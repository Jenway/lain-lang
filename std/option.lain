// std::option —— 可选值函子。
//
// 载荷类型由函子的编译期实参决定，函子遵循纯函数的单例缓存规则：
// 任意位置两次调用 Option(i64) 得到同一个类型标识与同一个模块。
// 枚举与模块只用到语言核心（enum / match / Module），因此同一份源码
// 在 lainir-run 虚拟机与 C99 后端上有完全一致的行为。
pub let Option = func(T: Type) -> Module {
  return module {
    pub let Opt = enum {
      None
      Some(T)
    };

    // 函子的类型标识：Option(T) 自身即可当作类型书写，Opt 保留为别名。
    pub let Self = Opt;

    // 空值：没有载荷。
    pub let none = func() -> Opt {
      return Opt.None { };
    };

    // 有值：把 v 装进 Some 分支。
    pub let some = func(v: T) -> Opt {
      return Opt.Some { v };
    };

    pub let is_some = func(o: Opt) -> bool {
      return match o {
        None => false,
        Some(_) => true,
      };
    };

    pub let is_none = func(o: Opt) -> bool {
      return match o {
        None => true,
        Some(_) => false,
      };
    };

    // 有值取载荷，空值回退到调用方给的默认值。
    pub let unwrap_or = func(o: Opt, fallback: T) -> T {
      return match o {
        None => fallback,
        Some(v) => v,
      };
    };
  };
};
