pub let Option = func(T: Type) -> Module {
  return module {
    pub let Opt = enum {
      None
      Some(T)
    };

    pub let Self = Opt;

    pub let none = func() -> Opt {
      return Opt.None { };
    };

    pub let some = func(v: T) -> Opt {
      return Opt.Some { v };
    };

    pub let is_some = func(o: Opt) -> bool {
      return match o {
        None => false,
        Some(_) => true,
      };
    };

    pub let is_none = func(o: Opt) -> bool {
      return match o {
        None => true,
        Some(_) => false,
      };
    };

    pub let unwrap_or = func(o: Opt, fallback: T) -> T {
      return match o {
        None => fallback,
        Some(v) => v,
      };
    };
  };
};
