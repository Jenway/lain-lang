@compiler_intrinsic(slice_len)
pub fn slice_len<T>(slice: &[T]) -> usize;

@compiler_intrinsic(slice_len_mut)
pub fn slice_len_mut<T>(slice: &mut [T]) -> usize;

@compiler_intrinsic(slice_as_opaque)
pub fn slice_as_opaque<T>(slice: &[T]) -> opaque;

@compiler_intrinsic(slice_as_mut_opaque)
pub fn slice_as_mut_opaque<T>(slice: &mut [T]) -> opaque;

@compiler_intrinsic(slice_from_raw_parts)
pub fn slice_from_raw_parts<T>(ptr: opaque, len: usize) -> &[T];
