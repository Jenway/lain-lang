@compiler_intrinsic(slice_len)
pub fn slice_len<T>(slice: &[T]) -> usize;

@compiler_intrinsic(slice_len_mut)
pub fn slice_len_mut<T>(slice: &mut [T]) -> usize;

@compiler_intrinsic(slice_as_ptr)
pub fn slice_as_ptr<T>(slice: &[T]) -> *mut T;

@compiler_intrinsic(slice_as_mut_ptr)
pub fn slice_as_mut_ptr<T>(slice: &mut [T]) -> *mut T;

@compiler_intrinsic(slice_from_raw_parts)
pub fn slice_from_raw_parts<T>(ptr: *mut T, len: usize) -> &[T];
