@compiler_intrinsic(slice_len)
@export
let slice_len = std::func<T>(slice: &[T]) -> usize;

@compiler_intrinsic(slice_len_mut)
@export
let slice_len_mut = std::func<T>(slice: &mut [T]) -> usize;

@compiler_intrinsic(slice_as_opaque)
@export
let slice_as_opaque = std::func<T>(slice: &[T]) -> opaque;

@compiler_intrinsic(slice_as_mut_opaque)
@export
let slice_as_mut_opaque = std::func<T>(slice: &mut [T]) -> opaque;

@compiler_intrinsic(slice_from_raw_parts)
@export
let slice_from_raw_parts = std::func<T>(ptr: opaque, len: usize) -> &[T];
