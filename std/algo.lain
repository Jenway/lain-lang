let option = import("std::option");

pub let Eq = sig {
  pub let Self: Type;
  pub let eq: Fn((Ref(Self), Ref(Self)) -> bool);
};

pub let Ord = sig {
  pub let Self: Type;
  pub let cmp: Fn((Ref(Self), Ref(Self)) -> i64);
};

pub let EqU64: Eq = module {
  pub let Self = u64;
  pub let eq = func(a: Ref(u64), b: Ref(u64)) -> bool {
    return deref(a) == deref(b);
  };
};

pub let OrdU64: Ord = module {
  pub let Self = u64;
  pub let cmp = func(a: Ref(u64), b: Ref(u64)) -> i64 {
    let x: u64 = deref(a);
    let y: u64 = deref(b);
    if x < y { return -1; }
    if x > y { return 1; }
    return 0;
  };
};

pub let EqI64: Eq = module {
  pub let Self = i64;
  pub let eq = func(a: Ref(i64), b: Ref(i64)) -> bool {
    return deref(a) == deref(b);
  };
};

pub let OrdI64: Ord = module {
  pub let Self = i64;
  pub let cmp = func(a: Ref(i64), b: Ref(i64)) -> i64 {
    let x: i64 = deref(a);
    let y: i64 = deref(b);
    if x < y { return -1; }
    if x > y { return 1; }
    return 0;
  };
};

pub let EqU8: Eq = module {
  pub let Self = u8;
  pub let eq = func(a: Ref(u8), b: Ref(u8)) -> bool {
    return deref(a) == deref(b);
  };
};

pub let OrdU8: Ord = module {
  pub let Self = u8;
  pub let cmp = func(a: Ref(u8), b: Ref(u8)) -> i64 {
    return (deref(a) as i64) - (deref(b) as i64);
  };
};

pub let OptIdx = option.Option(u64);

pub let IdxOpt = OptIdx.Opt;

pub let find = func(s: Slice(T), target: Ref(T)) ?{ T: Type, e: Eq, R: Type } -> R {
  let n: u64 = s.len;
  let hit: R = OptIdx.none();
  loop scan(i: u64 = 0) while i < n {
    let x: T = s[i];
    if e.eq(ref_of(x), target) {
      hit = OptIdx.some(i);
      i = n;
    } else {
      i = i + 1;
    }
  };
  return hit;
};

pub let contains = func(s: Slice(T), target: Ref(T)) ?{ T: Type, e: Eq } -> bool {
  let n: u64 = s.len;
  let found: u64 = loop scan(i: u64 = 0, hit: u64 = 0) while (i < n) and (hit == 0) {
    let x: T = s[i];
    if e.eq(ref_of(x), target) { hit = 1; }
    i = i + 1;
  };
  return found == 1;
};

pub let equal = func(a: Slice(T), b: Slice(T)) ?{ T: Type, e: Eq } -> bool {
  let n: u64 = a.len;
  if n != b.len {
    return false;
  }
  let same: u64 = loop cmp(i: u64 = 0, ok: u64 = 1) while (i < n) and (ok == 1) {
    let x: T = a[i];
    let y: T = b[i];
    if e.eq(ref_of(x), ref_of(y)) == false { ok = 0; }
    i = i + 1;
  };
  return same == 1;
};

pub let reverse = func(s: MutSlice(T)) ?{ T: Type } {
  let n: u64 = s.len;
  let half: u64 = n / 2;
  loop flip(i: u64 = 0) while i < half {
    let j: u64 = n - 1 - i;
    let tmp: T = s[i];
    s[i] = s[j];
    s[j] = tmp;
    i = i + 1;
  };
};

pub let fill = func(s: MutSlice(T), val: T) ?{ T: Type } {
  let n: u64 = s.len;
  loop pour(i: u64 = 0) while i < n {
    s[i] = val;
    i = i + 1;
  };
};

pub let is_sorted = func(s: Slice(T)) ?{ T: Type, o: Ord } -> bool {
  let n: u64 = s.len;
  let ok: u64 = loop scan(i: u64 = 1, good: u64 = 1) while (i < n) and (good == 1) {
    let prev: T = s[i - 1];
    let cur: T = s[i];
    if o.cmp(ref_of(prev), ref_of(cur)) > 0 { good = 0; }
    i = i + 1;
  };
  return ok == 1;
};

pub let sort = func(s: MutSlice(T)) ?{ T: Type, o: Ord } {
  let n: u64 = s.len;
  loop outer(i: u64 = 1) while i < n {
    let key: T = s[i];
    let slot: u64 = i;
    loop inner(j: u64 = i, done: u64 = 0) while (j > 0) and (done == 0) {
      let prev: T = s[j - 1];
      if o.cmp(ref_of(prev), ref_of(key)) > 0 {
        s[j] = prev;
        slot = j - 1;
        j = j - 1;
      } else {
        done = 1;
      }
    };
    s[slot] = key;
    i = i + 1;
  };
};

pub let binary_search = func(s: Slice(T), target: Ref(T)) ?{ T: Type, o: Ord, R: Type } -> R {
  let lo0: u64 = 0;
  let hi0: u64 = s.len;
  let hit: R = OptIdx.none();
  loop probe(lo: u64 = lo0, hi: u64 = hi0) while lo < hi {
    let mid: u64 = (lo + hi) / 2;
    let x: T = s[mid];
    let c: i64 = o.cmp(ref_of(x), target);
    if c == 0 {
      hit = OptIdx.some(mid);
      lo = hi;
    } else {
      if c < 0 {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
  };
  return hit;
};

pub let SliceIter = func(T: Type) -> Module {
  let opt = option.Option(T);
  return module {
    pub let Self = struct {
      s: Slice(T),
      pos: u64,
    };

    pub let from = func(s: Slice(T)) -> Self {
      return Self { s: s, pos: 0 };
    };

    pub let next = func(it: Mut(Self)) -> opt.Opt {
      let n: u64 = deref(it).s.len;
      let p: u64 = deref(it).pos;
      if p >= n {
        return opt.none();
      }
      let x: T = deref(it).s[p];
      deref(it).pos = p + 1;
      return opt.some(x);
    };
  };
};
