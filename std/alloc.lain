@foreign(c, link_name = "malloc")
@export
let malloc = std::func(size: usize) -> opaque ! {Alloc};

@foreign(c, link_name = "realloc")
@export
let realloc = std::func(ptr: opaque, size: usize) -> opaque ! {Alloc};

@foreign(c, link_name = "free")
@export
let free = std::func(ptr: opaque) -> () ! {Alloc};
