let mem = import("std::mem");
let option = import("std::option");

pub let HashMapU64 = func(V: Type)
  ?{ al: mem.Allocator = mem.SystemAlloc }
  -> Module
{
  let opt = option.Option(V);
  return module {
    pub let Opt = opt.Opt;

    pub let Self = struct {
      keys: Mut(u64),
      used: Mut(bool),
      vals: Mut(V),
      len: u64,
      cap: u64,
      alloc: al.Self,
    };

    pub let Map = Self;

    let mix = func(key: u64) -> u64 {
      let x: u64 = key ^ (key >> 30);
      return x * 0xbf58476d1ce4e5b9;
    };

    let slot_of = func(key: u64, cap: u64) -> u64 {
      return mix(key) % cap;
    };

    let elem_bytes = func() -> u64 {
      return size_of(V) as u64;
    };

    let used_get = func(base: Mut(bool), i: u64) -> bool {
      let p: Mut(bool) = ptr_cast(Mut(bool), (base as u64) + i * (size_of(bool) as u64));
      return deref(p);
    };

    let used_set = func(base: Mut(bool), i: u64, v: bool) {
      let p: Mut(bool) = ptr_cast(Mut(bool), (base as u64) + i * (size_of(bool) as u64));
      deref(p) = v;
    };

    let key_get = func(base: Mut(u64), i: u64) -> u64 {
      let p: Mut(u64) = ptr_cast(Mut(u64), (base as u64) + i * 8);
      return deref(p);
    };

    let key_set = func(base: Mut(u64), i: u64, v: u64) {
      let p: Mut(u64) = ptr_cast(Mut(u64), (base as u64) + i * 8);
      deref(p) = v;
    };

    let val_at = func(base: Mut(V), i: u64) -> Mut(V) {
      return ptr_cast(Mut(V), (base as u64) + i * elem_bytes());
    };

    let zero_used = func(base: Mut(bool), cap: u64) {
      loop z(i: u64 = 0) while i < cap {
        used_set(base, i, false);
        i = i + 1;
      };
    };

    let find_used_in = func(keys: Mut(u64), used: Mut(bool), cap: u64, key: u64) -> u64 {
      let start: u64 = slot_of(key, cap);
      let slot: u64 = loop s(i: u64 = 0, out: u64 = cap) while i < cap {
        let idx: u64 = (start + i) % cap;
        if used_get(used, idx) {
          if key_get(keys, idx) == key {
            out = idx;
            i = cap;
          } else {
            i = i + 1;
          }
        } else {
          i = cap;
        }
      };
      return slot;
    };

    let find_free_in = func(used: Mut(bool), cap: u64, key: u64) -> u64 {
      let start: u64 = slot_of(key, cap);
      let slot: u64 = loop s(i: u64 = 0, out: u64 = cap) while i < cap {
        let idx: u64 = (start + i) % cap;
        if used_get(used, idx) {
          i = i + 1;
        } else {
          out = idx;
          i = cap;
        }
      };
      return slot;
    };

    let alloc_bytes = func(a: Mut(al.Self), bytes: u64) -> u64 {
      let raw: u64 = al.alloc(a, bytes);
      if raw == 0 {
        let dead: u64 = mem.trap_abort(bytes);
        return dead;
      }
      return raw;
    };

    pub let with_capacity = func(a: al.Self, cap: u64) -> Self {
      if cap == 0 {
        return Self {
          keys: null_ref(Mut(u64)),
          used: null_ref(Mut(bool)),
          vals: null_ref(Mut(V)),
          len: 0,
          cap: 0,
          alloc: a,
        };
      }
      let ap: Mut(al.Self) = mut_of(a);
      let keys_raw: u64 = alloc_bytes(ap, cap * 8);
      let used_raw: u64 = alloc_bytes(ap, cap * (size_of(bool) as u64));
      let vals_raw: u64 = alloc_bytes(ap, cap * elem_bytes());
      let keys: Mut(u64) = ptr_cast(Mut(u64), keys_raw);
      let used: Mut(bool) = ptr_cast(Mut(bool), used_raw);
      let vals: Mut(V) = ptr_cast(Mut(V), vals_raw);
      zero_used(used, cap);
      return Self { keys: keys, used: used, vals: vals, len: 0, cap: cap, alloc: a };
    };

    pub let with_alloc = func(a: al.Self) -> Self {
      return with_capacity(a, 16);
    };

    let grow = func(m: Mut(Self)) {
      let old_cap: u64 = deref(m).cap;
      let new_cap: u64 = if old_cap == 0 { 16 } else { old_cap * 2 };
      let a: Mut(al.Self) = mut_of(deref(m).alloc);
      let keys_raw: u64 = alloc_bytes(a, new_cap * 8);
      let used_raw: u64 = alloc_bytes(a, new_cap * (size_of(bool) as u64));
      let vals_raw: u64 = alloc_bytes(a, new_cap * elem_bytes());
      let new_keys: Mut(u64) = ptr_cast(Mut(u64), keys_raw);
      let new_used: Mut(bool) = ptr_cast(Mut(bool), used_raw);
      let new_vals: Mut(V) = ptr_cast(Mut(V), vals_raw);
      zero_used(new_used, new_cap);
      let old_keys: Mut(u64) = deref(m).keys;
      let old_used: Mut(bool) = deref(m).used;
      let old_vals: Mut(V) = deref(m).vals;
      loop rehash(i: u64 = 0) while i < old_cap {
        if used_get(old_used, i) {
          let k: u64 = key_get(old_keys, i);
          let spot: u64 = find_free_in(new_used, new_cap, k);
          key_set(new_keys, spot, k);
          used_set(new_used, spot, true);
          deref(val_at(new_vals, spot)) = deref(val_at(old_vals, i));
        }
        i = i + 1;
      };
      if is_null(old_keys) == false {
        let f0: u64 = al.free(a, old_keys as u64);
      }
      if is_null(old_used) == false {
        let f1: u64 = al.free(a, old_used as u64);
      }
      if is_null(old_vals) == false {
        let f2: u64 = al.free(a, old_vals as u64);
      }
      deref(m).keys = new_keys;
      deref(m).used = new_used;
      deref(m).vals = new_vals;
      deref(m).cap = new_cap;
    };

    pub let drop = func(m: Mut(Self)) {
      let cap0: u64 = deref(m).cap;
      let used: Mut(bool) = deref(m).used;
      let vals: Mut(V) = deref(m).vals;
      loop release(i: u64 = 0) while i < cap0 {
        if used_get(used, i) {
          drop_at(val_at(vals, i));
        }
        i = i + 1;
      };
      let a: Mut(al.Self) = mut_of(deref(m).alloc);
      let keys: Mut(u64) = deref(m).keys;
      if is_null(keys) == false {
        let f0: u64 = al.free(a, keys as u64);
      }
      if is_null(used) == false {
        let f1: u64 = al.free(a, used as u64);
      }
      if is_null(vals) == false {
        let f2: u64 = al.free(a, vals as u64);
      }
      deref(m).keys = null_ref(Mut(u64));
      deref(m).used = null_ref(Mut(bool));
      deref(m).vals = null_ref(Mut(V));
      deref(m).len = 0;
      deref(m).cap = 0;
    };

    pub let len = func(m: Ref(Self)) -> u64 {
      return deref(m).len;
    };

    pub let cap = func(m: Ref(Self)) -> u64 {
      return deref(m).cap;
    };

    pub let is_empty = func(m: Ref(Self)) -> bool {
      return deref(m).len == 0;
    };

    pub let put = func(m: Mut(Self), key: u64, val: V) -> bool {
      let grow_now: bool = (deref(m).cap == 0) or (((deref(m).len + 1) * 10) > (deref(m).cap * 7));
      if grow_now {
        grow(m);
      }
      let hit: u64 = find_used_in(deref(m).keys, deref(m).used, deref(m).cap, key);
      let had_old: bool = hit < deref(m).cap;
      let spot: u64 = if had_old { hit } else { find_free_in(deref(m).used, deref(m).cap, key) };
      if had_old == false {
        key_set(deref(m).keys, spot, key);
        used_set(deref(m).used, spot, true);
        deref(m).len = deref(m).len + 1;
      }
      let slot: Mut(V) = val_at(deref(m).vals, spot);
      let raw: Uninit(V) = if had_old { drop_at(slot) } else { ptr_cast(Uninit(V), slot) };
      init_at(raw, reloc(val));
      return had_old == false;
    };

    pub let has = func(m: Ref(Self), key: u64) -> bool {
      let cap0: u64 = deref(m).cap;
      if cap0 == 0 {
        return false;
      }
      let hit: u64 = find_used_in(deref(m).keys, deref(m).used, cap0, key);
      return hit < cap0;
    };

    pub let get = func(m: Ref(Self), key: u64, out: Mut(V)) -> bool {
      let cap0: u64 = deref(m).cap;
      if cap0 == 0 {
        return false;
      }
      let hit: u64 = find_used_in(deref(m).keys, deref(m).used, cap0, key);
      if hit < cap0 {
        deref(out) = deref(val_at(deref(m).vals, hit));
        return true;
      }
      return false;
    };

    pub let get_opt = func(m: Ref(Self), key: u64) -> opt.Opt {
      let cap0: u64 = deref(m).cap;
      if cap0 == 0 {
        return opt.none();
      }
      let hit: u64 = find_used_in(deref(m).keys, deref(m).used, cap0, key);
      if hit < cap0 {
        return opt.some(deref(val_at(deref(m).vals, hit)));
      }
      return opt.none();
    };

    pub let clear = func(m: Mut(Self)) {
      let cap0: u64 = deref(m).cap;
      let used: Mut(bool) = deref(m).used;
      let vals: Mut(V) = deref(m).vals;
      loop wipe(i: u64 = 0) while i < cap0 {
        if used_get(used, i) {
          drop_at(val_at(vals, i));
          used_set(used, i, false);
        }
        i = i + 1;
      };
      deref(m).len = 0;
    };

    let AllocCell = struct { handle: al.Self };

    comptime if size_of(AllocCell) == 8 {
      pub let new = func() -> Self {
        return with_alloc(mem.SystemAlloc.new());
      };
    };
  };
};
