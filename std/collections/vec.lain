// std::collections::vec —— 定长容量的泛型向量函子。
//
// 函子只依赖语言核心（Array / loop / 引用族）与 std::mem 的静态 arena
// 切块原语，因此同一份源码在 lainir-run 虚拟机与 C99 后端上有完全一致的行为。
//
// 存储：LAINIR 里的 Array 与 struct 都是「指向块的指针」，函数返回时只拷指针字，
// 被调过程调用帧里的块随返回失效。因此容器块统一从本模块的静态 arena 切分，
// 每调用一次 new 就占用一段互不重叠的块，块的生命期与进程相同。
// arena 容量固定，耗尽时由 mem.carve 立即中止。
let mem = import("std::mem");

let ArenaBacking = struct {
  bytes: Array(u8, 16384),
};

// 空字面量让顶层聚合走「整块先清零再写字段」的数据登记，得到一块可写静态存储。
// 块的首字是已用字节数（游标），有效载荷从第 8 字节起。
let arena_backing: ArenaBacking = ArenaBacking { };

// 从静态 arena 切出 bytes 字节，块起点由 mem.carve 回。
let arena_take = func(bytes: u64) -> u64 {
  return mem.carve(ptr_of(arena_backing), 16384, bytes);
};

// ---------------------------------------------------------------------------
// ArenaVec：定长数组 + 长度计数。
// ---------------------------------------------------------------------------
pub let ArenaVec = func(T: Type, Cap: u64) -> Module {
  return module {
    pub let Vec = struct {
      data: Array(T, Cap),
      len: u64,
    };

    pub let Self = Vec;

    // 空容器：每个聚合字段从 arena 切一块，长度归零。
    pub let new = func() -> Vec {
      let v: Vec = Vec { len: 0 };
      comptime for f in fields_of(Vec) {
        let dst: Mut(u64) = ptr_cast(Mut(u64), ptr_of(v) + (f.offset as u64));
        deref(dst) = arena_take(size_of(f.type) as u64);
      }
      v.len = 0;
      return v;
    };

    pub let count = func(v: Ref(Vec)) -> u64 {
      return deref(v).len;
    };

    // 容量未满时追加到尾部，返回 1；满了返回 0。
    pub let push = func(v: Mut(Vec), item: T) -> u64 {
      if deref(v).len >= Cap {
        return 0;
      }
      deref(v).data[deref(v).len] = item;
      deref(v).len = deref(v).len + 1;
      return 1;
    };

    // 有效区间内按下标读取；调用方保证 i < count。
    pub let get = func(v: Ref(Vec), i: u64) -> T {
      return deref(v).data[i];
    };

    // 覆盖有效区间内的元素，返回 1；越界返回 0。
    pub let set = func(v: Mut(Vec), i: u64, item: T) -> u64 {
      if i >= deref(v).len {
        return 0;
      }
      deref(v).data[i] = item;
      return 1;
    };

    // 清空只回退长度，底层槽位保留。
    pub let clear = func(v: Mut(Vec)) -> u64 {
      deref(v).len = 0;
      return 1;
    };
  };
};
