let io = import("std::io");
let mem = import("std::mem");

pub let Cursor = struct {
  base: Mut(u8),
  p: Mut(u8),
  left: u64,
};

pub let capacity = func() -> u64 { return 256; };
let chunks = func() -> u64 { return 16; };

let pool_words = func() -> u64 { return 513; };
let data_off = func() -> u64 { return 8; };

let PoolStore = struct {
  words: Array(u64, 513),
};

let pool_store: PoolStore = PoolStore { };

let pool_addr = func() -> u64 { return ptr_of(pool_store); };

let slots = func() -> MutSlice(u64) {
  let base: Mut(u64) = ptr_cast(Mut(u64), pool_addr());
  return make_slice(MutSlice(u64), base, pool_words());
};

let bytes = func() -> Mut(u8) {
  return ptr_cast(Mut(u8), pool_addr());
};

let put_byte = func(c: Cursor, b: u8) -> Cursor {
  if c.left == 0 {
    mem.trap_abort(capacity());
  }
  let q: Mut(u8) = c.p;
  deref(q) = b;
  return Cursor { base: c.base, p: q + 1, left: c.left - 1 };
};

let str_at = func(c: Cursor, s: Slice(u8), i: u64) -> Cursor {
  if i >= s.len { return c; }
  return str_at(put_byte(c, s[i]), s, i + 1);
};

pub let write_str = func(c: Cursor, s: Slice(u8)) -> Cursor {
  return str_at(c, s, 0);
};

pub let write_u64 = func(c: Cursor, v: u64) -> Cursor {
  if v >= 10 {
    let head: Cursor = write_u64(c, v / 10);
    return put_byte(head, (48 + (v % 10)) as u8);
  }
  return put_byte(c, (48 + v) as u8);
};

pub let write_i64 = func(c: Cursor, v: i64) -> Cursor {
  if v < 0 {
    let head: Cursor = put_byte(c, 45);
    let uv: u64 = v as u64;
    return write_u64(head, 0 - uv);
  }
  return write_u64(c, v as u64);
};

pub let write_bool = func(c: Cursor, v: bool) -> Cursor {
  if v { return write_str(c, "true"); }
  return write_str(c, "false");
};

pub let fmt_begin = func() -> Cursor {
  let s: MutSlice(u64) = slots();
  let idx: u64 = s[0];
  s[0] = (idx + 1) % chunks();
  let base: Mut(u8) = bytes() + data_off() + idx * capacity();
  return Cursor { base: base, p: base, left: capacity() };
};

pub let fmt_done = func(c: Cursor) -> Slice(u8) {
  return make_slice(Slice(u8), c.base, capacity() - c.left);
};

pub let Formattable = sig {
  pub let Self: Type;
  pub let write: Fn((Cursor, Self) -> Cursor);
};

pub let fmt_val = func(c: Cursor, v: T) ?{ T: Type, f: Formattable } -> Cursor {
  return f.write(c, v);
};

pub let FmtI64: Formattable = module {
  pub let Self = i64;
  pub let write = func(c: Cursor, v: i64) -> Cursor { return write_i64(c, v); };
};

pub let FmtU64: Formattable = module {
  pub let Self = u64;
  pub let write = func(c: Cursor, v: u64) -> Cursor { return write_u64(c, v); };
};

pub let FmtBool: Formattable = module {
  pub let Self = bool;
  pub let write = func(c: Cursor, v: bool) -> Cursor { return write_bool(c, v); };
};

pub let FmtStr: Formattable = module {
  pub let Self = Slice(u8);
  pub let write = func(c: Cursor, s: Slice(u8)) -> Cursor { return write_str(c, s); };
};

pub let f_step = func(head: Slice(u8), v: T, tail: Slice(u8)) ?{ T: Type, w: Formattable } -> Slice(u8) {
  let c0: Cursor = write_str(fmt_begin(), head);
  let c1: Cursor = w.write(c0, v);
  return fmt_done(write_str(c1, tail));
};

pub let emit = func(c: Cursor) -> u64 {
  return io.write_str(fmt_done(c));
};

pub let emit_line = func(c: Cursor) -> u64 {
  return io.write_str(fmt_done(c)) + io.newline();
};

pub let print = func(s: Slice(u8)) -> u64 { return io.write_str(s); };

pub let println = func(s: Slice(u8)) -> u64 { return io.write_str(s) + io.newline(); };
