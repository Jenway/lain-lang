let mem = import("std::mem");
let pool = import("std::pool");

pub let WorkNode = struct {
  next: Mut(u8),
  work: Fn((Mut(u8)) -> u64),
  ctx: Mut(u8),
};

let no_link = func() -> Mut(u8) {
  return ptr_cast(Mut(u8), 0 as u64);
};

pub let work_node = func(work: Fn((Mut(u8)) -> u64), ctx: Mut(u8)) -> WorkNode {
  return WorkNode { next: no_link(), work: work, ctx: ctx };
};

pub let work_node_next = func(n: Ref(WorkNode)) -> Mut(WorkNode) {
  return ptr_cast(Mut(WorkNode), deref(n).next);
};

pub let work_node_link = func(n: Mut(WorkNode), next: Mut(WorkNode)) -> u64 {
  n.next = ptr_cast(Mut(u8), next);
  return 1;
};

pub let Scheduler = sig {
  pub let Self: Type;
  pub let schedule: Fn((Mut(Self), Fn((Mut(u8)) -> u64), Mut(u8)) -> bool);
  pub let wait_all: Fn((Mut(Self)) -> u64);
};

pub let InlineSched = struct { executed: u64 };

pub let InlineScheduler = module {
  pub let Self = InlineSched;

  pub let new = func() -> InlineSched {
    return InlineSched { executed: 0 };
  };

  pub let schedule = func(s: Mut(InlineSched), work: Fn((Mut(u8)) -> u64), ctx: Mut(u8)) -> bool {
    work(ctx);
    s.executed = s.executed + 1;
    return true;
  };

  pub let wait_all = func(s: Mut(InlineSched)) -> u64 {
    return s.executed;
  };

  pub let executed = func(s: Ref(InlineSched)) -> u64 {
    return deref(s).executed;
  };
};

pub let PoolSched = struct { pool: Mut(pool.ThreadPool) };

pub let PoolScheduler = module {
  pub let Self = PoolSched;

  pub let new = func(p: Mut(pool.ThreadPool)) -> PoolSched {
    return PoolSched { pool: p };
  };

  pub let schedule = func(s: Mut(PoolSched), work: Fn((Mut(u8)) -> u64), ctx: Mut(u8)) -> bool {
    return pool.pool_submit(s.pool, work, ctx);
  };

  pub let wait_all = func(s: Mut(PoolSched)) -> u64 {
    return pool.pool_wait_all(s.pool);
  };

  pub let pool_of = func(s: Ref(PoolSched)) -> Mut(pool.ThreadPool) {
    return deref(s).pool;
  };
};

pub let dispatch = func(s: Mut(S), work: Fn((Mut(u8)) -> u64), ctx: Mut(u8))
  ?{ S: Type, sc: Scheduler }
  -> bool
{
  return sc.schedule(s, work, ctx);
};

pub let wait_idle = func(s: Mut(S))
  ?{ S: Type, sc: Scheduler }
  -> u64
{
  return sc.wait_all(s);
};

pub let SpawnRequest = struct {
  work: Fn((Mut(u8)) -> u64),
  ctx: Mut(u8),
};

pub let Spawn = effect {
  op spawn(req: SpawnRequest) -> bool;
};

let Cell = struct { v: u64 };

let scope_slot: Cell = Cell { };

let current_pool = func() -> Mut(pool.ThreadPool) {
  let w: Mut(Cell) = mut_of(scope_slot);
  return ptr_cast(Mut(pool.ThreadPool), deref(w).v);
};

let set_current_pool = func(p: Mut(pool.ThreadPool)) -> Mut(pool.ThreadPool) {
  let w: Mut(Cell) = mut_of(scope_slot);
  let prev: Mut(pool.ThreadPool) = ptr_cast(Mut(pool.ThreadPool), deref(w).v);
  deref(w).v = p as u64;
  return prev;
};

pub let spawn_work = func(work: Fn((Mut(u8)) -> u64), ctx: Mut(u8)) -> bool !{ Spawn } {
  let p: Mut(pool.ThreadPool) = current_pool();
  if is_null(p) {
    mem.trap_abort(1);
  }
  return pool.pool_submit(p, work, ctx);
};

pub let run_pool_scope = func(p: Mut(pool.ThreadPool), body: Fn(() -> u64 !{ Spawn })) -> u64 {
  let prev: Mut(pool.ThreadPool) = set_current_pool(p);
  let done: u64 = body()!;
  pool.pool_wait_all(p);
  set_current_pool(prev);
  return done;
};
