let option = import("std::option");
let os = import("std::os");

let OptSlice = option.Option(MutSlice(u8));

use os.{ IoErr };

pub let File = module {
  pub {
    let Self = struct {
      handle: Mut(u8),
    };

    let drop = func(f: Mut(Self)) {
      let h: Mut(u8) = deref(f).handle;
      os.c_fclose(h);
    };

    let open = func(path: Slice(u8), mode: Slice(u8)) -> Self !{ IoErr } {
      let h: Mut(u8) = os.open_file(path, mode);
      if is_null(h) {
        perform IoErr.fail(1);
      }
      return Self { handle: h };
    };

    let read = func(f: Mut(Self), buf: MutSlice(u8)) -> u64 !{ IoErr } {
      let h: Mut(u8) = deref(f).handle;
      let got: c_size = os.c_fread(buf.ptr, 1, buf.len, h);
      return got as u64;
    };

    let write = func(f: Mut(Self), data: Slice(u8)) -> u64 !{ IoErr } {
      let h: Mut(u8) = deref(f).handle;
      let wrote: c_size = if data.len > 0 { os.c_fwrite(data.ptr, 1, data.len, h) } else { 0 };
      if wrote != data.len {
        perform IoErr.fail(2);
      }
      return wrote as u64;
    };
  };
};

pub let exists = func(path: Slice(u8)) -> bool {
  return os.file_exists(path);
};

pub let read_bytes = func(path: Slice(u8)) -> OptSlice.Opt {
  return os.read_file_slice(path);
};

pub let write_bytes = func(path: Slice(u8), data: Slice(u8)) -> bool {
  return os.write_file_bool(path, data);
};

pub let remove = func(path: Slice(u8)) -> bool {
  return os.remove_file(path) == 0;
};

pub let copy = func(src: Slice(u8), dst: Slice(u8)) !{ IoErr } {
  let in_f: File = File.open(src, "rb")!;
  let out_f: File = File.open(dst, "wb")!;
  let in_p: Mut(File) = mut_of(in_f);
  let out_p: Mut(File) = mut_of(out_f);
  let raw: Array(u8, 4096) = [0; 4096];
  let chunk: MutSlice(u8) = make_slice(MutSlice(u8), ptr_cast(Mut(u8), mut_of(raw)), 4096);
  loop pump() {
    let n: u64 = File.read(in_p, chunk)!;
    if n == 0 { break pump; }
    let part: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), chunk.ptr), n);
    let wrote: u64 = File.write(out_p, part)!;
  };
};
