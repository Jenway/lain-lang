// std/ownership.lain
//
// Small Meta ownership state machine.  It records policy decisions before
// physical lowering; no ownership labels are added to LAIN-IR.

@export
let ownership: Module = std::module {
    @export
    let State: type = i32;

    @export
    let Available: State = 0;

    @export
    let Borrowed: State = 1;

    @export
    let Moved: State = 2;

    @export
    let Aliased: State = 3;

    @export
    let Released: State = 4;

    @export
    let borrow_allowed = std::func(state: State) -> bool {
        return state == 0 || state == 1;
    };

    @export
    let move_allowed = std::func(state: State) -> bool {
        return state == 0 || state == 3;
    };

    @export
    let alias_allowed = std::func(state: State) -> bool {
        return state == 0 || state == 1 || state == 3;
    };

    @export
    let transition = std::func(
        state: State,
        operation: i32,
    ) -> State {
        if operation == 1 && ownership.borrow_allowed(state) { return 1; }
        if operation == 2 && ownership.move_allowed(state) { return 2; }
        if operation == 3 && ownership.alias_allowed(state) { return 3; }
        return 4;
    };
};
