pub let MemOrder = enum(u64) {
  Relaxed = 0,
  Acquire = 1,
  Release = 2,
  AcqRel = 3,
  SeqCst = 4
};

pub let fence = func(order: u64) -> u64 {
  atomic_fence(order);
  return 0;
};

pub let AtomicU64 = struct {
  val: u64,
};

pub let atomic_u64_new = func(v: u64) -> AtomicU64 {
  return AtomicU64 { val: v };
};

pub let atomic_u64_load = func(a: Mut(AtomicU64), order: u64) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), a);
  return atomic_load(word, order);
};

pub let atomic_u64_store = func(a: Mut(AtomicU64), v: u64, order: u64) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), a);
  atomic_store(word, v, order);
  return 0;
};

pub let atomic_u64_add = func(a: Mut(AtomicU64), delta: u64, order: u64) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), a);
  return atomic_add(word, delta, order);
};

pub let atomic_u64_cas = func(a: Mut(AtomicU64), expected: u64, desired: u64, order: u64) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), a);
  return atomic_cas(word, expected, desired, order);
};

pub let AtomicU64Mod = module {
  pub let Self = AtomicU64;

  pub let new = func(v: u64) -> AtomicU64 { return atomic_u64_new(v); };
  pub let load = func(a: Mut(AtomicU64), order: u64) -> u64 { return atomic_u64_load(a, order); };
  pub let store = func(a: Mut(AtomicU64), v: u64, order: u64) -> u64 {
    return atomic_u64_store(a, v, order);
  };
  pub let fetch_add = func(a: Mut(AtomicU64), delta: u64, order: u64) -> u64 {
    return atomic_u64_add(a, delta, order);
  };
  pub let compare_exchange = func(a: Mut(AtomicU64), expected: u64, desired: u64, order: u64) -> u64 {
    return atomic_u64_cas(a, expected, desired, order);
  };
};

pub let SpinLock = struct {
  locked: u64,
};

pub let spin_new = func() -> SpinLock {
  return SpinLock { locked: 0 };
};

pub let spin_lock = func(l: Mut(SpinLock)) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), l);
  loop c(held: u64 = 0) while held == 0 {
    let old: u64 = atomic_cas(word, 0, 1, MemOrder.Acquire as u64);
    if old == 0 {
      held = 1;
    }
  };
  return 0;
};

pub let spin_unlock = func(l: Mut(SpinLock)) -> u64 {
  let word: Mut(u64) = ptr_cast(Mut(u64), l);
  atomic_store(word, 0, MemOrder.Release as u64);
  return 0;
};

pub let SpinLockMod = module {
  pub let Self = SpinLock;

  pub let new = func() -> SpinLock { return spin_new(); };
  pub let lock = func(l: Mut(SpinLock)) -> u64 { return spin_lock(l); };
  pub let unlock = func(l: Mut(SpinLock)) -> u64 { return spin_unlock(l); };
};
