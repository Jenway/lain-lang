// std/type.lain
//
// Semantic type policy values.  These values describe meaning and preferred
// representation; physical lowering remains responsible for choosing the
// actual LAIN-IR width and address shape.

@export
let type: Module = std::module {
    @export
    let TypeKind: type = i32;

    @export
    let Nominal: TypeKind = 1;

    @export
    let Structural: TypeKind = 2;

    @export
    let Alias: TypeKind = 3;

    @export
    let Function: TypeKind = 4;

    @export
    let Opaque: TypeKind = 5;

    @export
    let Foreign: TypeKind = 6;

    @export
    let ShapeKind: type = i32;

    @export
    let ScalarShape: ShapeKind = 1;

    @export
    let AggregateShape: ShapeKind = 2;

    @export
    let PointerShape: ShapeKind = 3;

    @export
    let FunctionShape: ShapeKind = 4;

    @export
    let OpaqueShape: ShapeKind = 5;

    @export
    let TypeValue: type = std::struct {
        kind: TypeKind,
        shape: ShapeKind,
        width: usize,
        owner: usize,
        identity: usize,
    };

    @export
    let Representation: type = std::struct {
        shape: ShapeKind,
        width: usize,
        alignment: usize,
        address_like: bool,
    };

    // Strict conversion policy: identity and explicit alias unfolding are
    // accepted.  Numeric widening and foreign/opaque conversions require an
    // explicit operation at a higher layer.
    @export
    let strict_conversion = std::func(
        from_kind: TypeKind,
        to_kind: TypeKind,
        explicit: bool,
    ) -> bool {
        if from_kind == to_kind { return true; }
        if from_kind == 3 && to_kind == 1 && explicit { return true; }
        return false;
    };

    // Permissive policy is useful for migration and foreign boundaries.  It
    // still rejects opaque values and unrelated nominal identities; callers
    // must preserve the trust decision in their Meta diagnostic.
    @export
    let permissive_conversion = std::func(
        from_kind: TypeKind,
        to_kind: TypeKind,
        explicit: bool,
    ) -> bool {
        if from_kind == 5 || to_kind == 5 { return false; }
        if from_kind == to_kind { return true; }
        if from_kind == 3 || to_kind == 3 { return true; }
        if from_kind == 6 && to_kind == 1 && explicit { return true; }
        if from_kind == 1 && to_kind == 6 && explicit { return true; }
        return false;
    };

    @export
    let representation_compatible = std::func(
        left_shape: ShapeKind,
        left_width: usize,
        right_shape: ShapeKind,
        right_width: usize,
    ) -> bool {
        if left_shape != right_shape { return false; }
        if left_width != right_width { return false; }
        return true;
    };

    // A small deterministic candidate ranking: zero is an exact match,
    // one is an alias conversion, and the remaining values are rejected.
    @export
    let overload_rank = std::func(
        candidate_kind: TypeKind,
        argument_kind: TypeKind,
    ) -> usize {
        if candidate_kind == argument_kind { return 0; }
        if candidate_kind == 3 || argument_kind == 3 { return 1; }
        return 999;
    };

    @export
    let overload_ambiguous = std::func(
        first_rank: usize,
        second_rank: usize,
    ) -> bool {
        if first_rank == 999 || second_rank == 999 { return false; }
        return first_rank == second_rank;
    };
};
