// std::bench —— 步数与单调纳秒计时。VM 的步数来自 TCB，C99 的步数恒为 0。
let io = import("std::io");

extern bench_steps() -> u64 = lain_perf_steps;
extern bench_nanos() -> u64 = lain_perf_nanos;

func steps() -> u64 {
  return bench_steps();
}

func nanos() -> u64 {
  return bench_nanos();
}

func elapsed_nanos(start: u64) -> u64 {
  return bench_nanos() - start;
}

func delta_steps(start: u64) -> u64 {
  return bench_steps() - start;
}

struct Sample {
  name: Slice(u8),
  steps: u64,
  nanos: u64,
}

func begin(name: Slice(u8)) -> Sample {
  return Sample { name: name, steps: bench_steps(), nanos: bench_nanos() };
}

func finish(s: Sample) -> Sample {
  return Sample {
    name: s.name,
    steps: bench_steps() - s.steps,
    nanos: bench_nanos() - s.nanos,
  };
}

func report(s: Sample) -> u64 {
  io.print("[bench] ");
  io.print(s.name);
  io.print(" steps=");
  io.print_u64(s.steps);
  io.print(" nanos=");
  io.println_u64(s.nanos);
  return s.steps;
}

func measure(name: Slice(u8), work: Fn(() -> u64)) -> u64 {
  let started: Sample = begin(name);
  let out: u64 = work();
  let done: Sample = finish(started);
  report(done);
  return out;
}
