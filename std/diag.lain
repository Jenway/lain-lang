let io = import("std::io");

let write_spaces = func(count: u64) -> u64 {
  let limit: u64 = count;
  if limit > 120 {
    limit = 120;
  }
  let i: u64 = 0;
  while i < limit {
    io::print(" ");
    i = i + 1;
  };
  return 0;
};

pub let emit_span = func(stage: Slice(u8), kind: Slice(u8), text: Slice(u8), pos: u64) -> u64 {
  let target: u64 = pos;
  if target > text.len {
    target = text.len;
  }
  let line: u64 = 1;
  let line_start: u64 = 0;
  let i: u64 = 0;
  while i < target {
    if text[i] == 10 {
      line = line + 1;
      line_start = i + 1;
    }
    i = i + 1;
  };
  let col: u64 = (target - line_start) + 1;
  let line_end: u64 = line_start;
  while line_end < text.len {
    if (text[line_end] == 10) or (text[line_end] == 13) {
      break;
    }
    line_end = line_end + 1;
  };
  io::print("[");
  io::print(stage);
  io::print("] ");
  io::print(kind);
  io::print(" at ");
  io::print_u64(line);
  io::print(":");
  io::println_u64(col);
  if line_end >= line_start {
    let line_len: u64 = line_end - line_start;
    if line_len > 0 {
      let line_slice: Slice(u8) = make_slice(Slice(u8), text.ptr + line_start, line_len);
      io::print("  ");
      io::println(line_slice);
      io::print("  ");
      write_spaces(col - 1);
      io::println("^");
    }
  }
  return 0;
};

pub let emit_pos = func(stage: Slice(u8), kind: Slice(u8), pos: u64) -> u64 {
  io::print("[");
  io::print(stage);
  io::print("] ");
  io::print(kind);
  io::print(" at byte ");
  io::println_u64(pos);
  return 0;
};

pub let emit_ir = func(stage: Slice(u8), kind: Slice(u8), proc_id: u64, pc: u64) -> u64 {
  io::print("[");
  io::print(stage);
  io::print("] ");
  io::print(kind);
  io::print(" (proc=");
  io::print_u64(proc_id);
  io::print(", pc=");
  io::print_u64(pc);
  io::println(")");
  return 0;
};

pub let emit_msg = func(stage: Slice(u8), msg: Slice(u8)) -> u64 {
  io::print("[");
  io::print(stage);
  io::print("] ");
  io::println(msg);
  return 0;
};

pub let emit_msg_u64 = func(stage: Slice(u8), msg: Slice(u8), val: u64) -> u64 {
  io::print("[");
  io::print(stage);
  io::print("] ");
  io::print(msg);
  io::print(": ");
  io::println_u64(val);
  return 0;
};
