let mem = import("std::mem");

pub let put_byte = func(buf: MutSlice(u8), pos: Mut(u64), b: u8) -> bool {
  if deref(pos) >= buf.len {
    return false;
  }
  buf[deref(pos)] = b;
  deref(pos) = deref(pos) + 1;
  return true;
};

pub let put_slice = func(buf: MutSlice(u8), pos: Mut(u64), s: Slice(u8)) -> bool {
  let ok: bool = true;
  let i: u64 = 0;
  while (i < s.len) and ok {
    if put_byte(buf, pos, s[i]) == false {
      ok = false;
    }
    i = i + 1;
  };
  return ok;
};

pub let put_u64 = func(buf: MutSlice(u8), pos: Mut(u64), v: u64) -> bool {
  if v >= 10 {
    if put_u64(buf, pos, v / 10) == false {
      return false;
    }
    return put_byte(buf, pos, (48 + (v % 10)) as u8);
  }
  return put_byte(buf, pos, (48 + v) as u8);
};

pub let put_i64 = func(buf: MutSlice(u8), pos: Mut(u64), v: i64) -> bool {
  if v < 0 {
    if put_byte(buf, pos, 45) == false {
      return false;
    }
    let mag: u64 = 0 - (v as u64);
    return put_u64(buf, pos, mag);
  }
  return put_u64(buf, pos, v as u64);
};

let hex_digit = func(v: u64) -> u8 {
  let d: u64 = v % 16;
  if d < 10 {
    return (48 + d) as u8;
  }
  return (97 + (d - 10)) as u8;
};

let put_control = func(buf: MutSlice(u8), pos: Mut(u64), c: u8) -> bool {
  if put_slice(buf, pos, "\\u00") == false {
    return false;
  }
  let hi: u64 = (c as u64) / 16;
  let lo: u64 = (c as u64) % 16;
  if put_byte(buf, pos, hex_digit(hi)) == false {
    return false;
  }
  return put_byte(buf, pos, hex_digit(lo));
};

pub let put_string = func(buf: MutSlice(u8), pos: Mut(u64), s: Slice(u8)) -> bool {
  if put_byte(buf, pos, 34) == false {
    return false;
  }
  let ok: bool = true;
  let i: u64 = 0;
  while (i < s.len) and ok {
    let ch: u8 = s[i];
    let w: bool = match ch {
      34 => put_slice(buf, pos, "\\\""),
      92 => put_slice(buf, pos, "\\\\"),
      10 => put_slice(buf, pos, "\\n"),
      9 => put_slice(buf, pos, "\\t"),
      13 => put_slice(buf, pos, "\\r"),
      _ => {
        if ch < 32 {
          put_control(buf, pos, ch)
        } else {
          put_byte(buf, pos, ch)
        }
      },
    };
    if w == false {
      ok = false;
    }
    i = i + 1;
  };
  if ok == false {
    return false;
  }
  return put_byte(buf, pos, 34);
};

pub let put_key = func(buf: MutSlice(u8), pos: Mut(u64), name: Slice(u8)) -> bool {
  if put_string(buf, pos, name) == false {
    return false;
  }
  return put_byte(buf, pos, 58);
};

pub let JsonLeaf = sig {
  pub let Self: Type;
  pub let write: Fn((Self, MutSlice(u8), Mut(u64)) -> bool);
};

pub let JsonU64: JsonLeaf = module {
  pub let Self = u64;
  pub let write = func(v: u64, buf: MutSlice(u8), pos: Mut(u64)) -> bool {
    return put_u64(buf, pos, v);
  };
};

pub let JsonI64: JsonLeaf = module {
  pub let Self = i64;
  pub let write = func(v: i64, buf: MutSlice(u8), pos: Mut(u64)) -> bool {
    return put_i64(buf, pos, v);
  };
};

pub let JsonBool: JsonLeaf = module {
  pub let Self = bool;
  pub let write = func(v: bool, buf: MutSlice(u8), pos: Mut(u64)) -> bool {
    if v {
      return put_slice(buf, pos, "true");
    }
    return put_slice(buf, pos, "false");
  };
};

pub let JsonStr: JsonLeaf = module {
  pub let Self = Slice(u8);
  pub let write = func(v: Slice(u8), buf: MutSlice(u8), pos: Mut(u64)) -> bool {
    return put_string(buf, pos, v);
  };
};

use JsonU64;
use JsonI64;
use JsonBool;
use JsonStr;

pub let write_leaf = func(v: T, buf: MutSlice(u8), pos: Mut(u64)) ?{ T: Type, l: JsonLeaf } -> bool {
  return l.write(v, buf, pos);
};

pub let JsonStructCodec = sig {
  pub let Self: Type;
  pub let encode: Fn((Self, MutSlice(u8), Mut(u64)) -> bool);
};

pub let StructCodec = func(T: Type) -> Module {
  return module {
    pub let Self = T;
    pub let encode = func(v: T, buf: MutSlice(u8), pos: Mut(u64)) -> bool {
      let ok: bool = true;
      let first: bool = true;
      if put_byte(buf, pos, 123) == false { ok = false; }
      comptime for f in fields_of(T) {
        if ok {
          if first == false {
            if put_byte(buf, pos, 44) == false { ok = false; }
          }
          if put_key(buf, pos, f.name) == false { ok = false; }
          let w: bool = write_leaf(v.[:f.name], buf, pos);
          if w == false { ok = false; }
          first = false;
        }
      }
      if ok == false {
        return false;
      }
      return put_byte(buf, pos, 125);
    };
  };
};

pub let write_struct = func(val: Ref(T), buf: MutSlice(u8), pos: Mut(u64)) ?{ T: Type, c: JsonStructCodec } -> bool {
  return c.encode(deref(val), buf, pos);
};

pub let JsonKind = enum {
  Null
  True
  False
  Int
  Str
  Arr
  Obj
};

pub let kind_code = func(k: JsonKind) -> u64 {
  return match k {
    Null => 0,
    True => 1,
    False => 2,
    Int => 3,
    Str => 4,
    Arr => 5,
    Obj => 6,
  };
};

pub let kind_enum = func(k: u64) -> JsonKind {
  return match k {
    0 => JsonKind.Null {},
    1 => JsonKind.True {},
    2 => JsonKind.False {},
    3 => JsonKind.Int {},
    4 => JsonKind.Str {},
    5 => JsonKind.Arr {},
    _ => JsonKind.Obj {},
  };
};

pub let JsonVal = struct {
  kind: u64,
  num: i64,
  str_val: Slice(u8),
  key: Slice(u8),
  child: u64,
  next: u64,
  tail: u64,
  count: u64,
};

pub let Frame = struct {
  node: u64,
  kind: JsonKind,
  sep: bool,
};

let init_node = func(out: Mut(JsonVal)) {
  deref(out).kind = kind_code(JsonKind.Null {});
  deref(out).num = 0;
  deref(out).str_val = "";
  deref(out).key = "";
  deref(out).child = 0;
  deref(out).next = 0;
  deref(out).tail = 0;
  deref(out).count = 0;
};

let init_container = func(node: Mut(JsonVal), kind: JsonKind) {
  deref(node).kind = kind_code(kind);
  deref(node).child = 0;
  deref(node).next = 0;
  deref(node).tail = 0;
  deref(node).count = 0;
};

let alloc_node = func(arena: Mut(mem.BumpArena.Arena)) -> u64 {
  let spot: u64 = mem.BumpArena.alloc(arena, size_of(JsonVal));
  if spot == 0 {
    return 0;
  }
  let node: Mut(JsonVal) = ptr_cast(Mut(JsonVal), spot);
  init_node(node);
  return spot;
};

let link_child = func(parent: Mut(JsonVal), spot: u64) {
  if deref(parent).count == 0 {
    deref(parent).child = spot;
  } else {
    let tail: Mut(JsonVal) = ptr_cast(Mut(JsonVal), deref(parent).tail);
    deref(tail).next = spot;
  }
  deref(parent).tail = spot;
  deref(parent).count = deref(parent).count + 1;
};

pub let skip_ws = func(input: Slice(u8), pos: Mut(u64)) -> u64 {
  let i: u64 = deref(pos);
  let done: bool = false;
  while done == false {
    if i >= input.len {
      deref(pos) = i;
      done = true;
    } else {
      let ch: u8 = input[i];
      if (ch == 32) or (ch == 9) or (ch == 10) or (ch == 13) {
        i = i + 1;
        deref(pos) = i;
      } else {
        done = true;
      }
    }
  };
  return deref(pos);
};

let peek = func(input: Slice(u8), pos: Mut(u64)) -> u8 {
  if deref(pos) >= input.len {
    return 0;
  }
  return input[deref(pos)];
};

let expect_lit = func(input: Slice(u8), pos: Mut(u64), lit: Slice(u8)) -> bool {
  if (deref(pos) + lit.len) > input.len {
    return false;
  }
  let ok: bool = true;
  let i: u64 = 0;
  while (i < lit.len) and ok {
    if input[deref(pos) + i] != lit[i] {
      ok = false;
    }
    i = i + 1;
  };
  if ok == false {
    return false;
  }
  deref(pos) = deref(pos) + lit.len;
  return true;
};

let is_digit = func(ch: u8) -> bool {
  if ch >= 48 {
    if ch <= 57 {
      return true;
    }
  }
  return false;
};

let parse_int = func(input: Slice(u8), pos: Mut(u64), out: Mut(i64)) -> bool {
  let neg: bool = false;
  if peek(input, pos) == 45 {
    neg = true;
    deref(pos) = deref(pos) + 1;
  }
  let acc: u64 = 0;
  let digits: u64 = 0;
  let i: u64 = 0;
  while i == 0 {
    let ch: u8 = peek(input, pos);
    if is_digit(ch) {
      acc = acc * 10 + ((ch - 48) as u64);
      deref(pos) = deref(pos) + 1;
      digits = digits + 1;
    } else {
      i = 1;
    }
  };
  if digits == 0 {
    return false;
  }
  if neg {
    deref(out) = 0 - (acc as i64);
  } else {
    deref(out) = acc as i64;
  }
  return true;
};

let decode_escape = func(ch: u8, out: Mut(u8)) -> bool {
  if ch == 34 { deref(out) = 34; return true; }
  if ch == 92 { deref(out) = 92; return true; }
  if ch == 47 { deref(out) = 47; return true; }
  if ch == 98 { deref(out) = 8; return true; }
  if ch == 102 { deref(out) = 12; return true; }
  if ch == 110 { deref(out) = 10; return true; }
  if ch == 114 { deref(out) = 13; return true; }
  if ch == 116 { deref(out) = 9; return true; }
  return false;
};

let parse_string = func(arena: Mut(mem.BumpArena.Arena), input: Slice(u8), pos: Mut(u64), out: Mut(Slice(u8))) -> bool {
  deref(pos) = deref(pos) + 1;
  let end: u64 = 0;
  let dec: u64 = 0;
  let state: u64 = 1;
  loop c(i: u64 = deref(pos)) while state == 1 {
    if i >= input.len {
      state = 0;
    } else {
      let ch: u8 = input[i];
      if ch == 92 {
        if (i + 1) >= input.len {
          state = 0;
        } else {
          i = i + 2;
          dec = dec + 1;
        }
      } else {
        if ch == 34 {
          end = i;
          state = 2;
        } else {
          i = i + 1;
          dec = dec + 1;
        }
      }
    }
  };
  if state != 2 {
    return false;
  }
  let dst: Mut(u8) = null_ref(Mut(u8));
  if dec > 0 {
    let spot: u64 = mem.BumpArena.alloc(arena, dec);
    if spot == 0 {
      return false;
    }
    dst = ptr_cast(Mut(u8), spot);
  }
  let src: u64 = deref(pos);
  let written: u64 = 0;
  let dec_ok: bool = true;
  let i: u64 = src;
  while i < end {
    let ch: u8 = input[i];
    if ch == 92 {
      let target: Mut(u8) = dst + written;
      let escaped: u8 = input[i + 1];
      if decode_escape(escaped, target) == false {
        dec_ok = false;
      }
      i = i + 2;
    } else {
      let target2: Mut(u8) = dst + written;
      deref(target2) = ch;
      i = i + 1;
    }
    written = written + 1;
  };
  if dec_ok == false {
    return false;
  }
  deref(out) = make_slice(Slice(u8), ptr_cast(Ref(u8), dst as u64), dec);
  deref(pos) = end + 1;
  return true;
};

let parse_scalar = func(arena: Mut(mem.BumpArena.Arena), input: Slice(u8), pos: Mut(u64), out: Mut(JsonVal)) -> bool {
  let ch: u8 = peek(input, pos);
  if ch == 110 {
    if expect_lit(input, pos, "null") == false { return false; }
    deref(out).kind = kind_code(JsonKind.Null {});
    return true;
  }
  if ch == 116 {
    if expect_lit(input, pos, "true") == false { return false; }
    deref(out).kind = kind_code(JsonKind.True {});
    return true;
  }
  if ch == 102 {
    if expect_lit(input, pos, "false") == false { return false; }
    deref(out).kind = kind_code(JsonKind.False {});
    return true;
  }
  if ch == 34 {
    let s0: Slice(u8) = "";
    let sp: Mut(Slice(u8)) = mut_of(s0);
    if parse_string(arena, input, pos, sp) == false { return false; }
    deref(out).kind = kind_code(JsonKind.Str {});
    deref(out).str_val = s0;
    return true;
  }
  let num: i64 = 0;
  if parse_int(input, pos, mut_of(num)) == false { return false; }
  deref(out).kind = kind_code(JsonKind.Int {});
  deref(out).num = num;
  return true;
};

pub let parse = func(arena: Mut(mem.BumpArena.Arena), input: Slice(u8), out: Mut(JsonVal)) -> bool {
  init_node(out);
  let pos: u64 = 0;
  let p: Mut(u64) = mut_of(pos);
  let ws0: u64 = skip_ws(input, p);
  let ch: u8 = peek(input, p);
  if (ch != 123) and (ch != 91) {
    if parse_scalar(arena, input, p, out) == false {
      return false;
    }
    let ws1: u64 = skip_ws(input, p);
    return pos == input.len;
  }

  let kind: JsonKind = if ch == 123 { JsonKind.Obj {} } else { JsonKind.Arr {} };
  init_container(out, kind);
  let frames_addr: u64 = mem.BumpArena.alloc(arena, 64 * size_of(Frame));
  if frames_addr == 0 {
    return false;
  }
  let frames_ptr: Mut(Frame) = ptr_cast(Mut(Frame), frames_addr);
  let frames: MutSlice(Frame) = make_slice(MutSlice(Frame), frames_ptr, 64);
  frames[0] = Frame { node: out as u64, kind: kind, sep: false };
  let depth: u64 = 1;
  deref(p) = deref(p) + 1;

  let ok: bool = true;
  let guard: u64 = 0;
  while (depth > 0) and ok {
    let idx: u64 = depth - 1;
    let top: Frame = frames[idx];
    let ws: u64 = skip_ws(input, p);
    let cch: u8 = peek(input, p);
    let close: u8 = match top.kind {
      Obj => 125,
      _ => 93,
    };
    if cch == 0 {
      ok = false;
    } else {
      if top.sep {
        if cch == 44 {
          deref(p) = deref(p) + 1;
          frames[idx] = Frame { node: top.node, kind: top.kind, sep: false };
        } else {
          if cch == close {
            deref(p) = deref(p) + 1;
            depth = depth - 1;
          } else {
            ok = false;
          }
        }
      } else {
        let parent: Mut(JsonVal) = ptr_cast(Mut(JsonVal), top.node);
        if cch == close {
          if deref(parent).count == 0 {
            deref(p) = deref(p) + 1;
            depth = depth - 1;
          } else {
            ok = false;
          }
        } else {
          let is_obj: bool = match top.kind {
            Obj => true,
            _ => false,
          };
          let key_slice: Slice(u8) = "";
          if is_obj {
            if cch != 34 {
              ok = false;
            } else {
              let kp: Mut(Slice(u8)) = mut_of(key_slice);
              if parse_string(arena, input, p, kp) == false {
                ok = false;
              } else {
                let ws2: u64 = skip_ws(input, p);
                if peek(input, p) != 58 {
                  ok = false;
                } else {
                  deref(p) = deref(p) + 1;
                  let ws3: u64 = skip_ws(input, p);
                }
              }
            }
          }
          if ok {
            let child_addr: u64 = alloc_node(arena);
            if child_addr == 0 {
              ok = false;
            } else {
              let child: Mut(JsonVal) = ptr_cast(Mut(JsonVal), child_addr);
              if is_obj {
                deref(child).key = key_slice;
              }
              let vch: u8 = peek(input, p);
              if (vch == 123) or (vch == 91) {
                let ck: JsonKind = if vch == 123 { JsonKind.Obj {} } else { JsonKind.Arr {} };
                init_container(child, ck);
                link_child(parent, child_addr);
                deref(p) = deref(p) + 1;
                frames[idx] = Frame { node: top.node, kind: top.kind, sep: true };
                if depth >= 64 {
                  ok = false;
                } else {
                  frames[depth] = Frame { node: child_addr, kind: ck, sep: false };
                  depth = depth + 1;
                }
              } else {
                if parse_scalar(arena, input, p, child) == false {
                  ok = false;
                } else {
                  link_child(parent, child_addr);
                  frames[idx] = Frame { node: top.node, kind: top.kind, sep: true };
                }
              }
            }
          }
        }
      }
    }
  };
  if ok == false {
    return false;
  }
  if depth != 0 {
    return false;
  }
  let ws4: u64 = skip_ws(input, p);
  return pos == input.len;
};

let stringify_val = func(v: Ref(JsonVal), buf: MutSlice(u8), pos: Mut(u64)) -> bool {
  let kind: JsonKind = kind_enum(deref(v).kind);
  let shape: u64 = match kind {
    Arr => 1,
    Obj => 2,
    _ => 0,
  };
  if shape == 0 {
    return match kind {
      Null => put_slice(buf, pos, "null"),
      True => put_slice(buf, pos, "true"),
      False => put_slice(buf, pos, "false"),
      Int => put_i64(buf, pos, deref(v).num),
      Str => put_string(buf, pos, deref(v).str_val),
      _ => false,
    };
  }
  let is_arr: bool = shape == 1;
  let open_ch: u8 = if is_arr { 91 } else { 123 };
  let close_ch: u8 = if is_arr { 93 } else { 125 };
  if put_byte(buf, pos, open_ch) == false {
    return false;
  }
  let ok: bool = true;
  let cur: u64 = deref(v).child;
  let first: bool = true;
  while cur != 0 {
    if first == false {
      if put_byte(buf, pos, 44) == false { ok = false; }
    }
    let node: Ref(JsonVal) = ptr_cast(Ref(JsonVal), cur);
    if is_arr == false {
      if put_string(buf, pos, deref(node).key) == false { ok = false; }
      if put_byte(buf, pos, 58) == false { ok = false; }
    }
    if stringify_val(node, buf, pos) == false { ok = false; }
    cur = deref(node).next;
    first = false;
  };
  if ok == false {
    return false;
  }
  return put_byte(buf, pos, close_ch);
};

pub let stringify = func(v: Ref(JsonVal), buf: MutSlice(u8), pos: Mut(u64)) -> bool {
  return stringify_val(v, buf, pos);
};
