let io = import("std::io");

pub let Suite = struct {
  name: Slice(u8),
  passed: u64,
  failed: u64,
};

pub let suite = func(name: Slice(u8)) -> Suite {
  return Suite { name: name, passed: 0, failed: 0 };
};

let bytes_same = func(a: Slice(u8), b: Slice(u8)) -> bool {
  if a.len != b.len { return false; }
  let same: u64 = loop cmp(i: u64 = 0, ok: u64 = 1) while i < a.len {
    if a[i] != b[i] { ok = 0; }
    i = i + 1;
  };
  return same == 1;
};

let fail_head = func(s: Mut(Suite), label: Slice(u8)) -> u64 {
  io.print("[FAIL] ");
  io.print(s.name);
  io.print(" :: ");
  io.print(label);
  s.failed = s.failed + 1;
  return 0;
};

let pass_one = func(s: Mut(Suite)) -> bool {
  s.passed = s.passed + 1;
  return true;
};

pub let check = func(s: Mut(Suite), label: Slice(u8), cond: bool) -> bool {
  if cond { return pass_one(s); }
  fail_head(s, label);
  io.newline();
  return false;
};

pub let eq_i64 = func(s: Mut(Suite), label: Slice(u8), got: i64, want: i64) -> bool {
  if got == want { return pass_one(s); }
  fail_head(s, label);
  io.print(": expected ");
  io.print_i64(want);
  io.print(", got ");
  io.print_i64(got);
  io.newline();
  return false;
};

pub let eq_u64 = func(s: Mut(Suite), label: Slice(u8), got: u64, want: u64) -> bool {
  if got == want { return pass_one(s); }
  fail_head(s, label);
  io.print(": expected ");
  io.print_u64(want);
  io.print(", got ");
  io.print_u64(got);
  io.newline();
  return false;
};

let bool_text = func(v: bool) -> u64 {
  if v { return io.print("true"); }
  return io.print("false");
};

pub let eq_bool = func(s: Mut(Suite), label: Slice(u8), got: bool, want: bool) -> bool {
  if got == want { return pass_one(s); }
  fail_head(s, label);
  io.print(": expected ");
  bool_text(want);
  io.print(", got ");
  bool_text(got);
  io.newline();
  return false;
};

pub let eq_bytes = func(s: Mut(Suite), label: Slice(u8), got: Slice(u8), want: Slice(u8)) -> bool {
  if bytes_same(got, want) { return pass_one(s); }
  fail_head(s, label);
  io.print(": expected ");
  io.print(want);
  io.print(", got ");
  io.print(got);
  io.newline();
  return false;
};

pub let finish = func(s: Mut(Suite)) -> i64 {
  if s.failed == 0 {
    io.print("[PASS] ");
    io.print(s.name);
    io.print(" (");
    io.print_u64(s.passed);
    io.print("/");
    io.print_u64(s.passed + s.failed);
    io.println(")");
  } else {
    io.print("[FAIL] ");
    io.print(s.name);
    io.print(" (");
    io.print_u64(s.failed);
    io.println(" failed)");
  }
  return s.failed as i64;
};
