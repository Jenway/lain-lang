// std/env.lain — Command-line arguments and environment
// Note: @foreign(c) functions bound to pure C functions should NOT
// have effect annotations (! {IO} etc.) — effects inject extra
// context parameters that C functions don't expect.

@foreign(c, link_name = "native_get_arg_count")
@export
let arg_count = std::func() -> i32;

@foreign(c, link_name = "native_get_arg")
@export
let arg = std::func(idx: i32) -> addr;
