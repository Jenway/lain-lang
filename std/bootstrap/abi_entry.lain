// Stable ABI entry points for the formal standard-library artifact.
//
// The formal source closure is now able to publish the same five entry names
// as the bootstrap library.  Semantic lowering is intentionally reported as
// unsupported until the corresponding Meta passes are migrated here; this
// keeps the replacement boundary explicit instead of silently falling back to
// compiler-core code.

@foreign(c, link_name = "lain_ast_v1_nil")
let ast_nil = std::func() -> addr;

@foreign(c, link_name = "lain_meta_pass_result_v1_new")
let pass_result_new = std::func(
    status: i32,
    changed: i64,
    result: addr,
    diagnostic: addr,
    dependencies: addr,
    owner: addr,
) -> addr;

@foreign(c, link_name = "lain_compile_context_v1_owner")
let context_owner = std::func(context: addr) -> addr;

@foreign(c, link_name = "bootstrap.source-count")
let source_count = std::func() -> i64;

@foreign(c, link_name = "bootstrap.source-data")
let source_data = std::func(index: i64) -> addr;

@foreign(c, link_name = "bootstrap.source-length")
let source_length = std::func(index: i64) -> i64;

@foreign(c, link_name = "bootstrap.allocate-pages")
let allocate_pages = std::func(size: i64) -> addr;

@foreign(c, link_name = "tool_source_new")
let source_new = std::func(data: addr, length: i64) -> addr;

@foreign(c, link_name = "tool_lex_all")
let lex_all = std::func(source: addr) -> addr;

@foreign(c, link_name = "raw_parse")
let raw_parse = std::func(source: addr, tokens: addr) -> addr;

@foreign(c, link_name = "raw_node_first")
let raw_first = std::func(node: addr) -> addr;

@foreign(c, link_name = "raw_node_next")
let raw_next = std::func(node: addr) -> addr;

@foreign(c, link_name = "raw_node_start")
let raw_start = std::func(node: addr) -> i64;

@foreign(c, link_name = "raw_node_length")
let raw_length = std::func(node: addr) -> i64;

@foreign(c, link_name = "raw_is_nil")
let raw_nil = std::func(node: addr) -> bool;

// Syntax-index layout: count @0, cache @8, then 64-byte entries at @16.
// Every entry stores source index, source, root, first node, node count,
// import count, root span start and root span length.  Import target
// resolution remains the next migration slice; parsing and indexing all
// supplied sources already happens here.
let syntax_node_count = std::func(node: addr) -> i64 {
    if raw_nil(node) {
        return 0;
    }
    let next: addr = raw_next(node);
    return 1 + syntax_node_count(next);
};

let syntax_entry_at = std::func(index: addr, ordinal: i64) -> addr {
    if ordinal == 0 {
        return index + 16;
    }
    return syntax_entry_at(index, ordinal - 1) + 64;
};

@abi_export
let syntax_units_build = std::func() -> addr {
    let count: i64 = source_count();
    let bytes: i64 = 16;
    let size_ordinal: i64 = 0;
    while size_ordinal < count {
        bytes = bytes + 64;
        size_ordinal = size_ordinal + 1;
    }
    let index: addr = allocate_pages(bytes);
    std::store_bits(64, index + 0, count);
    std::store_bits(64, index + 8, 0);
    let ordinal: i64 = 0;
    while ordinal < count {
        let source: addr = source_new(
            source_data(ordinal),
            source_length(ordinal),
        );
        let root: addr = raw_parse(source, lex_all(source));
        let first: addr = raw_first(root);
        let node_count: i64 = syntax_node_count(first);
        let entry: addr = syntax_entry_at(index, ordinal);
        std::store_bits(64, entry + 0, ordinal);
        std::store_bits(64, entry + 8, source as usize);
        std::store_bits(64, entry + 16, root as usize);
        std::store_bits(64, entry + 24, first as usize);
        std::store_bits(64, entry + 32, node_count);
        std::store_bits(64, entry + 40, 0);
        std::store_bits(64, entry + 48, raw_start(root));
        std::store_bits(64, entry + 56, raw_length(root));
        ordinal = ordinal + 1;
    }
    return index;
};

@abi_export
let syntax_index_count = std::func(index: addr) -> i64 {
    return std::load_bits(64, index + 0);
};

@abi_export
let syntax_index_entry = std::func(index: addr, ordinal: i64) -> addr {
    return syntax_entry_at(index, ordinal);
};

@abi_export
let lain_std_abi_version = std::func() -> i64 {
    return 1;
};

@abi_export
let lain_std_initialize = std::func(context: addr) -> i32 {
    return 0;
};

@abi_export
let lain_std_expand = std::func(
    context: addr,
    source_unit: addr,
    root: addr,
) -> addr {
    return pass_result_new(
        0,
        0,
        root,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};

@abi_export
let lain_std_elaborate = std::func(
    context: addr,
    expanded_root: addr,
) -> addr {
    return pass_result_new(
        0,
        0,
        expanded_root,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};

@abi_export
let lain_std_lower = std::func(
    context: addr,
    elaborated_root: addr,
    l1_unit: addr,
) -> addr {
    // 5203 is the stable "formal std lowering unavailable" boundary
    // diagnostic.  The bootstrap implementation remains the active lowering
    // provider until this pass is migrated from LAIN-IR into formal std.
    return pass_result_new(
        5203,
        0,
        l1_unit,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};
