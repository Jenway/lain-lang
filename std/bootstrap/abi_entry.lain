// Stable ABI entry points for the formal standard-library artifact.
//
// The formal source closure is now able to publish the same five entry names
// as the bootstrap library.  Semantic lowering is intentionally reported as
// unsupported until the corresponding Meta passes are migrated here; this
// keeps the replacement boundary explicit instead of silently falling back to
// compiler-core code.

@foreign(c, link_name = "lain_ast_v1_nil")
let ast_nil = std::func() -> addr;

@foreign(c, link_name = "lain_meta_pass_result_v1_new")
let pass_result_new = std::func(
    status: i32,
    changed: i64,
    result: addr,
    diagnostic: addr,
    dependencies: addr,
    owner: addr,
) -> addr;

@foreign(c, link_name = "lain_compile_context_v1_owner")
let context_owner = std::func(context: addr) -> addr;

@foreign(c, link_name = "bootstrap.source-count")
let source_count = std::func() -> i64;

@foreign(c, link_name = "bootstrap.source-data")
let source_data = std::func(index: i64) -> addr;

@foreign(c, link_name = "bootstrap.source-length")
let source_length = std::func(index: i64) -> i64;

@foreign(c, link_name = "bootstrap.source-path-data")
let source_path_data = std::func(index: i64) -> addr;

@foreign(c, link_name = "bootstrap.source-path-length")
let source_path_length = std::func(index: i64) -> i64;

@foreign(c, link_name = "bootstrap.allocate-pages")
let allocate_pages = std::func(size: i64) -> addr;

@foreign(c, link_name = "tool_source_new")
let source_new = std::func(data: addr, length: i64) -> addr;

@foreign(c, link_name = "tool_lex_all")
let lex_all = std::func(source: addr) -> addr;

@foreign(c, link_name = "raw_parse")
let raw_parse = std::func(source: addr, tokens: addr) -> addr;

let formal_meta: Module = import("std::meta");

// AST inspection belongs to formal std::meta.  Keep the local names only as
// thin adapters so the lowering code below has one vocabulary while the
// implementation and seed ABI boundary remain in the Meta library.
let raw_first = std::func(node: addr) -> addr {
    return formal_meta.meta_ast_first(node);
};

let raw_next = std::func(node: addr) -> addr {
    return formal_meta.meta_ast_next(node);
};

let raw_kind = std::func(node: addr) -> i32 {
    return formal_meta.meta_ast_kind(node);
};

let raw_delimiter = std::func(node: addr) -> i32 {
    return formal_meta.meta_ast_delimiter(node);
};

let raw_start = std::func(node: addr) -> i64 {
    return formal_meta.meta_ast_start(node);
};

let raw_length = std::func(node: addr) -> i64 {
    return formal_meta.meta_ast_length(node);
};

let raw_nil = std::func(node: addr) -> bool {
    return formal_meta.meta_ast_is_nil(node);
};

let source_bytes = std::func(source: addr) -> addr {
    return formal_meta.meta_source_data(source);
};

let byte_at = std::func(data: addr, index: i64) -> i8 {
    return formal_meta.meta_source_byte_at(data, index);
};

@foreign(c, link_name = "bootstrap.write-artifact")
let artifact_write = std::func(data: addr, length: i64) -> unit;

// Syntax-index layout: count @0, cache @8, then 64-byte entries at @16.
// Every entry stores source index, source, root, first node, node count,
// import count, root span start and root span length.  Import target
// resolution remains the next migration slice; parsing and indexing all
// supplied sources already happens here.
let formal_is_import = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 { return false; }
    if raw_length(node) != 6 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 105 { return false; }
    if byte_at(data, start + 1) != 109 { return false; }
    if byte_at(data, start + 2) != 112 { return false; }
    if byte_at(data, start + 3) != 111 { return false; }
    if byte_at(data, start + 4) != 114 { return false; }
    if byte_at(data, start + 5) != 116 { return false; }
    return true;
};

let formal_import_count = std::func(source: addr, node: addr) -> i64 {
    // Import declarations are represented by the root's lossless sibling
    // stream (`let name = import(...)`).  Counting that stream avoids walking
    // nested argument groups twice while still covering every declaration.
    if raw_nil(node) { return 0; }
    let count: i64 = 0;
    if formal_is_import(source, node) {
        count = count + 1;
    }
    count = count + formal_import_count(source, raw_next(node));
    return count;
};

let syntax_node_count = std::func(node: addr) -> i64 {
    if raw_nil(node) {
        return 0;
    }
    let next: addr = raw_next(node);
    return 1 + syntax_node_count(next);
};

let syntax_entry_at = std::func(index: addr, ordinal: i64) -> addr {
    if ordinal == 0 {
        return index + 16;
    }
    return syntax_entry_at(index, ordinal - 1) + 64;
};

@abi_export
let syntax_units_build = std::func() -> addr {
    let count: i64 = source_count();
    let bytes: i64 = 16;
    let size_ordinal: i64 = 0;
    while size_ordinal < count {
        bytes = bytes + 64;
        size_ordinal = size_ordinal + 1;
    }
    let index: addr = allocate_pages(bytes);
    std::store_bits(64, index + 0, count);
    std::store_bits(64, index + 8, 0);
    let ordinal: i64 = 0;
    while ordinal < count {
        let source: addr = source_new(
            source_data(ordinal),
            source_length(ordinal),
        );
        let root: addr = raw_parse(source, lex_all(source));
        let first: addr = raw_first(root);
        let node_count: i64 = syntax_node_count(first);
        let entry: addr = syntax_entry_at(index, ordinal);
        std::store_bits(64, entry + 0, ordinal);
        std::store_bits(64, entry + 8, source as usize);
        std::store_bits(64, entry + 16, root as usize);
        std::store_bits(64, entry + 24, first as usize);
        std::store_bits(64, entry + 32, node_count);
        std::store_bits(64, entry + 40, formal_import_count(source, first));
        std::store_bits(64, entry + 48, raw_start(root));
        std::store_bits(64, entry + 56, raw_length(root));
        ordinal = ordinal + 1;
    }
    return index;
};

@abi_export
let syntax_index_count = std::func(index: addr) -> i64 {
    return std::load_bits(64, index + 0);
};

@abi_export
let syntax_index_entry = std::func(index: addr, ordinal: i64) -> addr {
    return syntax_entry_at(index, ordinal);
};

@abi_export
let syntax_index_imports = std::func(index: addr, ordinal: i64) -> i64 {
    let entry: addr = syntax_entry_at(index, ordinal);
    return std::load_bits(64, entry + 40);
};

let syntax_index_root = std::func(index: addr, ordinal: i64) -> addr {
    let entry: addr = syntax_entry_at(index, ordinal);
    let root: addr = std::load_bits(64, entry + 16);
    return root;
};

let syntax_index_source = std::func(index: addr, ordinal: i64) -> addr {
    let entry: addr = syntax_entry_at(index, ordinal);
    let source: addr = std::load_bits(64, entry + 8);
    return source;
};

let formal_import_is_std = std::func(source: addr, argument: addr) -> bool {
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(argument);
    let length: i64 = raw_length(argument);
    if length < 7 { return false; }
    if byte_at(data, start) != 34 { return false; }
    if byte_at(data, start + 1) != 115 { return false; }
    if byte_at(data, start + 2) != 116 { return false; }
    if byte_at(data, start + 3) != 100 { return false; }
    if byte_at(data, start + 4) != 58 { return false; }
    if byte_at(data, start + 5) != 58 { return false; }
    return true;
};

let formal_import_suffix_matches = std::func(
    path: addr,
    path_length: i64,
    data: addr,
    start: i64,
    length: i64,
) -> bool {
    if length < 2 { return false; }
    if byte_at(data, start) != 34 { return false; }
    if byte_at(data, start + (length - 1)) != 34 { return false; }
    let name_start: i64 = start + 1;
    let name_end: i64 = start + (length - 1);
    let name_index: i64 = name_start;
    while name_index < name_end {
        if byte_at(data, name_index) == 58 {
            name_start = name_index + 1;
        }
        name_index = name_index + 1;
    }
    let name_length: i64 = name_end - name_start;
    let path_start: i64 = 0;
    let path_index: i64 = 0;
    while path_index < path_length {
        let value: i8 = byte_at(path, path_index);
        if value == 47 || value == 92 {
            path_start = path_index + 1;
        }
        path_index = path_index + 1;
    }
    let path_name_length: i64 = path_length - path_start;
    let explicit_extension: bool = false;
    if name_length >= 5 {
        if byte_at(data, name_end - 5) == 46 {
            explicit_extension = true;
        }
    }
    if explicit_extension == false && path_name_length >= 5 {
        if byte_at(path, path_length - 5) == 46 {
            path_name_length = path_name_length - 5;
        }
    }
    if name_length != path_name_length { return false; }
    let offset: i64 = 0;
    while offset < name_length {
        if byte_at(path, path_start + offset) !=
            byte_at(data, name_start + offset) {
            return false;
        }
        offset = offset + 1;
    }
    return true;
};

let formal_import_std_matches = std::func(
    path: addr,
    path_length: i64,
    data: addr,
    start: i64,
    length: i64,
) -> bool {
    if length < 7 { return false; }
    if byte_at(data, start) != 34 { return false; }
    if byte_at(data, start + 1) != 115 { return false; }
    if byte_at(data, start + 2) != 116 { return false; }
    if byte_at(data, start + 3) != 100 { return false; }
    if byte_at(data, start + 4) != 58 { return false; }
    if byte_at(data, start + 5) != 58 { return false; }
    if byte_at(data, start + (length - 1)) != 34 { return false; }
    let name_start: i64 = start + 6;
    let name_end: i64 = start + (length - 1);
    let path_start: i64 = 0;
    let path_index: i64 = 0;
    let path_limit: i64 = path_length - 3;
    while path_index < path_length {
        if path_index >= path_limit { break; }
        if byte_at(path, path_index) == 115 {
            if byte_at(path, path_index + 1) == 116 {
                if byte_at(path, path_index + 2) == 100 {
                    let after_std: i64 = path_index + 3;
                    if after_std < path_length {
                        let separator: i8 = byte_at(path, after_std);
                        if separator == 47 || separator == 92 {
                            path_start = after_std + 1;
                        }
                    }
                }
            }
        }
        path_index = path_index + 1;
    }
    if path_start == 0 { return false; }
    let path_end: i64 = path_length;
    if path_end >= 5 && byte_at(path, path_end - 5) == 46 {
        path_end = path_end - 5;
    }
    let import_index: i64 = name_start;
    let candidate_index: i64 = path_start;
    while import_index < name_end {
        if candidate_index >= path_end { return false; }
        let value: i8 = byte_at(data, import_index);
        if value == 58 {
            if import_index + 1 >= name_end { return false; }
            if byte_at(data, import_index + 1) != 58 { return false; }
            let separator: i8 = byte_at(path, candidate_index);
            if separator != 47 && separator != 92 { return false; }
            import_index = import_index + 2;
            candidate_index = candidate_index + 1;
        } else {
            if value != byte_at(path, candidate_index) { return false; }
            import_index = import_index + 1;
            candidate_index = candidate_index + 1;
        }
    }
    return candidate_index == path_end;
};

let formal_import_target = std::func(
    source: addr,
    argument: addr,
    source_count_value: i64,
) -> i64 {
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(argument);
    let length: i64 = raw_length(argument);
    let candidate: i64 = 0;
    while candidate < source_count_value {
        let path: addr = source_path_data(candidate);
        let path_length: i64 = source_path_length(candidate);
        if formal_import_is_std(source, argument) {
            if formal_import_std_matches(
                path, path_length, data, start, length
            ) { return candidate; }
        } else {
            if formal_import_suffix_matches(
                path, path_length, data, start, length
            ) { return candidate; }
        }
        candidate = candidate + 1;
    }
    return source_count_value;
};

let formal_import_target_at = std::func(
    source: addr,
    root: addr,
    source_count_value: i64,
    ordinal: i64,
) -> i64 {
    let seen: i64 = 0;
    let node: addr = raw_first(root);
    while raw_nil(node) == false {
        if formal_is_import(source, node) {
            if seen == ordinal {
                let group: addr = raw_next(node);
                if raw_nil(group) { return source_count_value; }
                if raw_delimiter(group) != 40 { return source_count_value; }
                let argument: addr = raw_first(group);
                if raw_nil(argument) { return source_count_value; }
                if raw_kind(argument) != 1 { return source_count_value; }
                return formal_import_target(
                    source, argument, source_count_value
                );
            }
            seen = seen + 1;
        }
        node = raw_next(node);
    }
    return source_count_value;
};

let formal_reaches_cycle = std::func(
    index: addr,
    start: i64,
    current: i64,
    source_count_value: i64,
    states: addr,
) -> bool {
    let state: i64 = std::load_bits(
        64, states + (current * 8)
    );
    if state == 1 { return true; }
    if state == 2 { return false; }
    std::store_bits(64, states + (current * 8), 1);
    let source: addr = syntax_index_source(index, current);
    let root: addr = syntax_index_root(index, current);
    let imports: i64 = syntax_index_imports(index, current);
    let ordinal: i64 = 0;
    while ordinal < imports {
        let target: i64 = formal_import_target_at(
            source, root, source_count_value, ordinal
        );
        if target < source_count_value {
            if target == start { return true; }
            if formal_reaches_cycle(
                index, start, target, source_count_value, states
            ) { return true; }
        }
        ordinal = ordinal + 1;
    }
    std::store_bits(64, states + (current * 8), 2);
    return false;
};

let formal_has_cycle = std::func(
    index: addr,
    source_index: i64,
    source_count_value: i64,
) -> bool {
    let states: addr = allocate_pages(source_count_value * 8);
    let ordinal: i64 = 0;
    while ordinal < source_count_value {
        std::store_bits(64, states + (ordinal * 8), 0);
        ordinal = ordinal + 1;
    }
    return formal_reaches_cycle(
        index, source_index, source_index, source_count_value, states
    );
};

let formal_imports_resolved = std::func(
    source: addr,
    root: addr,
    source_count_value: i64,
) -> bool {
    let node: addr = raw_first(root);
    while raw_nil(node) == false {
        if formal_is_import(source, node) {
            let group: addr = raw_next(node);
            if raw_nil(group) { return false; }
            if raw_delimiter(group) != 40 { return false; }
            let argument: addr = raw_first(group);
            if raw_nil(argument) { return false; }
            if raw_kind(argument) != 1 { return false; }
            let target: i64 = formal_import_target(
                source, argument, source_count_value
            );
            // std:: imports may be supplied by an external capability.  A
            // local non-std import must resolve to one of the source units.
            if target == source_count_value {
                if formal_import_is_std(source, argument) == false {
                    return false;
                }
            }
        }
        node = raw_next(node);
    }
    return true;
};

let formal_import_status = std::func(index: addr) -> i32 {
    let count: i64 = syntax_index_count(index);
    let ordinal: i64 = 0;
    while ordinal < count {
        let source: addr = syntax_index_source(index, ordinal);
        let root: addr = syntax_index_root(index, ordinal);
        if formal_imports_resolved(source, root, count) == false {
            return 4101;
        }
        ordinal = ordinal + 1;
    }
    ordinal = 0;
    while ordinal < count {
        if formal_has_cycle(index, ordinal, count) {
            return 4103;
        }
        ordinal = ordinal + 1;
    }
    return 0;
};

@abi_export
let syntax_index_import_status = std::func() -> i32 {
    return formal_import_status(syntax_units_build());
};

let formal_is_return = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 { return false; }
    if raw_length(node) != 6 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 114 { return false; }
    if byte_at(data, start + 1) != 101 { return false; }
    if byte_at(data, start + 2) != 116 { return false; }
    if byte_at(data, start + 3) != 117 { return false; }
    if byte_at(data, start + 4) != 114 { return false; }
    if byte_at(data, start + 5) != 110 { return false; }
    return true;
};

let formal_decimal_bytes = std::func(
    data: addr,
    start: i64,
    length: i64,
    index: i64,
) -> bool {
    if index >= length { return true; }
    let value: i8 = byte_at(data, start + index);
    if value < 48 || value > 57 { return false; }
    return formal_decimal_bytes(data, start, length, index + 1);
};

let formal_is_decimal = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 { return false; }
    let length: i64 = raw_length(node);
    if length == 0 { return false; }
    return formal_decimal_bytes(
        source_bytes(source), raw_start(node), length, 0
    );
};

let formal_is_single_decimal_argument = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let argument: addr = raw_first(arguments);
    if formal_is_decimal(source, argument) {
        let next: addr = raw_next(argument);
        if raw_nil(next) { return true; }
    }
    return false;
};

let formal_is_single_arithmetic_argument = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let left: addr = raw_first(arguments);
    let operator: addr = raw_next(left);
    let right: addr = raw_next(operator);
    let tail: addr = raw_next(right);
    if formal_is_decimal(source, left)
        && formal_is_operator(source, operator)
        && formal_is_decimal(source, right)
        && raw_nil(tail) {
        return true;
    }
    return false;
};

let formal_is_comma = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 1 { return false; }
    return byte_at(source_bytes(source), raw_start(node)) == 44;
};

let formal_is_two_decimal_arguments = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let first: addr = raw_first(arguments);
    if formal_is_decimal(source, first) {
        let comma: addr = raw_next(first);
        if formal_is_comma(source, comma) {
            let second: addr = raw_next(comma);
            if formal_is_decimal(source, second) {
                let tail: addr = raw_next(second);
                if raw_nil(tail) { return true; }
            }
        }
    }
    return false;
};

let formal_is_operator = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 1 { return false; }
    let value: i8 = byte_at(source_bytes(source), raw_start(node));
    if value == 43 || value == 45 || value == 42 || value == 47 {
        return true;
    }
    return false;
};

let formal_is_arithmetic_group = std::func(
    source: addr,
    node: addr,
) -> bool {
    if raw_kind(node) != 2 || raw_delimiter(node) != 40 { return false; }
    let left: addr = raw_first(node);
    let operator: addr = raw_next(left);
    let right: addr = raw_next(operator);
    let tail: addr = raw_next(right);
    if formal_is_decimal(source, left)
        && formal_is_operator(source, operator)
        && formal_is_decimal(source, right)
        && raw_nil(tail) {
        return true;
    }
    return false;
};

let formal_is_semicolon = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 1 { return false; }
    return byte_at(source_bytes(source), raw_start(node)) == 59;
};

let formal_return_is_arithmetic = std::func(
    source: addr,
    return_node: addr,
) -> bool {
    let value: addr = raw_next(return_node);
    if formal_is_arithmetic_group(source, value) { return true; }
    let operator: addr = raw_next(value);
    let right: addr = raw_next(operator);
    if formal_is_operator(source, operator) {
        if formal_is_decimal(source, right) { return true; }
    }
    return false;
};

let formal_find_return_list = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_return(source, node) {
        let value: addr = raw_next(node);
        if formal_is_arithmetic_group(source, value) {
            if formal_is_semicolon(source, raw_next(value)) { return node; }
        }
        if formal_is_decimal(source, value) {
            let operator: addr = raw_next(value);
            if formal_is_semicolon(source, operator) { return node; }
            if formal_is_operator(source, operator) {
                let right: addr = raw_next(operator);
                if formal_is_decimal(source, right) {
                    if formal_is_semicolon(source, raw_next(right)) {
                        return node;
                    }
                }
            }
        }
    }
    return formal_find_return_list(source, raw_next(node));
};

let formal_is_unit_return = std::func(source: addr, node: addr) -> bool {
    if formal_is_return(source, node) {
        let value: addr = raw_next(node);
        if formal_is_semicolon(source, value) { return true; }
    }
    return false;
};

let formal_find_unit_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_unit_return(source, node) { return node; }
    return formal_find_unit_return_list(source, raw_next(node));
};

let formal_find_unit_return_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 123 {
            let value: addr = formal_find_unit_return_list(
                source, raw_first(node)
            );
            if raw_nil(value) == false { return value; }
        }
    }
    return formal_find_unit_return_body(source, raw_next(node));
};

let formal_find_parameter_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_return(source, node) {
        let value: addr = raw_next(node);
        let operator: addr = raw_next(value);
        let right: addr = raw_next(operator);
        if raw_kind(value) == 1 {
            if formal_is_operator(source, operator) {
                if formal_is_decimal(source, right) {
                    if formal_is_semicolon(source, raw_next(right)) {
                        return node;
                    }
                }
            }
        }
    }
    return formal_find_parameter_return_list(source, raw_next(node));
};

let formal_find_two_parameter_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_return(source, node) {
        let left: addr = raw_next(node);
        let operator: addr = raw_next(left);
        let right: addr = raw_next(operator);
        if raw_kind(left) == 1 {
            if raw_kind(right) == 1 {
                if formal_is_operator(source, operator) {
                    if formal_is_decimal(source, left) == false {
                        if formal_is_decimal(source, right) == false {
                            if formal_is_semicolon(source, raw_next(right)) {
                                return node;
                            }
                        }
                    }
                }
            }
        }
    }
    return formal_find_two_parameter_return_list(source, raw_next(node));
};

let formal_find_return_body = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 123 {
            let value: addr = formal_find_return_list(source, raw_first(node));
            if raw_nil(value) == false { return value; }
        }
    }
    return formal_find_return_body(source, raw_next(node));
};

let formal_is_let = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 3 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 108 { return false; }
    if byte_at(data, start + 1) != 101 { return false; }
    return byte_at(data, start + 2) == 116;
};

let formal_is_main = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 4 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 109 { return false; }
    if byte_at(data, start + 1) != 97 { return false; }
    if byte_at(data, start + 2) != 105 { return false; }
    return byte_at(data, start + 3) == 110;
};

let formal_name_matches = std::func(
    source: addr,
    left: addr,
    right: addr,
) -> bool {
    if raw_kind(left) != 1 || raw_kind(right) != 1 { return false; }
    let length: i64 = raw_length(left);
    if length != raw_length(right) { return false; }
    let data: addr = source_bytes(source);
    let left_start: i64 = raw_start(left);
    let right_start: i64 = raw_start(right);
    let index: i64 = 0;
    while index < length {
        if byte_at(data, left_start + index)
            != byte_at(data, right_start + index) { return false; }
        index = index + 1;
    }
    return true;
};

let formal_is_equals = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 1 { return false; }
    return byte_at(source_bytes(source), raw_start(node)) == 61;
};

let formal_find_local_scalar_binding = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_let(source, node) {
        let name: addr = raw_next(node);
        let equals: addr = raw_next(name);
        let value: addr = raw_next(equals);
        let semicolon: addr = raw_next(value);
        if raw_kind(name) == 1
            && formal_is_equals(source, equals)
            && formal_is_decimal(source, value)
            && formal_is_semicolon(source, semicolon) {
            return node;
        }
    }
    return formal_find_local_scalar_binding(source, raw_next(node));
};

let formal_find_named_return_list = std::func(
    source: addr,
    node: addr,
    name: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_return(source, node) {
        let value: addr = raw_next(node);
        let operator: addr = raw_next(value);
        let right: addr = raw_next(operator);
        if formal_name_matches(source, value, name) {
            if formal_is_semicolon(source, operator) { return node; }
            if formal_is_operator(source, operator)
                && formal_is_decimal(source, right)
                && formal_is_semicolon(source, raw_next(right)) {
                return node;
            }
        }
    }
    return formal_find_named_return_list(source, raw_next(node), name);
};

let formal_find_body_after = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 123 { return node; }
    }
    return formal_find_body_after(source, raw_next(node));
};

let formal_find_main_body = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_let(source, node) {
        let name: addr = raw_next(node);
        if formal_is_main(source, name) {
            return formal_find_body_after(source, raw_next(name));
        }
    }
    return formal_find_main_body(source, raw_next(node));
};

let formal_find_named_body = std::func(
    source: addr,
    node: addr,
    wanted: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_let(source, node) {
        let name: addr = raw_next(node);
        if formal_name_matches(source, name, wanted) {
            return formal_find_body_after(source, raw_next(name));
        }
    }
    return formal_find_named_body(source, raw_next(node), wanted);
};

let formal_find_parameter_group_after = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 40 { return node; }
    }
    return formal_find_parameter_group_after(source, raw_next(node));
};

let formal_find_named_parameter_group = std::func(
    source: addr,
    node: addr,
    wanted: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_let(source, node) {
        let name: addr = raw_next(node);
        if formal_name_matches(source, name, wanted) {
            return formal_find_parameter_group_after(source, raw_next(name));
        }
    }
    return formal_find_named_parameter_group(source, raw_next(node), wanted);
};

let formal_second_parameter = std::func(source: addr, group: addr) -> addr {
    let first: addr = raw_first(group);
    let colon: addr = raw_next(first);
    let type_name: addr = raw_next(colon);
    let comma: addr = raw_next(type_name);
    if formal_is_comma(source, comma) { return raw_next(comma); }
    return ast_nil();
};

let formal_find_call_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_return(source, node) {
        let callee: addr = raw_next(node);
        if raw_kind(callee) == 1 {
            let probe1: addr = raw_next(callee);
            if raw_kind(probe1) == 2 {
                if raw_delimiter(probe1) == 40 {
                    if raw_nil(raw_first(probe1)) {
                        return node;
                    }
                    if formal_is_single_decimal_argument(source, probe1) {
                        return node;
                    }
                    if formal_is_single_arithmetic_argument(source, probe1) {
                        return node;
                    }
                    if formal_is_two_decimal_arguments(source, probe1) {
                        return node;
                    }
                }
            }
        }
    }
    return formal_find_call_return_list(source, raw_next(node));
};

let formal_find_call_return_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 123 {
            let value: addr = formal_find_call_return_list(source, raw_first(node));
            if raw_nil(value) == false { return value; }
        }
    }
    return formal_find_call_return_body(source, raw_next(node));
};

let formal_is_if = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 2 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 105 { return false; }
    return byte_at(data, start + 1) == 102;
};

let formal_is_else = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 4 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 101 { return false; }
    if byte_at(data, start + 1) != 108 { return false; }
    if byte_at(data, start + 2) != 115 { return false; }
    return byte_at(data, start + 3) == 101;
};

let formal_is_true = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 4 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 116 { return false; }
    if byte_at(data, start + 1) != 114 { return false; }
    if byte_at(data, start + 2) != 117 { return false; }
    return byte_at(data, start + 3) == 101;
};

let formal_is_false = std::func(source: addr, node: addr) -> bool {
    if raw_kind(node) != 1 || raw_length(node) != 5 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    if byte_at(data, start) != 102 { return false; }
    if byte_at(data, start + 1) != 97 { return false; }
    if byte_at(data, start + 2) != 108 { return false; }
    if byte_at(data, start + 3) != 115 { return false; }
    return byte_at(data, start + 4) == 101;
};

let formal_is_comparison_operator = std::func(
    source: addr,
    node: addr,
) -> bool {
    if raw_kind(node) != 1 || raw_length(node) == 0 { return false; }
    let data: addr = source_bytes(source);
    let start: i64 = raw_start(node);
    let length: i64 = raw_length(node);
    if length == 2 {
        let first: i8 = byte_at(data, start);
        let second: i8 = byte_at(data, start + 1);
        if first == 61 && second == 61 { return true; }
        if first == 33 && second == 61 { return true; }
        if first == 60 && second == 61 { return true; }
        if first == 62 && second == 61 { return true; }
    }
    if length == 1 {
        let value: i8 = byte_at(data, start);
        if value == 60 || value == 62 { return true; }
    }
    return false;
};

let formal_find_if_list = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_if(source, node) {
        let condition: addr = raw_next(node);
        let then_group: addr = raw_next(condition);
        if raw_kind(then_group) == 2 {
            if raw_delimiter(then_group) == 123 {
                let else_word: addr = raw_next(then_group);
                if formal_is_else(source, else_word) {
                    let else_group: addr = raw_next(else_word);
                    if raw_kind(else_group) == 2 {
                        if raw_delimiter(else_group) == 123 {
                            return node;
                        }
                    }
                }
            }
        }
        if formal_is_comparison_operator(source, then_group) {
            let right: addr = raw_next(then_group);
            let branch: addr = raw_next(right);
            if formal_is_decimal(source, condition) {
                if formal_is_decimal(source, right) {
                    if raw_kind(branch) == 2 {
                        if raw_delimiter(branch) == 123 {
                            let else_word: addr = raw_next(branch);
                            if formal_is_else(source, else_word) {
                                let else_group: addr = raw_next(else_word);
                                if raw_kind(else_group) == 2 {
                                    if raw_delimiter(else_group) == 123 {
                                        return node;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return formal_find_if_list(source, raw_next(node));
};

let formal_find_if_body = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if raw_kind(node) == 2 {
        if raw_delimiter(node) == 123 {
            let value: addr = formal_find_if_list(source, raw_first(node));
            if raw_nil(value) == false { return value; }
        }
    }
    return formal_find_if_body(source, raw_next(node));
};

let formal_find_if_token = std::func(source: addr, node: addr) -> addr {
    if raw_nil(node) { return ast_nil(); }
    if formal_is_if(source, node) { return node; }
    if raw_kind(node) == 2 {
        let nested: addr = formal_find_if_token(source, raw_first(node));
        if raw_nil(nested) == false { return nested; }
    }
    return formal_find_if_token(source, raw_next(node));
};

let formal_if_then_group = std::func(source: addr, condition: addr) -> addr {
    let candidate: addr = raw_next(condition);
    if formal_is_comparison_operator(source, candidate) {
        let right: addr = raw_next(candidate);
        return raw_next(right);
    }
    return candidate;
};

let formal_literal_length = std::func(text: addr) -> i64 {
    let length: i64 = 0;
    while std::load_bits(8, text + length) != 0 {
        length = length + 1;
    }
    return length;
};

let formal_copy_literal = std::func(
    buffer: addr,
    offset: i64,
    text: addr,
) -> i64 {
    let length: i64 = formal_literal_length(text);
    let index: i64 = 0;
    while index < length {
        let target: i64 = offset + index;
        std::store_bits(
            8,
            buffer + target,
            std::load_bits(8, text + index),
        );
        index = index + 1;
    }
    return offset + length;
};

let formal_copy_source = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    node: addr,
) -> i64 {
    let data: addr = source_bytes(source) + raw_start(node);
    let length: i64 = raw_length(node);
    let index: i64 = 0;
    while index < length {
        let target: i64 = offset + index;
        std::store_bits(
            8,
            buffer + target,
            std::load_bits(8, data + index),
        );
        index = index + 1;
    }
    return offset + length;
};

let formal_copy_binary_expression = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    left: addr,
    operator: addr,
    right: addr,
) -> i64 {
    let operator_value: i8 = byte_at(
        source_bytes(source), raw_start(operator)
    );
    let cursor: i64 = offset;
    if operator_value == 43 {
        cursor = formal_copy_literal(buffer, cursor, "#add(");
    }
    if operator_value == 45 {
        cursor = formal_copy_literal(buffer, cursor, "#sub(");
    }
    if operator_value == 42 {
        cursor = formal_copy_literal(buffer, cursor, "#mul(");
    }
    if operator_value == 47 {
        cursor = formal_copy_literal(buffer, cursor, "#div(");
    }
    cursor = formal_copy_source(buffer, cursor, source, left);
    cursor = formal_copy_literal(buffer, cursor, ", ");
    cursor = formal_copy_source(buffer, cursor, source, right);
    return formal_copy_literal(buffer, cursor, ")");
};

let formal_copy_return_expression = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    return_node: addr,
) -> i64 {
    let value: addr = raw_next(return_node);
    if formal_is_arithmetic_group(source, value) {
        return formal_copy_binary_expression(
            buffer,
            offset,
            source,
            raw_first(value),
            raw_next(raw_first(value)),
            raw_next(raw_next(raw_first(value))),
        );
    }
    let operator: addr = raw_next(value);
    let right: addr = raw_next(operator);
    let arithmetic: bool = false;
    if formal_is_operator(source, operator) {
        if formal_is_decimal(source, right) {
            arithmetic = true;
        }
    }
    let cursor: i64 = offset;
    if arithmetic {
        cursor = formal_copy_binary_expression(
            buffer, cursor, source, value, operator, right
        );
    } else {
        cursor = formal_copy_source(buffer, cursor, source, value);
    }
    return cursor;
};

let formal_copy_argument_expression = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    arguments: addr,
) -> i64 {
    let left: addr = raw_first(arguments);
    let operator: addr = raw_next(left);
    let right: addr = raw_next(operator);
    return formal_copy_binary_expression(
        buffer, offset, source, left, operator, right
    );
};

let formal_copy_parameter_return_expression = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    return_node: addr,
    parameter: addr,
) -> i64 {
    let value: addr = raw_next(return_node);
    let operator: addr = raw_next(value);
    let right: addr = raw_next(operator);
    let cursor: i64 = offset;
    if formal_is_operator(source, operator) {
        if formal_is_decimal(source, right) {
            let operator_value: i8 = byte_at(source_bytes(source), raw_start(operator));
            if operator_value == 43 {
                cursor = formal_copy_literal(buffer, cursor, "#add(%");
            }
            if operator_value == 45 {
                cursor = formal_copy_literal(buffer, cursor, "#sub(%");
            }
            if operator_value == 42 {
                cursor = formal_copy_literal(buffer, cursor, "#mul(%");
            }
            if operator_value == 47 {
                cursor = formal_copy_literal(buffer, cursor, "#div(%");
            }
            cursor = formal_copy_source(buffer, cursor, source, parameter);
            cursor = formal_copy_literal(buffer, cursor, ", ");
            cursor = formal_copy_source(buffer, cursor, source, right);
            return formal_copy_literal(buffer, cursor, ")");
        }
    }
    return formal_copy_source(buffer, cursor, source, value);
};

let formal_copy_two_parameter_expression = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    return_node: addr,
    first_parameter: addr,
    second_parameter: addr,
) -> i64 {
    let left: addr = raw_next(return_node);
    let operator: addr = raw_next(left);
    let right: addr = raw_next(operator);
    let operator_value: i8 = byte_at(source_bytes(source), raw_start(operator));
    let cursor: i64 = offset;
    let left_is_first: bool = formal_name_matches(source, left, first_parameter);
    let right_is_first: bool = formal_name_matches(source, right, first_parameter);
    if operator_value == 43 {
        cursor = formal_copy_literal(buffer, cursor, "#add(%");
    }
    if operator_value == 45 {
        cursor = formal_copy_literal(buffer, cursor, "#sub(%");
    }
    if operator_value == 42 {
        cursor = formal_copy_literal(buffer, cursor, "#mul(%");
    }
    if operator_value == 47 {
        cursor = formal_copy_literal(buffer, cursor, "#div(%");
    }
    if left_is_first {
        cursor = formal_copy_source(buffer, cursor, source, first_parameter);
    } else {
        cursor = formal_copy_source(buffer, cursor, source, second_parameter);
    }
    cursor = formal_copy_literal(buffer, cursor, ", %");
    if right_is_first {
        cursor = formal_copy_source(buffer, cursor, source, first_parameter);
    } else {
        cursor = formal_copy_source(buffer, cursor, source, second_parameter);
    }
    return formal_copy_literal(buffer, cursor, ")");
};

let formal_emit_constant = std::func(source: addr, return_node: addr) -> unit {
    let prefix: addr = "#proc main() -> #bits<64> {\n  #return ";
    let suffix: addr = "\n}\n";
    let buffer: addr = allocate_pages(256);
    let offset: i64 = 0;
    if formal_return_is_arithmetic(source, return_node) {
        offset = formal_copy_literal(
            buffer, offset,
            "#proc main() -> #bits<64> {\n  #let %value: #bits<64> = #eval { #return "
        );
        offset = formal_copy_return_expression(buffer, offset, source, return_node);
        offset = formal_copy_literal(
            buffer, offset, " }\n  #return %value\n}\n"
        );
        artifact_write(buffer, offset);
        return;
    }
    offset = formal_copy_literal(buffer, offset, prefix);
    offset = formal_copy_return_expression(buffer, offset, source, return_node);
    offset = formal_copy_literal(buffer, offset, suffix);
    artifact_write(buffer, offset);
};

let formal_emit_local_binding = std::func(
    source: addr,
    binding: addr,
    return_node: addr,
    name: addr,
) -> unit {
    let value: addr = raw_next(raw_next(raw_next(binding)));
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_copy_literal(
        buffer,
        0,
        "#proc main() -> #bits<64> {\n  #let %",
    );
    offset = formal_copy_source(buffer, offset, source, name);
    offset = formal_copy_literal(buffer, offset, ": #bits<64> = ");
    offset = formal_copy_source(buffer, offset, source, value);
    offset = formal_copy_literal(buffer, offset, "\n  #return ");
    let return_value: addr = raw_next(return_node);
    let operator: addr = raw_next(return_value);
    if formal_is_semicolon(source, operator) {
        offset = formal_copy_literal(buffer, offset, "%");
        offset = formal_copy_source(buffer, offset, source, name);
    } else {
        offset = formal_copy_parameter_return_expression(
            buffer, offset, source, return_node, name
        );
    }
    offset = formal_copy_literal(buffer, offset, "\n}\n");
    artifact_write(buffer, offset);
};

let formal_emit_unit = std::func() -> unit {
    let buffer: addr = allocate_pages(128);
    let offset: i64 = formal_copy_literal(
        buffer, 0, "#proc main() -> #unit {\n  #return\n}\n"
    );
    artifact_write(buffer, offset);
};

let formal_emit_call = std::func(
    source: addr,
    callee: addr,
    callee_return: addr,
) -> unit {
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_copy_literal(buffer, 0, "#proc ");
    offset = formal_copy_source(buffer, offset, source, callee);
    if formal_return_is_arithmetic(source, callee_return) {
        offset = formal_copy_literal(
            buffer, offset,
            "() -> #bits<64> {\n  #let %value: #bits<64> = #eval { #return "
        );
        offset = formal_copy_return_expression(
            buffer, offset, source, callee_return
        );
        offset = formal_copy_literal(
            buffer, offset, " }\n  #return %value\n}\n\n#proc main() -> #bits<64> {\n  #return #call "
        );
    } else {
        offset = formal_copy_literal(
            buffer, offset, "() -> #bits<64> {\n  #return "
        );
        offset = formal_copy_return_expression(
            buffer, offset, source, callee_return
        );
        offset = formal_copy_literal(
            buffer, offset,
            "\n}\n\n#proc main() -> #bits<64> {\n  #return #call "
        );
    }
    offset = formal_copy_source(buffer, offset, source, callee);
    offset = formal_copy_literal(buffer, offset, "()\n}\n");
    artifact_write(buffer, offset);
};

let formal_emit_call_arg = std::func(
    source: addr,
    callee: addr,
    arguments: addr,
    callee_return: addr,
    parameter: addr,
) -> unit {
    let argument: addr = raw_first(arguments);
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_copy_literal(buffer, 0, "#proc ");
    offset = formal_copy_source(buffer, offset, source, callee);
    offset = formal_copy_literal(
        buffer, offset, "(#bits<64> %"
    );
    offset = formal_copy_source(buffer, offset, source, parameter);
    offset = formal_copy_literal(buffer, offset, ") -> #bits<64> {\n  #return ");
    offset = formal_copy_parameter_return_expression(
        buffer, offset, source, callee_return, parameter
    );
    offset = formal_copy_literal(
        buffer, offset,
        "\n}\n\n#proc main() -> #bits<64> {\n"
    );
    if formal_is_single_arithmetic_argument(source, arguments) {
        // Evaluate a non-scalar argument through LAIN-IR #eval before passing
        // it to the generated procedure.  The formal library remains a
        // compiler of syntax; seed remains the evaluator.
        offset = formal_copy_literal(
            buffer, offset,
            "  #let %argument_value: #bits<64> = #eval { #return "
        );
        offset = formal_copy_argument_expression(
            buffer, offset, source, arguments
        );
        offset = formal_copy_literal(
            buffer, offset,
            " }\n  #return #call "
        );
    } else {
        offset = formal_copy_literal(buffer, offset, "  #return #call ");
    }
    offset = formal_copy_source(buffer, offset, source, callee);
    offset = formal_copy_literal(buffer, offset, "(");
    if formal_is_single_arithmetic_argument(source, arguments) {
        offset = formal_copy_literal(buffer, offset, "%argument_value");
    } else {
        offset = formal_copy_source(buffer, offset, source, argument);
    }
    offset = formal_copy_literal(buffer, offset, ")\n}\n");
    artifact_write(buffer, offset);
};

let formal_emit_call_two_args = std::func(
    source: addr,
    callee: addr,
    arguments: addr,
    callee_return: addr,
    first_parameter: addr,
    second_parameter: addr,
) -> unit {
    let first: addr = raw_first(arguments);
    let comma: addr = raw_next(first);
    let second: addr = raw_next(comma);
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_copy_literal(buffer, 0, "#proc ");
    offset = formal_copy_source(buffer, offset, source, callee);
    offset = formal_copy_literal(
        buffer, offset, "(#bits<64> %"
    );
    offset = formal_copy_source(buffer, offset, source, first_parameter);
    offset = formal_copy_literal(buffer, offset, ", #bits<64> %");
    offset = formal_copy_source(buffer, offset, source, second_parameter);
    offset = formal_copy_literal(buffer, offset, ") -> #bits<64> {\n  #return ");
    offset = formal_copy_two_parameter_expression(
        buffer, offset, source, callee_return,
        first_parameter, second_parameter
    );
    offset = formal_copy_literal(
        buffer, offset,
        "\n}\n\n#proc main() -> #bits<64> {\n  #return #call "
    );
    offset = formal_copy_source(buffer, offset, source, callee);
    offset = formal_copy_literal(buffer, offset, "(");
    offset = formal_copy_source(buffer, offset, source, first);
    offset = formal_copy_literal(buffer, offset, ", ");
    offset = formal_copy_source(buffer, offset, source, second);
    offset = formal_copy_literal(buffer, offset, ")\n}\n");
    artifact_write(buffer, offset);
};

let formal_emit_if = std::func(
    source: addr,
    if_node: addr,
) -> unit {
    let condition: addr = raw_next(if_node);
    let then_group: addr = formal_if_then_group(source, condition);
    let else_word: addr = raw_next(then_group);
    let else_group: addr = raw_next(else_word);
    let then_return: addr = formal_find_return_list(
        source, raw_first(then_group)
    );
    let else_return: addr = formal_find_return_list(
        source, raw_first(else_group)
    );
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_copy_literal(
        buffer, 0, "#proc main() -> #bits<64> {\n  #if "
    );
    if formal_is_true(source, condition) {
        offset = formal_copy_literal(buffer, offset, "#eq(1, 1)");
    }
    if formal_is_false(source, condition) {
        offset = formal_copy_literal(buffer, offset, "#eq(0, 1)");
    }
    if formal_is_comparison_operator(source, raw_next(condition)) {
        let comparison_operator: addr = raw_next(condition);
        let comparison_right: addr = raw_next(comparison_operator);
        let operator_length: i64 = raw_length(comparison_operator);
        let operator_data: addr = source_bytes(source);
        let operator_start: i64 = raw_start(comparison_operator);
        if operator_length == 2 {
            let first: i8 = byte_at(operator_data, operator_start);
            let second: i8 = byte_at(operator_data, operator_start + 1);
            if first == 61 && second == 61 {
                offset = formal_copy_literal(buffer, offset, "#eq(");
            }
            if first == 33 && second == 61 {
                offset = formal_copy_literal(buffer, offset, "#ne(");
            }
            if first == 60 && second == 61 {
                offset = formal_copy_literal(buffer, offset, "#le(");
            }
            if first == 62 && second == 61 {
                offset = formal_copy_literal(buffer, offset, "#ge(");
            }
        }
        if operator_length == 1 {
            let value: i8 = byte_at(operator_data, operator_start);
            if value == 60 {
                offset = formal_copy_literal(buffer, offset, "#lt(");
            }
            if value == 62 {
                offset = formal_copy_literal(buffer, offset, "#gt(");
            }
        }
        offset = formal_copy_source(buffer, offset, source, condition);
        offset = formal_copy_literal(buffer, offset, ", ");
        offset = formal_copy_source(buffer, offset, source, comparison_right);
        offset = formal_copy_literal(buffer, offset, ")");
    }
    offset = formal_copy_literal(buffer, offset, " {\n    #return ");
    offset = formal_copy_return_expression(
        buffer, offset, source, then_return
    );
    offset = formal_copy_literal(buffer, offset, "\n  } else {\n    #return ");
    offset = formal_copy_return_expression(
        buffer, offset, source, else_return
    );
    offset = formal_copy_literal(buffer, offset, "\n  }\n}\n");
    artifact_write(buffer, offset);
};

let formal_lower_source = std::func(index: addr, ordinal: i64) -> bool {
    let count: i64 = syntax_index_count(index);
    if ordinal >= count { return false; }
    let source: addr = syntax_index_source(index, ordinal);
    let root: addr = syntax_index_root(index, ordinal);
    let main_body: addr = formal_find_main_body(source, raw_first(root));
    if raw_nil(main_body) {
        return formal_lower_source(index, ordinal + 1);
    }
    let unit_return: addr = formal_find_unit_return_list(
        source, raw_first(main_body)
    );
    if raw_nil(unit_return) == false {
        formal_emit_unit();
        return true;
    }
    let local_binding: addr = formal_find_local_scalar_binding(
        source, raw_first(main_body)
    );
    if raw_nil(local_binding) == false {
        let local_name: addr = raw_next(local_binding);
        let local_return: addr = formal_find_named_return_list(
            source, raw_first(main_body), local_name
        );
        if raw_nil(local_return) == false {
            formal_emit_local_binding(
                source, local_binding, local_return, local_name
            );
            return true;
        }
    }
    let if_node: addr = formal_find_if_list(source, raw_first(main_body));
    if raw_nil(if_node) == false {
        let condition: addr = raw_next(if_node);
        let then_group: addr = formal_if_then_group(source, condition);
        let else_word: addr = raw_next(then_group);
        let else_group: addr = raw_next(else_word);
        let then_return: addr = formal_find_return_list(
            source, raw_first(then_group)
        );
        let else_return: addr = formal_find_return_list(
            source, raw_first(else_group)
        );
        if formal_is_true(source, condition) {
            if raw_nil(then_return) == false {
                if raw_nil(else_return) == false {
                    formal_emit_if(source, if_node);
                    return true;
                }
            }
        }
        if formal_is_false(source, condition) {
            if raw_nil(then_return) == false {
                if raw_nil(else_return) == false {
                    formal_emit_if(source, if_node);
                    return true;
                }
            }
        }
        if formal_is_comparison_operator(source, raw_next(condition)) {
            if raw_nil(then_return) == false {
                if raw_nil(else_return) == false {
                    formal_emit_if(source, if_node);
                    return true;
                }
            }
        }
    }
    let any_if: addr = formal_find_if_token(source, raw_first(main_body));
    if raw_nil(any_if) == false {
        return formal_lower_source(index, ordinal + 1);
    }
    let call_return: addr = formal_find_call_return_list(
        source, raw_first(main_body)
    );
    if raw_nil(call_return) == false {
        let callee: addr = raw_next(call_return);
        let arguments: addr = raw_next(callee);
        let callee_body: addr = formal_find_named_body(
            source, raw_first(root), callee
        );
        let argument: addr = raw_first(arguments);
        if formal_is_two_decimal_arguments(source, arguments) {
            let parameter_group: addr = formal_find_named_parameter_group(
                source, raw_first(root), callee
            );
            let first_parameter: addr = raw_first(parameter_group);
            let second_parameter: addr = formal_second_parameter(
                source, parameter_group
            );
            let two_parameter_return: addr = formal_find_two_parameter_return_list(
                source, raw_first(callee_body)
            );
            if raw_nil(callee_body) == false {
                if raw_nil(parameter_group) == false {
                    if raw_nil(first_parameter) == false {
                        if raw_nil(second_parameter) == false {
                            if raw_nil(two_parameter_return) == false {
                                formal_emit_call_two_args(
                                    source, callee, arguments,
                                    two_parameter_return,
                                    first_parameter, second_parameter
                                );
                                return true;
                            }
                        }
                    }
                }
            }
        }
        let callee_return: addr = formal_find_return_list(
            source, raw_first(callee_body)
        );
        if raw_nil(argument) == false {
            let parameter_group: addr = formal_find_named_parameter_group(
                source, raw_first(root), callee
            );
            let parameter: addr = raw_first(parameter_group);
            let parameter_return: addr = formal_find_parameter_return_list(
                source, raw_first(callee_body)
            );
            if raw_nil(callee_body) == false {
                if raw_nil(parameter_group) == false {
                    if raw_nil(parameter) == false {
                        if raw_nil(parameter_return) == false {
                            formal_emit_call_arg(
                                source, callee, arguments, parameter_return,
                                parameter
                            );
                            return true;
                        }
                    }
                }
            }
        }
        if raw_nil(callee_body) == false {
            if raw_nil(callee_return) == false {
                formal_emit_call(source, callee, callee_return);
                return true;
            }
        }
    }
    let return_node: addr = formal_find_return_list(
        source, raw_first(main_body)
    );
    if raw_nil(return_node) == false {
        formal_emit_constant(source, return_node);
        return true;
    }
    return formal_lower_source(index, ordinal + 1);
};

@abi_export
let lain_std_abi_version = std::func() -> i64 {
    return 1;
};

@abi_export
let lain_std_initialize = std::func(context: addr) -> i32 {
    return 0;
};

@abi_export
let lain_std_expand = std::func(
    context: addr,
    source_unit: addr,
    root: addr,
) -> addr {
    let import_status: i32 = formal_import_status(source_unit);
    if import_status != 0 {
        return pass_result_new(
            import_status,
            0,
            root,
            ast_nil(),
            ast_nil(),
            context_owner(context),
        );
    }
    let expanded: addr = root;
    if syntax_index_count(source_unit) > 0 {
        // The first formal Meta slice proves an actual AstApi operation.  The
        // complete per-unit rewrite is still pending, so the remaining
        // entries stay owned by the syntax index until that pass is migrated.
        expanded = formal_meta.meta_ast_copy(
            syntax_index_root(source_unit, 0)
        );
    }
    return pass_result_new(
        0,
        1,
        expanded,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};

@abi_export
let lain_std_elaborate = std::func(
    context: addr,
    expanded_root: addr,
) -> addr {
    return pass_result_new(
        0,
        0,
        expanded_root,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};

@abi_export
let lain_std_lower = std::func(
    context: addr,
    elaborated_root: addr,
    l1_unit: addr,
) -> addr {
    // The first executable formal lowering slice handles only a constant
    // return.  All other forms retain the explicit migration boundary below.
    if formal_lower_source(l1_unit, 0) {
        return pass_result_new(
            0,
            1,
            l1_unit,
            ast_nil(),
            ast_nil(),
            context_owner(context),
        );
    }
    // 5203 is the stable "formal std lowering unavailable" boundary.
    // The bootstrap implementation remains the active provider for every
    // form outside this deliberately small slice.
    return pass_result_new(
        5203,
        0,
        l1_unit,
        ast_nil(),
        ast_nil(),
        context_owner(context),
    );
};
