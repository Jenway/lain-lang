let formal_emit_struct_field = std::func(
    source: addr,
    record_binding: addr,
    struct_body: addr,
    selected_field: addr,
) -> unit {
    let buffer: addr = allocate_pages(512);
    let offset: i64 = formal_meta.meta_copy_struct_field(
        buffer, 0, source, record_binding, struct_body, selected_field
    );
    artifact_write(buffer, offset);
};

