let AstTree: type = std::struct {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

@export

let ast_tag = std::func(node: AstTree) -> i32 {
    node.tag
}

@export

let ast_symbol = std::func(node: AstTree) -> i32 {
    node.symbol
}

@export

let ast_payload_left = std::func(node: AstTree) -> i32 {
    node.left
}

@export

let ast_payload_right = std::func(node: AstTree) -> i32 {
    node.right
}

@export

let ast_node_score = std::func(tag: i32, symbol: i32, left: i32, right: i32) -> i32 {
    let node: AstTree = AstTree {
        tag: tag,
        symbol: symbol,
        left: left,
        right: right,
    };
    ast_tag(node) + ast_symbol(node) + ast_payload_left(node) + ast_payload_right(node)
}
