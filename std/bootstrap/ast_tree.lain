struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

pub fn ast_tag(node: AstTree) -> i32 {
    node.tag
}

pub fn ast_symbol(node: AstTree) -> i32 {
    node.symbol
}

pub fn ast_payload_left(node: AstTree) -> i32 {
    node.left
}

pub fn ast_payload_right(node: AstTree) -> i32 {
    node.right
}

pub fn ast_node_score(tag: i32, symbol: i32, left: i32, right: i32) -> i32 {
    let node: AstTree = AstTree {
        tag: tag,
        symbol: symbol,
        left: left,
        right: right,
    };
    ast_tag(node) + ast_symbol(node) + ast_payload_left(node) + ast_payload_right(node)
}
