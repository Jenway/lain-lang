let IrType: type = std::struct {
    tag: i32,
    width: i32,
}

let IrValue: type = std::struct {
    tag: i32,
    type_tag: i32,
    payload: i32,
}

let IrFunction: type = std::struct {
    name: i32,
    param_count: i32,
    ret_tag: i32,
    body_score: i32,
}

let ir_type_i32 = std::func() -> IrType {
    IrType { tag: 1, width: 32 }
}

let ir_const_i32 = std::func(value: i32) -> IrValue {
    let ty: IrType = ir_type_i32();
    IrValue { tag: 1, type_tag: ty.tag, payload: value }
}

let ir_return_const_i32 = std::func(name: i32, value: i32) -> IrFunction {
    let value_expr: IrValue = ir_const_i32(value);
    IrFunction {
        name: name,
        param_count: 0,
        ret_tag: value_expr.type_tag,
        body_score: value_expr.payload,
    }
}

let ir_call2 = std::func(callee: IrFunction, left: IrValue, right: IrValue) -> IrValue {
    let payload: i32 = callee.name + left.payload + right.payload;
    IrValue {
        tag: 2,
        type_tag: callee.ret_tag,
        payload: payload,
    }
}

let ir_return_call2 = std::func(name: i32, callee: IrFunction, left: IrValue, right: IrValue) -> IrFunction {
    let call_expr: IrValue = ir_call2(callee, left, right);
    IrFunction {
        name: name,
        param_count: 2,
        ret_tag: call_expr.type_tag,
        body_score: call_expr.payload,
    }
}

@export

let ir_build_const_score = std::func(name: i32, value: i32) -> i32 {
    let function: IrFunction = ir_return_const_i32(name, value);
    function.name + function.body_score
}

@export

let ir_build_call_score = std::func(name: i32, callee_name: i32, left_value: i32, right_value: i32) -> i32 {
    let callee: IrFunction = ir_return_const_i32(callee_name, 0);
    let left: IrValue = ir_const_i32(left_value);
    let right: IrValue = ir_const_i32(right_value);
    let function: IrFunction = ir_return_call2(name, callee, left, right);
    function.name + function.body_score
}
