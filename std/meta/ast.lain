let mem = import("std::mem");
let option = import("std::option");

pub let NodeKind = enum { Token Group };

pub let Delim = enum { None Paren Bracket Brace };

pub let kind_code = func(k: NodeKind) -> u64 {
  return match k {
    Token => 1,
    Group => 2,
  };
};

pub let kind_enum = func(code: u64) -> NodeKind {
  if code == 1 { return NodeKind.Token {}; }
  if code == 2 { return NodeKind.Group {}; }
  let dead: u64 = mem.trap_abort(code);
  return NodeKind.Token {};
};

pub let delim_code = func(d: Delim) -> u64 {
  return match d {
    None => 0,
    Paren => 40,
    Bracket => 91,
    Brace => 123,
  };
};

pub let delim_enum = func(code: u64) -> Delim {
  if code == 0 { return Delim.None {}; }
  if code == 40 { return Delim.Paren {}; }
  if code == 91 { return Delim.Bracket {}; }
  if code == 123 { return Delim.Brace {}; }
  let dead: u64 = mem.trap_abort(code);
  return Delim.None {};
};

pub let NodeId = u64;

pub let NO_NODE: NodeId = 4294967295;

pub let OptNode = option.Option(u64);

pub let node_opt = func(id: NodeId) -> OptNode.Opt {
  if id == NO_NODE { return OptNode.Opt.None { }; }
  return OptNode.Opt.Some { id };
};

pub let node_id = func(o: OptNode.Opt) -> NodeId {
  return OptNode.unwrap_or(o, NO_NODE);
};

pub let RawNode = struct {
  kind: u64,
  delim: u64,
  sym: u64,
  span_id: u64,
  origin: u64,
  child_off: u64,
  child_count: u64,
  text_off: u64,
  text_len: u64,
};

pub let raw_node_bytes = func() -> u64 { return size_of(RawNode); };

pub let require_group = func(k: NodeKind, cause: u64) -> u64 {
  return match k {
    Token => mem.trap_abort(cause),
    Group => 0,
  };
};

pub let require_token = func(k: NodeKind, cause: u64) -> u64 {
  return match k {
    Token => 0,
    Group => mem.trap_abort(cause),
  };
};

pub let dead_node = func(cause: u64) -> RawNode {
  let dead: u64 = mem.trap_abort(cause);
  return RawNode {
    kind: kind_code(NodeKind.Token {}),
    delim: delim_code(Delim.None {}),
    sym: 0,
    span_id: 0,
    origin: 0,
    child_off: 0,
    child_count: 0,
    text_off: 0,
    text_len: 0,
  };
};
