let mem = import("std::mem");
let ast = import("std::meta::ast");

pub let AstView = struct {
  nodes: Ref(ast.RawNode),
  node_len: u64,
  kids: Ref(u32),
  kid_len: u64,
  pool: Ref(u8),
  pool_len: u64,
};

pub let ast_view = func(nodes: Ref(ast.RawNode), node_len: u64, kids: Ref(u32), kid_len: u64,
                        pool: Ref(u8), pool_len: u64) -> AstView {
  return AstView {
    nodes: nodes,
    node_len: node_len,
    kids: kids,
    kid_len: kid_len,
    pool: pool,
    pool_len: pool_len,
  };
};

pub let view_node = func(v: AstView, id: ast.NodeId) -> ast.RawNode {
  if id >= v.node_len { mem.trap_abort(id); }
  let p: Ref(ast.RawNode) = v.nodes + id * ast.raw_node_bytes();
  return deref(p);
};

pub let view_kind = func(v: AstView, id: ast.NodeId) -> ast.NodeKind {
  let n: ast.RawNode = view_node(v, id);
  return ast.kind_enum(n.kind);
};

pub let view_is_token = func(v: AstView, id: ast.NodeId) -> bool {
  let k: ast.NodeKind = view_kind(v, id);
  return match k {
    Token => true,
    Group => false,
  };
};

pub let view_is_group = func(v: AstView, id: ast.NodeId) -> bool {
  let k: ast.NodeKind = view_kind(v, id);
  return match k {
    Token => false,
    Group => true,
  };
};

pub let view_delim = func(v: AstView, id: ast.NodeId) -> ast.Delim {
  let n: ast.RawNode = view_node(v, id);
  return ast.delim_enum(n.delim);
};

pub let view_sym = func(v: AstView, id: ast.NodeId) -> u64 {
  let n: ast.RawNode = view_node(v, id);
  return n.sym;
};

pub let view_span = func(v: AstView, id: ast.NodeId) -> u64 {
  let n: ast.RawNode = view_node(v, id);
  return n.span_id;
};

pub let view_origin = func(v: AstView, id: ast.NodeId) -> u64 {
  let n: ast.RawNode = view_node(v, id);
  return n.origin;
};

pub let view_child_count = func(v: AstView, id: ast.NodeId) -> u64 {
  let n: ast.RawNode = view_node(v, id);
  return n.child_count;
};

pub let view_child_at = func(v: AstView, id: ast.NodeId, i: u64) -> ast.NodeId {
  let n: ast.RawNode = view_node(v, id);
  ast.require_group(ast.kind_enum(n.kind), id);
  if i >= n.child_count { return mem.trap_abort(i); }
  let slot: u64 = n.child_off + i;
  if slot >= v.kid_len { return mem.trap_abort(slot); }
  let p: Ref(u32) = v.kids + slot * 4;
  let w: u32 = deref(p);
  return w as u64;
};

pub let view_text = func(v: AstView, id: ast.NodeId) -> Slice(u8) {
  let n: ast.RawNode = view_node(v, id);
  ast.require_token(ast.kind_enum(n.kind), id);
  let end: u64 = n.text_off + n.text_len;
  if end > v.pool_len { mem.trap_abort(end); }
  let p: Ref(u8) = v.pool + n.text_off;
  return make_slice(Slice(u8), p, n.text_len);
};

pub let AstViewMod = module {
  pub let Self = AstView;

  pub let is_token = func(v: AstView, id: ast.NodeId) -> bool { return view_is_token(v, id); };
  pub let is_group = func(v: AstView, id: ast.NodeId) -> bool { return view_is_group(v, id); };
  pub let kind = func(v: AstView, id: ast.NodeId) -> ast.NodeKind { return view_kind(v, id); };
  pub let delim = func(v: AstView, id: ast.NodeId) -> ast.Delim { return view_delim(v, id); };
  pub let text = func(v: AstView, id: ast.NodeId) -> Slice(u8) { return view_text(v, id); };
  pub let child_count = func(v: AstView, id: ast.NodeId) -> u64 {
    return view_child_count(v, id);
  };
  pub let child_at = func(v: AstView, id: ast.NodeId, i: u64) -> ast.NodeId {
    return view_child_at(v, id, i);
  };
};
