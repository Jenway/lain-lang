let mem = import("std::mem");
let option = import("std::option");
let str = import("std::str");

pub let KIND_OTHER: u64 = 0;
pub let KIND_INT: u64 = 1;
pub let KIND_BOOL: u64 = 2;
pub let KIND_FLOAT: u64 = 3;
pub let KIND_STRUCT: u64 = 4;
pub let KIND_ENUM: u64 = 5;
pub let KIND_SLICE: u64 = 6;
pub let KIND_PTR: u64 = 7;
pub let KIND_ARRAY: u64 = 8;

pub let FieldDesc = struct {
  name: Slice(u8),
  offset: u64,
  size: u64,
  kind: u64,
};

pub let TypeDesc = struct {
  name: Slice(u8),
  size: u64,
  align: u64,
  fields: Slice(FieldDesc),
};

pub let FieldIndex = option.Option(u64);

pub let total_field_bytes = func(fields: Slice(FieldDesc)) -> u64 {
  return loop c(i: u64 = 0, acc: u64 = 0) while i < fields.len {
    acc = acc + fields[i].size;
    i = i + 1;
  };
};

pub let find_field = func(fields: Slice(FieldDesc), name: Slice(u8)) -> FieldIndex.Opt {
  let hit: u64 = 0;
  let found: bool = false;
  loop c(i: u64 = 0) while i < fields.len {
    if found == false {
      if str.eq(fields[i].name, name) {
        hit = i;
        found = true;
      }
    }
    i = i + 1;
  };
  if found {
    return FieldIndex.Opt.Some { hit };
  }
  return FieldIndex.Opt.None { };
};

let put_byte = func(buf: MutSlice(u8), pos: u64, b: u8) -> u64 {
  if pos >= buf.len {
    let dead: u64 = mem.halt_now(buf.len);
    return dead;
  }
  buf[pos] = b;
  return pos + 1;
};

let put_name = func(buf: MutSlice(u8), pos: u64, name: Slice(u8)) -> u64 {
  return loop c(i: u64 = 0, p: u64 = pos) while i < name.len {
    p = put_byte(buf, p, name[i]);
    i = i + 1;
  };
};

pub let emit_field_names_csv = func(fields: Slice(FieldDesc), buf: MutSlice(u8)) -> u64 {
  return loop c(i: u64 = 0, pos: u64 = 0) while i < fields.len {
    let start: u64 = if i == 0 { pos } else { put_byte(buf, pos, 44) };
    pos = put_name(buf, start, fields[i].name);
    i = i + 1;
  };
};
