// ParseResultV1 is an opaque seed-owned handle.  Its fixed layout is private
// to this module: source @0, token head @8, AST root @16, status @24.  Using a
// handle keeps the ABI independent from aggregate-return lowering in the
// current formal compiler while preserving one source/token/root tuple.
@foreign(c, link_name = "bootstrap.allocate-pages")
let meta_allocate_pages_foreign = std::func(size: i64) -> addr;

@abi_export
let meta_allocate_pages = std::func(size: i64) -> addr {
    return meta_allocate_pages_foreign(size);
};

@foreign(c, link_name = "bootstrap.release-pages")
let meta_release_pages_foreign = std::func(memory: addr) -> unit;

@abi_export
let meta_release_pages = std::func(memory: addr) -> unit {
    meta_release_pages_foreign(memory);
};

@abi_export
let meta_parse_result_new = std::func(data: addr, length: i64) -> addr {
    let source: addr = meta_source_new(data, length);
    let tokens: addr = meta_source_lex(source);
    let root: addr = meta_source_parse(source, tokens);
    let first_diagnostic: addr = meta_source_diagnostics(source);
    let result: addr = meta_allocate_pages(32);
    std::store_bits(64, result + 0, source as usize);
    std::store_bits(64, result + 8, tokens as usize);
    std::store_bits(64, result + 16, root as usize);
    std::store_bits(32, result + 24, meta_diagnostic_code(first_diagnostic));
    return result;
};

@abi_export
let meta_parse_result_source = std::func(result: addr) -> addr {
    let value: addr = std::load_bits(64, result + 0);
    return value;
};

@abi_export
let meta_parse_result_tokens = std::func(result: addr) -> addr {
    let value: addr = std::load_bits(64, result + 8);
    return value;
};

@abi_export
let meta_parse_result_root = std::func(result: addr) -> addr {
    let value: addr = std::load_bits(64, result + 16);
    return value;
};

@abi_export
let meta_parse_result_status = std::func(result: addr) -> i32 {
    let value: i32 = std::load_bits(32, result + 24);
    return value;
};

@abi_export
let meta_parse_result_release = std::func(result: addr) -> unit {
    let source: addr = meta_parse_result_source(result);
    let current: addr = meta_parse_result_tokens(result);
    while meta_token_kind(current) != 0 {
        let next: addr = meta_token_next(current);
        meta_release_trivia(meta_token_leading_trivia(current));
        meta_release_pages(current);
        current = next;
    }
    let diagnostic: addr = meta_source_diagnostics(source);
    while meta_diagnostic_code(diagnostic) != 0 {
        let next: addr = meta_diagnostic_next(diagnostic);
        meta_release_pages(diagnostic);
        diagnostic = next;
    }
    meta_release_pages(result);
};

