// std::meta —— 面向用户程序的元编程语法树接口（NodeKind / Delim / NodeId / OptNode /
// RawNode / Mark / AstView / AstOut）。
//
// 三份实现分别住在子模块里：std::meta::ast 定义节点记录与类别，std::meta::view
// 是同一批表上的只读视图，std::meta::out 是事务化的输出 Arena。本文件把它们的
// 公开符号按原名称重新导出，`import("std::meta")` 的调用点因此照旧可用；需要只
// 取其中一份时直接导入对应子模块。
pub let ast = import("std::meta::ast");
pub let view = import("std::meta::view");
pub let out = import("std::meta::out");

// --- 共享定义 ---------------------------------------------------------------
pub let NodeKind = ast.NodeKind;
pub let Delim = ast.Delim;
pub let NodeId = ast.NodeId;
pub let NO_NODE: NodeId = ast.NO_NODE;
pub let OptNode = ast.OptNode;
pub let RawNode = ast.RawNode;
pub let Mark = out.Mark;
pub let AstView = view.AstView;
pub let AstOut = out.AstOut;

// --- 类别码值 ---------------------------------------------------------------
pub let kind_code = func(k: NodeKind) -> u64 { return ast.kind_code(k); };
pub let kind_enum = func(code: u64) -> NodeKind { return ast.kind_enum(code); };
pub let delim_code = func(d: Delim) -> u64 { return ast.delim_code(d); };
pub let delim_enum = func(code: u64) -> Delim { return ast.delim_enum(code); };

// --- 可空节点下标 -----------------------------------------------------------
pub let node_opt = func(id: NodeId) -> OptNode.Opt { return ast.node_opt(id); };
pub let node_id = func(o: OptNode.Opt) -> NodeId { return ast.node_id(o); };

// --- 只读视图 ---------------------------------------------------------------
pub let ast_view = func(nodes: Ref(RawNode), node_len: u64, kids: Ref(u32), kid_len: u64,
                        pool: Ref(u8), pool_len: u64) -> AstView {
  return view.ast_view(nodes, node_len, kids, kid_len, pool, pool_len);
};

pub let view_node = func(v: AstView, id: NodeId) -> RawNode { return view.view_node(v, id); };
pub let view_kind = func(v: AstView, id: NodeId) -> NodeKind { return view.view_kind(v, id); };
pub let view_is_token = func(v: AstView, id: NodeId) -> bool {
  return view.view_is_token(v, id);
};
pub let view_is_group = func(v: AstView, id: NodeId) -> bool {
  return view.view_is_group(v, id);
};
pub let view_delim = func(v: AstView, id: NodeId) -> Delim { return view.view_delim(v, id); };
pub let view_sym = func(v: AstView, id: NodeId) -> u64 { return view.view_sym(v, id); };
pub let view_span = func(v: AstView, id: NodeId) -> u64 { return view.view_span(v, id); };
pub let view_origin = func(v: AstView, id: NodeId) -> u64 { return view.view_origin(v, id); };
pub let view_child_count = func(v: AstView, id: NodeId) -> u64 {
  return view.view_child_count(v, id);
};
pub let view_child_at = func(v: AstView, id: NodeId, i: u64) -> NodeId {
  return view.view_child_at(v, id, i);
};
pub let view_text = func(v: AstView, id: NodeId) -> Slice(u8) { return view.view_text(v, id); };

// --- 输出 Arena -------------------------------------------------------------
pub let ast_out_bytes = func(node_cap: u64, kid_cap: u64, pool_cap: u64, mark_cap: u64) -> u64 {
  return out.ast_out_bytes(node_cap, kid_cap, pool_cap, mark_cap);
};

pub let ast_out_init = func(arena: Mut(u8), node_cap: u64, kid_cap: u64, pool_cap: u64,
                            mark_cap: u64) -> AstOut {
  return out.ast_out_init(arena, node_cap, kid_cap, pool_cap, mark_cap);
};

pub let ast_out_node_count = func(a: Mut(AstOut)) -> u64 { return out.ast_out_node_count(a); };
pub let ast_out_child_total = func(a: Mut(AstOut)) -> u64 { return out.ast_out_child_total(a); };
pub let ast_out_pool_total = func(a: Mut(AstOut)) -> u64 { return out.ast_out_pool_total(a); };
pub let ast_out_tx_depth = func(a: Mut(AstOut)) -> u64 { return out.ast_out_tx_depth(a); };
pub let ast_out_root = func(a: Mut(AstOut)) -> OptNode.Opt { return out.ast_out_root(a); };
pub let ast_out_clear = func(a: Mut(AstOut)) -> u64 { return out.ast_out_clear(a); };

pub let ast_out_node_live = func(a: Mut(AstOut), id: NodeId) -> bool {
  return out.ast_out_node_live(a, id);
};
pub let ast_out_node_at = func(a: Mut(AstOut), id: NodeId) -> RawNode {
  return out.ast_out_node_at(a, id);
};
pub let ast_out_child_count = func(a: Mut(AstOut), id: NodeId) -> u64 {
  return out.ast_out_child_count(a, id);
};
pub let ast_out_child_at = func(a: Mut(AstOut), id: NodeId, i: u64) -> NodeId {
  return out.ast_out_child_at(a, id, i);
};
pub let ast_out_text = func(a: Mut(AstOut), id: NodeId) -> Slice(u8) {
  return out.ast_out_text(a, id);
};
pub let ast_view_of = func(a: Mut(AstOut)) -> AstView { return out.ast_view_of(a); };

pub let ast_out_begin = func(a: Mut(AstOut)) -> u64 { return out.ast_out_begin(a); };
pub let ast_out_commit = func(a: Mut(AstOut), tx: u64, root: NodeId) -> NodeId {
  return out.ast_out_commit(a, tx, root);
};
pub let ast_out_rollback = func(a: Mut(AstOut), tx: u64) -> NodeId {
  return out.ast_out_rollback(a, tx);
};

pub let ast_out_mk_token = func(a: Mut(AstOut), sym: u64, origin: u64, span: u64,
                                text: Slice(u8)) -> NodeId {
  return out.ast_out_mk_token(a, sym, origin, span, text);
};

pub let ast_out_mk_group = func(a: Mut(AstOut), delim: Delim, span: u64,
                                kids: Slice(u32)) -> NodeId {
  return out.ast_out_mk_group(a, delim, span, kids);
};

pub let ast_out_mk_group_empty = func(a: Mut(AstOut), delim: Delim, span: u64) -> NodeId {
  return out.ast_out_mk_group_empty(a, delim, span);
};

// --- 短名模块 ---------------------------------------------------------------
pub let AstViewMod = view.AstViewMod;
pub let AstOutMod = out.AstOutMod;
