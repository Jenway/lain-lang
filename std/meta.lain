// Import path matching is a Meta rule. The source table remains supplied by
// the seed capability, while the spelling and path normalization policy live
// here with the rest of the source model.
@abi_export
let meta_import_is_std = std::func(source: addr, argument: addr) -> bool {
    if meta_ast_kind(argument) != 1 { return false; }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(argument);
    let length: i64 = meta_ast_length(argument);
    if length < 7 { return false; }
    if meta_source_byte_at(data, start) != 34 { return false; }
    if meta_source_byte_at(data, start + 1) != 115 { return false; }
    if meta_source_byte_at(data, start + 2) != 116 { return false; }
    if meta_source_byte_at(data, start + 3) != 100 { return false; }
    if meta_source_byte_at(data, start + 4) != 58 { return false; }
    if meta_source_byte_at(data, start + 5) != 58 { return false; }
    return true;
};

let meta_import_suffix_matches = std::func(
    path: addr,
    path_length: i64,
    source: addr,
    argument: addr,
) -> bool {
    if meta_ast_kind(argument) != 1 { return false; }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(argument);
    let length: i64 = meta_ast_length(argument);
    if length < 2 { return false; }
    if meta_source_byte_at(data, start) != 34 { return false; }
    if meta_source_byte_at(data, start + (length - 1)) != 34 {
        return false;
    }
    let name_start: i64 = start + 1;
    let name_end: i64 = start + (length - 1);
    let name_index: i64 = name_start;
    while name_index < name_end {
        if meta_source_byte_at(data, name_index) == 58 {
            name_start = name_index + 1;
        }
        name_index = name_index + 1;
    }
    let name_length: i64 = name_end - name_start;
    let path_start: i64 = 0;
    let path_index: i64 = 0;
    while path_index < path_length {
        let value: i8 = meta_source_byte_at(path, path_index);
        if value == 47 || value == 92 {
            path_start = path_index + 1;
        }
        path_index = path_index + 1;
    }
    let path_name_length: i64 = path_length - path_start;
    let explicit_extension: bool = false;
    if name_length >= 5 {
        if meta_source_byte_at(data, name_end - 5) == 46 {
            explicit_extension = true;
        }
    }
    if explicit_extension == false && path_name_length >= 5 {
        if meta_source_byte_at(path, path_length - 5) == 46 {
            path_name_length = path_name_length - 5;
        }
    }
    if name_length != path_name_length { return false; }
    let offset: i64 = 0;
    while offset < name_length {
        if meta_source_byte_at(path, path_start + offset) !=
            meta_source_byte_at(data, name_start + offset) {
            return false;
        }
        offset = offset + 1;
    }
    return true;
};

let meta_import_std_matches = std::func(
    path: addr,
    path_length: i64,
    source: addr,
    argument: addr,
) -> bool {
    if meta_ast_kind(argument) != 1 { return false; }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(argument);
    let length: i64 = meta_ast_length(argument);
    if length < 7 { return false; }
    if meta_source_byte_at(data, start) != 34 { return false; }
    if meta_source_byte_at(data, start + 1) != 115 { return false; }
    if meta_source_byte_at(data, start + 2) != 116 { return false; }
    if meta_source_byte_at(data, start + 3) != 100 { return false; }
    if meta_source_byte_at(data, start + 4) != 58 { return false; }
    if meta_source_byte_at(data, start + 5) != 58 { return false; }
    if meta_source_byte_at(data, start + (length - 1)) != 34 {
        return false;
    }
    let name_start: i64 = start + 6;
    let name_end: i64 = start + (length - 1);
    let path_start: i64 = 0;
    let path_index: i64 = 0;
    let path_limit: i64 = path_length - 3;
    while path_index < path_length {
        if path_index >= path_limit { break; }
        if meta_source_byte_at(path, path_index) == 115 {
            if meta_source_byte_at(path, path_index + 1) == 116 {
                if meta_source_byte_at(path, path_index + 2) == 100 {
                    let after_std: i64 = path_index + 3;
                    if after_std < path_length {
                        let separator: i8 = meta_source_byte_at(
                            path, after_std
                        );
                        if separator == 47 || separator == 92 {
                            path_start = after_std + 1;
                        }
                    }
                }
            }
        }
        path_index = path_index + 1;
    }
    if path_start == 0 { return false; }
    let path_end: i64 = path_length;
    if path_end >= 5 && meta_source_byte_at(path, path_end - 5) == 46 {
        path_end = path_end - 5;
    }
    let import_index: i64 = name_start;
    let candidate_index: i64 = path_start;
    while import_index < name_end {
        if candidate_index >= path_end { return false; }
        let value: i8 = meta_source_byte_at(data, import_index);
        if value == 58 {
            if import_index + 1 >= name_end { return false; }
            if meta_source_byte_at(data, import_index + 1) != 58 {
                return false;
            }
            let separator: i8 = meta_source_byte_at(path, candidate_index);
            if separator != 47 && separator != 92 { return false; }
            import_index = import_index + 2;
            candidate_index = candidate_index + 1;
        } else {
            if value != meta_source_byte_at(path, candidate_index) {
                return false;
            }
            import_index = import_index + 1;
            candidate_index = candidate_index + 1;
        }
    }
    return candidate_index == path_end;
};

@abi_export
let meta_import_target = std::func(
    source: addr,
    argument: addr,
    source_count_value: i64,
) -> i64 {
    let candidate: i64 = 0;
    while candidate < source_count_value {
        let path: addr = meta_source_path_data(candidate);
        let path_length: i64 = meta_source_path_length(candidate);
        if meta_import_is_std(source, argument) {
            if meta_import_std_matches(
                path, path_length, source, argument
            ) { return candidate; }
        } else {
            if meta_import_suffix_matches(
                path, path_length, source, argument
            ) { return candidate; }
        }
        candidate = candidate + 1;
    }
    return source_count_value;
};

// Common semantic AST searches used by module and record lowering. These
// routines only inspect Meta handles and delegate all spelling decisions to
// the predicates in this module.
@abi_export
let meta_find_first_group_after = std::func(
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2 {
        if meta_ast_delimiter(node) == 123 { return node; }
    }
    return meta_find_first_group_after(meta_ast_next(node));
};

@abi_export
let meta_is_module_binding = std::func(
    source: addr,
    node: addr,
) -> bool {
    if meta_is_let(source, node) == false { return false; }
    let name: addr = meta_ast_next(node);
    let colon: addr = meta_ast_next(name);
    let type_name: addr = meta_ast_next(colon);
    let equals: addr = meta_ast_next(type_name);
    let std_name: addr = meta_ast_next(equals);
    let first_colon: addr = meta_ast_next(std_name);
    let second_colon: addr = meta_ast_next(first_colon);
    let constructor: addr = meta_ast_next(second_colon);
    let body: addr = meta_ast_next(constructor);
    if meta_is_module_type(source, type_name) == false { return false; }
    if meta_is_equals(source, equals) == false { return false; }
    if meta_ast_kind(std_name) != 1 || meta_ast_length(std_name) != 3 {
        return false;
    }
    if meta_is_module(source, constructor) == false { return false; }
    return meta_ast_kind(body) == 2 && meta_ast_delimiter(body) == 123;
};

@abi_export
let meta_find_module_body = std::func(
    source: addr,
    node: addr,
    path: addr,
    dot: i64,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        if meta_name_matches_path_prefix(source, name, path, dot)
            && meta_is_module_binding(source, node) {
            return meta_find_first_group_after(meta_ast_next(name));
        }
    }
    return meta_find_module_body(
        source, meta_ast_next(node), path, dot
    );
};

@abi_export
let meta_find_module_member = std::func(
    source: addr,
    node: addr,
    path: addr,
    dot: i64,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        if meta_name_matches_path_suffix(source, name, path, dot) {
            if meta_ast_is_nil(
                meta_find_first_group_after(meta_ast_next(name))
            ) == false {
                return node;
            }
        }
    }
    return meta_find_module_member(
        source, meta_ast_next(node), path, dot
    );
};

@abi_export
let meta_find_struct_binding = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        let colon: addr = meta_ast_next(name);
        let type_name: addr = meta_ast_next(colon);
        let equals: addr = meta_ast_next(type_name);
        let std_name: addr = meta_ast_next(equals);
        let first_colon: addr = meta_ast_next(std_name);
        let second_colon: addr = meta_ast_next(first_colon);
        let constructor: addr = meta_ast_next(second_colon);
        let body: addr = meta_ast_next(constructor);
        if meta_is_type(source, type_name)
            && meta_is_equals(source, equals)
            && meta_ast_kind(std_name) == 1
            && meta_ast_length(std_name) == 3
            && meta_is_struct(source, constructor)
            && meta_ast_kind(body) == 2
            && meta_ast_delimiter(body) == 123 {
            return node;
        }
    }
    return meta_find_struct_binding(source, meta_ast_next(node));
};

@abi_export
let meta_find_record_binding = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        let colon: addr = meta_ast_next(name);
        let type_name: addr = meta_ast_next(colon);
        let equals: addr = meta_ast_next(type_name);
        let constructor: addr = meta_ast_next(equals);
        let body: addr = meta_find_first_group_after(meta_ast_next(name));
        if meta_ast_kind(type_name) == 1
            && meta_name_matches(source, type_name, constructor)
            && meta_ast_kind(body) == 2
            && meta_ast_delimiter(body) == 123 {
            return node;
        }
    }
    return meta_find_record_binding(source, meta_ast_next(node));
};

@abi_export
let meta_find_member_return = std::func(
    source: addr,
    node: addr,
    record_name: addr,
    field_name: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let value: addr = meta_ast_next(node);
        let dot: i64 = meta_path_dot(source, value);
        if dot < meta_ast_length(value)
            && meta_name_matches_path_prefix(
                source, record_name, value, dot
            )
            && meta_name_matches_path_suffix(
                source, field_name, value, dot
            )
            && meta_is_semicolon(source, meta_ast_next(value)) {
            return node;
        }
    }
    return meta_find_member_return(
        source, meta_ast_next(node), record_name, field_name
    );
};

// Argument and expression shape views used by call/lowering rules. They are
// intentionally structural: Meta decides whether a token is a decimal,
// operator, or comma, while the compiler entry only consumes these views.
@abi_export
let meta_is_single_decimal_argument = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let argument: addr = meta_ast_first(arguments);
    if meta_is_decimal(source, argument) {
        return meta_ast_is_nil(meta_ast_next(argument));
    }
    return false;
};

@abi_export
let meta_is_single_arithmetic_argument = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let left: addr = meta_ast_first(arguments);
    let operator: addr = meta_ast_next(left);
    let right: addr = meta_ast_next(operator);
    let tail: addr = meta_ast_next(right);
    if meta_is_decimal(source, left)
        && meta_is_operator(source, operator)
        && meta_is_decimal(source, right) {
        if meta_ast_is_nil(tail) { return true; }
    }
    return false;
};

@abi_export
let meta_is_single_name_argument = std::func(
    arguments: addr,
) -> bool {
    let argument: addr = meta_ast_first(arguments);
    if meta_ast_kind(argument) != 1 { return false; }
    return meta_ast_is_nil(meta_ast_next(argument));
};

@abi_export
let meta_is_two_decimal_arguments = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let first: addr = meta_ast_first(arguments);
    if meta_is_decimal(source, first) {
        let comma: addr = meta_ast_next(first);
        if meta_is_comma(source, comma) {
            let second: addr = meta_ast_next(comma);
            if meta_is_decimal(source, second) {
                return meta_ast_is_nil(meta_ast_next(second));
            }
        }
    }
    return false;
};

@abi_export
let meta_is_two_name_arguments = std::func(
    source: addr,
    arguments: addr,
) -> bool {
    let first: addr = meta_ast_first(arguments);
    let comma: addr = meta_ast_next(first);
    let second: addr = meta_ast_next(comma);
    let tail: addr = meta_ast_next(second);
    if meta_ast_kind(first) == 1
        && meta_is_comma(source, comma)
        && meta_ast_kind(second) == 1
        && meta_ast_is_nil(tail) {
        if meta_is_decimal(source, first) == false
            && meta_is_decimal(source, second) == false {
            return true;
        }
    }
    return false;
};

@abi_export
let meta_is_arithmetic_group = std::func(
    source: addr,
    node: addr,
) -> bool {
    if meta_ast_kind(node) != 2 || meta_ast_delimiter(node) != 40 {
        return false;
    }
    let left: addr = meta_ast_first(node);
    let operator: addr = meta_ast_next(left);
    let right: addr = meta_ast_next(operator);
    let tail: addr = meta_ast_next(right);
    if meta_is_decimal(source, left)
        && meta_is_operator(source, operator)
        && meta_is_decimal(source, right) {
        if meta_ast_is_nil(tail) { return true; }
    }
    return false;
};

@abi_export
let meta_is_unit_return = std::func(source: addr, node: addr) -> bool {
    if meta_is_return(source, node) {
        return meta_is_semicolon(source, meta_ast_next(node));
    }
    return false;
};

@abi_export
let meta_find_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let value: addr = meta_ast_next(node);
        if meta_is_arithmetic_group(source, value) {
            if meta_is_semicolon(source, meta_ast_next(value)) {
                return node;
            }
        }
        if meta_is_decimal(source, value) {
            let operator: addr = meta_ast_next(value);
            if meta_is_semicolon(source, operator) { return node; }
            if meta_is_operator(source, operator) {
                let right: addr = meta_ast_next(operator);
                if meta_is_decimal(source, right) {
                    if meta_is_semicolon(
                        source, meta_ast_next(right)
                    ) { return node; }
                }
            }
        }
    }
    return meta_find_return_list(source, meta_ast_next(node));
};

@abi_export
let meta_find_unit_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_unit_return(source, node) { return node; }
    return meta_find_unit_return_list(source, meta_ast_next(node));
};

@abi_export
let meta_find_unit_return_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 123 {
        let value: addr = meta_find_unit_return_list(
            source, meta_ast_first(node)
        );
        if meta_ast_is_nil(value) == false { return value; }
    }
    return meta_find_unit_return_body(source, meta_ast_next(node));
};

@abi_export
let meta_find_parameter_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let value: addr = meta_ast_next(node);
        let operator: addr = meta_ast_next(value);
        let right: addr = meta_ast_next(operator);
        if meta_ast_kind(value) == 1 {
            if meta_is_operator(source, operator) {
                if meta_is_decimal(source, right) {
                    if meta_is_semicolon(
                        source, meta_ast_next(right)
                    ) { return node; }
                }
            }
        }
    }
    return meta_find_parameter_return_list(source, meta_ast_next(node));
};

@abi_export
let meta_find_two_parameter_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let left: addr = meta_ast_next(node);
        let operator: addr = meta_ast_next(left);
        let right: addr = meta_ast_next(operator);
        if meta_ast_kind(left) == 1 {
            if meta_ast_kind(right) == 1 {
                if meta_is_operator(source, operator) {
                    if meta_is_decimal(source, left) == false {
                        if meta_is_decimal(source, right) == false {
                            if meta_is_semicolon(
                                source, meta_ast_next(right)
                            ) { return node; }
                        }
                    }
                }
            }
        }
    }
    return meta_find_two_parameter_return_list(
        source, meta_ast_next(node)
    );
};

@abi_export
let meta_find_return_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 123 {
        let value: addr = meta_find_return_list(
            source, meta_ast_first(node)
        );
        if meta_ast_is_nil(value) == false { return value; }
    }
    return meta_find_return_body(source, meta_ast_next(node));
};

@abi_export
let meta_find_if_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_if(source, node) {
        let condition: addr = meta_ast_next(node);
        let then_group: addr = meta_ast_next(condition);
        if meta_ast_kind(then_group) == 2
            && meta_ast_delimiter(then_group) == 123 {
            let else_word: addr = meta_ast_next(then_group);
            if meta_is_else(source, else_word) {
                let else_group: addr = meta_ast_next(else_word);
                if meta_ast_kind(else_group) == 2
                    && meta_ast_delimiter(else_group) == 123 {
                    return node;
                }
            }
        }
        if meta_is_comparison_operator(source, then_group) {
            let right: addr = meta_ast_next(then_group);
            let branch: addr = meta_ast_next(right);
            if meta_is_decimal(source, condition)
                && meta_is_decimal(source, right)
                && meta_ast_kind(branch) == 2
                && meta_ast_delimiter(branch) == 123 {
                let else_word: addr = meta_ast_next(branch);
                if meta_is_else(source, else_word) {
                    let else_group: addr = meta_ast_next(else_word);
                    if meta_ast_kind(else_group) == 2
                        && meta_ast_delimiter(else_group) == 123 {
                        return node;
                    }
                }
            }
        }
    }
    return meta_find_if_list(source, meta_ast_next(node));
};

@abi_export
let meta_find_if_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 123 {
        let value: addr = meta_find_if_list(
            source, meta_ast_first(node)
        );
        if meta_ast_is_nil(value) == false { return value; }
    }
    return meta_find_if_body(source, meta_ast_next(node));
};

@abi_export
let meta_find_if_token = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_if(source, node) { return node; }
    if meta_ast_kind(node) == 2 {
        let nested: addr = meta_find_if_token(
            source, meta_ast_first(node)
        );
        if meta_ast_is_nil(nested) == false { return nested; }
    }
    return meta_find_if_token(source, meta_ast_next(node));
};

@abi_export
let meta_if_then_group = std::func(
    source: addr,
    condition: addr,
) -> addr {
    let candidate: addr = meta_ast_next(condition);
    if meta_is_comparison_operator(source, candidate) {
        let right: addr = meta_ast_next(candidate);
        return meta_ast_next(right);
    }
    return candidate;
};

@abi_export
let meta_find_body_after = std::func(
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 123 {
        return node;
    }
    return meta_find_body_after(meta_ast_next(node));
};

@abi_export
let meta_find_main_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        if meta_is_main(source, name) {
            return meta_find_body_after(meta_ast_next(name));
        }
    }
    return meta_find_main_body(source, meta_ast_next(node));
};

@abi_export
let meta_find_named_body = std::func(
    source: addr,
    node: addr,
    wanted: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        if meta_name_matches(source, name, wanted) {
            return meta_find_body_after(meta_ast_next(name));
        }
    }
    return meta_find_named_body(source, meta_ast_next(node), wanted);
};

@abi_export
let meta_find_parameter_group_after = std::func(
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 40 {
        return node;
    }
    return meta_find_parameter_group_after(meta_ast_next(node));
};

@abi_export
let meta_find_named_parameter_group = std::func(
    source: addr,
    node: addr,
    wanted: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        if meta_name_matches(source, name, wanted) {
            return meta_find_parameter_group_after(meta_ast_next(name));
        }
    }
    return meta_find_named_parameter_group(
        source, meta_ast_next(node), wanted
    );
};

@abi_export
let meta_second_parameter = std::func(
    source: addr,
    group: addr,
) -> addr {
    let first: addr = meta_ast_first(group);
    let colon: addr = meta_ast_next(first);
    let type_name: addr = meta_ast_next(colon);
    let comma: addr = meta_ast_next(type_name);
    if meta_is_comma(source, comma) { return meta_ast_next(comma); }
    return meta_ast_nil();
};

@abi_export
let meta_find_call_return_list = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let callee: addr = meta_ast_next(node);
        if meta_ast_kind(callee) == 1 {
            let arguments: addr = meta_ast_next(callee);
            if meta_ast_kind(arguments) == 2
                && meta_ast_delimiter(arguments) == 40 {
                if meta_ast_is_nil(meta_ast_first(arguments)) {
                    return node;
                }
                if meta_is_single_decimal_argument(source, arguments) {
                    return node;
                }
                if meta_is_single_arithmetic_argument(source, arguments) {
                    return node;
                }
                if meta_is_single_name_argument(arguments) {
                    return node;
                }
                if meta_is_two_decimal_arguments(source, arguments) {
                    return node;
                }
                if meta_is_two_name_arguments(source, arguments) {
                    return node;
                }
            }
        }
    }
    return meta_find_call_return_list(source, meta_ast_next(node));
};

@abi_export
let meta_find_call_return_body = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_ast_kind(node) == 2
        && meta_ast_delimiter(node) == 123 {
        let value: addr = meta_find_call_return_list(
            source, meta_ast_first(node)
        );
        if meta_ast_is_nil(value) == false { return value; }
    }
    return meta_find_call_return_body(source, meta_ast_next(node));
};

@abi_export
let meta_resolve_callee_body = std::func(
    source: addr,
    root: addr,
    callee: addr,
) -> addr {
    let dot: i64 = meta_path_dot(source, callee);
    if dot < meta_ast_length(callee) {
        let module_body: addr = meta_find_module_body(
            source, meta_ast_first(root), callee, dot
        );
        if meta_ast_is_nil(module_body) == false {
            let member: addr = meta_find_module_member(
                source, meta_ast_first(module_body), callee, dot
            );
            if meta_ast_is_nil(member) == false {
                return meta_find_first_group_after(meta_ast_next(member));
            }
        }
    }
    return meta_find_named_body(source, meta_ast_first(root), callee);
};

@abi_export
let meta_resolve_callee_name = std::func(
    source: addr,
    root: addr,
    callee: addr,
) -> addr {
    let dot: i64 = meta_path_dot(source, callee);
    if dot < meta_ast_length(callee) {
        let module_body: addr = meta_find_module_body(
            source, meta_ast_first(root), callee, dot
        );
        if meta_ast_is_nil(module_body) == false {
            let member: addr = meta_find_module_member(
                source, meta_ast_first(module_body), callee, dot
            );
            if meta_ast_is_nil(member) == false {
                return meta_ast_next(member);
            }
        }
    }
    return callee;
};

@abi_export
let meta_resolve_function_scope = std::func(
    source: addr,
    root: addr,
    callee: addr,
) -> addr {
    let dot: i64 = meta_path_dot(source, callee);
    if dot < meta_ast_length(callee) {
        let module_body: addr = meta_find_module_body(
            source, meta_ast_first(root), callee, dot
        );
        if meta_ast_is_nil(module_body) == false {
            let member: addr = meta_find_module_member(
                source, meta_ast_first(module_body), callee, dot
            );
            if meta_ast_is_nil(member) == false {
                return meta_ast_first(module_body);
            }
        }
    }
    return meta_ast_first(root);
};

@abi_export
let meta_find_local_scalar_binding = std::func(
    source: addr,
    node: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_let(source, node) {
        let name: addr = meta_ast_next(node);
        let equals: addr = meta_ast_next(name);
        let value: addr = meta_ast_next(equals);
        let value_operator: addr = meta_ast_next(value);
        let value_right: addr = meta_ast_next(value_operator);
        let semicolon: addr = meta_ast_next(value);
        let scalar_value: bool = false;
        if meta_is_decimal(source, value)
            && meta_is_semicolon(source, semicolon) {
            scalar_value = true;
        }
        let arithmetic_value: bool = false;
        if meta_is_decimal(source, value)
            && meta_is_operator(source, value_operator)
            && meta_is_decimal(source, value_right)
            && meta_is_semicolon(
                source, meta_ast_next(value_right)
            ) {
            arithmetic_value = true;
        }
        if meta_ast_kind(name) == 1
            && meta_is_equals(source, equals)
            && (scalar_value || arithmetic_value) {
            return node;
        }
    }
    return meta_find_local_scalar_binding(source, meta_ast_next(node));
};

@abi_export
let meta_find_named_return_list = std::func(
    source: addr,
    node: addr,
    name: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let value: addr = meta_ast_next(node);
        let operator: addr = meta_ast_next(value);
        let right: addr = meta_ast_next(operator);
        if meta_name_matches(source, value, name) {
            if meta_is_semicolon(source, operator) { return node; }
            if meta_is_operator(source, operator)
                && meta_is_decimal(source, right)
                && meta_is_semicolon(
                    source, meta_ast_next(right)
                ) {
                return node;
            }
        }
    }
    return meta_find_named_return_list(
        source, meta_ast_next(node), name
    );
};

@abi_export
let meta_find_two_named_return_list = std::func(
    source: addr,
    node: addr,
    first_name: addr,
    second_name: addr,
) -> addr {
    if meta_ast_is_nil(node) { return meta_ast_nil(); }
    if meta_is_return(source, node) {
        let left: addr = meta_ast_next(node);
        let operator: addr = meta_ast_next(left);
        let right: addr = meta_ast_next(operator);
        let left_known: bool = meta_name_matches(
            source, left, first_name
        );
        if left_known == false {
            left_known = meta_name_matches(source, left, second_name);
        }
        let right_known: bool = meta_name_matches(
            source, right, first_name
        );
        if right_known == false {
            right_known = meta_name_matches(source, right, second_name);
        }
        if left_known && right_known
            && meta_is_operator(source, operator)
            && meta_is_semicolon(
                source, meta_ast_next(right)
            ) {
            return node;
        }
    }
    return meta_find_two_named_return_list(
        source, meta_ast_next(node), first_name, second_name
    );
};

@abi_export
let meta_return_is_arithmetic = std::func(
    source: addr,
    return_node: addr,
) -> bool {
    let value: addr = meta_ast_next(return_node);
    if meta_is_arithmetic_group(source, value) { return true; }
    let operator: addr = meta_ast_next(value);
    let right: addr = meta_ast_next(operator);
    if meta_is_operator(source, operator) {
        if meta_is_decimal(source, right) { return true; }
    }
    return false;
};

@abi_export
let meta_binding_value_is_arithmetic = std::func(
    source: addr,
    binding: addr,
) -> bool {
    let value: addr = meta_ast_next(
        meta_ast_next(meta_ast_next(binding))
    );
    let operator: addr = meta_ast_next(value);
    let right: addr = meta_ast_next(operator);
    if meta_is_decimal(source, value)
        && meta_is_operator(source, operator)
        && meta_is_decimal(source, right) {
        if meta_is_semicolon(source, meta_ast_next(right)) {
            return true;
        }
    }
    return false;
};

// Text materialization helpers used by lowering. They copy bytes only; the
// choice of emitted LAIN-IR remains with the lowering policy.
@abi_export
let meta_literal_length = std::func(text: addr) -> i64 {
    let length: i64 = 0;
    while std::load_bits(8, text + length) != 0 {
        length = length + 1;
    }
    return length;
};

@abi_export
let meta_copy_literal = std::func(
    buffer: addr,
    offset: i64,
    text: addr,
) -> i64 {
    let length: i64 = meta_literal_length(text);
    let index: i64 = 0;
    while index < length {
        let target: i64 = offset + index;
        std::store_bits(
            8,
            buffer + target,
            std::load_bits(8, text + index),
        );
        index = index + 1;
    }
    return offset + length;
};

@abi_export
let meta_copy_source = std::func(
    buffer: addr,
    offset: i64,
    source: addr,
    node: addr,
) -> i64 {
    let data: addr = meta_source_data(source) + meta_ast_start(node);
    let length: i64 = meta_ast_length(node);
    let index: i64 = 0;
    while index < length {
        let target: i64 = offset + index;
        std::store_bits(
            8,
            buffer + target,
            std::load_bits(8, data + index),
        );
        index = index + 1;
    }
    return offset + length;
};

// Token classification is part of the formal source model.  The numeric
// word codes are private to this module; exported predicates keep callers
// independent from the spelling table and from the raw token layout.
let meta_word_code = std::func(source: addr, node: addr) -> i32 {
    if meta_ast_kind(node) != 1 { return 0; }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(node);
    let length: i64 = meta_ast_length(node);
    if length == 2
        && meta_source_byte_at(data, start) == 105
        && meta_source_byte_at(data, start + 1) == 102 {
        return 1;
    }
    if length == 3
        && meta_source_byte_at(data, start) == 108
        && meta_source_byte_at(data, start + 1) == 101
        && meta_source_byte_at(data, start + 2) == 116 {
        return 2;
    }
    if length == 4
        && meta_source_byte_at(data, start) == 109
        && meta_source_byte_at(data, start + 1) == 97
        && meta_source_byte_at(data, start + 2) == 105
        && meta_source_byte_at(data, start + 3) == 110 {
        return 3;
    }
    if length == 4
        && meta_source_byte_at(data, start) == 116
        && meta_source_byte_at(data, start + 1) == 121
        && meta_source_byte_at(data, start + 2) == 112
        && meta_source_byte_at(data, start + 3) == 101 {
        return 4;
    }
    if length == 3
        && meta_source_byte_at(data, start) == 105
        && meta_source_byte_at(data, start + 1) == 54
        && meta_source_byte_at(data, start + 2) == 52 {
        return 5;
    }
    if length == 4
        && meta_source_byte_at(data, start) == 116
        && meta_source_byte_at(data, start + 1) == 114
        && meta_source_byte_at(data, start + 2) == 117
        && meta_source_byte_at(data, start + 3) == 101 {
        return 6;
    }
    if length == 5
        && meta_source_byte_at(data, start) == 102
        && meta_source_byte_at(data, start + 1) == 97
        && meta_source_byte_at(data, start + 2) == 108
        && meta_source_byte_at(data, start + 3) == 115
        && meta_source_byte_at(data, start + 4) == 101 {
        return 7;
    }
    if length == 4
        && meta_source_byte_at(data, start) == 101
        && meta_source_byte_at(data, start + 1) == 108
        && meta_source_byte_at(data, start + 2) == 115
        && meta_source_byte_at(data, start + 3) == 101 {
        return 8;
    }
    if length == 6
        && meta_source_byte_at(data, start) == 114
        && meta_source_byte_at(data, start + 1) == 101
        && meta_source_byte_at(data, start + 2) == 116
        && meta_source_byte_at(data, start + 3) == 117
        && meta_source_byte_at(data, start + 4) == 114
        && meta_source_byte_at(data, start + 5) == 110 {
        return 9;
    }
    if length == 6
        && meta_source_byte_at(data, start) == 77
        && meta_source_byte_at(data, start + 1) == 111
        && meta_source_byte_at(data, start + 2) == 100
        && meta_source_byte_at(data, start + 3) == 117
        && meta_source_byte_at(data, start + 4) == 108
        && meta_source_byte_at(data, start + 5) == 101 {
        return 10;
    }
    if length == 6
        && meta_source_byte_at(data, start) == 109
        && meta_source_byte_at(data, start + 1) == 111
        && meta_source_byte_at(data, start + 2) == 100
        && meta_source_byte_at(data, start + 3) == 117
        && meta_source_byte_at(data, start + 4) == 108
        && meta_source_byte_at(data, start + 5) == 101 {
        return 11;
    }
    if length == 6
        && meta_source_byte_at(data, start) == 115
        && meta_source_byte_at(data, start + 1) == 116
        && meta_source_byte_at(data, start + 2) == 114
        && meta_source_byte_at(data, start + 3) == 117
        && meta_source_byte_at(data, start + 4) == 99
        && meta_source_byte_at(data, start + 5) == 116 {
        return 12;
    }
    if length == 6
        && meta_source_byte_at(data, start) == 105
        && meta_source_byte_at(data, start + 1) == 109
        && meta_source_byte_at(data, start + 2) == 112
        && meta_source_byte_at(data, start + 3) == 111
        && meta_source_byte_at(data, start + 4) == 114
        && meta_source_byte_at(data, start + 5) == 116 {
        return 13;
    }
    return 0;
};

@abi_export
let meta_is_if = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 1;
};

@abi_export
let meta_is_let = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 2;
};

@abi_export
let meta_is_main = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 3;
};

@abi_export
let meta_is_type = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 4;
};

@abi_export
let meta_is_i64 = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 5;
};

@abi_export
let meta_is_true = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 6;
};

@abi_export
let meta_is_false = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 7;
};

@abi_export
let meta_is_else = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 8;
};

@abi_export
let meta_is_return = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 9;
};

@abi_export
let meta_is_module_type = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 10;
};

@abi_export
let meta_is_module = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 11;
};

@abi_export
let meta_is_struct = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 12;
};

@abi_export
let meta_is_import = std::func(source: addr, node: addr) -> bool {
    return meta_word_code(source, node) == 13;
};

@abi_export
let meta_is_decimal = std::func(source: addr, node: addr) -> bool {
    if meta_ast_kind(node) != 1 { return false; }
    let length: i64 = meta_ast_length(node);
    if length == 0 { return false; }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(node);
    let index: i64 = 0;
    while index < length {
        let value: i8 = meta_source_byte_at(data, start + index);
        if value < 48 || value > 57 { return false; }
        index = index + 1;
    }
    return true;
};

@abi_export
let meta_is_operator = std::func(source: addr, node: addr) -> bool {
    if meta_ast_kind(node) != 1 || meta_ast_length(node) != 1 {
        return false;
    }
    let value: i8 = meta_source_byte_at(
        meta_source_data(source), meta_ast_start(node)
    );
    if value == 43 { return true; }
    if value == 45 { return true; }
    if value == 42 { return true; }
    if value == 47 { return true; }
    return false;
};

@abi_export
let meta_is_comma = std::func(source: addr, node: addr) -> bool {
    if meta_ast_kind(node) != 1 || meta_ast_length(node) != 1 {
        return false;
    }
    return meta_source_byte_at(
        meta_source_data(source), meta_ast_start(node)
    ) == 44;
};

@abi_export
let meta_is_semicolon = std::func(source: addr, node: addr) -> bool {
    if meta_ast_kind(node) != 1 || meta_ast_length(node) != 1 {
        return false;
    }
    return meta_source_byte_at(
        meta_source_data(source), meta_ast_start(node)
    ) == 59;
};

@abi_export
let meta_is_equals = std::func(source: addr, node: addr) -> bool {
    if meta_ast_kind(node) != 1 || meta_ast_length(node) != 1 {
        return false;
    }
    return meta_source_byte_at(
        meta_source_data(source), meta_ast_start(node)
    ) == 61;
};

@abi_export
let meta_is_comparison_operator = std::func(
    source: addr,
    node: addr,
) -> bool {
    if meta_ast_kind(node) != 1 || meta_ast_length(node) == 0 {
        return false;
    }
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(node);
    let length: i64 = meta_ast_length(node);
    if length == 2 {
        let first: i8 = meta_source_byte_at(data, start);
        let second: i8 = meta_source_byte_at(data, start + 1);
        if first == 61 && second == 61 { return true; }
        if first == 33 && second == 61 { return true; }
        if first == 60 && second == 61 { return true; }
        if first == 62 && second == 61 { return true; }
    }
    if length == 1 {
        let value: i8 = meta_source_byte_at(data, start);
        if value == 60 || value == 62 { return true; }
    }
    return false;
};

// Normalize operator spelling into a small source-model code so lowering does
// not read token bytes itself.  Codes 1..4 are arithmetic (+, -, *, /); codes
// 5..10 are comparisons (==, !=, <=, >=, <, >).  Zero means unsupported.
@abi_export
let meta_operator_code = std::func(
    source: addr,
    node: addr,
) -> i32 {
    if meta_ast_kind(node) != 1 { return 0; }
    let length: i64 = meta_ast_length(node);
    let data: addr = meta_source_data(source);
    let start: i64 = meta_ast_start(node);
    if length == 1 {
        let value: i8 = meta_source_byte_at(data, start);
        if value == 43 { return 1; }
        if value == 45 { return 2; }
        if value == 42 { return 3; }
        if value == 47 { return 4; }
        if value == 60 { return 9; }
        if value == 62 { return 10; }
        return 0;
    }
    if length == 2 {
        let first: i8 = meta_source_byte_at(data, start);
        let second: i8 = meta_source_byte_at(data, start + 1);
        if first == 61 && second == 61 { return 5; }
        if first == 33 && second == 61 { return 6; }
        if first == 60 && second == 61 { return 7; }
        if first == 62 && second == 61 { return 8; }
    }
    return 0;
};

@export
let meta: Module = std::module {

    // Phase values are independent of any compiler AST representation.  They
    // are the common currency between type factories, elaboration and
    // compile-time evaluation.
    @export
    let ComptimeValue: type = std::struct {
        type_id: usize,
        kind: i32,
        i32_payload: i32,
        bool_payload: bool,
        type_payload: usize,
        module_payload: usize,
        valid: bool,
    };

    @export
    let comptime_i32 = std::func(
        type_id: usize,
        value: i32,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_id,
            kind: 1,
            i32_payload: value,
            bool_payload: false,
            type_payload: 0,
            module_payload: 0,
            valid: true,
        };
    };

    @export
    let comptime_bool = std::func(
        type_id: usize,
        value: bool,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_id,
            kind: 2,
            i32_payload: 0,
            bool_payload: value,
            type_payload: 0,
            module_payload: 0,
            valid: true,
        };
    };

    @export
    let comptime_type = std::func(
        type_type_id: usize,
        value: usize,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_type_id,
            kind: 3,
            i32_payload: 0,
            bool_payload: false,
            type_payload: value,
            module_payload: 0,
            valid: value != 0,
        };
    };

    @export
    let comptime_module = std::func(
        module_type_id: usize,
        value: usize,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: module_type_id,
            kind: 4,
            i32_payload: 0,
            bool_payload: false,
            type_payload: 0,
            module_payload: value,
            valid: value != 0,
        };
    };

    @export
    let same_comptime_value = std::func(
        left: &ComptimeValue,
        right: &ComptimeValue,
    ) -> bool {
        if !left.valid || !right.valid { return false; }
        if left.type_id != right.type_id { return false; }
        if left.kind != right.kind { return false; }
        if left.kind == 1 { return left.i32_payload == right.i32_payload; }
        if left.kind == 2 { return left.bool_payload == right.bool_payload; }
        if left.kind == 3 { return left.type_payload == right.type_payload; }
        if left.kind == 4 { return left.module_payload == right.module_payload; }
        return false;
    };

    // Nominal type and module values are also phase values.  Their physical
    // ABI shape is intentionally absent here; lowering chooses that later.
    @export
    let TypeValue: type = std::struct {
        id: usize,
        kind: i32,
        argument_start: usize,
        argument_count: usize,
        nominal_owner: usize,
        namespace: usize,
    };

    @export
    let ModuleValue: type = std::struct {
        id: usize,
        namespace: usize,
    };

    @export
    let Builtins: type = std::struct {
        i32: usize,
        bool: usize,
        addr: usize,
        unit: usize,
        type: usize,
        module: usize,
        callable: usize,
    };

    // A callable's phase is part of its meta identity.  Keeping this in the
    // standard model lets every compiler front-end agree on when a value may
    // run, while the archive layer remains responsible for the actual
    // interpreter boundary.
    @export
    let CallablePhase: type = i32;

    @export
    let callable_phase_meta = std::func() -> CallablePhase { return 1; };

    @export
    let callable_phase_comptime = std::func() -> CallablePhase { return 2; };

    @export
    let callable_phase_runtime = std::func() -> CallablePhase { return 3; };

    @export
    let callable_phase_syntax = std::func() -> CallablePhase { return 4; };

    @export
    let callable_phase_backend = std::func() -> CallablePhase { return 5; };

    @export
    let Meta = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let TypeVector: type = vector.Vec(
            TypeValue,
            Memory.Allocation,
            Memory.Bounds,
        );
        let TypeArgumentVector: type = vector.Vec(
            usize,
            Memory.Allocation,
            Memory.Bounds,
        );
        let ModuleVector: type = vector.Vec(
            ModuleValue,
            Memory.Allocation,
            Memory.Bounds,
        );
        let TypeRegistry: type = std::struct {
            values: TypeVector,
            arguments: TypeArgumentVector,
            modules: ModuleVector,
            builtins: Builtins,
        };

        let new_type_registry = std::func() -> TypeRegistry
            ! {Memory.Allocation.Effect} {
            let state: TypeRegistry = TypeRegistry {
                values: TypeVector.new(),
                arguments: TypeArgumentVector.new(),
                modules: ModuleVector.new(),
                builtins: Builtins {
                    i32: 1,
                    bool: 2,
                    addr: 3,
                    unit: 4,
                    type: 5,
                    module: 6,
                    callable: 7,
                },
            };
            let id: usize = 1;
            while id <= 7 {
                state.values.push(TypeValue {
                    id: id,
                    kind: 1,
                    argument_start: 0,
                    argument_count: 0,
                    nominal_owner: 0,
                    namespace: 0,
                });
                id = id + 1;
            }
            return state;
        };

        let same_type_arguments = std::func(
            state: &TypeRegistry,
            value: &TypeValue,
            arguments: &TypeArgumentVector,
        ) -> bool ! {Memory.Bounds.Effect} {
            if value.argument_count != arguments.length() { return false; }
            let index: usize = 0;
            while index < value.argument_count {
                if *state.arguments.get(value.argument_start + index)
                    != *arguments.get(index) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        };

        let intern_type = std::func(
            state: &mut TypeRegistry,
            kind: i32,
            owner: usize,
            namespace: usize,
            arguments: &TypeArgumentVector,
        ) -> usize ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let index: usize = 0;
            while index < state.values.length() {
                let candidate: &TypeValue = state.values.get(index);
                if candidate.kind == kind && candidate.nominal_owner == owner
                    && candidate.namespace == namespace
                    && same_type_arguments(state, candidate, arguments) {
                    return candidate.id;
                }
                index = index + 1;
            }
            let argument_start: usize = state.arguments.length();
            let argument_index: usize = 0;
            while argument_index < arguments.length() {
                state.arguments.push(*arguments.get(argument_index));
                argument_index = argument_index + 1;
            }
            let id: usize = state.values.length() + 1;
            state.values.push(TypeValue {
                id: id,
                kind: kind,
                argument_start: argument_start,
                argument_count: arguments.length(),
                nominal_owner: owner,
                namespace: namespace,
            });
            return id;
        };

        let get_type = std::func(
            state: &TypeRegistry,
            id: usize,
        ) -> &TypeValue ! {Memory.Bounds.Effect} {
            if id == 0 { Memory.Bounds.check(0, state.values.length()); }
            return state.values.get(id - 1);
        };

        let intern_module = std::func(
            state: &mut TypeRegistry,
            id: usize,
            namespace: usize,
        ) -> usize ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if id == 0 { return 0; }
            let index: usize = 0;
            while index < state.modules.length() {
                let candidate: &ModuleValue = state.modules.get(index);
                if candidate.id == id && candidate.namespace == namespace {
                    return candidate.id;
                }
                index = index + 1;
            }
            state.modules.push(ModuleValue {
                id: id,
                namespace: namespace,
            });
            return id;
        };

        let get_module = std::func(
            state: &TypeRegistry,
            id: usize,
        ) -> &ModuleValue ! {Memory.Bounds.Effect} {
            let index: usize = 0;
            while index < state.modules.length() {
                let candidate: &ModuleValue = state.modules.get(index);
                if candidate.id == id { return candidate; }
                index = index + 1;
            }
            Memory.Bounds.check(id, state.modules.length());
            return state.modules.get(0);
        };

        let CallableId: type = usize;

        let Callable: type = std::struct {
            id: CallableId,
            // Keep the registry record scalar-friendly.  A String value is
            // physically a pointer to its Vec header; storing that pointer
            // avoids aggregate record lowering through generic Vec.push.
            name: addr,
            procedure: usize,
            phase: CallablePhase,
            // Zero means the callable is registered in the ambient registry;
            // a non-zero value ties it to a MetaProgram descriptor.
            program: usize,
        };

        let CallableVector: type = vector.Vec(
            Callable,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Registry: type = std::struct {
            callables: CallableVector,
        };

        let new_registry = std::func() -> Registry {
            return Registry {
                callables: CallableVector.new(),
            };
        };

        let same_name = std::func(
            left: addr,
            right: addr,
        ) -> bool {
            if left == (0 as addr) || right == (0 as addr) { return false; }
            let left_vec: addr = std::load_bits(64, left + 0);
            let right_vec: addr = std::load_bits(64, right + 0);
            if left_vec == (0 as addr) || right_vec == (0 as addr) {
                return left_vec == right_vec;
            }
            let left_length: usize = std::load_bits(64, left_vec + 8);
            let right_length: usize = std::load_bits(64, right_vec + 8);
            if left_length != right_length { return false; }
            let left_data: addr = std::load_bits(64, left_vec + 0) + 24;
            let right_data: addr = std::load_bits(64, right_vec + 0) + 24;
            let index: usize = 0;
            while index < left_length {
                if std::load_bits(8, left_data + index)
                    != std::load_bits(8, right_data + index) {
                    return false;
                }
                index = index + 1;
            }
            return true;
        };

        let register_with_phase = std::func(
            registry: &mut Registry,
            name: Memory.String,
            procedure: usize,
            phase: CallablePhase,
        ) -> CallableId ! {Memory.Allocation.Effect} {
            let id: CallableId = registry.callables.length();
            let callable: Callable = Callable {
                id: id,
                name: name as addr,
                procedure: procedure,
                phase: phase,
                program: 0,
            };
            registry.callables.push(callable);
            return id;
        };

        let register = std::func(
            registry: &mut Registry,
            name: Memory.String,
            procedure: usize,
        ) -> CallableId ! {Memory.Allocation.Effect} {
            return register_with_phase(
                registry,
                name,
                procedure,
                1,
            );
        };

        let register_in_program = std::func(
            registry: &mut Registry,
            name: Memory.String,
            procedure: usize,
            phase: CallablePhase,
            program: usize,
        ) -> CallableId ! {Memory.Allocation.Effect} {
            let id: CallableId = registry.callables.length();
            let callable: Callable = Callable {
                id: id,
                name: name as addr,
                procedure: procedure,
                phase: phase,
                program: program,
            };
            registry.callables.push(callable);
            return id;
        };

        let find = std::func(
            registry: &Registry,
            name: &Memory.String,
        ) -> CallableId ! {Memory.Bounds.Effect} {
            let index: usize = 0;
            while index < registry.callables.length() {
                let callable: &Callable = registry.callables.get(index);
                if same_name(callable.name as addr, name as addr) {
                    return callable.id;
                }
                index = index + 1;
            }
            // The bootstrap artifact uses zero for usize_max(); returning the
            // current vector length keeps “not found” distinct from id zero.
            return registry.callables.length();
        };

        // Procedure id zero is the first compiler-provided Meta primitive:
        // identity expansion.  It is intentionally a data-model helper; the
        // archive Meta layer decides how that id is executed.
        let register_identity = std::func(
            registry: &mut Registry,
        ) -> CallableId ! {Memory.Allocation.Effect} {
            let name: Memory.String = Memory.String.new();
            name.append_byte(105);
            name.append_byte(100);
            name.append_byte(101);
            name.append_byte(110);
            name.append_byte(116);
            name.append_byte(105);
            name.append_byte(116);
            name.append_byte(121);
            return register_with_phase(
                registry,
                name,
                0,
                1,
            );
        };

        return std::module {
            @export let TypeRegistry: type = TypeRegistry;
            @export let TypeArgumentVector: type = TypeArgumentVector;
            @export let new_type_registry = new_type_registry;
            @export let intern_type = intern_type;
            @export let get_type = get_type;
            @export let intern_module = intern_module;
            @export let get_module = get_module;
            @export let CallablePhase: type = CallablePhase;
            @export let callable_phase_meta = callable_phase_meta;
            @export let callable_phase_comptime = callable_phase_comptime;
            @export let callable_phase_runtime = callable_phase_runtime;
            @export let CallableId: type = CallableId;
            @export let Callable: type = Callable;
            @export let Registry: type = Registry;
            @export let new_registry = new_registry;
            @export let register_with_phase = register_with_phase;
            @export let register_in_program = register_in_program;
            @export let register = register;
            @export let register_identity = register_identity;
            @export let find = find;
        };
    };
};
