import std::os::windows::winsock;

fn tcp_listen_any(port: u16) -> usize ! {IO} {
    let startup_result = startup();
    if startup_result != 0 {
        0
    } else {
        let server = socket(2, 1, 6);
        let addr = any_addr(port);
        let bind_result = bind(server, &addr, 16);
        if bind_result != 0 {
            close_socket(server);
            0
        } else {
            let listen_result = listen(server, 16);
            if listen_result != 0 {
                close_socket(server);
                0
            } else {
                server
            }
        }
    }
}

fn tcp_accept(server: usize) -> usize ! {IO} {
    accept(server, null<*mut u8>, null<*mut i32>)
}

fn tcp_recv(socket: usize, buffer: &mut u8, len: i32) -> i32 ! {IO} {
    recv(socket, buffer, len, 0)
}

fn tcp_send(socket: usize, buffer: &u8, len: i32) -> i32 ! {IO} {
    send(socket, buffer, len, 0)
}

fn tcp_close(socket: usize) -> i32 ! {IO} {
    close_socket(socket)
}

fn tcp_shutdown() -> i32 ! {IO} {
    wsa_cleanup()
}
