// std/intrusive.lain — 侵入式链表

struct IntrusiveNode {
    next: opaque,
}

// container_of: 从节点 opaque 指针反推容器地址
// 用法: let container_addr = container_of(node_ptr, offset);
//       let container = container_addr as &MyStruct;
pub fn container_of(node: opaque, node_offset: usize) -> usize {
    let addr = node as usize;
    addr - node_offset
}

pub fn intrusive_init(head: opaque) {
    (head as &IntrusiveNode).next = 0 as opaque;
}

pub fn intrusive_insert_after(prev: opaque, new_node: opaque) {
    let prev_node = prev as &IntrusiveNode;
    (new_node as &IntrusiveNode).next = prev_node.next;
    prev_node.next = new_node as opaque;
}

pub fn intrusive_remove_next(prev: opaque) -> opaque {
    let prev_node = prev as &IntrusiveNode;
    let next_raw: opaque = prev_node.next;
    prev_node.next = (next_raw as &IntrusiveNode).next;
    next_raw
}

pub fn intrusive_next(head: opaque) -> opaque {
    (head as &IntrusiveNode).next
}
