import std::alloc;
import std::mem;
import std::option;
import std::slice;

pub struct DynArray<T> {
    ptr: opaque,
    len: usize,
    cap: usize,
}

pub impl<T> DynArray<T> {
    pub fn new() -> DynArray<T> ! {Alloc} {
        DynArray {
            ptr: usize_to_opaque(0),
            len: 0,
            cap: 0,
        }
    }

    pub fn with_capacity(n: usize) -> DynArray<T> ! {Alloc} {
        if n == 0 {
            DynArray::new<T>()
        } else {
            let bytes = n * size_of<T>();
            let raw = malloc(bytes);
            DynArray {
                ptr: raw,
                len: 0,
                cap: n,
            }
        }
    }

    pub fn push(self: &mut DynArray<T>, val: T) -> () ! {Alloc, RawPtrWrite} {
        if self.len == self.cap {
            self.grow();
        } else {};
        store(self.ptr + self.len * size_of<T>(), val);
        self.len = self.len + 1;
    }

    pub fn pop(self: &mut DynArray<T>) -> Option<T> ! {RawPtrRead} {
        if self.len == 0 {
            Option::None
        } else {
            self.len = self.len - 1;
            Option::Some(load(self.ptr + self.len * size_of<T>()))
        }
    }

    pub fn get(self: &DynArray<T>, i: usize) -> Option<&T> {
        if i >= self.len {
            Option::None
        } else {
            Option::Some(self.ptr + i * size_of<T>() as &T)
        }
    }

    pub fn len(self: &DynArray<T>) -> usize {
        self.len
    }

    pub fn as_ptr(self: &DynArray<T>) -> opaque {
        self.ptr
    }

    pub fn as_slice(self: &DynArray<T>) -> &[T] {
        slice_from_raw_parts<T>(self.ptr, self.len)
    }

    pub fn truncate(self: &mut DynArray<T>, len: usize) -> () {
        if len < self.len {
            self.len = len;
        } else {};
    }

    pub fn truncate_last(self: &mut DynArray<T>) -> () {
        if self.len > 0 {
            self.len = self.len - 1;
        } else {};
    }

    fn grow(self: &mut DynArray<T>) -> () ! {Alloc} {
        let four: usize = 4;
        let new_cap = if self.cap == 0 { four } else { self.cap * 2 };
        let bytes = new_cap * size_of<T>();
        let raw = if self.cap == 0 {
            malloc(bytes)
        } else {
            realloc(self.ptr, bytes)
        };
        self.ptr = raw;
        self.cap = new_cap;
    }
}
