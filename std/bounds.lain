// std/bounds.lain
//
// Bounds checking is a selectable effect policy.  Checked, unchecked and
// trapping behavior are handlers, not different container implementations.

let effects: Module = import("std::effect");

@export
let bounds: Module = std::module {
    @export
    let Strategy: type = i32;

    @export
    let CheckedStrategy: Strategy = 1;

    @export
    let VerifiedStrategy: Strategy = 2;

    @export
    let UncheckedStrategy: Strategy = 3;

    @export
    let RangeFact: type = std::struct {
        lower: usize,
        upper: usize,
        valid: bool,
    };

    @export
    let range_fact = std::func(lower: usize, upper: usize) -> RangeFact {
        return RangeFact {
            lower: lower,
            upper: upper,
            valid: lower <= upper,
        };
    };

    @export
    let checked_result = std::func(index: usize, length: usize) -> i32 {
        if index >= length { return 1; }
        return 0;
    };

    @export
    let verified_result = std::func(
        index: usize,
        length: usize,
        proven: bool,
    ) -> bool {
        if proven == false { return false; }
        return index < length;
    };

    @export
    let unchecked_trust = std::func() -> bool { return true; };

    @export
    let Effect: type = effects.Effect;

    @export
    let BoundsError: type = std::struct {
        index: usize,
        length: usize,
    };

    @export
    let Check = std::func(
        Policy: Module,
    ) -> effects.Effect {
        return std::effect("Bounds.Check", Policy);
    };

    @export
    let Policy: ModuleShape = std::module_shape {
        @export let Effect: effects.Effect;

        @export let check = std::func(
            index: usize,
            length: usize,
        ) -> unit ! {Effect};
    };

    @export
    let Checked: Module = std::module {
        @export let Effect: effects.Effect = bounds.Check(Checked);

        @export let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        @export let handler = std::handler(Effect) ! {
            effects.Throws(bounds.BoundsError),
        } {
            check(index, length) {
                if index >= length {
                    effects.throw(bounds.BoundsError {
                        index: index,
                        length: length,
                    });
                }
            }
        };
    };

    @export
    let Unchecked: Module = std::module {
        @export let Effect: effects.Effect = bounds.Check(Unchecked);

        @export let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        @export let handler = std::handler(Effect) {
            check(index, length) {
                // Deliberately no check.
            }
        };
    };

    @export
    let Trap: Module = std::module {
        @export let Effect: effects.Effect = bounds.Check(Trap);

        @export let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        @export let handler = std::handler(Effect) ! {
            effects.Trap,
        } {
            check(index, length) {
                if index >= length {
                    effects.trap();
                }
            }
        };
    };
};
