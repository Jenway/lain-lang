// std/bounds.lain
//
// Bounds checking is a selectable effect policy.  Checked, unchecked and
// trapping behavior are handlers, not different container implementations.

let effects: Module = import("std::effect");

@export
let bounds: Module = std::module {
    @export
    let Effect: type = effects.Effect;

    @export
    let BoundsError: type = std::struct {
        index: usize,
        length: usize,
    };

    @export
    let Check = std::func(
        Policy: Module,
    ) -> effects.Effect {
        return std::effect("Bounds.Check", Policy);
    };

    @export
    let Policy: ModuleShape = std::module_shape {
        let Effect: effects.Effect;

        let check = std::func(
            index: usize,
            length: usize,
        ) -> unit ! {Effect};
    };

    @export
    let Checked: Module = std::module {
        let Effect: effects.Effect = bounds.Check(Checked);

        let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        let handler = std::handler(Effect) ! {
            effects.Throws(bounds.BoundsError),
        } {
            check(index, length) {
                if index >= length {
                    effects.throw(bounds.BoundsError {
                        index: index,
                        length: length,
                    });
                }
            }
        };
    };

    @export
    let Unchecked: Module = std::module {
        let Effect: effects.Effect = bounds.Check(Unchecked);

        let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        let handler = std::handler(Effect) {
            check(index, length) {
                // Deliberately no check.
            }
        };
    };

    @export
    let Trap: Module = std::module {
        let Effect: effects.Effect = bounds.Check(Trap);

        let check = std::effect_operation(
            Effect,
            "check",
            std::func(index: usize, length: usize) -> unit,
        );

        let handler = std::handler(Effect) ! {
            effects.Trap,
        } {
            check(index, length) {
                if index >= length {
                    effects.trap();
                }
            }
        };
    };
};
