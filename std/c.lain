@foreign(c)
@export
let puts = std::func(message: CStr) -> i32 ! {IO};

@foreign(c)
@export
let printf = std::func(format: CStr, value: i32) -> i32 ! {IO};

@export

let print_line = std::func(message: CStr) -> i32 ! {IO} {
    puts(message)
}

@export

let print_i32 = std::func(format: CStr, value: i32) -> i32 ! {IO} {
    printf(format, value)
}
