pub {
  let is_space = func(c: u8) -> bool {
    if c == 32 { return true; }
    if c == 9 { return true; }
    if c == 13 { return true; }
    if c == 10 { return true; }
    return false;
  };

  let is_digit = func(c: u8) -> bool {
    return (c >= 48) and (c <= 57);
  };

  let is_hex_digit = func(c: u8) -> bool {
    if is_digit(c) { return true; }
    if (c >= 97) and (c <= 102) { return true; }
    if (c >= 65) and (c <= 70) { return true; }
    return false;
  };

  let is_alpha = func(c: u8) -> bool {
    if (c >= 97) and (c <= 122) { return true; }
    if (c >= 65) and (c <= 90) { return true; }
    return false;
  };

  let is_alnum = func(c: u8) -> bool {
    if is_alpha(c) { return true; }
    return is_digit(c);
  };

  let is_ident_start = func(c: u8) -> bool {
    if is_alpha(c) { return true; }
    return c == 95;
  };

  let is_ident_cont = func(c: u8) -> bool {
    if is_ident_start(c) { return true; }
    return is_digit(c);
  };

  let to_lower = func(c: u8) -> u8 {
    if (c >= 65) and (c <= 90) {
      return c + 32;
    }
    return c;
  };

  let to_upper = func(c: u8) -> u8 {
    if (c >= 97) and (c <= 122) {
      return c - 32;
    }
    return c;
  };
};
