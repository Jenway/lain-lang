@compiler_intrinsic(size_of)
pub fn size_of<T>() -> usize;

@compiler_intrinsic(ptr_cast)
pub fn ptr_cast<T, U>(ptr: *mut T) -> *mut U;

@compiler_intrinsic(usize_to_ptr)
pub fn usize_to_ptr<T>(value: usize) -> *mut T;

@compiler_intrinsic(cstr_from_ptr)
pub fn cstr_from_ptr(ptr: *mut u8) -> CStr;

@compiler_intrinsic(usize_to_i32)
pub fn usize_to_i32(value: usize) -> i32;

@compiler_intrinsic(i32_to_usize)
pub fn i32_to_usize(value: i32) -> usize;
