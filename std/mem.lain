// mem.lain — memory intrinsics

@compiler_intrinsic(size_of)
pub fn size_of<T>() -> usize;

@compiler_intrinsic(opaque_cast)
pub fn opaque_cast(ptr: opaque) -> opaque;

@compiler_intrinsic(usize_to_opaque)
pub fn usize_to_opaque(value: usize) -> opaque;

@compiler_intrinsic(cstr_from_opaque)
pub fn cstr_from_opaque(ptr: opaque) -> CStr;

@compiler_intrinsic(usize_to_i32)
pub fn usize_to_i32(value: usize) -> i32;

@compiler_intrinsic(i32_to_usize)
pub fn i32_to_usize(value: i32) -> usize;
