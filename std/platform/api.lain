// std/platform/api.lain
//
// Platform interaction is expressed as effects.  This module contains no
// callback-table Platform value and no OS implementation.

let effects: Module = import("std::effect");
let memory: Module = import("std::core::memory");
let memory_model: Module = import("std::memory_model");
let source: Module = import("std::core::source");

@export
let platform: Module = std::module {
    @export
    let Error: type = std::struct {
        code: i32,
    };

    @export
    let API = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let SourceBuffer: type = source.SourceBuffer(Memory);

        let VirtualMemory: effects.Effect =
            std::effect("Platform.VirtualMemory", Memory);
        let SourceRead: effects.Effect =
            std::effect("Platform.SourceRead", Memory);
        let ArtifactWrite: effects.Effect =
            std::effect("Platform.ArtifactWrite", Memory);
        let ConsoleWrite: effects.Effect =
            std::effect("Platform.ConsoleWrite", Memory);

        return std::module {
            @export
            let VirtualMemory: effects.Effect = VirtualMemory;

            @export
            let SourceRead: effects.Effect = SourceRead;

            @export
            let ArtifactWrite: effects.Effect = ArtifactWrite;

            @export
            let ConsoleWrite: effects.Effect = ConsoleWrite;

            @export
            let reserve_pages = std::effect_operation(
                VirtualMemory,
                "reserve_pages",
                std::func(
                    minimum_bytes: usize,
                ) -> memory.Region,
            );

            @export
            let release_pages = std::effect_operation(
                VirtualMemory,
                "release_pages",
                std::func(region: memory.Region) -> unit,
            );

            @export
            let read_source = std::effect_operation(
                SourceRead,
                "read_source",
                std::func(
                    path: &Memory.String,
                ) -> SourceBuffer,
            );

            @export
            let write_artifact = std::effect_operation(
                ArtifactWrite,
                "write_artifact",
                std::func(
                    path: &Memory.String,
                    artifact: &Memory.Bytes,
                ) -> unit,
            );

            @export
            let write_console = std::effect_operation(
                ConsoleWrite,
                "write_console",
                std::func(
                    text: &Memory.String,
                ) -> unit,
            );
        };
    };
};
