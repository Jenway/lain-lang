// std/build.lain — Build system host bindings
// These @foreign(c) are interpreter capabilities, not real C FFI.
// The L1 interpreter routes them through scheme_host_call → Scheme polyfills.
// NOTE: params use addr instead of CStr due to type lowering bug with CStr.

@foreign(c, link_name = "read_file_string")
@export
let host_read_file = std::func(path: addr) -> addr;

@foreign(c, link_name = "compile_file")
@export
let host_compile = std::func(src: addr, out: addr) -> i32;

export {
    host_read_file,
    host_compile,
}
