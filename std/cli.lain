let option = import("std::option");
let os = import("std::os");
let str = import("std::str");

pub let OptSlice = option.Option(Slice(u8));

let empty = func() -> Slice(u8) {
  return make_slice(Slice(u8), null_ref(Ref(u8)), 0);
};

pub let count = func() -> u64 {
  return os.argc();
};

pub let arg = func(i: u64) -> OptSlice.Opt {
  if i >= os.argc() {
    return OptSlice.Opt.None { };
  }
  let n: u64 = os.argv_len(i);
  let cap: u64 = n + 1;
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 {
    return OptSlice.Opt.None { };
  }
  let dst: MutSlice(u8) = make_slice(MutSlice(u8), ptr_cast(Mut(u8), raw), cap);
  let got: u64 = os.argv_copy(i, dst);
  return OptSlice.Opt.Some { make_slice(Slice(u8), ptr_cast(Ref(u8), raw), got) };
};

let release = func(s: Slice(u8)) -> u64 {
  return os.free_bytes(s.ptr as u64);
};

let flag_at = func(i: u64, flag: Slice(u8)) -> bool {
  let a: OptSlice.Opt = arg(i);
  if OptSlice.is_none(a) {
    return false;
  }
  let s: Slice(u8) = OptSlice.unwrap_or(a, empty());
  let same: bool = str.eq(s, flag);
  release(s);
  return same;
};

let plain_at = func(i: u64) -> bool {
  let a: OptSlice.Opt = arg(i);
  if OptSlice.is_none(a) {
    return false;
  }
  let s: Slice(u8) = OptSlice.unwrap_or(a, empty());
  let plain: bool = if s.len == 0 { false } else { s[0] != 45 };
  release(s);
  return plain;
};

pub let has_flag = func(flag: Slice(u8)) -> bool {
  let n: u64 = os.argc();
  let hit: bool = loop hf(i: u64 = 0, found: bool = false) while (i < n) and (found == false) {
    if flag_at(i, flag) { found = true; }
    i = i + 1;
  };
  return hit;
};

pub let get_opt = func(flag: Slice(u8)) -> OptSlice.Opt {
  let n: u64 = os.argc();
  let next: u64 = loop go(i: u64 = 0, at: u64 = 0) while (i < n) and (at == 0) {
    if flag_at(i, flag) { at = i + 1; }
    i = i + 1;
  };
  if next == 0 {
    return OptSlice.Opt.None { };
  }
  return arg(next);
};

pub let positional = func(idx: u64) -> OptSlice.Opt {
  let n: u64 = os.argc();
  let at: u64 = loop px(i: u64 = 1, seen: u64 = 0, hit: u64 = 0) while (i < n) and (hit == 0) {
    if plain_at(i) {
      if seen == idx { hit = i; }
      seen = seen + 1;
    }
    i = i + 1;
  };
  if at == 0 {
    return OptSlice.Opt.None { };
  }
  return arg(at);
};
