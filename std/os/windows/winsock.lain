#[repr(C)]
pub struct WsaData {
    version: u16,
    high_version: u16,
    description: [u8; 257],
    system_status: [u8; 129],
    max_sockets: u16,
    max_udp_dg: u16,
    vendor_info: opaque,
}

#[repr(C)]
pub struct SockAddrIn {
    family: u16,
    port: u16,
    addr: u32,
    zero: [u8; 8],
}

@foreign(c, link_name = "WSAStartup", library = "ws2_32")
pub fn wsa_startup(version: u16, data: &mut WsaData) -> i32 ! {IO};

@foreign(c, link_name = "WSACleanup", library = "ws2_32")
pub fn wsa_cleanup() -> i32 ! {IO};

@foreign(c, link_name = "socket", library = "ws2_32")
pub fn socket(af: i32, kind: i32, protocol: i32) -> usize ! {IO};

@foreign(c, link_name = "bind", library = "ws2_32")
pub fn bind(socket: usize, addr: &SockAddrIn, len: i32) -> i32 ! {IO};

@foreign(c, link_name = "listen", library = "ws2_32")
pub fn listen(socket: usize, backlog: i32) -> i32 ! {IO};

@foreign(c, link_name = "accept", library = "ws2_32")
pub fn accept(socket: usize, addr: opaque, len: opaque) -> usize ! {IO};

@foreign(c, link_name = "recv", library = "ws2_32")
pub fn recv(socket: usize, buffer: opaque, len: i32, flags: i32) -> i32 ! {IO};

@foreign(c, link_name = "send", library = "ws2_32")
pub fn send(socket: usize, buffer: opaque, len: i32, flags: i32) -> i32 ! {IO};

@foreign(c, link_name = "closesocket", library = "ws2_32")
pub fn close_socket(socket: usize) -> i32 ! {IO};

@foreign(c, link_name = "htons", library = "ws2_32")
pub fn htons(host_short: u16) -> u16 ! {IO};

fn make_wsa_data() -> WsaData {
    WsaData {
        version: 0,
        high_version: 0,
        description: [0; 257],
        system_status: [0; 129],
        max_sockets: 0,
        max_udp_dg: 0,
        vendor_info: usize_to_opaque(0),
    }
}

pub fn any_addr(port: u16) -> SockAddrIn ! {IO} {
    SockAddrIn {
        family: 2,
        port: htons(port),
        addr: 0,
        zero: [0; 8],
    }
}

pub fn startup() -> i32 ! {IO} {
    let mut data = make_wsa_data();
    wsa_startup(514, &mut data)
}
