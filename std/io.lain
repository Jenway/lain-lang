@cfg(target_os = "windows")
@foreign(c, link_name = "_write")
fn platform_write(fd: i32, buf: addr, len: usize) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "write")
fn platform_write(fd: i32, buf: addr, len: usize) -> i32 ! {IO};

fn __lain_println_raw(buf: addr, len: usize) -> () ! {IO} {
    platform_write(1, buf, len);
    return;
}
