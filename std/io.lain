// std::io —— 标准输出原语与切片辅助。
// 六个宿主原语由 lainir-run 的能力表与 C99 前导代码用同一组符号名兑现。

extern io_write(ptr: Ref(u8), len: u64) -> u64 = lain_io_write;
extern io_print_i64(v: i64) -> u64 = lain_io_print_i64;
extern io_print_u64(v: u64) -> u64 = lain_io_print_u64;
extern io_newline() -> u64 = lain_io_newline;

let write_str = func(s: Slice(u8)) -> u64 {
  return io_write(s.ptr, s.len);
};

let print = func(s: Slice(u8)) -> u64 {
  return write_str(s);
};

let println = func(s: Slice(u8)) -> u64 {
  return write_str(s) + io_newline();
};

let print_i64 = func(v: i64) -> u64 {
  return io_print_i64(v);
};

let println_i64 = func(v: i64) -> u64 {
  return io_print_i64(v) + io_newline();
};

let print_u64 = func(v: u64) -> u64 {
  return io_print_u64(v);
};

let println_u64 = func(v: u64) -> u64 {
  return io_print_u64(v) + io_newline();
};

let newline = func() -> u64 {
  return io_newline();
};
