@cfg(target_os = "windows")
@foreign(c, link_name = "_write")
let platform_write = std::func(fd: i32, buf: addr, len: usize) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "write")
let platform_write = std::func(fd: i32, buf: addr, len: usize) -> i32 ! {IO};

let __lain_println_raw = std::func(buf: addr, len: usize) -> () ! {IO} {
    platform_write(1, buf, len);
    return;
}
