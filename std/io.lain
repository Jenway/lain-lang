import std::mem;
import std::slice;
import std::string;

@cfg(target_os = "windows")
@foreign(c, link_name = "_read")
fn platform_read(fd: i32, buf: *mut u8, len: usize) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "read")
fn platform_read(fd: i32, buf: *mut u8, len: usize) -> i32 ! {IO};

@cfg(target_os = "windows")
@foreign(c, link_name = "_write")
fn platform_write(fd: i32, buf: *mut u8, len: usize) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "write")
fn platform_write(fd: i32, buf: *mut u8, len: usize) -> i32 ! {IO};

@cfg(target_os = "windows")
@foreign(c, link_name = "_open")
fn platform_open(path: CStr, flags: i32) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "open")
fn platform_open(path: CStr, flags: i32) -> i32 ! {IO};

@cfg(target_os = "windows")
@foreign(c, link_name = "_close")
fn platform_close(fd: i32) -> i32 ! {IO};

@cfg(target_os = "linux")
@foreign(c, link_name = "close")
fn platform_close(fd: i32) -> i32 ! {IO};

pub fn read(fd: i32, buf: &mut [u8]) -> i32 ! {IO} {
    platform_read(fd, slice_as_mut_ptr<u8>(buf), slice_len_mut<u8>(buf))
}

pub fn write(fd: i32, buf: &[u8]) -> i32 ! {IO} {
    platform_write(fd, slice_as_ptr<u8>(buf), slice_len<u8>(buf))
}

pub fn open(path: &[u8], flags: i32) -> i32 ! {IO} {
    platform_open(cstr_from_ptr(slice_as_ptr<u8>(path)), flags)
}

pub fn close(fd: i32) -> () ! {IO} {
    platform_close(fd);
}

pub fn print_string(message: &String) -> i32 ! {IO} {
    let result = write(1, message.as_str());
    write(1, "\n");
    result
}
