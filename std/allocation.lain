// std/allocation.lain
//
// Allocation is an effect family.  A policy Module fixes the block
// representation and the effect operations.  A handler supplies their
// implementation.

let effects: Module = import("std::effect");

@export
let allocation: Module = std::module {
    @export
    let Effect: type = effects.Effect;

    @export
    let Alloc = std::func(
        Policy: Module,
    ) -> effects.Effect {
        return std::effect("Alloc", Policy);
    };

    @export
    let Policy: ModuleShape = std::module_shape {
        @export let Block: type;
        @export let Effect: effects.Effect;

        @export let empty = std::func() -> Block;
        @export let is_empty = std::func(block: Block) -> bool;
        @export let address = std::func(block: Block) -> addr;

        @export let allocate = std::func(
            size: usize,
            alignment: usize,
        ) -> Block ! {Effect};

        @export let resize = std::func(
            block: Block,
            size: usize,
            alignment: usize,
        ) -> Block ! {Effect};

        @export let release = std::func(
            block: Block,
        ) -> unit ! {Effect};

        @export let capacity_overflow =
            std::func() -> never ! {Effect};
    };
};
