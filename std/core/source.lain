// SourceBuffer owns its path but borrows source bytes from the driver.

let memory: Module = import("std::core::memory");

@export
let source: Module = std::module {
    let MemoryShape: ModuleShape = std::module_shape {
        let String: std::type;
    };

    @export
    let SourceBuffer = std::func(
        Memory: MemoryShape,
    ) -> std::type {
        return std::struct {
            path: Memory.String,
            contents: memory.ByteSpan,
        };
    };
};
