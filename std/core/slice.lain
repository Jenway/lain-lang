// Slice is the conventional name for memory.Span.

let memory: Module = import("std::core::memory");
let bounds: Module = import("std::bounds");

@export
let slice: Module = std::module {
    @export
    let Slice = std::func(
        T: type,
        Bounds: bounds.Policy,
    ) -> type {
        return memory.Span(T, Bounds);
    };
};
