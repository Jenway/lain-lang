let vec = import("std::collections::vec");
let map = import("std::collections::map");
let mem = import("std::mem");

pub let Vec = func(T: Type) ?{ al: mem.TypedAllocator = mem.SystemTypedAlloc(T) } -> Module {
  return vec.Vec(T) ?{ al: al };
};

pub let HashMapU64 = func(V: Type) ?{ al: mem.Allocator = mem.SystemAlloc } -> Module {
  return map.HashMapU64(V) ?{ al: al };
};
