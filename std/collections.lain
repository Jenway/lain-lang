// std::collections —— 容器函子门面。
//
// 两个函子分别住在 std::collections::vec 与 std::collections::map，
// 本文件把它们的公开符号按原名称重新导出，`import("std::collections")`
// 的调用点因此照旧可用；需要只取一份容器时直接导入对应子模块。
let vec = import("std::collections::vec");
let map = import("std::collections::map");

// 宿主堆分配器驱动的可增长向量。
pub let Vec = func(T: Type) -> Module {
  return vec.Vec(T);
};

// 调用方指定分配器策略的可增长向量。
pub let VecIn = func(T: Type, Alloc: Module) -> Module {
  return vec.VecIn(T, Alloc);
};

// 宿主堆、线性 arena 与记账分配器三份策略。
pub let SystemAlloc = func(T: Type) -> Module {
  return vec.SystemAlloc(T);
};

pub let ArenaAlloc = func(T: Type) -> Module {
  return vec.ArenaAlloc(T);
};

pub let BudgetAlloc = func(T: Type) -> Module {
  return vec.BudgetAlloc(T);
};

// 宿主堆分配器驱动的 u64 键开放寻址哈希表。
pub let HashMapU64 = func(V: Type) -> Module {
  return map.HashMapU64(V);
};

// 调用方指定分配器策略的 u64 键哈希表。
pub let HashMapU64In = func(V: Type, Alloc: Module) -> Module {
  return map.HashMapU64In(V, Alloc);
};
