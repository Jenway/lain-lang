import std::dynarray;
import std::mem;
import std::slice;

pub struct String {
    buf: DynArray<u8>,
}

pub impl String {
    pub fn new() -> String ! {Alloc, RawPtrWrite} {
        String::from("")
    }

    pub fn from(s: &[u8]) -> String ! {Alloc, RawPtrWrite} {
        let mut out = String {
            buf: DynArray::with_capacity<u8>(slice_len<u8>(s) + 1),
        };
        let mut i: usize = 0;
        while i < slice_len<u8>(s) {
            out.buf.push(s[i]);
            i = i + 1;
        };
        let zero: u8 = 0;
        out.buf.push(zero);
        out
    }

    pub fn push(self: &mut String, s: &[u8]) -> () ! {Alloc, RawPtrWrite} {
        self.buf.truncate_last();
        let mut i: usize = 0;
        while i < slice_len<u8>(s) {
            self.buf.push(s[i]);
            i = i + 1;
        };
        let zero: u8 = 0;
        self.buf.push(zero);
    }

    pub fn as_str(self: &String) -> &[u8] {
        slice_from_raw_parts<u8>(self.buf.as_ptr(), self.len())
    }

    pub fn as_cstr(self: &String) -> CStr {
        cstr_from_ptr(self.buf.as_ptr())
    }

    pub fn len(self: &String) -> usize {
        let n = self.buf.len();
        if n == 0 { 0 } else { n - 1 }
    }
}
