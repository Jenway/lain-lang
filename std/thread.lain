// std::thread —— 宿主线程原语。Windows 绑定 kernel32，Linux 与 macOS 绑定 pthread。
// 线程句柄统一按 Mut(u8) 存放：Win32 的 HANDLE 与 pthread_t 都装得下 8 字节的值。
// 执行体是接收一个指针参数、返回 c_uint 的 C 函数。

pub let Thread = struct {
  handle: Mut(u8),
};

let null_handle = func() -> Mut(u8) {
  return ptr_cast(Mut(u8), 0 as u64);
};

comptime if is_windows() {
  @extern(abi = "C", link = "CreateThread")
  let c_create_thread = func(sec: Mut(u8), stack: c_size, start: Fn((Mut(u8)) -> c_uint),
                             arg: Mut(u8), flags: c_uint, tid: Mut(c_uint)) -> Mut(u8);

  @extern(abi = "C", link = "WaitForSingleObject")
  let c_wait_for_single_object = func(h: Mut(u8), ms: c_uint) -> c_uint;

  @extern(abi = "C", link = "CloseHandle")
  let c_close_handle = func(h: Mut(u8)) -> c_int;

  @extern(abi = "C", link = "Sleep")
  let c_sleep = func(ms: c_uint);

  // Win32 的无限等待毫秒值，传给 WaitForSingleObject 表示一直等到线程结束。
  let wait_infinite = func() -> u64 { return 0xffffffff; };

  let os_spawn = func(start: Fn((Mut(u8)) -> c_uint), arg: Mut(u8)) -> Thread {
    let tid: Mut(c_uint) = ptr_cast(Mut(c_uint), 0 as u64);
    let h: Mut(u8) = c_create_thread(null_handle(), 0, start, arg, 0, tid);
    return Thread { handle: h };
  };

  // 无限等待线程结束，随后关闭句柄。0 表示线程已经结束，非 0 表示等待失败。
  let os_join = func(h: Mut(u8)) -> u64 {
    if is_null(h) {
      return 1;
    }
    let ms: c_uint = wait_infinite() as c_uint;
    let rc: c_uint = c_wait_for_single_object(h, ms);
    c_close_handle(h);
    return rc as u64;
  };

  let os_sleep = func(ms: u64) -> u64 {
    c_sleep(ms as c_uint);
    return 0;
  };
} else {
  // pthread_t 的出参槽固定占 8 字节：Linux 上是 u64，macOS 上是指针。
  @extern(abi = "C", link = "pthread_create")
  let c_pthread_create = func(out: Mut(u64), attr: Mut(u8), start: Fn((Mut(u8)) -> c_uint),
                              arg: Mut(u8)) -> c_int;

  @extern(abi = "C", link = "pthread_join")
  let c_pthread_join = func(thread: Mut(u8), ret: Mut(u8)) -> c_int;

  @extern(abi = "C", link = "usleep")
  let c_usleep = func(usec: c_uint) -> c_int;

  // 0 表示创建成功，非 0 表示失败；失败时句柄为空。
  let os_spawn = func(start: Fn((Mut(u8)) -> c_uint), arg: Mut(u8)) -> Thread {
    let slot: Array(u64, 1) = [0];
    let out: Mut(u64) = mut_of(slot);
    let rc: c_int = c_pthread_create(out, null_handle(), start, arg);
    if rc != 0 {
      return Thread { handle: null_handle() };
    }
    return Thread { handle: ptr_cast(Mut(u8), deref(out)) };
  };

  // 阻塞等待线程结束，0 表示成功，非 0 表示等待失败。
  let os_join = func(h: Mut(u8)) -> u64 {
    if is_null(h) {
      return 1;
    }
    return c_pthread_join(h, null_handle()) as u64;
  };

  // usleep 的实参在部分系统上必须小于一百万微秒，按毫秒边界分块等待。
  let os_sleep = func(ms: u64) -> u64 {
    loop chunk(left: u64 = ms) while left > 0 {
      let step: u64 = if left > 1000 { 1000 } else { left };
      c_usleep((step * 1000) as c_uint);
      left = left - step;
    };
    return 0;
  };
}

// 启动执行体，返回持有线程句柄的记录。宿主拒绝创建时 handle 为空。
pub let spawn = func(start: Fn((Mut(u8)) -> c_uint), arg: Mut(u8)) -> Thread {
  return os_spawn(start, arg);
};

// 阻塞到线程结束并释放句柄，0 表示成功。
pub let join = func(t: Thread) -> u64 {
  return os_join(t.handle);
};

pub let sleep_ms = func(ms: u64) -> u64 {
  return os_sleep(ms);
};

pub let ThreadMod = module {
  pub let Self = Thread;

  pub let join = func(t: Thread) -> u64 { return os_join(t.handle); };
  pub let sleep_ms = func(ms: u64) -> u64 { return os_sleep(ms); };
};
