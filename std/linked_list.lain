// std/linked_list.lain — 单向链表

@foreign(c, link_name = "malloc")
let malloc = std::func(size: usize) -> opaque;

@foreign(c, link_name = "free")
let free = std::func(ptr: opaque);

let Node: type = std::struct {
    value: i32,
    next: opaque,
}

@export

let List: type = std::struct {
    head: opaque,
}

// ——— List 操作 ———

@export

let list_new = std::func() -> List {
    List { head: 0 as opaque }
}

@export

let list_push = std::func(head: opaque, v: i32) -> opaque {
    let raw = malloc(8);
    (raw as &Node).value = v;
    (raw as &Node).next = head;
    raw
}

@export

let list_pop = std::func(head: opaque) -> i32 {
    let val = (head as &Node).value;
    (head as &Node).value = 0;
    val
}

@export

let list_peek = std::func(head: opaque) -> i32 {
    (head as &Node).value
}

@export

let list_next = std::func(head: opaque) -> opaque {
    (head as &Node).next
}

@export

let list_free = std::func(head: opaque) {
    free(head)
}
