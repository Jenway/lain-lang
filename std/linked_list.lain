// std/linked_list.lain — Singly linked list

@foreign(c, link_name = "malloc")
pub fn malloc(size: usize) -> opaque ! {Alloc};

@foreign(c, link_name = "free")
fn free(ptr: opaque) -> () ! {Alloc};

struct Node {
    value: i32,
    next: opaque,
}

pub struct List {
    head: opaque,
}

pub impl List {
    pub fn new() -> List {
        List { head: 0 as opaque }
    }

    pub fn push(self: &mut List, v: i32) -> () ! {Alloc} {
        let raw = malloc(8);
        let node: &Node = raw as &Node;
        node.value = v;
        node.next = self.head;
        self.head = raw;
    }

    pub fn pop(self: &mut List) -> i32 ! {RawPtrRead} {
        let node: &Node = self.head as &Node;
        let val = node.value;
        self.head = node.next;
        val
    }
}
