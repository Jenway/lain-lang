// std/linked_list.lain — 单向链表

@foreign(c, link_name = "malloc")
fn malloc(size: usize) -> opaque;

@foreign(c, link_name = "free")
fn free(ptr: opaque);

struct Node {
    value: i32,
    next: opaque,
}

pub struct List {
    head: opaque,
}

// ——— List 操作 ———

pub fn list_new() -> List {
    List { head: 0 as opaque }
}

pub fn list_push(head: opaque, v: i32) -> opaque {
    let raw = malloc(8);
    (raw as &Node).value = v;
    (raw as &Node).next = head;
    raw
}

pub fn list_pop(head: opaque) -> i32 {
    let val = (head as &Node).value;
    (head as &Node).value = 0;
    val
}

pub fn list_peek(head: opaque) -> i32 {
    (head as &Node).value
}

pub fn list_next(head: opaque) -> opaque {
    (head as &Node).next
}

pub fn list_free(head: opaque) {
    free(head)
}
