#[repr(C)]
pub struct Waker {
    data: opaque,
    wake_fn: fn(opaque) -> (),
    next_data: opaque,
    next_wake_fn: fn(opaque) -> (),
}

fn noop_wake(data: opaque) -> () {}

pub impl Waker {
    pub fn new(data: opaque, wake_fn: fn(opaque) -> ()) -> Waker {
        Waker {
            data: data,
            wake_fn: wake_fn,
            next_data: usize_to_opaque(0),
            next_wake_fn: noop_wake,
        }
    }

    pub fn noop() -> Waker {
        Waker::new(usize_to_opaque(0), noop_wake)
    }

    pub fn data_ptr(self: &Waker) -> opaque {
        self.data
    }

    pub fn wake_function(self: &Waker) -> fn(opaque) -> () {
        self.wake_fn
    }

    pub fn next_data_ptr(self: &Waker) -> opaque {
        self.next_data
    }

    pub fn next_wake_function(self: &Waker) -> fn(opaque) -> () {
        self.next_wake_fn
    }

    pub fn wake(self: &Waker) -> () {
        self.wake_fn(self.data);
        self.next_wake_fn(self.next_data);
    }
}

pub effect Suspend {
    fn suspend(waker: Waker) -> ()
}
