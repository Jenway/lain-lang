#[repr(C)]
pub struct Waker {
    data: *mut u8,
    wake_fn: fn(*mut u8) -> (),
    next_data: *mut u8,
    next_wake_fn: fn(*mut u8) -> (),
}

fn noop_wake(data: *mut u8) -> () {}

pub impl Waker {
    pub fn new(data: *mut u8, wake_fn: fn(*mut u8) -> ()) -> Waker {
        Waker {
            data: data,
            wake_fn: wake_fn,
            next_data: null<*mut u8>,
            next_wake_fn: noop_wake,
        }
    }

    pub fn noop() -> Waker {
        Waker::new(null<*mut u8>, noop_wake)
    }

    pub fn data_ptr(self: &Waker) -> *mut u8 {
        self.data
    }

    pub fn wake_function(self: &Waker) -> fn(*mut u8) -> () {
        self.wake_fn
    }

    pub fn next_data_ptr(self: &Waker) -> *mut u8 {
        self.next_data
    }

    pub fn next_wake_function(self: &Waker) -> fn(*mut u8) -> () {
        self.next_wake_fn
    }

    pub fn wake(self: &Waker) -> () {
        self.wake_fn(self.data);
        self.next_wake_fn(self.next_data);
    }
}

pub effect Suspend {
    fn suspend(waker: Waker) -> ()
}
