let io = import("std::io");

let emit = func(head: Slice(u8), tag: Slice(u8), sep: Slice(u8), msg: Slice(u8)) -> u64 {
  let a: u64 = io.write_str(head);
  let b: u64 = io.write_str(tag);
  let c: u64 = io.write_str(sep);
  let d: u64 = io.write_str(msg);
  return a + b + c + d + io.newline();
};

pub let info = func(tag: Slice(u8), msg: Slice(u8)) -> u64 {
  return emit("[", tag, "] ", msg);
};

pub let pass = func(tag: Slice(u8), msg: Slice(u8)) -> u64 {
  return emit("[PASS] ", tag, ": ", msg);
};

pub let fail = func(tag: Slice(u8), msg: Slice(u8)) -> u64 {
  return emit("[FAIL] ", tag, ": ", msg);
};

pub let warn = func(tag: Slice(u8), msg: Slice(u8)) -> u64 {
  return emit("[WARN] ", tag, ": ", msg);
};
