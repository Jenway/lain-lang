// std::str —— 字节切片上的字符串判断与截取。
// 全部过程只看字节，不申请任何内存；传入的切片按借用处理，返回值也指向同一块缓冲。

let is_space = func(c: u8) -> bool {
  if c == 32 { return true; }
  if c == 9 { return true; }
  if c == 13 { return true; }
  if c == 10 { return true; }
  return false;
};

// needle 从 at 位置开始是否逐字节相等；needle 为空恒为真。
let match_at = func(s: Slice(u8), needle: Slice(u8), at: u64) -> bool {
  let same: bool = loop ma(k: u64 = 0, ok: bool = true) while (k < needle.len) and ok {
    if s[at + k] != needle[k] { ok = false; }
    k = k + 1;
  };
  return same;
};

pub let eq = func(a: Slice(u8), b: Slice(u8)) -> bool {
  if a.len != b.len { return false; }
  let same: bool = loop eq_at(k: u64 = 0, ok: bool = true) while (k < a.len) and ok {
    if a[k] != b[k] { ok = false; }
    k = k + 1;
  };
  return same;
};

pub let starts_with = func(s: Slice(u8), prefix: Slice(u8)) -> bool {
  if prefix.len > s.len { return false; }
  return match_at(s, prefix, 0);
};

pub let ends_with = func(s: Slice(u8), suffix: Slice(u8)) -> bool {
  if suffix.len > s.len { return false; }
  return match_at(s, suffix, s.len - suffix.len);
};

pub let contains = func(s: Slice(u8), needle: Slice(u8)) -> bool {
  if needle.len == 0 { return true; }
  if needle.len > s.len { return false; }
  let last: u64 = s.len - needle.len;
  let hit: bool = loop cs(i: u64 = 0, found: bool = false) while (i <= last) and (found == false) {
    if match_at(s, needle, i) { found = true; }
    i = i + 1;
  };
  return hit;
};

// 截取 [start, end)：两端都先夹到切片长度，end 小于 start 时回空切片。
pub let sub = func(s: Slice(u8), start: u64, end: u64) -> Slice(u8) {
  let n: u64 = s.len;
  let lo: u64 = if start > n { n } else { start };
  let hi: u64 = if end > n { n } else { end };
  if hi < lo {
    return make_slice(Slice(u8), s.ptr + lo, 0);
  }
  return make_slice(Slice(u8), s.ptr + lo, hi - lo);
};

// 去掉首尾的 ASCII 空白：空格、制表符、回车、换行。
pub let trim = func(s: Slice(u8)) -> Slice(u8) {
  let n: u64 = s.len;
  let lead: u64 = loop lt(i: u64 = 0) while (i < n) and is_space(s[i]) {
    i = i + 1;
  };
  let tail: u64 = loop tr(j: u64 = n) while (j > lead) and is_space(s[j - 1]) {
    j = j - 1;
  };
  return sub(s, lead, tail);
};
