use import("std::ascii")::{ is_space, is_digit, is_hex_digit };
use import("std::option")::{ Option };

let match_at = func(s: Slice(u8), needle: Slice(u8), at: u64) -> bool {
  let k: u64 = 0;
  let ok: bool = true;
  while (k < needle.len) and ok {
    if s[at + k] != needle[k] { ok = false; }
    k = k + 1;
  };
  let same: bool = ok;
  return same;
};

let digit_of = func(c: u8) -> i64 {
  if is_digit(c) {
    return (c as i64) - 48;
  }
  if (c >= 97) and (c <= 102) {
    return (c as i64) - 87;
  }
  if (c >= 65) and (c <= 70) {
    return (c as i64) - 55;
  }
  return -1;
};

pub let eq = func(a: Slice(u8), b: Slice(u8)) -> bool {
  if a.len != b.len { return false; }
  let k: u64 = 0;
  let ok: bool = true;
  while (k < a.len) and ok {
    if a[k] != b[k] { ok = false; }
    k = k + 1;
  };
  let same: bool = ok;
  return same;
};

pub let starts_with = func(s: Slice(u8), prefix: Slice(u8)) -> bool {
  if prefix.len > s.len { return false; }
  return match_at(s, prefix, 0);
};

pub let ends_with = func(s: Slice(u8), suffix: Slice(u8)) -> bool {
  if suffix.len > s.len { return false; }
  return match_at(s, suffix, s.len - suffix.len);
};

pub let contains = func(s: Slice(u8), needle: Slice(u8)) -> bool {
  if needle.len == 0 { return true; }
  if needle.len > s.len { return false; }
  let last: u64 = s.len - needle.len;
  let i: u64 = 0;
  let found: bool = false;
  while (i <= last) and (found == false) {
    if match_at(s, needle, i) { found = true; }
    i = i + 1;
  };
  let hit: bool = found;
  return hit;
};

pub let sub = func(s: Slice(u8), start: u64, end: u64) -> Slice(u8) {
  let n: u64 = s.len;
  let lo: u64 = if start > n { n } else { start };
  let hi: u64 = if end > n { n } else { end };
  if hi < lo {
    return make_slice(Slice(u8), s.ptr + lo, 0);
  }
  return make_slice(Slice(u8), s.ptr + lo, hi - lo);
};

pub let trim = func(s: Slice(u8)) -> Slice(u8) {
  let n: u64 = s.len;
  let i: u64 = 0;
  while (i < n) and is_space(s[i]) {
    i = i + 1;
  };
  let lead: u64 = i;
  let j: u64 = n;
  while (j > lead) and is_space(s[j - 1]) {
    j = j - 1;
  };
  let tail: u64 = j;
  return sub(s, lead, tail);
};

pub let parse_i64 = func(s: Slice(u8)) -> Option(i64) {
  let n: u64 = s.len;
  let i: u64 = 0;
  let neg: bool = false;
  if (n > 0) and ((s[0] as u64) == 45) {
    neg = true;
    i = 1;
  }
  if (n > 0) and ((s[0] as u64) == 43) {
    i = 1;
  }
  let radix: i64 = 10;
  if ((i + 1) < n) and ((s[i] as u64) == 48) and (((s[i + 1] as u64) == 120) or ((s[i + 1] as u64) == 88)) {
    radix = 16;
    i = i + 2;
  }
  let acc: i64 = 0;
  let seen: bool = false;
  let stop: bool = false;
  while (i < n) and (stop == false) {
    let c: u8 = s[i];
    if (c as u64) == 95 {
      i = i + 1;
    } else {
      let ok: bool = is_digit(c) or (is_hex_digit(c) and (radix == 16));
      if ok {
        acc = acc * radix + digit_of(c);
        seen = true;
        i = i + 1;
      } else {
        stop = true;
      }
    }
  };
  if seen == false {
    return Option(i64)::none();
  }
  if neg {
    return Option(i64)::some(0 - acc);
  }
  return Option(i64)::some(acc);
};
