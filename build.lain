// build.lain —— 纯 Lain 自举构建与全量验证入口（类比 `build.zig`）。
// 零 Python / 零 CMake / 零 seed C 工具链：直接编排 Stage-1 -> Stage-2 -> Stage-3 固定点，
// 再跑 examples/overhaul_showcase.lain 冒烟与 test.lain 全量回归。
// 默认走快速模式：build/lainc 已存在就直接复用它跑两套用例；
// 加上 --bootstrap 才完整重跑 Stage-1/2/3 固定点校验。
let os = import("std::os");
let fs = import("std::fs");
let cli = import("std::cli");
let log = import("std::log");
let str = import("std::str");
let bld = import("std::build");

use bld;

// --- 工具链命令 ------------------------------------------------------------
// 可执行文件路径按编译目标取字面量：comptime if 只保留当前平台的分支。
let lainc_bin = func() -> Slice(u8) {
  let p: Slice(u8) = "./build/lainc";
  comptime if is_windows() { p = "build\\lainc.exe"; };
  return p;
};

let stage2_bin = func() -> Slice(u8) {
  let p: Slice(u8) = "./build/lainc_stage2";
  comptime if is_windows() { p = "build\\lainc_stage2.exe"; };
  return p;
};

let showcase_bin = func() -> Slice(u8) {
  let p: Slice(u8) = "./build/showcase";
  comptime if is_windows() { p = "build\\showcase.exe"; };
  return p;
};

let test_bin = func() -> Slice(u8) {
  let p: Slice(u8) = "./build/test_runner";
  comptime if is_windows() { p = "build\\test_runner.exe"; };
  return p;
};

// clang 的 C99 编译命令；Windows 额外预留 16 MiB 栈。
let compile_c = func(src: Slice(u8), out: Slice(u8)) -> Slice(u8) {
  let stack: Slice(u8) = "";
  comptime if is_windows() { stack = "-Wl,/STACK:16777216 "; };
  return f"clang -std=c99 -O2 {stack}{src} -o {out}";
};

// lainc 的编译命令；with_entry 为真时显式指定入口 main。
let lainc_run = func(compiler: Slice(u8), src: Slice(u8), with_entry: bool, out: Slice(u8)) -> Slice(u8) {
  let entry: Slice(u8) = "";
  if with_entry { entry = " --entry main"; }
  return f"{compiler} {src}{entry} --out {out}";
};

// --- 步骤播报与退出码判定 --------------------------------------------------
let fail_step = func(label: Slice(u8), code: u64) -> u64 {
  log.fail(label, f"exit={code}");
  return code;
};

// 跑一步并播报；非零退出码就地打出 [FAIL] 并回该退出码。
let run_step = func(label: Slice(u8), cmd: Slice(u8)) -> u64 {
  log.info("build", label);
  return handle os.exec_or_err(cmd) with {
    return(v) => 0,
    fail(code) => fail_step(label, code),
  };
};

// 跑一步并校验约定退出码。
let expect_exit = func(label: Slice(u8), cmd: Slice(u8), want: u64) -> u64 {
  log.info("build", label);
  let rc = os.exec(cmd);
  if rc != want {
    log.fail(label, f"exit={rc}, expected {want}");
    return 1;
  }
  log.pass(label, f"exit={want}");
  return 0;
};

let prepare_build_dir = func() -> u64 {
  let cmd: Slice(u8) = "mkdir -p build";
  comptime if is_windows() { cmd = "cmd /c if not exist build mkdir build"; };
  return run_step("prepare build directory", cmd);
};

// --- 文件比较 --------------------------------------------------------------
// 两个 File 句柄都用栈上 1024 字节块流式对读，任何路径返回时由 File 自带的
// drop 关闭句柄；长度或任一字节不同立即回 false。
let compare_open = func(a: Slice(u8), b: Slice(u8)) -> bool !{ os.IoErr } {
  let fa: fs.File = fs.File.open(a, "rb")!;
  let fb: fs.File = fs.File.open(b, "rb")!;
  let pa: Mut(fs.File) = mut_of(fa);
  let pb: Mut(fs.File) = mut_of(fb);
  let raw_a: Array(u8, 1024) = [0; 1024];
  let raw_b: Array(u8, 1024) = [0; 1024];
  let chunk_a: MutSlice(u8) = make_slice(MutSlice(u8), ptr_cast(Mut(u8), mut_of(raw_a)), 1024);
  let chunk_b: MutSlice(u8) = make_slice(MutSlice(u8), ptr_cast(Mut(u8), mut_of(raw_b)), 1024);
  let same = true;
  let done = false;
  while (done == false) and same {
    let na = fs.File.read(pa, chunk_a)!;
    let nb = fs.File.read(pb, chunk_b)!;
    if na != nb {
      same = false;
    } else {
      if na == 0 {
        done = true;
      } else {
        let sa: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), chunk_a.ptr), na);
        let sb: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), chunk_b.ptr), nb);
        if str.eq(sa, sb) == false { same = false; }
      }
    }
  }
  return same;
};

// 打开或读取失败一律视为不相等。
let files_equal = func(a: Slice(u8), b: Slice(u8)) -> bool {
  return handle compare_open(a, b) with {
    return(v) => v,
    fail(code) => false,
  };
};

// --- 自举固定点 ------------------------------------------------------------
// Stage-1 冷启动 -> Stage-2 -> Stage-3，并校验 stage2.l1 与 stage3.l1 字节一致。
let run_bootstrap = func() -> u64 {
  if run_step("Stage-1: compile lainc_boot.c",
              compile_c("bootstrap/lainc_boot.c", lainc_bin())) != 0 { return 1; }
  if run_step("Stage-2 IR: lainc src/driver/entry.lain -> build/stage2.l1",
              lainc_run(lainc_bin(), "src/driver/entry.lain", false, "build/stage2.l1")) != 0 { return 1; }
  if run_step("Stage-2 C99: lainc src/driver/entry.lain -> build/stage2.c",
              lainc_run(lainc_bin(), "src/driver/entry.lain", true, "build/stage2.c")) != 0 { return 1; }
  if run_step("Stage-2 bin: compile build/stage2.c",
              compile_c("build/stage2.c", stage2_bin())) != 0 { return 1; }
  if run_step("Stage-3 IR: lainc_stage2 src/driver/entry.lain -> build/stage3.l1",
              lainc_run(stage2_bin(), "src/driver/entry.lain", false, "build/stage3.l1")) != 0 { return 1; }

  if files_equal("build/stage2.l1", "build/stage3.l1") == false {
    log.fail("Fixed point", "stage2.l1 != stage3.l1");
    return 1;
  }
  log.pass("Fixed point", "stage2.l1 == stage3.l1");
  return 0;
};

// --- 冒烟与全量回归 --------------------------------------------------------
let run_suites = func(compiler: Slice(u8)) -> u64 {
  // 冒烟：examples/overhaul_showcase.lain 的约定退出码是 126
  if run_step("Showcase C99: examples/overhaul_showcase.lain -> build/showcase.c",
              lainc_run(compiler, "examples/overhaul_showcase.lain", false, "build/showcase.c")) != 0 { return 1; }
  if run_step("Showcase bin: compile build/showcase.c",
              compile_c("build/showcase.c", showcase_bin())) != 0 { return 1; }
  if expect_exit("Run examples/overhaul_showcase.lain", showcase_bin(), 126) != 0 { return 1; }

  // 全量回归：test.lain
  if run_step("Tests C99: test.lain -> build/test_runner.c",
              lainc_run(compiler, "test.lain", false, "build/test_runner.c")) != 0 { return 1; }
  if run_step("Tests bin: compile build/test_runner.c",
              compile_c("build/test_runner.c", test_bin())) != 0 { return 1; }
  if run_step("Run test.lain", test_bin()) != 0 { return 1; }
  return 0;
};

let main = func() -> i64 {
  let bootstrap = cli.has_flag("--bootstrap");

  let os_tag: bld.Os = bld.Os.Linux { };
  comptime if is_windows() { os_tag = bld.Os.Windows { }; };
  let arch: bld.Arch = bld.Arch.X86_64 { };
  let opt: bld.OptMode = bld.OptMode.ReleaseFast { };
  let env = bld.TargetEnv {
    os: ref_of(os_tag),
    arch: ref_of(arch),
    opt: ref_of(opt),
  };
  let g: bld.Graph = bld.new_graph(env);
  let app = g.add_executable("lainc", "src/driver/entry.lain", "src", "entry");
  let tests = g.add_test("all_tests", "test.lain", "test", "test");
  g.link(tests, app);
  let steps = g.step_count();
  let edges = g.edge_count();
  log.info("build.lain", f"graph steps={steps}, edges={edges}");

  if prepare_build_dir() != 0 { return 1; }

  if bootstrap {
    if run_bootstrap() != 0 { return 1; }
    if run_suites(stage2_bin()) != 0 { return 1; }
  } else {
    if fs.exists(lainc_bin()) {
      log.info("build", "fast mode: reusing existing lainc binary (pass --bootstrap for full Stage-1/2/3)");
    } else {
      if run_step("Stage-1: compile lainc_boot.c",
                  compile_c("bootstrap/lainc_boot.c", lainc_bin())) != 0 { return 1; }
    }
    if run_suites(lainc_bin()) != 0 { return 1; }
  }

  log.info("build.lain", "ALL DONE");
  return 0;
};
