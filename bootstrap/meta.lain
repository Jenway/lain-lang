// 模块：Meta 本体。三个入口（lain_std_abi_version / lain_std_initialize / lain_std_lower）在清单里标成根名、发出平坦名字；其余跨单元引用一律写 `别名.名字`。
let std_declarations = import("std/declarations");
let std_emit = import("std/emit");
let std_eval = import("std/eval");
let std_expand = import("std/expand");
let std_funcs = import("std/funcs");
let std_handlers_let = import("std/handlers/let");
let std_lainir = import("std/lainir");
let std_lex = import("std/lex");
let std_modules = import("std/modules");
let std_parse = import("std/parse");
let std_recognize = import("std/recognize");
let std_records = import("std/records");
let std_registry = import("std/registry");
let std_scalars = import("std/scalars");
let std_scope = import("std/scope");
let std_sums = import("std/sums");
let std_syntax = import("std/syntax");
let std_types = import("std/types");

extern lain_meta_apply_status() -> u64 = lain_meta_apply_status;
extern lain_meta_emit_reset() -> u32 = lain_meta_emit_reset;
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_scratch_report(peak: u64) -> u64 = lain_meta_scratch_report;
extern lain_meta_source_data(index: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(index: u64) -> u64 = lain_meta_source_length;

func lain_std_abi_version() -> u64 {
  return 9;
}

func lain_std_initialize() -> u32 {
  return 0;
}

func lain_std_lower(source: u64) -> u32 {
  let has_tree: bool = std_parse.meta_source_has_tree(source);
  let no_tree: bool = has_tree == 0;
  if no_tree {
    let ft: u32 = lain_meta_fail(3);
    return 3;
  }
  // 诊断（宿主槽 30）：入口标记。用来确认 trace 通道本身是否工作。
  let reset: u32 = lain_meta_emit_reset();
  // 先认领 scratch 的固定区与 bump 区。Expand 自身需要有界临时帧；它不消费
  // 这次预扫描产生的语义结果。提交新 Root 后立即重新 setup，从新树重建所有表。
  let pre_setup: u32 = std_scope.meta_scope_setup(0);
  let pre_bad: bool = pre_setup != 0;
  if pre_bad {
    return pre_setup;
  }
  let expanded: u32 = std_expand.meta_expand_declared_source(source);
  let expand_bad: bool = expanded != 0;
  if expand_bad { return expanded; }
  // 作用域表要先建：外层是 root 环境，内层是这份源码。
  let setup: u32 = std_scope.meta_scope_setup(1);
  let ok: bool = setup == 0;
  // 值 if 之后还有无条件执行的 peak / reported，所以用一次性选择循环而不是守卫。
  let status: u32 = loop pick_status(t: u64 = 0) {
    if ok {
      let len: u64 = lain_meta_source_length(source);
      let base: addr = lain_meta_source_data(source);
      let mark: u64 = std_scope.meta_scope_count();
      let cur: u32 = std_scope.meta_scope_set_current(source);
      let scan: u32 = std_scope.meta_scope_scan(base, len, source, mark);
      let b2: bool = scan == 0;
      // setup 已识别所有源码；旁表按出现位置共存，不重复扫描。
      let s: u32 = if b2 {
        let r: u32 = meta_lower_source(source);
        r
      } else {
        scan
      };
      break pick_status(s);
    }
    break pick_status(setup);
  };
  let peak: u64 = std_scope.meta_bump_peak();
  let reported: u64 = lain_meta_scratch_report(peak);
  return status;
}

func meta_lower_source(source: u64) -> u32 {
  let len: u64 = lain_meta_source_length(source);
  let base: addr = lain_meta_source_data(source);
  let root: u64 = std_parse.meta_root_of(source);
  let count: u64 = std_parse.ast_child_count(root);
  let empty: bool = count == 0;
  if empty {
    let fe: u32 = lain_meta_fail(4);
    return 4;
  }
  let status: u32 = loop forms(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let node: u64 = std_parse.ast_child(root, i);
      let here: u64 = std_parse.meta_node_start(node);
      let handler: u64 = std_syntax.meta_syntax_lookup(node, 1, 0, 1);
      let any: bool = handler != 0;
      let s: u32 = loop pick_s(t: u64 = 0) {
        if any {
          let d: u32 = std_declarations.meta_lower_decl_invoke(handler, base, len, here, root, i, node);
          break pick_s(d);
        }
        // 顶层树的孩子是词，不是形式：跳过一条形式内部那些非关键字的词是正常的；
        // 但整份文件的第一个孩子必须是能被认出的形式，否则就是坏输入。
        let is_first: bool = i == 0;
        if is_first {
          let f: u32 = lain_meta_fail(4);
          break pick_s(4);
        }
        break pick_s(0);
      };
      let bad: bool = s != 0;
      if bad {
        break forms(s);
      }
      let i2: u64 = i + 1;
      continue forms(i2);
    } else {
      break forms(0);
    }
  };
  return status;
}

func meta_lower_struct(base: addr, len: u64, kw_at: u64) -> u32 {
  let after: u64 = kw_at + 6;
  let name_lo: u64 = std_lex.bs_skip_space(base, after, len);
  let name_hi: u64 = std_lex.bs_skip_ident(base, name_lo, len);
  let has_name: bool = name_lo < name_hi;
  // 旧 IR 的 %status 值 if：支里还嵌着 %inner / %s / %code 三层值 if，结果直接
  // 喂给 #return。改成平坦守卫：has_name 不成立就是旧 IR 的 else 支（fail(4) + 4）。
  if has_name == 0 {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  let brace: u64 = std_lex.bs_skip_space(base, name_hi, len);
  let is_open: bool = std_lex.bs_is_byte(base, brace, 123);
  if is_open == 0 {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let body: u64 = brace + 1;
  let size: u64 = meta_struct_fields(base, len, name_lo, name_hi, body, 0, 1);
  let failed: bool = size == 0xFFFFFFFFFFFFFFFF;
  if failed {
    let reset: u32 = lain_meta_emit_reset();
    let eval_code: u64 = lain_meta_apply_status();
    let has_eval_code: bool = eval_code > 0;
    if has_eval_code {
      let low: u32 = eval_code as u32;
      return low;
    }
    return 7;
  }
  let w: u32 = meta_emit_size(base, name_lo, name_hi, size);
  return 0;
}

func meta_struct_fields(base: addr, len: u64, rec_lo: u64, rec_hi: u64, at: u64, off: u64, max_align: u64) -> u64 {
  let size: u64 = loop fields(cur_at: u64 = at, cur_off: u64 = off, cur_al: u64 = max_align) {
    let here: u64 = std_lex.bs_skip_space(base, cur_at, len);
    let byte: u8 = std_lex.bs_byte_at(base, here, len);
    let byte_w: u32 = byte as u32;
    let is_close: bool = byte_w == 125;
    if is_close {
      let rounded: u64 = std_eval.meta_eval_align_up(cur_off, cur_al, base, here);
      break fields(rounded);
    }
    // 字段名 : 类型名
    let f_hi: u64 = std_lex.bs_skip_ident(base, here, len);
    let colon: u64 = std_lex.bs_skip_space(base, f_hi, len);
    let one: u64 = colon + 1;
    let t_lo: u64 = std_lex.bs_skip_space(base, one, len);
    let t_hi: u64 = std_lex.bs_skip_qualified(base, t_lo, len);
    // 查字段类型（root 环境或命名空间成员）——拿到的是类型 id
    let tid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
    let bad_type: bool = tid == 0;
    if bad_type {
      let f3: u32 = lain_meta_fail(5);
      return 0xFFFFFFFFFFFFFFFF;
    }
    let tinfo: u64 = std_registry.meta_tid_repr(tid);
    let kind: u64 = tinfo and 255;
    let width: u64 = (tinfo >> 8) and 255;
    let fsize: u64 = std_registry.meta_tid_size(tid);
    let falign: u64 = std_registry.meta_tid_align(tid);
    let aligned: u64 = std_lex.bs_align_up(cur_off, falign);
    let emit: u32 = meta_emit_field_offset(base, len, rec_lo, rec_hi, here, f_hi, aligned);
    let next_off: u64 = aligned + fsize;
    let bigger: bool = falign > cur_al;
    let new_al: u64 = if bigger {
      falign
    } else {
      cur_al
    };
    continue fields(t_hi, next_off, new_al);
  };
  return size;
}

func meta_emit_field_offset(base: addr, len: u64, rec_lo: u64, rec_hi: u64, f_lo: u64, f_hi: u64, value: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let rec_at: addr = base + rec_lo;
  let rec_len: u64 = rec_hi - rec_lo;
  let a1: u64 = std_lainir.lainir_buf_bytes(buf, 0, rec_at, rec_len);
  let d: addr = std_emit.meta_dsep;
  let a2: u64 = std_lainir.lainir_buf_bytes(buf, a1, d, 2);
  let f_at: addr = base + f_lo;
  let f_len: u64 = f_hi - f_lo;
  let a3: u64 = std_lainir.lainir_buf_bytes(buf, a2, f_at, f_len);
  let suf: addr = std_emit.meta_foff;
  let nlen: u64 = std_lainir.lainir_buf_bytes(buf, a3, suf, 7);
  let h: u32 = std_lainir.lainir_proc_head_full(buf, nlen, buf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let r: u32 = std_lainir.lainir_return_uint(value);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

func meta_emit_size(base: addr, rec_lo: u64, rec_hi: u64, value: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let rec_at: addr = base + rec_lo;
  let rec_len: u64 = rec_hi - rec_lo;
  let a1: u64 = std_lainir.lainir_buf_bytes(buf, 0, rec_at, rec_len);
  let suf: addr = std_emit.meta_rsize;
  let nlen: u64 = std_lainir.lainir_buf_bytes(buf, a1, suf, 6);
  let h: u32 = std_lainir.lainir_proc_head_full(buf, nlen, buf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let r: u32 = std_lainir.lainir_return_uint(value);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

func meta_lower_let(base: addr, len: u64, let_at: u64) -> u32 {
  let after: u64 = let_at + 3;
  let name_lo: u64 = std_lex.bs_skip_space(base, after, len);
  let name_hi: u64 = std_lex.bs_skip_ident(base, name_lo, len);
  let has_name: bool = name_lo < name_hi;
  if has_name {
    let s: u32 = meta_lower_binding(base, len, name_lo, name_hi);
    return s;
  }
  let f: u32 = lain_meta_fail(4);
  return 4;
}

func meta_lower_binding(base: addr, len: u64, name_lo: u64, name_hi: u64) -> u32 {
  let at: u64 = std_lex.bs_skip_space(base, name_hi, len);
  let is_eq: bool = std_lex.bs_is_byte(base, at, 61);
  // 旧 IR 的 %is_import 是 bool 值 if（真支算关键字匹配，假支裸 0），结果只喂给语句
  // if：改成平坦守卫。is_eq 不成立时旧 IR 直接走 else 支，这里跳过整块。
  if is_eq {
    let one: u64 = at + 1;
    let kw_at: u64 = std_lex.bs_skip_space(base, one, len);
    let kw: addr = std_modules.meta_kw_import;
    let k: bool = std_lex.bs_match_keyword(base, kw_at, len, kw, 6);
    if k {
      let s0: u32 = std_modules.meta_lower_import(base, len, at);
      return s0;
    }
  }
  // 旧 IR 的 %status 值 if（支里嵌着 %s1，%s1 支里再嵌 %s）结果喂给 #return。
  let is_colon: bool = std_lex.bs_is_byte(base, at, 58);
  if is_colon {
    let after: u64 = at + 1;
    let t_lo: u64 = std_lex.bs_skip_space(base, after, len);
    // 表标注：`:` 后面直接是 `[T]` 或 `ro [T]`，由 meta_lower_table 接管。
    let t_b0: u8 = std_lex.bs_byte_at(base, t_lo, len);
    let t_b0_w: u32 = t_b0 as u32;
    let t_is_tbl: bool = t_b0_w == 91;
    let t_is_ro: bool = std_lex.bs_match_keyword(base, t_lo, len, std_lex.meta_kw_ro, 2);
    let t_tbl: bool = t_is_tbl or t_is_ro;
    if t_tbl {
      let ts: u32 = std_handlers_let.meta_lower_table(base, len, name_lo, name_hi, at);
      return ts;
    }
    // 类型名可能是限定名（`W.w32`），所以不是 bs_skip_ident
    let t_hi: u64 = std_lex.bs_skip_qualified(base, t_lo, len);
    let s1: u32 = meta_lower_typed(base, len, name_lo, name_hi, t_lo, t_hi);
    return s1;
  }
  let s2: u32 = meta_lower_typed(base, len, name_lo, name_hi, 0, 0);
  return s2;
}

func meta_lower_typed(base: addr, len: u64, name_lo: u64, name_hi: u64, t_lo: u64, t_hi: u64) -> u32 {
  let has_type: bool = t_lo < t_hi;

  // 类型名 → 注册表里的**类型 id**。没有标注时给合成的 `#bits<64>`（owner 0）。
  let resolved: u64 = if has_type {
    let e: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
    e
  } else {
    let d: u64 = std_registry.meta_intern(1, 0, 0, 0, 64);
    d
  };
  let unknown: bool = resolved == 0;
  if unknown {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }

  // repr 从注册表里读——它是身份的**后果**，不是身份本身
  let info: u64 = std_registry.meta_tid_repr(resolved);
  let kind: u64 = info and 255;
  let width: u64 = (info >> 8) and 255;

  // 从类型名之后接着解析；没有标注就从名字之后
  let resume: u64 = if has_type {
    t_hi
  } else {
    name_hi
  };
  let eq_at: u64 = std_lex.bs_skip_space(base, resume, len);
  let is_eq: bool = std_lex.bs_is_byte(base, eq_at, 61);
  // 旧 IR 的 %status 值 if（支里嵌着 %inner）结果直接喂给 #return：改成平坦守卫。
  if is_eq == 0 {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let after_eq: u64 = eq_at + 1;
  let lhs_lo: u64 = std_lex.bs_skip_space(base, after_eq, len);
  // 值的第一个 token 的终点。`bs_skip_ident` 对 `(` 这类开头**不前进** —— 那样
  // `(1 + 2) + 3` 会被当成「`=` 后面没有值」报 3。括号开头的值第一个节点是那个组，
  // 终点由树给，所以这里只要保证 `lhs_hi > lhs_lo` 就行。
  let lhs_id: u64 = std_lex.bs_skip_ident(base, lhs_lo, len);
  let lhs_adv: bool = lhs_lo < lhs_id;
  let lhs_hi: u64 = if lhs_adv {
    lhs_id
  } else {
    let one: u64 = lhs_lo + 1;
    one
  };
  // 「有没有值」看的是 `=` 后面还有没有字节，不是识不识别得出标识符。
  let has_lhs: bool = lhs_lo < len;
  if has_lhs == 0 {
    let f2: u32 = lain_meta_fail(3);
    return 3;
  }
  let s: u32 = meta_emit_value(base, len, name_lo, name_hi, kind, width, t_lo, t_hi, lhs_lo, lhs_hi);
  return s;
}

func meta_emit_value(base: addr, len: u64, name_lo: u64, name_hi: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, lhs_lo: u64, lhs_hi: u64) -> u32 {
  // 字节串字面量：整段是一个静态字节块的顶层绑定（`data` 只能落顶层）。
  let is_bytes: bool = std_lex.bs_is_byte(base, lhs_lo, 34);
  if is_bytes {
    let bytes_st: u32 = std_handlers_let.meta_lower_static_bytes(base, len, name_lo, name_hi, lhs_lo);
    return bytes_st;
  }
  // 取表地址：`let X: addr = NAME;`（值只有一个名字 token，且 NAME 是当前作用域
  // 里的表绑定）。不是表就走原来的路 —— 这里只看，不改别处的行为。
  let tab_esz: u64 = meta_scope_table_esz(base, len, lhs_lo, lhs_hi);
  let tab_is: bool = tab_esz != 0;
  if tab_is {
    return meta_emit_addr_binding(base, len, name_lo, name_hi);
  }
  // 「是一条表达式」有三条进路：形状 4（二元）、形状 2（组）、整段里有算子。
  // 最后这条必须单独判：形状 5/6/10 说的是「这里开始一次调用/字段访问/构造」，
  // 不是「整个值就是它」。
  let form: u64 = std_recognize.meta_form_at(base, lhs_lo);
  let hasop: bool = std_recognize.meta_value_has_op(base, len, lhs_lo);
  let f_bin: bool = form == 4;
  let f_grp: bool = form == 2;
  let f_const: bool = form == 7;
  let e1: bool = f_bin or f_grp;
  let is_expr: bool = e1 or hasop;
  if is_expr {
    let s: u32 = meta_emit_chain(base, len, name_lo, name_hi, kind, width, t_lo, t_hi, lhs_lo, lhs_hi);
    return s;
  }
  if f_const {
    let s0: u32 = meta_emit_numeric(base, len, name_lo, name_hi, kind, width, t_lo, t_hi, lhs_lo, lhs_hi);
    return s0;
  }
  // 标识符到哪结束仍然要算：下面的降级点按字节区间工作。那是位置，不是形状。
  let rec_hi: u64 = std_lex.bs_skip_ident(base, lhs_lo, len);
  let after: u64 = std_lex.bs_skip_space(base, rec_hi, len);
  let single: bool = hasop == 0;
  let f_ctor0: bool = form == 10;
  let f_field0: bool = form == 6;
  let f_call0: bool = form == 5;
  // 三段值里还带算子 → 三个都是假 → 落到最里面那条 lain_meta_fail(4)
  let f_construct: bool = f_ctor0 and single;
  let f_field: bool = f_field0 and single;
  let f_call: bool = f_call0 and single;
  if f_construct {
    // 构造：这个类型的正文从哪开始，问符号表，不回源码里找
    let tb: u64 = std_records.meta_scope_body(base, lhs_lo, rec_hi, 4);
    // 初始化列表那个组节点：值名在根里的下一个兄弟。`meta_cursor_at` 命中值名，
    // 父组从 `meta_cursor_parent()` 取 —— 必须紧接着用。
    let root0: u64 = std_parse.meta_root_of_source(base);
    let vix: u64 = std_recognize.meta_cursor_at(root0, lhs_lo);
    let vmiss: bool = vix == 0xFFFFFFFFFFFFFFFF;
    if vmiss {
      let vg: u32 = lain_meta_fail(4);
      return 4;
    }
    let vparent: u64 = std_recognize.meta_cursor_parent();
    let vnext: u64 = vix + 1;
    let cgrp: u64 = std_parse.ast_child(vparent, vnext);
    let r1: u32 = std_records.meta_lower_construct(base, len, name_lo, name_hi, tb, cgrp);
    return r1;
  }
  if f_field {
    let dot: u64 = after + 1;
    let m_lo: u64 = std_lex.bs_skip_space(base, dot, len);
    let m_hi: u64 = std_lex.bs_skip_ident(base, m_lo, len);
    // `A.b` 里的 `A` 可能是三种东西，形状完全不同：
    //   import 绑定 → 跨模块取值（mangle 成扁平名 + #call）
    //   enum        → 变体构造／投影
    //   其余        → struct 字段访问
    let ns_at: u64 = std_modules.meta_find_import_binding(base, len, lhs_lo, rec_hi);
    let is_ns: bool = ns_at != 0;
    let is_sum: bool = std_sums.meta_is_enum(base, len, lhs_lo, rec_hi);
    // struct 字段访问要的正文起点，也问符号表
    let tb2: u64 = std_records.meta_scope_body(base, lhs_lo, rec_hi, 4);
    if is_ns {
      let r7: u32 = std_modules.meta_lower_ns_value(base, len, name_lo, name_hi, lhs_lo, rec_hi, m_lo, m_hi, kind, width);
      return r7;
    }
    if is_sum {
      let r5: u32 = std_sums.meta_lower_sum_access(base, len, name_lo, name_hi, lhs_lo, rec_hi, dot);
      return r5;
    }
    let r6: u32 = std_records.meta_lower_field_access(base, len, name_lo, name_hi, tb2, dot);
    return r6;
  }
  if f_call {
    let r4: u32 = meta_emit_call(base, len, name_lo, name_hi, kind, width, t_lo, t_hi, lhs_lo, rec_hi, after);
    return r4;
  }
  let f: u32 = lain_meta_fail(4);
  return 4;
}

func meta_is_int_literal(base: addr, lo: u64, hi: u64, len: u64) -> bool {
  let b0: u8 = std_lex.bs_byte_at(base, lo, len);
  let b0_w: u32 = b0 as u32;
  let is_zero: bool = b0_w == 48;
  let n1: u64 = lo + 1;
  let b1: u8 = std_lex.bs_byte_at(base, n1, len);
  let b1_w: u32 = b1 as u32;
  let lx: bool = b1_w == 120;
  let ux: bool = b1_w == 88;
  let x: bool = lx or ux;
  let hex: bool = is_zero and x;
  let first: u64 = if hex {
    let s2: u64 = lo + 2;
    s2
  } else {
    lo
  };
  let r: bool = loop s(i: u64 = first, any: bool = 0) {
    let more: bool = i < hi;
    if more {
      let b: u8 = std_lex.bs_byte_at(base, i, len);
      let ok: bool = if hex {
        let h: bool = std_lex.bs_is_hex_digit(b);
        h
      } else {
        let d: bool = std_lex.bs_is_digit(b);
        d
      };
      if ok {
        let n: u64 = i + 1;
        continue s(n, 1);
      }
      break s(0);
    } else {
      break s(any);
    }
  };
  return r;
}

func meta_literal_fits(base: addr, len: u64, ref_v: u64, lo: u64, hi: u64, kind: u64, width: u64) -> u32 {
  let is_src: bool = ref_v == 0xFFFFFFFFFFFFFFFF;
  if is_src == 0 {
    return 0;
  }
  let digits: bool = meta_is_int_literal(base, lo, hi, len);
  if digits == 0 {
    return 0;
  }
  let isbits: bool = kind == 0;
  let narrow: bool = width < 64;
  let checked: bool = isbits and narrow;
  if checked == 0 {
    return 0;
  }
  let v: u64 = std_lex.bs_read_uint(base, lo, len);
  let limit: u64 = 1 << width;
  let toobig: bool = v >= limit;
  if toobig {
    let x: u32 = lain_meta_fail(23);
    return 23;
  }
  return 0;
}

func meta_at_semi(base: addr, at: u64, len: u64) -> bool {
  let p: u64 = std_lex.bs_skip_space(base, at, len);
  // 用 `bs_byte_at`（越界给 0）而不是 `bs_is_byte`：源码没有以 `;` 收尾时
  // `bs_skip_space` 会返回 `len`，而 `bs_is_byte` 在 `len` 处是**越界读**——
  // 那会被 VM 以 trap 1004 拒掉。响是响了，但那是崩溃，不是诊断。
  let b: u8 = std_lex.bs_byte_at(base, p, len);
  let b_w: u32 = b as u32;
  let r: bool = b_w == 59;
  return r;
}

func meta_emit_numeric(base: addr, len: u64, name_lo: u64, name_hi: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, lhs_lo: u64, lhs_hi: u64) -> u32 {
  let form: u64 = std_recognize.meta_form_at(base, lhs_lo);
  let f_bin: bool = form == 4;
  let f_grp: bool = form == 2;
  let is_expr: bool = f_bin or f_grp;
  if is_expr {
    // 整段交给表达式发射器。它自己走到 `;`，吃到不该有的东西就报错；调用方不再替它
    // 检查尾巴。
    let s: u32 = meta_emit_chain(base, len, name_lo, name_hi, kind, width, t_lo, t_hi, lhs_lo, lhs_hi);
    return s;
  }
  let lhs_digits: bool = meta_is_int_literal(base, lhs_lo, lhs_hi, len);
  let lhs_semi: bool = meta_at_semi(base, lhs_hi, len);
  let lhs_ok: bool = lhs_digits and lhs_semi;
  let lhs_bad: bool = lhs_ok == 0;
  if lhs_bad {
    let ft2: u32 = lain_meta_fail(4);
    return 4;
  }
  // 常量装不装得进声明的类型？`let main: i8 = 300;` 曾经静默截断成 44 ——
  // 这条路的出参只有源码区间，没有「引用」，所以按「源码那段」查。
  let lfit: u32 = meta_literal_fits(base, len, 0xFFFFFFFFFFFFFFFF, lhs_lo, lhs_hi, kind, width);
  let lbad: bool = lfit != 0;
  if lbad {
    return lfit;
  }
  let s2: u32 = meta_emit_let(base, len, name_lo, name_hi, kind, width, lhs_lo);
  return s2;
}

func meta_emit_call(base: addr, len: u64, name_lo: u64, name_hi: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, callee_lo: u64, callee_hi: u64, at: u64) -> u32 {
  let callee_name: addr = base + callee_lo;
  let callee_len: u64 = callee_hi - callee_lo;
  let decl: u64 = std_scope.meta_scope_require_func(callee_name, callee_len);
  if decl == 0 { return 9415; }
  let w1: u32 = std_lainir.lainir_proc_word_write();
  let name_at: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let w2: u32 = std_lainir.lainir_write(name_at, name_len);
  let w3: u32 = std_lainir.lainir_empty_params_write();
  let w4: u32 = std_emit.meta_emit_repr(kind, width);
  let w5: u32 = std_lainir.lainir_open_body();
  // 头写完了，现在降级实参。被调用者的下一个孩子就是实参那个组 —— 「位置 ->
  // 同一个父组里的下一项」，不是靠节点引用找兄弟。
  let grp: u64 = std_recognize.meta_next_at(base, callee_lo);
  let ast: u32 = std_funcs.meta_args_prepare(base, len, kind, width, t_lo, t_hi, grp);
  let abad: bool = ast != 0;
  if abad {
    return ast;
  }
  // `  #return #call <callee>(`
  let w6: u32 = std_lainir.lainir_ret_call_head_write();
  let callee_at: addr = base + callee_lo;
  let w7: u32 = std_lainir.lainir_write(callee_at, callee_len);
  let w8: u32 = std_lainir.lainir_open_paren_write();
  let wst: u32 = std_funcs.meta_args_write(base, len);
  let wbad: bool = wst != 0;
  if wbad {
    return wst;
  }
  let w9: u32 = std_lainir.lainir_rparen_nl_close_write();
  return 0;
}

func meta_emit_let(base: addr, len: u64, name_lo: u64, name_hi: u64, kind: u64, width: u64, num_lo: u64) -> u32 {
  let w1: u32 = std_lainir.lainir_proc_word_write();
  let name_at: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let w2: u32 = std_lainir.lainir_write(name_at, name_len);
  let w3: u32 = std_lainir.lainir_empty_params_write();
  let w4: u32 = std_emit.meta_emit_repr(kind, width);
  let w5: u32 = std_lainir.lainir_body_return_write();
  let value: u64 = std_lex.bs_read_uint(base, num_lo, len);
  let w6: u32 = std_emit.meta_emit_uint(value);
  let w7: u32 = std_lainir.lainir_close_body();
  return 0;
}

func meta_emit_chain(base: addr, len: u64, name_lo: u64, name_hi: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, first_lo: u64, first_hi: u64) -> u32 {
  let w1: u32 = std_lainir.lainir_proc_word_write();
  let name_at: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let w2: u32 = std_lainir.lainir_write(name_at, name_len);
  let w3: u32 = std_lainir.lainir_empty_params_write();
  let w4: u32 = std_emit.meta_emit_repr(kind, width);
  let w5: u32 = std_lainir.lainir_open_body();
  let idx: u64 = std_recognize.meta_cursor_of_at(base, first_lo);
  let parent: u64 = std_recognize.meta_cursor_parent();
  let est: u32 = meta_emit_expr(base, len, kind, width, t_lo, t_hi, parent, idx, 1, 0, 0, 0);
  let ebad: bool = est != 0;
  if ebad {
    return est;
  }
  let scratch: addr = lain_meta_scratch_data();
  let ref_v: u64 = std_types.meta_cell_get(scratch + 168);
  // `  #return <结果>\n}\n`
  let z1: u32 = std_lainir.lainir_return_write();
  let rlo: u64 = std_types.meta_cell_get(scratch + 176);
  let rhi: u64 = std_types.meta_cell_get(scratch + 184);
  // 整个值就是一个字面量时，看它装不装得进这个类型（`let main: i8 = 300;` 曾经
  // 静默截断成 44）。
  let cfit: u32 = meta_literal_fits(base, len, ref_v, rlo, rhi, kind, width);
  let cbad: bool = cfit != 0;
  if cbad {
    return cfit;
  }
  let z2: u32 = meta_emit_ref2(base, len, ref_v, rlo, rhi);
  let z3: u32 = std_lainir.lainir_close_brace_write();
  return 0;
}

func meta_emit_ref2(base: addr, len: u64, ref_v: u64, lo: u64, hi: u64) -> u32 {
  let is_src: bool = ref_v == 0xFFFFFFFFFFFFFFFF;
  let st: u32 = if is_src {
    let w: u32 = std_funcs.meta_emit_operand(base, lo, hi, len);
    w
  } else {
    let w2: u32 = std_funcs.meta_emit_temp_name(ref_v);
    w2
  };
  return st;
}

func meta_render_ref2(base: addr, len: u64, ref_v: u64, lo: u64, hi: u64, out: addr) -> u64 {
  let is_src: bool = ref_v == 0xFFFFFFFFFFFFFFFF;
  let st: u64 = if is_src {
    let w: u64 = std_funcs.meta_render_operand(base, lo, hi, len, out);
    w
  } else {
    let w2: u64 = std_lainir.lainir_buf_temp(out, 0, ref_v);
    w2
  };
  return st;
}

func meta_is_neg_literal(base: addr, len: u64, parent: u64, index: u64) -> bool {
  let n: u64 = std_parse.ast_child(parent, index);
  let at: u64 = std_parse.meta_node_start(n);
  let b: u8 = std_lex.bs_byte_at(base, at, len);
  let b_w: u32 = b as u32;
  let dash: bool = b_w == 45;
  if dash {
    let nx: u64 = index + 1;
    let nn: u64 = std_parse.ast_child(parent, nx);
    let nnone: bool = nn == 0;
    if nnone {
      return 0;
    }
    let lo: u64 = std_parse.meta_node_start(nn);
    let hi: u64 = lo + std_parse.meta_node_len(nn);
    let dg: bool = meta_is_int_literal(base, lo, hi, len);
    return dg;
  }
  return 0;
}

func meta_emit_neg_temp(base: addr, len: u64, kind: u64, width: u64, parent: u64, index: u64) -> u32 {
  let ni: u64 = index + 1;
  let nn: u64 = std_parse.ast_child(parent, ni);
  let nlo: u64 = std_parse.meta_node_start(nn);
  let nhi: u64 = nlo + std_parse.meta_node_len(nn);
  let tn: u64 = std_funcs.meta_next_temp();
  let subn: addr = std_emit.meta_sym_sub;
  let buf: addr = std_lainir.lainir_text_buffer;
  let zlen: u64 = std_lainir.lainir_buf_uint(buf, 0, 0);
  let n_at: addr = base + nlo;
  let n_len: u64 = nhi - nlo;
  let w8: u32 = std_lainir.lainir_binary_op_at(2, tn, subn, 3, kind, width, buf, zlen, n_at, n_len);
  let sc: addr = lain_meta_scratch_data();
  let s1: u32 = std_types.meta_cell_put(sc + 168, tn);
  // 范围也写出去：外层拿到的是「一个操作数」的范围（数字那段），不是负号那段。
  let s2: u32 = std_types.meta_cell_put(sc + 176, nlo);
  let s3: u32 = std_types.meta_cell_put(sc + 184, nhi);
  return 0;
}

func meta_operand_emit(base: addr, len: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, parent: u64, index: u64) -> u32 {
  let neg: bool = meta_is_neg_literal(base, len, parent, index);
  if neg {
    return meta_emit_neg_temp(base, len, kind, width, parent, index);
  }
  let node: u64 = std_parse.ast_child(parent, index);
  let form: u64 = std_parse.meta_node_form(parent, index);
  // 点号形态（形状 6）在这里分走：两条路都要读左边那个名字的类型，发的都是
  // `#lea` 加 `#load`，与「一个 token」那条路完全不同。留给 token 那条路的话，
  // 只有点号左边会被发出去、右边被悄悄丢掉。
  //
  // 左边是**和类型名**、右边那个成员后面跟 `(`：那是变体投影（`Shape.Circle(s)` 取载荷）；
  // 其余情况是积类型的字段访问（`p.x`）。
  let is_field: bool = form == 6;
  if is_field {
    let d_lo: u64 = std_parse.meta_node_start(node);
    let d_hi: u64 = d_lo + std_parse.meta_node_len(node);
    let d_after: u64 = std_lex.bs_skip_space(base, d_hi, len);
    let d_f_lo: u64 = std_lex.bs_skip_space(base, d_after + 1, len);
    let d_f_hi: u64 = std_lex.bs_skip_ident(base, d_f_lo, len);
    let d_enum: bool = std_sums.meta_is_enum(base, len, d_lo, d_hi);
    let d_delim: u8 = meta_dotted_delim(base, len, parent, index);
    let d_delim_w: u32 = d_delim as u32;
    let d_paren: bool = d_delim_w == 40;
    let d_proj: bool = d_enum and d_paren;
    // 左边是 import 绑定：跨模块取成员。模块的过程在 import 声明处已经发完
    // （见 meta_emit_module_exports），这里只发一次 `%r<n> = #call <mangle>__<成员>()`。
    let d_ns: u64 = std_modules.meta_find_import_binding(base, len, d_lo, d_hi);
    let d_isns: bool = d_ns != 0;
    if d_isns {
      let d_n: u32 = std_modules.meta_emit_ns_operand(base, len, d_lo, d_hi, d_f_lo, d_f_hi);
      return d_n;
    }
    if d_proj {
      let d_v: u32 = std_sums.meta_emit_projection_temp(base, len, parent, index, d_lo, d_hi, d_f_lo, d_f_hi);
      return d_v;
    }
    let d_f: u32 = std_records.meta_emit_field_temp(base, len, parent, index);
    return d_f;
  }
  // 索引形态（形状 12）：`NAME[i]` 是 `#data_addr NAME_storage` 加一条 `#lea`，
  // 与「一个 token」那条路完全不同 —— 留给它的话只有名字会被发出去。
  let is_index: bool = form == 12;
  if is_index {
    return meta_emit_index_temp(base, len, parent, index);
  }
  // 裸名字形态（形状 13）：`?NAME` 按 `%NAME` 渲染。绑定名与产物里的值名一致，所以
  // 别再让「一个 token」那条路把整段 `?NAME` 当源码片段发出去（那是 `%?NAME`）。
  let is_bare: bool = form == 13;
  if is_bare {
    return meta_emit_bare_temp(base, len, parent, index);
  }
  let is_group: bool = form == 2;
  let is_call: bool = form == 5;
  if is_group {
    // 括号组：里面那条表达式从**这个组**的第 0 个孩子开始（游标 = (组, 0)）。
    let st1: u32 = meta_emit_expr(base, len, kind, width, t_lo, t_hi, node, 0, 0, 0, 0, 0);
    return st1;
  }
  if is_call {
    let c_lo: u64 = std_parse.meta_node_start(node);
    let c_hi: u64 = c_lo + std_parse.meta_node_len(node);
    // 被调用者的下一个兄弟就是实参组：游标前进一格。
    let grp: u64 = std_parse.meta_cursor_next(parent, index);
    // 内建的内存操作（lea / load）形态与调用一样，先认它们；回 1 表示不是内建。
    let prim: u32 = std_funcs.meta_emit_builtin_temp(base, len, kind, width, c_lo, c_hi, grp);
    let notprim: bool = prim == 1;
    if notprim {
      let call3: u32 = meta_emit_call_temp(base, len, kind, width, t_lo, t_hi, c_lo, c_hi, grp);
      return call3;
    }
    return prim;
  }
  // 字节串字面量只在顶层 let 里能落成静态块（`data` 只能放顶层）；别处报 4,
  // 不能把它当普通 token 发成 `%"…"`。
  let str_at: u64 = std_parse.meta_node_start(node);
  let is_str: bool = std_lex.bs_is_byte(base, str_at, 34);
  if is_str {
    let str_fail: u32 = lain_meta_fail(4);
    return str_fail;
  }
  // 静态数据绑定（表与字节串）：它们不在 IR 里当值用，值是 `#data_addr` 给出的地址。
  // 不拦的话会被当普通 token 发成 `%NAME`，装载器找不到那个值。
  let s_lo0: u64 = std_parse.meta_node_start(node);
  let s_len0: u64 = std_parse.meta_node_len(node);
  let s_at0: addr = base + s_lo0;
  let s_ix: u64 = std_scope.meta_scope_find(s_at0, s_len0);
  let s_hit: bool = s_ix != 0xFFFFFFFFFFFFFFFF;
  let s_is: bool = loop pick_s(t: u64 = 0) {
    if s_hit {
      let s_k: u64 = std_scope.meta_scope_kind(s_ix);
      let s_k3: bool = s_k == 3;
      if s_k3 {
        let s_e: u64 = std_scope.meta_scope_emitted(s_ix);
        let s_eok: bool = s_e != 0;
        let s_p: u64 = std_scope.meta_scope_payload(s_ix);
        let s_p_lo: u64 = std_parse.meta_node_start(s_p);
        let s_p_b: u8 = std_lex.bs_byte_at(base, s_p_lo, len);
        let s_p_bw: u32 = s_p_b as u32;
        let s_p_str: bool = s_p_bw == 34;
        break pick_s(s_eok or s_p_str);
      }
      break pick_s(0);
    }
    break pick_s(0);
  };
  if s_is {
    // 块名就是裸名字；符号文本拼一次，临时编号由它回。
    let sy_lo: u64 = std_parse.meta_node_start(node);
    let sy_len: u64 = std_parse.meta_node_len(node);
    let sy_at: addr = base + sy_lo;
    let sy_ok: u64 = std_lainir.lainir_buf_bytes(std_lainir.lainir_text_buffer, 0, sy_at, sy_len);
    let sy_t: u64 = meta_emit_symbol_addr_line(std_lainir.lainir_text_buffer, sy_ok);
    let ssc: addr = lain_meta_scratch_data();
    let ss1: u32 = std_types.meta_cell_put(ssc + 168, sy_t);
    // 范围写**名字**那一段（不是 0）：外层要靠它查这个操作数的类型
    // （`p as u64`、`t as u64` 的方向判断都要）。结果本身是 `%r<t>`。
    let ss2: u32 = std_types.meta_cell_put(ssc + 176, s_lo0);
    let ss3: u32 = std_types.meta_cell_put(ssc + 184, s_lo0 + s_len0);
    // 下一个位置是名字之后那一格（`meta_operand_emit` 拿到的是下标）。
    let ss4: u32 = std_types.meta_cell_put(ssc + 2368, index + 1);
    // 结果已经物化，就地收尾 —— 下面的「一个 token」会把 168 改回源码窗口。
    return 0;
  }
  // 一个 token：直接用源码那段。**源码范围也要写进 +176/+184** —— 组的那个分支
  // 是递归留下的范围，调用方一律从这里读，就不会把 `(42)` 的范围当成整个括号。
  let sc: addr = lain_meta_scratch_data();
  let lo0: u64 = std_parse.meta_node_start(node);
  let hi0: u64 = lo0 + std_parse.meta_node_len(node);
  // 循环参数：这一轮里被赋过值就发那个临时值（参数名本身是进入本轮时的值）。有了
  // 这条，i = i + 1; acc = acc + i; 的第二条语句读到的是刚写下的 i，不是循环头的 i。
  let knl: u64 = hi0 - lo0;
  let kix: u64 = std_funcs.meta_loop_param_index(base, lo0, knl);
  let isparam: bool = kix != 0xFFFFFFFFFFFFFFFF;
  if isparam {
    let pboff: u64 = std_types.meta_cell_get(sc + 2456);
    let pb: addr = sc + pboff;
    let kpslot: u64 = 88 + kix * 96;
    let kpq: addr = pb + kpslot;
    let kcur: u64 = std_types.meta_cell_get(kpq + 32);
    let khas: bool = kcur != 0xFFFFFFFFFFFFFFFF;
    if khas {
      let pa: u32 = std_types.meta_cell_put(sc + 168, kcur);
      let pb2: u32 = std_types.meta_cell_put(sc + 176, 0);
      let pc2: u32 = std_types.meta_cell_put(sc + 184, 0);
      return 0;
    }
    let pd: u32 = std_types.meta_cell_put(sc + 168, 0xFFFFFFFFFFFFFFFF);
    let pe: u32 = std_types.meta_cell_put(sc + 176, lo0);
    let pf: u32 = std_types.meta_cell_put(sc + 184, hi0);
    return 0;
  }
  let s4: u32 = std_types.meta_cell_put(sc + 168, 0xFFFFFFFFFFFFFFFF);
  let s5: u32 = std_types.meta_cell_put(sc + 176, lo0);
  let s6: u32 = std_types.meta_cell_put(sc + 184, hi0);
  return 0;
}

func meta_emit_call_temp(base: addr, len: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, callee_lo: u64, callee_hi: u64, args: u64) -> u32 {
  let callee: addr = base + callee_lo;
  let callee_len: u64 = callee_hi - callee_lo;
  let decl: u64 = std_scope.meta_scope_require_func(callee, callee_len);
  let unbound: bool = decl == 0;
  if unbound { return 9415; }
  // 先把实参降级好（子表达式的指令现在发），再写这一行 —— 反过来那些指令会插进
  // `#call f(` 后面。
  let ast: u32 = std_funcs.meta_args_prepare(base, len, kind, width, t_lo, t_hi, args);
  let abad: bool = ast != 0;
  if abad {
    return ast;
  }
  let w1: u32 = std_lainir.lainir_indent_write();
  let tn: u64 = std_funcs.meta_next_temp();
  let w2: u32 = std_funcs.meta_emit_temp_name(tn);
  let w3: u32 = std_lainir.lainir_result_sep_write();
  let w4: u32 = std_lainir.lainir_call_word_write();
  let c_at: addr = base + callee_lo;
  let c_len: u64 = callee_hi - callee_lo;
  let w5: u32 = std_lainir.lainir_write(c_at, c_len);
  let w6: u32 = std_lainir.lainir_open_paren_write();
  let wst: u32 = std_funcs.meta_args_write(base, len);
  let wbad: bool = wst != 0;
  if wbad {
    return wst;
  }
  let w7: u32 = std_lainir.lainir_close_paren_write();
  let w8: u32 = std_lainir.lainir_newline_write();
  let sc: addr = lain_meta_scratch_data();
  let s: u32 = std_types.meta_cell_put(sc + 168, tn);
  return 0;
}

func meta_dotted_delim(base: addr, len: u64, parent: u64, index: u64) -> u8 {
  let node: u64 = std_parse.ast_child(parent, index);
  let lo: u64 = std_parse.meta_node_start(node);
  let hi: u64 = lo + std_parse.meta_node_len(node);
  let after: u64 = std_lex.bs_skip_space(base, hi, len);
  let f_lo: u64 = std_lex.bs_skip_space(base, after + 1, len);
  let f_hi: u64 = std_lex.bs_skip_ident(base, f_lo, len);
  let open: u64 = std_lex.bs_skip_space(base, f_hi, len);
  let r: u8 = std_lex.bs_byte_at(base, open, len);
  return r;
}

func meta_after_operand(base: addr, len: u64, parent: u64, index: u64) -> u64 {
  let k: u64 = std_parse.meta_node_form(parent, index);
  let is_call: bool = k == 5;
  // 负数字面量也占两格（负号 + 数字）—— 不跳的话 `-5` 后面那一格会被当成算子。
  let is_neg: bool = meta_is_neg_literal(base, len, parent, index);
  let skip2: bool = is_call or is_neg;
  let nx: u64 = index + 1;
  let nx2: u64 = if skip2 {
    let g2: u64 = nx + 1;
    g2
  } else {
    nx
  };
  // 旧 IR 的 %r/%r2 值 if 链（每一层的 else 支里嵌着下一层）结果直接喂给 #return：
  // 改成平坦守卫，次序与旧 IR 相同 —— 只有前一层不命中才算后一层的条件。
  // 点号形态至少占三格（值、点号、成员名）：成员后面跟 `(` 时那个实参组再占一格
  // （`Shape.Circle(s)`）—— 少跳一格会把点号或实参组当成下一个语句。
  let is_bare: bool = k == 13;
  if is_bare {
    // `?` 与名字各占一格。
    let g_b: u64 = index + 2;
    return g_b;
  }
  let is_index: bool = k == 12;
  if is_index {
    // 索引占两格：名字 + 那个 `[` 组。
    let g_i: u64 = nx + 1;
    return g_i;
  }
  let is_field: bool = k == 6;
  if is_field == 0 {
    return nx2;
  }
  let f_delim: u8 = meta_dotted_delim(base, len, parent, index);
  // 只有组才算多占一格：字段访问后面那个字节是分号或换行，那不是组。
  let f_delim_w: u32 = f_delim as u32;
  let f_paren: bool = f_delim_w == 40;
  let f_brace: bool = f_delim_w == 123;
  let f_arg: bool = f_paren or f_brace;
  let f_n: u64 = if f_arg {
    let g4: u64 = nx + 3;
    g4
  } else {
    let g3: u64 = nx + 2;
    g3
  };
  return f_n;
}

func meta_emit_bare_temp(base: addr, len: u64, parent: u64, index: u64) -> u32 {
  let ni: u64 = index + 1;
  let node: u64 = std_parse.ast_child(parent, ni);
  let nnone: bool = node == 0;
  if nnone {
    let fn: u32 = lain_meta_fail(3);
    return 3;
  }
  let n_lo: u64 = std_parse.meta_node_start(node);
  let n_hi: u64 = n_lo + std_parse.meta_node_len(node);
  let n_len: u64 = n_hi - n_lo;
  let n_at: addr = base + n_lo;
  let si: u64 = std_scope.meta_scope_find(n_at, n_len);
  let s_hit: bool = si != 0xFFFFFFFFFFFFFFFF;
  let s_is: bool = loop pick_flag(t: u64 = 0) {
    if s_hit {
      let s_k: u64 = std_scope.meta_scope_kind(si);
      let s_k3: bool = s_k == 3;
      if s_k3 {
        let s_e: u64 = std_scope.meta_scope_emitted(si);
        let s_eok: bool = s_e != 0;
        let s_p: u64 = std_scope.meta_scope_payload(si);
        let s_p_b: u8 = std_lex.bs_byte_at(base, std_parse.meta_node_start(s_p), len);
        let s_p_w: u32 = s_p_b as u32;
        let s_p_str: bool = s_p_w == 34;
        break pick_flag(s_eok or s_p_str);
      }
      break pick_flag(0);
    }
    break pick_flag(0);
  };
  let sc: addr = lain_meta_scratch_data();
  if s_is {
    // 块名就是裸名字：先把符号文本拼出来，再让它写地址行并回临时编号。
    let s_buf: addr = std_lainir.lainir_text_buffer;
    let s_b: u64 = std_lainir.lainir_buf_bytes(s_buf, 0, n_at, n_len);
    let s_at: u64 = meta_emit_symbol_addr_line(s_buf, s_b);
    // 结果就是那个 `%r<t>`：写进 168，外层直接渲染。
    let q1: u32 = std_types.meta_cell_put(sc + 168, s_at);
    let q2: u32 = std_types.meta_cell_put(sc + 176, n_lo);
    let q3: u32 = std_types.meta_cell_put(sc + 184, n_hi);
    return 0;
  }
  // 普通参数名与局部绑定：**不发任何指令** —— 名字在产物里已经绑好了（参数名就是
  // 源码名），外层按「源码窗口 + 无名」渲染出 `%名字` 就行。
  let p1: u32 = std_types.meta_cell_put(sc + 168, 0xFFFFFFFFFFFFFFFF);
  let p2: u32 = std_types.meta_cell_put(sc + 176, n_lo);
  let p3: u32 = std_types.meta_cell_put(sc + 184, n_hi);
  return 0;
}

func meta_scope_table_esz(base: addr, len: u64, lo: u64, hi: u64) -> u64 {
  let n_len: u64 = hi - lo;
  let at: addr = base + lo;
  let i: u64 = std_scope.meta_scope_find(at, n_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0;
  }
  let k: u64 = std_scope.meta_scope_kind(i);
  let isval: bool = k == 3;
  if isval {
    let v: u64 = std_scope.meta_scope_emitted(i);
    return v;
  }
  return 0;
}

func meta_emit_data_addr_line(symbol: addr, symbol_len: u64) -> u64 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let tn: u64 = std_funcs.meta_next_temp();
  let p0: u64 = std_lainir.lainir_buf_bytes(buf, 0, std_lainir.lainir_indent, 2);
  let p1: u64 = std_lainir.lainir_buf_temp(buf, p0, tn);
  let p2: u64 = std_lainir.lainir_buf_bytes(buf, p1, std_lainir.lainir_assign, 4);
  // D-002：数据符号本身就是地址，取址写成 `#bitcast[#addr](%NAME)`；旧拼写 `#data_addr` 已删。
  let p3: u64 = std_lainir.lainir_buf_bytes(buf, p2, std_lainir.lainir_bitcast_addr_head, 16);
  // 块名就是裸名字。
  let p5: u64 = std_lainir.lainir_buf_bytes(buf, p3, symbol, symbol_len);
  let p6: u64 = std_lainir.lainir_buf_bytes(buf, p5, std_lainir.lainir_rparen_nl, 2);
  let wr: u32 = std_lainir.lainir_write(buf, p6);
  return tn;
}

func meta_emit_addr_binding(base: addr, len: u64, name_lo: u64, name_hi: u64) -> u32 {
  let rec_at: addr = base + name_lo;
  let rec_len: u64 = name_hi - name_lo;
  let buf: addr = std_lainir.lainir_text_buffer;
  let n1: u64 = std_lainir.lainir_buf_bytes(buf, 0, rec_at, rec_len);
  let tn: u64 = meta_emit_symbol_addr_line(buf, n1);
  let sc: addr = lain_meta_scratch_data();
  let p1: u32 = std_types.meta_cell_put(sc + 168, tn);
  let p2: u32 = std_types.meta_cell_put(sc + 176, name_lo);
  let p3: u32 = std_types.meta_cell_put(sc + 184, name_hi);
  return 0;
}

func meta_emit_index_temp(base: addr, len: u64, parent: u64, index: u64) -> u32 {
  let node: u64 = std_parse.ast_child(parent, index);
  let n_lo: u64 = std_parse.meta_node_start(node);
  let n_len: u64 = std_parse.meta_node_len(node);
  let n_at: addr = base + n_lo;
  let i: u64 = std_scope.meta_scope_find(n_at, n_len);
  let found: bool = i != 0xFFFFFFFFFFFFFFFF;
  if found == 0 {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  let k: u64 = std_scope.meta_scope_kind(i);
  let isval: bool = k == 3;
  if isval == 0 {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let esz: u64 = std_scope.meta_scope_emitted(i);
  let isz: bool = esz == 0;
  if isz {
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  let cnt: u64 = std_scope.meta_scope_aux(i);
  // 下标：名字的下一个兄弟就是 `[` 组，组里第一个孩子才是指标。
  let ix_parent: u64 = std_parse.meta_cursor_next(parent, index);
  let ix_node: u64 = std_parse.meta_node_child(ix_parent);
  let ix_miss: bool = ix_node == 0;
  if ix_miss {
    let f3: u32 = lain_meta_fail(4);
    return 4;
  }
  let ix_lo: u64 = std_parse.meta_node_start(ix_node);
  let ix_hi: u64 = ix_lo + std_parse.meta_node_len(ix_node);
  let ix_lit: bool = meta_is_int_literal(base, ix_lo, ix_hi, len);
  if ix_lit {
    let ix_val: u64 = std_lex.bs_read_uint(base, ix_lo, len);
    let oob: bool = ix_val >= cnt;
    if oob {
      let f4: u32 = lain_meta_fail(4);
      return 4;
    }
  }
  let st: u32 = meta_emit_expr(base, len, 0, 64, 0, 0, ix_parent, 0, 0, 0, 0, 0);
  let sbad: bool = st != 0;
  if sbad {
    return st;
  }
  let sc: addr = lain_meta_scratch_data();
  let aref: u64 = std_types.meta_cell_get(sc + 168);
  let alo: u64 = std_types.meta_cell_get(sc + 176);
  let ahi: u64 = std_types.meta_cell_get(sc + 184);
  let buf: addr = std_lainir.lainir_text_buffer;
  let bt: u64 = meta_emit_data_addr_line(n_at, n_len);
  let b_at: u64 = std_lainir.lainir_buf_temp(buf, 64, bt);
  let b_len: u64 = b_at - 64;
  let i1: addr = buf + 96;
  let i_len: u64 = meta_render_ref2(base, len, aref, alo, ahi, i1);
  let lt: u64 = std_funcs.meta_next_temp();
  let b1: addr = buf + 64;
  let wr: u32 = std_lainir.lainir_lea_at(lt, b1, b_len, i1, i_len, esz, 0);
  let p1: u32 = std_types.meta_cell_put(sc + 168, lt);
  let p2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let p3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return 0;
}

func meta_emit_len_temp(base: addr, len: u64, kind: u64, width: u64, args: u64) -> u32 {
  let acount: u64 = std_parse.ast_child_count(args);
  let ok1: bool = acount == 1;
  if ok1 == 0 {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  let arg: u64 = std_parse.ast_child(args, 0);
  let n_lo: u64 = std_parse.meta_node_start(arg);
  let n_len: u64 = std_parse.meta_node_len(arg);
  let n_at: u64 = base + n_lo;
  let i: u64 = std_scope.meta_scope_find(n_at, n_len);
  let found: bool = i != 0xFFFFFFFFFFFFFFFF;
  if found == 0 {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let k: u64 = std_scope.meta_scope_kind(i);
  let isval: bool = k == 3;
  if isval == 0 {
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  let node: u64 = std_scope.meta_scope_payload(i);
  let p_lo: u64 = std_parse.meta_node_start(node);
  let pb: u8 = std_lex.bs_byte_at(base, p_lo, len);
  let pb_w: u32 = pb as u32;
  let is_str: bool = pb_w == 34;
  // 长度只对字节串与定长表有意义 —— 别的绑定（标量、集合）在这里就拒，
  // 不能拿「元素个数 0」当答案发出去。
  let esz: u64 = std_scope.meta_scope_emitted(i);
  let is_tab: bool = esz != 0;
  let known: bool = is_str or is_tab;
  if known == 0 {
    let f3: u32 = lain_meta_fail(4);
    return 4;
  }
  let cnt: u64 = if is_str {
    let tl: u64 = std_parse.meta_node_len(node);
    let m: u64 = tl - 2;
    m
  } else {
    let av: u64 = std_scope.meta_scope_aux(i);
    av
  };
  let buf: addr = std_lainir.lainir_text_buffer;
  let csz: u64 = std_lainir.lainir_buf_uint(buf, 0, cnt);
  // 整数字面量是 `<数>0` 的十进制文本：计数写在 0 起，紧跟着一个 `0`（1 字节）。
  let z_at: u64 = buf + csz;
  let wz: u64 = std_lainir.lainir_buf_bytes(buf, csz, std_lainir.lainir_zero, 1);
  let tn: u64 = std_funcs.meta_next_temp();
  let wr: u32 = std_lainir.lainir_binary_op_at(2, tn, std_emit.meta_sym_add, 3, kind, width, buf, csz, z_at, 1);
  let sc: addr = lain_meta_scratch_data();
  let p1: u32 = std_types.meta_cell_put(sc + 168, tn);
  let p2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let p3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return 0;
}

func meta_operand_step(base: addr, len: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, parent: u64, index: u64) -> u32 {
  let c0: u64 = std_parse.ast_child(parent, index);
  let is_if0: bool = std_parse.meta_node_is_word(c0, base, std_lex.meta_kw_if, 2);
  let sc0: addr = lain_meta_scratch_data();
  if is_if0 {
    let tn0: u64 = std_funcs.meta_next_temp();
    let st0: u32 = std_funcs.meta_lower_if_value(base, len, parent, index, 0, 0, t_lo, t_hi, 2, tn0);
    let bad0: bool = st0 != 0;
    if bad0 {
      return st0;
    }
    let p1: u32 = std_types.meta_cell_put(sc0 + 168, tn0);
    let p2: u32 = std_types.meta_cell_put(sc0 + 176, 0);
    let p3: u32 = std_types.meta_cell_put(sc0 + 184, 0);
    return 0;
  }
  let st1: u32 = meta_operand_emit(base, len, kind, width, t_lo, t_hi, parent, index);
  let bad1: bool = st1 != 0;
  if bad1 {
    return st1;
  }
  let nx1: u64 = meta_after_operand(base, len, parent, index);
  let p4: u32 = std_types.meta_cell_put(sc0 + 2368, nx1);
  return 0;
}

func meta_emit_expr(base: addr, len: u64, kind: u64, width: u64, t_lo: u64,
                    t_hi: u64, parent: u64, index: u64, need_semi: bool,
                    close: u64, n_lo: u64, n_hi: u64) -> u32 {
  let st: u32 = loop e(i: u64 = index, have: bool = 0,
                       acc: u64 = 0xFFFFFFFFFFFFFFFF, alo: u64 = 0,
                       ahi: u64 = 0, bound: bool = 0) {
    // 当前位置的孩子。游标越过末尾时 `ast_child` 回空引用 0 —— 与旧代码里那个
    // 「无节点」等价，但不再需要伪造一个节点：**末尾是范围，不是节点**。
    let c: u64 = std_parse.ast_child(parent, i);
    let phase1: bool = have == 0;
    if phase1 {
      // 阶段一：%c 是一个操作数，它成为累积值
      let at: u64 = std_parse.meta_node_start(c);
      let b: u8 = std_lex.bs_byte_at(base, at, len);
      let isnone: bool = c == 0;
      let issemi: bool = (b as u32) == 59;
      let empty: bool = isnone or issemi;
      if empty {
        // 一个操作数都没有就结束了
        let f0: u32 = lain_meta_fail(3);
        break e(3);
      }
      let ost: u32 = meta_operand_step(base, len, kind, width, t_lo,
                                       t_hi, parent, i);
      let obad: bool = ost != 0;
      if obad {
        break e(ost);
      }
      let sc: addr = lain_meta_scratch_data();
      let refv: u64 = std_types.meta_cell_get(sc + 168);
      let alo1: u64 = std_types.meta_cell_get(sc + 176);
      let ahi1: u64 = std_types.meta_cell_get(sc + 184);
      let nx: u64 = std_types.meta_cell_get(sc + 2368);
      let nxclr: u32 = std_types.meta_cell_put(sc + 2368, 0);
      continue e(nx, 1, refv, alo1, ahi1, 0);
    }
    // 阶段二：%c 是算子、或者是表达式的终点
    let bat: u64 = std_parse.meta_node_start(c);
    let bb: u8 = std_lex.bs_byte_at(base, bat, len);
    // 算子符号的长度也要带下去：`==` 是双字节，查表按长度比。
    let bn: u64 = std_parse.meta_node_len(c);
    let isnone2: bool = c == 0;
    let issemi2: bool = (bb as u32) == 59;
    let iscomma2: bool = (bb as u32) == 44;
    let any1: bool = isnone2 or issemi2;
    // `,` 也是终点：实参位置上一条表达式到逗号为止（见 `meta_emit_args`）。
    let anyend: bool = any1 or iscomma2;
    // 归档的 %endok 值 if 里套了三层值 if：改成一次性选择循环，只有走到的那一支求值，
    // 顺序与副作用与旧 IR 一致。
    let endok: bool = loop pick_endok(t: bool = 0) {
      if need_semi { break pick_endok(issemi2); }
      if anyend { break pick_endok(1); }
      // 初始化列表里的**下一个字段名**（`a: 1 b: 2` 的 `b`）也是终点：一个槽后面紧跟
      // `:` 就是字段名，值这条表达式到这里为止。别处表达式里出现「名字 :」本来就是
      // 错的，所以这条不会把别处的合法表达式截断。
      let fnext: u64 = i + 1;
      let fnode: u64 = std_parse.ast_child(parent, fnext);
      let fnone: bool = fnode == 0;
      let fn_at: u64 = std_parse.meta_node_start(fnode);
      let fn_b: u8 = std_lex.bs_byte_at(base, fn_at, len);
      let fn_len: u64 = std_parse.meta_node_len(fnode);
      let fn_colon: bool = (fn_b as u32) == 58;
      let fn_one: bool = fn_len == 1;
      let fn_field: bool = fn_colon and fn_one;
      let fn_none0: bool = fnone == 0;
      let isfield: bool = fn_field and fn_none0;
      if isfield { break pick_endok(1); }
      // 块组 `{` 也是终点：`if a < b { … }` 的条件从下标+1 一路吃到块，块是**下一个
      // 兄弟**（不是操作数）。算子位置上出现一个花括号组只可能是这个意思 ——
      // 操作数位置上的组在阶段一就被吃掉了。
      //
      // 只在**别的终点都不成立**时才去看这个节点：走到了兄弟链末尾时 `%c` 是空
      // 引用，对它取分隔符会撞上「空引用不是节点」那条拒码。
      let iskind2: bool = std_parse.meta_node_kind(c) == 2;
      let isbrace: bool = (std_parse.ast_delim(c) as u32) == 123;
      let isblock: bool = iskind2 and isbrace;
      break pick_endok(isblock);
    };
    if endok {
      let sc2: addr = lain_meta_scratch_data();
      let s1: u32 = std_types.meta_cell_put(sc2 + 168, acc);
      let s2: u32 = std_types.meta_cell_put(sc2 + 176, alo);
      let s3: u32 = std_types.meta_cell_put(sc2 + 184, ahi);
      // 终点**下标**也带出去：调用方（实参那个循环）要靠它找下一个实参从哪开始。
      // 带下标而不是节点引用 —— 位置是游标的一半，引用不是。
      let s4: u32 = std_types.meta_cell_put(sc2 + 192, i);
      // 闭合模式在这一条语句的末尾收尾（模式 0 什么都不做，调用方自己收）。
      let cl: u32 = std_funcs.meta_emit_close(base, len, close, bound, acc,
                                    alo, ahi, kind, width, t_lo, t_hi,
                                    n_lo, n_hi);
      let clbad: bool = cl != 0;
      if clbad {
        break e(cl);
      }
      break e(0);
    }
    let isop: bool = std_lex.bs_is_operator(base, bat, len, bn);
    let notop: bool = isop == 0;
    if notop {
      // 既不是算子也不是终点：`1 + 2 3` 之类
      let f1: u32 = lain_meta_fail(4);
      break e(4);
    }
    // `x as T`：右边是**类型名**，不是值。目标类型决定发哪条指令 —— 变宽 `#zext`、
    // 变窄 `#trunc`、等宽补一条加零复制（等宽上 zext/trunc 都不是合法变换）。
    // 转换后的类型**不回填**给后面的算子：循环携带的是绑定/返回的上下文类型，
    // 所以 `x as i64 + y` 里那个 `+` 仍按操作数自己的类型查表。
    let bn2: bool = bn == 2;
    let asw: bool = std_types.meta_bytes_equal(base + bat, std_lex.meta_kw_as, 2);
    let is_as: bool = bn2 and asw;
    if is_as {
      let rti: u64 = i + 1;
      let rtn: u64 = std_parse.ast_child(parent, rti);
      let rtn_none: bool = rtn == 0;
      if rtn_none {
        // `as` 后面没有类型名
        let fa1: u32 = lain_meta_fail(4);
        break e(4);
      }
      let rtn_at: u64 = std_parse.meta_node_start(rtn);
      let rtn_b: u8 = std_lex.bs_byte_at(base, rtn_at, len);
      let rtn_semi: bool = (rtn_b as u32) == 59;
      if rtn_semi {
        let fa1b: u32 = lain_meta_fail(4);
        break e(4);
      }
      let rtn_hi: u64 = rtn_at + std_parse.meta_node_len(rtn);
      let atid: u64 = std_scalars.meta_type_resolve(base, len, rtn_at, rtn_hi);
      let atid_none: bool = atid == 0;
      if atid_none {
        // 类型名不认识：与别处一样报「没有这个名字」
        let fa2: u32 = lain_meta_fail(5);
        break e(5);
      }
      let atk: u64 = std_registry.meta_tid_repr_kind(atid);
      // 整数与地址互转：目标是 `addr`，或者**源是地址而目标不是**。后者必须在这里拦 ——
      // 让 `p as u64` 落进下面那条 zext/trunc 路会发出 `#zext[#bits<64>](%p)`（地址当整数，
      // 验证器不查这个位置的操作数类别，产物能过、值是错的）。
      // 这里没有操作数的下标（累的临时值就是操作数本身），所以按「终点」传。
      let a_addr: bool = atk == 3;
      let a_saddr: bool = meta_operand_is_addr(base, len, alo, ahi, acc);
      let a_cast: bool = a_addr or a_saddr;
      if a_cast {
        let ap: u64 = meta_operand_cast(base, len, parent, i, rtn,
                                        acc, alo, ahi);
        // 转换结果是一个临时值：它成为新的累积值，游标接在 `as T` 之后。
        let ap_sc: addr = lain_meta_scratch_data();
        let ap_ref: u64 = std_types.meta_cell_get(ap_sc + 168);
        continue e(ap, 1, ap_ref, 0, 0, 0);
      }
      let a_bits: bool = atk == 0;
      if a_bits {
        let atw: u64 = std_registry.meta_tid_repr_width(atid);
        // 源宽度优先取操作数**自己**的类型（参数名），取不到（字面量、临时值）才用
        // 传进来的上下文宽度。
        // 操作数是**源码里的值**（`%acc` = 无）时它自己有名字，可以查类型；是临时值
        // 时没有类型来源，只能用上下文宽度。
        let acc_srcf: bool = acc == 0xFFFFFFFFFFFFFFFF;
        let srcw: u64 = loop pick_srcw(t: u64 = 0) {
          if acc_srcf == 0 { break pick_srcw(width); }
          let alt_sc: addr = lain_meta_scratch_data();
          let aln: u64 = std_recognize.meta_node_at(base, alo);
          let alt: u64 = std_funcs.meta_word_type_name(base, len, aln);
          let alt_miss: bool = alt == 0;
          if alt_miss { break pick_srcw(width); }
          let alt_hi: u64 = std_types.meta_cell_get(alt_sc + 0);
          let asid: u64 = std_scalars.meta_type_resolve(base, len, alt, alt_hi);
          let asw2: u64 = std_registry.meta_tid_repr_width(asid);
          break pick_srcw(asw2);
        };
        let widen: bool = srcw < atw;
        let narrow: bool = srcw > atw;
        // 出参名前缀与通用算子那条路同一个判断：绑定模式的最后一条直接写 %NAME。
        let anx: u64 = meta_after_operand(base, len, parent, rti);
        let anxc: u64 = std_parse.ast_child(parent, anx);
        let aa_at: u64 = std_parse.meta_node_start(anxc);
        let aa_b: u8 = std_lex.bs_byte_at(base, aa_at, len);
        let aa_nl: u64 = std_parse.meta_node_len(anxc);
        let aa_op: bool = std_lex.bs_is_operator(base, aa_at, len, aa_nl);
        let alast: bool = aa_op == 0;
        let a_is_bind: bool = close == 1;
        let a_named: bool = a_is_bind and alast;
        let atn: u64 = loop pick_atn(t: u64 = 0) {
          if a_named {
            let ay1: u32 = std_lainir.lainir_st_pct_write();
            let an_at: addr = base + n_lo;
            let an_len: u64 = n_hi - n_lo;
            let ay2: u32 = std_lainir.lainir_write(an_at, an_len);
            break pick_atn(0xFFFFFFFFFFFFFFFF);
          }
          let ay3: u32 = std_lainir.lainir_indent_write();
          let an2: u64 = std_funcs.meta_next_temp();
          let ay4: u32 = std_funcs.meta_emit_temp_name(an2);
          break pick_atn(an2);
        };
        let ay5: u32 = std_lainir.lainir_result_sep_write();
        let ay6: u32 = loop pick_ay6(t: u64 = 0) {
          if widen {
            let azn: addr = std_emit.meta_sym_zext;
            let az1: u32 = std_funcs.meta_emit_op_lit(azn, 4, atk, atw);
            let az2: u32 = meta_emit_ref2(base, len, acc, alo, ahi);
            break pick_ay6(az2);
          }
          if narrow {
            let atrd: addr = std_emit.meta_sym_trunc;
            let ay8: u32 = std_funcs.meta_emit_op_lit(atrd, 5, atk, atw);
            let ay9: u32 = meta_emit_ref2(base, len, acc, alo, ahi);
            break pick_ay6(ay9);
          }
          // 等宽：加零就是复制
          let aadd: addr = std_emit.meta_sym_add;
          let ay10: u32 = std_funcs.meta_emit_op_lit(aadd, 3, atk, atw);
          let ay11: u32 = meta_emit_ref2(base, len, acc, alo, ahi);
          let ay12: u32 = std_lainir.lainir_comma_write();
          let ay13: u32 = std_lainir.lainir_zero_write();
          break pick_ay6(0);
        };
        let ay14: u32 = std_lainir.lainir_close_paren_write();
        let ay15: u32 = std_lainir.lainir_newline_write();
        let abound: bool = a_named;
        continue e(anx, 1, atn, 0, 0, abound);
      } else {
        // `as` 现在只做定宽整数之间的转换
        let fa3: u32 = lain_meta_fail(5);
        break e(5);
      }
    }
    // 右操作数：游标前进一格。到头时 `ast_child` 回空引用 0。
    let rni: u64 = i + 1;
    let rn: u64 = std_parse.ast_child(parent, rni);
    let rn_at: u64 = std_parse.meta_node_start(rn);
    let rn_b: u8 = std_lex.bs_byte_at(base, rn_at, len);
    let rn_none: bool = rn == 0;
    let rn_semi: bool = (rn_b as u32) == 59;
    let rn_end: bool = rn_none or rn_semi;
    if rn_end {
      // 算子在，操作数没了（`1 + ;`）
      let f2: u32 = lain_meta_fail(3);
      break e(3);
    }
    // **顺序要紧**：右操作数先降级。它可能是括号，会递归，递归里又会
    // `meta_op_resolve` 一次；而 `meta_op_resolve` 把物理算子名放在 `+24`/`+32`，
    // `meta_emit_op_mid` 稍后才读。先查算子再降级的话，名字会被递归那一次覆盖。
    // 真出过：`let main: i32 = 12 / (2 + 1);` 发成 `%r2 = #add[#bits<32>](12, %r1)`
    // （该是 `#sdiv`），验证通过，算出来 15 而不是 4。
    let rst: u32 = meta_operand_step(base, len, kind, width, t_lo,
                                     t_hi, parent, rni);
    let rbad: bool = rst != 0;
    if rbad {
      break e(rst);
    }
    let sc3: addr = lain_meta_scratch_data();
    // 右操作数之后接哪一格：这一格必须**紧接着**取走，后面那些类型查询虽然是叶子
    // 调用，也不该指望它们不碰暂存区。
    let rn_nx3: u64 = std_types.meta_cell_get(sc3 + 2368);
    let rn_nxclr: u32 = std_types.meta_cell_put(sc3 + 2368, 0);
    let rref: u64 = std_types.meta_cell_get(sc3 + 168);
    let rn_lo2: u64 = std_types.meta_cell_get(sc3 + 176);
    let rn_hi2: u64 = std_types.meta_cell_get(sc3 + 184);
    // 操作数**自己**的类型优先：参数有类型。字面量没有类型，就退回传进来的
    // （绑定 / 返回的）类型 —— 这也是 plan §4 第 3 条那个没定的问题：`1 < 2` 的两个
    // 操作数是裸字面量，没人告诉编译器它们是 i32。
    let acc_tmp: bool = acc != 0xFFFFFFFFFFFFFFFF;
    let l_tlo: u64 = loop pick_ltlo(t: u64 = 0) {
      if acc_tmp { break pick_ltlo(0xFFFFFFFFFFFFFFFF); }
      let ln: u64 = std_recognize.meta_node_at(base, alo);
      let lt: u64 = std_funcs.meta_word_type_name(base, len, ln);
      let lmiss0: bool = lt == 0xFFFFFFFFFFFFFFFF;
      // 调用不能直接当 break 的实参（验证器 2020：break 的实参按无期望类型降级，
      // 嵌套的 #call 不分配结果临时量），先绑成局部量再带出去。
      if lmiss0 {
        let ltlocal: u64 = std_funcs.meta_local_type_name(base, alo, ahi);
        break pick_ltlo(ltlocal);
      }
      break pick_ltlo(lt);
    };
    let scp: addr = lain_meta_scratch_data();
    let l_thi: u64 = std_types.meta_cell_get(scp + 0);
    let l_miss: bool = l_tlo == 0xFFFFFFFFFFFFFFFF;
    // 左操作数自己没有类型时（字面量、裸名字），常规名字查表认不出循环参数；
    // `let inner: bool = i == 3;` 里 `i` 是循环参数，期望类型（bool）不该给它当类型。
    // 只在「左操作数没查到类型」时，用裸名字再问一次循环参数表 —— 它的窗口才是 `i` 的真正类型。
    let l_asize: u64 = ahi - alo;
    let l_loop_tlo: u64 = if l_miss { std_funcs.meta_loop_type_name(base, alo, l_asize) } else { 0xFFFFFFFFFFFFFFFF };
    let l_loop_thi: u64 = std_types.meta_cell_get(scp + 0);
    let l_loop_miss: bool = l_loop_tlo == 0xFFFFFFFFFFFFFFFF;
    let l_tlo3: u64 = if l_loop_miss { l_tlo } else { l_loop_tlo };
    let l_thi3: u64 = if l_loop_miss { l_thi } else { l_loop_thi };
    let l_miss3: bool = l_tlo3 == 0xFFFFFFFFFFFFFFFF;
    let r_tlo: u64 = if l_miss {
      let rt: u64 = std_records.meta_operand_type_window(base, len, parent, rni);
      rt
    } else {
      0xFFFFFFFFFFFFFFFF
    };
    let r_thi: u64 = std_types.meta_cell_get(scp + 0);
    let r_miss: bool = r_tlo == 0xFFFFFFFFFFFFFFFF;
    let l_hit: bool = l_miss3 == 0;
    let r_hit: bool = r_miss == 0;
    let any_hit: bool = l_hit or r_hit;
    // 归档的 %tlo2 值 if 假支里还套着值 if：改成一次性选择循环。
    let tlo2: u64 = loop pick_tlo2(t: u64 = 0) {
      if l_hit { break pick_tlo2(l_tlo3); }
      if r_hit { break pick_tlo2(r_tlo); }
      break pick_tlo2(t_lo);
    };
    let thi2: u64 = loop pick_thi2(t: u64 = 0) {
      if l_hit { break pick_thi2(l_thi3); }
      if r_hit { break pick_thi2(r_thi); }
      break pick_thi2(t_hi);
    };
    // 指令那一格写的是**操作数**的宽度：`x < 2` 里两个操作数是 i32，所以发
    // `#slt[#bits<32>]`；结果天生 1 位，由验证器跟返回类型对。
    let kind2: u64 = if any_hit {
      let tid2: u64 = std_scalars.meta_type_resolve(base, len, tlo2, thi2);
      let info2: u64 = std_registry.meta_tid_repr(tid2);
      let kk: u64 = info2 and 255;
      kk
    } else {
      kind
    };
    let width2: u64 = if any_hit {
      let tid3: u64 = std_scalars.meta_type_resolve(base, len, tlo2, thi2);
      let info3: u64 = std_registry.meta_tid_repr(tid3);
      let ww: u64 = (info3 >> 8) and 255;
      ww
    } else {
      width
    };
    // 两个操作数都是**裸字面量**时，先按上下文的类型查；上下文那个类型**查不到**这个
    // 算子（`bool` 的 op 表是空的），才退回**字面量自己的类型** —— 参考经典 C：十进制
    // 常量取「装得下它的第一个类型」，这里是 i32，装不下才 i64；`i8`/`u8`/`bool` 不进
    // 候选（C 也不会把字面量定成 char/short）。
    //
    // **只在这一种情况下退回**：有名字操作数时（`x < 2`，`x` 是 u32）退回 i32 会把
    // `ult` 发成 `slt` —— 那是静默给错值。
    let l_lit0: bool = acc == 0xFFFFFFFFFFFFFFFF;
    let l_dig: bool = meta_is_int_literal(base, alo, ahi, len);
    let l_lit: bool = l_lit0 and l_dig;
    let r_lit0: bool = rref == 0xFFFFFFFFFFFFFFFF;
    let r_dig: bool = meta_is_int_literal(base, rn_lo2, rn_hi2, len);
    let r_lit: bool = r_lit0 and r_dig;
    let both_lit: bool = l_lit and r_lit;
    // `p + i`（地址 + 整数）：地址不是算子表里的类型，`+` 在这里就是
    // `#lea(基址, 下标, 1, 0)`。只认 `+` 一个符号，且操作数的类型得是 addr。
    let sp_b: u8 = std_lex.bs_byte_at(base, bat, len);
    let is_plus: bool = (sp_b as u32) == 43;
    // **只认左边的地址**：`1 + p` 不是地址算术（换过去是 `#lea(1, %p, 1, 0)`）。
    let a_tid: u64 = if l_hit {
      let a_t2: u64 = std_scalars.meta_type_resolve(base, len, l_tlo, l_thi);
      a_t2
    } else {
      0
    };
    let a_info: u64 = std_registry.meta_tid_repr(a_tid);
    let a_kind: u64 = a_info and 255;
    let a_is_addr: bool = a_kind == 3;
    let is_lea: bool = is_plus and a_is_addr;
    // `p + i * K`：地址算术把 scale 固定成 1，于是 `p + i * 4` 先算成 `(p + i) * 4`、
    // 在 addr 上报 6。这里就地看出来：右操作数后面紧跟 `* <裸字面量>`，且再往后不是算子。
    // 认出来就把那条乘法挪进 `#lea` 的 scale，游标跳过那两个节点。
    // 归档的 %lea_k 值 if 里套了四层值 if：改成一次性选择循环，只有走到的那一支求值。
    let lea_k: u64 = loop pick_leak(t: u64 = 0) {
      if is_lea == 0 { break pick_leak(0xFFFFFFFFFFFFFFFF); }
      let m_n: u64 = std_parse.ast_child(parent, rn_nx3);
      let m_none: bool = m_n == 0;
      if m_none { break pick_leak(0xFFFFFFFFFFFFFFFF); }
      let m_at: u64 = std_parse.meta_node_start(m_n);
      let m_b: u8 = std_lex.bs_byte_at(base, m_at, len);
      let m_nl: u64 = std_parse.meta_node_len(m_n);
      let m_isstar: bool = (m_b as u32) == 42;
      let m_one: bool = m_nl == 1;
      let m_star: bool = m_isstar and m_one;
      let m_i: u64 = rn_nx3 + 1;
      let m_kn: u64 = std_parse.ast_child(parent, m_i);
      let m_knone: bool = m_kn == 0;
      if m_knone { break pick_leak(0xFFFFFFFFFFFFFFFF); }
      let m_klo: u64 = std_parse.meta_node_start(m_kn);
      let m_khi: u64 = m_klo + std_parse.meta_node_len(m_kn);
      let m_kd: bool = meta_is_int_literal(base, m_klo, m_khi, len);
      let m_ok: bool = m_star and m_kd;
      if m_ok == 0 { break pick_leak(0xFFFFFFFFFFFFFFFF); }
      let m_ai: u64 = rn_nx3 + 2;
      let m_an: u64 = std_parse.ast_child(parent, m_ai);
      let m_anone: bool = m_an == 0;
      // 区域类型跟着被调过程的返回值走：`bs_is_operator` 回 1 位。
      let m_op: bool = loop pick_mop(t: bool = 0) {
        if m_anone { break pick_mop(0); }
        let m_aat: u64 = std_parse.meta_node_start(m_an);
        let m_anl: u64 = std_parse.meta_node_len(m_an);
        let m_isop: bool = std_lex.bs_is_operator(base, m_aat, len, m_anl);
        break pick_mop(m_isop);
      };
      let m_stop: bool = m_op == 0;
      if m_stop == 0 { break pick_leak(0xFFFFFFFFFFFFFFFF); }
      let m_kv: u64 = std_lex.bs_read_uint(base, m_klo, len);
      break pick_leak(m_kv);
    };
    let lea_has: bool = lea_k != 0xFFFFFFFFFFFFFFFF;
    let lea_mult: bool = is_lea and lea_has;
    let lea_nxt: u64 = if lea_mult {
      let ln2: u64 = rn_nx3 + 2;
      ln2
    } else {
      rn_nx3
    };
    // 右边是地址、左边不是：`i + p` 不是地址算术，也不能按左边的整数类型发
    // `#add`（地址不是整数）。报 4。
    let rwt_lo: u64 = std_records.meta_operand_type_window(base, len, parent, rni);
    let rwt_hi: u64 = std_types.meta_cell_get(scp + 0);
    let rwt_miss: bool = rwt_lo == 0xFFFFFFFFFFFFFFFF;
    let rwtid: u64 = if rwt_miss {
      0
    } else {
      let rwt2: u64 = std_scalars.meta_type_resolve(base, len, rwt_lo, rwt_hi);
      rwt2
    };
    let rwinfo: u64 = std_registry.meta_tid_repr(rwtid);
    let rkind: u64 = rwinfo and 255;
    let r_is_addr: bool = rkind == 3;
    let nonl: bool = a_is_addr == 0;
    let rev_ok: bool = r_is_addr and nonl;
    let rev_bad: bool = is_plus and rev_ok;
    if rev_bad {
      let f3c: u32 = lain_meta_fail(4);
      break e(4);
    }
    // 现在才查物理算子。从这往后到这条指令发完，**不能再有任何递归调用** ——
    // 否则 `+24`/`+32` 里的名字会被换掉。
    let sym: addr = base + bat;
    let ctx_phys: u64 = std_scalars.meta_op_resolve(base, len, tlo2, thi2, sym, bn);
    let ctx_miss: bool = ctx_phys == 0xFFFFFFFFFFFFFFFF;
    let try_default: bool = both_lit and ctx_miss;
    let def_phys: u64 = if try_default {
      let p0: u64 = std_scalars.meta_op_resolve_default(base, len, sym, bn,
                                            alo, ahi, rn_lo2, rn_hi2);
      p0
    } else {
      0xFFFFFFFFFFFFFFFF
    };
    let def_miss: bool = def_phys == 0xFFFFFFFFFFFFFFFF;
    let phys: u64 = if try_default { def_phys } else { ctx_phys };
    let miss: bool = if try_default { def_miss } else { ctx_miss };
    let missreal: bool = miss and (is_lea == 0);
    if missreal {
      let f3: u32 = lain_meta_fail(6);
      break e(6);
    }
    // 用了字面量自己的类型，**指令的类型实参也得跟着换** —— 默认类型都是 `bits<N>`
    // （kind 恒为 0），宽度由 `meta_op_resolve_default` 写在暂存区 `+488`。不换的话
    // `let b: bool = 1 < 2;` 会按绑定的 1 位发 `#slt[#bits<1>](1, 2)`：`2` 被截成 0，
    // 比较结果变成假 —— 验证通过、值是错的。
    let kind3: u64 = if try_default { 0 } else { kind2 };
    let width3: u64 = if try_default {
      let wcell: u64 = std_types.meta_cell_get(sc3 + 488);
      wcell
    } else {
      width2
    };
    // 裸字面量当操作数：装不装得进这条指令的宽度（`let main: i8 = 1 + 300;` 曾经
    // 静默截断成 44）。量的是 `%kind3/%width3` —— 那才是这条指令真正的类型实参。
    let lfit: u32 = meta_literal_fits(base, len, acc, alo, ahi,
                                       kind3, width3);
    let lbadfit: bool = lfit != 0;
    if lbadfit {
      break e(lfit);
    }
    let rfit: u32 = meta_literal_fits(base, len, rref, rn_lo2, rn_hi2,
                                      kind3, width3);
    let rbadfit: bool = rfit != 0;
    if rbadfit {
      break e(rfit);
    }
    // 这条是不是整条链的最后一条？看右操作数后面那个位置还是不是算子。
    // **必须在 `meta_op_resolve` 之后做**：这几个都是只读树的叶子调用，不碰 `+24`/`+32`。
    let nx2c: u64 = std_parse.ast_child(parent, rn_nx3);
    let a_at: u64 = std_parse.meta_node_start(nx2c);
    let a_b: u8 = std_lex.bs_byte_at(base, a_at, len);
    let a_nl: u64 = std_parse.meta_node_len(nx2c);
    let a_op: bool = std_lex.bs_is_operator(base, a_at, len, a_nl);
    let last: bool = a_op == 0;
    let is_bind: bool = close == 1;
    let named: bool = is_bind and last;
    // `  %r<n> = ` 还是 `  %NAME = `。绑定模式的最后一条**直接写名字** —— 这样
    // `let y: i32 = 1 + 2;` 出来的还是一条指令（与老路径逐字节一样），而不是
    // "先 `%r1 = #add(1, 2)` 再复制进 `%y`"。
    let tn: u64 = loop pick_tn(t: u64 = 0) {
      if named {
        let y1: u32 = std_lainir.lainir_st_pct_write();
        let n_at: addr = base + n_lo;
        let n_len: u64 = n_hi - n_lo;
        let y2: u32 = std_lainir.lainir_write(n_at, n_len);
        // 名字就是这条指令的结果，没有临时值 —— 也**不占**临时值编号
        break pick_tn(0xFFFFFFFFFFFFFFFF);
      }
      let y3: u32 = std_lainir.lainir_indent_write();
      let n2: u64 = std_funcs.meta_next_temp();
      let y4: u32 = std_funcs.meta_emit_temp_name(n2);
      break pick_tn(n2);
    };
    let x3: u32 = std_lainir.lainir_result_sep_write();
    // 地址加整数发 `#lea(基址, 下标, 1, 0)`：没有类型实参，结果类型由验证器跟着
    // 那个地址操作数对。
    if is_lea {
      let q1: u32 = std_lainir.lainir_lea_head_write();
      let q2: u32 = meta_emit_ref2(base, len, acc, alo, ahi);
      let q3: u32 = std_lainir.lainir_comma_write();
      let q4: u32 = meta_emit_ref2(base, len, rref, rn_lo2, rn_hi2);
      let q5: u32 = std_lainir.lainir_comma_write();
      let q6v: u64 = if lea_mult { lea_k } else { 1 };
      let q6: u32 = std_lainir.lainir_emit_uint(q6v);
      let q7: u32 = std_lainir.lainir_comma_write();
      let q8: u32 = std_emit.meta_emit_uint(0);
      let q9: u32 = std_lainir.lainir_close_paren_write();
      let q10: u32 = std_lainir.lainir_newline_write();
    } else {
      let x4: u32 = std_funcs.meta_emit_op_mid(kind3, width3);
      let x5: u32 = meta_emit_ref2(base, len, acc, alo, ahi);
      let x6: u32 = std_lainir.lainir_comma_write();
      let x7: u32 = meta_emit_ref2(base, len, rref, rn_lo2, rn_hi2);
      let x8: u32 = std_lainir.lainir_close_paren_write();
      let x9: u32 = std_lainir.lainir_newline_write();
    }
    // 绑定模式且这一条已经是最后一条：语句的收尾就是它，循环出去时别再补一条
    let bound2: bool = named;
    // `p + i * K` 那一步已经把 `* K` 吃进 scale，游标要多跳两格。
    continue e(lea_nxt, 1, tn, 0, 0, bound2);
  };
  return st;
}

func meta_emit_symbol_addr_line(symbol: addr, symbol_len: u64) -> u64 {
  let indent: addr = std_lainir.lainir_indent;
  let w0: u32 = std_lainir.lainir_write(indent, 2);
  let tn: u64 = std_funcs.meta_next_temp();
  let pct: addr = std_lainir.lainir_pct_r;
  let w1: u32 = std_lainir.lainir_write(pct, 2);
  let w2: u32 = std_lainir.lainir_emit_uint(tn);
  let assign: addr = std_lainir.lainir_assign;
  let w3: u32 = std_lainir.lainir_write(assign, 4);
  // D-002：同上，`#data_addr` 已从算子表移除，这里发 `#bitcast[#addr](%NAME)`。
  let head: addr = std_lainir.lainir_bitcast_addr_head;
  let w4: u32 = std_lainir.lainir_write(head, 16);
  let w5: u32 = std_lainir.lainir_write(symbol, symbol_len);
  let w6: u32 = std_lainir.lainir_write(std_lainir.lainir_rparen_nl, 2);
  return tn;
}

func meta_operand_const(base: addr, len: u64, ref_v: u64, lo: u64, hi: u64) -> u64 {
  let noref: bool = ref_v == 0xFFFFFFFFFFFFFFFF;
  let dig: bool = meta_is_int_literal(base, lo, hi, len);
  let hit: bool = noref and dig;
  if hit {
    let pv: u64 = std_lex.bs_read_uint(base, lo, len);
    return pv;
  }
  return 0xFFFFFFFFFFFFFFFF;
}

func meta_emit_lea_line(temp: u64, base_txt: addr, base_len: u64, idx_txt: addr, idx_len: u64, scale: u64, disp: u64) -> u32 {
  let w0: u32 = std_lainir.lainir_indent_write();
  let w1: u32 = std_funcs.meta_emit_temp_name(temp);
  let w2: u32 = std_lainir.lainir_result_sep_write();
  let w3: u32 = std_lainir.lainir_lea_head_write();
  let w4: u32 = std_lainir.lainir_write(base_txt, base_len);
  let w5: u32 = std_lainir.lainir_comma_write();
  let w6: u32 = std_lainir.lainir_write(idx_txt, idx_len);
  let w7: u32 = std_lainir.lainir_comma_write();
  let w8: u32 = std_emit.meta_emit_uint(scale);
  let w9: u32 = std_lainir.lainir_comma_write();
  let w10: u32 = std_emit.meta_emit_uint(disp);
  let w11: u32 = std_lainir.lainir_close_paren_write();
  let w12: u32 = std_lainir.lainir_newline_write();
  return 0;
}

func meta_emit_cast_temp(target_kind: u64, target_width: u64, text: addr, text_len: u64) -> u32 {
  let tn: u64 = std_funcs.meta_next_temp();
  let is_ptr: bool = target_kind == 3;
  let w: u32 = loop pick_w(t: u64 = 0) {
    if is_ptr {
      let v: u32 = std_lainir.lainir_int2ptr_at(tn, text, text_len);
      break pick_w(v);
    }
    // 目标是整数时只认 64 位：语言侧要的是 `u64`（`addr` 也是 64 位）。别的宽度
    // 没有语义（窄转换走 `as u8` 那条 zext/trunc 路），拒，不猜。
    let w_ok: bool = target_width == 64;
    if w_ok {
      let v2: u32 = std_lainir.lainir_ptr2int_at(target_width, tn, text, text_len);
      break pick_w(v2);
    }
    let fw: u32 = lain_meta_fail(4);
    break pick_w(4);
  };
  let sc: addr = lain_meta_scratch_data();
  let p1: u32 = std_types.meta_cell_put(sc + 168, tn);
  let p2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let p3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return w;
}

func meta_value_name_window(base: addr, len: u64, lo: u64, hi: u64) -> u64 {
  let b: u8 = std_lex.bs_byte_at(base, lo, len);
  let b_w: u32 = b as u32;
  let is_q: bool = b_w == 63;
  let sc: addr = lain_meta_scratch_data();
  if is_q {
    let lo2: u64 = lo + 1;
    let p: u32 = std_types.meta_cell_put(sc + 0, hi);
    return lo2;
  }
  let p2: u32 = std_types.meta_cell_put(sc + 0, hi);
  return lo;
}

func meta_operand_is_addr(base: addr, len: u64, lo: u64, hi: u64, ref_v: u64) -> bool {
  let unused: u64 = ref_v + 0;
  let n0: u64 = meta_value_name_window(base, len, lo, hi);
  let nsc: addr = lain_meta_scratch_data();
  let hi0: u64 = std_types.meta_cell_get(nsc + 0);
  let o_n: u64 = std_recognize.meta_node_at(base, n0);
  let s_lo: u64 = std_funcs.meta_word_type_name(base, len, o_n);
  let s_miss0: bool = s_lo == 0xFFFFFFFFFFFFFFFF;
  // 参数表里没有就问局部变量表（终点已经在暂存区 +0 里），两支都是纯表达式。
  let s_lo2: u64 = if s_miss0 {
    std_funcs.meta_local_type_name(base, n0, hi0)
  } else {
    s_lo
  };
  let sc: addr = lain_meta_scratch_data();
  let s_hi: u64 = std_types.meta_cell_get(sc + 0);
  let s_miss: bool = s_lo2 == 0xFFFFFFFFFFFFFFFF;
  // 类型名在：走类型解析那条路（原来 %k 值 if 的假支）。
  if s_miss == 0 {
    let s_tid: u64 = std_scalars.meta_type_resolve(base, len, s_lo2, s_hi);
    let k2: u64 = std_registry.meta_tid_repr_kind(s_tid);
    let is_addr2: bool = k2 == 3;
    return is_addr2;
  }
  // 类型名不在：查作用域表（原来 %k 值 if 的真支）。
  let n_at: addr = base + n0;
  let n_len: u64 = hi0 - n0;
  let ei: u64 = std_scope.meta_scope_find(n_at, n_len);
  let ef: bool = ei != 0xFFFFFFFFFFFFFFFF;
  if ef == 0 {
    let k3: u64 = 0xFFFFFFFFFFFFFFFF;
    let is_addr3: bool = k3 == 3;
    return is_addr3;
  }
  let ek: u64 = std_scope.meta_scope_kind(ei);
  let is3: bool = ek == 3;
  if is3 == 0 {
    let k4: u64 = 0xFFFFFFFFFFFFFFFF;
    let is_addr4: bool = k4 == 3;
    return is_addr4;
  }
  let ev: u64 = std_scope.meta_scope_emitted(ei);
  let ev_ok: bool = ev != 0;
  let pl: u64 = std_scope.meta_scope_payload(ei);
  let pl_b: u8 = std_lex.bs_byte_at(base, std_parse.meta_node_start(pl), len);
  let pl_w: u32 = pl_b as u32;
  let pl_str: bool = pl_w == 34;
  let st: bool = ev_ok or pl_str;
  let k5: u64 = if st { 3 } else { 0xFFFFFFFFFFFFFFFF };
  let is_addr5: bool = k5 == 3;
  return is_addr5;
}

func meta_operand_cast(base: addr, len: u64, parent: u64, op_index: u64, t_n: u64, aref: u64, alo: u64, ahi: u64) -> u64 {
  let t_none: bool = t_n == 0;
  if t_none {
    let f0: u32 = lain_meta_fail(3);
    return 3;
  }
  let t_lo: u64 = std_parse.meta_node_start(t_n);
  let t_hi: u64 = std_lex.bs_skip_qualified(base, t_lo, len);
  // 操作数必须是**一个名字**（可以带 `?` 前缀）。静态数据的索引（`t[i]`）在上一层就
  // 物化成了临时值，源码窗口指不到一个名字 —— 那种不带转换。
  let n_lo: u64 = meta_value_name_window(base, len, alo, ahi);
  let nsc: addr = lain_meta_scratch_data();
  let n_hi: u64 = std_types.meta_cell_get(nsc + 0);
  let o_n: u64 = std_recognize.meta_node_at(base, n_lo);
  let o_none: bool = o_n == 0;
  let o_st: u64 = if o_none {
    0xFFFFFFFFFFFFFFFF
  } else {
    std_parse.meta_node_start(o_n)
  };
  let o_at_ok: bool = o_st == n_lo;
  if o_at_ok == 0 {
    let f0b: u32 = lain_meta_fail(4);
    return 4;
  }
  // 源的表示类别：参数名取参数表、局部绑定取局部表；都没有就看是不是静态数据绑定。
  let s_lo: u64 = std_funcs.meta_word_type_name(base, len, o_n);
  let s_miss0: bool = s_lo == 0xFFFFFFFFFFFFFFFF;
  let s_lo2: u64 = if s_miss0 {
    std_funcs.meta_local_type_name(base, n_lo, n_hi)
  } else {
    s_lo
  };
  let sc: addr = lain_meta_scratch_data();
  let s_hi: u64 = std_types.meta_cell_get(sc + 0);
  let s_miss: bool = s_lo2 == 0xFFFFFFFFFFFFFFFF;
  // %s_kind 的归档值 if 支里还有两层 if，结果喂给后面的计算（不是 return）：
  // 一次性选择循环 pick_kind；两层内层 if 改成平坦守卫（条件按旧 IR 顺序求值，
  // 只有原来会走到的分支才被求值）。
  let s_kind: u64 = loop pick_kind(t: u64 = 0) {
    if s_miss {
      let nm_at: addr = base + alo;
      let nm_len: u64 = ahi - alo;
      let ei: u64 = std_scope.meta_scope_find(nm_at, nm_len);
      let efound: bool = ei != 0xFFFFFFFFFFFFFFFF;
      let stat: bool = loop pick_stat(u: u64 = 0) {
        if efound {
          let ek: u64 = std_scope.meta_scope_kind(ei);
          let ek_table: bool = ek == 3;
          if ek_table {
            let ev: u64 = std_scope.meta_scope_emitted(ei);
            let ev_ok: bool = ev != 0;
            let pl: u64 = std_scope.meta_scope_payload(ei);
            let pl_lo: u64 = std_parse.meta_node_start(pl);
            let pl_b: u8 = std_lex.bs_byte_at(base, pl_lo, len);
            let pl_w: u32 = pl_b as u32;
            let pl_str: bool = pl_w == 34;
            break pick_stat(ev_ok or pl_str);
          }
          break pick_stat(0);
        }
        break pick_stat(0);
      };
      if stat { break pick_kind(3); }
      break pick_kind(0xFFFFFFFFFFFFFFFF);
    }
    let s_tid: u64 = std_scalars.meta_type_resolve(base, len, s_lo2, s_hi);
    // break 的实参拿不到期望类型，嵌套调用要先进局部（否则验证器 2020）。
    let sk: u64 = std_registry.meta_tid_repr_kind(s_tid);
    break pick_kind(sk);
  };
  let t_tid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
  let t_tidz: bool = t_tid == 0;
  if t_tidz {
    let f3: u32 = lain_meta_fail(5);
    return 5;
  }
  let t_kind: u64 = std_registry.meta_tid_repr_kind(t_tid);
  let t_width: u64 = std_registry.meta_tid_repr_width(t_tid);
  // 认一条路：**恰好一边是地址**。1 位值上的 #xor 与 bool 的 != 同义。
  let s_addr: bool = s_kind == 3;
  let t_addr: bool = t_kind == 3;
  let mixed: bool = s_addr != t_addr;
  if mixed == 0 {
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  let nm_at2: addr = base + n_lo;
  let nm_len2: u64 = n_hi - n_lo;
  let ei2: u64 = std_scope.meta_scope_find(nm_at2, nm_len2);
  let ef2: bool = ei2 != 0xFFFFFFFFFFFFFFFF;
  // 归档的 %st2 值 if（真支里有一个 let）结果喂给后面的值 if：一次性选择循环 pick_st2。
  let st2: bool = loop pick_st2(t: u64 = 0) {
    if ef2 {
      let ek2: u64 = std_scope.meta_scope_kind(ei2);
      break pick_st2(ek2 == 3);
    }
    break pick_st2(0);
  };
  let buf: addr = std_lainir.lainir_text_buffer;
  // 块名就是裸名字：符号文本先拼进缓冲，再由它发地址行、取回 `%r<b>` 的长度。
  let sym_end: u64 = if st2 {
    let sym_at: addr = base + n_lo;
    let sym_b: u64 = std_lainir.lainir_buf_bytes(buf, 0, sym_at, nm_len2);
    sym_b
  } else {
    0
  };
  let a_end: u64 = if st2 {
    let tmp: u64 = meta_emit_symbol_addr_line(buf, sym_end);
    std_lainir.lainir_buf_temp(buf, 0, tmp)
  } else {
    0
  };
  // `%a_end` 就是 `%r<b>` 文本的长度（`lainir_buf_temp` 回的是写完之后的位置）。
  let a_len: u64 = if st2 {
    a_end
  } else {
    meta_render_ref2(base, len, aref, alo, ahi, buf)
  };
  let cs: u32 = meta_emit_cast_temp(t_kind, t_width, buf, a_len);
  // `as` 与它后面的类型名各占一格：`meta_after_operand` 给的是类型的下标，再前进一格。
  let nx: u64 = meta_after_operand(base, len, parent, op_index);
  let nx2: u64 = nx + 1;
  return nx2;
}
