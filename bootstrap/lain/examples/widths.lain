func n64(a: u64, b: u64) -> u64 { return a * b + a / b; }
func c64(a: u64, b: u64) -> bool { return a >= b; }
func ln(a: usize, b: usize) -> usize { return a + b; }
func lc(a: usize, b: usize) -> bool { return a != b; }
func s64(a: i64, b: i64) -> i64 { return a - b; }
func bl(a: bool, b: bool) -> bool { return a and b; }
