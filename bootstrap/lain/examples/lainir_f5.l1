#proc f5_probe(%index: #bits<64>) -> #bits<32> {
  %reset = #call lainir_reset()
  %buf = #data_addr lainir_text_buffer
  %abase = #lea(%buf, 32, 1, 0)
  %blen = #call lainir_buf_temp(%abase, 0, 12)
  %lbuf = #lea(%buf, 64, 1, 0)
  %alen = #call lainir_text_lea_field(%lbuf, 0, %abase, %blen, 340)
  %w = #call lainir_write(%lbuf, %alen)
  #return %w
}
