// 带值 if 缺 `else`：假分支直接 `#yield 0`。

func keep(a: i32, c: bool) -> i32 {
  let y: i32 = if c { a };
  return y + 1;
}

func keep_or_zero(a: i32, c: bool) -> i32 {
  return if c { a };
}

func addr_or_null(p: addr, c: bool) -> addr {
  let q: addr = if c { p };
  return q;
}

func total(a: i32, b: i32, c: bool) -> i32 {
  let r: i32 = 1 + if c { a } else { b };
  let s: i32 = 2 + if c { a };
  return r + s;
}
