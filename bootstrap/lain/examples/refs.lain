// 引用 / 切片类型：ref / mut ref / slice。
func deref(p: ref u64) -> u64 {
  return load(p);
}
func set(p: mut ref u64, v: u64) -> u64 {
  store(p, v);
  return v;
}
func make_slice(b: addr, n: u64) -> slice u8 {
  return slice_of(b, n);
}
func via_ref() -> u64 {
  let x: u64 = 42;
  let r: ref u64 = ref_of(x);
  return load(r);
}
