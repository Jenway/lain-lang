enum Shape {
  Circle(i32)
  Empty
}

func add(a: i32, b: i32) -> i32 {
  return a + b;
}

// 绑定位置：判别字段命中才读载荷，不命中回 0。
func grab(s: Shape) -> i32 {
  let v: i32 = Shape.Circle(s);
  return v;
}

// 返回位置。
func grab2(s: Shape) -> i32 {
  return Shape.Circle(s);
}

// 实参位置。
func grab3(s: Shape) -> i32 {
  return add(Shape.Circle(s), 2);
}

// 两次投影各用自己的临时值。
func both(s: Shape) -> i32 {
  return Shape.Circle(s) + Shape.Circle(s);
}
