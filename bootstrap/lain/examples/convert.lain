// `as`：定宽整数之间的转换。变宽发 #zext、变窄发 #trunc、等宽补一条加零复制。
// 右边是**类型名**，不是值；目标类型决定指令的类型实参。

func widen(x: i32) -> i64 {
  let y: i64 = x as i64;
  return y;
}

func narrow(x: i64) -> i32 {
  let y: i32 = x as i32;
  return y;
}

func same(x: i32) -> i32 {
  let y: i32 = x as i32;
  return y;
}

// 没有类型标注的绑定：类型由 `as` 右边那个类型名给出。
func bare(x: i32) -> i64 {
  let y = x as i64;
  return y;
}
