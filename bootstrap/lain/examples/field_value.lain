struct Point {
  x: i32
  y: i32
}

// 单个字段当值。
func first(p: Point) -> i32 {
  return p.x;
}

func second(p: Point) -> i32 {
  return p.y;
}

// 两个字段各取一次，第二次不能复用第一次的地址。
func total(p: Point) -> i32 {
  return p.x + p.y;
}

func add(a: i32, b: i32) -> i32 {
  return a + b;
}

// 实参位置。
func pairs(p: Point) -> i32 {
  return add(p.x, p.y) + p.x;
}

// 绑定位置：带标注与不带标注。
func bind(p: Point) -> i32 {
  let y: i32 = p.x;
  let v = p.y;
  return y + v;
}
