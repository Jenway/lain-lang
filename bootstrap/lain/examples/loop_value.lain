// 循环出值：没有 `acc` 参数时，值由源码自己的 `break LABEL(值)` 带出来 ——
// Meta 里那 84 处 `#loop` 几乎都是这个形状（先找、命中就带走结果）。
func first_over(n: u64, k: u64) -> u64 {
  let r: u64 = loop s(i: u64 = 0) while i < n {
    if i == k {
      break s(i);
    } else {
      i = i + 1;
    }
  };
  return r;
}

// 循环参数的类型参与算子选择：`i` 是 u64，`i == 3` 发 `#eq[#bits<64>]`
// （之前循环参数没有类型来源，会退化成 `#bits<0>` 这种畸形宽度）。
func third(n: u64) -> u64 {
  let r: u64 = loop s(i: u64 = 0) while i < n {
    if i == 3 {
      break s(i);
    }
    i = i + 1;
  };
  return r;
}
