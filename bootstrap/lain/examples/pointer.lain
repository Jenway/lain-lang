func pack(p: addr) -> u64 {
  let w: u64 = ptr_of(p);
  return w;
}

func unpack(w: u64) -> addr {
  let q: addr = addr_of(w);
  return q;
}

func round(p: addr) -> addr {
  return addr_of(ptr_of(p));
}

func offset(p: addr, i: u64) -> u64 {
  let q: addr = lea(p, i);
  return ptr_of(q);
}

func same(p: addr) -> u64 {
  let w: u64 = ptr_of(p);
  let q: addr = addr_of(w);
  return ptr_of(q);
}

func poked(p: addr, v: u8) -> u64 {
  store(addr_of(ptr_of(p)), v);
  return ptr_of(addr_of(ptr_of(p)));
}
