struct Pair { a: i32 b: i32 }

// 函数体里的构造：从**栈**上划一块（`#alloca[#bits<8>](size)`），字段值可以是
// 参数（`a: v`）或字面量（`b: 3`），然后绑定成一个地址值。
func mk(v: i32) -> Pair {
  let p: Pair = Pair { a: v b: 3 };
  return p;
}

// 直接返回构造：`#return %r<n>`，不起临时名字。
func mk2(v: i32) -> Pair {
  return Pair { a: v b: v };
}

// 同一个函数里两处构造：各拿一个临时值编号，互不覆盖（顶层那套用同一个
// `%base` 名字 —— 那边每个构造点在自己的过程里，这里不行）。
func two(v: i32) -> Pair {
  let r: Pair = Pair { a: v b: 0 };
  let s: Pair = Pair { a: v b: 1 };
  return s;
}

// 顶层照旧：静态 `data` 块 + 取址过程。
let origin = Pair { a: 1 b: 2 };
