struct Pair { a: i32 b: i32 }

// 读一个字段：聚合是**参数**，地址由调用方给，出了帧也有效。
func pair_a(p: Pair) -> i32 {
  return p.a;
}

// 函数体里的构造：从**栈**上划一块（`#alloca[#bits<8>](size)`），字段值可以是
// 参数（`a: v`）或字面量（`b: 3`）。构造出来的地址只在**本帧内**有效，所以它不能
// 当返回值（那是错的输入，报 11）—— 这里把它交给同帧内的调用。
func mk(v: i32) -> i32 {
  let p: Pair = Pair { a: v b: 3 };
  return pair_a(p);
}

// 直接构造再交给调用（绑定名与顶层那套无关）。
func mk2(v: i32) -> i32 {
  let q: Pair = Pair { a: v b: v };
  return pair_a(q);
}

// 同一个函数里两处构造：各拿一个临时值编号，互不覆盖（顶层那套用同一个
// `%base` 名字 —— 那边每个构造点在自己的过程里，这里不行）。
func two(v: i32) -> i32 {
  let r: Pair = Pair { a: v b: 0 };
  let s: Pair = Pair { a: v b: 1 };
  return pair_a(s);
}

// 顶层照旧：静态 `data` 块 + 取址过程。
let origin = Pair { a: 1 b: 2 };
