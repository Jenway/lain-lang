// 模块样例（被导入的一侧）：值绑定、静态数据与类型声明；导出的函数成员由导入方
// 用 M.名字 调（M.bump），静态数据由导入方用 M.table 取址后读写。
let answer: u64 = 42;
let twice: u64 = answer;
let table: [u8] = [10, 20, 30];
// 表基址单独导出一次：symbol_addr 只认本模块的静态数据，跨模块用 M.base 取。
let base: addr = symbol_addr("table_storage");

func bump(v: u64) -> u64 {
  return v + 1;
}

struct Point { x: i32 y: i32 }
enum Shape { Circle(i32) Empty }
