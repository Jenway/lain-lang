extern source_count() -> u64 = lain_meta_source_count;
extern source_data(index: u64) -> addr = lain_meta_source_data;
extern emit_write(data: addr, length: u64) -> u32 = lain_meta_emit_write;
extern report_fail(code: u32) -> u32 = lain_meta_fail;

func first_byte() -> u8 {
  let p: addr = source_data(0);
  let b: u8 = load(p);
  return b;
}

func copy_head(len: u64) -> u32 {
  let p: addr = source_data(0);
  let st: u32 = emit_write(p, len);
  return st;
}

func probe() -> u64 {
  let n: u64 = source_count();
  return n;
}
