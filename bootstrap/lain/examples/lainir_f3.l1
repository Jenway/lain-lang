data f3_name ro { 102 51 95 112 114 111 98 101 }
data f3_params ro { 37 112 58 32 35 97 100 100 114 44 32 37 105 58 32 35 98 105 116 115 60 54 52 62 44 32 37 118 58 32 35 98 105 116 115 60 54 52 62 }
data f3_arg_p ro { 37 112 }
data f3_arg_i ro { 37 105 }
data f3_arg_v ro { 37 118 }
data f3_callee ro { 102 51 95 112 114 111 98 101 }
data f3_data_sym ro { 102 51 95 112 114 111 98 101 95 100 97 116 97 }
data f3_proc_sym ro { 102 51 95 112 114 111 98 101 }
data f3_call_args ro { 37 112 44 32 37 105 44 32 37 118 }
data f3_indirect_args ro { 37 105 }
data f3_indirect_target ro { 37 114 53 }
data f3_zero_text ro { 48 32 }
#proc f3_probe(%index: #bits<64>) -> #bits<32> {
  %reset = #call lainir_reset()
  %name = #data_addr f3_name
  %params = #data_addr f3_params
  %data_sym = #data_addr f3_data_sym
  %zero_text = #data_addr f3_zero_text
  %decl = #call lainir_data(%data_sym, 13, %zero_text, 2)
  %begin = #call lainir_proc_begin_typed(%name, 8, %params, 39)
  %p = #data_addr f3_arg_p
  %i = #data_addr f3_arg_i
  %v = #data_addr f3_arg_v
  %l = #call lainir_load(64, %p, 2)
  %s = #call lainir_store(64, %v, 2, %p, 2)
  %lea = #call lainir_lea(%p, 2, %i, 2, 8, 16)
  %alloc = #call lainir_alloca(8, 16)
  %ds = #data_addr f3_data_sym
  %da = #call lainir_data_addr(%ds, 13)
  %ps = #data_addr f3_proc_sym
  %pa = #call lainir_proc_addr(%ps, 8)
  %callee = #data_addr f3_callee
  %args = #data_addr f3_call_args
  %call = #call lainir_call(%callee, 8, %args, 10)
  %target = #data_addr f3_indirect_target
  %iargs = #data_addr f3_indirect_args
  %icall = #call lainir_call_indirect(%target, 3, %iargs, 2)
  %ret = #call lainir_return(0)
  %end = #call lainir_proc_end()
  #return %end
}
