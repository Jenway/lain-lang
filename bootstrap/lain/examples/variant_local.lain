enum Shape {
  Circle(i32)
  Empty
}

func id(x: i32) -> i32 {
  return x;
}

// 读载荷：投影的值是**参数**，地址由调用方给。
func payload(s: Shape) -> i32 {
  return Shape.Circle(s);
}

// 函数体里的构造：栈上划框、tag 一条 store、载荷一条 store。构造出来的地址只在
// 本帧内有效，当返回值报 11 —— 这里交给同帧内的投影。
func keep(k: i32) -> i32 {
  let s: Shape = Shape.Circle { k };
  return payload(s);
}

// 载荷是一条表达式。
func compute(x: i32) -> i32 {
  let s: Shape = Shape.Circle { id(x) };
  return payload(s);
}
