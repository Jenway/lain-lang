enum Shape {
  Circle(i32)
  Empty
}

func id(x: i32) -> i32 {
  return x;
}

// 绑定位置：栈上划框、tag 一条 store、载荷一条 store。
func keep(k: i32) -> Shape {
  let s: Shape = Shape.Circle { k };
  return s;
}

// 返回位置。
func make() -> Shape {
  return Shape.Circle { 7 };
}

// 载荷是一条表达式。
func compute(x: i32) -> Shape {
  let s: Shape = Shape.Circle { id(x) };
  return s;
}

// 空变体只有 tag。
func blank() -> Shape {
  let e: Shape = Shape.Empty { };
  return e;
}
