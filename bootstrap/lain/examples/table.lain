// 定长同质表的静态数据：字面量建块、索引取址、len 取元素个数。
//
let bytes: [u8] = [1, 2, 3, 4];
let table: [u64] = [10, 20, 30];
let marks: ro [u8] = [7, 8, 9, 10, 11];

func second() -> u8 {
  let p: addr = bytes[1];
  return load(p);
}

func third() -> u64 {
  let p: addr = table[2];
  return load(p);
}

func count() -> u64 {
  let n: u64 = len(table);
  return n;
}

func first_mark() -> u8 {
  let p: addr = marks[0];
  return load(p);
}

func bump(i: u64, v: u64) -> u64 {
  let p: addr = table[i];
  store(p, v);
  let q: addr = table[i];
  return load(q);
}
