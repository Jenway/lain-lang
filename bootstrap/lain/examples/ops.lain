// 算子表样例：i32 / u32 的算术与比较。
//
// 每个函数对应标量表里的一条绑定：算术 - * / %，比较 == != > <= >=。
// 物理算子由操作数的类型决定（i32 走 sdiv/srem/slt 一列，u32 走 udiv/urem/ult 一列）。
func mix(a: i32, b: i32) -> i32 { return (a - b) * 2 + a % b - a / b; }
func cmp_signed(a: i32, b: i32) -> bool { return a >= b; }
func cmp_unsigned(a: u32, b: u32) -> bool { return a > b; }
func cmp_equal(a: i32, b: i32) -> bool { return a != b; }
func mix_unsigned(a: u32, b: u32) -> u32 { return a - b * 2 + a % b; }
func cmp_le(a: u32, b: u32) -> bool { return a <= b; }
