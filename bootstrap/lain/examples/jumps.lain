// 早退：break / continue 带实参。循环体里出现终止语句之后就不会再往下走（区域里
// 终止指令必须是最后一条），所以测试重点在「实参怎么发」与「收尾还合不合法」。

func first(n: i32) -> i32 {
  let total: i32 = loop outer(i: i32 = n, acc: i32 = 0) while i > 0 {
    acc = acc + i;
    break outer(acc);
  };
  return total;
}

func early(n: i32) -> i32 {
  let total: i32 = loop outer(i: i32 = n, acc: i32 = 0) while i > 0 {
    acc = acc + i;
    break outer(acc + 1);
  };
  return total;
}

func step(n: i32) -> i32 {
  let total: i32 = loop outer(i: i32 = 0, acc: i32 = 0) while i < n {
    acc = acc + i;
    continue outer(i + 1, acc + 2);
  };
  return total;
}
