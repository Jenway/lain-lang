extern cell_get(p: addr) -> u64 = meta_cell_get;

// 循环体里可以写 `let`：类型进局部变量表，值走与函数体同一条语句降级路。
// 这是为了用表面 Lain 重写 registry 模块而补的（`meta_reg_lookup` 的体内到处是
// `let e: addr = reg_entry(scratch, i);`、`let k: u64 = cell_get(e + 8);`）。
func find_first(scratch: addr, kind: u64) -> u64 {
  let found: u64 = loop s(i: u64 = 0) {
    let e: addr = scratch + 520;
    let k: u64 = cell_get(e + 8);
    if k == kind {
      let id: u64 = cell_get(e);
      break s(id);
    } else {
      i = i + 1;
    }
  };
  return found;
}
