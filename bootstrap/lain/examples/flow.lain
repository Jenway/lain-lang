// 控制流与省略标注的绑定。
//
// `if <表达式> <块> [else <块>]`：条件不需要括号 —— 多 token 的条件（`a < b`）
// 走统一表达式入口，块就是表达式停下来的那一格。
// `let NAME = <值>;`：类型由**值**推 —— 调用取被调方声明的返回类型，参数名取参数表，
// 都不是就退回本函数的返回类型当上下文。
func pick(a: i32, b: i32) -> i32 {
  if a < b { return a; } else { return b; }
}

func inc(x: i32) -> i32 { return x + 1; }

func bump(n: i32) -> i32 {
  let y = inc(n);
  return y;
}

func copy_of(n: i32) -> i32 {
  let z = n;
  return z;
}

func lit() -> i32 {
  let k = 1 + 2;
  return k;
}
