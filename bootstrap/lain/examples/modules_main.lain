// 模块样例（导入方）：值绑定在绑定位置、表达式位置、实参位置各用一次；
// 模块里的类型名在参数与返回类型位置各用一次。
let M = import("examples::modules_lib");

let a: u64 = M.answer;

func bump(v: u64) -> u64 {
  return v + 1;
}

func total() -> u64 {
  return M.answer + M.twice + bump(M.answer);
}

func keep(p: M.Point) -> M.Point {
  return p;
}

func later() -> u64 {
  let x: u64 = M.answer + 2;
  return x;
}
