// 模块样例（导入方）：值绑定在绑定位置、表达式位置、实参位置各用一次；
// 模块里的类型名在参数与返回类型位置各用一次。跨模块静态数据取址后喂给 store；
// 嵌套成员调用 M.bump(M.twice) 与跨模块字段访问 p.x 各覆盖一次。
let M = import("examples::modules_lib");

let a: u64 = M.answer;

func bump(v: u64) -> u64 {
  return v + 1;
}

func total() -> u64 {
  return M.answer + M.twice + bump(M.answer);
}

// 嵌套成员调用：被调者与实参都是被导入模块的成员。
func nested() -> u64 {
  return M.bump(M.twice);
}

func keep(p: M.Point) -> M.Point {
  return p;
}

func later() -> u64 {
  let x: u64 = M.answer + 2;
  return x;
}

// 跨模块静态数据：M.table[i] 给出第 i 个元素的地址；M.base 是被导入模块导出的表
// 基址（addr 类型），按既有地址算术偏移后同样能喂给 store。
func poke(i: u64, v: u8) -> u8 {
  let p: addr = M.table[i];
  store(p, v);
  let q: addr = M.base + i;
  return load(q);
}

// 跨模块字段访问：参数类型是被导入模块声明的 Point，直接读字段。
func px(p: M.Point) -> i32 {
  return p.x;
}
