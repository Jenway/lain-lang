// 带值 if 的用法：结果绑在名字上（`choose.lain`）、直接 `return`、以及当表达式里的操作数。
// 三个位置都会把整条 `#if` 发成一条临时值，后面那一步再引用它。

func plus(a: i32, c: bool) -> i32 {
  return 1 + if c { a } else { 0 - a };
}

func pick(a: i32, b: i32, c: bool) -> i32 {
  return if a < b { a } else { b };
}

func scale(a: i32, c: bool) -> i32 {
  let q: i32 = (if c { a } else { 2 }) * 3;
  return q;
}

func sum(a: i32, c: bool) -> i32 {
  let r: i32 = 1 + if c { a } else { 2 };
  return r + if c { 3 } else { 4 };
}
