data f1_name ro { 112 114 111 98 101 }
#proc f1_probe(%index: #bits<64>) -> #bits<32> {
  %reset = #call lainir_reset()
  %output = #call lainir_text()
  %length = #call lainir_length()
  %name = #data_addr f1_name
  %begin = #call lainir_proc_begin(%name, 5)
  %ret = #call lainir_return(0)
  %end = #call lainir_proc_end()
  #return %end
}
