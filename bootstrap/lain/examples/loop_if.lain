// 循环体内的 if：分支里提前 break / continue，分支里给循环参数赋值后按新值继续，
// 以及分支里再套一层 if。值在分支之间合并，if 之后的语句读到的是合并后的值。

func clip(n: i32) -> i32 {
  let total: i32 = loop scan(i: i32 = 0, acc: i32 = 0) while i < n {
    if acc > 100 {
      break scan(acc);
    }
    if i == 3 {
      continue scan(i + 1, acc + 1);
    }
    acc = acc + i;
    continue scan(i + 1, acc);
  };
  return total;
}

func branchy(n: i32) -> i32 {
  let total: i32 = loop scan(i: i32 = 0, acc: i32 = 0) while i < n {
    if i < 3 {
      acc = acc + i;
    } else {
      acc = acc + 10;
    }
    acc = acc + acc;
    continue scan(i + 1, acc);
  };
  return total;
}

func nested(n: i32) -> i32 {
  let total: i32 = loop scan(i: i32 = 0, acc: i32 = 0) while i < n {
    if i < n {
      if i == 2 {
        break scan(acc + 1);
      }
      acc = acc + 1;
    }
    continue scan(i + 1, acc);
  };
  return total;
}
