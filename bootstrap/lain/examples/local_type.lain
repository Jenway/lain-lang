struct Point {
  x: i32
  y: i32
}

// 局部变量的类型参与算子选择：`n` 是 u64，所以 `<` 查的是 u64 的算子表
// （无符号比较），不是拿 bool 的 op 表去查（那张表是空的，会报 6）。
func below() -> bool {
  let n: u64 = 1;
  return n < 8;
}

// 局部绑定也可以来自调用结果。
extern cell_get(p: addr) -> u64 = lain_meta_scratch_data;

func count(scratch: addr) -> bool {
  let n: u64 = cell_get(scratch + 512);
  let r: bool = n < 8;
  return r;
}
