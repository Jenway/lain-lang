// 层 0 端到端验收：用 lainir_* 重新发射一个完整单元。
//
// 目标文本是处理管线在 `bootstrap/lain/examples/locals.lain` 上产出的那一份
// （`build/after/locals.out`）：字段偏移过程、函数体内的两次栈上构造与一次直接
// 返回、顶层静态块加取址过程。这里逐条调层 0 的写出器，走的是与管线同一套 API；
// 产物必须逐字节相同，并且过 check_unit 的 parse + verify。
data f6_n_a ro { 80 97 105 114 95 95 97 95 111 102 102 115 101 116 }
data f6_n_b ro { 80 97 105 114 95 95 98 95 111 102 102 115 101 116 }
data f6_n_size ro { 80 97 105 114 95 95 115 105 122 101 }
data f6_n_mk ro { 109 107 }
data f6_n_mk2 ro { 109 107 50 }
data f6_n_two ro { 116 119 111 }
data f6_n_origin ro { 111 114 105 103 105 110 }
data f6_params_v ro { 37 118 58 32 35 98 105 116 115 60 51 50 62 }
data f6_text_v ro { 37 118 }
data f6_text_r1 ro { 37 114 49 }
data f6_text_r2 ro { 37 114 50 }
data f6_text_r3 ro { 37 114 51 }
data f6_text_r4 ro { 37 114 52 }
data f6_text_p ro { 37 112 }
data f6_text_r ro { 37 114 }
data f6_text_s ro { 37 115 }
data f6_text_base ro { 37 98 97 115 101 }
data f6_zero ro { 48 }
#proc f6_probe(%index: #bits<64>) -> #bits<32> {
  %reset = #call lainir_reset()
  %buf = #data_addr lainir_text_buffer
  %lbuf = #lea(%buf, 64, 1, 0)
  %zero = #data_addr f6_zero
  %tv = #data_addr f6_text_v
  // ---- 字段偏移与大小：三个只发一条 #return 的过程 ----
  %na = #data_addr f6_n_a
  %h1 = #call lainir_proc_head_full(%na, 14, %zero, 0, 0, 64)
  %o1 = #call lainir_open_body()
  %r1 = #call lainir_return_uint(0)
  %e1 = #call lainir_close_body()
  %nb = #data_addr f6_n_b
  %h2 = #call lainir_proc_head_full(%nb, 14, %zero, 0, 0, 64)
  %o2 = #call lainir_open_body()
  %r2 = #call lainir_return_uint(4)
  %e2 = #call lainir_close_body()
  %ns = #data_addr f6_n_size
  %h3 = #call lainir_proc_head_full(%ns, 10, %zero, 0, 0, 64)
  %o3 = #call lainir_open_body()
  %r3 = #call lainir_return_uint(8)
  %e3 = #call lainir_close_body()
  // ---- mk：栈上构造，绑到一个名字，再 #return 那个名字 ----
  %t1 = #data_addr f6_text_r1
  %name_mk = #data_addr f6_n_mk
  %params_v = #data_addr f6_params_v
  %h4 = #call lainir_proc_head_full(%name_mk, 2, %params_v, 13, 3, 0)
  %o4 = #call lainir_open_body()
  %a1 = #call lainir_alloca_at(1, 8, 8)
  %v1 = #call lainir_buf_bytes(%buf, 0, %tv, 2)
  %d1 = #call lainir_text_lea_field(%lbuf, 0, %t1, 3, 0)
  %s1 = #call lainir_store(0, 32, %buf, %v1, %lbuf, %d1)
  %v2 = #call lainir_buf_uint(%buf, 0, 3)
  %d2 = #call lainir_text_lea_field(%lbuf, 0, %t1, 3, 4)
  %s2 = #call lainir_store(0, 32, %buf, %v2, %lbuf, %d2)
  %tp = #data_addr f6_text_p
  %l1 = #call lainir_lea_named(%tp, 2, %t1, 3, %zero, 1, 1, 0)
  %r4 = #call lainir_return_ref(%tp, 2)
  %e4 = #call lainir_close_brace_write()
  // ---- mk2：直接返回构造，不起名字 ----
  %t2 = #data_addr f6_text_r2
  %name_mk2 = #data_addr f6_n_mk2
  %h5 = #call lainir_proc_head_full(%name_mk2, 3, %params_v, 13, 3, 0)
  %o5 = #call lainir_open_body()
  %a2 = #call lainir_alloca_at(2, 8, 8)
  %v3 = #call lainir_buf_bytes(%buf, 0, %tv, 2)
  %d3 = #call lainir_text_lea_field(%lbuf, 0, %t2, 3, 0)
  %s3 = #call lainir_store(0, 32, %buf, %v3, %lbuf, %d3)
  %v4 = #call lainir_buf_bytes(%buf, 0, %tv, 2)
  %d4 = #call lainir_text_lea_field(%lbuf, 0, %t2, 3, 4)
  %s4 = #call lainir_store(0, 32, %buf, %v4, %lbuf, %d4)
  %r5 = #call lainir_return_ref(%t2, 3)
  %e5 = #call lainir_close_brace_write()
  // ---- two：同一个过程里两处构造，两个临时值编号 ----
  %t3 = #data_addr f6_text_r3
  %t4 = #data_addr f6_text_r4
  %name_two = #data_addr f6_n_two
  %h6 = #call lainir_proc_head_full(%name_two, 3, %params_v, 13, 3, 0)
  %o6 = #call lainir_open_body()
  %a3 = #call lainir_alloca_at(3, 8, 8)
  %v5 = #call lainir_buf_bytes(%buf, 0, %tv, 2)
  %d5 = #call lainir_text_lea_field(%lbuf, 0, %t3, 3, 0)
  %s5 = #call lainir_store(0, 32, %buf, %v5, %lbuf, %d5)
  %v6 = #call lainir_buf_uint(%buf, 0, 0)
  %d6 = #call lainir_text_lea_field(%lbuf, 0, %t3, 3, 4)
  %s6 = #call lainir_store(0, 32, %buf, %v6, %lbuf, %d6)
  %tr = #data_addr f6_text_r
  %l2 = #call lainir_lea_named(%tr, 2, %t3, 3, %zero, 1, 1, 0)
  %a4 = #call lainir_alloca_at(4, 8, 8)
  %v7 = #call lainir_buf_bytes(%buf, 0, %tv, 2)
  %d7 = #call lainir_text_lea_field(%lbuf, 0, %t4, 3, 0)
  %s7 = #call lainir_store(0, 32, %buf, %v7, %lbuf, %d7)
  %v8 = #call lainir_buf_uint(%buf, 0, 1)
  %d8 = #call lainir_text_lea_field(%lbuf, 0, %t4, 3, 4)
  %s8 = #call lainir_store(0, 32, %buf, %v8, %lbuf, %d8)
  %ts = #data_addr f6_text_s
  %l3 = #call lainir_lea_named(%ts, 2, %t4, 3, %zero, 1, 1, 0)
  %r6 = #call lainir_return_ref(%ts, 2)
  %e6 = #call lainir_close_brace_write()
  // ---- 顶层静态块与取址过程 ----
  %name_origin = #data_addr f6_n_origin
  %dh = #call lainir_data_head()
  %dn = #call lainir_write(%name_origin, 6)
  %rw = #call lainir_data_rw_head()
  %z1 = #call lainir_zero_text()
  %z2 = #call lainir_zero_text()
  %z3 = #call lainir_zero_text()
  %z4 = #call lainir_zero_text()
  %z5 = #call lainir_zero_text()
  %z6 = #call lainir_zero_text()
  %z7 = #call lainir_zero_text()
  %z8 = #call lainir_zero_text()
  %po = #call lainir_proc_head_open()
  %pn = #call lainir_write(%name_origin, 6)
  %ab = #call lainir_addr_body_write()
  %ba = #call lainir_base_assign_write()
  %bn = #call lainir_write(%name_origin, 6)
  %ss = #call lainir_storage_suffix_write()
  %tb = #data_addr f6_text_base
  %g1 = #call lainir_buf_uint(%buf, 0, 1)
  %k1 = #call lainir_text_lea_field(%lbuf, 0, %tb, 5, 0)
  %q1 = #call lainir_store(0, 32, %buf, %g1, %lbuf, %k1)
  %g2 = #call lainir_buf_uint(%buf, 0, 2)
  %k2 = #call lainir_text_lea_field(%lbuf, 0, %tb, 5, 4)
  %q2 = #call lainir_store(0, 32, %buf, %g2, %lbuf, %k2)
  %rc = #call lainir_return_base_close()
  #return %rc
}
