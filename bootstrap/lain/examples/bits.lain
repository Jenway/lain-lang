func band(a: i32, b: i32) -> i32 { return a and b; }
func bor(a: i32, b: i32) -> i32 { return a or b; }
func bshl(a: i32, b: i32) -> i32 { return a << b; }
func bshr(a: i32, b: i32) -> i32 { return a >> b; }
func uband(a: u32, b: u32) -> u32 { return a and b; }
func ubor(a: u32, b: u32) -> u32 { return a or b; }
func ubshl(a: u32, b: u32) -> u32 { return a << b; }
func ubshr(a: u32, b: u32) -> u32 { return a >> b; }
