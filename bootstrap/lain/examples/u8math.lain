// u8 算术与比较：验证 8-bit 同宽运算/比较能编译到合法 LAINIR。
func eq8(a: u8, b: u8) -> bool {
  return a == b;
}
func ne8(a: u8, b: u8) -> bool {
  return a != b;
}
func lt8(a: u8, b: u8) -> bool {
  return a < b;
}
func le8(a: u8, b: u8) -> bool {
  return a <= b;
}
func gt8(a: u8, b: u8) -> bool {
  return a > b;
}
func ge8(a: u8, b: u8) -> bool {
  return a >= b;
}
func add8(a: u8, b: u8) -> u8 {
  return a + b;
}
func sub8(a: u8, b: u8) -> u8 {
  return a - b;
}
func and8(a: u8, b: u8) -> u8 {
  return a & b;
}
func shr8(a: u8, b: u8) -> u8 {
  return a >> b;
}
