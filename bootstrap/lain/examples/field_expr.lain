struct Point {
  x: i32
  y: i32
}

func add(a: i32, b: i32) -> i32 {
  return a + b;
}

// 读一个字段：聚合是参数，地址由调用方给。
func x_of(p: Point) -> i32 {
  return p.x;
}

// 字段值是表达式：store 的值是那条算子的结果。
func shift(p: i32, q: i32) -> i32 {
  let r: Point = Point { x: p + 1 y: q };
  return x_of(r);
}

// 逗号分隔也认，两个字段都是表达式。
func scale(a: i32) -> i32 {
  let s: Point = Point { x: a * 2, y: add(a, 1) };
  return x_of(s);
}

// 顶层静态构造同样吃字面量表达式。
let origin = Point { x: 1 + 2 y: 3 * 4 };
