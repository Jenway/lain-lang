struct Point {
  x: i32
  y: i32
}

func add(a: i32, b: i32) -> i32 {
  return a + b;
}

// 字段值是表达式：store 的值是那条算子的结果。
func shift(p: i32, q: i32) -> Point {
  let r: Point = Point { x: p + 1 y: q };
  return r;
}

// 逗号分隔也认，两个字段都是表达式。
func scale(a: i32) -> Point {
  return Point { x: a * 2, y: add(a, 1) };
}

// 顶层静态构造同样吃字面量表达式。
let origin = Point { x: 1 + 2 y: 3 * 4 };
