func pack(p: addr) -> u64 {
  return p as u64;
}

func unpack(w: u64) -> addr {
  return w as addr;
}

func element(p: addr, i: u64) -> u64 {
  let q: addr = p + i * 8;
  let w: u64 = load(q);
  return w;
}

func byte_at(p: addr, i: u64) -> u8 {
  let b: u8 = load(p + i * 1);
  return b;
}

func round(p: addr) -> addr {
  return (p as u64) as addr;
}

func scaled(p: addr, i: u64) -> u64 {
  let q: addr = p + i * 8;
  store(q, 7);
  let r: addr = p + i * 8;
  return load(r);
}
