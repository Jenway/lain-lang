data f2_proc_name ro { 112 114 111 98 101 }
data f2_params ro { 37 108 104 115 58 32 35 98 105 116 115 60 51 50 62 44 32 37 114 104 115 58 32 35 98 105 116 115 60 51 50 62 44 32 37 118 97 108 117 101 58 32 35 98 105 116 115 60 54 52 62 44 32 37 112 116 114 58 32 35 97 100 100 114 }
#proc f2_probe(%index: #bits<64>) -> #bits<32> {
  %reset = #call lainir_reset()
  %name = #data_addr f2_proc_name
  %params = #data_addr f2_params
  %begin = #call lainir_proc_begin_typed(%name, 5, %params, 64)
  %lhs = #data_addr f2_lhs
  %rhs = #data_addr f2_rhs
  %ptr = #data_addr f2_lhs
  %value = #data_addr f2_value
  %r_add = #call lainir_add(32, %lhs, 4, %rhs, 4)
  %r_sub = #call lainir_sub(32, %lhs, 4, %rhs, 4)
  %r_mul = #call lainir_mul(32, %lhs, 4, %rhs, 4)
  %r_sdiv = #call lainir_sdiv(32, %lhs, 4, %rhs, 4)
  %r_udiv = #call lainir_udiv(32, %lhs, 4, %rhs, 4)
  %r_srem = #call lainir_srem(32, %lhs, 4, %rhs, 4)
  %r_urem = #call lainir_urem(32, %lhs, 4, %rhs, 4)
  %r_and = #call lainir_and(32, %lhs, 4, %rhs, 4)
  %r_or = #call lainir_or(32, %lhs, 4, %rhs, 4)
  %r_xor = #call lainir_xor(32, %lhs, 4, %rhs, 4)
  %r_shl = #call lainir_shl(32, %lhs, 4, %rhs, 4)
  %r_lshr = #call lainir_lshr(32, %lhs, 4, %rhs, 4)
  %r_ashr = #call lainir_ashr(32, %lhs, 4, %rhs, 4)
  %r_eq = #call lainir_eq(32, %lhs, 4, %rhs, 4)
  %r_ne = #call lainir_ne(32, %lhs, 4, %rhs, 4)
  %r_slt = #call lainir_slt(32, %lhs, 4, %rhs, 4)
  %r_sle = #call lainir_sle(32, %lhs, 4, %rhs, 4)
  %r_sgt = #call lainir_sgt(32, %lhs, 4, %rhs, 4)
  %r_sge = #call lainir_sge(32, %lhs, 4, %rhs, 4)
  %r_ult = #call lainir_ult(32, %lhs, 4, %rhs, 4)
  %r_ule = #call lainir_ule(32, %lhs, 4, %rhs, 4)
  %r_ugt = #call lainir_ugt(32, %lhs, 4, %rhs, 4)
  %r_uge = #call lainir_uge(32, %lhs, 4, %rhs, 4)
  %r_zext = #call lainir_zext(64, %value, 6)
  %r_sext = #call lainir_sext(64, %value, 6)
  %r_trunc = #call lainir_trunc(64, %value, 6)
  %r_bitcast = #call lainir_bitcast(64, %value, 6)
  %ptr_text = #data_addr f2_ptr_text
  %r_ptr2int = #call lainir_ptr2int(64, %value, %ptr_text, 4)
  %r_int2ptr = #call lainir_int2ptr(%value, 6)
  %ret = #call lainir_return(0)
  %end = #call lainir_proc_end()
  #return %end
}
