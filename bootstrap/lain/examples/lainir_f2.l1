data f2_ule_name ro { 117 108 101 }
data f2_ugt_name ro { 117 103 116 }
data f2_uge_name ro { 117 103 101 }
data f2_lhs ro { 37 108 104 115 }
data f2_rhs ro { 37 114 104 115 }
data f2_value ro { 37 118 97 108 117 101 }
