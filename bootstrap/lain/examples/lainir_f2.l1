data f2_sub_name ro { 115 117 98 }
data f2_mul_name ro { 109 117 108 }
data f2_sdiv_name ro { 115 100 105 118 }
data f2_udiv_name ro { 117 100 105 118 }
data f2_srem_name ro { 115 114 101 109 }
data f2_urem_name ro { 117 114 101 109 }
data f2_and_name ro { 97 110 100 }
data f2_or_name ro { 111 114 }
data f2_xor_name ro { 120 111 114 }
data f2_shl_name ro { 115 104 108 }
data f2_lshr_name ro { 108 115 104 114 }
data f2_ashr_name ro { 97 115 104 114 }
