// Meta v0 —— 语言定义层，手写 LAINIR。
//
// 它是「编译器的哪一部分必须能用 Lain 重写」这条边界的第一个落点：
// 它读源码字节，按语言规则决定含义，产出 canonical LAINIR 文本，
// 交给驱动去 parse + verify + 执行。它不认识任何物理算子，
// 底座也不认识任何 Lain 概念。
//
// v0 认的顶层形式：`let` / `struct` / `enum` / `func` / `scalar`（只在模块里有效）
// / `import(...)`。分派按**形状**走（`meta_lower_form` 问的是「这个节点是不是内容
// 为 struct 的词」），不按字节搜关键字。语言面的清单见 README「v0 的语言」。
//
// 三个入口对应三个标准阶段。v0 里 expand 是恒等（还没有宏），
// elaborate 与 lower 合成一条直线——等形状长出来再拆。

#proc lain_std_abi_version() -> #bits<64> {
  #return 1
}

#proc lain_std_initialize(%host: #addr) -> #bits<32> {
  #return 0
}

// 产出：把 source 那份源码 lowering 成 LAINIR 文本，写进宿主的输出缓冲。
// 返回 0 = 成功。
#proc lain_std_lower(%host: #addr, %source: #bits<64>) -> #bits<32> {
  %reset = #call lain_meta_emit_reset(%host)
  // 作用域表要先建：外层是 root 环境，内层是这份源码。名字按表查，
  // 不再回源码搜字节。
  %setup = #call meta_scope_setup(%host)
  %ok = #eq[#bits<32>](%setup, 0)
  %status = #if %ok -> (#bits<32>) {
    %len = #call lain_meta_source_length(%host, %source)
    %base = #call lain_meta_source_data(%host, %source)
    %mark = #call meta_scope_count(%host)
    %cur = #call meta_scope_set_current(%host, %source)
    %scan = #call meta_scope_scan(%host, %base, %len, %source, %mark)
    %b2 = #eq[#bits<32>](%scan, 0)
    %s = #if %b2 -> (#bits<32>) {
      // 语法树在 meta_scope_setup 里已经把每份源码都读好了。
      %r = #call meta_lower_source(%host, %source)
      #yield %r
    } else {
      #yield %scan
    }
    #yield %s
  } else {
    #yield %setup
  }
  #return %status
}

// 一条一条走顶层形式。**形式从语法树上走**——「一条形式从哪到哪」由节点给出，
// 不再靠「从某个位置起找下一处长得像关键字的地方」。
#proc meta_lower_source(%host: #addr, %source: #bits<64>) -> #bits<32> {
  %len = #call lain_meta_source_length(%host, %source)
  %base = #call lain_meta_source_data(%host, %source)
  %root = #call meta_root_of(%host, %source)
  %first = #call meta_node_child(%host, %root)
  %skw = #data_addr meta_kw_scalar
  %kw = #data_addr meta_kw_struct
  %ekw = #data_addr meta_kw_enum
  %lkw = #data_addr meta_kw_let
  %status = #loop forms(%node: #bits<64> = %first) -> (#bits<32>) {
    %more = #ne[#bits<64>](%node, 0xFFFFFFFFFFFFFFFF)
    #if %more {
      %here = #call meta_node_start(%host, %node)
      %is_struct = #call meta_node_is_word(%host, %node, %base, %kw, 6)
      %is_enum = #call meta_node_is_word(%host, %node, %base, %ekw, 4)
      %is_scalar = #call meta_node_is_word(%host, %node, %base, %skw, 6)
      %is_let = #call meta_node_is_word(%host, %node, %base, %lkw, 3)
      %fkw = #data_addr meta_kw_func
      %is_func = #call meta_node_is_word(%host, %node, %base, %fkw, 4)
      %h1 = #or[#bits<1>](%is_struct, %is_enum)
      %h2 = #or[#bits<1>](%is_scalar, %is_let)
      %h3 = #or[#bits<1>](%h1, %h2)
      %any = #or[#bits<1>](%h3, %is_func)
      %s = #if %any -> (#bits<32>) {
        %d = #call meta_lower_form(%host, %base, %len, %here, %node, %is_struct,
                                    %is_enum, %is_scalar, %is_let, %is_func)
        #yield %d
      } else {
        // **顶层树的孩子是词，不是形式**——一条形式跨好几个孩子（`struct`
        // `Pair` `{...}`）。所以跳过一条形式内部那些非关键字的词是正常的；
        // 但**整份文件的第一个孩子必须是能被认出的形式**，否则就是坏输入。
        %is_first = #eq[#bits<64>](%node, %first)
        %x = #if %is_first -> (#bits<32>) {
          %f = #call lain_meta_fail(%host, 4)
          #yield 4
        } else {
          #yield 0
        }
        #yield %x
      }
      %bad = #ne[#bits<32>](%s, 0)
      #if %bad {
        #break forms(%s)
      }
      %next = #call meta_node_next(%host, %node)
      #continue forms(%next)
    } else {
      #break forms(0)
    }
  }
  #return %status
}

// 一条顶层形式：关键字已经认出来了，按它分派。
#proc meta_lower_form(%host: #addr, %base: #addr, %len: #bits<64>,
                       %here: #bits<64>, %node: #bits<64>, %is_struct: #bits<1>,
                       %is_enum: #bits<1>, %is_scalar: #bits<1>,
                       %is_let: #bits<1>, %is_func: #bits<1>) -> #bits<32> {
  %s = #if %is_struct -> (#bits<32>) {
    %r1 = #call meta_lower_struct(%host, %base, %len, %here)
    #yield %r1
  } else {
    %r2 = #if %is_enum -> (#bits<32>) {
      %r4 = #call meta_lower_enum(%host, %base, %len, %here)
      #yield %r4
    } else {
      %r3 = #if %is_func -> (#bits<32>) {
        %r7 = #call meta_lower_func(%host, %base, %len, %node)
        #yield %r7
      } else {
        %r5 = #if %is_scalar -> (#bits<32>) {
          // 标量声明只在**模块**里有效（prelude / 被 import 的源码）。
          // 被降级的那份源码自己写 `scalar` 会静默变成不可见，所以直接拒。
          %f2 = #call lain_meta_fail(%host, 14)
          #yield 14
        } else {
          %r6 = #if %is_let -> (#bits<32>) {
            %r8 = #call meta_lower_let(%host, %base, %len, %here)
            #yield %r8
          } else {
            %f = #call lain_meta_fail(%host, 4)
            #yield 4
          }
          #yield %r6
        }
        #yield %r5
      }
      #yield %r3
    }
    #yield %r2
  }
  #return %s
}

// --- 积类型 ---------------------------------------------------------------
//
// `struct Rec { f: T ... }` 只产出两个东西：每个字段的字节偏移，和总大小。
// 偏移是**算出来的**（逐个 align_up 累加），不是查表查来的——这正是积类型
// 和标量的区别所在。
//
// v0 假设输入是良构的：字段名后面一定有 `:` 和类型名。写坏了会产出错的
// 偏移，而产物过不了验证——失败是响的，只是诊断不好看。

#proc meta_lower_struct(%host: #addr, %base: #addr, %len: #bits<64>,
                        %kw_at: #bits<64>) -> #bits<32> {
  %after = #add[#bits<64>](%kw_at, 6)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %has_name = #ult[#bits<64>](%name_lo, %name_hi)
  %status = #if %has_name -> (#bits<32>) {
    %brace = #call bs_skip_space(%base, %name_hi, %len)
    %is_open = #call bs_is_byte(%base, %brace, 123)
    %inner = #if %is_open -> (#bits<32>) {
      %body = #add[#bits<64>](%brace, 1)
      %size = #call meta_struct_fields(%host, %base, %len, %name_lo, %name_hi,
                                       %body, 0, 1)
      %w = #call meta_emit_size(%host, %base, %name_lo, %name_hi, %size)
      %ok = #eq[#bits<64>](%size, 0xFFFFFFFFFFFFFFFF)
      %s = #if %ok -> (#bits<32>) {
        %f2 = #call lain_meta_fail(%host, 7)
        #yield 7
      } else {
        #yield 0
      }
      #yield %s
    } else {
      %f = #call lain_meta_fail(%host, 4)
      #yield 4
    }
    #yield %inner
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

// 走字段列表，每个字段发一个 offset 过程。返回总大小；出错返回 NOT_FOUND。
// 循环携带 (下一个位置, 当前偏移, 当前最大对齐)。
#proc meta_struct_fields(%host: #addr, %base: #addr, %len: #bits<64>,
                        %rec_lo: #bits<64>, %rec_hi: #bits<64>,
                        %at: #bits<64>, %off: #bits<64>,
                        %max_align: #bits<64>) -> #bits<64> {
  %size = #loop fields(%at: #bits<64> = %at, %off: #bits<64> = %off,
                       %al: #bits<64> = %max_align) -> (#bits<64>) {
    %here = #call bs_skip_space(%base, %at, %len)
    %byte = #call bs_byte_at(%base, %here, %len)
    %is_close = #eq[#bits<8>](%byte, 125)
    #if %is_close {
      %rounded = #call bs_align_up(%off, %al)
      #break fields(%rounded)
    }
    // 字段名 : 类型名
    %f_hi = #call bs_skip_ident(%base, %here, %len)
    %colon = #call bs_skip_space(%base, %f_hi, %len)
    %one = #add[#bits<64>](%colon, 1)
    %t_lo = #call bs_skip_space(%base, %one, %len)
    %t_hi = #call bs_skip_qualified(%base, %t_lo, %len)
    // 查字段类型（root 环境或命名空间成员）——拿到的是类型 id
    %tid = #call meta_type_resolve(%host, %base, %len, %t_lo, %t_hi)
    %bad_type = #eq[#bits<64>](%tid, 0)
    #if %bad_type {
      %f3 = #call lain_meta_fail(%host, 5)
      #return 5
    }
    %tinfo = #call meta_tid_repr(%host, %tid)
    %kind = #and[#bits<64>](%tinfo, 255)
    %width = #and[#bits<64>](#lshr[#bits<64>](%tinfo, 8), 255)
    %fsize = #call meta_tid_size(%host, %tid)
    %falign = #call meta_tid_align(%host, %tid)
    %aligned = #call bs_align_up(%off, %falign)
    %emit = #call meta_emit_field_offset(%host, %base, %len, %rec_lo, %rec_hi,
                                         %here, %f_hi, %aligned)
    %next_off = #add[#bits<64>](%aligned, %fsize)
    %bigger = #ugt[#bits<64>](%falign, %al)
    %new_al = #if %bigger -> (#bits<64>) {
      #yield %falign
    } else {
      #yield %al
    }
    #continue fields(%t_hi, %next_off, %new_al)
  }
  #return %size
}

// 发一个 `<Rec>__<field>_offset() -> #bits<64> { #return <offset> }`。
#proc meta_emit_field_offset(%host: #addr, %base: #addr, %len: #bits<64>,
                            %rec_lo: #bits<64>, %rec_hi: #bits<64>,
                            %f_lo: #bits<64>, %f_hi: #bits<64>,
                            %value: #bits<64>) -> #bits<32> {
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %rec_at = #lea(%base, %rec_lo, 1, 0)
  %rec_len = #sub[#bits<64>](%rec_hi, %rec_lo)
  %w2 = #call lain_meta_emit_write(%host, %rec_at, %rec_len)
  %d = #data_addr meta_dsep
  %w3 = #call lain_meta_emit_write(%host, %d, 2)
  %f_at = #lea(%base, %f_lo, 1, 0)
  %f_len = #sub[#bits<64>](%f_hi, %f_lo)
  %w4 = #call lain_meta_emit_write(%host, %f_at, %f_len)
  %suf = #data_addr meta_foff
  %w5 = #call lain_meta_emit_write(%host, %suf, 7)
  %p2a = #data_addr meta_p2a
  %w6 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w7 = #call meta_emit_repr(%host, 0, 64)
  %p2b = #data_addr meta_p2b
  %w8 = #call lain_meta_emit_write(%host, %p2b, 13)
  %w9 = #call meta_emit_uint(%host, %value)
  %p3 = #data_addr meta_p3
  %w10 = #call lain_meta_emit_write(%host, %p3, 3)
  #return 0
}

// 发一个 `<Rec>__size() -> #bits<64> { #return <size> }`。
#proc meta_emit_size(%host: #addr, %base: #addr, %rec_lo: #bits<64>,
                    %rec_hi: #bits<64>, %value: #bits<64>) -> #bits<32> {
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %rec_at = #lea(%base, %rec_lo, 1, 0)
  %rec_len = #sub[#bits<64>](%rec_hi, %rec_lo)
  %w2 = #call lain_meta_emit_write(%host, %rec_at, %rec_len)
  %suf = #data_addr meta_rsize
  %w3 = #call lain_meta_emit_write(%host, %suf, 6)
  %p2a = #data_addr meta_p2a
  %w4 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w5 = #call meta_emit_repr(%host, 0, 64)
  %p2b = #data_addr meta_p2b
  %w6 = #call lain_meta_emit_write(%host, %p2b, 13)
  %w7 = #call meta_emit_uint(%host, %value)
  %p3 = #data_addr meta_p3
  %w8 = #call lain_meta_emit_write(%host, %p3, 3)
  #return 0
}

#proc meta_lower_let(%host: #addr, %base: #addr, %len: #bits<64>, %let_at: #bits<64>) -> #bits<32> {
  %after = #add[#bits<64>](%let_at, 3)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %has_name = #ult[#bits<64>](%name_lo, %name_hi)
  %status = #if %has_name -> (#bits<32>) {
    %s = #call meta_lower_binding(%host, %base, %len, %name_lo, %name_hi)
    #yield %s
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

// NAME [: TYPE] = INT
// NAME = import("逻辑路径") 是一种**不产出 LAINIR** 的绑定：它是编译期的
// 命名空间绑定，用到时再回源码里找回来。所以它在类型标注之前分叉。
#proc meta_lower_binding(%host: #addr, %base: #addr, %len: #bits<64>,
                         %name_lo: #bits<64>, %name_hi: #bits<64>) -> #bits<32> {
  %at = #call bs_skip_space(%base, %name_hi, %len)
  %is_eq = #call bs_is_byte(%base, %at, 61)
  %is_import = #if %is_eq -> (#bits<1>) {
    %one = #add[#bits<64>](%at, 1)
    %kw_at = #call bs_skip_space(%base, %one, %len)
    %kw = #data_addr meta_kw_import
    %k = #call bs_match_keyword(%base, %kw_at, %len, %kw, 6)
    #yield %k
  } else {
    #yield 0
  }
  %status = #if %is_import -> (#bits<32>) {
    %s0 = #call meta_lower_import(%host, %base, %len, %at)
    #yield %s0
  } else {
    %is_colon = #call bs_is_byte(%base, %at, 58)
    %s1 = #if %is_colon -> (#bits<32>) {
      %after = #add[#bits<64>](%at, 1)
      %t_lo = #call bs_skip_space(%base, %after, %len)
      // 类型名可能是限定名（`W.w32`），所以不是 bs_skip_ident
      %t_hi = #call bs_skip_qualified(%base, %t_lo, %len)
      %s = #call meta_lower_typed(%host, %base, %len, %name_lo, %name_hi, %t_lo,
                                  %t_hi)
      #yield %s
    } else {
      %s = #call meta_lower_typed(%host, %base, %len, %name_lo, %name_hi, 0, 0)
      #yield %s
    }
    #yield %s1
  }
  #return %status
}

// 解析类型名拿到 repr，再 `= INT`，最后把整条绑定写出去。
#proc meta_lower_typed(%host: #addr, %base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<32> {
  %has_type = #ult[#bits<64>](%t_lo, %t_hi)

  // 类型名 → 注册表里的**类型 id**。没有标注时给合成的 `#bits<64>`（owner 0）。
  %resolved = #if %has_type -> (#bits<64>) {
    %e = #call meta_type_resolve(%host, %base, %len, %t_lo, %t_hi)
    #yield %e
  } else {
    %d = #call meta_intern(%host, 1, 0, 0, 0, 64)
    #yield %d
  }
  %unknown = #eq[#bits<64>](%resolved, 0)
  #if %unknown {
    %f0 = #call lain_meta_fail(%host, 5)
    #return 5
  }

  // repr 从注册表里读——它是身份的**后果**，不是身份本身
  %info = #call meta_tid_repr(%host, %resolved)
  %kind = #and[#bits<64>](%info, 255)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)

  // 从类型名之后接着解析；没有标注就从名字之后
  %resume = #if %has_type -> (#bits<64>) {
    #yield %t_hi
  } else {
    #yield %name_hi
  }
  %eq_at = #call bs_skip_space(%base, %resume, %len)
  %is_eq = #call bs_is_byte(%base, %eq_at, 61)
  %status = #if %is_eq -> (#bits<32>) {
    %after_eq = #add[#bits<64>](%eq_at, 1)
    %lhs_lo = #call bs_skip_space(%base, %after_eq, %len)
    // 值的第一个 token 的终点。`bs_skip_ident` 对 `(` 这类开头**不前进** —— 那样
    // `(1 + 2) + 3` 会被当成「`=` 后面没有值」报 3。括号开头的值第一个节点是那个组，
    // 终点由树给，所以这里只要保证 `lhs_hi > lhs_lo` 就行。
    %lhs_id = #call bs_skip_ident(%base, %lhs_lo, %len)
    %lhs_adv = #ult[#bits<64>](%lhs_lo, %lhs_id)
    %lhs_hi = #if %lhs_adv -> (#bits<64>) {
      #yield %lhs_id
    } else {
      %one = #add[#bits<64>](%lhs_lo, 1)
      #yield %one
    }
    // 「有没有值」看的是 `=` 后面还有没有字节，不是识不识别得出标识符。
    %has_lhs = #ult[#bits<64>](%lhs_lo, %len)
    %inner = #if %has_lhs -> (#bits<32>) {
      %s = #call meta_emit_value(%host, %base, %len, %name_lo, %name_hi, %kind,
                                 %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
      #yield %s
    } else {
      %f = #call lain_meta_fail(%host, 3)
      #yield 3
    }
    #yield %inner
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

// 右值：一个整数，或者 `整数 OP 整数`。
// 后者拿符号去**类型的 op 表**里查该发哪条物理算子——Meta 不知道
// "div" 对有符号和无符号是不同的。
#proc meta_emit_value(%host: #addr, %base: #addr, %len: #bits<64>,
                      %name_lo: #bits<64>, %name_hi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                      %t_hi: #bits<64>, %lhs_lo: #bits<64>,
                      %lhs_hi: #bits<64>) -> #bits<32> {
  // 形状**不问字节，问识别 pass 算好的那一格**。这里曾经看值的头一个字节判数字、
  // 又看第一个标识符之后的字节判 `{` / `.` / `(` —— 同一套形状规则在好几处各写一
  // 遍，改一处漏两处。现在只读 form（取值见 `std/recognize.l1`）。
  //
  // 「是一条表达式」有三条进路：
  //   形状 4（二元）   第一个操作数后面跟着算子
  //   形状 2（组）     第一个操作数是括号（`(1 + 2) + 3`）
  //   整段里有算子     第一个操作数是调用/字段/构造而后面还有算子（`f(1) + 2`）
  // 最后这条必须单独判：形状 5/6/10 说的是「这里开始一次调用/字段访问/构造」，**不是**
  // 「整个值就是它」。不判的话那三条发射器只发构造本身，后面跟的算子会被悄悄丢掉 ——
  // `let main: i32 = f(1) + 2;` 曾经发成 `#return #call f(1)`，验证通过，算出来 2
  // 而不是 4。
  %form = #call meta_form_at(%host, %base, %lhs_lo)
  %hasop = #call meta_value_has_op(%host, %base, %len, %lhs_lo)
  %f_bin = #eq[#bits<64>](%form, 4)
  %f_grp = #eq[#bits<64>](%form, 2)
  %f_const = #eq[#bits<64>](%form, 7)
  %e1 = #or[#bits<1>](%f_bin, %f_grp)
  %is_expr = #or[#bits<1>](%e1, %hasop)
  %status = #if %is_expr -> (#bits<32>) {
    %s = #call meta_emit_chain(%host, %base, %len, %name_lo, %name_hi, %kind,
                               %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
    #yield %s
  } else {
    %s_c0 = #if %f_const -> (#bits<32>) {
      %s0 = #call meta_emit_numeric(%host, %base, %len, %name_lo, %name_hi,
                                    %kind, %width, %t_lo, %t_hi, %lhs_lo,
                                    %lhs_hi)
      #yield %s0
    } else {
    // 标识符到哪结束仍然要算：下面的降级点按字节区间工作。那是**位置**，不是形状。
    %rec_hi = #call bs_skip_ident(%base, %lhs_lo, %len)
    %after = #call bs_skip_space(%base, %rec_hi, %len)
    %single = #eq[#bits<1>](%hasop, 0)
    %f_ctor0 = #eq[#bits<64>](%form, 10)
    %f_field0 = #eq[#bits<64>](%form, 6)
    %f_call0 = #eq[#bits<64>](%form, 5)
    // 三段值里还带算子 → 三个都是假 → 落到最里面那个 `lain_meta_fail(4)`
    %f_construct = #and[#bits<1>](%f_ctor0, %single)
    %f_field = #and[#bits<1>](%f_field0, %single)
    %f_call = #and[#bits<1>](%f_call0, %single)
    %s2 = #if %f_construct -> (#bits<32>) {
      // 构造：这个类型的正文从哪开始，**问符号表**，不回源码里找
      %tb = #call meta_scope_body(%host, %base, %lhs_lo, %rec_hi, 4)
      %r1 = #call meta_lower_construct(%host, %base, %len, %name_lo, %name_hi,
                                       %tb, %after)
      #yield %r1
    } else {
      %s3 = #if %f_field -> (#bits<32>) {
        %dot = #add[#bits<64>](%after, 1)
        %m_lo = #call bs_skip_space(%base, %dot, %len)
        %m_hi = #call bs_skip_ident(%base, %m_lo, %len)
        // `A.b` 里的 `A` 可能是三种东西，形状完全不同：
        //   import 绑定 → 跨模块取值（mangle 成扁平名 + #call）
        //   enum        → 变体构造／投影
        //   其余        → struct 字段访问
        %ns_at = #call meta_find_import_binding(%host, %base, %len, %lhs_lo, %rec_hi)
        %is_ns = #ne[#bits<64>](%ns_at, 0)
        %is_sum = #call meta_is_enum(%host, %base, %len, %lhs_lo, %rec_hi)
        // struct 字段访问要的正文起点，也问符号表
        %tb2 = #call meta_scope_body(%host, %base, %lhs_lo, %rec_hi, 4)
        %r2 = #if %is_ns -> (#bits<32>) {
          %r7 = #call meta_lower_ns_value(%host, %base, %len, %name_lo,
                                          %name_hi, %lhs_lo, %rec_hi, %m_lo,
                                          %m_hi, %kind, %width)
          #yield %r7
        } else {
          %r3 = #if %is_sum -> (#bits<32>) {
            %r5 = #call meta_lower_sum_access(%host, %base, %len, %name_lo,
                                              %name_hi, %lhs_lo, %rec_hi, %dot)
            #yield %r5
          } else {
            %r6 = #call meta_lower_field_access(%host, %base, %len, %name_lo,
                                                %name_hi, %tb2, %dot)
            #yield %r6
          }
          #yield %r3
        }
        #yield %r2
      } else {
        %s4 = #if %f_call -> (#bits<32>) {
          %r4 = #call meta_emit_call(%host, %base, %len, %name_lo, %name_hi,
                                     %kind, %width, %t_lo, %t_hi, %lhs_lo,
                                     %rec_hi, %after)
          #yield %r4
        } else {
          %f = #call lain_meta_fail(%host, 4)
          #yield 4
        }
        #yield %s4
      }
      #yield %s3
    }
    #yield %s2
    }
    #yield %s_c0
  }
  #return %status
}

// 这段字节**全是**十进制数字吗？`0x10` 不是：`bs_read_uint` 在 `x` 停下，
// 只读出 `0`，剩下的悄悄丢掉。
#proc meta_all_digits(%base: #addr, %lo: #bits<64>, %hi: #bits<64>,
                       %len: #bits<64>) -> #bits<1> {
  %r = #loop s(%i: #bits<64> = %lo) -> (#bits<1>) {
    %more = #ult[#bits<64>](%i, %hi)
    #if %more {
      %b = #call bs_byte_at(%base, %i, %len)
      %ok = #call bs_is_digit(%b)
      #if %ok {
        %n = #add[#bits<64>](%i, 1)
        #continue s(%n)
      }
      #break s(0)
    } else {
      #break s(1)
    }
  }
  #return %r
}

// 从 at 起跳过空白之后是不是 `;`？
#proc meta_at_semi(%base: #addr, %at: #bits<64>, %len: #bits<64>) -> #bits<1> {
  %p = #call bs_skip_space(%base, %at, %len)
  // 用 `bs_byte_at`（越界给 0）而不是 `bs_is_byte`：源码没有以 `;` 收尾时
  // `bs_skip_space` 会返回 `len`，而 `bs_is_byte` 在 `len` 处是**越界读**——
  // 那会被 VM 以 trap 1004 拒掉。响是响了，但那是崩溃，不是诊断。
  %b = #call bs_byte_at(%base, %p, %len)
  %r = #eq[#bits<8>](%b, 59)
  #return %r
}

// 数值右值：一个整数，或 `整数 OP 整数 [OP 整数 …]`。
//
// 分支点是**值后面第一个非空白字节**：
//
//   - 是算子 → 交给 `meta_emit_chain`，它自己把整条链吃到 `;` 为止；
//   - 不是算子 → 这段话到这里就该完了，于是要求它后面**紧跟 `;`**。
//
// 这些尾巴检查都是给"静默给错值"堵口：`0x10` 会被 `bs_read_uint` 读成 `0`
// 而把 `x10` 丢掉；`1 + 2 + 3` 曾被只发成 `#add(1,2)` 而把 `+ 3` 丢掉——
// 后者算出一个**错的但是合法的**结果。缺少检查，写错的东西会被当成对的算出
// 来。这正是文档里禁止的失败方式：失败要响，不能静默给错值。
#proc meta_emit_numeric(%host: #addr, %base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                       %t_hi: #bits<64>, %lhs_lo: #bits<64>,
                       %lhs_hi: #bits<64>) -> #bits<32> {
  // 是「一条表达式」还是「一个常量」，读识别 pass 算好的形状：
  //   形状 4（二元）    → 表达式，第一个操作数后面跟着算子
  //   形状 2（组）      → 表达式，第一个操作数是括号（`(1 + 2) + 3`）
  //   其余（形状 7 等） → 当常量走
  %form = #call meta_form_at(%host, %base, %lhs_lo)
  %f_bin = #eq[#bits<64>](%form, 4)
  %f_grp = #eq[#bits<64>](%form, 2)
  %is_expr = #or[#bits<1>](%f_bin, %f_grp)
  %status = #if %is_expr -> (#bits<32>) {
    // 整段交给表达式发射器。它自己走到 `;`，吃到不该有的东西就报错；调用方不再替它
    // 检查尾巴。
    %s = #call meta_emit_chain(%host, %base, %len, %name_lo, %name_hi, %kind,
                               %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
    #yield %s
  } else {
    %lhs_digits = #call meta_all_digits(%base, %lhs_lo, %lhs_hi, %len)
    %lhs_semi = #call meta_at_semi(%base, %lhs_hi, %len)
    %lhs_ok = #and[#bits<1>](%lhs_digits, %lhs_semi)
    %lhs_bad = #eq[#bits<1>](%lhs_ok, 0)
    #if %lhs_bad {
      %ft2 = #call lain_meta_fail(%host, 4)
      #return 4
    }
    %s = #call meta_emit_let(%host, %base, %len, %name_lo, %name_hi, %kind,
                             %width, %lhs_lo)
    #yield %s
  }
  #return %status
}

// `let a = f(3, 4);` —— 直接把已声明过程的结果当成这条绑定的值。
//
// 实参从**树上**那个组节点的孩子链上取（`meta_emit_args`），不按字节扫。
//
// 这里原来是从 `(` 后面一路扫到**第一个** `)` 然后照抄字节。那样有两处坏：
// `f((1))` 会在里层那个 `)` 上停住，发出 `#call f((1)`（少一个括号，驱动重解析时才
// 炸）；`f(1 + 2)` 会照抄出 `#call f(1 + 2)` —— **LAINIR 的实参不能是任意表达式**，
// 只能是操作数或嵌套的 `#call`，所以那条也过不去。
//
// 现在实参走 `meta_emit_args`：一个 token 一个实参，数字照发、名字加 `%`，实参里出现
// 组或算子就报 4。**报出来比发一段坏的强** —— 静默发坏正是这个仓库明文禁止的失败方式。
#proc meta_emit_call(%host: #addr, %base: #addr, %len: #bits<64>,
                     %name_lo: #bits<64>, %name_hi: #bits<64>,
                     %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                     %t_hi: #bits<64>,
                     %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                     %at: #bits<64>) -> #bits<32> {
  // 顺序很要紧：`#proc NAME() -> repr {\n` 这个**头**先写，然后才降级实参（实参里的
  // 子表达式要发指令，那些指令得落在过程体**里面**），最后写 `  #return #call f(实参)`。
  // 反过来（先降级实参）子指令会跑到 `#proc` 前面去。
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lain_meta_emit_write(%host, %name_at, %name_len)
  %p2a = #data_addr meta_p2a
  %w3 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w4 = #call meta_emit_repr(%host, %kind, %width)
  %open = #data_addr meta_fn_open
  %w5 = #call lain_meta_emit_write(%host, %open, 3)
  // 头写完了，现在降级实参
  %cnode = #call meta_node_at(%host, %base, %callee_lo)
  %grp = #call meta_node_next(%host, %cnode)
  %ast = #call meta_args_prepare(%host, %base, %len, %kind, %width, %t_lo,
                                 %t_hi, %grp)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  // `  #return #call <callee>(`
  %x1 = #data_addr meta_st_retcall
  %w6 = #call lain_meta_emit_write(%host, %x1, 16)
  %callee_at = #lea(%base, %callee_lo, 1, 0)
  %callee_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %w7 = #call lain_meta_emit_write(%host, %callee_at, %callee_len)
  %lp = #data_addr meta_fn_lparen
  %w8 = #call lain_meta_emit_write(%host, %lp, 1)
  %wst = #call meta_args_write(%host, %base, %len)
  %wbad = #ne[#bits<32>](%wst, 0)
  #if %wbad {
    #return %wst
  }
  %rp = #data_addr meta_call_rparen
  %w9 = #call lain_meta_emit_write(%host, %rp, 4)
  #return 0
}

// 把这条绑定写成 LAINIR。
#proc meta_emit_let(%host: #addr, %base: #addr, %len: #bits<64>,
                    %name_lo: #bits<64>, %name_hi: #bits<64>,
                    %kind: #bits<64>, %width: #bits<64>,
                    %num_lo: #bits<64>) -> #bits<32> {
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lain_meta_emit_write(%host, %name_at, %name_len)
  %p2a = #data_addr meta_p2a
  %w3 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w4 = #call meta_emit_repr(%host, %kind, %width)
  %p2b = #data_addr meta_p2b
  %w5 = #call lain_meta_emit_write(%host, %p2b, 13)
  %value = #call bs_read_uint(%base, %num_lo, %len)
  %w6 = #call meta_emit_uint(%host, %value)
  %p3 = #data_addr meta_p3
  %w7 = #call lain_meta_emit_write(%host, %p3, 3)
  #return 0
}

// `let NAME: T = A OP B [OP C …];` —— 左结合链，每个算子发一条指令。
//
// 这是"值识别"的第一步，要点是**它负责把整段吃完**。每读到一个算子就核对右
// 操作数（必须存在、必须全是数字），读到不是算子的地方才停，然后要求那里
// **正好是 `;`**。"整块吃完了没有"于是成了这一步的结构属性，不再靠调用方记得
// 检查——旧版正是靠调用方检查，才漏出过 `1 + 2 + 3` 只发 `#add(1,2)`。
//
// 一条 `1 + 2 + 3` 发成：
//
//     %r1 = #add[#bits<32>](1, 2)
//     %r2 = #add[#bits<32>](%r1, 3)
//
// 中转值编号在 `meta_next_temp` 里，`%cur == 0` 表示"还没有中转值"——此时左
// 操作数直接来自源码的 `%first_lo`。物理算子名依旧是 `meta_op_resolve` 从
// **类型的 op 表**里查出来的（`"/"` 对 i32 是 sdiv、对 u32 是 udiv），这里没有
// 一行写着「如果是 i32」。查不到就是 6，不是换一个算子硬发。
#proc meta_emit_chain(%host: #addr, %base: #addr, %len: #bits<64>,
                      %name_lo: #bits<64>, %name_hi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                      %t_hi: #bits<64>, %first_lo: #bits<64>,
                      %first_hi: #bits<64>) -> #bits<32> {
  // `#proc NAME() -> <repr> {\n`
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lain_meta_emit_write(%host, %name_at, %name_len)
  %p2a = #data_addr meta_p2a
  %w3 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w4 = #call meta_emit_repr(%host, %kind, %width)
  %open = #data_addr meta_fn_open
  %w5 = #call lain_meta_emit_write(%host, %open, 3)

  // 整段值交给表达式发射器。它自己走到 `;` 为止，结果写在 +168（临时值下标，或
  // 「无」= 结果就是源码里那段，此时 +176/+184 是它的范围）。
  %first_node = #call meta_node_at(%host, %base, %first_lo)
  %est = #call meta_emit_expr(%host, %base, %len, %kind, %width, %t_lo, %t_hi,
                              %first_node, 1)
  %ebad = #ne[#bits<32>](%est, 0)
  #if %ebad {
    #return %est
  }
  %scratch = #call lain_meta_scratch_data(%host)
  %ref = #call meta_cell_get(#lea(%scratch, 168, 1, 0))
  // `  #return <结果>\n}\n`
  %ret = #data_addr meta_st_ret
  %z1 = #call lain_meta_emit_write(%host, %ret, 10)
  %rlo = #call meta_cell_get(#lea(%scratch, 176, 1, 0))
  %rhi = #call meta_cell_get(#lea(%scratch, 184, 1, 0))
  %z2 = #call meta_emit_ref2(%host, %base, %len, %ref, %rlo, %rhi)
  %close = #data_addr meta_o6
  %z3 = #call lain_meta_emit_write(%host, %close, 2)
  #return 0
}

// 发一个「引用」：`%ref` 是「无」就把源码 `[lo, hi)` 发出去（数字照发、名字加 `%`），
// 否则发临时值名 `%r<n>`。两处要用同一个判断（左边的累积值和右边的操作数），所以单独
// 一个 proc。
#proc meta_emit_ref2(%host: #addr, %base: #addr, %len: #bits<64>,
                     %ref: #bits<64>, %lo: #bits<64>, %hi: #bits<64>) -> #bits<32> {
  %is_src = #eq[#bits<64>](%ref, 0xFFFFFFFFFFFFFFFF)
  %st = #if %is_src -> (#bits<32>) {
    %w = #call meta_emit_operand(%host, %base, %lo, %hi, %len)
    #yield %w
  } else {
    %w2 = #call meta_emit_temp_name(%host, %ref)
    #yield %w2
  }
  #return %st
}

// 把一个操作数节点变成「可以引用的东西」，结果写进暂存区 `+168`：临时值下标，或者
// 「无」表示"直接用源码那段"。回状态码。
//
// 三种操作数：
//   - 一个 token（数字或名字）→ 「无」，让调用方去发源码那段
//   - 一个组 `( … )`          → 递归降级（括号里自己是一条表达式）
//   - 一次调用 `f(…)`         → 发 `  %r<n> = #call f(…)\n`
//
// 括号里以**兄弟链走完**收尾（`%need_semi` = 0），不是 `;`。
#proc meta_operand_emit(%host: #addr, %base: #addr, %len: #bits<64>,
                        %kind: #bits<64>, %width: #bits<64>,
                        %t_lo: #bits<64>, %t_hi: #bits<64>,
                        %node: #bits<64>) -> #bits<32> {
  %form = #call meta_node_kind(%host, %node)
  %is_group = #eq[#bits<64>](%form, 2)
  %is_call = #eq[#bits<64>](%form, 5)
  %st = #if %is_group -> (#bits<32>) {
    %kid = #call meta_node_child(%host, %node)
    %st1 = #call meta_emit_expr(%host, %base, %len, %kind, %width, %t_lo,
                                %t_hi, %kid, 0)
    #yield %st1
  } else {
    %st2 = #if %is_call -> (#bits<32>) {
      %c_lo = #call meta_node_start(%host, %node)
      %c_hi = #add[#bits<64>](%c_lo, #call meta_node_len(%host, %node))
      %grp = #call meta_node_next(%host, %node)
      %st3 = #call meta_emit_call_temp(%host, %base, %len, %kind, %width,
                                       %t_lo, %t_hi, %c_lo, %c_hi, %grp)
      #yield %st3
    } else {
      // 一个 token：直接用源码那段。**源码范围也要写进 +176/+184** —— 组的那个分支
      // 是递归留下的范围，调用方一律从这里读，就不会把 `(42)` 的范围当成整个括号。
      %sc = #call lain_meta_scratch_data(%host)
      %s = #call meta_cell_put(#lea(%sc, 168, 1, 0), 0xFFFFFFFFFFFFFFFF)
      %lo0 = #call meta_node_start(%host, %node)
      %hi0 = #add[#bits<64>](%lo0, #call meta_node_len(%host, %node))
      %s4 = #call meta_cell_put(#lea(%sc, 176, 1, 0), %lo0)
      %s5 = #call meta_cell_put(#lea(%sc, 184, 1, 0), %hi0)
      #yield 0
    }
    #yield %st2
  }
  #return %st
}

// 发 `  %r<n> = #call <被调用者>(<实参>…)\n`，把临时值下标写进 `+168`。回状态码。
//
// 子表达式里的调用要**先算进一个临时值**才能当操作数用 —— `f(1) + 2` 得先有
// `%r1 = #call f(1)`，才有 `%r2 = #add(%r1, 2)`。
#proc meta_emit_call_temp(%host: #addr, %base: #addr, %len: #bits<64>,
                          %kind: #bits<64>, %width: #bits<64>,
                          %t_lo: #bits<64>, %t_hi: #bits<64>,
                          %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                          %args: #bits<64>) -> #bits<32> {
  // 先把实参降级好（子表达式的指令现在发），再写这一行 —— 反过来那些指令会插进
  // `#call f(` 后面。
  %ast = #call meta_args_prepare(%host, %base, %len, %kind, %width, %t_lo,
                                 %t_hi, %args)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  %ind = #data_addr meta_st_ind
  %w1 = #call lain_meta_emit_write(%host, %ind, 2)
  %tn = #call meta_next_temp(%host)
  %w2 = #call meta_emit_temp_name(%host, %tn)
  %eqop = #data_addr meta_st_eqop
  %w3 = #call lain_meta_emit_write(%host, %eqop, 3)
  %hc = #data_addr meta_hash_call
  %w4 = #call lain_meta_emit_write(%host, %hc, 6)
  %c_at = #lea(%base, %callee_lo, 1, 0)
  %c_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %w5 = #call lain_meta_emit_write(%host, %c_at, %c_len)
  %lp = #data_addr meta_fn_lparen
  %w6 = #call lain_meta_emit_write(%host, %lp, 1)
  %wst = #call meta_args_write(%host, %base, %len)
  %wbad = #ne[#bits<32>](%wst, 0)
  #if %wbad {
    #return %wst
  }
  %rp = #data_addr meta_rparen
  %w7 = #call lain_meta_emit_write(%host, %rp, 1)
  %nl = #data_addr meta_st_nl
  %w8 = #call lain_meta_emit_write(%host, %nl, 1)
  %sc = #call lain_meta_scratch_data(%host)
  %s = #call meta_cell_put(#lea(%sc, 168, 1, 0), %tn)
  #return 0
}

// 一个操作数节点之后接着是哪个节点。**调用占两个节点**（被调用者 + 实参那个组），
// 所以要跳两个 —— 不跳的话 `f(1) + 2` 会把实参组当成算子，报一个跟真实原因无关的 4。
#proc meta_after_operand(%host: #addr, %node: #bits<64>) -> #bits<64> {
  %k = #call meta_node_kind(%host, %node)
  %is_call = #eq[#bits<64>](%k, 5)
  %nx = #call meta_node_next(%host, %node)
  %r = #if %is_call -> (#bits<64>) {
    %g = #call meta_node_next(%host, %nx)
    #yield %g
  } else {
    #yield %nx
  }
  #return %r
}

// 一条表达式：`操作数 (算子 操作数)*`，左结合。`%first` 是第一个操作数节点。
//
// `%need_semi`：最外层要 1 —— 表达式必须**正好以 `;` 收尾**（少个 `;` 是错，不能当没
// 看见）；括号里的要 0 —— 那里以兄弟链走完（「无」）收尾。
//
// 结果放在暂存区：`+168` = 临时值下标，或「无」表示"结果就是源码里那段"（此时
// `+176`/`+184` 是它的范围）。**出参而不是返回值**，因为返回值要用来带状态码；这也是
// `meta_parse_seq` 用 `+144` 的老路子，调用方紧接着读。
//
// 左结合：每读到一个算子，就把它左边累积的值和右边操作数发成一条指令。累积值一开始
// 可以是源码片段（`1 + 2` 的第一条就是 `#add(1, 2)`，不是先物化 `1`），发了第一条
// 指令之后就是临时值。
//
// 物理算子名由 `meta_op_resolve` 从**类型的 op 表**里查，这里没有一行写着「如果是 i32」。
#proc meta_emit_expr(%host: #addr, %base: #addr, %len: #bits<64>,
                     %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                     %t_hi: #bits<64>, %first: #bits<64>,
                     %need_semi: #bits<1>) -> #bits<32> {
  %st = #loop e(%c: #bits<64> = %first, %have: #bits<1> = 0,
                %acc: #bits<64> = 0xFFFFFFFFFFFFFFFF, %alo: #bits<64> = 0,
                %ahi: #bits<64> = 0) -> (#bits<32>) {
    %phase1 = #eq[#bits<1>](%have, 0)
    #if %phase1 {
      // 阶段一：%c 是一个操作数，它成为累积值
      %at = #call meta_node_start(%host, %c)
      %b = #call bs_byte_at(%base, %at, %len)
      %isnone = #eq[#bits<64>](%c, 0xFFFFFFFFFFFFFFFF)
      %issemi = #eq[#bits<8>](%b, 59)
      %empty = #or[#bits<1>](%isnone, %issemi)
      #if %empty {
        // 一个操作数都没有就结束了
        %f0 = #call lain_meta_fail(%host, 3)
        #break e(3)
      }
      %ost = #call meta_operand_emit(%host, %base, %len, %kind, %width, %t_lo,
                                     %t_hi, %c)
      %obad = #ne[#bits<32>](%ost, 0)
      #if %obad {
        #break e(%ost)
      }
      %sc = #call lain_meta_scratch_data(%host)
      %ref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %alo1 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %ahi1 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      %nx = #call meta_after_operand(%host, %c)
      #continue e(%nx, 1, %ref, %alo1, %ahi1)
    }
    // 阶段二：%c 是算子、或者是表达式的终点
    %bat = #call meta_node_start(%host, %c)
    %bb = #call bs_byte_at(%base, %bat, %len)
    %isnone2 = #eq[#bits<64>](%c, 0xFFFFFFFFFFFFFFFF)
    %issemi2 = #eq[#bits<8>](%bb, 59)
    %iscomma2 = #eq[#bits<8>](%bb, 44)
    %any1 = #or[#bits<1>](%isnone2, %issemi2)
    // `,` 也是终点：实参位置上一条表达式到逗号为止（见 `meta_emit_args`）。
    %anyend = #or[#bits<1>](%any1, %iscomma2)
    %endok = #if %need_semi -> (#bits<1>) {
      #yield %issemi2
    } else {
      #yield %anyend
    }
    #if %endok {
      %sc2 = #call lain_meta_scratch_data(%host)
      %s1 = #call meta_cell_put(#lea(%sc2, 168, 1, 0), %acc)
      %s2 = #call meta_cell_put(#lea(%sc2, 176, 1, 0), %alo)
      %s3 = #call meta_cell_put(#lea(%sc2, 184, 1, 0), %ahi)
      // 终点节点也带出去：调用方（实参那个循环）要靠它找下一个实参从哪开始。
      %s4 = #call meta_cell_put(#lea(%sc2, 192, 1, 0), %c)
      #break e(0)
    }
    %isop = #call bs_is_operator(%bb)
    %notop = #eq[#bits<1>](%isop, 0)
    #if %notop {
      // 既不是算子也不是终点：`1 + 2 3` 之类
      %f1 = #call lain_meta_fail(%host, 4)
      #break e(4)
    }
    // 右操作数
    %rn = #call meta_node_next(%host, %c)
    %rn_at = #call meta_node_start(%host, %rn)
    %rn_b = #call bs_byte_at(%base, %rn_at, %len)
    %rn_none = #eq[#bits<64>](%rn, 0xFFFFFFFFFFFFFFFF)
    %rn_semi = #eq[#bits<8>](%rn_b, 59)
    %rn_end = #or[#bits<1>](%rn_none, %rn_semi)
    #if %rn_end {
      // 算子在，操作数没了（`1 + ;`）
      %f2 = #call lain_meta_fail(%host, 3)
      #break e(3)
    }
    %sym = #lea(%base, %bat, 1, 0)
    %phys = #call meta_op_resolve(%host, %base, %len, %t_lo, %t_hi, %sym, 1)
    %miss = #eq[#bits<64>](%phys, 0xFFFFFFFFFFFFFFFF)
    #if %miss {
      %f3 = #call lain_meta_fail(%host, 6)
      #break e(6)
    }
    // 右操作数也先变成可引用的东西（组/调用会先发指令）
    %rst = #call meta_operand_emit(%host, %base, %len, %kind, %width, %t_lo,
                                   %t_hi, %rn)
    %rbad = #ne[#bits<32>](%rst, 0)
    #if %rbad {
      #break e(%rst)
    }
    %sc3 = #call lain_meta_scratch_data(%host)
    %rref = #call meta_cell_get(#lea(%sc3, 168, 1, 0))
    %rn_lo2 = #call meta_cell_get(#lea(%sc3, 176, 1, 0))
    %rn_hi2 = #call meta_cell_get(#lea(%sc3, 184, 1, 0))
    // `  %r<n> = #<物理>[<repr>](<左>, <右>)\n`
    %tn = #call meta_next_temp(%host)
    %ind = #data_addr meta_st_ind
    %x1 = #call lain_meta_emit_write(%host, %ind, 2)
    %x2 = #call meta_emit_temp_name(%host, %tn)
    %eqop = #data_addr meta_st_eqop
    %x3 = #call lain_meta_emit_write(%host, %eqop, 3)
    %x4 = #call meta_emit_op_mid(%host, %kind, %width)
    %x5 = #call meta_emit_ref2(%host, %base, %len, %acc, %alo, %ahi)
    %comma = #data_addr meta_o4
    %x6 = #call lain_meta_emit_write(%host, %comma, 2)
    %x7 = #call meta_emit_ref2(%host, %base, %len, %rref, %rn_lo2, %rn_hi2)
    %rp = #data_addr meta_rparen
    %x8 = #call lain_meta_emit_write(%host, %rp, 1)
    %nl = #data_addr meta_st_nl
    %x9 = #call lain_meta_emit_write(%host, %nl, 1)
    %nx2 = #call meta_after_operand(%host, %rn)
    #continue e(%nx2, 1, %tn, 0, 0)
  }
  #return %st
}
