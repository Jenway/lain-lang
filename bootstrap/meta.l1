// Meta v0 —— 语言定义层，手写 LAINIR。
//
// 它是「编译器的哪一部分必须能用 Lain 重写」这条边界的第一个落点：
// 它读源码字节，按语言规则决定含义，产出 canonical LAINIR 文本，
// 交给驱动去 parse + verify + 执行。它不认识任何物理算子，
// 底座也不认识任何 Lain 概念。
//
// v0 认的顶层形式：`let` / `struct` / `enum` / `func` / `import(...)`。关键字经
// Meta 语法注册表取得 handler，再由各声明处理器登记与
// Lowering；底座不参与语言分派。语言面的清单见 README「v0 的语言」。
//
// ABI 提供版本、初始化与 lower；lower 内部先协调展开与声明登记，再识别和生成。

#proc lain_std_abi_version() -> #bits<64> {
  // 第一期把节点形状从私有树搬进 LAINAST v1 旁表、宿主侧建平铺 AstIn、新增
  // `lain_meta_ast_*` 读原语，公共 ABI 因此从 2 提到 3（v2 实现不再可配）。
  // 命名迁移批把 seed 的 Eval 服务改称 apply：五个宿主能力名由原来的
  // apply 请求 ABI 接入实参数组，公共 ABI 因此从 4 提到 5。
  // 增加 apply 字节结果请求与受权复制能力，公共 ABI 因此从 6 提到 7。
  // 增加编译会话身份能力，供 Meta wire 校验类型/过程引用归属，公共 ABI 提到 8。
  // 增加 apply 只读字节实参请求能力，公共 ABI 提到 9。
  // （v3 实现不再可配）。
  #return 9
}

#proc lain_std_initialize() -> #bits<32> {
  #return 0
}

// 产出：把 source 那份源码 lowering 成 LAINIR 文本，写进宿主的输出缓冲。
// 返回 0 = 成功。
#proc lain_std_lower(%source: #bits<64>) -> #bits<32> {
  // reader 在**登记时**就拒了这份源码（未闭合的块注释、括号不配对……）：宿主只登记了
  // 源码段，没有 AstIn Arena。干净地拒 —— 回 3、一个字节产物都不发；失败位置由宿主的
  // 诊断通道给出（`diagnostic: <路径> byte N code 34`）。旧实现是懒解析在第一次访问时
  // 才炸，外部看到的也是「回 3 + 那条诊断」，这里保持同一组观测。
  %has_tree = #call meta_source_has_tree(%source)
  %no_tree = #eq[#bits<1>](%has_tree, 0)
  #if %no_tree {
    %ft = #call lain_meta_fail(3)
    #return 3
  }
  // 诊断（宿主槽 30）：入口标记。用来确认 trace 通道本身是否工作。
  %reset = #call lain_meta_emit_reset()
  // 先认领 scratch 的固定区与 bump 区。Expand 自身需要有界临时帧；它不消费
  // 这次预扫描产生的语义结果。提交新 Root 后立即重新 setup，从新树重建所有表。
  %pre_setup = #call meta_scope_setup(0)
  %pre_bad = #ne[#bits<32>](%pre_setup, 0)
  #if %pre_bad {
    #return %pre_setup
  }
  %expanded = #call meta_expand_declared_source(%source)
  %expand_bad = #ne[#bits<32>](%expanded, 0)
  #if %expand_bad { #return %expanded }
  // 作用域表要先建：外层是 root 环境，内层是这份源码。名字按表查，
  // 不再回源码搜字节。
  %setup = #call meta_scope_setup(1)
  %ok = #eq[#bits<32>](%setup, 0)
  %status = #if %ok -> (#bits<32>) {
    %len = #call lain_meta_source_length(%source)
    %base = #call lain_meta_source_data(%source)
    %mark = #call meta_scope_count()
    %cur = #call meta_scope_set_current(%source)
    %scan = #call meta_scope_scan(%base, %len, %source, %mark)
    %b2 = #eq[#bits<32>](%scan, 0)
    %s = #if %b2 -> (#bits<32>) {
      // setup 已识别所有源码；旁表按出现位置共存，不重复扫描。
      %r = #call meta_lower_source(%source)
      #yield %r
    } else {
      #yield %scan
    }
    #yield %s
  } else {
    #yield %setup
  }
  %peak = #call meta_bump_peak()
  %reported = #call lain_meta_scratch_report(%peak)
  #return %status
}

// 一条一条走顶层形式。**形式从语法树上走**——「一条形式从哪到哪」由节点给出，
// 不再靠「从某个位置起找下一处长得像关键字的地方」。
#proc meta_lower_source(%source: #bits<64>) -> #bits<32> {
  %len = #call lain_meta_source_length(%source)
  %base = #call lain_meta_source_data(%source)
  %root = #call meta_root_of(%source)
  %count = #call ast_child_count(%root)
  // **顶层形式的遍历是一个游标**：`(root, i)`，i 从 0 走到 child_count。走到头
  // 就结束 —— 不再有「节点自己的下一个兄弟」这种东西（规范 §2.1）。
  %status = #loop forms(%i: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %node = #call ast_child(%root, %i)
      %here = #call meta_node_start(%node)
      %handler = #call meta_syntax_lookup(%node, 1, 0, 1)
      %any = #ne[#bits<64>](%handler, 0)
      %s = #if %any -> (#bits<32>) {
        %d = #call meta_lower_decl_invoke(%handler, %base, %len, %here,
                                           %root, %i, %node)
        #yield %d
      } else {
        // **顶层树的孩子是词，不是形式**——一条形式跨好几个孩子（`struct`
        // `Pair` `{...}`）。所以跳过一条形式内部那些非关键字的词是正常的；
        // 但**整份文件的第一个孩子必须是能被认出的形式**，否则就是坏输入。
        %is_first = #eq[#bits<64>](%i, 0)
        %x = #if %is_first -> (#bits<32>) {
          %f = #call lain_meta_fail(4)
          #yield 4
        } else {
          #yield 0
        }
        #yield %x
      }
      %bad = #ne[#bits<32>](%s, 0)
      #if %bad {
        #break forms(%s)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue forms(%i2)
    } else {
      #break forms(0)
    }
  }
  #return %status
}

// --- 积类型 ---------------------------------------------------------------
//
// `struct Rec { f: T ... }` 只产出两个东西：每个字段的字节偏移，和总大小。
// 偏移是**算出来的**（逐个 align_up 累加），不是查表查来的——这正是积类型
// 和标量的区别所在。
//
// v0 假设输入是良构的：字段名后面一定有 `:` 和类型名。写坏了会产出错的
// 偏移，而产物过不了验证——失败是响的，只是诊断不好看。

#proc meta_lower_struct(%base: #addr, %len: #bits<64>,
                        %kw_at: #bits<64>) -> #bits<32> {
  %after = #add[#bits<64>](%kw_at, 6)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %has_name = #ult[#bits<64>](%name_lo, %name_hi)
  %status = #if %has_name -> (#bits<32>) {
    %brace = #call bs_skip_space(%base, %name_hi, %len)
    %is_open = #call bs_is_byte(%base, %brace, 123)
    %inner = #if %is_open -> (#bits<32>) {
      %body = #add[#bits<64>](%brace, 1)
      %size = #call meta_struct_fields(%base, %len, %name_lo, %name_hi,
                                       %body, 0, 1)
      %failed = #eq[#bits<64>](%size, 0xFFFFFFFFFFFFFFFF)
      %s = #if %failed -> (#bits<32>) {
        %reset = #call lain_meta_emit_reset()
        %eval_code = #call lain_meta_apply_status()
        %has_eval_code = #ugt[#bits<64>](%eval_code, 0)
        %code = #if %has_eval_code -> (#bits<32>) {
          %low = #trunc[#bits<32>](%eval_code)
          #yield %low
        } else {
          #yield 7
        }
        #yield %code
      } else {
        %w = #call meta_emit_size(%base, %name_lo, %name_hi, %size)
        #yield 0
      }
      #yield %s
    } else {
      %f = #call lain_meta_fail(4)
      #yield 4
    }
    #yield %inner
  } else {
    %f = #call lain_meta_fail(4)
    #yield 4
  }
  #return %status
}

// 走字段列表，每个字段发一个 offset 过程。返回总大小；出错返回 NOT_FOUND。
// 循环携带 (下一个位置, 当前偏移, 当前最大对齐)。
#proc meta_struct_fields(%base: #addr, %len: #bits<64>,
                        %rec_lo: #bits<64>, %rec_hi: #bits<64>,
                        %at: #bits<64>, %off: #bits<64>,
                        %max_align: #bits<64>) -> #bits<64> {
  %size = #loop fields(%at: #bits<64> = %at, %off: #bits<64> = %off,
                       %al: #bits<64> = %max_align) -> (#bits<64>) {
    %here = #call bs_skip_space(%base, %at, %len)
    %byte = #call bs_byte_at(%base, %here, %len)
    %is_close = #eq[#bits<8>](%byte, 125)
    #if %is_close {
      %rounded = #call meta_eval_align_up(%off, %al, %base, %here)
      #break fields(%rounded)
    }
    // 字段名 : 类型名
    %f_hi = #call bs_skip_ident(%base, %here, %len)
    %colon = #call bs_skip_space(%base, %f_hi, %len)
    %one = #add[#bits<64>](%colon, 1)
    %t_lo = #call bs_skip_space(%base, %one, %len)
    %t_hi = #call bs_skip_qualified(%base, %t_lo, %len)
    // 查字段类型（root 环境或命名空间成员）——拿到的是类型 id
    %tid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
    %bad_type = #eq[#bits<64>](%tid, 0)
    #if %bad_type {
      %f3 = #call lain_meta_fail(5)
      #return 0xFFFFFFFFFFFFFFFF
    }
    %tinfo = #call meta_tid_repr(%tid)
    %kind = #and[#bits<64>](%tinfo, 255)
    %width = #and[#bits<64>](#lshr[#bits<64>](%tinfo, 8), 255)
    %fsize = #call meta_tid_size(%tid)
    %falign = #call meta_tid_align(%tid)
    %aligned = #call bs_align_up(%off, %falign)
    %emit = #call meta_emit_field_offset(%base, %len, %rec_lo, %rec_hi,
                                         %here, %f_hi, %aligned)
    %next_off = #add[#bits<64>](%aligned, %fsize)
    %bigger = #ugt[#bits<64>](%falign, %al)
    %new_al = #if %bigger -> (#bits<64>) {
      #yield %falign
    } else {
      #yield %al
    }
    #continue fields(%t_hi, %next_off, %new_al)
  }
  #return %size
}

// 发一个 `<Rec>__<field>_offset() -> #bits<64> { #return <offset> }`。
#proc meta_emit_field_offset(%base: #addr, %len: #bits<64>,
                            %rec_lo: #bits<64>, %rec_hi: #bits<64>,
                            %f_lo: #bits<64>, %f_hi: #bits<64>,
                            %value: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %rec_at = #lea(%base, %rec_lo, 1, 0)
  %rec_len = #sub[#bits<64>](%rec_hi, %rec_lo)
  %a1 = #call lainir_buf_bytes(%buf, 0, %rec_at, %rec_len)
  %d = #data_addr meta_dsep
  %a2 = #call lainir_buf_bytes(%buf, %a1, %d, 2)
  %f_at = #lea(%base, %f_lo, 1, 0)
  %f_len = #sub[#bits<64>](%f_hi, %f_lo)
  %a3 = #call lainir_buf_bytes(%buf, %a2, %f_at, %f_len)
  %suf = #data_addr meta_foff
  %nlen = #call lainir_buf_bytes(%buf, %a3, %suf, 7)
  %h = #call lainir_proc_head_full(%buf, %nlen, %buf, 0, 0, 64)
  %o = #call lainir_open_body()
  %r = #call lainir_return_uint(%value)
  %c = #call lainir_close_body()
  #return 0
}

// 发一个 `<Rec>__size() -> #bits<64> { #return <size> }`。
#proc meta_emit_size(%base: #addr, %rec_lo: #bits<64>,
                    %rec_hi: #bits<64>, %value: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %rec_at = #lea(%base, %rec_lo, 1, 0)
  %rec_len = #sub[#bits<64>](%rec_hi, %rec_lo)
  %a1 = #call lainir_buf_bytes(%buf, 0, %rec_at, %rec_len)
  %suf = #data_addr meta_rsize
  %nlen = #call lainir_buf_bytes(%buf, %a1, %suf, 6)
  %h = #call lainir_proc_head_full(%buf, %nlen, %buf, 0, 0, 64)
  %o = #call lainir_open_body()
  %r = #call lainir_return_uint(%value)
  %c = #call lainir_close_body()
  #return 0
}

#proc meta_lower_let(%base: #addr, %len: #bits<64>, %let_at: #bits<64>) -> #bits<32> {
  %after = #add[#bits<64>](%let_at, 3)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %has_name = #ult[#bits<64>](%name_lo, %name_hi)
  %status = #if %has_name -> (#bits<32>) {
    %s = #call meta_lower_binding(%base, %len, %name_lo, %name_hi)
    #yield %s
  } else {
    %f = #call lain_meta_fail(4)
    #yield 4
  }
  #return %status
}

// NAME [: TYPE] = INT
// NAME = import("逻辑路径") 是一种**不产出 LAINIR** 的绑定：它是编译期的
// 命名空间绑定，用到时再回源码里找回来。所以它在类型标注之前分叉。
#proc meta_lower_binding(%base: #addr, %len: #bits<64>,
                         %name_lo: #bits<64>, %name_hi: #bits<64>) -> #bits<32> {
  %at = #call bs_skip_space(%base, %name_hi, %len)
  %is_eq = #call bs_is_byte(%base, %at, 61)
  %is_import = #if %is_eq -> (#bits<1>) {
    %one = #add[#bits<64>](%at, 1)
    %kw_at = #call bs_skip_space(%base, %one, %len)
    %kw = #data_addr meta_kw_import
    %k = #call bs_match_keyword(%base, %kw_at, %len, %kw, 6)
    #yield %k
  } else {
    #yield 0
  }
  %status = #if %is_import -> (#bits<32>) {
    %s0 = #call meta_lower_import(%base, %len, %at)
    #yield %s0
  } else {
    %is_colon = #call bs_is_byte(%base, %at, 58)
    %s1 = #if %is_colon -> (#bits<32>) {
      %after = #add[#bits<64>](%at, 1)
      %t_lo = #call bs_skip_space(%base, %after, %len)
      // 类型名可能是限定名（`W.w32`），所以不是 bs_skip_ident
      %t_hi = #call bs_skip_qualified(%base, %t_lo, %len)
      %s = #call meta_lower_typed(%base, %len, %name_lo, %name_hi, %t_lo,
                                  %t_hi)
      #yield %s
    } else {
      %s = #call meta_lower_typed(%base, %len, %name_lo, %name_hi, 0, 0)
      #yield %s
    }
    #yield %s1
  }
  #return %status
}

// 解析类型名拿到 repr，再 `= INT`，最后把整条绑定写出去。
#proc meta_lower_typed(%base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<32> {
  %has_type = #ult[#bits<64>](%t_lo, %t_hi)

  // 类型名 → 注册表里的**类型 id**。没有标注时给合成的 `#bits<64>`（owner 0）。
  %resolved = #if %has_type -> (#bits<64>) {
    %e = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
    #yield %e
  } else {
    %d = #call meta_intern(1, 0, 0, 0, 64)
    #yield %d
  }
  %unknown = #eq[#bits<64>](%resolved, 0)
  #if %unknown {
    %f0 = #call lain_meta_fail(5)
    #return 5
  }

  // repr 从注册表里读——它是身份的**后果**，不是身份本身
  %info = #call meta_tid_repr(%resolved)
  %kind = #and[#bits<64>](%info, 255)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)

  // 从类型名之后接着解析；没有标注就从名字之后
  %resume = #if %has_type -> (#bits<64>) {
    #yield %t_hi
  } else {
    #yield %name_hi
  }
  %eq_at = #call bs_skip_space(%base, %resume, %len)
  %is_eq = #call bs_is_byte(%base, %eq_at, 61)
  %status = #if %is_eq -> (#bits<32>) {
    %after_eq = #add[#bits<64>](%eq_at, 1)
    %lhs_lo = #call bs_skip_space(%base, %after_eq, %len)
    // 值的第一个 token 的终点。`bs_skip_ident` 对 `(` 这类开头**不前进** —— 那样
    // `(1 + 2) + 3` 会被当成「`=` 后面没有值」报 3。括号开头的值第一个节点是那个组，
    // 终点由树给，所以这里只要保证 `lhs_hi > lhs_lo` 就行。
    %lhs_id = #call bs_skip_ident(%base, %lhs_lo, %len)
    %lhs_adv = #ult[#bits<64>](%lhs_lo, %lhs_id)
    %lhs_hi = #if %lhs_adv -> (#bits<64>) {
      #yield %lhs_id
    } else {
      %one = #add[#bits<64>](%lhs_lo, 1)
      #yield %one
    }
    // 「有没有值」看的是 `=` 后面还有没有字节，不是识不识别得出标识符。
    %has_lhs = #ult[#bits<64>](%lhs_lo, %len)
    %inner = #if %has_lhs -> (#bits<32>) {
      %s = #call meta_emit_value(%base, %len, %name_lo, %name_hi, %kind,
                                 %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
      #yield %s
    } else {
      %f = #call lain_meta_fail(3)
      #yield 3
    }
    #yield %inner
  } else {
    %f = #call lain_meta_fail(4)
    #yield 4
  }
  #return %status
}

// 右值：一个整数，或者 `整数 OP 整数`。
// 后者拿符号去**类型的 op 表**里查该发哪条物理算子——Meta 不知道
// "div" 对有符号和无符号是不同的。
#proc meta_emit_value(%base: #addr, %len: #bits<64>,
                      %name_lo: #bits<64>, %name_hi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                      %t_hi: #bits<64>, %lhs_lo: #bits<64>,
                      %lhs_hi: #bits<64>) -> #bits<32> {
  // 字节串字面量：整段是一个静态字节块的顶层绑定（`data` 只能落顶层）。
  %is_bytes = #call bs_is_byte(%base, %lhs_lo, 34)
  #if %is_bytes {
    %bytes_st = #call meta_lower_static_bytes(%base, %len, %name_lo,
                                               %name_hi, %lhs_lo)
    #return %bytes_st
  }
  // 形状**不问字节，问识别 pass 算好的那一格**。这里曾经看值的头一个字节判数字、
  // 又看第一个标识符之后的字节判 `{` / `.` / `(` —— 同一套形状规则在好几处各写一
  // 遍，改一处漏两处。现在只读 form（取值见 `std/recognize.l1`）。
  //
  // 「是一条表达式」有三条进路：
  //   形状 4（二元）   第一个操作数后面跟着算子
  //   形状 2（组）     第一个操作数是括号（`(1 + 2) + 3`）
  //   整段里有算子     第一个操作数是调用/字段/构造而后面还有算子（`f(1) + 2`）
  // 最后这条必须单独判：形状 5/6/10 说的是「这里开始一次调用/字段访问/构造」，**不是**
  // 「整个值就是它」。不判的话那三条发射器只发构造本身，后面跟的算子会被悄悄丢掉 ——
  // `let main: i32 = f(1) + 2;` 曾经发成 `#return #call f(1)`，验证通过，算出来 2
  // 而不是 4。
  %form = #call meta_form_at(%base, %lhs_lo)
  %hasop = #call meta_value_has_op(%base, %len, %lhs_lo)
  %f_bin = #eq[#bits<64>](%form, 4)
  %f_grp = #eq[#bits<64>](%form, 2)
  %f_const = #eq[#bits<64>](%form, 7)
  %e1 = #or[#bits<1>](%f_bin, %f_grp)
  %is_expr = #or[#bits<1>](%e1, %hasop)
  %status = #if %is_expr -> (#bits<32>) {
    %s = #call meta_emit_chain(%base, %len, %name_lo, %name_hi, %kind,
                               %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
    #yield %s
  } else {
    %s_c0 = #if %f_const -> (#bits<32>) {
      %s0 = #call meta_emit_numeric(%base, %len, %name_lo, %name_hi,
                                    %kind, %width, %t_lo, %t_hi, %lhs_lo,
                                    %lhs_hi)
      #yield %s0
    } else {
    // 标识符到哪结束仍然要算：下面的降级点按字节区间工作。那是**位置**，不是形状。
    %rec_hi = #call bs_skip_ident(%base, %lhs_lo, %len)
    %after = #call bs_skip_space(%base, %rec_hi, %len)
    %single = #eq[#bits<1>](%hasop, 0)
    %f_ctor0 = #eq[#bits<64>](%form, 10)
    %f_field0 = #eq[#bits<64>](%form, 6)
    %f_call0 = #eq[#bits<64>](%form, 5)
    // 三段值里还带算子 → 三个都是假 → 落到最里面那个 `lain_meta_fail(4)`
    %f_construct = #and[#bits<1>](%f_ctor0, %single)
    %f_field = #and[#bits<1>](%f_field0, %single)
    %f_call = #and[#bits<1>](%f_call0, %single)
    %s2 = #if %f_construct -> (#bits<32>) {
      // 构造：这个类型的正文从哪开始，**问符号表**，不回源码里找
      %tb = #call meta_scope_body(%base, %lhs_lo, %rec_hi, 4)
      %r1 = #call meta_lower_construct(%base, %len, %name_lo, %name_hi,
                                       %tb, %after)
      #yield %r1
    } else {
      %s3 = #if %f_field -> (#bits<32>) {
        %dot = #add[#bits<64>](%after, 1)
        %m_lo = #call bs_skip_space(%base, %dot, %len)
        %m_hi = #call bs_skip_ident(%base, %m_lo, %len)
        // `A.b` 里的 `A` 可能是三种东西，形状完全不同：
        //   import 绑定 → 跨模块取值（mangle 成扁平名 + #call）
        //   enum        → 变体构造／投影
        //   其余        → struct 字段访问
        %ns_at = #call meta_find_import_binding(%base, %len, %lhs_lo, %rec_hi)
        %is_ns = #ne[#bits<64>](%ns_at, 0)
        %is_sum = #call meta_is_enum(%base, %len, %lhs_lo, %rec_hi)
        // struct 字段访问要的正文起点，也问符号表
        %tb2 = #call meta_scope_body(%base, %lhs_lo, %rec_hi, 4)
        %r2 = #if %is_ns -> (#bits<32>) {
          %r7 = #call meta_lower_ns_value(%base, %len, %name_lo,
                                          %name_hi, %lhs_lo, %rec_hi, %m_lo,
                                          %m_hi, %kind, %width)
          #yield %r7
        } else {
          %r3 = #if %is_sum -> (#bits<32>) {
            %r5 = #call meta_lower_sum_access(%base, %len, %name_lo,
                                              %name_hi, %lhs_lo, %rec_hi, %dot)
            #yield %r5
          } else {
            %r6 = #call meta_lower_field_access(%base, %len, %name_lo,
                                                %name_hi, %tb2, %dot)
            #yield %r6
          }
          #yield %r3
        }
        #yield %r2
      } else {
        %s4 = #if %f_call -> (#bits<32>) {
          %r4 = #call meta_emit_call(%base, %len, %name_lo, %name_hi,
                                     %kind, %width, %t_lo, %t_hi, %lhs_lo,
                                     %rec_hi, %after)
          #yield %r4
        } else {
          %f = #call lain_meta_fail(4)
          #yield 4
        }
        #yield %s4
      }
      #yield %s3
    }
    #yield %s2
    }
    #yield %s_c0
  }
  #return %status
}

// 这段字节是一个**完整**的整数字面量吗？十进制全数字，或 `0x`/`0X` 后跟至少一位十六
// 进制数字。**整段必须用完**：`0x10` 曾经被 `bs_read_uint` 读成 `0` 而把 `x10` 悄悄丢掉。
#proc meta_is_int_literal(%base: #addr, %lo: #bits<64>, %hi: #bits<64>,
                           %len: #bits<64>) -> #bits<1> {
  %b0 = #call bs_byte_at(%base, %lo, %len)
  %is_zero = #eq[#bits<8>](%b0, 48)
  %n1 = #add[#bits<64>](%lo, 1)
  %b1 = #call bs_byte_at(%base, %n1, %len)
  %lx = #eq[#bits<8>](%b1, 120)
  %ux = #eq[#bits<8>](%b1, 88)
  %x = #or[#bits<1>](%lx, %ux)
  %hex = #and[#bits<1>](%is_zero, %x)
  %first = #if %hex -> (#bits<64>) {
    %s2 = #add[#bits<64>](%lo, 2)
    #yield %s2
  } else {
    #yield %lo
  }
  %r = #loop s(%i: #bits<64> = %first, %any: #bits<1> = 0) -> (#bits<1>) {
    %more = #ult[#bits<64>](%i, %hi)
    #if %more {
      %b = #call bs_byte_at(%base, %i, %len)
      %ok = #if %hex -> (#bits<1>) {
        %h = #call bs_is_hex_digit(%b)
        #yield %h
      } else {
        %d = #call bs_is_digit(%b)
        #yield %d
      }
      #if %ok {
        %n = #add[#bits<64>](%i, 1)
        #continue s(%n, 1)
      }
      #break s(0)
    } else {
      #break s(%any)
    }
  }
  #return %r
}

// 一个**裸字面量**装得进这个宽度吗？装不进报 **23**（`let main: i8 = 300;` 曾经
// 静默截断成 44，`let main: bool = 2;` 截断成 0 —— 都是本仓库禁止的失败方式）。
//
// 只对 `bits<N>`（repr kind 0）查，而且宽度按**无符号**算：标量的 repr 不带符号，
// `i32` 和 `u32` 都是 `bits<32>`，符号属性住在 op 表里（`sdiv` vs `udiv`）。
// 名字、`0x10` 那种非纯数字、以及算出来的临时值都不在这里管 —— 各有各的检查。
#proc meta_literal_fits(%base: #addr, %len: #bits<64>,
                         %ref: #bits<64>, %lo: #bits<64>, %hi: #bits<64>,
                         %kind: #bits<64>, %width: #bits<64>) -> #bits<32> {
  %is_src = #eq[#bits<64>](%ref, 0xFFFFFFFFFFFFFFFF)
  %st = #if %is_src -> (#bits<32>) {
    %digits = #call meta_is_int_literal(%base, %lo, %hi, %len)
    %s = #if %digits -> (#bits<32>) {
      %isbits = #eq[#bits<64>](%kind, 0)
      %narrow = #ult[#bits<64>](%width, 64)
      %checked = #and[#bits<1>](%isbits, %narrow)
      %c = #if %checked -> (#bits<32>) {
        %v = #call bs_read_uint(%base, %lo, %len)
        %limit = #shl[#bits<64>](1, %width)
        %toobig = #uge[#bits<64>](%v, %limit)
        %f = #if %toobig -> (#bits<32>) {
          %x = #call lain_meta_fail(23)
          #yield 23
        } else {
          #yield 0
        }
        #yield %f
      } else {
        #yield 0
      }
      #yield %c
    } else {
      #yield 0
    }
    #yield %s
  } else {
    #yield 0
  }
  #return %st
}

// 从 at 起跳过空白之后是不是 `;`？
#proc meta_at_semi(%base: #addr, %at: #bits<64>, %len: #bits<64>) -> #bits<1> {
  %p = #call bs_skip_space(%base, %at, %len)
  // 用 `bs_byte_at`（越界给 0）而不是 `bs_is_byte`：源码没有以 `;` 收尾时
  // `bs_skip_space` 会返回 `len`，而 `bs_is_byte` 在 `len` 处是**越界读**——
  // 那会被 VM 以 trap 1004 拒掉。响是响了，但那是崩溃，不是诊断。
  %b = #call bs_byte_at(%base, %p, %len)
  %r = #eq[#bits<8>](%b, 59)
  #return %r
}

// 数值右值：一个整数，或 `整数 OP 整数 [OP 整数 …]`。
//
// 分支点是**值后面第一个非空白字节**：
//
//   - 是算子 → 交给 `meta_emit_chain`，它自己把整条链吃到 `;` 为止；
//   - 不是算子 → 这段话到这里就该完了，于是要求它后面**紧跟 `;`**。
//
// 这些尾巴检查都是给"静默给错值"堵口：`1 + 2 + 3` 曾被只发成 `#add(1,2)` 而把 `+ 3` 丢掉——
// 后者算出一个**错的但是合法的**结果。缺少检查，写错的东西会被当成对的算出
// 来。这正是文档里禁止的失败方式：失败要响，不能静默给错值。
#proc meta_emit_numeric(%base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                       %t_hi: #bits<64>, %lhs_lo: #bits<64>,
                       %lhs_hi: #bits<64>) -> #bits<32> {
  // 是「一条表达式」还是「一个常量」，读识别 pass 算好的形状：
  //   形状 4（二元）    → 表达式，第一个操作数后面跟着算子
  //   形状 2（组）      → 表达式，第一个操作数是括号（`(1 + 2) + 3`）
  //   其余（形状 7 等） → 当常量走
  %form = #call meta_form_at(%base, %lhs_lo)
  %f_bin = #eq[#bits<64>](%form, 4)
  %f_grp = #eq[#bits<64>](%form, 2)
  %is_expr = #or[#bits<1>](%f_bin, %f_grp)
  %status = #if %is_expr -> (#bits<32>) {
    // 整段交给表达式发射器。它自己走到 `;`，吃到不该有的东西就报错；调用方不再替它
    // 检查尾巴。
    %s = #call meta_emit_chain(%base, %len, %name_lo, %name_hi, %kind,
                               %width, %t_lo, %t_hi, %lhs_lo, %lhs_hi)
    #yield %s
  } else {
    %lhs_digits = #call meta_is_int_literal(%base, %lhs_lo, %lhs_hi, %len)
    %lhs_semi = #call meta_at_semi(%base, %lhs_hi, %len)
    %lhs_ok = #and[#bits<1>](%lhs_digits, %lhs_semi)
    %lhs_bad = #eq[#bits<1>](%lhs_ok, 0)
    #if %lhs_bad {
      %ft2 = #call lain_meta_fail(4)
      #return 4
    }
    // 常量装不装得进声明的类型？`let main: i8 = 300;` 曾经静默截断成 44 ——
    // 这条路的出参只有源码区间，没有"引用"，所以按「源码那段」查。
    %lfit = #call meta_literal_fits(%base, %len, 0xFFFFFFFFFFFFFFFF,
                                    %lhs_lo, %lhs_hi, %kind, %width)
    %lbad = #ne[#bits<32>](%lfit, 0)
    #if %lbad {
      #return %lfit
    }
    %s = #call meta_emit_let(%base, %len, %name_lo, %name_hi, %kind,
                             %width, %lhs_lo)
    #yield %s
  }
  #return %status
}

// `let a = f(3, 4);` —— 直接把已声明过程的结果当成这条绑定的值。
//
// 实参从**树上**那个组节点的孩子链上取（`meta_emit_args`），不按字节扫。
//
// 这里原来是从 `(` 后面一路扫到**第一个** `)` 然后照抄字节。那样有两处坏：
// `f((1))` 会在里层那个 `)` 上停住，发出 `#call f((1)`（少一个括号，驱动重解析时才
// 炸）；`f(1 + 2)` 会照抄出 `#call f(1 + 2)` —— **LAINIR 的实参不能是任意表达式**，
// 只能是操作数或嵌套的 `#call`，所以那条也过不去。
//
// 现在实参走 `meta_emit_args`：一个 token 一个实参，数字照发、名字加 `%`，实参里出现
// 组或算子就报 4。**报出来比发一段坏的强** —— 静默发坏正是这个仓库明文禁止的失败方式。
#proc meta_emit_call(%base: #addr, %len: #bits<64>,
                     %name_lo: #bits<64>, %name_hi: #bits<64>,
                     %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                     %t_hi: #bits<64>,
                     %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                     %at: #bits<64>) -> #bits<32> {
  %callee_name = #lea(%base, %callee_lo, 1, 0)
  %callee_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %decl = #call meta_scope_require_func(%callee_name, %callee_len)
  #if #eq[#bits<64>](%decl, 0) { #return 9415 }
  // 顺序很要紧：`#proc NAME() -> repr {\n` 这个**头**先写，然后才降级实参（实参里的
  // 子表达式要发指令，那些指令得落在过程体**里面**），最后写 `  #return #call f(实参)`。
  // 反过来（先降级实参）子指令会跑到 `#proc` 前面去。
  %w1 = #call lainir_proc_word_write()
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lainir_write(%name_at, %name_len)
  %w3 = #call lainir_empty_params_write()
  %w4 = #call meta_emit_repr(%kind, %width)
  %w5 = #call lainir_open_body()
  // 头写完了，现在降级实参。被调用者的下一个孩子就是实参那个组 —— 「位置 -> 同一个
  // 父组里的下一项」，不是靠节点引用找兄弟。
  %grp = #call meta_next_at(%base, %callee_lo)
  %ast = #call meta_args_prepare(%base, %len, %kind, %width, %t_lo,
                                 %t_hi, %grp)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  // `  #return #call <callee>(`
  %w6 = #call lainir_ret_call_head_write()
  %callee_at = #lea(%base, %callee_lo, 1, 0)
  %w7 = #call lainir_write(%callee_at, %callee_len)
  %w8 = #call lainir_open_paren_write()
  %wst = #call meta_args_write(%base, %len)
  %wbad = #ne[#bits<32>](%wst, 0)
  #if %wbad {
    #return %wst
  }
  %w9 = #call lainir_rparen_nl_close_write()
  #return 0
}

// 把这条绑定写成 LAINIR。
#proc meta_emit_let(%base: #addr, %len: #bits<64>,
                    %name_lo: #bits<64>, %name_hi: #bits<64>,
                    %kind: #bits<64>, %width: #bits<64>,
                    %num_lo: #bits<64>) -> #bits<32> {
  %w1 = #call lainir_proc_word_write()
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lainir_write(%name_at, %name_len)
  %w3 = #call lainir_empty_params_write()
  %w4 = #call meta_emit_repr(%kind, %width)
  %w5 = #call lainir_body_return_write()
  %value = #call bs_read_uint(%base, %num_lo, %len)
  %w6 = #call meta_emit_uint(%value)
  %w7 = #call lainir_close_body()
  #return 0
}

// `let NAME: T = A OP B [OP C …];` —— 左结合链，每个算子发一条指令。
//
// 这是"值识别"的第一步，要点是**它负责把整段吃完**。每读到一个算子就核对右
// 操作数（必须存在、必须全是数字），读到不是算子的地方才停，然后要求那里
// **正好是 `;`**。"整块吃完了没有"于是成了这一步的结构属性，不再靠调用方记得
// 检查——旧版正是靠调用方检查，才漏出过 `1 + 2 + 3` 只发 `#add(1,2)`。
//
// 一条 `1 + 2 + 3` 发成：
//
//     %r1 = #add[#bits<32>](1, 2)
//     %r2 = #add[#bits<32>](%r1, 3)
//
// 中转值编号在 `meta_next_temp` 里，`%cur == 0` 表示"还没有中转值"——此时左
// 操作数直接来自源码的 `%first_lo`。物理算子名依旧是 `meta_op_resolve` 从
// **类型的 op 表**里查出来的（`"/"` 对 i32 是 sdiv、对 u32 是 udiv），这里没有
// 一行写着「如果是 i32」。查不到就是 6，不是换一个算子硬发。
#proc meta_emit_chain(%base: #addr, %len: #bits<64>,
                      %name_lo: #bits<64>, %name_hi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                      %t_hi: #bits<64>, %first_lo: #bits<64>,
                      %first_hi: #bits<64>) -> #bits<32> {
  // `#proc NAME() -> <repr> {\n`
  %w1 = #call lainir_proc_word_write()
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lainir_write(%name_at, %name_len)
  %w3 = #call lainir_empty_params_write()
  %w4 = #call meta_emit_repr(%kind, %width)
  %w5 = #call lainir_open_body()

  // 整段值交给表达式发射器。它自己走到 `;` 为止，结果写在 +168（临时值下标，或
  // 「无」= 结果就是源码里那段，此时 +176/+184 是它的范围）。
  // 值的第一个操作数在这里的**出现位置**是 `(父组, 下标)`；表达式发射器要的正是它。
  %idx = #call meta_cursor_of_at(%base, %first_lo)
  %parent = #call meta_cursor_parent()
  %est = #call meta_emit_expr(%base, %len, %kind, %width, %t_lo, %t_hi,
                              %parent, %idx, 1, 0, 0, 0)
  %ebad = #ne[#bits<32>](%est, 0)
  #if %ebad {
    #return %est
  }
  %scratch = #call lain_meta_scratch_data()
  %ref = #call meta_cell_get(#lea(%scratch, 168, 1, 0))
  // `  #return <结果>\n}\n`
  %z1 = #call lainir_return_write()
  %rlo = #call meta_cell_get(#lea(%scratch, 176, 1, 0))
  %rhi = #call meta_cell_get(#lea(%scratch, 184, 1, 0))
  // 整个值就是一个字面量时，看它装不装得进这个类型（`let main: i8 = 300;` 曾经
  // 静默截断成 44）。
  %cfit = #call meta_literal_fits(%base, %len, %ref, %rlo, %rhi,
                                  %kind, %width)
  %cbad = #ne[#bits<32>](%cfit, 0)
  #if %cbad {
    #return %cfit
  }
  %z2 = #call meta_emit_ref2(%base, %len, %ref, %rlo, %rhi)
  %z3 = #call lainir_close_brace_write()
  #return 0
}

// 发一个「引用」：`%ref` 是「无」就把源码 `[lo, hi)` 发出去（数字照发、名字加 `%`），
// 否则发临时值名 `%r<n>`。两处要用同一个判断（左边的累积值和右边的操作数），所以单独
// 一个 proc。
#proc meta_emit_ref2(%base: #addr, %len: #bits<64>,
                     %ref: #bits<64>, %lo: #bits<64>, %hi: #bits<64>) -> #bits<32> {
  %is_src = #eq[#bits<64>](%ref, 0xFFFFFFFFFFFFFFFF)
  %st = #if %is_src -> (#bits<32>) {
    %w = #call meta_emit_operand(%base, %lo, %hi, %len)
    #yield %w
  } else {
    %w2 = #call meta_emit_temp_name(%ref)
    #yield %w2
  }
  #return %st
}

// 同 `meta_emit_ref2`，但把文本渲染进缓冲区并返回长度 —— 指令文本交给层 0 发。
#proc meta_render_ref2(%base: #addr, %len: #bits<64>,
                       %ref: #bits<64>, %lo: #bits<64>, %hi: #bits<64>,
                       %out: #addr) -> #bits<64> {
  %is_src = #eq[#bits<64>](%ref, 0xFFFFFFFFFFFFFFFF)
  %st = #if %is_src -> (#bits<64>) {
    %w = #call meta_render_operand(%base, %lo, %hi, %len, %out)
    #yield %w
  } else {
    %w2 = #call lainir_buf_temp(%out, 0, %ref)
    #yield %w2
  }
  #return %st
}

// `- <数字>` 是**一个**操作数（负数字面量），但它占**两个**节点：负号一个、数字一个。
// 只看源码字节，不问语义旁表 —— 负号是 `-`，后面紧跟着的必须是一段纯十进制数字
// （`-0x10` 不算，那是十进制以外的记法，还没有支持）。
#proc meta_is_neg_literal(%base: #addr, %len: #bits<64>,
                           %parent: #bits<64>, %index: #bits<64>) -> #bits<1> {
  %n = #call ast_child(%parent, %index)
  %at = #call meta_node_start(%n)
  %b = #call bs_byte_at(%base, %at, %len)
  %dash = #eq[#bits<8>](%b, 45)
  %r = #if %dash -> (#bits<1>) {
    %nx = #add[#bits<64>](%index, 1)
    %nn = #call ast_child(%parent, %nx)
    %nnone = #eq[#bits<64>](%nn, 0)
    %d = #if %nnone -> (#bits<1>) {
      #yield 0
    } else {
      %lo = #call meta_node_start(%nn)
      %hi = #add[#bits<64>](%lo, #call meta_node_len(%nn))
      %dg = #call meta_is_int_literal(%base, %lo, %hi, %len)
      #yield %dg
    }
    #yield %d
  } else {
    #yield 0
  }
  #return %r
}

// 负数字面量降级成 `  %r<n> = #sub[repr](0, <数字>)\n`，结果写进 `+168`。
//
// **LAINIR 的字面量是无符号十进制文本**，没有负号这种东西：直接把 `-5` 抄进产物会
// 得到一条读不出意义的指令。所以按语言的语义发一条减法（`0 - 5`），宽度取上下文
// 类型 —— 也就是说符号属性由类型定，不由字面量定。
#proc meta_emit_neg_temp(%base: #addr, %len: #bits<64>,
                          %kind: #bits<64>, %width: #bits<64>,
                          %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %ni = #add[#bits<64>](%index, 1)
  %nn = #call ast_child(%parent, %ni)
  %nlo = #call meta_node_start(%nn)
  %nhi = #add[#bits<64>](%nlo, #call meta_node_len(%nn))
  %tn = #call meta_next_temp()
  %sub = #data_addr meta_sym_sub
  %buf = #data_addr lainir_text_buffer
  %zlen = #call lainir_buf_uint(%buf, 0, 0)
  %n_at = #lea(%base, %nlo, 1, 0)
  %n_len = #sub[#bits<64>](%nhi, %nlo)
  %w8 = #call lainir_binary_op_at(2, %tn, %sub, 3, %kind, %width, %buf, %zlen, %n_at, %n_len)
  %sc = #call lain_meta_scratch_data()
  %s1 = #call meta_cell_put(#lea(%sc, 168, 1, 0), %tn)
  // 范围也写出去：外层拿到的是「一个操作数」的范围（数字那段），不是负号那段。
  %s2 = #call meta_cell_put(#lea(%sc, 176, 1, 0), %nlo)
  %s3 = #call meta_cell_put(#lea(%sc, 184, 1, 0), %nhi)
  #return 0
}

// 把一个操作数节点变成「可以引用的东西」，结果写进暂存区 `+168`：临时值下标，或者
// 「无」表示"直接用源码那段"。回状态码。
//
// 三种操作数：
//   - 一个 token（数字或名字）→ 「无」，让调用方去发源码那段
//   - 一个组 `( … )`          → 递归降级（括号里自己是一条表达式）
//   - 一次调用 `f(…)`         → 发 `  %r<n> = #call f(…)\n`
//
// 括号里以**兄弟链走完**收尾（`%need_semi` = 0），不是 `;`。
//
// 参数是**游标**（父组 + 下标），不是节点引用：形状、括号里的第一个操作数、
// 「被调用者后面那个实参组」全都要靠出现位置。`meta_after_operand` 也吃同样的游标。
#proc meta_operand_emit(%base: #addr, %len: #bits<64>,
                        %kind: #bits<64>, %width: #bits<64>,
                        %t_lo: #bits<64>, %t_hi: #bits<64>,
                        %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %neg = #call meta_is_neg_literal(%base, %len, %parent, %index)
  #if %neg {
    #return #call meta_emit_neg_temp(%base, %len, %kind, %width,
                                     %parent, %index)
  }
  %node = #call ast_child(%parent, %index)
  %form = #call meta_node_form(%parent, %index)
  // 点号形态（形状 6）在这里分走：两条路都要读左边那个名字的类型，发的都是
  // `#lea` 加 `#load`，与「一个 token」那条路完全不同。留给 token 那条路的话，
  // 只有点号左边会被发出去、右边被悄悄丢掉。
  //
  // 左边是**和类型名**、右边那个成员后面跟 `(`：那是变体投影（`Shape.Circle(s)` 取载荷）；
  // 其余情况是积类型的字段访问（`p.x`）。
  %is_field = #eq[#bits<64>](%form, 6)
  #if %is_field {
    %d_lo = #call meta_node_start(%node)
    %d_hi = #add[#bits<64>](%d_lo, #call meta_node_len(%node))
    %d_after = #call bs_skip_space(%base, %d_hi, %len)
    %d_f_lo = #call bs_skip_space(%base, #add[#bits<64>](%d_after, 1), %len)
    %d_f_hi = #call bs_skip_ident(%base, %d_f_lo, %len)
    %d_enum = #call meta_is_enum(%base, %len, %d_lo, %d_hi)
    %d_arg = #call meta_dotted_has_arg(%base, %len, %parent, %index)
    %d_proj = #and[#bits<1>](%d_enum, %d_arg)
    %d_st = #if %d_proj -> (#bits<32>) {
      %d_v = #call meta_emit_projection_temp(%base, %len, %parent, %index,
                                             %d_lo, %d_hi, %d_f_lo, %d_f_hi)
      #yield %d_v
    } else {
      %d_f = #call meta_emit_field_temp(%base, %len, %parent, %index)
      #yield %d_f
    }
    #return %d_st
  }
  %is_group = #eq[#bits<64>](%form, 2)
  %is_call = #eq[#bits<64>](%form, 5)
  %st = #if %is_group -> (#bits<32>) {
    // 括号组：里面那条表达式从**这个组**的第 0 个孩子开始（游标 = (组, 0)）。
    %st1 = #call meta_emit_expr(%base, %len, %kind, %width, %t_lo,
                                %t_hi, %node, 0, 0, 0, 0, 0)
    #yield %st1
  } else {
    %st2 = #if %is_call -> (#bits<32>) {
      %c_lo = #call meta_node_start(%node)
      %c_hi = #add[#bits<64>](%c_lo, #call meta_node_len(%node))
      // 被调用者的下一个兄弟就是实参组：游标前进一格。
      %grp = #call meta_cursor_next(%parent, %index)
      // 内建的内存操作（lea / load）形态与调用一样，先认它们；回 1 表示不是内建。
      %prim = #call meta_emit_builtin_temp(%base, %len, %kind, %width,
                                           %c_lo, %c_hi, %grp)
      %notprim = #eq[#bits<32>](%prim, 1)
      %st3 = #if %notprim -> (#bits<32>) {
        %call3 = #call meta_emit_call_temp(%base, %len, %kind, %width,
                                           %t_lo, %t_hi, %c_lo, %c_hi,
                                           %grp)
        #yield %call3
      } else {
        #yield %prim
      }
      #yield %st3
    } else {
      // 字节串字面量只在顶层 let 里能落成静态块（`data` 只能放顶层）；别处报 4,
      // 不能把它当普通 token 发成 `%"…"`。
      %str_at = #call meta_node_start(%node)
      %is_str = #call bs_is_byte(%base, %str_at, 34)
      #if %is_str {
        %str_fail = #call lain_meta_fail(4)
        #return %str_fail
      }
      // 一个 token：直接用源码那段。**源码范围也要写进 +176/+184** —— 组的那个分支
      // 是递归留下的范围，调用方一律从这里读，就不会把 `(42)` 的范围当成整个括号。
      %sc = #call lain_meta_scratch_data()
      %lo0 = #call meta_node_start(%node)
      %hi0 = #add[#bits<64>](%lo0, #call meta_node_len(%node))
      // 循环参数：这一轮里被赋过值就发那个临时值（参数名本身是进入本轮时的值）。有了
      // 这条，i = i + 1; acc = acc + i; 的第二条语句读到的是刚写下的 i，不是循环头的 i。
      %knl = #sub[#bits<64>](%hi0, %lo0)
      %kix = #call meta_loop_param_index(%base, %lo0, %knl)
      %isparam = #ne[#bits<64>](%kix, 0xFFFFFFFFFFFFFFFF)
      %s = #if %isparam -> (#bits<32>) {
        %pboff = #call meta_cell_get(#lea(%sc, 2456, 1, 0))
        %pb = #lea(%sc, %pboff, 1, 0)
        %kpslot = #add[#bits<64>](88, #mul[#bits<64>](%kix, 96))
        %kpq = #lea(%pb, %kpslot, 1, 0)
        %kcur = #call meta_cell_get(#lea(%kpq, 32, 1, 0))
        %khas = #ne[#bits<64>](%kcur, 0xFFFFFFFFFFFFFFFF)
        %sp = #if %khas -> (#bits<32>) {
          %pa = #call meta_cell_put(#lea(%sc, 168, 1, 0), %kcur)
          %pb2 = #call meta_cell_put(#lea(%sc, 176, 1, 0), 0)
          %pc2 = #call meta_cell_put(#lea(%sc, 184, 1, 0), 0)
          #yield 0
        } else {
          %pd = #call meta_cell_put(#lea(%sc, 168, 1, 0), 0xFFFFFFFFFFFFFFFF)
          %pe = #call meta_cell_put(#lea(%sc, 176, 1, 0), %lo0)
          %pf = #call meta_cell_put(#lea(%sc, 184, 1, 0), %hi0)
          #yield 0
        }
        #yield %sp
      } else {
        %s4 = #call meta_cell_put(#lea(%sc, 168, 1, 0), 0xFFFFFFFFFFFFFFFF)
        %s5 = #call meta_cell_put(#lea(%sc, 176, 1, 0), %lo0)
        %s6 = #call meta_cell_put(#lea(%sc, 184, 1, 0), %hi0)
        #yield 0
      }
      #yield %s
    }
    #yield %st2
  }
  #return %st
}

// 发 `  %r<n> = #call <被调用者>(<实参>…)\n`，把临时值下标写进 `+168`。回状态码。
//
// 子表达式里的调用要**先算进一个临时值**才能当操作数用 —— `f(1) + 2` 得先有
// `%r1 = #call f(1)`，才有 `%r2 = #add(%r1, 2)`。
#proc meta_emit_call_temp(%base: #addr, %len: #bits<64>,
                          %kind: #bits<64>, %width: #bits<64>,
                          %t_lo: #bits<64>, %t_hi: #bits<64>,
                          %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                          %args: #bits<64>) -> #bits<32> {
  %callee = #lea(%base, %callee_lo, 1, 0)
  %callee_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %decl = #call meta_scope_require_func(%callee, %callee_len)
  %unbound = #eq[#bits<64>](%decl, 0)
  #if %unbound { #return 9415 }
  // 先把实参降级好（子表达式的指令现在发），再写这一行 —— 反过来那些指令会插进
  // `#call f(` 后面。
  %ast = #call meta_args_prepare(%base, %len, %kind, %width, %t_lo,
                                 %t_hi, %args)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  %w1 = #call lainir_indent_write()
  %tn = #call meta_next_temp()
  %w2 = #call meta_emit_temp_name(%tn)
  %w3 = #call lainir_result_sep_write()
  %w4 = #call lainir_call_word_write()
  %c_at = #lea(%base, %callee_lo, 1, 0)
  %c_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %w5 = #call lainir_write(%c_at, %c_len)
  %w6 = #call lainir_open_paren_write()
  %wst = #call meta_args_write(%base, %len)
  %wbad = #ne[#bits<32>](%wst, 0)
  #if %wbad {
    #return %wst
  }
  %w7 = #call lainir_close_paren_write()
  %w8 = #call lainir_newline_write()
  %sc = #call lain_meta_scratch_data()
  %s = #call meta_cell_put(#lea(%sc, 168, 1, 0), %tn)
  #return 0
}

// 点号形态里成员名后面跟 `(` 吗？`Shape.Circle(s)` 跟（实参组再占一格），`p.x` 不跟。
#proc meta_dotted_has_arg(%base: #addr, %len: #bits<64>,
                           %parent: #bits<64>, %index: #bits<64>) -> #bits<1> {
  %node = #call ast_child(%parent, %index)
  %lo = #call meta_node_start(%node)
  %hi = #add[#bits<64>](%lo, #call meta_node_len(%node))
  %after = #call bs_skip_space(%base, %hi, %len)
  %f_lo = #call bs_skip_space(%base, #add[#bits<64>](%after, 1), %len)
  %f_hi = #call bs_skip_ident(%base, %f_lo, %len)
  %open = #call bs_skip_space(%base, %f_hi, %len)
  %r = #call bs_is_byte(%base, %open, 40)
  #return %r
}

// 一个操作数**之后**接着是哪个下标。**调用占两个节点**（被调用者 + 实参那个组），
// 所以要跳两格 —— 不跳的话 `f(1) + 2` 会把实参组当成算子，报一个跟真实原因无关的 4。
//
// 吃的是游标（父组 + 下标），回的是**下一个下标**（游标只会增加下标，规范 §2.1）；
// 形状问的是「这个位置」的形状，不涉及节点引用。
#proc meta_after_operand(%base: #addr, %len: #bits<64>,
                         %parent: #bits<64>, %index: #bits<64>) -> #bits<64> {
  %k = #call meta_node_form(%parent, %index)
  %is_call = #eq[#bits<64>](%k, 5)
  // 负数字面量也占两格（负号 + 数字）—— 不跳的话 `-5` 后面那一格会被当成算子。
  %is_neg = #call meta_is_neg_literal(%base, %len, %parent, %index)
  %skip2 = #or[#bits<1>](%is_call, %is_neg)
  %nx = #add[#bits<64>](%index, 1)
  %nx2 = #if %skip2 -> (#bits<64>) {
    %g2 = #add[#bits<64>](%nx, 1)
    #yield %g2
  } else {
    #yield %nx
  }
  // 点号形态至少占三格（值、点号、成员名）：成员后面跟 `(` 时那个实参组再占一格
  // （`Shape.Circle(s)`）—— 少跳一格会把点号或实参组当成下一个语句。
  %is_field = #eq[#bits<64>](%k, 6)
  %r = #if %is_field -> (#bits<64>) {
    %f_arg = #call meta_dotted_has_arg(%base, %len, %parent, %index)
    %f_n = #if %f_arg -> (#bits<64>) {
      %g4 = #add[#bits<64>](%nx, 3)
      #yield %g4
    } else {
      %g3 = #add[#bits<64>](%nx, 2)
      #yield %g3
    }
    #yield %f_n
  } else {
    #yield %nx2
  }
  #return %r
}

// 一个操作数位置：是带值 if（`1 + if c { a } else { b }`）就整条降级成一条临时值，
// 别的都走普通操作数路径。两条路都把「结果是谁」写进 `+168`/`+176`/`+184`，把
// **下一格**写进 `+2368`：普通路径的下一格由形状决定，if 的下一格是「整条 if 之后」，
// 只有 `meta_lower_if_value` 知道。调用方紧接着取走这两样。
#proc meta_operand_step(%base: #addr, %len: #bits<64>, %kind: #bits<64>,
                        %width: #bits<64>, %t_lo: #bits<64>, %t_hi: #bits<64>,
                        %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %c0 = #call ast_child(%parent, %index)
  %is_if0 = #call meta_node_is_word(%c0, %base, #data_addr meta_kw_if, 2)
  %sc0 = #call lain_meta_scratch_data()
  %r0 = #if %is_if0 -> (#bits<32>) {
    %tn0 = #call meta_next_temp()
    %st0 = #call meta_lower_if_value(%base, %len, %parent, %index,
                                     0, 0, %t_lo, %t_hi, 2, %tn0)
    %bad0 = #ne[#bits<32>](%st0, 0)
    %r1 = #if %bad0 -> (#bits<32>) {
      #yield %st0
    } else {
      %p1 = #call meta_cell_put(#lea(%sc0, 168, 1, 0), %tn0)
      %p2 = #call meta_cell_put(#lea(%sc0, 176, 1, 0), 0)
      %p3 = #call meta_cell_put(#lea(%sc0, 184, 1, 0), 0)
      #yield 0
    }
    #yield %r1
  } else {
    %st1 = #call meta_operand_emit(%base, %len, %kind, %width, %t_lo, %t_hi,
                                   %parent, %index)
    %bad1 = #ne[#bits<32>](%st1, 0)
    %r2 = #if %bad1 -> (#bits<32>) {
      #yield %st1
    } else {
      %nx1 = #call meta_after_operand(%base, %len, %parent, %index)
      %p4 = #call meta_cell_put(#lea(%sc0, 2368, 1, 0), %nx1)
      #yield 0
    }
    #yield %r2
  }
  #return %r0
}

// 一条表达式：`操作数 (算子 操作数)*`，左结合。`%first` 是第一个操作数节点。
//
// `%need_semi`：最外层要 1 —— 表达式必须**正好以 `;` 收尾**（少个 `;` 是错，不能当没
// 看见）；括号里的要 0 —— 那里以兄弟链走完（「无」）收尾。
//
// 结果放在暂存区：`+168` = 临时值下标，或「无」表示"结果就是源码里那段"（此时
// `+176`/`+184` 是它的范围）。**出参而不是返回值**，因为返回值要用来带状态码；这也是
// 这条表达式沿用的出参约定：调用方在返回后紧接着读取。
//
// 左结合：每读到一个算子，就把它左边累积的值和右边操作数发成一条指令。累积值一开始
// 可以是源码片段（`1 + 2` 的第一条就是 `#add(1, 2)`，不是先物化 `1`），发了第一条
// 指令之后就是临时值。
//
// 物理算子名由 `meta_op_resolve` 从**类型的 op 表**里查，这里没有一行写着「如果是 i32」。
// `%close`（闭合模式）决定这一条表达式的收尾由谁写：
//   0 = 只把结果写进 sheet（`+168`/`+176`/`+184`），调用方自己收 —— 顶层值那条路
//   1 = 绑定：最后一条指令**直接写成 `  %NAME = …`**（`%n_lo/%n_hi` 是名字的范围）；
//       没有算子时补一条 `  %NAME = #add[repr](<结果>, 0)`
//   2 = 返回：末尾写 `  #return <结果>`
//
// 1 和 2 是给函数体那条路用的：以前 `meta_lower_stmt` 另有一份只发**一个**算子的
// 老路径，`return a + b + c;` 会静默丢掉 `+ c`（实测 `%r2 = #add(%a, %b)`）。
// 参数是**游标**（`%parent` + 起始下标 `%index`），不是第一个操作数的节点引用：
// 这条链每一步都要前进一格，而「下一格」只有父组答得出来（规范 §2.1）。
#proc meta_emit_expr(%base: #addr, %len: #bits<64>,
                     %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                     %t_hi: #bits<64>, %parent: #bits<64>, %index: #bits<64>,
                     %need_semi: #bits<1>, %close: #bits<64>,
                     %n_lo: #bits<64>, %n_hi: #bits<64>) -> #bits<32> {
  %st = #loop e(%i: #bits<64> = %index, %have: #bits<1> = 0,
                %acc: #bits<64> = 0xFFFFFFFFFFFFFFFF, %alo: #bits<64> = 0,
                %ahi: #bits<64> = 0, %bound: #bits<1> = 0) -> (#bits<32>) {
    // 当前位置的孩子。游标越过末尾时 `ast_child` 回空引用 0 —— 与旧代码里那个
    // 「无节点」等价，但不再需要伪造一个节点：**末尾是范围，不是节点**。
    %c = #call ast_child(%parent, %i)
    %phase1 = #eq[#bits<1>](%have, 0)
    #if %phase1 {
      // 阶段一：%c 是一个操作数，它成为累积值
      %at = #call meta_node_start(%c)
      %b = #call bs_byte_at(%base, %at, %len)
      %isnone = #eq[#bits<64>](%c, 0)
      %issemi = #eq[#bits<8>](%b, 59)
      %empty = #or[#bits<1>](%isnone, %issemi)
      #if %empty {
        // 一个操作数都没有就结束了
        %f0 = #call lain_meta_fail(3)
        #break e(3)
      }
      %ost = #call meta_operand_step(%base, %len, %kind, %width, %t_lo,
                                     %t_hi, %parent, %i)
      %obad = #ne[#bits<32>](%ost, 0)
      #if %obad {
        #break e(%ost)
      }
      %sc = #call lain_meta_scratch_data()
      %ref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %alo1 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %ahi1 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      %nx = #call meta_cell_get(#lea(%sc, 2368, 1, 0))
      %nxclr = #call meta_cell_put(#lea(%sc, 2368, 1, 0), 0)
      #continue e(%nx, 1, %ref, %alo1, %ahi1, 0)
    }
    // 阶段二：%c 是算子、或者是表达式的终点
    %bat = #call meta_node_start(%c)
    %bb = #call bs_byte_at(%base, %bat, %len)
    // 算子符号的长度也要带下去：`==` 是双字节，查表按长度比。
    %bn = #call meta_node_len(%c)
    %isnone2 = #eq[#bits<64>](%c, 0)
    %issemi2 = #eq[#bits<8>](%bb, 59)
    %iscomma2 = #eq[#bits<8>](%bb, 44)
    %any1 = #or[#bits<1>](%isnone2, %issemi2)
    // `,` 也是终点：实参位置上一条表达式到逗号为止（见 `meta_emit_args`）。
    %anyend = #or[#bits<1>](%any1, %iscomma2)
    %endok = #if %need_semi -> (#bits<1>) {
      #yield %issemi2
    } else {
      // 块组 `{` 也是终点：`if a < b { … }` 的条件从下标+1 一路吃到块，块是**下一个
      // 兄弟**（不是操作数）。算子位置上出现一个花括号组只可能是这个意思 ——
      // 操作数位置上的组在阶段一就被吃掉了。
      //
      // 只在**别的终点都不成立**时才去看这个节点：走到了兄弟链末尾时 `%c` 是空
      // 引用，对它取分隔符会撞上「空引用不是节点」那条拒码。
      %ends = #if %anyend -> (#bits<1>) {
        #yield 1
      } else {
        %iskind2 = #eq[#bits<64>](#call meta_node_kind(%c), 2)
        %isbrace = #eq[#bits<8>](#call ast_delim(%c), 123)
        %isblock = #and[#bits<1>](%iskind2, %isbrace)
        #yield %isblock
      }
      #yield %ends
    }
    #if %endok {
      %sc2 = #call lain_meta_scratch_data()
      %s1 = #call meta_cell_put(#lea(%sc2, 168, 1, 0), %acc)
      %s2 = #call meta_cell_put(#lea(%sc2, 176, 1, 0), %alo)
      %s3 = #call meta_cell_put(#lea(%sc2, 184, 1, 0), %ahi)
      // 终点**下标**也带出去：调用方（实参那个循环）要靠它找下一个实参从哪开始。
      // 带下标而不是节点引用 —— 位置是游标的一半，引用不是。
      %s4 = #call meta_cell_put(#lea(%sc2, 192, 1, 0), %i)
      // 闭合模式在这一条语句的末尾收尾（模式 0 什么都不做，调用方自己收）。
      %cl = #call meta_emit_close(%base, %len, %close, %bound, %acc,
                                  %alo, %ahi, %kind, %width, %t_lo, %t_hi,
                                  %n_lo, %n_hi)
      %clbad = #ne[#bits<32>](%cl, 0)
      #if %clbad {
        #break e(%cl)
      }
      #break e(0)
    }
    %isop = #call bs_is_operator(%base, %bat, %len, %bn)
    %notop = #eq[#bits<1>](%isop, 0)
    #if %notop {
      // 既不是算子也不是终点：`1 + 2 3` 之类
      %f1 = #call lain_meta_fail(4)
      #break e(4)
    }
    // `x as T`：右边是**类型名**，不是值。目标类型决定发哪条指令 —— 变宽 `#zext`、
    // 变窄 `#trunc`、等宽补一条加零复制（等宽上 zext/trunc 都不是合法变换）。
    // 转换后的类型**不回填**给后面的算子：循环携带的是绑定/返回的上下文类型，
    // 所以 `x as i64 + y` 里那个 `+` 仍按操作数自己的类型查表。
    %bn2 = #eq[#bits<64>](%bn, 2)
    %asw = #call meta_bytes_equal(#lea(%base, %bat, 1, 0),
                                  #data_addr meta_kw_as, 2)
    %is_as = #and[#bits<1>](%bn2, %asw)
    #if %is_as {
      %rti = #add[#bits<64>](%i, 1)
      %rtn = #call ast_child(%parent, %rti)
      %rtn_none = #eq[#bits<64>](%rtn, 0)
      #if %rtn_none {
        // `as` 后面没有类型名
        %fa1 = #call lain_meta_fail(4)
        #break e(4)
      }
      %rtn_at = #call meta_node_start(%rtn)
      %rtn_b = #call bs_byte_at(%base, %rtn_at, %len)
      %rtn_semi = #eq[#bits<8>](%rtn_b, 59)
      #if %rtn_semi {
        %fa1b = #call lain_meta_fail(4)
        #break e(4)
      }
      %rtn_hi = #add[#bits<64>](%rtn_at, #call meta_node_len(%rtn))
      %atid = #call meta_type_resolve(%base, %len, %rtn_at, %rtn_hi)
      %atid_none = #eq[#bits<64>](%atid, 0)
      #if %atid_none {
        // 类型名不认识：与别处一样报「没有这个名字」
        %fa2 = #call lain_meta_fail(5)
        #break e(5)
      }
      %atk = #call meta_tid_repr_kind(%atid)
      %a_bits = #eq[#bits<64>](%atk, 0)
      #if %a_bits {
        %atw = #call meta_tid_repr_width(%atid)
        // 源宽度优先取操作数**自己**的类型（参数名），取不到（字面量、临时值）才用
        // 传进来的上下文宽度。
        // 操作数是**源码里的值**（`%acc` = 无）时它自己有名字，可以查类型；是临时值
        // 时没有类型来源，只能用上下文宽度。
        %acc_srcf = #eq[#bits<64>](%acc, 0xFFFFFFFFFFFFFFFF)
        %srcw = #if %acc_srcf -> (#bits<64>) {
          %alt_sc = #call lain_meta_scratch_data()
          %aln = #call meta_node_at(%base, %alo)
          %alt = #call meta_word_type_name(%base, %len, %aln)
          %alt_miss = #eq[#bits<64>](%alt, 0)
          %sw = #if %alt_miss -> (#bits<64>) {
            #yield %width
          } else {
            %alt_hi = #call meta_cell_get(#lea(%alt_sc, 0, 1, 0))
            %asid = #call meta_type_resolve(%base, %len, %alt, %alt_hi)
            %asw2 = #call meta_tid_repr_width(%asid)
            #yield %asw2
          }
          #yield %sw
        } else {
          #yield %width
        }
        %widen = #ult[#bits<64>](%srcw, %atw)
        %narrow = #ugt[#bits<64>](%srcw, %atw)
        // 出参名前缀与通用算子那条路同一个判断：绑定模式的最后一条直接写 %NAME。
        %anx = #call meta_after_operand(%base, %len, %parent, %rti)
        %anxc = #call ast_child(%parent, %anx)
        %aa_at = #call meta_node_start(%anxc)
        %aa_b = #call bs_byte_at(%base, %aa_at, %len)
        %aa_nl = #call meta_node_len(%anxc)
        %aa_op = #call bs_is_operator(%base, %aa_at, %len, %aa_nl)
        %alast = #eq[#bits<1>](%aa_op, 0)
        %a_is_bind = #eq[#bits<64>](%close, 1)
        %a_named = #and[#bits<1>](%a_is_bind, %alast)
        %atn = #if %a_named -> (#bits<64>) {
          %ay1 = #call lainir_st_pct_write()
          %an_at = #lea(%base, %n_lo, 1, 0)
          %an_len = #sub[#bits<64>](%n_hi, %n_lo)
          %ay2 = #call lainir_write(%an_at, %an_len)
          #yield 0xFFFFFFFFFFFFFFFF
        } else {
          %ay3 = #call lainir_indent_write()
          %an2 = #call meta_next_temp()
          %ay4 = #call meta_emit_temp_name(%an2)
          #yield %an2
        }
        %ay5 = #call lainir_result_sep_write()
        %ay6 = #if %widen -> (#bits<32>) {
          %azn = #data_addr meta_sym_zext
          %az1 = #call meta_emit_op_lit(%azn, 4, %atk, %atw)
          %az2 = #call meta_emit_ref2(%base, %len, %acc, %alo, %ahi)
          #yield %az2
        } else {
          %ay7 = #if %narrow -> (#bits<32>) {
            %atrd = #data_addr meta_sym_trunc
            %ay8 = #call meta_emit_op_lit(%atrd, 5, %atk, %atw)
            %ay9 = #call meta_emit_ref2(%base, %len, %acc, %alo, %ahi)
            #yield %ay9
          } else {
            // 等宽：加零就是复制
            %aadd = #data_addr meta_sym_add
            %ay10 = #call meta_emit_op_lit(%aadd, 3, %atk, %atw)
            %ay11 = #call meta_emit_ref2(%base, %len, %acc, %alo, %ahi)
            %ay12 = #call lainir_comma_write()
            %ay13 = #call lainir_zero_write()
            #yield 0
          }
          #yield %ay7
        }
        %ay14 = #call lainir_close_paren_write()
        %ay15 = #call lainir_newline_write()
        %abound = #if %a_named -> (#bits<1>) {
          #yield 1
        } else {
          #yield 0
        }
        #continue e(%anx, 1, %atn, 0, 0, %abound)
      } else {
        // `as` 现在只做定宽整数之间的转换
        %fa3 = #call lain_meta_fail(5)
        #break e(5)
      }
    }
    // 右操作数：游标前进一格。到头时 `ast_child` 回空引用 0。
    %rni = #add[#bits<64>](%i, 1)
    %rn = #call ast_child(%parent, %rni)
    %rn_at = #call meta_node_start(%rn)
    %rn_b = #call bs_byte_at(%base, %rn_at, %len)
    %rn_none = #eq[#bits<64>](%rn, 0)
    %rn_semi = #eq[#bits<8>](%rn_b, 59)
    %rn_end = #or[#bits<1>](%rn_none, %rn_semi)
    #if %rn_end {
      // 算子在，操作数没了（`1 + ;`）
      %f2 = #call lain_meta_fail(3)
      #break e(3)
    }
    // **顺序要紧**：右操作数先降级。它可能是括号，会递归，递归里又会
    // `meta_op_resolve` 一次；而 `meta_op_resolve` 把物理算子名放在 `+24`/`+32`，
    // `meta_emit_op_mid` 稍后才读。先查算子再降级的话，名字会被递归那一次覆盖。
    // 真出过：`let main: i32 = 12 / (2 + 1);` 发成 `%r2 = #add[#bits<32>](12, %r1)`
    // （该是 `#sdiv`），验证通过，算出来 15 而不是 4。
    %rst = #call meta_operand_step(%base, %len, %kind, %width, %t_lo,
                                   %t_hi, %parent, %rni)
    %rbad = #ne[#bits<32>](%rst, 0)
    #if %rbad {
      #break e(%rst)
    }
    %sc3 = #call lain_meta_scratch_data()
    // 右操作数之后接哪一格：这一格必须**紧接着**取走，后面那些类型查询虽然是叶子
    // 调用，也不该指望它们不碰暂存区。
    %rn_nx3 = #call meta_cell_get(#lea(%sc3, 2368, 1, 0))
    %rn_nxclr = #call meta_cell_put(#lea(%sc3, 2368, 1, 0), 0)
    %rref = #call meta_cell_get(#lea(%sc3, 168, 1, 0))
    %rn_lo2 = #call meta_cell_get(#lea(%sc3, 176, 1, 0))
    %rn_hi2 = #call meta_cell_get(#lea(%sc3, 184, 1, 0))
    // 操作数**自己**的类型优先：参数有类型。字面量没有类型，就退回传进来的
    // （绑定 / 返回的）类型 —— 这也是 plan §4 第 3 条那个没定的问题：`1 < 2` 的两个
    // 操作数是裸字面量，没人告诉编译器它们是 i32。
    %acc_tmp = #ne[#bits<64>](%acc, 0xFFFFFFFFFFFFFFFF)
    %l_tlo = #if %acc_tmp -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %ln = #call meta_node_at(%base, %alo)
      %lt = #call meta_word_type_name(%base, %len, %ln)
      #yield %lt
    }
    %scp = #call lain_meta_scratch_data()
    %l_thi = #call meta_cell_get(#lea(%scp, 0, 1, 0))
    %l_miss = #eq[#bits<64>](%l_tlo, 0xFFFFFFFFFFFFFFFF)
    %r_tlo = #if %l_miss -> (#bits<64>) {
      %rt = #call meta_operand_type_window(%base, %len, %parent, %rni)
      #yield %rt
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    %r_thi = #call meta_cell_get(#lea(%scp, 0, 1, 0))
    %r_miss = #eq[#bits<64>](%r_tlo, 0xFFFFFFFFFFFFFFFF)
    %l_hit = #eq[#bits<1>](%l_miss, 0)
    %r_hit = #eq[#bits<1>](%r_miss, 0)
    %any_hit = #or[#bits<1>](%l_hit, %r_hit)
    %tlo2 = #if %l_hit -> (#bits<64>) {
      #yield %l_tlo
    } else {
      %x5a = #if %r_hit -> (#bits<64>) {
        #yield %r_tlo
      } else {
        #yield %t_lo
      }
      #yield %x5a
    }
    %thi2 = #if %l_hit -> (#bits<64>) {
      #yield %l_thi
    } else {
      %x5b = #if %r_hit -> (#bits<64>) {
        #yield %r_thi
      } else {
        #yield %t_hi
      }
      #yield %x5b
    }
    // 指令那一格写的是**操作数**的宽度：`x < 2` 里两个操作数是 i32，所以发
    // `#slt[#bits<32>]`；结果天生 1 位，由验证器跟返回类型对。
    %kind2 = #if %any_hit -> (#bits<64>) {
      %tid2 = #call meta_type_resolve(%base, %len, %tlo2, %thi2)
      %info2 = #call meta_tid_repr(%tid2)
      %kk = #and[#bits<64>](%info2, 255)
      #yield %kk
    } else {
      #yield %kind
    }
    %width2 = #if %any_hit -> (#bits<64>) {
      %tid3 = #call meta_type_resolve(%base, %len, %tlo2, %thi2)
      %info3 = #call meta_tid_repr(%tid3)
      %ww = #and[#bits<64>](#lshr[#bits<64>](%info3, 8), 255)
      #yield %ww
    } else {
      #yield %width
    }
    // 两个操作数都是**裸字面量**时，先按上下文的类型查；上下文那个类型**查不到**这个
    // 算子（`bool` 的 op 表是空的），才退回**字面量自己的类型** —— 参考经典 C：十进制
    // 常量取「装得下它的第一个类型」，这里是 i32，装不下才 i64；`i8`/`u8`/`bool` 不进
    // 候选（C 也不会把字面量定成 char/short）。
    //
    // **只在这一种情况下退回**：有名字操作数时（`x < 2`，`x` 是 u32）退回 i32 会把
    // `ult` 发成 `slt` —— 那是静默给错值。
    %l_lit0 = #eq[#bits<64>](%acc, 0xFFFFFFFFFFFFFFFF)
    %l_dig = #call meta_is_int_literal(%base, %alo, %ahi, %len)
    %l_lit = #and[#bits<1>](%l_lit0, %l_dig)
    %r_lit0 = #eq[#bits<64>](%rref, 0xFFFFFFFFFFFFFFFF)
    %r_dig = #call meta_is_int_literal(%base, %rn_lo2, %rn_hi2, %len)
    %r_lit = #and[#bits<1>](%r_lit0, %r_dig)
    %both_lit = #and[#bits<1>](%l_lit, %r_lit)
    // `p + i`（地址 + 整数）：地址不是算子表里的类型，`+` 在这里就是
    // `#lea(基址, 下标, 1, 0)`。只认 `+` 一个符号，且操作数的类型得是 addr。
    %sp_b = #call bs_byte_at(%base, %bat, %len)
    %is_plus = #eq[#bits<8>](%sp_b, 43)
    // **只认左边的地址**：`1 + p` 不是地址算术（换过去是 `#lea(1, %p, 1, 0)`）。
    %a_tid = #if %l_hit -> (#bits<64>) {
      %a_t2 = #call meta_type_resolve(%base, %len, %l_tlo, %l_thi)
      #yield %a_t2
    } else {
      #yield 0
    }
    %a_info = #call meta_tid_repr(%a_tid)
    %a_kind = #and[#bits<64>](%a_info, 255)
    %a_is_addr = #eq[#bits<64>](%a_kind, 3)
    %is_lea = #and[#bits<1>](%is_plus, %a_is_addr)
    // 右边是地址、左边不是：`i + p` 不是地址算术，也不能按左边的整数类型发
    // `#add`（地址不是整数）。报 4。
    %rwt_lo = #call meta_operand_type_window(%base, %len, %parent, %rni)
    %rwt_hi = #call meta_cell_get(#lea(%scp, 0, 1, 0))
    %rwt_miss = #eq[#bits<64>](%rwt_lo, 0xFFFFFFFFFFFFFFFF)
    %rwtid = #if %rwt_miss -> (#bits<64>) {
      #yield 0
    } else {
      %rwt2 = #call meta_type_resolve(%base, %len, %rwt_lo, %rwt_hi)
      #yield %rwt2
    }
    %rwinfo = #call meta_tid_repr(%rwtid)
    %rkind = #and[#bits<64>](%rwinfo, 255)
    %r_is_addr = #eq[#bits<64>](%rkind, 3)
    %nonl = #eq[#bits<1>](%a_is_addr, 0)
    %rev_ok = #and[#bits<1>](%r_is_addr, %nonl)
    %rev_bad = #and[#bits<1>](%is_plus, %rev_ok)
    #if %rev_bad {
      %f3c = #call lain_meta_fail(4)
      #break e(4)
    }
    // 现在才查物理算子。从这往后到这条指令发完，**不能再有任何递归调用** ——
    // 否则 `+24`/`+32` 里的名字会被换掉。
    %sym = #lea(%base, %bat, 1, 0)
    %ctx_phys = #call meta_op_resolve(%base, %len, %tlo2, %thi2, %sym, %bn)
    %ctx_miss = #eq[#bits<64>](%ctx_phys, 0xFFFFFFFFFFFFFFFF)
    %try_default = #and[#bits<1>](%both_lit, %ctx_miss)
    %def_phys = #if %try_default -> (#bits<64>) {
      %p0 = #call meta_op_resolve_default(%base, %len, %sym, %bn,
                                          %alo, %ahi, %rn_lo2, %rn_hi2)
      #yield %p0
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    %def_miss = #eq[#bits<64>](%def_phys, 0xFFFFFFFFFFFFFFFF)
    %phys = #if %try_default -> (#bits<64>) {
      #yield %def_phys
    } else {
      #yield %ctx_phys
    }
    %miss = #if %try_default -> (#bits<1>) {
      #yield %def_miss
    } else {
      #yield %ctx_miss
    }
    %missreal = #and[#bits<1>](%miss, #eq[#bits<1>](%is_lea, 0))
    #if %missreal {
      %f3 = #call lain_meta_fail(6)
      #break e(6)
    }
    // 用了字面量自己的类型，**指令的类型实参也得跟着换** —— 默认类型都是 `bits<N>`
    // （kind 恒为 0），宽度由 `meta_op_resolve_default` 写在暂存区 `+488`。不换的话
    // `let b: bool = 1 < 2;` 会按绑定的 1 位发 `#slt[#bits<1>](1, 2)`：`2` 被截成 0，
    // 比较结果变成假 —— 验证通过、值是错的。
    %kind3 = #if %try_default -> (#bits<64>) {
      #yield 0
    } else {
      #yield %kind2
    }
    %width3 = #if %try_default -> (#bits<64>) {
      %wcell = #call meta_cell_get(#lea(%sc3, 488, 1, 0))
      #yield %wcell
    } else {
      #yield %width2
    }
    // 裸字面量当操作数：装不装得进这条指令的宽度（`let main: i8 = 1 + 300;` 曾经
    // 静默截断成 44）。量的是 `%kind3/%width3` —— 那才是这条指令真正的类型实参。
    %lfit = #call meta_literal_fits(%base, %len, %acc, %alo, %ahi,
                                    %kind3, %width3)
    %lbadfit = #ne[#bits<32>](%lfit, 0)
    #if %lbadfit {
      #break e(%lfit)
    }
    %rfit = #call meta_literal_fits(%base, %len, %rref, %rn_lo2, %rn_hi2,
                                    %kind3, %width3)
    %rbadfit = #ne[#bits<32>](%rfit, 0)
    #if %rbadfit {
      #break e(%rfit)
    }
    // 这条是不是整条链的最后一条？看右操作数后面那个位置还是不是算子。
    // **必须在 `meta_op_resolve` 之后做**：这几个都是只读树的叶子调用，不碰 `+24`/`+32`。
    %nx2c = #call ast_child(%parent, %rn_nx3)
    %a_at = #call meta_node_start(%nx2c)
    %a_b = #call bs_byte_at(%base, %a_at, %len)
    %a_nl = #call meta_node_len(%nx2c)
    %a_op = #call bs_is_operator(%base, %a_at, %len, %a_nl)
    %last = #eq[#bits<1>](%a_op, 0)
    %is_bind = #eq[#bits<64>](%close, 1)
    %named = #and[#bits<1>](%is_bind, %last)
    // `  %r<n> = ` 还是 `  %NAME = `。绑定模式的最后一条**直接写名字** —— 这样
    // `let y: i32 = 1 + 2;` 出来的还是一条指令（与老路径逐字节一样），而不是
    // "先 `%r1 = #add(1, 2)` 再复制进 `%y`"。
    %tn = #if %named -> (#bits<64>) {
      %y1 = #call lainir_st_pct_write()
      %n_at = #lea(%base, %n_lo, 1, 0)
      %n_len = #sub[#bits<64>](%n_hi, %n_lo)
      %y2 = #call lainir_write(%n_at, %n_len)
      // 名字就是这条指令的结果，没有临时值 —— 也**不占**临时值编号
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %y3 = #call lainir_indent_write()
      %n2 = #call meta_next_temp()
      %y4 = #call meta_emit_temp_name(%n2)
      #yield %n2
    }
    %x3 = #call lainir_result_sep_write()
    // 地址加整数发 `#lea(基址, 下标, 1, 0)`：没有类型实参，结果类型由验证器跟着
    // 那个地址操作数对。
    #if %is_lea {
      %q1 = #call lainir_lea_head_write()
      %q2 = #call meta_emit_ref2(%base, %len, %acc, %alo, %ahi)
      %q3 = #call lainir_comma_write()
      %q4 = #call meta_emit_ref2(%base, %len, %rref, %rn_lo2, %rn_hi2)
      %q5 = #call lainir_comma_write()
      %q6 = #call meta_emit_uint(1)
      %q7 = #call lainir_comma_write()
      %q8 = #call meta_emit_uint(0)
      %q9 = #call lainir_close_paren_write()
      %q10 = #call lainir_newline_write()
    } else {
      %x4 = #call meta_emit_op_mid(%kind3, %width3)
      %x5 = #call meta_emit_ref2(%base, %len, %acc, %alo, %ahi)
      %x6 = #call lainir_comma_write()
      %x7 = #call meta_emit_ref2(%base, %len, %rref, %rn_lo2, %rn_hi2)
      %x8 = #call lainir_close_paren_write()
      %x9 = #call lainir_newline_write()
    }
    // 绑定模式且这一条已经是最后一条：语句的收尾就是它，循环出去时别再补一条
    %bound2 = #if %named -> (#bits<1>) {
      #yield 1
    } else {
      #yield 0
    }
    #continue e(%rn_nx3, 1, %tn, 0, 0, %bound2)
  }
  #return %st
}
