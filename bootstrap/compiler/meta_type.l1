// Type-related Meta queries used by the lowering pipeline.
//
// These helpers inspect Meta environments and resolve a source-level type
// value.  They do not emit LAIN-IR.  Physical spelling remains in the lower
// and emit layers; this file only answers which Meta value a type name denotes.

#extern #proc bootstrap.allocate-pages(#bits<64> %size) -> #addr;
#extern #proc raw_is_nil(#addr %node) -> #bits<1>;
#extern #proc raw_node_start(#addr %node) -> #bits<64>;
#extern #proc raw_node_length(#addr %node) -> #bits<64>;
#extern #proc raw_node_next(#addr %node) -> #addr;
#extern #proc raw_node_first(#addr %node) -> #addr;
#extern #proc tool_source_data(#addr %source) -> #addr;
#extern #proc tool_byte_at(#addr %data, #bits<64> %index) -> #bits<8>;
#extern #proc meta_atom_equal(
  #addr %source, #addr %node, #addr %text, #bits<64> %length
) -> #bits<1>;
#extern #proc meta_value_nil() -> #addr;
#extern #proc meta_value_kind(#addr %value) -> #bits<32>;
#extern #proc meta_value_source(#addr %value) -> #addr;
#extern #proc meta_value_start(#addr %value) -> #bits<64>;
#extern #proc meta_value_length(#addr %value) -> #bits<64>;
#extern #proc meta_value_payload(#addr %value) -> #addr;
#extern #proc meta_value_module(
  #addr %source, #addr %name, #addr %group, #addr %environment
) -> #addr;
#extern #proc meta_value_type_with_namespace(
  #addr %source, #addr %name, #addr %binding, #addr %environment
) -> #addr;
#extern #proc meta_env_is_nil(#addr %environment) -> #bits<1>;
#extern #proc meta_env_parent(#addr %environment) -> #addr;
#extern #proc meta_env_binding_is_nil(#addr %binding) -> #bits<1>;
#extern #proc meta_env_new(#addr %parent) -> #addr;
#extern #proc meta_env_bind(
  #addr %environment, #addr %source, #addr %name, #addr %value
) -> #unit;
#extern #proc meta_env_lookup_local(
  #addr %environment, #addr %source, #addr %name
) -> #addr;
#extern #proc meta_env_lookup_path(
  #addr %environment, #addr %source, #addr %node
) -> #addr;
#extern #proc meta_env_lookup_text(
  #addr %environment, #addr %source, #addr %text, #bits<64> %length
) -> #addr;
#extern #proc meta_env_lookup_span(
  #addr %environment, #addr %source,
  #bits<64> %start, #bits<64> %length
) -> #addr;
#extern #proc meta_builtin_width_span(
  #addr %source, #bits<64> %start, #bits<64> %length
) -> #bits<64>;
#extern #proc meta_builtin_width(#addr %source, #addr %node) -> #bits<64>;
#extern #proc meta_type_is_address(#addr %source, #addr %node) -> #bits<1>;
#extern #proc meta_type_is_unit(#addr %source, #addr %node) -> #bits<1>;
#extern #proc meta_type_is_nominal(#addr %source, #addr %node) -> #bits<1>;
#extern #proc meta_type_end(#addr %source, #addr %node) -> #addr;
#extern #proc program_is_semicolon(#addr %source, #addr %node) -> #bits<1>;
#extern #proc program_is_generic_type_name(
  #addr %source, #addr %node
) -> #bits<1>;
#extern #proc program_find_type(
  #addr %unit, #addr %source, #addr %node
) -> #addr;
#extern #proc program_find_type_final_member(
  #addr %unit, #addr %source, #addr %node
) -> #addr;
#extern #proc program_find_type_in_source(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %node
) -> #addr;
#extern #proc program_type_width_value(#addr %type) -> #bits<64>;
#extern #proc program_type_new(
  #addr %source, #addr %name, #bits<64> %width, #bits<32> %status,
  #bits<64> %source_index, #addr %binding
) -> #addr;
#extern #proc program_append_type(#addr %unit, #addr %type) -> #unit;
#extern #proc program_unit_meta_environment(#addr %unit) -> #addr;
#extern #proc program_meta_bind_type(
  #addr %environment, #addr %source, #addr %let_node, #addr %type
) -> #unit;

// Transitional program_* names are kept so the lowering call sites can move
// incrementally.  The implementation now lives in this Meta-owned module.
#proc program_type_width(#addr %source, #addr %node) -> #bits<64> {
  #return #call meta_builtin_width(%source, %node)
}

#proc program_type_is_address(#addr %source, #addr %node) -> #bits<1> {
  #return #call meta_type_is_address(%source, %node)
}

#proc program_type_valid(#addr %source, #addr %node) -> #bits<1> {
  #if #call program_type_is_address(%source, %node) { #return 1 }
  #return #ne(#call program_type_width(%source, %node), 0)
}

#proc program_type_width_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<64> {
  #let %builtin: #bits<64> = #call program_type_width(%source, %node)
  #if #ne(%builtin, 0) { #return %builtin }
  #let %known: #addr = #call program_find_type(%unit, %source, %node)
  #if #call raw_is_nil(%known) {
    %known: #addr = #call program_find_type_final_member(
      %unit, %source, %node
    )
  }
  #if #call raw_is_nil(%known) { #return 0 }
  #return #call program_type_width_value(%known)
}

#proc program_type_valid_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<1> {
  // `std::type` is a Meta-only type.  It is valid in a declaration or
  // parameter position but has no physical width and must not lower as data.
  #if #eq(#call raw_is_nil(#call program_std_type_member(%source, %node)), 0) {
    #return 1
  }
  #if #call meta_type_is_unit(%source, %node) { #return 1 }
  #if #call program_type_is_address(%source, %node) { #return 1 }
  #if #ne(#call program_type_width(%source, %node), 0) { #return 1 }
  #if #call meta_type_is_nominal(%source, %node) { #return 1 }
  #let %arguments: #addr = #call raw_node_next(%node)
  #if #eq(#call raw_node_kind(%arguments), 2) {
    #if #eq(#call raw_node_delimiter(%arguments), 40) { #return 1 }
  }
  #return #eq(
    #call raw_is_nil(#call program_find_type(%unit, %source, %node)), 0
  )
}

#proc program_type_is_address_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<1> {
  #if #call meta_type_is_unit(%source, %node) { #return 0 }
  #if #call program_type_is_address(%source, %node) { #return 1 }
  #let %arguments: #addr = #call raw_node_next(%node)
  #if #eq(#call raw_node_kind(%arguments), 2) {
    #if #eq(#call raw_node_delimiter(%arguments), 40) { #return 1 }
  }
  #let %known: #addr = #call program_find_type(%unit, %source, %node)
  #if #eq(#call raw_is_nil(%known), 0) {
    #return #eq(#call program_type_width_value(%known), 0)
  }
  #if #call meta_type_is_nominal(%source, %node) { #return 1 }
  #return 0
}

#proc program_std_type_member(#addr %source, #addr %node) -> #addr {
  #if #eq(#call meta_atom_equal(%source, %node, "std", 3), 1) {
  } else { #return #call meta_value_nil() }
  #let %colon1: #addr = #call raw_node_next(%node)
  #if #eq(#call meta_atom_equal(%source, %colon1, ":", 1), 1) {
  } else { #return #call meta_value_nil() }
  #let %colon2: #addr = #call raw_node_next(%colon1)
  #if #eq(#call meta_atom_equal(%source, %colon2, ":", 1), 1) {
  } else { #return #call meta_value_nil() }
  #let %member: #addr = #call raw_node_next(%colon2)
  #if #eq(#call meta_atom_equal(%source, %member, "type", 4), 1) {
    #return %member
  }
  #return #call meta_value_nil()
}

// The standard namespace is a normal Meta module.  Its binding is created
// once in the unit root environment from the first source spelling of
// `std::type`; ordinary `::` lookup resolves every later occurrence.
#proc program_bind_std_type_universe(
  #addr %unit, #addr %source, #addr %annotation
) -> #addr {
  #let %member: #addr = #call program_std_type_member(%source, %annotation)
  #if #call raw_is_nil(%member) { #return #call meta_value_nil() }
  #let %root: #addr = #call program_unit_meta_environment(%unit)
  #let %existing: #addr = #call meta_env_lookup_local(
    %root, %source, %annotation
  )
  #if #eq(#call meta_value_kind(%existing), 0) {
    #let %standard_environment: #addr = #call meta_env_new(%root)
    #let %type_value: #addr = #call meta_value_type_with_namespace(
      %source, %member, %member, %standard_environment
    )
    #let %standard: #addr = #call meta_value_module(
      %source, %annotation, %member, %standard_environment
    )
    #call meta_env_bind(%root, %source, %annotation, %standard)
    #call meta_env_bind(
      %standard_environment, %source, %member, %type_value
    )
  }
  #return #call meta_env_lookup_path(%root, %source, %annotation)
}

#proc program_is_type_binding(
  #addr %unit, #addr %source, #addr %let_node
) -> #bits<1> {
  #let %name: #addr = #call raw_node_next(%let_node)
  #let %colon: #addr = #call raw_node_next(%name)
  #let %annotation: #addr = #call raw_node_next(%colon)
  #if #call raw_is_nil(%annotation) { #return 0 }
  #let %type_universe: #addr = #call program_bind_std_type_universe(
    %unit, %source, %annotation
  )
  #if #eq(#call meta_value_kind(%type_universe), 0) { #return 0 }
  #return #eq(
    %type_universe,
    #call meta_env_lookup_path(
      #call program_unit_meta_environment(%unit), %source, %annotation
    )
  )
}

#proc program_type_binding_value(
  #addr %source, #addr %let_node
) -> #addr {
  #let %node: #addr = #call raw_node_next(%let_node)
  #loop declaration {
    #if #call raw_is_nil(%node) { #return %node }
    #if #call meta_atom_equal(%source, %node, "=", 1) {
      #return #call raw_node_next(%node)
    }
    #if #call program_is_semicolon(%source, %node) { #return %node }
    %node: #addr = #call raw_node_next(%node)
    #continue declaration
  }
}

#proc program_type_value_is_std_constructor(
  #addr %source, #addr %value
) -> #bits<1> {
  #if #eq(#call meta_atom_equal(%source, %value, "std", 3), 0) {
    #return 0
  }
  #let %colon1: #addr = #call raw_node_next(%value)
  #let %colon2: #addr = #call raw_node_next(%colon1)
  #return #call meta_atom_equal(%source, %colon2, ":", 1)
}

#proc program_type_value_is_constructor(
  #addr %source, #addr %value
) -> #bits<1> {
  #if #call program_type_value_is_std_constructor(%source, %value) {
    #return 1
  }
  #let %arguments: #addr = #call raw_node_next(%value)
  #if #call raw_is_nil(%arguments) { #return 0 }
  #if #ne(#call raw_node_kind(%arguments), 2) { #return 0 }
  #return #eq(#call raw_node_delimiter(%arguments), 40)
}

#proc program_collect_type_candidate(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %let_node
) -> #bits<32> {
  #let %name: #addr = #call raw_node_next(%let_node)
  #let %value: #addr = #call program_type_binding_value(%source, %let_node)
  #if #call raw_is_nil(%name) { #return 5117 }
  #if #call raw_is_nil(%value) { #return 5117 }
  #let %existing: #addr = #call program_find_type_in_source(
    %unit, %source, %source_index, %name
  )
  #if #eq(#call raw_is_nil(%existing), 0) {
    #if #call meta_type_is_nominal(%source, %value) { #return 0 }
    #if #call program_type_value_is_constructor(%source, %value) {
      #return 0
    }
    #return 5117
  }
  #let %width: #bits<64> = #call program_type_width(%source, %value)
  #let %status: #bits<32> = 0
  #if #eq(%width, 0) {
    #if #call program_type_is_address(%source, %value) {
      // Address aliases keep the physical address representation.
      %width: #bits<64> = 0
    } else {
    #if #call program_type_value_is_constructor(%source, %value) {
      %width: #bits<64> = 0
    } else {
      #if #call meta_type_is_nominal(%source, %value) {
        %width: #bits<64> = 0
      } else {
        #let %alias: #addr = #call program_find_type_in_source(
          %unit, %source, %source_index, %value
        )
        #if #call raw_is_nil(%alias) {
          #let %global_alias: #addr = #call program_find_type(
            %unit, %source, %value
          )
          %alias: #addr = %global_alias
        }
        #if #call raw_is_nil(%alias) {
          %status: #bits<32> = 5117
        } else {
          %width: #bits<64> = #call program_type_width_value(%alias)
        }
      }
    }
    }
  }
  #let %type: #addr = #call program_type_new(
    %source, %name, %width, %status, %source_index, %let_node
  )
  #call program_append_type(%unit, %type)
  #if #eq(%status, 0) {
    #if #eq(
      #call program_type_value_is_constructor(%source, %value), 0
    ) {
      #call program_meta_bind_type(
        #call program_unit_meta_environment(%unit),
        %source, %let_node, %type
      )
    } else {
      #if #call program_type_value_is_std_constructor(%source, %value) {
        #call program_meta_bind_type(
          #call program_unit_meta_environment(%unit),
          %source, %let_node, %type
        )
      }
    }
  }
  #return %status
}

#proc program_register_local_type(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %let_node
) -> #bits<32> {
  #let %name: #addr = #call raw_node_next(%let_node)
  #let %value: #addr = #call program_type_binding_value(%source, %let_node)
  #if #call raw_is_nil(%name) { #return 0 }
  #if #call raw_is_nil(%value) { #return 0 }
  #let %existing: #addr = #call program_find_type_in_source(
    %unit, %source, %source_index, %name
  )
  #if #eq(#call raw_is_nil(%existing), 0) { #return 0 }
  #let %width: #bits<64> = #call program_type_width(%source, %value)
  #let %type: #addr = #call program_type_new(
    %source, %name, %width, 0, %source_index, %let_node
  )
  #call program_append_type(%unit, %type)
  #return 0
}

#proc program_type_end(#addr %source, #addr %node) -> #addr {
  #return #call meta_type_end(%source, %node)
}

#proc meta_lookup_type_binding(
  #addr %environment, #addr %source, #addr %node
) -> #addr {
  #let %data: #addr = #call tool_source_data(%source)
  #let %start: #bits<64> = #call raw_node_start(%node)
  #let %length: #bits<64> = #call raw_node_length(%node)
  #let %current: #addr = %environment
  #let %depth: #bits<64> = 0
  #loop environments {
    #if #sge(%depth, 256) { #return #call meta_value_nil() }
    %depth: #bits<64> = #add(%depth, 1)
    #if #call meta_env_is_nil(%current) {
      #return #call meta_value_nil()
    }
    #let %binding: #addr = #load[#addr](
      #lea(base=%current, idx=0, scale=0, offset=16)
    )
    #loop bindings {
      #if #call meta_env_binding_is_nil(%binding) { #break bindings }
      #if #eq(
        #load[#bits<64>](#lea(base=%binding, idx=0, scale=0, offset=24)),
        %length
      ) {
        #let %binding_source: #addr = #load[#addr](
          #lea(base=%binding, idx=0, scale=0, offset=8)
        )
        #let %binding_data: #addr = #call tool_source_data(
          %binding_source
        )
        #let %index: #bits<64> = 0
        #let %same: #bits<1> = 1
        #loop compare {
          #if #sge(%index, %length) { #break compare }
          #if #ne(
            #call tool_byte_at(%data, #add(%start, %index)),
            #call tool_byte_at(
              %binding_data,
              #add(
                #load[#bits<64>](
                  #lea(base=%binding, idx=0, scale=0, offset=16)
                ),
                %index
              )
            )
          ) {
            %same: #bits<1> = 0
            #break compare
          }
          %index: #bits<64> = #add(%index, 1)
          #continue compare
        }
        #if %same {
          #return #load[#addr](
            #lea(base=%binding, idx=0, scale=0, offset=32)
          )
        }
      }
      %binding: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=40)
      )
      #continue bindings
    }
    %current: #addr = #call meta_env_parent(%current)
    #continue environments
  }
}

#proc meta_lookup_first_type_value(#addr %environment) -> #addr {
  #let %current: #addr = %environment
  #let %depth: #bits<64> = 0
  #loop environments {
    #if #sge(%depth, 256) { #return #call meta_value_nil() }
    %depth: #bits<64> = #add(%depth, 1)
    #if #call meta_env_is_nil(%current) {
      #return #call meta_value_nil()
    }
    #let %binding: #addr = #load[#addr](
      #lea(base=%current, idx=0, scale=0, offset=16)
    )
    #loop bindings {
      #if #call meta_env_binding_is_nil(%binding) { #break bindings }
      #let %value: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=32)
      )
      #if #eq(#call meta_value_kind(%value), 4) {
        #return %value
      }
      %binding: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=40)
      )
      #continue bindings
    }
    %current: #addr = #call meta_env_parent(%current)
    #continue environments
  }
}

#proc meta_lookup_concrete_type_value(
  #addr %environment, #addr %source
) -> #addr {
  #let %current: #addr = %environment
  #let %depth: #bits<64> = 0
  #loop environments {
    #if #sge(%depth, 256) { #return #call meta_value_nil() }
    %depth: #bits<64> = #add(%depth, 1)
    #if #call meta_env_is_nil(%current) {
      #return #call meta_value_nil()
    }
    #let %binding: #addr = #load[#addr](
      #lea(base=%current, idx=0, scale=0, offset=16)
    )
    #loop bindings {
      #if #call meta_env_binding_is_nil(%binding) { #break bindings }
      #let %value: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=32)
      )
      #if #eq(
        #load[#bits<64>](#lea(base=%binding, idx=0, scale=0, offset=24)),
        1
      ) {
        #let %binding_source: #addr = #load[#addr](
          #lea(base=%binding, idx=0, scale=0, offset=8)
        )
        #let %binding_data: #addr = #call tool_source_data(%binding_source)
        #if #eq(
          #call tool_byte_at(
            %binding_data,
            #load[#bits<64>](#lea(base=%binding, idx=0, scale=0, offset=16))
          ),
          84
        ) {
          #if #eq(#call meta_value_kind(%value), 4) {
            #let %value_source: #addr = #call meta_value_source(%value)
            #let %value_width: #bits<64> = #call meta_builtin_width_span(
              %value_source,
              #call meta_value_start(%value),
              #call meta_value_length(%value)
            )
            #if #ne(%value_width, 0) {
              #return %value
            }
          }
        }
      }
      %binding: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=40)
      )
      #continue bindings
    }
    %current: #addr = #call meta_env_parent(%current)
    #continue environments
  }
}

// Return the concrete `T` captured by a generic factory even when `T` is a
// record type.  `meta_lookup_concrete_type_value` intentionally filters for
// builtin-width values because it is also used by scalar inference; record
// projections need the nominal binding as well (`Vec(Unit)` -> `Unit`).
#proc meta_lookup_type_parameter_value(#addr %environment) -> #addr {
  #let %current: #addr = %environment
  #let %depth: #bits<64> = 0
  #loop environments {
    #if #sge(%depth, 256) { #return #call meta_value_nil() }
    %depth: #bits<64> = #add(%depth, 1)
    #if #call meta_env_is_nil(%current) {
      #return #call meta_value_nil()
    }
    #let %binding: #addr = #load[#addr](
      #lea(base=%current, idx=0, scale=0, offset=16)
    )
    #loop bindings {
      #if #call meta_env_binding_is_nil(%binding) { #break bindings }
      #let %value: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=32)
      )
      #if #eq(
        #load[#bits<64>](#lea(base=%binding, idx=0, scale=0, offset=24)),
        1
      ) {
        #let %binding_source: #addr = #load[#addr](
          #lea(base=%binding, idx=0, scale=0, offset=8)
        )
        #let %binding_data: #addr = #call tool_source_data(%binding_source)
        #if #eq(
          #call tool_byte_at(
            %binding_data,
            #load[#bits<64>](#lea(base=%binding, idx=0, scale=0, offset=16))
          ),
          84
        ) {
          #if #eq(#call meta_value_kind(%value), 4) {
            #return %value
          }
        }
      }
      %binding: #addr = #load[#addr](
        #lea(base=%binding, idx=0, scale=0, offset=40)
      )
      #continue bindings
    }
    %current: #addr = #call meta_env_parent(%current)
    #continue environments
  }
}

#proc meta_function_type_value(
  #addr %environment, #addr %source, #addr %type
) -> #addr {
  #let %nil: #addr = #call meta_value_nil()
  #if #eq(#call raw_is_nil(%environment), 0) {
    #let %path_value: #addr = #call meta_env_lookup_path(
      %environment, %source, %type
    )
    #if #ne(#call meta_value_kind(%path_value), 0) {
      #if #eq(#call meta_value_kind(%path_value), 4) {
        #return %path_value
      }
    }
    #if #call program_is_generic_type_name(%source, %type) {
      #let %resolved: #addr = #call meta_env_lookup_span(
        %environment, %source,
        #call raw_node_start(%type), #call raw_node_length(%type)
      )
      // The binding was created from the factory parameter node, while the
      // use site can come from a different RawAst source span.  Match the
      // actual identifier text as a final step so captured `T`/`U` values do
      // not disappear merely because their source offsets differ.
      #if #eq(#call meta_value_kind(%resolved), 0) {
      #let %type_text: #addr = #lea(
        base=#call tool_source_data(%source),
        idx=#call raw_node_start(%type), scale=1, offset=0
      )
        %resolved: #addr = #call meta_env_lookup_text(
          %environment, %source, %type_text,
          #call raw_node_length(%type)
        )
      }
      #if #ne(#call meta_value_kind(%resolved), 0) {
        #if #eq(#call meta_value_kind(%resolved), 4) {
          #let %resolved_source: #addr = #call meta_value_source(%resolved)
          #let %resolved_payload: #addr = #call meta_value_payload(%resolved)
          #let %payload_is_T: #bits<1> = #call meta_atom_equal(
            %resolved_source, %resolved_payload, "T", 1
          )
          #if %payload_is_T {
            #let %concrete: #addr = #call meta_lookup_concrete_type_value(
              %environment, %source
            )
            #if #eq(#call raw_is_nil(%concrete), 0) {
              #return %concrete
            }
          }
          // A generic parameter binding whose payload does not point at the
          // parameter name can carry a stale/overwritten payload (the span
          // and payload disagree).  Recover the concrete type parameter from
          // the environment instead of trusting the inconsistent payload.
          #if #eq(%payload_is_T, 0) {
            #if #ne(
              #call raw_node_start(%resolved_payload),
              #call meta_value_start(%resolved)
            ) {
              #let %concrete: #addr = #call meta_lookup_concrete_type_value(
                %environment, %source
              )
              #if #eq(#call raw_is_nil(%concrete), 0) {
                #return %concrete
              }
            }
          }
        }
      }
      #return %resolved
    }
  }
  #return %nil
}
