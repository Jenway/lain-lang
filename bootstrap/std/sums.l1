// 初代标准库 v0 —— 和类型：tag、载荷、投影。
//
// 和积类型同源（都是 align_up 累加出来的布局），多出来的只有**判别字段**：
//
//   tag     `#bits<8>`，偏移 0
//   载荷区  从 align_up(tag 大小, 最大对齐) 开始，所有变体共用
//   总大小  align_up(载荷区起点 + 最大载荷, 最大对齐)
//
// v0 限制：每个变体最多一个载荷字段（`Circle(i32)`），且 tag 固定 `#bits<8>`。
//
// 正文起点**从符号表取**（`meta_scope_body`），不回源码里搜——条目里存的就是
// 那条 enum 声明的节点。

// 这个类型名是不是 enum？用来区分积类型的字段访问和和类型的投影。
//
// 现在**只查作用域表**：条目里就写着这个名字是哪一种声明，不用去看它的正文。
#proc meta_is_enum(%src: #addr, %len: #bits<64>,
                   %name_lo: #bits<64>, %name_hi: #bits<64>) -> #bits<1> {
  %name = #lea(%src, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %i = #call meta_scope_find(%name, %name_len)
  %miss = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %r = #if %miss -> (#bits<1>) {
    #yield 0
  } else {
    %kind = #call meta_scope_kind(%i)
    %is = #eq[#bits<64>](%kind, 5)
    #yield %is
  }
  #return %r
}

// 走一遍变体，找 var_lo/var_hi 那一个，同时把最大载荷大小/对齐写进 scratch。
//   返回 packed：tag 0..7、kind 8..11、width 12..19、size 20..51、align 52..55、
//   命中 63。
//   没命中返回 0。v0 假设变体列表良构（名字后面可选 `(类型)`）。
#proc meta_enum_walk(%src: #addr, %len: #bits<64>,
                     %body: #bits<64>,
                     %var_lo: #bits<64>, %var_hi: #bits<64>,
                     %scratch: #addr) -> #bits<64> {
  %r = #loop vars(%at: #bits<64> = %body, %tag: #bits<64> = 0,
                  %maxsz: #bits<64> = 0, %maxal: #bits<64> = 1,
                  %hit: #bits<64> = 0) -> (#bits<64>) {
    %here = #call bs_skip_space(%src, %at, %len)
    %byte = #call bs_byte_at(%src, %here, %len)
    %is_close = #eq[#bits<8>](%byte, 125)
    #if %is_close {
      %s = #call meta_store_scratch(%scratch, %maxsz, %maxal)
      #break vars(%hit)
    }
    %name_hi = #call bs_skip_ident(%src, %here, %len)
    %paren = #call bs_skip_space(%src, %name_hi, %len)
    %pb = #call bs_byte_at(%src, %paren, %len)
    %has_payload = #eq[#bits<8>](%pb, 40)
    // 有载荷就读类型名，算大小/对齐；没有的话下面直接用字面量。
    #if %has_payload {
      %one = #add[#bits<64>](%paren, 1)
      %t_lo = #call bs_skip_space(%src, %one, %len)
      %t_hi = #call bs_skip_qualified(%src, %t_lo, %len)
      %tid = #call meta_type_resolve(%src, %len, %t_lo, %t_hi)
      // 同 records.l1：解析不出来是错，不是「大小 0」。报宿主状态通道。
      %bad_type = #eq[#bits<64>](%tid, 0)
      #if %bad_type {
        %f = #call lain_meta_fail(5)
        %st0 = #call meta_store_scratch(%scratch, %maxsz, %maxal)
        #break vars(0)
      }
      %tinfo = #call meta_tid_repr(%tid)
      %k = #and[#bits<64>](%tinfo, 255)
      %w = #and[#bits<64>](#lshr[#bits<64>](%tinfo, 8), 255)
      %sz = #call meta_tid_size(%tid)
      %al = #call meta_tid_align(%tid)
      %close = #call bs_skip_space(%src, %t_hi, %len)
      %after2 = #add[#bits<64>](%close, 1)
      // 名字匹配？
      %want = #sub[#bits<64>](%var_hi, %var_lo)
      %have = #sub[#bits<64>](%name_hi, %here)
      %len_ok = #eq[#bits<64>](%want, %have)
      %mine = #if %len_ok -> (#bits<1>) {
        %a = #lea(%src, %here, 1, 0)
        %b = #lea(%src, %var_lo, 1, 0)
        %eq = #call meta_bytes_equal(%a, %b, %want)
        #yield %eq
      } else {
        #yield 0
      }
      %packed = #call meta_pack_variant(%tag, %k, %w, %sz, %al)
      %new_hit = #if %mine -> (#bits<64>) {
        #yield %packed
      } else {
        #yield %hit
      }
      %bigsz = #ugt[#bits<64>](%sz, %maxsz)
      %nsz = #if %bigsz -> (#bits<64>) { #yield %sz } else { #yield %maxsz }
      %bigal = #ugt[#bits<64>](%al, %maxal)
      %nal = #if %bigal -> (#bits<64>) { #yield %al } else { #yield %maxal }
      %tag2 = #add[#bits<64>](%tag, 1)
      #continue vars(%after2, %tag2, %nsz, %nal, %new_hit)
    }
    // 没有载荷
    %want2 = #sub[#bits<64>](%var_hi, %var_lo)
    %have2 = #sub[#bits<64>](%name_hi, %here)
    %len_ok2 = #eq[#bits<64>](%want2, %have2)
    %mine2 = #if %len_ok2 -> (#bits<1>) {
      %a2 = #lea(%src, %here, 1, 0)
      %b2 = #lea(%src, %var_lo, 1, 0)
      %eq2 = #call meta_bytes_equal(%a2, %b2, %want2)
      #yield %eq2
    } else {
      #yield 0
    }
    %packed2 = #call meta_pack_variant(%tag, 0, 0, 0, 1)
    %hit2 = #if %mine2 -> (#bits<64>) {
      #yield %packed2
    } else {
      #yield %hit
    }
    %tag3 = #add[#bits<64>](%tag, 1)
    #continue vars(%paren, %tag3, %maxsz, %maxal, %hit2)
  }
  #return %r
}

// 把 (tag, kind, width, size, align) 打包；命中位置最高位。
#proc meta_pack_variant(%tag: #bits<64>, %kind: #bits<64>, %width: #bits<64>,
                        %size: #bits<64>, %align: #bits<64>) -> #bits<64> {
  %a = #or[#bits<64>](%tag, #shl[#bits<64>](%kind, 8))
  %b = #or[#bits<64>](%a, #shl[#bits<64>](%width, 12))
  %c = #or[#bits<64>](%b, #shl[#bits<64>](%size, 20))
  %d = #or[#bits<64>](%c, #shl[#bits<64>](%align, 52))
  %e = #or[#bits<64>](%d, 0x8000000000000000)
  #return %e
}

// 把最大载荷大小/对齐写进 scratch+0 / scratch+8。
#proc meta_store_scratch(%scratch: #addr, %maxsz: #bits<64>,
                        %maxal: #bits<64>) -> #bits<32> {
  #store[#bits<64>](%maxsz, %scratch)
  %p = #lea(%scratch, 8, 1, 0)
  #store[#bits<64>](%maxal, %p)
  #return 0
}

#proc meta_scratch_max_size(%scratch: #addr) -> #bits<64> {
  %v = #load[#bits<64>](%scratch)
  #return %v
}

#proc meta_scratch_max_align(%scratch: #addr) -> #bits<64> {
  %p = #lea(%scratch, 8, 1, 0)
  %v = #load[#bits<64>](%p)
  #return %v
}

// 载荷区起点 = align_up(tag 大小=1, 最大对齐)
#proc meta_enum_payload_off(%scratch: #addr) -> #bits<64> {
  %al = #call meta_scratch_max_align(%scratch)
  %off = #call bs_align_up(1, %al)
  #return %off
}

// 总大小 = align_up(载荷起点 + 最大载荷, 最大对齐)
#proc meta_enum_size(%scratch: #addr) -> #bits<64> {
  %al = #call meta_scratch_max_align(%scratch)
  %off = #call meta_enum_payload_off(%scratch)
  %sz = #call meta_scratch_max_size(%scratch)
  %sum = #add[#bits<64>](%off, %sz)
  %total = #call bs_align_up(%sum, %al)
  #return %total
}

// 和类型的名义类型 ID。布局复用已验证的变体扫描与最大载荷规则。
#proc meta_sum_type_id(%index: #bits<64>) -> #bits<64> {
  %src = #call meta_scope_word(%index, 0)
  %len = #call lain_meta_source_length(%src)
  %base = #call lain_meta_source_data(%src)
  %node = #call meta_scope_decl_node(%index)
  %pos = #call meta_node_start(%node)
  %src1 = #add[#bits<64>](%src, 1)
  %high = #shl[#bits<64>](%src1, 32)
  %owner = #or[#bits<64>](%high, #add[#bits<64>](%pos, 1))
  %scratch = #call lain_meta_scratch_data()
  %registered = #call meta_reg_lookup(%scratch, 2, %owner, 0)
  #if #ne[#bits<64>](%registered, 0) { #return %registered }
  %top = #call meta_cell_get(#lea(%scratch, 456, 1, 0))
  %cycle = #loop active_sum(%link: #bits<64> = %top) -> (#bits<1>) {
    #if #eq[#bits<64>](%link, 0) { #break active_sum(0) }
    %entry = #lea(%scratch, %link, 1, 0)
    %active_owner = #call meta_cell_get(%entry)
    #if #eq[#bits<64>](%active_owner, %owner) { #break active_sum(1) }
    %previous = #call meta_cell_get(#lea(%entry, 8, 1, 0))
    #continue active_sum(%previous)
  }
  #if #ne[#bits<1>](%cycle, 0) {
    %set_cycle = #call meta_cell_put(#lea(%scratch, 464, 1, 0), 1)
    %fail = #call lain_meta_fail(5)
    #return 0
  }
  %mark = #call meta_bump_mark()
  %frame = #call meta_bump_alloc(16)
  #if #eq[#bits<64>](%frame, 0xFFFFFFFFFFFFFFFF) { #return 0 }
  %frame_addr = #lea(%scratch, %frame, 1, 0)
  %save_owner = #call meta_cell_put(%frame_addr, %owner)
  %save_previous = #call meta_cell_put(#lea(%frame_addr, 8, 1, 0), %top)
  %push = #call meta_cell_put(#lea(%scratch, 456, 1, 0), %frame)
  %body = #call meta_decl_body(%base, %node)
  %walk = #call meta_enum_walk(%base, %len, %body, 0, 0, %frame_addr)
  %walk_status = #call lain_meta_status()
  %walk_failed = #ne[#bits<64>](%walk_status, 0)
  %max_size = #call meta_scratch_max_size(%frame_addr)
  %max_align = #call meta_scratch_max_align(%frame_addr)
  %payload_off = #call meta_layout_field_align_up_checked(1, %max_align)
  %payload_end = #call meta_layout_add_checked(%payload_off, %max_size)
  %total = #call meta_layout_field_align_up_checked(%payload_end, %max_align)
  %invalid = #or[#bits<1>](
      #eq[#bits<64>](%payload_off, 0xFFFFFFFFFFFFFFFF),
      #eq[#bits<64>](%payload_end, 0xFFFFFFFFFFFFFFFF))
  %invalid1 = #or[#bits<1>](%invalid,
      #eq[#bits<64>](%total, 0xFFFFFFFFFFFFFFFF))
  %invalid2 = #or[#bits<1>](%invalid1, %walk_failed)
  %id = #if %invalid2 -> (#bits<64>) {
    %recursive = #call meta_cell_get(#lea(%scratch, 464, 1, 0))
    #if #eq[#bits<64>](%recursive, 0) { %fail2 = #call lain_meta_fail(5) }
    #yield 0
  } else {
    %new_id = #call meta_intern(2, %owner, 0, %total, %max_align)
    #yield %new_id
  }
  %restore = #call meta_cell_put(#lea(%scratch, 456, 1, 0), %top)
  %release = #call meta_bump_release(%mark)
  #return %id
}

// --- 构造与投影 -----------------------------------------------------------
//
// `let c = Shape.Circle { 7 }` 和积类型的构造同形：一块静态存储 + 一条 tag 存
// + 一条载荷存。区别只在于「字段偏移」换成了「变体 tag + 载荷偏移」。
//
// `let v: i32 = Shape.Circle(c)` 没有积类型的对应物：积类型的字段访问是**一条
// `#load`**（偏移编译期就知道，字段一定在），和类型的投影要**先看判别字段**
// ——别的变体也有那块载荷区。v0 把不命中折叠成 0（全函数），不做 panic 路径。

// 走一遍声明，拿到变体的 tag/载荷形状；返回 0 表示没有这个变体。
#proc meta_sum_variant(%base: #addr, %len: #bits<64>,
                       %enum_lo: #bits<64>,
                       %enum_hi: #bits<64>, %var_lo: #bits<64>,
                       %var_hi: #bits<64>, %scratch: #addr) -> #bits<64> {
  // 正文起点**问符号表**（条目里存的是声明节点），不回源码里搜
  %body = #call meta_scope_body(%base, %enum_lo, %enum_hi, 5)
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  %info = #if %missing -> (#bits<64>) {
    #yield 0
  } else {
    %w = #call meta_enum_walk(%base, %len, %body, %var_lo, %var_hi, %scratch)
    #yield %w
  }
  #return %info
}

// `let NAME = Enum.Variant { 值 }`
#proc meta_lower_sum_construct(%base: #addr, %len: #bits<64>,
                               %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                               %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                               %var_lo: #bits<64>, %var_hi: #bits<64>,
                               %brace_at: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %info = #call meta_sum_variant(%base, %len, %enum_lo, %enum_hi, %var_lo,
                                 %var_hi, %scratch)
  %bit = #lshr[#bits<64>](%info, 63)
  %found = #eq[#bits<64>](%bit, 1)
  %status = #if %found -> (#bits<32>) {
    %tag = #and[#bits<64>](%info, 255)
    %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 15)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 12), 255)
    %psize = #and[#bits<64>](#lshr[#bits<64>](%info, 20), 0xFFFFFFFF)
    %poff = #call meta_enum_payload_off(%scratch)
    %total = #call meta_enum_size(%scratch)
    %bind_at = #lea(%base, %bind_lo, 1, 0)
    %bind_len = #sub[#bits<64>](%bind_hi, %bind_lo)

    %w1 = #call lainir_data_head()
    %w2 = #call lainir_write(%bind_at, %bind_len)
    %w3 = #call lainir_data_rw_head()
    %w4 = #call meta_emit_zeros(%total)
    %w5 = #call lainir_proc_head_open()

    %w6 = #call lainir_write(%bind_at, %bind_len)
    %w7 = #call lainir_addr_body_write()
    %w8 = #call lainir_base_assign_write()
    %w9 = #call lainir_write(%bind_at, %bind_len)
    %w10 = #call lainir_storage_suffix_write()

    // tag 是 `#bits<8>`，在偏移 0——这是 v0 的固定选择，不从声明读。
    %s1 = #call meta_emit_store(0, 8, %tag, 0, 0xFFFFFFFFFFFFFFFF)

    // 有载荷才发第二条 store。空变体（`Empty`）只有 tag。
    %has_payload = #ugt[#bits<64>](%psize, 0)
    %s2 = #if %has_payload -> (#bits<32>) {
      %raw_lo = #add[#bits<64>](%brace_at, 1)
      %v_lo = #call bs_skip_space(%base, %raw_lo, %len)
      %value = #call bs_read_uint(%base, %v_lo, %len)
      %s = #call meta_emit_store(%kind, %width, %value, %poff,
                                 0xFFFFFFFFFFFFFFFF)
      #yield %s
    } else {
      #yield 0
    }

    %w11 = #call lainir_return_base_close()
    #yield %s2
  } else {
    %f = #call lain_meta_fail(9)
    #yield 9
  }
  #return %status
}

// `let s: Shape = Shape.Circle { k };`（函数体里）：从**栈**上划一块（`#alloca`），
// tag 一条 store、载荷一条 store，绑定接 `%NAME = #lea(%r<n>, 0, 1, 0)`。与顶层那条
// `meta_lower_sum_construct`（静态 storage 加一条取址 proc）的区别就在这里。
//
// 载荷是**一条表达式**（`{ k }` 里那个 `k`），按操作数降级 —— 不按源码数字读，
// 所以函数参数与局部值都能当载荷。
#proc meta_lower_sum_construct_local(%base: #addr, %len: #bits<64>,
                                     %name_lo: #bits<64>, %name_hi: #bits<64>,
                                     %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                                     %var_lo: #bits<64>, %var_hi: #bits<64>,
                                     %parent: #bits<64>, %group: #bits<64>,
                                     %brace: #bits<64>,
                                     %is_ret: #bits<1>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %info = #call meta_sum_variant(%base, %len, %enum_lo, %enum_hi, %var_lo,
                                 %var_hi, %scratch)
  %bit = #lshr[#bits<64>](%info, 63)
  %found = #eq[#bits<64>](%bit, 1)
  %st = #if %found -> (#bits<32>) {
    %tag = #and[#bits<64>](%info, 255)
    %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 15)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 12), 255)
    %psize = #and[#bits<64>](#lshr[#bits<64>](%info, 20), 0xFFFFFFFF)
    %poff = #call meta_enum_payload_off(%scratch)
    %total = #call meta_enum_size(%scratch)
    %zero = #eq[#bits<64>](%total, 0)
    %s = #if %zero -> (#bits<32>) {
      // 没有可划的框：count 为 0 的 `#alloca` 被验证器拒（2024）
      %fz = #call lain_meta_fail(5)
      #yield 5
    } else {
      %n = #call meta_next_temp()
      %a1 = #call lainir_alloca_at(%n, 8, %total)
      // tag 固定在偏移 0：v0 的固定选择，不从声明读
      %t1 = #call meta_emit_store(0, 8, %tag, 0, %n)
      %has_payload = #ugt[#bits<64>](%psize, 0)
      %t2 = #if %has_payload -> (#bits<32>) {
        %ast = #call meta_operand_emit(%base, %len, %kind, %width, 0, 0,
                                       %parent, %group)
        %abad = #ne[#bits<32>](%ast, 0)
        %pst = #if %abad -> (#bits<32>) {
          #yield %ast
        } else {
          %sc2 = #call lain_meta_scratch_data()
          %pref = #call meta_cell_get(#lea(%sc2, 168, 1, 0))
          %plo = #call meta_cell_get(#lea(%sc2, 176, 1, 0))
          %phi = #call meta_cell_get(#lea(%sc2, 184, 1, 0))
          %vbuf = #data_addr lainir_text_buffer
          %vlen = #call meta_render_ref2(%base, %len, %pref, %plo, %phi,
                                         %vbuf)
          %vbad = #eq[#bits<64>](%vlen, 0xFFFFFFFFFFFFFFFF)
          %vst = #if %vbad -> (#bits<32>) {
            #yield 4
          } else {
            %w = #call meta_emit_store_text(%kind, %width, %vbuf, %vlen,
                                            %poff, %n)
            #yield %w
          }
          #yield %vst
        }
        #yield %pst
      } else {
        #yield 0
      }
      %tail = #if %is_ret -> (#bits<32>) {
        %rbuf = #data_addr lainir_text_buffer
        %rlen = #call lainir_buf_temp(%rbuf, 0, %n)
        %w10 = #call lainir_return_ref(%rbuf, %rlen)
        #yield 0
      } else {
        %buf2 = #data_addr lainir_text_buffer
        %tbuf = #lea(%buf2, 64, 1, 0)
        %tlen2 = #call lainir_buf_temp(%tbuf, 0, %n)
        %nbuf = #lea(%buf2, 128, 1, 0)
        %npct = #call lainir_buf_byte(%nbuf, 0, 37)
        %bind_at = #lea(%base, %name_lo, 1, 0)
        %bind_len = #sub[#bits<64>](%name_hi, %name_lo)
        %nlen = #call lainir_buf_bytes(%nbuf, %npct, %bind_at, %bind_len)
        %zbuf = #lea(%buf2, 180, 1, 0)
        %zlen = #call lainir_buf_uint(%zbuf, 0, 0)
        %w17 = #call lainir_lea_named(%nbuf, %nlen, %tbuf, %tlen2, %zbuf,
                                      %zlen, 1, 0)
        #yield 0
      }
      %tb = #ne[#bits<32>](%t2, 0)
      #if %tb {
        #return %t2
      }
      #yield %tail
    }
    #yield %s
  } else {
    // 没有这个变体名
    %fnf = #call lain_meta_fail(9)
    #yield 9
  }
  #return %st
}

// `let NAME: T = Enum.Variant(值)`：读 tag、比、命中才读载荷。
#proc meta_lower_sum_project(%base: #addr, %len: #bits<64>,
                            %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                            %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                            %var_lo: #bits<64>, %var_hi: #bits<64>,
                            %at: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %info = #call meta_sum_variant(%base, %len, %enum_lo, %enum_hi, %var_lo,
                                 %var_hi, %scratch)
  %bit = #lshr[#bits<64>](%info, 63)
  %found = #eq[#bits<64>](%bit, 1)
  %status = #if %found -> (#bits<32>) {
    %tag = #and[#bits<64>](%info, 255)
    %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 15)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 12), 255)
    %psize = #and[#bits<64>](#lshr[#bits<64>](%info, 20), 0xFFFFFFFF)
    %empty = #eq[#bits<64>](%psize, 0)
    %s = #if %empty -> (#bits<32>) {
      // 空变体没有载荷可投——这是错的输入，不是「0」。
      %f = #call lain_meta_fail(10)
      #yield 10
    } else {
      %poff = #call meta_enum_payload_off(%scratch)
      %one = #add[#bits<64>](%at, 1)
      %v_lo = #call bs_skip_space(%base, %one, %len)
      %v_hi = #call bs_skip_ident(%base, %v_lo, %len)
      %bind_at = #lea(%base, %bind_lo, 1, 0)
      %bind_len = #sub[#bits<64>](%bind_hi, %bind_lo)
      %var_at = #lea(%base, %v_lo, 1, 0)
      %var_len = #sub[#bits<64>](%v_hi, %v_lo)

      %w1 = #call lainir_proc_word_write()
      %w2 = #call lainir_write(%bind_at, %bind_len)
      %w3 = #call lainir_empty_params_write()
      %w4 = #call meta_emit_repr(%kind, %width)
      %w5 = #call lainir_bind_head_write()
      %w6 = #call lainir_write(%var_at, %var_len)

      %w7 = #call lainir_vproj_load_write()
      %w8 = #call meta_emit_uint(%tag)
      %w9 = #call lainir_vproj_if_write()
      %w10 = #call meta_emit_repr(%kind, %width)
      %w11 = #call lainir_vproj_lea_write()
      %w12 = #call meta_emit_uint(%poff)
      %w13 = #call lainir_vproj_value_write()
      %w14 = #call meta_emit_repr(%kind, %width)
      %w15 = #call lainir_vproj_tail_write()
      #yield 0
    }
    #yield %s
  } else {
    %f2 = #call lain_meta_fail(9)
    #yield 9
  }
  #return %status
}

// `Enum.Variant(值)` 当值（函数体内的变体投影）：判别字段读出来与 tag 比，命中才读
// 载荷，不命中回 0 —— v0 把不命中折叠成 0，不做 panic 路径。
//
// 与顶层那条路（`meta_lower_sum_project` 发一整条无名参数的 proc）的区别：这里的值来自
// 参数或局部值，所以发的是**三条指令加一条带值 `#if`**，就写在当前函数体里。
#proc meta_emit_projection_temp(%base: #addr, %len: #bits<64>,
                                %parent: #bits<64>, %index: #bits<64>,
                                %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                                %var_lo: #bits<64>,
                                %var_hi: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %info = #call meta_sum_variant(%base, %len, %enum_lo, %enum_hi, %var_lo,
                                 %var_hi, %scratch)
  %bit = #lshr[#bits<64>](%info, 63)
  %found = #eq[#bits<64>](%bit, 1)
  %st = #if %found -> (#bits<32>) {
    %tag = #and[#bits<64>](%info, 255)
    %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 15)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 12), 255)
    %psize = #and[#bits<64>](#lshr[#bits<64>](%info, 20), 0xFFFFFFFF)
    %empty = #eq[#bits<64>](%psize, 0)
    %s = #if %empty -> (#bits<32>) {
      // 空变体没有载荷可投
      %fe = #call lain_meta_fail(10)
      #yield 10
    } else {
      %poff = #call meta_enum_payload_off(%scratch)
      // 要投影的那个值就是实参组里的那条表达式（`Shape.Circle(s)` 的 `s`）
      %ai = #add[#bits<64>](%index, 3)
      %ast = #call meta_operand_emit(%base, %len, 3, 0, 0, 0, %parent, %ai)
      #if #ne[#bits<32>](%ast, 0) {
        #return %ast
      }
      %sc = #call lain_meta_scratch_data()
      %aref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %alo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %ahi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      // 缓冲区（`lainir_text_buffer`）：0 起是基址文本、64 起是 tag 的十进制文本、
      // 96 起是载荷地址文本。
      %buf = #data_addr lainir_text_buffer
      %blen = #call meta_render_ref2(%base, %len, %aref, %alo, %ahi, %buf)
      %bbad = #eq[#bits<64>](%blen, 0xFFFFFFFFFFFFFFFF)
      #if %bbad {
        #return 4
      }
      %tbuf = #lea(%buf, 64, 1, 0)
      %tlen = #call lainir_buf_uint(%tbuf, 0, %tag)

      //   %r<t> = #load[#bits<8>](<基址>, 0)
      //   %r<m> = #eq[#bits<8>](%r<t>, <tag>)
      //
      // 判别字段是**从基址读出来的一个字节**，不是基址本身：地址不是位串，拿它去
      // 查位类型的算子表会被验证器按类型不符拒（2005）。
      %tn = #call meta_next_temp()
      %l1 = #call lainir_load_at(%tn, 0, 8, %buf, %blen)
      %tref = #lea(%buf, 32, 1, 0)
      %tref_len = #call lainir_buf_temp(%tref, 0, %tn)
      %mn = #call meta_next_temp()
      %eqn = #data_addr lainir_eq_name
      %l2 = #call lainir_binary_op_at(2, %mn, %eqn, 2, 0, 8, %tref, %tref_len,
                                      %tbuf, %tlen)

      //   %r<r> = #if %r<m> -> (<repr>) {
      %rn = #call meta_next_temp()
      %h1 = #call lainir_indent_write()
      %h2 = #call lainir_temp_name_emit(%rn)
      %h4 = #call lainir_result_sep_write()
      %h5 = #call lainir_if_head_write()
      %h6 = #call lainir_temp_name_emit(%mn)
      %h7 = #call lainir_arrow_lp_write()
      %h8 = #call lainir_repr(%kind, %width)
      %h9 = #call lainir_close_paren_write()
      %h10 = #call lainir_open_body()

      //     %r<p> = #lea(<基址>, 0, 1, <载荷偏移>)
      //     %r<v> = #load[<repr>](%r<p>, 0)
      //     #yield %r<v>
      %pn = #call meta_next_temp()
      %zbuf = #data_addr lainir_zero
      %l3 = #call lainir_lea_at_i(4, %pn, %buf, %blen, %zbuf, 1, 1, %poff)
      %pbuf = #lea(%buf, 96, 1, 0)
      %plen = #call lainir_buf_temp(%pbuf, 0, %pn)
      %vn = #call meta_next_temp()
      %l4 = #call lainir_load_at_i(4, %vn, %kind, %width, %pbuf, %plen)
      %y1 = #call lainir_yield_write()
      %y2 = #call lainir_temp_name_emit(%vn)
      %y3 = #call lainir_newline_write()

      //   } else {
      //     #yield 0
      //   }
      %e1 = #call lainir_else_write()
      %e2 = #call lainir_yield_write()
      %e3 = #call lainir_zero_write()
      %e4 = #call lainir_newline_write()
      %e5 = #call lainir_close_line_write()

      // 结果就是那条 `#if` 的临时值
      %r1 = #call meta_cell_put(#lea(%sc, 168, 1, 0), %rn)
      %r2 = #call meta_cell_put(#lea(%sc, 176, 1, 0), 0)
      %r3 = #call meta_cell_put(#lea(%sc, 184, 1, 0), 0)
      #yield 0
    }
    #yield %s
  } else {
    // 没有这个变体名
    %fnf = #call lain_meta_fail(9)
    #yield 9
  }
  #return %st
}

// `Enum.Variant { ... }` 还是 `Enum.Variant(v)`？`at` 是点号之后。
#proc meta_lower_sum_access(%base: #addr, %len: #bits<64>,
                            %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                            %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                            %at: #bits<64>) -> #bits<32> {
  %var_lo = #call bs_skip_space(%base, %at, %len)
  %var_hi = #call bs_skip_ident(%base, %var_lo, %len)
  %after = #call bs_skip_space(%base, %var_hi, %len)
  %b = #call bs_byte_at(%base, %after, %len)
  %is_brace = #eq[#bits<8>](%b, 123)
  %status = #if %is_brace -> (#bits<32>) {
    %s1 = #call meta_lower_sum_construct(%base, %len, %bind_lo, %bind_hi,
                                         %enum_lo, %enum_hi, %var_lo, %var_hi,
                                         %after)
    #yield %s1
  } else {
    %s2 = #call meta_lower_sum_project(%base, %len, %bind_lo, %bind_hi,
                                       %enum_lo, %enum_hi, %var_lo, %var_hi,
                                       %after)
    #yield %s2
  }
  #return %status
}

// --- 发射 -----------------------------------------------------------------

// 发一个 `<Enum>__<Variant><后缀>() -> #bits<64> { #return <value> }`
#proc meta_emit_enum_case(%base: #addr, %enum_lo: #bits<64>,
                          %enum_hi: #bits<64>, %var_lo: #bits<64>,
                          %var_hi: #bits<64>, %suf: #addr, %suf_len: #bits<64>,
                          %value: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %d = #data_addr meta_dsep
  %e_at = #lea(%base, %enum_lo, 1, 0)
  %e_len = #sub[#bits<64>](%enum_hi, %enum_lo)
  %a1 = #call lainir_buf_bytes(%buf, 0, %e_at, %e_len)
  %a2 = #call lainir_buf_bytes(%buf, %a1, %d, 2)
  %v_at = #lea(%base, %var_lo, 1, 0)
  %v_len = #sub[#bits<64>](%var_hi, %var_lo)
  %a3 = #call lainir_buf_bytes(%buf, %a2, %v_at, %v_len)
  %nlen = #call lainir_buf_bytes(%buf, %a3, %suf, %suf_len)
  %h = #call lainir_proc_head_full(%buf, %nlen, %buf, 0, 0, 64)
  %o = #call lainir_open_body()
  %r = #call lainir_return_uint(%value)
  %c = #call lainir_close_body()
  #return 0
}

// 逐变体发 `<V>_tag`，有载荷的再发 `<V>_off`。
#proc meta_emit_enum_variants(%base: #addr, %len: #bits<64>,
                              %enum_lo: #bits<64>, %enum_hi: #bits<64>,
                              %body: #bits<64>, %poff: #bits<64>) -> #bits<32> {
  %tag_suf = #data_addr meta_etag
  %off_suf = #data_addr meta_eoff
  %st = #loop vars(%at: #bits<64> = %body, %tag: #bits<64> = 0) -> (#bits<32>) {
    %here = #call bs_skip_space(%base, %at, %len)
    %byte = #call bs_byte_at(%base, %here, %len)
    %is_close = #eq[#bits<8>](%byte, 125)
    #if %is_close {
      #break vars(0)
    }
    %name_hi = #call bs_skip_ident(%base, %here, %len)
    %paren = #call bs_skip_space(%base, %name_hi, %len)
    %pb = #call bs_byte_at(%base, %paren, %len)
    %has_payload = #eq[#bits<8>](%pb, 40)
    %e1 = #call meta_emit_enum_case(%base, %enum_lo, %enum_hi, %here,
                                    %name_hi, %tag_suf, 4, %tag)
    %next = #if %has_payload -> (#bits<64>) {
      %one = #add[#bits<64>](%paren, 1)
      %t_lo = #call bs_skip_space(%base, %one, %len)
      %t_hi = #call bs_skip_ident(%base, %t_lo, %len)
      %close = #call bs_skip_space(%base, %t_hi, %len)
      %past = #add[#bits<64>](%close, 1)
      %e2 = #call meta_emit_enum_case(%base, %enum_lo, %enum_hi, %here,
                                      %name_hi, %off_suf, 4, %poff)
      #yield %past
    } else {
      #yield %paren
    }
    %tag2 = #add[#bits<64>](%tag, 1)
    #continue vars(%next, %tag2)
  }
  #return %st
}

// `enum NAME { V1 V2(T) ... }` —— 发出每个变体的 tag、载荷偏移，和总大小。
#proc meta_lower_enum(%base: #addr, %len: #bits<64>,
                      %kw_at: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %after = #add[#bits<64>](%kw_at, 4)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %body = #call meta_scope_body(%base, %name_lo, %name_hi, 5)
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  %status = #if %missing -> (#bits<32>) {
    %f0 = #call lain_meta_fail(4)
    #yield 4
  } else {
    // 第一遍只为把最大载荷大小/对齐算进 scratch（第二个参数给 0 表示不找变体）
    %pass1 = #call meta_enum_walk(%base, %len, %body, 0, 0, %scratch)
    %enum_error = #call lain_meta_status()
    %valid = #eq[#bits<64>](%enum_error, 0)
    %lowered = #if %valid -> (#bits<32>) {
      %poff = #call meta_enum_payload_off(%scratch)
      %size = #call meta_enum_size(%scratch)
      %s1 = #call meta_emit_enum_variants(%base, %len, %name_lo, %name_hi,
                                          %body, %poff)
      %s2 = #call meta_emit_size(%base, %name_lo, %name_hi, %size)
      #yield %s1
    } else {
      %code = #trunc[#bits<32>](%enum_error)
      #yield %code
    }
    #yield %lowered
  }
  #return %status
}
