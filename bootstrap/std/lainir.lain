func lainir_write(text: addr, length: u64) -> u32 {
  let status: u32 = lain_meta_emit_write(text, length);
  return status;
}

func lainir_reset() -> u32 {
  let grant: u32 = meta_region_scratch_window();
  let scratch: addr = lain_meta_scratch_data();
  let zero: u32 = meta_cell_put(scratch + 144, 0);
  let status: u32 = lain_meta_emit_reset();
  return status;
}

func lainir_text() -> addr {
  let text: addr = lain_meta_emit_data();
  return text;
}

func lainir_length() -> u64 {
  let length: u64 = lain_meta_emit_length();
  return length;
}

func lainir_proc_begin(name: addr, name_length: u64) -> u32 {
  let a: addr = symbol_addr("lainir_proc_storage");
  let w1: u32 = lainir_write(a, 6);
  let w2: u32 = lainir_write(name, name_length);
  let b: addr = symbol_addr("lainir_open_storage");
  let w3: u32 = lainir_write(b, 6);
  let c: addr = symbol_addr("lainir_bits32_storage");
  let w4: u32 = lainir_write(c, 9);
  let d: addr = symbol_addr("lainir_body_storage");
  let w5: u32 = lainir_write(d, 3);
  return w5;
}

func lainir_return(value: u64) -> u32 {
  let a: addr = symbol_addr("lainir_return_text_storage");
  let w1: u32 = lainir_write(a, 10);
  let w2: u32 = lainir_emit_uint(value);
  let b: addr = symbol_addr("lainir_newline_storage");
  let w3: u32 = lainir_write(b, 1);
  return w3;
}

func lainir_next_temp() -> u64 {
  let next: u64 = meta_next_temp();
  return next;
}

func lainir_binary(name: addr, name_length: u64, width: u64, lhs: addr, lhs_length: u64, rhs: addr, rhs_length: u64) -> u32 {
  let indent: addr = symbol_addr("lainir_indent_storage");
  let w0: u32 = lainir_write(indent, 2);
  let temp: u64 = lainir_next_temp();
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let w1: u32 = lainir_write(pct, 2);
  let w2: u32 = lainir_emit_uint(temp);
  let assign: addr = symbol_addr("lainir_assign_storage");
  let w3: u32 = lainir_write(assign, 4);
  let opcode: u32 = lainir_write(name, name_length);
  let open: addr = symbol_addr("lainir_bits_open_storage");
  let w4: u32 = lainir_write(open, 7);
  let w5: u32 = lainir_emit_uint(width);
  let close_type: addr = symbol_addr("lainir_close_type_storage");
  let w6: u32 = lainir_write(close_type, 3);
  let w7: u32 = lainir_write(lhs, lhs_length);
  let comma: addr = symbol_addr("lainir_comma_storage");
  let w8: u32 = lainir_write(comma, 2);
  let w9: u32 = lainir_write(rhs, rhs_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let w10: u32 = lainir_write(end, 2);
  return 0;
}

func lainir_unary(name: addr, name_length: u64, width: u64, value: addr, value_length: u64) -> u32 {
  let indent: addr = symbol_addr("lainir_indent_storage");
  let w0: u32 = lainir_write(indent, 2);
  let temp: u64 = lainir_next_temp();
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let w1: u32 = lainir_write(pct, 2);
  let w2: u32 = lainir_emit_uint(temp);
  let assign: addr = symbol_addr("lainir_assign_storage");
  let w3: u32 = lainir_write(assign, 4);
  let opcode: u32 = lainir_write(name, name_length);
  let open: addr = symbol_addr("lainir_bits_open_storage");
  let w4: u32 = lainir_write(open, 7);
  let w5: u32 = lainir_emit_uint(width);
  let close_type: addr = symbol_addr("lainir_close_type_storage");
  let w6: u32 = lainir_write(close_type, 3);
  let w7: u32 = lainir_write(value, value_length);
  let endnl: addr = symbol_addr("lainir_rparen_nl_storage");
  let w8: u32 = lainir_write(endnl, 2);
  return 0;
}

