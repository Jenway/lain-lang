  let w4: u32 = lainir_write(open, 7);
  let w5: u32 = lainir_emit_uint(width);
  let close: addr = symbol_addr("lainir_close_type_storage");
  let w6: u32 = lainir_write(close, 3);
  let wv0: u32 = lainir_write(name, name_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
