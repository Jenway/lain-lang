func lainir_loop_value(label: addr, label_length: u64, params: addr, params_length: u64, results: addr, results_length: u64) -> u32 {
  let t: u64 = lainir_next_temp();
  let s: u32 = lainir_line_start(t);
  let n: addr = symbol_addr("lainir_loop_name_storage");
  let a: u32 = lainir_write(n, 4);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(label, label_length);
  let lp: addr = symbol_addr("lainir_lparen_storage");
  let d: u32 = lainir_write(lp, 1);
  let e: u32 = lainir_write(params, params_length);
  let rp: addr = symbol_addr("lainir_close_rparen_storage");
  let f: u32 = lainir_write(rp, 1);
  let ar: addr = symbol_addr("lainir_arrow_open_storage");
  let g: u32 = lainir_write(ar, 5);
  let h: u32 = lainir_write(results, results_length);
  let i: u32 = lainir_write(rp, 1);
  let br: addr = symbol_addr("lainir_brace_nl_storage");
  let j: u32 = lainir_write(br, 3);
  return j;
}

func lainir_yield(values: addr, values_length: u64) -> u32 {
  let s: u32 = lainir_line_start(0);
  let n: addr = symbol_addr("lainir_yield_name_storage");
  let a: u32 = lainir_write(n, 5);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(values, values_length);
  let nl: addr = symbol_addr("lainir_newline_storage");
  let d: u32 = lainir_write(nl, 1);
  return d;
}

func lainir_break(label: addr, label_length: u64, args: addr, args_length: u64) -> u32 {
  let s: u32 = lainir_line_start(0);
  let n: addr = symbol_addr("lainir_break_name_storage");
  let a: u32 = lainir_write(n, 5);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(label, label_length);
  let zero: bool = args_length == 0;
  // 归档的 %rest 值 if 结果直接喂给 #return，改成平坦守卫：命中即 return 同一
  // 个值；两条路径都只发各自那串 `lainir_write`，顺序与副作用与旧 IR 一致。
  if zero {
    let nl: addr = symbol_addr("lainir_newline_storage");
    let w: u32 = lainir_write(nl, 1);
    return w;
  }
  let lp: addr = symbol_addr("lainir_lparen_storage");
  let d: u32 = lainir_write(lp, 1);
  let e: u32 = lainir_write(args, args_length);
  let rp: addr = symbol_addr("lainir_close_rparen_storage");
  let f: u32 = lainir_write(rp, 1);
  let nl2: addr = symbol_addr("lainir_newline_storage");
  let g: u32 = lainir_write(nl2, 1);
  return g;
}

func lainir_continue(label: addr, label_length: u64, args: addr, args_length: u64) -> u32 {
  let s: u32 = lainir_line_start(0);
  let n: addr = symbol_addr("lainir_continue_name_storage");
  let a: u32 = lainir_write(n, 8);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(label, label_length);
  let zero: bool = args_length == 0;
  // 归档 %rest 值 if 的结果直接喂给 #return：改写成平坦守卫，两支的求值顺序与
  // 副作用串完全一致（真支只写一个换行，假支写括号/实参/右括号/换行）。
  if zero {
    let nl: addr = symbol_addr("lainir_newline_storage");
    let w: u32 = lainir_write(nl, 1);
    return w;
  }
  let lp: addr = symbol_addr("lainir_lparen_storage");
  let d: u32 = lainir_write(lp, 1);
  let e: u32 = lainir_write(args, args_length);
  let rp: addr = symbol_addr("lainir_close_rparen_storage");
  let f: u32 = lainir_write(rp, 1);
  let nl2: addr = symbol_addr("lainir_newline_storage");
  let g: u32 = lainir_write(nl2, 1);
  return g;
}

func lainir_switch(width: u64, selector: addr, selector_length: u64, results: addr, results_length: u64) -> u32 {
  let t: u64 = lainir_next_temp();
  let s: u32 = lainir_line_start(t);
  let n: addr = symbol_addr("lainir_switch_name_storage");
  let a: u32 = lainir_write(n, 6);
  let bo: addr = symbol_addr("lainir_bits_open_storage");
  let b: u32 = lainir_write(bo, 7);
  let c: u32 = lainir_emit_uint(width);
  let cb: addr = symbol_addr("lainir_close_bracket_space_storage");
  let d: u32 = lainir_write(cb, 3);
  let e: u32 = lainir_write(selector, selector_length);
  let ar: addr = symbol_addr("lainir_arrow_open_storage");
  let f: u32 = lainir_write(ar, 5);
  let g: u32 = lainir_write(results, results_length);
  let rp: addr = symbol_addr("lainir_close_rparen_storage");
  let h: u32 = lainir_write(rp, 1);
  let br: addr = symbol_addr("lainir_brace_nl_storage");
  let i: u32 = lainir_write(br, 3);
  return i;
}

