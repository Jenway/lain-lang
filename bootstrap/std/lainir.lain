func lainir_load_named(name: addr, name_length: u64, kind: u64, width: u64, address: addr, address_length: u64) -> u32 {
  let ind: addr = symbol_addr("lainir_indent_storage");
  let a: u32 = lainir_write(ind, 2);
  let b: u32 = lainir_write(name, name_length);
  // 归档的 %as：`as` 是关键字，改名为 asn。
  let asn: addr = symbol_addr("lainir_assign_storage");
  let c: u32 = lainir_write(asn, 4);
  let n: addr = symbol_addr("lainir_load_name_storage");
  let d: u32 = lainir_write(n, 4);
  let lb: addr = symbol_addr("lainir_store_open_storage");
  let e: u32 = lainir_write(lb, 1);
  let rep: u32 = lainir_repr(kind, width);
  let cl: addr = symbol_addr("lainir_after_type_storage");
  let f: u32 = lainir_write(cl, 2);
  let g: u32 = lainir_write(address, address_length);
  let endnl: addr = symbol_addr("lainir_rparen_nl_storage");
  let h: u32 = lainir_write(endnl, 2);
  return h;
}

