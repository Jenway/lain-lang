func lainir_binary_op_named(name: addr, name_length: u64, op: addr, op_length: u64, kind: u64, width: u64, lhs: addr, lhs_length: u64, rhs: addr, rhs_length: u64) -> u32 {
  let ind: addr = symbol_addr("lainir_indent_storage");
  let a: u32 = lainir_write(ind, 2);
  let b: u32 = lainir_write(name, name_length);
  // 归档局部 %as 是保留字，改名 asx（同 bootstrap/std/funcs.lain），语义不变。
  let asx: addr = symbol_addr("lainir_result_sep_storage");
  let c: u32 = lainir_write(asx, 3);
  let d: u32 = lainir_op_prefix(op, op_length, kind, width);
  let e: u32 = lainir_write(lhs, lhs_length);
  let cm: addr = symbol_addr("lainir_comma_storage");
  let f: u32 = lainir_write(cm, 2);
  let g: u32 = lainir_write(rhs, rhs_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let h: u32 = lainir_write(end, 2);
  return h;
}

