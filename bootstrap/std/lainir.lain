func lainir_write(text: addr, length: u64) -> u32 {
  let status: u32 = lain_meta_emit_write(text, length);
  return status;
}

func lainir_ptr2int_at(width: u64, temp: u64, name: addr, name_length: u64) -> u32 {
  let indent: addr = symbol_addr("lainir_indent_storage");
  let w0: u32 = lainir_write(indent, 2);
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let w1: u32 = lainir_write(pct, 2);
  let w2: u32 = lainir_emit_uint(temp);
  let assign: addr = symbol_addr("lainir_assign_storage");
  let w3: u32 = lainir_write(assign, 4);
  // D-002：地址 ↔ 整数统一走 `#bitcast[#bits<W>]`。
  let n: addr = symbol_addr("lainir_bitcast_name_storage");
  let whash: u32 = lainir_write(n, 7);
  let open: addr = symbol_addr("lainir_bits_open_storage");
  let w4: u32 = lainir_write(open, 7);
  let w5: u32 = lainir_emit_uint(width);
  let close: addr = symbol_addr("lainir_close_type_storage");
  let w6: u32 = lainir_write(close, 3);
  let wv0: u32 = lainir_write(name, name_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let w8: u32 = lainir_write(end, 2);
  return 0;
}

func lainir_int2ptr_at(temp: u64, value: addr, value_length: u64) -> u32 {
  let indent: addr = symbol_addr("lainir_indent_storage");
  let w0: u32 = lainir_write(indent, 2);
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let w1: u32 = lainir_write(pct, 2);
  let w2: u32 = lainir_emit_uint(temp);
  let asg: addr = symbol_addr("lainir_assign_storage");
  let w3: u32 = lainir_write(asg, 4);
  // D-002：地址 ↔ 整数统一走 `#bitcast[#addr]`。
  let n: addr = symbol_addr("lainir_bitcast_name_storage");
  let w4: u32 = lainir_write(n, 7);
  let ty: addr = symbol_addr("lainir_addr_open_storage");
  let w5: u32 = lainir_write(ty, 8);
  let w6: u32 = lainir_write(value, value_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let w7: u32 = lainir_write(end, 2);
  return 0;
}

func lainir_load_at_i(indent: u64, temp: u64, kind: u64, width: u64, address: addr, address_length: u64) -> u32 {
  let a: u32 = lainir_spaces(indent);
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let b: u32 = lainir_write(pct, 2);
  let c: u32 = lainir_emit_uint(temp);
  let asx: addr = symbol_addr("lainir_assign_storage");
  let d: u32 = lainir_write(asx, 4);
  let n: addr = symbol_addr("lainir_load_name_storage");
  let e: u32 = lainir_write(n, 4);
  let lb: addr = symbol_addr("lainir_store_open_storage");
  let f: u32 = lainir_write(lb, 1);
  let rep: u32 = lainir_repr(kind, width);
  let cl: addr = symbol_addr("lainir_after_type_storage");
  let g: u32 = lainir_write(cl, 2);
  let v: u32 = lainir_write(address, address_length);
  let cm: addr = symbol_addr("lainir_comma_storage");
  let i: u32 = lainir_write(cm, 2);
  let z: u32 = lainir_emit_uint(0);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let h: u32 = lainir_write(end, 2);
  return h;
}

func lainir_load_at(temp: u64, kind: u64, width: u64, address: addr, address_length: u64) -> u32 {
  let w: u32 = lainir_load_at_i(2, temp, kind, width, address, address_length);
  return w;
}

func lainir_store(kind: u64, width: u64, value: addr, value_length: u64, address: addr, address_length: u64) -> u32 {
  let ind: addr = symbol_addr("lainir_indent_storage");
  let a: u32 = lainir_write(ind, 2);
  let h: addr = symbol_addr("lainir_hash_storage");
  let b: u32 = lainir_write(h, 1);
  let n: addr = symbol_addr("lainir_store_name_storage");
  let c: u32 = lainir_write(n, 5);
  let lb: addr = symbol_addr("lainir_store_open_storage");
  let lbw: u32 = lainir_write(lb, 1);
  let rep: u32 = lainir_repr(kind, width);
  let ct: addr = symbol_addr("lainir_after_type_storage");
  let e: u32 = lainir_write(ct, 2);
  let v: u32 = lainir_write(value, value_length);
  let comma: addr = symbol_addr("lainir_comma_storage");
  let f: u32 = lainir_write(comma, 2);
  let g: u32 = lainir_write(address, address_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let i: u32 = lainir_write(end, 2);
  return 0;
}

func lainir_lea_at_i(indent: u64, temp: u64, base: addr, base_length: u64, index: addr, index_length: u64, scale: u64, disp: u64) -> u32 {
  let a: u32 = lainir_spaces(indent);
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let b: u32 = lainir_write(pct, 2);
  let c: u32 = lainir_emit_uint(temp);
  let asep: addr = symbol_addr("lainir_assign_storage");
  let d: u32 = lainir_write(asep, 4);
  let n: addr = symbol_addr("lainir_lea_name_storage");
  let f: u32 = lainir_write(n, 3);
  let lp: addr = symbol_addr("lainir_lparen_storage");
  let g: u32 = lainir_write(lp, 1);
  let v0: u32 = lainir_write(base, base_length);
  let comma: addr = symbol_addr("lainir_comma_storage");
  let x1: u32 = lainir_write(comma, 2);
  let v1: u32 = lainir_write(index, index_length);
  let x2: u32 = lainir_write(comma, 2);
  let x3: u32 = lainir_emit_uint(scale);
  let x4: u32 = lainir_write(comma, 2);
  let x5: u32 = lainir_emit_uint(disp);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let x6: u32 = lainir_write(end, 2);
  return 0;
}

func lainir_lea_at(temp: u64, base: addr, base_length: u64, index: addr, index_length: u64, scale: u64, disp: u64) -> u32 {
  let w: u32 = lainir_lea_at_i(2, temp, base, base_length, index, index_length, scale, disp);
  return w;
}

func lainir_extern_marker_write() -> u32 {
  let t: addr = symbol_addr("lainir_extern_marker_storage");
  let s: u32 = lainir_write(t, 10);
  return s;
}

func lainir_quote_nl_write() -> u32 {
  let t: addr = symbol_addr("lainir_quote_nl_storage");
  let s: u32 = lainir_write(t, 2);
  return s;
}

func lainir_buf_bytes(out: addr, at: u64, src: addr, length: u64) -> u64 {
  let done: u64 = loop cp(i: u64 = 0) {
    let more: bool = i < length;
    if more {
      let from: addr = src + i;
      let b: u8 = load(from);
      let to: addr = out + at + i;
      store(to, b);
      let i2: u64 = i + 1;
      continue cp(i2);
    } else {
      let stop: u64 = at + length;
      break cp(stop);
    }
  };
  return done;
}

func lainir_buf_byte(out: addr, at: u64, b: u8) -> u64 {
  let to: addr = out + at;
  store(to, b);
  let next: u64 = at + 1;
  return next;
}

func lainir_buf_uint(out: addr, at: u64, v: u64) -> u64 {
  let digits: u64 = loop count(n: u64 = v, k: u64 = 1) {
    let small: bool = n < 10;
    if small {
      break count(k);
    }
    let n2: u64 = n / 10;
    let k2: u64 = k + 1;
    continue count(n2, k2);
  };
  let end: u64 = loop emit(i: u64 = 0, n: u64 = v) {
    let more: bool = i < digits;
    if more {
      let d: u64 = n % 10;
      let ch: u64 = d + 48;
      let b8: u8 = ch as u8;
      let back: u64 = digits - i;
      let back2: u64 = back - 1;
      let at2: u64 = at + back2;
      let w: u64 = lainir_buf_byte(out, at2, b8);
      let n2: u64 = n / 10;
      let i2: u64 = i + 1;
      continue emit(i2, n2);
    } else {
      let stop: u64 = at + digits;
      break emit(stop);
    }
  };
  return end;
}

func lainir_buf_temp(out: addr, at: u64, n: u64) -> u64 {
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let w0: u64 = lainir_buf_bytes(out, at, pct, 2);
  let w2: u64 = lainir_buf_uint(out, w0, n);
  return w2;
}

func lainir_text_lea_field(out: addr, at: u64, base_text: addr, base_length: u64, disp: u64) -> u64 {
  let open: addr = symbol_addr("lainir_lea_text_open_storage");
  let w0: u64 = lainir_buf_bytes(out, at, open, 5);
  let w1: u64 = lainir_buf_bytes(out, w0, base_text, base_length);
  let mid: addr = symbol_addr("lainir_lea_tail_text_storage");
  let w2: u64 = lainir_buf_bytes(out, w1, mid, 8);
  let w3: u64 = lainir_buf_uint(out, w2, disp);
  let w4: u64 = lainir_buf_byte(out, w3, 41);
  return w4;
}

func lainir_byte(b: u8) -> u32 {
  let p: addr = symbol_addr("lainir_scratch_byte_storage");
  store(p, b);
  let r: u32 = lainir_write(p, 1);
  return r;
}

func lainir_emit_uint(v: u64) -> u32 {
  let big: bool = v >= 10;
  // 大于等于 10：先递归发高位，再发末位；个位数走末尾。
  if big {
    let q: u64 = v / 10;
    let skip: u32 = lainir_emit_uint(q);
    let rem: u64 = v % 10;
    let ch: u64 = rem + 48;
    let b: u8 = ch as u8;
    let w: u32 = lainir_byte(b);
    return w;
  }
  let ch2: u64 = v + 48;
  let b2: u8 = ch2 as u8;
  let w2: u32 = lainir_byte(b2);
  return w2;
}

func lainir_repr(kind: u64, width: u64) -> u32 {
  if kind == 3 {
    let p: addr = symbol_addr("lainir_t_addr_storage");
    let w: u32 = lainir_write(p, 5);
    return w;
  }
  if kind == 1 {
    let p: addr = symbol_addr("lainir_t_f_storage");
    let a: u32 = lainir_write(p, 3);
    let b: u32 = lainir_emit_uint(width);
    let g: addr = symbol_addr("lainir_t_gt_storage");
    let c: u32 = lainir_write(g, 1);
    return c;
  }
  if kind == 2 {
    let p: addr = symbol_addr("lainir_t_vec_storage");
    let a: u32 = lainir_write(p, 5);
    let b: u32 = lainir_emit_uint(width);
    let g: addr = symbol_addr("lainir_t_gt_storage");
    let c: u32 = lainir_write(g, 1);
    return c;
  }
  let bits: addr = symbol_addr("lainir_t_bits_storage");
  let w1: u32 = lainir_write(bits, 6);
  let w2: u32 = lainir_emit_uint(width);
  let gt: addr = symbol_addr("lainir_t_gt_storage");
  let w3: u32 = lainir_write(gt, 1);
  return w3;
}

func lainir_op_prefix(name: addr, name_length: u64, kind: u64, width: u64) -> u32 {
  let h: addr = symbol_addr("lainir_hash_storage");
  let a: u32 = lainir_write(h, 1);
  let b: u32 = lainir_write(name, name_length);
  let lb: addr = symbol_addr("lainir_op_bracket_storage");
  let c: u32 = lainir_write(lb, 1);
  let d: u32 = lainir_repr(kind, width);
  let cl: addr = symbol_addr("lainir_op_close_text_storage");
  let e: u32 = lainir_write(cl, 2);
  return e;
}

func lainir_op_prefix_phys(kind: u64, width: u64) -> u32 {
  let h: addr = symbol_addr("lainir_hash_storage");
  let a: u32 = lainir_write(h, 1);
  let scratch: addr = lain_meta_scratch_data();
  let pos: u64 = std_types.meta_cell_get(scratch + 24);
  let plen: u64 = std_types.meta_cell_get(scratch + 32);
  let table: addr = std_scalars.meta_scalar_table;
  let phys: addr = table + pos;
  let b: u32 = lainir_write(phys, plen);
  let lb: addr = symbol_addr("lainir_op_bracket_storage");
  let c: u32 = lainir_write(lb, 1);
  let d: u32 = lainir_repr(kind, width);
  let cl: addr = symbol_addr("lainir_op_close_text_storage");
  let e: u32 = lainir_write(cl, 2);
  return e;
}

