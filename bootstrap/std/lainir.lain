  let d: u32 = lainir_write(sep, 3);
  let e: u32 = lainir_op_prefix_phys(kind, width);
  let f: u32 = lainir_write(lhs, lhs_length);
  let cm: addr = symbol_addr("lainir_comma_storage");
  let g: u32 = lainir_write(cm, 2);
  let h: u32 = lainir_write(rhs, rhs_length);
  let tail: addr = symbol_addr("lainir_rparen_nl_storage");
