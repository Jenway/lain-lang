func lainir_buf_repr(out: addr, at: u64, kind: u64, width: u64) -> u64 {
  if kind == 3 {
    let p: addr = symbol_addr("lainir_t_addr_storage");
    let w: u64 = lainir_buf_bytes(out, at, p, 5);
    return w;
  }
  if kind == 1 {
    let p: addr = symbol_addr("lainir_t_f_storage");
    let a: u64 = lainir_buf_bytes(out, at, p, 3);
    let b: u64 = lainir_buf_uint(out, a, width);
    let g: addr = symbol_addr("lainir_t_gt_storage");
    let c: u64 = lainir_buf_bytes(out, b, g, 1);
    return c;
  }
  if kind == 2 {
    let p: addr = symbol_addr("lainir_t_vec_storage");
    let a: u64 = lainir_buf_bytes(out, at, p, 5);
    let b: u64 = lainir_buf_uint(out, a, width);
    let g: addr = symbol_addr("lainir_t_gt_storage");
    let c: u64 = lainir_buf_bytes(out, b, g, 1);
    return c;
  }
  let bits: addr = symbol_addr("lainir_t_bits_storage");
  let w1: u64 = lainir_buf_bytes(out, at, bits, 6);
  let w2: u64 = lainir_buf_uint(out, w1, width);
  let gt: addr = symbol_addr("lainir_t_gt_storage");
  let w3: u64 = lainir_buf_bytes(out, w2, gt, 1);
  return w3;
}

func lainir_proc_head_full(name: addr, name_length: u64, params: addr, params_length: u64, kind: u64, width: u64) -> u32 {
  let p: addr = symbol_addr("lainir_proc_storage");
  let w1: u32 = lainir_write(p, 6);
  let w2: u32 = lainir_write(name, name_length);
  let lp: addr = symbol_addr("lainir_lparen_storage");
  let w3: u32 = lainir_write(lp, 1);
  let w4: u32 = lainir_write(params, params_length);
  let rr: addr = symbol_addr("lainir_rret_storage");
  let w5: u32 = lainir_write(rr, 5);
  let w6: u32 = lainir_repr(kind, width);
  return w6;
}

