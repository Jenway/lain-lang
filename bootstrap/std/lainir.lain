func lainir_line_start(temp: u64) -> u32 {
  let ind: addr = symbol_addr("lainir_indent_storage");
  let w0: u32 = lainir_write(ind, 2);
  let h: addr = symbol_addr("lainir_hash_storage");
  let zero: bool = temp == 0;
  let r: u32 = if zero {
    let wh: u32 = lainir_write(h, 1);
    wh
  } else {
    let pct: addr = symbol_addr("lainir_pct_r_storage");
    let a: u32 = lainir_write(pct, 2);
    let b: u32 = lainir_emit_uint(temp);
    let sep: addr = symbol_addr("lainir_result_sep_storage");
    let c: u32 = lainir_write(sep, 3);
    let d: u32 = lainir_write(h, 1);
    d
  };
  return r;
}

func lainir_if(cond: addr, cond_length: u64) -> u32 {
  let s: u32 = lainir_line_start(0);
  let n: addr = symbol_addr("lainir_if_name_storage");
  let a: u32 = lainir_write(n, 2);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(cond, cond_length);
  let br: addr = symbol_addr("lainir_brace_nl_storage");
  let d: u32 = lainir_write(br, 3);
  return d;
}

func lainir_if_value(cond: addr, cond_length: u64, results: addr, results_length: u64) -> u32 {
  let t: u64 = lainir_next_temp();
  let s: u32 = lainir_line_start(t);
  let n: addr = symbol_addr("lainir_if_name_storage");
  let a: u32 = lainir_write(n, 2);
  let sp: addr = symbol_addr("lainir_space_storage");
  let b: u32 = lainir_write(sp, 1);
  let c: u32 = lainir_write(cond, cond_length);
  let ar: addr = symbol_addr("lainir_arrow_open_storage");
  let d: u32 = lainir_write(ar, 5);
  let e: u32 = lainir_write(results, results_length);
  let rp: addr = symbol_addr("lainir_close_rparen_storage");
  let f: u32 = lainir_write(rp, 1);
  let br: addr = symbol_addr("lainir_brace_nl_storage");
  let g: u32 = lainir_write(br, 3);
  return g;
}

