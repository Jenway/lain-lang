func lainir_binary_op_at(indent: u64, temp: u64, name: addr, name_length: u64, kind: u64, width: u64, lhs: addr, lhs_length: u64, rhs: addr, rhs_length: u64) -> u32 {
  let sp: u32 = lainir_spaces(indent);
  let pct: addr = symbol_addr("lainir_pct_r_storage");
  let a: u32 = lainir_write(pct, 2);
  let b: u32 = lainir_emit_uint(temp);
  let asep: addr = symbol_addr("lainir_result_sep_storage");
  let c: u32 = lainir_write(asep, 3);
  let d: u32 = lainir_op_prefix(name, name_length, kind, width);
  let e: u32 = lainir_write(lhs, lhs_length);
  let cm: addr = symbol_addr("lainir_comma_storage");
  let f: u32 = lainir_write(cm, 2);
  let g: u32 = lainir_write(rhs, rhs_length);
  let end: addr = symbol_addr("lainir_rparen_nl_storage");
  let h: u32 = lainir_write(end, 2);
  return h;
}

