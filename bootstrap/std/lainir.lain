func lainir_spaces(n: u64) -> u32 {
  let st: u32 = loop sp(i: u64 = 0) {
    let more: bool = i < n;
    if more {
      let w: u32 = lainir_byte(32);
      let i2: u64 = i + 1;
      continue sp(i2);
    } else {
      break sp(0);
    }
  };
  return st;
}

