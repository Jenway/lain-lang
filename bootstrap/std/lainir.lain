func lainir_spaces(n: u64) -> u32 {
  let st: u32 = loop sp(i: u64 = 0) {
    let more: bool = i < n;
    if more {
      let w: u32 = lainir_byte(32);
      let i2: u64 = i + 1;
      continue sp(i2);
    } else {
      break sp(0);
    }
  };
  return st;
}

func lainir_binary_named_at(indent: u64, name: addr, name_length: u64, kind: u64, width: u64, lhs: addr, lhs_length: u64, rhs: addr, rhs_length: u64) -> u32 {
