// struct 对齐请求的物理 LAINIR。值经实参 wire 传递，不拼进源文本。
// 参数格式由宿主 ABI 定义为 kind/width/bits 三个 64 位单元。
data meta_eval_align_module ro { 35 112 114 111 99 32 108 97 121 111 117 116 95 97 108 105 103 110 40 37 118 58 32 35 98 105 116 115 60 54 52 62 44 32 37 97 58 32 35 98 105 116 115 60 54 52 62 41 32 45 62 32 35 98 105 116 115 60 54 52 62 32 123 10 32 32 37 98 97 99 107 32 61 32 35 115 117 98 91 35 98 105 116 115 60 54 52 62 93 40 37 97 44 32 49 41 10 32 32 37 115 117 109 32 61 32 35 97 100 100 91 35 98 105 116 115 60 54 52 62 93 40 37 118 44 32 37 98 97 99 107 41 10 32 32 37 113 32 61 32 35 117 100 105 118 91 35 98 105 116 115 60 54 52 62 93 40 37 115 117 109 44 32 37 97 41 10 32 32 37 114 101 115 117 108 116 32 61 32 35 109 117 108 91 35 98 105 116 115 60 54 52 62 93 40 37 113 44 32 37 97 41 10 32 32 35 114 101 116 117 114 110 32 37 114 101 115 117 108 116 10 125 10 }
data meta_eval_align_entry ro { 108 97 121 111 117 116 95 97 108 105 103 110 }

// 通用标量请求门面：模块文本、入口和标量 wire 都是调用方提供的数据。
// 显式能力与预算目前由驱动配置在宿主上下文中；此门面不替调用者伪造过程值或权限。
#proc meta_apply_scalar_request(%text: #addr, %text_len: #bits<64>,
                                %entry: #addr, %entry_len: #bits<64>,
                                %args: #addr, %arg_count: #bits<64>) -> #bits<64> {
  %result = #call lain_meta_apply_request(%text, %text_len, %entry,
                                          %entry_len, %args, %arg_count)
  #return %result
}

// 把 Meta 中的有界字节块作为只读 #addr 实参交给通用 apply。
#proc meta_apply_bytes_arg_request(%text: #addr, %text_len: #bits<64>,
                                   %entry: #addr, %entry_len: #bits<64>,
                                   %args: #addr, %arg_count: #bits<64>,
                                   %byte_arg: #addr, %byte_len: #bits<64>,
                                   %byte_index: #bits<64>) -> #bits<64> {
  %result = #call lain_meta_apply_bytes_arg_request(
      %text, %text_len, %entry, %entry_len, %args, %arg_count,
      %byte_arg, %byte_len, %byte_index)
  %status = #call lain_meta_apply_status()
  %failed = #ne[#bits<64>](%status, 0)
  %value = #if %failed -> (#bits<64>) {
    #yield %status
  } else {
    #yield %result
  }
  #return %value
}

// 字节结果复制到调用方明确提供的 Meta 可写缓冲区；VM 地址不会成为 Meta 值。
#proc meta_apply_bytes_request_copy(%text: #addr, %text_len: #bits<64>,
                                    %entry: #addr, %entry_len: #bits<64>,
                                    %args: #addr, %arg_count: #bits<64>,
                                    %byte_length: #bits<64>,
                                    %destination: #addr) -> #bits<64> {
  %request = #call lain_meta_apply_bytes_request(
      %text, %text_len, %entry, %entry_len, %args, %arg_count, %byte_length)
  %status = #call lain_meta_apply_status()
  %failed = #ne[#bits<64>](%status, 0)
  #if %failed { #return %status }
  %actual_length = #call lain_meta_apply_bytes_length()
  %length_ok = #eq[#bits<64>](%actual_length, %byte_length)
  #if #eq[#bits<1>](%length_ok, 0) { #return 9344 }
  %copy = #call lain_meta_apply_bytes_copy(0, %destination, %byte_length)
  #return %copy
}

#proc lain_meta_apply_emitted_request(%entry: #addr, %entry_len: #bits<64>,
                                     %args: #addr, %arg_count: #bits<64>) -> #bits<64>
    #extern "lain_meta_apply_emitted_request"

#proc meta_apply_emitted_bytes_arg_request(
    %entry: #addr, %entry_len: #bits<64>, %args: #addr,
    %arg_count: #bits<64>, %byte_arg: #addr, %byte_len: #bits<64>,
    %byte_index: #bits<64>) -> #bits<64> {
  %result = #call lain_meta_apply_emitted_bytes_arg_request(
      %entry, %entry_len, %args, %arg_count, %byte_arg, %byte_len,
      %byte_index)
  %status = #call lain_meta_apply_status()
  %failed = #ne[#bits<64>](%status, 0)
  %value = #if %failed -> (#bits<64>) {
    #yield %status
  } else {
    #yield %result
  }
  #return %value
}

// 按已登记过程的依赖闭包临时生成 LAINIR，再用普通过程 apply 执行。
// 当前接收标量 wire；过程值及跨模块身份后续沿用此入口扩展。
#proc meta_eval_apply_decl_closure(%root: #bits<64>,
                                  %args: #addr,
                                  %arg_count: #bits<64>) -> #bits<64> {
  %mark = #call meta_bump_mark()
  %root_kind = #call meta_scope_kind(%root)
  %root_func = #eq[#bits<64>](%root_kind, 6)
  #if #eq[#bits<1>](%root_func, 0) {
    %f0 = #call lain_meta_fail(9412)
    %r0 = #call meta_bump_release(%mark)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %closure = #call meta_scope_dependency_closure(%root)
  %empty = #eq[#bits<64>](%closure, 0)
  #if %empty {
    %r1 = #call meta_bump_release(%mark)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %opened = #call lain_meta_emit_scope_begin()
  %open_failed = #ne[#bits<32>](%opened, 0)
  #if %open_failed {
    %f1 = #call lain_meta_fail(%opened)
    %r2 = #call meta_bump_release(%mark)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %scratch = #call lain_meta_scratch_data()
  %old_current = #call meta_cell_get(#lea(%scratch, 104, 1, 0))
  %lower_status = #loop lower(%i: #bits<64> = 0) -> (#bits<32>) {
    %count = #call meta_scope_dependency_closure_count()
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %scope_index = #call meta_scope_dependency_closure_at(%i)
      %kind = #call meta_scope_kind(%scope_index)
      %source = #call meta_scope_word(%scope_index, 0)
      %base = #call lain_meta_source_data(%source)
      %len = #call lain_meta_source_length(%source)
      %parent = #call meta_scope_aux(%scope_index)
      %index = #call meta_scope_emitted(%scope_index)
      %node = #call meta_scope_decl_node(%scope_index)
      %current = #call meta_scope_set_current(%source)
      %is_func = #eq[#bits<64>](%kind, 6)
      %is_struct = #eq[#bits<64>](%kind, 4)
      %is_enum = #eq[#bits<64>](%kind, 5)
      %status = #if %is_func -> (#bits<32>) {
        %s0 = #call meta_lower_decl_func(%base, %len, %parent,
                                          %index, %node)
        #yield %s0
      } else {
        %s1 = #if %is_struct -> (#bits<32>) {
          %here = #call meta_node_start(%node)
          %s2 = #call meta_lower_decl_struct(%base, %len, %here)
          #yield %s2
        } else {
          %s3 = #if %is_enum -> (#bits<32>) {
            %here2 = #call meta_node_start(%node)
            %s4 = #call meta_lower_decl_enum(%base, %len, %here2)
            #yield %s4
          } else {
            %f2 = #call lain_meta_fail(9412)
            #yield 9412
          }
          #yield %s3
        }
        #yield %s1
      }
      %failed = #ne[#bits<32>](%status, 0)
      #if %failed { #break lower(%status) }
      %next = #add[#bits<64>](%i, 1)
      #continue lower(%next)
    } else { #break lower(0) }
  }
  %has_lower_error = #ne[#bits<32>](%lower_status, 0)
  %result = #if %has_lower_error -> (#bits<64>) {
    %f3 = #call lain_meta_fail(%lower_status)
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %root_source = #call meta_scope_word(%root, 0)
    %root_base = #call lain_meta_source_data(%root_source)
    %entry_off = #call meta_scope_word(%root, 8)
    %entry_len = #call meta_scope_word(%root, 16)
    %entry = #lea(%root_base, %entry_off, 1, 0)
    %bits = #call lain_meta_apply_emitted_request(%entry, %entry_len,
                                                  %args, %arg_count)
    %apply_status = #call lain_meta_apply_status()
    %apply_kind = #call lain_meta_apply_kind()
    %apply_width = #call lain_meta_apply_width()
    %status_ok = #eq[#bits<64>](%apply_status, 0)
    %kind_ok = #eq[#bits<64>](%apply_kind, 0)
    %width_ok = #ne[#bits<64>](%apply_width, 0)
    %type_ok = #and[#bits<1>](%kind_ok, %width_ok)
    %valid = #and[#bits<1>](%status_ok, %type_ok)
    %value = #if %valid -> (#bits<64>) {
      #yield %bits
    } else {
      %code = #if %status_ok -> (#bits<32>) {
        #yield 7
      } else {
        %low = #trunc[#bits<32>](%apply_status)
        #yield %low
      }
      %f4 = #call lain_meta_fail(%code)
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %value
  }
  %restore = #call meta_cell_put(#lea(%scratch, 104, 1, 0), %old_current)
  %closed = #call lain_meta_emit_scope_end()
  %released = #call meta_bump_release(%mark)
  #return %result
}

// 从已验证的 proc_ref 取回声明身份，经同一依赖闭包路径生成并 apply。
// 引用帧不是权限令牌；实际 apply 仍受当前 Meta 宿主能力与统一预算约束。
#proc meta_eval_apply_proc_ref(%wire: #addr, %wire_length: #bits<64>,
                               %args: #addr,
                               %arg_count: #bits<64>) -> #bits<64> {
  %tag = #call meta_wire_validate(%wire, %wire_length)
  %is_proc_ref = #eq[#bits<64>](%tag, 4)
  #if #eq[#bits<1>](%is_proc_ref, 0) {
    %is_wire_error = #ugt[#bits<64>](%tag, 4)
    %code = #if %is_wire_error -> (#bits<64>) {
      #yield %tag
    } else {
      #yield 9439
    }
    %code32 = #trunc[#bits<32>](%code)
    %failed = #call lain_meta_fail(%code32)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %procedure_id = #call meta_wire_read_le(%wire, 24, 8)
  %root = #sub[#bits<64>](%procedure_id, 1)
  %result = #call meta_eval_apply_decl_closure(%root, %args, %arg_count)
  #return %result
}

// 失败返回 UINT64_MAX，宿主状态保留 apply 的具体拒码。模块缓冲区固定 256 字节，
// wire 从偏移 256 开始；每个标量参数占 24 字节，两个参数的总暂存大小为 304 字节。
#proc meta_eval_align_up(%v: #bits<64>, %a: #bits<64>,
                         %source_base: #addr, %position: #bits<64>) -> #bits<64> {
  %zero = #eq[#bits<64>](%a, 0)
  #if %zero {
    #return %v
  }
  %mark = #call meta_bump_mark()
  %off = #call meta_bump_alloc(304)
  %no_space = #eq[#bits<64>](%off, 0xFFFFFFFFFFFFFFFF)
  #if %no_space {
    #return 0xFFFFFFFFFFFFFFFF
  }
  %scratch = #call lain_meta_scratch_data()
  %buf = #lea(%scratch, %off, 1, 0)
  %prefix = #data_addr meta_eval_align_module
  %length = #call meta_buf_puts(%buf, 256, 0, %prefix, 223)
  %build_failed = #eq[#bits<64>](%length, 0xFFFFFFFFFFFFFFFF)
  #if %build_failed {
    %release = #call meta_bump_release(%mark)
    %failed = #call lain_meta_fail(17)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %wire = #lea(%buf, 256, 1, 0)
  %w0 = #call meta_cell_put(%wire, 0)
  %w1 = #call meta_cell_put(#lea(%wire, 8, 1, 0), 64)
  %w2 = #call meta_cell_put(#lea(%wire, 16, 1, 0), %v)
  %w3 = #call meta_cell_put(#lea(%wire, 24, 1, 0), 0)
  %w4 = #call meta_cell_put(#lea(%wire, 32, 1, 0), 64)
  %w5 = #call meta_cell_put(#lea(%wire, 40, 1, 0), %a)
  %entry = #data_addr meta_eval_align_entry
  %bits = #call meta_apply_scalar_request(%buf, %length, %entry, 12,
                                          %wire, 2)
  %status = #call lain_meta_apply_status()
  %kind = #call lain_meta_apply_kind()
  %width = #call lain_meta_apply_width()
  %status_ok = #eq[#bits<64>](%status, 0)
  %kind_ok = #eq[#bits<64>](%kind, 0)
  %width_ok = #eq[#bits<64>](%width, 64)
  %type_ok = #and[#bits<1>](%kind_ok, %width_ok)
  %valid = #and[#bits<1>](%status_ok, %type_ok)
  %result = #if %valid -> (#bits<64>) {
    #yield %bits
  } else {
    %code = #if %status_ok -> (#bits<32>) {
      #yield 7
    } else {
      %low = #trunc[#bits<32>](%status)
      #yield %low
    }
    // 布局结束处是这次物理对齐计算的来源；请求行列由 Eval 单独保留。
    %source = #call meta_source_of(%source_base)
    %known = #ne[#bits<64>](%source, 0xFFFFFFFFFFFFFFFF)
    #if %known {
      %wide_code = #zext[#bits<64>](%code)
      %failed_at = #call lain_meta_fail_at(%wide_code, %source, %position)
    } else {
      %failed = #call lain_meta_fail(%code)
    }
    #yield 0xFFFFFFFFFFFFFFFF
  }
  %release = #call meta_bump_release(%mark)
  #return %result
}
