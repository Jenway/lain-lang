// 声明处理器分派。语法注册表决定关键字属于哪个处理器；作用域登记与
// Lowering 只接收 handler ID，不再各自重做一套关键字分类。

// 宏处理器拥有替换片段内部的上下文规则。返回 1 = 已写入，0 = 失败。
#proc meta_expand_replacement_invoke(%handler: #bits<64>,
                                     %slice: #bits<64>,
                                     %count: #bits<64>,
                                     %buffer: #addr,
                                     %outn: #bits<64>) -> #bits<64> {
  %is_my_if = #eq[#bits<64>](%handler, 1)
  %r = #if %is_my_if -> (#bits<64>) {
    %v = #call meta_expand_replacement_my_if(%slice, %count, %buffer, %outn)
    #yield %v
  } else {
    %is_block = #eq[#bits<64>](%handler, 11)
    %is_require = #eq[#bits<64>](%handler, 12)
    %blockish = #or[#bits<1>](%is_block, %is_require)
    %b = #if %blockish -> (#bits<64>) {
      %v2 = #call meta_expand_replacement_my_block(%slice, %count,
                                                    %buffer, %outn)
      #yield %v2
    } else {
      %f = #call lain_meta_fail(9412)
      #yield 0
    }
    #yield %b
  }
  #return %r
}

// statement 处理器决定哪些孩子继续按 statement 上下文展开。
// 无孩子适配器的处理器消费当前节点 1 项；0 表示递归失败。
#proc meta_expand_stmt_children_invoke(%handler: #bits<64>,
                                       %parent: #bits<64>,
                                       %cursor: #bits<64>,
                                       %count: #bits<64>,
                                       %buffer: #addr,
                                       %outn: #bits<64>) -> #bits<64> {
  %is_if = #eq[#bits<64>](%handler, 3)
  %r = #if %is_if -> (#bits<64>) {
    %v = #call meta_expand_children_if(%parent, %cursor, %count,
                                       %buffer, %outn)
    #yield %v
  } else { #yield 1 }
  #return %r
}

// declaration 处理器决定顶层声明内部的展开上下文。
#proc meta_expand_decl_children_invoke(%handler: #bits<64>,
                                       %parent: #bits<64>,
                                       %cursor: #bits<64>,
                                       %count: #bits<64>,
                                       %buffer: #addr,
                                       %outn: #bits<64>) -> #bits<64> {
  %is_func = #eq[#bits<64>](%handler, 2)
  %r = #if %is_func -> (#bits<64>) {
    %v = #call meta_expand_children_func(%parent, %cursor, %count,
                                         %buffer, %outn)
    #yield %v
  } else { #yield 1 }
  #return %r
}

#proc meta_declare_invoke(%handler: #bits<64>, %base: #addr,
                          %len: #bits<64>, %source: #bits<64>,
                          %level_start: #bits<64>, %parent: #bits<64>,
                          %index: #bits<64>) -> #bits<32> {
  %is_scalar = #eq[#bits<64>](%handler, 6)
  %s = #if %is_scalar -> (#bits<32>) {
    %r0 = #call meta_declare_scalar(%base, %len, %source,
                                    %level_start, %parent, %index)
    #yield %r0
  } else {
    %is_struct = #eq[#bits<64>](%handler, 4)
    %r1 = #if %is_struct -> (#bits<32>) {
      %x0 = #call meta_declare_struct(%base, %len, %source,
                                      %level_start, %parent, %index)
      #yield %x0
    } else {
      %is_enum = #eq[#bits<64>](%handler, 5)
      %r2 = #if %is_enum -> (#bits<32>) {
        %x1 = #call meta_declare_enum(%base, %len, %source,
                                      %level_start, %parent, %index)
        #yield %x1
      } else {
        %is_func = #eq[#bits<64>](%handler, 2)
        %r3 = #if %is_func -> (#bits<32>) {
          %x2 = #call meta_declare_func(%base, %len, %source,
                                        %level_start, %parent, %index)
          #yield %x2
        } else {
          %is_let = #eq[#bits<64>](%handler, 7)
          %r4 = #if %is_let -> (#bits<32>) {
            %x3 = #call meta_declare_let(%base, %len, %source,
                                         %level_start, %parent, %index)
            #yield %x3
          } else {
            %f = #call lain_meta_fail(9412)
            #yield 9412
          }
          #yield %r4
        }
        #yield %r3
      }
      #yield %r2
    }
    #yield %r1
  }
  #return %s
}

#proc meta_lower_decl_invoke(%handler: #bits<64>, %base: #addr,
                             %len: #bits<64>, %here: #bits<64>,
                             %parent: #bits<64>, %index: #bits<64>,
                             %node: #bits<64>) -> #bits<32> {
  %is_struct = #eq[#bits<64>](%handler, 4)
  %s = #if %is_struct -> (#bits<32>) {
    %r0 = #call meta_lower_decl_struct(%base, %len, %here)
    #yield %r0
  } else {
    %is_enum = #eq[#bits<64>](%handler, 5)
    %r1 = #if %is_enum -> (#bits<32>) {
      %x0 = #call meta_lower_decl_enum(%base, %len, %here)
      #yield %x0
    } else {
      %is_func = #eq[#bits<64>](%handler, 2)
      %r2 = #if %is_func -> (#bits<32>) {
        %x1 = #call meta_lower_decl_func(%base, %len, %parent, %index, %node)
        #yield %x1
      } else {
        %is_scalar = #eq[#bits<64>](%handler, 6)
        %r3 = #if %is_scalar -> (#bits<32>) {
          %x2 = #call meta_lower_decl_scalar()
          #yield %x2
        } else {
          %is_let = #eq[#bits<64>](%handler, 7)
          %r4 = #if %is_let -> (#bits<32>) {
            %x3 = #call meta_lower_decl_let(%base, %len, %here)
            #yield %x3
          } else {
            %f1 = #call lain_meta_fail(9412)
            #yield 9412
          }
          #yield %r4
        }
        #yield %r3
      }
      #yield %r2
    }
    #yield %r1
  }
  #return %s
}
