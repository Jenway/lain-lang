// 模块：函数体处理与语句序列。跨单元引用一律写 `别名.名字`。
let meta = import("../meta");
let std_emit = import("emit");
let std_lainir = import("lainir");
let std_lex = import("lex");
let std_parse = import("parse");
let std_recognize = import("recognize");
let std_records = import("records");
let std_regions = import("regions");
let std_registry = import("registry");
let std_scalars = import("scalars");
let std_scope = import("scope");
let std_sums = import("sums");
let std_syntax = import("syntax");
let std_types = import("types");

extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;

func meta_emit_ret_call(base: addr, len: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, callee_lo: u64, callee_hi: u64, args: u64) -> u32 {
  let callee_name: addr = base + callee_lo;
  let callee_len: u64 = callee_hi - callee_lo;
  let decl: u64 = std_scope.meta_scope_require_func(callee_name, callee_len);
  if decl == 0 { return 9415; }
  let ast: u32 = meta_args_prepare(base, len, kind, width, t_lo, t_hi, args);
  let abad: bool = ast != 0;
  if abad {
    return ast;
  }
  let buf: addr = std_lainir.lainir_text_buffer;
  let alen: u64 = meta_args_render(base, len, buf);
  let c_at: addr = base + callee_lo;
  let pbuf: addr = std_scope.meta_path_buf();
  let c_len: u64 = std_scope.meta_callee_symbol(pbuf, c_at, callee_len);
  let w: u32 = std_lainir.lainir_ret_call(pbuf, c_len, buf, alen);
  return 0;
}

func meta_emit_loop_test(base: addr, len: u64, kind: u64, width: u64, i_lo: u64, i_hi: u64, hi_lo: u64, hi_hi: u64) -> u32 {
  let n: u64 = meta_next_temp();
  let buf: addr = std_lainir.lainir_text_buffer;
  let nbuf: addr = buf + 160;
  let pct: u64 = std_lainir.lainir_buf_byte(nbuf, 0, 37);
  let cch: u64 = std_lainir.lainir_buf_byte(nbuf, pct, 99);
  let nlen: u64 = std_lainir.lainir_buf_uint(nbuf, cch, n);
  let alen: u64 = meta_render_operand(base, i_lo, i_hi, len, buf);
  let abuf: addr = buf + 96;
  let blen: u64 = meta_render_operand(base, hi_lo, hi_hi, len, abuf);
  let w: u32 = std_lainir.lainir_binary_named_at(4, nbuf, nlen, kind, width, buf, alen, abuf, blen);
  let w10: u32 = std_lainir.lainir_indent4_write();
  let w11: u32 = std_lainir.lainir_if_head_write();
  let w12: u32 = std_lainir.lainir_byte(99);
  let w13: u32 = std_lainir.lainir_emit_uint(n);
  let w14: u32 = std_lainir.lainir_open_body();
  return 0;
}

func meta_emit_addr_of_temp(base: addr, len: u64, kind: u64, width: u64, args: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let acount: u64 = std_parse.ast_child_count(args);
  let zero: bool = acount == 0;
  if zero {
    return 3;
  }
  let akind: u64 = meta_arg_repr_kind(base, len, args);
  let int_arg: bool = akind == 0;
  let notint: bool = int_arg == 0;
  if notint {
    let fb2: u32 = lain_meta_fail(4);
    return 4;
  }
  let est: u32 = meta.meta_emit_expr(base, len, 0, 64, 0, 0, args, 0, 0, 0, 0, 0);
  let ebad: bool = est != 0;
  if ebad {
    return est;
  }
  let endi: u64 = std_types.meta_cell_get(sc + 192);
  let done: bool = endi >= acount;
  let tail: bool = done == 0;
  if tail {
    let ft2: u32 = lain_meta_fail(4);
    return 4;
  }
  let aref: u64 = std_types.meta_cell_get(sc + 168);
  let alo: u64 = std_types.meta_cell_get(sc + 176);
  let ahi: u64 = std_types.meta_cell_get(sc + 184);
  let buf: addr = std_lainir.lainir_text_buffer;
  let vlen: u64 = meta.meta_render_ref2(base, len, aref, alo, ahi, buf);
  let tn: u64 = meta_next_temp();
  let w: u32 = std_lainir.lainir_int2ptr_at(tn, buf, vlen);
  let s1: u32 = std_types.meta_cell_put(sc + 168, tn);
  return 0;
}

func meta_arg_repr_kind(base: addr, len: u64, args: u64) -> u64 {
  let node: u64 = std_parse.ast_child(args, 0);
  let none: bool = node == 0;
  if none {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let k0: u64 = std_parse.meta_node_kind(node);
  let is_word: bool = k0 == 1;
  if is_word == 0 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let n_at: u64 = std_parse.meta_node_start(node);
  let n_hi: u64 = n_at + std_parse.meta_node_len(node);
  let name: addr = base + n_at;
  let is_ptr: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_ptr_of, 6);
  let is_addr: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_addr_of, 7);
  let prim: bool = is_ptr or is_addr;
  // 有返回类型的内建：整数或地址，照定义给类别。
  if prim {
    if is_addr {
      return 3;
    }
    return 0;
  }
  let sc: addr = lain_meta_scratch_data();
  let lo: u64 = meta_word_type_name(base, len, node);
  let miss: bool = lo == 0xFFFFFFFFFFFFFFFF;
  let hi: u64 = std_types.meta_cell_get(sc + 0);
  if miss {
    return 0;
  }
  let tid: u64 = std_scalars.meta_type_resolve(base, len, lo, hi);
  let zero: bool = tid == 0;
  if zero {
    return 0xFFFFFFFFFFFFFFFF;
  }
  return std_registry.meta_tid_repr_kind(tid);
}

func meta_loop_phi_names(nparam: u64, res: addr) -> u32 {
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      if k != 0 {
        let wc: u32 = std_lainir.lainir_comma_write();
      }
      let coff: u64 = k * 8;
      let tn: u64 = std_types.meta_cell_get(res + coff);
      let wt: u32 = std_lainir.lainir_temp_name_emit(tn);
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  return r;
}

func meta_loop_phi_yield(base: addr, len: u64, b: addr, nparam: u64) -> u32 {
  let w0: u32 = std_lainir.lainir_yield_write();
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      if k != 0 {
        let wc: u32 = std_lainir.lainir_comma_write();
      }
      let kslot: u64 = 88 + k * 96;
      let kq: addr = b + kslot;
      let cur: u64 = std_types.meta_cell_get(kq + 32);
      let isnone: bool = cur == 0xFFFFFFFFFFFFFFFF;
      if isnone {
        let ex_hi: u64 = std_types.meta_cell_get(kq + 88);
        let has_ex: bool = ex_hi != 0;
        if has_ex {
          let ex_lo: u64 = std_types.meta_cell_get(kq + 80);
          let wx: u32 = meta_emit_operand(base, ex_lo, ex_hi, len);
        } else {
          let pn_lo: u64 = std_types.meta_cell_get(kq);
          let pn_hi: u64 = std_types.meta_cell_get(kq + 8);
          let wp: u32 = meta_emit_operand(base, pn_lo, pn_hi, len);
        }
      } else {
        let wt: u32 = meta_emit_temp_name(cur);
      }
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  let w1: u32 = std_lainir.lainir_newline_write();
  return r;
}

func meta_lower_loop(base: addr, len: u64, parent: u64, index: u64, n_lo: u64, n_hi: u64) -> u32 {
  // 形状：`loop` 标签 参数组 `while` 条件… 循环体组 `;`。`while` 子句可以省。
  let label: u64 = std_parse.meta_cursor_next(parent, index);
  let pgrp: u64 = std_parse.meta_cursor_next(parent, index + 1);
  let wh: u64 = std_parse.meta_cursor_next(parent, index + 2);
  let lk: u64 = std_parse.meta_node_kind(label);
  let lab_ok: bool = lk == 1;
  let pk: u64 = std_parse.meta_node_kind(pgrp);
  let pgrp_ok: bool = pk == 2;
  let w_ok: bool = std_parse.meta_node_is_word(wh, std_lex.meta_kw_while, 5);
  let whk: u64 = std_parse.meta_node_kind(wh);
  let whgrp: bool = whk == 2;
  let head_ok: bool = w_ok or whgrp;
  let h0: bool = lab_ok and pgrp_ok;
  let head: bool = h0 and head_ok;
  let badhead: bool = head == 0;
  if badhead {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  // 参数个数：`名字 冒号 类型 等号 初值` 五格一组，组间一个逗号：n = (孩子数 + 1) / 6
  let pc: u64 = std_parse.ast_child_count(pgrp);
  let nparam: u64 = (pc + 1) / 6;
  let no_par: bool = nparam == 0;
  let too_many: bool = nparam > 8;
  let badn: bool = no_par or too_many;
  if badn {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let mark: u64 = std_scope.meta_bump_mark();
  let bytes: u64 = 88 + nparam * 96;
  let blk: u64 = std_scope.meta_bump_alloc(bytes);
  let noblk: bool = blk == 0xFFFFFFFFFFFFFFFF;
  if noblk {
    // 分配器已经报过 17
    return 17;
  }
  let sc: addr = lain_meta_scratch_data();
  let b: addr = sc + blk;
  let s0: u32 = std_types.meta_cell_put(b + 8, nparam);
  let s1: u32 = std_types.meta_cell_put(b + 24, 0xFFFFFFFFFFFFFFFF);
  let lab_at: u64 = std_parse.meta_node_start(label);
  let lab_hi: u64 = lab_at + std_parse.meta_node_len(label);
  let s2: u32 = std_types.meta_cell_put(b + 56, lab_at);
  let s3: u32 = std_types.meta_cell_put(b + 64, lab_hi);
  let lp_n: u64 = meta_next_temp();
  let s4: u32 = std_types.meta_cell_put(b + 16, lp_n);
  // 标签与编号同时记进暂存区固定格（d3 解析带名字的 break / continue 要看它们）
  let s5: u32 = std_types.meta_cell_put(sc + 2432, lab_at);
  let s6: u32 = std_types.meta_cell_put(sc + 2440, lab_hi);
  let s7: u32 = std_types.meta_cell_put(sc + 2448, lp_n);

  // 第一趟：每个参数的声明（名字、类型、acc 是哪一个）进块。
  let decl: u32 = loop d(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      let bi6: u64 = k * 6;
      let nm: u64 = std_parse.ast_child(pgrp, bi6);
      let col: u64 = std_parse.ast_child(pgrp, bi6 + 1);
      let ty: u64 = std_parse.ast_child(pgrp, bi6 + 2);
      let eqn: u64 = std_parse.ast_child(pgrp, bi6 + 3);
      let nk: u64 = std_parse.meta_node_kind(nm);
      let n_ok: bool = nk == 1;
      let c_ok: bool = std_parse.meta_node_is_word(col, std_lex.meta_kw_colon, 1);
      let e_ok: bool = std_parse.meta_node_is_word(eqn, std_lex.meta_kw_eq, 1);
      let o0: bool = n_ok and c_ok;
      let shape: bool = o0 and e_ok;
      let bad: bool = shape == 0;
      if bad {
        let fd: u32 = lain_meta_fail(4);
        break d(fd);
      }
      let t_lo: u64 = std_parse.meta_node_start(ty);
      let t_hi: u64 = t_lo + std_parse.meta_node_len(ty);
      let tid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
      let no_type: bool = tid == 0;
      if no_type {
        let ft: u32 = lain_meta_fail(5);
        break d(ft);
      }
      let info: u64 = std_registry.meta_tid_repr(tid);
      let kd: u64 = info and 255;
      let wd: u64 = (info >> 8) and 255;
      let n_at: u64 = std_parse.meta_node_start(nm);
      let n_hi2: u64 = n_at + std_parse.meta_node_len(nm);
      let pslot: u64 = 88 + k * 96;
      let q: addr = b + pslot;
      let p0: u32 = std_types.meta_cell_put(q, n_at);
      let p1: u32 = std_types.meta_cell_put(q + 8, n_hi2);
      let p2: u32 = std_types.meta_cell_put(q + 16, kd);
      let p3: u32 = std_types.meta_cell_put(q + 24, wd);
      let p4: u32 = std_types.meta_cell_put(q + 32, 0xFFFFFFFFFFFFFFFF);
      // 声明的类型窗口：`continue` 的实参按它降级（上下文类型）
      let p5: u32 = std_types.meta_cell_put(q + 64, t_lo);
      let p6: u32 = std_types.meta_cell_put(q + 72, t_hi);
      let p7: u32 = std_types.meta_cell_put(q + 80, 0);
      let p8: u32 = std_types.meta_cell_put(q + 88, 0);
      // `acc`：循环的值。名字长度先对，再逐字节比。
      let nlen: u64 = n_hi2 - n_at;
      let len3: bool = nlen == 3;
      if len3 {
        let eqb: bool = std_types.meta_bytes_equal(base + n_at, std_lex.meta_kw_acc, 3);
        if eqb {
          let a0: u32 = std_types.meta_cell_put(b + 24, kd);
          let a1: u32 = std_types.meta_cell_put(b + 32, wd);
          let a2: u32 = std_types.meta_cell_put(b + 40, n_at);
          let a3: u32 = std_types.meta_cell_put(b + 48, n_hi2);
          let a4: u32 = std_types.meta_cell_put(b + 72, t_lo);
          let a5: u32 = std_types.meta_cell_put(b + 80, t_hi);
        }
      }
      continue d(k + 1);
    } else {
      break d(0);
    }
  };
  let dbad: bool = decl != 0;
  if dbad {
    let rel0: u32 = std_scope.meta_bump_release(mark);
    return decl;
  }
  // 没有叫 `acc` 的参数时，循环的值由 break LABEL(值) 带出来，结果类型与条件上下文
  // 都取第一个参数的声明类型。
  let akd0: u64 = std_types.meta_cell_get(b + 24);
  let no_acc: bool = akd0 == 0xFFFFFFFFFFFFFFFF;
  if no_acc {
    let q0: addr = b + 88;
    let ftlo: u64 = std_types.meta_cell_get(q0 + 64);
    let fthi: u64 = std_types.meta_cell_get(q0 + 72);
    let fkd: u64 = std_types.meta_cell_get(q0 + 16);
    let fwd: u64 = std_types.meta_cell_get(q0 + 24);
    let a2: u32 = std_types.meta_cell_put(b + 24, fkd);
    let a3: u32 = std_types.meta_cell_put(b + 32, fwd);
    let a4: u32 = std_types.meta_cell_put(b + 72, ftlo);
    let a5: u32 = std_types.meta_cell_put(b + 80, fthi);
    // acc 名字窗口清 0：它只服务合成的那条收尾 `#break`，没有 acc 就没有它。
    let a6: u32 = std_types.meta_cell_put(b + 40, 0);
    let a7: u32 = std_types.meta_cell_put(b + 48, 0);
  }

  // 第二趟：初值各降级成一条表达式。指令发在 `#loop` 那一行之前。
  let inits: u32 = loop i(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      let bi6: u64 = k * 6;
      let ty: u64 = std_parse.ast_child(pgrp, bi6 + 2);
      let t_lo: u64 = std_parse.meta_node_start(ty);
      let t_hi: u64 = t_lo + std_parse.meta_node_len(ty);
      let pslot: u64 = 88 + k * 96;
      let q: addr = b + pslot;
      let kd: u64 = std_types.meta_cell_get(q + 16);
      let wd: u64 = std_types.meta_cell_get(q + 24);
      let ii: u64 = bi6 + 4;
      let est: u32 = meta.meta_emit_expr(base, len, kd, wd, t_lo, t_hi, pgrp, ii, 0, 0, 0, 0);
      let ibad: bool = est != 0;
      if ibad {
        break i(est);
      }
      let iref: u64 = std_types.meta_cell_get(sc + 168);
      let ilo: u64 = std_types.meta_cell_get(sc + 176);
      let ihi: u64 = std_types.meta_cell_get(sc + 184);
      let w0: u32 = std_types.meta_cell_put(q + 40, iref);
      let w1: u32 = std_types.meta_cell_put(q + 48, ilo);
      let w2: u32 = std_types.meta_cell_put(q + 56, ihi);
      continue i(k + 1);
    } else {
      break i(0);
    }
  };
  let ibadv: bool = inits != 0;
  if ibadv {
    let rel2: u32 = std_scope.meta_bump_release(mark);
    return inits;
  }

  // 表头：`  %NAME = #loop L<n>(%p1: T1 = <初值>, …) -> (Ta) {`
  let h1: u32 = std_lainir.lainir_st_pct_write();
  let nm_at: addr = base + n_lo;
  let nm_n: u64 = n_hi - n_lo;
  let h2: u32 = std_lainir.lainir_write(nm_at, nm_n);
  let h3: u32 = std_lainir.lainir_loop_head_write();
  let h4: u32 = std_lainir.lainir_emit_uint(lp_n);
  let h5: u32 = std_lainir.lainir_open_paren_write();
  let hdr: u32 = loop h(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      if k != 0 {
        let wc: u32 = std_lainir.lainir_comma_write();
      }
      let pslot: u64 = 88 + k * 96;
      let q: addr = b + pslot;
      let n_at: u64 = std_types.meta_cell_get(q);
      let n_hi2: u64 = std_types.meta_cell_get(q + 8);
      let kd: u64 = std_types.meta_cell_get(q + 16);
      let wd: u64 = std_types.meta_cell_get(q + 24);
      let iref: u64 = std_types.meta_cell_get(q + 40);
      let ilo: u64 = std_types.meta_cell_get(q + 48);
      let ihi: u64 = std_types.meta_cell_get(q + 56);
      let w3: u32 = meta_emit_operand(base, n_at, n_hi2, len);
      let w4: u32 = std_lainir.lainir_colon_write();
      let w5: u32 = std_lainir.lainir_repr(kd, wd);
      let w6: u32 = std_lainir.lainir_assign_write();
      let w7: u32 = meta.meta_emit_ref2(base, len, iref, ilo, ihi);
      continue h(k + 1);
    } else {
      break h(0);
    }
  };
  let h6: u32 = std_lainir.lainir_result_head_write();
  // 结果类型：有 `acc` 就取它，没有就取第一个参数的声明类型。
  let akd: u64 = std_types.meta_cell_get(b + 24);
  let noacc2: bool = akd == 0xFFFFFFFFFFFFFFFF;
  let q1: addr = b + 88;
  let akd_alt: u64 = std_types.meta_cell_get(q1 + 16);
  let awd_cur: u64 = std_types.meta_cell_get(b + 32);
  let awd_alt: u64 = std_types.meta_cell_get(q1 + 24);
  let akd2: u64 = if noacc2 {
    akd_alt
  } else {
    akd
  };
  let awd2: u64 = if noacc2 {
    awd_alt
  } else {
    awd_cur
  };
  let h7: u32 = std_lainir.lainir_repr(akd2, awd2);
  let h8: u32 = std_lainir.lainir_loop_body_open_write();

  // 条件（只有写了 `while` 才有）：命中坏码就地释放并返回。
  if w_ok {
    let ct_lo: u64 = std_types.meta_cell_get(b + 72);
    let ct_hi: u64 = std_types.meta_cell_get(b + 80);
    let cond_i: u64 = index + 4;
    let cest: u32 = meta.meta_emit_expr(base, len, akd2, awd2, ct_lo, ct_hi, parent, cond_i, 0, 0, 0, 0);
    let cbad: bool = cest != 0;
    if cbad {
      let rel3: u32 = std_scope.meta_bump_release(mark);
      return cest;
    }
    let cref0: u64 = std_types.meta_cell_get(sc + 168);
    let clo0: u64 = std_types.meta_cell_get(sc + 176);
    let chi0: u64 = std_types.meta_cell_get(sc + 184);
    let c1: u32 = std_lainir.lainir_indent4_write();
    let c2: u32 = std_lainir.lainir_if_head_write();
    let c3: u32 = meta.meta_emit_ref2(base, len, cref0, clo0, chi0);
    let c4: u32 = std_lainir.lainir_open_body();
  }
  // 循环体组：写了 `while` 时是表达式停下来的那一格，没写时就是第三格。
  let bi192: u64 = std_types.meta_cell_get(sc + 192);
  let bi: u64 = if w_ok {
    bi192
  } else {
    // `meta_cursor_next(%parent, %index)` 取的是孩子 `index + 1`，所以第三格
    // （循环体组）是孩子 `index + 3`。
    let bix: u64 = index + 3;
    bix
  };
  let body: u64 = std_parse.ast_child(parent, bi);
  let bk: u64 = std_parse.meta_node_kind(body);
  let isgrp: bool = bk == 2;
  let notgrp: bool = isgrp == 0;
  if notgrp {
    let fb0: u32 = lain_meta_fail(4);
    let rel4: u32 = std_scope.meta_bump_release(mark);
    return 4;
  }

  // 循环体里的 `break`/`continue` 靠暂存区 2456 找当前循环（嵌套时取最近一层）。
  let reg_cell: addr = sc + 2456;
  let reg_prev: u64 = std_types.meta_cell_get(reg_cell);
  let reg_set: u32 = std_types.meta_cell_put(reg_cell, blk);
  // 正在降级循环体的标志（0 = 不在循环体里）。
  let act_cell: addr = sc + 2384;
  let act_prev: u64 = std_types.meta_cell_get(act_cell);
  let act_set: u32 = std_types.meta_cell_put(act_cell, 1);
  // 出现过终止指令之后，剩余语句与收尾的 `#continue`/`#break` 都不再发。
  let term_cell: addr = sc + 2464;
  let term0: u32 = std_types.meta_cell_put(term_cell, 0);

  let sts: u32 = meta_lower_loop_stmts(base, len, body, 0, 0, pgrp);
  let reg_back: u32 = std_types.meta_cell_put(reg_cell, reg_prev);
  let act_back: u32 = std_types.meta_cell_put(act_cell, act_prev);
  let term: u64 = std_types.meta_cell_get(term_cell);
  let sbad2: bool = sts != 0;
  if sbad2 {
    let rel5: u32 = std_scope.meta_bump_release(mark);
    return sts;
  }

  // `    #continue L<n>(<参数值…>)`：一轮里没被赋值的参数把自己的当前值传下去。
  let termbad: bool = term != 0;
  if termbad == 0 {
    let v1: u32 = meta_emit_continue_now(base, len, b, nparam, lp_n);
  }
  // 写了 `while` 才有那个 `#if` 包裹要收：`    }`。
  if w_ok {
    let v5: u32 = std_lainir.lainir_close4_write();
  }
  // `    }`：条件为假时从 `#if` 之后落下，`#break` 带走 `acc`。只有真有 `acc` 参数时
  // 才合成这条收尾的 `#break`（没有 acc 的循环值由源码自己的 break 带出来）。
  if termbad == 0 {
    let accnow: u64 = std_types.meta_cell_get(b + 40);
    let hadacc: bool = accnow != 0;
    if hadacc {
      let v6: u32 = std_lainir.lainir_break_head_write();
      let v7: u32 = std_lainir.lainir_emit_uint(lp_n);
      let v8: u32 = std_lainir.lainir_open_paren_write();
      let a_lo: u64 = std_types.meta_cell_get(b + 40);
      let a_hi: u64 = std_types.meta_cell_get(b + 48);
      let v9: u32 = meta_emit_operand(base, a_lo, a_hi, len);
      let v10: u32 = std_lainir.lainir_rparen_nl_write();
    }
  }
  let v11: u32 = std_lainir.lainir_close_line_write();
  let rel6: u32 = std_scope.meta_bump_release(mark);
  return 0;
}

func meta_local_type_name(base: addr, n_lo: u64, n_hi: u64) -> u64 {
  let sc: addr = lain_meta_scratch_data();
  let count: u64 = std_types.meta_cell_get(sc + 2128);
  let tb: u64 = std_types.meta_cell_get(sc + 2136);
  // 表还没建就查不得：+2136 是 0 时读它是静默的加载故障，不是「查不到」。
  let no_table: bool = tb == 0;
  let empty0: bool = count == 0;
  let c_none: bool = count == 0xFFFFFFFFFFFFFFFF;
  let n1: bool = c_none or no_table;
  let none: bool = n1 or empty0;
  if none {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let rb: addr = std_regions.meta_region_scratch_base();
  let tbase: addr = rb + tb;
  let want: u64 = n_hi - n_lo;
  let hit: u64 = loop ls(i: u64 = count) {
    let more: bool = i > 0;
    if more {
      let k: u64 = i - 1;
      let off: u64 = k * 32;
      let e: addr = tbase + off;
      let elo: u64 = std_types.meta_cell_get(e);
      let ehi: u64 = std_types.meta_cell_get(e + 8);
      // 未使用的槽（从未写过的条目）读回的是 0/0，长度 0 匹配不上真名字。
      let have: u64 = ehi - elo;
      let len_ok: bool = have == want;
      let use_len: bool = want > 0;
      let same_len: bool = len_ok and use_len;
      if same_len {
        let a: addr = base + elo;
        let b: addr = base + n_lo;
        let eqb: bool = std_types.meta_bytes_equal(a, b, want);
        if eqb {
          let tlo: u64 = std_types.meta_cell_get(e + 16);
          let thi: u64 = std_types.meta_cell_get(e + 24);
          let put: u32 = std_types.meta_cell_put(sc + 0, thi);
          break ls(tlo);
        }
      }
      let i2: u64 = i - 1;
      continue ls(i2);
    } else {
      break ls(0xFFFFFFFFFFFFFFFF);
    }
  };
  return hit;
}

func meta_value_type_window(base: addr, len: u64, parent: u64, vi: u64, r_t_lo: u64, r_t_hi: u64) -> u64 {
  let asx: u64 = meta.meta_after_operand(base, len, parent, vi);
  let asc: u64 = std_parse.ast_child(parent, asx);
  let asc_pos: bool = asc != 0;
  let r_as: u64 = loop pick_as(t: u64 = 0) {
    if asc_pos == 0 {
      break pick_as(0xFFFFFFFFFFFFFFFF);
    }
    let asc_kind: u64 = std_parse.meta_node_kind(asc);
    let asc_tok: bool = asc_kind == 1;
    let asc_n: u64 = std_parse.meta_node_len(asc);
    let asc_two: bool = asc_n == 2;
    let asc_at: u64 = std_parse.meta_node_start(asc);
    let asc_p: addr = base + asc_at;
    let asc_same: bool = std_types.meta_bytes_equal(asc_p, std_lex.meta_kw_as, 2);
    let asc_a: bool = asc_tok and asc_two;
    let asc_yes: bool = asc_a and asc_same;
    if asc_yes == 0 {
      break pick_as(0xFFFFFFFFFFFFFFFF);
    }
    let ati: u64 = asx + 1;
    let atn: u64 = std_parse.ast_child(parent, ati);
    let atn_none: bool = atn == 0;
    if atn_none {
      break pick_as(0xFFFFFFFFFFFFFFFF);
    }
    let alo: u64 = std_parse.meta_node_start(atn);
    let ahi: u64 = alo + std_parse.meta_node_len(atn);
    let asc_sc: addr = lain_meta_scratch_data();
    let asc_put: u32 = std_types.meta_cell_put(asc_sc + 0, ahi);
    break pick_as(alo);
  };
  let no_as: bool = r_as == 0xFFFFFFFFFFFFFFFF;
  if no_as == 0 {
    return r_as;
  }
  let form: u64 = std_parse.meta_node_form(parent, vi);
  let is_group: bool = form == 2;
  if is_group {
    // 括号：值在组里面，游标进组、下标归零。
    let gv: u64 = std_parse.ast_child(parent, vi);
    let gi: u64 = meta_value_type_window(base, len, gv, 0, r_t_lo, r_t_hi);
    return gi;
  }
  let is_call: bool = form == 5;
  // 两支互斥，只有走到的那一支求值。
  let c: u64 = loop pick_c(t: u64 = 0) {
    if is_call {
      let v: u64 = std_parse.ast_child(parent, vi);
      let c_lo: u64 = std_parse.meta_node_start(v);
      let c_hi: u64 = c_lo + std_parse.meta_node_len(v);
      let name: addr = base + c_lo;
      let n_len: u64 = c_hi - c_lo;
      let cwin: u64 = meta_decl_ret_window(name, n_len);
      break pick_c(cwin);
    }
    let v2: u64 = std_parse.ast_child(parent, vi);
    let twin: u64 = std_records.meta_operand_type_window(base, len, parent, vi);
    break pick_c(twin);
  };
  let miss: bool = c == 0xFFFFFFFFFFFFFFFF;
  if miss == 0 {
    return c;
  }
  // 求不出来：退回本函数的返回类型，交给表达式发射器自己去定宽度。
  let sc: addr = lain_meta_scratch_data();
  let put: u32 = std_types.meta_cell_put(sc + 0, r_t_hi);
  return r_t_lo;
}

func meta_render_operand(base: addr, lo: u64, hi: u64, len: u64, out: addr) -> u64 {
  let b: u8 = std_lex.bs_byte_at(base, lo, len);
  let is_num: bool = std_lex.bs_is_digit(b);
  if is_num {
    // 数字开头不等于读得出值：`0x` 后面没有十六进制数字、`0x10` 这种**整段**都得是
    // 合法字面量。不查的话 `bs_read_uint` 只读出前缀能读的那部分，剩下的悄悄丢掉
    // —— 静默给错值是本仓库禁止的失败方式。
    let oknum: bool = meta.meta_is_int_literal(base, lo, hi, len);
    if oknum {
      let v: u64 = std_lex.bs_read_uint(base, lo, len);
      let n: u64 = std_lainir.lainir_buf_uint(out, 0, v);
      return n;
    }
    let badlit: u32 = lain_meta_fail(4);
    return 0xFFFFFFFFFFFFFFFF;
  }
  let pct: u64 = std_lainir.lainir_buf_byte(out, 0, 37);
  let at: addr = base + lo;
  let nwin: u64 = hi - lo;
  let w2: u64 = std_lainir.lainir_buf_bytes(out, pct, at, nwin);
  return w2;
}

func meta_args_prepare(base: addr, len: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, args: u64) -> u32 {
  let sc0: addr = lain_meta_scratch_data();
  let oldb: u64 = std_types.meta_cell_get(sc0 + 216);
  let oldc: u64 = std_types.meta_cell_get(sc0 + 496);
  let mark: u64 = std_scope.meta_bump_mark();
  let blk0: u64 = std_scope.meta_bump_alloc(312);
  let noblk: bool = blk0 == 0xFFFFFFFFFFFFFFFF;
  if noblk {
    // 分配器已经报过 17
    return 17;
  }
  // 这一层的存档：水位、外层的块、外层数到第几个实参
  let qa: addr = sc0 + blk0;
  let h1: u32 = std_types.meta_cell_put(qa, mark);
  let h2: u32 = std_types.meta_cell_put(qa + 8, oldb);
  let h3: u32 = std_types.meta_cell_put(qa + 16, oldc);
  // 当前块与计数交给这一层：块偏移从格子里现读，才能支持嵌套
  let cur: u32 = std_types.meta_cell_put(sc0 + 216, blk0);
  let z0: u32 = std_types.meta_cell_put(sc0 + 496, 0);
  let acount: u64 = std_parse.ast_child_count(args);
  let st: u32 = loop a(ai: u64 = 0) {
    let more: bool = ai < acount;
    if more {
      let c: u64 = std_parse.ast_child(args, ai);
      // 空实参（`f(,a)`）跳过去
      let at0: u64 = std_parse.meta_node_start(c);
      let b0: u8 = std_lex.bs_byte_at(base, at0, len);
      let iscomma0: bool = (b0 as u32) == 44;
      if iscomma0 {
        let ai0: u64 = ai + 1;
        continue a(ai0);
      }
      let sc: addr = lain_meta_scratch_data();
      let n: u64 = std_types.meta_cell_get(sc + 496);
      let full: bool = n >= 12;
      if full {
        let ff: u32 = lain_meta_fail(4);
        break a(4);
      }
      let est: u32 = meta.meta_emit_expr(base, len, kind, width, t_lo, t_hi, args, ai,
                                    0, 0, 0, 0);
      let ebad: bool = est != 0;
      if ebad {
        break a(est);
      }
      let ref_v: u64 = std_types.meta_cell_get(sc + 168);
      let lo: u64 = std_types.meta_cell_get(sc + 176);
      let hi: u64 = std_types.meta_cell_get(sc + 184);
      let endi: u64 = std_types.meta_cell_get(sc + 192);
      // 块偏移从格子里现读：循环体只带循环变量，外层局部值不进这一层的作用域
      let blk: u64 = std_types.meta_cell_get(sc + 216);
      let off: u64 = n * 24;
      let d0: u64 = off + 24;
      let slot: u64 = blk + d0;
      let q: addr = sc + slot;
      let s1: u32 = std_types.meta_cell_put(q, ref_v);
      let s2: u32 = std_types.meta_cell_put(q + 8, lo);
      let s3: u32 = std_types.meta_cell_put(q + 16, hi);
      let n2: u64 = n + 1;
      let s4: u32 = std_types.meta_cell_put(sc + 496, n2);
      // 下一个实参从终点之后接：终点必须到头、或者正好是 `,`
      let past: bool = endi >= acount;
      if past {
        break a(0);
      }
      let endc: u64 = std_parse.ast_child(args, endi);
      let en_at: u64 = std_parse.meta_node_start(endc);
      let en_b: u8 = std_lex.bs_byte_at(base, en_at, len);
      let en_comma: bool = (en_b as u32) == 44;
      let notcomma: bool = en_comma == 0;
      if notcomma {
        // 实参后面既不是 `,` 也不是到头（`f(1 2)` 之类）
        let f1: u32 = lain_meta_fail(4);
        break a(4);
      }
      let ai2: u64 = endi + 1;
      continue a(ai2);
    } else {
      break a(0);
    }
  };
  let sfail: bool = st != 0;
  if sfail {
    // 这一层失败：外层的块和计数还回去、水位退回，再把状态报上去。
    let scf: addr = lain_meta_scratch_data();
    let u1: u32 = std_types.meta_cell_put(scf + 216, oldb);
    let u2: u32 = std_types.meta_cell_put(scf + 496, oldc);
    let u3: u32 = std_scope.meta_bump_release(mark);
    return st;
  }
  return 0;
}

func meta_args_render(base: addr, len: u64, out: addr) -> u64 {
  let sc2: addr = lain_meta_scratch_data();
  let blk0: u64 = std_types.meta_cell_get(sc2 + 216);
  let cnt: u64 = std_types.meta_cell_get(sc2 + 496);
  let ba: addr = sc2 + blk0;
  let mark: u64 = std_types.meta_cell_get(ba);
  let oldb: u64 = std_types.meta_cell_get(ba + 8);
  let oldc: u64 = std_types.meta_cell_get(ba + 16);
  let w: u64 = loop b(i: u64 = 0, at: u64 = 0) {
    let fin: bool = i >= cnt;
    if fin {
      break b(at);
    }
    let notfirst: bool = i != 0;
    let at2: u64 = if notfirst {
      let sm: addr = std_lainir.lainir_comma;
      let wa: u64 = std_lainir.lainir_buf_bytes(out, at, sm, 2);
      wa
    } else {
      at
    };
    let blk: u64 = std_types.meta_cell_get(sc2 + 216);
    let off2: u64 = i * 24;
    let d2: u64 = off2 + 24;
    let slot2: u64 = blk + d2;
    let q2: addr = sc2 + slot2;
    let r2: u64 = std_types.meta_cell_get(q2);
    let l2: u64 = std_types.meta_cell_get(q2 + 8);
    let h2: u64 = std_types.meta_cell_get(q2 + 16);
    let at3: addr = out + at2;
    let n2: u64 = meta.meta_render_ref2(base, len, r2, l2, h2, at3);
    let at4: u64 = at2 + n2;
    let i2: u64 = i + 1;
    continue b(i2, at4);
  };
  let u1: u32 = std_types.meta_cell_put(sc2 + 216, oldb);
  let u2: u32 = std_types.meta_cell_put(sc2 + 496, oldc);
  let u3: u32 = std_scope.meta_bump_release(mark);
  return w;
}

func meta_emit_loop_temp(base: addr, len: u64, kind: u64, width: u64, a_lo: u64, a_hi: u64, b_lo: u64, b_hi: u64) -> u64 {
  let n: u64 = meta_next_temp();
  let buf: addr = std_lainir.lainir_text_buffer;
  let abuf: addr = buf + 96;
  let alen: u64 = meta_render_operand(base, a_lo, a_hi, len, buf);
  let blen: u64 = meta_render_operand(base, b_lo, b_hi, len, abuf);
  let w: u32 = std_lainir.lainir_binary_phys_at(n, kind, width, buf, alen, abuf, blen);
  return n;
}

func meta_lower_if(base: addr, len: u64, parent: u64, index: u64, c: u64, r_t_lo: u64, r_t_hi: u64) -> u32 {
  let ci: u64 = index + 1;
  let cond: u64 = std_parse.meta_cursor_next(parent, index);
  let nocond: bool = cond == 0;
  if nocond {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  // 条件的上下文类型取本函数的返回类型：`if 1 < 2 {` 这种两个裸字面量的条件要靠
  // 它查算子表（上下文查不到，才会退回字面量自己的类型）。
  let ctid: u64 = std_scalars.meta_type_resolve(base, len, r_t_lo, r_t_hi);
  let cmissing: bool = ctid == 0;
  if cmissing {
    let cf: u32 = lain_meta_fail(5);
    return 5;
  }
  let cinfo: u64 = std_registry.meta_tid_repr(ctid);
  let ckind: u64 = cinfo and 255;
  let cwidth: u64 = (cinfo >> 8) and 255;
  let ce: u32 = meta.meta_emit_expr(base, len, ckind, cwidth, r_t_lo, r_t_hi, parent, ci,
                               0, 0, 0, 0);
  let cbad: bool = ce != 0;
  if cbad {
    return ce;
  }
  let csc2: addr = lain_meta_scratch_data();
  let bi: u64 = std_types.meta_cell_get(csc2 + 192);
  let block: u64 = std_parse.ast_child(parent, bi);
  let bkind: u64 = std_parse.meta_node_kind(block);
  let isgroup: bool = bkind == 2;
  let notgroup: bool = isgroup == 0;
  if notgroup {
    // 条件后面不是块
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  // 先发 `#if <条件> {`，再降级块。条件的值引用已经在 168/176/184 那一格。
  let kw: addr = std_emit.meta_st_if;
  let w1: u32 = std_lainir.lainir_if_head2_write();
  let cref: u64 = std_types.meta_cell_get(csc2 + 168);
  let cl: u64 = std_types.meta_cell_get(csc2 + 176);
  let ch: u64 = std_types.meta_cell_get(csc2 + 184);
  let w2: u32 = meta.meta_emit_ref2(base, len, cref, cl, ch);
  let ob: addr = std_emit.meta_fn_open;
  let w3: u32 = std_lainir.lainir_open_body();
  let bst: u32 = meta_lower_body(base, len, block, r_t_lo, r_t_hi);
  let bfail: bool = bst != 0;
  if bfail {
    return bst;
  }
  // `else` 可选。它自己带收掉 `if` 块的那个 `}`，所以有它就先写 `  } else {`，
  // 没有就直接写 `  }` 加换行；两种情况都在最后收一次尾。else 词就在块组的下一格。
  let ei: u64 = bi + 1;
  let af: u64 = std_parse.meta_cursor_next(parent, bi);
  let ekw: addr = std_lex.meta_kw_else;
  let is_else: bool = std_parse.meta_node_is_word(af, ekw, 4);
  if is_else {
    let egrp: u64 = std_parse.meta_cursor_next(parent, ei);
    let ek: u64 = std_parse.meta_node_kind(egrp);
    let eisgrp: bool = ek == 2;
    let enotgrp: bool = eisgrp == 0;
    if enotgrp {
      // `else` 后面不是块
      let f3: u32 = lain_meta_fail(4);
      return 4;
    }
    let ew: addr = std_emit.meta_st_else;
    let w5: u32 = std_lainir.lainir_else_write();
    let bst2: u32 = meta_lower_body(base, len, egrp, r_t_lo, r_t_hi);
    let bf2: bool = bst2 != 0;
    if bf2 {
      return bst2;
    }
  }
  let cl2: addr = std_emit.meta_st_lend;
  let w4: u32 = std_lainir.lainir_close_line_write();
  // 调用方（`meta_lower_body`）要从这里接着数下一条语句。条件多 token 时块的
  // 位置不是常数，所以由本过程把「整条 if 之后的下标」与「有没有 else」写进
  // 暂存区。**必须写在最后**：块里的嵌套 if 也会写这两格，写完就没有别的调用了。
  let rsc: addr = lain_meta_scratch_data();
  let resume: u64 = if is_else {
    let r2: u64 = ei + 2;
    r2
  } else {
    let r1b: u64 = bi + 1;
    r1b
  };
  let pr: u32 = std_types.meta_cell_put(rsc + 2408, resume);
  let ie64: u64 = is_else as u64;
  let pe: u32 = std_types.meta_cell_put(rsc + 2416, ie64);
  return 0;
}

func meta_lower_if_value(base: addr, len: u64, parent: u64, index: u64, name_lo: u64, name_hi: u64, t_lo: u64, t_hi: u64, name_mode: u64, temp_num: u64) -> u32 {
  let ci: u64 = index + 1;
  let ctid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
  let cmiss: bool = ctid == 0;
  if cmiss {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }
  let cinfo: u64 = std_registry.meta_tid_repr(ctid);
  let ckind: u64 = cinfo and 255;
  let cwidth: u64 = (cinfo >> 8) and 255;
  let ces: u32 = meta.meta_emit_expr(base, len, ckind, cwidth, t_lo, t_hi, parent, ci,
                                0, 0, 0, 0);
  let cbad: bool = ces != 0;
  if cbad {
    return ces;
  }
  let sc: addr = lain_meta_scratch_data();
  let bi: u64 = std_types.meta_cell_get(sc + 192);
  let blk: u64 = std_parse.ast_child(parent, bi);
  let bk: u64 = std_parse.meta_node_kind(blk);
  let bk2: bool = bk == 2;
  let noblk: bool = bk2 == 0;
  if noblk {
    // 条件后面不是块
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let ind: addr = std_emit.meta_st_ind;
  let pct: addr = std_emit.meta_st_pct;
  let eqop: addr = std_emit.meta_st_eqop;
  let hif: addr = std_emit.meta_hash_if;
  let alp: addr = std_emit.meta_st_arrow_lp;
  let lh: addr = std_emit.meta_st_lhead;
  let yld: addr = std_emit.meta_st_yield;
  let nl: addr = std_emit.meta_st_nl;
  let ew: addr = std_emit.meta_st_else;
  let lend: addr = std_emit.meta_st_lend;
  let ekw: addr = std_lex.meta_kw_else;
  // `  %NAME = #if ` + 条件 + ` -> (` + 类型 + `) {\n`
  let w1: u32 = std_lainir.lainir_indent_write();
  let w2: u32 = std_lainir.lainir_st_pct_write();
  let srcname: bool = name_mode == 0;
  let w3: u32 = if srcname {
    let n_at: addr = base + name_lo;
    let n_len: u64 = name_hi - name_lo;
    let w3a: u32 = std_lainir.lainir_write(n_at, n_len);
    w3a
  } else {
    // 临时值名连百分号一起渲染，跳过首字节写（百分号已经由
    // `lainir_st_pct_write` 发过）。
    let ntxt: u64 = std_lainir.lainir_buf_temp(std_lainir.lainir_text_buffer,
                                    0, temp_num);
    let np1: addr = std_lainir.lainir_text_buffer + 1;
    let nlen: u64 = ntxt - 1;
    let w3b: u32 = std_lainir.lainir_write(np1, nlen);
    w3b
  };
  let w4: u32 = std_lainir.lainir_assign_write();
  let w5: u32 = std_lainir.lainir_if_head_write();
  let cref: u64 = std_types.meta_cell_get(sc + 168);
  let clo: u64 = std_types.meta_cell_get(sc + 176);
  let chi: u64 = std_types.meta_cell_get(sc + 184);
  let w6: u32 = meta.meta_emit_ref2(base, len, cref, clo, chi);
  let w7: u32 = std_lainir.lainir_arrow_lp_write();
  let w8: u32 = std_lainir.lainir_repr(ckind, cwidth);
  let w9: u32 = std_lainir.lainir_loop_body_open_write();
  // 真分支：表达式降级在区域里面，结果 `#yield` 出来。
  // 分支体可以是「前缀语句 + 值表达式」：`meta_lower_branch_value` 切开降级。
  let tst: u32 = meta_lower_branch_value(base, len, blk, ckind, cwidth, t_lo, t_hi);
  let tbad: bool = tst != 0;
  if tbad {
    return tst;
  }
  let w10: u32 = std_lainir.lainir_yield_write();
  let c1: u64 = std_types.meta_cell_get(sc + 168);
  let l1: u64 = std_types.meta_cell_get(sc + 176);
  let h1: u64 = std_types.meta_cell_get(sc + 184);
  let w11: u32 = meta.meta_emit_ref2(base, len, c1, l1, h1);
  let w12: u32 = std_lainir.lainir_newline_write();
  // `else` 可选，但**带值** if 的两个区域都必须有值（LAINIR 的区域要 yield），
  // 所以这里必须有 else，否则干净地报 4。else 词就在块组的下一格。
  let ei: u64 = bi + 1;
  let af: u64 = std_parse.meta_cursor_next(parent, bi);
  let is_else: bool = std_parse.meta_node_is_word(af, ekw, 4);
  if is_else {
    let egrp: u64 = std_parse.meta_cursor_next(parent, ei);
    let ek: u64 = std_parse.meta_node_kind(egrp);
    let ek2: bool = ek == 2;
    let enotgrp: bool = ek2 == 0;
    if enotgrp {
      // `else` 后面不是块
      let f2: u32 = lain_meta_fail(4);
      return 4;
    }
    let w13: u32 = std_lainir.lainir_else_write();
    let est: u32 = meta_lower_branch_value(base, len, egrp, ckind, cwidth,
                                           t_lo, t_hi);
    let ebad: bool = est != 0;
    if ebad {
      return est;
    }
    let w14: u32 = std_lainir.lainir_yield_write();
    let c2: u64 = std_types.meta_cell_get(sc + 168);
    let l2: u64 = std_types.meta_cell_get(sc + 176);
    let h2: u64 = std_types.meta_cell_get(sc + 184);
    let w15: u32 = meta.meta_emit_ref2(base, len, c2, l2, h2);
    let w16: u32 = std_lainir.lainir_newline_write();
  } else {
    // 缺 `else`：假分支发一条 `#yield`，值是结果类型的零值 —— bits 类直接
    // `#yield 0`，addr 先 `%r<n> = #int2ptr[#addr](0)` 再 yield 它。f/vec 的零值
    // 形态还没有，照样报 4（今天的源码类型里没有能落到这两种的标注）。
    let zdkind: bool = ckind == 0;
    let zdaddr: bool = ckind == 3;
    let zdok: bool = zdkind or zdaddr;
    let zdbad: bool = zdok == 0;
    if zdbad {
      let f3: u32 = lain_meta_fail(4);
      return 4;
    }
    let w13d: u32 = std_lainir.lainir_else_write();
    let zdi: u32 = if zdaddr {
      let zdt: u64 = meta_next_temp();
      let w13f: u32 = std_lainir.lainir_int2ptr_at(zdt, std_lainir.lainir_zero, 1);
      let w13e: u32 = std_lainir.lainir_yield_write();
      let w13g: u32 = std_lainir.lainir_temp_name_emit(zdt);
      0
    } else {
      let w13h: u32 = std_lainir.lainir_yield_write();
      let w13i: u32 = std_lainir.lainir_zero_write();
      0
    };
    let w13j: u32 = std_lainir.lainir_newline_write();
  }
  let w17: u32 = std_lainir.lainir_close_line_write();
  let rz: u64 = if is_else {
    let rza: u64 = ei + 2;
    rza
  } else {
    let rzb: u64 = bi + 1;
    rzb
  };
  // 操作数位置（模式 2）把「整条 if 之后」写进 +2368，表达式遍历接回。
  let wantres: bool = name_mode == 2;
  let wres: u32 = if wantres {
    let wresa: u32 = std_types.meta_cell_put(sc + 2368, rz);
    wresa
  } else {
    0
  };
  return 0;
}

func meta_is_builtin_name(base: addr, c_lo: u64, c_hi: u64) -> bool {
  let name: addr = base + c_lo;
  let a: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_load, 4);
  let b: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_lea, 3);
  let c: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_len, 3);
  let d: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_ptr_of, 6);
  let e: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_addr_of, 7);
  let ab: bool = a or b;
  let abc: bool = ab or c;
  let de: bool = d or e;
  let r: bool = abc or de;
  return r;
}

func meta_loop_phi_restore(b: addr, nparam: u64, save: addr) -> u32 {
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      let kslot: u64 = 88 + (k * 96);
      let kq: addr = b + kslot;
      let coff: u64 = k * 8;
      let sv: u64 = std_types.meta_cell_get(save + coff);
      let w1: u32 = std_types.meta_cell_put(kq + 32, sv);
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  return r;
}

func meta_param_scan(base: addr, len: u64, group: u64, index: u64, n_at: u64, n_hi: u64) -> u64 {
  let n_n: u64 = n_hi - n_at;
  let count: u64 = std_parse.ast_child_count(group);
  let r: u64 = loop s(i: u64 = index) {
    let more: bool = i < count;
    if more {
      let c: u64 = std_parse.ast_child(group, i);
      let c_at: u64 = std_parse.meta_node_start(c);
      let c_hi: u64 = c_at + std_parse.meta_node_len(c);
      let c_n: u64 = c_hi - c_at;
      let same_len: bool = c_n == n_n;
      if same_len {
        let p: addr = base + c_at;
        let q: addr = base + n_at;
        let e: bool = std_types.meta_bytes_equal(p, q, c_n);
        if e {
          // 名字后面必须正好是 `:`：那是**下一个位置**。
          let nx: u64 = std_parse.meta_cursor_next(group, i);
          let nx_at: u64 = std_parse.meta_node_start(nx);
          let b: u8 = std_lex.bs_byte_at(base, nx_at, len);
          let is_colon: bool = (b as u32) == 58;
          if is_colon {
            let tn: u64 = std_parse.meta_cursor_next(group, i + 1);
            let t_lo: u64 = std_parse.meta_node_start(tn);
            // 限定名（M.Point）按字节扫到名字末尾
            let t_hi: u64 = std_lex.bs_skip_qualified(base, t_lo, len);
            let sc: addr = lain_meta_scratch_data();
            let s_put: u32 = std_types.meta_cell_put(sc + 0, t_hi);
            break s(t_lo);
          }
          // 名字后面不是 `:`：这一格不是形参
          let i2: u64 = i + 1;
          continue s(i2);
        }
      }
      let i3: u64 = i + 1;
      continue s(i3);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return r;
}

func meta_decl_ret_window(name: addr, name_len: u64) -> u64 {
  let index: u64 = std_scope.meta_scope_find(name, name_len);
  let found: bool = index != 0xFFFFFFFFFFFFFFFF;
  let kind: u64 = if found {
    let k: u64 = std_scope.meta_scope_kind(index);
    k
  } else {
    0
  };
  let is_func: bool = kind == 6;
  if is_func == 0 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let parent: u64 = std_scope.meta_scope_aux(index);
  let at: u64 = std_scope.meta_scope_emitted(index);
  let ri: u64 = at + 3;
  let ret_node: u64 = std_parse.meta_cursor_next(parent, ri);
  let none: bool = ret_node == 0;
  if none {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let lo: u64 = std_parse.meta_node_start(ret_node);
  let hi: u64 = lo + std_parse.meta_node_len(ret_node);
  let sc: addr = lain_meta_scratch_data();
  let put: u32 = std_types.meta_cell_put(sc + 0, hi);
  return lo;
}

func meta_lower_func(base: addr, len: u64, parent: u64, index: u64, node: u64) -> u32 {
  // 参数组属于当前 lowering 调用层。旧值留在本过程的 LAINIR 调用帧中；内层返回后
  // 统一恢复共享格。mark 只负责回收内层遗漏的动态临时区，不为保存旧值额外占 scratch。
  let mark: u64 = std_scope.meta_bump_mark();
  let scratch: addr = lain_meta_scratch_data();
  let parent_params: u64 = std_types.meta_cell_get(scratch + 504);
  let parent_decl: u64 = std_types.meta_cell_get(scratch + 152);
  // 局部变量表（名字 → 类型名窗口）也属于当前 lowering 调用层：+2128 是条数、
  // +2136 是条目区起点（每条 24 字节：名字起点、名字终点、类型名起点、类型名终点）。
  // 它让 `let n: u64 = 1;` 之后 `n < 8` 查 u64 的算子表，不会拿 bool 的 op 表去查
  // （bool 表是空的 —— 报 6）。
  let parent_locals: u64 = std_types.meta_cell_get(scratch + 2128);
  let parent_lbase: u64 = std_types.meta_cell_get(scratch + 2136);
  let name_node: u64 = std_scope.meta_scope_name_of(parent, index);
  let name_lo: u64 = std_parse.meta_node_start(name_node);
  let name_len: u64 = std_parse.meta_node_len(name_node);
  let name: addr = base + name_lo;
  let decl_index: u64 = std_scope.meta_scope_find(name, name_len);
  let found: bool = decl_index != 0xFFFFFFFFFFFFFFFF;
  let decl_kind: u64 = if found {
    let k: u64 = std_scope.meta_scope_kind(decl_index);
    k
  } else {
    0
  };
  let is_func: bool = decl_kind == 6;
  let identity_ok: bool = found and is_func;
  if identity_ok == 0 {
    let fail: u32 = lain_meta_fail(9414);
    let restore0: u32 = std_types.meta_cell_put(scratch + 504, parent_params);
    let restore0b: u32 = std_types.meta_cell_put(scratch + 2128, parent_locals);
    let restore0c: u32 = std_types.meta_cell_put(scratch + 2136, parent_lbase);
    let restore1: u32 = std_scope.meta_bump_release(mark);
    return 9414;
  }
  let decl_set: u32 = std_types.meta_cell_put(scratch + 152, decl_index);
  let lowered: u32 = meta_lower_func_inner(base, len, parent, index, node);
  let restore: u32 = std_types.meta_cell_put(scratch + 504, parent_params);
  let restore_decl: u32 = std_types.meta_cell_put(scratch + 152, parent_decl);
  let restore_locals: u32 = std_types.meta_cell_put(scratch + 2128, parent_locals);
  let restore_lbase: u32 = std_types.meta_cell_put(scratch + 2136, parent_lbase);
  let released: u32 = std_scope.meta_bump_release(mark);
  return lowered;
}

func meta_find_semi_index(base: addr, parent: u64, index: u64) -> u64 {
  let kw: addr = std_lex.meta_kw_semi;
  let count: u64 = std_parse.ast_child_count(parent);
  let found: u64 = loop s(i: u64 = index) {
    let more: bool = i < count;
    if more {
      let c: u64 = std_parse.ast_child(parent, i);
      let hit: bool = std_parse.meta_node_is_word(c, kw, 1);
      if hit {
        break s(i);
      }
      let i2: u64 = i + 1;
      continue s(i2);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return found;
}

func meta_next_temp() -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let n: u64 = std_types.meta_cell_get(scratch + 144);
  let n2: u64 = n + 1;
  let put: u32 = std_types.meta_cell_put(scratch + 144, n2);
  return n2;
}

func meta_emit_close(base: addr, len: u64, close: u64, bound: bool, acc_v: u64,
                      alo: u64, ahi: u64, kind: u64, width: u64,
                      t_lo: u64, t_hi: u64, n_lo: u64, n_hi: u64) -> u32 {
  let plain: bool = close == 0;
  if plain {
    return 0;
  }
  let is_ret: bool = close == 2;
  if is_ret {
    // `return 300;` 在 bits<8> 的函数里：装不进就拒。
    let fc: u32 = meta.meta_literal_fits(base, len, acc_v, alo, ahi, kind, width);
    let fcbad: bool = fc != 0;
    if fcbad {
      return fc;
    }
    let buf: addr = std_lainir.lainir_text_buffer;
    let rlen: u64 = meta.meta_render_ref2(base, len, acc_v, alo, ahi, buf);
    let w: u32 = std_lainir.lainir_return_ref(buf, rlen);
    return 0;
  }
  if bound {
    return 0;
  }
  // 值是字面量/源码那段：复制进绑定之前先看装不装得下
  let bfc: u32 = meta.meta_literal_fits(base, len, acc_v, alo, ahi, kind, width);
  let bfbad: bool = bfc != 0;
  if bfbad {
    return bfc;
  }
  // 复制是编译器自己发的，不走源码的算子表：地址用 #lea(x, 0, 1, 0)，
  // 其余定宽整数用 #add[repr](x, 0)。u8/i8/addr 没有算子绑定，
  // 走算子表查 `+` 会报 6。
  let nbuf: addr = std_lainir.lainir_text_buffer;
  let pct0: u64 = std_lainir.lainir_buf_byte(nbuf, 0, 37);
  let n_at: addr = base + n_lo;
  let n_len: u64 = n_hi - n_lo;
  let nlen0: u64 = std_lainir.lainir_buf_bytes(nbuf, pct0, n_at, n_len);
  let abuf: addr = nbuf + 128;
  let alen0: u64 = meta.meta_render_ref2(base, len, acc_v, alo, ahi, abuf);
  let zbuf: addr = nbuf + 180;
  let zero0: u64 = std_lainir.lainir_buf_uint(zbuf, 0, 0);
  let is_addr: bool = kind == 3;
  let cpy: u32 = if is_addr {
    let w9: u32 = std_lainir.lainir_lea_named(nbuf, nlen0, abuf, alen0, zbuf, zero0, 1, 0);
    0
  } else {
    let addn: addr = std_emit.meta_sym_add;
    let w10: u32 = std_lainir.lainir_binary_op_named(nbuf, nlen0, addn, 3, kind, width,
                                          abuf, alen0, zbuf, zero0);
    0
  };
  return cpy;
}

func meta_emit_loop_step(base: addr, len: u64, kind: u64, width: u64,
                          i_lo: u64, i_hi: u64) -> u64 {
  let n: u64 = meta_next_temp();
  let buf: addr = std_lainir.lainir_text_buffer;
  let ibuf: addr = buf + 96;
  let ilen: u64 = meta_render_operand(base, i_lo, i_hi, len, buf);
  let olen: u64 = std_lainir.lainir_buf_uint(ibuf, 0, 1);
  let w: u32 = std_lainir.lainir_binary_phys_at(n, kind, width, buf, ilen, ibuf, olen);
  return n;
}

func meta_emit_load_temp(base: addr, len: u64, kind: u64, width: u64,
                          args: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let acount: u64 = std_parse.ast_child_count(args);
  let est: u32 = meta.meta_emit_expr(base, len, 3, 64, 0, 0, args, 0, 0, 0, 0, 0);
  let ebad: bool = est != 0;
  if ebad {
    return est;
  }
  let endi: u64 = std_types.meta_cell_get(sc + 192);
  let done: bool = endi >= acount;
  let tail: bool = done == 0;
  if tail {
    return 4;
  }
  let aref: u64 = std_types.meta_cell_get(sc + 168);
  let alo: u64 = std_types.meta_cell_get(sc + 176);
  let ahi: u64 = std_types.meta_cell_get(sc + 184);
  let buf: addr = std_lainir.lainir_text_buffer;
  let alen: u64 = meta.meta_render_ref2(base, len, aref, alo, ahi, buf);
  let tn: u64 = meta_next_temp();
  let w: u32 = std_lainir.lainir_load_at(tn, kind, width, buf, alen);
  let s1: u32 = std_types.meta_cell_put(sc + 168, tn);
  return 0;
}

func meta_emit_ptr_of_temp(base: addr, len: u64, kind: u64, width: u64,
                            args: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let acount: u64 = std_parse.ast_child_count(args);
  // 没有实参：尾随参数缺失。
  let zero: bool = acount == 0;
  if zero {
    let fz: u32 = lain_meta_fail(4);
    return 4;
  }
  // 实参必须是地址；类型未知或不是地址都拒（不猜）。
  let akind: u64 = meta_arg_repr_kind(base, len, args);
  let addr_arg: bool = akind == 3;
  let notaddr: bool = addr_arg == 0;
  if notaddr {
    let fb: u32 = lain_meta_fail(4);
    return 4;
  }
  let est: u32 = meta.meta_emit_expr(base, len, 3, 64, 0, 0, args, 0, 0, 0, 0, 0);
  let ebad: bool = est != 0;
  if ebad {
    return est;
  }
  let endi: u64 = std_types.meta_cell_get(sc + 192);
  let done: bool = endi >= acount;
  let tail: bool = done == 0;
  if tail {
    let ft: u32 = lain_meta_fail(4);
    return 4;
  }
  let aref: u64 = std_types.meta_cell_get(sc + 168);
  let alo: u64 = std_types.meta_cell_get(sc + 176);
  let ahi: u64 = std_types.meta_cell_get(sc + 184);
  let buf: addr = std_lainir.lainir_text_buffer;
  let alen: u64 = meta.meta_render_ref2(base, len, aref, alo, ahi, buf);
  let tn: u64 = meta_next_temp();
  let w: u32 = std_lainir.lainir_ptr2int_at(width, tn, buf, alen);
  let s1: u32 = std_types.meta_cell_put(sc + 168, tn);
  return 0;
}

func meta_emit_continue_now(base: addr, len: u64,
                            b: addr, nparam: u64,
                            lp_n: u64) -> u32 {
  let v1: u32 = std_lainir.lainir_continue_head_write();
  let v2: u32 = std_lainir.lainir_emit_uint(lp_n);
  let v3: u32 = std_lainir.lainir_open_paren_write();
  let vals: u32 = loop v(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      if k != 0 {
        let wc: u32 = std_lainir.lainir_comma_write();
      }
      let pslot: u64 = 88 + k * 96;
      let q: addr = b + pslot;
      let cur: u64 = std_types.meta_cell_get(q + 32);
      let isnone: bool = cur == 0xFFFFFFFFFFFFFFFF;
      if isnone {
        // 显式 `continue L(…)` 写过这个参数就用它的实参窗口，否则发参数自己的名字
        let ex_hi: u64 = std_types.meta_cell_get(q + 88);
        let has_ex: bool = ex_hi != 0;
        let we: u32 = if has_ex {
          let ex_lo: u64 = std_types.meta_cell_get(q + 80);
          let wx: u32 = meta_emit_operand(base, ex_lo, ex_hi, len);
          wx
        } else {
          let pn_lo: u64 = std_types.meta_cell_get(q);
          let pn_hi: u64 = std_types.meta_cell_get(q + 8);
          let wp: u32 = meta_emit_operand(base, pn_lo, pn_hi, len);
          wp
        };
      } else {
        let wt: u32 = meta_emit_temp_name(cur);
      }
      continue v(k + 1);
    } else {
      break v(0);
    }
  };
  let v4: u32 = std_lainir.lainir_rparen_nl_write();
  return 0;
}

func meta_lower_loop_stmts(base: addr, len: u64,
                            parent: u64, si0: u64,
                            now: u64, pgrp: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let boff: u64 = std_types.meta_cell_get(sc + 2456);
  let b: addr = sc + boff;
  let nparam: u64 = std_types.meta_cell_get(b + 8);
  let lp_n: u64 = std_types.meta_cell_get(b + 16);
  let bcount: u64 = std_parse.ast_child_count(parent);
  let sts: u32 = loop s(si: u64 = si0) {
    let more: bool = si < bcount;
    if more {
      let nm: u64 = std_parse.ast_child(parent, si);
      // 显式跳转：`break LABEL(值);` / `continue LABEL(实参…);`
      let isbrk2: bool = std_parse.meta_node_is_word(nm, std_lex.meta_kw_break, 5);
      let iscont2: bool = std_parse.meta_node_is_word(nm, std_lex.meta_kw_continue, 8);
      let isjump: bool = isbrk2 or iscont2;
      if isjump {
        let ji: u64 = meta_find_semi_index(base, parent, si);
        let jnos: bool = ji == 0xFFFFFFFFFFFFFFFF;
        if jnos {
          let fbj: u32 = lain_meta_fail(4);
          break s(fbj);
        }
        let jr: u32 = meta_lower_loop_jump(base, len, parent, si, now);
        let jrbad: bool = jr != 0;
        if jrbad {
          break s(jr);
        }
        // 这一串语句被跳转终结：循环体里的 if 据此决定还要不要发 #yield
        let jz1: u32 = std_types.meta_cell_put(sc + 2392, 1);
        break s(0);
      }
      // 语句 `if <条件> { … } [else { … }]`
      let isif2: bool = std_parse.meta_node_is_word(nm, std_lex.meta_kw_if, 2);
      if isif2 {
        let ir: u32 = meta_lower_loop_if(base, len, parent, si, pgrp);
        let irbad: bool = ir != 0;
        if irbad {
          break s(ir);
        }
        // 整条 `if` 之后的下标由那个分支自己写进暂存区 2376
        let rsi: u64 = std_types.meta_cell_get(sc + 2376);
        let jz2: u32 = std_types.meta_cell_put(sc + 2392, 0);
        continue s(rsi);
      }
      // 语句 `let NAME: T = 值;`：与函数体那条路同源 —— 标注的类型进局部变量表
      // （Meta 的循环体里到处是 `let e: addr = …;`、`let k: u64 = load(e + 8);`），
      // 值交给 `meta_lower_stmt` 降级。
      let islet2: bool = std_parse.meta_node_is_word(nm, std_lex.meta_kw_let, 3);
      if islet2 {
        let lsi: u64 = meta_find_semi_index(base, parent, si);
        let lnos: bool = lsi == 0xFFFFFFFFFFFFFFFF;
        if lnos {
          let fbl: u32 = lain_meta_fail(4);
          break s(fbl);
        }
        let lname: u64 = std_parse.ast_child(parent, si + 1);
        let lty: u64 = std_parse.ast_child(parent, si + 3);
        let lvalsemi: u64 = std_parse.ast_child(parent, lsi);
        let ln_lo: u64 = std_parse.meta_node_start(lname);
        let ln_hi: u64 = ln_lo + std_parse.meta_node_len(lname);
        let lt_lo: u64 = std_parse.meta_node_start(lty);
        let lt_hi: u64 = lt_lo + std_parse.meta_node_len(lty);
        let lreg: u32 = meta_local_type_put(ln_lo, ln_hi, lt_lo, lt_hi);
        let lvi: u64 = si + 5;
        let lst: u32 = meta_lower_stmt(base, len, parent, si, lvi, lvalsemi, 0,
                                       ln_lo, ln_hi, lt_lo, lt_hi);
        let lstbad: bool = lst != 0;
        if lstbad {
          break s(lst);
        }
        let jz4: u32 = std_types.meta_cell_put(sc + 2392, 0);
        let lnx: u64 = lsi + 1;
        continue s(lnx);
      }
      let eqn: u64 = std_parse.ast_child(parent, si + 1);
      let nk: u64 = std_parse.meta_node_kind(nm);
      let n_ok: bool = nk == 1;
      let e_ok: bool = std_parse.meta_node_is_word(eqn, std_lex.meta_kw_eq, 1);
      let shape: bool = n_ok and e_ok;
      let bad: bool = shape == 0;
      if bad {
        let fb1: u32 = lain_meta_fail(4);
        break s(fb1);
      }
      let n_at: u64 = std_parse.meta_node_start(nm);
      let n_hi2: u64 = n_at + std_parse.meta_node_len(nm);
      let nlen: u64 = n_hi2 - n_at;
      let kidx: u64 = meta_loop_param_index(base, n_at, nlen);
      let nomatch: bool = kidx == 0xFFFFFFFFFFFFFFFF;
      if nomatch {
        let fn0: u32 = lain_meta_fail(4);
        break s(fn0);
      }
      let kslot: u64 = 88 + kidx * 96;
      let kq: addr = b + kslot;
      let kd: u64 = std_types.meta_cell_get(kq + 16);
      let wd: u64 = std_types.meta_cell_get(kq + 24);
      let bi6: u64 = kidx * 6;
      let ty: u64 = std_parse.ast_child(pgrp, bi6 + 2);
      let t_lo: u64 = std_parse.meta_node_start(ty);
      let t_hi: u64 = t_lo + std_parse.meta_node_len(ty);
      let vi: u64 = si + 2;
      let est: u32 = meta.meta_emit_expr(base, len, kd, wd, t_lo, t_hi, parent, vi, 1, 0, 0, 0);
      let sbad: bool = est != 0;
      if sbad {
        break s(est);
      }
      let sref: u64 = std_types.meta_cell_get(sc + 168);
      let send: u64 = std_types.meta_cell_get(sc + 192);
      let sw: u32 = std_types.meta_cell_put(kq + 32, sref);
      let jz3: u32 = std_types.meta_cell_put(sc + 2392, 0);
      continue s(send + 1);
    } else {
      break s(0);
    }
  };
  return sts;
}

func meta_lower_body(base: addr, len: u64,
                      body: u64, r_t_lo: u64,
                      r_t_hi: u64) -> u32 {
  let count: u64 = std_parse.ast_child_count(body);
  let st: u32 = loop stmts(si: u64 = 0, saw_ret: bool = 0) {
    let more: bool = si < count;
    if more {
      let c: u64 = std_parse.ast_child(body, si);
      // `if` 先分出去：它的 `;` 语义跟别的语句不一样（`meta_find_semi` 会一路找到
      // **后面**那条语句的 `;`，因为块里的 `;` 在组里面、不是兄弟）。
      let ck: u64 = std_parse.meta_node_form(body, si);
      let is_if: bool = ck == 11;
      if is_if {
        let ist: u32 = meta_lower_if(base, len, body, si, c, r_t_lo, r_t_hi);
        let ibad: bool = ist != 0;
        if ibad {
          break stmts(ist);
        }
        // 下一条语句从哪继续：条件是多 token 时块的位置不是常数，所以由
        // `meta_lower_if` 把「整条 if 之后的下标」和「有没有 else」写在暂存区
        // 2408/2416（它在返回前最后才写，块里的嵌套 if 覆盖不掉）。跳错的话
        // `else` 后面那个块会被当成一条新语句去 `meta_find_semi`，报一个跟真实原因
        // 无关的 21。
        let isc: addr = lain_meta_scratch_data();
        let next0: u64 = std_types.meta_cell_get(isc + 2408);
        let eflag: u64 = std_types.meta_cell_get(isc + 2416);
        let has_else: bool = eflag != 0;
        // 这一格有三种情况：
        //   - 带 `else`：两支都以 `return` 收尾，这条语句一定终结，`saw_ret` 置 1。
        //   - 没有 `else` 但块尾就是这条 `if`（后面没有兄弟语句）：内层分支里的 `return`
        //     已经是这一层的出口，也把它当终结。只看 `has_else` 会让
        //     `if c { return 6; } }` 这种形状在块尾报 20「函数体结尾没有 return」，
        //     而手写层到处是这种收尾。
        //   - 后面还有兄弟语句：`if` 里的 return 可能不走，`saw_ret` 保持原样。
        let itail: bool = next0 >= count;
        let done_if: bool = has_else or itail;
        continue stmts(next0, done_if);
      }
      let semi_i: u64 = meta_find_semi_index(base, body, si);
      let nosemi: bool = semi_i == 0xFFFFFFFFFFFFFFFF;
      if nosemi {
        let f0: u32 = lain_meta_fail(21);
        break stmts(21);
      }
      // `;` 在哪个下标：语句从 %si 起，`;` 是这条语句的最后一格。
      let semi: u64 = std_parse.ast_child(body, semi_i);
      // 内存写是**语句**（#store 没有结果），所以在这里接，不走表达式那条路。
      let is_store: bool = std_parse.meta_node_is_word(c, std_lex.meta_kw_store, 5);
      if is_store {
        let sst: u32 = meta_lower_store(base, len, body, si, r_t_lo, r_t_hi);
        let sbad3: bool = sst != 0;
        if sbad3 {
          break stmts(sst);
        }
        let snext: u64 = semi_i + 1;
        continue stmts(snext, 0);
      }
      let handler: u64 = std_syntax.meta_syntax_lookup(c, 1, 0, 2);
      let is_ret: bool = handler == 8;
      let is_let: bool = handler == 9;
      if is_ret {
        let rvi: u64 = si + 1;
        let r: u32 = meta_lower_stmt(base, len, body, si, rvi, semi, 1,
                                     0, 0, r_t_lo, r_t_hi);
        let rbad: bool = r != 0;
        if rbad {
          break stmts(r);
        }
        continue stmts(semi_i + 1, is_ret);
      }
      if is_let == 0 {
        let f2: u32 = lain_meta_fail(4);
        break stmts(4);
      }
      let ni: u64 = si + 1;
      let name_node: u64 = std_parse.ast_child(body, ni);
      let ai: u64 = si + 2;
      let after: u64 = std_parse.ast_child(body, ai);
      let has_colon: bool = std_parse.meta_node_is_word(after, std_lex.meta_kw_colon, 1);
      if has_colon {
        // `let NAME: T = 值;`
        let ti: u64 = si + 3;
        let t_node: u64 = std_parse.ast_child(body, ti);
        let eqi: u64 = si + 4;
        let eq_node: u64 = std_parse.ast_child(body, eqi);
        let vi: u64 = si + 5;
        let v: u64 = std_parse.ast_child(body, vi);
        let t_lo: u64 = std_parse.meta_node_start(t_node);
        let t_hi: u64 = t_lo + std_parse.meta_node_len(t_node);
        let n_lo: u64 = std_parse.meta_node_start(name_node);
        let n_hi: u64 = n_lo + std_parse.meta_node_len(name_node);
        // 这条绑定记进局部变量表：后面用到这个名字时，算子的类型取它自己的标注。
        let lp: u32 = meta_local_type_put(n_lo, n_hi, t_lo, t_hi);
        // `= for ...` 是循环，不是值：整条 `for` 自己发 `#loop`，
        // 结果绑在这个 `let` 的名字上。`for` 的位置就是 `%vi`。
        let for_handler: u64 = std_syntax.meta_syntax_lookup(v, 1, 0, 2);
        let is_for: bool = for_handler == 10;
        // `= loop …` 也是循环，但它不需要绑定的标注：循环参数自带类型，
        // 结果的宽度取名字是 `acc` 的那个参数声明的类型。
        let is_loop: bool = for_handler == 13;
        if is_for {
          let fr: u32 = meta_lower_for(base, len, body, vi, n_lo,
                                       n_hi, t_lo, t_hi);
          let frbad: bool = fr != 0;
          if frbad {
            break stmts(fr);
          }
          continue stmts(semi_i + 1, is_ret);
        }
        if is_loop {
          let lr: u32 = meta_lower_loop(base, len, body, vi,
                                        n_lo, n_hi);
          let lrbad: bool = lr != 0;
          if lrbad {
            break stmts(lr);
          }
          continue stmts(semi_i + 1, is_ret);
        }
        let stc: u32 = meta_lower_stmt(base, len, body, si, vi,
                                       semi, 0, n_lo, n_hi, t_lo,
                                       t_hi);
        let stcbad: bool = stc != 0;
        if stcbad {
          break stmts(stc);
        }
        continue stmts(semi_i + 1, is_ret);
      }
      // 没有类型标注：`let y = <值>;`。值在 si+3（`let`、名字、`=`、值）。
      // 类型窗口从**值**求（见 `meta_value_type_window`）：调用取被调方声明的
      // 返回类型、参数名取参数表、括号往里一层；都不是就退回本函数的返回类型
      // 当上下文 —— 本地变量本来就没有类型来源（`meta_word_type_name` 只认参数）。
      let eq_i2: u64 = si + 2;
      let eq_n2: u64 = std_parse.ast_child(body, eq_i2);
      let is_eq2: bool = std_parse.meta_node_is_word(eq_n2, std_lex.meta_kw_eq, 1);
      if is_eq2 == 0 {
        // 形状不像 `let 名字 = …`
        let f1c: u32 = lain_meta_fail(21);
        break stmts(21);
      }
      let vi2: u64 = si + 3;
      let v2: u64 = std_parse.ast_child(body, vi2);
      let for_h2: u64 = std_syntax.meta_syntax_lookup(v2, 1, 0, 2);
      let is_for2: bool = for_h2 == 10;
      let no_for2: bool = is_for2 == 0;
      let n2_lo: u64 = std_parse.meta_node_start(name_node);
      let n2_hi: u64 = n2_lo + std_parse.meta_node_len(name_node);
      let is_loop2: bool = for_h2 == 13;
      if no_for2 == 0 {
        // `let y = for ...` 要累加器的类型才发得出 `#loop` 的结果宽度；
        // `loop` 不用（参数自带类型），`%no_for2` 那一支接两种循环。
        let f1b: u32 = lain_meta_fail(21);
        break stmts(21);
      }
      if is_loop2 {
        let lr2: u32 = meta_lower_loop(base, len, body, vi2,
                                       n2_lo, n2_hi);
        let lr2bad: bool = lr2 != 0;
        if lr2bad {
          break stmts(lr2);
        }
        continue stmts(semi_i + 1, is_ret);
      }
      // `let b = load(p);`：内建返回值的宽度只能来自期望类型，值本身
      // 推不出类型就拒。
      let v2_at: u64 = std_parse.meta_node_start(v2);
      let v2_hi: u64 = v2_at + std_parse.meta_node_len(v2);
      let v2_prim: bool = meta_is_builtin_name(base, v2_at, v2_hi);
      if v2_prim {
        let f1d: u32 = lain_meta_fail(4);
        break stmts(4);
      }
      let vt_lo: u64 = meta_value_type_window(base, len, body, vi2,
                                              r_t_lo, r_t_hi);
      let tsc: addr = lain_meta_scratch_data();
      let vt_hi: u64 = std_types.meta_cell_get(tsc + 0);
      let st3: u32 = meta_lower_stmt(base, len, body, si, vi2,
                                     semi, 0, n2_lo, n2_hi, vt_lo,
                                     vt_hi);
      let st3bad: bool = st3 != 0;
      if st3bad {
        break stmts(st3);
      }
      continue stmts(semi_i + 1, is_ret);
    } else {
      // 函数体结尾没有 return：LAINIR 的过程体必须以终结子收尾。
      if saw_ret {
        break stmts(0);
      }
      let f3: u32 = lain_meta_fail(20);
      break stmts(20);
    }
  };
  return st;
}

func meta_word_type_name(base: addr, len: u64,
                           node: u64) -> u64 {
  let k: u64 = std_parse.meta_node_kind(node);
  // AstIn 的物理 kind 始终是 Token=1 或 Group=2；语法形状只在旁表。
  let is_word: bool = k == 1;
  if is_word == 0 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let sc: addr = lain_meta_scratch_data();
  let pn: u64 = std_types.meta_cell_get(sc + 504);
  let gone: bool = pn == 0;
  if gone {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let n_at: u64 = std_parse.meta_node_start(node);
  let n_hi: u64 = n_at + std_parse.meta_node_len(node);
  // 参数组的第 0 个位置就是第一个参数 —— 扫描从游标 (参数组, 0) 开始。
  let f: u64 = meta_param_scan(base, len, pn, 0, n_at, n_hi);
  let missed: bool = f == 0xFFFFFFFFFFFFFFFF;
  if missed == 0 {
    return f;
  }
  // 不是参数：先问局部变量表（`let n: u64 = …;` 自己那条标注），再问循环参数表。
  let lw: u64 = meta_local_type_name(base, n_at, n_hi);
  let lmiss: bool = lw == 0xFFFFFFFFFFFFFFFF;
  if lmiss {
    return meta_loop_type_name(base, n_at, n_hi);
  }
  return lw;
}

func meta_lower_func_inner(base: addr, len: u64,
                            parent: u64, index: u64,
                            node: u64) -> u32 {
  let ni: u64 = index + 1;
  let name_node: u64 = std_parse.meta_cursor_next(parent, index);
  let pi: u64 = index + 2;
  let params: u64 = std_parse.meta_cursor_next(parent, ni);
  // 当前函数的参数组节点记到暂存区 `+504`；外层包装负责保存并恢复调用层状态。
  // 为什么需要它：算子的操作数宽度该看**操作数自己**的类型，不是看绑定/返回的类型。
  // `func f(x: i32) -> bool { return x < 2; }` 里 `<` 的两个操作数是 i32，而 bool 的
  // op 表是空的 —— 拿绑定的类型去查表查不到 `<`。
  let scp: addr = lain_meta_scratch_data();
  let sp: u32 = std_types.meta_cell_put(scp + 504, params);
  let ai: u64 = index + 3;
  let arrow: u64 = std_parse.meta_cursor_next(parent, pi);
  let ri: u64 = index + 4;
  let ret_node: u64 = std_parse.meta_cursor_next(parent, ai);
  let ccnt: u64 = std_parse.ast_child_count(parent);
  let bnext: u64 = loop body_scan(j: u64 = ri) {
    let past_end: bool = j >= ccnt;
    if past_end { break body_scan(0xFFFFFFFFFFFFFFFF); }
    let bform: u64 = std_parse.meta_node_form(parent, j);
    let is_group: bool = bform == 2;
    if is_group { break body_scan(j); }
    continue body_scan(j + 1);
  };
  let nobody: bool = bnext == 0xFFFFFFFFFFFFFFFF;
  if nobody {
    let fb0: u32 = lain_meta_fail(4);
    return 4;
  }
  // `meta_cursor_next(parent, i)` 取的是**下标 i 的下一个**孩子，所以这里减一。
  let bprev: u64 = bnext - 1;
  let body: u64 = std_parse.meta_cursor_next(parent, bprev);

  // 每个函数体一张新的局部变量表：条目区从 bump 动态区要（表随绑定数增长），条数归零。
  // 表的寿命是这一次函数体 lowering —— 由 meta_lower_func 恢复外层那份。容量按函数体
  // 的孩子数给（一条语句最多产生一条绑定），够用；越界写会撞上别的临时块。
  let pcount0: u64 = std_parse.ast_child_count(body);
  let lmark: u64 = std_scope.meta_bump_mark();
  let lbytes: u64 = pcount0 * 32;
  let lbytes2: u64 = lbytes + 32;
  let loff: u64 = std_scope.meta_bump_alloc(lbytes2);
  let lbad: bool = loff == 0xFFFFFFFFFFFFFFFF;
  if lbad { return 17; }
  // 条目区的**字节偏移**（相对 scratch 基址）存进固定格，读的时候再算地址：地址值
  // 跨调用层会被别的 bump 块叠在上面（读回一个已释放的地址 → 1004），偏移不会。
  let lz: u32 = std_types.meta_cell_put(scp + 2128, 0);
  let lb: u32 = std_types.meta_cell_put(scp + 2136, loff);

  let r_lo: u64 = std_parse.meta_node_start(ret_node);
  // 限定名（M.Point）跨多个 token：函数体的返回类型窗口也要扫到名字末尾
  let r_hi: u64 = std_lex.bs_skip_qualified(base, r_lo, len);
  let hdr: u32 = meta_emit_proc_header(base, len, name_node, params,
                                        ret_node, 1);
  let hbad: bool = hdr != 0;
  if hbad { return hdr; }
  let w6: u32 = std_lainir.lainir_open_body();
  // 语句序列
  let bst: u32 = meta_lower_body(base, len, body, r_lo, r_hi);
  // 局部变量表的条目区在 bump 动态区：函数体 lowering 结束就还回去。
  let lrel2: u32 = std_scope.meta_bump_release(lmark);
  let bfail: bool = bst != 0;
  if bfail { return bst; }
  let w7: u32 = std_lainir.lainir_close_brace_write();
  return 0;
}

func meta_emit_op_mid(kind: u64, width: u64) -> u32 {
  let w: u32 = std_lainir.lainir_op_prefix_phys(kind, width);
  return w;
}

func meta_emit_temp_name(n: u64) -> u32 {
  let w: u32 = std_lainir.lainir_temp_name_emit(n);
  return w;
}

func meta_args_write(base: addr, len: u64) -> u32 {
  let sc2: addr = lain_meta_scratch_data();
  let blk0: u64 = std_types.meta_cell_get(sc2 + 216);
  let cnt: u64 = std_types.meta_cell_get(sc2 + 496);
  let ba: addr = sc2 + blk0;
  let mark: u64 = std_types.meta_cell_get(ba);
  let oldb: u64 = std_types.meta_cell_get(ba + 8);
  let oldc: u64 = std_types.meta_cell_get(ba + 16);
  let w: u32 = loop b(i: u64 = 0) {
    let fin: bool = i >= cnt;
    if fin {
      break b(0);
    }
    let notfirst: bool = i != 0;
    if notfirst {
      let w1: u32 = std_lainir.lainir_comma_write();
    }
    let blk: u64 = std_types.meta_cell_get(sc2 + 216);
    let off2: u64 = i * 24;
    let d2: u64 = off2 + 24;
    let slot2: u64 = blk + d2;
    let q2: addr = sc2 + slot2;
    let r2: u64 = std_types.meta_cell_get(q2);
    let l2: u64 = std_types.meta_cell_get(q2 + 8);
    let h2: u64 = std_types.meta_cell_get(q2 + 16);
    let w2: u32 = meta.meta_emit_ref2(base, len, r2, l2, h2);
    let i2: u64 = i + 1;
    continue b(i2);
  };
  // 这一层用完就还：水位退回、外层的块和计数还原。成功失败都要还。
  let u1: u32 = std_types.meta_cell_put(sc2 + 216, oldb);
  let u2: u32 = std_types.meta_cell_put(sc2 + 496, oldc);
  let u3: u32 = std_scope.meta_bump_release(mark);
  return w;
}

func meta_lower_stmt(base: addr, len: u64, parent: u64, index: u64, vindex: u64, semi: u64, is_ret: bool, name_lo: u64, name_hi: u64, t_lo: u64, t_hi: u64) -> u32 {
  let vi: u64 = vindex + 0;
  let v: u64 = std_parse.ast_child(parent, vi);
  let tid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
  let no_type: bool = tid == 0;
  if no_type {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }
  let info: u64 = std_registry.meta_tid_repr(tid);
  let kind: u64 = info and 255;
  let width: u64 = (info >> 8) and 255;
  // 带值 if：值的第一个 token 是 `if` 那个词。两个位置都收（模式 0 / 模式 1）。
  let vif: bool = std_parse.meta_node_is_word(v, std_lex.meta_kw_if, 2);
  let vif_named: bool = name_hi != name_lo;
  let do_vif: bool = vif and vif_named;
  if do_vif {
    let vif_st: u32 = meta_lower_if_value(base, len, parent, vi, name_lo, name_hi, t_lo, t_hi, 0, 0);
    return vif_st;
  }
  let vif_ret: bool = vif and is_ret;
  if vif_ret {
    let vtn: u64 = meta_next_temp();
    let vrst: u32 = meta_lower_if_value(base, len, parent, vi, 0, 0, t_lo, t_hi, 1, vtn);
    let vrstz: bool = vrst != 0;
    if vrstz {
      return vrst;
    }
    let vbuf: addr = std_lainir.lainir_text_buffer;
    let vrlen: u64 = std_lainir.lainir_buf_temp(vbuf, 0, vtn);
    let vw: u32 = std_lainir.lainir_return_ref(vbuf, vrlen);
    return 0;
  }
  // 形状读识别 pass 算好的那一格（键 = 这个出现位置）。
  let form: u64 = std_parse.meta_node_form(parent, vi);
  let v_st: u64 = std_parse.meta_node_start(v);
  let hasop: bool = std_recognize.meta_value_has_op(base, len, v_st);
  let single: bool = hasop == 0;
  let f_call0: bool = form == 5;
  let v_hi0: u64 = v_st + std_parse.meta_node_len(v);
  let prim0: bool = meta_is_builtin_name(base, v_st, v_hi0);
  let notprim0: bool = prim0 == 0;
  let callable: bool = f_call0 and single;
  let f_call: bool = callable and notprim0;
  let f_ctor: bool = form == 10;
  let f_ctor_only: bool = f_ctor and single;
  if f_ctor_only {
    // 返回刚构造的聚合：`#alloca` 的水位在帧弹出时回退，那个地址出了帧就失效。
    if is_ret {
      let esc0: u32 = lain_meta_fail(11);
      return 11;
    }
    let ctor_lo: u64 = std_parse.meta_node_start(v);
    let ctor_ln: u64 = std_parse.meta_node_len(v);
    let ctor_hi: u64 = ctor_lo + ctor_ln;
    let ctor_grp: u64 = std_parse.meta_cursor_next(parent, vi);
    let ctor_st: u32 = std_records.meta_lower_construct_local(base, len, name_lo, name_hi, ctor_lo, ctor_hi, ctor_grp, is_ret);
    return ctor_st;
  }
  // 和类型的变体构造（`Shape.Circle { k }`）：形状 6 加花括号组。
  let d_delim2: u8 = meta.meta_dotted_delim(base, len, parent, vi);
  let d_delim2_w: u32 = d_delim2 as u32;
  let d_brace2: bool = d_delim2_w == 123;
  let d_enum2: bool = std_sums.meta_is_enum(base, len, v_st, v_hi0);
  let d_ctor2: bool = d_brace2 and d_enum2;
  let f_sumctor: bool = d_ctor2 and single;
  if f_sumctor {
    if is_ret {
      let esc1: u32 = lain_meta_fail(11);
      return 11;
    }
    let sc_after: u64 = std_lex.bs_skip_space(base, v_hi0, len);
    let sc_vlo: u64 = std_lex.bs_skip_space(base, sc_after + 1, len);
    let sc_vhi: u64 = std_lex.bs_skip_ident(base, sc_vlo, len);
    let sc_mi: u64 = vi + 2;
    let sc_gi: u64 = vi + 3;
    let sc_st: u32 = std_sums.meta_lower_sum_construct_local(base, len, name_lo, name_hi, v_st, v_hi0, sc_vlo, sc_vhi, parent, sc_gi, is_ret);
    return sc_st;
  }
  // 返回聚合时，地址必须是调用方给的或被调用方算出来的。
  let agg4: u64 = std_records.meta_scope_body(base, t_lo, t_hi, 4);
  let agg5: u64 = std_records.meta_scope_body(base, t_lo, t_hi, 5);
  let agg4m: bool = agg4 == 0xFFFFFFFFFFFFFFFF;
  let agg5m: bool = agg5 == 0xFFFFFFFFFFFFFFFF;
  let agg_no: bool = agg4m and agg5m;
  let agg: bool = agg_no == 0;
  let agg_ret: bool = agg and is_ret;
  // 「普通名字」的判据用排除法。
  let v_kind0: u64 = std_parse.meta_node_kind(v);
  let v_word0: bool = v_kind0 == 1;
  let not_call: bool = form != 5;
  let not_field: bool = form != 6;
  let not_ctor: bool = form != 10;
  let not_group: bool = form != 2;
  let p1: bool = not_call and not_field;
  let p2: bool = not_ctor and not_group;
  let plain_shape: bool = p1 and p2;
  let plain_name: bool = plain_shape and v_word0;
  let check_name: bool = agg_ret and plain_name;
  if check_name {
    let v_lo: u64 = std_parse.meta_node_start(v);
    let v_hi: u64 = v_lo + std_parse.meta_node_len(v);
    let lwin: u64 = meta_local_type_name(base, v_lo, v_hi);
    let islocal: bool = lwin != 0xFFFFFFFFFFFFFFFF;
    if islocal {
      let esc2: u32 = lain_meta_fail(11);
      return 11;
    }
    let ntw: u64 = meta_word_type_name(base, len, v);
    let notparam: bool = ntw == 0xFFFFFFFFFFFFFFFF;
    if notparam {
      let esc2b: u32 = lain_meta_fail(11);
      return 11;
    }
  }
  // 调用本身单独接住（两者的实参写法不同）。其余形状一律交给表达式发射器。
  if f_call == 0 {
    let close: u64 = if is_ret { 2 } else { 1 };
    let est: u32 = meta.meta_emit_expr(base, len, kind, width, t_lo, t_hi, parent, vi, 1, close, name_lo, name_hi);
    return est;
  }
  let grp: u64 = std_parse.meta_cursor_next(parent, vi);
  let notret: bool = is_ret == 0;
  if notret {
    let d_lo: u64 = std_parse.meta_node_start(v);
    let d_ln: u64 = std_parse.meta_node_len(v);
    let d_hi: u64 = d_lo + d_ln;
    let bc: u32 = meta_emit_binding_call(base, len, kind, width, name_lo, name_hi, t_lo, t_hi, d_lo, d_hi, grp);
    return bc;
  }
  let c_lo: u64 = std_parse.meta_node_start(v);
  let c_ln: u64 = std_parse.meta_node_len(v);
  let c_hi: u64 = c_lo + c_ln;
  let rc: u32 = meta_emit_ret_call(base, len, kind, width, t_lo, t_hi, c_lo, c_hi, grp);
  return rc;
}

func meta_lower_branch_prefix(base: addr, len: u64, blk: u64, limit: u64, r_t_lo: u64, r_t_hi: u64) -> u32 {
  let st: u32 = loop stmts(i: u64 = 0) {
    let more: bool = i < limit;
    if more {
      let c: u64 = std_parse.ast_child(blk, i);
      let c_none: bool = c == 0;
      if c_none {
        break stmts(0);
      }
      let is_store: bool = std_parse.meta_node_is_word(c, std_lex.meta_kw_store, 5);
      let s: u32 = loop pick_s(t: u32 = 0) {
        if is_store {
          let w0: u32 = meta_lower_store(base, len, blk, i, r_t_lo, r_t_hi);
          break pick_s(w0);
        }
        let handler: u64 = std_syntax.meta_syntax_lookup(c, 1, 0, 2);
        let is_let: bool = handler == 9;
        if is_let == 0 {
          let f1: u32 = lain_meta_fail(4);
          break pick_s(4);
        }
        // `%c` 是 `let` 那个词本身：绑定名在下一格。
        let name_node: u64 = std_parse.ast_child(blk, i + 1);
        let n_lo: u64 = std_parse.meta_node_start(name_node);
        let n_hi: u64 = n_lo + std_parse.meta_node_len(name_node);
        // `let NAME: T = …` 的值在 `si+5`；`let NAME = …` 在 `si+3`。
        let c2: u64 = std_parse.ast_child(blk, i + 2);
        let is_colon: bool = std_parse.meta_node_is_word(c2, std_lex.meta_kw_colon, 1);
        let vi: u64 = if is_colon {
          let e1: u64 = i + 5;
          e1
        } else {
          let e2: u64 = i + 3;
          e2
        };
        // 带标注：窗口就是标注那个节点。没标注：从值推，终点写进暂存区 +0，紧接着
        // 读回来（与 meta_lower_body 那条无标注路同一个来源）。
        let t_lo: u64 = if is_colon {
          let tn: u64 = std_parse.ast_child(blk, i + 3);
          let tn_lo: u64 = std_parse.meta_node_start(tn);
          tn_lo
        } else {
          let tsc0: addr = lain_meta_scratch_data();
          let vt: u64 = meta_value_type_window(base, len, blk, vi, r_t_lo, r_t_hi);
          let vth: u64 = std_types.meta_cell_get(tsc0 + 0);
          let vp: u32 = std_types.meta_cell_put(tsc0 + 2440, vth);
          vt
        };
        let t_hi: u64 = if is_colon {
          let tn2: u64 = std_parse.ast_child(blk, i + 3);
          let tn_lo: u64 = std_parse.meta_node_start(tn2);
          let tn_hi: u64 = tn_lo + std_parse.meta_node_len(tn2);
          tn_hi
        } else {
          let tsc: addr = lain_meta_scratch_data();
          let thv: u64 = std_types.meta_cell_get(tsc + 2440);
          thv
        };
        let semi_i: u64 = meta_find_semi_index(base, blk, i);
        let semi_none: bool = semi_i == 0xFFFFFFFFFFFFFFFF;
        if semi_none {
          let f0: u32 = lain_meta_fail(21);
          break pick_s(21);
        }
        let semi: u64 = std_parse.ast_child(blk, semi_i);
        let r2: u32 = meta_lower_stmt(base, len, blk, i, vi, semi, 0, n_lo, n_hi, t_lo, t_hi);
        break pick_s(r2);
      };
      let bad: bool = s != 0;
      if bad {
        break stmts(s);
      }
      // 前进到这条语句的 `;` 之后。
      let si: u64 = meta_find_semi_index(base, blk, i);
      let nx: u64 = si + 1;
      continue stmts(nx);
    } else {
      break stmts(0);
    }
  };
  return st;
}

func meta_emit_builtin_temp(base: addr, len: u64, kind: u64, width: u64, c_lo: u64, c_hi: u64, args: u64) -> u32 {
  let name: addr = base + c_lo;
  let is_load: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_load, 4);
  let is_lea: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_lea, 3);
  if is_load {
    let r1: u32 = meta_emit_load_temp(base, len, kind, width, args);
    return r1;
  }
  if is_lea {
    let r2: u32 = meta_emit_lea_temp(base, len, args);
    return r2;
  }
  let is_len: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_len, 3);
  if is_len {
    let r3: u32 = meta.meta_emit_len_temp(base, len, kind, width, args);
    return r3;
  }
  let is_ptr: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_ptr_of, 6);
  if is_ptr {
    let r4: u32 = meta_emit_ptr_of_temp(base, len, kind, width, args);
    return r4;
  }
  let is_addr: bool = std_types.meta_bytes_equal(name, std_lex.meta_kw_addr_of, 7);
  if is_addr {
    let r5: u32 = meta_emit_addr_of_temp(base, len, kind, width, args);
    return r5;
  }
  return 1;
}

func meta_lower_store(base: addr, len: u64, parent: u64, index: u64, r_t_lo: u64, r_t_hi: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let grp: u64 = std_parse.meta_cursor_next(parent, index);
  let acount: u64 = std_parse.ast_child_count(grp);
  let a1: u32 = meta.meta_emit_expr(base, len, 3, 64, 0, 0, grp, 0, 0, 0, 0, 0);
  let b1: bool = a1 != 0;
  if b1 {
    return a1;
  }
  let e1: u64 = std_types.meta_cell_get(sc + 192);
  let r1: u64 = std_types.meta_cell_get(sc + 168);
  let l1: u64 = std_types.meta_cell_get(sc + 176);
  let h1: u64 = std_types.meta_cell_get(sc + 184);
  let s1: u32 = std_types.meta_cell_put(sc + 2512, r1);
  let s2: u32 = std_types.meta_cell_put(sc + 2520, l1);
  let s3: u32 = std_types.meta_cell_put(sc + 2528, h1);
  let cc: u64 = std_parse.ast_child(grp, e1);
  let cat: u64 = std_parse.meta_node_start(cc);
  let cb: u8 = std_lex.bs_byte_at(base, cat, len);
  let cb_w: u32 = cb as u32;
  let iscomma: bool = cb_w == 44;
  if iscomma == 0 {
    return 4;
  }
  let start2: u64 = e1 + 1;
  // 宽度取自**值自己的类型**：这是 store 与 load 唯一不同的地方。
  let vt_lo: u64 = meta_value_type_window(base, len, grp, start2, r_t_lo, r_t_hi);
  let vt_hi: u64 = std_types.meta_cell_get(sc + 0);
  let tid: u64 = std_scalars.meta_type_resolve(base, len, vt_lo, vt_hi);
  let nokind: bool = tid == 0;
  if nokind {
    return 5;
  }
  let vkind: u64 = std_registry.meta_tid_repr_kind(tid);
  let vwidth: u64 = std_registry.meta_tid_repr_width(tid);
  let a2: u32 = meta.meta_emit_expr(base, len, vkind, vwidth, vt_lo, vt_hi, grp, start2, 0, 0, 0, 0);
  let b2: bool = a2 != 0;
  if b2 {
    return a2;
  }
  let e2: u64 = std_types.meta_cell_get(sc + 192);
  let done: bool = e2 >= acount;
  let tail: bool = done == 0;
  if tail {
    return 4;
  }
  let vref: u64 = std_types.meta_cell_get(sc + 168);
  let vlo: u64 = std_types.meta_cell_get(sc + 176);
  let vhi: u64 = std_types.meta_cell_get(sc + 184);
  let w1: u32 = std_lainir.lainir_indent_write();
  let w2: u32 = std_lainir.lainir_store_head_write();
  let w3: u32 = std_lainir.lainir_repr(vkind, vwidth);
  let w4: u32 = std_lainir.lainir_bracket_paren_write();
  let w5: u32 = meta.meta_emit_ref2(base, len, vref, vlo, vhi);
  let w6: u32 = std_lainir.lainir_comma_write();
  let o1: u64 = std_types.meta_cell_get(sc + 2512);
  let o1l: u64 = std_types.meta_cell_get(sc + 2520);
  let o1h: u64 = std_types.meta_cell_get(sc + 2528);
  let w7: u32 = meta.meta_emit_ref2(base, len, o1, o1l, o1h);
  let w8: u32 = std_lainir.lainir_close_paren_write();
  let w9: u32 = std_lainir.lainir_newline_write();
  return 0;
}

func meta_loop_phi_snapshot(b: addr, nparam: u64, save: addr, res: addr) -> u32 {
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      let kslot: u64 = 88 + k * 96;
      let kq: addr = b + kslot;
      let cur: u64 = std_types.meta_cell_get(kq + 32);
      let coff: u64 = k * 8;
      let w1: u32 = std_types.meta_cell_put(save + coff, cur);
      let tn: u64 = meta_next_temp();
      let w2: u32 = std_types.meta_cell_put(res + coff, tn);
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  return r;
}

func meta_loop_phi_store(b: addr, nparam: u64, res: addr) -> u32 {
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      let kslot: u64 = 88 + k * 96;
      let kq: addr = b + kslot;
      let coff: u64 = k * 8;
      let tn: u64 = std_types.meta_cell_get(res + coff);
      let w1: u32 = std_types.meta_cell_put(kq + 32, tn);
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  return r;
}

func meta_lower_loop_if(base: addr, len: u64, parent: u64, index: u64, pgrp: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let boff: u64 = std_types.meta_cell_get(sc + 2456);
  let b: addr = sc + boff;
  let nparam: u64 = std_types.meta_cell_get(b + 8);
  let akd: u64 = std_types.meta_cell_get(b + 24);
  let awd: u64 = std_types.meta_cell_get(b + 32);
  let at_lo: u64 = std_types.meta_cell_get(b + 72);
  let at_hi: u64 = std_types.meta_cell_get(b + 80);
  let ci: u64 = index + 1;
  let ces: u32 = meta.meta_emit_expr(base, len, akd, awd, at_lo, at_hi, parent, ci, 0, 0, 0, 0);
  let cbad: bool = ces != 0;
  if cbad {
    return ces;
  }
  let bi: u64 = std_types.meta_cell_get(sc + 192);
  let blk: u64 = std_parse.ast_child(parent, bi);
  let bkind: u64 = std_parse.meta_node_kind(blk);
  let isgroup: bool = bkind == 2;
  let notgroup: bool = isgroup == 0;
  if notgroup {
    // 条件后面不是块
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  // 帧：每个参数的当前值快照 + 每个参数的结果临时值编号。
  let bytes: u64 = nparam * 8;
  let mark: u64 = std_scope.meta_bump_mark();
  let saveoff: u64 = std_scope.meta_bump_alloc(bytes);
  let resoff: u64 = std_scope.meta_bump_alloc(bytes);
  let savenone: bool = saveoff == 0xFFFFFFFFFFFFFFFF;
  let resnone: bool = resoff == 0xFFFFFFFFFFFFFFFF;
  let nonone: bool = savenone or resnone;
  if nonone {
    // 分配器已经报过 17
    let rel0: u32 = std_scope.meta_bump_release(mark);
    return 17;
  }
  let save: addr = sc + saveoff;
  let res: addr = sc + resoff;
  let snap: u32 = meta_loop_phi_snapshot(b, nparam, save, res);
  let cref: u64 = std_types.meta_cell_get(sc + 168);
  let clo: u64 = std_types.meta_cell_get(sc + 176);
  let chi: u64 = std_types.meta_cell_get(sc + 184);
  let w1: u32 = std_lainir.lainir_indent4_write();
  let w2: u32 = meta_loop_phi_names(nparam, res);
  let w3: u32 = std_lainir.lainir_assign_write();
  let w4: u32 = std_lainir.lainir_if_head_write();
  let w4b: u32 = meta.meta_emit_ref2(base, len, cref, clo, chi);
  let w5a: u32 = std_lainir.lainir_arrow_lp_write();
  let w5t: u32 = meta_loop_phi_types(b, nparam);
  let w5c: u32 = std_lainir.lainir_close_paren_write();
  let w5d: u32 = std_lainir.lainir_open_body();
  // 真支：先恢复进入 if 之前的值，再走语句。
  let r1: u32 = meta_loop_phi_restore(b, nparam, save);
  let z0: u32 = std_types.meta_cell_put(sc + 2392, 0);
  let z0b: u32 = std_types.meta_cell_put(sc + 2464, 0);
  let bst: u32 = meta_lower_loop_stmts(base, len, blk, 0, 1, pgrp);
  let t1: u64 = std_types.meta_cell_get(sc + 2392);
  let z1b: u32 = std_types.meta_cell_put(sc + 2464, 0);
  let bfail: bool = bst != 0;
  if bfail {
    let rel1: u32 = std_scope.meta_bump_release(mark);
    return bst;
  }
  let t1b: bool = t1 != 0;
  let y1: u32 = if t1b {
    0
  } else {
    let wy1: u32 = meta_loop_phi_yield(base, len, b, nparam);
    0
  };
  let ei: u64 = bi + 1;
  let af: u64 = std_parse.meta_cursor_next(parent, bi);
  let is_else: bool = std_parse.meta_node_is_word(af, std_lex.meta_kw_else, 4);
  if is_else {
    let egrp: u64 = std_parse.meta_cursor_next(parent, ei);
    let ek: u64 = std_parse.meta_node_kind(egrp);
    let eisgrp: bool = ek == 2;
    let enotgrp: bool = eisgrp == 0;
    if enotgrp {
      // `else` 后面不是块
      let f2: u32 = lain_meta_fail(4);
      return 4;
    }
    let w5: u32 = std_lainir.lainir_else_write();
    let r2: u32 = meta_loop_phi_restore(b, nparam, save);
    let z2: u32 = std_types.meta_cell_put(sc + 2392, 0);
    let z2b: u32 = std_types.meta_cell_put(sc + 2464, 0);
    let bst2: u32 = meta_lower_loop_stmts(base, len, egrp, 0, 1, pgrp);
    let t2: u64 = std_types.meta_cell_get(sc + 2392);
    let z3: u32 = std_types.meta_cell_put(sc + 2464, 0);
    let tf1: u32 = std_types.meta_cell_put(sc + 2424, t2);
    let bf2: bool = bst2 != 0;
    if bf2 {
      let rel2: u32 = std_scope.meta_bump_release(mark);
      return bst2;
    }
  } else {
    // 源码里没有 else：假分支走的就是进入 if 之前那些值
    let w5b: u32 = std_lainir.lainir_else_write();
    let r3: u32 = meta_loop_phi_restore(b, nparam, save);
    let tf2: u32 = std_types.meta_cell_put(sc + 2424, 0);
  }
  let t2r: u64 = std_types.meta_cell_get(sc + 2424);
  let t2b: bool = t2r != 0;
  let y2: u32 = if t2b {
    0
  } else {
    let wy2: u32 = meta_loop_phi_yield(base, len, b, nparam);
    0
  };
  let w6: u32 = std_lainir.lainir_close4_write();
  let setr: u32 = meta_loop_phi_store(b, nparam, res);
  let rel3: u32 = std_scope.meta_bump_release(mark);
  let resume: u64 = if is_else {
    let r2b: u64 = ei + 2;
    r2b
  } else {
    let r1b: u64 = bi + 1;
    r1b
  };
  let pr: u32 = std_types.meta_cell_put(sc + 2376, resume);
  return 0;
}

func meta_loop_type_name(base: addr, nm_at: u64, nm_len: u64) -> u64 {
  let sc: addr = lain_meta_scratch_data();
  let act: u64 = std_types.meta_cell_get(sc + 2384);
  let inloop: bool = act != 0;
  if inloop == 0 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let boff: u64 = std_types.meta_cell_get(sc + 2456);
  let b: addr = sc + boff;
  let nparam: u64 = std_types.meta_cell_get(b + 8);
  let r: u64 = loop f(k: u64 = 0) {
    let km: bool = k < nparam;
    if km == 0 {
      break f(0xFFFFFFFFFFFFFFFF);
    }
    let kslot: u64 = 88 + k * 96;
    let kq: addr = b + kslot;
    let pn_lo: u64 = std_types.meta_cell_get(kq);
    let pn_hi: u64 = std_types.meta_cell_get(kq + 8);
    let plen: u64 = pn_hi - pn_lo;
    let lenok: bool = plen == nm_len;
    if lenok {
      let pa: addr = base + pn_lo;
      let na: addr = base + nm_at;
      let eqb: bool = std_types.meta_bytes_equal(pa, na, plen);
      if eqb {
        let tlo: u64 = std_types.meta_cell_get(kq + 64);
        let thi: u64 = std_types.meta_cell_get(kq + 72);
        let put: u32 = std_types.meta_cell_put(sc + 0, thi);
        break f(tlo);
      }
    }
    continue f(k + 1);
  };
  return r;
}

func meta_emit_operand(base: addr, lo: u64, hi: u64, len: u64) -> u32 {
  let out: addr = std_lainir.lainir_text_buffer;
  let n: u64 = meta_render_operand(base, lo, hi, len, out);
  let bad: bool = n == 0xFFFFFFFFFFFFFFFF;
  let st: u32 = if bad {
    4
  } else {
    let w: u32 = std_lainir.lainir_write(out, n);
    w
  };
  return st;
}

func meta_emit_op_lit(name: addr, name_len: u64, kind: u64, width: u64) -> u32 {
  let w: u32 = std_lainir.lainir_op_prefix(name, name_len, kind, width);
  return w;
}

func meta_emit_binding_call(base: addr, len: u64, kind: u64, width: u64, name_lo: u64, name_hi: u64, t_lo: u64, t_hi: u64, callee_lo: u64, callee_hi: u64, args: u64) -> u32 {
  let callee_name: addr = base + callee_lo;
  let callee_len: u64 = callee_hi - callee_lo;
  let decl: u64 = std_scope.meta_scope_require_func(callee_name, callee_len);
  if decl == 0 { return 9415; }
  let ast: u32 = meta_args_prepare(base, len, kind, width, t_lo, t_hi, args);
  let abad: bool = ast != 0;
  if abad {
    return ast;
  }
  let buf: addr = std_lainir.lainir_text_buffer;
  let alen: u64 = meta_args_render(base, len, buf);
  let nbuf: addr = buf + 128;
  let pct: u64 = std_lainir.lainir_buf_byte(nbuf, 0, 37);
  let n_at: addr = base + name_lo;
  let n_len: u64 = name_hi - name_lo;
  let nlen2: u64 = std_lainir.lainir_buf_bytes(nbuf, pct, n_at, n_len);
  let c_at: addr = base + callee_lo;
  let pbuf: addr = std_scope.meta_path_buf();
  let c_len: u64 = std_scope.meta_callee_symbol(pbuf, c_at, callee_len);
  let w: u32 = std_lainir.lainir_call_named(nbuf, nlen2, pbuf, c_len, buf, alen);
  return 0;
}

func meta_lower_for(base: addr, len: u64, parent: u64, index: u64, b_lo: u64, b_hi: u64, t_lo: u64, t_hi: u64) -> u32 {
  let tid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
  let no_type: bool = tid == 0;
  if no_type {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }
  let info: u64 = std_registry.meta_tid_repr(tid);
  let kind: u64 = info and 255;
  let width: u64 = (info >> 8) and 255;

  // for I in LO .. HI acc = INIT { 体 }：游标一格一格往前推。
  let i_node: u64 = std_parse.meta_cursor_next(parent, index);
  let in_node: u64 = std_parse.meta_cursor_next(parent, index + 1);
  let lo_node: u64 = std_parse.meta_cursor_next(parent, index + 2);
  let dots: u64 = std_parse.meta_cursor_next(parent, index + 3);
  let hi_node: u64 = std_parse.meta_cursor_next(parent, index + 4);
  let acc_node: u64 = std_parse.meta_cursor_next(parent, index + 5);
  let acc_eq: u64 = std_parse.meta_cursor_next(parent, index + 6);
  let init_node: u64 = std_parse.meta_cursor_next(parent, index + 7);
  let body: u64 = std_parse.meta_cursor_next(parent, index + 8);

  // 形状先认全了再动手发。节点访问器对 NONE 是安全的（`meta_tree_field` 挡了），
  // 所以一条写残的源码最多就是「形状不认」，不会读到暂存区外面去。
  let kw_in: addr = std_lex.meta_kw_in;
  let kw_acc: addr = std_lex.meta_kw_acc;
  let kw_eq: addr = std_lex.meta_kw_eq;
  let kw_dots: addr = std_emit.meta_sym_dotdot;
  let ok_in: bool = std_parse.meta_node_is_word(in_node, kw_in, 2);
  let ok_dots: bool = std_parse.meta_node_is_word(dots, kw_dots, 2);
  let ok_acc: bool = std_parse.meta_node_is_word(acc_node, kw_acc, 3);
  let ok_eq: bool = std_parse.meta_node_is_word(acc_eq, kw_eq, 1);
  let bk: u64 = std_parse.meta_node_kind(body);
  let is_group: bool = bk == 2;
  let q1: bool = ok_in and ok_dots;
  let q2: bool = ok_acc and ok_eq;
  let q3: bool = q1 and q2;
  let shape: bool = q3 and is_group;
  let notshape: bool = shape == 0;
  if notshape {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }

  // 循环编号：和临时值共用一个计数器（+144）。编号只进 `L<n>` 这个名字，
  // 临时值只进 `%r<n>`，前缀不同，不会撞。
  let ln: u64 = meta_next_temp();

  // `  %<结果> = #loop L<n>(`
  let p: addr = std_emit.meta_st_pct;
  let w1: u32 = std_lainir.lainir_st_pct_write();
  let b_at: addr = base + b_lo;
  let b_n: u64 = b_hi - b_lo;
  let w2: u32 = std_lainir.lainir_write(b_at, b_n);
  let w3: u32 = std_lainir.lainir_loop_head_write();
  let w4: u32 = std_lainir.lainir_emit_uint(ln);
  let w5: u32 = std_lainir.lainir_open_paren_write();

  // `%<循环变量>: <repr> = <下界>`——`meta_emit_operand` 自己发那个 `%`
  let i_lo: u64 = std_parse.meta_node_start(i_node);
  let i_hi: u64 = i_lo + std_parse.meta_node_len(i_node);
  let pct: addr = std_emit.meta_fn_pct;
  let w7: u32 = meta_emit_operand(base, i_lo, i_hi, len);
  let w8: u32 = std_lainir.lainir_colon_write();
  let w9: u32 = std_lainir.lainir_repr(kind, width);
  let w10: u32 = std_lainir.lainir_assign_write();
  let lo_lo: u64 = std_parse.meta_node_start(lo_node);
  let lo_hi: u64 = lo_lo + std_parse.meta_node_len(lo_node);
  let w11: u32 = meta_emit_operand(base, lo_lo, lo_hi, len);

  // `, %acc: <repr> = <初值>`
  let w12: u32 = std_lainir.lainir_comma_write();
  let w13: u32 = std_lainir.lainir_pct_write();
  let w14: u32 = std_lainir.lainir_write(kw_acc, 3);
  let w15: u32 = std_lainir.lainir_colon_write();
  let w16: u32 = std_lainir.lainir_repr(kind, width);
  let w17: u32 = std_lainir.lainir_assign_write();
  let in_lo: u64 = std_parse.meta_node_start(init_node);
  let in_hi: u64 = in_lo + std_parse.meta_node_len(init_node);
  let w18: u32 = meta_emit_operand(base, in_lo, in_hi, len);

  // `) -> (<repr>) {\n`
  let w19: u32 = std_lainir.lainir_result_head_write();
  let w20: u32 = std_lainir.lainir_repr(kind, width);
  let w21: u32 = std_lainir.lainir_loop_body_open_write();

  // 循环条件：`<` 是这个类型自己的算子，不是编译器里写死的
  let lt: addr = std_emit.meta_sym_lt;
  let ltid: u64 = std_scalars.meta_op_resolve(base, len, t_lo, t_hi, lt, 1);
  let ltmiss: bool = ltid == 0xFFFFFFFFFFFFFFFF;
  if ltmiss {
    let f2: u32 = lain_meta_fail(6);
    return 6;
  }
  let hi_lo: u64 = std_parse.meta_node_start(hi_node);
  let hi_hi: u64 = hi_lo + std_parse.meta_node_len(hi_node);
  let tw: u32 = meta_emit_loop_test(base, len, kind, width, i_lo, i_hi, hi_lo, hi_hi);

  // 循环体只认一条 `acc = A OP B;`。这里换成**循环体组上的游标**：`%body` 是父组，
  // 每一个后继都是「父组 + 下标 + n」。
  // lain0 把「调用嵌在另一个调用的实参里」降级成不带结果的 `#call`（验证器 2020），
  // 所以内层 `ast_child` 要先提成一条 let。
  let body_first: u64 = std_parse.ast_child(body, 0);
  let ok_accb: bool = std_parse.meta_node_is_word(body_first, kw_acc, 3);
  let eq2: u64 = std_parse.ast_child(body, 1);
  let ok_eqb: bool = std_parse.meta_node_is_word(eq2, kw_eq, 1);
  let bshape: bool = ok_accb and ok_eqb;
  let badbody: bool = bshape == 0;
  if badbody {
    let f3: u32 = lain_meta_fail(4);
    return 4;
  }
  let a_node: u64 = std_parse.ast_child(body, 2);
  let op_node: u64 = std_parse.ast_child(body, 3);
  let b_node: u64 = std_parse.ast_child(body, 4);
  let semi: u64 = std_parse.ast_child(body, 5);
  let kw_semi: addr = std_lex.meta_kw_semi;
  let ok_semi: bool = std_parse.meta_node_is_word(semi, kw_semi, 1);
  let nosemi: bool = ok_semi == 0;
  if nosemi {
    let f4: u32 = lain_meta_fail(21);
    return 21;
  }

  // 循环体那个算子：从类型自己的 op 表里查（和顶层 `let` 同一个来源）
  let op_lo: u64 = std_parse.meta_node_start(op_node);
  let sym: addr = base + op_lo;
  let opid: u64 = std_scalars.meta_op_resolve(base, len, t_lo, t_hi, sym, 1);
  let opmiss: bool = opid == 0xFFFFFFFFFFFFFFFF;
  if opmiss {
    let f5: u32 = lain_meta_fail(6);
    return 6;
  }
  let x_lo: u64 = std_parse.meta_node_start(a_node);
  let x_hi: u64 = x_lo + std_parse.meta_node_len(a_node);
  let y_lo: u64 = std_parse.meta_node_start(b_node);
  let y_hi: u64 = y_lo + std_parse.meta_node_len(b_node);
  let rv: u64 = meta_emit_loop_temp(base, len, kind, width, x_lo, x_hi, y_lo, y_hi);

  // 步进
  let plus: addr = std_emit.meta_sym_plus;
  let pid: u64 = std_scalars.meta_op_resolve(base, len, t_lo, t_hi, plus, 1);
  let pmiss: bool = pid == 0xFFFFFFFFFFFFFFFF;
  if pmiss {
    let f6: u32 = lain_meta_fail(6);
    return 6;
  }
  let rs: u64 = meta_emit_loop_step(base, len, kind, width, i_lo, i_hi);

  // `    #continue L<n>(%r<步进>, %r<结果>)\n`
  let w22: u32 = std_lainir.lainir_continue_head_write();
  let w23: u32 = std_lainir.lainir_emit_uint(ln);
  let w24: u32 = std_lainir.lainir_open_paren_write();
  let w25: u32 = meta_emit_temp_name(rs);
  let w26: u32 = std_lainir.lainir_comma_write();
  let w27: u32 = meta_emit_temp_name(rv);
  let w28: u32 = std_lainir.lainir_rparen_nl_write();

  // `    }\n`
  let w29: u32 = std_lainir.lainir_close4_write();

  // `    #break L<n>(%acc)\n`
  let w30: u32 = std_lainir.lainir_break_head_write();
  let w31: u32 = std_lainir.lainir_emit_uint(ln);
  let w32: u32 = std_lainir.lainir_open_paren_write();
  let w33: u32 = std_lainir.lainir_pct_write();
  let w34: u32 = std_lainir.lainir_write(kw_acc, 3);
  let w35: u32 = std_lainir.lainir_rparen_nl_write();

  // `  }\n`
  let w36: u32 = std_lainir.lainir_close_line_write();
  return 0;
}

func meta_lower_branch_value(base: addr, len: u64, blk: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64) -> u32 {
  let count: u64 = std_parse.ast_child_count(blk);
  // 最后一个 `;` 的位置；没有就是「整块是值表达式」。
  let ls: u64 = loop find(i: u64 = 0, seen: u64 = 0xFFFFFFFFFFFFFFFF) {
    let more: bool = i < count;
    if more {
      let c: u64 = std_parse.ast_child(blk, i);
      let c_at: u64 = std_parse.meta_node_start(c);
      let b: u8 = std_lex.bs_byte_at(base, c_at, len);
      let b_w: u32 = b as u32;
      let is_semi: bool = b_w == 59;
      let i2: u64 = i + 1;
      if is_semi {
        continue find(i2, i);
      }
      continue find(i2, seen);
    } else {
      break find(seen);
    }
  };
  let no_semi: bool = ls == 0xFFFFFFFFFFFFFFFF;
  let start: u64 = if no_semi {
    0
  } else {
    let s1: u64 = ls + 1;
    s1
  };
  let st: u32 = if no_semi {
    0
  } else {
    let p: u32 = meta_lower_branch_prefix(base, len, blk, ls, t_lo, t_hi);
    p
  };
  let bad: bool = st != 0;
  if bad {
    return st;
  }
  let e: u32 = meta.meta_emit_expr(base, len, kind, width, t_lo, t_hi, blk, start, 0, 0, 0, 0);
  return e;
}

func meta_lower_loop_jump(base: addr, len: u64, parent: u64, index: u64, now: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let boff: u64 = std_types.meta_cell_get(sc + 2456);
  let noloop: bool = boff == 0;
  if noloop {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  let b: addr = sc + boff;
  // `break` 还是 `continue`
  let kw: u64 = std_parse.ast_child(parent, index);
  let isbrk: bool = std_parse.meta_node_is_word(kw, std_lex.meta_kw_break, 5);
  let iscont: bool = std_parse.meta_node_is_word(kw, std_lex.meta_kw_continue, 8);
  let known: bool = isbrk or iscont;
  let unknown: bool = known == 0;
  if unknown {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  // 标签必须与当前循环同名：嵌套循环里用它指认跳哪一层
  let la: u64 = std_parse.ast_child(parent, index + 1);
  let lk: u64 = std_parse.meta_node_kind(la);
  let lab_n: u64 = std_parse.meta_node_len(la);
  let llo: u64 = std_types.meta_cell_get(b + 56);
  let lhi: u64 = std_types.meta_cell_get(b + 64);
  let llen: u64 = lhi - llo;
  let l_ok: bool = lk == 1;
  let l_same: bool = lab_n == llen;
  let l0: bool = l_ok and l_same;
  if l0 {
    let lst: u64 = std_parse.meta_node_start(la);
    let eqb: bool = std_types.meta_bytes_equal(base + lst, base + llo, llen);
    let lbad: bool = eqb == 0;
    if lbad {
      let f2: u32 = lain_meta_fail(4);
      return 4;
    }
  } else {
    let f2b: u32 = lain_meta_fail(4);
    return 4;
  }
  // `(实参…)`：`break` 只带循环的值，`continue` 要给每个参数一个值
  let ag: u64 = std_parse.ast_child(parent, index + 2);
  let agk: u64 = std_parse.meta_node_kind(ag);
  let nparam: u64 = std_types.meta_cell_get(b + 8);
  let wanted: u64 = if isbrk {
    1
  } else {
    nparam
  };
  // 实参个数不靠孩子数猜：一个实参可以是多 token 的表达式，个数由 `#continue` 的参数
  // 个数（或 `#break` 的 1）定，每个实参在逗号处收尾。
  let ag_ok: bool = agk == 2;
  let head_bad: bool = ag_ok == 0;
  if head_bad {
    let f3: u32 = lain_meta_fail(4);
    return 4;
  }
  let lp_n: u64 = std_types.meta_cell_get(b + 16);
  // `break` 直接发终止指令，循环体随后的收尾不再发；`continue` 只把实参记成
  // 「下一轮的值」，由循环体收尾那条 `#continue` 发出去 —— 区域里终止指令必须是
  // 最后一条，而值型循环又必须有一个 `#break`（验证器 2006）。终止标志写在
  // 暂存区 2464：1 表示区域已经被 `break` 终结。
  let tflag: u64 = if isbrk {
    1
  } else {
    0
  };
  let tset: u32 = std_types.meta_cell_put(sc + 2464, tflag);
  // 实参类型：`break` 就是循环的值（块头 +24/+32 与 +72/+80），
  // `continue` 按参数顺序取该参数的声明类型（参数项 +16/+24 与 +64/+72）。
  let akd: u64 = std_types.meta_cell_get(b + 24);
  let awd: u64 = std_types.meta_cell_get(b + 32);
  let at_lo: u64 = std_types.meta_cell_get(b + 72);
  let at_hi: u64 = std_types.meta_cell_get(b + 80);
  // 逐个实参检查：第 0 个从 AG 的头部开始，其余从上一项终点之后一格开始，先验逗号。
  let gas: u32 = loop g(k: u64 = 0, pe: u64 = 0) {
    let more: bool = k < wanted;
    if more {
      let is0: bool = k == 0;
      // 实参之间是逗号：下一个实参从上一个的终点之后一格开始
      let cpos: u64 = if is0 {
        0
      } else {
        pe + 1
      };
      if is0 == 0 {
        let cm: u64 = std_parse.ast_child(ag, pe);
        let cm_at: u64 = std_parse.meta_node_start(cm);
        let cm_b: u8 = std_lex.bs_byte_at(base, cm_at, len);
        let cm_w: u32 = cm_b as u32;
        let cm_is: bool = cm_w == 44;
        if cm_is == 0 {
          let f4: u32 = lain_meta_fail(4);
          break g(f4);
        }
      }
      let kslot: u64 = 88 + k * 96;
      let kq: addr = b + kslot;
      let ekd: u64 = std_types.meta_cell_get(kq + 16);
      let ewd: u64 = std_types.meta_cell_get(kq + 24);
      let et_lo: u64 = std_types.meta_cell_get(kq + 64);
      let et_hi: u64 = std_types.meta_cell_get(kq + 72);
      let use_kd: u64 = if isbrk {
        akd
      } else {
        ekd
      };
      let use_wd: u64 = if isbrk {
        awd
      } else {
        ewd
      };
      let use_lo: u64 = if isbrk {
        at_lo
      } else {
        et_lo
      };
      let use_hi: u64 = if isbrk {
        at_hi
      } else {
        et_hi
      };
      let est: u32 = meta.meta_emit_expr(base, len, use_kd, use_wd, use_lo, use_hi, ag, cpos, 0, 0, 0, 0);
      let ebad: bool = est != 0;
      if ebad {
        break g(est);
      }
      let aref: u64 = std_types.meta_cell_get(sc + 168);
      let alo: u64 = std_types.meta_cell_get(sc + 176);
      let ahi: u64 = std_types.meta_cell_get(sc + 184);
      let aend: u64 = std_types.meta_cell_get(sc + 192);
      let send: u32 = std_types.meta_cell_put(sc + 2504, aend);
      // break 只有一个实参，先存起来，等所有实参都降级完再发指令 ——
      // 实参里的临时指令必须发在 `#break` 之前。
      let out: u32 = if isbrk {
        let q1: u32 = std_types.meta_cell_put(sc + 2480, aref);
        let q2: u32 = std_types.meta_cell_put(sc + 2488, alo);
        let q3: u32 = std_types.meta_cell_put(sc + 2496, ahi);
        0
      } else {
        let st1: u32 = std_types.meta_cell_put(kq + 32, aref);
        let st2: u32 = std_types.meta_cell_put(kq + 80, alo);
        let st3: u32 = std_types.meta_cell_put(kq + 88, ahi);
        0
      };
      continue g(k + 1, aend);
    } else {
      break g(0);
    }
  };
  let gbad: bool = gas != 0;
  if gbad {
    return gas;
  }
  // 多写的实参：最后一个实参的终点应该正好是实参组的尽头。
  let acount: u64 = std_parse.ast_child_count(ag);
  let lastend: u64 = std_types.meta_cell_get(sc + 2504);
  let tail_ok: bool = lastend == acount;
  let tail_bad: bool = tail_ok == 0;
  if tail_bad {
    let f5: u32 = lain_meta_fail(4);
    return 4;
  }
  // 嵌套在 `if` 分支里的 `continue` 必须就地发：循环体收尾那条 `#continue` 只在
  // 顶层的语句序列里代表它，否则条件为假的那一轮也会把分支里算出来的实参传下去。
  if isbrk == 0 {
    let nowtop: bool = now == 0;
    if nowtop == 0 {
      let wn: u32 = meta_emit_continue_now(base, len, b, nparam, lp_n);
      if wn != 0 {
        return wn;
      }
    }
  }
  // `break`：实参已经算好，现在才发终止指令（临时指令都在它之前）。
  if isbrk {
    let w1: u32 = std_lainir.lainir_break_head_write();
    let w1a: u32 = std_lainir.lainir_emit_uint(lp_n);
    let w1b: u32 = std_lainir.lainir_open_paren_write();
    let bkr: u64 = std_types.meta_cell_get(sc + 2480);
    let bkl: u64 = std_types.meta_cell_get(sc + 2488);
    let bkh: u64 = std_types.meta_cell_get(sc + 2496);
    let w1c: u32 = meta.meta_emit_ref2(base, len, bkr, bkl, bkh);
    let w1d: u32 = std_lainir.lainir_rparen_nl_write();
  }
  return 0;
}

func meta_emit_lea_temp(base: addr, len: u64, args: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let acount: u64 = std_parse.ast_child_count(args);
  let a1: u32 = meta.meta_emit_expr(base, len, 3, 64, 0, 0, args, 0, 0, 0, 0, 0);
  let b1: bool = a1 != 0;
  if b1 {
    return a1;
  }
  let e1: u64 = std_types.meta_cell_get(sc + 192);
  let r1: u64 = std_types.meta_cell_get(sc + 168);
  let l1: u64 = std_types.meta_cell_get(sc + 176);
  let h1: u64 = std_types.meta_cell_get(sc + 184);
  // 第一个操作数先存起来：降级第二个实参时 +168/+176/+184 会被覆盖
  let s1: u32 = std_types.meta_cell_put(sc + 2512, r1);
  let s2: u32 = std_types.meta_cell_put(sc + 2520, l1);
  let s3: u32 = std_types.meta_cell_put(sc + 2528, h1);
  let cc: u64 = std_parse.ast_child(args, e1);
  let cat: u64 = std_parse.meta_node_start(cc);
  let cb: u8 = std_lex.bs_byte_at(base, cat, len);
  let cb_w: u32 = cb as u32;
  let iscomma: bool = cb_w == 44;
  if iscomma == 0 {
    return 4;
  }
  let start2: u64 = e1 + 1;
  let a2: u32 = meta.meta_emit_expr(base, len, 0, 64, 0, 0, args, start2, 0, 0, 0, 0);
  let b2: bool = a2 != 0;
  if b2 {
    return a2;
  }
  let e2: u64 = std_types.meta_cell_get(sc + 192);
  let done: bool = e2 >= acount;
  let tail: bool = done == 0;
  if tail {
    return 4;
  }
  let r2: u64 = std_types.meta_cell_get(sc + 168);
  let l2: u64 = std_types.meta_cell_get(sc + 176);
  let h2: u64 = std_types.meta_cell_get(sc + 184);
  let o1: u64 = std_types.meta_cell_get(sc + 2512);
  let o1l: u64 = std_types.meta_cell_get(sc + 2520);
  let o1h: u64 = std_types.meta_cell_get(sc + 2528);
  let buf: addr = std_lainir.lainir_text_buffer;
  let i1: addr = buf + 96;
  let alen: u64 = meta.meta_render_ref2(base, len, o1, o1l, o1h, buf);
  let ilen: u64 = meta.meta_render_ref2(base, len, r2, l2, h2, i1);
  let tn: u64 = meta_next_temp();
  let w: u32 = std_lainir.lainir_lea_at(tn, buf, alen, i1, ilen, 1, 0);
  let s4: u32 = std_types.meta_cell_put(sc + 168, tn);
  return 0;
}

func meta_loop_param_index(base: addr, nm_at: u64, nm_len: u64) -> u64 {
  let sc: addr = lain_meta_scratch_data();
  let act: u64 = std_types.meta_cell_get(sc + 2384);
  let inloop: bool = act != 0;
  let idx: u64 = if inloop {
    let boff: u64 = std_types.meta_cell_get(sc + 2456);
    let b: addr = sc + boff;
    let nparam: u64 = std_types.meta_cell_get(b + 8);
    let r: u64 = loop f(k: u64 = 0) {
      let km: bool = k < nparam;
      if km {
        let kslot: u64 = 88 + k * 96;
        let kq: addr = b + kslot;
        let pn_lo: u64 = std_types.meta_cell_get(kq);
        let pn_hi: u64 = std_types.meta_cell_get(kq + 8);
        let plen: u64 = pn_hi - pn_lo;
        let lenok: bool = plen == nm_len;
        if lenok {
          let eqb: bool = std_types.meta_bytes_equal(base + pn_lo, base + nm_at, plen);
          if eqb {
            break f(k);
          }
        }
        continue f(k + 1);
      } else {
        break f(0xFFFFFFFFFFFFFFFF);
      }
    };
    r
  } else {
    0xFFFFFFFFFFFFFFFF
  };
  return idx;
}

func meta_loop_phi_types(b: addr, nparam: u64) -> u32 {
  let r: u32 = loop s(k: u64 = 0) {
    let more: bool = k < nparam;
    if more {
      if k != 0 {
        let wc: u32 = std_lainir.lainir_comma_write();
      }
      let kslot: u64 = 88 + k * 96;
      let kq: addr = b + kslot;
      let kind: u64 = std_types.meta_cell_get(kq + 16);
      let width: u64 = std_types.meta_cell_get(kq + 24);
      let wt: u32 = std_lainir.lainir_repr(kind, width);
      continue s(k + 1);
    } else {
      break s(0);
    }
  };
  return r;
}

func meta_local_type_put(n_lo: u64, n_hi: u64, t_lo: u64, t_hi: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let raw: u64 = std_types.meta_cell_get(sc + 2136);
  let rb0: addr = std_regions.meta_region_scratch_base();
  let base: addr = rb0 + raw;
  // 表还没建（顶层值 / extern 头这类不在函数体里的位置）就别写：`int2ptr(0)` 是空
  // 地址，往它里面写会被判 1005（加载/存储故障），不会表现成「记不进去」。
  let no_tbl: bool = raw == 0;
  if no_tbl { return 0; }
  let count: u64 = std_types.meta_cell_get(sc + 2128);
  let off: u64 = count * 32;
  let e: addr = base + off;
  let s0: u32 = std_types.meta_cell_put(e, n_lo);
  let s1: u32 = std_types.meta_cell_put(e + 8, n_hi);
  let s2: u32 = std_types.meta_cell_put(e + 16, t_lo);
  let s3: u32 = std_types.meta_cell_put(e + 24, t_hi);
  let next: u64 = count + 1;
  let s4: u32 = std_types.meta_cell_put(sc + 2128, next);
  return 0;
}

func meta_emit_proc_header(base: addr, len: u64, name_node: u64, params: u64, ret_node: u64, prefixed: bool) -> u32 {
  let r_lo: u64 = std_parse.meta_node_start(ret_node);
  // 限定名（M.Point）跨多个 token，节点只覆盖第一段，所以按字节扫到名字末尾
  let r_hi: u64 = std_lex.bs_skip_qualified(base, r_lo, len);
  let tid: u64 = std_scalars.meta_type_resolve(base, len, r_lo, r_hi);
  let no_type: bool = tid == 0;
  if no_type {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }
  let info: u64 = std_registry.meta_tid_repr(tid);
  let kind: u64 = info and 255;
  let width: u64 = (info >> 8) and 255;

  // 参数表渲染进缓冲区；循环带回「1 + 长度」，0 表示参数类型解析失败
  let buf: addr = std_lainir.lainir_text_buffer;
  let colon: addr = std_lex.meta_kw_colon;
  let colon2: addr = std_lainir.lainir_colon_text;
  let comma: addr = std_lainir.lainir_comma;
  let pcount: u64 = std_parse.ast_child_count(params);
  let pst: u64 = loop ps(pi2: u64 = 0, lead: bool = 0, pat: u64 = 0) {
    let more: bool = pi2 < pcount;
    if more {
      let c: u64 = std_parse.ast_child(params, pi2);
      let cni: u64 = pi2 + 1;
      let nx: u64 = std_parse.meta_cursor_next(params, pi2);
      let is_colon: bool = std_parse.meta_node_is_word(nx, colon, 1);
      let both: bool = is_colon and lead;
      let pat2: u64 = if both {
        let wc: u64 = std_lainir.lainir_buf_bytes(buf, pat, comma, 2);
        wc
      } else {
        pat
      };
      if is_colon == 0 {
        continue ps(cni, 1, pat2);
      }
      let wp: u64 = std_lainir.lainir_buf_byte(buf, pat2, 37);
      let a_lo: u64 = std_parse.meta_node_start(c);
      let a_n: u64 = std_parse.meta_node_len(c);
      let a_at: addr = base + a_lo;
      let wa: u64 = std_lainir.lainir_buf_bytes(buf, wp, a_at, a_n);
      let wk: u64 = std_lainir.lainir_buf_bytes(buf, wa, colon2, 2);
      let tn: u64 = std_parse.meta_cursor_next(params, cni);
      let t_lo: u64 = std_parse.meta_node_start(tn);
      // 同上：限定名按字节扫
      let t_hi: u64 = std_lex.bs_skip_qualified(base, t_lo, len);
      let ptid: u64 = std_scalars.meta_type_resolve(base, len, t_lo, t_hi);
      let pbad: bool = ptid == 0;
      if pbad {
        let f1: u32 = lain_meta_fail(5);
        break ps(0);
      }
      let pinfo: u64 = std_registry.meta_tid_repr(ptid);
      let pk: u64 = pinfo and 255;
      let pw: u64 = (pinfo >> 8) and 255;
      let wr: u64 = std_lainir.lainir_buf_repr(buf, wk, pk, pw);
      continue ps(cni, 1, wr);
    } else {
      let done: u64 = 1 + pat;
      break ps(done);
    }
  };
  let pfail: bool = pst == 0;
  if pfail {
    return 5;
  }
  let plen: u64 = pst - 1;
  let n_lo: u64 = std_parse.meta_node_start(name_node);
  let n_n: u64 = std_parse.meta_node_len(name_node);
  let n_at: addr = base + n_lo;
  // 顶层 func 发 `<模块键>__<名字>`（prefixed = 1）；宿主 extern 保持平坦名
  // （prefixed = 0 —— 它们按 `= link_name` 找，与模块键无关）。
  let w5: u32 = loop pick_name(t: u32 = 0) {
    if prefixed {
      let pbuf: addr = std_scope.meta_path_buf();
      let sym: u64 = std_scope.meta_unit_symbol(pbuf, n_at, n_n);
      let w: u32 = std_lainir.lainir_proc_head_full(pbuf, sym, buf, plen, kind, width);
      break pick_name(w);
    }
    let w2: u32 = std_lainir.lainir_proc_head_full(n_at, n_n, buf, plen, kind, width);
    break pick_name(w2);
  };
  return 0;
}
