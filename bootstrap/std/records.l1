// 初代标准库 v0 —— 积类型：构造与字段访问。
//
// 降级 `p.a` 的时候，发 `#load[#bits<32>]` 要**编译期就知道**偏移和宽度。
// 字段偏移是 struct 声明时算出来的，但目前只有那几个 offset/size **过程**
// ——过程是运行时才叫得动的，编译期用不上。
//
// 所以这里要在编译期把布局再算一遍：从这个类型的正文起点开始，累加偏移直到
// 命中字段名。**正文起点来自符号表**（`meta_scope_body`：条目里记的就是那条
// 声明的节点），所以不用回源码里找声明。
//
// 以前这里是「按需回源码里再走一遍那条 struct 声明」，每个字段一次 O(n) 扫描；
// 那句注释当时写着「真正的做法是一张编译期符号表，那是下一步」——现在它在
// `std/scope.l1` 里了。
//
// 打包：`偏移` 在低 40 位、`kind` 在 40..43、`width` 在 44..51、命中在最高位。
// 走到 `}` 时返回的是**总大小**（最高位 0）——同一个走法服务两种问题。

// `meta_find_keyword`（从某个位置起逐字节找关键字）**已经删了**：按名字找声明
// 现在走语法树（`meta_find_decl`）。它和 `bs_next_form` 是同一类东西——「搜」，
// 而不是「认」。

// 一条声明自己的正文从哪开始：`struct X { ... }` 里 `{` 后面一个字符。
// **O(1)**：名字节点 → 花括号组 → 起点。不搜。
//
// 作用域表里存的是**声明节点**（`meta_scope_payload`），不是出现位置，所以这里用
// 「位置 -> 同一个父组里的下一项」把后继两步取出来：声明词的位置由 `meta_node_start`
// 给出，名字与花括号组分别是它的下一个、再下一个孩子。全程不碰「节点自带的后继」。
#proc meta_decl_body(%base: #addr, %node: #bits<64>) -> #bits<64> {
  %node_at = #call meta_node_start(%node)
  %name_node = #call meta_next_at(%base, %node_at)
  %name_at = #call meta_node_start(%name_node)
  %grp = #call meta_next_at(%base, %name_at)
  %gone = #eq[#bits<64>](%grp, 0)
  %r = #if %gone -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %kind = #call meta_node_kind(%grp)
    %is_group = #eq[#bits<64>](%kind, 2)
    %v = #if %is_group -> (#bits<64>) {
      %st = #call meta_node_start(%grp)
      %one = #add[#bits<64>](%st, 1)
      #yield %one
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %v
  }
  #return %r
}

// 按名字从**作用域表**里取出「这个类型的正文从哪开始」。找不到返回 NOT_FOUND。
//
// 这是符号表真正省下来的那件事：以前每访问一次字段就回源码里把声明搜一遍
// （`meta_find_rec_body`），现在条目里存的就是声明节点，读一下就有。
// expect 是期望的种类：4 = 积类型，5 = 和类型。
#proc meta_scope_body(%base: #addr, %name_lo: #bits<64>,
                       %name_hi: #bits<64>, %expect: #bits<64>) -> #bits<64> {
  %name = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %i = #call meta_scope_find(%name, %name_len)
  %miss = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %r = #if %miss -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %kind = #call meta_scope_kind(%i)
    %ok = #eq[#bits<64>](%kind, %expect)
    %v = #if %ok -> (#bits<64>) {
      %node = #call meta_scope_decl_node(%i)
      %body = #if #ne[#bits<64>](%node, 0) -> (#bits<64>) {
        #yield #call meta_decl_body(%base, %node)
      } else { #yield 0xFFFFFFFFFFFFFFFF }
      #yield %body
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %v
  }
  #return %r
}


// 走字段列表累加偏移。
//   命中 f_lo/f_hi  → 返回 packed（最高位 1）
//   走到 `}`        → 返回按最大对齐取整后的总大小（最高位 0）
// f_lo == f_hi 表示「不匹配任何字段」，那就只算大小。
#proc meta_layout_align_up_checked(%value: #bits<64>, %align: #bits<64>,
                                    %src: #addr, %position: #bits<64>) -> #bits<64> {
  %zero = #eq[#bits<64>](%align, 0)
  #if %zero {
    %bad = #call lain_meta_fail(5)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %padding = #sub[#bits<64>](%align, 1)
  %limit = #sub[#bits<64>](0xFFFFFFFFFFFFFFFF, %padding)
  %overflow = #ugt[#bits<64>](%value, %limit)
  #if %overflow { #return 0xFFFFFFFFFFFFFFFF }
  %aligned = #call meta_eval_align_up(%value, %align, %src, %position)
  #return %aligned
}

#proc meta_layout_field_align_up_checked(%value: #bits<64>,
                                          %align: #bits<64>) -> #bits<64> {
  %zero = #eq[#bits<64>](%align, 0)
  #if %zero {
    %bad = #call lain_meta_fail(5)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %padding = #sub[#bits<64>](%align, 1)
  %limit = #sub[#bits<64>](0xFFFFFFFFFFFFFFFF, %padding)
  %overflow = #ugt[#bits<64>](%value, %limit)
  #if %overflow { #return 0xFFFFFFFFFFFFFFFF }
  %aligned = #call bs_align_up(%value, %align)
  #return %aligned
}

// 受检查的偏移累加；调用方在收到 sentinel 后设置具体语义拒码。
#proc meta_layout_add_checked(%left: #bits<64>, %right: #bits<64>) -> #bits<64> {
  %room = #sub[#bits<64>](0xFFFFFFFFFFFFFFFF, %left)
  %overflow = #ugt[#bits<64>](%right, %room)
  %result = #if %overflow -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    #yield #add[#bits<64>](%left, %right)
  }
  #return %result
}

#proc meta_walk_fields(%src: #addr, %len: #bits<64>,
                       %at: #bits<64>,
                       %f_lo: #bits<64>, %f_hi: #bits<64>,
                       %off0: #bits<64>, %al0: #bits<64>) -> #bits<64> {
  %r = #loop fields(%at: #bits<64> = %at, %off: #bits<64> = %off0,
                    %al: #bits<64> = %al0) -> (#bits<64>) {
    %here = #call bs_skip_space(%src, %at, %len)
    %byte = #call bs_byte_at(%src, %here, %len)
    %is_close = #eq[#bits<8>](%byte, 125)
    #if %is_close {
      %rounded = #call meta_layout_align_up_checked(%off, %al, %src, %here)
      %round_failed = #eq[#bits<64>](%rounded, 0xFFFFFFFFFFFFFFFF)
      #if %round_failed {
        %scratch = #call lain_meta_scratch_data()
        %recursive = #call meta_cell_get(#lea(%scratch, 464, 1, 0))
        #if #eq[#bits<64>](%recursive, 0) {
          %fail = #call lain_meta_fail(5)
        }
        #break fields(0xFFFFFFFFFFFFFFFF)
      }
      #break fields(%rounded)
    }
    %name_hi = #call bs_skip_ident(%src, %here, %len)
    %colon = #call bs_skip_space(%src, %name_hi, %len)
    %one = #add[#bits<64>](%colon, 1)
    %t_lo = #call bs_skip_space(%src, %one, %len)
    %t_hi = #call bs_skip_qualified(%src, %t_lo, %len)
    // 字段类型可能是 `i8`，也可能是 `T.i8`——解析统一走 root 环境/命名空间
    %tid = #call meta_type_resolve(%src, %len, %t_lo, %t_hi)
    // 解析不出来是**错**，不是「大小为 0」。走法只能回一个打包值，带不了
    // 状态，所以报给宿主状态通道（驱动必须看它），返回 0 让上面也走不通。
    %bad_type = #eq[#bits<64>](%tid, 0)
    #if %bad_type {
      %scratch = #call lain_meta_scratch_data()
      %recursive = #call meta_cell_get(#lea(%scratch, 464, 1, 0))
      #if #eq[#bits<64>](%recursive, 0) {
        %f = #call lain_meta_fail(5)
      }
      #break fields(0xFFFFFFFFFFFFFFFF)
    }
    %tinfo = #call meta_tid_repr(%tid)
    %kind = #and[#bits<64>](%tinfo, 255)
    %width = #and[#bits<64>](#lshr[#bits<64>](%tinfo, 8), 255)
    %fsize = #call meta_tid_size(%tid)
    %falign = #call meta_tid_align(%tid)
    %aligned = #call meta_layout_field_align_up_checked(%off, %falign)
    #if #eq[#bits<64>](%aligned, 0xFFFFFFFFFFFFFFFF) {
      %scratch = #call lain_meta_scratch_data()
      %recursive = #call meta_cell_get(#lea(%scratch, 464, 1, 0))
      #if #eq[#bits<64>](%recursive, 0) {
        %fail = #call lain_meta_fail(5)
      }
      #break fields(0xFFFFFFFFFFFFFFFF)
    }
    %want = #sub[#bits<64>](%f_hi, %f_lo)
    %have = #sub[#bits<64>](%name_hi, %here)
    %len_ok = #eq[#bits<64>](%want, %have)
    %same = #if %len_ok -> (#bits<1>) {
      %a = #lea(%src, %here, 1, 0)
      %b = #lea(%src, %f_lo, 1, 0)
      %eq = #call meta_bytes_equal(%a, %b, %want)
      #yield %eq
    } else {
      #yield 0
    }
    #if %same {
      %k = #shl[#bits<64>](%kind, 40)
      %w = #shl[#bits<64>](%width, 44)
      %pk1 = #or[#bits<64>](%aligned, %k)
      %pk2 = #or[#bits<64>](%pk1, %w)
      %set = #or[#bits<64>](%pk2, 0x8000000000000000)
      #break fields(%set)
    }
    %next_off = #call meta_layout_add_checked(%aligned, %fsize)
    #if #eq[#bits<64>](%next_off, 0xFFFFFFFFFFFFFFFF) {
      %fail = #call lain_meta_fail(5)
      #break fields(0xFFFFFFFFFFFFFFFF)
    }
    %bigger = #ugt[#bits<64>](%falign, %al)
    %new_al = #if %bigger -> (#bits<64>) {
      #yield %falign
    } else {
      #yield %al
    }
    #continue fields(%t_hi, %next_off, %new_al)
  }
  #return %r
}

// 某个字段的 (偏移, kind, width)。`body` 是那个 type 的正文起点（由
// `meta_scope_body` 从符号表里取，不用搜）。找不到返回 0。
#proc meta_layout_field(%src: #addr, %len: #bits<64>,
                        %body: #bits<64>, %f_lo: #bits<64>,
                        %f_hi: #bits<64>) -> #bits<64> {
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  %r = #if %missing -> (#bits<64>) {
    #yield 0
  } else {
    %info = #call meta_walk_fields(%src, %len, %body, %f_lo, %f_hi, 0, 1)
    #yield %info
  }
  #return %r
}

// 某个字段**声明的类型名**窗口：起点是那个类型名，终点写进暂存区 `+0`（与
// `meta_word_type_name` 同一个约定），找不到回「无」。
//
// `meta_layout_field` 只回打包好的 (偏移, kind, width)，够发射「按偏移取字段」用；
// 值名不带标注的绑定（`let v = p.x;`）要的是**类型名** —— 类型名才能交给
// `meta_type_resolve` 走一遍完整解析（`T.i8` 这种限定名也认）。
#proc meta_field_type_window(%src: #addr, %len: #bits<64>,
                             %body: #bits<64>, %f_lo: #bits<64>,
                             %f_hi: #bits<64>) -> #bits<64> {
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  %r = #if %missing -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %found = #loop fields(%at: #bits<64> = %body) -> (#bits<64>) {
      %here = #call bs_skip_space(%src, %at, %len)
      %byte = #call bs_byte_at(%src, %here, %len)
      #if #eq[#bits<8>](%byte, 125) { #break fields(0xFFFFFFFFFFFFFFFF) }
      %name_hi = #call bs_skip_ident(%src, %here, %len)
      %colon = #call bs_skip_space(%src, %name_hi, %len)
      %t_lo = #call bs_skip_space(%src, #add[#bits<64>](%colon, 1), %len)
      %t_hi = #call bs_skip_qualified(%src, %t_lo, %len)
      %want = #sub[#bits<64>](%f_hi, %f_lo)
      %have = #sub[#bits<64>](%name_hi, %here)
      %len_ok = #eq[#bits<64>](%want, %have)
      %same = #if %len_ok -> (#bits<1>) {
        %a = #lea(%src, %here, 1, 0)
        %b = #lea(%src, %f_lo, 1, 0)
        %eq = #call meta_bytes_equal(%a, %b, %want)
        #yield %eq
      } else {
        #yield 0
      }
      #if %same {
        %sc = #call lain_meta_scratch_data()
        %put = #call meta_cell_put(#lea(%sc, 0, 1, 0), %t_hi)
        #break fields(%t_lo)
      }
      #continue fields(%t_hi)
    }
    #yield %found
  }
  #return %r
}

// 一个操作数**自己**的类型名窗口（起点是类型名，终点写进暂存区 `+0`，找不到回
// 「无」）。
//
// 操作数是字段访问（`p.x`）时，类型是**字段**的类型，用 `p` 的类型去查算子表
// 会撞上「积类型上没有 `+`」这种跟真实原因无关的拒绝（`1 + p.x` 真出过）。
#proc meta_operand_type_window(%base: #addr, %len: #bits<64>,
                                %parent: #bits<64>, %index: #bits<64>) -> #bits<64> {
  %form = #call meta_node_form(%parent, %index)
  %is_field = #eq[#bits<64>](%form, 6)
  %r = #if %is_field -> (#bits<64>) {
    %node = #call ast_child(%parent, %index)
    %v_lo = #call meta_node_start(%node)
    %v_hi = #add[#bits<64>](%v_lo, #call meta_node_len(%node))
    %after = #call bs_skip_space(%base, %v_hi, %len)
    %f_lo = #call bs_skip_space(%base, #add[#bits<64>](%after, 1), %len)
    %f_hi = #call bs_skip_ident(%base, %f_lo, %len)
    %bt_lo = #call meta_word_type_name(%base, %len, %node)
    %sc = #call lain_meta_scratch_data()
    %bt_hi = #call meta_cell_get(#lea(%sc, 0, 1, 0))
    %nobody = #eq[#bits<64>](%bt_lo, 0xFFFFFFFFFFFFFFFF)
    %fw = #if %nobody -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %tbody = #call meta_scope_body(%base, %bt_lo, %bt_hi, 4)
      %fwin = #call meta_field_type_window(%base, %len, %tbody, %f_lo, %f_hi)
      #yield %fwin
    }
    #yield %fw
  } else {
    %node2 = #call ast_child(%parent, %index)
    %tw = #call meta_word_type_name(%base, %len, %node2)
    #yield %tw
  }
  #return %r
}

// 记录的总大小。
#proc meta_layout_size(%src: #addr, %len: #bits<64>,
                       %body: #bits<64>) -> #bits<64> {
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  %r = #if %missing -> (#bits<64>) {
    #yield 0
  } else {
    %info = #call meta_walk_fields(%src, %len, %body, 0, 0, 0, 1)
    %failed_sentinel = #eq[#bits<64>](%info, 0xFFFFFFFFFFFFFFFF)
    %failed_zero = #eq[#bits<64>](%info, 0)
    %failed = #or[#bits<1>](%failed_sentinel, %failed_zero)
    %size = #if %failed -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %low = #and[#bits<64>](%info, 0xFFFFFFFFFF)
      #yield %low
    }
    #yield %size
  }
  #return %r
}

// struct 的最大字段对齐。
#proc meta_layout_align(%src: #addr, %len: #bits<64>,
                        %body: #bits<64>) -> #bits<64> {
  %r = #loop aligns(%at: #bits<64> = %body, %max: #bits<64> = 1)
       -> (#bits<64>) {
    %here = #call bs_skip_space(%src, %at, %len)
    %byte = #call bs_byte_at(%src, %here, %len)
    #if #eq[#bits<8>](%byte, 125) { #break aligns(%max) }
    %name_hi = #call bs_skip_ident(%src, %here, %len)
    %colon = #call bs_skip_space(%src, %name_hi, %len)
    %t_lo = #call bs_skip_space(%src, #add[#bits<64>](%colon, 1), %len)
    %t_hi = #call bs_skip_qualified(%src, %t_lo, %len)
    %tid = #call meta_type_resolve(%src, %len, %t_lo, %t_hi)
    #if #eq[#bits<64>](%tid, 0) {
      %scratch = #call lain_meta_scratch_data()
      %recursive = #call meta_cell_get(#lea(%scratch, 464, 1, 0))
      #if #eq[#bits<64>](%recursive, 0) {
        %fail = #call lain_meta_fail(5)
      }
      #break aligns(0)
    }
    %align = #call meta_tid_align(%tid)
    %next_max = #if #ugt[#bits<64>](%align, %max) -> (#bits<64>) {
      #yield %align
    } else { #yield %max }
    #continue aligns(%t_hi, %next_max)
  }
  #return %r
}

// struct 的名义类型 ID 独立存于注册表；作用域 payload 仍保留声明节点。
#proc meta_record_type_id(%index: #bits<64>) -> #bits<64> {
  %src = #call meta_scope_word(%index, 0)
  %len = #call lain_meta_source_length(%src)
  %base = #call lain_meta_source_data(%src)
  %node = #call meta_scope_decl_node(%index)
  %pos = #call meta_node_start(%node)
  %src1 = #add[#bits<64>](%src, 1)
  %high = #shl[#bits<64>](%src1, 32)
  %owner = #or[#bits<64>](%high, #add[#bits<64>](%pos, 1))
  %scratch = #call lain_meta_scratch_data()
  %registered = #call meta_reg_lookup(%scratch, 2, %owner, 0)
  #if #ne[#bits<64>](%registered, 0) { #return %registered }
  %top = #call meta_cell_get(#lea(%scratch, 456, 1, 0))
  %cycle = #loop active(%link: #bits<64> = %top) -> (#bits<1>) {
    #if #eq[#bits<64>](%link, 0) { #break active(0) }
    %entry = #lea(%scratch, %link, 1, 0)
    %active_owner = #call meta_cell_get(%entry)
    #if #eq[#bits<64>](%active_owner, %owner) { #break active(1) }
    %previous = #call meta_cell_get(#lea(%entry, 8, 1, 0))
    #continue active(%previous)
  }
  #if #ne[#bits<1>](%cycle, 0) {
    // 5 是当前类型解析/布局的稳定语义拒码；旁格让外层字段扫描不覆盖它。
    %set_cycle = #call meta_cell_put(#lea(%scratch, 464, 1, 0), 1)
    %recursive = #call lain_meta_fail(5)
    #return 0
  }
  %mark = #call meta_bump_mark()
  %frame = #call meta_bump_alloc(16)
  #if #eq[#bits<64>](%frame, 0xFFFFFFFFFFFFFFFF) { #return 0 }
  %frame_addr = #lea(%scratch, %frame, 1, 0)
  %save_owner = #call meta_cell_put(%frame_addr, %owner)
  %save_previous = #call meta_cell_put(#lea(%frame_addr, 8, 1, 0), %top)
  %push = #call meta_cell_put(#lea(%scratch, 456, 1, 0), %frame)
  %body = #call meta_decl_body(%base, %node)
  %size = #call meta_layout_size(%base, %len, %body)
  %failed = #eq[#bits<64>](%size, 0xFFFFFFFFFFFFFFFF)
  %id = #if %failed -> (#bits<64>) {
    #yield 0
  } else {
    %align = #call meta_layout_align(%base, %len, %body)
    %valid = #ugt[#bits<64>](%align, 0)
    %result = #if %valid -> (#bits<64>) {
      %new_id = #call meta_intern(2, %owner, 0, %size, %align)
      #yield %new_id
    } else { #yield 0 }
    #yield %result
  }
  %restore_top = #call meta_cell_put(#lea(%scratch, 456, 1, 0), %top)
  %release = #call meta_bump_release(%mark)
  #return %id
}

// --- 发射 -----------------------------------------------------------------

// 写 n 个 "0 "（给 data 的初值）
#proc meta_emit_zeros(%n: #bits<64>) -> #bits<32> {
  %st = #loop scan(%i: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%i, %n)
    #if %more {
      %w = #call lainir_zero_text()
      %i2 = #add[#bits<64>](%i, 1)
      #continue scan(%i2)
    } else {
      #break scan(0)
    }
  }
  #return %st
}

// 字段地址文本：`#lea(<基址引用>, 0, 0, <off>)`，写进 `%buf` 的 32 偏移处。
//
// `%base_n` 是「基址引用哪个值」：`0xFFFFFFFFFFFFFFFF` 用顶层的**字面名字** `%base`
// （顶层构造过程里那个固定名字），其余是临时值编号 —— 函数体内的构造，基址来自
// `#alloca` 的结果 `%r<n>`。**不能**让两处都叫 `%base`：装载器的 `region_lookup`
// 按名字返回**第一个**匹配，同一个过程里重名会静默指向前一个。
#proc meta_emit_field_addr(%buf: #addr, %off: #bits<64>, %base_n: #bits<64>) -> #bits<64> {
  %abase = #lea(%buf, 32, 1, 0)
  %named = #ne[#bits<64>](%base_n, 0xFFFFFFFFFFFFFFFF)
  %blen = #if %named -> (#bits<64>) {
    %l = #call lainir_buf_temp(%abase, 0, %base_n)
    #yield %l
  } else {
    %b = #data_addr lainir_base_name
    %l2 = #call lainir_buf_bytes(%abase, 0, %b, 5)
    #yield %l2
  }
  %lbuf = #lea(%buf, 64, 1, 0)
  %alen = #call lainir_text_lea_field(%lbuf, 0, %abase, %blen, %off)
  #return %alen
}

// 写一条 `  #store[repr](value, #lea(%base, 0, 0, off))`，值是**一个数**（`a: 1`）。
#proc meta_emit_store(%kind: #bits<64>, %width: #bits<64>,
                      %value: #bits<64>, %off: #bits<64>,
                      %base_n: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %vlen = #call lainir_buf_uint(%buf, 0, %value)
  %alen = #call meta_emit_field_addr(%buf, %off, %base_n)
  %lbuf = #lea(%buf, 64, 1, 0)
  %w = #call lainir_store(%kind, %width, %buf, %vlen, %lbuf, %alen)
  #return %w
}

// 写一条 `  #store[repr](<值文本>, #lea(%base, 0, 0, off))`：值文本由调用方渲染好
// （放在 `lainir_text_buffer` 的 0 起），地址那段与上面两条 store 同一个来源。
#proc meta_emit_store_text(%kind: #bits<64>, %width: #bits<64>,
                           %value_text: #addr, %value_len: #bits<64>,
                           %off: #bits<64>, %base_n: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %alen = #call meta_emit_field_addr(%buf, %off, %base_n)
  %lbuf = #lea(%buf, 64, 1, 0)
  %w = #call lainir_store(%kind, %width, %value_text, %value_len, %lbuf, %alen)
  #return %w
}

// 初始化列表 `{ f: v f: v }`：每个字段一条 store，值是**一条表达式**（`a: p + 1`）。
//
// 走**游标**（花括号组 + 下标）：值到哪结束只有表达式那条路答得出来 —— 「下一个字段名」
// （一个槽后面紧跟 `:`）由 `meta_emit_expr` 当终点，终止下标放在暂存区 `+192`。
#proc meta_construct_fields(%base: #addr, %len: #bits<64>,
                            %body: #bits<64>,
                            %group: #bits<64>,
                            %base_n: #bits<64>) -> #bits<32> {
  %gnone = #eq[#bits<64>](%group, 0)
  %st = #if %gnone -> (#bits<32>) {
    // 初始化列表不是组：形状坏了
    %fg = #call lain_meta_fail(4)
    #yield 4
  } else {
    %count = #call ast_child_count(%group)
    %r = #loop fields(%i: #bits<64> = 0) -> (#bits<32>) {
      %more = #ult[#bits<64>](%i, %count)
      #if %more {
        %fnode = #call ast_child(%group, %i)
        %f_lo = #call meta_node_start(%fnode)
        %f_hi = #add[#bits<64>](%f_lo, #call meta_node_len(%fnode))
        // 逗号（`a: 1, b: 2` 的写法）夹在字段之间：跳掉
        %fb = #call bs_byte_at(%base, %f_lo, %len)
        %iscomma = #eq[#bits<8>](%fb, 44)
        #if %iscomma {
          #continue fields(#add[#bits<64>](%i, 1))
        }
        %info = #call meta_layout_field(%base, %len, %body, %f_lo, %f_hi)
        // 走表不中就是错的：不能把「走到 } 得到的总大小」当成字段偏移用。
        %found = #lshr[#bits<64>](%info, 63)
        %missing = #eq[#bits<64>](%found, 0)
        #if %missing {
          %f = #call lain_meta_fail(8)
          #break fields(8)
        }
        %off = #and[#bits<64>](%info, 0xFFFFFFFFFF)
        %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 40), 15)
        %width = #and[#bits<64>](#lshr[#bits<64>](%info, 44), 255)
        // 名字、冒号各占一格，值是第三格起的那条表达式
        %vi = #add[#bits<64>](%i, 2)
        %vst = #call meta_emit_expr(%base, %len, %kind, %width, 0, 0, %group,
                                    %vi, 0, 0, 0, 0)
        %vbad = #ne[#bits<32>](%vst, 0)
        #if %vbad {
          #break fields(%vst)
        }
        %sc = #call lain_meta_scratch_data()
        %vref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
        %vlo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
        %vhi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
        %nx = #call meta_cell_get(#lea(%sc, 192, 1, 0))
        %vbuf = #data_addr lainir_text_buffer
        %vlen = #call meta_render_ref2(%base, %len, %vref, %vlo, %vhi, %vbuf)
        %lenbad = #eq[#bits<64>](%vlen, 0xFFFFFFFFFFFFFFFF)
        #if %lenbad {
          %fl = #call lain_meta_fail(4)
          #break fields(4)
        }
        %w = #call meta_emit_store_text(%kind, %width, %vbuf, %vlen, %off,
                                        %base_n)
        %wn = #ne[#bits<32>](%w, 0)
        #if %wn {
          #break fields(%w)
        }
        // 表达式停在下一格：那是下一个字段名、夹着的逗号、或者组的末尾
        #continue fields(%nx)
      } else {
        #break fields(0)
      }
    }
    #yield %r
  }
  #return %st
}

// `let NAME = Rec { ... }`：
//   data NAME_storage rw { 0 ... }
//   #proc NAME() -> #addr { %base = #data_addr NAME_storage; stores; #return %base }
//
// `type_body` 是那个类型声明的正文起点——**从符号表取**（`meta_scope_body`），
// 不是每次回源码里找一遍。`group` 是初始化列表那个**组节点**——字段值是一条表达式，
// 走的是游标（组 + 下标），所以调用方把组一起给进来。
#proc meta_lower_construct(%base: #addr, %len: #bits<64>,
                           %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                           %type_body: #bits<64>,
                           %group: #bits<64>) -> #bits<32> {
  %size = #call meta_layout_size(%base, %len, %type_body)
  %failed = #eq[#bits<64>](%size, 0xFFFFFFFFFFFFFFFF)
  #if %failed {
    %reset = #call lain_meta_emit_reset()
    %eval_code = #call lain_meta_apply_status()
    %has_eval_code = #ugt[#bits<64>](%eval_code, 0)
    %code = #if %has_eval_code -> (#bits<32>) {
      %low = #trunc[#bits<32>](%eval_code)
      #yield %low
    } else {
      #yield 7
    }
    #return %code
  }
  %bind_at = #lea(%base, %bind_lo, 1, 0)
  %bind_len = #sub[#bits<64>](%bind_hi, %bind_lo)

  %w1 = #call lainir_data_head()
  %w2 = #call lainir_write(%bind_at, %bind_len)
  %w3 = #call lainir_data_rw_head()
  %w4 = #call meta_emit_zeros(%size)
  %w5 = #call lainir_proc_head_open()

  %w6 = #call lainir_write(%bind_at, %bind_len)
  %w7 = #call lainir_addr_body_write()
  %w8 = #call lainir_base_assign_write()
  %w9 = #call lainir_write(%bind_at, %bind_len)
  %w10 = #call lainir_storage_suffix_write()

  %st = #call meta_construct_fields(%base, %len, %type_body, %group,
                                  0xFFFFFFFFFFFFFFFF)

  %w11 = #call lainir_return_base_close()
  #return %st
}

// `let p = Rec { ... }` / `return Rec { ... }` **在函数体里**。
//
// 顶层那份（`meta_lower_construct`）落一个静态 `data` 块；函数体里发不出顶层 `data`
// （发射是流式的），所以从**栈**上划一块：
//
//   %r<n> = #alloca[#bits<8>](size)
//   #store[...](value, #lea(%r<n>, 0, 0, off))
//   ...
//   %p = #lea(%r<n>, 0, 1, 0)        // 绑定；`return` 那一格换成 `#return %r<n>`
//
// `#alloca` 从栈租约的水位递增，帧退出时水位回退（`stack_mark`），所以这块地址
// **不能带出函数** —— 同 C 返回局部地址。框对齐到 16 字节。
//
// `%type_lo`/`%type_hi` 是构造名（`Rec`）的位置，`%group` 是那个花括号组节点。
#proc meta_lower_construct_local(%base: #addr, %len: #bits<64>,
                                 %name_lo: #bits<64>, %name_hi: #bits<64>,
                                 %type_lo: #bits<64>, %type_hi: #bits<64>,
                                 %group: #bits<64>,
                                 %is_ret: #bits<1>) -> #bits<32> {
  %body = #call meta_scope_body(%base, %type_lo, %type_hi, 4)
  %missing = #eq[#bits<64>](%body, 0xFFFFFFFFFFFFFFFF)
  #if %missing {
    // 名字不是积类型（和类型变体在函数体里的构造还没做）
    %nf = #call lain_meta_fail(4)
    #return 4
  }
  %size = #call meta_layout_size(%base, %len, %body)
  %bad = #eq[#bits<64>](%size, 0xFFFFFFFFFFFFFFFF)
  #if %bad {
    %reset = #call lain_meta_emit_reset()
    %eval_code = #call lain_meta_apply_status()
    %has_eval_code = #ugt[#bits<64>](%eval_code, 0)
    %code = #if %has_eval_code -> (#bits<32>) {
      %low = #trunc[#bits<32>](%eval_code)
      #yield %low
    } else {
      #yield 7
    }
    #return %code
  }
  %empty = #eq[#bits<64>](%size, 0)
  #if %empty {
    // 空类型没有可划的框；count 为 0 的 `#alloca` 被验证器拒（2024）
    %zero = #call lain_meta_fail(5)
    #return 5
  }
  %n = #call meta_next_temp()
  %w7 = #call lainir_alloca_at(%n, 8, %size)
  %st = #call meta_construct_fields(%base, %len, %body, %group, %n)
  #if #ne[#bits<32>](%st, 0) {
    #return %st
  }
  %tail = #if %is_ret -> (#bits<32>) {
    %buf = #data_addr lainir_text_buffer
    %tlen = #call lainir_buf_temp(%buf, 0, %n)
    %w10 = #call lainir_return_ref(%buf, %tlen)
    #yield 0
  } else {
    %buf2 = #data_addr lainir_text_buffer
    %tbuf = #lea(%buf2, 64, 1, 0)
    %tlen2 = #call lainir_buf_temp(%tbuf, 0, %n)
    %nbuf = #lea(%buf2, 128, 1, 0)
    %npct = #call lainir_buf_byte(%nbuf, 0, 37)
    %bind_at = #lea(%base, %name_lo, 1, 0)
    %bind_len = #sub[#bits<64>](%name_hi, %name_lo)
    %nlen = #call lainir_buf_bytes(%nbuf, %npct, %bind_at, %bind_len)
    %zbuf = #lea(%buf2, 180, 1, 0)
    %zlen = #call lainir_buf_uint(%zbuf, 0, 0)
    %w17 = #call lainir_lea_named(%nbuf, %nlen, %tbuf, %tlen2, %zbuf, %zlen, 1, 0)
    #yield 0
  }
  #return %tail
}


// `let NAME = Rec.field(VAR)` —— v0 里记录名和值名都写出来，
// 所以不需要值表。`p.left` 那种写法要一张「值名 → 类型名」的表，是下一步。
#proc meta_lower_field_access(%base: #addr, %len: #bits<64>,
                              %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                              %type_body: #bits<64>,
                              %at: #bits<64>) -> #bits<32> {
  %f_lo = #call bs_skip_space(%base, %at, %len)
  %f_hi = #call bs_skip_ident(%base, %f_lo, %len)
  %paren = #call bs_skip_space(%base, %f_hi, %len)
  %one = #add[#bits<64>](%paren, 1)
  %v_lo = #call bs_skip_space(%base, %one, %len)
  %v_hi = #call bs_skip_ident(%base, %v_lo, %len)

  %info = #call meta_layout_field(%base, %len, %type_body, %f_lo, %f_hi)
  %off = #and[#bits<64>](%info, 0xFFFFFFFFFF)
  %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 40), 15)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 44), 255)

  %bind_at = #lea(%base, %bind_lo, 1, 0)
  %bind_len = #sub[#bits<64>](%bind_hi, %bind_lo)
  %var_at = #lea(%base, %v_lo, 1, 0)
  %var_len = #sub[#bits<64>](%v_hi, %v_lo)

  %buf = #data_addr lainir_text_buffer
  %bbuf = #lea(%buf, 128, 1, 0)
  %h = #call lainir_proc_head_full(%bind_at, %bind_len, %bbuf, 0, %kind, %width)
  %o = #call lainir_open_body()
  %b = #data_addr lainir_name_b
  %v = #data_addr lainir_name_v
  %c1 = #call lainir_call_named(%b, 2, %var_at, %var_len, %bbuf, 0)
  %b2 = #data_addr lainir_name_b2
  %zbuf = #lea(%buf, 180, 1, 0)
  %zlen = #call lainir_buf_uint(%zbuf, 0, 0)
  %l1 = #call lainir_lea_named(%b2, 3, %b, 2, %zbuf, %zlen, 1, %off)
  %l2 = #call lainir_load_named(%v, 2, %kind, %width, %b2, 3)
  %r2 = #call lainir_return_ref(%v, 2)
  %c2 = #call lainir_close_body()
  #return 0
}

// `p.x` 当值用：`p` 是**一个值**（函数参数，类型从参数表来），字段偏移在编译期从
// 类型正文算出来，然后发两条指令：`#lea` 取字段地址（基址是值本身、下标 0、缩放 1、
// 位移是字段偏移），`#load` 按字段类型取出值。取值结果的临时值下标写进暂存区 +168
// （+176/+184 清零）—— 与 `meta_operand_emit` 的约定一致：调用方从 168/176/184 这一
// 组读「结果是谁」。
#proc meta_lower_field_get(%base: #addr, %len: #bits<64>,
                           %v_lo: #bits<64>, %v_hi: #bits<64>,
                           %type_body: #bits<64>,
                           %f_lo: #bits<64>, %f_hi: #bits<64>) -> #bits<32> {
  %info = #call meta_layout_field(%base, %len, %type_body, %f_lo, %f_hi)
  %found = #lshr[#bits<64>](%info, 63)
  %missing = #eq[#bits<64>](%found, 0)
  #if %missing {
    // 走表不中：那是错的，不能拿「走到 } 得到的总大小」当字段偏移用。
    %f = #call lain_meta_fail(8)
    #return 8
  }
  %off = #and[#bits<64>](%info, 0xFFFFFFFFFF)
  %kind = #and[#bits<64>](#lshr[#bits<64>](%info, 40), 15)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 44), 255)

  // 缓冲区（`lainir_text_buffer`，192 字节）分段：0 起是 lea 结果的临时值名、
  // 32 起是值名（带 `%`）、64 起是 load 结果的临时值名、180 是 lea 的下标 `0`。
  %buf = #data_addr lainir_text_buffer
  %v_at = #lea(%base, %v_lo, 1, 0)
  %v_n = #sub[#bits<64>](%v_hi, %v_lo)
  %pfx = #call lainir_buf_byte(%buf, 32, 37)
  %v_end = #call lainir_buf_bytes(%buf, %pfx, %v_at, %v_n)
  %v_len = #sub[#bits<64>](%v_end, 32)
  %v_txt = #lea(%buf, 32, 1, 0)
  %zbuf = #lea(%buf, 180, 1, 0)
  %zlen = #call lainir_buf_uint(%zbuf, 0, 0)

  %n1 = #call meta_next_temp()
  %l1 = #call lainir_buf_temp(%buf, 0, %n1)
  %w1 = #call lainir_lea_named(%buf, %l1, %v_txt, %v_len, %zbuf, %zlen, 1, %off)

  %n2 = #call meta_next_temp()
  %tbuf = #lea(%buf, 64, 1, 0)
  %l2 = #call lainir_buf_temp(%tbuf, 0, %n2)
  %w2 = #call lainir_load_named(%tbuf, %l2, %kind, %width, %buf, %l1)

  %sc = #call lain_meta_scratch_data()
  %s1 = #call meta_cell_put(#lea(%sc, 168, 1, 0), %n2)
  %s2 = #call meta_cell_put(#lea(%sc, 176, 1, 0), 0)
  %s3 = #call meta_cell_put(#lea(%sc, 184, 1, 0), 0)
  #return 0
}

// `p.x` 出现在操作数位置（返回、绑定、实参、更大的表达式里）。形状 6 说的是「这里
// 开始一次字段访问」，形状判据已由识别 pass 算好，所以这里只解析两段字节区间：值名
// （点号左边那个 token）与字段名（点号右边）。
//
// 值名的类型**只认函数参数**（`meta_word_type_name`）：局部绑定与循环参数今天没有
// 「值名 → 类型」的表，干净地报 4。类型正文从符号表取，字段偏移在编译期算出。
#proc meta_emit_field_temp(%base: #addr, %len: #bits<64>,
                            %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %node = #call ast_child(%parent, %index)
  %v_lo = #call meta_node_start(%node)
  %v_hi = #add[#bits<64>](%v_lo, #call meta_node_len(%node))
  %after = #call bs_skip_space(%base, %v_hi, %len)
  %dot = #add[#bits<64>](%after, 1)
  %f_lo = #call bs_skip_space(%base, %dot, %len)
  %f_hi = #call bs_skip_ident(%base, %f_lo, %len)

  %t_lo = #call meta_word_type_name(%base, %len, %node)
  %sc = #call lain_meta_scratch_data()
  %t_hi = #call meta_cell_get(#lea(%sc, 0, 1, 0))
  %unknown = #eq[#bits<64>](%t_lo, 0xFFFFFFFFFFFFFFFF)
  %st = #if %unknown -> (#bits<32>) {
    %f1 = #call lain_meta_fail(4)
    #yield 4
  } else {
    %tb = #call meta_scope_body(%base, %t_lo, %t_hi, 4)
    %nobody = #eq[#bits<64>](%tb, 0xFFFFFFFFFFFFFFFF)
    %g = #if %nobody -> (#bits<32>) {
      // 值名的声明类型不是积类型（和类型的变体投影是另一条路）
      %f2 = #call lain_meta_fail(4)
      #yield 4
    } else {
      %gz = #call meta_lower_field_get(%base, %len, %v_lo, %v_hi, %tb, %f_lo, %f_hi)
      #yield %gz
    }
    #yield %g
  }
  #return %st
}
