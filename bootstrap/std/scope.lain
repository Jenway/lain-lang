// 作用域表 —— 由 bootstrapl1/std/scope.l1 翻译成 Lain 表面语法。
// 暂存区分段布局、容量公式与查找规则的说明见旧源文件头部注释。
//
// 模块：跨单元引用一律写 `别名.名字`（别名 = 被导入单元的模块键），
// 指向本仓其它单元的影子 extern 已删除；宿主能力 extern 保留。

let std_declarations = import("declarations");
let std_expand = import("expand");
let std_handlers_let = import("handlers/let");
let std_lex = import("lex");
let std_modules = import("modules");
let std_parse = import("parse");
let std_records = import("records");
let std_regions = import("regions");
let std_registry = import("registry");
let std_sums = import("sums");
let std_syntax = import("syntax");
let std_types = import("types");

extern lain_meta_source_count() -> u64 = lain_meta_source_count;
extern lain_meta_source_length(source: u64) -> u64 = lain_meta_source_length;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_scratch_size() -> u64 = lain_meta_scratch_size;
extern lain_meta_status() -> u64 = lain_meta_status;
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_trace(slot: u64, value: u64) -> u64 = lain_meta_trace;
extern lain_meta_ast_commit(source: u64, old_root: u64, new_root: u64, tx: u64) -> u32 = lain_meta_ast_commit;
extern lain_meta_ast_tx_rollback(tx: u64) -> u32 = lain_meta_ast_tx_rollback;

let meta_kw_colon_b: ro [u8] = [58];

// --- 建表 -----------------------------------------------------------------

func meta_scope_setup(scan: bool) -> u32 {
  let count: u64 = lain_meta_source_count();
  let total: u64 = loop sum(i: u64 = 0, acc: u64 = 0) {
    let more: bool = i < count;
    if more {
      let n: u64 = lain_meta_source_length(i);
      let acc2: u64 = acc + n;
      continue sum(i + 1, acc2);
    } else {
      break sum(acc);
    }
  };
  let scratch: addr = lain_meta_scratch_data();
  let grant: u32 = std_regions.meta_region_scratch_window();
  let gst: u64 = lain_meta_status();
  let gnonzero: bool = gst != 0;
  if gnonzero {
    let gpublish: u32 = lain_meta_fail(gst as u32);
    return gst as u32;
  }
  let size: u64 = lain_meta_scratch_size();
  let t16: u64 = total / 16;
  let tcap: u64 = t16 + 8;
  let t8: u64 = total / 8;
  let scap: u64 = t8 + 8;
  let nodes0_sem: u64 = total + 8;
  let host_end0: u64 = std_parse.meta_host_meta_end();
  let reg_base: u64 = if host_end0 < 520 { 520 } else { host_end0 };
  let reg_bytes: u64 = tcap * 64;
  let reg_end: u64 = reg_base + reg_bytes;
  let rbw: u32 = std_types.meta_cell_put_raw(std_registry.meta_reg_base_state, reg_base);
  let ctl_floor: u64 = 2504 + 56;
  let sc_base: u64 = if reg_end < ctl_floor { ctl_floor } else { reg_end };
  let sc_bytes: u64 = scap * 56;
  let dep_cap: u64 = total + 8;
  let dep_bytes: u64 = dep_cap * 24;
  let dep_base: u64 = sc_base + sc_bytes;
  let dep_end: u64 = dep_base + dep_bytes;
  let host_end: u64 = std_parse.meta_host_meta_end();
  let path_at: u64 = dep_end + 0;
  let ctl_end: u64 = 1096 + 64;
  let lower: u64 = if path_at < host_end { host_end } else { path_at };
  let path_at2: u64 = if lower < ctl_end { ctl_end } else { lower };
  let path_bytes_ad: addr = std_registry.meta_path_cap;
  let path_bytes: u64 = std_types.meta_cell_get(path_bytes_ad);
  let path_end: u64 = path_at2 + path_bytes;
  let sem_base: u64 = path_end + 48;
  let sem_entries: u64 = nodes0_sem * 72;
  let need: u64 = sem_base + sem_entries;
  let fits: bool = need <= size;
  if fits == 0 {
    let dbg_a: u64 = lain_meta_trace(40, need);
    let dbg_b: u64 = lain_meta_trace(41, size);
    let dbg_c: u64 = lain_meta_trace(42, sem_base);
    let dbg_d: u64 = lain_meta_trace(43, sem_entries);
    let kd0: u64 = dbg_a + dbg_b;
    let kd1: u64 = dbg_c + dbg_d;
    let keepd: u64 = kd0 + kd1;
    let f: u32 = lain_meta_fail(17);
    let fk: u32 = f + (keepd as u32);
    return 17;
  }
  let s1: u32 = std_types.meta_cell_put(scratch + 56, total);
  let s2: u32 = std_types.meta_cell_put(scratch + 64, tcap);
  let s3: u32 = std_types.meta_cell_put(scratch + 72, sc_base);
  let s4: u32 = std_types.meta_cell_put(scratch + 80, scap);
  let s5: u32 = std_types.meta_cell_put(scratch + 88, 0);
  let s6: u32 = std_types.meta_cell_put(scratch + 152, 0xFFFFFFFFFFFFFFFF);
  let d0: u32 = std_types.meta_cell_put(scratch + 416, dep_base);
  let d1: u32 = std_types.meta_cell_put(scratch + 424, dep_cap);
  let d2: u32 = std_types.meta_cell_put(scratch + 432, 0);
  let closure_base_off: u64 = dep_cap * 16;
  let closure_base: u64 = dep_base + closure_base_off;
  let d3: u32 = std_types.meta_cell_put(scratch + 440, closure_base);
  let d4: u32 = std_types.meta_cell_put(scratch + 448, 0);
  let d5: u32 = std_types.meta_cell_put(scratch + 456, 0);
  let d6: u32 = std_types.meta_cell_put(scratch + 464, 0);
  let d7: u32 = std_types.meta_cell_put(scratch + 472, 0);
  let ve: u32 = std_types.meta_cell_put(scratch + 480, 0);
  let bw: u32 = std_types.meta_cell_put(scratch + 200, need);
  let bp: u32 = std_types.meta_cell_put(scratch + 208, need);
  let bq: u32 = std_types.meta_cell_put(scratch + 216, 0);
  let bc: u32 = std_types.meta_cell_put(scratch + 496, 0);
  let fp: u32 = std_types.meta_cell_put(scratch + 504, 0);
  let t4: u32 = std_types.meta_cell_put(scratch + 1000, sem_base);
  let z0: u32 = std_types.meta_cell_put(scratch + 1008, 0);
  let z1: u32 = std_types.meta_cell_put(scratch + 1016, 0);
  let z2: u32 = std_types.meta_cell_put(scratch + 1024, 0);
  let z3: u32 = std_types.meta_cell_put(scratch + 1032, 0);
  let z4: u32 = std_types.meta_cell_put(scratch + 1040, 0);
  let z5: u32 = std_types.meta_cell_put(scratch + 1048, 0);
  let c0: u32 = std_types.meta_cell_put(scratch + 1056, nodes0_sem);
  let c1: u32 = std_types.meta_cell_put(scratch + 1064, nodes0_sem);
  let c2: u32 = std_types.meta_cell_put(scratch + 1072, nodes0_sem);
  let c3: u32 = std_types.meta_cell_put(scratch + 1080, nodes0_sem);
  let c4: u32 = std_types.meta_cell_put(scratch + 1088, nodes0_sem);
  let c5: u32 = std_types.meta_cell_put(scratch + 1096, nodes0_sem);
  let zl: u32 = std_types.meta_cell_put(scratch + 2128, 0);
  let zb: u32 = std_types.meta_cell_put(scratch + 2136, 0);
  let semi: u32 = std_parse.meta_sem_init();
  let syntax: u32 = std_syntax.meta_syntax_init();
  if syntax != 0 { return syntax; }
  let ksc: addr = lain_meta_scratch_data();
  let ks0: u32 = std_types.meta_cell_put(ksc + 2048, count);
  if scan == 0 { return 0; }
  let parsed: u32 = loop ps(i: u64 = 0) {
    let kt0: u64 = std_types.meta_cell_get_raw(ksc + 2056);
    let kt1: u64 = kt0 + 1;
    let kt2: u32 = std_types.meta_cell_put(ksc + 2056, kt1);
    let more: bool = i < count;
    if more {
      let st: u32 = std_parse.meta_parse_source(i);
      let sti: u64 = st as u64;
      let bad: bool = st != 0;
      if bad { break ps(st); }
      continue ps(i + 1);
    } else {
      break ps(0);
    }
  };
  if parsed != 0 { return parsed; }
  let z144: u32 = std_types.meta_cell_put(scratch + 144, 0);
  let s6b: u32 = std_types.meta_cell_put(scratch + 96, 0xFFFFFFFFFFFFFFFF);
  return 0;
}

// Expand 的声明协调步：只登记身份/声明位置，不运行函数体或 Lowering。
func meta_declare_available(source: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let clear_root: u32 = std_types.meta_cell_put(scratch + 96, 0xFFFFFFFFFFFFFFFF);
  let mark: u64 = meta_scope_count();
  let current: u32 = meta_scope_set_current(source);
  let len: u64 = lain_meta_source_length(source);
  let base: addr = lain_meta_source_data(source);
  let scan: u32 = meta_scope_scan(base, len, source, mark);
  return scan;
}

// 路径 / mangle 缓冲区：动态区里紧接作用域表与依赖区之后。
func meta_path_buffer() -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let sc_base: u64 = std_types.meta_cell_get(scratch + 72);
  let scap: u64 = std_types.meta_cell_get(scratch + 80);
  let sc_bytes: u64 = scap * 56;
  let dep_cap: u64 = std_types.meta_cell_get(scratch + 424);
  let dep_bytes: u64 = dep_cap * 24;
  let at0: u64 = sc_base + sc_bytes;
  let at: u64 = at0 + dep_bytes;
  return at;
}

// --- 单元自己的顶层符号名（模块键前缀）-------------------------------------
//
// lain0 对**模块自己**的顶层 func 与顶层 let 都发 `<模块键>__<名字>`，数据符号是
// `<键>__<名字>_storage`；模块键 = 该模块**解析到的路径**去 `.lain`、`/`→`_`（见
// std/modules.lain 的 meta_build_mangle）。宿主 extern 例外：保持平坦名（宿主按
// `link_name` 找它），所以调用点要能分辨「本单元的 func」与「extern」。
//
// 被降级的这份源码（当前单元）的索引就是作用域表的「当前源码」格。

// 路径 / mangle 缓冲区的**地址**（scratch 基址 + 偏移）。渲染名字用它。
func meta_path_buf() -> addr {
  let scratch: addr = lain_meta_scratch_data();
  let off: u64 = meta_path_buffer();
  let p: addr = scratch + off;
  return p;
}

// buf[at..] = src[0..n]，返回 at+n。
func meta_buf_copy(out: addr, at: u64, src: addr, n: u64) -> u64 {
  let end: u64 = loop cp(i: u64 = 0) {
    let more: bool = i < n;
    if more {
      let b: u8 = load(src + i);
      let head: addr = out + at;
      let p: addr = head + i;
      store(p, b);
      continue cp(i + 1);
    } else {
      break cp(at + n);
    }
  };
  return end;
}

// 这条声明是 `extern` 吗？（声明节点的第一个词就是 `extern`。）
func meta_scope_is_extern(index: u64) -> bool {
  let node: u64 = meta_scope_payload(index);
  let src: u64 = meta_scope_word(index, 0);
  let base: addr = lain_meta_source_data(src);
  let kw: addr = std_lex.meta_kw_extern;
  let hit: bool = std_parse.meta_node_is_word(node, base, kw, 6);
  return hit;
}

// `<当前单元键>__<名字>` 渲染进 buf（名字字节 = 从 at 起 len 个），返回总长度。
func meta_unit_symbol(buf: addr, at: addr, len: u64) -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let idx: u64 = std_types.meta_cell_get(scratch + 104);
  let k: u64 = std_modules.meta_module_key(idx, buf);
  let u1: u64 = k + 1;
  let us: u8 = 95;
  let p1: addr = buf + k;
  store(p1, us);
  let u2: u64 = u1 + 1;
  let p2: addr = buf + u1;
  store(p2, us);
  let total: u64 = meta_buf_copy(buf, u2, at, len);
  return total;
}

// 调用点的被调名渲染进 buf，返回长度：解析到**本单元的 func**（不是 extern）就发
// `<键>__<名字>`；extern / 找不到 → 原样搬。extern 保持平坦是契约。
func meta_callee_symbol(buf: addr, at: addr, len: u64) -> u64 {
  let i: u64 = meta_scope_find(at, len);
  let found: bool = i != 0xFFFFFFFFFFFFFFFF;
  let ex: bool = if found { meta_scope_is_extern(i) } else { 1 };
  let total: u64 = loop pick(t: u64 = 0) {
    if ex {
      let raw: u64 = meta_buf_copy(buf, 0, at, len);
      break pick(raw);
    }
    let sym: u64 = meta_unit_symbol(buf, at, len);
    break pick(sym);
  };
  return total;
}

// --- 暂存区分配器（碰撞式）--------------------------------------------------

func meta_bump_word(off: u64) -> u64 {
  let scratch: addr = std_regions.meta_region_scratch_base();
  let v: u64 = std_types.meta_cell_get(scratch + off);
  return v;
}

func meta_bump_mark() -> u64 {
  let w: u64 = meta_bump_word(200);
  return w;
}

func meta_bump_peak() -> u64 {
  let v: u64 = meta_bump_word(208);
  return v;
}

func meta_bump_alloc(bytes: u64) -> u64 {
  let scratch: addr = std_regions.meta_region_scratch_base();
  let size: u64 = std_regions.meta_region_scratch_capacity();
  let at: u64 = meta_bump_mark();
  let alignable: bool = bytes <= 0xFFFFFFFFFFFFFFF8;
  if alignable == 0 {
    let fail: u32 = lain_meta_fail(17);
    return 0xFFFFFFFFFFFFFFFF;
  }
  let pad0: u64 = bytes + 7;
  let need: u64 = pad0 & 0xFFFFFFFFFFFFFFF8;
  let end: u64 = at + need;
  let not_wrapped: bool = end >= at;
  let within: bool = end <= size;
  let ok: bool = not_wrapped and within;
  if ok {
    let putw: u32 = std_types.meta_cell_put(scratch + 200, end);
    let peak: u64 = meta_bump_peak();
    let higher: bool = end > peak;
    if higher {
      let putp: u32 = std_types.meta_cell_put(scratch + 208, end);
    }
    return at;
  }
  let f: u32 = lain_meta_fail(17);
  return 0xFFFFFFFFFFFFFFFF;
}

func meta_bump_release(mark: u64) -> u32 {
  let scratch: addr = std_regions.meta_region_scratch_base();
  let s: u32 = std_types.meta_cell_put(scratch + 200, mark);
  return 0;
}

func meta_scope_count() -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let v: u64 = std_types.meta_cell_get(scratch + 88);
  return v;
}

func meta_scope_release(mark: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let s: u32 = std_types.meta_cell_put(scratch + 88, mark);
  return 0;
}

func meta_scope_entry(index: u64) -> addr {
  let scratch: addr = lain_meta_scratch_data();
  let base: u64 = std_types.meta_cell_get(scratch + 72);
  let p: addr = scratch + base;
  let off: u64 = index * 56;
  let dbg_b: u32 = std_types.meta_cell_put(scratch + 1806, 1);
  let dbg_i: u32 = std_types.meta_cell_put(scratch + 1814, index);
  let dbg_o: u32 = std_types.meta_cell_put(scratch + 1822, off);
  let q: addr = p + off;
  return q;
}

func meta_scope_word(index: u64, off: u64) -> u64 {
  let e: addr = meta_scope_entry(index);
  let p: addr = e + off;
  let v: u64 = std_types.meta_cell_get(p);
  return v;
}

func meta_scope_kind(index: u64) -> u64 {
  let v: u64 = meta_scope_word(index, 24);
  return v;
}

func meta_scope_payload(index: u64) -> u64 {
  let v: u64 = meta_scope_word(index, 32);
  return v;
}

func meta_scope_aux(index: u64) -> u64 {
  let v: u64 = meta_scope_word(index, 40);
  return v;
}

func meta_scope_emitted(index: u64) -> u64 {
  let v: u64 = meta_scope_word(index, 48);
  return v;
}

// 声明引用由最终树中的 (source, parent group, child index) 定位。
func meta_scope_decl_node(index: u64) -> u64 {
  let kind: u64 = meta_scope_kind(index);
  let is_struct: bool = kind == 4;
  let is_enum: bool = kind == 5;
  let is_func: bool = kind == 6;
  let decl2: bool = is_enum or is_func;
  let decl_kind: bool = is_struct or decl2;
  if decl_kind == 0 {
    let fail0: u32 = lain_meta_fail(9414);
    return 0;
  }
  let parent: u64 = meta_scope_aux(index);
  let child_index: u64 = meta_scope_emitted(index);
  let actual: u64 = std_parse.ast_child(parent, child_index);
  let cached: u64 = meta_scope_payload(index);
  let present: bool = actual != 0;
  let same: bool = actual == cached;
  let valid: bool = present and same;
  if valid == 0 {
    let fail: u32 = lain_meta_fail(9414);
    return 0;
  }
  return cached;
}

// 普通调用必须绑定到已登记的过程声明；返回其出现位置对应的节点。
func meta_scope_require_func(name: addr, name_len: u64) -> u64 {
  let index: u64 = meta_scope_find(name, name_len);
  let found: bool = index != 0xFFFFFFFFFFFFFFFF;
  let kind: u64 = if found { meta_scope_kind(index) } else { 0 };
  let is_func: bool = kind == 6;
  let is_table: bool = kind == 3;
  let tab_esz: u64 = if is_table { meta_scope_emitted(index) } else { 0 };
  let is_static: bool = tab_esz != 0;
  let is_size_name: bool = meta_scope_generated_size_name(name, name_len);
  let not_found: bool = index == 0xFFFFFFFFFFFFFFFF;
  let synthetic_candidate: bool = is_size_name and not_found;
  let prefix_len: u64 = name_len - 6;
  let type_index: u64 = meta_scope_find(name, prefix_len);
  let type_found: bool = type_index != 0xFFFFFFFFFFFFFFFF;
  let type_kind: u64 = if type_found { meta_scope_kind(type_index) } else { 0 };
  let type_is_struct: bool = type_kind == 4;
  let type_node: u64 = if type_is_struct { meta_scope_decl_node(type_index) } else { 0 };
  let has_type: bool = type_node != 0;
  let accept_syn: bool = synthetic_candidate and has_type;
  if is_func {
    let decl: u64 = meta_scope_decl_node(index);
    if decl != 0 {
      let edge: u32 = meta_scope_dependency_add(index);
      if edge == 0 { return decl; }
    }
  } else {
    if is_static { return 1; }
    if accept_syn {
      let edge2: u32 = meta_scope_dependency_add(type_index);
      if edge2 == 0 { return 1; }
    }
  }
  let prior: u64 = lain_meta_status();
  if prior == 0 {
    let fail: u32 = lain_meta_fail(9415);
    return 0;
  }
  return 0;
}

// 依赖边记录声明表身份，不记录拼写；扫描去重保持首次遇见顺序。
func meta_scope_dependency_add(target: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let from: u64 = std_types.meta_cell_get(scratch + 152);
  let inactive: bool = from == 0xFFFFFFFFFFFFFFFF;
  if inactive { return 0; }
  let base: u64 = std_types.meta_cell_get(scratch + 416);
  let count: u64 = std_types.meta_cell_get(scratch + 432);
  let cap: u64 = std_types.meta_cell_get(scratch + 424);
  let seen: bool = loop find(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let slot_off: u64 = i * 16;
      let at: u64 = base + slot_off;
      let old_from: u64 = std_types.meta_cell_get(scratch + at);
      let to_at: u64 = at + 8;
      let old_to: u64 = std_types.meta_cell_get(scratch + to_at);
      let same_from: bool = old_from == from;
      let same_to: bool = old_to == target;
      let same: bool = same_from and same_to;
      if same { break find(1); }
      continue find(i + 1);
    } else {
      break find(0);
    }
  };
  if seen { return 0; }
  let full: bool = count >= cap;
  if full {
    let fail: u32 = lain_meta_fail(9416);
    return 9416;
  }
  let slot_off2: u64 = count * 16;
  let at2: u64 = base + slot_off2;
  let a: u32 = std_types.meta_cell_put(scratch + at2, from);
  let to_at2: u64 = at2 + 8;
  let b: u32 = std_types.meta_cell_put(scratch + to_at2, target);
  let new_count: u64 = count + 1;
  let c: u32 = std_types.meta_cell_put(scratch + 432, new_count);
  return 0;
}

// struct 声明生成 `<Type>__size()` 过程；按名字后缀识别这类派生入口。
func meta_scope_generated_size_name(name: addr, name_len: u64) -> bool {
  let enough: bool = name_len >= 6;
  if enough == 0 { return 0; }
  let at: u64 = name_len - 6;
  let b0: bool = std_lex.bs_is_byte(name, at, 95);
  let at1: u64 = at + 1;
  let b1: bool = std_lex.bs_is_byte(name, at1, 95);
  let at2: u64 = at + 2;
  let b2: bool = std_lex.bs_is_byte(name, at2, 115);
  let at3: u64 = at + 3;
  let b3: bool = std_lex.bs_is_byte(name, at3, 105);
  let at4: u64 = at + 4;
  let b4: bool = std_lex.bs_is_byte(name, at4, 122);
  let at5: u64 = at + 5;
  let b5: bool = std_lex.bs_is_byte(name, at5, 101);
  let p0: bool = b0 and b1;
  let p1: bool = b2 and b3;
  let p2: bool = b4 and b5;
  let p3: bool = p0 and p1;
  let all: bool = p3 and p2;
  return all;
}

func meta_scope_set_emitted(index: u64, v: u64) -> u32 {
  let e: addr = meta_scope_entry(index);
  let p: addr = e + 48;
  let s: u32 = std_types.meta_cell_put(p, v);
  return 0;
}

// 同一层里两条条目的名字是不是同一个？跨源码比，所以两个地址都要算出来。
func meta_scope_name_eq(index: u64, name_src: u64, name_off: u64, name_len: u64) -> bool {
  let have: u64 = meta_scope_word(index, 16);
  let same_len: bool = have == name_len;
  if same_len == 0 { return 0; }
  let src_a: u64 = meta_scope_word(index, 0);
  let off_a: u64 = meta_scope_word(index, 8);
  let base_a: addr = lain_meta_source_data(src_a);
  let a: addr = base_a + off_a;
  let base_b: addr = lain_meta_source_data(name_src);
  let b: addr = base_b + name_off;
  let eqb: bool = std_types.meta_bytes_equal(a, b, name_len);
  return eqb;
}

// 追加一条。同层重名 → 16；表满 → 17。
func meta_scope_add(level_start: u64, source: u64, name_off: u64, name_len: u64, kind: u64, payload: u64, aux: u64) -> u32 {
  let count: u64 = meta_scope_count();
  let dup: bool = loop d(i: u64 = level_start) {
    let more: bool = i < count;
    if more {
      let same: bool = meta_scope_name_eq(i, source, name_off, name_len);
      if same { break d(1); }
      continue d(i + 1);
    } else {
      break d(0);
    }
  };
  if dup {
    let dsc: addr = lain_meta_scratch_data();
    let d0: u64 = std_types.meta_cell_get_raw(dsc + 1928);
    let d1: u64 = d0 + 1;
    let d2: u32 = std_types.meta_cell_put(dsc + 1928, d1);
    let d3: u32 = std_types.meta_cell_put(dsc + 1936, name_off);
    let f0: u32 = lain_meta_fail(16);
    return 16;
  }
  let scratch: addr = lain_meta_scratch_data();
  let cap: u64 = std_types.meta_cell_get(scratch + 80);
  let full: bool = count >= cap;
  if full {
    let f1: u32 = lain_meta_fail(17);
    return 17;
  }
  let e: addr = meta_scope_entry(count);
  let s0: u32 = std_types.meta_cell_put(e, source);
  let s1: u32 = std_types.meta_cell_put(e + 8, name_off);
  let s2: u32 = std_types.meta_cell_put(e + 16, name_len);
  let s3: u32 = std_types.meta_cell_put(e + 24, kind);
  let s4: u32 = std_types.meta_cell_put(e + 32, payload);
  let s5: u32 = std_types.meta_cell_put(e + 40, aux);
  let s6: u32 = std_types.meta_cell_put(e + 48, 0);
  let new: u64 = count + 1;
  let scratch2: addr = lain_meta_scratch_data();
  let s7: u32 = std_types.meta_cell_put(scratch2 + 88, new);
  return 0;
}

// 按名字找，从表尾往前（最内层优先）。返回条目下标；没有返回 NOT_FOUND。
func meta_scope_find(name_addr: addr, name_len: u64) -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let root: u64 = std_types.meta_cell_get(scratch + 96);
  let current: u64 = std_types.meta_cell_get(scratch + 104);
  let count: u64 = meta_scope_count();
  let found: u64 = loop s(i: u64 = count) {
    let more: bool = i > 0;
    if more {
      let k: u64 = i - 1;
      let src: u64 = meta_scope_word(k, 0);
      let mine: bool = src == current;
      let rooted: bool = src == root;
      let visible: bool = mine or rooted;
      let off: u64 = meta_scope_word(k, 8);
      let p: addr = meta_scope_name_at(src, off);
      let have: u64 = meta_scope_word(k, 16);
      let sf3: u64 = std_types.meta_cell_get(p);
      let same_len: bool = have == name_len;
      let eqb: bool = std_types.meta_bytes_equal(p, name_addr, name_len);
      let hit: bool = visible and same_len and eqb;
      if hit { break s(k); }
      continue s(i - 1);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return found;
}

// 表里有没有这份源码的条目？——用来判断「这个模块扫过了没有」。
func meta_scope_has_source(source: u64) -> bool {
  let count: u64 = meta_scope_count();
  let found: bool = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let src: u64 = meta_scope_word(i, 0);
      let same: bool = src == source;
      if same { break s(1); }
      continue s(i + 1);
    } else {
      break s(0);
    }
  };
  return found;
}

// 进出一份源码的作用域。链是 [root, 当前]，所以只需要存一个「当前」。
func meta_scope_enter(source: u64) -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let old: u64 = std_types.meta_cell_get(scratch + 104);
  let s1: u32 = std_types.meta_cell_put(scratch + 104, source);
  return old;
}

func meta_scope_set_current(source: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let s1: u32 = std_types.meta_cell_put(scratch + 104, source);
  return 0;
}

func meta_scope_name_at(source: u64, off: u64) -> addr {
  let base: addr = lain_meta_source_data(source);
  let p: addr = base + off;
  return p;
}

// --- 预扫一份源码的顶层形式 -------------------------------------------------

// 名字节点跟在关键字后面。
func meta_scope_name_of(parent: u64, index: u64) -> u64 {
  let n_i: u64 = index + 1;
  let count: u64 = std_parse.ast_child_count(parent);
  let has: bool = n_i < count;
  if has == 0 { return 0; }
  return std_parse.ast_child(parent, n_i);
}

// `struct X { ... }` / `enum X { ... }`：payload 记声明自己的节点。
func meta_scope_add_decl(base: addr, len: u64, source: u64, level_start: u64, parent: u64, index: u64, kind: u64) -> u32 {
  let node: u64 = std_parse.ast_child(parent, index);
  let name_node: u64 = meta_scope_name_of(parent, index);
  let n_lo: u64 = std_parse.meta_node_start(name_node);
  let n_len: u64 = std_parse.meta_node_len(name_node);
  let st: u32 = meta_scope_add(level_start, source, n_lo, n_len, kind, node, parent);
  let added: bool = st == 0;
  if added {
    let count: u64 = meta_scope_count();
    let last: u64 = count - 1;
    let stored: u32 = meta_scope_set_emitted(last, index);
  }
  return st;
}

// `let NAME = <初始化式>`：payload 记初始化式那个节点。
func meta_scope_add_let(base: addr, len: u64, source: u64, level_start: u64, parent: u64, index: u64) -> u32 {
  let node: u64 = std_parse.ast_child(parent, index);
  let name_node: u64 = meta_scope_name_of(parent, index);
  let n_lo: u64 = std_parse.meta_node_start(name_node);
  let n_len: u64 = std_parse.meta_node_len(name_node);
  let count: u64 = std_parse.ast_child_count(parent);
  let tail_i: u64 = index + 2;
  let eq_i: u64 = loop findeq(j: u64 = tail_i) {
    let jmore: bool = j < count;
    if jmore {
      let jk: u64 = std_parse.ast_child(parent, j);
      let jhit: bool = std_parse.meta_node_is_word(jk, base, std_lex.meta_kw_eq, 1);
      if jhit { break findeq(j); }
      continue findeq(j + 1);
    } else {
      break findeq(index);
    }
  };
  let rhs_i: u64 = eq_i + 1;
  let rhs_room: bool = rhs_i < count;
  let rhs: u64 = if rhs_room { std_parse.ast_child(parent, rhs_i) } else { 0 };
  let gone: bool = rhs == 0;
  if gone {
    let a: u32 = meta_scope_add(level_start, source, n_lo, n_len, 3, 0, 0);
    return a;
  }
  let is_import: bool = std_parse.meta_node_is_word(rhs, base, std_modules.meta_kw_import, 6);
  if is_import {
    let grp_i: u64 = rhs_i + 1;
    let grp_room: bool = grp_i < count;
    let grp: u64 = if grp_room { std_parse.ast_child(parent, grp_i) } else { 0 };
    let str: u64 = std_parse.meta_node_child(grp);
    let st_off: u64 = std_parse.meta_node_start(str);
    let lp: u64 = st_off + 1;
    let lp_len: u64 = meta_logical_len_of(str);
    let path: addr = base + lp;
    let idx: u64 = std_modules.meta_source_find(path, lp_len);
    let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
    if miss {
      let f: u32 = lain_meta_fail(11);
      return 11;
    }
    let b: u32 = meta_scope_add(level_start, source, n_lo, n_len, 1, idx, lp);
    return b;
  }
  let rhs_lo: u64 = std_parse.meta_node_start(rhs);
  let tbl_b: u8 = std_lex.bs_byte_at(base, rhs_lo, len);
  let tbl_w: u32 = tbl_b as u32;
  let tbl_v: bool = tbl_w == 91;
  if tbl_v == 0 {
    let cp: u32 = meta_scope_add(level_start, source, n_lo, n_len, 3, rhs, 0);
    return cp;
  }
  let tc: u64 = std_handlers_let.meta_table_count(base, len, rhs);
  let tt: u64 = std_handlers_let.meta_table_elt_esz(base, len, parent, tail_i, eq_i);
  let ta: u32 = meta_scope_add(level_start, source, n_lo, n_len, 3, rhs, tc);
  let tok: bool = ta == 0;
  if tok == 0 { return ta; }
  let cnt2: u64 = meta_scope_count();
  let last2: u64 = cnt2 - 1;
  let se: u32 = meta_scope_set_emitted(last2, tt);
  return 0;
}

// `"std::math"` 这个节点里，引号之间有多少字节。
func meta_logical_len_of(str: u64) -> u64 {
  let n: u64 = std_parse.meta_node_len(str);
  let two: u64 = n - 2;
  return two;
}

// 预扫顶层形式，把绑定记进表。level_start 是本次那一层的起点。
func meta_scope_scan(base: addr, len: u64, source: u64, level_start: u64) -> u32 {
  let root: u64 = std_parse.meta_root_of(source);
  let s: u32 = meta_scope_scan_root(base, len, source, level_start, root);
  return s;
}

// 候选根尚未发布时也可登记声明；调用方负责联合提交或恢复作用域表。
func meta_scope_scan_root(base: addr, len: u64, source: u64, level_start: u64, root: u64) -> u32 {
  let count: u64 = std_parse.ast_child_count(root);
  let ss0: addr = lain_meta_scratch_data();
  let sso: u64 = source * 32;
  let ssa: u64 = sso + 1540;
  let ssp0: u32 = std_types.meta_cell_put(ss0 + ssa, count);
  let ssb: u64 = sso + 1548;
  let ssp1: u32 = std_types.meta_cell_put(ss0 + ssb, root);
  let ssc: u64 = sso + 1556;
  let ssp2: u32 = std_types.meta_cell_put(ss0 + ssc, 1);
  let esc: addr = lain_meta_scratch_data();
  let es0: u32 = std_types.meta_cell_put(esc + 1984, source);
  let en0: u64 = std_types.meta_cell_get_raw(esc + 1992);
  let en1: u64 = en0 + 1;
  let es1: u32 = std_types.meta_cell_put(esc + 1992, en1);
  let first_i: u64 = 0 + 0;
  let st: u32 = loop forms(i: u64 = 0) {
    let more: bool = i < count;
    if more == 0 { break forms(0); }
    let node: u64 = std_parse.ast_child(root, i);
    let here: u64 = std_parse.meta_node_start(node);
    let handler: u64 = std_syntax.meta_syntax_lookup(node, 1, level_start, 1);
    let is_macro: bool = handler == 11;
    let any: bool = (handler != 0) and (is_macro == 0);
    if any == 0 {
      let is_first: bool = (i == first_i) and (handler == 0);
      if is_first {
        let f: u32 = lain_meta_fail(4);
        break forms(4);
      }
      continue forms(i + 1);
    }
    let qsc: addr = lain_meta_scratch_data();
    let qs0: u32 = std_types.meta_cell_put(qsc + 1960, source);
    let qs1: u32 = std_types.meta_cell_put(qsc + 1968, i);
    let qn0: u64 = std_types.meta_cell_get_raw(qsc + 1976);
    let qn1: u64 = qn0 + 1;
    let qs2: u32 = std_types.meta_cell_put(qsc + 1976, qn1);
    let d: u32 = std_declarations.meta_declare_invoke(handler, base, len, source, level_start, root, i);
    if d != 0 { break forms(d); }
    continue forms(i + 1);
  };
  let sdc: addr = lain_meta_scratch_data();
  let sdt: u64 = st as u64;
  let sda: u32 = std_types.meta_cell_put(sdc + 1944, sdt);
  let sdb: u64 = meta_scope_count();
  let sdd: u32 = std_types.meta_cell_put(sdc + 1952, sdb);
  return st;
}

// --- 查类型 ---------------------------------------------------------------

// 名字 → 声明类型（struct/enum）的类型 id；查不到或不是类型返回 NOT_FOUND。
func meta_scope_type_id(name_addr: addr, name_len: u64) -> u64 {
  let i: u64 = meta_scope_find(name_addr, name_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss { return 0xFFFFFFFFFFFFFFFF; }
  let kind: u64 = meta_scope_kind(i);
  let is_struct_type: bool = kind == 4;
  let is_sum_type: bool = kind == 5;
  if is_struct_type { return std_records.meta_record_type_id(i); }
  if is_sum_type { return std_sums.meta_sum_type_id(i); }
  return 0xFFFFFFFFFFFFFFFF;
}

// AstOut 与候选声明索引联合发布。备份旧条目及两个可见链控制格。
func meta_commit_decl_candidate(source: u64, old_root: u64, new_root: u64, tx: u64, syntax_mark: u64) -> u32 {
  let mark: u64 = meta_bump_mark();
  let count: u64 = meta_scope_count();
  let bytes: u64 = count * 56;
  let off: u64 = meta_bump_alloc(bytes);
  if off == 0xFFFFFFFFFFFFFFFF {
    let rb0: u32 = lain_meta_ast_tx_rollback(tx);
    let s0: u32 = std_syntax.meta_syntax_state_put(8, syntax_mark);
    return 17;
  }
  let scratch: addr = lain_meta_scratch_data();
  let backup: addr = scratch + off;
  let base_off: u64 = std_types.meta_cell_get(scratch + 72);
  let table: addr = scratch + base_off;
  let old_env: u64 = std_types.meta_cell_get(scratch + 96);
  let old_current: u64 = std_types.meta_cell_get(scratch + 104);
  let copied: u32 = loop save(i: u64 = 0) {
    let smore: bool = i < bytes;
    if smore {
      let sv: u64 = std_types.meta_cell_get(table + i);
      let sw: u32 = std_types.meta_cell_put(backup + i, sv);
      continue save(i + 8);
    } else {
      break save(0);
    }
  };
  let clear: u32 = meta_scope_release(0);
  let set_env: u32 = std_types.meta_cell_put(scratch + 96, 0xFFFFFFFFFFFFFFFF);
  let level: u64 = meta_scope_count();
  let set_current: u32 = meta_scope_set_current(source);
  let base: addr = lain_meta_source_data(source);
  let len: u64 = lain_meta_source_length(source);
  let candidate: u32 = meta_scope_scan_root(base, len, source, level, new_root);
  let body_phase: u32 = if candidate == 0 { std_types.meta_cell_put_raw(std_expand.meta_expand_decl_phase, 0) } else { 0 };
  let final_root: u64 = if candidate == 0 { std_expand.meta_expand_root(new_root) } else { 0 };
  let dependency: u64 = if (candidate == 0) and (final_root == 0) { std_expand.meta_expand_defer_get() } else { 0 };
  let host: u64 = if (candidate == 0) and (final_root == 0) and (dependency == 0) { lain_meta_status() } else { 0 };
  let commit_v: u32 = if (candidate == 0) and (final_root != 0) { lain_meta_ast_commit(source, old_root, final_root, tx) } else { 0 };
  let status: u32 = loop pick(s: u32 = 0) {
    if candidate != 0 { break pick(candidate); }
    if final_root != 0 { break pick(commit_v); }
    if dependency != 0 { break pick(9411); }
    break pick(host as u32);
  };
  if status != 0 {
    let restored: u32 = loop restore(i: u64 = 0) {
      let rmore: bool = i < bytes;
      if rmore {
        let rv: u64 = std_types.meta_cell_get(backup + i);
        let rw: u32 = std_types.meta_cell_put(table + i, rv);
        continue restore(i + 8);
      } else {
        break restore(0);
      }
    };
    let tail: u64 = meta_scope_count();
    let cleared: u32 = loop clear_tail(i: u64 = count) {
      let cmore: bool = i < tail;
      if cmore {
        let entry: addr = meta_scope_entry(i);
        let zeroed: u32 = loop zero(j: u64 = 0) {
          let jmore: bool = j < 56;
          if jmore {
            let zw: u32 = std_types.meta_cell_put(entry + j, 0);
            continue zero(j + 8);
          } else {
            break zero(0);
          }
        };
        continue clear_tail(i + 1);
      } else {
        break clear_tail(0);
      }
    };
    let old_count: u32 = meta_scope_release(count);
    let env: u32 = std_types.meta_cell_put(scratch + 96, old_env);
    let current: u32 = std_types.meta_cell_put(scratch + 104, old_current);
    let syntax: u32 = std_syntax.meta_syntax_state_put(8, syntax_mark);
    let rb: u32 = lain_meta_ast_tx_rollback(tx);
    let deferred: u64 = std_expand.meta_expand_defer_get();
    if deferred == 0 {
      let fail: u32 = lain_meta_fail(status);
    }
    let release: u32 = meta_bump_release(mark);
    return status;
  }
  let release_ok: u32 = meta_bump_release(mark);
  return 0;
}
