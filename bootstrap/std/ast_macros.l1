// Library macro helpers and probes, using generic RawAst capabilities.
#extern #proc ast_copy(#addr %node) -> #addr;
#extern #proc ast_count_atom(#addr %source, #addr %node, #addr %text, #bits<64> %len) -> #bits<64>;
#extern #proc ast_find_atom(
  #addr %source, #addr %parent, #addr %text, #bits<64> %length
) -> #addr;
#extern #proc ast_find_parent(#addr %root, #addr %node) -> #addr;
#extern #proc ast_from_text(#addr %source, #bits<64> %start, #bits<64> %length) -> #addr;
#extern #proc ast_is_atom(#addr %source, #addr %node, #addr %text, #bits<64> %length) -> #bits<1>;
#extern #proc ast_is_postfix_group(#addr %node) -> #bits<1>;
#extern #proc ast_node_count(#addr %root) -> #bits<64>;
#extern #proc ast_postfix_args(#addr %node) -> #addr;
#extern #proc ast_remove_child(#addr %parent, #addr %child) -> #bits<1>;
#extern #proc ast_rename_in(
  #addr %source, #addr %node, #addr %text, #bits<64> %len, #addr %fresh
) -> #bits<64>;
#extern #proc ast_replace_child(
  #addr %parent, #addr %old_child, #addr %new_child
) -> #bits<1>;
#extern #proc ast_span_equal(
  #addr %source, #addr %node, #addr %text, #bits<64> %length
) -> #bits<1>;
#extern #proc ast_substitute(
  #addr %source,
  #addr %node,
  #addr %ph,
  #bits<64> %plen,
  #addr %arg_tree
) -> #unit;
#extern #proc ast_write(#addr %source, #addr %node) -> #unit;
#extern #proc ast_write_decimal(#bits<64> %value) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc bootstrap.artifact-write-byte(#bits<8> %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(#addr %text) -> #unit;
#extern #proc bootstrap.release-pages(#addr %memory) -> #unit;
#extern #proc bootstrap.source-count() -> #bits<64>;
#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc raw_dump_bytes(#addr %data, #bits<64> %start, #bits<64> %length) -> #unit;
#extern #proc raw_is_nil(#addr %node) -> #bits<1>;
#extern #proc raw_node_first(#addr %node) -> #addr;
#extern #proc raw_node_length(#addr %node) -> #bits<64>;
#extern #proc raw_node_next(#addr %node) -> #addr;
#extern #proc raw_node_nil() -> #addr;
#extern #proc raw_node_start(#addr %node) -> #bits<64>;
#extern #proc raw_parse(#addr %source, #addr %tokens) -> #addr;
#extern #proc raw_syntax_context_append(
  #addr %context, #addr %text, #bits<64> %length
) -> #bits<64>;
#extern #proc raw_syntax_context_fresh_atom(
  #addr %context, #addr %text, #bits<64> %length, #bits<32> %token_kind
) -> #addr;
#extern #proc raw_syntax_context_new() -> #addr;
#extern #proc raw_syntax_context_release(#addr %context) -> #unit;
#extern #proc raw_syntax_context_source(#addr %context) -> #addr;
#extern #proc tool_lex_all(#addr %source) -> #addr;
#extern #proc tool_source_data(#addr %source) -> #addr;
#extern #proc tool_source_new(#addr %data, #bits<64> %length) -> #addr;


// Macro-instantiation probe.  Fixture:
//   let y = twice(21);
//   let t = (x + x);
// "twice" is treated as a macro whose expansion template is the
// parenthesised body of `let t = <template>;`.  The probe:
//   1. finds the `twice(21)` call and parses its argument (21) into an AST;
//   2. finds the template group after `let t = ` and parses it into an AST;
//   3. replaces every `x` placeholder in the template with a copy of the
//      argument subtree (macro instantiation);
//   4. writes the instantiated template back as text.
// Output line: tmpl:<text> args:<count> first_x:<0|1> inst:<text>
#proc lain_macro_expand_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // 1. Find the `twice(21)` call and the template group.
  #let %child: #addr = #call raw_node_first(%root)
  #let %call: #addr = #call raw_node_nil()
  #let %template: #addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
        %call: #addr = %child
      }
    }
    // Template: `let t = (x + x);` — after `t` and `=` is the group.
    #if #eq(#call ast_is_atom(%source, %child, "t", 1), 1) {
      #let %eq: #addr = #call raw_node_next(%child)
      #if #eq(#call raw_is_nil(%eq), 0) {
        #if #eq(#call ast_is_atom(%source, %eq, "=", 1), 1) {
          %template: #addr = #call raw_node_next(%eq)
        }
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // 2. Argument subtree: parse `twice(`'s first argument span.
  #let %args: #addr = #call ast_postfix_args(%call)
  #let %first_arg: #addr = #call raw_node_first(%args)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  #call bootstrap.artifact-write-literal(" tmpl:")
  #call ast_write(%source, %template)
  #call bootstrap.artifact-write-literal(" args:")
  #call ast_write_decimal(#call ast_node_count(%arg_tree))
  // 3. Instantiate: replace each `x` placeholder in the template group
  //    with a copy of the argument subtree.
  #let %x1: #addr = #call ast_find_atom(%source, %template, "x", 1)
  #let %found_x: #bits<1> = 0
  #if #eq(#call raw_is_nil(%x1), 0) {
    #call ast_replace_child(%template, %x1, #call ast_copy(%arg_tree))
    %found_x: #bits<1> = 1
  }
  #let %x2: #addr = #call ast_find_atom(%source, %template, "x", 1)
  #if #eq(#call raw_is_nil(%x2), 0) {
    #call ast_replace_child(%template, %x2, #call ast_copy(%arg_tree))
  }
  #call bootstrap.artifact-write-literal(" first_x:")
  #call ast_write_decimal(#zext[#bits<64>](%found_x))
  // 4. Write the instantiated template.
  #call bootstrap.artifact-write-literal(" inst:")
  #call ast_write(%source, %template)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Macro-declaration probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// The probe recognises `let NAME = macro(PARAM) { TEMPLATE };`, extracts
// the macro name, parameter and template group, finds the call site,
// substitutes the argument for the parameter in the template and writes
// the expansion back.
// Output: name:<m> param:<p> tmpl:<t> arg:<a> inst:<expanded>
#proc lain_macro_decl_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Walk top-level: the declaration is `let twice = macro (x) { ... };`
  // parsed as: let, twice, =, macro, (x), { ... }, ;
  // `macro` is an atom followed by its parameter group `(x)`; the template
  // brace group follows that.  Find the `macro` atom.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #let %call: #addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      } else {
        #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
          %call: #addr = %child
        }
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // Parameter group is the sibling after `macro`.
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  // Template brace group follows the parameter group.
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  // Macro name: `let` NAME `=` `macro` -> two siblings before macro_atom.
  #let %name: #addr = #call raw_node_nil()
  #let %scan: #addr = #call raw_node_first(%root)
  #loop find_name {
    #if #call raw_is_nil(%scan) { #break find_name }
    #if #eq(#call raw_node_next(%scan), %macro_atom) {
      // scan is `=`; two before it is the name.
      %name: #addr = #call raw_node_nil()
      #let %scan2: #addr = #call raw_node_first(%root)
      #loop find_name2 {
        #if #call raw_is_nil(%scan2) { #break find_name2 }
        #if #eq(#call raw_node_next(%scan2), %scan) {
          %name: #addr = %scan2
          #break find_name2
        }
        %scan2: #addr = #call raw_node_next(%scan2)
        #continue find_name2
      }
      #break find_name
    }
    %scan: #addr = #call raw_node_next(%scan)
    #continue find_name
  }
  // Macro parameter: first child of the parameter group (the atom `x`).
  #let %param: #addr = #call raw_node_first(%param_group)
  // Template body: the brace group `{ (x + x) }`'s first child is the
  // inner paren group `(x + x)` — substitute inside it.
  #let %body: #addr = #call raw_node_first(%template_brace)
  // Call argument: first child of twice(...)'s arg group (the atom `21`).
  #let %call_arg: #addr = #call raw_node_first(
    #call ast_postfix_args(%call)
  )
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Output fields.
  #call bootstrap.artifact-write-literal(" name:")
  #call raw_dump_bytes(
    %data, #call raw_node_start(%name), #call raw_node_length(%name)
  )
  #call bootstrap.artifact-write-literal(" param:")
  #call raw_dump_bytes(
    %data, #call raw_node_start(%param), #call raw_node_length(%param)
  )
  #call bootstrap.artifact-write-literal(" tmpl:")
  #call ast_write(%source, %body)
  #call bootstrap.artifact-write-literal(" arg:")
  #call ast_write(%source, %arg_tree)
  // Instantiate: replace every atom whose text equals the param inside the
  // template body with a copy of the argument subtree.  Two explicit
  // passes cover `x + x` without a substitution loop.
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  #let %hit1: #addr = #call raw_node_nil()
  #let %c2: #addr = #call raw_node_first(%body)
  #loop find_in_body1 {
    #if #call raw_is_nil(%c2) { #break find_in_body1 }
    #if #eq(
      #call ast_span_equal(
        %source, %c2,
        #lea(base=%pdata, idx=%pstart, scale=1, offset=0),
        %plen
      ),
      1
    ) {
      %hit1: #addr = %c2
      #break find_in_body1
    }
    %c2: #addr = #call raw_node_next(%c2)
    #continue find_in_body1
  }
  #if #eq(#call raw_is_nil(%hit1), 0) {
    #call ast_replace_child(%body, %hit1, #call ast_copy(%arg_tree))
  }
  #let %hit2: #addr = #call raw_node_nil()
  #let %c3: #addr = #call raw_node_first(%body)
  #loop find_in_body2 {
    #if #call raw_is_nil(%c3) { #break find_in_body2 }
    #if #eq(
      #call ast_span_equal(
        %source, %c3,
        #lea(base=%pdata, idx=%pstart, scale=1, offset=0),
        %plen
      ),
      1
    ) {
      %hit2: #addr = %c3
      #break find_in_body2
    }
    %c3: #addr = #call raw_node_next(%c3)
    #continue find_in_body2
  }
  #if #eq(#call raw_is_nil(%hit2), 0) {
    #call ast_replace_child(%body, %hit2, #call ast_copy(%arg_tree))
  }
  #call bootstrap.artifact-write-literal(" inst:")
  #call ast_write(%source, %body)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Program-level macro expansion probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// The probe recognises the macro declaration, removes it from the tree,
// then replaces the call site `twice(21)` with the expanded template
// `(21 + 21)` inside the tree, and writes the whole program back.
// Output: prog:<full program text with the call expanded>
#proc lain_macro_program_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Find the `macro` atom; its parameter group and template brace are the
  // next two siblings; the declaration spans from `let` to `;`.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #let %call_name: #addr = #call raw_node_nil()
  #let %call_group: #addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      } else {
        #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
          %call_name: #addr = %child
          %call_group: #addr = #call raw_node_next(%child)
        }
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // Template body: brace group after the parameter group.
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = #call raw_node_first(%template_brace)
  // Macro parameter text.
  #let %param: #addr = #call raw_node_first(%param_group)
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  // Call argument subtree.
  #let %call_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Substitute both placeholders in the template body.
  #let %hit1: #addr = #call raw_node_nil()
  #let %c2: #addr = #call raw_node_first(%body)
  #loop find1 {
    #if #call raw_is_nil(%c2) { #break find1 }
    #if #eq(#call ast_span_equal(%source, %c2, #lea(base=%pdata, idx=%pstart, scale=1, offset=0), %plen), 1) {
      %hit1: #addr = %c2
      #break find1
    }
    %c2: #addr = #call raw_node_next(%c2)
    #continue find1
  }
  #if #eq(#call raw_is_nil(%hit1), 0) {
    #call ast_replace_child(%body, %hit1, #call ast_copy(%arg_tree))
  }
  #let %hit2: #addr = #call raw_node_nil()
  #let %c3: #addr = #call raw_node_first(%body)
  #loop find2 {
    #if #call raw_is_nil(%c3) { #break find2 }
    #if #eq(#call ast_span_equal(%source, %c3, #lea(base=%pdata, idx=%pstart, scale=1, offset=0), %plen), 1) {
      %hit2: #addr = %c3
      #break find2
    }
    %c3: #addr = #call raw_node_next(%c3)
    #continue find2
  }
  #if #eq(#call raw_is_nil(%hit2), 0) {
    #call ast_replace_child(%body, %hit2, #call ast_copy(%arg_tree))
  }
  // The expanded template subtree now replaces the call site: first remove
  // the call's arg group, then replace the call name atom with a copy of
  // the expanded body (keeping the declaration's own template intact).
  #call ast_remove_child(%root, %call_group)
  #call ast_replace_child(%root, %call_name, #call ast_copy(%body))
  // Remove the macro declaration: the first seven root children are
  // `let` `twice` `=` `macro` `(x)` `{template}` `;`.  Remove them in
  // order by repeatedly deleting the first root child.
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Find the next macro call site in the root's sibling chain: a postfix
// group whose name atom's text equals `text` (length `len`).  Returns the
// name atom, or nil when none remains.  Single loop, no nesting.
#proc ast_find_macro_call(
  #addr %source, #addr %root, #addr %text, #bits<64> %len
) -> #addr {
  #let %c: #addr = #call raw_node_first(%root)
  #loop scan {
    #if #call raw_is_nil(%c) { #break scan }
    #if #eq(#call ast_is_postfix_group(%c), 1) {
      #if #eq(#call ast_span_equal(%source, %c, %text, %len), 1) {
        #return %c
      }
    }
    %c: #addr = #call raw_node_next(%c)
    #continue scan
  }
  #return #call raw_node_nil()
}


// Depth-first search for a macro call site anywhere in the tree: a
// postfix group whose name atom's text equals `text`.  Recurses into
// group children so calls nested inside expanded templates are found.
#proc ast_find_macro_call_deep(
  #addr %source, #addr %node, #addr %text, #bits<64> %len
) -> #addr {
  #if #call raw_is_nil(%node) { #return #call raw_node_nil() }
  #if #eq(#call ast_is_postfix_group(%node), 1) {
    #if #eq(#call ast_span_equal(%source, %node, %text, %len), 1) {
      #return %node
    }
  }
  #let %child: #addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #let %hit: #addr = #call ast_find_macro_call_deep(%source, %child, %text, %len)
    #if #eq(#call raw_is_nil(%hit), 0) { #return %hit }
    %child: #addr = #call raw_node_next(%child)
    #continue children
  }
  #return #call raw_node_nil()
}


// Expand one macro call site in place.  call_name is the name atom of the
// call (`twice`), call_group its argument group `(args)`.  The template
// body (a group like `(x + x)`) has every atom matching the macro
// parameter's text replaced by a copy of the argument subtree, then the
// call's arg group is removed and the call name atom is replaced by the
// expanded body.  This mutates the sibling chain under the call's parent.
#proc ast_expand_macro_call(
  #addr %source,
  #addr %root,
  #addr %call_name,
  #addr %call_group,
  #addr %body_template,
  #addr %param
) -> #unit {
  // Argument subtree from the call's first arg.
  #let %call_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Parameter span for placeholder matching.
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  // Work on a copy of the template so each expansion starts fresh.
  #let %body: #addr = #call ast_copy(%body_template)
  // Replace every placeholder (deep search handles placeholders nested
  // inside groups like `(inc(x))`).
  #let %ph: #addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
  #call ast_substitute(%source, %body, %ph, %plen, %arg_tree)
  // Splice the expansion into the call site: find the call's parent
  // (it may be nested inside a group), replace the name atom there (the
  // expansion takes over the name's next link, which is the arg group),
  // then remove the now-dangling arg group.
  #let %parent: #addr = #call ast_find_parent(%root, %call_name)
  #if #eq(#call raw_is_nil(%parent), 0) {
    #call ast_replace_child(%parent, %call_name, %body)
    #call ast_remove_child(%parent, %call_group)
  }
  #return
}


// Multi-call-site macro expansion probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let a = twice(21);
//   let b = twice(5);
//   let c = twice(1);
// End offset of the argument expression starting at atom `node` inside a
// group: scan siblings until a top-level comma or the group end.  Returns
// the end offset of the last expression atom.
#proc ast_arg_expr_end(#addr %source, #addr %node) -> #bits<64> {
  #let %cur: #addr = %node
  #let %end: #bits<64> = #add(
    #call raw_node_start(%cur), #call raw_node_length(%cur)
  )
  #let %scanning: #bits<1> = 1
  #loop scan {
    #if #eq(%scanning, 0) { #break scan }
    #let %nxt: #addr = #call raw_node_next(%cur)
    #if #eq(#call raw_is_nil(%nxt), 0) {
      #if #eq(#call ast_is_atom(%source, %nxt, ",", 1), 1) {
        %scanning: #bits<1> = 0
      } else {
        %cur: #addr = %nxt
        %end: #bits<64> = #add(
          #call raw_node_start(%cur), #call raw_node_length(%cur)
        )
      }
    } else {
      %scanning: #bits<1> = 0
    }
    #continue scan
  }
  #return %end
}


// Replace every parameter placeholder in `body` with the corresponding
// argument subtree.  Both groups are `atom , atom , ...` sibling chains
// (the comma is an atom whose text is ",").  Positions pair up:
// param[0] -> arg[0], param[1] -> arg[1], etc.  An argument may be a
// whole expression (`2 * 3`), so its span runs to the next comma.  Uses
// ast_substitute for each pair so nested placeholders are replaced too.
#proc ast_substitute_params(
  #addr %source,
  #addr %body,
  #addr %param_group,
  #addr %arg_group
) -> #unit {
  #let %p: #addr = #call raw_node_first(%param_group)
  #let %a: #addr = #call raw_node_first(%arg_group)
  #let %done: #bits<1> = 0
  #loop pairs {
    #if #eq(%done, 1) { #break pairs }
    #if #eq(#call raw_is_nil(%p), 0) {
      #if #eq(#call raw_is_nil(%a), 0) {
        // p is a param atom, a is the first atom of the matching argument.
        #let %pdata: #addr = #call tool_source_data(%source)
        #let %plen: #bits<64> = #call raw_node_length(%p)
        #let %pstart: #bits<64> = #call raw_node_start(%p)
        #let %ph: #addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
        #let %aend: #bits<64> = #call ast_arg_expr_end(%source, %a)
        #let %arg_tree: #addr = #call ast_from_text(
          %source,
          #call raw_node_start(%a),
          #sub(%aend, #call raw_node_start(%a))
        )
        #call ast_substitute(%source, %body, %ph, %plen, %arg_tree)
        // Advance p past any comma, then a past its whole expression and
        // the following comma.
        #let %pn: #addr = #call raw_node_next(%p)
        #if #eq(#call raw_is_nil(%pn), 0) {
          #if #eq(#call ast_is_atom(%source, %pn, ",", 1), 1) {
            %p: #addr = #call raw_node_next(%pn)
          } else {
            %p: #addr = %pn
          }
        } else {
          %p: #addr = %pn
        }
        // Move a to the next argument: walk to the node whose end equals
        // aend, then take its next (the comma) and skip it.
        #let %an: #addr = %a
        #let %a_done: #bits<1> = 0
        #loop advance_a {
          #if #eq(%a_done, 1) { #break advance_a }
          #if #eq(#call raw_is_nil(%an), 0) {
            #if #eq(
              #add(#call raw_node_start(%an), #call raw_node_length(%an)),
              %aend
            ) {
              %an: #addr = #call raw_node_next(%an)
              %a_done: #bits<1> = 1
            } else {
              %an: #addr = #call raw_node_next(%an)
            }
          } else {
            %a_done: #bits<1> = 1
          }
          #continue advance_a
        }
        #if #eq(#call raw_is_nil(%an), 0) {
          #if #eq(#call ast_is_atom(%source, %an, ",", 1), 1) {
            %a: #addr = #call raw_node_next(%an)
          } else {
            %a: #addr = %an
          }
        } else {
          %a: #addr = %an
        }
      } else {
        %done: #bits<1> = 1
      }
    } else {
      %done: #bits<1> = 1
    }
    #continue pairs
  }
  #return
}


// Multi-parameter macro expansion probe.  Fixture:
//   let add = macro(x, y) { (x + y) };
//   let z = add(3, 4);
// The probe recognises the declaration, removes it, expands the call by
// substituting each parameter with its matching argument, and writes the
// program back.
// Output: prog:<rewritten program>
#proc lain_macro_multi_param_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = #call raw_node_first(%template_brace)
  // Locate the call site `add(3, 4)`.
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "add", 3)
  #let %call_group: #addr = #call raw_node_next(%call_name)
  // Remove the declaration (7 top-level nodes).
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Expand: substitute params with args, then replace the call site.
  #let %expanded_body: #addr = #call ast_copy(%body)
  #call ast_substitute_params(%source, %expanded_body, %param_group, %call_group)
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Multi-call-site macro expansion probe (one macro name, many calls).
#proc lain_macro_multi_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Find the macro declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_top
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body_template: #addr = #call raw_node_first(%template_brace)
  #let %param: #addr = #call raw_node_first(%param_group)
  // Expand every call site whose name is `twice`.
  #let %expanded: #bits<64> = 0
  #let %scanning: #bits<1> = 1
  #loop expand_all {
    #if #eq(%scanning, 0) { #break expand_all }
    #let %name_node: #addr = #call ast_find_macro_call(
      %source, %root, "twice", 5
    )
    #if #eq(#call raw_is_nil(%name_node), 0) {
      #let %group_node: #addr = #call raw_node_next(%name_node)
      #call ast_expand_macro_call(
        %source, %root, %name_node, %group_node, %body_template, %param
      )
      %expanded: #bits<64> = #add(%expanded, 1)
    } else {
      %scanning: #bits<1> = 0
    }
    #continue expand_all
  }
  // Remove the macro declaration (first seven root children).
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-literal(" expanded:")
  #call ast_write_decimal(%expanded)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Find the template info for macro `name` (length `len`) in the root's
// sibling chain: returns the parameter atom of the matching declaration,
// or nil.  The template brace is its next sibling, the body is inside it.
// Assumes the declaration shape `let NAME = macro(P) { BODY };`.
#proc ast_macro_param(#addr %source, #addr %root, #addr %text, #bits<64> %len) -> #addr {
  #let %c: #addr = #call raw_node_first(%root)
  #loop scan {
    #if #call raw_is_nil(%c) { #break scan }
    #if #eq(#call ast_is_postfix_group(%c), 1) {
      #if #eq(#call ast_span_equal(%source, %c, %text, %len), 1) {
        // c is the NAME atom of `let NAME = macro(P) {...}`; the macro
        // atom and its param group follow the `=`.
        #return %c
      }
    }
    %c: #addr = #call raw_node_next(%c)
    #continue scan
  }
  #return #call raw_node_nil()
}


// Nested macro expansion probe.  Fixture:
//   let inc = macro(x) { (x + 1) };
//   let twice = macro(x) { (inc(x) + inc(x)) };
//   let y = twice(21);
// Expanding `twice(21)` first yields `(inc(21) + inc(21))`; the loop then
// expands the inner `inc` calls to `(21 + 1)` each.  Expansion repeats
// until no macro call remains, then declarations are removed and the
// whole program is written back.
// Output: prog:<rewritten program> expanded:<count>
#proc lain_macro_nested_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate both declarations by finding each `macro` postfix group.
  // `let NAME = macro (P) {B} ;`: macro's previous sibling is `=`, whose
  // previous sibling is NAME; macro's next is (P), then {B}.
  #let %inc_param: #addr = #call raw_node_nil()
  #let %inc_body: #addr = #call raw_node_nil()
  #let %twice_param: #addr = #call raw_node_nil()
  #let %twice_body: #addr = #call raw_node_nil()
  #let %child: #addr = #call raw_node_first(%root)
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        // NAME is two siblings before macro; (P) and {B} follow it.
        #let %eq_node: #addr = #call raw_node_nil()
        #let %name_node: #addr = #call raw_node_nil()
        #let %scan2: #addr = #call raw_node_first(%root)
        #loop find_eq {
          #if #call raw_is_nil(%scan2) { #break find_eq }
          #if #eq(#call raw_node_next(%scan2), %child) {
            %eq_node: #addr = %scan2
            #break find_eq
          }
          %scan2: #addr = #call raw_node_next(%scan2)
          #continue find_eq
        }
        #let %scan3: #addr = #call raw_node_first(%root)
        #loop find_name {
          #if #call raw_is_nil(%scan3) { #break find_name }
          #if #eq(#call raw_node_next(%scan3), %eq_node) {
            %name_node: #addr = %scan3
            #break find_name
          }
          %scan3: #addr = #call raw_node_next(%scan3)
          #continue find_name
        }
        #let %param_group: #addr = #call raw_node_next(%child)
        #let %brace: #addr = #call raw_node_next(%param_group)
        #if #eq(#call ast_span_equal(%source, %name_node, "inc", 3), 1) {
          %inc_param: #addr = #call raw_node_first(%param_group)
          %inc_body: #addr = #call raw_node_first(%brace)
        }
        #if #eq(#call ast_span_equal(%source, %name_node, "twice", 5), 1) {
          %twice_param: #addr = #call raw_node_first(%param_group)
          %twice_body: #addr = #call raw_node_first(%brace)
        }
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  // Remove both macro declarations before expanding, so deep searches do
  // not mistake template internals for call sites.  Each declaration is
  // 7 top-level nodes (let NAME = macro (P) {B} ;).
  #let %rcount: #bits<64> = 0
  #loop remove_decls {
    #if #sge(%rcount, 14) { #break remove_decls }
    #let %rfirst: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%rfirst), 0) {
      #call ast_remove_child(%root, %rfirst)
    }
    %rcount: #bits<64> = #add(%rcount, 1)
    #continue remove_decls
  }
  // Expand every macro call until none remains.  Prefer expanding `inc`
  // (the inner macro) first so `twice` templates containing `inc` are
  // re-scanned after their own expansion.
  #let %expanded: #bits<64> = 0
  #let %scanning: #bits<1> = 1
  #loop expand_all {
    #if #eq(%scanning, 0) { #break expand_all }
    #if #sge(%expanded, 12) { #break expand_all }
    #let %name_node: #addr = #call ast_find_macro_call_deep(
      %source, %root, "inc", 3
    )
    #let %group_node: #addr = #call raw_node_nil()
    #let %param_sel: #addr = %inc_param
    #let %body_sel: #addr = %inc_body
    #if #eq(#call raw_is_nil(%name_node), 0) {
      %group_node: #addr = #call raw_node_next(%name_node)
    } else {
      %name_node: #addr = #call ast_find_macro_call_deep(
        %source, %root, "twice", 5
      )
      %param_sel: #addr = %twice_param
      %body_sel: #addr = %twice_body
      #if #eq(#call raw_is_nil(%name_node), 0) {
        %group_node: #addr = #call raw_node_next(%name_node)
      }
    }
    #if #eq(#call raw_is_nil(%name_node), 0) {
      #call ast_expand_macro_call(
        %source, %root, %name_node, %group_node, %body_sel, %param_sel
      )
      %expanded: #bits<64> = #add(%expanded, 1)
    } else {
      %scanning: #bits<1> = 0
    }
    #continue expand_all
  }
  // Verify the expansion left no macro calls behind: count residual
  // `twice` / `inc` call sites anywhere in the tree.
  #let %residual: #bits<64> = 0
  #let %rnode: #addr = #call ast_find_macro_call_deep(%source, %root, "inc", 3)
  #if #eq(#call raw_is_nil(%rnode), 0) { %residual: #bits<64> = #add(%residual, 1) }
  #let %rnode2: #addr = #call ast_find_macro_call_deep(%source, %root, "twice", 5)
  #if #eq(#call raw_is_nil(%rnode2), 0) { %residual: #bits<64> = #add(%residual, 1) }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-literal(" expanded:")
  #call ast_write_decimal(%expanded)
  #call bootstrap.artifact-write-literal(" residual:")
  #call ast_write_decimal(%residual)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Integrated AST-ops probe: one run demonstrates the whole mechanism.
// Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// Steps: parse, view the call (ast_is_call/postfix), transform a copy
// (replace first arg), expand the macro call, remove the declaration,
// write the program back and count the result.
// Output: view:<0|1> replaced:<0|1> prog:<text>
#proc lain_ast_all_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // 1. View: find the `twice(21)` call.
  #let %name_node: #addr = #call ast_find_macro_call(%source, %root, "twice", 5)
  #let %view: #bits<1> = 0
  #if #eq(#call raw_is_nil(%name_node), 0) { %view: #bits<1> = 1 }
  // 2. Transform: copy the call's argument group and replace its first
  //    argument with a copy of itself — proves copy+replace on a subtree
  //    without touching the original tree.
  #let %replaced: #bits<1> = 0
  #if #eq(%view, 1) {
    #let %group_node: #addr = #call raw_node_next(%name_node)
    #let %arg_copy: #addr = #call ast_copy(%group_node)
    #let %first_arg: #addr = #call raw_node_first(%arg_copy)
    #if #eq(#call raw_is_nil(%first_arg), 0) {
      #call ast_replace_child(
        %arg_copy, %first_arg, #call ast_copy(%first_arg)
      )
      %replaced: #bits<1> = 1
    }
  }
  // 3. Macro expansion: find and remove the declaration, expand the call.
  #let %macro_atom: #addr = #call ast_find_macro_call(%source, %root, "macro", 5)
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = #call raw_node_first(%template_brace)
  #let %param: #addr = #call raw_node_first(%param_group)
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "twice", 5)
  #if #eq(#call raw_is_nil(%call_name), 0) {
    #let %call_group: #addr = #call raw_node_next(%call_name)
    #call ast_expand_macro_call(
      %source, %root, %call_name, %call_group, %body, %param
    )
  }
  // 4. Remove the declaration (7 top-level nodes) and write back.
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  #call bootstrap.artifact-write-literal("view:")
  #call ast_write_decimal(#zext[#bits<64>](%view))
  #call bootstrap.artifact-write-literal(" replaced:")
  #call ast_write_decimal(#zext[#bits<64>](%replaced))
  #call bootstrap.artifact-write-literal(" prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Compile-integration probe: expand a macro whose template is a bare
// expression, so the expansion is plain Lain the reference compiler can
// compile.  Fixture:
//   let val = macro(x) { x };
//   let y = val(42);
// Expansion yields `let y = 42;`.  The test harness appends a `main` and
// compiles it with the reference lainc, proving macro output is
// compilable Lain, not just parseable.
// Output: prog:<rewritten program>
#proc lain_macro_compile_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = #call raw_node_first(%template_brace)
  #let %param: #addr = #call raw_node_first(%param_group)
  // Locate the call `val(42)`.
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "val", 3)
  #let %call_group: #addr = #call raw_node_next(%call_name)
  // Remove the declaration (7 top-level nodes).
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Expand: the template body is the bare placeholder `x`; substitute
  // the argument, then replace the call site with the expansion.
  #let %expanded_body: #addr = #call ast_copy(%body)
  #let %ph: #addr = #call tool_source_data(%source)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %ph_off: #addr = #lea(base=%ph, idx=%pstart, scale=1, offset=0)
  #let %first_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  // If the whole template body is the placeholder itself (bare `x`),
  // the expansion is just the argument subtree.
  #if #eq(#call ast_is_atom(%source, %body, %ph_off, %plen), 1) {
    %expanded_body: #addr = #call ast_copy(%arg_tree)
  } else {
    #call ast_substitute(%source, %expanded_body, %ph_off, %plen, %arg_tree)
  }
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Self-referential macro probe.  Fixture:
//   let loop = macro(x) { (loop(x)) };
//   let y = loop(1);
// Expanding `loop(1)` yields `(loop(1))`, which contains the macro call
// again — expansion would never terminate.  The probe expands with a
// step bound, detects that a macro call remains after the bound, and
// reports recursive:1 instead of looping forever.
// Output: expanded:<n> recursive:<0|1> residual:<0|1>
#proc lain_macro_recursion_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = #call raw_node_first(%template_brace)
  #let %param: #addr = #call raw_node_first(%param_group)
  // Remove the declaration (7 top-level nodes).
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Expand with a hard step bound; detect non-termination.
  #let %expanded: #bits<64> = 0
  #let %recursive: #bits<1> = 0
  #let %scanning: #bits<1> = 1
  #loop expand_all {
    #if #eq(%scanning, 0) { #break expand_all }
    #if #sge(%expanded, 8) {
      %recursive: #bits<1> = 1
      %scanning: #bits<1> = 0
    } else {
      #let %call_name: #addr = #call ast_find_macro_call_deep(
        %source, %root, "loop", 4
      )
      #if #eq(#call raw_is_nil(%call_name), 0) {
        #let %call_group: #addr = #call raw_node_next(%call_name)
        #call ast_expand_macro_call(
          %source, %root, %call_name, %call_group, %body, %param
        )
        %expanded: #bits<64> = #add(%expanded, 1)
      } else {
        %scanning: #bits<1> = 0
      }
    }
    #continue expand_all
  }
  // Residual: does a `loop` call remain after the bound?
  #let %residual: #bits<1> = 0
  #let %rnode: #addr = #call ast_find_macro_call_deep(%source, %root, "loop", 4)
  #if #eq(#call raw_is_nil(%rnode), 0) { %residual: #bits<1> = 1 }
  #call bootstrap.artifact-write-literal("expanded:")
  #call ast_write_decimal(%expanded)
  #call bootstrap.artifact-write-literal(" recursive:")
  #call ast_write_decimal(#zext[#bits<64>](%recursive))
  #call bootstrap.artifact-write-literal(" residual:")
  #call ast_write_decimal(#zext[#bits<64>](%residual))
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Template-local-binding macro probe.  Fixture:
//   let inc2 = macro(x) { let t = (x + 1); (t + t) };
//   let y = inc2(10);
// The template declares a local `t` bound from the placeholder `x` and
// uses it twice.  Expansion must copy the template (so the local is
// independent per instance), substitute `x` inside the let initialiser
// (deep replacement), and keep `t` as the template's own binding.
// Output: prog:<rewritten program>
#proc lain_macro_let_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  // The template body is the whole brace group (it may contain a
  // statement sequence: `let t = ...; (t + t)`), not just its first
  // child.
  #let %body: #addr = %template_brace
  #let %param: #addr = #call raw_node_first(%param_group)
  // Locate the call `inc2(10)`.
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "inc2", 4)
  #let %call_group: #addr = #call raw_node_next(%call_name)
  // Remove the declaration (7 top-level nodes).
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %first: #addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Expand: copy the template, substitute x -> 10 (deep), replace the
  // call site with the expansion.
  #let %expanded_body: #addr = #call ast_copy(%body)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  #let %ph: #addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
  #let %first_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  #call ast_substitute(%source, %expanded_body, %ph, %plen, %arg_tree)
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Capture-collision probe.  Fixture:
//   let t = 99;
//   let inc2 = macro(x) { let t = (x + 1); (t + t) };
//   let y = inc2(10);
// The template declares a local `t`; the caller also has a top-level
// `t`.  After expansion the expanded program contains both the template
// `t` (bound and used) and the caller's `t`, so `t` appears more than
// once — the probe counts occurrences and reports capture:1 (a hygiene
// hazard).  This is the detection step; fresh-name generation is the
// follow-up.
// Output: t_occurrences:<n> capture:<0|1>
#proc lain_macro_capture_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = %template_brace
  #let %param: #addr = #call raw_node_first(%param_group)
  // Locate the call `inc2(10)`.
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "inc2", 4)
  #let %call_group: #addr = #call raw_node_next(%call_name)
  // Expand (template has a local let binding).
  #let %expanded_body: #addr = #call ast_copy(%body)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  #let %ph: #addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
  #let %first_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  #call ast_substitute(%source, %expanded_body, %ph, %plen, %arg_tree)
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Remove the declaration `let inc2 = macro(x) { ... };` (7 top-level
  // nodes).  It is preceded by `let t = 99;`, so locate its `let` by
  // tracking the previous two children while scanning for the `inc2`
  // atom, then splice out the 7 nodes that follow the node before it.
  #let %before: #addr = #call raw_node_nil()
  #let %prev2: #addr = #call raw_node_nil()
  #let %prev1: #addr = #call raw_node_nil()
  #let %child2: #addr = #call raw_node_first(%root)
  #loop find_decl {
    #if #call raw_is_nil(%child2) { #break find_decl }
    #if #eq(#call ast_is_atom(%source, %child2, "inc2", 4), 1) {
      %before: #addr = %prev2
      #break find_decl
    }
    %prev2: #addr = %prev1
    %prev1: #addr = %child2
    %child2: #addr = #call raw_node_next(%child2)
    #continue find_decl
  }
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %next: #addr = #call raw_node_next(%before)
    #if #eq(#call raw_is_nil(%next), 1) { #break remove_decl }
    #call ast_remove_child(%root, %next)
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Count `t` occurrences in the whole tree after expansion, anchored on
  // the caller's `t` atom (second node of the remaining program):
  //   let t = 99; let y = {let t = (10 + 1); (t + t)};
  // gives 1 (caller decl) + 1 (template decl) + 2 (template uses) = 4.
  #let %td: #addr = #call tool_source_data(%source)
  #let %tdecl_atom: #addr = #call raw_node_next(#call raw_node_first(%root))
  #let %tptr: #addr = #lea(
    base=%td,
    idx=#call raw_node_start(%tdecl_atom),
    scale=1,
    offset=0
  )
  #let %t_occ: #bits<64> = #call ast_count_atom(
    %source, %root, %tptr, #call raw_node_length(%tdecl_atom)
  )
  #call bootstrap.artifact-write-literal("t_occurrences:")
  #call ast_write_decimal(%t_occ)
  #call bootstrap.artifact-write-literal(" capture:")
  #if #sgt(%t_occ, 1) {
    #call bootstrap.artifact-write-literal("1")
  } else {
    #call bootstrap.artifact-write-literal("0")
  }
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}


// Hygiene probe: expand a template whose local `t` collides with a
// caller `t`, then rename the template's `t` atoms (bound and used) to
// a freshly generated `t_1` in a syntax-context-owned text pool.  After renaming, the caller's
// `t` is the only `t` left, the template's local is `t_1`, and the
// expanded program serialises with the generated name:
//   let t = 99; let y = {let t_1 = (10+1); (t_1+t_1)};
// Output:
//   t_occurrences:<n> t1_occurrences:<m> renamed:<r> capture:<0|1>
//   prog:<renamed program>
#proc lain_macro_hygiene_probe() -> #bits<32> {
  #if #eq(#call bootstrap.source-count(), 0) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: #addr = #call raw_node_first(%root)
  #let %macro_atom: #addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: #addr = #call raw_node_next(%macro_atom)
  #let %template_brace: #addr = #call raw_node_next(%param_group)
  #let %body: #addr = %template_brace
  #let %param: #addr = #call raw_node_first(%param_group)
  // Locate the call `inc2(10)`.
  #let %call_name: #addr = #call ast_find_macro_call(%source, %root, "inc2", 4)
  #let %call_group: #addr = #call raw_node_next(%call_name)
  // Expand (template has a local let binding).
  #let %expanded_body: #addr = #call ast_copy(%body)
  #let %pdata: #addr = #call tool_source_data(%source)
  #let %plen: #bits<64> = #call raw_node_length(%param)
  #let %pstart: #bits<64> = #call raw_node_start(%param)
  #let %ph: #addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
  #let %first_arg: #addr = #call raw_node_first(%call_group)
  #let %arg_tree: #addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  #call ast_substitute(%source, %expanded_body, %ph, %plen, %arg_tree)
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Remove the declaration (7 top-level nodes after the `;` before
  // `inc2`), as in the capture probe.
  #let %before: #addr = #call raw_node_nil()
  #let %prev2: #addr = #call raw_node_nil()
  #let %prev1: #addr = #call raw_node_nil()
  #let %child2: #addr = #call raw_node_first(%root)
  #loop find_decl {
    #if #call raw_is_nil(%child2) { #break find_decl }
    #if #eq(#call ast_is_atom(%source, %child2, "inc2", 4), 1) {
      %before: #addr = %prev2
      #break find_decl
    }
    %prev2: #addr = %prev1
    %prev1: #addr = %child2
    %child2: #addr = #call raw_node_next(%child2)
    #continue find_decl
  }
  #let %count: #bits<64> = 0
  #loop remove_decl {
    #if #sge(%count, 7) { #break remove_decl }
    #let %next: #addr = #call raw_node_next(%before)
    #if #eq(#call raw_is_nil(%next), 1) { #break remove_decl }
    #call ast_remove_child(%root, %next)
    %count: #bits<64> = #add(%count, 1)
    #continue remove_decl
  }
  // Materialise the program through the stable syntax-context API: copy the
  // source into its context-owned pool and create a fresh atom there.
  #let %context: #addr = #call raw_syntax_context_new()
  #call raw_syntax_context_append(%context, %data, %length)
  #let %context_source: #addr = #call raw_syntax_context_source(%context)
  #let %fresh: #addr = #call raw_syntax_context_fresh_atom(
    %context, "t_1", 3, 1
  )
  #let %fresh_off: #bits<64> = #call raw_node_start(%fresh)
  // Rename the template's `t` atoms (inside the expanded body) to `t_1`.
  #let %renamed: #bits<64> = #call ast_rename_in(
    %source, %expanded_body, "t", 1, %fresh
  )
  // Count with the pool-backed source: `t` should now be only the
  // caller's binding (1), `t_1` the template's decl plus its two uses (3).
  #let %pool_source: #addr = %context_source
  #let %pool_data: #addr = #call tool_source_data(%context_source)
  #let %tdecl_atom: #addr = #call raw_node_next(#call raw_node_first(%root))
  #let %tptr: #addr = #lea(
    base=%pool_data,
    idx=#call raw_node_start(%tdecl_atom),
    scale=1,
    offset=0
  )
  #let %t_occ: #bits<64> = #call ast_count_atom(
    %pool_source, %root, %tptr, #call raw_node_length(%tdecl_atom)
  )
  #let %t1ptr: #addr = #lea(base=%pool_data, idx=%fresh_off, scale=1, offset=0)
  #let %t1_occ: #bits<64> = #call ast_count_atom(%pool_source, %root, %t1ptr, 3)
  #call bootstrap.artifact-write-literal("t_occurrences:")
  #call ast_write_decimal(%t_occ)
  #call bootstrap.artifact-write-literal(" t1_occurrences:")
  #call ast_write_decimal(%t1_occ)
  #call bootstrap.artifact-write-literal(" renamed:")
  #call ast_write_decimal(%renamed)
  #call bootstrap.artifact-write-literal(" capture:")
  #if #sgt(%t_occ, 1) {
    #call bootstrap.artifact-write-literal("1")
  } else {
    #call bootstrap.artifact-write-literal("0")
  }
  #call bootstrap.artifact-write-literal(" prog:")
  #call ast_write(%pool_source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call raw_syntax_context_release(%context)
  #call bootstrap.release-pages(%source)
  #return %status
}


// ---------------------------------------------------------------------------
// #eval bridge to AST values.
//
// `#eval` is the LAIN-IR compile-time execution boundary: the block runs
// in the seed interpreter during compilation.  Its result type is the
// enclosing subroutine's return type, so a proc returning `#addr` can hand
// an AST value (a RawAst root built at compile time) back to the meta
// layer, which then consumes it with the ordinary AST views.  This is the
// "return AST data" leg of the roadmap's #eval flow
// (scalar / module / type / AST data).
// ---------------------------------------------------------------------------

// Worker: parse the source span [start, start+len) into a fresh,
// independent AST *inside* an #eval block and return its root address.
#proc lain_macro_eval_ast_worker(#addr %source, #bits<64> %start, #bits<64> %len) -> #addr {
  #let %root: #addr = #eval {
    #return #call ast_from_text(%source, %start, %len)
  }
  #return %root
}


// Probe.  Fixture: `let x = foo(1, 2);`.  Locates the `foo(1,2)` call,
// bridges its span through #eval into an AST value, and consumes that
// value with the AST views (node count + text round trip).
// Output: eval_ast:<nodes> eval_text:<written span>
#proc lain_macro_eval_ast_probe() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %root: #addr = #call raw_parse(%source, %tokens)
  #let %status: #bits<32> = 0
  #call bootstrap.artifact-begin()
  // Locate the `foo(1,2)` call site.
  #let %child: #addr = #call raw_node_first(%root)
  #let %call_name: #addr = #call raw_node_nil()
  #loop scan_root {
    #if #call raw_is_nil(%child) { #break scan_root }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "foo", 3), 1) {
        %call_name: #addr = %child
      }
    }
    %child: #addr = #call raw_node_next(%child)
    #continue scan_root
  }
  // Bridge: build the call's AST at compile time via #eval and consume
  // the returned address with the AST views.  The span covers the whole
  // call: from the `foo` name through the closing paren of the group.
  #let %call_group: #addr = #call raw_node_next(%call_name)
  #let %call_end: #bits<64> = #add(
    #call raw_node_start(%call_group), #call raw_node_length(%call_group)
  )
  #let %call_span: #bits<64> = #sub(%call_end, #call raw_node_start(%call_name))
  #let %ast: #addr = #call lain_macro_eval_ast_worker(
    %source,
    #call raw_node_start(%call_name),
    %call_span
  )
  #call bootstrap.artifact-write-literal("eval_ast:")
  #call ast_write_decimal(#call ast_node_count(%ast))
  #call bootstrap.artifact-write-literal(" eval_text:")
  #call ast_write(%source, %ast)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}
