// 模块：和类型（tag、载荷、投影）。跨单元引用一律写 `别名.名字`。
//
// 和积类型同源（都是 align_up 累加出来的布局），多出来的只有**判别字段**：
//
//   tag     `#bits<8>`，偏移 0
//   载荷区  从 align_up(tag 大小, 最大align 值) 开始，所有变体共用
//   总大小  align_up(载荷区起点 + 最大载荷, 最大align 值)
//
// v0 限制：每个变体最多一个载荷字段（`Circle(i32)`），且 tag 固定 `#bits<8>`。
//
// 正文起点**从符号表取**（`meta_scope_body`），不回源码里搜——条目里存的就是
// 那条 enum 声明的节点。
//
// 打包字段：tag 0..7、kind 8..11、width 12..19、size 20..51、align 52..55、
// 命中位 63；各段不相交，拼装用 or。
//
// 本单元没有静态块；跨单元的数据符号用 symbol_addr("NAME_storage") 取址。
let meta = import("../meta");
let std_emit = import("emit");
let std_funcs = import("funcs");
let std_lainir = import("lainir");
let std_lex = import("lex");
let std_parse = import("parse");
let std_records = import("records");
let std_registry = import("registry");
let std_scalars = import("scalars");
let std_scope = import("scope");
let std_types = import("types");

// 宿主能力。
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_data(index: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(index: u64) -> u64 = lain_meta_source_length;
extern lain_meta_status() -> u64 = lain_meta_status;

// 这个类型名是不是 enum？用来区分积类型的字段访问和和类型的投影。
//
// **只查作用域表**：条目里就写着这个名字是哪一种声明，不用去看它的正文。
func meta_is_enum(src: addr, len: u64, name_lo: u64, name_hi: u64) -> bool {
  let name: addr = src + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let i: u64 = std_scope.meta_scope_find(name, name_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0;
  }
  let kind: u64 = std_scope.meta_scope_kind(i);
  let is: bool = kind == 5;
  return is;
}

// 走一遍变体，找 var_lo/var_hi 那一个，同时把最大载荷大小/align 值写进 scratch。
//   返回 packed：tag 0..7、kind 8..11、width 12..19、size 20..51、align 52..55、
//   命中 63。
//   没命中返回 0。v0 假设变体列表良构（名字后面可选 `(类型)`）。
func meta_enum_walk(src: addr, len: u64, body: u64, var_lo: u64, var_hi: u64, scratch: addr) -> u64 {
  let r: u64 = loop vars(at: u64 = body, tag: u64 = 0, maxsz: u64 = 0, maxal: u64 = 1, hit: u64 = 0) {
    let here: u64 = std_lex.bs_skip_space(src, at, len);
    let byte: u8 = std_lex.bs_byte_at(src, here, len);
    let byte_w: u32 = byte as u32;
    let is_close: bool = byte_w == 125;
    if is_close {
      let s: u32 = meta_store_scratch(scratch, maxsz, maxal);
      break vars(hit);
    }
    let name_hi: u64 = std_lex.bs_skip_ident(src, here, len);
    let paren: u64 = std_lex.bs_skip_space(src, name_hi, len);
    let pb: u8 = std_lex.bs_byte_at(src, paren, len);
    let pb_w: u32 = pb as u32;
    let has_payload: bool = pb_w == 40;
    // 有载荷就读类型名，算大小/align 值；没有的话下面直接用字面量。
    if has_payload {
      let one: u64 = paren + 1;
      let t_lo: u64 = std_lex.bs_skip_space(src, one, len);
      let t_hi: u64 = std_lex.bs_skip_qualified(src, t_lo, len);
      let tid: u64 = std_scalars.meta_type_resolve(src, len, t_lo, t_hi);
      // 同 records.l1：解析不出来是错，不是「大小 0」。报宿主状态通道。
      let bad_type: bool = tid == 0;
      if bad_type {
        let f: u32 = lain_meta_fail(5);
        let st0: u32 = meta_store_scratch(scratch, maxsz, maxal);
        break vars(0);
      }
      let tinfo: u64 = std_registry.meta_tid_repr(tid);
      let k: u64 = tinfo and 255;
      let w: u64 = (tinfo >> 8) and 255;
      let sz: u64 = std_registry.meta_tid_size(tid);
      let al: u64 = std_registry.meta_tid_align(tid);
      let close: u64 = std_lex.bs_skip_space(src, t_hi, len);
      let after2: u64 = close + 1;
      // 名字匹配？
      let want: u64 = var_hi - var_lo;
      let have: u64 = name_hi - here;
      let len_ok: bool = want == have;
      // 只有 len_ok 成立才求 a / b / eq。
      let mine: bool = loop pick_mine(t: bool = 0) {
        if len_ok {
          let a: addr = src + here;
          let b: addr = src + var_lo;
          let eq: bool = std_types.meta_bytes_equal(a, b, want);
          break pick_mine(eq);
        }
        break pick_mine(0);
      };
      let packed: u64 = meta_pack_variant(tag, k, w, sz, al);
      let new_hit: u64 = if mine { packed } else { hit };
      let bigsz: bool = sz > maxsz;
      let nsz: u64 = if bigsz { sz } else { maxsz };
      let bigal: bool = al > maxal;
      let nal: u64 = if bigal { al } else { maxal };
      let tag2: u64 = tag + 1;
      continue vars(after2, tag2, nsz, nal, new_hit);
    }
    // 没有载荷
    let want2: u64 = var_hi - var_lo;
    let have2: u64 = name_hi - here;
    let len_ok2: bool = want2 == have2;
    let mine2: bool = loop pick_mine2(t: bool = 0) {
      if len_ok2 {
        let a2: addr = src + here;
        let b2: addr = src + var_lo;
        let eq2: bool = std_types.meta_bytes_equal(a2, b2, want2);
        break pick_mine2(eq2);
      }
      break pick_mine2(0);
    };
    let packed2: u64 = meta_pack_variant(tag, 0, 0, 0, 1);
    let hit2: u64 = if mine2 { packed2 } else { hit };
    let tag3: u64 = tag + 1;
    continue vars(paren, tag3, maxsz, maxal, hit2);
  };
  return r;
}

// 把 (tag, kind, width, size, align) 打包；命中位置最高位。
func meta_pack_variant(tag: u64, kind: u64, width: u64, size: u64, align: u64) -> u64 {
  let a: u64 = tag or (kind << 8);
  let b: u64 = a or (width << 12);
  let c: u64 = b or (size << 20);
  let d: u64 = c or (align << 52);
  let e: u64 = d or 0x8000000000000000;
  return e;
}

// 把最大载荷大小/align 值写进 scratch+0 / scratch+8。
func meta_store_scratch(scratch: addr, maxsz: u64, maxal: u64) -> u32 {
  store(scratch, maxsz);
  let p: addr = scratch + 8;
  store(p, maxal);
  return 0;
}

func meta_scratch_max_size(scratch: addr) -> u64 {
  let v: u64 = load(scratch);
  return v;
}

func meta_scratch_max_align(scratch: addr) -> u64 {
  let p: addr = scratch + 8;
  let v: u64 = load(p);
  return v;
}

// 载荷区起点 = align_up(tag 大小=1, 最大align 值)
func meta_enum_payload_off(scratch: addr) -> u64 {
  let al: u64 = meta_scratch_max_align(scratch);
  let off: u64 = std_lex.bs_align_up(1, al);
  return off;
}

// 总大小 = align_up(载荷起点 + 最大载荷, 最大align 值)
func meta_enum_size(scratch: addr) -> u64 {
  let al: u64 = meta_scratch_max_align(scratch);
  let off: u64 = meta_enum_payload_off(scratch);
  let sz: u64 = meta_scratch_max_size(scratch);
  let sum: u64 = off + sz;
  let total: u64 = std_lex.bs_align_up(sum, al);
  return total;
}

// 和类型的名义类型 ID。布局复用已验证的变体扫描与最大载荷规则。
// restore_top / release 在返回之前无条件执行，所以用一次性选择循环 pick_id。
func meta_sum_type_id(index: u64) -> u64 {
  let src: u64 = std_scope.meta_scope_word(index, 0);
  let len: u64 = lain_meta_source_length(src);
  let base: addr = lain_meta_source_data(src);
  let node: u64 = std_scope.meta_scope_decl_node(index);
  let pos: u64 = std_parse.meta_node_start(node);
  let src1: u64 = src + 1;
  let high: u64 = src1 << 32;
  // src1 占高 32 位、pos + 1 占低 32 位，位域不相交，or 与加法等价。
  let owner: u64 = high or (pos + 1);
  let scratch: addr = lain_meta_scratch_data();
  let registered: u64 = std_registry.meta_reg_lookup(scratch, 2, owner, 0);
  if registered != 0 { return registered; }
  let top: u64 = std_types.meta_cell_get(scratch + 456);
  let cycle: bool = loop active_sum(link: u64 = top) {
    if link == 0 { break active_sum(0); }
    let entry: addr = scratch + link;
    let active_owner: u64 = std_types.meta_cell_get(entry);
    if active_owner == owner { break active_sum(1); }
    let previous: u64 = std_types.meta_cell_get(entry + 8);
    continue active_sum(previous);
  };
  if cycle {
    let set_cycle: u32 = std_types.meta_cell_put(scratch + 464, 1);
    let fail: u32 = lain_meta_fail(5);
    return 0;
  }
  let mark: u64 = std_scope.meta_bump_mark();
  let frame: u64 = std_scope.meta_bump_alloc(16);
  if frame == 0xFFFFFFFFFFFFFFFF { return 0; }
  let frame_addr: addr = scratch + frame;
  let save_owner: u32 = std_types.meta_cell_put(frame_addr, owner);
  let save_previous: u32 = std_types.meta_cell_put(frame_addr + 8, top);
  let push: u32 = std_types.meta_cell_put(scratch + 456, frame);
  let body: u64 = std_records.meta_decl_body(base, node);
  let walk: u64 = meta_enum_walk(base, len, body, 0, 0, frame_addr);
  let walk_status: u64 = lain_meta_status();
  let walk_failed: bool = walk_status != 0;
  let max_size: u64 = meta_scratch_max_size(frame_addr);
  let max_align: u64 = meta_scratch_max_align(frame_addr);
  let payload_off: u64 = std_records.meta_layout_field_align_up_checked(1, max_align);
  let payload_end: u64 = std_records.meta_layout_add_checked(payload_off, max_size);
  let total: u64 = std_records.meta_layout_field_align_up_checked(payload_end, max_align);
  // 1 位值上的按位 or 与逻辑 or 同义。
  let invalid: bool = (payload_off == 0xFFFFFFFFFFFFFFFF) or (payload_end == 0xFFFFFFFFFFFFFFFF);
  let invalid1: bool = invalid or (total == 0xFFFFFFFFFFFFFFFF);
  let invalid2: bool = invalid1 or walk_failed;
  // invalid2 为假才 meta_intern；为真先看递归标记再回 0。
  // 末尾的 restore / release 在循环之后执行。
  let id: u64 = loop pick_id(t: u64 = 0) {
    if invalid2 {
      let recursive: u64 = std_types.meta_cell_get(scratch + 464);
      if recursive == 0 {
        let fail2: u32 = lain_meta_fail(5);
      }
      break pick_id(0);
    }
    let new_id: u64 = std_registry.meta_intern(2, owner, 0, total, max_align);
    break pick_id(new_id);
  };
  let restore: u32 = std_types.meta_cell_put(scratch + 456, top);
  let release: u32 = std_scope.meta_bump_release(mark);
  return id;
}

// --- 构造与投影 -----------------------------------------------------------
//
// `let c = Shape.Circle { 7 }` 和积类型的构造同形：一块静态存储 + 一条 tag 存
// + 一条载荷存。区别只在于「字段偏移」换成了「变体 tag + 载荷偏移」。
//
// `let v: i32 = Shape.Circle(c)` 没有积类型的对应物：积类型的字段访问是**一条
// `#load`**（偏移编译期就知道，字段一定在），和类型的投影要**先看判别字段**
// ——别的变体也有那块载荷区。v0 把不命中折叠成 0（全函数），不做 panic 路径。

// 走一遍声明，拿到变体的 tag/载荷形状；返回 0 表示没有这个变体。
func meta_sum_variant(base: addr, len: u64, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64, scratch: addr) -> u64 {
  // 正文起点**问符号表**（条目里存的是声明节点），不回源码里搜
  let body: u64 = std_records.meta_scope_body(base, enum_lo, enum_hi, 5);
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    return 0;
  }
  let w: u64 = meta_enum_walk(base, len, body, var_lo, var_hi, scratch);
  return w;
}

// `let NAME = Enum.Variant { 值 }`
func meta_lower_sum_construct(base: addr, len: u64, bind_lo: u64, bind_hi: u64, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64, brace_at: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let info: u64 = meta_sum_variant(base, len, enum_lo, enum_hi, var_lo, var_hi, scratch);
  let bit: u64 = info >> 63;
  let found: bool = bit == 1;
  if found == 0 {
    let f: u32 = lain_meta_fail(9);
    return 9;
  }
  let tag: u64 = info and 255;
  let kind: u64 = (info >> 8) and 15;
  let width: u64 = (info >> 12) and 255;
  let psize: u64 = (info >> 20) and 0xFFFFFFFF;
  let poff: u64 = meta_enum_payload_off(scratch);
  let total: u64 = meta_enum_size(scratch);
  let bind_at: addr = base + bind_lo;
  let bind_len: u64 = bind_hi - bind_lo;
  // 顶层绑定的符号名是 `<模块键>__<名字>`，数据块是 `<键>__<名字>_storage`。
  let pbuf: addr = std_scope.meta_path_buf();
  let sym: u64 = std_scope.meta_unit_symbol(pbuf, bind_at, bind_len);

  let w1: u32 = std_lainir.lainir_data_head();
  let w2: u32 = std_lainir.lainir_write(pbuf, sym);
  let w3: u32 = std_lainir.lainir_data_rw_head();
  let w4: u32 = std_records.meta_emit_zeros(total);
  let w5: u32 = std_lainir.lainir_proc_head_open();

  let w6: u32 = std_lainir.lainir_write(pbuf, sym);
  let w7: u32 = std_lainir.lainir_addr_body_write();
  let w8: u32 = std_lainir.lainir_base_assign_write();
  let w9: u32 = std_lainir.lainir_write(pbuf, sym);
  let w10: u32 = std_lainir.lainir_storage_suffix_write();

  // tag 是 `#bits<8>`，在偏移 0——这是 v0 的固定选择，不从声明读。
  let s1: u32 = std_records.meta_emit_store(0, 8, tag, 0, 0xFFFFFFFFFFFFFFFF);

  // 有载荷才发第二条 store。空变体（`Empty`）只有 tag。
  let has_payload: bool = psize > 0;
  let s2: u32 = if has_payload {
    let raw_lo: u64 = brace_at + 1;
    let v_lo: u64 = std_lex.bs_skip_space(base, raw_lo, len);
    let value: u64 = std_lex.bs_read_uint(base, v_lo, len);
    let s: u32 = std_records.meta_emit_store(kind, width, value, poff, 0xFFFFFFFFFFFFFFFF);
    s
  } else {
    0
  };

  let w11: u32 = std_lainir.lainir_return_base_close();
  return s2;
}

// `let s: Shape = Shape.Circle { k };`（函数体里）：从 **stack** 上划一块（`#alloca`），
// tag 一条 store、载荷一条 store，绑定接 `%NAME = #lea(%r<n>, 0, 1, 0)`。与顶层那条
// `meta_lower_sum_construct`（静态 storage 加一条取址 proc）的区别就在这里。
//
// 载荷是**一条表达式**（`{ k }` 里那个 `k`），按操作数降级 —— 不按源码数字读，
// 所以函数参数与局部值都能当载荷。
func meta_lower_sum_construct_local(base: addr, len: u64, name_lo: u64, name_hi: u64, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64, parent: u64, group: u64, is_ret: bool) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let info: u64 = meta_sum_variant(base, len, enum_lo, enum_hi, var_lo, var_hi, scratch);
  let bit: u64 = info >> 63;
  let found: bool = bit == 1;
  if found == 0 {
    // 没有这个变体名
    let fnf: u32 = lain_meta_fail(9);
    return 9;
  }
  let tag: u64 = info and 255;
  let kind: u64 = (info >> 8) and 15;
  let width: u64 = (info >> 12) and 255;
  let psize: u64 = (info >> 20) and 0xFFFFFFFF;
  let poff: u64 = meta_enum_payload_off(scratch);
  let total: u64 = meta_enum_size(scratch);
  let zero: bool = total == 0;
  if zero {
    // 没有可划的框：count 为 0 的 `#alloca` 被验证器拒（2024）
    let fz: u32 = lain_meta_fail(5);
    return 5;
  }
  let n: u64 = std_funcs.meta_next_temp();
  let a1: u32 = std_lainir.lainir_alloca_at(n, 8, total);
  // tag 固定在偏移 0：v0 的固定选择，不从声明读
  let t1: u32 = std_records.meta_emit_store(0, 8, tag, 0, n);
  let has_payload: bool = psize > 0;
  // 一次性选择循环：has_payload 为假取 0；为真才按顺序求 operand_emit（错码即带出）、
  // 缓冲区、meta_render_ref2（%vbad 即带出 4）、meta_emit_store_text。
  let t2: u32 = loop pick_t2(t: u32 = 0) {
    if has_payload {
      let ast: u32 = meta.meta_operand_emit(base, len, kind, width, 0, 0, parent, group);
      let abad: bool = ast != 0;
      if abad { break pick_t2(ast); }
      let sc2: addr = lain_meta_scratch_data();
      let pref: u64 = std_types.meta_cell_get(sc2 + 168);
      let plo: u64 = std_types.meta_cell_get(sc2 + 176);
      let phi: u64 = std_types.meta_cell_get(sc2 + 184);
      let vbuf: addr = std_lainir.lainir_text_buffer;
      let vlen: u64 = meta.meta_render_ref2(base, len, pref, plo, phi, vbuf);
      let vbad: bool = vlen == 0xFFFFFFFFFFFFFFFF;
      if vbad { break pick_t2(4); }
      let w: u32 = std_records.meta_emit_store_text(kind, width, vbuf, vlen, poff, n);
      break pick_t2(w);
    }
    break pick_t2(0);
  };
  let tb: bool = t2 != 0;
  if tb {
    return t2;
  }
  let tail: u32 = if is_ret {
    let rbuf: addr = std_lainir.lainir_text_buffer;
    let rlen: u64 = std_lainir.lainir_buf_temp(rbuf, 0, n);
    let w10: u32 = std_lainir.lainir_return_ref(rbuf, rlen);
    0
  } else {
    let buf2: addr = std_lainir.lainir_text_buffer;
    let tbuf: addr = buf2 + 64;
    let tlen2: u64 = std_lainir.lainir_buf_temp(tbuf, 0, n);
    let nbuf: addr = buf2 + 128;
    let npct: u64 = std_lainir.lainir_buf_byte(nbuf, 0, 37);
    let bind_at: addr = base + name_lo;
    let bind_len: u64 = name_hi - name_lo;
    let nlen: u64 = std_lainir.lainir_buf_bytes(nbuf, npct, bind_at, bind_len);
    let zbuf: addr = buf2 + 180;
    let zlen: u64 = std_lainir.lainir_buf_uint(zbuf, 0, 0);
    let w17: u32 = std_lainir.lainir_lea_named(nbuf, nlen, tbuf, tlen2, zbuf, zlen, 1, 0);
    0
  };
  return tail;
}

// `let NAME: T = Enum.Variant(值)`：读 tag、比、命中才读载荷。
func meta_lower_sum_project(base: addr, len: u64, bind_lo: u64, bind_hi: u64, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64, at: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let info: u64 = meta_sum_variant(base, len, enum_lo, enum_hi, var_lo, var_hi, scratch);
  let bit: u64 = info >> 63;
  let found: bool = bit == 1;
  if found == 0 {
    let f2: u32 = lain_meta_fail(9);
    return 9;
  }
  let tag: u64 = info and 255;
  let kind: u64 = (info >> 8) and 15;
  let width: u64 = (info >> 12) and 255;
  let psize: u64 = (info >> 20) and 0xFFFFFFFF;
  let empty: bool = psize == 0;
  if empty {
    // 空变体没有载荷可投——这是错的输入，不是「0」。
    let f: u32 = lain_meta_fail(10);
    return 10;
  }
  let poff: u64 = meta_enum_payload_off(scratch);
  let one: u64 = at + 1;
  let v_lo: u64 = std_lex.bs_skip_space(base, one, len);
  let v_hi: u64 = std_lex.bs_skip_ident(base, v_lo, len);
  let bind_at: addr = base + bind_lo;
  let bind_len: u64 = bind_hi - bind_lo;
  let var_at: addr = base + v_lo;
  let var_len: u64 = v_hi - v_lo;

  let w1: u32 = std_lainir.lainir_proc_word_write();
  let w2: u32 = std_lainir.lainir_write(bind_at, bind_len);
  let w3: u32 = std_lainir.lainir_empty_params_write();
  let w4: u32 = std_lainir.lainir_repr(kind, width);
  let w5: u32 = std_lainir.lainir_bind_head_write();
  let w6: u32 = std_lainir.lainir_write(var_at, var_len);

  let w7: u32 = std_lainir.lainir_vproj_load_write();
  let w8: u32 = std_lainir.lainir_emit_uint(tag);
  let w9: u32 = std_lainir.lainir_vproj_if_write();
  let w10: u32 = std_lainir.lainir_repr(kind, width);
  let w11: u32 = std_lainir.lainir_vproj_lea_write();
  let w12: u32 = std_lainir.lainir_emit_uint(poff);
  let w13: u32 = std_lainir.lainir_vproj_value_write();
  let w14: u32 = std_lainir.lainir_repr(kind, width);
  let w15: u32 = std_lainir.lainir_vproj_tail_write();
  return 0;
}

// `Enum.Variant(值)` 当值（函数体内的变体投影）：判别字段读出来与 tag 比，命中才读
// 载荷，不命中回 0 —— v0 把不命中折叠成 0，不做 panic 路径。
//
// 与顶层那条路（`meta_lower_sum_project` 发一整条无名参数的 proc）的区别：这里的值来自
// 参数或局部值，所以发的是**三条指令加一条带值 `#if`**，就写在当前函数体里。
func meta_emit_projection_temp(base: addr, len: u64, parent: u64, index: u64, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let info: u64 = meta_sum_variant(base, len, enum_lo, enum_hi, var_lo, var_hi, scratch);
  let bit: u64 = info >> 63;
  let found: bool = bit == 1;
  if found == 0 {
    // 没有这个变体名
    let fnf: u32 = lain_meta_fail(9);
    return 9;
  }
  let tag: u64 = info and 255;
  let kind: u64 = (info >> 8) and 15;
  let width: u64 = (info >> 12) and 255;
  let psize: u64 = (info >> 20) and 0xFFFFFFFF;
  let empty: bool = psize == 0;
  if empty {
    // 空变体没有载荷可投
    let fe: u32 = lain_meta_fail(10);
    return 10;
  }
  let poff: u64 = meta_enum_payload_off(scratch);
  // 要投影的那个值就是实参组里的那条表达式（`Shape.Circle(s)` 的 `s`）
  let ai: u64 = index + 3;
  let ast: u32 = meta.meta_operand_emit(base, len, 3, 0, 0, 0, parent, ai);
  if ast != 0 {
    return ast;
  }
  let sc: addr = lain_meta_scratch_data();
  let aref: u64 = std_types.meta_cell_get(sc + 168);
  let alo: u64 = std_types.meta_cell_get(sc + 176);
  let ahi: u64 = std_types.meta_cell_get(sc + 184);
  // 缓冲区（`lainir_text_buffer`）：0 起是基址文本、64 起是 tag 的十进制文本、
  // 96 起是载荷地址文本。
  let buf: addr = std_lainir.lainir_text_buffer;
  let blen: u64 = meta.meta_render_ref2(base, len, aref, alo, ahi, buf);
  let bbad: bool = blen == 0xFFFFFFFFFFFFFFFF;
  if bbad {
    return 4;
  }
  let tbuf: addr = buf + 64;
  let tlen: u64 = std_lainir.lainir_buf_uint(tbuf, 0, tag);

  //   %r<t> = #load[#bits<8>](<基址>, 0)
  //   %r<m> = #eq[#bits<8>](%r<t>, <tag>)
  //
  // 判别字段是**从基址读出来的一个字节**，不是基址本身：地址不是位串，拿它去
  // 查位类型的算子表会被验证器按类型不符拒（2005）。
  let tn: u64 = std_funcs.meta_next_temp();
  let l1: u32 = std_lainir.lainir_load_at(tn, 0, 8, buf, blen);
  let tref: addr = buf + 32;
  let tref_len: u64 = std_lainir.lainir_buf_temp(tref, 0, tn);
  let mn: u64 = std_funcs.meta_next_temp();
  let eqn: addr = std_lainir.lainir_eq_name;
  let l2: u32 = std_lainir.lainir_binary_op_at(2, mn, eqn, 2, 0, 8, tref, tref_len, tbuf, tlen);

  //   %r<r> = #if %r<m> -> (<repr>) {
  let rn: u64 = std_funcs.meta_next_temp();
  let h1: u32 = std_lainir.lainir_indent_write();
  let h2: u32 = std_lainir.lainir_temp_name_emit(rn);
  let h4: u32 = std_lainir.lainir_result_sep_write();
  let h5: u32 = std_lainir.lainir_if_head_write();
  let h6: u32 = std_lainir.lainir_temp_name_emit(mn);
  let h7: u32 = std_lainir.lainir_arrow_lp_write();
  let h8: u32 = std_lainir.lainir_repr(kind, width);
  let h9: u32 = std_lainir.lainir_close_paren_write();
  let h10: u32 = std_lainir.lainir_open_body();

  //     %r<p> = #lea(<基址>, 0, 1, <载荷偏移>)
  //     %r<v> = #load[<repr>](%r<p>, 0)
  //     #yield %r<v>
  let pn: u64 = std_funcs.meta_next_temp();
  let zbuf: addr = std_lainir.lainir_zero;
  let l3: u32 = std_lainir.lainir_lea_at_i(4, pn, buf, blen, zbuf, 1, 1, poff);
  let pbuf: addr = buf + 96;
  let plen: u64 = std_lainir.lainir_buf_temp(pbuf, 0, pn);
  let vn: u64 = std_funcs.meta_next_temp();
  let l4: u32 = std_lainir.lainir_load_at_i(4, vn, kind, width, pbuf, plen);
  let y1: u32 = std_lainir.lainir_yield_write();
  let y2: u32 = std_lainir.lainir_temp_name_emit(vn);
  let y3: u32 = std_lainir.lainir_newline_write();

  //   } else {
  //     #yield 0
  //   }
  let e1: u32 = std_lainir.lainir_else_write();
  let e2: u32 = std_lainir.lainir_yield_write();
  let e3: u32 = std_lainir.lainir_zero_write();
  let e4: u32 = std_lainir.lainir_newline_write();
  let e5: u32 = std_lainir.lainir_close_line_write();

  // 结果就是那条 `#if` 的临时值
  let r1: u32 = std_types.meta_cell_put(sc + 168, rn);
  let r2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let r3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return 0;
}

// `Enum.Variant { ... }` 还是 `Enum.Variant(v)`？`at` 是点号之后。
// u8 没有算子表，比较先 as u32。
func meta_lower_sum_access(base: addr, len: u64, bind_lo: u64, bind_hi: u64, enum_lo: u64, enum_hi: u64, at: u64) -> u32 {
  let var_lo: u64 = std_lex.bs_skip_space(base, at, len);
  let var_hi: u64 = std_lex.bs_skip_ident(base, var_lo, len);
  let after: u64 = std_lex.bs_skip_space(base, var_hi, len);
  let b: u8 = std_lex.bs_byte_at(base, after, len);
  let b_w: u32 = b as u32;
  let is_brace: bool = b_w == 123;
  if is_brace {
    let s1: u32 = meta_lower_sum_construct(base, len, bind_lo, bind_hi, enum_lo, enum_hi, var_lo, var_hi, after);
    return s1;
  }
  let s2: u32 = meta_lower_sum_project(base, len, bind_lo, bind_hi, enum_lo, enum_hi, var_lo, var_hi, after);
  return s2;
}

// --- 发射 -----------------------------------------------------------------

// 发一个 `<Enum>__<Variant><后缀>() -> #bits<64> { #return <value> }`
func meta_emit_enum_case(base: addr, enum_lo: u64, enum_hi: u64, var_lo: u64, var_hi: u64, suf: addr, suf_len: u64, value: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let d: addr = std_emit.meta_dsep;
  let e_at: addr = base + enum_lo;
  let e_len: u64 = enum_hi - enum_lo;
  let a1: u64 = std_lainir.lainir_buf_bytes(buf, 0, e_at, e_len);
  let a2: u64 = std_lainir.lainir_buf_bytes(buf, a1, d, 2);
  let v_at: addr = base + var_lo;
  let v_len: u64 = var_hi - var_lo;
  let a3: u64 = std_lainir.lainir_buf_bytes(buf, a2, v_at, v_len);
  let nlen: u64 = std_lainir.lainir_buf_bytes(buf, a3, suf, suf_len);
  let h: u32 = std_lainir.lainir_proc_head_full(buf, nlen, buf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let r: u32 = std_lainir.lainir_return_uint(value);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 逐变体发 `<V>_tag`，有载荷的再发 `<V>_off`。
// u8 比较先转成 u32。
func meta_emit_enum_variants(base: addr, len: u64, enum_lo: u64, enum_hi: u64, body: u64, poff: u64) -> u32 {
  let tag_suf: addr = std_emit.meta_etag;
  let off_suf: addr = std_emit.meta_eoff;
  let st: u32 = loop vars(at: u64 = body, tag: u64 = 0) {
    let here: u64 = std_lex.bs_skip_space(base, at, len);
    let byte: u8 = std_lex.bs_byte_at(base, here, len);
    let byte_w: u32 = byte as u32;
    let is_close: bool = byte_w == 125;
    if is_close {
      break vars(0);
    }
    let name_hi: u64 = std_lex.bs_skip_ident(base, here, len);
    let paren: u64 = std_lex.bs_skip_space(base, name_hi, len);
    let pb: u8 = std_lex.bs_byte_at(base, paren, len);
    let pb_w: u32 = pb as u32;
    let has_payload: bool = pb_w == 40;
    let e1: u32 = meta_emit_enum_case(base, enum_lo, enum_hi, here, name_hi, tag_suf, 4, tag);
    let next: u64 = if has_payload {
      let one: u64 = paren + 1;
      let t_lo: u64 = std_lex.bs_skip_space(base, one, len);
      let t_hi: u64 = std_lex.bs_skip_ident(base, t_lo, len);
      let close: u64 = std_lex.bs_skip_space(base, t_hi, len);
      let past: u64 = close + 1;
      let e2: u32 = meta_emit_enum_case(base, enum_lo, enum_hi, here, name_hi, off_suf, 4, poff);
      past
    } else {
      paren
    };
    let tag2: u64 = tag + 1;
    continue vars(next, tag2);
  };
  return st;
}

// `enum NAME { V1 V2(T) ... }` —— 发出每个变体的 tag、载荷偏移，和总大小。
func meta_lower_enum(base: addr, len: u64, kw_at: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let after: u64 = kw_at + 4;
  let name_lo: u64 = std_lex.bs_skip_space(base, after, len);
  let name_hi: u64 = std_lex.bs_skip_ident(base, name_lo, len);
  let body: u64 = std_records.meta_scope_body(base, name_lo, name_hi, 5);
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    let f0: u32 = lain_meta_fail(4);
    return 4;
  }
  // 第一遍只为把最大载荷大小/align 值算进 scratch（第二个参数给 0 表示不找变体）
  let pass1: u64 = meta_enum_walk(base, len, body, 0, 0, scratch);
  let enum_error: u64 = lain_meta_status();
  let valid: bool = enum_error == 0;
  if valid == 0 {
    let code: u32 = enum_error as u32;
    return code;
  }
  let poff: u64 = meta_enum_payload_off(scratch);
  let size: u64 = meta_enum_size(scratch);
  let s1: u32 = meta_emit_enum_variants(base, len, name_lo, name_hi, body, poff);
  let s2: u32 = meta.meta_emit_size(base, name_lo, name_hi, size);
  return s1;
}
