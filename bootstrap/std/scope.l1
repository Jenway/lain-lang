// 初代标准库 v0 —— 作用域表。
//
// 在这之前，「解析一个名字」的实际动作是**拿名字的字节回源码里搜一段长得像声明
// 的字节**，搜到就用。这里面没有「名字是在哪个范围里被绑定的」这个信息，所以：
//
//   - 搜的是整份文件，没有「内层 / 外层」之分；
//   - 没有一份「这个范围里有哪些名字」的清单，重名无从检测；
//   - 每个使用点都要重搜一遍。
//
// 这个文件补的是**作用域结构**：一张表，条目记「哪个范围的哪个名字是什么」。
//
//   ScopeEntry: source  name_off  name_len  kind  payload  aux  emitted
//
//   kind 1 = 模块引用（import 绑定）  payload = 被 import 的源码下标，aux = 逻辑路径位置
//   kind 2 = 标量类型                 payload = 类型 id（注册表里的身份；0 = 还没查过）
//   kind 3 = 值绑定                   payload = 初始化式的位置
//   kind 4/5/6 = struct/enum/func     payload = 节点，aux = 父组引用，emitted = 组内下标
//
// 查找规则：**从表尾往前找**，也就是「最内层优先，再往外」。表按范围逐层追加，
// 所以「倒着找、第一个命中」天然就是词法作用域的语义。
//
// 重名规则：**只在本层里比**。同一个名字可以在内层重新绑定（遮蔽＝），但不许在
// 同一层绑两次——那是重名，报 16。所以每条条目都带自己那一层的起点。
//
// 层次：外层是 root 环境，内层是被降级的那份源码，被 import 的模块取用时再压一层，
// 用完退掉（mark / release）。root 槽今天恒为 NONE —— 标量是内建表，不由源码扫描填充。
//
// 暂存区分段。**这一段是布局的单一来源**：以前它是按「grep `scratch, N` 看哪些
// 数字出现过」选的偏移，于是两块缓冲区叠在同一段内存上也没人发现。现在每一格
// 都写明归谁。
//
// 宿主给的总额：64 KiB 保底 + 每输入字节 128 字节（`host.c` 的
// `decide_scratch_size`）。
//
//   --- 固定格子（+0..+519）---
//   +0    和类型最大载荷大小       +8    和类型最大对齐
//   +16   命中标量所在源码下标      +24   op 物理名位置
//   +32   op 物理名长度            +40   那份源码长度
//   +48   标量的 repr 位置         +56   全部输入字节数
//   +64   注册表条目容量           +72   作用域表起点（偏移）
//   +80   作用域表条目容量          +88   作用域表条目数
//   +96   root 环境槽（恒 NONE）
//   +104  当前正在降级的源码下标
//   +112  语法树节点区起点（偏移）
//   +120  语法树的节点数
//   +128  每份源码的树根数组起点（偏移）
//   +136  语法树的节点容量
//   +144  降级期的临时值计数器
//   +152  当前 lowering 声明索引（无当前声明 = UINT64_MAX）
//   +160  保留（对齐，8 字节）
//   +168  表达式结果：引用 / 范围起点 / 范围终点 / 终点节点（4 格，meta.l1）
//   +200  bump 分配器当前水位        +208  历史最高水位
//   +216  当前实参块偏移（块本身在动态分配区，每条 24 字节）
//   +224..+255 parse 计数/诊断格        +256..+415 scalar 解析辅助格
//   +416  依赖边表偏移  +424 边/闭包容量  +432 边数
//   +440  闭包表偏移    +448 闭包条数
//   +488  字面量默认类型宽度（scalars.l1）
//   +496  当前实参块条目数             +504  当前函数参数组节点（调用层保存/恢复）
//   +512  注册表条目数             +480 Meta 值环境绑定链表头
//
//   --- 动态区（容量按输入预计算）---
//        注册表每条 64 字节；作用域表每条 56 字节；依赖区每单位容量 24 字节
//        （一条 from/to 边 16 字节 + 一个闭包节点 8 字节）。
//        作用域区下界至少 2560；路径区、语义表在宿主段/根元数据末尾之后。
//        路径缓冲区 352 字节；语义表头 48 字节，条目 72 字节。
//        语义容量 = 全任务源码字节总数 + 8，一次认领，满额拒 17。
//        分配器水位在认领区末尾，AstIn 不占 scratch 的节点或根数组。
//
// **查找只认两份源码：当前这份，和 root 环境那份。**
//
// 命名空间成员被取用时，链是 [root, 那个模块]——**调用方那一层不在链里**。所以
// 「模块内部的绑定能不能看见调用方的绑定」这件事，答案是看不见（那是动态作用域）。
// 用「当前源码 + root」两个条件表达这条链，不需要通用的层级表。
//
// 代价说清楚：这只够表达深度 2 的作用域链。将来要有块级作用域、函数内作用域，
// 就得换成真正的层级表（每层记起点和父层）。

// --- 建表 -----------------------------------------------------------------

// 按模块算容量再定布局。**容量必须来自模块**：声明数上界按最少字节数的声明估
// ——`let a=1;` 是 8 字节，`enum e { a }` 也只有十几个字节。装不下要响（17），
// 不能截断：截断会让「表里没有」和「真的没有」分不开。
#proc meta_scope_setup(%scan: #bits<1>) -> #bits<32> {
  %count = #call lain_meta_source_count()
  %total = #loop sum(%i: #bits<64> = 0, %acc: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %n = #call lain_meta_source_length(%i)
      %acc2 = #add[#bits<64>](%acc, %n)
      %i2 = #add[#bits<64>](%i, 1)
      #continue sum(%i2, %acc2)
    } else {
      #break sum(%acc)
    }
  }
  %scratch = #call lain_meta_scratch_data()
  %size = #call lain_meta_scratch_size()

  %t16 = #udiv[#bits<64>](%total, 16)
  %tcap = #add[#bits<64>](%t16, 8)
  %t8 = #udiv[#bits<64>](%total, 8)
  %scap = #add[#bits<64>](%t8, 8)
  // 每个非根节点至少消耗一个源码字节；根不写旁表，total+8 为容量上界。
  %nodes0_sem = #add[#bits<64>](%total, 8)

  %reg_bytes = #mul[#bits<64>](%tcap, 64)
  %reg_end = #add[#bits<64>](%reg_bytes, 520)
  // 固定格（控制格 + 诊断格）最高用到 +2504 —— 注册表/作用域表区**必须排在它们之后**。
  // 反过来也一样：固定格如果落进**动态表**里就会把表项写坏。实测 `ast_text_len` 的
  // 诊断格 +2264/+2272（记节点引用与宿主地址）正好压在语义旁表第 4 条上（+2256 起），
  // 那一条的「形状」于是读回一个节点引用，`meta_form_at` 判不出形状 → 报 4
  // （`seed/tests/meta_conformance/core_let_spaces.lain` 就是这么挂的）。
  // 所以动态区从 2560 起，固定格全部留在它下面；`520 + %reg_bytes` 太小时抬到这条线
  // （15 字节源码时它会落到 1032，把控制格当数据区压掉 → 作用域表「满」报 17）。
  %ctl_floor = #add[#bits<64>](2504, 56)
  %sc_base = #if #ult[#bits<64>](%reg_end, %ctl_floor) -> (#bits<64>) {
    #yield %ctl_floor
  } else {
    #yield %reg_end
  }
  %sc_bytes = #mul[#bits<64>](%scap, 56)
  // 最坏每个源码字节都开启一条调用引用；每条边 16 字节，宁可预留后按需占用，
  // 也不在降低期间扩容或返回无效依赖表地址。
  %dep_cap = #add[#bits<64>](%total, 8)
  %dep_bytes = #mul[#bits<64>](%dep_cap, 24)
  %dep_base = #add[#bits<64>](%sc_base, %sc_bytes)
  %dep_end = #add[#bits<64>](%dep_base, %dep_bytes)
  // **第一期起暂存区里没有语法树了**：树是宿主在登记源码时建好、驱动只读映射进来的
  // 平铺 AstIn Arena，不占 Meta 一格。跟着一起删掉的还有：节点预留区、每份源码一个
  // 根槽（根引用由宿主写进暂存区头部的段/根表，见 parse.l1 的 meta_root_of）、以及
  // 节点容量格。
  // 动态区从**宿主元数据的末尾**开始：暂存区头部 [0,32) 是 magic/abi/两个计数，
  // 紧随其后是段表与每份源码一个根槽，都是宿主的。Meta 的第一块数据必须排在它们
  // 之后，否则会把根引用表覆盖掉。
  %host_end = #call meta_host_meta_end()
  // 路径/旁表区必须排在**作用域表区之后**：`%sc_base + %sc_bytes`。
  // 原写法是 `%sc_base + 0`，于是路径缓冲区与语义旁表都紧贴作用域表起点，
  // 三层互相覆盖 —— 实测 `sem_base == sc_base == 5384`，旁表 44 条
  // (1408 字节) 正好盖掉作用域表的前 25 个条目槽，`sc_cnt` 因此长期为 0/2。
  %path_at = #add[#bits<64>](%dep_end, 0)
  %ctl_end = #add[#bits<64>](1096, 64)
  %lower = #if #ult[#bits<64>](%path_at, %host_end) -> (#bits<64>) {
    #yield %host_end
  } else {
    #yield %path_at
  }
  %path_at2 = #if #ult[#bits<64>](%lower, %ctl_end) -> (#bits<64>) {
    #yield %ctl_end
  } else {
    #yield %lower
  }
  %path_bytes_ad = #data_addr meta_path_cap
  %path_bytes = #call meta_cell_get(%path_bytes_ad)
  %path_end = #add[#bits<64>](%path_at2, %path_bytes)
  // 语义/类型旁表（lainsemantic）：只由识别 pass 写、按**游标**查（规范 §2.2）。
  // 一条 **72** 字节（父组 + 下标 + 环境 + 作用域 + 上下文 + 绑定 + 形状 + 类型 +
  // 展开），表缓冲区前面还有 **48** 字节表头，所以 容量随输入增长，按 `48 + capacity*72` 一次认领，禁止隐式扩容。
  // 表头紧挨条目区之前，所以条目区起点要往后让 48 字节 —— 不让的话表头会盖在
  // 路径缓冲区上。
  %sem_base = #add[#bits<64>](%path_end, 48)
  %sem_entries = #mul[#bits<64>](%nodes0_sem, 72)
  %need = #add[#bits<64>](%sem_base, %sem_entries)
  %fits = #ule[#bits<64>](%need, %size)
  %r = #if %fits -> (#bits<32>) {
    %s1 = #call meta_cell_put(#lea(%scratch, 56, 1, 0), %total)
    %s2 = #call meta_cell_put(#lea(%scratch, 64, 1, 0), %tcap)
    %s3 = #call meta_cell_put(#lea(%scratch, 72, 1, 0), %sc_base)
    %s4 = #call meta_cell_put(#lea(%scratch, 80, 1, 0), %scap)
    %s5 = #call meta_cell_put(#lea(%scratch, 88, 1, 0), 0)
    %s6 = #call meta_cell_put(#lea(%scratch, 152, 1, 0), 0xFFFFFFFFFFFFFFFF)
    %d0 = #call meta_cell_put(#lea(%scratch, 416, 1, 0), %dep_base)
    %d1 = #call meta_cell_put(#lea(%scratch, 424, 1, 0), %dep_cap)
    %d2 = #call meta_cell_put(#lea(%scratch, 432, 1, 0), 0)
    %closure_base_off = #mul[#bits<64>](%dep_cap, 16)
    %closure_base = #add[#bits<64>](%dep_base, %closure_base_off)
    %d3 = #call meta_cell_put(#lea(%scratch, 440, 1, 0), %closure_base)
    %d4 = #call meta_cell_put(#lea(%scratch, 448, 1, 0), 0)
    // struct 布局递归链顶；节点本身放在 bump 动态区。
    %d5 = #call meta_cell_put(#lea(%scratch, 456, 1, 0), 0)
    %d6 = #call meta_cell_put(#lea(%scratch, 464, 1, 0), 0)
    // wire field_list 临时 record 的单次会话名义 owner 序号。
    %d7 = #call meta_cell_put(#lea(%scratch, 472, 1, 0), 0)
    // Meta 值环境用显式 handle 与名字绑定 wire 值；链表头不与源码 scope 混用。
    %ve = #call meta_cell_put(#lea(%scratch, 480, 1, 0), 0)
    // 分配器的区段 = 固定认领之后剩下的全部。`%need` 正好是认领的末尾（它已经
    // 把树、注册表、作用域表和路径缓冲区都算进去了），所以它就是初始水位。
    // **不写它的话第一次 `meta_bump_alloc` 会从 0 开始**：实参块与 apply 的
    // 请求文本会盖掉宿主的段/根表头与固定格（实测 +208 变成产物文本的 8 个字节，
    // 于是 `lain_meta_scratch_report` 报 38 = 资源发布越界）。
    %bw = #call meta_cell_put(#lea(%scratch, 200, 1, 0), %need)
    %bp = #call meta_cell_put(#lea(%scratch, 208, 1, 0), %need)
    // 「当前实参块」和实参个数也要有个确定的初值（第一次调用前没人写过它们）
    %bq = #call meta_cell_put(#lea(%scratch, 216, 1, 0), 0)
    %bc = #call meta_cell_put(#lea(%scratch, 496, 1, 0), 0)
    %fp = #call meta_cell_put(#lea(%scratch, 504, 1, 0), 0)
    // +1000 语义旁表**条目区**起点（表头就在它前面 48 字节）、+1008 条数、
    // +1056 容量（源码字节数 + 8）。表头由 `meta_sem_init` 按规范 §2.2 写全 —— 它必须在这
    // 两格都写好之后调。
    // **注意**：这批格子写是**必需的初始化**，不是诊断 —— 第 38 轮我用正则批量删探针时
    // 把它一起删掉了（正则里含 `meta_cell_put`，误伤了这里），导致所有控制格读回 0、
    // 旁表全空。现已恢复。
    %t4 = #call meta_cell_put(#lea(%scratch, 1000, 1, 0), %sem_base)
    %z0 = #call meta_cell_put(#lea(%scratch, 1008, 1, 0), 0)
    %z1 = #call meta_cell_put(#lea(%scratch, 1016, 1, 0), 0)
    %z2 = #call meta_cell_put(#lea(%scratch, 1024, 1, 0), 0)
    %z3 = #call meta_cell_put(#lea(%scratch, 1032, 1, 0), 0)
    %z4 = #call meta_cell_put(#lea(%scratch, 1040, 1, 0), 0)
    %z5 = #call meta_cell_put(#lea(%scratch, 1048, 1, 0), 0)
    %c0 = #call meta_cell_put(#lea(%scratch, 1056, 1, 0), %nodes0_sem)
    %c1 = #call meta_cell_put(#lea(%scratch, 1064, 1, 0), %nodes0_sem)
    %c2 = #call meta_cell_put(#lea(%scratch, 1072, 1, 0), %nodes0_sem)
    %c3 = #call meta_cell_put(#lea(%scratch, 1080, 1, 0), %nodes0_sem)
    %c4 = #call meta_cell_put(#lea(%scratch, 1088, 1, 0), %nodes0_sem)
    %c5 = #call meta_cell_put(#lea(%scratch, 1096, 1, 0), %nodes0_sem)
    %semi = #call meta_sem_init()
    // 语法环境与本次 scratch 布局同寿命。scan=0 给 Expand 使用；提交新 Root 后
    // scan=1 会重新建表，供声明登记、recognize 与 lowering 查询。
    %syntax = #call meta_syntax_init()
    #if #ne[#bits<32>](%syntax, 0) { #return %syntax }
    // **每份源码都读成树**：不只是被降级的那份。模块和 root 环境的名字查找
    // 以后也要在树上做，所以它们的树现在就得在。
    // 诊断（安全格 2048=源数量、2056=ps 循环迭代次数）
    %ksc = #call lain_meta_scratch_data()
    %ks0 = #call meta_cell_put(#lea(%ksc, 2048, 1, 0), %count)
    %pass = #if %scan -> (#bits<32>) {
      %parsed = #loop ps(%i: #bits<64> = 0) -> (#bits<32>) {
      %kt0 = #call meta_cell_get_raw(#lea(%ksc, 2056, 1, 0))
      %kt1 = #add[#bits<64>](%kt0, 1)
      %kt2 = #call meta_cell_put(#lea(%ksc, 2056, 1, 0), %kt1)
      %more = #ult[#bits<64>](%i, %count)
      #if %more {
        // 诊断（槽 70+src 记迭代下标、76+src 记返回码）：循环到底跑了几趟。
        %st = #call meta_parse_source(%i)
        %sti = #zext[#bits<64>](%st)
        %bad = #ne[#bits<32>](%st, 0)
        #if %bad {
          #break ps(%st)
        }
        %i2 = #add[#bits<64>](%i, 1)
        #continue ps(%i2)
      } else {
        #break ps(0)
      }
    }
    %ok = #eq[#bits<32>](%parsed, 0)
    %w = #if %ok -> (#bits<32>) {
      // 解析用完的「出参」单元现在改用临时值计数器（见 funcs.l1），先清零。
      // 每次编译都从零开始编号临时值。
      %z144 = #call meta_cell_put(#lea(%scratch, 144, 1, 0), 0)
      // 根槽没有「外层源码」可指：标量是内建名字（`scalars.l1` 的表），源码里
      // 没有另一份要先扫的 root 环境。根槽保持 NONE。
      %s6 = #call meta_cell_put(#lea(%scratch, 96, 1, 0), 0xFFFFFFFFFFFFFFFF)
      #yield 0
    } else {
      #yield %parsed
    }
      #yield %w
    } else {
      #yield 0
    }
    #yield %pass
  } else {
    // 诊断：把 need / size / 各项中间值递到宿主槽（不写暂存区）。
    %dbg_a = #call lain_meta_trace(40, %need)
    %dbg_b = #call lain_meta_trace(41, %size)
    %dbg_c = #call lain_meta_trace(42, %sem_base)
    %dbg_d = #call lain_meta_trace(43, %sem_entries)
    %kd0 = #add[#bits<64>](%dbg_a, %dbg_b)
    %kd1 = #add[#bits<64>](%dbg_c, %dbg_d)
    %keepd = #add[#bits<64>](%kd0, %kd1)
    %f = #call lain_meta_fail(17)
    %fk = #add[#bits<32>](%f, #trunc[#bits<32>](%keepd))
    #yield 17
  }
  #return %r
}

// Expand 的声明协调步：只登记身份/声明位置，不运行函数体或 Lowering。
// 第一次 DEFER 后调用；返回 0 表示扫描完成，协调器随后查询具体依赖是否可见。
#proc meta_declare_available(%source: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %clear_root = #call meta_cell_put(#lea(%scratch, 96, 1, 0),
                                    0xFFFFFFFFFFFFFFFF)
  %mark = #call meta_scope_count()
  %current = #call meta_scope_set_current(%source)
  %len = #call lain_meta_source_length(%source)
  %base = #call lain_meta_source_data(%source)
  %scan = #call meta_scope_scan(%base, %len, %source, %mark)
  #return %scan
}

// 路径 / mangle 缓冲区在哪 —— **动态区里紧接作用域表**，语义旁表在它后面。
//
// 为什么不放在固定格子里：它要装得下最长的逻辑路径（容量见 `meta_path_cap`，
// 352 字节），而固定格子 +168..+504 已经被降级表达式和实参机械占满。硬塞进去
// 就是两块内存互相覆盖 —— 旧表正是这么写的（把 +160..+511 整段给了它），这一版
// 才拆开。公式只此一处，使用者调这个 proc。
#proc meta_path_buffer() -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %sc_base = #call meta_cell_get(#lea(%scratch, 72, 1, 0))
  %scap = #call meta_cell_get(#lea(%scratch, 80, 1, 0))
  %sc_bytes = #mul[#bits<64>](%scap, 56)
  %dep_cap = #call meta_cell_get(#lea(%scratch, 424, 1, 0))
  %dep_bytes = #mul[#bits<64>](%dep_cap, 24)
  %at0 = #add[#bits<64>](%sc_base, %sc_bytes)
  %at = #add[#bits<64>](%at0, %dep_bytes)
  #return %at
}

// --- 暂存区分配器（碰撞式）--------------------------------------------------
//
// 为什么要有它：那些**逐表达式、会嵌套**的临时块，用手挑的固定偏移做不到。实参表
// 就是活证据 —— 外层的实参降级到一半，里面又碰到一次调用，内层把同一段内存写一遍：
//
//   func add3(a: i32, b: i32, c: i32) -> i32 { return a + b; }
//   let main: i32 = add3(g(1), g(2), g(3));
//   →
//   %r3 = #call g(1)   %r4 = #call g(2)   %r5 = #call g(3)
//   #return #call add3(3, %r4, %r5)      ← 第一个实参成了内层 g(3) 的实参
//
// 验证器不报，值是错的。所以临时块改成**向分配器要**。
//
// 只需要碰撞式：这里从不 free、没有碎片。水位往上推，mark/release 成对回退。
//
//   +200  水位（下一个可用偏移）
//   +208  历史最高水位（只增 —— "够不够"看这一个数，不用再估）
//
// 区段 = 启动时那几笔固定认领之后剩下的全部（认领顺序就是布局，见文件头的表）。
//
// 水位顶出区段上界时下一次 `#store` 会被 VSpace 拒 —— 这是跟 VM 的唯一接口
// （计划 §4 第 5 条读法二下）。分配器要**抢在撞墙之前**自己报 17，所以每次
// 分配都先比一次上界。

#proc meta_bump_word(%off: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %v = #call meta_cell_get(#lea(%scratch, %off, 1, 0))
  #return %v
}

#proc meta_bump_mark() -> #bits<64> {
  %w = #call meta_bump_word(200)
  #return %w
}

// 历史最高水位。够不够读它，不要读水位（水位会随 release 退回去）。
#proc meta_bump_peak() -> #bits<64> {
  %v = #call meta_bump_word(208)
  #return %v
}

// 要 `%bytes` 字节，8 字节对齐，返回偏移；装不下报 17 并返回「无」。
#proc meta_bump_alloc(%bytes: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %size = #call lain_meta_scratch_size()
  %at = #call meta_bump_mark()
  // 对齐前先防 `bytes + 7` 回绕；回绕后再与 scratch 上界比较会误认成小块。
  %alignable = #ule[#bits<64>](%bytes, 0xFFFFFFFFFFFFFFF8)
  #if #eq[#bits<1>](%alignable, 0) {
    %fail = #call lain_meta_fail(17)
    #return 0xFFFFFFFFFFFFFFFF
  }
  %pad0 = #add[#bits<64>](%bytes, 7)
  %need = #and[#bits<64>](%pad0, 0xFFFFFFFFFFFFFFF8)
  %end = #add[#bits<64>](%at, %need)
  %not_wrapped = #uge[#bits<64>](%end, %at)
  %within = #ule[#bits<64>](%end, %size)
  %ok = #and[#bits<1>](%not_wrapped, %within)
  %r = #if %ok -> (#bits<64>) {
    %s1 = #call meta_cell_put(#lea(%scratch, 200, 1, 0), %end)
    %peak = #call meta_bump_peak()
    %higher = #ugt[#bits<64>](%end, %peak)
    %s2 = #if %higher -> (#bits<32>) {
      %s3 = #call meta_cell_put(#lea(%scratch, 208, 1, 0), %end)
      #yield 0
    } else {
      #yield 0
    }
    #yield %at
  } else {
    %f = #call lain_meta_fail(17)
    #yield 0xFFFFFFFFFFFFFFFF
  }
  #return %r
}

#proc meta_bump_release(%mark: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %s = #call meta_cell_put(#lea(%scratch, 200, 1, 0), %mark)
  #return 0
}

// 这个模块扫过了吗？没有就扫一层。压模块作用域时用（配合 meta_scope_enter）。
#proc meta_scope_ensure_scanned(%idx: #bits<64>) -> #bits<32> {
  %already = #call meta_scope_has_source(%idx)
  %st = #if %already -> (#bits<32>) {
    #yield 0
  } else {
    %base = #call lain_meta_source_data(%idx)
    %len = #call lain_meta_source_length(%idx)
    %mark = #call meta_scope_count()
    %s = #call meta_scope_scan(%base, %len, %idx, %mark)
    #yield %s
  }
  #return %st
}

#proc meta_scope_count() -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %v = #call meta_cell_get(#lea(%scratch, 88, 1, 0))
  #return %v
}

#proc meta_scope_release(%mark: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %s = #call meta_cell_put(#lea(%scratch, 88, 1, 0), %mark)
  #return 0
}

#proc meta_scope_entry(%index: #bits<64>) -> #addr {
  %scratch = #call lain_meta_scratch_data()
  %base = #call meta_cell_get(#lea(%scratch, 72, 1, 0))
  %p = #lea(%scratch, %base, 1, 0)
  %off = #mul[#bits<64>](%index, 56)
  // 诊断（安全区 1806..1820）：来源标记 1 + 入参，供越界时读出。
  %dbg_b = #call meta_cell_put(#lea(%scratch, 1806, 1, 0), 1)
  %dbg_i = #call meta_cell_put(#lea(%scratch, 1814, 1, 0), %index)
  %dbg_o = #call meta_cell_put(#lea(%scratch, 1822, 1, 0), %off)
  %q = #lea(%p, %off, 1, 0)
  #return %q
}

#proc meta_scope_word(%index: #bits<64>,
                      %off: #bits<64>) -> #bits<64> {
  %e = #call meta_scope_entry(%index)
  %p = #lea(%e, %off, 1, 0)
  %v = #call meta_cell_get(%p)
  #return %v
}

#proc meta_scope_kind(%index: #bits<64>) -> #bits<64> {
  %v = #call meta_scope_word(%index, 24)
  #return %v
}

#proc meta_scope_payload(%index: #bits<64>) -> #bits<64> {
  %v = #call meta_scope_word(%index, 32)
  #return %v
}

#proc meta_scope_aux(%index: #bits<64>) -> #bits<64> {
  %v = #call meta_scope_word(%index, 40)
  #return %v
}

#proc meta_scope_set_payload(%index: #bits<64>,
                             %v: #bits<64>) -> #bits<32> {
  %e = #call meta_scope_entry(%index)
  %p = #lea(%e, 32, 1, 0)
  %s = #call meta_cell_put(%p, %v)
  #return 0
}

#proc meta_scope_emitted(%index: #bits<64>) -> #bits<64> {
  %v = #call meta_scope_word(%index, 48)
  #return %v
}

// 声明引用由最终树中的 (source, parent group, child index) 定位。payload 缓存节点，
// 每次消费前与出现位置复核，避免展开替换后继续使用失效或错位的缓存引用。
#proc meta_scope_decl_node(%index: #bits<64>) -> #bits<64> {
  %kind = #call meta_scope_kind(%index)
  %is_struct = #eq[#bits<64>](%kind, 4)
  %is_enum = #eq[#bits<64>](%kind, 5)
  %is_func = #eq[#bits<64>](%kind, 6)
  %decl2 = #or[#bits<1>](%is_enum, %is_func)
  %decl_kind = #or[#bits<1>](%is_struct, %decl2)
  %valid = #if %decl_kind -> (#bits<1>) {
    %parent = #call meta_scope_aux(%index)
    %child_index = #call meta_scope_emitted(%index)
    %actual = #call ast_child(%parent, %child_index)
    %cached = #call meta_scope_payload(%index)
    %present = #ne[#bits<64>](%actual, 0)
    %same = #eq[#bits<64>](%actual, %cached)
    #yield #and[#bits<1>](%present, %same)
  } else { #yield 0 }
  %node = #if %valid -> (#bits<64>) {
    %cached = #call meta_scope_payload(%index)
    #yield %cached
  } else {
    %fail = #call lain_meta_fail(9414)
    #yield 0
  }
  #return %node
}

// 普通调用必须绑定到已登记的过程声明；返回其出现位置对应的节点。
#proc meta_scope_require_func(%name: #addr,
                              %name_len: #bits<64>) -> #bits<64> {
  %index = #call meta_scope_find(%name, %name_len)
  %found = #ne[#bits<64>](%index, 0xFFFFFFFFFFFFFFFF)
  %kind = #if %found -> (#bits<64>) {
    %k = #call meta_scope_kind(%index)
    #yield %k
  } else { #yield 0 }
  %is_func = #eq[#bits<64>](%kind, 6)
  %is_size_name = #call meta_scope_generated_size_name(%name, %name_len)
  %not_found = #eq[#bits<64>](%index, 0xFFFFFFFFFFFFFFFF)
  %synthetic_candidate = #and[#bits<1>](%is_size_name, %not_found)
  %synthetic = #if %synthetic_candidate -> (#bits<64>) {
    %prefix_len = #sub[#bits<64>](%name_len, 6)
    %type_index = #call meta_scope_find(%name, %prefix_len)
    %type_found = #ne[#bits<64>](%type_index, 0xFFFFFFFFFFFFFFFF)
    %type_kind = #if %type_found -> (#bits<64>) {
      %k = #call meta_scope_kind(%type_index)
      #yield %k
    } else { #yield 0 }
    %is_struct = #eq[#bits<64>](%type_kind, 4)
    %type_node = #if %is_struct -> (#bits<64>) {
      %n = #call meta_scope_decl_node(%type_index)
      #yield %n
    } else { #yield 0 }
    %has_type = #ne[#bits<64>](%type_node, 0)
    %result = #if %has_type -> (#bits<64>) {
      %edge = #call meta_scope_dependency_add(%type_index)
      %edge_ok = #eq[#bits<32>](%edge, 0)
      %accepted = #if %edge_ok -> (#bits<64>) { #yield 1 } else { #yield 0 }
      #yield %accepted
    } else { #yield 0 }
    #yield %result
  } else { #yield 0 }
  %node = #if %is_func -> (#bits<64>) {
    %decl = #call meta_scope_decl_node(%index)
    %present = #ne[#bits<64>](%decl, 0)
    %edge = #if %present -> (#bits<32>) {
      %e = #call meta_scope_dependency_add(%index)
      #yield %e
    } else { #yield 9414 }
    %edge_ok = #eq[#bits<32>](%edge, 0)
    %result = #if %edge_ok -> (#bits<64>) { #yield %decl } else { #yield 0 }
    #yield %result
  } else {
    #yield %synthetic
  }
  %valid = #ne[#bits<64>](%node, 0)
  %r = #if %valid -> (#bits<64>) {
    #yield %node
  } else {
    %prior = #call lain_meta_status()
    %no_prior = #eq[#bits<64>](%prior, 0)
    %reported = #if %no_prior -> (#bits<64>) {
      %fail = #call lain_meta_fail(9415)
      #yield 1
    } else {
      #yield 0
    }
    #yield 0
  }
  #return %r
}

// 依赖边记录声明表身份，不记录拼写；扫描去重保持首次遇见顺序。
#proc meta_scope_dependency_add(%target: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %from = #call meta_cell_get(#lea(%scratch, 152, 1, 0))
  %inactive = #eq[#bits<64>](%from, 0xFFFFFFFFFFFFFFFF)
  %r = #if %inactive -> (#bits<32>) {
    #yield 0
  } else {
    %base = #call meta_cell_get(#lea(%scratch, 416, 1, 0))
    %count = #call meta_cell_get(#lea(%scratch, 432, 1, 0))
    %cap = #call meta_cell_get(#lea(%scratch, 424, 1, 0))
    %seen = #loop find(%i: #bits<64> = 0) -> (#bits<1>) {
      %more = #ult[#bits<64>](%i, %count)
      #if %more {
        %slot_off = #mul[#bits<64>](%i, 16)
        %at = #add[#bits<64>](%base, %slot_off)
        %old_from = #call meta_cell_get(#lea(%scratch, %at, 1, 0))
        %to_at = #add[#bits<64>](%at, 8)
        %old_to = #call meta_cell_get(#lea(%scratch, %to_at, 1, 0))
        %same_from = #eq[#bits<64>](%old_from, %from)
        %same_to = #eq[#bits<64>](%old_to, %target)
        %same = #and[#bits<1>](%same_from, %same_to)
        #if %same {
          #break find(1)
        }
        %next = #add[#bits<64>](%i, 1)
        #continue find(%next)
      } else {
        #break find(0)
      }
    }
    %full = #uge[#bits<64>](%count, %cap)
    %status = #if %seen -> (#bits<32>) {
      #yield 0
    } else {
      %added = #if %full -> (#bits<32>) {
        %fail = #call lain_meta_fail(9416)
        #yield 9416
      } else {
        %slot_off = #mul[#bits<64>](%count, 16)
        %at = #add[#bits<64>](%base, %slot_off)
        %a = #call meta_cell_put(#lea(%scratch, %at, 1, 0), %from)
        %to_at = #add[#bits<64>](%at, 8)
        %b = #call meta_cell_put(#lea(%scratch, %to_at, 1, 0), %target)
        %new_count = #add[#bits<64>](%count, 1)
        %c = #call meta_cell_put(#lea(%scratch, 432, 1, 0), %new_count)
        #yield 0
      }
      #yield %added
    }
    #yield %status
  }
  #return %r
}

#proc meta_scope_dependency_count() -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %count = #call meta_cell_get(#lea(%scratch, 432, 1, 0))
  #return %count
}

// 声明索引是否已在本次闭包队列中。
#proc meta_scope_closure_contains(%target: #bits<64>) -> #bits<1> {
  %scratch = #call lain_meta_scratch_data()
  %base = #call meta_cell_get(#lea(%scratch, 440, 1, 0))
  %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
  %found = #loop find(%i: #bits<64> = 0) -> (#bits<1>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %off = #mul[#bits<64>](%i, 8)
      %at = #add[#bits<64>](%base, %off)
      %item = #call meta_cell_get(#lea(%scratch, %at, 1, 0))
      %same = #eq[#bits<64>](%item, %target)
      #if %same { #break find(1) }
      %next = #add[#bits<64>](%i, 1)
      #continue find(%next)
    } else { #break find(0) }
  }
  #return %found
}

#proc meta_scope_closure_append(%target: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %base = #call meta_cell_get(#lea(%scratch, 440, 1, 0))
  %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
  %cap = #call meta_cell_get(#lea(%scratch, 424, 1, 0))
  %full = #uge[#bits<64>](%count, %cap)
  %r = #if %full -> (#bits<32>) {
    %fail = #call lain_meta_fail(9416)
    #yield 9416
  } else {
    %off = #mul[#bits<64>](%count, 8)
    %at = #add[#bits<64>](%base, %off)
    %put = #call meta_cell_put(#lea(%scratch, %at, 1, 0), %target)
    %next = #add[#bits<64>](%count, 1)
    %save = #call meta_cell_put(#lea(%scratch, 448, 1, 0), %next)
    #yield 0
  }
  #return %r
}

// 对声明调用图做确定顺序的广度优先闭包。将处理中节点先放进闭包，
// 因此自递归和互递归都终止；它们是过程引用环，不判作 eval 请求循环。
#proc meta_scope_dependency_closure(%root: #bits<64>) -> #bits<64> {
  %root_node = #call meta_scope_decl_node(%root)
  %valid_root = #ne[#bits<64>](%root_node, 0)
  #if #eq[#bits<1>](%valid_root, 0) { #return 0 }
  %scratch = #call lain_meta_scratch_data()
  %clear = #call meta_cell_put(#lea(%scratch, 448, 1, 0), 0)
  %first = #call meta_scope_closure_append(%root)
  %walk = #loop bfs(%cursor: #bits<64> = 0) -> (#bits<32>) {
    %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
    %more = #ult[#bits<64>](%cursor, %count)
    #if %more {
      %closure_base = #call meta_cell_get(#lea(%scratch, 440, 1, 0))
      %node_off = #mul[#bits<64>](%cursor, 8)
      %node_at = #add[#bits<64>](%closure_base, %node_off)
      %current = #call meta_cell_get(#lea(%scratch, %node_at, 1, 0))
      %current_node = #call meta_scope_decl_node(%current)
      %stale = #eq[#bits<64>](%current_node, 0)
      #if %stale {
        %fail = #call lain_meta_fail(9414)
        #break bfs(9414)
      }
      %edge_base = #call meta_cell_get(#lea(%scratch, 416, 1, 0))
      %edge_count = #call meta_cell_get(#lea(%scratch, 432, 1, 0))
      %edge_status = #loop edges(%edge: #bits<64> = 0) -> (#bits<32>) {
        %has_edge = #ult[#bits<64>](%edge, %edge_count)
        #if %has_edge {
          %edge_off = #mul[#bits<64>](%edge, 16)
          %from_at = #add[#bits<64>](%edge_base, %edge_off)
          %from = #call meta_cell_get(#lea(%scratch, %from_at, 1, 0))
          %same_from = #eq[#bits<64>](%from, %current)
          %status = #if %same_from -> (#bits<32>) {
            %to_at = #add[#bits<64>](%from_at, 8)
            %to = #call meta_cell_get(#lea(%scratch, %to_at, 1, 0))
            %seen = #call meta_scope_closure_contains(%to)
            %status_add = #if %seen -> (#bits<32>) {
              #yield 0
            } else {
              %to_node = #call meta_scope_decl_node(%to)
              %bad_to = #eq[#bits<64>](%to_node, 0)
              %added = #if %bad_to -> (#bits<32>) {
                #yield 9414
              } else {
                %a = #call meta_scope_closure_append(%to)
                #yield %a
              }
              #yield %added
            }
            #yield %status_add
          } else { #yield 0 }
          %failed = #ne[#bits<32>](%status, 0)
          #if %failed { #break edges(%status) }
          %next_edge = #add[#bits<64>](%edge, 1)
          #continue edges(%next_edge)
        } else { #break edges(0) }
      }
      %edge_failed = #ne[#bits<32>](%edge_status, 0)
      #if %edge_failed {
        %err = #if #eq[#bits<32>](%edge_status, 9414) -> (#bits<32>) {
          %fail = #call lain_meta_fail(9414)
          #yield 9414
        } else { #yield %edge_status }
        #break bfs(%err)
      }
      %next_cursor = #add[#bits<64>](%cursor, 1)
      #continue bfs(%next_cursor)
    } else { #break bfs(0) }
  }
  %failed = #ne[#bits<32>](%walk, 0)
  %r = #if %failed -> (#bits<64>) {
    #yield 0
  } else {
    %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
    #yield %count
  }
  #return %r
}

#proc meta_scope_dependency_closure_count() -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
  #return %count
}

#proc meta_scope_dependency_closure_at(%index: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %base = #call meta_cell_get(#lea(%scratch, 440, 1, 0))
  %count = #call meta_cell_get(#lea(%scratch, 448, 1, 0))
  %inside = #ult[#bits<64>](%index, %count)
  %r = #if %inside -> (#bits<64>) {
    %off = #mul[#bits<64>](%index, 8)
    %at = #add[#bits<64>](%base, %off)
    %node = #call meta_cell_get(#lea(%scratch, %at, 1, 0))
    #yield %node
  } else { #yield 0xFFFFFFFFFFFFFFFF }
  #return %r
}

// struct 声明生成 `<Type>__size()` 过程；按类型身份识别这类派生入口。
#proc meta_scope_generated_size_name(%name: #addr,
                                    %name_len: #bits<64>) -> #bits<1> {
  %enough = #uge[#bits<64>](%name_len, 6)
  %r = #if %enough -> (#bits<1>) {
    %at = #sub[#bits<64>](%name_len, 6)
    %b0 = #call bs_is_byte(%name, %at, 95)
    %at1 = #add[#bits<64>](%at, 1)
    %b1 = #call bs_is_byte(%name, %at1, 95)
    %at2 = #add[#bits<64>](%at, 2)
    %b2 = #call bs_is_byte(%name, %at2, 115)
    %at3 = #add[#bits<64>](%at, 3)
    %b3 = #call bs_is_byte(%name, %at3, 105)
    %at4 = #add[#bits<64>](%at, 4)
    %b4 = #call bs_is_byte(%name, %at4, 122)
    %at5 = #add[#bits<64>](%at, 5)
    %b5 = #call bs_is_byte(%name, %at5, 101)
    %p0 = #and[#bits<1>](%b0, %b1)
    %p1 = #and[#bits<1>](%b2, %b3)
    %p2 = #and[#bits<1>](%b4, %b5)
    %p3 = #and[#bits<1>](%p0, %p1)
    %all = #and[#bits<1>](%p3, %p2)
    #yield %all
  } else { #yield 0 }
  #return %r
}

#proc meta_scope_set_emitted(%index: #bits<64>,
                             %v: #bits<64>) -> #bits<32> {
  %e = #call meta_scope_entry(%index)
  %p = #lea(%e, 48, 1, 0)
  %s = #call meta_cell_put(%p, %v)
  #return 0
}

// 同一层里两条条目的名字是不是同一个？跨源码比，所以两个地址都要算出来。
#proc meta_scope_name_eq(%index: #bits<64>,
                          %name_src: #bits<64>, %name_off: #bits<64>,
                          %name_len: #bits<64>) -> #bits<1> {
  %have = #call meta_scope_word(%index, 16)
  %same_len = #eq[#bits<64>](%have, %name_len)
  %r = #if %same_len -> (#bits<1>) {
    %src_a = #call meta_scope_word(%index, 0)
    %off_a = #call meta_scope_word(%index, 8)
    %base_a = #call lain_meta_source_data(%src_a)
    %a = #lea(%base_a, %off_a, 1, 0)
    %base_b = #call lain_meta_source_data(%name_src)
    %b = #lea(%base_b, %name_off, 1, 0)
    %eqb = #call meta_bytes_equal(%a, %b, %name_len)
    #yield %eqb
  } else {
    #yield 0
  }
  #return %r
}

// 追加一条。同层重名 → 16；表满 → 17。
#proc meta_scope_add(%level_start: #bits<64>, %source: #bits<64>,
                     %name_off: #bits<64>, %name_len: #bits<64>,
                     %kind: #bits<64>, %payload: #bits<64>,
                     %aux: #bits<64>) -> #bits<32> {
  %count = #call meta_scope_count()
  %dup = #loop d(%i: #bits<64> = %level_start) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %same = #call meta_scope_name_eq(%i, %source, %name_off, %name_len)
      #if %same {
        #break d(1)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue d(%i2)
    } else {
      #break d(0)
    }
  }
  %bad = #ne[#bits<64>](%dup, 0)
  %r = #if %bad -> (#bits<32>) {
    // 诊断（安全区 1920）：重复名被拒的次数 + 名字窗口
    %dsc = #call lain_meta_scratch_data()
    %d0 = #call meta_cell_get_raw(#lea(%dsc, 1928, 1, 0))
    %d1 = #add[#bits<64>](%d0, 1)
    %d2 = #call meta_cell_put(#lea(%dsc, 1928, 1, 0), %d1)
    %d3 = #call meta_cell_put(#lea(%dsc, 1936, 1, 0), %name_off)
    %f0 = #call lain_meta_fail(16)
    #yield 16
  } else {
    %scratch = #call lain_meta_scratch_data()
    %cap = #call meta_cell_get(#lea(%scratch, 80, 1, 0))
    %full = #uge[#bits<64>](%count, %cap)
    %w = #if %full -> (#bits<32>) {
      %f1 = #call lain_meta_fail(17)
      #yield 17
    } else {
      %e = #call meta_scope_entry(%count)
      // 条目布局（每条 56 字节）：+0 源码下标、+8 名字偏移、+16 名字长度、
      // +24 kind、+32 payload、+40 aux、+48 emitted 标记。
      // **+0 与 +56 那次写回条数是必需的**：少了条数写回，`meta_scope_count()`
      // 永远回 0，于是每次 add 都写同一槽、作用域表看起来「一条都没进」
      //（实测 `scope: count=0`，而 `addscalar` 明明被调到了）。
      // 这几行是第 38 轮那条批量删除正则误删的（它把 `meta_cell_put` 一起匹配了）。
      %s0 = #call meta_cell_put(%e, %source)
      %s1 = #call meta_cell_put(#lea(%e, 8, 1, 0), %name_off)
      %s2 = #call meta_cell_put(#lea(%e, 16, 1, 0), %name_len)
      %s3 = #call meta_cell_put(#lea(%e, 24, 1, 0), %kind)
      %s4 = #call meta_cell_put(#lea(%e, 32, 1, 0), %payload)
      %s5 = #call meta_cell_put(#lea(%e, 40, 1, 0), %aux)
      %s6 = #call meta_cell_put(#lea(%e, 48, 1, 0), 0)
      %new = #add[#bits<64>](%count, 1)
      %scratch2 = #call lain_meta_scratch_data()
      %s7 = #call meta_cell_put(#lea(%scratch2, 88, 1, 0), %new)
      #yield 0
    }
    #yield %w
  }
  #return %r
}

// 按名字找，**从表尾往前**（最内层优先）。返回条目下标；没有返回 NOT_FOUND。
//
// 只认两份源码的条目：**当前正在降级的那份**（+104）和 root 环境那份（+96）。
// 别的源码的条目一律看不见——这就是「调用方那一层不在模块的链里」那条规则。
#proc meta_scope_find(%name_addr: #addr,
                      %name_len: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %root = #call meta_cell_get(#lea(%scratch, 96, 1, 0))
  %current = #call meta_cell_get(#lea(%scratch, 104, 1, 0))
  %count = #call meta_scope_count()
  %found = #loop s(%i: #bits<64> = %count) -> (#bits<64>) {
    %more = #ugt[#bits<64>](%i, 0)
    #if %more {
      %k = #sub[#bits<64>](%i, 1)
      %src = #call meta_scope_word(%k, 0)
      %mine = #eq[#bits<64>](%src, %current)
      %rooted = #eq[#bits<64>](%src, %root)
      %visible = #or[#bits<1>](%mine, %rooted)
      %hit = #if %visible -> (#bits<1>) {
        %off = #call meta_scope_word(%k, 8)
        %p = #call meta_scope_name_at(%src, %off)
        %have = #call meta_scope_word(%k, 16)
        // 诊断（宿主槽 6/7/8/9）：本条目的来源、可见性、名字长度、条目名前 8 字节。
        %sf3 = #call meta_cell_get(%p)
        %same_len = #eq[#bits<64>](%have, %name_len)
        %eqb = #if %same_len -> (#bits<1>) {
          %e = #call meta_bytes_equal(%p, %name_addr, %name_len)
          #yield %e
        } else {
          #yield 0
        }
        #yield %eqb
      } else {
        #yield 0
      }
      #if %hit {
        #break s(%k)
      }
      %i2 = #sub[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %found
}

// 表里有没有这份源码的条目？——用来判断「这个模块扫过了没有」。
//
// 模块的作用域**扫一次就留着**，不退掉。原因：`emitted` 标记是记在条目上的，
// 退掉再扫一遍会得到一批标记全为 0 的新条目，于是同一条绑定被发两次——产物里
// 出现两个同名过程。留着条目，第二次取用就看得见「已经发过」。
//
// 留着不违反可见性：查找只认「当前源码 + root」两份，别人的条目看不见。代价是
// 表会随被取用的模块数增长，而容量本来就是按模块算的。
#proc meta_scope_has_source(%source: #bits<64>) -> #bits<1> {
  %count = #call meta_scope_count()
  %found = #loop s(%i: #bits<64> = 0) -> (#bits<1>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %src = #call meta_scope_word(%i, 0)
      %same = #eq[#bits<64>](%src, %source)
      #if %same {
        #break s(1)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0)
    }
  }
  #return %found
}

// 进出一份源码的作用域。链是 [root, 当前]，所以只需要存一个「当前」。
#proc meta_scope_enter(%source: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %old = #call meta_cell_get(#lea(%scratch, 104, 1, 0))
  %s1 = #call meta_cell_put(#lea(%scratch, 104, 1, 0), %source)
  #return %old
}

#proc meta_scope_set_current(%source: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data()
  %s1 = #call meta_cell_put(#lea(%scratch, 104, 1, 0), %source)
  #return 0
}

#proc meta_scope_name_at(%source: #bits<64>,
                         %off: #bits<64>) -> #addr {
  %base = #call lain_meta_source_data(%source)
  %p = #lea(%base, %off, 1, 0)
  #return %p
}

// --- 预扫一份源码的顶层形式 -------------------------------------------------

// 一个引用在它父组的哪个位置。**「下一个兄弟」必须由父组 + 下标给出**：规范禁止
// `node.next`，节点自己不带兄弟信息了。
#proc ast_index_of(%parent: #bits<64>, %node: #bits<64>) -> #bits<64> {
  %count = #call ast_child_count(%parent)
  %r = #loop s(%i: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%parent, %i)
      %same = #eq[#bits<64>](%c, %node)
      #if %same {
        #break s(%i)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %r
}

// 名字节点跟在关键字后面；`名字后面那个节点` 是 `=`（标量）或 `{...}` 组（积/和）。
// 记进表的是**节点引用**，不是字节位置。
#proc meta_scope_name_of(%parent: #bits<64>, %index: #bits<64>) -> #bits<64> {
  %n_i = #add[#bits<64>](%index, 1)
  %count = #call ast_child_count(%parent)
  %has = #ult[#bits<64>](%n_i, %count)
  %r = #if %has -> (#bits<64>) {
    %c = #call ast_child(%parent, %n_i)
    #yield %c
  } else {
    #yield 0
  }
  #return %r
}

// `struct X { ... }` / `enum X { ... }`：payload 记声明自己的节点下标。
#proc meta_scope_add_decl(%base: #addr, %len: #bits<64>,
                           %source: #bits<64>, %level_start: #bits<64>,
                           %parent: #bits<64>, %index: #bits<64>,
                           %kind: #bits<64>) -> #bits<32> {
  %node = #call ast_child(%parent, %index)
  %name_node = #call meta_scope_name_of(%parent, %index)
  %n_lo = #call meta_node_start(%name_node)
  %n_len = #call meta_node_len(%name_node)
  %st = #call meta_scope_add(%level_start, %source, %n_lo, %n_len,
                             %kind, %node, %parent)
  %added = #eq[#bits<32>](%st, 0)
  #if %added {
    %count = #call meta_scope_count()
    %last = #sub[#bits<64>](%count, 1)
    %stored = #call meta_scope_set_emitted(%last, %index)
  }
  #return %st
}

// `let NAME = <初始化式>`：payload 记初始化式那个节点的下标。
#proc meta_scope_add_let(%base: #addr, %len: #bits<64>,
                         %source: #bits<64>, %level_start: #bits<64>,
                         %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %node = #call ast_child(%parent, %index)
  %name_node = #call meta_scope_name_of(%parent, %index)
  %n_lo = #call meta_node_start(%name_node)
  %n_len = #call meta_node_len(%name_node)
  %count = #call ast_child_count(%parent)
  %eq_i = #add[#bits<64>](%index, 2)
  %eq_room = #ult[#bits<64>](%eq_i, %count)
  %eq_node = #if %eq_room -> (#bits<64>) {
    %e0 = #call ast_child(%parent, %eq_i)
    #yield %e0
  } else {
    #yield 0
  }
  %rhs_i = #add[#bits<64>](%index, 3)
  %rhs_room = #ult[#bits<64>](%rhs_i, %count)
  %rhs = #if %rhs_room -> (#bits<64>) {
    %r0 = #call ast_child(%parent, %rhs_i)
    #yield %r0
  } else {
    #yield 0
  }
  %gone = #eq[#bits<64>](%rhs, 0)
  %st = #if %gone -> (#bits<32>) {
    %a = #call meta_scope_add(%level_start, %source, %n_lo, %n_len,
                              3, 0, 0)
    #yield %a
  } else {
    // RHS 是不是 `import("...")`？是模块引用，逻辑路径在那个组的第一个孩子里。
    %ikw = #data_addr meta_kw_import
    %is_import = #call meta_node_is_word(%rhs, %base, %ikw, 6)
    %v = #if %is_import -> (#bits<32>) {
      %grp_i = #add[#bits<64>](%rhs_i, 1)
      %grp_room = #ult[#bits<64>](%grp_i, %count)
      %grp = #if %grp_room -> (#bits<64>) {
        %g0 = #call ast_child(%parent, %grp_i)
        #yield %g0
      } else {
        #yield 0
      }
      %str = #call meta_node_child(%grp)
      %st_off = #call meta_node_start(%str)
      // 逻辑路径在引号里面：+1 跳过开引号
      %lp = #add[#bits<64>](%st_off, 1)
      %lp_len = #call meta_logical_len_of(%str)
      %path = #lea(%base, %lp, 1, 0)
      %idx = #call meta_source_find(%path, %lp_len)
      %miss = #eq[#bits<64>](%idx, 0xFFFFFFFFFFFFFFFF)
      %w = #if %miss -> (#bits<32>) {
        %f = #call lain_meta_fail(11)
        #yield 11
      } else {
        %b = #call meta_scope_add(%level_start, %source, %n_lo, %n_len,
                                  1, %idx, %lp)
        #yield %b
      }
      #yield %w
    } else {
      %c = #call meta_scope_add(%level_start, %source, %n_lo, %n_len,
                                3, %rhs, 0)
      #yield %c
    }
    #yield %v
  }
  #return %st
}

// `"std::math"` 这个节点里，引号之间有多少字节。
#proc meta_logical_len_of(%str: #bits<64>) -> #bits<64> {
  %n = #call meta_node_len(%str)
  %two = #sub[#bits<64>](%n, 2)
  #return %two
}

// 旧的 `meta_scope_add_let`（按字节读 `let NAME = ...`）**已经删了**：现在按节点
// 走。

// 预扫顶层形式，把绑定记进表。level_start 是本次那一层的起点（重名只在本层比）。
//
// **形式从语法树上走**，不再扫字节找关键字。以前是「从某个位置起，逐字节找下一处
// 长得像 let / struct / enum 的地方」——所以注释里的词、字段名叫 `letter`
// 之类的都会被当成声明。现在问的是「这个节点是不是内容为 struct 的词」，而且一条
// 形式从哪到哪由节点自己给出。
#proc meta_scope_scan(%base: #addr, %len: #bits<64>,
                      %source: #bits<64>,
                      %level_start: #bits<64>) -> #bits<32> {
  %root = #call meta_root_of(%source)
  %s = #call meta_scope_scan_root(%base, %len, %source, %level_start, %root)
  #return %s
}

// 候选根尚未发布时也可登记声明；调用方负责联合提交或恢复作用域表。
#proc meta_scope_scan_root(%base: #addr, %len: #bits<64>,
                           %source: #bits<64>, %level_start: #bits<64>,
                           %root: #bits<64>) -> #bits<32> {
  %count = #call ast_child_count(%root)
  // 诊断（安全区 1540+src*32）：扫描入口的根与孩子数。
  %ss0 = #call lain_meta_scratch_data()
  %sso = #mul[#bits<64>](%source, 32)
  %ssa = #add[#bits<64>](%sso, 1540)
  %ssp0 = #call meta_cell_put(#lea(%ss0, %ssa, 1, 0), %count)
  %ssb = #add[#bits<64>](%sso, 1548)
  %ssp1 = #call meta_cell_put(#lea(%ss0, %ssb, 1, 0), %root)
  %ssc = #add[#bits<64>](%sso, 1556)
  %ssp2 = #call meta_cell_put(#lea(%ss0, %ssc, 1, 0), 1)
  // 诊断（安全格 1984=入口调用的 source、1992=调用次数）：入口无条件记。
  %esc = #call lain_meta_scratch_data()
  %es0 = #call meta_cell_put(#lea(%esc, 1984, 1, 0), %source)
  %en0 = #call meta_cell_get_raw(#lea(%esc, 1992, 1, 0))
  %en1 = #add[#bits<64>](%en0, 1)
  %es1 = #call meta_cell_put(#lea(%esc, 1992, 1, 0), %en1)
  %first_i = #add[#bits<64>](0, 0)
  %st = #loop forms(%i: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %node = #call ast_child(%root, %i)
      %here = #call meta_node_start(%node)
      %handler = #call meta_syntax_lookup(%node, 1, %level_start, 1)
      // 未展开的声明宏尚无声明身份；先登记其它已知声明，等待协调器重试。
      %is_macro = #eq[#bits<64>](%handler, 11)
      %any = #and[#bits<1>](#ne[#bits<64>](%handler, 0),
                             #eq[#bits<1>](%is_macro, 0))
      %s = #if %any -> (#bits<32>) {
        // 诊断（安全区 1960=source、1968=命中的下标、1976=进入 add_form 的次数）
        %qsc = #call lain_meta_scratch_data()
        %qs0 = #call meta_cell_put(#lea(%qsc, 1960, 1, 0), %source)
        %qs1 = #call meta_cell_put(#lea(%qsc, 1968, 1, 0), %i)
        %qn0 = #call meta_cell_get_raw(#lea(%qsc, 1976, 1, 0))
        %qn1 = #add[#bits<64>](%qn0, 1)
        %qs2 = #call meta_cell_put(#lea(%qsc, 1976, 1, 0), %qn1)
        %d = #call meta_declare_invoke(%handler, %base, %len, %source,
                                       %level_start, %root, %i)
        #yield %d
      } else {
        // 顶层树的孩子是词，不是形式——见 meta_lower_source 同处的说明。
        %is_first = #and[#bits<1>](#eq[#bits<64>](%i, %first_i),
                                    #eq[#bits<64>](%handler, 0))
        %x = #if %is_first -> (#bits<32>) {
          %f = #call lain_meta_fail(4)
          #yield 4
        } else {
          #yield 0
        }
        #yield %x
      }
      %bad = #ne[#bits<32>](%s, 0)
      #if %bad {
        #break forms(%s)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue forms(%i2)
    } else {
      #break forms(0)
    }
  }
  // 诊断（安全区 1944/1952）：扫描的返回值与结束时的作用域表条数
  %sdc = #call lain_meta_scratch_data()
  %sdt = #zext[#bits<64>](%st)
  %sda = #call meta_cell_put(#lea(%sdc, 1944, 1, 0), %sdt)
  %sdb = #call meta_scope_count()
  %sdd = #call meta_cell_put(#lea(%sdc, 1952, 1, 0), %sdb)
  #return %st
}

// 把一条顶层形式的名字记进表。关键字已经由 declarations.l1 的处理器分派，
// **节点下标也传进来**。
//
// `payload` / `aux` 存的是**已经解析好的东西**，不是「等用到再回源码找」的位置：
//
//   kind 2 标量   payload = 类型 id（0 = 还没 intern）  aux = repr 的**节点下标**
//   kind 4/5/6 声明 payload = 声明节点，aux = 父组引用，emitted = 父组内下标
//   kind 1 模块引用 payload = 被 import 的源码下标       aux = 逻辑路径的位置
//   kind 3 值绑定 payload = 初始化式的**节点下标**       aux = 0
//
// 「节点下标」这一列是这张表被叫成符号表的原因：它指着声明本身。用的时候是
// O(1) 地读那个节点，不是拿名字回源码里搜一遍。
// --- 查类型 ---------------------------------------------------------------

// 名字 → 声明类型（struct/enum）的类型 id；查不到或不是类型返回 NOT_FOUND ——
// 调用方按「没有这个类型」处理，也就是 5。
//
// **标量不在这里**：内建标量住在 `scalars.l1` 的表里，不进作用域表。
#proc meta_scope_type_id(%name_addr: #addr,
                          %name_len: #bits<64>) -> #bits<64> {
  %i = #call meta_scope_find(%name_addr, %name_len)
  %miss = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %r = #if %miss -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %kind = #call meta_scope_kind(%i)
    %is_struct_type = #eq[#bits<64>](%kind, 4)
    %is_sum_type = #eq[#bits<64>](%kind, 5)
    %w = #if %is_struct_type -> (#bits<64>) {
      #yield #call meta_record_type_id(%i)
    } else {
      %sum_id = #if %is_sum_type -> (#bits<64>) {
        #yield #call meta_sum_type_id(%i)
      } else {
        // 名字在表里，但不是类型
        #yield 0xFFFFFFFFFFFFFFFF
      }
      #yield %sum_id
    }
    #yield %w
  }
  #return %r
}

// AstOut 与候选声明索引联合发布。备份旧条目及两个可见链控制格；登记失败或
// 根提交失败时，先恢复引用表，再回滚物理节点，防止撤销引用留在作用域/语法表。
#proc meta_commit_decl_candidate(%source: #bits<64>, %old_root: #bits<64>,
                                  %new_root: #bits<64>, %tx: #bits<64>,
                                  %syntax_mark: #bits<64>) -> #bits<32> {
  %mark = #call meta_bump_mark()
  %count = #call meta_scope_count()
  %bytes = #mul[#bits<64>](%count, 56)
  %off = #call meta_bump_alloc(%bytes)
  #if #eq[#bits<64>](%off, 0xFFFFFFFFFFFFFFFF) {
    %rb0 = #call lain_meta_ast_tx_rollback(%tx)
    %s0 = #call meta_syntax_state_put(8, %syntax_mark)
    #return 17
  }
  %scratch = #call lain_meta_scratch_data()
  %backup = #lea(%scratch, %off, 1, 0)
  %base_off = #call meta_cell_get(#lea(%scratch, 72, 1, 0))
  %table = #lea(%scratch, %base_off, 1, 0)
  %old_env = #call meta_cell_get(#lea(%scratch, 96, 1, 0))
  %old_current = #call meta_cell_get(#lea(%scratch, 104, 1, 0))
  %copied = #loop save(%i: #bits<64> = 0) -> (#bits<32>) {
    #if #ult[#bits<64>](%i, %bytes) {
      %v = #call meta_cell_get(#lea(%table, %i, 1, 0))
      %w = #call meta_cell_put(#lea(%backup, %i, 1, 0), %v)
      #continue save(#add[#bits<64>](%i, 8))
    } else { #break save(0) }
  }
  %clear = #call meta_scope_release(0)
  %set_env = #call meta_cell_put(#lea(%scratch, 96, 1, 0), 0xFFFFFFFFFFFFFFFF)
  %level = #call meta_scope_count()
  %set_current = #call meta_scope_set_current(%source)
  %base = #call lain_meta_source_data(%source)
  %len = #call lain_meta_source_length(%source)
  %candidate = #call meta_scope_scan_root(%base, %len, %source, %level, %new_root)
  %status = #if #eq[#bits<32>](%candidate, 0) -> (#bits<32>) {
    // 候选声明已登记，函数体可引用同批宏生成的声明。最终根仍在同一个事务内。
    %body_phase = #call meta_cell_put_raw(#data_addr meta_expand_decl_phase, 0)
    %final_root = #call meta_expand_root(%new_root)
    %done = #if #ne[#bits<64>](%final_root, 0) -> (#bits<32>) {
      %commit = #call lain_meta_ast_commit(%source, %old_root, %final_root, %tx)
      #yield %commit
    } else {
      %dependency = #call meta_expand_defer_get()
      %code = #if #ne[#bits<64>](%dependency, 0) -> (#bits<32>) {
        #yield 9411
      } else {
        %host = #call lain_meta_status()
        %error = #trunc[#bits<32>](%host)
        #yield %error
      }
      #yield %code
    }
    #yield %done
  } else { #yield %candidate }
  #if #ne[#bits<32>](%status, 0) {
    %restored = #loop restore(%i: #bits<64> = 0) -> (#bits<32>) {
      #if #ult[#bits<64>](%i, %bytes) {
        %v = #call meta_cell_get(#lea(%backup, %i, 1, 0))
        %w = #call meta_cell_put(#lea(%table, %i, 1, 0), %v)
        #continue restore(#add[#bits<64>](%i, 8))
      } else { #break restore(0) }
    }
    %tail = #call meta_scope_count()
    %cleared = #loop clear_tail(%i: #bits<64> = %count) -> (#bits<32>) {
      #if #ult[#bits<64>](%i, %tail) {
        %entry = #call meta_scope_entry(%i)
        %zeroed = #loop zero(%j: #bits<64> = 0) -> (#bits<32>) {
          #if #ult[#bits<64>](%j, 56) {
            %w = #call meta_cell_put(#lea(%entry, %j, 1, 0), 0)
            #continue zero(#add[#bits<64>](%j, 8))
          } else { #break zero(0) }
        }
        #continue clear_tail(#add[#bits<64>](%i, 1))
      } else { #break clear_tail(0) }
    }
    %old_count = #call meta_scope_release(%count)
    %env = #call meta_cell_put(#lea(%scratch, 96, 1, 0), %old_env)
    %current = #call meta_cell_put(#lea(%scratch, 104, 1, 0), %old_current)
    %syntax = #call meta_syntax_state_put(8, %syntax_mark)
    %rb = #call lain_meta_ast_tx_rollback(%tx)
    %deferred = #call meta_expand_defer_get()
    #if #eq[#bits<64>](%deferred, 0) {
      %fail = #call lain_meta_fail(%status)
    }
  }
  %release = #call meta_bump_release(%mark)
  #return %status
}
