// 初代标准库 v0 —— 宿主 ABI 与产物输出。
//
// 这里声明 Meta 用到的**全部**宿主能力。它们是 link_name，同时是链接符号名，
// 所以必须是合法 C 标识符（SYMBOL 策略下后端按这个名字发外部符号引用）。
//
// 宿主指针**不在**这里的参数里：注册时它被绑成能力槽上的 context，
// LAINVM 在调用时注入。Meta 只传业务参数，也无法指定或伪造宿主。
// 这就是 ABI 版本从 1 提到 2 的原因：这些能力与两个入口的签名都变了。

#proc lain_meta_source_count() -> #bits<64> #extern "lain_meta_source_count"
#proc lain_meta_session_id() -> #bits<64> #extern "lain_meta_session_id"
#proc lain_meta_source_data(%index: #bits<64>) -> #addr #extern "lain_meta_source_data"
#proc lain_meta_source_length(%index: #bits<64>) -> #bits<64> #extern "lain_meta_source_length"
#proc lain_meta_source_path_data(%index: #bits<64>) -> #addr #extern "lain_meta_source_path_data"
#proc lain_meta_emit_reset() -> #bits<32> #extern "lain_meta_emit_reset"
#proc lain_meta_emit_scope_begin() -> #bits<32> #extern "lain_meta_emit_scope_begin"
#proc lain_meta_emit_scope_end() -> #bits<32> #extern "lain_meta_emit_scope_end"
#proc lain_meta_emit_write(%data: #addr, %length: #bits<64>) -> #bits<32> #extern "lain_meta_emit_write"
#proc lain_meta_emit_data() -> #addr #extern "lain_meta_emit_data"
#proc lain_meta_emit_length() -> #bits<64> #extern "lain_meta_emit_length"
#proc lain_meta_fail(%code: #bits<32>) -> #bits<32> #extern "lain_meta_fail"
#proc lain_meta_status() -> #bits<64> #extern "lain_meta_status"
#proc lain_meta_scratch_report(%peak: #bits<64>) -> #bits<64> #extern "lain_meta_scratch_report"
#proc lain_meta_type_publish(%descriptor: #addr) -> #bits<64> #extern "lain_meta_type_publish"

// Meta 的可写暂存（表格建在这里）。驱动负责把这块范围授权成 READ|WRITE。
#proc lain_meta_scratch_data() -> #addr #extern "lain_meta_scratch_data"
#proc lain_meta_scratch_size() -> #bits<64> #extern "lain_meta_scratch_size"

// 编译期求值：完整 LAINIR 模块 + 查询入口；结果按物理位模式返回。
// 调用后读 status；成功时 kind/width 给出结果物理类型。
#proc lain_meta_apply_request(%text: #addr, %length: #bits<64>, %entry: #addr, %entry_length: #bits<64>, %args: #addr, %arg_count: #bits<64>) -> #bits<64> #extern "lain_meta_apply_request"
#proc lain_meta_apply_bytes_request(%text: #addr, %length: #bits<64>, %entry: #addr, %entry_length: #bits<64>, %args: #addr, %arg_count: #bits<64>, %byte_length: #bits<64>) -> #bits<64> #extern "lain_meta_apply_bytes_request"
#proc lain_meta_apply_bytes_arg_request(%text: #addr, %length: #bits<64>, %entry: #addr, %entry_length: #bits<64>, %args: #addr, %arg_count: #bits<64>, %byte_arg: #addr, %byte_length: #bits<64>, %byte_index: #bits<64>) -> #bits<64> #extern "lain_meta_apply_bytes_arg_request"
#proc lain_meta_apply_emitted_bytes_request(%entry: #addr, %entry_length: #bits<64>, %args: #addr, %arg_count: #bits<64>, %byte_length: #bits<64>) -> #bits<64> #extern "lain_meta_apply_emitted_bytes_request"
#proc lain_meta_apply_emitted_bytes_arg_request(%entry: #addr, %entry_length: #bits<64>, %args: #addr, %arg_count: #bits<64>, %byte_arg: #addr, %byte_length: #bits<64>, %byte_index: #bits<64>) -> #bits<64> #extern "lain_meta_apply_emitted_bytes_arg_request"
#proc lain_meta_apply_status() -> #bits<64> #extern "lain_meta_apply_status"
#proc lain_meta_apply_kind() -> #bits<64> #extern "lain_meta_apply_kind"
#proc lain_meta_apply_width() -> #bits<64> #extern "lain_meta_apply_width"
#proc lain_meta_apply_bytes_length() -> #bits<64> #extern "lain_meta_apply_bytes_length"
#proc lain_meta_apply_bytes_copy(%offset: #bits<64>, %destination: #addr, %length: #bits<64>) -> #bits<64> #extern "lain_meta_apply_bytes_copy"

// 通用源码树。句柄归所属宿主与源文件；字段号见 docs/meta.md。
// 第一期：AstIn 四个原语取代旧的 7 项树能力（root/field/child/text_byte/
// make_token/make_group/replace_child 全部物理删除）。引用是「段号 + 段内偏移」，
// 节点引用不是字节引用，两者不许互相代用。属性里每一项先在所属段内校验
//（段存活、Header 合法、节点已发布、区间不越界），再交给 VSpace。
#proc lain_meta_ast_root(%source: #bits<64>) -> #bits<64> #extern "lain_meta_ast_root"
#proc lain_meta_ast_node_addr(%ref: #bits<64>) -> #addr #extern "lain_meta_ast_node_addr"
#proc lain_meta_ast_span_addr(%ref: #bits<64>, %length: #bits<64>) -> #addr #extern "lain_meta_ast_span_addr"
#proc lain_meta_ast_child_ref(%group: #bits<64>, %index: #bits<64>) -> #bits<64> #extern "lain_meta_ast_child_ref"
// 第二期输出树：调用者只传业务参数，Host Context 仍由冻结 CSpace 注入。
#proc lain_meta_ast_tx_begin() -> #bits<64> #extern "lain_meta_ast_tx_begin"
#proc lain_meta_ast_charge(%kind: #bits<64>, %amount: #bits<64>) -> #bits<32> #extern "lain_meta_ast_charge"
#proc lain_meta_ast_tx_release(%tx: #bits<64>) -> #bits<32> #extern "lain_meta_ast_tx_release"
#proc lain_meta_ast_tx_rollback(%tx: #bits<64>) -> #bits<32> #extern "lain_meta_ast_tx_rollback"
#proc lain_meta_ast_append_token(%text: #addr, %length: #bits<64>, %origin: #bits<64>, %expansion_id: #bits<64>) -> #bits<64> #extern "lain_meta_ast_append_token"
#proc lain_meta_ast_append_refs(%refs: #addr, %count: #bits<64>) -> #bits<64> #extern "lain_meta_ast_append_refs"
#proc lain_meta_ast_append_group(%delimiter: #bits<64>, %slice: #bits<64>, %count: #bits<64>, %origin: #bits<64>, %expansion_id: #bits<64>) -> #bits<64> #extern "lain_meta_ast_append_group"
#proc lain_meta_ast_expansion_id(%node: #bits<64>) -> #bits<64> #extern "lain_meta_ast_expansion_id"
#proc lain_meta_ast_commit(%source: #bits<64>, %expected_root: #bits<64>, %new_root: #bits<64>, %tx: #bits<64>) -> #bits<32> #extern "lain_meta_ast_commit"
// Meta 侧诊断通道（第一期排查用）：把值写进宿主结构里的 16 个槽。刻意不落暂存区 ——
// 暂存区格子会被分配器与实参表覆盖，读回全 0 会导致「这段代码没跑」的错误结论。
#proc lain_meta_trace(%slot: #bits<64>, %value: #bits<64>) -> #bits<64> #extern "lain_meta_trace"

// 输出模板。产物长这样：
//   #proc <NAME>() -> <REPR> {
//     #return <VALUE>
//   }
// 三段固定文本 + 从源码原样搬过来的名字 + 类型实参 + 十进制数字。





// 带算子的形式：
//   #proc <NAME>() -> <REPR> {
//     %r = #<PHYS>[<REPR>](<LHS>, <RHS>)
//     #return %r
//   }







// 积类型：声明 `struct Rec { f: T ... }` 时，Meta 给每个字段发一个
// 「它的字节偏移」的过程，再发一个「总大小」的过程。
// 名字拼成 <Rec>__<field>_offset 和 <Rec>__size。
data meta_kw_struct ro { 115 116 114 117 99 116 }
data meta_dsep ro { 95 95 }
data meta_foff ro { 95 111 102 102 115 101 116 }
data meta_rsize ro { 95 95 115 105 122 101 }

// 构造与字段访问要发多语句的过程体，模板就多几个。
// 每行后面的数字是字节数——错一个就产出畸形文本，产物解析会直接失败。




// 函数体内的构造：从栈上划一块（`#alloca`），不落顶层 `data`。



// 字段访问





// 直接调用一个已声明过程：`let a = f();` → `#return #call f()`。
// v0 apply 请求最多传递 8 个标量实参。


// 带参数的函数签名：`(`, `) -> `, 参数前的 `%`, 名字和类型之间的 `: `。
// 函数体的二元运算复用 meta_o1..o6——那边发的是 `%r = #<phys>[repr](lhs, rhs)`。

data meta_fn_pct ro { 37 }                             // "%"      1



// 函数体里的语句。模板和字节数由 build/tmp-probe/gen2.py 生成——手数字节数
// 在这上面已经错过三次。
data meta_st_pct ro { 32 32 37 }                       // "  %"      3
data meta_st_eqop ro { 32 61 32 }                      // " = "      3


// `  #return #call x(` 一样的前缀。`#return #call f(…)` 是 LAINIR 里的尾调用写法，
// 函数体里 `return g(x);` 就发成它。

data meta_st_nl ro { 10 }                              // "\n"       1

// `#call ` —— 单独一份，因为子表达式里的调用要发成 `  %r<n> = #call f(…)`，
// 而现有那两份（`meta_f1`/`meta_x1`）都带着自己的前缀。





// extern 声明的尾巴：空格 + #extern + 引号 + 链接名 + 引号换行。
data meta_st_extern ro { 32 35 101 120 116 101 114 110 32 34 }  // " #extern \"" 10
data meta_dquote_nl ro { 34 10 }                                 // "\"\n"     2               // "#lea("   5


data meta_sym_plus ro { 43 }                           // "+"        1
// `as` 的转换指令名：变宽/变窄/等宽复制（后者补零）。它们不在标量表的 op 表里，
// 所以按 **#data 地址**发射，而不是走 `meta_emit_op_mid` 的表内偏移。
data meta_sym_zext ro { 122 101 120 116 }              // "zext"  4
data meta_sym_trunc ro { 116 114 117 110 99 }          // "trunc" 5
data meta_sym_add ro { 97 100 100 }                    // "add"   3
data meta_sym_sub ro { 115 117 98 }                    // "sub"   3

data meta_fn_open ro { 32 123 10 }                     // " {\n"      3
data meta_st_ind ro { 32 32 }                          // "  "        2
// `  #if ` —— 函数体里的 `if` 语句（条件是**语句级** `#if`，不是 `#if … -> (T)` 那个
// 表达式形式；后者用 `meta_st_ind4if` 之类）。条件值紧跟在这后面。
data meta_st_if ro { 32 32 35 105 102 32 }             // "  #if "    6
data meta_hash_if ro { 35 105 102 32 }                  // "#if "      4
data meta_st_arrow_lp ro { 32 45 62 32 40 }             // " -> ("     5
data meta_st_yield ro { 32 32 32 32 35 121 105 101 108 100 32 } // "    #yield " 11
// `  } else {` —— 收掉 `if` 的块、开 `else` 的块。它自己带那个 `}`，所以有 else 时
// 就不再另写 `  }\n`（收尾统一在最后写一次）。
data meta_st_else ro { 32 32 125 32 101 108 115 101 32 123 10 } // "  } else {\n" 11

// for 循环。目标形状：
//   `  %<结果>` + ` = #loop L` + <编号> + `(` + `%<循环变量>: <repr> = <下界>`
//   + `, %acc: <repr> = <初值>` + `) -> (` + <repr> + `) {\n`
// 循环体在 4 格缩进里：`%c<n> = ...` / `#if %c<n> {` / `#continue L<n>(...)` /
// `#break L<n>(%acc)`，最后 `  }\n` 收掉循环。
//
// 4 格缩进有两个版本：`meta_st_ind4pct` 自己带 `%`（给 `%c<n>` 用），
// `meta_st_ind4` 不带（`meta_emit_temp_name` 会自己发那个 `%`）。




data meta_st_lhead ro { 41 32 123 10 }                 // ") {\n"     4


data meta_st_ind4cont ro { 32 32 32 32 35 99 111 110 116 105 110 117 101 32 76 } // "    #continue L" 15

data meta_st_lend ro { 32 32 125 10 }                  // "  }\n"     4

data meta_sym_lt ro { 60 }                             // "<"         1
// 字面量的**默认类型名**。它们不写在任何源码里 —— 是编译器里的数据模板，所以要用
// 「按地址查」的作用域表去解析（见 scalars.l1 的 meta_op_resolve_default）。
data meta_sym_i32 ro { 105 51 50 }                     // "i32"       3
data meta_sym_i64 ro { 105 54 52 }                     // "i64"       3
data meta_sym_dotdot ro { 46 46 }                      // ".."        2

// 和类型。tag 是 `#bits<8>`，在偏移 0；载荷区从 max_align 对齐之后开始。
data meta_kw_enum ro { 101 110 117 109 }                               // "enum"             4
data meta_etag ro { 95 116 97 103 }                                     // "_tag"             4
data meta_eoff ro { 95 111 102 102 }                                    // "_off"             4

// 投影 `let v: T = Shape.Circle(c)`：先读 tag 比一比，命中才读载荷，不命中给 0。
//   #proc <NAME>() -> <REPR> {
//     %b = #call <值>()
//     %t = #load[#bits<8>](%b)
//     %m = #eq[#bits<8>](%t, <TAG>)
//     %r = #if %m -> (<REPR>) {
//       %p = #lea(%b, 0, 0, <载荷偏移>)
//       %v = #load[<REPR>](%p)
//       #yield %v
//     } else {
//       #yield 0
//     }
//     #return %r
//   }
// 头两段（`#proc `/`() -> `）和 `%b = #call ` 复用积类型那几段。





// 投影：读 tag → 比 → 命中就读载荷，否则给 0






// 一个字节的暂存：能力只接受 (地址, 长度)，所以单字节要有个落脚点。


// 把 repr 写成 LAINIR 的类型实参：0 -> #bits<N>，1 -> #f<N>，
// 2 -> #vec<N>，3 -> #addr（#addr 没有宽度可言）。
// 类型实参、单字节与十进制整数的词素都由层 0 负责（`lainir_repr` /
// `lainir_byte` / `lainir_emit_uint`），这里只是管线侧的旧名字。
#proc meta_emit_repr(%kind: #bits<64>,
                     %width: #bits<64>) -> #bits<32> {
  %w = #call lainir_repr(%kind, %width)
  #return %w
}

#proc meta_emit_byte(%b: #bits<8>) -> #bits<32> {
  %r = #call lainir_byte(%b)
  #return %r
}

#proc meta_emit_uint(%v: #bits<64>) -> #bits<32> {
  %s = #call lainir_emit_uint(%v)
  #return %s
}

#proc lain_meta_diagnostic_field(%field: #bits<64>) -> #bits<64> #extern "lain_meta_diagnostic_field"
#proc lain_meta_apply_diagnostic_field(%field: #bits<64>) -> #bits<64> #extern "lain_meta_apply_diagnostic_field"
#proc lain_meta_fail_at(%code: #bits<64>, %source: #bits<64>, %offset: #bits<64>) -> #bits<64> #extern "lain_meta_fail_at"
