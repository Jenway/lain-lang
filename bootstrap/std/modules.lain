// 模块：源码注册表与 import。跨单元引用一律写 `别名.名字`。
//
// 解析规则（与 lain0 的 resolveModulePath 同义）：说明符**相对导入方目录**解析，
// 登记名是「源根相对路径」（`std/lex.lain`、`examples/arith.lain`）。
//
//   import("../meta")          →  <导入方目录>/../meta        →  meta.lain
//   import("std::math")        →  <导入方目录>/math.lain
//                                 <导入方目录>/std/math.lain
//   import("examples::lib")    →  <导入方目录>/lib.lain
//                                 <导入方目录>/examples/lib.lain
//
// 候选按序取第一个命中：说明符原样规范化（旧口径，根相对）、导入方目录 + 末段、
// 导入方目录 + 整段（`::` 对 `/`）。拼接后做词法规范化（丢 `.`、折叠 `..`、
// 折叠重复 `/`），末尾补 `.lain`。全部不中就是错误（status 11）。
//
// 注册表里每份源码的路径由宿主给（`lain_meta_source_path_data`），是 NUL 结尾的
// C 字符串——所以这里靠扫 0 取长度，不需要额外的长度能力。
//
// 命名空间绑定 `let M = import("std::math");` **不产出任何 LAINIR**：它是纯编译期
// 绑定。后面用到 `M.x` 时再回源码里扫这条 import 找回来——和积/和类型重算布局是
// 同一个办法，不建编译期表。
//
// 暂存区分段（宿主给 64 KiB）：
//   +0    和类型的最大载荷大小
//   +8    和类型的最大 align 值
//   +64   import 逻辑路径的规范化缓冲区
//
// 静态只读块用 `let NAME: ro [u8] = [...]` 声明，取址写 symbol_addr("NAME_storage")：
// 编译器发布的数据符号带 _storage 后缀。

let std_emit = import("emit");
let std_funcs = import("funcs");
let std_lainir = import("lainir");
let std_lex = import("lex");
let std_parse = import("parse");
let std_registry = import("registry");
let std_scalars = import("scalars");
let std_scope = import("scope");
let std_types = import("types");

let meta_kw_import: ro [u8] = [105, 109, 112, 111, 114, 116];      // "import"  6
let meta_suffix_lain: ro [u8] = [46, 108, 97, 105, 110];           // ".lain"   5

// 宿主能力。
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_count() -> u64 = lain_meta_source_count;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(source: u64) -> u64 = lain_meta_source_length;
extern lain_meta_source_path_data(index: u64) -> addr = lain_meta_source_path_data;

// --- 宿主字符串与缓冲区 ---------------------------------------------------

// 两个 NUL 结尾字符串相等？同时走到 0 才算相等。u8 没有算子，先 as u32 再比。
func meta_cstr_equal(a: addr, b: addr) -> bool {
  let r: bool = loop walk(i: u64 = 0) {
    let pa: addr = a + i;
    let pb: addr = b + i;
    let ba: u8 = load(pa);
    let bb: u8 = load(pb);
    let baw: u32 = ba as u32;
    let bbw: u32 = bb as u32;
    let diff: bool = baw != bbw;
    if diff { break walk(0); }
    let end: bool = baw == 0;
    if end { break walk(1); }
    continue walk(i + 1);
  };
  return r;
}

func meta_buf_put(buf: addr, capacity: u64, at: u64, b: u8) -> u32 {
  let fits: bool = at < capacity;
  if fits == 0 { return 17; }
  let p: addr = buf + at;
  store(p, b);
  return 0;
}

// 往缓冲区写 n 个字节，返回写完后的下标。
func meta_buf_puts(buf: addr, capacity: u64, at: u64, src: addr, n: u64) -> u64 {
  let at_ok: bool = at <= capacity;
  let remaining: u64 = capacity - at;
  let length_ok: bool = n <= remaining;
  let fits: bool = at_ok and length_ok;
  if fits == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let end: u64 = loop put(k: u64 = 0, j: u64 = at) {
    let more: bool = k < n;
    if more {
      let p: addr = src + k;
      let b: u8 = load(p);
      let q: addr = buf + j;
      store(q, b);
      continue put(k + 1, j + 1);
    } else {
      break put(j);
    }
  };
  return end;
}

// --- 路径规范化 -----------------------------------------------------------

// 逻辑路径末尾是不是已经写了 `.lain`？
func meta_ends_with_lain(logical: addr, len: u64) -> bool {
  let enough: bool = len >= 5;
  if enough == 0 { return 0; }
  let off: u64 = len - 5;
  let p: addr = logical + off;
  let suf: addr = symbol_addr("meta_suffix_lain_storage");
  let eq: bool = std_types.meta_bytes_equal(p, suf, 5);
  return eq;
}

// 虚拟拼接流「dir + 斜杠 + logical[from..len)」的第 k 个字节。dir_len == 0 表示没有
// 前缀，这时第 k 个字节就是 logical[from + k]。
func meta_rel_byte(dir: addr, dir_len: u64, logical: addr, from: u64, len: u64, k: u64) -> u8 {
  let no_dir: bool = dir_len == 0;
  if no_dir { return std_lex.bs_byte_at(logical, from + k, len); }
  let in_dir: bool = k < dir_len;
  if in_dir { return load(dir + k); }
  let at_slash: bool = k == dir_len;
  if at_slash { return 47; }
  let off: u64 = k - dir_len - 1;
  return std_lex.bs_byte_at(logical, from + off, len);
}

// 虚拟流第 k 个字节属于哪个真实字符串的哪个下标。dir_len == 0 时没有前缀，
// 第 k 个字节就是 logical[from + k]；否则前 dir_len 个字节在 dir 里、第 dir_len 个
// 是斜杠、之后的字节在 logical 里且要跳过那个斜杠。
func meta_rel_addr(dir: addr, dir_len: u64, logical: addr, from: u64, k: u64) -> addr {
  let no_dir: bool = dir_len == 0;
  if no_dir {
    let at: u64 = from + k;
    return logical + at;
  }
  let in_dir: bool = k < dir_len;
  if in_dir { return dir + k; }
  let soff: u64 = k - dir_len - 1;
  let spec_at: u64 = from + soff;
  return logical + spec_at;
}

// dir_len == 0 时虚拟流的总长度；否则是 dir + 斜杠 + 说明符。
func meta_rel_len(dir_len: u64, len: u64, from: u64) -> u64 {
  let spec_len: u64 = len - from;
  let no_dir: bool = dir_len == 0;
  let total: u64 = if no_dir { spec_len } else { dir_len + 1 + spec_len };
  return total;
}

// 说明符那一段（不含目录前缀）自己写了 .lain 吗？
func meta_spec_has_lain(logical: addr, from: u64, len: u64) -> bool {
  let spec_len: u64 = len - from;
  let enough: bool = spec_len >= 5;
  if enough == 0 { return 0; }
  let at: u64 = from + (spec_len - 5);
  let p: addr = logical + at;
  let suf: addr = symbol_addr("meta_suffix_lain_storage");
  return std_types.meta_bytes_equal(p, suf, 5);
}

// 把「dir + 斜杠 + logical[from..len)」规范化成注册路径写进 buf（NUL 结尾）。
// 双冒号对斜杠；点段丢弃；双点段吃掉上一段（上一段也是双点就照留）；重复斜杠
// 折叠；首字节是斜杠的保留一个前导斜杠。说明符自己没写 .lain 就补上。
// dir_len == 0 表示没有前缀。越界返回 17，调用方保证 buf 够大。
func meta_build_rel(dir: addr, dir_len: u64, logical: addr, from: u64, len: u64, buf: addr, capacity: u64) -> u32 {
  let tlen: u64 = meta_rel_len(dir_len, len, from);
  let has: bool = meta_spec_has_lain(logical, from, len);
  let suffix: u64 = if has { 0 } else { 5 };
  let need: u64 = tlen + suffix + 1;
  let fits: bool = need <= capacity;
  if fits == 0 { return 17; }
  let empty: bool = tlen == 0;
  let first: u8 = if empty { 0 } else { meta_rel_byte(dir, dir_len, logical, from, len, 0) };
  let fu: u32 = first as u32;
  let abs: bool = fu == 47;
  let head: u32 = if abs { meta_buf_put(buf, capacity, 0, 47) } else { 0 };
  if head != 0 { return head; }
  let j0: u64 = if abs { 1 } else { 0 };
  let j: u64 = loop put(k: u64 = 0, j: u64 = j0) {
    let past: bool = k >= tlen;
    if past { break put(j); }
    let raw: u8 = meta_rel_byte(dir, dir_len, logical, from, len, k);
    let rawu: u32 = raw as u32;
    let colon: bool = rawu == 58;
    if colon {
      let k1: u64 = k + 1;
      let two: u8 = meta_rel_byte(dir, dir_len, logical, from, len, k1);
      let twou: u32 = two as u32;
      let also: bool = twou == 58;
      let adv: u64 = if also { 2 } else { 1 };
      continue put(k + adv, j);
    }
    let slash: bool = rawu == 47;
    if slash { continue put(k + 1, j); }
    // 一段普通字节，直到下一个分隔符。
    let seg_end: u64 = loop seg(e: u64 = k) {
      let epast: bool = e >= tlen;
      if epast { break seg(e); }
      let eb: u8 = meta_rel_byte(dir, dir_len, logical, from, len, e);
      let ebu: u32 = eb as u32;
      let eslash: bool = ebu == 47;
      let ecolon: bool = ebu == 58;
      let esep: bool = eslash or ecolon;
      if esep { break seg(e); }
      continue seg(e + 1);
    };
    let seg_len: u64 = seg_end - k;
    let one: bool = seg_len == 1;
    if one {
      let db: u8 = meta_rel_byte(dir, dir_len, logical, from, len, k);
      let dbu: u32 = db as u32;
      let dot: bool = dbu == 46;
      if dot { continue put(seg_end, j); }
    }
    let two_long: bool = seg_len == 2;
    if two_long {
      let d0: u8 = meta_rel_byte(dir, dir_len, logical, from, len, k);
      let d0u: u32 = d0 as u32;
      let k1: u64 = k + 1;
      let d1: u8 = meta_rel_byte(dir, dir_len, logical, from, len, k1);
      let d1u: u32 = d1 as u32;
      let dots: bool = (d0u == 46) and (d1u == 46);
      if dots {
        let back: u64 = loop pop(q: u64 = j) {
          let stop: bool = q <= j0;
          if stop { break pop(j0); }
          let q1: u64 = q - 1;
          let cb: u8 = load(buf + q1);
          let cbu: u32 = cb as u32;
          if cbu == 47 { break pop(q1); }
          continue pop(q1);
        };
        continue put(seg_end, back);
      }
    }
    let sep: u32 = if j > j0 { meta_buf_put(buf, capacity, j, 47) } else { 0 };
    if sep != 0 { return sep; }
    let j1: u64 = if j > j0 { j + 1 } else { j };
    let src: addr = meta_rel_addr(dir, dir_len, logical, from, k);
    let j2: u64 = meta_buf_puts(buf, capacity, j1, src, seg_len);
    let failed: bool = j2 == 0xFFFFFFFFFFFFFFFF;
    if failed { return 17; }
    continue put(seg_end, j2);
  };
  let end: u64 = loop pick_end(t: u64 = 0) {
    if has { break pick_end(j); }
    let suf: addr = symbol_addr("meta_suffix_lain_storage");
    let e: u64 = meta_buf_puts(buf, capacity, j, suf, 5);
    break pick_end(e);
  };
  let zero: u32 = meta_buf_put(buf, capacity, end, 0);
  if zero != 0 { return zero; }
  return 0;
}

// 没有目录前缀的规范化（说明符按源根相对解释）。
func meta_build_path(logical: addr, len: u64, buf: addr, capacity: u64) -> u32 {
  return meta_build_rel(buf, 0, logical, 0, len, buf, capacity);
}

// NUL 结尾路径里最后一个斜杠的下标（没有就 0）。目录前缀是 path[0..dir_len)。
func meta_dir_len(path: addr) -> u64 {
  let r: u64 = loop scan(i: u64 = 0, n: u64 = 0) {
    let b: u8 = load(path + i);
    let bu: u32 = b as u32;
    let done: bool = bu == 0;
    if done { break scan(n); }
    let is_slash: bool = bu == 47;
    let n2: u64 = if is_slash { i } else { n };
    continue scan(i + 1, n2);
  };
  return r;
}

// 说明符里最后一处双冒号的首字节下标；没有返回 NOT_FOUND。
func meta_last_dsep(logical: addr, len: u64) -> u64 {
  let r: u64 = loop scan(i: u64 = 0, last: u64 = 0xFFFFFFFFFFFFFFFF) {
    let past: bool = i >= len;
    if past { break scan(last); }
    let c0: bool = std_lex.bs_is_byte(logical, i, 58);
    let i1: u64 = i + 1;
    let c1: bool = std_lex.bs_is_byte(logical, i1, 58);
    let hit: bool = c0 and c1;
    let last2: u64 = if hit { i } else { last };
    continue scan(i + 1, last2);
  };
  return r;
}

// 注册表里等于 path 的源码下标；没有返回 NOT_FOUND。
func meta_registered_match(path: addr, count: u64) -> u64 {
  let r: u64 = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let p: addr = lain_meta_source_path_data(i);
      let same: bool = meta_cstr_equal(p, path);
      if same { break s(i); }
      continue s(i + 1);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return r;
}
// --- 查注册表 -------------------------------------------------------------

// 说明符 → 源码下标；找不到返回 NOT_FOUND。
//
// 候选按序取第一个命中，三条都在同一个私有缓冲里算：
//   (a) 导入方目录 + 斜杠 + 整条说明符
//   (b) 导入方目录 + 斜杠 + 说明符最后一处双冒号之后的末段
//   (c) 说明符按源根相对解释
// 导入方是 `meta_scope_current()` 那份源码的登记路径。缓冲从 bump 动态区要，用完
// 立刻还：352 字节的 meta_path_buf 是别的发射器的临时名字区，不能借。
func meta_source_find(logical: addr, logical_len: u64) -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  let cap_ad: addr = std_registry.meta_path_cap;
  let cap: u64 = std_types.meta_cell_get(cap_ad);
  let need: u64 = logical_len + 6;
  let fits: bool = need <= cap;
  if fits == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let count: u64 = lain_meta_source_count();
  let mark: u64 = std_scope.meta_bump_mark();
  let off: u64 = std_scope.meta_bump_alloc(cap);
  let no_space: bool = off == 0xFFFFFFFFFFFFFFFF;
  if no_space { return 0xFFFFFFFFFFFFFFFF; }
  let buf: addr = scratch + off;
  let cur: u64 = std_scope.meta_scope_current();
  let no_cur: bool = cur >= count;
  // 候选的命中下标与「还要不要再试」都放进参数组格子；每个分支结束时只赋值、不提前返回，
  // 最后统一释放缓冲。
  let hit_a: u64 = loop pick_a(h: u64 = 0xFFFFFFFFFFFFFFFF) {
    if no_cur { break pick_a(0xFFFFFFFFFFFFFFFF); }
    let path: addr = lain_meta_source_path_data(cur);
    let dlen: u64 = meta_dir_len(path);
    let ba: u32 = meta_build_rel(path, dlen, logical, 0, logical_len, buf, cap);
    let ha: u64 = meta_registered_match(buf, count);
    break pick_a(ha);
  };
  let hit_b: u64 = loop pick_b(h: u64 = 0xFFFFFFFFFFFFFFFF) {
    let found_a: bool = hit_a != 0xFFFFFFFFFFFFFFFF;
    if found_a { break pick_b(hit_a); }
    if no_cur { break pick_b(0xFFFFFFFFFFFFFFFF); }
    let last: u64 = meta_last_dsep(logical, logical_len);
    let no_sep: bool = last == 0xFFFFFFFFFFFFFFFF;
    if no_sep { break pick_b(0xFFFFFFFFFFFFFFFF); }
    let path: addr = lain_meta_source_path_data(cur);
    let dlen: u64 = meta_dir_len(path);
    let from: u64 = last + 2;
    let bb: u32 = meta_build_rel(path, dlen, logical, from, logical_len, buf, cap);
    let hb: u64 = meta_registered_match(buf, count);
    let found_b: bool = hb != 0xFFFFFFFFFFFFFFFF;
    let h2: u64 = if found_b { hb } else { 0xFFFFFFFFFFFFFFFF };
    break pick_b(h2);
  };
  let hit_c: u64 = loop pick_c(h: u64 = 0xFFFFFFFFFFFFFFFF) {
    let found_b: bool = hit_b != 0xFFFFFFFFFFFFFFFF;
    if found_b { break pick_c(hit_b); }
    let bc: u32 = meta_build_path(logical, logical_len, buf, cap);
    let hc: u64 = meta_registered_match(buf, count);
    break pick_c(hc);
  };
  let relc: u32 = std_scope.meta_bump_release(mark);
  return hit_c;
}

// --- import 的语法与降级 ---------------------------------------------------

// 从 `import` 的位置往下读 `("逻辑路径")`，返回逻辑路径首字节的下标；
// 形状不对返回 NOT_FOUND。
func meta_import_logical(base: addr, len: u64, kw_at: u64) -> u64 {
  let p: u64 = kw_at + 6;
  let p1: u64 = std_lex.bs_skip_space(base, p, len);
  let open: bool = std_lex.bs_is_byte(base, p1, 40);
  if open == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let q1: u64 = p1 + 1;
  let quote: bool = std_lex.bs_is_byte(base, q1, 34);
  if quote == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let start: u64 = q1 + 1;
  return start;
}

// 逻辑路径到收尾引号为止的长度。
func meta_logical_len(base: addr, from: u64, len: u64) -> u64 {
  let n: u64 = loop scan(i: u64 = from) {
    let b: u8 = std_lex.bs_byte_at(base, i, len);
    let bw: u32 = b as u32;
    let stop: bool = bw == 34;
    let past: bool = i >= len;
    let done: bool = stop or past;
    if done {
      break scan(i);
    }
    continue scan(i + 1);
  };
  let r: u64 = n - from;
  return r;
}

// 按绑定名找回它的 import 逻辑路径下标（== `let M = import("...")` 里引号内的起点）。
// 查**作用域表**：命中的条目 kind 必须是 1（模块引用），逻辑路径位置记在 aux。
// 不是模块引用、或表里没有，都返回 0（「没找到」的哨兵——引号位置永远大于 0）。
func meta_find_import_binding(base: addr, len: u64, ns_lo: u64, ns_hi: u64) -> u64 {
  let name: addr = base + ns_lo;
  let name_len: u64 = ns_hi - ns_lo;
  let i: u64 = std_scope.meta_scope_find(name, name_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0;
  }
  let kind: u64 = std_scope.meta_scope_kind(i);
  let is_ns: bool = kind == 1;
  if is_ns == 0 {
    return 0;
  }
  let aux: u64 = std_scope.meta_scope_aux(i);
  return aux;
}

// 把一个模块里**全部值绑定**的过程发出来（名字是 `<mangle>__<成员>`），按声明顺序。
//
// 为什么在 import 声明处一次发完：过程只能落在顶层。表达式里的 `M.x` 处在函数体
// 里，那一刻已经没有位置插一条 `#proc`。导入时发完，用到时只管 `#call`。
func meta_emit_module_exports(m_base: addr, m_len: u64, idx: u64, mag: addr, mag_len: u64) -> u32 {
  let count: u64 = std_scope.meta_scope_count();
  let r: u32 = loop ex(k: u64 = 0) {
    let more: bool = k < count;
    if more {
      let src: u64 = std_scope.meta_scope_word(k, 0);
      let same: bool = src == idx;
      let kind: u64 = std_scope.meta_scope_word(k, 24);
      let isval: bool = kind == 3;
      let hit: bool = same and isval;
      if hit {
        let n_off: u64 = std_scope.meta_scope_word(k, 8);
        let n_len: u64 = std_scope.meta_scope_word(k, 16);
        let name: addr = m_base + n_off;
        let e: u32 = meta_emit_module_binding(m_base, m_len, name, n_len, mag, mag_len);
        if e != 0 {
          break ex(e);
        }
        continue ex(k + 1);
      }
      continue ex(k + 1);
    } else {
      break ex(0);
    }
  };
  return r;
}

// `let NAME = import("逻辑路径");` —— 解析并登记。
//
// 被导入模块的绑定**属于它自己的单元**：lain0 --split 每个模块一份产物，跨模块
// 引用按 `<键>__<成员>` 落到依赖单元里。这里再发一遍就会与依赖单元的同名过程
// 撞车（校验报 2022 duplicate subroutine）。
func meta_lower_import(base: addr, len: u64, eq_at: u64) -> u32 {
  let one: u64 = eq_at + 1;
  let kw_at: u64 = std_lex.bs_skip_space(base, one, len);
  let lp: u64 = meta_import_logical(base, len, kw_at);
  let bad: bool = lp == 0xFFFFFFFFFFFFFFFF;
  if bad {
    let f0: u32 = lain_meta_fail(11);
    return 11;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let m_base: addr = lain_meta_source_data(idx);
  let m_len: u64 = lain_meta_source_length(idx);
  let pat: u64 = std_scope.meta_path_buffer();
  let scratch: addr = lain_meta_scratch_data();
  let buf: addr = scratch + pat;
  // 键从**解析到的模块路径**算（不是 import 说明符）：见 meta_build_mangle。
  let mag_len: u64 = meta_module_key(idx, buf);
  // 模块那一层压进链，扫一次（见 meta_scope_has_source 的注释），发完全部值
  // 绑定的过程，再把当前源码换回去。
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let already: bool = std_scope.meta_scope_has_source(idx);
  // 已扫过就不扫：只有没扫过才调 meta_scope_count / meta_scope_scan。
  let ready: u32 = loop pick_ready(t: u32 = 0) {
    if already { break pick_ready(0); }
    let mark: u64 = std_scope.meta_scope_count();
    let scan: u32 = std_scope.meta_scope_scan(m_base, m_len, idx, mark);
    break pick_ready(scan);
  };
  if ready != 0 {
    let rest0: u32 = std_scope.meta_scope_set_current(old_src);
    return ready;
  }
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  return rest;
}

// --- 命名空间成员：`M.x` ----------------------------------------------------
//
// LAINIR 的名字是扁平的，所以命名空间成员要 **mangle 成扁平名**才落得到物理层：
//
//   std/types.lain 里的 meta_bytes_equal   →   std_types__meta_bytes_equal
//
// 规则与 lain0 的 `Program::keyOf`（seed/lain0/src/Sema.cpp）**逐字一致**：
// 模块键 = 模块**解析到的路径**（源根相对路径）去结尾 `.lain`、每个 `/` 换一个 `_`。
// 再拼 `__` 和成员名。
//
// 键从**解析到的模块**算：说明符里的 `::`、相对段、省掉的 `.lain` 只参与解析，
// 键使用解析后的扁平名。

// NUL 结尾字符串的字节数（不含结尾 NUL）。登记的逻辑路径就是这种串。
func meta_path_len(p: addr) -> u64 {
  let n: u64 = loop scan(i: u64 = 0) {
    let b: u8 = load(p + i);
    let bw: u32 = b as u32;
    let stop: bool = bw == 0;
    if stop { break scan(i); }
    continue scan(i + 1);
  };
  return n;
}

// 模块路径 → 模块键，写进 buf，返回长度。去结尾 `.lain`（长度够时）、`/`→`_`。
func meta_build_mangle(path: addr, len: u64, buf: addr) -> u64 {
  let has_suffix: bool = meta_ends_with_lain(path, len);
  let body: u64 = loop pick_body(t: u64 = 0) {
    if has_suffix == 0 { break pick_body(len); }
    let five: u64 = len - 5;
    break pick_body(five);
  };
  let j: u64 = loop put(i: u64 = 0, j: u64 = 0) {
    let more: bool = i < body;
    if more {
      let is_slash: bool = std_lex.bs_is_byte(path, i, 47);
      let raw: u8 = std_lex.bs_byte_at(path, i, body);
      let out: u8 = if is_slash { 95 } else { raw };
      let p: addr = buf + j;
      store(p, out);
      continue put(i + 1, j + 1);
    } else {
      break put(j);
    }
  };
  return j;
}

// 源码 idx 的**模块键**（写进 buf，返回长度）：键从它解析到的路径算，见 meta_build_mangle。
// import 站（`M.x`）与「单元自己的顶层名」两处都用它。
func meta_module_key(idx: u64, buf: addr) -> u64 {
  let path: addr = lain_meta_source_path_data(idx);
  let len: u64 = meta_path_len(path);
  let k: u64 = meta_build_mangle(path, len, buf);
  return k;
}


// 发「被导入的绑定」本身：`#proc <mangle>__<member>() -> #bits<64> { #return v }`
// member 是**调用方源码里**写的那个名字（用户写的是 `M.answer`，输出里就该是
// `answer`），只有值来自被导入的源码。
func meta_emit_exported(mag: addr, mag_len: u64, b_base: addr, b_lo: u64, b_hi: u64, value: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let dsep: addr = std_emit.meta_dsep;
  let a1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let a2: u64 = std_lainir.lainir_buf_bytes(buf, a1, dsep, 2);
  let at: addr = b_base + b_lo;
  let n: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(buf, a2, at, n);
  let h: u32 = std_lainir.lainir_proc_head_full(buf, nlen, buf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let r: u32 = std_lainir.lainir_return_uint(value);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 发调用方：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
func meta_emit_ns_call(b_base: addr, b_lo: u64, b_hi: u64, kind: u64, width: u64, mag: addr, mag_len: u64, m_base: addr, m_lo: u64, m_hi: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let nbuf: addr = buf + 128;
  let bat: addr = b_base + b_lo;
  let bn: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(nbuf, 0, bat, bn);
  let h: u32 = std_lainir.lainir_proc_head_full(nbuf, nlen, nbuf, 0, kind, width);
  let o: u32 = std_lainir.lainir_open_body();
  let dsep: addr = std_emit.meta_dsep;
  let c1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(buf, c1, dsep, 2);
  let mat: addr = m_base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(buf, c2, mat, mn);
  let r: u32 = std_lainir.lainir_ret_call(buf, clen, buf, 0);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 模块**内部**的一条绑定调用同一个模块里的另一条：
//   `#proc <mangle>__<b>() -> #bits<64> { #return #call <mangle>__<a>() }`
//
// 和 `meta_emit_ns_call` 的区别：那个是给调用方用的，只有被调方带 mangle；这里
// 两边都是模块自己的绑定，**两个名字都要带前缀**。
func meta_emit_module_call(m_base: addr, b_lo: u64, b_hi: u64, mag: addr, mag_len: u64, m_lo: u64, m_hi: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let nbuf: addr = buf + 128;
  let dsep: addr = std_emit.meta_dsep;
  let n1: u64 = std_lainir.lainir_buf_bytes(nbuf, 0, mag, mag_len);
  let n2: u64 = std_lainir.lainir_buf_bytes(nbuf, n1, dsep, 2);
  let bat: addr = m_base + b_lo;
  let bn: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(nbuf, n2, bat, bn);
  let h: u32 = std_lainir.lainir_proc_head_full(nbuf, nlen, nbuf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let c1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(buf, c1, dsep, 2);
  let mat: addr = m_base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(buf, c2, mat, mn);
  let r: u32 = std_lainir.lainir_ret_call(buf, clen, buf, 0);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// `<mangle>__<名字>` 过程名渲染进 buf，返回长度。
func meta_module_proc_symbol(mag: addr, mag_len: u64, base: addr, b_lo: u64, b_hi: u64, buf: addr) -> u64 {
  let dsep: addr = std_emit.meta_dsep;
  let s1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let s2: u64 = std_lainir.lainir_buf_bytes(buf, s1, dsep, 2);
  let n_at: addr = base + b_lo;
  let s3: u64 = std_lainir.lainir_buf_bytes(buf, s2, n_at, b_hi - b_lo);
  return s3;
}

// 导出模块里的静态表绑定：发数据块 `<键>__<名字>_storage` 加取址过程
// `<键>__<名字>()`。数据块的元素字节数在作用域条目的 emitted 里（建表时写入）。
func meta_emit_module_table(m_base: addr, m_len: u64, i: u64, n_off: u64, n_hi: u64, init: u64, mag: addr, mag_len: u64) -> u32 {
  let scratch: addr = lain_meta_scratch_data();
  let pat: u64 = std_scope.meta_path_buffer();
  let pbuf: addr = scratch + pat;
  let sbuf: addr = pbuf + 256;
  let dsym: u64 = meta_module_data_symbol(mag, mag_len, m_base, n_off, n_hi - n_off, sbuf);
  let psym: u64 = meta_module_proc_symbol(mag, mag_len, m_base, n_off, n_hi, pbuf);
  // 标注里有没有 `ro`：在名字末尾与 `=` 之间扫一遍。
  let is_ro: bool = loop ro_scan(k: u64 = n_hi) {
    let more: bool = k < init;
    if more {
      let hit: bool = std_lex.bs_match_keyword(m_base, k, m_len, std_lex.meta_kw_ro, 2);
      if hit { break ro_scan(1); }
      continue ro_scan(k + 1);
    } else {
      break ro_scan(0);
    }
  };
  let h0: u32 = std_lainir.lainir_data_head();
  // 数据头自己会补 \`_storage\`，这里只写过程名那一段。
  let h1: u32 = std_lainir.lainir_write(pbuf, psym);
  let h2: u32 = if is_ro { std_lainir.lainir_data_ro_storage_head() } else { std_lainir.lainir_data_rw_head() };
  let elt_node: u64 = std_scope.meta_scope_payload(i);
  let cnt: u64 = std_parse.ast_child_count(elt_node);
  let esz: u64 = std_scope.meta_scope_emitted(i);
  let body: u32 = loop elems(k: u64 = 0) {
    let more: bool = k < cnt;
    if more {
      let c: u64 = std_parse.ast_child(elt_node, k);
      let c_lo: u64 = std_parse.meta_node_start(c);
      let fb: u8 = std_lex.bs_byte_at(m_base, c_lo, m_len);
      let is_comma: bool = fb == 44;
      if is_comma {
        continue elems(k + 1);
      } else {
        let val: u64 = std_lex.bs_read_uint(m_base, c_lo, m_len);
        let bytes_st: u32 = loop emit_elt(j: u64 = 0) {
          let jmore: bool = j < esz;
          if jmore {
            let shift: u64 = j * 8;
            let shr: u64 = val >> shift;
            let bv: u64 = shr and 255;
            let w0: u32 = std_lainir.lainir_emit_uint(bv);
            let w1: u32 = std_lainir.lainir_space_write();
            continue emit_elt(j + 1);
          } else {
            break emit_elt(0);
          }
        };
        continue elems(k + 1);
      }
    } else {
      break elems(0);
    }
  };
  let h3: u32 = std_lainir.lainir_data_close();
  let p0: u32 = std_lainir.lainir_proc_head_full(pbuf, psym, pbuf, 0, 3, 0);
  let p1: u32 = std_lainir.lainir_open_body();
  let p2: u32 = std_lainir.lainir_base_assign_write();
  let p3: u32 = std_lainir.lainir_write(sbuf, dsym);
  let p4: u32 = std_lainir.lainir_write(std_lainir.lainir_rparen_nl, 2);
  let p5: u32 = std_lainir.lainir_return_base_close();
  return 0;
}

// 导出模块里的取址绑定：`let X: addr = symbol_addr("名字[_storage]")`。
func meta_emit_module_symbol(m_base: addr, m_len: u64, n_off: u64, n_hi: u64, init: u64, mag: addr, mag_len: u64) -> u32 {
  let q0: u64 = std_lex.bs_skip_space(m_base, init + 11, m_len);
  let arg_at: u64 = std_lex.bs_skip_space(m_base, q0 + 1, m_len);
  let inner: u64 = arg_at + 1;
  let close: u64 = loop find_close(j: u64 = inner) {
    let more: bool = j < m_len;
    if more {
      let b: u8 = std_lex.bs_byte_at(m_base, j, m_len);
      let is_q: bool = b == 34;
      if is_q { break find_close(j); }
      continue find_close(j + 1);
    } else {
      break find_close(inner);
    }
  };
  let raw: u64 = close - inner;
  let room: bool = raw >= 8;
  let suf_at_off: u64 = close - 8;
  let suf_at: addr = m_base + suf_at_off;
  let suffix: bool = if room { std_types.meta_bytes_equal(suf_at, std_lex.meta_bs_storage, 8) } else { 0 };
  let use_len: u64 = if suffix { raw - 8 } else { raw };
  let scratch: addr = lain_meta_scratch_data();
  let pat: u64 = std_scope.meta_path_buffer();
  let pbuf: addr = scratch + pat;
  let sbuf: addr = pbuf + 256;
  let dsym: u64 = meta_module_data_symbol(mag, mag_len, m_base, inner, use_len, sbuf);
  let psym: u64 = meta_module_proc_symbol(mag, mag_len, m_base, n_off, n_hi, pbuf);
  let h0: u32 = std_lainir.lainir_proc_head_full(pbuf, psym, pbuf, 0, 3, 0);
  let h1: u32 = std_lainir.lainir_open_body();
  let tn: u64 = meta_emit_data_addr_line(sbuf, dsym);
  let h2: u32 = std_lainir.lainir_return_write();
  let h3: u32 = std_lainir.lainir_temp_name_emit(tn);
  let h4: u32 = std_lainir.lainir_newline_write();
  let h5: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 发出模块里的一条值绑定，名字是 `<mangle>__<名字>`。
//
// 初始化式有两种形状（v0）：
//   数字 → 一个字面量
//   标识符 → **同一个模块里的另一条绑定**：先把那条递归发出来，再发调用它的这条
//
// 同一个绑定被引用两次只会发一次：条目里的 `emitted` 是防重入的标记，先置位再
// 展开函数体，所以自引用也不会转圈。遇到别的形状报 4。
func meta_emit_module_binding(m_base: addr, m_len: u64, name_addr: addr, name_len: u64, mag: addr, mag_len: u64) -> u32 {
  let i: u64 = std_scope.meta_scope_find(name_addr, name_len);
  let gone: bool = i == 0xFFFFFFFFFFFFFFFF;
  if gone {
    let f0: u32 = lain_meta_fail(13);
    return 13;
  }
  let kind: u64 = std_scope.meta_scope_kind(i);
  let is_value: bool = kind == 3;
  let is_func: bool = kind == 6;
  if is_func {
    // 函数成员的过程体就在模块自己的单元里，调用方直接发 #call，这里没有要发的东西。
    return 0;
  }
  if is_value == 0 {
    // v0：模块里能取用的只有值绑定与函数。取一个标量类型或别的，报 4。
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let done: u64 = std_scope.meta_scope_exported(i);
  let skip: bool = done != 0;
  if skip {
    return 0;
  }
  let mark: u32 = std_scope.meta_scope_set_exported(i, 1);
  // 名字在模块源码里的位置：条目里存着
  let n_off: u64 = std_scope.meta_scope_word(i, 8);
  let n_len: u64 = std_scope.meta_scope_word(i, 16);
  let n_hi: u64 = n_off + n_len;
  // 初始化式的**节点下标**：条目里存着。位置的直接读节点，不用 skip。
  let init_node: u64 = std_scope.meta_scope_payload(i);
  let init: u64 = std_parse.meta_node_start(init_node);
  let init_len: u64 = std_parse.meta_node_len(init_node);
  let init_hi: u64 = init + init_len;
  let first: u8 = std_lex.bs_byte_at(m_base, init, m_len);
  let first32: u32 = first as u32;
  let is_tbl: bool = first32 == 91;
  if is_tbl {
    let et: u32 = meta_emit_module_table(m_base, m_len, i, n_off, n_hi, init, mag, mag_len);
    return et;
  }
  let is_symaddr: bool = std_lex.bs_match_keyword(m_base, init, m_len, std_lex.meta_kw_symbol_addr, 11);
  if is_symaddr {
    let es: u32 = meta_emit_module_symbol(m_base, m_len, n_off, n_hi, init, mag, mag_len);
    return es;
  }
  let is_num: bool = std_lex.bs_is_digit(first);
  if is_num {
    let value: u64 = std_lex.bs_read_uint(m_base, init, m_len);
    let e0: u32 = meta_emit_exported(mag, mag_len, m_base, n_off, n_hi, value);
    return e0;
  }
  // 标识符：同模块里的另一条绑定。引用的名字就是那个节点本身。
  let ref_v: addr = m_base + init;
  let ref_len: u64 = init_hi - init;
  let e1: u32 = meta_emit_module_binding(m_base, m_len, ref_v, ref_len, mag, mag_len);
  let bad: bool = e1 != 0;
  if bad {
    return e1;
  }
  let e2: u32 = meta_emit_module_call(m_base, n_off, n_hi, mag, mag_len, init, init_hi);
  return e2;
}

// `let NAME = M.member;` —— 解析命名空间绑定，**进入那个模块的作用域**去取成员。
//
// 关键在这里：取成员时要压入模块自己那一层（链变成 [root, 那个模块]），所以模块
// 内部 `let b = a;` 里的 `a` 能解析到同一个模块里的 `a`。
func meta_lower_ns_value(base: addr, len: u64, bind_lo: u64, bind_hi: u64, ns_lo: u64, ns_hi: u64, m_lo: u64, m_hi: u64, kind: u64, width: u64) -> u32 {
  let lp: u64 = meta_find_import_binding(base, len, ns_lo, ns_hi);
  let nons: bool = lp == 0;
  if nons {
    // `M` 不是这条源码里的 import 绑定
    let f0: u32 = lain_meta_fail(12);
    return 12;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let m_base: addr = lain_meta_source_data(idx);
  let m_len: u64 = lain_meta_source_length(idx);
  let scratch: addr = lain_meta_scratch_data();
  let pat: u64 = std_scope.meta_path_buffer();
  let buf: addr = scratch + pat;
  let mag_len: u64 = meta_module_key(idx, buf);

  // 切到模块那一层；**扫一次就留着**（见 meta_scope_has_source 的注释）。
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let already: bool = std_scope.meta_scope_has_source(idx);
  let ready: u32 = loop pick_ready(t: u32 = 0) {
    if already { break pick_ready(0); }
    let mark: u64 = std_scope.meta_scope_count();
    let scan: u32 = std_scope.meta_scope_scan(m_base, m_len, idx, mark);
    break pick_ready(scan);
  };
  if ready != 0 {
    let rest0: u32 = std_scope.meta_scope_set_current(old_src);
    return ready;
  }
  // 成员名写在**调用方**的源码里，值在模块的源码里
  let m_name: addr = base + m_lo;
  let m_name_len: u64 = m_hi - m_lo;
  let e1: u32 = meta_emit_module_binding(m_base, m_len, m_name, m_name_len, buf, mag_len);
  // 调用方那条：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
  let e2: u32 = meta_emit_ns_call(base, bind_lo, bind_hi, kind, width, buf, mag_len, base, m_lo, m_hi);
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  let bad: bool = e1 != 0;
  if bad {
    return e1;
  }
  return e2;
}

// `M.answer` 当操作数用（`M.answer + 1`、`f(M.answer)`、`let x = M.answer + 2;`）：
// 发一次 `  %r<n> = #call <mangle>__<成员>()`，把临时值下标写进暂存区 +168。
//
// 成员的过程已经在 import 声明处发过（`meta_emit_module_exports`），所以这里只发
// 调用；再确认一下成员确实在模块表里、是值绑定，缺失或不是值绑定分别报 13 / 4。
// 发 `  %r<n> = #bitcast[#addr](%<符号>)`，回临时编号。符号名在同一个文件里。
func meta_emit_data_addr_line(symbol: addr, symbol_len: u64) -> u64 {
  let indent: addr = std_lainir.lainir_indent;
  let w0: u32 = std_lainir.lainir_write(indent, 2);
  let tn: u64 = std_funcs.meta_next_temp();
  let pct: addr = std_lainir.lainir_pct_r;
  let w1: u32 = std_lainir.lainir_write(pct, 2);
  let w2: u32 = std_lainir.lainir_emit_uint(tn);
  let assign: addr = std_lainir.lainir_assign;
  let w3: u32 = std_lainir.lainir_write(assign, 4);
  let head: addr = std_lainir.lainir_bitcast_addr_head;
  let w4: u32 = std_lainir.lainir_write(head, 16);
  let w5: u32 = std_lainir.lainir_write(symbol, symbol_len);
  let w6: u32 = std_lainir.lainir_write(std_lainir.lainir_rparen_nl, 2);
  return tn;
}

// 模块 idx 里名字为 name 的静态数据块，符号 `<键>__<名字>_storage` 写进 buf，返回长度。
func meta_module_data_symbol(mag: addr, mag_len: u64, base: addr, m_lo: u64, m_len: u64, buf: addr) -> u64 {
  let dsep: addr = std_emit.meta_dsep;
  let s1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let s2: u64 = std_lainir.lainir_buf_bytes(buf, s1, dsep, 2);
  // 名字取模块**自己的**源码：调用方同一个名字在两边字节一样，但归属要写清楚。
  let n_at: addr = base + m_lo;
  let s3: u64 = std_lainir.lainir_buf_bytes(buf, s2, n_at, m_len);
  let s4: u64 = std_lainir.lainir_buf_bytes(buf, s3, std_lex.meta_bs_storage, 8);
  return s4;
}

// 跨模块静态表的取址：发一条 `%r<n> = #bitcast[#addr](%<键>__<成员>_storage)`，
// 临时号与元素字节数、元素个数分别另存 3936 / 3944 / 3952。
func meta_emit_ns_static_addr(base: addr, len: u64, ns_lo: u64, ns_hi: u64, m_lo: u64, m_hi: u64) -> u32 {
  let lp: u64 = meta_find_import_binding(base, len, ns_lo, ns_hi);
  let nons: bool = lp == 0;
  if nons {
    let f0: u32 = lain_meta_fail(12);
    return 12;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let pat: u64 = std_scope.meta_path_buffer();
  let scratch: addr = lain_meta_scratch_data();
  let buf: addr = scratch + pat;
  let mag_len: u64 = meta_module_key(idx, buf);
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let mname: addr = base + m_lo;
  let mnlen: u64 = m_hi - m_lo;
  let mi: u64 = std_scope.meta_scope_find(mname, mnlen);
  let chk: u32 = loop ns_chk(t: u32 = 0) {
    let found: bool = mi != 0xFFFFFFFFFFFFFFFF;
    if found == 0 {
      let fm: u32 = lain_meta_fail(13);
      break ns_chk(13);
    }
    let mk: u64 = std_scope.meta_scope_kind(mi);
    let isv: bool = mk == 3;
    if isv == 0 {
      let fk: u32 = lain_meta_fail(4);
      break ns_chk(4);
    }
    let me: u64 = std_scope.meta_scope_emitted(mi);
    let me0: bool = me == 0;
    if me0 {
      let fe: u32 = lain_meta_fail(4);
      break ns_chk(4);
    }
    break ns_chk(0);
  };
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  let bad: bool = chk != 0;
  if bad {
    return chk;
  }
  let esz: u64 = std_scope.meta_scope_emitted(mi);
  let cnt: u64 = std_scope.meta_scope_aux(mi);
  let tybuf: addr = scratch + 3936;
  let tsym: u64 = meta_module_data_symbol(buf, mag_len, base, m_lo, mnlen, tybuf);
  let ttn: u64 = meta_emit_data_addr_line(tybuf, tsym);
  let q1: u32 = std_types.meta_cell_put(scratch + 3936, ttn);
  let q2: u32 = std_types.meta_cell_put(scratch + 3944, esz);
  let q3: u32 = std_types.meta_cell_put(scratch + 3952, cnt);
  return 0;
}

func meta_emit_ns_operand(base: addr, len: u64, ns_lo: u64, ns_hi: u64, m_lo: u64, m_hi: u64, kind: u64, width: u64, t_lo: u64, t_hi: u64, has_args: bool, args: u64) -> u32 {
  let lp: u64 = meta_find_import_binding(base, len, ns_lo, ns_hi);
  let nons: bool = lp == 0;
  if nons {
    let f0: u32 = lain_meta_fail(12);
    return 12;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let pat: u64 = std_scope.meta_path_buffer();
  let scratch: addr = lain_meta_scratch_data();
  let buf: addr = scratch + pat;
  let mag_len: u64 = meta_module_key(idx, buf);
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let mname: addr = base + m_lo;
  let mnlen: u64 = m_hi - m_lo;
  let mi: u64 = std_scope.meta_scope_find(mname, mnlen);
  let found: bool = mi != 0xFFFFFFFFFFFFFFFF;
  let chk: u32 = loop pick_chk(t: u32 = 0) {
    if found == 0 {
      let fm: u32 = lain_meta_fail(13);
      break pick_chk(13);
    }
    let mk: u64 = std_scope.meta_scope_kind(mi);
    let isv: bool = mk == 3;
    if isv { break pick_chk(0); }
    let isf: bool = mk == 6;
    if isf { break pick_chk(0); }
    let fk: u32 = lain_meta_fail(4);
    break pick_chk(4);
  };
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  let bad: bool = chk != 0;
  if bad {
    return chk;
  }
  // 静态数据成员（定长表、字节串）：它的值是该模块里的数据块地址，过程体在模块
  // 自己的单元里（见 meta_emit_module_binding）。这里发一条取址。
  let is_tab: u64 = loop pick_tab(t: u64 = 0) {
    if found == 0 { break pick_tab(0); }
    let tk: u64 = std_scope.meta_scope_kind(mi);
    let t3: bool = tk == 3;
    if t3 == 0 { break pick_tab(0); }
    let te: u64 = std_scope.meta_scope_emitted(mi);
    let teok: bool = te != 0;
    let tp: u64 = std_scope.meta_scope_payload(mi);
    let tp_lo: u64 = std_parse.meta_node_start(tp);
    let tp_b: u8 = std_lex.bs_byte_at(base, tp_lo, len);
    let tp_bw: u32 = tp_b as u32;
    let tp_str: bool = tp_bw == 34;
    break pick_tab(teok or tp_str);
  };
  let tab: bool = is_tab != 0;
  if tab {
    let tybuf: addr = std_scope.meta_path_buf();
    let tsym: u64 = meta_module_data_symbol(buf, mag_len, base, m_lo, mnlen, tybuf);
    let ttn: u64 = meta_emit_data_addr_line(tybuf, tsym);
    let tsc: addr = lain_meta_scratch_data();
    let q1: u32 = std_types.meta_cell_put(tsc + 168, ttn);
    let q2: u32 = std_types.meta_cell_put(tsc + 176, 0);
    let q3: u32 = std_types.meta_cell_put(tsc + 184, 0);
    return 0;
  }
  // 实参先降级：那些指令必须发在这一行**前面**，而它们的降级会用到文字缓冲区，
  // 所以被调名要在降级之后再渲染进去。
  let ap: u32 = if has_args {
    std_funcs.meta_args_prepare(base, len, kind, width, t_lo, t_hi, args)
  } else { 0 };
  let abad: bool = ap != 0;
  if abad {
    return ap;
  }
  // 实参降级会借走同一块 352 字节路径缓冲（symbol_addr 的实参要渲染当前单元的符号名，
  // 也写在那里），所以被调方键必须在降级之后重新算一遍。否则前缀会被换成当前单元
  // 自己的键，产物里出现「本单元键 + 别的模块的成员名」这种悬空调用。
  let mag2_len: u64 = if has_args { meta_module_key(idx, buf) } else { mag_len };
  // 名字渲染进缓冲区：0 起是 `<mangle>__<成员>`，160 起是 `%r<n>`。
  let tb: addr = std_lainir.lainir_text_buffer;
  let dsep: addr = std_emit.meta_dsep;
  let c1: u64 = std_lainir.lainir_buf_bytes(tb, 0, buf, mag2_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(tb, c1, dsep, 2);
  let mat: addr = base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(tb, c2, mat, mn);
  if has_args {
    let tn2: u64 = std_funcs.meta_next_temp();
    let a1: u32 = std_lainir.lainir_indent_write();
    let a2: u32 = std_lainir.lainir_temp_name_emit(tn2);
    let a3: u32 = std_lainir.lainir_result_sep_write();
    let a4: u32 = std_lainir.lainir_call_word_write();
    let a5: u32 = std_lainir.lainir_write(tb, clen);
    let a6: u32 = std_lainir.lainir_open_paren_write();
    let a7: u32 = std_funcs.meta_args_write(base, len);
    let a8: u32 = std_lainir.lainir_close_paren_write();
    let a9: u32 = std_lainir.lainir_newline_write();
    let sc2: addr = lain_meta_scratch_data();
    let q1: u32 = std_types.meta_cell_put(sc2 + 168, tn2);
    let q2: u32 = std_types.meta_cell_put(sc2 + 176, 0);
    let q3: u32 = std_types.meta_cell_put(sc2 + 184, 0);
    return 0;
  }
  let tn: u64 = std_funcs.meta_next_temp();
  let nend: u64 = std_lainir.lainir_buf_temp(tb, 160, tn);
  let nlen: u64 = nend - 160;
  let z: addr = std_lainir.lainir_zero;
  // 名字是缓冲区 160 起那段 `%r<n>`，不是 0 起的被调用者文本
  let naddr: addr = tb + 160;
  let w: u32 = std_lainir.lainir_call_named(naddr, nlen, tb, clen, z, 0);
  let sc: addr = lain_meta_scratch_data();
  let p1: u32 = std_types.meta_cell_put(sc + 168, tn);
  let p2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let p3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return 0;
}
