// 模块：源码注册表与 import。跨单元引用一律写 `别名.名字`。
//
// 解析规则：**逻辑路径全路径精确匹配，不做末段回退。**
//
//   import("std::math")  →  注册路径 "std/math.lain"
//
// `::` 对 `/`，末尾补 `.lain`（逻辑路径里自己写了 `.lain` 也接受）。逐字节比较
// 整条路径，找不到就是错误（status 11）。
//
// 注册表里每份源码的路径由宿主给（`lain_meta_source_path_data`），是 NUL 结尾的
// C 字符串——所以这里靠扫 0 取长度，不需要额外的长度能力。
//
// 命名空间绑定 `let M = import("std::math");` **不产出任何 LAINIR**：它是纯编译期
// 绑定。后面用到 `M.x` 时再回源码里扫这条 import 找回来——和积/和类型重算布局是
// 同一个办法，不建编译期表。
//
// 暂存区分段（宿主给 64 KiB）：
//   +0    和类型的最大载荷大小
//   +8    和类型的最大 align 值
//   +64   import 逻辑路径的规范化缓冲区
//
// 静态只读块用 `let NAME: ro [u8] = [...]` 声明，取址写 symbol_addr("NAME_storage")：
// 编译器发布的数据符号带 _storage 后缀。

let std_emit = import("emit");
let std_funcs = import("funcs");
let std_lainir = import("lainir");
let std_lex = import("lex");
let std_parse = import("parse");
let std_registry = import("registry");
let std_scalars = import("scalars");
let std_scope = import("scope");
let std_types = import("types");

let meta_kw_import: ro [u8] = [105, 109, 112, 111, 114, 116];      // "import"  6
let meta_suffix_lain: ro [u8] = [46, 108, 97, 105, 110];           // ".lain"   5

// 宿主能力。
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_count() -> u64 = lain_meta_source_count;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(source: u64) -> u64 = lain_meta_source_length;
extern lain_meta_source_path_data(index: u64) -> addr = lain_meta_source_path_data;

// --- 宿主字符串与缓冲区 ---------------------------------------------------

// 两个 NUL 结尾字符串相等？同时走到 0 才算相等。u8 没有算子，先 as u32 再比。
func meta_cstr_equal(a: addr, b: addr) -> bool {
  let r: bool = loop walk(i: u64 = 0) {
    let pa: addr = a + i;
    let pb: addr = b + i;
    let ba: u8 = load(pa);
    let bb: u8 = load(pb);
    let baw: u32 = ba as u32;
    let bbw: u32 = bb as u32;
    let diff: bool = baw != bbw;
    if diff { break walk(0); }
    let end: bool = baw == 0;
    if end { break walk(1); }
    continue walk(i + 1);
  };
  return r;
}

func meta_buf_put(buf: addr, capacity: u64, at: u64, b: u8) -> u32 {
  let fits: bool = at < capacity;
  if fits == 0 { return 17; }
  let p: addr = buf + at;
  store(p, b);
  return 0;
}

// 往缓冲区写 n 个字节，返回写完后的下标。
func meta_buf_puts(buf: addr, capacity: u64, at: u64, src: addr, n: u64) -> u64 {
  let at_ok: bool = at <= capacity;
  let remaining: u64 = capacity - at;
  let length_ok: bool = n <= remaining;
  let fits: bool = at_ok and length_ok;
  if fits == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let end: u64 = loop put(k: u64 = 0, j: u64 = at) {
    let more: bool = k < n;
    if more {
      let p: addr = src + k;
      let b: u8 = load(p);
      let q: addr = buf + j;
      store(q, b);
      continue put(k + 1, j + 1);
    } else {
      break put(j);
    }
  };
  return end;
}

// --- 路径规范化 -----------------------------------------------------------

// 逻辑路径末尾是不是已经写了 `.lain`？
func meta_ends_with_lain(logical: addr, len: u64) -> bool {
  let enough: bool = len >= 5;
  if enough == 0 { return 0; }
  let off: u64 = len - 5;
  let p: addr = logical + off;
  let suf: addr = symbol_addr("meta_suffix_lain_storage");
  let eq: bool = std_types.meta_bytes_equal(p, suf, 5);
  return eq;
}

// 把逻辑路径规范化成注册路径的形状，写进 buf（NUL 结尾）。调用方保证 buf 够大。
func meta_build_path(logical: addr, len: u64, buf: addr, capacity: u64) -> u32 {
  let has: bool = meta_ends_with_lain(logical, len);
  let suffix: u64 = if has { 0 } else { 5 };
  let need: u64 = len + suffix + 1;
  let fits: bool = need <= capacity;
  if fits == 0 { return 17; }
  // `::` 变 `/`（吃掉第二个冒号）；单个 `:` 原样留着，它匹配不上就是匹配不上。
  let j: u64 = loop put(i: u64 = 0, j: u64 = 0) {
    let more: bool = i < len;
    if more {
      let is_colon: bool = std_lex.bs_is_byte(logical, i, 58);
      let raw: u8 = std_lex.bs_byte_at(logical, i, len);
      let out: u8 = if is_colon { 47 } else { raw };
      let p: addr = buf + j;
      store(p, out);
      let j2: u64 = j + 1;
      if is_colon == 0 { continue put(i + 1, j2); }
      let i1: u64 = i + 1;
      let also: bool = std_lex.bs_is_byte(logical, i1, 58);
      if also { continue put(i + 2, j2); }
      continue put(i + 1, j2);
    } else {
      break put(j);
    }
  };
  let end: u64 = loop pick_end(t: u64 = 0) {
    if has { break pick_end(j); }
    let suf: addr = symbol_addr("meta_suffix_lain_storage");
    let e: u64 = meta_buf_puts(buf, capacity, j, suf, 5);
    break pick_end(e);
  };
  let zero: u32 = meta_buf_put(buf, capacity, end, 0);
  if zero != 0 { return zero; }
  return 0;
}

// --- 查注册表 -------------------------------------------------------------

// 逻辑路径 → 源码下标；找不到返回 NOT_FOUND。查不到就**不回退**。
func meta_source_find(logical: addr, logical_len: u64) -> u64 {
  let scratch: addr = lain_meta_scratch_data();
  // 路径 / mangle 缓冲区：位置由 scope.lain 的 meta_path_buffer 给出（动态区尾部，
  // 紧接语法树节点区），容量 352 字节。
  let cap_ad: addr = std_registry.meta_path_cap;
  let cap: u64 = std_types.meta_cell_get(cap_ad);
  // `::` 只会变短，补 `.lain` 和 NUL 是最坏情况 +6
  let need: u64 = logical_len + 6;
  let fits: bool = need <= cap;
  if fits == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let pat: u64 = std_scope.meta_path_buffer();
  let buf: addr = scratch + pat;
  let b: u32 = meta_build_path(logical, logical_len, buf, cap);
  let count: u64 = lain_meta_source_count();
  let idx: u64 = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let p: addr = lain_meta_source_path_data(i);
      let same: bool = meta_cstr_equal(p, buf);
      if same { break s(i); }
      continue s(i + 1);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return idx;
}

// --- import 的语法与降级 ---------------------------------------------------

// 从 `import` 的位置往下读 `("逻辑路径")`，返回逻辑路径首字节的下标；
// 形状不对返回 NOT_FOUND。
func meta_import_logical(base: addr, len: u64, kw_at: u64) -> u64 {
  let p: u64 = kw_at + 6;
  let p1: u64 = std_lex.bs_skip_space(base, p, len);
  let open: bool = std_lex.bs_is_byte(base, p1, 40);
  if open == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let q1: u64 = p1 + 1;
  let quote: bool = std_lex.bs_is_byte(base, q1, 34);
  if quote == 0 { return 0xFFFFFFFFFFFFFFFF; }
  let start: u64 = q1 + 1;
  return start;
}

// 逻辑路径到收尾引号为止的长度。
func meta_logical_len(base: addr, from: u64, len: u64) -> u64 {
  let n: u64 = loop scan(i: u64 = from) {
    let b: u8 = std_lex.bs_byte_at(base, i, len);
    let bw: u32 = b as u32;
    let stop: bool = bw == 34;
    let past: bool = i >= len;
    let done: bool = stop or past;
    if done {
      break scan(i);
    }
    continue scan(i + 1);
  };
  let r: u64 = n - from;
  return r;
}

// 按绑定名找回它的 import 逻辑路径下标（== `let M = import("...")` 里引号内的起点）。
// 查**作用域表**：命中的条目 kind 必须是 1（模块引用），逻辑路径位置记在 aux。
// 不是模块引用、或表里没有，都返回 0（「没找到」的哨兵——引号位置永远大于 0）。
func meta_find_import_binding(base: addr, len: u64, ns_lo: u64, ns_hi: u64) -> u64 {
  let name: addr = base + ns_lo;
  let name_len: u64 = ns_hi - ns_lo;
  let i: u64 = std_scope.meta_scope_find(name, name_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0;
  }
  let kind: u64 = std_scope.meta_scope_kind(i);
  let is_ns: bool = kind == 1;
  if is_ns == 0 {
    return 0;
  }
  let aux: u64 = std_scope.meta_scope_aux(i);
  return aux;
}

// 把一个模块里**全部值绑定**的过程发出来（名字是 `<mangle>__<成员>`），按声明顺序。
//
// 为什么在 import 声明处一次发完：过程只能落在顶层。表达式里的 `M.x` 处在函数体
// 里，那一刻已经没有位置插一条 `#proc`。导入时发完，用到时只管 `#call`。
func meta_emit_module_exports(m_base: addr, m_len: u64, idx: u64, mag: addr, mag_len: u64) -> u32 {
  let count: u64 = std_scope.meta_scope_count();
  let r: u32 = loop ex(k: u64 = 0) {
    let more: bool = k < count;
    if more {
      let src: u64 = std_scope.meta_scope_word(k, 0);
      let same: bool = src == idx;
      let kind: u64 = std_scope.meta_scope_word(k, 24);
      let isval: bool = kind == 3;
      let hit: bool = same and isval;
      if hit {
        let n_off: u64 = std_scope.meta_scope_word(k, 8);
        let n_len: u64 = std_scope.meta_scope_word(k, 16);
        let name: addr = m_base + n_off;
        let e: u32 = meta_emit_module_binding(m_base, m_len, name, n_len, mag, mag_len);
        if e != 0 {
          break ex(e);
        }
        continue ex(k + 1);
      }
      continue ex(k + 1);
    } else {
      break ex(0);
    }
  };
  return r;
}

// `let NAME = import("逻辑路径");` —— 解析、登记，并把模块里全部值绑定的过程
// 一次发出去（见 `meta_emit_module_exports`）。
func meta_lower_import(base: addr, len: u64, eq_at: u64) -> u32 {
  let one: u64 = eq_at + 1;
  let kw_at: u64 = std_lex.bs_skip_space(base, one, len);
  let lp: u64 = meta_import_logical(base, len, kw_at);
  let bad: bool = lp == 0xFFFFFFFFFFFFFFFF;
  if bad {
    let f0: u32 = lain_meta_fail(11);
    return 11;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let m_base: addr = lain_meta_source_data(idx);
  let m_len: u64 = lain_meta_source_length(idx);
  let pat: u64 = std_scope.meta_path_buffer();
  let scratch: addr = lain_meta_scratch_data();
  let buf: addr = scratch + pat;
  // 键从**解析到的模块路径**算（不是 import 说明符）：见 meta_build_mangle。
  let mag_len: u64 = meta_module_key(idx, buf);
  // 模块那一层压进链，扫一次（见 meta_scope_has_source 的注释），发完全部值
  // 绑定的过程，再把当前源码换回去。
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let already: bool = std_scope.meta_scope_has_source(idx);
  // 已扫过就不扫：只有没扫过才调 meta_scope_count / meta_scope_scan。
  let ready: u32 = loop pick_ready(t: u32 = 0) {
    if already { break pick_ready(0); }
    let mark: u64 = std_scope.meta_scope_count();
    let scan: u32 = std_scope.meta_scope_scan(m_base, m_len, idx, mark);
    break pick_ready(scan);
  };
  if ready != 0 {
    let rest0: u32 = std_scope.meta_scope_set_current(old_src);
    return ready;
  }
  let e: u32 = meta_emit_module_exports(m_base, m_len, idx, buf, mag_len);
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  return e;
}

// --- 命名空间成员：`M.x` ----------------------------------------------------
//
// LAINIR 的名字是扁平的，所以命名空间成员要 **mangle 成扁平名**才落得到物理层：
//
//   std/types.lain 里的 meta_bytes_equal   →   std_types__meta_bytes_equal
//
// 规则与 lain0 的 `Program::keyOf`（seed/lain0/src/Sema.cpp）**逐字一致**：
// 模块键 = 模块**解析到的路径**（源根相对路径）去结尾 `.lain`、每个 `/` 换一个 `_`。
// 再拼 `__` 和成员名。
//
// 键从**解析到的模块**算：说明符里的 `::`、相对段、省掉的 `.lain` 只参与解析，
// 键使用解析后的扁平名。

// NUL 结尾字符串的字节数（不含结尾 NUL）。登记的逻辑路径就是这种串。
func meta_path_len(p: addr) -> u64 {
  let n: u64 = loop scan(i: u64 = 0) {
    let b: u8 = load(p + i);
    let bw: u32 = b as u32;
    let stop: bool = bw == 0;
    if stop { break scan(i); }
    continue scan(i + 1);
  };
  return n;
}

// 模块路径 → 模块键，写进 buf，返回长度。去结尾 `.lain`（长度够时）、`/`→`_`。
func meta_build_mangle(path: addr, len: u64, buf: addr) -> u64 {
  let has_suffix: bool = meta_ends_with_lain(path, len);
  let body: u64 = loop pick_body(t: u64 = 0) {
    if has_suffix == 0 { break pick_body(len); }
    let five: u64 = len - 5;
    break pick_body(five);
  };
  let j: u64 = loop put(i: u64 = 0, j: u64 = 0) {
    let more: bool = i < body;
    if more {
      let is_slash: bool = std_lex.bs_is_byte(path, i, 47);
      let raw: u8 = std_lex.bs_byte_at(path, i, body);
      let out: u8 = if is_slash { 95 } else { raw };
      let p: addr = buf + j;
      store(p, out);
      continue put(i + 1, j + 1);
    } else {
      break put(j);
    }
  };
  return j;
}

// 源码 idx 的**模块键**（写进 buf，返回长度）：键从它解析到的路径算，见 meta_build_mangle。
// import 站（`M.x`）与「单元自己的顶层名」两处都用它。
func meta_module_key(idx: u64, buf: addr) -> u64 {
  let path: addr = lain_meta_source_path_data(idx);
  let len: u64 = meta_path_len(path);
  let k: u64 = meta_build_mangle(path, len, buf);
  return k;
}


// 发「被导入的绑定」本身：`#proc <mangle>__<member>() -> #bits<64> { #return v }`
// member 是**调用方源码里**写的那个名字（用户写的是 `M.answer`，输出里就该是
// `answer`），只有值来自被导入的源码。
func meta_emit_exported(mag: addr, mag_len: u64, b_base: addr, b_lo: u64, b_hi: u64, value: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let dsep: addr = std_emit.meta_dsep;
  let a1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let a2: u64 = std_lainir.lainir_buf_bytes(buf, a1, dsep, 2);
  let at: addr = b_base + b_lo;
  let n: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(buf, a2, at, n);
  let h: u32 = std_lainir.lainir_proc_head_full(buf, nlen, buf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let r: u32 = std_lainir.lainir_return_uint(value);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 发调用方：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
func meta_emit_ns_call(b_base: addr, b_lo: u64, b_hi: u64, kind: u64, width: u64, mag: addr, mag_len: u64, m_base: addr, m_lo: u64, m_hi: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let nbuf: addr = buf + 128;
  let bat: addr = b_base + b_lo;
  let bn: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(nbuf, 0, bat, bn);
  let h: u32 = std_lainir.lainir_proc_head_full(nbuf, nlen, nbuf, 0, kind, width);
  let o: u32 = std_lainir.lainir_open_body();
  let dsep: addr = std_emit.meta_dsep;
  let c1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(buf, c1, dsep, 2);
  let mat: addr = m_base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(buf, c2, mat, mn);
  let r: u32 = std_lainir.lainir_ret_call(buf, clen, buf, 0);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 模块**内部**的一条绑定调用同一个模块里的另一条：
//   `#proc <mangle>__<b>() -> #bits<64> { #return #call <mangle>__<a>() }`
//
// 和 `meta_emit_ns_call` 的区别：那个是给调用方用的，只有被调方带 mangle；这里
// 两边都是模块自己的绑定，**两个名字都要带前缀**。
func meta_emit_module_call(m_base: addr, b_lo: u64, b_hi: u64, mag: addr, mag_len: u64, m_lo: u64, m_hi: u64) -> u32 {
  let buf: addr = std_lainir.lainir_text_buffer;
  let nbuf: addr = buf + 128;
  let dsep: addr = std_emit.meta_dsep;
  let n1: u64 = std_lainir.lainir_buf_bytes(nbuf, 0, mag, mag_len);
  let n2: u64 = std_lainir.lainir_buf_bytes(nbuf, n1, dsep, 2);
  let bat: addr = m_base + b_lo;
  let bn: u64 = b_hi - b_lo;
  let nlen: u64 = std_lainir.lainir_buf_bytes(nbuf, n2, bat, bn);
  let h: u32 = std_lainir.lainir_proc_head_full(nbuf, nlen, nbuf, 0, 0, 64);
  let o: u32 = std_lainir.lainir_open_body();
  let c1: u64 = std_lainir.lainir_buf_bytes(buf, 0, mag, mag_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(buf, c1, dsep, 2);
  let mat: addr = m_base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(buf, c2, mat, mn);
  let r: u32 = std_lainir.lainir_ret_call(buf, clen, buf, 0);
  let c: u32 = std_lainir.lainir_close_body();
  return 0;
}

// 发出模块里的一条值绑定，名字是 `<mangle>__<名字>`。
//
// 初始化式有两种形状（v0）：
//   数字 → 一个字面量
//   标识符 → **同一个模块里的另一条绑定**：先把那条递归发出来，再发调用它的这条
//
// 同一个绑定被引用两次只会发一次：条目里的 `emitted` 是防重入的标记，先置位再
// 展开函数体，所以自引用也不会转圈。遇到别的形状报 4。
func meta_emit_module_binding(m_base: addr, m_len: u64, name_addr: addr, name_len: u64, mag: addr, mag_len: u64) -> u32 {
  let i: u64 = std_scope.meta_scope_find(name_addr, name_len);
  let gone: bool = i == 0xFFFFFFFFFFFFFFFF;
  if gone {
    let f0: u32 = lain_meta_fail(13);
    return 13;
  }
  let kind: u64 = std_scope.meta_scope_kind(i);
  let is_value: bool = kind == 3;
  if is_value == 0 {
    // v0：模块里能取用的只有值绑定。取一个标量类型或别的，报 4。
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let done: u64 = std_scope.meta_scope_emitted(i);
  let skip: bool = done != 0;
  if skip {
    return 0;
  }
  let mark: u32 = std_scope.meta_scope_set_emitted(i, 1);
  // 名字在模块源码里的位置：条目里存着
  let n_off: u64 = std_scope.meta_scope_word(i, 8);
  let n_len: u64 = std_scope.meta_scope_word(i, 16);
  let n_hi: u64 = n_off + n_len;
  // 初始化式的**节点下标**：条目里存着。位置的直接读节点，不用 skip。
  let init_node: u64 = std_scope.meta_scope_payload(i);
  let init: u64 = std_parse.meta_node_start(init_node);
  let init_len: u64 = std_parse.meta_node_len(init_node);
  let init_hi: u64 = init + init_len;
  let first: u8 = std_lex.bs_byte_at(m_base, init, m_len);
  let is_num: bool = std_lex.bs_is_digit(first);
  if is_num {
    let value: u64 = std_lex.bs_read_uint(m_base, init, m_len);
    let e0: u32 = meta_emit_exported(mag, mag_len, m_base, n_off, n_hi, value);
    return e0;
  }
  // 标识符：同模块里的另一条绑定。引用的名字就是那个节点本身。
  let ref_v: addr = m_base + init;
  let ref_len: u64 = init_hi - init;
  let e1: u32 = meta_emit_module_binding(m_base, m_len, ref_v, ref_len, mag, mag_len);
  let bad: bool = e1 != 0;
  if bad {
    return e1;
  }
  let e2: u32 = meta_emit_module_call(m_base, n_off, n_hi, mag, mag_len, init, init_hi);
  return e2;
}

// `let NAME = M.member;` —— 解析命名空间绑定，**进入那个模块的作用域**去取成员。
//
// 关键在这里：取成员时要压入模块自己那一层（链变成 [root, 那个模块]），所以模块
// 内部 `let b = a;` 里的 `a` 能解析到同一个模块里的 `a`。
func meta_lower_ns_value(base: addr, len: u64, bind_lo: u64, bind_hi: u64, ns_lo: u64, ns_hi: u64, m_lo: u64, m_hi: u64, kind: u64, width: u64) -> u32 {
  let lp: u64 = meta_find_import_binding(base, len, ns_lo, ns_hi);
  let nons: bool = lp == 0;
  if nons {
    // `M` 不是这条源码里的 import 绑定
    let f0: u32 = lain_meta_fail(12);
    return 12;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let m_base: addr = lain_meta_source_data(idx);
  let m_len: u64 = lain_meta_source_length(idx);
  let scratch: addr = lain_meta_scratch_data();
  let pat: u64 = std_scope.meta_path_buffer();
  let buf: addr = scratch + pat;
  let mag_len: u64 = meta_module_key(idx, buf);

  // 切到模块那一层；**扫一次就留着**（见 meta_scope_has_source 的注释）。
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let already: bool = std_scope.meta_scope_has_source(idx);
  let ready: u32 = loop pick_ready(t: u32 = 0) {
    if already { break pick_ready(0); }
    let mark: u64 = std_scope.meta_scope_count();
    let scan: u32 = std_scope.meta_scope_scan(m_base, m_len, idx, mark);
    break pick_ready(scan);
  };
  if ready != 0 {
    let rest0: u32 = std_scope.meta_scope_set_current(old_src);
    return ready;
  }
  // 成员名写在**调用方**的源码里，值在模块的源码里
  let m_name: addr = base + m_lo;
  let m_name_len: u64 = m_hi - m_lo;
  let e1: u32 = meta_emit_module_binding(m_base, m_len, m_name, m_name_len, buf, mag_len);
  // 调用方那条：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
  let e2: u32 = meta_emit_ns_call(base, bind_lo, bind_hi, kind, width, buf, mag_len, base, m_lo, m_hi);
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  return e1;
}

// `M.answer` 当操作数用（`M.answer + 1`、`f(M.answer)`、`let x = M.answer + 2;`）：
// 发一次 `  %r<n> = #call <mangle>__<成员>()`，把临时值下标写进暂存区 +168。
//
// 成员的过程已经在 import 声明处发过（`meta_emit_module_exports`），所以这里只发
// 调用；再确认一下成员确实在模块表里、是值绑定，缺失或不是值绑定分别报 13 / 4。
func meta_emit_ns_operand(base: addr, len: u64, ns_lo: u64, ns_hi: u64, m_lo: u64, m_hi: u64) -> u32 {
  let lp: u64 = meta_find_import_binding(base, len, ns_lo, ns_hi);
  let nons: bool = lp == 0;
  if nons {
    let f0: u32 = lain_meta_fail(12);
    return 12;
  }
  let n: u64 = meta_logical_len(base, lp, len);
  let path: addr = base + lp;
  let idx: u64 = meta_source_find(path, n);
  let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
  if miss {
    let f1: u32 = lain_meta_fail(11);
    return 11;
  }
  let pat: u64 = std_scope.meta_path_buffer();
  let scratch: addr = lain_meta_scratch_data();
  let buf: addr = scratch + pat;
  let mag_len: u64 = meta_module_key(idx, buf);
  let old_src: u64 = std_scope.meta_scope_enter(idx);
  let mname: addr = base + m_lo;
  let mnlen: u64 = m_hi - m_lo;
  let mi: u64 = std_scope.meta_scope_find(mname, mnlen);
  let found: bool = mi != 0xFFFFFFFFFFFFFFFF;
  let chk: u32 = loop pick_chk(t: u32 = 0) {
    if found == 0 {
      let fm: u32 = lain_meta_fail(13);
      break pick_chk(13);
    }
    let mk: u64 = std_scope.meta_scope_kind(mi);
    let isv: bool = mk == 3;
    if isv { break pick_chk(0); }
    let fk: u32 = lain_meta_fail(4);
    break pick_chk(4);
  };
  let rest: u32 = std_scope.meta_scope_set_current(old_src);
  let bad: bool = chk != 0;
  if bad {
    return chk;
  }
  // 名字渲染进缓冲区：0 起是 `<mangle>__<成员>`，160 起是 `%r<n>`。
  let tb: addr = std_lainir.lainir_text_buffer;
  let dsep: addr = std_emit.meta_dsep;
  let c1: u64 = std_lainir.lainir_buf_bytes(tb, 0, buf, mag_len);
  let c2: u64 = std_lainir.lainir_buf_bytes(tb, c1, dsep, 2);
  let mat: addr = base + m_lo;
  let mn: u64 = m_hi - m_lo;
  let clen: u64 = std_lainir.lainir_buf_bytes(tb, c2, mat, mn);
  let tn: u64 = std_funcs.meta_next_temp();
  let nend: u64 = std_lainir.lainir_buf_temp(tb, 160, tn);
  let nlen: u64 = nend - 160;
  let z: addr = std_lainir.lainir_zero;
  // 名字是缓冲区 160 起那段 `%r<n>`，不是 0 起的被调用者文本
  let naddr: addr = tb + 160;
  let w: u32 = std_lainir.lainir_call_named(naddr, nlen, tb, clen, z, 0);
  let sc: addr = lain_meta_scratch_data();
  let p1: u32 = std_types.meta_cell_put(sc + 168, tn);
  let p2: u32 = std_types.meta_cell_put(sc + 176, 0);
  let p3: u32 = std_types.meta_cell_put(sc + 184, 0);
  return 0;
}
