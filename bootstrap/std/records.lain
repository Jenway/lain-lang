// 一条声明自己的正文从哪开始：`struct X { ... }` 里 `{` 后面一个字符。
// **O(1)**：名字节点 → 花括号组 → 起点。不搜。
//
// 作用域表里存的是**声明节点**（`meta_scope_payload`），不是出现位置，所以这里用
// 「位置 -> 同一个父组里的下一项」把后继两步取出来：声明词的位置由 `meta_node_start`
// 给出，名字与花括号组分别是它的下一个、再下一个孩子。全程不碰「节点自带的后继」。
//
// 归档的 %r / %v 值 if 结果都喂给 #return，改成平坦守卫（%gone 先求值，命中即返回）。
func meta_decl_body(base: addr, node: u64) -> u64 {
  let node_at: u64 = meta_node_start(node);
  let name_node: u64 = meta_next_at(base, node_at);
  let name_at: u64 = meta_node_start(name_node);
  let grp: u64 = meta_next_at(base, name_at);
  let gone: bool = grp == 0;
  if gone {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let kind: u64 = meta_node_kind(grp);
  let is_group: bool = kind == 2;
  if is_group {
    let st: u64 = meta_node_start(grp);
    let one: u64 = st + 1;
    return one;
  }
  return 0xFFFFFFFFFFFFFFFF;
}

// 按名字从**作用域表**里取出「这个类型的正文从哪开始」。找不到返回 NOT_FOUND。
//
// 这是符号表真正省下来的那件事：以前每访问一次字段就回源码里把声明搜一遍
// （`meta_find_rec_body`），现在条目里存的就是声明节点，读一下就有。
// expect 是期望的种类：4 = 积类型，5 = 和类型。
//
// 归档三层值 if（%r / %v / %body）结果都喂给 #return，改成平坦守卫，条件按原顺序求值。
func meta_scope_body(base: addr, name_lo: u64, name_hi: u64, expect: u64) -> u64 {
  let name: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let i: u64 = meta_scope_find(name, name_len);
  let miss: bool = i == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let kind: u64 = meta_scope_kind(i);
  let ok: bool = kind == expect;
  if ok == 0 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let node: u64 = meta_scope_decl_node(i);
  let have: bool = node != 0;
  if have {
    let body: u64 = meta_decl_body(base, node);
    return body;
  }
  return 0xFFFFFFFFFFFFFFFF;
}

// 走字段列表累加偏移。
//   命中 f_lo/f_hi  → 返回 packed（最高位 1）
//   走到 `}`        → 返回按最大对齐取整后的总大小（最高位 0）
// f_lo == f_hi 表示「不匹配任何字段」，那就只算大小。
func meta_layout_align_up_checked(value: u64, align: u64, src: addr, position: u64) -> u64 {
  let zero: bool = align == 0;
  if zero {
    let bad: u32 = lain_meta_fail(5);
    return 0xFFFFFFFFFFFFFFFF;
  }
  let padding: u64 = align - 1;
  let limit: u64 = 0xFFFFFFFFFFFFFFFF - padding;
  let overflow: bool = value > limit;
  if overflow { return 0xFFFFFFFFFFFFFFFF; }
  let aligned: u64 = meta_eval_align_up(value, align, src, position);
  return aligned;
}

func meta_layout_field_align_up_checked(value: u64, align: u64) -> u64 {
  let zero: bool = align == 0;
  if zero {
    let bad: u32 = lain_meta_fail(5);
    return 0xFFFFFFFFFFFFFFFF;
  }
  let padding: u64 = align - 1;
  let limit: u64 = 0xFFFFFFFFFFFFFFFF - padding;
  let overflow: bool = value > limit;
  if overflow { return 0xFFFFFFFFFFFFFFFF; }
  let aligned: u64 = bs_align_up(value, align);
  return aligned;
}

// 受检查的偏移累加；调用方在收到 sentinel 后设置具体语义拒码。
func meta_layout_add_checked(left: u64, right: u64) -> u64 {
  let room: u64 = 0xFFFFFFFFFFFFFFFF - left;
  let overflow: bool = right > room;
  let result: u64 = if overflow {
    0xFFFFFFFFFFFFFFFF
  } else {
    left + right
  };
  return result;
}

// 走字段列表：命中字段名回 packed，走到 `}` 回总大小。本函数的循环参数在归档里叫
// %at / %off / %al（%at 与函数参数 %at 同名，循环初值取的就是外层 %at）；表面语言的
// 循环参数会遮蔽外层同名绑定，所以改名 cur_at / cur_off / cur_al，初值仍取 %at /
// %off0 / %al0。u8 比较先 as u32；%same 值 if 改成平坦守卫（bool 值 if 的 else 支
// 是裸 0，验证器 2005）。
func meta_walk_fields(src: addr, len: u64, at: u64, f_lo: u64, f_hi: u64, off0: u64, al0: u64) -> u64 {
  let r: u64 = loop fields(cur_at: u64 = at, cur_off: u64 = off0, cur_al: u64 = al0) {
    let here: u64 = bs_skip_space(src, cur_at, len);
    let byte: u8 = bs_byte_at(src, here, len);
    let byte_w: u32 = byte as u32;
    let is_close: bool = byte_w == 125;
    if is_close {
      let rounded: u64 = meta_layout_align_up_checked(cur_off, cur_al, src, here);
      let round_failed: bool = rounded == 0xFFFFFFFFFFFFFFFF;
      if round_failed {
        let scratch: addr = lain_meta_scratch_data();
        let recursive: u64 = meta_cell_get(scratch + 464);
        if recursive == 0 {
          let fail: u32 = lain_meta_fail(5);
        }
        break fields(0xFFFFFFFFFFFFFFFF);
      }
      break fields(rounded);
    }
    let name_hi: u64 = bs_skip_ident(src, here, len);
    let colon: u64 = bs_skip_space(src, name_hi, len);
    let one: u64 = colon + 1;
    let t_lo: u64 = bs_skip_space(src, one, len);
    let t_hi: u64 = bs_skip_qualified(src, t_lo, len);
    // 字段类型可能是 `i8`，也可能是 `T.i8`——解析统一走 root 环境/命名空间
    let tid: u64 = meta_type_resolve(src, len, t_lo, t_hi);
    // 解析不出来是**错**，不是「大小为 0」。走法只能回一个打包值，带不了
    // 状态，所以报给宿主状态通道（驱动必须看它），返回 0 让上面也走不通。
    let bad_type: bool = tid == 0;
    if bad_type {
      let scratch: addr = lain_meta_scratch_data();
      let recursive: u64 = meta_cell_get(scratch + 464);
      if recursive == 0 {
        let fail: u32 = lain_meta_fail(5);
      }
      break fields(0xFFFFFFFFFFFFFFFF);
    }
    let tinfo: u64 = meta_tid_repr(tid);
    let kind: u64 = tinfo and 255;
    let width: u64 = (tinfo >> 8) and 255;
    let fsize: u64 = meta_tid_size(tid);
    let falign: u64 = meta_tid_align(tid);
    let aligned: u64 = meta_layout_field_align_up_checked(cur_off, falign);
    if aligned == 0xFFFFFFFFFFFFFFFF {
      let scratch: addr = lain_meta_scratch_data();
      let recursive: u64 = meta_cell_get(scratch + 464);
      if recursive == 0 {
        let fail: u32 = lain_meta_fail(5);
      }
      break fields(0xFFFFFFFFFFFFFFFF);
    }
    let want: u64 = f_hi - f_lo;
    let have: u64 = name_hi - here;
    let len_ok: bool = want == have;
    // 归档的 %same 值 if（真支比字节、假支裸 0）结果喂给语句 if，改成平坦守卫：
    // 只有 len_ok 成立才算 %a / %b / %same，命中即发打包值。
    if len_ok {
      let a: addr = src + here;
      let b: addr = src + f_lo;
      let same: bool = meta_bytes_equal(a, b, want);
      if same {
        let k: u64 = kind << 40;
        let w: u64 = width << 44;
        let pk1: u64 = aligned or k;
        let pk2: u64 = pk1 or w;
        let set: u64 = pk2 or 0x8000000000000000;
        break fields(set);
      }
    }
    let next_off: u64 = meta_layout_add_checked(aligned, fsize);
    if next_off == 0xFFFFFFFFFFFFFFFF {
      let fail: u32 = lain_meta_fail(5);
      break fields(0xFFFFFFFFFFFFFFFF);
    }
    let bigger: bool = falign > cur_al;
    let new_al: u64 = if bigger {
      falign
    } else {
      cur_al
    };
    continue fields(t_hi, next_off, new_al);
  };
  return r;
}

// 某个字段的 (偏移, kind, width)。`body` 是那个 type 的正文起点（由
// `meta_scope_body` 从符号表里取，不用搜）。找不到返回 0。
// 归档的 %r 值 if 结果直接喂给 #return，改成守卫。
func meta_layout_field(src: addr, len: u64, body: u64, f_lo: u64, f_hi: u64) -> u64 {
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    return 0;
  }
  let info: u64 = meta_walk_fields(src, len, body, f_lo, f_hi, 0, 1);
  return info;
}

// 某个字段**声明的类型名**窗口：起点是那个类型名，终点写进暂存区 `+0`（与
// `meta_word_type_name` 同一个约定），找不到回「无」。
//
// `meta_layout_field` 只回打包好的 (偏移, kind, width)，够发射「按偏移取字段」用；
// 值名不带标注的绑定（`let v = p.x;`）要的是**类型名** —— 类型名才能交给
// `meta_type_resolve` 走一遍完整解析（`T.i8` 这种限定名也认）。
//
// 归档的 %r 值 if（假支里是一个 #loop）结果喂给 #return，改成守卫；循环里的 %same
// 值 if 同样改成平坦守卫（见 meta_walk_fields）。
func meta_field_type_window(src: addr, len: u64, body: u64, f_lo: u64, f_hi: u64) -> u64 {
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let found: u64 = loop fields(at: u64 = body) {
    let here: u64 = bs_skip_space(src, at, len);
    let byte: u8 = bs_byte_at(src, here, len);
    let byte_w: u32 = byte as u32;
    if byte_w == 125 { break fields(0xFFFFFFFFFFFFFFFF); }
    let name_hi: u64 = bs_skip_ident(src, here, len);
    let colon: u64 = bs_skip_space(src, name_hi, len);
    let t_lo: u64 = bs_skip_space(src, colon + 1, len);
    let t_hi: u64 = bs_skip_qualified(src, t_lo, len);
    let want: u64 = f_hi - f_lo;
    let have: u64 = name_hi - here;
    let len_ok: bool = want == have;
    if len_ok {
      let a: addr = src + here;
      let b: addr = src + f_lo;
      let same: bool = meta_bytes_equal(a, b, want);
      if same {
        let sc: addr = lain_meta_scratch_data();
        let put: u32 = meta_cell_put(sc + 0, t_hi);
        break fields(t_lo);
      }
    }
    continue fields(t_hi);
  };
  return found;
}

// 一个操作数**自己**的类型名窗口（起点是类型名，终点写进暂存区 `+0`，找不到回
// 「无」）。
//
// 操作数是字段访问（`p.x`）时，类型是**字段**的类型，用 `p` 的类型去查算子表
// 会撞上「积类型上没有 `+`」这种跟真实原因无关的拒绝（`1 + p.x` 真出过）。
//
// 归档的 %r / %fw 值 if 结果都喂给 #return，两边都改成平坦守卫（真支的每条路径
// 都 return，所以「非字段」那段只在 %is_field 为假时执行，与旧 IR 的 if / else
// 两支互斥一致）。
func meta_operand_type_window(base: addr, len: u64, parent: u64, index: u64) -> u64 {
  let form: u64 = meta_node_form(parent, index);
  let is_field: bool = form == 6;
  if is_field {
    let node: u64 = ast_child(parent, index);
    let v_lo: u64 = meta_node_start(node);
    let v_hi: u64 = v_lo + meta_node_len(node);
    let after: u64 = bs_skip_space(base, v_hi, len);
    let f_lo: u64 = bs_skip_space(base, after + 1, len);
    let f_hi: u64 = bs_skip_ident(base, f_lo, len);
    let bt_lo: u64 = meta_word_type_name(base, len, node);
    let sc: addr = lain_meta_scratch_data();
    let bt_hi: u64 = meta_cell_get(sc + 0);
    let nobody: bool = bt_lo == 0xFFFFFFFFFFFFFFFF;
    if nobody {
      return 0xFFFFFFFFFFFFFFFF;
    }
    let tbody: u64 = meta_scope_body(base, bt_lo, bt_hi, 4);
    let fwin: u64 = meta_field_type_window(base, len, tbody, f_lo, f_hi);
    return fwin;
  }
  let node2: u64 = ast_child(parent, index);
  let tw: u64 = meta_word_type_name(base, len, node2);
  return tw;
}

// 记录的总大小。
// 归档三层值 if（%r / %size，以及 %failed 的 or）结果都喂给 #return，改成平坦守卫。
func meta_layout_size(src: addr, len: u64, body: u64) -> u64 {
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    return 0;
  }
  let info: u64 = meta_walk_fields(src, len, body, 0, 0, 0, 1);
  let failed_sentinel: bool = info == 0xFFFFFFFFFFFFFFFF;
  let failed_zero: bool = info == 0;
  // 1 位值上的按位 or 与逻辑 or 同义（照旧 IR 写 or）。
  let failed: bool = failed_sentinel or failed_zero;
  if failed {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let low: u64 = info and 0xFFFFFFFFFF;
  return low;
}

// struct 的最大字段对齐。
func meta_layout_align(src: addr, len: u64, body: u64) -> u64 {
  let r: u64 = loop aligns(at: u64 = body, max: u64 = 1) {
    let here: u64 = bs_skip_space(src, at, len);
    let byte: u8 = bs_byte_at(src, here, len);
    let byte_w: u32 = byte as u32;
    if byte_w == 125 { break aligns(max); }
    let name_hi: u64 = bs_skip_ident(src, here, len);
    let colon: u64 = bs_skip_space(src, name_hi, len);
    let t_lo: u64 = bs_skip_space(src, colon + 1, len);
    let t_hi: u64 = bs_skip_qualified(src, t_lo, len);
    let tid: u64 = meta_type_resolve(src, len, t_lo, t_hi);
    if tid == 0 {
      let scratch: addr = lain_meta_scratch_data();
      let recursive: u64 = meta_cell_get(scratch + 464);
      if recursive == 0 {
        let fail: u32 = lain_meta_fail(5);
      }
      break aligns(0);
    }
    let align: u64 = meta_tid_align(tid);
    let next_max: u64 = if align > max {
      align
    } else {
      max
    };
    continue aligns(t_hi, next_max);
  };
  return r;
}

// struct 的名义类型 ID 独立存于注册表；作用域 payload 仍保留声明节点。
// 归档的 %id 值 if 结果喂给 #return，但 #return 之前还有 restore_top / release
// 两条无条件执行的语句，所以改成一次性选择循环 pick_id（见文件头说明）。
func meta_record_type_id(index: u64) -> u64 {
  let src: u64 = meta_scope_word(index, 0);
  let len: u64 = lain_meta_source_length(src);
  let base: addr = lain_meta_source_data(src);
  let node: u64 = meta_scope_decl_node(index);
  let pos: u64 = meta_node_start(node);
  let src1: u64 = src + 1;
  let high: u64 = src1 << 32;
  // src1 占高 32 位、pos + 1 占低 32 位，位域不相交，or 与加法等价（照旧 IR 写 or）。
  let owner: u64 = high or (pos + 1);
  let scratch: addr = lain_meta_scratch_data();
  let registered: u64 = meta_reg_lookup(scratch, 2, owner, 0);
  if registered != 0 { return registered; }
  let top: u64 = meta_cell_get(scratch + 456);
  let cycle: bool = loop active(link: u64 = top) {
    if link == 0 { break active(0); }
    let entry: addr = scratch + link;
    let active_owner: u64 = meta_cell_get(entry);
    if active_owner == owner { break active(1); }
    let previous: u64 = meta_cell_get(entry + 8);
    continue active(previous);
  };
  if cycle {
    // 5 是当前类型解析/布局的稳定语义拒码；旁格让外层字段扫描不覆盖它。
    let set_cycle: u32 = meta_cell_put(scratch + 464, 1);
    let recursive: u32 = lain_meta_fail(5);
    return 0;
  }
  let mark: u64 = meta_bump_mark();
  let frame: u64 = meta_bump_alloc(16);
  if frame == 0xFFFFFFFFFFFFFFFF { return 0; }
  let frame_addr: addr = scratch + frame;
  let save_owner: u32 = meta_cell_put(frame_addr, owner);
  let save_previous: u32 = meta_cell_put(frame_addr + 8, top);
  let push: u32 = meta_cell_put(scratch + 456, frame);
  let body: u64 = meta_decl_body(base, node);
  let size: u64 = meta_layout_size(base, len, body);
  let failed: bool = size == 0xFFFFFFFFFFFFFFFF;
  // 一次性选择循环：failed → 0；否则先算 align / valid，valid 才 meta_intern。
  // 旧 IR 的求值顺序逐条保留，末尾 restore_top / release 仍在循环之后执行。
  let id: u64 = loop pick_id(t: u64 = 0) {
    if failed { break pick_id(0); }
    let align: u64 = meta_layout_align(base, len, body);
    let valid: bool = align > 0;
    if valid {
      let new_id: u64 = meta_intern(2, owner, 0, size, align);
      break pick_id(new_id);
    }
    break pick_id(0);
  };
  let restore_top: u32 = meta_cell_put(scratch + 456, top);
  let release: u32 = meta_bump_release(mark);
  return id;
}

// --- 发射 -----------------------------------------------------------------

// 写 n 个 "0 "（给 data 的初值）
func meta_emit_zeros(n: u64) -> u32 {
  let st: u32 = loop scan(i: u64 = 0) {
    let more: bool = i < n;
    if more {
      let w: u32 = lainir_zero_text();
      let i2: u64 = i + 1;
      continue scan(i2);
    } else {
      break scan(0);
    }
  };
  return st;
}

// 字段地址文本：`#lea(<基址引用>, 0, 0, <off>)`，写进 `%buf` 的 32 偏移处。
//
// `%base_n` 是「基址引用哪个值」：`0xFFFFFFFFFFFFFFFF` 用顶层的**字面名字** `%base`
// （顶层构造过程里那个固定名字），其余是临时值编号 —— 函数体内的构造，基址来自
// `#alloca` 的结果 `%r<n>`。**不能**让两处都叫 `%base`：装载器的 `region_lookup`
// 按名字返回**第一个**匹配，同一个过程里重名会静默指向前一个。
func meta_emit_field_addr(buf: addr, off: u64, base_n: u64) -> u64 {
  let abase: addr = buf + 32;
  let named: bool = base_n != 0xFFFFFFFFFFFFFFFF;
  let blen: u64 = if named {
    let l: u64 = lainir_buf_temp(abase, 0, base_n);
    l
  } else {
    let b: addr = symbol_addr("lainir_base_name_storage");
    let l2: u64 = lainir_buf_bytes(abase, 0, b, 5);
    l2
  };
  let lbuf: addr = buf + 64;
  let alen: u64 = lainir_text_lea_field(lbuf, 0, abase, blen, off);
  return alen;
}

// 写一条 `  #store[repr](value, #lea(%base, 0, 0, off))`，值是**一个数**（`a: 1`）。
func meta_emit_store(kind: u64, width: u64, value: u64, off: u64, base_n: u64) -> u32 {
  let buf: addr = symbol_addr("lainir_text_buffer_storage");
  let vlen: u64 = lainir_buf_uint(buf, 0, value);
  let alen: u64 = meta_emit_field_addr(buf, off, base_n);
  let lbuf: addr = buf + 64;
  let w: u32 = lainir_store(kind, width, buf, vlen, lbuf, alen);
  return w;
}

// 写一条 `  #store[repr](<值文本>, #lea(%base, 0, 0, off))`：值文本由调用方渲染好
// （放在 `lainir_text_buffer` 的 0 起），地址那段与上面两条 store 同一个来源。
func meta_emit_store_text(kind: u64, width: u64, value_text: addr, value_len: u64, off: u64, base_n: u64) -> u32 {
  let buf: addr = symbol_addr("lainir_text_buffer_storage");
  let alen: u64 = meta_emit_field_addr(buf, off, base_n);
  let lbuf: addr = buf + 64;
  let w: u32 = lainir_store(kind, width, value_text, value_len, lbuf, alen);
  return w;
}

// 初始化列表 `{ f: v f: v }`：每个字段一条 store，值是**一条表达式**（`a: p + 1`）。
//
// 走**游标**（花括号组 + 下标）：值到哪结束只有表达式那条路答得出来 —— 「下一个字段名」
// （一个槽后面紧跟 `:`）由 `meta_emit_expr` 当终点，终止下标放在暂存区 `+192`。
//
// 归档的 %st 值 if（真支 fail(4) + 4，假支是一整个 #loop）结果喂给 #return，改成
// 平坦守卫；u8 比较先 as u32。
func meta_construct_fields(base: addr, len: u64, body: u64, group: u64, base_n: u64) -> u32 {
  let gnone: bool = group == 0;
  if gnone {
    // 初始化列表不是组：形状坏了
    let fg: u32 = lain_meta_fail(4);
    return 4;
  }
  let count: u64 = ast_child_count(group);
  let r: u32 = loop fields(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let fnode: u64 = ast_child(group, i);
      let f_lo: u64 = meta_node_start(fnode);
      let f_hi: u64 = f_lo + meta_node_len(fnode);
      // 逗号（`a: 1, b: 2` 的写法）夹在字段之间：跳掉
      let fb: u8 = bs_byte_at(base, f_lo, len);
      let fb_w: u32 = fb as u32;
      let iscomma: bool = fb_w == 44;
      if iscomma {
        continue fields(i + 1);
      }
      let info: u64 = meta_layout_field(base, len, body, f_lo, f_hi);
      // 走表不中就是错的：不能把「走到 } 得到的总大小」当成字段偏移用。
      let found: u64 = info >> 63;
      let missing: bool = found == 0;
      if missing {
        let f: u32 = lain_meta_fail(8);
        break fields(8);
      }
      let off: u64 = info and 0xFFFFFFFFFF;
      let kind: u64 = (info >> 40) and 15;
      let width: u64 = (info >> 44) and 255;
      // 名字、冒号各占一格，值是第三格起的那条表达式
      let vi: u64 = i + 2;
      let vst: u32 = meta_emit_expr(base, len, kind, width, 0, 0, group, vi, 0, 0, 0, 0);
      let vbad: bool = vst != 0;
      if vbad {
        break fields(vst);
      }
      let sc: addr = lain_meta_scratch_data();
      let vref: u64 = meta_cell_get(sc + 168);
      let vlo: u64 = meta_cell_get(sc + 176);
      let vhi: u64 = meta_cell_get(sc + 184);
      let nx: u64 = meta_cell_get(sc + 192);
      let vbuf: addr = symbol_addr("lainir_text_buffer_storage");
      let vlen: u64 = meta_render_ref2(base, len, vref, vlo, vhi, vbuf);
      let lenbad: bool = vlen == 0xFFFFFFFFFFFFFFFF;
      if lenbad {
        let fl: u32 = lain_meta_fail(4);
        break fields(4);
      }
      let w: u32 = meta_emit_store_text(kind, width, vbuf, vlen, off, base_n);
      let wn: bool = w != 0;
      if wn {
        break fields(w);
      }
      // 表达式停在下一格：那是下一个字段名、夹着的逗号、或者组的末尾
      continue fields(nx);
    } else {
      break fields(0);
    }
  };
  return r;
}

// `let NAME = Rec { ... }`：
//   data NAME_storage rw { 0 ... }
//   #proc NAME() -> #addr { %base = #data_addr NAME_storage; stores; #return %base }
//
// `type_body` 是那个类型声明的正文起点——**从符号表取**（`meta_scope_body`），
// 不是每次回源码里找一遍。`group` 是初始化列表那个**组节点**——字段值是一条表达式，
// 走的是游标（组 + 下标），所以调用方把组一起给进来。
func meta_lower_construct(base: addr, len: u64, bind_lo: u64, bind_hi: u64, type_body: u64, group: u64) -> u32 {
  let size: u64 = meta_layout_size(base, len, type_body);
  let failed: bool = size == 0xFFFFFFFFFFFFFFFF;
  if failed {
    let reset: u32 = lain_meta_emit_reset();
    let eval_code: u64 = lain_meta_apply_status();
    let has_eval_code: bool = eval_code > 0;
    // 归档的 %code 值 if：两支都是纯表达式（真支里只有一个 let），照旧写值 if。
    let code: u32 = if has_eval_code {
      let low: u32 = eval_code as u32;
      low
    } else {
      7
    };
    return code;
  }
  let bind_at: addr = base + bind_lo;
  let bind_len: u64 = bind_hi - bind_lo;

  let w1: u32 = lainir_data_head();
  let w2: u32 = lainir_write(bind_at, bind_len);
  let w3: u32 = lainir_data_rw_head();
  let w4: u32 = meta_emit_zeros(size);
  let w5: u32 = lainir_proc_head_open();

  let w6: u32 = lainir_write(bind_at, bind_len);
  let w7: u32 = lainir_addr_body_write();
  let w8: u32 = lainir_base_assign_write();
  let w9: u32 = lainir_write(bind_at, bind_len);
  let w10: u32 = lainir_storage_suffix_write();

  let st: u32 = meta_construct_fields(base, len, type_body, group, 0xFFFFFFFFFFFFFFFF);

  let w11: u32 = lainir_return_base_close();
  return st;
}

// `let p = Rec { ... }` / `return Rec { ... }` **在函数体里**。
//
// 顶层那份（`meta_lower_construct`）落一个静态 `data` 块；函数体里发不出顶层 `data`
// （发射是流式的），所以从**栈**上划一块：
//
//   %r<n> = #alloca[#bits<8>](size)
//   #store[...](value, #lea(%r<n>, 0, 0, off))
//   ...
//   %p = #lea(%r<n>, 0, 1, 0)        // 绑定；`return` 那一格换成 `#return %r<n>`
//
// `#alloca` 从栈租约的水位递增，帧退出时水位回退（`stack_mark`），所以这块地址
// **不能带出函数** —— 同 C 返回局部地址。框对齐到 16 字节。
//
// `%type_lo`/`%type_hi` 是构造名（`Rec`）的位置，`%group` 是那个花括号组节点。
//
// 归档的 %missing / %bad / %empty 值 if 都改成平坦守卫；%tail 值 if 两支都是纯
// 表达式（支里只有 let），照旧写值 if。
func meta_lower_construct_local(base: addr, len: u64, name_lo: u64, name_hi: u64, type_lo: u64, type_hi: u64, group: u64, is_ret: bool) -> u32 {
  let body: u64 = meta_scope_body(base, type_lo, type_hi, 4);
  let missing: bool = body == 0xFFFFFFFFFFFFFFFF;
  if missing {
    // 名字不是积类型（和类型变体在函数体里的构造还没做）
    let nf: u32 = lain_meta_fail(4);
    return 4;
  }
  let size: u64 = meta_layout_size(base, len, body);
  let bad: bool = size == 0xFFFFFFFFFFFFFFFF;
  if bad {
    let reset: u32 = lain_meta_emit_reset();
    let eval_code: u64 = lain_meta_apply_status();
    let has_eval_code: bool = eval_code > 0;
    let code: u32 = if has_eval_code {
      let low: u32 = eval_code as u32;
      low
    } else {
      7
    };
    return code;
  }
  let empty: bool = size == 0;
  if empty {
    // 空类型没有可划的框；count 为 0 的 `#alloca` 被验证器拒（2024）
    let zero: u32 = lain_meta_fail(5);
    return 5;
  }
  let n: u64 = meta_next_temp();
  let w7: u32 = lainir_alloca_at(n, 8, size);
  let st: u32 = meta_construct_fields(base, len, body, group, n);
  if st != 0 {
    return st;
  }
  let tail: u32 = if is_ret {
    let buf: addr = symbol_addr("lainir_text_buffer_storage");
    let tlen: u64 = lainir_buf_temp(buf, 0, n);
    let w10: u32 = lainir_return_ref(buf, tlen);
    0
  } else {
    let buf2: addr = symbol_addr("lainir_text_buffer_storage");
    let tbuf: addr = buf2 + 64;
    let tlen2: u64 = lainir_buf_temp(tbuf, 0, n);
    let nbuf: addr = buf2 + 128;
    let npct: u64 = lainir_buf_byte(nbuf, 0, 37);
    let bind_at: addr = base + name_lo;
    let bind_len: u64 = name_hi - name_lo;
    let nlen: u64 = lainir_buf_bytes(nbuf, npct, bind_at, bind_len);
    let zbuf: addr = buf2 + 180;
    let zlen: u64 = lainir_buf_uint(zbuf, 0, 0);
    let w17: u32 = lainir_lea_named(nbuf, nlen, tbuf, tlen2, zbuf, zlen, 1, 0);
    0
  };
  return tail;
}

// `let NAME = Rec.field(VAR)` —— v0 里记录名和值名都写出来，
// 所以不需要值表。`p.left` 那种写法要一张「值名 → 类型名」的表，是下一步。
func meta_lower_field_access(base: addr, len: u64, bind_lo: u64, bind_hi: u64, type_body: u64, at: u64) -> u32 {
  let f_lo: u64 = bs_skip_space(base, at, len);
  let f_hi: u64 = bs_skip_ident(base, f_lo, len);
  let paren: u64 = bs_skip_space(base, f_hi, len);
  let one: u64 = paren + 1;
  let v_lo: u64 = bs_skip_space(base, one, len);
  let v_hi: u64 = bs_skip_ident(base, v_lo, len);

  let info: u64 = meta_layout_field(base, len, type_body, f_lo, f_hi);
  let off: u64 = info and 0xFFFFFFFFFF;
  let kind: u64 = (info >> 40) and 15;
  let width: u64 = (info >> 44) and 255;

  let bind_at: addr = base + bind_lo;
  let bind_len: u64 = bind_hi - bind_lo;
  let var_at: addr = base + v_lo;
  let var_len: u64 = v_hi - v_lo;

  let buf: addr = symbol_addr("lainir_text_buffer_storage");
  let bbuf: addr = buf + 128;
  let h: u32 = lainir_proc_head_full(bind_at, bind_len, bbuf, 0, kind, width);
  let o: u32 = lainir_open_body();
  let b: addr = symbol_addr("lainir_name_b_storage");
  let v: addr = symbol_addr("lainir_name_v_storage");
  let c1: u32 = lainir_call_named(b, 2, var_at, var_len, bbuf, 0);
  let b2: addr = symbol_addr("lainir_name_b2_storage");
  let zbuf: addr = buf + 180;
  let zlen: u64 = lainir_buf_uint(zbuf, 0, 0);
  let l1: u32 = lainir_lea_named(b2, 3, b, 2, zbuf, zlen, 1, off);
  let l2: u32 = lainir_load_named(v, 2, kind, width, b2, 3);
  let r2: u32 = lainir_return_ref(v, 2);
  let c2: u32 = lainir_close_body();
  return 0;
}

// `p.x` 当值用：`p` 是**一个值**（函数参数，类型从参数表来），字段偏移在编译期从
// 类型正文算出来，然后发两条指令：`#lea` 取字段地址（基址是值本身、下标 0、缩放 1、
// 位移是字段偏移），`#load` 按字段类型取出值。取值结果的临时值下标写进暂存区 +168
// （+176/+184 清零）—— 与 `meta_operand_emit` 的约定一致：调用方从 168/176/184 这一
// 组读「结果是谁」。
func meta_lower_field_get(base: addr, len: u64, v_lo: u64, v_hi: u64, type_body: u64, f_lo: u64, f_hi: u64) -> u32 {
  let info: u64 = meta_layout_field(base, len, type_body, f_lo, f_hi);
  let found: u64 = info >> 63;
  let missing: bool = found == 0;
  if missing {
    // 走表不中：那是错的，不能拿「走到 } 得到的总大小」当字段偏移用。
    let f: u32 = lain_meta_fail(8);
    return 8;
  }
  let off: u64 = info and 0xFFFFFFFFFF;
  let kind: u64 = (info >> 40) and 15;
  let width: u64 = (info >> 44) and 255;

  // 缓冲区（`lainir_text_buffer`，192 字节）分段：0 起是 lea 结果的临时值名、
  // 32 起是值名（带 `%`）、64 起是 load 结果的临时值名、180 是 lea 的下标 `0`。
  let buf: addr = symbol_addr("lainir_text_buffer_storage");
  let v_at: addr = base + v_lo;
  let v_n: u64 = v_hi - v_lo;
  let pfx: u64 = lainir_buf_byte(buf, 32, 37);
  let v_end: u64 = lainir_buf_bytes(buf, pfx, v_at, v_n);
  let v_len: u64 = v_end - 32;
  let v_txt: addr = buf + 32;
  let zbuf: addr = buf + 180;
  let zlen: u64 = lainir_buf_uint(zbuf, 0, 0);

  let n1: u64 = meta_next_temp();
  let l1: u64 = lainir_buf_temp(buf, 0, n1);
  let w1: u32 = lainir_lea_named(buf, l1, v_txt, v_len, zbuf, zlen, 1, off);

  let n2: u64 = meta_next_temp();
  let tbuf: addr = buf + 64;
  let l2: u64 = lainir_buf_temp(tbuf, 0, n2);
  let w2: u32 = lainir_load_named(tbuf, l2, kind, width, buf, l1);

  let sc: addr = lain_meta_scratch_data();
  let s1: u32 = meta_cell_put(sc + 168, n2);
  let s2: u32 = meta_cell_put(sc + 176, 0);
  let s3: u32 = meta_cell_put(sc + 184, 0);
  return 0;
}

// `p.x` 出现在操作数位置（返回、绑定、实参、更大的表达式里）。形状 6 说的是「这里
// 开始一次字段访问」，形状判据已由识别 pass 算好，所以这里只解析两段字节区间：值名
// （点号左边那个 token）与字段名（点号右边）。
//
// 值名的类型**只认函数参数**（`meta_word_type_name`）：局部绑定与循环参数今天没有
// 「值名 → 类型」的表，干净地报 4。类型正文从符号表取，字段偏移在编译期算出。
//
// 归档嵌套值 if（%st / %g）结果都喂给 #return，改成平坦守卫。
func meta_emit_field_temp(base: addr, len: u64, parent: u64, index: u64) -> u32 {
  let node: u64 = ast_child(parent, index);
  let v_lo: u64 = meta_node_start(node);
  let v_hi: u64 = v_lo + meta_node_len(node);
  let after: u64 = bs_skip_space(base, v_hi, len);
  let dot: u64 = after + 1;
  let f_lo: u64 = bs_skip_space(base, dot, len);
  let f_hi: u64 = bs_skip_ident(base, f_lo, len);

  let t_lo: u64 = meta_word_type_name(base, len, node);
  let sc: addr = lain_meta_scratch_data();
  let t_hi: u64 = meta_cell_get(sc + 0);
  let unknown: bool = t_lo == 0xFFFFFFFFFFFFFFFF;
  if unknown {
    let f1: u32 = lain_meta_fail(4);
    return 4;
  }
  let tb: u64 = meta_scope_body(base, t_lo, t_hi, 4);
  let nobody: bool = tb == 0xFFFFFFFFFFFFFFFF;
  if nobody {
    // 值名的声明类型不是积类型（和类型的变体投影是另一条路）
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  let gz: u32 = meta_lower_field_get(base, len, v_lo, v_hi, tb, f_lo, f_hi);
  return gz;
}
