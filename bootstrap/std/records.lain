// 初代标准库 v0 —— 积类型：构造与字段访问。
// 由 bootstrapl1/std/records.l1 翻译成 Lain 表面语法。
//
// 降级 `p.a` 的时候，发 `#load[#bits<32>]` 要**编译期就知道**偏移和宽度。
// 字段偏移是 struct 声明时算出来的，但目前只有那几个 offset/size **过程**
// ——过程是运行时才叫得动的，编译期用不上。
//
// 所以这里要在编译期把布局再算一遍：从这个类型的正文起点开始，累加偏移直到
// 命中字段名。**正文起点来自符号表**（`meta_scope_body`：条目里记的就是那条
// 声明的节点），所以不用回源码里找声明。
//
// 以前这里是「按需回源码里再走一遍那条 struct 声明」，每个字段一次 O(n) 扫描；
// 那句注释当时写着「真正的做法是一张编译期符号表，那是下一步」——现在它在
// `std/scope.l1` 里了。
//
// 打包：`偏移` 在低 40 位、`kind` 在 40..43、`width` 在 44..51、命中在最高位。
// 走到 `}` 时返回的是**总大小**（最高位 0）——同一个走法服务两种问题。

// `meta_find_keyword`（从某个位置起逐字节找关键字）**已经删了**：按名字找声明
// 现在走语法树（`meta_find_decl`）。它和 `bs_next_form` 是同一类东西——「搜」，
// 而不是「认」。

// 翻译说明（表面语言的值 if 支里不能再写语句 if / 值 if；bool 值 if 的 else 支
// 不能是裸 0；u8 没有算子表；循环参数会遮蔽外层同名绑定）：
//   * 本单元**没有自己的静态块**（归档 22 个过程、0 个 data），所以本体里没有
//     `let NAME: ro [u8]`。通过 `#data_addr` 取址的 5 个符号都定义在**别的单元**
//     （bootstrapl1/std/lainir.l1），取址一律写成 symbol_addr("NAME_storage")
//     （编译器发布的数据符号带 _storage 后缀，绑定名本身不是符号，见
//     bootstrap/std/scalars.lain 与 bootstrap/std/modules.lain）：
//     lainir_base_name / lainir_name_b / lainir_name_b2 / lainir_name_v /
//     lainir_text_buffer。字节数组在编译夹具里给临时定义（192 字节的
//     lainir_text_buffer 全 0）。
//   * 「值 if 结果直接喂给 #return」的地方逐条改写成平坦守卫（命中即 return），
//     条件按旧 IR 的原顺序求值，只有原来会走到的分支才被求值：meta_decl_body 的
//     %r/%v、meta_scope_body 的 %r/%v/%body、meta_layout_field 的 %r、
//     meta_field_type_window 的 %r、meta_operand_type_window 的 %r/%fw、
//     meta_layout_size 的 %r/%size、meta_construct_fields 的 %st、
//     meta_lower_construct_local 的 %missing/%bad/%empty、
//     meta_emit_field_temp 的 %st/%g。
//   * meta_walk_fields / meta_field_type_window / meta_layout_align /
//     meta_construct_fields 里的 u8 比较（#eq[#bits<8>]）按表面语言的规矩先
//     `as u32` 再比常量。
//   * meta_walk_fields / meta_field_type_window 的 %same 值 if 结果喂给语句 if，
//     且 bool 值 if 的 else 支是裸 0（验证器 2005）：按既有写法改成平坦守卫 ——
//     `len_ok` 成立才算 %a / %b / %same，命中即 break，顺序与副作用与旧 IR 一致。
//   * meta_record_type_id 的 %id 值 if 结果喂给 #return，但#return 之前还有
//     restore_top / release 两条语句**无条件执行**，所以不能改平坦守卫（会把
//     释放跳掉）：按既有写法（见 bootstrap/std/eval.lain 的 pick_result 与
//     bootstrap/std/modules.lain 的 pick_end / pick_body）改成一次性选择循环
//     pick_id —— 先判 failed，再算 align / valid，最后 meta_intern，求值顺序与
//     旧 IR 逐条相同，末尾 restore_top / release 仍在循环之后无条件执行。
//   * meta_lower_construct 的 %code 与 meta_lower_construct_local 的 %tail 值 if
//     两支都是纯表达式（支里只有 let），照旧写值 if（同 bootstrap/std/eval.lain 的
//     %code 值 if）。
//   * meta_walk_fields 的循环参数在归档里叫 %at / %off / %al，其中 %at 与函数参数
//     %at 同名（归档里循环初始值取的就是外层 %at）；表面语言里循环参数会遮蔽外层
//     同名绑定，所以循环参数改名 cur_at / cur_off / cur_al，初值仍取外层 %at /
//     %off0 / %al0，语义不变。
//   * 旧 IR 的 %w1…%w11 / %w17 / %c1 / %c2 / %r2 / %l1 / %l2 / %s1…%s3 / %h / %o /
//     %put / %fg / %fl / %f / %nf / %zero / %bad / %reset / %save_* / %push /
//     %restore_top 等不被读的值只取调用副作用，照旧保留为 let 绑定（死局部保留，
//     不做清理）。
//   * meta_emit_expr 的 need_semi 是 bool 参数，归档传 0，这里照旧传 0（与
//     bootstrapl1/meta.l1 的调用点一致）。
//   * 本单元这批依赖里没有 ref / slice 这两个保留字参数名。归档里 meta_node_* 的
//     末参在规范签名里按脚本给的名字写成 ref_value，meta_render_ref2 的 %ref 写成
//     ref_v，meta_intern 的 %rw 写成 rw_v —— 都只是形参改名，链接名原样保留。
//   * 归档里几处 `#or` 原样保留为 `or`（不是改成加法）：
//     `#or(#shl(src1, 32), pos + 1)`（src1 占高 32 位、pos + 1 占低 32 位，位域
//     不相交）、`#or(aligned, kind << 40)` / `#or(pk1, width << 44)` /
//     `#or(pk2, 0x8000000000000000)`（偏移 < 2^40、kind 占 40..43、width 占
//     44..51、命中标志占 bit63，四段不相交）、以及
//     `#or[#bits<1>](failed_sentinel, failed_zero)`（1 位值上的按位 or 与逻辑 or
//     同义）。保留 or 与旧 IR 逐位相同。

// 跨单元 / Host 依赖的规范签名（由 meta_sig_index.py 从 bootstrapl1/std/records.l1
// 的调用点与各定义单元核对得到，链接名原样保留）。旧 IR 的宽度 #bits<N> 已归一为
// 表面语言的标量类型。本单元没有任何归档 `#extern` 过程，也不重复声明本文件里定义的
// 那 22 个过程 —— 下面每一条都在**别的**单元里定义。
extern ast_child(node: u64, index: u64) -> u64 = ast_child;
extern ast_child_count(node: u64) -> u64 = ast_child_count;
extern bs_align_up(v: u64, a: u64) -> u64 = bs_align_up;
extern bs_byte_at(base: addr, at: u64, len: u64) -> u8 = bs_byte_at;
extern bs_skip_ident(base: addr, start: u64, len: u64) -> u64 = bs_skip_ident;
extern bs_skip_qualified(base: addr, start: u64, len: u64) -> u64 = bs_skip_qualified;
extern bs_skip_space(base: addr, start: u64, len: u64) -> u64 = bs_skip_space;
extern lain_meta_apply_status() -> u64 = lain_meta_apply_status;
extern lain_meta_emit_reset() -> u32 = lain_meta_emit_reset;
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
