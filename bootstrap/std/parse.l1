// 初代标准库 v0 —— 从机制源码树复制词和组，供识别 pass 标注语义。
//
// 在这之前，「读源码」是拿字符找模式：跳空白、读标识符、匹配关键字字节、猜一条
// 形式到哪结束。它不知道程序是有结构的，所以每个使用点都要重搜一遍，而且
// 「`letter` 里的 let」「注释里的 scalar」这类东西会被当成声明——都真的出过。
//
// 词法和括号配对由机制源码树完成；本文件只把公开节点复制到可写的语义树。
//
// 树只有两种节点：
//
//   词 —— 一段连续的字母数字（`struct`、`Pair`、`i32`、`42`），或者一个标点
//   组 —— 一对括号，连同里面装的东西
//
// 没有第三种。**它不认识 let / struct / enum**——那些是 Meta 的事。正因如此这层
// 是跟语言无关的。
//
// 每个节点摊平成一格，48 字节，六个数：
//
//   +0  节点种类（1 = 词，2 = 组；识别 pass 之后往后长，见文件末 meta_recognize）
//   +8  它在源码里的起点
//   +16 它的长度
//   +24 它的第一个孩子（组的才有意义；没有孩子是「无」）
//   +32 它的下一个兄弟（没有兄弟是「无」）
//   +40 它的类型（第 3 步「表达式带类型」要挂的地方；现在一律 0）
//
// 步长 48 硬编码在 `meta_tree_field` / `meta_tree_set` 两处，改要一起改。
// 计划里原本写 8 个数（加 `end` / `origin` / `hygiene`），核过之后改成 6 个：
// `start + len` 已经就是 extent，再加 `end` 是冗余；`origin`/`hygiene` 是「哪份
// 源码 + 起点 + 长度」三个值，塞进一格会变成半个设计，等真有合成节点的消费者再说。
//
// 「第一个孩子 + 下一个兄弟」两句话就能表达任意形状的树，不需要指针——只有一排
// 格子，正好合上「Meta 手里只有整数、地址、和一块可写内存」这个约束。
//
// 复制仍按后序：公开树的孩子先入可写表，父节点随后追加并记录首孩子。

// 节点的第 word 个数（0..5）
// 越界的下标（NONE）直接回 NONE，不去算地址：源码写残了的时候，`next`/`child`
// 会一路把 NONE 传回来，要是照样乘 48 就是读到暂存区外面去了。
// 这一条让所有节点访问器对 NONE 都是安全的——形状检查才敢「先问再取」。
#proc meta_tree_field(%host: #addr, %index: #bits<64>,
                       %word: #bits<64>) -> #bits<64> {
  %none = #eq[#bits<64>](%index, 0xFFFFFFFFFFFFFFFF)
  %v = #if %none -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %scratch = #call lain_meta_scratch_data(%host)
    %base = #call meta_cell_get(#lea(%scratch, 112, 1, 0))
    %p = #lea(%scratch, %base, 1, 0)
    %off = #mul[#bits<64>](%index, 48)
    %q = #lea(%p, %off, 1, 0)
    %shift = #mul[#bits<64>](%word, 8)
    %cell = #lea(%q, %shift, 1, 0)
    %f = #call meta_cell_get(%cell)
    #yield %f
  }
  #return %v
}

#proc meta_tree_set(%host: #addr, %index: #bits<64>, %word: #bits<64>,
                     %v: #bits<64>) -> #bits<32> {
  %scratch = #call lain_meta_scratch_data(%host)
  %base = #call meta_cell_get(#lea(%scratch, 112, 1, 0))
  %p = #lea(%scratch, %base, 1, 0)
  %off = #mul[#bits<64>](%index, 48)
  %q = #lea(%p, %off, 1, 0)
  %shift = #mul[#bits<64>](%word, 8)
  %cell = #lea(%q, %shift, 1, 0)
  %s = #call meta_cell_put(%cell, %v)
  #return 0
}

#proc meta_tree_count(%host: #addr) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data(%host)
  %v = #call meta_cell_get(#lea(%scratch, 120, 1, 0))
  #return %v
}

#proc meta_tree_root(%host: #addr) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data(%host)
  %v = #call meta_cell_get(#lea(%scratch, 128, 1, 0))
  #return %v
}

// 追加一格，返回它的下标。装不下报 17——**不截断**：截断会读出一棵残缺的树，
// 而「树里没有」和「源码里没有」就分不开了。
#proc meta_tree_add(%host: #addr, %kind: #bits<64>, %start: #bits<64>,
                     %length: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data(%host)
  %count = #call meta_cell_get(#lea(%scratch, 120, 1, 0))
  %cap = #call meta_cell_get(#lea(%scratch, 136, 1, 0))
  %full = #uge[#bits<64>](%count, %cap)
  %idx = #if %full -> (#bits<64>) {
    %f = #call lain_meta_fail(%host, 17)
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %s0 = #call meta_tree_set(%host, %count, 0, %kind)
    %s1 = #call meta_tree_set(%host, %count, 1, %start)
    %s2 = #call meta_tree_set(%host, %count, 2, %length)
    %s3 = #call meta_tree_set(%host, %count, 3, 0xFFFFFFFFFFFFFFFF)
    %s4 = #call meta_tree_set(%host, %count, 4, 0xFFFFFFFFFFFFFFFF)
    // 类型格：一律先清零。「没类型」和「类型是 0 号」必须分得开，所以 0 号类型
    // 不能是任何真实类型（注册表从 1 开始数）。
    %s6 = #call meta_tree_set(%host, %count, 5, 0)
    %new = #add[#bits<64>](%count, 1)
    %s5 = #call meta_cell_put(#lea(%scratch, 120, 1, 0), %new)
    #yield %count
  }
  #return %idx
}

// 节点的字段（0 = 种类，1 = 起点，2 = 长度，3 = 第一个孩子，4 = 下一个兄弟，
// 5 = 类型）。名字写短一点，调用点才看得清。
#proc meta_node_kind(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 0)
  #return %v
}

#proc meta_node_start(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 1)
  #return %v
}

#proc meta_node_len(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 2)
  #return %v
}

#proc meta_node_child(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 3)
  #return %v
}

#proc meta_node_next(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 4)
  #return %v
}

// 类型格。0 = 还没类型（建树时一律清零）。0 号类型不是任何真实类型，所以
// 「没类型」和「类型是 0 号」不会混。
#proc meta_node_type_id(%host: #addr, %i: #bits<64>) -> #bits<64> {
  %v = #call meta_tree_field(%host, %i, 5)
  #return %v
}

#proc meta_node_set_type_id(%host: #addr, %i: #bits<64>,
                            %v: #bits<64>) -> #bits<32> {
  %s = #call meta_tree_set(%host, %i, 5, %v)
  #return 0
}

// 识别 pass 写回种类用这个（词/组 → 声明/二元/调用/字段…）。
#proc meta_node_set_kind(%host: #addr, %i: #bits<64>,
                         %v: #bits<64>) -> #bits<32> {
  %s = #call meta_tree_set(%host, %i, 0, %v)
  #return 0
}

// 这份源码的根节点。每份源码各有一棵树，根下标按源码下标存。
#proc meta_root_of(%host: #addr, %source: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data(%host)
  %base = #call meta_cell_get(#lea(%scratch, 128, 1, 0))
  %p = #lea(%scratch, %base, 1, 0)
  %off = #mul[#bits<64>](%source, 8)
  %q = #lea(%p, %off, 1, 0)
  %v = #call meta_cell_get(%q)
  #return %v
}

// 这个节点是不是「字面量 kw」，也就是一个词，内容正好是那串字节？
// **这就是「按形状认，不按字节搜」的落点**：不再问「源码里哪儿有 struct 这三个
// 字母」，而是问「这个节点是不是一个内容为 struct 的词」。
#proc meta_node_is_word(%host: #addr, %i: #bits<64>, %base: #addr,
                         %kw: #addr, %kw_len: #bits<64>) -> #bits<1> {
  %kind = #call meta_node_kind(%host, %i)
  // 「是词」= 不是组、也不是「无」。**不能写 `kind == 1`**：识别 pass 会把词的种类
  // 从 1 改成 3..10（声明/二元/调用/字段/…），写死 1 的话识别之后一个关键字都认不
  // 出来。组永远是 2，所以「不是组」这个判据在整个识别前后都成立。
  %is_group = #eq[#bits<64>](%kind, 2)
  %is_none = #eq[#bits<64>](%kind, 0xFFFFFFFFFFFFFFFF)
  %not_group = #eq[#bits<1>](%is_group, 0)
  %not_none = #eq[#bits<1>](%is_none, 0)
  %is_word = #and[#bits<1>](%not_group, %not_none)
  %r = #if %is_word -> (#bits<1>) {
    %n = #call meta_node_len(%host, %i)
    %same_len = #eq[#bits<64>](%n, %kw_len)
    %e = #if %same_len -> (#bits<1>) {
      %st = #call meta_node_start(%host, %i)
      %p = #lea(%base, %st, 1, 0)
      %eqb = #call meta_bytes_equal(%p, %kw, %kw_len)
      #yield %eqb
    } else {
      #yield 0
    }
    #yield %e
  } else {
    #yield 0
  }
  #return %r
}

// 这个地址属于哪份源码？——查找函数靠它知道该走哪棵树，不用让调用方一层层把
// 源码下标传下来。地址之间不能直接比，所以先转成整数。
#proc meta_source_of(%host: #addr, %base: #addr) -> #bits<64> {
  %count = #call lain_meta_source_count(%host)
  %want = #ptr2int[#bits<64>](%base)
  %found = #loop s(%i: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %p = #call lain_meta_source_data(%host, %i)
      %have = #ptr2int[#bits<64>](%p)
      %same = #eq[#bits<64>](%have, %want)
      #if %same {
        #break s(%i)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %found
}

// `meta_find_decl`（按名字在源码顶层找一个 `关键字 名字`）**已经删了**。
//
// 它是「按名字找声明」那一半的过渡形态：从「拿字节从头搜」改成「走树找」。但真正
// 的答案是**符号表**——作用域表的条目里直接记着声明的节点下标，根本不用找。所以
// 连它一起删掉了：`meta_scope_body`（积/和类型）和 `meta_scope_type_id`（标量）
// 各自从条目里读。
//
// 留在 parse.l1 的只有「把源码读成树」和「节点怎么读」——找名字不是这一层的事。

// 一份源码的树根。
#proc meta_root_of_source(%host: #addr, %base: #addr) -> #bits<64> {
  %src = #call meta_source_of(%host, %base)
  %missing = #eq[#bits<64>](%src, 0xFFFFFFFFFFFFFFFF)
  %r = #if %missing -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %root = #call meta_root_of(%host, %src)
    #yield %root
  }
  #return %r
}

// 把一份源码读成一棵树，根是一个覆盖全文的组节点。根下标按源码下标记下来。
//
// 建完树紧接着跑一遍**识别 pass**（`std/recognize.l1`，语言相关的那一层）。这样
// 「读到树的时候形状已经写好」是个不变式，由一个调用点保证，不靠调用方记得。
#proc meta_copy_public_node(%host: #addr, %handle: #bits<64>) -> #bits<64> {
  %kind = #call lain_meta_tree_field(%host, %handle, 1)
  %start = #call lain_meta_tree_field(%host, %handle, 2)
  %length = #call lain_meta_tree_field(%host, %handle, 3)
  %token = #eq[#bits<64>](%kind, 1)
  %index = #if %token -> (#bits<64>) {
    %leaf = #call meta_tree_add(%host, 1, %start, %length)
    #yield %leaf
  } else {
    %group = #eq[#bits<64>](%kind, 2)
    %node = #if %group -> (#bits<64>) {
      %count = #call lain_meta_tree_field(%host, %handle, 7)
      %first = #loop children(%i: #bits<64> = 0,
                              %first: #bits<64> = 0xFFFFFFFFFFFFFFFF,
                              %last: #bits<64> = 0xFFFFFFFFFFFFFFFF) -> (#bits<64>) {
        %more = #ult[#bits<64>](%i, %count)
        #if %more {
          %child_handle = #call lain_meta_tree_child(%host, %handle, %i)
          %child = #call meta_copy_public_node(%host, %child_handle)
          %bad = #eq[#bits<64>](%child, 0xFFFFFFFFFFFFFFFF)
          #if %bad {
            #break children(0xFFFFFFFFFFFFFFFF)
          }
          %empty = #eq[#bits<64>](%first, 0xFFFFFFFFFFFFFFFF)
          %new_first = #if %empty -> (#bits<64>) {
            #yield %child
          } else {
            %link = #call meta_tree_set(%host, %last, 4, %child)
            #yield %first
          }
          %next = #add[#bits<64>](%i, 1)
          #continue children(%next, %new_first, %child)
        } else {
          #break children(%first)
        }
      }
      %nonempty = #ugt[#bits<64>](%count, 0)
      %no_child = #eq[#bits<64>](%first, 0xFFFFFFFFFFFFFFFF)
      %bad_children = #and[#bits<1>](%nonempty, %no_child)
      %result = #if %bad_children -> (#bits<64>) {
        #yield 0xFFFFFFFFFFFFFFFF
      } else {
        %g = #call meta_tree_add(%host, 2, %start, %length)
        %valid = #ne[#bits<64>](%g, 0xFFFFFFFFFFFFFFFF)
        #if %valid {
          %set = #call meta_tree_set(%host, %g, 3, %first)
        }
        #yield %g
      }
      #yield %result
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %node
  }
  #return %index
}

// 机制树的语法拒绝映射到 Meta v0 的旧码 3；资源与句柄错误保留宿主码。
#proc meta_public_tree_error(%host: #addr) -> #bits<32> {
  %status = #call lain_meta_status(%host)
  %parse = #eq[#bits<64>](%status, 34)
  %zero = #eq[#bits<64>](%status, 0)
  %old = #or[#bits<1>](%parse, %zero)
  %code = #if %old -> (#bits<32>) {
    #yield 3
  } else {
    %low = #trunc[#bits<32>](%status)
    #yield %low
  }
  #return %code
}

#proc meta_parse_source(%host: #addr, %source: #bits<64>) -> #bits<32> {
  %public_root = #call lain_meta_tree_root(%host, %source)
  %missing = #eq[#bits<64>](%public_root, 0)
  #if %missing {
    %code = #call meta_public_tree_error(%host)
    #return %code
  }
  %scratch = #call lain_meta_scratch_data(%host)
  %root = #call meta_copy_public_node(%host, %public_root)
  %invalid = #eq[#bits<64>](%root, 0xFFFFFFFFFFFFFFFF)
  #if %invalid {
    %code2 = #call meta_public_tree_error(%host)
    #return %code2
  }
  %rb = #call meta_cell_get(#lea(%scratch, 128, 1, 0))
  %rp = #lea(%scratch, %rb, 1, 0)
  %off = #mul[#bits<64>](%source, 8)
  %slot = #lea(%rp, %off, 1, 0)
  %s = #call meta_cell_put(%slot, %root)
  %rec = #call meta_recognize_source(%host, %source)
  #return 0
}
