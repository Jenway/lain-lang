// 初代标准库 v0 —— 源码注册表与 import。
//
// 解析规则：**逻辑路径全路径精确匹配，不做末段回退。**
//
//   import("std::math")  →  注册路径 "std/math.lain"
//
// `::` 对 `/`，末尾补 `.lain`（逻辑路径里自己写了 `.lain` 也接受）。逐字节比较
// 整条路径，找不到就是错误（status 11）。这和旧塔不同：旧塔对非 std 的 import
// **只比 basename**，已证实会把 `packages::lain::lainvm::api_contract` 绑到
// `src/lainir/api_contract.lain`（见 docs/implementation/module-namespaces.md §4.1）。
// 全路径匹配让那类歧义在机制上不可能发生。
//
// 注册表里每份源码的路径由宿主给（`lain_meta_source_path_data`），是 NUL 结尾的
// C 字符串——所以这里靠扫 0 取长度，不需要额外的长度能力。
//
// 命名空间绑定 `let M = import("std::math");` **不产出任何 LAINIR**：它是纯编译期
// 绑定。后面用到 `M.x` 时再回源码里扫这条 import 找回来——和积/和类型重算布局是
// 同一个办法，不建编译期表。
//
// 暂存区分段（宿主给 64 KiB）：
//   +0    和类型的最大载荷大小
//   +8    和类型的最大对齐
//   +64   import 逻辑路径的规范化缓冲区

data meta_kw_import ro { 105 109 112 111 114 116 }      // "import"  6
data meta_suffix_lain ro { 46 108 97 105 110 }          // ".lain"   5

// --- 宿主字符串与缓冲区 ---------------------------------------------------


// 两个 NUL 结尾字符串相等？同时走到 0 才算相等。
#proc meta_cstr_equal(%a: #addr, %b: #addr) -> #bits<1> {
  %r = #loop walk(%i: #bits<64> = 0) -> (#bits<1>) {
    %pa = #lea(%a, %i, 1, 0)
    %pb = #lea(%b, %i, 1, 0)
    %ba = #load[#bits<8>](%pa)
    %bb = #load[#bits<8>](%pb)
    %diff = #ne[#bits<8>](%ba, %bb)
    #if %diff {
      #break walk(0)
    }
    %end = #eq[#bits<8>](%ba, 0)
    #if %end {
      #break walk(1)
    }
    %i2 = #add[#bits<64>](%i, 1)
    #continue walk(%i2)
  }
  #return %r
}

#proc meta_buf_put(%buf: #addr, %capacity: #bits<64>,
                   %at: #bits<64>, %b: #bits<8>) -> #bits<32> {
  %fits = #ult[#bits<64>](%at, %capacity)
  #if #eq[#bits<1>](%fits, 0) { #return 17 }
  %p = #lea(%buf, %at, 1, 0)
  #store[#bits<8>](%b, %p)
  #return 0
}

// 往缓冲区写 n 个字节，返回写完后的下标。
#proc meta_buf_puts(%buf: #addr, %capacity: #bits<64>,
                    %at: #bits<64>, %src: #addr,
                    %n: #bits<64>) -> #bits<64> {
  %at_ok = #ule[#bits<64>](%at, %capacity)
  %remaining = #sub[#bits<64>](%capacity, %at)
  %length_ok = #ule[#bits<64>](%n, %remaining)
  %fits = #and[#bits<1>](%at_ok, %length_ok)
  #if #eq[#bits<1>](%fits, 0) { #return 0xFFFFFFFFFFFFFFFF }
  %end = #loop put(%k: #bits<64> = 0, %j: #bits<64> = %at) -> (#bits<64>) {
    %more = #ult[#bits<64>](%k, %n)
    #if %more {
      %p = #lea(%src, %k, 1, 0)
      %b = #load[#bits<8>](%p)
      %q = #lea(%buf, %j, 1, 0)
      #store[#bits<8>](%b, %q)
      %k2 = #add[#bits<64>](%k, 1)
      %j2 = #add[#bits<64>](%j, 1)
      #continue put(%k2, %j2)
    } else {
      #break put(%j)
    }
  }
  #return %end
}


// --- 路径规范化 -----------------------------------------------------------

// 逻辑路径末尾是不是已经写了 `.lain`？
#proc meta_ends_with_lain(%logical: #addr, %len: #bits<64>) -> #bits<1> {
  %enough = #uge[#bits<64>](%len, 5)
  %r = #if %enough -> (#bits<1>) {
    %off = #sub[#bits<64>](%len, 5)
    %p = #lea(%logical, %off, 1, 0)
    %suf = #data_addr meta_suffix_lain
    %eq = #call meta_bytes_equal(%p, %suf, 5)
    #yield %eq
  } else {
    #yield 0
  }
  #return %r
}

// 把逻辑路径规范化成注册路径的形状，写进 buf（NUL 结尾）。调用方保证 buf 够大。
#proc meta_build_path(%logical: #addr, %len: #bits<64>,
                      %buf: #addr, %capacity: #bits<64>) -> #bits<32> {
  %has = #call meta_ends_with_lain(%logical, %len)
  %suffix = #if %has -> (#bits<64>) { #yield 0 } else { #yield 5 }
  %need0 = #add[#bits<64>](%len, %suffix)
  %need = #add[#bits<64>](%need0, 1)
  %nowrap = #uge[#bits<64>](%need, %len)
  %fits = #ule[#bits<64>](%need, %capacity)
  %valid = #and[#bits<1>](%nowrap, %fits)
  #if #eq[#bits<1>](%valid, 0) { #return 17 }
  // `::` 变 `/`（吃掉第二个冒号）；单个 `:` 原样留着，它匹配不上就是匹配不上。
  %j = #loop put(%i: #bits<64> = 0, %j: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %len)
    #if %more {
      %is_colon = #call bs_is_byte(%logical, %i, 58)
      %raw = #call bs_byte_at(%logical, %i, %len)
      %out = #if %is_colon -> (#bits<8>) {
        #yield 47
      } else {
        #yield %raw
      }
      %p = #lea(%buf, %j, 1, 0)
      #store[#bits<8>](%out, %p)
      %j2 = #add[#bits<64>](%j, 1)
      %step = #if %is_colon -> (#bits<64>) {
        %i1 = #add[#bits<64>](%i, 1)
        %also = #call bs_is_byte(%logical, %i1, 58)
        %s = #if %also -> (#bits<64>) {
          #yield 2
        } else {
          #yield 1
        }
        #yield %s
      } else {
        #yield 1
      }
      %i2 = #add[#bits<64>](%i, %step)
      #continue put(%i2, %j2)
    } else {
      #break put(%j)
    }
  }
  %end = #if %has -> (#bits<64>) {
    #yield %j
  } else {
    %suf = #data_addr meta_suffix_lain
    %e = #call meta_buf_puts(%buf, %capacity, %j, %suf, 5)
    #yield %e
  }
  %zero = #call meta_buf_put(%buf, %capacity, %end, 0)
  #if #ne[#bits<32>](%zero, 0) { #return %zero }
  #return 0
}

// --- 查注册表 -------------------------------------------------------------

// 逻辑路径 → 源码下标；找不到返回 NOT_FOUND。查不到就**不回退**。
#proc meta_source_find(%logical: #addr,
                       %logical_len: #bits<64>) -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  // 诊断分段标记（安全格 2064）：1=进入、2=装不下、3=循环开始、4=全部不等
  %ms0 = #call meta_cell_put(#lea(%scratch, 2064, 1, 0), 1)
  %mcap0_ad = #data_addr meta_path_cap
  %mcap0 = #call meta_cell_get(%mcap0_ad)
  %mcw = #call meta_cell_put(#lea(%scratch, 2080, 1, 0), %mcap0)
  // 对照：同样方式读另一个 data 块（meta_reg_count_off 应为 512），
  // 以及读 meta_scalar_table 的头 8 字节（表的第一条记录开头）。
  %mreg_ad = #data_addr meta_reg_count_off
  %mreg = #call meta_cell_get(%mreg_ad)
  %mcw3 = #call meta_cell_put(#lea(%scratch, 2088, 1, 0), %mreg)
  %mlp_ad = #data_addr meta_scalar_table
  %mlp = #call meta_cell_get(%mlp_ad)
  %mcw4 = #call meta_cell_put(#lea(%scratch, 2096, 1, 0), %mlp)
  %mcnt = #call lain_meta_source_count()
  %mcw2 = #call meta_cell_put(#lea(%scratch, 2072, 1, 0), %mcnt)
  // 路径 / mangle 缓冲区：**位置**见 scope.l1 的 `meta_path_buffer`（动态区尾部，
  // 紧接语法树节点区），容量 352 字节。
  %cap_ad = #data_addr meta_path_cap
  %cap = #call meta_cell_get(%cap_ad)
  // `::` 只会变短，补 `.lain` 和 NUL 是最坏情况 +6
  %need = #add[#bits<64>](%logical_len, 6)
  %fits = #ule[#bits<64>](%need, %cap)
  %r = #if %fits -> (#bits<64>) {
    %pat = #call meta_path_buffer()
    %buf = #lea(%scratch, %pat, 1, 0)
    %b = #call meta_build_path(%logical, %logical_len, %buf, %cap)
    %count = #call lain_meta_source_count()
    %idx = #loop s(%i: #bits<64> = 0) -> (#bits<64>) {
      %more = #ult[#bits<64>](%i, %count)
      #if %more {
        %ms3a = #call lain_meta_scratch_data()
        %ms3 = #call meta_cell_put(#lea(%ms3a, 2064, 1, 0), 3)
        %p = #call lain_meta_source_path_data(%i)
        // 诊断（安全格 2032/2040）：把两边头 8 字节记下来，判断路径缓冲区
        // 是否被语义旁表覆盖（`%buf` = scratch+13448，而旁表也从此处开始）。
        %dsc = #call lain_meta_scratch_data()
        %da = #call meta_cell_get_raw(%buf)
        %dw = #call meta_cell_put(#lea(%dsc, 2032, 1, 0), %da)
        %db = #call meta_cell_get_raw(%p)
        %dw2 = #call meta_cell_put(#lea(%dsc, 2040, 1, 0), %db)
        %same = #call meta_cstr_equal(%p, %buf)
        #if %same {
          #break s(%i)
        }
        %i2 = #add[#bits<64>](%i, 1)
        #continue s(%i2)
      } else {
        %ms4a = #call lain_meta_scratch_data()
        %ms4 = #call meta_cell_put(#lea(%ms4a, 2064, 1, 0), 4)
        #break s(0xFFFFFFFFFFFFFFFF)
      }
    }
    #yield %idx
  } else {
    // 缓冲区装不下 → 它不可能等于任何注册路径
    %ms2a = #call lain_meta_scratch_data()
    %ms2 = #call meta_cell_put(#lea(%ms2a, 2064, 1, 0), 2)
    #yield 0xFFFFFFFFFFFFFFFF
  }
  #return %r
}

// --- import 的语法与降级 ---------------------------------------------------

// `bs_next_let`（逐字节找下一个 `let`）**已经删了**：顶层形式现在从语法树上走，
// 不用找。它当时还得额外要求「`let` 后面是空白」才能不把 `letter` 认错——那个补丁
// 正说明「搜字节」这条路本身不对。

// 从 `import` 的位置往下读 `("逻辑路径")`，返回逻辑路径首字节的下标；
// 形状不对返回 NOT_FOUND。
#proc meta_import_logical(%base: #addr, %len: #bits<64>,
                          %kw_at: #bits<64>) -> #bits<64> {
  %p = #add[#bits<64>](%kw_at, 6)
  %p1 = #call bs_skip_space(%base, %p, %len)
  %open = #call bs_is_byte(%base, %p1, 40)
  %r = #if %open -> (#bits<64>) {
    %q0 = #call bs_skip_space(%base, %p1, %len)
    %q1 = #add[#bits<64>](%q0, 1)
    %quote = #call bs_is_byte(%base, %q1, 34)
    %v = #if %quote -> (#bits<64>) {
      %start = #add[#bits<64>](%q1, 1)
      #yield %start
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %v
  } else {
    #yield 0xFFFFFFFFFFFFFFFF
  }
  #return %r
}

// 逻辑路径到收尾引号为止的长度。
#proc meta_logical_len(%base: #addr, %from: #bits<64>,
                        %len: #bits<64>) -> #bits<64> {
  %n = #loop scan(%i: #bits<64> = %from) -> (#bits<64>) {
    %b = #call bs_byte_at(%base, %i, %len)
    %stop = #eq[#bits<8>](%b, 34)
    %past = #uge[#bits<64>](%i, %len)
    %done = #or[#bits<1>](%stop, %past)
    #if %done {
      #break scan(%i)
    }
    %i2 = #add[#bits<64>](%i, 1)
    #continue scan(%i2)
  }
  %r = #sub[#bits<64>](%n, %from)
  #return %r
}

// `meta_import_at`（按绑定名回源码里找 `let X = import(...)`）**已经删了**：
// 查作用域表就够，逻辑路径位置记在条目的 aux 里。

// 按绑定名找回它的 import 逻辑路径下标（== `let M = import("...")` 里引号内的起点）。
// 查**作用域表**：命中的条目 kind 必须是 1（模块引用），逻辑路径位置记在 aux。
// 不是模块引用、或表里没有，都返回 0（「没找到」的哨兵——引号位置永远大于 0）。
#proc meta_find_import_binding(%base: #addr, %len: #bits<64>,
                               %ns_lo: #bits<64>,
                               %ns_hi: #bits<64>) -> #bits<64> {
  %name = #lea(%base, %ns_lo, 1, 0)
  %name_len = #sub[#bits<64>](%ns_hi, %ns_lo)
  %i = #call meta_scope_find(%name, %name_len)
  %miss = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %r = #if %miss -> (#bits<64>) {
    #yield 0
  } else {
    %kind = #call meta_scope_kind(%i)
    %is_ns = #eq[#bits<64>](%kind, 1)
    %v = #if %is_ns -> (#bits<64>) {
      %aux = #call meta_scope_aux(%i)
      #yield %aux
    } else {
      #yield 0
    }
    #yield %v
  }
  #return %r
}

// `let NAME = import("逻辑路径");` —— 解析并登记。**不产出任何 LAINIR**。
#proc meta_lower_import(%base: #addr, %len: #bits<64>,
                        %eq_at: #bits<64>) -> #bits<32> {
  %one = #add[#bits<64>](%eq_at, 1)
  %kw_at = #call bs_skip_space(%base, %one, %len)
  %lp = #call meta_import_logical(%base, %len, %kw_at)
  %bad = #eq[#bits<64>](%lp, 0xFFFFFFFFFFFFFFFF)
  %status = #if %bad -> (#bits<32>) {
    %f0 = #call lain_meta_fail(11)
    #yield 11
  } else {
    %n = #call meta_logical_len(%base, %lp, %len)
    %path = #lea(%base, %lp, 1, 0)
    %idx = #call meta_source_find(%path, %n)
    %miss = #eq[#bits<64>](%idx, 0xFFFFFFFFFFFFFFFF)
    %s = #if %miss -> (#bits<32>) {
      %f1 = #call lain_meta_fail(11)
      #yield 11
    } else {
      #yield 0
    }
    #yield %s
  }
  #return %status
}

// --- 命名空间成员：`M.x` ----------------------------------------------------
//
// LAINIR 的名字是扁平的，所以命名空间成员要 **mangle 成扁平名**才落得到物理层：
//
//   std/math.lain 里的 answer   →   std__math__answer
//
// 规则：去掉 `.lain`，`::`（也就是规范化之后的 `/` 的位置…不，是**逻辑路径里的
// `::`**）变 `__`，再拼 `__` 和成员名。v0 里导入的绑定只支持 `let NAME = INT;`
// 这一种形状，所以 repr 固定 `#bits<64>`——类型标注的导入是下一步。

// 逻辑路径 → mangle 前缀，写进 buf，返回长度。
#proc meta_build_mangle(%logical: #addr, %len: #bits<64>,
                         %buf: #addr) -> #bits<64> {
  %has_suffix = #call meta_ends_with_lain(%logical, %len)
  %body = #if %has_suffix -> (#bits<64>) {
    %five = #sub[#bits<64>](%len, 5)
    #yield %five
  } else {
    #yield %len
  }
  %j = #loop put(%i: #bits<64> = 0, %j: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %body)
    #if %more {
      %is_colon = #call bs_is_byte(%logical, %i, 58)
      %raw = #call bs_byte_at(%logical, %i, %body)
      %out = #if %is_colon -> (#bits<8>) {
        #yield 95
      } else {
        #yield %raw
      }
      %p = #lea(%buf, %j, 1, 0)
      #store[#bits<8>](%out, %p)
      %j2 = #add[#bits<64>](%j, 1)
      %i1 = #add[#bits<64>](%i, 1)
      %also = #call bs_is_byte(%logical, %i1, 58)
      %dbl = #and[#bits<1>](%is_colon, %also)
      // `::` 是两字节的分隔符，mangle 成两个下划线（`std::math` → `std__math`）。
      // 只发一个的话 `std::a::b` 和 `std::a_b` 会撞成同一个扁平名。
      %j3 = #if %dbl -> (#bits<64>) {
        %q = #lea(%buf, %j2, 1, 0)
        #store[#bits<8>](95, %q)
        %j4 = #add[#bits<64>](%j2, 1)
        #yield %j4
      } else {
        #yield %j2
      }
      %step = #if %dbl -> (#bits<64>) {
        #yield 2
      } else {
        #yield 1
      }
      %i2 = #add[#bits<64>](%i, %step)
      #continue put(%i2, %j3)
    } else {
      #break put(%j)
    }
  }
  #return %j
}

// `meta_find_binding_in`（回模块源码里找一条 `let`，返回 `=` 的下标）**已经删了**：
// 取模块成员现在压入那个模块的作用域、在表里查（见 `meta_emit_module_binding`）。

// 发「被导入的绑定」本身：`#proc <mangle>__<member>() -> #bits<64> { #return v }`
// member 是**调用方源码里**写的那个名字（用户写的是 `M.answer`，输出里就该是
// `answer`），只有值来自被导入的源码。
#proc meta_emit_exported(%mag: #addr, %mag_len: #bits<64>,
                          %b_base: #addr, %b_lo: #bits<64>, %b_hi: #bits<64>,
                          %value: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %dsep = #data_addr meta_dsep
  %a1 = #call lainir_buf_bytes(%buf, 0, %mag, %mag_len)
  %a2 = #call lainir_buf_bytes(%buf, %a1, %dsep, 2)
  %at = #lea(%b_base, %b_lo, 1, 0)
  %n = #sub[#bits<64>](%b_hi, %b_lo)
  %nlen = #call lainir_buf_bytes(%buf, %a2, %at, %n)
  %h = #call lainir_proc_head_full(%buf, %nlen, %buf, 0, 0, 64)
  %o = #call lainir_open_body()
  %r = #call lainir_return_uint(%value)
  %c = #call lainir_close_body()
  #return 0
}

// 发调用方：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
#proc meta_emit_ns_call(%b_base: #addr, %b_lo: #bits<64>,
                         %b_hi: #bits<64>, %kind: #bits<64>, %width: #bits<64>,
                         %mag: #addr, %mag_len: #bits<64>, %m_base: #addr,
                         %m_lo: #bits<64>, %m_hi: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %nbuf = #lea(%buf, 128, 1, 0)
  %bat = #lea(%b_base, %b_lo, 1, 0)
  %bn = #sub[#bits<64>](%b_hi, %b_lo)
  %nlen = #call lainir_buf_bytes(%nbuf, 0, %bat, %bn)
  %h = #call lainir_proc_head_full(%nbuf, %nlen, %nbuf, 0, %kind, %width)
  %o = #call lainir_open_body()
  %dsep = #data_addr meta_dsep
  %c1 = #call lainir_buf_bytes(%buf, 0, %mag, %mag_len)
  %c2 = #call lainir_buf_bytes(%buf, %c1, %dsep, 2)
  %mat = #lea(%m_base, %m_lo, 1, 0)
  %mn = #sub[#bits<64>](%m_hi, %m_lo)
  %clen = #call lainir_buf_bytes(%buf, %c2, %mat, %mn)
  %r = #call lainir_ret_call(%buf, %clen, %buf, 0)
  %c = #call lainir_close_body()
  #return 0
}

// 模块**内部**的一条绑定调用同一个模块里的另一条：
//   `#proc <mangle>__<b>() -> #bits<64> { #return #call <mangle>__<a>() }`
//
// 和 `meta_emit_ns_call` 的区别：那个是给调用方用的，只有被调方带 mangle；这里
// 两边都是模块自己的绑定，**两个名字都要带前缀**。
#proc meta_emit_module_call(%m_base: #addr, %b_lo: #bits<64>,
                             %b_hi: #bits<64>, %mag: #addr,
                             %mag_len: #bits<64>, %m_lo: #bits<64>,
                             %m_hi: #bits<64>) -> #bits<32> {
  %buf = #data_addr lainir_text_buffer
  %nbuf = #lea(%buf, 128, 1, 0)
  %dsep = #data_addr meta_dsep
  %n1 = #call lainir_buf_bytes(%nbuf, 0, %mag, %mag_len)
  %n2 = #call lainir_buf_bytes(%nbuf, %n1, %dsep, 2)
  %bat = #lea(%m_base, %b_lo, 1, 0)
  %bn = #sub[#bits<64>](%b_hi, %b_lo)
  %nlen = #call lainir_buf_bytes(%nbuf, %n2, %bat, %bn)
  %h = #call lainir_proc_head_full(%nbuf, %nlen, %nbuf, 0, 0, 64)
  %o = #call lainir_open_body()
  %c1 = #call lainir_buf_bytes(%buf, 0, %mag, %mag_len)
  %c2 = #call lainir_buf_bytes(%buf, %c1, %dsep, 2)
  %mat = #lea(%m_base, %m_lo, 1, 0)
  %mn = #sub[#bits<64>](%m_hi, %m_lo)
  %clen = #call lainir_buf_bytes(%buf, %c2, %mat, %mn)
  %r = #call lainir_ret_call(%buf, %clen, %buf, 0)
  %c = #call lainir_close_body()
  #return 0
}

// 发出模块里的一条值绑定，名字是 `<mangle>__<名字>`。
//
// 初始化式有两种形状（v0）：
//   数字 → 一个字面量
//   标识符 → **同一个模块里的另一条绑定**：先把那条递归发出来，再发调用它的这条
//
// 同一个绑定被引用两次只会发一次：条目里的 `emitted` 是防重入的标记，先置位再
// 展开函数体，所以自引用也不会转圈。遇到别的形状报 4（响的，不是静默给 0）。
#proc meta_emit_module_binding(%m_base: #addr,
                                %m_len: #bits<64>, %name_addr: #addr,
                                %name_len: #bits<64>, %mag: #addr,
                                %mag_len: #bits<64>) -> #bits<32> {
  %i = #call meta_scope_find(%name_addr, %name_len)
  %gone = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %status = #if %gone -> (#bits<32>) {
    %f0 = #call lain_meta_fail(13)
    #yield 13
  } else {
    %kind = #call meta_scope_kind(%i)
    %is_value = #eq[#bits<64>](%kind, 3)
    %s0 = #if %is_value -> (#bits<32>) {
      %done = #call meta_scope_emitted(%i)
      %skip = #ne[#bits<64>](%done, 0)
      %s1 = #if %skip -> (#bits<32>) {
        #yield 0
      } else {
        %mark = #call meta_scope_set_emitted(%i, 1)
        // 名字在模块源码里的位置：条目里存着
        %n_off = #call meta_scope_word(%i, 8)
        %n_len = #call meta_scope_word(%i, 16)
        %n_hi = #add[#bits<64>](%n_off, %n_len)
        // 初始化式的**节点下标**：条目里存着。位置的直接读节点，不用 skip。
        %init_node = #call meta_scope_payload(%i)
        %init = #call meta_node_start(%init_node)
        %init_hi = #add[#bits<64>](%init,
                                   #call meta_node_len(%init_node))
        %first = #call bs_byte_at(%m_base, %init, %m_len)
        %is_num = #call bs_is_digit(%first)
        %s2 = #if %is_num -> (#bits<32>) {
          %value = #call bs_read_uint(%m_base, %init, %m_len)
          %e0 = #call meta_emit_exported(%mag, %mag_len, %m_base,
                                         %n_off, %n_hi, %value)
          #yield %e0
        } else {
          // 标识符：同模块里的另一条绑定。引用的名字就是那个节点本身。
          %ref = #lea(%m_base, %init, 1, 0)
          %ref_len = #sub[#bits<64>](%init_hi, %init)
          %e1 = #call meta_emit_module_binding(%m_base, %m_len,
                                               %ref, %ref_len, %mag, %mag_len)
          %bad = #ne[#bits<32>](%e1, 0)
          %s3 = #if %bad -> (#bits<32>) {
            #yield %e1
          } else {
            %e2 = #call meta_emit_module_call(%m_base, %n_off, %n_hi,
                                              %mag, %mag_len, %init, %init_hi)
            #yield %e2
          }
          #yield %s3
        }
        #yield %s2
      }
      #yield %s1
    } else {
      // v0：模块里能取用的只有值绑定。取一个标量类型或别的，报 4。
      %f1 = #call lain_meta_fail(4)
      #yield 4
    }
    #yield %s0
  }
  #return %status
}

// `let NAME = M.member;` —— 解析命名空间绑定，**进入那个模块的作用域**去取成员。
//
// 关键在这里：取成员时要压入模块自己那一层（链变成 [root, 那个模块]），所以模块
// 内部 `let b = a;` 里的 `a` 能解析到同一个模块里的 `a`。以前是拿模块源码的字节
// 硬读一个字面量，读到字母就给 0 —— 静默的错值。
#proc meta_lower_ns_value(%base: #addr, %len: #bits<64>,
                           %bind_lo: #bits<64>, %bind_hi: #bits<64>,
                           %ns_lo: #bits<64>, %ns_hi: #bits<64>,
                           %m_lo: #bits<64>, %m_hi: #bits<64>,
                           %kind: #bits<64>, %width: #bits<64>) -> #bits<32> {
  %lp = #call meta_find_import_binding(%base, %len, %ns_lo, %ns_hi)
  %nons = #eq[#bits<64>](%lp, 0)
  %status = #if %nons -> (#bits<32>) {
    // `M` 不是这条源码里的 import 绑定
    %f0 = #call lain_meta_fail(12)
    #yield 12
  } else {
    %n = #call meta_logical_len(%base, %lp, %len)
    %path = #lea(%base, %lp, 1, 0)
    %idx = #call meta_source_find(%path, %n)
    %miss = #eq[#bits<64>](%idx, 0xFFFFFFFFFFFFFFFF)
    %s1 = #if %miss -> (#bits<32>) {
      %f1 = #call lain_meta_fail(11)
      #yield 11
    } else {
      %m_base = #call lain_meta_source_data(%idx)
      %m_len = #call lain_meta_source_length(%idx)
      %scratch = #call lain_meta_scratch_data()
      %pat = #call meta_path_buffer()
      %buf = #lea(%scratch, %pat, 1, 0)
      %mag_len = #call meta_build_mangle(%path, %n, %buf)

      // 切到模块那一层；**扫一次就留着**（见 meta_scope_has_source 的注释）。
      %old_src = #call meta_scope_enter(%idx)
      %already = #call meta_scope_has_source(%idx)
      %ready = #if %already -> (#bits<32>) {
        #yield 0
      } else {
        %mark = #call meta_scope_count()
        %scan = #call meta_scope_scan(%m_base, %m_len, %idx, %mark)
        #yield %scan
      }
      %bad = #ne[#bits<32>](%ready, 0)
      %s2 = #if %bad -> (#bits<32>) {
        %rest0 = #call meta_scope_set_current(%old_src)
        #yield %ready
      } else {
        // 成员名写在**调用方**的源码里，值在模块的源码里
        %m_name = #lea(%base, %m_lo, 1, 0)
        %m_name_len = #sub[#bits<64>](%m_hi, %m_lo)
        %e1 = #call meta_emit_module_binding(%m_base, %m_len,
                                             %m_name, %m_name_len, %buf,
                                             %mag_len)
        // 调用方那条：`#proc <bind>() -> <repr> { #return #call <mangle>__<member>() }`
        %e2 = #call meta_emit_ns_call(%base, %bind_lo, %bind_hi, %kind,
                                      %width, %buf, %mag_len, %base, %m_lo,
                                      %m_hi)
        %rest = #call meta_scope_set_current(%old_src)
        #yield %e1
      }
      #yield %s2
    }
    #yield %s1
  }
  #return %status
}
