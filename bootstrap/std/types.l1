// 初代标准库 v0 —— 通用小工具。
//
// 类型表**不在这里**：标量集是 `std/scalars.l1` 里的一段静态字节表（名字、kind、
// 宽度、算符对），源码里没有声明语法。这个文件只剩下跟「哪来的」无关的三样东西：
// 字节比较、暂存区单元、repr 的字节数与对齐。

// 两个字节串相等？长度也要相等。
#proc meta_bytes_equal(%a: #addr, %b: #addr, %n: #bits<64>) -> #bits<1> {
  %same = #loop cmp(%i: #bits<64> = 0) -> (#bits<1>) {
    %more = #ult[#bits<64>](%i, %n)
    #if %more {
      %ba = #load[#bits<8>](#lea(%a, %i, 1, 0))
      %bb = #load[#bits<8>](#lea(%b, %i, 1, 0))
      %eq = #eq[#bits<8>](%ba, %bb)
      #if %eq {
        %i2 = #add[#bits<64>](%i, 1)
        #continue cmp(%i2)
      } else {
        #break cmp(0)
      }
    } else {
      #break cmp(1)
    }
  }
  #return %same
}

// --- 暂存区单元 -----------------------------------------------------------
//
// 过程只能回一个值，而解析常常要多回几个（比如「标量在哪份源码的哪个位置」）。
// 这些中间结果写进暂存区，调用方按固定的分段读回来。分段表见
// `std/modules.l1` 的头注释。

#proc meta_cell_put(%cell: #addr, %v: #bits<64>) -> #bits<32> {
  // 与 `meta_cell_get` 对称的边界检查：越界的写同样夹住并计数（安全格 1908），
  // 避免把值写进不属于本进程的地址（那会静默损坏内存、最终表现为宿主崩溃）。
  %sc = #call lain_meta_scratch_data()
  %bi = #ptr2int[#bits<64>](%sc)
  %ci = #ptr2int[#bits<64>](%cell)
  %under = #ult[#bits<64>](%ci, %bi)
  %lim = #add[#bits<64>](%bi, 0x40000)
  %over = #uge[#bits<64>](%ci, %lim)
  %bad = #or[#bits<1>](%under, %over)
  %r = #if %bad -> (#bits<32>) {
    %n0 = #call meta_cell_get_raw(#lea(%sc, 1908, 1, 0))
    %n1 = #add[#bits<64>](%n0, 1)
    %w = #call meta_cell_put_raw(#lea(%sc, 1908, 1, 0), %n1)
    #yield 0
  } else {
    %s = #call meta_cell_put_raw(%cell, %v)
    #yield %s
  }
  #return %r
}

#proc meta_cell_put_raw(%cell: #addr, %v: #bits<64>) -> #bits<32> {
  #store[#bits<64>](%v, %cell)
  #return 0
}

#proc meta_cell_get_raw(%cell: #addr) -> #bits<64> {
  %v = #load[#bits<64>](%cell)
  #return %v
}

#proc meta_cell_get(%cell: #addr) -> #bits<64> {
  // **不要在这里做边界检查**。第 76 轮我为了让越权不再 trap，加了
  // 「不在 [scratch, scratch+0x40000) 就回 0」—— 结果**把全部 data 块读取
  // （`#data_addr meta_path_cap` 之类，位于映像区而非暂存区）都夹成了 0**，
  // 直接造成 `meta_path_cap` 读成 0 → `meta_source_find` 判定「缓冲区装不下」
  // → root 扫描找不到 → 作用域表空。这是一个自伤，已回退。
  %v = #load[#bits<64>](%cell)
  #return %v
}

// --- repr 的字节数与对齐 ---------------------------------------------------
//
// 标量按自然对齐：大小 = 位数/8（不足一字节当一字节），对齐 = 大小。
// #addr 是 8/8。

#proc bs_repr_size(%kind: #bits<64>, %width: #bits<64>) -> #bits<64> {
  %is_addr = #eq[#bits<64>](%kind, 3)
  %r = #if %is_addr -> (#bits<64>) {
    #yield 8
  } else {
    %bytes = #udiv[#bits<64>](%width, 8)
    %zero = #eq[#bits<64>](%bytes, 0)
    %b = #if %zero -> (#bits<64>) {
      #yield 1
    } else {
      #yield %bytes
    }
    #yield %b
  }
  #return %r
}

#proc bs_repr_align(%kind: #bits<64>, %width: #bits<64>) -> #bits<64> {
  %a = #call bs_repr_size(%kind, %width)
  #return %a
}
