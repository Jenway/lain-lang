// 模块：标量表、类型名解析、算子解析。跨单元引用一律写 `别名.名字`。
//
// 标量**是表**：这份静态字节就是「语言里有那些标量」的唯一出处。
// 源码里没有、也不需要一个 `scalar` 声明语法；`i32` 这类名字是内建名字，
// 由本文件的名字解析直接命中。
//
// 每条记录的布局（表以「名字长度为 0」的一条记录结束）：
//
//   +0        名字长度        +1..        名字
//   +nl+1     类型构造子 0 bits / 1 f / 2 vec / 3 addr
//   +nl+2     宽度（addr 为 0）
//   +nl+3     算子条数
//   之后每条：符号长度、符号、物理名长度、物理名
//
// 宽度那一格与 LAINIR 的类型实参同义。符号 → 物理名是「语言的算子名」到
// 「机器算子名」的唯一一层翻译，`meta_op_resolve` 查的就是它。
//
// `meta_scalar_table` 的取址一律写 symbol_addr("meta_scalar_table_storage")：
// 编译器发布的数据符号带 `_storage` 后缀。
let std_emit = import("emit");
let std_lex = import("lex");
let std_modules = import("modules");
let std_registry = import("registry");
let std_scope = import("scope");
let std_types = import("types");

let meta_scalar_table: ro [u8] = [3, 105, 51, 50, 0, 32, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 47, 4, 115, 100, 105, 118, 1, 43, 3, 97, 100, 100, 1, 60, 3, 115, 108, 116, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 37, 4, 115, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 115, 103, 116, 2, 60, 61, 3, 115, 108, 101, 2, 62, 61, 3, 115, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 3, 117, 51, 50, 0, 32, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 47, 4, 117, 100, 105, 118, 1, 43, 3, 97, 100, 100, 1, 60, 3, 117, 108, 116, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 37, 4, 117, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 117, 103, 116, 2, 60, 61, 3, 117, 108, 101, 2, 62, 61, 3, 117, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 3, 117, 54, 52, 0, 64, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 43, 3, 97, 100, 100, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 47, 4, 117, 100, 105, 118, 1, 37, 4, 117, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 117, 103, 116, 1, 60, 3, 117, 108, 116, 2, 60, 61, 3, 117, 108, 101, 2, 62, 61, 3, 117, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 3, 105, 54, 52, 0, 64, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 43, 3, 97, 100, 100, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 47, 4, 115, 100, 105, 118, 1, 37, 4, 115, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 115, 103, 116, 1, 60, 3, 115, 108, 116, 2, 60, 61, 3, 115, 108, 101, 2, 62, 61, 3, 115, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 2, 105, 56, 0, 8, 3, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  2, 117, 56, 0, 8, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 47, 4, 117, 100, 105, 118, 1, 43, 3, 97, 100, 100, 1, 60, 3, 117, 108, 116, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 37, 4, 117, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 117, 103, 116, 2, 60, 61, 3, 117, 108, 101, 2, 62, 61, 3, 117, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 4, 98, 111, 111, 108, 0, 1, 4, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 5, 117, 115, 105, 122, 101, 0, 64, 18, 1, 38, 3, 97, 110, 100, 1, 124, 2, 111, 114, 1, 94, 3, 120, 111, 114,  1, 43, 3, 97, 100, 100, 1, 45, 3, 115, 117, 98, 1, 42, 3, 109, 117, 108, 1, 47, 4, 117, 100, 105, 118, 1, 37, 4, 117, 114, 101, 109, 2, 61, 61, 2, 101, 113, 2, 33, 61, 2, 110, 101, 1, 62, 3, 117, 103, 116, 1, 60, 3, 117, 108, 116, 2, 60, 61, 3, 117, 108, 101, 2, 62, 61, 3, 117, 103, 101, 3, 97, 110, 100, 3, 97, 110, 100, 2, 111, 114, 2, 111, 114, 2, 60, 60, 3, 115, 104, 108, 2, 62, 62, 4, 108, 115, 104, 114, 4, 97, 100, 100, 114, 3, 0, 0, 0];   // 587 字节，标量表

// 宿主能力。
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(source: u64) -> u64 = lain_meta_source_length;

// --- 表访问 ---------------------------------------------------------------

// 表里第 off 个字节，零扩展成机器字。表的长度不另存一份：走表的过程自己会在
// 「名字长度为 0」的记录上停，所以这里给一个大上界即可。
func meta_scalar_load8(off: u64) -> u64 {
  let table: addr = symbol_addr("meta_scalar_table_storage");
  let b: u8 = std_lex.bs_byte_at(table, off, 0xFFFFFFFFFFFFFFFF);
  let v: u64 = b as u64;
  return v;
}

// 记录的名字长度。0 表示表尾。
func meta_scalar_name_len(rec: u64) -> u64 {
  let n: u64 = meta_scalar_load8(rec);
  return n;
}

// 记录的名字（指向只读表里的字节，不是拷贝）。
func meta_scalar_name(rec: u64) -> addr {
  let table: addr = symbol_addr("meta_scalar_table_storage");
  let at: u64 = rec + 1;
  let p: addr = table + at;
  return p;
}

// 记录的 repr，打包成 (kind | width << 8)。
func meta_scalar_repr(rec: u64) -> u64 {
  let nl: u64 = meta_scalar_name_len(rec);
  let kind_at: u64 = rec + (nl + 1);
  let kind: u64 = meta_scalar_load8(kind_at);
  let width_at: u64 = kind_at + 1;
  let width: u64 = meta_scalar_load8(width_at);
  // kind 与 width 都只占低 8 位，位域不相交，or 与加法等价。
  let packed: u64 = kind or (width << 8);
  return packed;
}

// 下一条记录的偏移：跳过名字、三格头部和整张算子表。
func meta_scalar_next(rec: u64) -> u64 {
  let nl: u64 = meta_scalar_name_len(rec);
  let after_name: u64 = (rec + 1) + nl;
  let count_at: u64 = after_name + 2;
  let count: u64 = meta_scalar_load8(count_at);
  let ops: u64 = after_name + 3;
  let end: u64 = loop o(k: u64 = ops, n: u64 = 0) {
    let more: bool = n < count;
    if more {
      let sl: u64 = meta_scalar_load8(k);
      let after_sym: u64 = k + (sl + 1);
      let pl: u64 = meta_scalar_load8(after_sym);
      let k2: u64 = after_sym + (pl + 1);
      let n2: u64 = n + 1;
      continue o(k2, n2);
    } else {
      break o(k);
    }
  };
  return end;
}

// 按名字找记录；找不到 NOT_FOUND。
func meta_scalar_find(name: addr, name_len: u64) -> u64 {
  let rec: u64 = loop s(cur: u64 = 0) {
    let nl: u64 = meta_scalar_name_len(cur);
    let end: bool = nl == 0;
    if end {
      break s(0xFFFFFFFFFFFFFFFF);
    }
    let same_len: bool = nl == name_len;
    if same_len {
      let p: addr = meta_scalar_name(cur);
      let eq: bool = std_types.meta_bytes_equal(p, name, name_len);
      if eq {
        break s(cur);
      }
    }
    let next: u64 = meta_scalar_next(cur);
    continue s(next);
  };
  return rec;
}

// 在记录的算子表里查符号 sym，回打包的 (物理名偏移 << 16) | 长度。
// 查不到 NOT_FOUND。偏移是**表内**的偏移。
func meta_scalar_op(rec: u64, sym: addr, sym_len: u64) -> u64 {
  let nl: u64 = meta_scalar_name_len(rec);
  let after_name: u64 = (rec + 1) + nl;
  let count_at: u64 = after_name + 2;
  let count: u64 = meta_scalar_load8(count_at);
  let ops: u64 = after_name + 3;
  let found: u64 = loop s(k: u64 = ops, n: u64 = 0) {
    let more: bool = n < count;
    if more {
      let sl: u64 = meta_scalar_load8(k);
      let sym_at: u64 = k + 1;
      let after_sym: u64 = sym_at + sl;
      let pl: u64 = meta_scalar_load8(after_sym);
      let phys_at: u64 = after_sym + 1;
      let same_len: bool = sl == sym_len;
      if same_len {
        let table: addr = symbol_addr("meta_scalar_table_storage");
        let p: addr = table + sym_at;
        let eq: bool = std_types.meta_bytes_equal(p, sym, sym_len);
        if eq {
          // phys_at 是高 48 位、pl 是低 16 位，位域不相交，or 与加法等价。
          let packed: u64 = (phys_at << 16) or pl;
          break s(packed);
        }
      }
      let next: u64 = phys_at + pl;
      let n2: u64 = n + 1;
      continue s(next, n2);
    } else {
      break s(0xFFFFFFFFFFFFFFFF);
    }
  };
  return found;
}

// 记录 + 符号 → 物理名。物理名的**表内偏移/长度**写进暂存区 +24 / +32。
// 返回 0 = 成功，NOT_FOUND = 这条记录没有这个符号。
func meta_scalar_resolve_op(rec: u64, sym: addr, sym_len: u64) -> u64 {
  let packed: u64 = meta_scalar_op(rec, sym, sym_len);
  let gone: bool = packed == 0xFFFFFFFFFFFFFFFF;
  if gone {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let off: u64 = (packed >> 16) and 0xFFFF;
  let len: u64 = packed and 0xFFFF;
  let scratch: addr = lain_meta_scratch_data();
  let s1: u32 = std_types.meta_cell_put(scratch + 24, off);
  let s2: u32 = std_types.meta_cell_put(scratch + 32, len);
  return 0;
}

// --- 类型名解析 ------------------------------------------------------------

// 在 [lo, hi) 里找 `.`，返回它的下标；找不到 NOT_FOUND。
//
// 只用来判定「这个名字是不是带点的」：带点的类型名没有解析（标量是内建名字，
// 不存在模块导出的标量），一律按「没有这个名字」处理。
func meta_find_dot(base: addr, lo: u64, hi: u64) -> u64 {
  let found: u64 = loop scan(i: u64 = lo) {
    let more: bool = i < hi;
    if more {
      let is: bool = std_lex.bs_is_byte(base, i, 46);
      if is {
        break scan(i);
      }
      let i2: u64 = i + 1;
      continue scan(i2);
    } else {
      break scan(0xFFFFFFFFFFFFFFFF);
    }
  };
  return found;
}

// 名字 → 内建标量的类型 id（注册表身份）；不是内建标量返回 0。
//
// 身份不是 repr：`i32` 与 `u32` 的 repr 都是 bits/32，让它们不同的是 owner。
// 这里 owner = 0x4000000000000000 | 记录偏移 —— 高位那一段把内建标量与「源码里
// 声明的类型」（owner = ((源码下标 + 1) << 32) | (位置 + 1)）分开。
func meta_scalar_type_id(name: addr, name_len: u64) -> u64 {
  let rec: u64 = meta_scalar_find(name, name_len);
  let miss: bool = rec == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0;
  }
  let repr: u64 = meta_scalar_repr(rec);
  let rk: u64 = repr and 255;
  let rw_v: u64 = (repr >> 8) and 255;
  // %rec 是 <587 的表内偏移，与 bit62 的 owner 标志位域不相交，or 与加法等价。
  let owner: u64 = 0x4000000000000000 or rec;
  let id: u64 = std_registry.meta_intern(1, owner, 0, rk, rw_v);
  return id;
}

// 名字 → 类型 id。源码里声明的类型（struct/enum）先查；都不中再查内建标量表。
func meta_type_id_of_name(name: addr, name_len: u64) -> u64 {
  let declared: u64 = std_scope.meta_scope_type_id(name, name_len);
  let have: bool = declared != 0xFFFFFFFFFFFFFFFF;
  if have {
    return declared;
  }
  let builtin: u64 = meta_scalar_type_id(name, name_len);
  return builtin;
}

// 类型名 → 类型 id（供表达式降级）；没有这个名字返回 0。
//
// 带点的名字是**跨模块类型**：`M.Point` 的左半是 import 绑定，右半在那个模块
// 自己的表里查。标量是内建名字、不存在「模块导出的标量」，所以左半不是 import 绑定
// （或模块里没有这个名字）一律按「没有这个名字」处理（调用方报 5）。
func meta_type_resolve(base: addr, len: u64, t_lo: u64, t_hi: u64) -> u64 {
  let dot: u64 = meta_find_dot(base, t_lo, t_hi);
  let qualified: bool = dot != 0xFFFFFFFFFFFFFFFF;
  if qualified {
    // `M.Point`：左半是 import 绑定，右半在那个模块的表里查。压入模块那一层、
    // 必要时扫一次，查完把当前源码换回去。
    let m_lo: u64 = std_lex.bs_skip_space(base, dot + 1, len);
    let m_hi: u64 = std_lex.bs_skip_ident(base, m_lo, len);
    let lp: u64 = std_modules.meta_find_import_binding(base, len, t_lo, dot);
    let nons: bool = lp == 0;
    if nons {
      return 0;
    }
    let n: u64 = std_modules.meta_logical_len(base, lp, len);
    let path: addr = base + lp;
    let idx: u64 = std_modules.meta_source_find(path, n);
    let miss: bool = idx == 0xFFFFFFFFFFFFFFFF;
    if miss {
      return 0;
    }
    let m_base: addr = lain_meta_source_data(idx);
    let m_len: u64 = lain_meta_source_length(idx);
    let old_src: u64 = std_scope.meta_scope_enter(idx);
    let already: bool = std_scope.meta_scope_has_source(idx);
    let ready: u32 = if already {
      0
    } else {
      let mark: u64 = std_scope.meta_scope_count();
      let scan: u32 = std_scope.meta_scope_scan(m_base, m_len, idx, mark);
      scan
    };
    let bad: bool = ready != 0;
    if bad {
      let rest0: u32 = std_scope.meta_scope_set_current(old_src);
      return 0;
    }
    let mname: addr = base + m_lo;
    let mnlen: u64 = m_hi - m_lo;
    let tid: u64 = std_scope.meta_scope_type_id(mname, mnlen);
    let rest: u32 = std_scope.meta_scope_set_current(old_src);
    let tak: bool = tid != 0xFFFFFFFFFFFFFFFF;
    if tak {
      return tid;
    }
    return 0;
  }
  // 非限定名：源码里声明的类型先查、内建标量表后查，都没有就是「没有这个名字」。
  let name: addr = base + t_lo;
  let name_len: u64 = t_hi - t_lo;
  let id: u64 = meta_type_id_of_name(name, name_len);
  let hit0: bool = id != 0;
  if hit0 {
    return id;
  }
  // 引用与切片：`ref T` / `mut ref T` / `slice T` 都是地址。
  let id2: u64 = meta_addr_type_of(base, len, t_lo, t_hi);
  return id2;
}

// 引用与切片类型名 → 地址类型 id；不是这几类名字回 0。
//
// `ref T`、`mut ref T`、`slice T` 在 IR 里都是 `#addr`：引用的读写由 load/store
// 决定，切片的形状由 `slice_of` 那块栈内存决定。
func meta_addr_type_of(base: addr, len: u64, t_lo: u64, t_hi: u64) -> u64 {
  let at: u64 = std_lex.bs_skip_space(base, t_lo, len);
  let is_ref: bool = std_lex.bs_match_keyword(base, at, len, std_lex.meta_kw_ref, 3);
  let is_slice: bool = std_lex.bs_match_keyword(base, at, len, std_lex.meta_kw_slice, 5);
  let is_mut: bool = std_lex.bs_match_keyword(base, at, len, std_lex.meta_kw_mut, 3);
  // 修饰词后面必须还有元素类型，否则 `ref` / `mut` 只是恰好同名的普通名字。
  let has_tail: bool = std_lex.bs_skip_space(base, at, t_hi) < t_hi;
  let wraps: bool = (is_ref or is_slice or is_mut) and has_tail;
  if wraps == 0 {
    return 0;
  }
  let addr_id: u64 = meta_scalar_type_id(std_lex.meta_kw_addr, 4);
  return addr_id;
}

// 类型名 + 算子符号 → 物理算子名。物理名的**表内偏移/长度**写进暂存区
// +24 / +32。返回 0 = 成功，NOT_FOUND = 名字或符号没有。
func meta_op_resolve(base: addr, len: u64, t_lo: u64, t_hi: u64, sym: addr, sym_len: u64) -> u64 {
  let dot: u64 = meta_find_dot(base, t_lo, t_hi);
  let qualified: bool = dot != 0xFFFFFFFFFFFFFFFF;
  if qualified {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let name: addr = base + t_lo;
  let name_len: u64 = t_hi - t_lo;
  let rec: u64 = meta_scalar_find(name, name_len);
  let miss: bool = rec == 0xFFFFFFFFFFFFFFFF;
  if miss {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let res: u64 = meta_scalar_resolve_op(rec, sym, sym_len);
  return res;
}

// 字面量自己的类型（参考经典 C 的字面量规则）：十进制常量取「装得下它的第一个
// 类型」—— 这里是 i32，装不下才 i64。`i8`/`u8`/`bool` **不进候选**。
//
// 只有**两个操作数都是裸字面量**时才走这条路（调用方判的）：有名字操作数时退回
// i32 会把 u32 的 `<` 发成 `slt`，那是静默给错值。
//
// 选中的宽度写进暂存区 +488（调用方要拿它换指令的类型实参）。
// meta_sym_i32 / meta_sym_i64 是 emit 单元的静态块，本单元只取址。
func meta_op_resolve_default(base: addr, len: u64, sym: addr, sym_len: u64, l_lo: u64, l_hi: u64, r_lo: u64, r_hi: u64) -> u64 {
  let lv: u64 = std_lex.bs_read_uint(base, l_lo, len);
  let rv: u64 = std_lex.bs_read_uint(base, r_lo, len);
  let l_big: bool = lv > 0x7FFFFFFF;
  let r_big: bool = rv > 0x7FFFFFFF;
  let big: bool = l_big or r_big;
  if big {
    let a64: addr = std_emit.meta_sym_i64;
    let rec64: u64 = meta_scalar_find(a64, 3);
    let m64: bool = rec64 == 0xFFFFFFFFFFFFFFFF;
    if m64 {
      return 0xFFFFFFFFFFFFFFFF;
    }
    let sc64: addr = lain_meta_scratch_data();
    let w64: u32 = std_types.meta_cell_put(sc64 + 488, 64);
    let q64: u64 = meta_scalar_resolve_op(rec64, sym, sym_len);
    return q64;
  }
  let a32: addr = std_emit.meta_sym_i32;
  let rec32: u64 = meta_scalar_find(a32, 3);
  let m32: bool = rec32 == 0xFFFFFFFFFFFFFFFF;
  if m32 {
    return 0xFFFFFFFFFFFFFFFF;
  }
  let sc32: addr = lain_meta_scratch_data();
  let w32: u32 = std_types.meta_cell_put(sc32 + 488, 32);
  let q32: u64 = meta_scalar_resolve_op(rec32, sym, sym_len);
  return q32;
}
