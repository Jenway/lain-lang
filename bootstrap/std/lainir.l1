// 层 0 的最小产物发射接口。所有文本追加到 Meta 宿主输出缓冲。
data lainir_proc ro { 35 112 114 111 99 32 }
data lainir_open ro { 40 41 32 45 62 32 }
data lainir_bits32 ro { 35 98 105 116 115 60 51 50 62 }
data lainir_body ro { 32 123 10 }
data lainir_return_text ro { 32 32 35 114 101 116 117 114 110 32 }
data lainir_newline ro { 10 }
data lainir_close ro { 125 10 }

#proc lainir_write(%text: #addr, %length: #bits<64>) -> #bits<32> {
  %status = #call lain_meta_emit_write(%text, %length)
  #return %status
}

#proc lainir_reset() -> #bits<32> {
  %cell = #data_addr lainir_counter
  #store[#bits<64>](0, %cell)
  %status = #call lain_meta_emit_reset()
  #return %status
}

#proc lainir_text() -> #addr {
  %text = #call lain_meta_emit_data()
  #return %text
}

#proc lainir_length() -> #bits<64> {
  %length = #call lain_meta_emit_length()
  #return %length
}

#proc lainir_proc_begin(%name: #addr, %name_length: #bits<64>) -> #bits<32> {
  %a = #data_addr lainir_proc
  %w1 = #call lainir_write(%a, 6)
  %w2 = #call lainir_write(%name, %name_length)
  %b = #data_addr lainir_open
  %w3 = #call lainir_write(%b, 6)
  %c = #data_addr lainir_bits32
  %w4 = #call lainir_write(%c, 9)
  %d = #data_addr lainir_body
  %w5 = #call lainir_write(%d, 3)
  #return %w5
}

#proc lainir_return(%value: #bits<64>) -> #bits<32> {
  %a = #data_addr lainir_return_text
  %w1 = #call lainir_write(%a, 10)
  %w2 = #call meta_emit_uint(%value)
  %b = #data_addr lainir_newline
  %w3 = #call lainir_write(%b, 1)
  #return %w3
}

data lainir_counter rw { 0 0 0 0 0 0 0 0 }
data lainir_assign ro { 32 61 32 35 }
data lainir_bits_open ro { 91 35 98 105 116 115 60 }
data lainir_close_type ro { 62 93 40 }
data lainir_comma ro { 44 32 }
data lainir_rparen_nl ro { 41 10 }
data lainir_rparen_nl_close ro { 41 10 125 10 }
data lainir_pct_r ro { 37 114 }
data lainir_indent ro { 32 32 }
data lainir_hash ro { 35 }
data lainir_addr_open ro { 91 35 97 100 100 114 93 40 }

#proc lainir_next_temp() -> #bits<64> {
  %cell = #data_addr lainir_counter
  %n = #load[#bits<64>](%cell)
  %next = #add[#bits<64>](%n, 1)
  #store[#bits<64>](%next, %cell)
  #return %next
}

// 发射带两个位整数操作数的指令。name 是不带 # 的指令名；比较结果由 verifier 推导为一位。
#proc lainir_binary(%name: #addr, %name_length: #bits<64>, %width: #bits<64>, %lhs: #addr, %lhs_length: #bits<64>, %rhs: #addr, %rhs_length: #bits<64>) -> #bits<32> {
  %indent = #data_addr lainir_indent
  %w0 = #call lainir_write(%indent, 2)
  %temp = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %w1 = #call lainir_write(%pct, 2)
  %w2 = #call meta_emit_uint(%temp)
  %assign = #data_addr lainir_assign
  %w3 = #call lainir_write(%assign, 4)
  %opcode = #call lainir_write(%name, %name_length)
  %open = #data_addr lainir_bits_open
  %w4 = #call lainir_write(%open, 7)
  %w5 = #call meta_emit_uint(%width)
  %close_type = #data_addr lainir_close_type
  %w6 = #call lainir_write(%close_type, 3)
  %w7 = #call lainir_write(%lhs, %lhs_length)
  %comma = #data_addr lainir_comma
  %w8 = #call lainir_write(%comma, 2)
  %w9 = #call lainir_write(%rhs, %rhs_length)
  %end = #data_addr lainir_rparen_nl
  %w10 = #call lainir_write(%end, 2)
  #return 0
}

// 发射从位整数转换到位整数的一元指令；类型实参是结果宽度。
#proc lainir_unary(%name: #addr, %name_length: #bits<64>, %width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %indent = #data_addr lainir_indent
  %w0 = #call lainir_write(%indent, 2)
  %temp = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %w1 = #call lainir_write(%pct, 2)
  %w2 = #call meta_emit_uint(%temp)
  %assign = #data_addr lainir_assign
  %w3 = #call lainir_write(%assign, 4)
  %opcode = #call lainir_write(%name, %name_length)
  %open = #data_addr lainir_bits_open
  %w4 = #call lainir_write(%open, 7)
  %w5 = #call meta_emit_uint(%width)
  %close_type = #data_addr lainir_close_type
  %w6 = #call lainir_write(%close_type, 3)
  %w7 = #call lainir_write(%value, %value_length)
  %end = #data_addr lainir_rparen_nl
  %w8 = #call lainir_write(%end, 2)
  #return 0
}

data lainir_add_name ro { 97 100 100 }
data lainir_sub_name ro { 115 117 98 }
data lainir_mul_name ro { 109 117 108 }
data lainir_sdiv_name ro { 115 100 105 118 }
data lainir_udiv_name ro { 117 100 105 118 }
data lainir_srem_name ro { 115 114 101 109 }
data lainir_urem_name ro { 117 114 101 109 }
data lainir_and_name ro { 97 110 100 }
data lainir_or_name ro { 111 114 }
data lainir_xor_name ro { 120 111 114 }
data lainir_shl_name ro { 115 104 108 }
data lainir_lshr_name ro { 108 115 104 114 }
data lainir_ashr_name ro { 97 115 104 114 }
data lainir_eq_name ro { 101 113 }
data lainir_ne_name ro { 110 101 }
data lainir_slt_name ro { 115 108 116 }
data lainir_sle_name ro { 115 108 101 }
data lainir_sgt_name ro { 115 103 116 }
data lainir_sge_name ro { 115 103 101 }
data lainir_ult_name ro { 117 108 116 }
data lainir_ule_name ro { 117 108 101 }
data lainir_ugt_name ro { 117 103 116 }
data lainir_uge_name ro { 117 103 101 }

#proc lainir_add(%width: #bits<64>, %lhs: #addr, %lhs_length: #bits<64>, %rhs: #addr, %rhs_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_add_name
  %r = #call lainir_binary(%n, 3, %width, %lhs, %lhs_length, %rhs, %rhs_length)
  #return %r
}
#proc lainir_sub(%width: #bits<64>, %lhs: #addr, %lhs_length: #bits<64>, %rhs: #addr, %rhs_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_sub_name
  %r = #call lainir_binary(%n, 3, %width, %lhs, %lhs_length, %rhs, %rhs_length)
