data lainir_zext_name ro { 122 101 120 116 }
data lainir_sext_name ro { 115 101 120 116 }
data lainir_trunc_name ro { 116 114 117 110 99 }
data lainir_bitcast_name ro { 98 105 116 99 97 115 116 }
data lainir_ptr2int_name ro { 112 116 114 50 105 110 116 }
data lainir_int2ptr_name ro { 105 110 116 50 112 116 114 }

#proc lainir_zext(%width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_zext_name
  %r = #call lainir_unary(%n, 4, %width, %value, %value_length)
  #return %r
}
#proc lainir_sext(%width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_sext_name
  %r = #call lainir_unary(%n, 4, %width, %value, %value_length)
  #return %r
}
#proc lainir_trunc(%width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_trunc_name
  %r = #call lainir_unary(%n, 5, %width, %value, %value_length)
  #return %r
}
#proc lainir_bitcast(%width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_bitcast_name
  %r = #call lainir_unary(%n, 7, %width, %value, %value_length)
  #return %r
}
#proc lainir_ptr2int(%width: #bits<64>, %pointer: #addr, %name: #addr, %name_length: #bits<64>) -> #bits<32> {
  %indent = #data_addr lainir_indent
  %w0 = #call lainir_write(%indent, 2)
  %temp = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %w1 = #call lainir_write(%pct, 2)
  %w2 = #call lainir_emit_uint(%temp)
  %assign = #data_addr lainir_assign
  %w3 = #call lainir_write(%assign, 4)
  %n = #data_addr lainir_ptr2int_name
  %whash = #call lainir_write(%n, 7)
  %open = #data_addr lainir_bits_open
  %w4 = #call lainir_write(%open, 7)
  %w5 = #call lainir_emit_uint(%width)
  %close = #data_addr lainir_close_type
  %w6 = #call lainir_write(%close, 3)
  %wv0 = #call lainir_write(%name, %name_length)
  %end = #data_addr lainir_rparen_nl
  %w8 = #call lainir_write(%end, 2)
  #return 0
}
#proc lainir_int2ptr(%value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %indent = #data_addr lainir_indent
  %w0 = #call lainir_write(%indent, 2)
  %temp = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %w1 = #call lainir_write(%pct, 2)
  %w2 = #call lainir_emit_uint(%temp)
  %assign = #data_addr lainir_assign
  %w3 = #call lainir_write(%assign, 4)
  %n = #data_addr lainir_int2ptr_name
  %w4 = #call lainir_write(%n, 7)
  %type = #data_addr lainir_addr_open
  %w5 = #call lainir_write(%type, 8)
  %w6 = #call lainir_write(%value, %value_length)
  %end = #data_addr lainir_rparen_nl
  %w7 = #call lainir_write(%end, 2)
  #return 0
}

data lainir_paren_open ro { 40 }
data lainir_typed_close ro { 41 32 45 62 32 35 98 105 116 115 60 51 50 62 32 123 10 }
#proc lainir_proc_begin_typed(%name: #addr, %name_length: #bits<64>, %params: #addr, %params_length: #bits<64>) -> #bits<32> {
  %a = #data_addr lainir_proc
  %w1 = #call lainir_write(%a, 6)
  %w2 = #call lainir_write(%name, %name_length)
  %o = #data_addr lainir_paren_open
  %w3 = #call lainir_write(%o, 1)
  %w4 = #call lainir_write(%params, %params_length)
  %c = #data_addr lainir_typed_close
  %w5 = #call lainir_write(%c, 17)
  #return %w5
}

data lainir_load_name ro { 108 111 97 100 }
data lainir_store_name ro { 115 116 111 114 101 }
data lainir_lea_name ro { 108 101 97 }
data lainir_alloca_name ro { 97 108 108 111 99 97 }
data lainir_data_addr_name ro { 100 97 116 97 95 97 100 100 114 }
data lainir_proc_addr_name ro { 112 114 111 99 95 97 100 100 114 }
data lainir_call_space ro { 32 }
data lainir_lparen ro { 40 }

#proc lainir_address_line(%name: #addr, %name_length: #bits<64>, %symbol: #addr, %symbol_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %temp = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%temp)
  %as = #data_addr lainir_assign
  %d = #call lainir_write(%as, 4)
  %f = #call lainir_write(%name, %name_length)
  %sp = #data_addr lainir_call_space
  %g = #call lainir_write(%sp, 1)
  %i = #call lainir_write(%symbol, %symbol_length)
  %nl = #data_addr lainir_newline
  %j = #call lainir_write(%nl, 1)
  #return 0
}
#proc lainir_data_addr(%symbol: #addr, %symbol_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_data_addr_name
  %r = #call lainir_address_line(%n, 9, %symbol, %symbol_length)
  #return %r
}
#proc lainir_proc_addr(%symbol: #addr, %symbol_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_proc_addr_name
  %r = #call lainir_address_line(%n, 9, %symbol, %symbol_length)
  #return %r
}

#proc lainir_load_at(%temp: #bits<64>, %kind: #bits<64>, %width: #bits<64>, %address: #addr, %address_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%temp)
  %as = #data_addr lainir_assign
  %d = #call lainir_write(%as, 4)
  %n = #data_addr lainir_load_name
  %e = #call lainir_write(%n, 4)
  %lb = #data_addr lainir_store_open
  %f = #call lainir_write(%lb, 1)
  %rep = #call lainir_repr(%kind, %width)
  %cl = #data_addr lainir_after_type
  %g = #call lainir_write(%cl, 2)
  %v = #call lainir_write(%address, %address_length)
  %cm = #data_addr lainir_comma
  %i = #call lainir_write(%cm, 2)
  %z = #call lainir_emit_uint(0)
  %end = #data_addr lainir_rparen_nl
  %h = #call lainir_write(%end, 2)
  #return %h
}

#proc lainir_load(%kind: #bits<64>, %width: #bits<64>, %address: #addr, %address_length: #bits<64>) -> #bits<32> {
  %t = #call lainir_next_temp()
  %w = #call lainir_load_at(%t, %kind, %width, %address, %address_length)
  #return %w
}
#proc lainir_memory_unary(%name: #addr, %name_length: #bits<64>, %width: #bits<64>, %value: #addr, %value_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %t = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%t)
  %as = #data_addr lainir_assign
  %d = #call lainir_write(%as, 4)
  %f = #call lainir_write(%name, %name_length)
  %op = #data_addr lainir_bits_open
  %g = #call lainir_write(%op, 7)
  %w = #call lainir_emit_uint(%width)
  %ct = #data_addr lainir_close_type
  %i = #call lainir_write(%ct, 3)
  %v = #call lainir_write(%value, %value_length)
  %end = #data_addr lainir_rparen_nl
  %j = #call lainir_write(%end, 2)
  #return 0
}
#proc lainir_alloca(%width: #bits<64>, %count: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
