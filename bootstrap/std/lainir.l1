#proc lainir_line_start(%temp: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %w0 = #call lainir_write(%ind, 2)
  %h = #data_addr lainir_hash
  %zero = #eq[#bits<64>](%temp, 0)
  %r = #if %zero -> (#bits<32>) {
    %wh = #call lainir_write(%h, 1)
    #yield %wh
  } else {
    %pct = #data_addr lainir_pct_r
    %a = #call lainir_write(%pct, 2)
    %b = #call lainir_emit_uint(%temp)
    %sep = #data_addr lainir_result_sep
    %c = #call lainir_write(%sep, 3)
    %d = #call lainir_write(%h, 1)
    #yield %d
  }
  #return %r
}

#proc lainir_if(%cond: #addr, %cond_length: #bits<64>) -> #bits<32> {
  %s = #call lainir_line_start(0)
  %n = #data_addr lainir_if_name
  %a = #call lainir_write(%n, 2)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%cond, %cond_length)
  %br = #data_addr lainir_brace_nl
  %d = #call lainir_write(%br, 3)
  #return %d
}
#proc lainir_if_value(%cond: #addr, %cond_length: #bits<64>, %results: #addr, %results_length: #bits<64>) -> #bits<32> {
  %t = #call lainir_next_temp()
  %s = #call lainir_line_start(%t)
  %n = #data_addr lainir_if_name
  %a = #call lainir_write(%n, 2)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%cond, %cond_length)
  %ar = #data_addr lainir_arrow_open
  %d = #call lainir_write(%ar, 5)
  %e = #call lainir_write(%results, %results_length)
  %rp = #data_addr lainir_close_rparen
  %f = #call lainir_write(%rp, 1)
  %br = #data_addr lainir_brace_nl
  %g = #call lainir_write(%br, 3)
  #return %g
}
#proc lainir_else() -> #bits<32> {
  %e = #data_addr lainir_else_line
  %w = #call lainir_write(%e, 11)
  #return %w
}
#proc lainir_end() -> #bits<32> {
  %c = #data_addr lainir_close_line
  %w = #call lainir_write(%c, 4)
  #return %w
}
#proc lainir_loop(%label: #addr, %label_length: #bits<64>, %params: #addr, %params_length: #bits<64>) -> #bits<32> {
  %s = #call lainir_line_start(0)
  %n = #data_addr lainir_loop_name
  %a = #call lainir_write(%n, 4)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%label, %label_length)
  %lp = #data_addr lainir_lparen
  %d = #call lainir_write(%lp, 1)
  %e = #call lainir_write(%params, %params_length)
  %rb = #data_addr lainir_rparen_brace
  %f = #call lainir_write(%rb, 4)
  #return %f
}
#proc lainir_loop_value(%label: #addr, %label_length: #bits<64>, %params: #addr, %params_length: #bits<64>, %results: #addr, %results_length: #bits<64>) -> #bits<32> {
  %t = #call lainir_next_temp()
  %s = #call lainir_line_start(%t)
  %n = #data_addr lainir_loop_name
  %a = #call lainir_write(%n, 4)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%label, %label_length)
  %lp = #data_addr lainir_lparen
  %d = #call lainir_write(%lp, 1)
  %e = #call lainir_write(%params, %params_length)
  %rp = #data_addr lainir_close_rparen
  %f = #call lainir_write(%rp, 1)
  %ar = #data_addr lainir_arrow_open
  %g = #call lainir_write(%ar, 5)
  %h = #call lainir_write(%results, %results_length)
  %i = #call lainir_write(%rp, 1)
  %br = #data_addr lainir_brace_nl
  %j = #call lainir_write(%br, 3)
  #return %j
}
#proc lainir_yield(%values: #addr, %values_length: #bits<64>) -> #bits<32> {
  %s = #call lainir_line_start(0)
  %n = #data_addr lainir_yield_name
  %a = #call lainir_write(%n, 5)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%values, %values_length)
  %nl = #data_addr lainir_newline
  %d = #call lainir_write(%nl, 1)
  #return %d
}
#proc lainir_break(%label: #addr, %label_length: #bits<64>, %args: #addr, %args_length: #bits<64>) -> #bits<32> {
  %s = #call lainir_line_start(0)
  %n = #data_addr lainir_break_name
  %a = #call lainir_write(%n, 5)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%label, %label_length)
  %zero = #eq[#bits<64>](%args_length, 0)
  %rest = #if %zero -> (#bits<32>) {
    %nl = #data_addr lainir_newline
    %w = #call lainir_write(%nl, 1)
    #yield %w
  } else {
    %lp = #data_addr lainir_lparen
    %d = #call lainir_write(%lp, 1)
    %e = #call lainir_write(%args, %args_length)
    %rp = #data_addr lainir_close_rparen
    %f = #call lainir_write(%rp, 1)
    %nl2 = #data_addr lainir_newline
    %g = #call lainir_write(%nl2, 1)
    #yield %g
  }
  #return %rest
}
#proc lainir_continue(%label: #addr, %label_length: #bits<64>, %args: #addr, %args_length: #bits<64>) -> #bits<32> {
  %s = #call lainir_line_start(0)
  %n = #data_addr lainir_continue_name
  %a = #call lainir_write(%n, 8)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%label, %label_length)
  %zero = #eq[#bits<64>](%args_length, 0)
  %rest = #if %zero -> (#bits<32>) {
    %nl = #data_addr lainir_newline
    %w = #call lainir_write(%nl, 1)
    #yield %w
  } else {
    %lp = #data_addr lainir_lparen
    %d = #call lainir_write(%lp, 1)
    %e = #call lainir_write(%args, %args_length)
    %rp = #data_addr lainir_close_rparen
    %f = #call lainir_write(%rp, 1)
    %nl2 = #data_addr lainir_newline
    %g = #call lainir_write(%nl2, 1)
    #yield %g
  }
  #return %rest
}
#proc lainir_switch(%width: #bits<64>, %selector: #addr, %selector_length: #bits<64>, %results: #addr, %results_length: #bits<64>) -> #bits<32> {
  %t = #call lainir_next_temp()
  %s = #call lainir_line_start(%t)
  %n = #data_addr lainir_switch_name
  %a = #call lainir_write(%n, 6)
  %bo = #data_addr lainir_bits_open
  %b = #call lainir_write(%bo, 7)
  %c = #call lainir_emit_uint(%width)
  %cb = #data_addr lainir_close_bracket_space
  %d = #call lainir_write(%cb, 3)
  %e = #call lainir_write(%selector, %selector_length)
  %ar = #data_addr lainir_arrow_open
  %f = #call lainir_write(%ar, 5)
  %g = #call lainir_write(%results, %results_length)
  %rp = #data_addr lainir_close_rparen
  %h = #call lainir_write(%rp, 1)
  %br = #data_addr lainir_brace_nl
  %i = #call lainir_write(%br, 3)
  #return %i
}
#proc lainir_case(%value: #bits<64>) -> #bits<32> {
  %cp = #data_addr lainir_case_prefix
  %a = #call lainir_write(%cp, 7)
  %b = #call lainir_emit_uint(%value)
  %br = #data_addr lainir_brace_nl
  %c = #call lainir_write(%br, 3)
  #return %c
}
#proc lainir_default() -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %d = #data_addr lainir_default_line
  %b = #call lainir_write(%d, 10)
  #return %b
}
#proc lainir_extern(%name: #addr, %name_length: #bits<64>, %link: #addr, %link_length: #bits<64>, %params: #addr, %params_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_proc
  %a = #call lainir_write(%n, 6)
  %b = #call lainir_write(%name, %name_length)
  %lp = #data_addr lainir_lparen
  %c = #call lainir_write(%lp, 1)
  %d = #call lainir_write(%params, %params_length)
  %rp = #data_addr lainir_close_rparen
  %e = #call lainir_write(%rp, 1)
  %f = #call lainir_extern_marker_write()
  %g = #call lainir_write(%link, %link_length)
  %h = #call lainir_quote_nl_write()
  #return %h
}

// 写「#extern "」（10 字节）与「" 换行」（2 字节）。
#proc lainir_extern_marker_write() -> #bits<32> {
  %t = #data_addr lainir_extern_marker
  %s = #call lainir_write(%t, 10)
  #return %s
}
#proc lainir_quote_nl_write() -> #bits<32> {
  %t = #data_addr lainir_quote_nl
  %s = #call lainir_write(%t, 2)
  #return %s
}

