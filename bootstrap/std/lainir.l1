// 发射具名结果的 load：结果的文本由调用方给。
#proc lainir_load_named(%name: #addr, %name_length: #bits<64>, %kind: #bits<64>, %width: #bits<64>, %address: #addr, %address_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %b = #call lainir_write(%name, %name_length)
  %as = #data_addr lainir_assign
  %c = #call lainir_write(%as, 4)
  %n = #data_addr lainir_load_name
  %d = #call lainir_write(%n, 4)
  %lb = #data_addr lainir_store_open
  %e = #call lainir_write(%lb, 1)
  %rep = #call lainir_repr(%kind, %width)
  %cl = #data_addr lainir_after_type
  %f = #call lainir_write(%cl, 2)
  %g = #call lainir_write(%address, %address_length)
  %end = #data_addr lainir_rparen_nl
  %h = #call lainir_write(%end, 2)
  #return %h
}

