data lainir_pct_only ro { 37 }
#proc lainir_pct_write() -> #bits<32> {
  %t = #data_addr lainir_pct_only
  %w = #call lainir_write(%t, 1)
  #return %w
}
#proc lainir_close_line_write() -> #bits<32> {
  %t = #data_addr lainir_close_line
  %w = #call lainir_write(%t, 4)
  #return %w
}

// 发射具名结果的二元指令：结果与算子名的文本都由调用方给。
#proc lainir_binary_op_named(%name: #addr, %name_length: #bits<64>, %op: #addr, %op_length: #bits<64>, %kind: #bits<64>, %width: #bits<64>, %lhs: #addr, %lhs_length: #bits<64>, %rhs: #addr, %rhs_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %b = #call lainir_write(%name, %name_length)
  %as = #data_addr lainir_result_sep
  %c = #call lainir_write(%as, 3)
  %d = #call lainir_op_prefix(%op, %op_length, %kind, %width)
  %e = #call lainir_write(%lhs, %lhs_length)
  %cm = #data_addr lainir_comma
  %f = #call lainir_write(%cm, 2)
  %g = #call lainir_write(%rhs, %rhs_length)
  %end = #data_addr lainir_rparen_nl
  %h = #call lainir_write(%end, 2)
  #return %h
}

