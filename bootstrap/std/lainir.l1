// 发射一条二元指令：结果编号与算子名都由调用方给。
#proc lainir_binary_op_at(%indent: #bits<64>, %temp: #bits<64>, %name: #addr, %name_length: #bits<64>, %kind: #bits<64>, %width: #bits<64>, %lhs: #addr, %lhs_length: #bits<64>, %rhs: #addr, %rhs_length: #bits<64>) -> #bits<32> {
  %sp = #call lainir_spaces(%indent)
  %pct = #data_addr lainir_pct_r
  %a = #call lainir_write(%pct, 2)
  %b = #call lainir_emit_uint(%temp)
  %as = #data_addr lainir_result_sep
  %c = #call lainir_write(%as, 3)
  %d = #call lainir_op_prefix(%name, %name_length, %kind, %width)
  %e = #call lainir_write(%lhs, %lhs_length)
  %cm = #data_addr lainir_comma
  %f = #call lainir_write(%cm, 2)
  %g = #call lainir_write(%rhs, %rhs_length)
  %end = #data_addr lainir_rparen_nl
  %h = #call lainir_write(%end, 2)
  #return %h
}

