  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%t)
  %as = #data_addr lainir_assign
  %d = #call lainir_write(%as, 4)
  %n = #data_addr lainir_alloca_name
  %f = #call lainir_write(%n, 6)
  %op = #data_addr lainir_bits_open
  %g = #call lainir_write(%op, 7)
  %w = #call lainir_emit_uint(%width)
  %ct = #data_addr lainir_close_type
  %i = #call lainir_write(%ct, 3)
  %cnt = #call lainir_emit_uint(%count)
  %end = #data_addr lainir_rparen_nl
  %j = #call lainir_write(%end, 2)
  #return 0
}

#proc lainir_store(%kind: #bits<64>, %width: #bits<64>, %value: #addr, %value_length: #bits<64>, %address: #addr, %address_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %h = #data_addr lainir_hash
  %b = #call lainir_write(%h, 1)
  %n = #data_addr lainir_store_name
  %c = #call lainir_write(%n, 5)
  %lb = #data_addr lainir_store_open
  %lbw = #call lainir_write(%lb, 1)
  %rep = #call lainir_repr(%kind, %width)
  %ct = #data_addr lainir_after_type
  %e = #call lainir_write(%ct, 2)
  %v = #call lainir_write(%value, %value_length)
  %comma = #data_addr lainir_comma
  %f = #call lainir_write(%comma, 2)
  %g = #call lainir_write(%address, %address_length)
  %end = #data_addr lainir_rparen_nl
  %i = #call lainir_write(%end, 2)
  #return 0
}

#proc lainir_lea_at(%temp: #bits<64>, %base: #addr, %base_length: #bits<64>, %index: #addr, %index_length: #bits<64>, %scale: #bits<64>, %disp: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%temp)
  %as = #data_addr lainir_assign
  %d = #call lainir_write(%as, 4)
  %n = #data_addr lainir_lea_name
  %f = #call lainir_write(%n, 3)
  %lp = #data_addr lainir_lparen
  %g = #call lainir_write(%lp, 1)
  %v0 = #call lainir_write(%base, %base_length)
  %comma = #data_addr lainir_comma
  %x1 = #call lainir_write(%comma, 2)
  %v1 = #call lainir_write(%index, %index_length)
  %x2 = #call lainir_write(%comma, 2)
  %x3 = #call lainir_emit_uint(%scale)
  %x4 = #call lainir_write(%comma, 2)
  %x5 = #call lainir_emit_uint(%disp)
  %end = #data_addr lainir_rparen_nl
  %x6 = #call lainir_write(%end, 2)
  #return 0
}

#proc lainir_lea(%base: #addr, %base_length: #bits<64>, %index: #addr, %index_length: #bits<64>, %scale: #bits<64>, %disp: #bits<64>) -> #bits<32> {
  %t = #call lainir_next_temp()
  %w = #call lainir_lea_at(%t, %base, %base_length, %index, %index_length, %scale, %disp)
  #return %w
}

