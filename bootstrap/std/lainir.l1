#proc lainir_call(%callee: #addr, %callee_length: #bits<64>, %args: #addr, %args_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %t = #call lainir_next_temp()
  %pct = #data_addr lainir_pct_r
  %b = #call lainir_write(%pct, 2)
  %c = #call lainir_emit_uint(%t)
  %as = #data_addr lainir_call_assign
  %d = #call lainir_write(%as, 4)
  %n = #data_addr lainir_call_name
  %w = #call lainir_write(%n, 4)
  %sp = #data_addr lainir_space
  %spw = #call lainir_write(%sp, 1)
  %name = #call lainir_write(%callee, %callee_length)
  %lp = #data_addr lainir_args_open
  %i = #call lainir_write(%lp, 1)
  %arg = #call lainir_write(%args, %args_length)
  %end = #data_addr lainir_rparen_nl
  %j = #call lainir_write(%end, 2)
  #return 0
}
#proc lainir_call_indirect(%target: #addr, %target_length: #bits<64>, %args: #addr, %args_length: #bits<64>) -> #bits<32> {
  %ind = #data_addr lainir_indent
  %a = #call lainir_write(%ind, 2)
  %h = #data_addr lainir_hash
  %hw = #call lainir_write(%h, 1)
  %word = #data_addr lainir_call_indirect_word
  %f = #call lainir_write(%word, 14)
  %v = #call lainir_write(%target, %target_length)
  %comma = #data_addr lainir_comma
  %x = #call lainir_write(%comma, 2)
  %arg = #call lainir_write(%args, %args_length)
  %end = #data_addr lainir_rparen_nl
  %j = #call lainir_write(%end, 2)
  #return 0
}

#proc lainir_data(%name: #addr, %name_length: #bits<64>, %values: #addr, %values_length: #bits<64>) -> #bits<32> {
  %n = #data_addr lainir_data_name
  %a = #call lainir_write(%n, 4)
  %sp = #data_addr lainir_space
  %b = #call lainir_write(%sp, 1)
  %c = #call lainir_write(%name, %name_length)
  %mode = #data_addr lainir_data_mode
  %d = #call lainir_write(%mode, 6)
  %v = #call lainir_write(%values, %values_length)
  %end = #data_addr lainir_close
  %e = #call lainir_write(%end, 2)
  #return 0
}

data lainir_if_name ro { 105 102 }
data lainir_loop_name ro { 108 111 111 112 }
