// 模块：标量/单元格读写与字节比较。跨单元引用一律写 `别名.名字`。
let std_regions = import("regions");

extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;

func meta_bytes_equal(a: addr, b: addr, n: u64) -> bool {
  let same: bool = loop cmp(i: u64 = 0) {
    let more: bool = i < n;
    if more {
      let ba: u8 = load(a + i);
      let bb: u8 = load(b + i);
      if ba == bb {
        continue cmp(i + 1);
      } else {
        break cmp(0);
      }
    } else {
      break cmp(1);
    }
  };
  return same;
}

func meta_cell_put(cell: addr, v: u64) -> u32 {
  let sc: addr = lain_meta_scratch_data();
  let bi: u64 = ptr_of(sc);
  let ci: u64 = ptr_of(cell);
  let under: bool = ci < bi;
  let cap: u64 = std_regions.meta_region_scratch_capacity();
  let lim: u64 = bi + cap;
  let over: bool = ci >= lim;
  let bad: bool = under or over;
  if bad {
    let f: u32 = lain_meta_fail(17);
    return 17;
  }
  let s: u32 = meta_cell_put_raw(cell, v);
  return s;
}

func meta_cell_put_raw(cell: addr, v: u64) -> u32 {
  store(cell, v);
  return 0;
}

func meta_cell_get_raw(cell: addr) -> u64 {
  let v: u64 = load(cell);
  return v;
}

func meta_cell_get(cell: addr) -> u64 {
  let v: u64 = load(cell);
  return v;
}

func bs_repr_size(kind: u64, width: u64) -> u64 {
  let is_addr: bool = kind == 3;
  if is_addr {
    return 8;
  }
  let bytes: u64 = width / 8;
  let zero: bool = bytes == 0;
  if zero {
    return 1;
  } else {
    return bytes;
  }
}

func bs_repr_align(kind: u64, width: u64) -> u64 {
  let a: u64 = bs_repr_size(kind, width);
  return a;
}
