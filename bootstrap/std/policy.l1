// First-generation policy surface used during cold start.
//
// These small functions are the seed implementation of the same stable
// policy ABI exported by std/meta.lain.  Keeping them in the bootstrap
// standard-library artifact lets the compiler exercise type, generic, effect
// and bounds policy without embedding those decisions in compiler_api.l1.

#proc meta_type_conversion_allowed(
  #bits<32> %from_kind, #bits<32> %to_kind, #bits<1> %explicit
) -> #bits<1> {
  #if #eq(%from_kind, %to_kind) { #return 1 }
  #if #eq(%from_kind, 3) {
    #if #eq(%to_kind, 1) {
      #if #eq(%explicit, 1) { #return 1 }
    }
  }
  #return 0
}

#proc meta_generic_parameter_valid(#bits<32> %kind) -> #bits<1> {
  #if #slt(%kind, 1) { #return 0 }
  #if #sgt(%kind, 4) { #return 0 }
  #return 1
}

#proc meta_generic_specialization_token(
  #bits<64> %source_id, #bits<64> %type_argument, #bits<64> %value_argument,
  #bits<64> %policy, #bits<64> %environment, #bits<64> %target, #bits<64> %backend
) -> #bits<64> {
  #let %base: #bits<64> = #add(#mul(#add(#mul(%source_id, 257), %type_argument), 257), %value_argument)
  #let %seed: #bits<64> = #add(#mul(%base, 17), %policy)
  #return #add(
    #mul(#add(#mul(#add(#mul(%seed, 257), %environment), 257), %target), 257),
    %backend
  )
}

#proc meta_effect_allowed(#bits<32> %required, #bits<32> %provided) -> #bits<1> {
  #if #eq(%required, 0) { #return 1 }
  #return #eq(%required, %provided)
}

#proc meta_bounds_check(#bits<64> %index, #bits<64> %length) -> #bits<32> {
  #if #sge(%index, %length) { #return 1 }
  #return 0
}
