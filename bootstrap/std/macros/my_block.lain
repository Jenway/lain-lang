// 模块：`my_block { ... }` 展开处理器。跨单元引用一律写 `别名.名字`。
//
// 把花括号组的孩子拼入当前 DECL 或 STMT 序列。它是通用 N→M 替换的基准处理器：
// 输入固定消费 2 项，输出数量由块内孩子数决定。
// 本单元在 bootstrap/std/macros/ 下，所以导入路径要带 `../`。

let std_expand = import("../expand");
let std_macros_my_if = import("my_if");
let std_parse = import("../parse");
let std_scope = import("../scope");
let std_syntax = import("../syntax");
let std_types = import("../types");

let meta_kw_my_block: ro [u8] = [109, 121, 95, 98, 108, 111, 99, 107];

extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_status() -> u64 = lain_meta_status;
extern lain_meta_ast_append_refs(refs: addr, count: u64) -> u64 = lain_meta_ast_append_refs;
extern lain_meta_ast_span_addr(reference: u64, length: u64) -> addr = lain_meta_ast_span_addr;
extern lain_meta_ast_charge(kind: u64, amount: u64) -> u32 = lain_meta_ast_charge;

func meta_register_my_block(node: u64) -> u32 {
  let hit: bool = std_parse.meta_node_is_word(node, symbol_addr("meta_kw_my_block_storage"), 8);
  if hit {
    let ensured2: u32 = std_syntax.meta_syntax_ensure(node, 2, 11);
    if ensured2 != 0 { return ensured2; }
    return std_syntax.meta_syntax_ensure(node, 1, 11);
  }
  return 0;
}

// 把一个 statement Group 展开后发布为替换切片。my_block 与依赖宏共用这条路径。
func meta_expand_splice_group(body: u64, consumed: u64, context: u64, result: addr) -> u32 {
  let root_context: bool = context == 1;
  let entered: u32 = if root_context { lain_meta_ast_charge(4, 1) } else { 0 };
  if root_context and (entered != 0) { return entered; }
  let expanded: u64 = if root_context { std_expand.meta_expand_root(body) } else { std_expand.meta_expand_stmt_group(body) };
  let left: u32 = if root_context { lain_meta_ast_charge(5, 1) } else { 0 };
  if expanded == 0 {
    let dependency: u64 = std_expand.meta_expand_defer_get();
    if dependency != 0 {
      let defer_status: u32 = std_macros_my_if.meta_expand_result_defer(result, dependency);
      return 0;
    }
    return lain_meta_status() as u32;
  }
  let count: u64 = std_parse.ast_child_count(expanded);
  let empty: bool = count == 0;
  if empty == 0 {
    let mark: u64 = std_scope.meta_bump_mark();
    let bytes: u64 = count * 8;
    let off: u64 = std_scope.meta_bump_alloc(bytes);
    if off == 0xFFFFFFFFFFFFFFFF {
      let error_status: u32 = std_macros_my_if.meta_expand_result_error(result, 17);
      return 0;
    }
    let scratch: addr = lain_meta_scratch_data();
    let refs: addr = scratch + off;
    let filled: u64 = loop children(i: u64 = 0) {
      let more: bool = i < count;
      if more {
        let child: u64 = std_parse.ast_child(expanded, i);
        let child_off: u64 = i * 8;
        let child_at: addr = refs + child_off;
        let put: u32 = std_types.meta_cell_put(child_at, child);
        continue children(i + 1);
      } else {
        break children(1);
      }
    };
    let made: u64 = lain_meta_ast_append_refs(refs, count);
    let release: u32 = std_scope.meta_bump_release(mark);
    if made == 0 { return lain_meta_status() as u32; }
    let s0: u32 = std_types.meta_cell_put(result, 1);
    let s1: u32 = std_types.meta_cell_put(result + 8, consumed);
    let s2: u32 = std_types.meta_cell_put(result + 16, made);
    let s3: u32 = std_types.meta_cell_put(result + 24, count);
    let s4: u32 = std_types.meta_cell_put(result + 32, 0);
    let s5: u32 = std_types.meta_cell_put(result + 40, 0);
    return 0;
  }
  let s0: u32 = std_types.meta_cell_put(result, 1);
  let s1: u32 = std_types.meta_cell_put(result + 8, consumed);
  let s2: u32 = std_types.meta_cell_put(result + 16, 0);
  let s3: u32 = std_types.meta_cell_put(result + 24, 0);
  let s4: u32 = std_types.meta_cell_put(result + 32, 0);
  let s5: u32 = std_types.meta_cell_put(result + 40, 0);
  return 0;
}

func meta_expand_my_block(request: addr, result: addr) -> u32 {
  let clear: u32 = std_macros_my_if.meta_expand_result_clear(result);
  let abi: u64 = std_types.meta_cell_get(request);
  let parent: u64 = std_types.meta_cell_get(request + 8);
  let cursor: u64 = std_types.meta_cell_get(request + 16);
  let context: u64 = std_types.meta_cell_get(request + 40);
  let expansion_id: u64 = std_types.meta_cell_get(request + 48);
  let head: u64 = std_parse.ast_child(parent, cursor);
  let kw: addr = symbol_addr("meta_kw_my_block_storage");
  let name_ok: bool = std_parse.meta_node_is_word(head, kw, 8);
  let ctx_ok: bool = (context == 1) or (context == 2);
  let abi_ok: bool = abi == 1;
  let matched: bool = abi_ok and ctx_ok and name_ok;
  if matched == 0 {
    let z0: u32 = std_types.meta_cell_put(result, 0);
    let z1: u32 = std_types.meta_cell_put(result + 32, 0);
    return 0;
  }
  if expansion_id == 0 {
    let bad_id: u32 = std_macros_my_if.meta_expand_result_error(result, 9408);
    return 0;
  }
  let parent_count: u64 = std_parse.ast_child_count(parent);
  let end: u64 = cursor + 2;
  if end > parent_count {
    let error_status: u32 = std_macros_my_if.meta_expand_result_error(result, 9409);
    return 0;
  }
  let body: u64 = std_parse.ast_child(parent, cursor + 1);
  let delimiter: u8 = std_parse.ast_delim(body);
  let delimiter_wide: u32 = delimiter as u32;
  if delimiter_wide != 123 {
    let error_status: u32 = std_macros_my_if.meta_expand_result_error(result, 9409);
    return 0;
  }
  return meta_expand_splice_group(body, 2, context, result);
}

// 块内部已经由处理器递归展开；这里只把替换引用复制进父输出序列。
func meta_expand_replacement_my_block(slice_ref: u64, count: u64, buffer: addr, outn: u64) -> u64 {
  if count == 0 { return 1; }
  let bytes: u64 = count * 8;
  let src: addr = lain_meta_ast_span_addr(slice_ref, bytes);
  let copied: u64 = loop repl(i: u64 = 0) {
    let more: bool = i < count;
    if more {
      let off: u64 = i * 8;
      let at: addr = src + off;
      let raw: u64 = std_types.meta_cell_get(at);
      let put: u32 = std_expand.meta_expand_store_ref(buffer, outn + i, raw);
      continue repl(i + 1);
    } else {
      break repl(1);
    }
  };
  return copied;
}
