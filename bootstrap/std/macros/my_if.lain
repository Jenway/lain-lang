// `my_if` 的独立语法处理器。它只匹配兄弟序列并返回替换切片；
// 不直接发射 LAINIR，也不修改 AstIn。请求/结果布局见 lain/meta/expand.h。
//
// 模块：跨单元引用一律写 `别名.名字`（别名 = 被导入单元的模块键），
// 指向本仓其它单元的影子 extern 已删除；宿主能力 extern 保留。
// 本单元在 bootstrap/std/macros/ 下，所以路径要带 `../`。

let std_expand = import("../expand");
let std_lex = import("../lex");
let std_parse = import("../parse");
let std_scope = import("../scope");
let std_syntax = import("../syntax");
let std_types = import("../types");

let meta_kw_my_if: ro [u8] = [109, 121, 95, 105, 102];
let meta_kw_generated_if: ro [u8] = [105, 102];

extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_status() -> u64 = lain_meta_status;
extern lain_meta_ast_append_token(text: addr, length: u64, origin: u64, expansion_id: u64) -> u64 = lain_meta_ast_append_token;
extern lain_meta_ast_append_refs(refs: addr, count: u64) -> u64 = lain_meta_ast_append_refs;
extern lain_meta_ast_span_addr(reference: u64, length: u64) -> addr = lain_meta_ast_span_addr;

func meta_register_my_if(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = std_parse.meta_node_is_word(node, dummy, symbol_addr("meta_kw_my_if_storage"), 5);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 2, 1);
  }
  return 0;
}

func meta_expand_result_clear(result: addr) -> u32 {
  let s0: u32 = std_types.meta_cell_put(result, 3);
  let s1: u32 = std_types.meta_cell_put(result + 8, 0);
  let s2: u32 = std_types.meta_cell_put(result + 16, 0);
  let s3: u32 = std_types.meta_cell_put(result + 24, 0);
  let s4: u32 = std_types.meta_cell_put(result + 32, 9408);
  let s5: u32 = std_types.meta_cell_put(result + 40, 0);
  return 0;
}

func meta_expand_result_error(result: addr, diagnostic: u64) -> u32 {
  let s0: u32 = std_types.meta_cell_put(result, 3);
  let s1: u32 = std_types.meta_cell_put(result + 8, 0);
  let s2: u32 = std_types.meta_cell_put(result + 16, 0);
  let s3: u32 = std_types.meta_cell_put(result + 24, 0);
  let s4: u32 = std_types.meta_cell_put(result + 32, diagnostic);
  let s5: u32 = std_types.meta_cell_put(result + 40, 0);
  return 0;
}

func meta_expand_result_defer(result: addr, dependency: u64) -> u32 {
  let s0: u32 = std_types.meta_cell_put(result, 2);
  let s1: u32 = std_types.meta_cell_put(result + 8, 0);
  let s2: u32 = std_types.meta_cell_put(result + 16, 0);
  let s3: u32 = std_types.meta_cell_put(result + 24, 0);
  let s4: u32 = std_types.meta_cell_put(result + 32, 0);
  let s5: u32 = std_types.meta_cell_put(result + 40, dependency);
  return 0;
}

// ABI：执行成功返回 0；匹配结果写入 result。这里只接受 STMT context=2。
func meta_expand_my_if(request: addr, result: addr) -> u32 {
  let clear: u32 = meta_expand_result_clear(result);
  let abi: u64 = std_types.meta_cell_get(request);
  let parent: u64 = std_types.meta_cell_get(request + 8);
  let cursor: u64 = std_types.meta_cell_get(request + 16);
  let context: u64 = std_types.meta_cell_get(request + 40);
  let expansion_id: u64 = std_types.meta_cell_get(request + 48);
  let abi_ok: bool = abi == 1;
  let ctx_ok: bool = context == 2;
  let head: u64 = std_parse.ast_child(parent, cursor);
  let dummy: addr = lain_meta_source_data(0);
  let kw: addr = symbol_addr("meta_kw_my_if_storage");
  let name_ok: bool = std_parse.meta_node_is_word(head, dummy, kw, 5);
  let matched: bool = abi_ok and ctx_ok and name_ok;
  if matched == 0 {
    let z0: u32 = std_types.meta_cell_put(result, 0);
    let z1: u32 = std_types.meta_cell_put(result + 32, 0);
    return 0;
  }
  if expansion_id == 0 {
    let bad_id: u32 = meta_expand_result_error(result, 9408);
    return 0;
  }
  let count: u64 = std_parse.ast_child_count(parent);
  let need: u64 = cursor + 3;
  if need > count {
    let e0: u32 = meta_expand_result_error(result, 9409);
    return 0;
  }
  let cond: u64 = std_parse.ast_child(parent, cursor + 1);
  let body: u64 = std_parse.ast_child(parent, cursor + 2);
  let cd: u8 = std_parse.ast_delim(cond);
  let cdw: u32 = cd as u32;
  let bd: u8 = std_parse.ast_delim(body);
  let bdw: u32 = bd as u32;
  let cond_ok: bool = cdw == 40;
  let body_ok: bool = bdw == 123;
  let shape: bool = cond_ok and body_ok;
  if shape == 0 {
    let e1: u32 = meta_expand_result_error(result, 9409);
    return 0;
  }
  let after_i: u64 = cursor + 3;
  let has_after: bool = after_i < count;
  let has_else_u: u64 = loop pickA(s: u64 = 0) {
    if has_after == 0 { break pickA(0); }
    let after_node: u64 = std_parse.ast_child(parent, after_i);
    let ekw: addr = std_lex.meta_kw_else;
    let hit_else: bool = std_parse.meta_node_is_word(after_node, dummy, ekw, 4);
    if hit_else { break pickA(1); }
    break pickA(0);
  };
  let has_else: bool = has_else_u != 0;
  if has_else {
    let else_end: u64 = cursor + 5;
    if else_end > count {
      let e2: u32 = meta_expand_result_error(result, 9409);
      return 0;
    }
    let else_body: u64 = std_parse.ast_child(parent, cursor + 4);
    let ed: u8 = std_parse.ast_delim(else_body);
    let edw: u32 = ed as u32;
    let else_ok: bool = edw == 123;
    if else_ok == 0 {
      let e3: u32 = meta_expand_result_error(result, 9409);
      return 0;
    }
  }
  let consumed: u64 = if has_else { 5 } else { 3 };
  let mark: u64 = std_scope.meta_bump_mark();
  let bytes: u64 = consumed * 8;
  let off: u64 = std_scope.meta_bump_alloc(bytes);
  if off == 0xFFFFFFFFFFFFFFFF {
    let e4: u32 = meta_expand_result_error(result, 9410);
    return 0;
  }
  let scratch: addr = lain_meta_scratch_data();
  let refs: addr = scratch + off;
  let if_text: addr = symbol_addr("meta_kw_generated_if_storage");
  let if_node: u64 = lain_meta_ast_append_token(if_text, 2, head, expansion_id);
  if if_node == 0 {
    let release0: u32 = std_scope.meta_bump_release(mark);
    let status0: u64 = lain_meta_status();
    let code0: u32 = status0 as u32;
    return code0;
  }
  let r0: u32 = std_types.meta_cell_put(refs, if_node);
  let r1: u32 = std_types.meta_cell_put(refs + 8, cond);
  let r2: u32 = std_types.meta_cell_put(refs + 16, body);
  if has_else {
    let else_word: u64 = std_parse.ast_child(parent, cursor + 3);
    let else_body2: u64 = std_parse.ast_child(parent, cursor + 4);
    let r3: u32 = std_types.meta_cell_put(refs + 24, else_word);
    let r4: u32 = std_types.meta_cell_put(refs + 32, else_body2);
  }
  let slice_ref: u64 = lain_meta_ast_append_refs(refs, consumed);
  if slice_ref == 0 {
    let release1: u32 = std_scope.meta_bump_release(mark);
    let status1: u64 = lain_meta_status();
    let code1: u32 = status1 as u32;
    return code1;
  }
  let release: u32 = std_scope.meta_bump_release(mark);
  let s0: u32 = std_types.meta_cell_put(result, 1);
  let s1: u32 = std_types.meta_cell_put(result + 8, consumed);
  let s2: u32 = std_types.meta_cell_put(result + 16, slice_ref);
  let s3: u32 = std_types.meta_cell_put(result + 24, consumed);
  let s4: u32 = std_types.meta_cell_put(result + 32, 0);
  let s5: u32 = std_types.meta_cell_put(result + 40, 0);
  return 0;
}

// my_if 替换片段的孩子上下文也由处理器拥有：第 2、4 个相对孩子是 statement
// Group。通用调度器只负责请求「把这段替换复制到输出」，不认识分支位置。
func meta_expand_replacement_my_if(slice_ref: u64, count: u64, buffer: addr, outn: u64) -> u64 {
  let bytes: u64 = count * 8;
  let src: addr = lain_meta_ast_span_addr(slice_ref, bytes);
  let copied: u64 = loop repl(j: u64 = 0) {
    let more: bool = j < count;
    if more {
      let jo: u64 = j * 8;
      let raw: u64 = std_types.meta_cell_get(src + jo);
      let is2: bool = j == 2;
      let is4: bool = j == 4;
      let branch: bool = is2 or is4;
      let value: u64 = if branch { std_expand.meta_expand_stmt_group(raw) } else { raw };
      if value == 0 { break repl(0); }
      let put: u32 = std_expand.meta_expand_store_ref(buffer, outn + j, value);
      continue repl(j + 1);
    } else {
      break repl(1);
    }
  };
  return copied;
}
