// 模块：`my_require NAME { ... }` 展开处理器。跨单元引用一律写 `别名.名字`。
//
// NAME 已登记时拼入块体；否则以 NAME 词作为依赖延后。
// 本单元在 bootstrap/std/macros/ 下，所以导入路径要带 `../`。

let std_expand = import("../expand");
let std_macros_my_block = import("my_block");
let std_macros_my_if = import("my_if");
let std_parse = import("../parse");
let std_syntax = import("../syntax");
let std_types = import("../types");

let meta_kw_my_require: ro [u8] = [109, 121, 95, 114, 101, 113, 117, 105, 114, 101];

func meta_register_my_require(node: u64) -> u32 {
  let hit: bool = std_parse.meta_node_is_word(node, symbol_addr("meta_kw_my_require_storage"), 10);
  if hit { return std_syntax.meta_syntax_ensure(node, 2, 12); }
  return 0;
}

func meta_expand_my_require(request: addr, result: addr) -> u32 {
  let clear: u32 = std_macros_my_if.meta_expand_result_clear(result);
  let abi: u64 = std_types.meta_cell_get(request);
  let parent: u64 = std_types.meta_cell_get(request + 8);
  let cursor: u64 = std_types.meta_cell_get(request + 16);
  let context: u64 = std_types.meta_cell_get(request + 40);
  let expansion_id: u64 = std_types.meta_cell_get(request + 48);
  let head: u64 = std_parse.ast_child(parent, cursor);
  let word: addr = symbol_addr("meta_kw_my_require_storage");
  let name_ok: bool = std_parse.meta_node_is_word(head, word, 10);
  let abi_ok: bool = abi == 1;
  let ctx_ok: bool = context == 2;
  let matched: bool = abi_ok and ctx_ok and name_ok;
  if matched == 0 {
    let z0: u32 = std_types.meta_cell_put(result, 0);
    let z1: u32 = std_types.meta_cell_put(result + 32, 0);
    return 0;
  }
  if expansion_id == 0 {
    let bad_id: u32 = std_macros_my_if.meta_expand_result_error(result, 9408);
    return 0;
  }
  let count: u64 = std_parse.ast_child_count(parent);
  let end: u64 = cursor + 3;
  if end > count {
    let e0: u32 = std_macros_my_if.meta_expand_result_error(result, 9409);
    return 0;
  }
  let name: u64 = std_parse.ast_child(parent, cursor + 1);
  let body: u64 = std_parse.ast_child(parent, cursor + 2);
  let kind: u8 = std_parse.ast_kind(name);
  let kind_wide: u32 = kind as u32;
  let delimiter: u8 = std_parse.ast_delim(body);
  let delimiter_wide: u32 = delimiter as u32;
  let name_is_word: bool = kind_wide == 1;
  let body_is_group: bool = delimiter_wide == 123;
  let shape: bool = name_is_word and body_is_group;
  if shape == 0 {
    let e1: u32 = std_macros_my_if.meta_expand_result_error(result, 9409);
    return 0;
  }
  let binding: u64 = std_expand.meta_expand_dependency_binding(name);
  let missing: bool = binding == 0xFFFFFFFFFFFFFFFF;
  if missing {
    let d0: u32 = std_types.meta_cell_put(result, 2);
    let d1: u32 = std_types.meta_cell_put(result + 8, 0);
    let d2: u32 = std_types.meta_cell_put(result + 16, 0);
    let d3: u32 = std_types.meta_cell_put(result + 24, 0);
    let d4: u32 = std_types.meta_cell_put(result + 32, 0);
    let d5: u32 = std_types.meta_cell_put(result + 40, name);
    return 0;
  }
  let spliced: u32 = std_macros_my_block.meta_expand_splice_group(body, 3, context, result);
  return spliced;
}
