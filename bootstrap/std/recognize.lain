// 模块：形状识别 pass。走一遍树，把「这个节点开始了什么形状」写进节点的种类格。
//
// 为什么要有这一层：每个降级点各自按**位置的字节**重新认形状的话，同一条形状规则
// 会在多处各写一遍，改一处漏两处 —— `1 + 2 + 3` 只发 `#add(1,2)` 就是这么漏的。
//
// 这一遍算完写进种类格，之后降级只读它。**判据只用形状**（自己/下一个兄弟的字节、
// 兄弟是不是组），不看类型 —— 类型是第 3 步的事。所以 `bits<32> { … }` 里的 `>`
// 会被记成「构造」：它确实是「后面跟了个花括号组」。只有真正当值用的位置才来读这个
// 形状，而 `bits<32>` 不在值位置上。
//
// 种类格的取值（1 / 2 是建树时给的，3 起是这里写的）：
//
//   1  词      普通词，没认出更具体的
//   2  组      括号组
//   3  声明    let / func / struct / enum 之一
//   4  二元    这里开始一条算子链（下一个兄弟是算子符号）
//   5  调用    下一个兄弟是 `(` 组
//   6  字段    下一个兄弟是 `.`
//   7  常量    字面量数字
//   8  返回    return
//   9  算子    这个词是单字节算子符号
//   10 构造    下一个兄弟是 `{` 组
//   11 条件    if
//
// 优先级：声明 > 返回 > if > 自己是算子 > 调用 > 构造 > 字段 > 二元 > 常量 > 词。
// 「自己是算子」排在调用前面，是因为算子符号后面不可能跟一个组；反过来 `f(x)` 的
// `f` 不是算子，所以两条不会争。
//
// u8 没有算子，与整数常量比较一律先 `as u32`。跨单元引用一律写 `别名.名字`。

let std_declarations = import("declarations");
let std_lex = import("lex");
let std_parse = import("parse");
let std_syntax = import("syntax");
let std_types = import("types");

// 宿主能力。
extern lain_meta_ast_expansion_id(node: u64) -> u64 = lain_meta_ast_expansion_id;
extern lain_meta_scratch_data() -> addr = lain_meta_scratch_data;
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_source_length(source: u64) -> u64 = lain_meta_source_length;

// 这个词是不是一个算子符号？最长的是 `and`（3 字节）。
// 位置越界时 `bs_byte_at` 给 0，所以兄弟是「无」的时候在这里是安全的。
func meta_rec_is_op(base: addr, at: u64, n: u64, len: u64) -> bool {
  let one: bool = n <= 3;
  if one == 0 { return 0; }
  let o: bool = std_lex.bs_is_operator(base, at, len, n);
  return o;
}

// 这个词是不是单个 `.`？
func meta_rec_is_dot(base: addr, at: u64, n: u64, len: u64) -> bool {
  let one: bool = n == 1;
  if one == 0 { return 0; }
  let b: u8 = std_lex.bs_byte_at(base, at, len);
  let bw: u32 = b as u32;
  let d: bool = bw == 46;
  return d;
}

// 找当前 Group 的语法拥有者。中央层只枚举此前的兄弟并传相对下标；具体哪一个
// 孩子进入什么上下文，由命中的处理器回答。
func meta_recognize_group_context(parent: u64, index: u64, ambient: u64) -> u64 {
  let context: u64 = loop owners(i: u64 = 0) {
    let more: bool = i < index;
    if more == 0 { break owners(0); }
    let head: u64 = std_parse.ast_child(parent, i);
    let handler: u64 = std_syntax.meta_syntax_lookup(head, 1, 0, ambient);
    let relative: u64 = index - i;
    let candidate: u64 = if handler != 0 {
      std_declarations.meta_recognize_child_context_invoke(handler, relative)
    } else {
      0
    };
    if candidate != 0 { break owners(candidate); }
    continue owners(i + 1);
  };
  return context;
}

// 给一个词节点算形状，写进**语义旁表**。
//
// 参数是一个游标：(父组引用, child_index)。形状里要用到「下一个兄弟」，而规范禁止
// `node.next` —— 下一个兄弟由父组 + index+1 给出，所以游标是唯一能让这段逻辑成立
// 的输入形状。
func meta_recognize_word(base: addr, len: u64, parent: u64, index: u64, ambient: u64) -> u32 {
  let i: u64 = std_parse.ast_child(parent, index);
  let at: u64 = std_parse.meta_node_start(i);
  let n: u64 = std_parse.meta_node_len(i);
  let hi: u64 = at + n;

  // 语言关键字由语法环境拥有；recognize 只把处理器类别映射到旁表 form。
  let decl_context: bool = ambient == 1;
  let stmt_context: bool = ambient == 2;
  let decl_match: u64 = if decl_context { std_syntax.meta_syntax_match(i, 1, 0, 1) } else { 0 };
  let stmt_match: u64 = if stmt_context { std_syntax.meta_syntax_match(i, 1, 0, 2) } else { 0 };
  let decl_handler: u64 = decl_match and 0xFFFFFFFF;
  let stmt_handler: u64 = stmt_match and 0xFFFFFFFF;
  let decl_hi: bool = decl_handler >= 2;
  let decl_lo: bool = decl_handler <= 7;
  let is_decl: bool = decl_hi and decl_lo;
  let is_ret: bool = stmt_handler == 8;
  let is_if: bool = stmt_handler == 3;

  let self_op: bool = meta_rec_is_op(base, at, n, len);
  let self_b: u8 = std_lex.bs_byte_at(base, at, len);
  let self_digit: bool = std_lex.bs_is_digit(self_b);

  // 下一个兄弟决定「这里开始的是什么」。它是**父组的下一个孩子**；越过末尾时
  // 下面每条判断都给假。
  let count: u64 = std_parse.ast_child_count(parent);
  let nx_i: u64 = index + 1;
  let has_nx: bool = nx_i < count;
  let nx_kind: u64 = if has_nx {
    let nx0: u64 = std_parse.ast_child(parent, nx_i);
    let k0: u8 = std_parse.ast_kind(nx0);
    k0 as u64
  } else {
    0xFFFFFFFFFFFFFFFF
  };
  let nx_at: u64 = if has_nx {
    let nx1: u64 = std_parse.ast_child(parent, nx_i);
    std_parse.ast_text_start(nx1)
  } else {
    0
  };
  let nx_n: u64 = if has_nx {
    let nx2: u64 = std_parse.ast_child(parent, nx_i);
    std_parse.ast_text_len(nx2)
  } else {
    0
  };
  let nx_is_group: bool = nx_kind == 2;
  let nx_is_op: bool = meta_rec_is_op(base, nx_at, nx_n, len);
  let nx_is_dot: bool = meta_rec_is_dot(base, nx_at, nx_n, len);
  // 组节点从它自己的开括号起（reader 给出的源码位置），所以看那一格
  // 就知道是 `(` 还是 `{`。这两个形状完全不同：调用 vs 构造。
  let nx_b: u8 = std_lex.bs_byte_at(base, nx_at, len);
  let nx_bw: u32 = nx_b as u32;
  let nx_paren: bool = nx_bw == 40;
  let nx_brace: bool = nx_bw == 123;
  let nx_lbrack: bool = nx_bw == 91;
  let callish: bool = nx_is_group and nx_paren;
  let construct: bool = nx_is_group and nx_brace;
  let indexish: bool = nx_is_group and nx_lbrack;
  // 裸名字形态：`?NAME`。`?` 不是标识符字符，所以只看这个词自己的第一个字节。
  let self_b0: u8 = std_lex.bs_byte_at(base, at, len);
  let self_b0w: u32 = self_b0 as u32;
  let bareish: bool = self_b0w == 63;

  // 按优先级取第一个命中的形状（命中即 break）。
  let form: u64 = loop pick_form(t: u64 = 0) {
    if is_decl { break pick_form(3); }
    if is_ret { break pick_form(8); }
    if is_if { break pick_form(11); }
    if self_op { break pick_form(9); }
    if callish { break pick_form(5); }
    if bareish { break pick_form(13); }
    if indexish { break pick_form(12); }
    if construct { break pick_form(10); }
    if nx_is_dot { break pick_form(6); }
    if nx_is_op { break pick_form(4); }
    if self_digit { break pick_form(7); }
    break pick_form(1);
  };
  // 声明上下文优先；若不是声明，再记录 statement 绑定。普通标识符和表达式词为 0。
  let decl_binding: u64 = decl_match >> 32;
  let stmt_binding: u64 = stmt_match >> 32;
  let binding: u64 = if decl_handler != 0 { decl_binding } else { stmt_binding };
  let stmt_ctx: u64 = if stmt_handler != 0 { 2 } else { 0 };
  let context: u64 = if decl_handler != 0 { 1 } else { stmt_ctx };
  // Host 的事务旁车按 AstOut 节点槽保存处理器调用 ID。AstIn 没有这项输出能力。
  let segment: u64 = i >> 48;
  let is_out: bool = segment == 3;
  let expansion: u64 = if is_out { lain_meta_ast_expansion_id(i) } else { 0 };
  let s: u32 = std_parse.meta_sem_put_annotated(parent, index, context, form, binding, expansion);
  return s;
}

// 走一个组的全部孩子：组先递归进去，词算形状。
// **没有兄弟链**：位置由 (父组, 下标) 给出，所以组的孩子和它的后继都不需要节点
// 自己携带。形状写进语义旁表。
func meta_recognize_all(base: addr, len: u64, group: u64, ambient: u64) -> u32 {
  let count: u64 = std_parse.ast_child_count(group);
  let st: u32 = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more == 0 { break s(0); }
    let c: u64 = std_parse.ast_child(group, i);
    let k: u8 = std_parse.ast_kind(c);
    let kw: u32 = k as u32;
    let is_group: bool = kw == 2;
    // **每个出现位置都要进旁表**，不只是词：组的位置也要有形状条目（编号 2 =
    // Group，与 reader 的种类编号一致），`meta_node_form(父组, 下标)` 才答得出来。
    // 键是 (父组, 下标) —— 出现位置，不是节点引用；同一个组节点出现在两个父组里
    // 会有两条互不覆盖的条目。
    if is_group {
      let segment: u64 = c >> 48;
      let is_out: bool = segment == 3;
      let expansion: u64 = if is_out { lain_meta_ast_expansion_id(c) } else { 0 };
      let rec: u32 = std_parse.meta_sem_put_annotated(group, i, 0, 2, 0, expansion);
      if rec != 0 { return rec; }
      let sub_context: u64 = meta_recognize_group_context(group, i, ambient);
      let sub: u32 = meta_recognize_all(base, len, c, sub_context);
      if sub != 0 { break s(sub); }
      continue s(i + 1);
    }
    let w: u32 = meta_recognize_word(base, len, group, i, ambient);
    if w != 0 { break s(w); }
    continue s(i + 1);
  };
  return st;
}

// 一份源码识别一遍。旁表是**单张**的，键是 (父组, 下标)：重复识别同一份源码是幂等的
//（同键覆盖），不同源码的条目也能共存（父组引用里带段号，天然不冲突）。
func meta_recognize_source(source: u64) -> u32 {
  let base: addr = lain_meta_source_data(source);
  let len: u64 = lain_meta_source_length(source);
  let root: u64 = std_parse.meta_root_of(source);
  // root 缺席 = 这份源码被 reader 拒了（AstIn 段不活、Arena 一个字节都没发布）。
  let none: bool = root == 0;
  let st: u32 = if none {
    0
  } else {
    // **不要清表**：单张旁表 + 「谁在用就重新识别谁」的组合下，清表会把上一层已经
    // 建好的条目**全部抹掉**。
    // **根不进旁表**：它的形状属于「顶层形式序列」这个位置，而根自己不是任何父组的
    // 孩子 —— 没有游标指向它，也就没有键可写；写 (root, 0) 会与
    // 「root 的第 0 个孩子」这条条目**撞键**。
    meta_recognize_all(base, len, root, 1)
  };
  return st;
}

// 在 %group 的子树里找 text 起点等于 %at 的那个**出现位置**。
//
// 命中：把它的**父组**写进暂存区固定格 +2400，返回它在那个父组里的下标。
// 未命中：返回「查不到」（0xFFFFFFFFFFFFFFFF，非引用域），格子不动。
//
// **组也算**：组的 text 起点就是它那个开括号的位置，而那个位置上没有叶子，所以不会
// 和叶子的匹配打架。`(1 + 2) + 3` 的值的第一个节点就是那个组 —— 只认叶子的话查不到它，
// 形状就成了「无」，整段被当成常量走错路。
//
// 遍历只走「当前正在看的组的孩子」，不许跨组：位置由父组与下标给出，返回的也是这两样。
func meta_cursor_at(group: u64, at: u64) -> u64 {
  let count: u64 = std_parse.ast_child_count(group);
  let r: u64 = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more == 0 { break s(0xFFFFFFFFFFFFFFFF); }
    let c: u64 = std_parse.ast_child(group, i);
    let st: u64 = std_parse.ast_text_start(c);
    let same: bool = st == at;
    if same {
      // 命中：把父组记下来（递归向上传播的是下标，父组走格子带出来）。
      let sc: addr = lain_meta_scratch_data();
      let pw: u32 = std_types.meta_cell_put(sc + 2400, group);
      break s(i);
    }
    let k: u8 = std_parse.ast_kind(c);
    let kw: u32 = k as u32;
    let is_group: bool = kw == 2;
    if is_group {
      let inner: u64 = meta_cursor_at(c, at);
      let miss: bool = inner == 0xFFFFFFFFFFFFFFFF;
      if miss == 0 { break s(inner); }
    }
    continue s(i + 1);
  };
  return r;
}

// 暂存区里「上一次 `meta_cursor_at` 命中的父组」那一格。它只在 `meta_cursor_at`
// 返回非「查不到」之后有效，并且必须**紧接着**用掉。
func meta_cursor_parent() -> u64 {
  let sc: addr = lain_meta_scratch_data();
  let p: u64 = std_types.meta_cell_get(sc + 2400);
  return p;
}

// 从 %at 起头的那个节点的**引用**（找不到回空引用 0）。它由命中位置的父组与下标
// 算出来 —— 「位置 -> 节点」是合法方向（搜索），被禁止的是「节点 -> 唯一父组」。
func meta_node_at(base: addr, at: u64) -> u64 {
  let root: u64 = std_parse.meta_root_of_source(base);
  let missing: bool = root == 0;
  if missing { return 0; }
  let i: u64 = meta_cursor_at(root, at);
  let none: bool = i == 0xFFFFFFFFFFFFFFFF;
  if none { return 0; }
  let parent: u64 = meta_cursor_parent();
  let c: u64 = std_parse.ast_child(parent, i);
  return c;
}

// 从 %at 起头的那个节点的形状（读语义旁表，键是命中位置的父组与下标）。
// 找不到回「查不到」。
func meta_form_at(base: addr, at: u64) -> u64 {
  let root: u64 = std_parse.meta_root_of_source(base);
  let missing: bool = root == 0;
  if missing { return 0xFFFFFFFFFFFFFFFF; }
  let i: u64 = meta_cursor_at(root, at);
  let none: bool = i == 0xFFFFFFFFFFFFFFFF;
  if none { return 0xFFFFFFFFFFFFFFFF; }
  let parent: u64 = meta_cursor_parent();
  let f: u64 = std_parse.meta_node_form(parent, i);
  return f;
}

// 位置 -> 出现位置（父组走暂存区 +2400 格子，返回下标）；找不到回「查不到」。
// 调用方必须在**紧接着**的语句里用掉那一格（`meta_cursor_parent`）。
func meta_cursor_of_at(base: addr, at: u64) -> u64 {
  let root: u64 = std_parse.meta_root_of_source(base);
  let missing: bool = root == 0;
  if missing { return 0xFFFFFFFFFFFFFFFF; }
  let i: u64 = meta_cursor_at(root, at);
  return i;
}

// 位置 -> **同一个父组里的下一个孩子**（空引用 0 = 到头）。
//
// 这是「位置 -> 位置」的查询：先按字节起点定位那个出现位置（父组 + 下标），再取
// 父组的下一项。全程**不碰节点引用**，也不假设某个引用唯一确定父组或后继 ——
// 那些正是规范 §2.1 禁止的东西。给「手里只有字节位置、没有游标」的调用点用
//（顶层值那条路按位置走）；已经有游标的循环必须直接推进游标，不要绕这一圈。
func meta_next_at(base: addr, at: u64) -> u64 {
  let i: u64 = meta_cursor_of_at(base, at);
  let none: bool = i == 0xFFFFFFFFFFFFFFFF;
  if none { return 0; }
  let parent: u64 = meta_cursor_parent();
  let c: u64 = std_parse.meta_cursor_next(parent, i);
  return c;
}

// 一个组里从下标 %i 开始的**兄弟序列**里有没有算子形状（9）？走到 `;` 为止。
//
// 遍历的是**当前组的兄弟序列**，不是「节点自己的下一个兄弟」——这就是
// 「(当前组, 起始下标)」这对游标存在的理由：同一段连续的兄弟，从中间起步问
// 「后面有没有算子」，答案取决于起点；节点引用本身答不了这个问题。
func meta_seq_has_op(base: addr, len: u64, group: u64, i: u64) -> bool {
  let count: u64 = std_parse.ast_child_count(group);
  let r: bool = loop s(j: u64 = i) {
    let more: bool = j < count;
    if more == 0 { break s(0); }
    let c: u64 = std_parse.ast_child(group, j);
    let k: u64 = std_parse.meta_node_form(group, j);
    let is_op: bool = k == 9;
    if is_op { break s(1); }
    let st: u64 = std_parse.ast_text_start(c);
    let b: u8 = std_lex.bs_byte_at(base, st, len);
    let bw: u32 = b as u32;
    let is_semi: bool = bw == 59;
    if is_semi { break s(0); }
    continue s(j + 1);
  };
  return r;
}

// 从 %at 起头的那个节点所在的兄弟序列里有没有算子形状（9）？走到 `;` 为止。
//
// 形状 5/6/10 表示「这里开始一次调用 / 字段访问 / 构造」，而整个值可能只是它的
// 一部分。`f(1) + 2` 里 `f` 的形状也是 5，但值是一条链；调用 / 字段 / 构造那三条
// 发射器只发那个构造本身，后面剩下的会被**悄悄丢掉**。所以走那三条之前先问这个，
// 有算子就报错，不发。
//
// `;` 是单个词、字节 59。组里面的 `;` 不是兄弟，所以走不到。
//
// 「根都没找到」和「查不到该节点」都按「可能有算子」处理（回 1）。
func meta_value_has_op(base: addr, len: u64, at: u64) -> bool {
  let root: u64 = std_parse.meta_root_of_source(base);
  let missing: bool = root == 0;
  // 连根都没找到：**按「可能有算子」处理**。宁可走慢一点的表达式发射器，
  // 也不要因为查不到就选「值就是一次调用」那条捷径 —— 它会静默丢掉后面的算子。
  if missing { return 1; }
  let f: u64 = meta_seq_has_op_at(root, base, len, at);
  let unknown: bool = f == 0xFFFFFFFFFFFFFFFF;
  if unknown { return 1; }
  let zero: bool = f == 0;
  let has: bool = zero == 0;
  return has;
}

// 找到 %at 那个节点所在的组与下标，再问那个序列。%group 是当前正在看的组。
//
// 返回值是**三态**：1 = 有算子，0 = 找到了、序列里没有算子，0xFFFFFFFFFFFFFFFF =
// 这棵子树里没有 %at 那个节点。三态是必需的：递归找节点时「没找到」和「找到但没
// 算子」必须分得开 —— 都回 0 的话，只要目标在**嵌套的组**里（函数体就是一层
// 花括号组），外层循环就会把递归答案丢掉、一路扫到组尾回 0。
func meta_seq_has_op_at(group: u64, base: addr, len: u64, at: u64) -> u64 {
  let count: u64 = std_parse.ast_child_count(group);
  let r: u64 = loop s(i: u64 = 0) {
    let more: bool = i < count;
    if more == 0 { break s(0xFFFFFFFFFFFFFFFF); }
    let c: u64 = std_parse.ast_child(group, i);
    let st: u64 = std_parse.ast_text_start(c);
    let same: bool = st == at;
    if same {
      let h: bool = meta_seq_has_op(base, len, group, i);
      let hw: u64 = h as u64;
      break s(hw);
    }
    let k: u8 = std_parse.ast_kind(c);
    let kw: u32 = k as u32;
    let is_group: bool = kw == 2;
    if is_group {
      let inner: u64 = meta_seq_has_op_at(c, base, len, at);
      let none: bool = inner == 0xFFFFFFFFFFFFFFFF;
      let found: bool = none == 0;
      if found { break s(inner); }
    }
    continue s(i + 1);
  };
  return r;
}
