// 识别 pass —— 走一遍树，把「这个节点开始了什么形状」写进节点的种类格。
//
// 为什么要有这一层：在这之前，每个降级点各自按**位置的字节**重新认形状。
// `meta_emit_value` 看值的头一个字节判数字/构造，又看第一个标识符之后的字节判
// `{` / `.` / `(`；`meta_emit_numeric` 看值后面第一个非空白字节是不是算子。同一条
// 形状规则因此在三处各写一遍，改一处漏两处 —— `1 + 2 + 3` 只发 `#add(1,2)` 就是
// 这么漏的。
//
// 这一遍算完写进种类格，之后降级只读它。**判据只用形状**（自己/下一个兄弟的字节、
// 兄弟是不是组），不看类型 —— 类型是第 3 步的事。所以 `bits<32> { … }` 里的 `>`
// 会被记成「构造」：它确实是「后面跟了个花括号组」。只有真正当值用的位置才来读这个
// 形状，而 `bits<32>` 不在值位置上。
//
// 种类格的取值（1 / 2 是建树时给的，3 起是这里写的）：
//
//   1  词      普通词，没认出更具体的
//   2  组      括号组
//   3  声明    let / func / struct / enum / scalar 之一
//   4  二元    这里开始一条算子链（下一个兄弟是算子符号）
//   5  调用    下一个兄弟是 `(` 组
//   6  字段    下一个兄弟是 `.`
//   7  常量    字面量数字
//   8  返回    return
//   9  算子    这个词是单字节算子符号
//   10 构造    下一个兄弟是 `{` 组
//   11 条件    if
//
// 优先级：声明 > 返回 > if > 自己是算子 > 调用 > 构造 > 字段 > 二元 > 常量 > 词。
// 「自己是算子」排在调用前面，是因为算子符号后面不可能跟一个组；反过来 `f(x)` 的
// `f` 不是算子，所以两条不会争。

// 「这一段字节是不是关键字 kw」用 `scalars.l1` 已有的 `meta_word_is`：它收
// [lo, hi)，这里手里是起点 + 长度，加一下就是 hi。不另写一份。

// 这个词是不是单个算子符号？长度必须是 1，而且那一个字节得是算子。
// 位置越界时 `bs_byte_at` 给 0，所以兄弟是「无」的时候在这里是安全的。
#proc meta_rec_is_op(%base: #addr, %at: #bits<64>, %n: #bits<64>,
                      %len: #bits<64>) -> #bits<1> {
  %one = #eq[#bits<64>](%n, 1)
  %r = #if %one -> (#bits<1>) {
    %b = #call bs_byte_at(%base, %at, %len)
    %o = #call bs_is_operator(%b)
    #yield %o
  } else {
    #yield 0
  }
  #return %r
}

// 这个词是不是单个 `.`？
#proc meta_rec_is_dot(%base: #addr, %at: #bits<64>, %n: #bits<64>,
                       %len: #bits<64>) -> #bits<1> {
  %one = #eq[#bits<64>](%n, 1)
  %r = #if %one -> (#bits<1>) {
    %b = #call bs_byte_at(%base, %at, %len)
    %d = #eq[#bits<8>](%b, 46)
    #yield %d
  } else {
    #yield 0
  }
  #return %r
}

// 给一个词节点算形状，写进**语义旁表**（不再往 AstIn 的种类格写）。
//
// 参数是一个游标：(父组引用, child_index)。形状里要用到「下一个兄弟」，而规范禁止
// `node.next` —— 下一个兄弟由父组 + index+1 给出，所以游标是唯一能让这段逻辑成立
// 的输入形状。
#proc meta_recognize_word(%base: #addr, %len: #bits<64>, %parent: #bits<64>,
                          %index: #bits<64>) -> #bits<32> {
  %i = #call ast_child(%parent, %index)
  %at = #call meta_node_start(%i)
  %n = #call meta_node_len(%i)
  %hi = #add[#bits<64>](%at, %n)

  // 语言关键字由语法环境拥有；recognize 只把处理器类别映射到旧旁表 form。
  %decl_match = #call meta_syntax_match(%i, 1, 0, 1)
  %stmt_match = #call meta_syntax_match(%i, 1, 0, 2)
  %decl_handler = #and[#bits<64>](%decl_match, 0xFFFFFFFF)
  %stmt_handler = #and[#bits<64>](%stmt_match, 0xFFFFFFFF)
  %is_decl = #and[#bits<1>](#uge[#bits<64>](%decl_handler, 2),
                            #ule[#bits<64>](%decl_handler, 7))
  %is_ret = #eq[#bits<64>](%stmt_handler, 8)
  %is_if = #eq[#bits<64>](%stmt_handler, 3)

  %self_op = #call meta_rec_is_op(%base, %at, %n, %len)
  %self_b = #call bs_byte_at(%base, %at, %len)
  %self_digit = #call bs_is_digit(%self_b)

  // 下一个兄弟决定「这里开始的是什么」。它是**父组的下一个孩子**；没有下一个
  // （越过末尾）时下面每条判断都给假——旧代码靠「无」节点的种类达到同样效果，
  // 现在靠显式范围判断，不再伪造一个空节点。
  %count = #call ast_child_count(%parent)
  %nx_i = #add[#bits<64>](%index, 1)
  %has_nx = #ult[#bits<64>](%nx_i, %count)
  %nx_kind = #if %has_nx -> (#bits<64>) {
    %nx0 = #call ast_child(%parent, %nx_i)
    %k0 = #call ast_kind(%nx0)
    %w0 = #zext[#bits<64>](%k0)
    #yield %w0
  } else {
    #yield 0xFFFFFFFFFFFFFFFF
  }
  %nx_at = #if %has_nx -> (#bits<64>) {
    %nx1 = #call ast_child(%parent, %nx_i)
    %s1 = #call ast_text_start(%nx1)
    #yield %s1
  } else {
    #yield 0
  }
  %nx_n = #if %has_nx -> (#bits<64>) {
    %nx2 = #call ast_child(%parent, %nx_i)
    %s2 = #call ast_text_len(%nx2)
    #yield %s2
  } else {
    #yield 0
  }
  %nx_is_group = #eq[#bits<64>](%nx_kind, 2)
  %nx_is_op = #call meta_rec_is_op(%base, %nx_at, %nx_n, %len)
  %nx_is_dot = #call meta_rec_is_dot(%base, %nx_at, %nx_n, %len)
  // 组节点从它自己的开括号起（reader 给出的源码位置），所以看那一格
  // 就知道是 `(` 还是 `{`。这两个形状完全不同：调用 vs 构造。
  %nx_b = #call bs_byte_at(%base, %nx_at, %len)
  %nx_paren = #eq[#bits<8>](%nx_b, 40)
  %nx_brace = #eq[#bits<8>](%nx_b, 123)
  %callish = #and[#bits<1>](%nx_is_group, %nx_paren)
  %construct = #and[#bits<1>](%nx_is_group, %nx_brace)

  %form = #if %is_decl -> (#bits<64>) {
    #yield 3
  } else {
    %f2 = #if %is_ret -> (#bits<64>) {
      #yield 8
    } else {
      %f2b = #if %is_if -> (#bits<64>) {
        #yield 11
      } else {
        %f3 = #if %self_op -> (#bits<64>) {
        #yield 9
      } else {
        %f4 = #if %callish -> (#bits<64>) {
          #yield 5
        } else {
          %f5 = #if %construct -> (#bits<64>) {
            #yield 10
          } else {
            %f6 = #if %nx_is_dot -> (#bits<64>) {
              #yield 6
            } else {
              %f7 = #if %nx_is_op -> (#bits<64>) {
                #yield 4
              } else {
                %f8 = #if %self_digit -> (#bits<64>) {
                  #yield 7
                } else {
                  #yield 1
                }
                #yield %f8
              }
              #yield %f7
            }
            #yield %f6
          }
          #yield %f5
        }
        #yield %f4
      }
      #yield %f3
      }
      #yield %f2b
    }
    #yield %f2
  }
  // 声明上下文优先；若不是声明，再记录 statement 绑定。普通标识符和表达式词为 0。
  %decl_binding = #lshr[#bits<64>](%decl_match, 32)
  %stmt_binding = #lshr[#bits<64>](%stmt_match, 32)
  %binding = #if #ne[#bits<64>](%decl_handler, 0) -> (#bits<64>) {
    #yield %decl_binding
  } else {
    #yield %stmt_binding
  }
  // Host 的事务旁车按 AstOut 节点槽保存处理器调用 ID。AstIn 不需要这项输出能力，
  // 第一阶段只读消费者因此仍能运行。
  %segment = #lshr[#bits<64>](%i, 48)
  %is_out = #eq[#bits<64>](%segment, 3)
  %expansion = #if %is_out -> (#bits<64>) {
    %eid = #call lain_meta_ast_expansion_id(%i)
    #yield %eid
  } else { #yield 0 }
  %s = #call meta_sem_put_annotated(%parent, %index, %form, %binding, %expansion)
  #return %s
}

// 走一个组的全部孩子：组先递归进去，词算形状。
// **没有兄弟链**：位置由 (父组, 下标) 给出，所以组的孩子和它的后继都不需要节点
// 自己携带。形状写进语义旁表。
#proc meta_recognize_all(%base: #addr, %len: #bits<64>,
                         %group: #bits<64>) -> #bits<32> {
  %count = #call ast_child_count(%group)
  %st = #loop s(%i: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%group, %i)
      %k = #call ast_kind(%c)
      %is_group = #eq[#bits<8>](%k, 2)
      // **每个出现位置都要进旁表**，不只是词：组的位置也要有形状条目（编号 2 =
      // Group，与 reader 的种类编号一致），`meta_node_form(父组, 下标)` 才答得出来。
      // 键是 (父组, 下标) —— 出现位置，不是节点引用；同一个组节点出现在两个父组里
      // 会有两条互不覆盖的条目。
      %r = #if %is_group -> (#bits<32>) {
        %segment = #lshr[#bits<64>](%c, 48)
        %is_out = #eq[#bits<64>](%segment, 3)
        %expansion = #if %is_out -> (#bits<64>) {
          %eid = #call lain_meta_ast_expansion_id(%c)
          #yield %eid
        } else { #yield 0 }
        %rec = #call meta_sem_put_annotated(%group, %i, 2, 0, %expansion)
        #if #ne[#bits<32>](%rec, 0) {
          #return %rec
        }
        %sub = #call meta_recognize_all(%base, %len, %c)
        #yield %sub
      } else {
        %w = #call meta_recognize_word(%base, %len, %group, %i)
        #yield %w
      }
      #if #ne[#bits<32>](%r, 0) {
        #break s(%r)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0)
    }
  }
  #return %st
}

// 一份源码识别一遍。旁表是**单张**的，键是 (父组, 下标)：重复识别同一份源码是幂等的
//（同键覆盖），不同源码的条目也能共存（父组引用里带段号，天然不冲突）。
#proc meta_recognize_source(%source: #bits<64>) -> #bits<32> {
  %seg = #call ast_segment_of_source(%source)
  %scratch = #call lain_meta_scratch_data()
  %segw = #call meta_cell_put(#lea(%scratch, 1524, 1, 0), %seg)
  %secw = #call meta_cell_put(#lea(%scratch, 1532, 1, 0), 0)
  %base = #call lain_meta_source_data(%source)
  %len = #call lain_meta_source_length(%source)
  %root = #call meta_root_of(%source)
  // root 缺席 = 这份源码被 reader 拒了（AstIn 段不活、Arena 一个字节都没发布）。
  %none = #eq[#bits<64>](%root, 0)
  %st = #if %none -> (#bits<32>) {
    #yield 0
  } else {
    // **不要清表**：单张旁表 + 「谁在用就重新识别谁」的组合下，清表会把上一层已经
    // 建好的条目（例如 prelude 的 scalar 声明）**全部抹掉**。实测：setup 扫 prelude
    // 后表里有 8 条，但降级前重新识别主源码时清表，最终只剩主源码的 2 条。
    // **根不进旁表**：它的形状属于「顶层形式序列」这个位置，而根自己不是任何父组的
    // 孩子 —— 没有游标指向它，也就没有键可写。旧实现记 (root, 0) 是为了让
    // `meta_node_next(root)` 回 NONE，那条路已经不存在了；真写了反而会与
    // 「root 的第 0 个孩子」这条条目**撞键**（同一个 (root, 0)）。
    %r = #call meta_recognize_all(%base, %len, %root)
    #yield %r
  }
  #return %st
}

// 在 %group 的子树里找 text 起点等于 %at 的那个**出现位置**。
//
// 命中：把它的**父组**写进暂存区固定格 +2400，返回它在那个父组里的下标。
// 未命中：返回「查不到」（0xFFFFFFFFFFFFFFFF，非引用域），格子不动。
//
// **组也算**：组的 text 起点就是它那个开括号的位置，而那个位置上没有叶子，所以不会
// 和叶子的匹配打架。`(1 + 2) + 3` 的值的第一个节点就是那个组 —— 只认叶子的话查不到它，
// 形状就成了「无」，整段被当成常量走错路。
//
// 遍历只走「当前正在看的组的孩子」，不许跨组：位置由父组与下标给出，返回的也是这两样。
#proc meta_cursor_at(%group: #bits<64>, %at: #bits<64>) -> #bits<64> {
  %count = #call ast_child_count(%group)
  %r = #loop s(%i: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%group, %i)
      %st = #call ast_text_start(%c)
      %same = #eq[#bits<64>](%st, %at)
      #if %same {
        // 命中：把父组记下来（递归向上传播的是下标，父组走格子带出来）。
        %sc = #call lain_meta_scratch_data()
        %pw = #call meta_cell_put(#lea(%sc, 2400, 1, 0), %group)
        #break s(%i)
      }
      %k = #call ast_kind(%c)
      %is_group = #eq[#bits<8>](%k, 2)
      %sub = #if %is_group -> (#bits<64>) {
        %inner = #call meta_cursor_at(%c, %at)
        #yield %inner
      } else {
        #yield 0xFFFFFFFFFFFFFFFF
      }
      %miss = #eq[#bits<64>](%sub, 0xFFFFFFFFFFFFFFFF)
      #if %miss {
        %i2 = #add[#bits<64>](%i, 1)
        #continue s(%i2)
      }
      #break s(%sub)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %r
}

// 暂存区里「上一次 `meta_cursor_at` 命中的父组」那一格。它只在 `meta_cursor_at`
// 返回非「查不到」之后有效，并且必须**紧接着**用掉。
#proc meta_cursor_parent() -> #bits<64> {
  %sc = #call lain_meta_scratch_data()
  %p = #call meta_cell_get(#lea(%sc, 2400, 1, 0))
  #return %p
}

// 从 %at 起头的那个节点的**引用**（找不到回空引用 0）。它由命中位置的父组与下标
// 算出来 —— 「位置 -> 节点」是合法方向（搜索），被禁止的是「节点 -> 唯一父组」。
#proc meta_node_at(%base: #addr, %at: #bits<64>) -> #bits<64> {
  %root = #call meta_root_of_source(%base)
  %missing = #eq[#bits<64>](%root, 0)
  %r = #if %missing -> (#bits<64>) {
    #yield 0
  } else {
    %i = #call meta_cursor_at(%root, %at)
    %none = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
    %v = #if %none -> (#bits<64>) {
      #yield 0
    } else {
      %parent = #call meta_cursor_parent()
      %c = #call ast_child(%parent, %i)
      #yield %c
    }
    #yield %v
  }
  #return %r
}

// 从 %at 起头的那个节点的形状（读语义旁表，键是命中位置的父组与下标）。
// 找不到回「查不到」。
#proc meta_form_at(%base: #addr, %at: #bits<64>) -> #bits<64> {
  %root = #call meta_root_of_source(%base)
  %missing = #eq[#bits<64>](%root, 0)
  %v = #if %missing -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %i = #call meta_cursor_at(%root, %at)
    %none = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
    %w = #if %none -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %parent = #call meta_cursor_parent()
      %f = #call meta_sem_lookup(%parent, %i)
      #yield %f
    }
    #yield %w
  }
  #return %v
}

// 位置 -> 出现位置（父组走暂存区 +2400 格子，返回下标）；找不到回「查不到」。
// 调用方必须在**紧接着**的语句里用掉那一格（`meta_cursor_parent`）。
#proc meta_cursor_of_at(%base: #addr, %at: #bits<64>) -> #bits<64> {
  %root = #call meta_root_of_source(%base)
  %missing = #eq[#bits<64>](%root, 0)
  %v = #if %missing -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %i = #call meta_cursor_at(%root, %at)
    #yield %i
  }
  #return %v
}

// 位置 -> **同一个父组里的下一个孩子**（空引用 0 = 到头）。
//
// 这是「位置 -> 位置」的查询：先按字节起点定位那个出现位置（父组 + 下标），再取
// 父组的下一项。全程**不碰节点引用**，也不假设某个引用唯一确定父组或后继 ——
// 那些正是规范 §2.1 禁止的东西。给「手里只有字节位置、没有游标」的调用点用
//（顶层值那条路按位置走）；已经有游标的循环必须直接推进游标，不要绕这一圈。
#proc meta_next_at(%base: #addr, %at: #bits<64>) -> #bits<64> {
  %i = #call meta_cursor_of_at(%base, %at)
  %none = #eq[#bits<64>](%i, 0xFFFFFFFFFFFFFFFF)
  %v = #if %none -> (#bits<64>) {
    #yield 0
  } else {
    %parent = #call meta_cursor_parent()
    %c = #call meta_cursor_next(%parent, %i)
    #yield %c
  }
  #return %v
}

// 一个组里从下标 %i 开始的**兄弟序列**里有没有算子形状（9）？走到 `;` 为止。
//
// 遍历的是**当前组的兄弟序列**，不是「节点自己的下一个兄弟」——这就是
// 「(当前组, 起始下标)」这对游标存在的理由：同一段连续的兄弟，从中间起步问
// 「后面有没有算子」，答案取决于起点；节点引用本身答不了这个问题。
#proc meta_seq_has_op(%base: #addr, %len: #bits<64>, %group: #bits<64>,
                      %i: #bits<64>) -> #bits<1> {
  %count = #call ast_child_count(%group)
  %r = #loop s(%j: #bits<64> = %i) -> (#bits<1>) {
    %more = #ult[#bits<64>](%j, %count)
    #if %more {
      %c = #call ast_child(%group, %j)
      %k = #call meta_sem_lookup(%group, %j)
      %is_op = #eq[#bits<64>](%k, 9)
      #if %is_op {
        #break s(1)
      }
      %st = #call ast_text_start(%c)
      %b = #call bs_byte_at(%base, %st, %len)
      %is_semi = #eq[#bits<8>](%b, 59)
      #if %is_semi {
        #break s(0)
      }
      %j2 = #add[#bits<64>](%j, 1)
      #continue s(%j2)
    } else {
      #break s(0)
    }
  }
  #return %r
}

// 从 %at 起头的那个节点所在的兄弟序列里有没有算子形状（9）？走到 `;` 为止。
//
// 为什么必须有这个：形状 5/6/10 说的是「这里开始一次调用 / 字段访问 / 构造」，
// **不是**「整个值就是它」。`f(1) + 2` 里 `f` 的形状也是 5，但值是一条链。调用 /
// 字段 / 构造那三条发射器只发那个构造本身，后面剩下的会被**悄悄丢掉** ——
// 真出过：`let main: i32 = f(1) + 2;` 发成 `#return #call f(1)`，验证通过，
// 算出来 2 而不是 4。所以走那三条之前先问这个，有算子就报错，不发。
//
// `;` 是单个词、字节 59。组里面的 `;` 不是兄弟，所以走不到。
#proc meta_value_has_op(%base: #addr, %len: #bits<64>,
                         %at: #bits<64>) -> #bits<1> {
  %root = #call meta_root_of_source(%base)
  %missing = #eq[#bits<64>](%root, 0)
  %r = #if %missing -> (#bits<1>) {
    // 连根都没找到：**按「可能有算子」处理**。宁可走慢一点的表达式发射器，
    // 也不要因为查不到就选「值就是一次调用」那条捷径 —— 它会静默丢掉后面的算子。
    #yield 1
  } else {
    %f = #call meta_seq_has_op_at(%root, %base, %len, %at)
    %unknown = #eq[#bits<64>](%f, 0xFFFFFFFFFFFFFFFF)
    %v = #if %unknown -> (#bits<1>) {
      #yield 1
    } else {
      %zero = #eq[#bits<64>](%f, 0)
      %has = #eq[#bits<1>](%zero, 0)
      #yield %has
    }
    #yield %v
  }
  #return %r
}

// 找到 %at 那个节点所在的组与下标，再问那个序列。%group 是当前正在看的组。
//
// 返回值是**三态**：1 = 有算子，0 = 找到了、序列里没有算子，0xFFFFFFFFFFFFFFFF =
// 这棵子树里没有 %at 那个节点。三态是必需的：递归找节点时「没找到」和「找到但没
// 算子」必须分得开 —— 都回 0 的话，只要目标在**嵌套的组**里（函数体就是一层
// 花括号组），外层循环就会把递归答案丢掉、一路扫到组尾回 0。实测后果：
// `func f() -> i32 { return g(1) + 2; }` 发成 `#return #call g(1)`，
// `+ 2` 被静默丢掉，验证器不报，算出来是 1 而不是 3。
#proc meta_seq_has_op_at(%group: #bits<64>, %base: #addr, %len: #bits<64>,
                          %at: #bits<64>) -> #bits<64> {
  %count = #call ast_child_count(%group)
  %r = #loop s(%i: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%group, %i)
      %st = #call ast_text_start(%c)
      %same = #eq[#bits<64>](%st, %at)
      #if %same {
        %h = #call meta_seq_has_op(%base, %len, %group, %i)
        %hw = #zext[#bits<64>](%h)
        #break s(%hw)
      }
      %k = #call ast_kind(%c)
      %is_group = #eq[#bits<8>](%k, 2)
      #if %is_group {
        %inner = #call meta_seq_has_op_at(%c, %base, %len, %at)
        %none = #eq[#bits<64>](%inner, 0xFFFFFFFFFFFFFFFF)
        %found = #eq[#bits<1>](%none, 0)
        #if %found {
          #break s(%inner)
        }
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %r
}
