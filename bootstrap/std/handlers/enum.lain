// enum 声明处理器。
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern meta_node_is_word(node: u64, base: addr, word: addr, len: u64) -> bool = meta_node_is_word;
extern meta_syntax_ensure(node: u64, context: u64, handler: u64) -> u32 = meta_syntax_ensure;
extern meta_scope_add_decl(base: addr, len: u64, source: u64, level_start: u64, parent: u64, index: u64, kind: u64) -> u32 = meta_scope_add_decl;
extern meta_lower_enum(base: addr, len: u64, kw_at: u64) -> u32 = meta_lower_enum;

func meta_register_enum(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_enum_storage"), 4);
  if hit {
    return meta_syntax_ensure(node, 1, 5);
  }
  return 0;
}

func meta_declare_enum(base: addr, len: u64, source: u64, level: u64, parent: u64, index: u64) -> u32 {
  let s: u32 = meta_scope_add_decl(base, len, source, level, parent, index, 5);
  return s;
}

func meta_lower_decl_enum(base: addr, len: u64, here: u64) -> u32 {
  let s: u32 = meta_lower_enum(base, len, here);
  return s;
}
