// enum 声明处理器。
// 模块：enum 声明处理器。跨单元引用一律写 `别名.名字`。
let std_emit = import("../emit");
let std_parse = import("../parse");
let std_scope = import("../scope");
let std_sums = import("../sums");
let std_syntax = import("../syntax");

extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;

func meta_register_enum(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = std_parse.meta_node_is_word(node, dummy, std_emit.meta_kw_enum, 4);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 1, 5);
  }
  return 0;
}

func meta_declare_enum(base: addr, len: u64, source: u64, level: u64, parent: u64, index: u64) -> u32 {
  let s: u32 = std_scope.meta_scope_add_decl(base, len, source, level, parent, index, 5);
  return s;
}

func meta_lower_decl_enum(base: addr, len: u64, here: u64) -> u32 {
  let s: u32 = std_sums.meta_lower_enum(base, len, here);
  return s;
}
