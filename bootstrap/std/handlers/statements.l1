// 尚未拆出完整 declare/lower 对象的核心语句，也各自拥有名字登记钩子。
#proc meta_register_return(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_return, 6)
  %s = #if %hit -> (#bits<32>) {
    %r = #call meta_syntax_ensure(%node, 2, 8)
    #yield %r
  } else { #yield 0 }
  #return %s
}

#proc meta_register_for(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
