    %r = #call meta_syntax_ensure(%node, 2, 10)
    #yield %r
  } else { #yield 0 }
  #return %s
}

#proc meta_register_loop(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_loop, 4)
  %s = #if %hit -> (#bits<32>) {
    %r = #call meta_syntax_ensure(%node, 2, 13)
    #yield %r
  } else { #yield 0 }
  #return %s
}
