// scalar 声明处理器。它能进入模块符号表，不能在当前编译单元直接 Lowering。
#proc meta_register_scalar(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_scalar, 6)
  %s = #if %hit -> (#bits<32>) {
    %r = #call meta_syntax_ensure(%node, 1, 6)
    #yield %r
  } else { #yield 0 }
  #return %s
}
#proc meta_declare_scalar(%base: #addr, %len: #bits<64>,
                          %source: #bits<64>, %level: #bits<64>,
                          %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %s = #call meta_scope_add_scalar(%base, %len, %source, %level,
                                    %parent, %index)
  #return %s
}
#proc meta_lower_decl_scalar() -> #bits<32> {
  %f = #call lain_meta_fail(14)
  #return 14
}
