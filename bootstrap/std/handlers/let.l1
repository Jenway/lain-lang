// 顶层 let 声明处理器。
#proc meta_register_let(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_let, 3)
  #if #eq[#bits<1>](%hit, 0) { #return 0 }
  %decl = #call meta_syntax_ensure(%node, 1, 7)
  #if #ne[#bits<32>](%decl, 0) { #return %decl }
  %stmt = #call meta_syntax_ensure(%node, 2, 9)
  #return %stmt
}
#proc meta_declare_let(%base: #addr, %len: #bits<64>,
                       %source: #bits<64>, %level: #bits<64>,
                       %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %s = #call meta_scope_add_let(%base, %len, %source, %level,
                                 %parent, %index)
  #return %s
}
#proc meta_lower_decl_let(%base: #addr, %len: #bits<64>,
                          %here: #bits<64>) -> #bits<32> {
  %s = #call meta_lower_let(%base, %len, %here)
  #return %s
}
