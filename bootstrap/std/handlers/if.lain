// if 语句处理器的孩子上下文适配器。
// 返回值低 63 位是本次消费/写入的兄弟数；最高位表示孩子发生变化。
// 形状不完整时消费 1，让后续 recognize/lower 按既有诊断路径处理；递归失败返回 0。
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern meta_node_is_word(node: u64, base: addr, word: addr, len: u64) -> bool = meta_node_is_word;
extern meta_syntax_ensure(node: u64, context: u64, handler: u64) -> u32 = meta_syntax_ensure;
extern ast_child(node: u64, index: u64) -> u64 = ast_child;
extern ast_delim(node: u64) -> u8 = ast_delim;
extern meta_expand_stmt_group(group: u64) -> u64 = meta_expand_stmt_group;
extern meta_expand_store_ref(buffer: addr, index: u64, value: u64) -> u32 = meta_expand_store_ref;

func meta_register_if(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_if_storage"), 2);
  if hit { return meta_syntax_ensure(node, 2, 3); }
  return 0;
}

// if 的第 2 个相对孩子是真分支，第 4 个是 else 分支；两者都是 STMT。
func meta_recognize_child_context_if(relative: u64) -> u64 {
  let then_body: bool = relative == 2;
  let else_body: bool = relative == 4;
  let body: bool = then_body or else_body;
  let context: u64 = if body { 2 } else { 0 };
  return context;
}

func meta_expand_children_if(group: u64, cursor: u64, count: u64, buffer: addr, outn: u64) -> u64 {
  let fit: u64 = cursor + 3;
  let room: bool = fit <= count;
  let node: u64 = ast_child(group, cursor);
  if room == 0 {
    let fallback0: u32 = meta_expand_store_ref(buffer, outn, node);
    return 1;
  }
  let cond_i: u64 = cursor + 1;
  let cond: u64 = ast_child(group, cond_i);
  let body_i: u64 = cursor + 2;
  let body: u64 = ast_child(group, body_i);
  let delimiter: u8 = ast_delim(body);
  let delimiter_wide: u32 = delimiter as u32;
  if delimiter_wide != 123 {
    let fallback1: u32 = meta_expand_store_ref(buffer, outn, node);
    return 1;
  }
  let new_body: u64 = meta_expand_stmt_group(body);
  if new_body == 0 { return 0; }
  let p0: u32 = meta_expand_store_ref(buffer, outn, node);
  let p1: u32 = meta_expand_store_ref(buffer, outn + 1, cond);
  let p2: u32 = meta_expand_store_ref(buffer, outn + 2, new_body);

  // 旧 IR 的 %else_hit 只在 has_after 成立时求值，否则为 0；这里用同样的守卫形状。
  let after_i: u64 = cursor + 3;
  let has_after: bool = after_i < count;
  if has_after {
    let after: u64 = ast_child(group, after_i);
    let base: addr = lain_meta_source_data(0);
    let else_kw: addr = symbol_addr("meta_kw_else_storage");
    let else_hit: bool = meta_node_is_word(after, base, else_kw, 4);
    if else_hit {
      let else_end: u64 = cursor + 5;
      let else_room: bool = else_end <= count;
      if else_room {
        let else_word: u64 = ast_child(group, after_i);
        let else_i: u64 = cursor + 4;
        let else_body: u64 = ast_child(group, else_i);
        let else_delim: u8 = ast_delim(else_body);
        let else_delim_wide: u32 = else_delim as u32;
        if else_delim_wide == 123 {
          let new_else: u64 = meta_expand_stmt_group(else_body);
          if new_else == 0 { return 0; }
          let p3: u32 = meta_expand_store_ref(buffer, outn + 3, else_word);
          let p4: u32 = meta_expand_store_ref(buffer, outn + 4, new_else);
          let c0: bool = new_body != body;
          let c1: bool = new_else != else_body;
          let changed: bool = c0 or c1;
          let flag: u64 = if changed { 0x8000000000000000 } else { 0 };
          // flag 只可能是 0 或 bit 63，与低位数不重叠，因此加法等价于旧 IR 的 or。
          return flag + 5;
        }
      }
    }
  }
  let changed3: bool = new_body != body;
  let flag3: u64 = if changed3 { 0x8000000000000000 } else { 0 };
  return flag3 + 3;
}
