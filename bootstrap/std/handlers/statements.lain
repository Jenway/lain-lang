// 尚未拆出完整 declare/lower 对象的核心语句，也各自拥有名字登记钩子。
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern meta_node_is_word(node: u64, base: addr, word: addr, len: u64) -> bool = meta_node_is_word;
extern meta_syntax_ensure(node: u64, context: u64, handler: u64) -> u32 = meta_syntax_ensure;

func meta_register_return(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_return_storage"), 6);
  if hit {
    return meta_syntax_ensure(node, 2, 8);
  }
  return 0;
}

func meta_register_for(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_for_storage"), 3);
  if hit {
    return meta_syntax_ensure(node, 2, 10);
  }
  return 0;
}

func meta_register_loop(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_loop_storage"), 4);
  if hit {
    return meta_syntax_ensure(node, 2, 13);
  }
  return 0;
}
