// 尚未拆出完整 declare/lower 对象的核心语句，也各自拥有名字登记钩子。
// 模块：核心语句（return/for/loop）处理器。跨单元引用一律写 `别名.名字`。
let std_lex = import("../lex");
let std_parse = import("../parse");
let std_syntax = import("../syntax");

extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;

func meta_register_return(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = std_parse.meta_node_is_word(node, dummy, std_lex.meta_kw_return, 6);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 2, 8);
  }
  return 0;
}

func meta_register_for(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = std_parse.meta_node_is_word(node, dummy, std_lex.meta_kw_for, 3);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 2, 10);
  }
  return 0;
}

func meta_register_loop(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = std_parse.meta_node_is_word(node, dummy, std_lex.meta_kw_loop, 4);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 2, 13);
  }
  return 0;
}
