// func 声明处理器。
#proc meta_register_func(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_func, 4)
  %s = #if %hit -> (#bits<32>) {
    %r = #call meta_syntax_ensure(%node, 1, 2)
    #yield %r
  } else { #yield 0 }
  #return %s
}
#proc meta_declare_func(%base: #addr, %len: #bits<64>,
                        %source: #bits<64>, %level: #bits<64>,
                        %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %s = #call meta_scope_add_decl(%base, %len, %source, %level,
                                  %parent, %index, 6)
  #return %s
}
#proc meta_lower_decl_func(%base: #addr, %len: #bits<64>,
                           %parent: #bits<64>, %index: #bits<64>,
                           %node: #bits<64>) -> #bits<32> {
  %s = #call meta_lower_func(%base, %len, %parent, %index, %node)
  #return %s
}

// recognize 的孩子上下文也由 func 拥有：只有相对下标 5 的函数体是 STMT。
#proc meta_recognize_child_context_func(%relative: #bits<64>) -> #bits<64> {
  %body = #eq[#bits<64>](%relative, 5)
  %context = #if %body -> (#bits<64>) { #yield 2 } else { #yield 0 }
  #return %context
}

// func 声明的孩子上下文适配器。表面布局由本处理器拥有：第 5 个相对孩子是
// statement Group。返回约定与 if 适配器相同。
#proc meta_expand_children_func(%root: #bits<64>, %cursor: #bits<64>,
                                %count: #bits<64>, %buffer: #addr,
                                %outn: #bits<64>) -> #bits<64> {
  %end = #add[#bits<64>](%cursor, 6)
  %room = #ule[#bits<64>](%end, %count)
  #if #eq[#bits<1>](%room, 0) {
    %node0 = #call ast_child(%root, %cursor)
    %fallback0 = #call meta_expand_store_ref(%buffer, %outn, %node0)
    #return 1
  }
  %body_i = #add[#bits<64>](%cursor, 5)
  %body = #call ast_child(%root, %body_i)
  %delimiter = #call ast_delim(%body)
  #if #ne[#bits<8>](%delimiter, 123) {
    %node1 = #call ast_child(%root, %cursor)
    %fallback1 = #call meta_expand_store_ref(%buffer, %outn, %node1)
    #return 1
  }
  // 声明阶段只保留函数体引用；全部声明登记之后才展开函数体。
  %phase = #call meta_cell_get(#data_addr meta_expand_decl_phase)
  %new_body = #if #ne[#bits<64>](%phase, 0) -> (#bits<64>) {
    #yield %body
  } else {
    %expanded = #call meta_expand_stmt_group(%body)
    #yield %expanded
  }
  #if #eq[#bits<64>](%new_body, 0) { #return 0 }
  %copied = #loop form(%j: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%j, 6)
    #if %more {
      %at = #add[#bits<64>](%cursor, %j)
      %old = #call ast_child(%root, %at)
      %body_slot = #eq[#bits<64>](%j, 5)
      %value = #if %body_slot -> (#bits<64>) { #yield %new_body }
               else { #yield %old }
      %put = #call meta_expand_store_ref(%buffer,
                   #add[#bits<64>](%outn, %j), %value)
      #continue form(#add[#bits<64>](%j, 1))
    } else { #break form(1) }
  }
  %changed = #ne[#bits<64>](%new_body, %body)
  %flag = #if %changed -> (#bits<64>) { #yield 0x8000000000000000 }
          else { #yield 0 }
  #return #or[#bits<64>](%flag, 6)
}
