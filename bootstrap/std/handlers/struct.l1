// struct 声明处理器：拥有符号登记种类与最终 Lowering 入口。
#proc meta_register_struct(%node: #bits<64>) -> #bits<32> {
  %dummy = #call lain_meta_source_data(0)
  %hit = #call meta_node_is_word(%node, %dummy, #data_addr meta_kw_struct, 6)
  %s = #if %hit -> (#bits<32>) {
    %r = #call meta_syntax_ensure(%node, 1, 4)
    #yield %r
  } else { #yield 0 }
  #return %s
}
#proc meta_declare_struct(%base: #addr, %len: #bits<64>,
                          %source: #bits<64>, %level: #bits<64>,
                          %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %s = #call meta_scope_add_decl(%base, %len, %source, %level,
                                  %parent, %index, 4)
  #return %s
}
#proc meta_lower_decl_struct(%base: #addr, %len: #bits<64>,
                             %here: #bits<64>) -> #bits<32> {
  %s = #call meta_lower_struct(%base, %len, %here)
  #return %s
}
