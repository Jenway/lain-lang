// let 声明处理器 —— 由 bootstrapl1/std/handlers/let.l1 翻译成 Lain 表面语法。
// 三种落法：静态字节块（字符串字面量）、定长同质表、普通绑定。
// 旧 IR 里「支里再套值 if」的地方改写成逐条守卫 + continue/break（表面语言的值 if
// 支前缀只认 let / store，不能写 if），语义逐条对应。
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern lain_meta_fail(code: u32) -> u32 = lain_meta_fail;
extern meta_node_is_word(node: u64, base: addr, word: addr, len: u64) -> bool = meta_node_is_word;
extern meta_syntax_ensure(node: u64, context: u64, handler: u64) -> u32 = meta_syntax_ensure;
extern meta_scope_add_let(base: addr, len: u64, source: u64, level_start: u64, parent: u64, index: u64) -> u32 = meta_scope_add_let;
extern meta_lower_let(base: addr, len: u64, let_at: u64) -> u32 = meta_lower_let;
extern meta_node_child(node: u64) -> u64 = meta_node_child;
extern meta_node_start(node: u64) -> u64 = meta_node_start;
extern meta_node_len(node: u64) -> u64 = meta_node_len;
extern meta_node_at(base: addr, at: u64) -> u64 = meta_node_at;
extern meta_type_resolve(base: addr, len: u64, t_lo: u64, t_hi: u64) -> u64 = meta_type_resolve;
extern meta_tid_repr(id: u64) -> u64 = meta_tid_repr;
extern meta_is_int_literal(base: addr, lo: u64, hi: u64, len: u64) -> bool = meta_is_int_literal;
// `ref` 是表面语言的保留字，做不了参数名，这里改名 ref_v（链接名不变）。
extern meta_literal_fits(base: addr, len: u64, ref_v: u64, lo: u64, hi: u64, kind: u64, width: u64) -> u32 = meta_literal_fits;
extern ast_child(node: u64, index: u64) -> u64 = ast_child;
extern ast_child_count(node: u64) -> u64 = ast_child_count;
extern ast_delim(node: u64) -> u8 = ast_delim;
extern ast_kind(node: u64) -> u8 = ast_kind;
extern bs_byte_at(base: addr, at: u64, len: u64) -> u8 = bs_byte_at;
extern bs_is_byte(base: addr, i: u64, c: u8) -> bool = bs_is_byte;
extern bs_match_keyword(base: addr, at: u64, len: u64, kw: addr, kw_len: u64) -> bool = bs_match_keyword;
extern bs_read_uint(base: addr, start: u64, len: u64) -> u64 = bs_read_uint;
extern bs_skip_space(base: addr, start: u64, len: u64) -> u64 = bs_skip_space;
extern lainir_data_head() -> u32 = lainir_data_head;
extern lainir_data_ro_head() -> u32 = lainir_data_ro_head;
extern lainir_data_rw_bare_head() -> u32 = lainir_data_rw_bare_head;
extern lainir_data_close() -> u32 = lainir_data_close;
extern lainir_write(text: addr, length: u64) -> u32 = lainir_write;
extern lainir_emit_uint(v: u64) -> u32 = lainir_emit_uint;
extern lainir_space_write() -> u32 = lainir_space_write;

// 顶层 let 声明处理器。
func meta_register_let(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_let_storage"), 3);
  if hit == 0 { return 0; }
  let decl: u32 = meta_syntax_ensure(node, 1, 7);
  if decl != 0 { return decl; }
  let stmt: u32 = meta_syntax_ensure(node, 2, 9);
  return stmt;
}

func meta_declare_let(base: addr, len: u64, source: u64, level: u64, parent: u64, index: u64) -> u32 {
  let s: u32 = meta_scope_add_let(base, len, source, level, parent, index);
  return s;
}

func meta_lower_decl_let(base: addr, len: u64, here: u64) -> u32 {
  let s: u32 = meta_lower_let(base, len, here);
  return s;
}

// let NAME: addr = "…";：静态字节块的顶层绑定。字节串是 ro 的字节表简写。
//   data NAME_storage ro { <字节…> }
//   #proc NAME() -> #addr { %base = #data_addr NAME_storage; #return %base }
// 字节按源码原样搬（reader 认转义对，但不解码），不补末尾 0 —— 需要结束符的块
// 用 let NAME: ro [u8] = [ … , 0 ]; 写成表。
func meta_lower_static_bytes(base: addr, len: u64, name_lo: u64, name_hi: u64, at: u64) -> u32 {
  let name_at: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  let w1: u32 = lainir_data_head();
  let w2: u32 = lainir_write(name_at, name_len);
  let w3: u32 = lainir_data_ro_head();
  let first: u64 = at + 1;
  let scan: u32 = loop b(i: u64 = first) {
    let inside: bool = i < len;
    if inside == 0 {
      let f0: u32 = lain_meta_fail(4);
      break b(4);
    }
    let c: u8 = bs_byte_at(base, i, len);
    let cw: u32 = c as u32;
    let is_q: bool = cw == 34;
    if is_q { break b(0); }
    let cv: u64 = c as u64;
    let w5: u32 = lainir_emit_uint(cv);
    let w6: u32 = lainir_space_write();
    let is_esc: bool = cw == 92;
    // 旧 IR 的 %nxt 值 if：esc 前进 2（转义对整对原样搬），否则 1。
    if is_esc {
      let esc_at: u64 = i + 1;
      let c2: u8 = bs_byte_at(base, esc_at, len);
      let c2v: u64 = c2 as u64;
      let w7: u32 = lainir_emit_uint(c2v);
      let w8: u32 = lainir_space_write();
      continue b(i + 2);
    }
    continue b(i + 1);
  };
  let bad: bool = scan != 0;
  if bad {
    return scan;
  }
  let wc: u32 = lainir_data_close();
  return 0;
}

// ===== 定长同质表 =====
//
// let NAME: [T] = [ … ];      默认 rw
// let NAME: ro [T] = [ … ];   ro
//
//   data NAME_storage rw|ro { <每元素按小端拆成字节、十进制、空格分隔> }
//   #proc NAME() -> #addr { %base = #data_addr NAME_storage; #return %base }
//
// 元素必须是整数字面量，装不下 T 报 23；T 只认标量表里有的标量（repr kind 0）。
// 元素个数与每个元素的字节数记在作用域条目的 aux 与 emitted 上（见
// std/scope.l1 的 meta_scope_add_let），索引与 len 查表即得。

// 类型标注组 [T] 里那个 T 的类型 id；解析不出来回 0。
func meta_table_elt_tid(base: addr, len: u64, ann: u64) -> u64 {
  let tn: u64 = meta_node_child(ann);
  let t_lo: u64 = meta_node_start(tn);
  let t_len: u64 = meta_node_len(tn);
  let t_hi: u64 = t_lo + t_len;
  let tid: u64 = meta_type_resolve(base, len, t_lo, t_hi);
  return tid;
}

// 表标注 `[T]` / `ro [T]`（父组上从 from 扫到 eq_i）里 T 的每元素字节数；
// 找不到、或 T 不是标量表里有的标量，回 0。
// 旧 IR 把「命中就取值、否则下一个孩子」写成嵌套值 if；这里等价地写成守卫。
func meta_table_elt_esz(base: addr, len: u64, parent: u64, from: u64, eq_i: u64) -> u64 {
  let esz: u64 = loop scan(j: u64 = from) {
    let more: bool = j < eq_i;
    if more == 0 { break scan(0); }
    let c: u64 = ast_child(parent, j);
    let k: u8 = ast_kind(c);
    let kw: u32 = k as u32;
    let is_g: bool = kw == 2;
    if is_g == 0 { continue scan(j + 1); }
    let c_d: u8 = ast_delim(c);
    let c_dw: u32 = c_d as u32;
    let is_b: bool = c_dw == 91;
    if is_b == 0 { continue scan(j + 1); }
    let tid: u64 = meta_table_elt_tid(base, len, c);
    if tid == 0 { continue scan(j + 1); }
    let info: u64 = meta_tid_repr(tid);
    let w: u64 = (info >> 8) and 255;
    let e: u64 = w >> 3;
    let hit: bool = e != 0;
    if hit { break scan(e); }
    continue scan(j + 1);
  };
  return esz;
}

// 表字面量的元素个数：组的孩子里除逗号以外的都算一个元素。
func meta_table_count(base: addr, len: u64, grp: u64) -> u64 {
  let count: u64 = ast_child_count(grp);
  let n: u64 = loop elts(i: u64 = 0, acc: u64 = 0) {
    let more: bool = i < count;
    if more {
      let c: u64 = ast_child(grp, i);
      let c_lo: u64 = meta_node_start(c);
      let b: u8 = bs_byte_at(base, c_lo, len);
      let bw: u32 = b as u32;
      let is_comma: bool = bw == 44;
      // 旧 IR 的 %acc2 值 if：逗号不加，别的加一。
      if is_comma {
        continue elts(i + 1, acc);
      }
      continue elts(i + 1, acc + 1);
    } else {
      break elts(acc);
    }
  };
  return n;
}

// 本过程只负责发 data 块与取址过程；返回的 `%count`（元素个数）与 `%esz`
//（元素字节数）由调用方 meta_lower_binding 写进作用域条目。
func meta_lower_table(base: addr, len: u64, name_lo: u64, name_hi: u64, colon_at: u64) -> u32 {
  let name_at: addr = base + name_lo;
  let name_len: u64 = name_hi - name_lo;
  // 标注起点：`:` 之后跳过空白；`ro` 两个字节，再跳一次空白。
  let after: u64 = colon_at + 1;
  let p0: u64 = bs_skip_space(base, after, len);
  let is_ro: bool = bs_match_keyword(base, p0, len, symbol_addr("meta_kw_ro_storage"), 2);
  let ro_next: u64 = p0 + 2;
  let ann_at: u64 = if is_ro { bs_skip_space(base, ro_next, len) } else { p0 };
  let ann: u64 = meta_node_at(base, ann_at);
  let a_lo: u64 = meta_node_start(ann);
  let a_len: u64 = meta_node_len(ann);
  let a_hi: u64 = a_lo + a_len;
  let tid: u64 = meta_table_elt_tid(base, len, ann);
  let unknown: bool = tid == 0;
  if unknown {
    let f0: u32 = lain_meta_fail(5);
    return 5;
  }
  let info: u64 = meta_tid_repr(tid);
  let kind: u64 = info and 255;
  let info_hi: u64 = info >> 8;
  let width: u64 = info_hi and 255;
  let isbits: bool = kind == 0;
  if isbits == 0 {
    let f1: u32 = lain_meta_fail(5);
    return 5;
  }
  let esz: u64 = width >> 3;
  // 值组：`=` 之后那个以 `[` 开头的组。
  let eq_at: u64 = bs_skip_space(base, a_hi, len);
  let is_eq: bool = bs_is_byte(base, eq_at, 61);
  if is_eq == 0 {
    let f2: u32 = lain_meta_fail(4);
    return 4;
  }
  let eq_next: u64 = eq_at + 1;
  let v_lo: u64 = bs_skip_space(base, eq_next, len);
  let v: u64 = meta_node_at(base, v_lo);
  let v_delim: u8 = ast_delim(v);
  let v_dw: u32 = v_delim as u32;
  let is_table: bool = v_dw == 91;
  if is_table == 0 {
    let f3: u32 = lain_meta_fail(4);
    return 4;
  }
  let w1: u32 = lainir_data_head();
  let w2: u32 = lainir_write(name_at, name_len);
  let w3: u32 = if is_ro { lainir_data_ro_head() } else { lainir_data_rw_bare_head() };
  let count: u64 = ast_child_count(v);
  let st: u32 = loop elts(i: u64 = 0) {
    let more: bool = i < count;
    if more == 0 { break elts(0); }
    let c: u64 = ast_child(v, i);
    let c_lo: u64 = meta_node_start(c);
    let c_len: u64 = meta_node_len(c);
    let c_hi: u64 = c_lo + c_len;
    let b0: u8 = bs_byte_at(base, c_lo, len);
    let b0w: u32 = b0 as u32;
    let is_comma: bool = b0w == 44;
    // 逗号不是元素；旧 IR 的 %one 值 if 在这里就是「跳过」。
    if is_comma { continue elts(i + 1); }
    let lit: bool = meta_is_int_literal(base, c_lo, c_hi, len);
    if lit == 0 {
      let f4: u32 = lain_meta_fail(4);
      break elts(4);
    }
    let fits: u32 = meta_literal_fits(base, len, 0xFFFFFFFFFFFFFFFF, c_lo, c_hi, kind, width);
    if fits != 0 { break elts(fits); }
    let val: u64 = bs_read_uint(base, c_lo, len);
    let bs: u32 = loop splits(j: u64 = 0) {
      let jmore: bool = j < esz;
      if jmore {
        let sh: u64 = j * 8;
        let sv: u64 = val >> sh;
        let byte: u64 = sv and 255;
        let wm: u32 = lainir_emit_uint(byte);
        let wn: u32 = lainir_space_write();
        continue splits(j + 1);
      } else {
        break splits(0);
      }
    };
    if bs != 0 { break elts(bs); }
    continue elts(i + 1);
  };
  let bad: bool = st != 0;
  if bad {
    return st;
  }
  let wc: u32 = lainir_data_close();
  return 0;
}
