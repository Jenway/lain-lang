// 模块：struct 声明处理器。跨单元引用一律写 `别名.名字`。
let meta = import("../../meta");
let std_emit = import("../emit");
let std_parse = import("../parse");
let std_scope = import("../scope");
let std_syntax = import("../syntax");

func meta_register_struct(node: u64) -> u32 {
  let hit: bool = std_parse.meta_node_is_word(node, std_emit.meta_kw_struct, 6);
  if hit {
    return std_syntax.meta_syntax_ensure(node, 1, 4);
  }
  return 0;
}

func meta_declare_struct(base: addr, len: u64, source: u64, level: u64, parent: u64, index: u64) -> u32 {
  let s: u32 = std_scope.meta_scope_add_decl(base, len, source, level, parent, index, 4);
  return s;
}

func meta_lower_decl_struct(base: addr, len: u64, here: u64) -> u32 {
  let s: u32 = meta.meta_lower_struct(base, len, here);
  return s;
}
