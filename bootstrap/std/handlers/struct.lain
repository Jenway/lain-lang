// struct 声明处理器：拥有符号登记种类与最终 Lowering 入口。
extern lain_meta_source_data(source: u64) -> addr = lain_meta_source_data;
extern meta_node_is_word(node: u64, base: addr, word: addr, len: u64) -> bool = meta_node_is_word;
extern meta_syntax_ensure(node: u64, context: u64, handler: u64) -> u32 = meta_syntax_ensure;
extern meta_scope_add_decl(base: addr, len: u64, source: u64, level_start: u64, parent: u64, index: u64, kind: u64) -> u32 = meta_scope_add_decl;
extern meta_lower_struct(base: addr, len: u64, kw_at: u64) -> u32 = meta_lower_struct;

func meta_register_struct(node: u64) -> u32 {
  let dummy: addr = lain_meta_source_data(0);
  let hit: bool = meta_node_is_word(node, dummy, symbol_addr("meta_kw_struct_storage"), 6);
  if hit {
    return meta_syntax_ensure(node, 1, 4);
  }
  return 0;
}

func meta_declare_struct(base: addr, len: u64, source: u64, level: u64, parent: u64, index: u64) -> u32 {
  let s: u32 = meta_scope_add_decl(base, len, source, level, parent, index, 4);
  return s;
}

func meta_lower_decl_struct(base: addr, len: u64, here: u64) -> u32 {
  let s: u32 = meta_lower_struct(base, len, here);
  return s;
}
