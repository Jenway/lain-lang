// enum 声明处理器。
#proc meta_declare_enum(%base: #addr, %len: #bits<64>,
                        %source: #bits<64>, %level: #bits<64>,
                        %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %s = #call meta_scope_add_decl(%base, %len, %source, %level,
                                  %parent, %index, 5)
  #return %s
}
#proc meta_lower_decl_enum(%base: #addr, %len: #bits<64>,
                           %here: #bits<64>) -> #bits<32> {
  %s = #call meta_lower_enum(%base, %len, %here)
  #return %s
}
