// 模块：词法辅助。跨单元引用一律写 `别名.名字`（别名 = 被导入单元的模块键）。
let std_types = import("types");

let meta_kw_let: ro [u8] = [108, 101, 116];
let meta_kw_eq: ro [u8] = [61];
let meta_kw_colon: ro [u8] = [58];
let meta_kw_func: ro [u8] = [102, 117, 110, 99];
let meta_kw_return: ro [u8] = [114, 101, 116, 117, 114, 110];
let meta_kw_semi: ro [u8] = [59];
let meta_kw_if: ro [u8] = [105, 102];
let meta_kw_else: ro [u8] = [101, 108, 115, 101];
let meta_kw_and: ro [u8] = [97, 110, 100];
let meta_kw_or: ro [u8] = [111, 114];
let meta_kw_as: ro [u8] = [97, 115];
let meta_kw_for: ro [u8] = [102, 111, 114];
let meta_kw_in: ro [u8] = [105, 110];
let meta_kw_loop: ro [u8] = [108, 111, 111, 112];
let meta_kw_while: ro [u8] = [119, 104, 105, 108, 101];
let meta_kw_break: ro [u8] = [98, 114, 101, 97, 107];
let meta_kw_continue: ro [u8] = [99, 111, 110, 116, 105, 110, 117, 101];
let meta_kw_acc: ro [u8] = [97, 99, 99];
let meta_kw_load: ro [u8] = [108, 111, 97, 100];
let meta_kw_store: ro [u8] = [115, 116, 111, 114, 101];
let meta_kw_lea: ro [u8] = [108, 101, 97];
let meta_kw_len: ro [u8] = [108, 101, 110];
let meta_kw_ro: ro [u8] = [114, 111];
let meta_kw_extern: ro [u8] = [101, 120, 116, 101, 114, 110];
let meta_kw_ptr_of: ro [u8] = [112, 116, 114, 95, 111, 102];
let meta_kw_addr_of: ro [u8] = [97, 100, 100, 114, 95, 111, 102];
let meta_kw_symbol_addr: ro [u8] = [115, 121, 109, 98, 111, 108, 95, 97, 100, 100, 114];
let meta_kw_ref_of: ro [u8] = [114, 101, 102, 95, 111, 102];
let meta_kw_ref: ro [u8] = [114, 101, 102];
let meta_kw_mut: ro [u8] = [109, 117, 116];
let meta_kw_slice: ro [u8] = [115, 108, 105, 99, 101];
let meta_kw_addr: ro [u8] = [97, 100, 100, 114];
let meta_kw_slice_of: ro [u8] = [115, 108, 105, 99, 101, 95, 111, 102];
let meta_bs_storage: ro [u8] = [95, 115, 116, 111, 114, 97, 103, 101];  // "_storage" 8

func bs_is_digit(b: u8) -> bool {
  let w: u32 = b as u32;
  let lo: bool = w >= 48;
  let hi: bool = w <= 57;
  return lo and hi;
}

func bs_is_hex_digit(b: u8) -> bool {
  let d: bool = bs_is_digit(b);
  let w: u32 = b as u32;
  let llo: bool = w >= 97;
  let lhi: bool = w <= 102;
  let lower: bool = llo and lhi;
  let ulo: bool = w >= 65;
  let uhi: bool = w <= 70;
  let upper: bool = ulo and uhi;
  return lower or upper or d;
}

func bs_is_ident(b: u8) -> bool {
  let digit: bool = bs_is_digit(b);
  let w: u32 = b as u32;
  let lower: bool = w >= 97 and w <= 122;
  let upper: bool = w >= 65 and w <= 90;
  let us: bool = w == 95;
  return lower or upper or us or digit;
}

func bs_skip_line(base: addr, from: u64, len: u64) -> u64 {
  return loop scan(i: u64 = from) {
    let more: bool = i < len;
    if more {
      let b: u8 = load(base + i);
      let w: u32 = b as u32;
      if w == 10 { break scan(i + 1); }
      continue scan(i + 1);
    } else { break scan(i); }
  };
}

func bs_skip_block(base: addr, from: u64, len: u64) -> u64 {
  return loop scan(i: u64 = from) {
    let more: bool = i < len;
    if more {
      let b: u8 = bs_byte_at(base, i, len);
      let w: u32 = b as u32;
      if w == 42 {
        let j: u64 = i + 1;
        if j < len {
          let next: u8 = bs_byte_at(base, j, len);
          let nw: u32 = next as u32;
          if nw == 47 { break scan(j + 1); }
        }
      }
      continue scan(i + 1);
    } else { break scan(len + 1); }
  };
}

func bs_skip_space(base: addr, start: u64, len: u64) -> u64 {
  return loop scan(i: u64 = start) {
    let more: bool = i < len;
    if more {
      let b: u8 = load(base + i);
      let w: u32 = b as u32;
      if w <= 32 { continue scan(i + 1); }
      if w == 47 {
        let j: u64 = i + 1;
        let next: u8 = bs_byte_at(base, j, len);
        let nw: u32 = next as u32;
        if nw == 47 {
          let after_line: u64 = bs_skip_line(base, j, len);
          continue scan(after_line);
        }
        if nw == 42 {
          let after_block: u64 = bs_skip_block(base, j + 1, len);
          continue scan(after_block);
        }
      }
      break scan(i);
    } else { break scan(i); }
  };
}

func bs_skip_ident(base: addr, start: u64, len: u64) -> u64 {
  return loop scan(i: u64 = start) {
    if i < len {
      let b: u8 = load(base + i);
      if bs_is_ident(b) { continue scan(i + 1); }
      break scan(i);
    } else { break scan(i); }
  };
}

func bs_read_hex(base: addr, start: u64, len: u64) -> u64 {
  return loop scan(i: u64 = start, v: u64 = 0) {
    if i < len {
      let b: u8 = load(base + i);
      if bs_is_hex_digit(b) {
        let val: u64 = bs_digit_value(b);
        continue scan(i + 1, v * 16 + val);
      } else { break scan(v); }
    } else { break scan(v); }
  };
}

func bs_digit_value(b: u8) -> u64 {
  let d: bool = bs_is_digit(b);
  if d {
    let w: u64 = b as u64;
    return w - 48;
  }
  let h: bool = bs_is_hex_digit(b);
  if h {
    let w: u64 = b as u64;
    let lo: bool = b as u32 >= 97;
    let base: u64 = if lo { 87 } else { 55 };
    return w - base;
  }
  return 0xFFFFFFFFFFFFFFFF;
}

func bs_read_uint(base: addr, start: u64, len: u64) -> u64 {
  let b0: u8 = bs_byte_at(base, start, len);
  let w0: u32 = b0 as u32;
  let is_zero: bool = w0 == 48;
  let b1: u8 = bs_byte_at(base, start + 1, len);
  let w1: u32 = b1 as u32;
  let lx: bool = w1 == 120;
  let ux: bool = w1 == 88;
  let hex: bool = is_zero and (lx or ux);
  if hex { return bs_read_hex(base, start + 2, len); }
  return bs_read_dec(base, start, len);
}

func bs_read_dec(base: addr, start: u64, len: u64) -> u64 {
  return loop scan(i: u64 = start, v: u64 = 0) {
    if i < len {
      let b: u8 = load(base + i);
      if bs_is_digit(b) {
        let w: u64 = b as u64;
        let d: u64 = w - 48;
        continue scan(i + 1, v * 10 + d);
      } else { break scan(v); }
    } else { break scan(v); }
  };
}

func bs_skip_qualified(base: addr, start: u64, len: u64) -> u64 {
  return loop scan(at: u64 = start) {
    let hi: u64 = bs_skip_ident(base, at, len);
    let dot: u64 = bs_skip_space(base, hi, len);
    if bs_is_byte(base, dot, 46) { continue scan(dot + 1); }
    break scan(hi);
  };
}

// 类型名窗口：先按限定名（`M.Point`）扫到名字末尾；不是限定名时再按
// `mut ref T` / `slice T` 这类带空格的写法越过修饰词，窗口覆盖到整段。
func bs_skip_type_name(base: addr, start: u64, len: u64) -> u64 {
  let first: u64 = bs_skip_qualified(base, start, len);
  let at: u64 = bs_skip_space(base, start, len);
  let is_mut: bool = bs_match_keyword(base, at, len, meta_kw_mut, 3);
  let is_ref: bool = bs_match_keyword(base, at, len, meta_kw_ref, 3);
  let is_slice: bool = bs_match_keyword(base, at, len, meta_kw_slice, 5);
  let lead: bool = is_mut or is_ref or is_slice;
  if lead == 0 {
    return first;
  }
  // 窗口要覆盖整段：循环只带一个参数（当前位置），刚刚扫过的那个词的终点留在
  // 循环外面也读得到的位置（暂存 +8），退出时返回它。
  let sc: addr = lain_meta_scratch_data();
  let put: u32 = std_types.meta_cell_put(sc + 16, first);
  let cur0: u64 = loop scan(cur: u64 = start) {
    let here: u64 = bs_skip_space(base, cur, len);
    let n1: u64 = bs_skip_qualified(base, here, len);
    let keep: u32 = std_types.meta_cell_put(sc + 16, n1);
    let n2: u64 = bs_skip_space(base, n1, len);
    let more: bool = bs_is_byte(base, n2, 32);
    if more {
      continue scan(n2 + 1);
    }
    break scan(n1);
  };
  let last: u64 = std_types.meta_cell_get(sc + 16);
  return last;
}

func bs_is_byte(base: addr, i: u64, c: u8) -> bool {
  let b: u8 = load(base + i);
  let bw: u32 = b as u32;
  let cw: u32 = c as u32;
  return bw == cw;
}

func bs_byte_at(base: addr, at: u64, len: u64) -> u8 {
  if at < len { return load(base + at); }
  return 0;
}

func bs_is_operator(base: addr, at: u64, len: u64, n: u64) -> bool {
  let b8: u8 = bs_byte_at(base, at, len);
  let b: u32 = b8 as u32;
  let n1: bool = n == 1;
  let plus: bool = b == 43;
  let minus: bool = b == 45;
  let star: bool = b == 42;
  let slash: bool = b == 47;
  let percent: bool = b == 37;
  let lt: bool = b == 60;
  let gt: bool = b == 62;
  let amp: bool = b == 38;
  let pipe: bool = b == 124;
  let caret: bool = b == 94;
  let punct1: bool = plus or minus or star or slash or percent or lt or gt;
  let punctb: bool = amp or pipe or caret;
  let any1: bool = punct1 or punctb;
  let r1: bool = n1 and any1;
  let n2: bool = n == 2;
  let eqb: bool = b == 61;
  let bangb: bool = b == 33;
  let punct2: bool = eqb or bangb or lt or gt or minus;
  let r2: bool = n2 and punct2;
  let p: addr = base + at;
  let n3: bool = n == 3;
  let andword: bool = std_types.meta_bytes_equal(p, meta_kw_and, 3);
  let orword: bool = std_types.meta_bytes_equal(p, meta_kw_or, 2);
  let asword: bool = std_types.meta_bytes_equal(p, meta_kw_as, 2);
  let r3: bool = n3 and andword;
  let r4: bool = n2 and orword;
  let r5: bool = n2 and asword;
  return r1 or r2 or r3 or r4 or r5;
}

// 每个算子的结合优先级，数值与 `seed/lain0/src/Lexer.cpp` 的 `binaryPrecedence` 一一对应：
// 高的先成值。`as` 不参与（它是类型转换，由发射器单独处理），回 0 表示「不是算子」。
func bs_op_precedence(base: addr, at: u64, len: u64, n: u64) -> u64 {
  let b8: u8 = bs_byte_at(base, at, len);
  let b: u32 = b8 as u32;
  let p: addr = base + at;
  let word_and: bool = n == 3;
  let word_or: bool = n == 2;
  let is_and: bool = word_and and std_types.meta_bytes_equal(p, meta_kw_and, 3);
  let is_or: bool = word_or and std_types.meta_bytes_equal(p, meta_kw_or, 2);
  if is_and { return 2; }
  if is_or { return 1; }
  let n1: bool = n == 1;
  let n2: bool = n == 2;
  // 单字节：`| ^ & < > + - * / %`
  let one: u64 = loop pick_one(v: u64 = 0) {
    if n1 == 0 { break pick_one(0); }
    if b == 124 { break pick_one(3); }
    if b == 94 { break pick_one(4); }
    if b == 38 { break pick_one(5); }
    if b == 60 { break pick_one(7); }
    if b == 62 { break pick_one(7); }
    if b == 43 { break pick_one(9); }
    if b == 45 { break pick_one(9); }
    if b == 42 { break pick_one(10); }
    if b == 47 { break pick_one(10); }
    if b == 37 { break pick_one(10); }
    break pick_one(0);
  };
  if one != 0 { return one; }
  if n2 == 0 { return 0; }
  // 双字节：`==`、`!=` 是 6 级，`<=`、`>=` 是 7 级，`<<`、`>>` 是 8 级。
  let b1: u8 = bs_byte_at(base, at + 1, len);
  let c1: u32 = b1 as u32;
  if b == 61 { return 6; }
  if b == 33 { return 6; }
  if b == 60 {
    let shl: bool = c1 == 60;
    if shl { return 8; }
    return 7;
  }
  if b == 62 {
    let shr: bool = c1 == 62;
    if shr { return 8; }
    return 7;
  }
  return 0;
}

func bs_match_keyword(base: addr, at: u64, len: u64, kw: addr, kw_len: u64) -> bool {
  let need: u64 = at + kw_len;
  if need <= len { return std_types.meta_bytes_equal(base + at, kw, kw_len); }
  return 0;
}

func bs_align_up(v: u64, a: u64) -> u64 {
  if a == 0 { return v; }
  let back: u64 = a - 1;
  let sum: u64 = v + back;
  let q: u64 = sum / a;
  return q * a;
}
