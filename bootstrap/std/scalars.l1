// 初代标准库 v0 —— 标量表、类型名解析、算子解析。
//
// 标量**是表，不是声明**：这份静态字节就是「语言里有那些标量」的唯一出处。
// 源码里没有、也不需要一个 `scalar` 声明语法；`i32` 这类名字是内建名字，
// 由本文件的名字解析直接命中。
//
// 每条记录的布局（表以「名字长度为 0」的一条记录结束）：
//
//   +0        名字长度        +1..        名字
//   +nl+1     类型构造子 0 bits / 1 f / 2 vec / 3 addr
//   +nl+2     宽度（addr 为 0）
//   +nl+3     算子条数
//   之后每条：符号长度、符号、物理名长度、物理名
//
// 宽度那一格与 LAINIR 的类型实参同义。符号 → 物理名是「语言的算子名」到
// 「机器算子名」的唯一一层翻译，`meta_op_resolve` 查的就是它。

// i32  u32  i64  i8  u8  bool  usize  addr
//   3 105 51 50 0 32 3 …
data meta_scalar_table ro { 3 105 51 50 0 32 11 1 47 4 115 100 105 118 1 43 3 97 100 100 1 60 3 115 108 116 1 45 3 115 117 98 1 42 3 109 117 108 1 37 4 115 114 101 109 2 61 61 2 101 113 2 33 61 2 110 101 1 62 3 115 103 116 2 60 61 3 115 108 101 2 62 61 3 115 103 101 3 117 51 50 0 32 11 1 47 4 117 100 105 118 1 43 3 97 100 100 1 60 3 117 108 116 1 45 3 115 117 98 1 42 3 109 117 108 1 37 4 117 114 101 109 2 61 61 2 101 113 2 33 61 2 110 101 1 62 3 117 103 116 2 60 61 3 117 108 101 2 62 61 3 117 103 101 3 105 54 52 0 64 0 2 105 56 0 8 0 2 117 56 0 8 0 4 98 111 111 108 0 1 0 5 117 115 105 122 101 0 64 0 4 97 100 100 114 3 0 0 0 }

// --- 表访问 ---------------------------------------------------------------

// 表里第 off 个字节，零扩展成机器字。表的长度不另存一份：走表的过程自己会在
// 「名字长度为 0」的记录上停，所以这里给一个大上界即可。
#proc meta_scalar_load8(%off: #bits<64>) -> #bits<64> {
  %table = #data_addr meta_scalar_table
  %b = #call bs_byte_at(%table, %off, 0xFFFFFFFFFFFFFFFF)
  %v = #zext[#bits<64>](%b)
  #return %v
}

// 记录的名字长度。0 表示表尾。
#proc meta_scalar_name_len(%rec: #bits<64>) -> #bits<64> {
  %n = #call meta_scalar_load8(%rec)
  #return %n
}

// 记录的名字（指向只读表里的字节，不是拷贝）。
#proc meta_scalar_name(%rec: #bits<64>) -> #addr {
  %table = #data_addr meta_scalar_table
  %at = #add[#bits<64>](%rec, 1)
  %p = #lea(%table, %at, 1, 0)
  #return %p
}

// 记录的 repr，打包成 (kind | width << 8)。
#proc meta_scalar_repr(%rec: #bits<64>) -> #bits<64> {
  %nl = #call meta_scalar_name_len(%rec)
  %kind_at = #add[#bits<64>](%rec, #add[#bits<64>](%nl, 1))
  %kind = #call meta_scalar_load8(%kind_at)
  %width_at = #add[#bits<64>](%kind_at, 1)
  %width = #call meta_scalar_load8(%width_at)
  %packed = #or[#bits<64>](%kind, #shl[#bits<64>](%width, 8))
  #return %packed
}

// 下一条记录的偏移：跳过名字、三格头部和整张算子表。
#proc meta_scalar_next(%rec: #bits<64>) -> #bits<64> {
  %nl = #call meta_scalar_name_len(%rec)
  %after_name = #add[#bits<64>](#add[#bits<64>](%rec, 1), %nl)
  %count_at = #add[#bits<64>](%after_name, 2)
  %count = #call meta_scalar_load8(%count_at)
  %ops = #add[#bits<64>](%after_name, 3)
  %end = #loop o(%k: #bits<64> = %ops, %n: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%n, %count)
    #if %more {
      %sl = #call meta_scalar_load8(%k)
      %after_sym = #add[#bits<64>](%k, #add[#bits<64>](%sl, 1))
      %pl = #call meta_scalar_load8(%after_sym)
      %k2 = #add[#bits<64>](%after_sym, #add[#bits<64>](%pl, 1))
      %n2 = #add[#bits<64>](%n, 1)
      #continue o(%k2, %n2)
    } else {
      #break o(%k)
    }
  }
  #return %end
}

// 按名字找记录；找不到 NOT_FOUND。
#proc meta_scalar_find(%name: #addr, %name_len: #bits<64>) -> #bits<64> {
  %rec = #loop s(%cur: #bits<64> = 0) -> (#bits<64>) {
    %nl = #call meta_scalar_name_len(%cur)
    %end = #eq[#bits<64>](%nl, 0)
    #if %end {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
    %same_len = #eq[#bits<64>](%nl, %name_len)
    %hit = #if %same_len -> (#bits<1>) {
      %p = #call meta_scalar_name(%cur)
      %eq = #call meta_bytes_equal(%p, %name, %name_len)
      #yield %eq
    } else {
      #yield 0
    }
    #if %hit {
      #break s(%cur)
    }
    %next = #call meta_scalar_next(%cur)
    #continue s(%next)
  }
  #return %rec
}

// 在记录的算子表里查符号 sym，回打包的 (物理名偏移 << 16) | 长度。
// 查不到 NOT_FOUND。偏移是**表内**的偏移。
#proc meta_scalar_op(%rec: #bits<64>, %sym: #addr,
                     %sym_len: #bits<64>) -> #bits<64> {
  %nl = #call meta_scalar_name_len(%rec)
  %after_name = #add[#bits<64>](#add[#bits<64>](%rec, 1), %nl)
  %count_at = #add[#bits<64>](%after_name, 2)
  %count = #call meta_scalar_load8(%count_at)
  %ops = #add[#bits<64>](%after_name, 3)
  %found = #loop s(%k: #bits<64> = %ops, %n: #bits<64> = 0) -> (#bits<64>) {
    %more = #ult[#bits<64>](%n, %count)
    #if %more {
      %sl = #call meta_scalar_load8(%k)
      %sym_at = #add[#bits<64>](%k, 1)
      %after_sym = #add[#bits<64>](%sym_at, %sl)
      %pl = #call meta_scalar_load8(%after_sym)
      %phys_at = #add[#bits<64>](%after_sym, 1)
      %same_len = #eq[#bits<64>](%sl, %sym_len)
      %same = #if %same_len -> (#bits<1>) {
        %table = #data_addr meta_scalar_table
        %p = #lea(%table, %sym_at, 1, 0)
        %eq = #call meta_bytes_equal(%p, %sym, %sym_len)
        #yield %eq
      } else {
        #yield 0
      }
      #if %same {
        %packed = #or[#bits<64>](#shl[#bits<64>](%phys_at, 16), %pl)
        #break s(%packed)
      }
      %next = #add[#bits<64>](%phys_at, %pl)
      %n2 = #add[#bits<64>](%n, 1)
      #continue s(%next, %n2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %found
}

// 记录 + 符号 → 物理名。物理名的**表内偏移/长度**写进暂存区 +24 / +32。
// 返回 0 = 成功，NOT_FOUND = 这条记录没有这个符号。
#proc meta_scalar_resolve_op(%rec: #bits<64>, %sym: #addr,
                              %sym_len: #bits<64>) -> #bits<64> {
  %packed = #call meta_scalar_op(%rec, %sym, %sym_len)
  %gone = #eq[#bits<64>](%packed, 0xFFFFFFFFFFFFFFFF)
  %r = #if %gone -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %off = #and[#bits<64>](#lshr[#bits<64>](%packed, 16), 0xFFFF)
    %len = #and[#bits<64>](%packed, 0xFFFF)
    %scratch = #call lain_meta_scratch_data()
    %s1 = #call meta_cell_put(#lea(%scratch, 24, 1, 0), %off)
    %s2 = #call meta_cell_put(#lea(%scratch, 32, 1, 0), %len)
    #yield 0
  }
  #return %r
}

// --- 类型名解析 ------------------------------------------------------------

// 在 [lo, hi) 里找 `.`，返回它的下标；找不到 NOT_FOUND。
//
// 只用来判定「这个名字是不是带点的」：带点的类型名没有解析（标量是内建名字，
// 不存在模块导出的标量），一律按「没有这个名字」处理。
#proc meta_find_dot(%base: #addr, %lo: #bits<64>,
                    %hi: #bits<64>) -> #bits<64> {
  %found = #loop scan(%i: #bits<64> = %lo) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %hi)
    #if %more {
      %is = #call bs_is_byte(%base, %i, 46)
      #if %is {
        #break scan(%i)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue scan(%i2)
    } else {
      #break scan(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %found
}

// 名字 → 内建标量的类型 id（注册表身份）；不是内建标量返回 0。
//
// 身份不是 repr：`i32` 与 `u32` 的 repr 都是 bits/32，让它们不同的是 owner。
// 这里 owner = 0x4000000000000000 | 记录偏移 —— 高位那一段把内建标量与「源码里
// 声明的类型」（owner = ((源码下标 + 1) << 32) | (位置 + 1)）分开。
#proc meta_scalar_type_id(%name: #addr, %name_len: #bits<64>) -> #bits<64> {
  %rec = #call meta_scalar_find(%name, %name_len)
  %miss = #eq[#bits<64>](%rec, 0xFFFFFFFFFFFFFFFF)
  %r = #if %miss -> (#bits<64>) {
    #yield 0
  } else {
    %repr = #call meta_scalar_repr(%rec)
    %rk = #and[#bits<64>](%repr, 255)
    %rw = #and[#bits<64>](#lshr[#bits<64>](%repr, 8), 255)
    %owner = #or[#bits<64>](0x4000000000000000, %rec)
    %id = #call meta_intern(1, %owner, 0, %rk, %rw)
    #yield %id
  }
  #return %r
}

// 名字 → 类型 id。源码里声明的类型（struct/enum）先查；都不中再查内建标量表。
#proc meta_type_id_of_name(%name: #addr,
                            %name_len: #bits<64>) -> #bits<64> {
  %declared = #call meta_scope_type_id(%name, %name_len)
  %have = #ne[#bits<64>](%declared, 0xFFFFFFFFFFFFFFFF)
  %r = #if %have -> (#bits<64>) {
    #yield %declared
  } else {
    %builtin = #call meta_scalar_type_id(%name, %name_len)
    #yield %builtin
  }
  #return %r
}

// 类型名 → 类型 id（供表达式降级）；没有这个名字返回 0。
//
// **带点名字没有解析**：标量是内建名字，不存在「模块导出的标量」，`T.i32`
// 一律按「没有这个名字」处理（调用方报 5）。
#proc meta_type_resolve(%base: #addr, %len: #bits<64>,
                        %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<64> {
  // 诊断：进入次数与最近一次窗口。
  %sce = #call lain_meta_scratch_data()
  %e0 = #call meta_cell_get(#lea(%sce, 392, 1, 0))
  %e1 = #add[#bits<64>](%e0, 1)
  %e2 = #call meta_cell_put(#lea(%sce, 392, 1, 0), %e1)
  %e3 = #call meta_cell_put(#lea(%sce, 400, 1, 0), %t_lo)
  %e4 = #call meta_cell_put(#lea(%sce, 408, 1, 0), %t_hi)
  %dot = #call meta_find_dot(%base, %t_lo, %t_hi)
  %qualified = #ne[#bits<64>](%dot, 0xFFFFFFFFFFFFFFFF)
  %r = #if %qualified -> (#bits<64>) {
    #yield 0
  } else {
    %name = #lea(%base, %t_lo, 1, 0)
    %name_len = #sub[#bits<64>](%t_hi, %t_lo)
    %id = #call meta_type_id_of_name(%name, %name_len)
    %gone = #eq[#bits<64>](%id, 0)
    %v = #if %gone -> (#bits<64>) {
      // 诊断：记下失败的名字窗口与作用域表条数，供驱动在收尾时读出。
      %sc = #call lain_meta_scratch_data()
      %c0 = #call meta_cell_put(#lea(%sc, 264, 1, 0), %t_lo)
      %c1 = #call meta_cell_put(#lea(%sc, 272, 1, 0), %t_hi)
      %cnt = #call meta_scope_count()
      %c2 = #call meta_cell_put(#lea(%sc, 280, 1, 0), %cnt)
      #yield 0
    } else {
      #yield %id
    }
    #yield %v
  }
  #return %r
}

// 类型名 + 算子符号 → 物理算子名。物理名的**表内偏移/长度**写进暂存区
// +24 / +32（+16 不再使用）。返回 0 = 成功，NOT_FOUND = 名字或符号没有。
#proc meta_op_resolve(%base: #addr, %len: #bits<64>,
                       %t_lo: #bits<64>, %t_hi: #bits<64>, %sym: #addr,
                       %sym_len: #bits<64>) -> #bits<64> {
  %dot = #call meta_find_dot(%base, %t_lo, %t_hi)
  %qualified = #ne[#bits<64>](%dot, 0xFFFFFFFFFFFFFFFF)
  %r = #if %qualified -> (#bits<64>) {
    #yield 0xFFFFFFFFFFFFFFFF
  } else {
    %name = #lea(%base, %t_lo, 1, 0)
    %name_len = #sub[#bits<64>](%t_hi, %t_lo)
    %rec = #call meta_scalar_find(%name, %name_len)
    %miss = #eq[#bits<64>](%rec, 0xFFFFFFFFFFFFFFFF)
    %w = #if %miss -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %res = #call meta_scalar_resolve_op(%rec, %sym, %sym_len)
      #yield %res
    }
    #yield %w
  }
  #return %r
}

// 字面量自己的类型（参考经典 C 的字面量规则）：十进制常量取「装得下它的第一个
// 类型」—— 这里是 i32，装不下才 i64。`i8`/`u8`/`bool` **不进候选**。
//
// 只有**两个操作数都是裸字面量**时才走这条路（调用方判的）：有名字操作数时退回
// i32 会把 u32 的 `<` 发成 `slt`，那是静默给错值。
//
// 选中的宽度写进暂存区 +488（调用方要拿它换指令的类型实参）。
#proc meta_op_resolve_default(%base: #addr, %len: #bits<64>,
                              %sym: #addr, %sym_len: #bits<64>,
                              %l_lo: #bits<64>, %l_hi: #bits<64>,
                              %r_lo: #bits<64>, %r_hi: #bits<64>) -> #bits<64> {
  %lv = #call bs_read_uint(%base, %l_lo, %len)
  %rv = #call bs_read_uint(%base, %r_lo, %len)
  %l_big = #ugt[#bits<64>](%lv, 0x7FFFFFFF)
  %r_big = #ugt[#bits<64>](%rv, 0x7FFFFFFF)
  %big = #or[#bits<1>](%l_big, %r_big)
  %r = #if %big -> (#bits<64>) {
    %a64 = #data_addr meta_sym_i64
    %rec64 = #call meta_scalar_find(%a64, 3)
    %m64 = #eq[#bits<64>](%rec64, 0xFFFFFFFFFFFFFFFF)
    %x64 = #if %m64 -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %sc64 = #call lain_meta_scratch_data()
      %w64 = #call meta_cell_put(#lea(%sc64, 488, 1, 0), 64)
      %q64 = #call meta_scalar_resolve_op(%rec64, %sym, %sym_len)
      #yield %q64
    }
    #yield %x64
  } else {
    %a32 = #data_addr meta_sym_i32
    %rec32 = #call meta_scalar_find(%a32, 3)
    %m32 = #eq[#bits<64>](%rec32, 0xFFFFFFFFFFFFFFFF)
    %x32 = #if %m32 -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %sc32 = #call lain_meta_scratch_data()
      %w32 = #call meta_cell_put(#lea(%sc32, 488, 1, 0), 32)
      %q32 = #call meta_scalar_resolve_op(%rec32, %sym, %sym_len)
      #yield %q32
    }
    #yield %x32
  }
  #return %r
}
