// 初代标准库 v0 —— 普通函数：参数、返回类型、函数体、带实参的调用。
//
// 这是「Meta 用 Lain 写」的地基：解析器的每一个组件都是一个**带参数的过程**，
// 没有这一层，语言里连一个解析器都放不下。
//
//   func add(a: i32, b: i32) -> i32 { return a + b; }
//   let main: i32 = add(3, 4);
//   →
//   #proc add(%a: #bits<32>, %b: #bits<32>) -> #bits<32> {
//     %r1 = #add[#bits<32>](%a, %b)
//     #return %r1
//   }
//   #proc main() -> #bits<32> {
//     #return #call add(3, 4)
//   }
//
// 参数名**直接当 LAINIR 的参数名用**：LAINIR 的过程参数是有名字的（`%a: #bits<32>`），
// 所以源码里的 `a` 到产物里还是 `a`，中间不需要槽位表。
//
// 函数体是**语句序列**：
//
//   let NAME : TYPE = <表达式> ;
//   return <表达式> ;
//   NAME = <表达式> ;        （只在 for 里合法，见循环那一节）
//
// 表达式是 `值` 或 `值 算子 值`。算子从**类型自己的 op 表**里查（和顶层 `let`
// 那条路同一个来源）。
//
// v0 的限制（都写在这里，别猜）：
//
//   - **局部变量必须写类型标注。** 不是懒：`%x = 0` 在 LAINIR 里不是合法指令
//     （每个绑定都得来自一条指令），而给一个字面量造绑定需要知道 repr 和 op 表。
//   - **同一个函数体里不能重复绑定同一个名字**（LAINIR 是单赋值的）。所以
//     `let x = a; ... let x = b;` 会被拒（22），而不是悄悄用后一个。
//   - **语句的种类**：`let NAME : TYPE = <值>;`、`return <值>;`、`if <条件> { … }`
//     （可选 `else`）、`let NAME : TYPE = for …`。值可以是字面量、参数/局部名、
//     调用 `f(…)`、以及它们的算子链与括号嵌套（表达式在 `meta_emit_expr` 里
//     按**节点**递归，不再按字节推进）。
//   - **还没做的**：字段访问和构造当值用（`p.left`、`Rec { … }` —— 报 4）；
//     模块成员当操作数或实参（`M.answer + 1`、`f(M.answer)` —— 报 4）。顶层那条
//     `let x: T = M.member;` 是通的（走 modules.l1 的命名空间路径）。
//   - 函数体里的标识符**只按参数表解析**，不走作用域表——参数遮蔽不了外面的同名
//     绑定，而且函数体里本来也没有「外面」。遮蔽要等块级作用域。
//   - 不是参数的标识符会原样发成 `%名字`，被验证器拒（未定义的值）——响的，不是
//     静默给错值。

// 把一个运算数渲染进缓冲区：是十进制数字就写数字，否则写 `%名字`。返回写入长度，
// 非法字面量返回全一值。
#proc meta_render_operand(%base: #addr, %lo: #bits<64>,
                          %hi: #bits<64>, %len: #bits<64>,
                          %out: #addr) -> #bits<64> {
  %b = #call bs_byte_at(%base, %lo, %len)
  %is_num = #call bs_is_digit(%b)
  %st = #if %is_num -> (#bits<64>) {
    // 数字开头不等于读得出值：`0x` 后面没有十六进制数字、`0x10` 这种**整段**都得是
    // 合法字面量。不查的话 `bs_read_uint` 只读出前缀能读的那部分，剩下的悄悄丢掉
    // —— 静默给错值是本仓库禁止的失败方式。
    %oknum = #call meta_is_int_literal(%base, %lo, %hi, %len)
    %w = #if %oknum -> (#bits<64>) {
      %v = #call bs_read_uint(%base, %lo, %len)
      %n = #call lainir_buf_uint(%out, 0, %v)
      #yield %n
    } else {
      %badlit = #call lain_meta_fail(4)
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %w
  } else {
    // 诊断（安全格 2104/2112/2120）：先量出 %lo/%hi/%len 的真实值。
    %esc = #call lain_meta_scratch_data()
    %ew0 = #call meta_cell_put(#lea(%esc, 2104, 1, 0), %lo)
    %ew1 = #call meta_cell_put(#lea(%esc, 2112, 1, 0), %hi)
    %ew2 = #call meta_cell_put(#lea(%esc, 2120, 1, 0), %len)
    // 配对读数：tag（调用点刚写的）+ lo + hi，三者同源同次。
    %etag = #call meta_cell_get_raw(#lea(%esc, 2288, 1, 0))
    %ew6 = #call meta_cell_put(#lea(%esc, 2296, 1, 0), %etag)
    %ew7 = #call meta_cell_put(#lea(%esc, 2304, 1, 0), %lo)
    %ew8 = #call meta_cell_put(#lea(%esc, 2312, 1, 0), %hi)
    // 诊断：记下 %lo 处的首字节与 %n 的有无（判断是「空区间」还是「下溢」）。
    %eb = #call bs_byte_at(%base, %lo, %len)
    %ebw = #zext[#bits<64>](%eb)
    %ew3 = #call meta_cell_put(#lea(%esc, 2144, 1, 0), %ebw)
    %ew4 = #call meta_cell_put(#lea(%esc, 2152, 1, 0), 1)
    %pct = #call lainir_buf_byte(%out, 0, 37)
    %at = #lea(%base, %lo, 1, 0)
    %n = #sub[#bits<64>](%hi, %lo)
    %ew5 = #call meta_cell_put(#lea(%esc, 2160, 1, 0), %n)
    %w2 = #call lainir_buf_bytes(%out, %pct, %at, %n)
    #yield %w2
  }
  #return %st
}

// 发射一个运算数：是十进制数字就发数字，否则发 `%名字`。
#proc meta_emit_operand(%base: #addr, %lo: #bits<64>,
                         %hi: #bits<64>, %len: #bits<64>) -> #bits<32> {
  %out = #data_addr lainir_text_buffer
  %n = #call meta_render_operand(%base, %lo, %hi, %len, %out)
  %bad = #eq[#bits<64>](%n, 0xFFFFFFFFFFFFFFFF)
  %st = #if %bad -> (#bits<32>) {
    #yield 4
  } else {
    %w = #call lainir_write(%out, %n)
    #yield %w
  }
  #return %st
}

// 这条语句的 `;` 在哪。从**同一个父组**的下标 %index 起往后走；找不到回空引用 0。
// 吃游标而不是节点引用：同一段兄弟里从哪起步决定了答案，只有父组答得出来。
#proc meta_find_semi_index(%base: #addr, %parent: #bits<64>,
                      %index: #bits<64>) -> #bits<64> {
  %kw = #data_addr meta_kw_semi
  %count = #call ast_child_count(%parent)
  %found = #loop s(%i: #bits<64> = %index) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%parent, %i)
      %is = #call meta_node_is_word(%c, %base, %kw, 1)
      #if %is {
        #break s(%i)
      }
      %i2 = #add[#bits<64>](%i, 1)
      #continue s(%i2)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %found
}

// 临时值的编号（`%r1`、`%r2`…）。解析早就跑完了，+144 那个单元空着。
#proc meta_next_temp() -> #bits<64> {
  %scratch = #call lain_meta_scratch_data()
  %n = #call meta_cell_get(#lea(%scratch, 144, 1, 0))
  %n2 = #add[#bits<64>](%n, 1)
  %s = #call meta_cell_put(#lea(%scratch, 144, 1, 0), %n2)
  #return %n2
}

// 发射 `#<物理算子>[<repr>](`，物理算子名从暂存区读（meta_op_resolve 填的
// 表内偏移与长度）。
#proc meta_emit_op_mid(%kind: #bits<64>,
                       %width: #bits<64>) -> #bits<32> {
  %w = #call lainir_op_prefix_phys(%kind, %width)
  #return %w
}

// 发射 `#<名字>[<repr>](`，名字是 **#data 的地址**。与 `meta_emit_op_mid` 的区别：
// 那条从暂存区 +24/+32 读标量表内偏移，只给 op 表查出来的算子用；这条给不查表的
// 形态用（`as` 的 zext/trunc/复制）。
#proc meta_emit_op_lit(%name: #addr, %name_len: #bits<64>,
                       %kind: #bits<64>, %width: #bits<64>) -> #bits<32> {
  %w = #call lainir_op_prefix(%name, %name_len, %kind, %width)
  #return %w
}

// 发一个临时值名字 `%r<n>`。
#proc meta_emit_temp_name(%n: #bits<64>) -> #bits<32> {
  %w = #call lainir_temp_name_emit(%n)
  #return %w
}

// `meta_emit_binding_bin` / `meta_emit_binding_const` / `meta_emit_return` /
// `meta_emit_ret_bin` **都删了**：它们是函数体那条"只发**一个**算子"的老路径，现在是
// 整条表达式交给 `meta_emit_expr` + `meta_emit_close`（后者补"没有算子时加零复制"
// 那一格）。单算子的产物与老路径**逐字节相同** —— 60 个用例的对比钉着这一点。

// 实参的**第一趟**：把每个实参降级成一条表达式（`meta_emit_expr`），结果（引用 +
// 源码范围）暂存进缓冲区，**不发任何字节**。之后由调用方写前缀、再调
// `meta_args_write` 写出来。
//
// 为什么要拆成两趟两个 proc：调用那一行的前缀（`  %r<n> = #call f(` 或
// `  #return #call f(`）得写在实参**前面**，而实参里的子表达式要发指令 —— 一趟写下去
// 那些指令会插进这一行中间，出来是坏的。所以顺序只能是
// `prepare` → 写前缀 → `write`。
//
// 还有一个 LAINIR 的限制在这里起作用：调用的实参只能是操作数或**嵌套的 `#call`**，
// 不能是任意表达式。所以 `f(1 + 2)` 必须先把 `1 + 2` 算进一个临时值再当实参。
//
// **块是向分配器要的，不是固定偏移** —— 这是它必须这样做的原因：实参的降级会递归
// （`f(g(1))` 里 `g` 的实参也是降级出来的），内层会把外层那段内存写一遍。实测
// `add3(g(1), g(2), g(3))` 发成 `#call add3(3, %r4, %r5)`：第一个实参成了内层的
// 实参，**验证器不报**，算出来 6（该 9）。
//
// 块布局（水位回退要的东西块自己记着，所以调用方不用传 mark）：
//
//   +0             进来时的水位（`meta_args_write` 用它 release）
//   +8             上一个「当前实参块」偏移（嵌套调用回来时还原）
//   +16            上一个实参个数
//   +24 + i*24     引用（临时值下标，或「无」= 用源码那段）/ 范围起点 / 范围终点
//
// 上限 12 个（24 + 12×24 = 312 字节）—— 超了报 4。整个块要不到就是 17。
#proc meta_args_prepare(%base: #addr, %len: #bits<64>,
                        %kind: #bits<64>, %width: #bits<64>, %t_lo: #bits<64>,
                        %t_hi: #bits<64>, %args: #bits<64>) -> #bits<32> {
  %sc0 = #call lain_meta_scratch_data()
  %oldb = #call meta_cell_get(#lea(%sc0, 216, 1, 0))
  %oldc = #call meta_cell_get(#lea(%sc0, 496, 1, 0))
  %mark = #call meta_bump_mark()
  %blk0 = #call meta_bump_alloc(312)
  %noblk = #eq[#bits<64>](%blk0, 0xFFFFFFFFFFFFFFFF)
  #if %noblk {
    // 分配器已经报过 17
    #return 17
  }
  // 这一层的存档：水位、外层的块、外层数到第几个实参
  %qa = #lea(%sc0, %blk0, 1, 0)
  %h1 = #call meta_cell_put(%qa, %mark)
  %h2 = #call meta_cell_put(#lea(%qa, 8, 1, 0), %oldb)
  %h3 = #call meta_cell_put(#lea(%qa, 16, 1, 0), %oldc)
  // 当前块与计数交给这一层：块偏移从格子里现读，才能支持嵌套
  %cur = #call meta_cell_put(#lea(%sc0, 216, 1, 0), %blk0)
  %z0 = #call meta_cell_put(#lea(%sc0, 496, 1, 0), 0)
  // 第一趟：每个实参降级成一条表达式，存进**这一层**的块。
  // 遍历是**实参组上的游标**：`(args, ai)`，ai 从 0 走到孩子个数。表达式发射器
  // 回来时把「它吃到哪一格」写进 +192（下标），下一轮从那一格之后接。
  %acount = #call ast_child_count(%args)
  %st = #loop a(%ai: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%ai, %acount)
    #if %more {
      %c = #call ast_child(%args, %ai)
      // 空实参（`f(,a)`）跳过去
      %at0 = #call meta_node_start(%c)
      %b0 = #call bs_byte_at(%base, %at0, %len)
      %iscomma0 = #eq[#bits<8>](%b0, 44)
      #if %iscomma0 {
        %ai0 = #add[#bits<64>](%ai, 1)
        #continue a(%ai0)
      }
      %sc = #call lain_meta_scratch_data()
      %n = #call meta_cell_get(#lea(%sc, 496, 1, 0))
      %full = #uge[#bits<64>](%n, 12)
      #if %full {
        %ff = #call lain_meta_fail(4)
        #break a(4)
      }
      %est = #call meta_emit_expr(%base, %len, %kind, %width, %t_lo,
                                  %t_hi, %args, %ai, 0, 0, 0, 0)
      %ebad = #ne[#bits<32>](%est, 0)
      #if %ebad {
        #break a(%est)
      }
      %ref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %lo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %hi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      %endi = #call meta_cell_get(#lea(%sc, 192, 1, 0))
      // 块偏移从格子里现读：循环体只带循环变量，外层局部值不进这一层的作用域
      %blk = #call meta_cell_get(#lea(%sc, 216, 1, 0))
      %off = #mul[#bits<64>](%n, 24)
      %d0 = #add[#bits<64>](%off, 24)
      %slot = #add[#bits<64>](%blk, %d0)
      %q = #lea(%sc, %slot, 1, 0)
      %s1 = #call meta_cell_put(%q, %ref)
      %s2 = #call meta_cell_put(#lea(%q, 8, 1, 0), %lo)
      %s3 = #call meta_cell_put(#lea(%q, 16, 1, 0), %hi)
      %n2 = #add[#bits<64>](%n, 1)
      %s4 = #call meta_cell_put(#lea(%sc, 496, 1, 0), %n2)
      // 下一个实参从终点之后接：终点必须到头、或者正好是 `,`
      %past = #uge[#bits<64>](%endi, %acount)
      #if %past {
        #break a(0)
      }
      %endc = #call ast_child(%args, %endi)
      %en_at = #call meta_node_start(%endc)
      %en_b = #call bs_byte_at(%base, %en_at, %len)
      %en_comma = #eq[#bits<8>](%en_b, 44)
      %notcomma = #eq[#bits<1>](%en_comma, 0)
      #if %notcomma {
        // 实参后面既不是 `,` 也不是到头（`f(1 2)` 之类）
        %f1 = #call lain_meta_fail(4)
        #break a(4)
      }
      %ai2 = #add[#bits<64>](%endi, 1)
      #continue a(%ai2)
    } else {
      #break a(0)
    }
  }
  %sfail = #ne[#bits<32>](%st, 0)
  %res = #if %sfail -> (#bits<32>) {
    // 这一层失败：外层的块和计数还回去、水位退回，再把状态报上去。
    // （成功时**不还** —— 块还要给 `meta_args_write` 读。）
    %scf = #call lain_meta_scratch_data()
    %u1 = #call meta_cell_put(#lea(%scf, 216, 1, 0), %oldb)
    %u2 = #call meta_cell_put(#lea(%scf, 496, 1, 0), %oldc)
    %u3 = #call meta_bump_release(%mark)
    #yield %st
  } else {
    #yield 0
  }
  #return %res
}

// 第二趟：把**这一层**块里的实参写出来，`<a>, <b>, …`（不带括号），读完把块还给分配器。
//
// **必须在调用方写完前缀之后调** —— 前缀（`  %r<n> = #call f(` 或 `  #return #call f(`）
// 得在实参前面，而 `meta_args_prepare` 已经把实参里的子表达式指令发完了。所以顺序是
// 调用方：`prepare` → 写前缀 → `write` → 写 `)`。块的归还也在这里：`prepare` 只管要，
// `write` 是最后一个读它的人。
#proc meta_args_write(%base: #addr, %len: #bits<64>) -> #bits<32> {
  %sc2 = #call lain_meta_scratch_data()
  %blk0 = #call meta_cell_get(#lea(%sc2, 216, 1, 0))
  %cnt = #call meta_cell_get(#lea(%sc2, 496, 1, 0))
  %ba = #lea(%sc2, %blk0, 1, 0)
  %mark = #call meta_cell_get(%ba)
  %oldb = #call meta_cell_get(#lea(%ba, 8, 1, 0))
  %oldc = #call meta_cell_get(#lea(%ba, 16, 1, 0))
  %w = #loop b(%i: #bits<64> = 0) -> (#bits<32>) {
    %fin = #uge[#bits<64>](%i, %cnt)
    #if %fin {
      #break b(0)
    }
    %notfirst = #ne[#bits<64>](%i, 0)
    #if %notfirst {
      %w1 = #call lainir_comma_write()
    }
    %blk = #call meta_cell_get(#lea(%sc2, 216, 1, 0))
    %off2 = #mul[#bits<64>](%i, 24)
    %d2 = #add[#bits<64>](%off2, 24)
    %slot2 = #add[#bits<64>](%blk, %d2)
    %q2 = #lea(%sc2, %slot2, 1, 0)
    %r2 = #call meta_cell_get(%q2)
    %l2 = #call meta_cell_get(#lea(%q2, 8, 1, 0))
    %h2 = #call meta_cell_get(#lea(%q2, 16, 1, 0))
    %w2 = #call meta_emit_ref2(%base, %len, %r2, %l2, %h2)
    %i2 = #add[#bits<64>](%i, 1)
    #continue b(%i2)
  }
  // 这一层用完就还：水位退回、外层的块和计数还原。成功失败都要还，否则嵌套越深
  // 水位越高（泄漏），最后撞上区段上界。
  %u1 = #call meta_cell_put(#lea(%sc2, 216, 1, 0), %oldb)
  %u2 = #call meta_cell_put(#lea(%sc2, 496, 1, 0), %oldc)
  %u3 = #call meta_bump_release(%mark)
  #return %w
}

// `  #return #call <callee>(<实参>…)\n`
//
// 顺序：先 `meta_args_prepare`（发实参里的子表达式指令），再写这一行的前缀和实参。
// 反过来写的话子表达式指令会插进 `#call f(` 后面。
// 把暂存好的实参列表渲染进缓冲区（逗号加空格分隔），返回写入长度，同时把这一层
// 的块还掉。前缀由调用方写，所以渲染与发射分成两步。
#proc meta_args_render(%base: #addr, %len: #bits<64>,
                        %out: #addr) -> #bits<64> {
  %sc2 = #call lain_meta_scratch_data()
  %blk0 = #call meta_cell_get(#lea(%sc2, 216, 1, 0))
  %cnt = #call meta_cell_get(#lea(%sc2, 496, 1, 0))
  %ba = #lea(%sc2, %blk0, 1, 0)
  %mark = #call meta_cell_get(%ba)
  %oldb = #call meta_cell_get(#lea(%ba, 8, 1, 0))
  %oldc = #call meta_cell_get(#lea(%ba, 16, 1, 0))
  %w = #loop b(%i: #bits<64> = 0, %at: #bits<64> = 0) -> (#bits<64>) {
    %fin = #uge[#bits<64>](%i, %cnt)
    #if %fin {
      #break b(%at)
    }
    %notfirst = #ne[#bits<64>](%i, 0)
    %at2 = #if %notfirst -> (#bits<64>) {
      %sm = #data_addr lainir_comma
      %wa = #call lainir_buf_bytes(%out, %at, %sm, 2)
      #yield %wa
    } else {
      #yield %at
    }
    %blk = #call meta_cell_get(#lea(%sc2, 216, 1, 0))
    %off2 = #mul[#bits<64>](%i, 24)
    %d2 = #add[#bits<64>](%off2, 24)
    %slot2 = #add[#bits<64>](%blk, %d2)
    %q2 = #lea(%sc2, %slot2, 1, 0)
    %r2 = #call meta_cell_get(%q2)
    %l2 = #call meta_cell_get(#lea(%q2, 8, 1, 0))
    %h2 = #call meta_cell_get(#lea(%q2, 16, 1, 0))
    %at3 = #lea(%out, %at2, 1, 0)
    %n2 = #call meta_render_ref2(%base, %len, %r2, %l2, %h2, %at3)
    %at4 = #add[#bits<64>](%at2, %n2)
    %i2 = #add[#bits<64>](%i, 1)
    #continue b(%i2, %at4)
  }
  %u1 = #call meta_cell_put(#lea(%sc2, 216, 1, 0), %oldb)
  %u2 = #call meta_cell_put(#lea(%sc2, 496, 1, 0), %oldc)
  %u3 = #call meta_bump_release(%mark)
  #return %w
}
#proc meta_emit_ret_call(%base: #addr, %len: #bits<64>,
                          %kind: #bits<64>, %width: #bits<64>,
                          %t_lo: #bits<64>, %t_hi: #bits<64>,
                          %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                          %args: #bits<64>) -> #bits<32> {
  %callee_name = #lea(%base, %callee_lo, 1, 0)
  %callee_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %decl = #call meta_scope_require_func(%callee_name, %callee_len)
  #if #eq[#bits<64>](%decl, 0) { #return 9415 }
  %ast = #call meta_args_prepare(%base, %len, %kind, %width, %t_lo,
                                 %t_hi, %args)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  %buf = #data_addr lainir_text_buffer
  %alen = #call meta_args_render(%base, %len, %buf)
  %c_at = #lea(%base, %callee_lo, 1, 0)
  %c_len = #add[#bits<64>](%callee_len, 0)
  %w = #call lainir_ret_call(%c_at, %c_len, %buf, %alen)
  #return 0
}

// `  %NAME = #call <callee>(<实参>…)\n`
//
// 函数体里的绑定调用与 `meta_emit_ret_call` 共用实参的两趟顺序；先准备实参，
// 再写调用前缀，最后写实参，避免子表达式指令落进 `#call f(` 中间。
#proc meta_emit_binding_call(%base: #addr, %len: #bits<64>,
                             %kind: #bits<64>, %width: #bits<64>,
                             %name_lo: #bits<64>, %name_hi: #bits<64>,
                             %t_lo: #bits<64>, %t_hi: #bits<64>,
                             %callee_lo: #bits<64>, %callee_hi: #bits<64>,
                             %args: #bits<64>) -> #bits<32> {
  %callee_name = #lea(%base, %callee_lo, 1, 0)
  %callee_len = #sub[#bits<64>](%callee_hi, %callee_lo)
  %decl = #call meta_scope_require_func(%callee_name, %callee_len)
  #if #eq[#bits<64>](%decl, 0) { #return 9415 }
  %ast = #call meta_args_prepare(%base, %len, %kind, %width, %t_lo,
                                 %t_hi, %args)
  %abad = #ne[#bits<32>](%ast, 0)
  #if %abad {
    #return %ast
  }
  %buf = #data_addr lainir_text_buffer
  %alen = #call meta_args_render(%base, %len, %buf)
  %nbuf = #lea(%buf, 128, 1, 0)
  %pct = #call lainir_buf_byte(%nbuf, 0, 37)
  %n_at = #lea(%base, %name_lo, 1, 0)
  %n_len = #sub[#bits<64>](%name_hi, %name_lo)
  %nlen2 = #call lainir_buf_bytes(%nbuf, %pct, %n_at, %n_len)
  %c_at = #lea(%base, %callee_lo, 1, 0)
  %c_len = #add[#bits<64>](%callee_len, 0)
  %w = #call lainir_call_named(%nbuf, %nlen2, %c_at, %c_len, %buf, %alen)
  #return 0
}

// 表达式发射器的**收尾**（`meta_emit_expr` 在语句末尾按 `%close` 调它）。
//
//   0 = 什么都不做（顶层值那条路自己读 sheet 收尾）
//   1 = 绑定：链的最后一条已经写成 `%NAME = …` 了（`%bound` = 1）就不再动手；
//       否则结果是「源码那段」或者一个临时值，复制一条 `  %NAME = #add[repr](<结果>, 0)`
//   2 = 返回：写 `  #return <结果>`
//
// 加零那条路走类型自己的 `+`（跟老路径同一个来源），查不到报 6。
#proc meta_emit_close(%base: #addr, %len: #bits<64>,
                      %close: #bits<64>, %bound: #bits<1>,
                      %acc: #bits<64>, %alo: #bits<64>, %ahi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>,
                      %t_lo: #bits<64>, %t_hi: #bits<64>,
                      %n_lo: #bits<64>, %n_hi: #bits<64>) -> #bits<32> {
  %plain = #eq[#bits<64>](%close, 0)
  %st = #if %plain -> (#bits<32>) {
    #yield 0
  } else {
    %is_ret = #eq[#bits<64>](%close, 2)
    %s = #if %is_ret -> (#bits<32>) {
      // `return 300;` 在 bits<8> 的函数里：装不进就拒（曾经静默截断成 44）
      %fc = #call meta_literal_fits(%base, %len, %acc, %alo, %ahi,
                                    %kind, %width)
      %fcbad = #ne[#bits<32>](%fc, 0)
      #if %fcbad {
        #return %fc
      }
      %buf = #data_addr lainir_text_buffer
      %rlen = #call meta_render_ref2(%base, %len, %acc, %alo, %ahi, %buf)
      %w = #call lainir_return_ref(%buf, %rlen)
      #yield 0
    } else {
      %done = #if %bound -> (#bits<32>) {
        #yield 0
      } else {
        // 值是字面量/源码那段：复制进绑定之前先看装不装得下
        %bfc = #call meta_literal_fits(%base, %len, %acc, %alo, %ahi,
                                       %kind, %width)
        %bfbad = #ne[#bits<32>](%bfc, 0)
        #if %bfbad {
          #return %bfc
        }
        // 复制是编译器自己发的，不走源码的算子表：地址用 #lea(x, 0, 1, 0)，
        // 其余定宽整数用 #add[repr](x, 0)。u8/i8/addr 没有算子绑定，
        // 走算子表查 `+` 会报 6。
        %nbuf = #data_addr lainir_text_buffer
        %pct0 = #call lainir_buf_byte(%nbuf, 0, 37)
        %n_at = #lea(%base, %n_lo, 1, 0)
        %n_len = #sub[#bits<64>](%n_hi, %n_lo)
        %nlen0 = #call lainir_buf_bytes(%nbuf, %pct0, %n_at, %n_len)
        %abuf = #lea(%nbuf, 128, 1, 0)
        %alen0 = #call meta_render_ref2(%base, %len, %acc, %alo, %ahi, %abuf)
        %zbuf = #lea(%nbuf, 180, 1, 0)
        %zero0 = #call lainir_buf_uint(%zbuf, 0, 0)
        %is_addr = #eq[#bits<64>](%kind, 3)
        %cpy = #if %is_addr -> (#bits<32>) {
          %w9 = #call lainir_lea_named(%nbuf, %nlen0, %abuf, %alen0, %zbuf, %zero0, 1, 0)
          #yield 0
        } else {
          %addn = #data_addr meta_sym_add
          %w10 = #call lainir_binary_op_named(%nbuf, %nlen0, %addn, 3, %kind, %width, %abuf, %alen0, %zbuf, %zero0)
          #yield 0
        }
        #yield %cpy
      }
      #yield %done
    }
    #yield %s
  }
  #return %st
}

// --- for 循环 ---------------------------------------------------------------
//
//   let total: i32 = for i in 0..n acc = 0 {
//     acc = acc + i;
//   };
//
// 整条 `for` 是一条表达式，值就是累加变量的最终值；`acc` 这个名字是**语言定的**
// （不是用户在源码里起的），所以循环体里唯一能赋值的合法目标就是它。
//
// 形状是照 LAINIR 的 `#loop` 削出来的：`#loop NAME(变量…) -> (T)` 携带的就是循环
// 自己的变量，而且只回一个结果。于是：
//
//   - `#loop` 的变量**直接就是 `i` 和 `acc`**，产物里写成 `%i`、`%acc`，
//     **不需要任何「源码名 → LAINIR 名」的映射表**；
//   - `acc = 值 算子 值` 就是「下一轮的 acc」；
//   - 循环的结果绑在 `let` 那个名字上（`%total = #loop L1(...)`）。
//
// 产物形状：
//
//     %total = #loop L1(%i: #bits<32> = 0, %acc: #bits<32> = 0) -> (#bits<32>) {
//       %c2 = #slt[#bits<32>](%i, %n)
//       #if %c2 {
//         %r3 = #add[#bits<32>](%acc, %i)
//         %r4 = #add[#bits<32>](%i, 1)
//         #continue L1(%r4, %r3)
//       }
//       #break L1(%acc)
//     }
//
// `#continue` 的值按 `#loop` 声明变量的**顺序**给，所以是「先步进、再结果」。
//
// v0 的限制：不能嵌套循环；循环变量和累加变量都取 `let` 标注的那个类型，所以那个
// 类型要有 `<` 和 `+`（v0 里只有 i32/u32 有）；下界和上界是「值」（字面量、参数或
// 已声明的局部），不是任意表达式；循环体**只有一条 `acc = 值 算子 值;`**。

// 发射带缩进的 `    %c<n> = #<物理< >[repr](<循环变量>, <上界>)\n    #if %c<n> {\n`。
// 调用前 `meta_op_resolve` 要已经把 `<` 的物理名字填进暂存区。
#proc meta_emit_loop_test(%base: #addr, %len: #bits<64>,
                           %kind: #bits<64>, %width: #bits<64>,
                           %i_lo: #bits<64>, %i_hi: #bits<64>,
                           %hi_lo: #bits<64>,
                           %hi_hi: #bits<64>) -> #bits<32> {
  // 这一份自己发 `%`（后面跟的是 `c`，不是 `meta_emit_temp_name`）
  %n = #call meta_next_temp()
  %sc = #call lain_meta_scratch_data()
  %buf = #data_addr lainir_text_buffer
  %nbuf = #lea(%buf, 160, 1, 0)
  %pct = #call lainir_buf_byte(%nbuf, 0, 37)
  %cch = #call lainir_buf_byte(%nbuf, %pct, 99)
  %nlen = #call lainir_buf_uint(%nbuf, %cch, %n)
  %dt0 = #call meta_cell_put(#lea(%sc, 2288, 1, 0), 0)
  %dh0 = #call meta_cell_put(#lea(%sc, 2176, 1, 0), %i_hi)
  %alen = #call meta_render_operand(%base, %i_lo, %i_hi, %len, %buf)
  %dt1 = #call meta_cell_put(#lea(%sc, 2288, 1, 0), 1)
  %dh1 = #call meta_cell_put(#lea(%sc, 2184, 1, 0), %hi_hi)
  %abuf = #lea(%buf, 96, 1, 0)
  %blen = #call meta_render_operand(%base, %hi_lo, %hi_hi, %len, %abuf)
  %w = #call lainir_binary_named_at(4, %nbuf, %nlen, %kind, %width, %buf, %alen, %abuf, %blen)
  %w10 = #call lainir_indent4_write()
  %w11 = #call lainir_if_head_write()
  %w12 = #call lainir_byte(99)
  %w13 = #call lainir_emit_uint(%n)
  %w14 = #call lainir_open_body()
  #return 0
}

// `    %r<n> = #<物理>[repr](<a>, <b>)\n`。返回临时值编号。
// 调用前 `meta_op_resolve` 要已经把这个算子的物理名字填进暂存区。
#proc meta_emit_loop_temp(%base: #addr, %len: #bits<64>,
                           %kind: #bits<64>, %width: #bits<64>,
                           %a_lo: #bits<64>, %a_hi: #bits<64>,
                           %b_lo: #bits<64>, %b_hi: #bits<64>) -> #bits<64> {
  // 缩进 4 格，但**不发 `%`**：`meta_emit_temp_name` 自己带
  %n = #call meta_next_temp()
  %sc = #call lain_meta_scratch_data()
  %dt2 = #call meta_cell_put(#lea(%sc, 2288, 1, 0), 2)
  %dh2 = #call meta_cell_put(#lea(%sc, 2192, 1, 0), %a_hi)
  %buf = #data_addr lainir_text_buffer
  %abuf = #lea(%buf, 96, 1, 0)
  %alen = #call meta_render_operand(%base, %a_lo, %a_hi, %len, %buf)
  %dt3 = #call meta_cell_put(#lea(%sc, 2288, 1, 0), 3)
  %dh3 = #call meta_cell_put(#lea(%sc, 2200, 1, 0), %b_hi)
  %blen = #call meta_render_operand(%base, %b_lo, %b_hi, %len, %abuf)
  %w = #call lainir_binary_phys_at(%n, %kind, %width, %buf, %alen, %abuf, %blen)
  #return %n
}

// `    %r<n> = #<物理>[repr](<循环变量>, 1)\n` —— 步进。返回临时值编号。
// 调用前 `meta_op_resolve` 要已经把这个类型的 `+` 填进暂存区。
#proc meta_emit_loop_step(%base: #addr, %len: #bits<64>,
                           %kind: #bits<64>, %width: #bits<64>,
                           %i_lo: #bits<64>, %i_hi: #bits<64>) -> #bits<64> {
  %n = #call meta_next_temp()
  %sc = #call lain_meta_scratch_data()
  %dt4 = #call meta_cell_put(#lea(%sc, 2288, 1, 0), 4)
  %dh4 = #call meta_cell_put(#lea(%sc, 2208, 1, 0), %i_hi)
  %buf = #data_addr lainir_text_buffer
  %ibuf = #lea(%buf, 96, 1, 0)
  %ilen = #call meta_render_operand(%base, %i_lo, %i_hi, %len, %buf)
  %olen = #call lainir_buf_uint(%ibuf, 0, 1)
  %w = #call lainir_binary_phys_at(%n, %kind, %width, %buf, %ilen, %ibuf, %olen)
  #return %n
}

// `let NAME: T = for I in LO..HI acc = INIT { acc = A OP B; };`
//
// b_lo/b_hi 是那个绑定名（`let` 左边），t_lo/t_hi 是它的类型。`%parent/%index` 是
// `for` 这个词在**语句序列里的出现位置**；整条 `for …` 的八个后继都由
// 「父组 + 下标 + n」给出 —— 游标只会增加下标（规范 §2.1），不查节点自己的后继。
#proc meta_lower_for(%base: #addr, %len: #bits<64>,
                      %parent: #bits<64>, %index: #bits<64>,
                      %b_lo: #bits<64>, %b_hi: #bits<64>,
                      %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<32> {
  // 诊断（宿主槽 8/9/10）：for 的入口次数与窗口。
  %tid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
  %no_type = #eq[#bits<64>](%tid, 0)
  #if %no_type {
    %f0 = #call lain_meta_fail(5)
    #return 5
  }
  %info = #call meta_tid_repr(%tid)
  %kind = #and[#bits<64>](%info, 255)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)

  // for I in LO .. HI acc = INIT { 体 }：游标一格一格往前推。
  %i_node = #call meta_cursor_next(%parent, %index)
  %in_node = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 1))
  %lo_node = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 2))
  %dots = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 3))
  %hi_node = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 4))
  %acc_node = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 5))
  %acc_eq = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 6))
  %init_node = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 7))
  %body = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 8))

  // 形状先认全了再动手发。节点访问器对 NONE 是安全的（`meta_tree_field` 挡了），
  // 所以一条写残的源码最多就是「形状不认」，不会读到暂存区外面去。
  %kw_in = #data_addr meta_kw_in
  %kw_acc = #data_addr meta_kw_acc
  %kw_eq = #data_addr meta_kw_eq
  %kw_dots = #data_addr meta_sym_dotdot
  %ok_in = #call meta_node_is_word(%in_node, %base, %kw_in, 2)
  %ok_dots = #call meta_node_is_word(%dots, %base, %kw_dots, 2)
  %ok_acc = #call meta_node_is_word(%acc_node, %base, %kw_acc, 3)
  %ok_eq = #call meta_node_is_word(%acc_eq, %base, %kw_eq, 1)
  %bk = #call meta_node_kind(%body)
  %is_group = #eq[#bits<64>](%bk, 2)
  %q1 = #and[#bits<1>](%ok_in, %ok_dots)
  %q2 = #and[#bits<1>](%ok_acc, %ok_eq)
  %q3 = #and[#bits<1>](%q1, %q2)
  %shape = #and[#bits<1>](%q3, %is_group)
  %notshape = #eq[#bits<1>](%shape, 0)
  #if %notshape {
    %f1 = #call lain_meta_fail(4)
    #return 4
  }

  // 循环编号：和临时值共用一个计数器（+144）。编号只进 `L<n>` 这个名字，
  // 临时值只进 `%r<n>`，前缀不同，不会撞。
  %ln = #call meta_next_temp()

  // `  %<结果> = #loop L<n>(`
  %p = #data_addr meta_st_pct
  %w1 = #call lain_meta_emit_write(%p, 3)
  %b_at = #lea(%base, %b_lo, 1, 0)
  %b_n = #sub[#bits<64>](%b_hi, %b_lo)
  %w2 = #call lain_meta_emit_write(%b_at, %b_n)
  %lop = #data_addr meta_st_loopopen
  %w3 = #call lain_meta_emit_write(%lop, 10)
  %w4 = #call meta_emit_uint(%ln)
  %lp = #data_addr meta_fn_lparen
  %w5 = #call lain_meta_emit_write(%lp, 1)

  // `%<循环变量>: <repr> = <下界>`——`meta_emit_operand` 自己发那个 `%`
  %i_lo = #call meta_node_start(%i_node)
  %i_hi = #add[#bits<64>](%i_lo, #call meta_node_len(%i_node))
  %pct = #data_addr meta_fn_pct
  %ds5 = #call lain_meta_scratch_data()
  %dt5 = #call meta_cell_put(#lea(%ds5, 2288, 1, 0), 5)
    %dh5 = #call meta_cell_put(#lea(%ds5, 2216, 1, 0), %i_hi)
  %w7 = #call meta_emit_operand(%base, %i_lo, %i_hi, %len)
  %col = #data_addr meta_fn_colon
  %w8 = #call lain_meta_emit_write(%col, 2)
  %w9 = #call meta_emit_repr(%kind, %width)
  %eqs = #data_addr meta_st_eqop
  %w10 = #call lain_meta_emit_write(%eqs, 3)
  %lo_lo = #call meta_node_start(%lo_node)
  %lo_hi = #add[#bits<64>](%lo_lo, #call meta_node_len(%lo_node))
  %ds6 = #call lain_meta_scratch_data()
  %dt6 = #call meta_cell_put(#lea(%ds6, 2288, 1, 0), 6)
    %dh6 = #call meta_cell_put(#lea(%ds6, 2224, 1, 0), %lo_hi)
  %w11 = #call meta_emit_operand(%base, %lo_lo, %lo_hi, %len)

  // `, %acc: <repr> = <初值>`
  %cm = #data_addr meta_o4
  %w12 = #call lain_meta_emit_write(%cm, 2)
  %w13 = #call lain_meta_emit_write(%pct, 1)
  %w14 = #call lain_meta_emit_write(%kw_acc, 3)
  %w15 = #call lain_meta_emit_write(%col, 2)
  %w16 = #call meta_emit_repr(%kind, %width)
  %w17 = #call lain_meta_emit_write(%eqs, 3)
  %in_lo = #call meta_node_start(%init_node)
  %in_hi = #add[#bits<64>](%in_lo, #call meta_node_len(%init_node))
  %ds7 = #call lain_meta_scratch_data()
  %dt7 = #call meta_cell_put(#lea(%ds7, 2288, 1, 0), 7)
    %dh7 = #call meta_cell_put(#lea(%ds7, 2232, 1, 0), %in_hi)
  %w18 = #call meta_emit_operand(%base, %in_lo, %in_hi, %len)

  // `) -> (<repr>) {\n`
  %rl = #data_addr meta_st_rlpar
  %w19 = #call lain_meta_emit_write(%rl, 6)
  %w20 = #call meta_emit_repr(%kind, %width)
  %lh = #data_addr meta_st_lhead
  %w21 = #call lain_meta_emit_write(%lh, 4)

  // 循环条件：`<` 是这个类型自己的算子，不是编译器里写死的
  %lt = #data_addr meta_sym_lt
  %ltid = #call meta_op_resolve(%base, %len, %t_lo, %t_hi, %lt, 1)
  %ltmiss = #eq[#bits<64>](%ltid, 0xFFFFFFFFFFFFFFFF)
  #if %ltmiss {
    %f2 = #call lain_meta_fail(6)
    #return 6
  }
  %hi_lo = #call meta_node_start(%hi_node)
  %hi_hi = #add[#bits<64>](%hi_lo, #call meta_node_len(%hi_node))
  %tw = #call meta_emit_loop_test(%base, %len, %kind, %width,
                                  %i_lo, %i_hi, %hi_lo, %hi_hi)

  // 循环体只认一条 `acc = A OP B;`。这里换成**循环体组上的游标**：`%body` 是父组，
  // 每一个后继都是「父组 + 下标 + n」。
  %ok_accb = #call meta_node_is_word(#call ast_child(%body, 0), %base, %kw_acc, 3)
  %eq2 = #call ast_child(%body, 1)
  %ok_eqb = #call meta_node_is_word(%eq2, %base, %kw_eq, 1)
  %bshape = #and[#bits<1>](%ok_accb, %ok_eqb)
  %badbody = #eq[#bits<1>](%bshape, 0)
  #if %badbody {
    %f3 = #call lain_meta_fail(4)
    #return 4
  }
  %a_node = #call ast_child(%body, 2)
  %op_node = #call ast_child(%body, 3)
  %b_node = #call ast_child(%body, 4)
  %semi = #call ast_child(%body, 5)
  %kw_semi = #data_addr meta_kw_semi
  %ok_semi = #call meta_node_is_word(%semi, %base, %kw_semi, 1)
  %nosemi = #eq[#bits<1>](%ok_semi, 0)
  #if %nosemi {
    %f4 = #call lain_meta_fail(21)
    #return 21
  }

  // 循环体那个算子：从类型自己的 op 表里查（和顶层 `let` 同一个来源）
  %op_lo = #call meta_node_start(%op_node)
  %sym = #lea(%base, %op_lo, 1, 0)
  %opid = #call meta_op_resolve(%base, %len, %t_lo, %t_hi, %sym, 1)
  %opmiss = #eq[#bits<64>](%opid, 0xFFFFFFFFFFFFFFFF)
  #if %opmiss {
    %f5 = #call lain_meta_fail(6)
    #return 6
  }
  %x_lo = #call meta_node_start(%a_node)
  %x_hi = #add[#bits<64>](%x_lo, #call meta_node_len(%a_node))
  %y_lo = #call meta_node_start(%b_node)
  %y_hi = #add[#bits<64>](%y_lo, #call meta_node_len(%b_node))
  // 诊断（安全格 2320..2360）：两个节点与两个窗口，配对记录。
  %lsc = #call lain_meta_scratch_data()
  %lw0 = #call meta_cell_put(#lea(%lsc, 2320, 1, 0), %a_node)
  %lw1 = #call meta_cell_put(#lea(%lsc, 2328, 1, 0), %b_node)
  %lw2 = #call meta_cell_put(#lea(%lsc, 2336, 1, 0), %x_lo)
  %lw3 = #call meta_cell_put(#lea(%lsc, 2344, 1, 0), %x_hi)
  %lw4 = #call meta_cell_put(#lea(%lsc, 2352, 1, 0), %y_lo)
  %lw5 = #call meta_cell_put(#lea(%lsc, 2360, 1, 0), %y_hi)
  %rv = #call meta_emit_loop_temp(%base, %len, %kind, %width,
                                  %x_lo, %x_hi, %y_lo, %y_hi)

  // 步进
  %plus = #data_addr meta_sym_plus
  %pid = #call meta_op_resolve(%base, %len, %t_lo, %t_hi, %plus, 1)
  %pmiss = #eq[#bits<64>](%pid, 0xFFFFFFFFFFFFFFFF)
  #if %pmiss {
    %f6 = #call lain_meta_fail(6)
    #return 6
  }
  %rs = #call meta_emit_loop_step(%base, %len, %kind, %width,
                                  %i_lo, %i_hi)

  // `    #continue L<n>(%r<步进>, %r<结果>)\n`
  %w22 = #call lainir_continue_head_write()
  %w23 = #call lainir_emit_uint(%ln)
  %w24 = #call lainir_open_paren_write()
  %w25 = #call meta_emit_temp_name(%rs)
  %w26 = #call lainir_comma_write()
  %w27 = #call meta_emit_temp_name(%rv)
  %w28 = #call lainir_rparen_nl_write()

  // `    }\n`
  %w29 = #call lainir_close4_write()

  // `    #break L<n>(%acc)\n`
  %w30 = #call lainir_break_head_write()
  %w31 = #call lainir_emit_uint(%ln)
  %w32 = #call lainir_open_paren_write()
  %w33 = #call lainir_pct_write()
  %w34 = #call lainir_write(%kw_acc, 3)
  %w35 = #call lainir_rparen_nl_write()

  // `  }\n`
  %w36 = #call lainir_close_line_write()
  #return 0
}

// 一条语句。is_ret 决定它是 `return` 还是 `let`。
//   t_lo/t_hi 是这条语句用的类型名（`let` 是标注的那个，`return` 是返回类型）。
//   `%parent/%index` 是这条语句的**第一个孩子**（`return` / `let` 那个词）的出现位置；
//   `%vindex` 是**值**在同一个父组里的下标（`return` 是 +1，`let NAME: T =` 是 +5）——
//   由调用方算好传进来，别在这里猜：语句长度随形状变。
#proc meta_lower_stmt(%base: #addr, %len: #bits<64>,
                       %parent: #bits<64>, %index: #bits<64>,
                       %vindex: #bits<64>, %semi: #bits<64>,
                       %is_ret: #bits<1>, %name_lo: #bits<64>,
                       %name_hi: #bits<64>, %t_lo: #bits<64>,
                       %t_hi: #bits<64>) -> #bits<32> {
  // 值的位置由调用方给出（游标是「父组 + 下标」这一对，不是一个能推算的常数）。
  // 寄存器没有复制指令（`%a = %b` 非法），要搬一个值就加 0。
  %vi = #add[#bits<64>](%vindex, 0)
  %v = #call ast_child(%parent, %vi)
  %tid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
  %no_type = #eq[#bits<64>](%tid, 0)
  %status = #if %no_type -> (#bits<32>) {
    %f0 = #call lain_meta_fail(5)
    #yield 5
  } else {
    %info = #call meta_tid_repr(%tid)
    %kind = #and[#bits<64>](%info, 255)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)
    // 带值 if：`let x: T = if c { a } else { b };`（值的**第一个** token 是 `if` 那个词）。
    // 只在绑定位置接住 —— `return if …` 还没有写法，干净地报 4。
    %vif = #call meta_node_is_word(%v, %base, #data_addr meta_kw_if, 2)
    %notret_v = #eq[#bits<1>](%is_ret, 0)
    %vif_ok = #and[#bits<1>](%vif, %notret_v)
    %vif_named = #ne[#bits<64>](%name_hi, %name_lo)
    %do_vif = #and[#bits<1>](%vif_ok, %vif_named)
    #if %do_vif {
      %vif_st = #call meta_lower_if_value(%base, %len, %parent, %vi,
                                           %name_lo, %name_hi, %t_lo, %t_hi)
      #return %vif_st
    }
    // 形状读识别 pass 算好的那一格（键 = 这个出现位置），不再用「下一个节点是不是
    // `;`」猜。猜法在 `return g(x);` 上会挂：`g` 的下一个节点是那个组，于是组被当成
    // 算子，拿 `(` 去查类型的 op 表 —— 报 6「没这个算子」，跟真实原因毫无关系。
    %form = #call meta_node_form(%parent, %vi)
    // 形状 5 说的是「这里开始一次调用」，不是「整个值就是这次调用」。`return f(0) + 1;`
    // 里 `f` 的形状也是 5 —— 那样后面那个 `+ 1` 会被悄悄丢掉（真出过）。所以先问
    // 整段值里有没有算子。
    %v_st = #call meta_node_start(%v)
    %hasop = #call meta_value_has_op(%base, %len, %v_st)
    %single = #eq[#bits<1>](%hasop, 0)
    %f_call0 = #eq[#bits<64>](%form, 5)
    // 内建的 load / lea 也是「名字 + 实参组」的调用形状，但它们不是声明调用：
    // 拦下来交给表达式那条路（meta_operand_emit 会先认它们）。
    %v_hi0 = #add[#bits<64>](%v_st, #call meta_node_len(%v))
    %prim0 = #call meta_is_builtin_name(%base, %v_st, %v_hi0)
    %notprim0 = #eq[#bits<1>](%prim0, 0)
    %callable = #and[#bits<1>](%f_call0, %single)
    %f_call = #and[#bits<1>](%callable, %notprim0)
    %f_field = #eq[#bits<64>](%form, 6)
    %f_ctor = #eq[#bits<64>](%form, 10)
    // 构造当值用：函数体里从**栈**上划一块（`meta_lower_construct_local`）。
    // 初始化列表是值的**下一个节点**（那个花括号组），与调用那条路同源。
    %f_ctor_only = #and[#bits<1>](%f_ctor, %single)
    #if %f_ctor_only {
      %ctor_lo = #call meta_node_start(%v)
      %ctor_ln = #call meta_node_len(%v)
      %ctor_hi = #add[#bits<64>](%ctor_lo, %ctor_ln)
      %ctor_grp = #call meta_cursor_next(%parent, %vi)
      %ctor_at = #call meta_node_start(%ctor_grp)
      %ctor_st = #call meta_lower_construct_local(%base, %len, %name_lo,
                                                   %name_hi, %ctor_lo, %ctor_hi,
                                                   %ctor_at, %is_ret)
      #return %ctor_st
    }
    // 字段访问当值用：函数体里的降级还没做，**干净地**报 4 —— 不要让 `p.left` 掉进
    // 表达式那条路：操作数发射器会把它当成一个 token，发出来的文本是坏的，
    // 验证器会拿一个跟真实原因无关的码拒。
    // 调用**不**在这一档：`f(1) + 2` 要交给表达式发射器（它会把 `f(1)` 算进临时值）。
    %f_other = #and[#bits<1>](%f_field, 1)
    %s = #if %f_call -> (#bits<32>) {
      // 值是一次调用。两条语句各有自己的写法：
      //   return g(x);        -> `  #return #call g(x)\n`
      //   let y: T = g(x);    -> `  %y = #call g(x)\n`
      // 两者共用实参那两趟（prepare → 写前缀 → write），只差前缀。实参组就是值的
      // **下一个位置** —— 游标前进一格。
      %grp = #call meta_cursor_next(%parent, %vi)
      %notret = #eq[#bits<1>](%is_ret, 0)
      %s_call = #if %notret -> (#bits<32>) {
        %d_lo = #call meta_node_start(%v)
        %d_ln = #call meta_node_len(%v)
        %d_hi = #add[#bits<64>](%d_lo, %d_ln)
        %bc = #call meta_emit_binding_call(%base, %len, %kind, %width,
                                           %name_lo, %name_hi, %t_lo, %t_hi,
                                           %d_lo, %d_hi, %grp)
        #yield %bc
      } else {
        %c_lo = #call meta_node_start(%v)
        %c_ln = #call meta_node_len(%v)
        %c_hi = #add[#bits<64>](%c_lo, %c_ln)
        %rc = #call meta_emit_ret_call(%base, %len, %kind, %width,
                                       %t_lo, %t_hi, %c_lo, %c_hi, %grp)
        #yield %rc
      }
      #yield %s_call
    } else {
      %s_shape = #if %f_other -> (#bits<32>) {
        // 字段访问 / 构造当值用：形状认出来了，函数体里的降级还没做
        %f2 = #call lain_meta_fail(4)
        #yield 4
      } else {
        // 其余的值一律交给表达式发射器：它按**游标**递归、算子链左结合、操作数自己的
        // 类型优先（参数的类型从参数表来）。收尾按 `%close` 写：绑定 `  %NAME = …`，
        // 返回 `  #return …`。
        //
        // 老路径（`meta_emit_ret_bin` / `meta_emit_binding_bin`）**已删** —— 它只发
        // **一个**算子，`return a + b + c;` 会静默丢掉 `+ c`，产物是
        // `%r2 = #add[#bits<32>](%a, %b)`，验证器不报、算出来是错的。这就是
        // `add3(g(1), g(2), g(3))` 算出来 5 而不是 9 的原因。
        %close = #if %is_ret -> (#bits<64>) {
          #yield 2
        } else {
          #yield 1
        }
        %est = #call meta_emit_expr(%base, %len, %kind, %width, %t_lo,
                                    %t_hi, %parent, %vi, 1, %close, %name_lo,
                                    %name_hi)
        #yield %est
      }
      #yield %s_shape
    }
    #yield %s
  }
  #return %status
}

// `if <条件> { 语句* }`
//
// 条件只吃**一个 token**（名字或字面量）：`if b { … }`。它是不是 1 位、有没有定义，
// 由**验证器**判 —— 条件是多 token 的表达式（`if x < 2`）要先有"算子产生自己的结果
// 类型"，那个问题记在 plan §4 第 3 条，还没定。所以这里只发 `  #if %<条件> {`，
// 不去猜条件该补什么（补 `#ne[#bits<W>](…)` 要知道 W，那就得知道条件的类型）。
//
// 块里的语句交给 `meta_lower_body`（它要求块以 `return` 收尾）。缩进不递归，块里的
// 语句还是 2 格 —— LAINIR 不看缩进。
#proc meta_lower_if(%base: #addr, %len: #bits<64>,
                     %parent: #bits<64>, %index: #bits<64>,
                     %c: #bits<64>, %r_t_lo: #bits<64>,
                     %r_t_hi: #bits<64>) -> #bits<32> {
  // `if <条件> <块> [else <块>]`：条件从下标+1 开始，**吃到块那个组为止** ——
  // 条件可以是多 token 的表达式（`if a < b {`），块就是表达式降级停下来的那一格
  // （终点下标在暂存区 `+192`，见 `meta_emit_expr`）。不是由「下标+2」推出来的：
  // 那是「条件恰好一格」时的巧合。
  %ci = #add[#bits<64>](%index, 1)
  %cond = #call meta_cursor_next(%parent, %index)
  %nocond = #eq[#bits<64>](%cond, 0)
  %st = #if %nocond -> (#bits<32>) {
    %f0 = #call lain_meta_fail(4)
    #yield 4
  } else {
    // 条件的上下文类型取本函数的返回类型：`if 1 < 2 {` 这种两个裸字面量的条件要靠
    // 它查算子表（上下文查不到，才会退回字面量自己的类型）。
    %ctid = #call meta_type_resolve(%base, %len, %r_t_lo, %r_t_hi)
    %cmissing = #eq[#bits<64>](%ctid, 0)
    %ce = #if %cmissing -> (#bits<32>) {
      %cf = #call lain_meta_fail(5)
      #yield 5
    } else {
      %cinfo = #call meta_tid_repr(%ctid)
      %ckind = #and[#bits<64>](%cinfo, 255)
      %cwidth = #and[#bits<64>](#lshr[#bits<64>](%cinfo, 8), 255)
      %ces = #call meta_emit_expr(%base, %len, %ckind, %cwidth,
                                  %r_t_lo, %r_t_hi, %parent, %ci, 0, 0, 0, 0)
      #yield %ces
    }
    %cbad = #ne[#bits<32>](%ce, 0)
    #if %cbad { #return %ce }
    %csc2 = #call lain_meta_scratch_data()
    %bi = #call meta_cell_get(#lea(%csc2, 192, 1, 0))
    %block = #call ast_child(%parent, %bi)
    %bkind = #call meta_node_kind(%block)
    %isgroup = #eq[#bits<64>](%bkind, 2)
    %notgroup = #eq[#bits<1>](%isgroup, 0)
    %s = #if %notgroup -> (#bits<32>) {
      // 条件后面不是块
      %f2 = #call lain_meta_fail(4)
      #yield 4
    } else {
      // 先发 `#if <条件> {`，再降级块。条件的值引用已经在 168/176/184 那一格。
      %kw = #data_addr meta_st_if
      %w1 = #call lain_meta_emit_write(%kw, 6)
      %cref = #call meta_cell_get(#lea(%csc2, 168, 1, 0))
      %cl = #call meta_cell_get(#lea(%csc2, 176, 1, 0))
      %ch = #call meta_cell_get(#lea(%csc2, 184, 1, 0))
      %w2 = #call meta_emit_ref2(%base, %len, %cref, %cl, %ch)
      %ob = #data_addr meta_fn_open
      %w3 = #call lain_meta_emit_write(%ob, 3)
      %bst = #call meta_lower_body(%base, %len, %block, %r_t_lo, %r_t_hi)
      %bfail = #ne[#bits<32>](%bst, 0)
      #if %bfail {
        #return %bst
      }
      // `else` 可选。它自己带收掉 `if` 块的那个 `}`，所以有它就先写 `  } else {`，
      // 没有就直接写 `  }` 加换行；两种情况都在最后收一次尾。else 词就在块组的下一格。
      %ei = #add[#bits<64>](%bi, 1)
      %af = #call meta_cursor_next(%parent, %bi)
      %ekw = #data_addr meta_kw_else
      %is_else = #call meta_node_is_word(%af, %base, %ekw, 4)
      #if %is_else {
        %egrp = #call meta_cursor_next(%parent, %ei)
        %ek = #call meta_node_kind(%egrp)
        %eisgrp = #eq[#bits<64>](%ek, 2)
        %enotgrp = #eq[#bits<1>](%eisgrp, 0)
        #if %enotgrp {
          // `else` 后面不是块
          %f3 = #call lain_meta_fail(4)
          #return 4
        }
        %ew = #data_addr meta_st_else
        %w5 = #call lain_meta_emit_write(%ew, 11)
        %bst2 = #call meta_lower_body(%base, %len, %egrp, %r_t_lo, %r_t_hi)
        %bf2 = #ne[#bits<32>](%bst2, 0)
        #if %bf2 {
          #return %bst2
        }
      }
      %cl2 = #data_addr meta_st_lend
      %w4 = #call lain_meta_emit_write(%cl2, 4)
      // 调用方（`meta_lower_body`）要从这里接着数下一条语句。条件多 token 时块的
      // 位置不是常数，所以由本过程把「整条 if 之后的下标」与「有没有 else」写进
      // 暂存区。**必须写在最后**：块里的嵌套 if 也会写这两格，写完就没有别的调用了。
      %rsc = #call lain_meta_scratch_data()
      %resume = #if %is_else -> (#bits<64>) {
        %r2 = #add[#bits<64>](%ei, 2)
        #yield %r2
      } else {
        %r1b = #add[#bits<64>](%bi, 1)
        #yield %r1b
      }
      %pr = #call meta_cell_put(#lea(%rsc, 2408, 1, 0), %resume)
      %ie64 = #zext[#bits<64>](%is_else)
      %pe = #call meta_cell_put(#lea(%rsc, 2416, 1, 0), %ie64)
      #yield 0
    }
    #yield %s
  }
  #return %st
}

#proc meta_lower_if_value(%base: #addr, %len: #bits<64>,
                          %parent: #bits<64>, %index: #bits<64>,
                          %name_lo: #bits<64>, %name_hi: #bits<64>,
                          %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<32> {
  // 带值 if：`let x: T = if c { a } else { b };`。
  //
  // 形状与语句 if 一样（`if <条件> <块> [else <块>]`），差别只在这条 `#if` **有结果**：
  // 两个区域各自 `#yield` 一个值，绑定名直接写在这条 `#if` 上。
  //
  // 条件与两个区域都按**同一个上下文类型**降级（绑定的标注）。区域里的表达式自己
  // 会发指令，那些指令必须落在区域**里面** —— 所以顺序只能是
  // 条件 → `#if … {` 那一行 → 区域里的表达式 → `#yield`：先降级区域再写前缀的话，
  // 区域里的指令会插到这一行前面，出来是坏的。
  %ci = #add[#bits<64>](%index, 1)
  %ctid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
  %cmiss = #eq[#bits<64>](%ctid, 0)
  %s = #if %cmiss -> (#bits<32>) {
    %f0 = #call lain_meta_fail(5)
    #yield 5
  } else {
    %cinfo = #call meta_tid_repr(%ctid)
    %ckind = #and[#bits<64>](%cinfo, 255)
    %cwidth = #and[#bits<64>](#lshr[#bits<64>](%cinfo, 8), 255)
    %ces = #call meta_emit_expr(%base, %len, %ckind, %cwidth, %t_lo, %t_hi,
                                %parent, %ci, 0, 0, 0, 0)
    %cbad = #ne[#bits<32>](%ces, 0)
    %z = #if %cbad -> (#bits<32>) {
      #yield %ces
    } else {
      %sc = #call lain_meta_scratch_data()
      %bi = #call meta_cell_get(#lea(%sc, 192, 1, 0))
      %blk = #call ast_child(%parent, %bi)
      %bk = #call meta_node_kind(%blk)
      %bk2 = #eq[#bits<64>](%bk, 2)
      %noblk = #eq[#bits<1>](%bk2, 0)
      %y = #if %noblk -> (#bits<32>) {
        // 条件后面不是块
        %f1 = #call lain_meta_fail(4)
        #yield 4
      } else {
        %ind = #data_addr meta_st_ind
        %pct = #data_addr meta_st_pct
        %eqop = #data_addr meta_st_eqop
        %hif = #data_addr meta_hash_if
        %alp = #data_addr meta_st_arrow_lp
        %lh = #data_addr meta_st_lhead
        %yld = #data_addr meta_st_yield
        %nl = #data_addr meta_st_nl
        %ew = #data_addr meta_st_else
        %lend = #data_addr meta_st_lend
        %ekw = #data_addr meta_kw_else
        // `  %NAME = #if ` + 条件 + ` -> (` + 类型 + `) {\n`
        %w1 = #call lain_meta_emit_write(%ind, 2)
        %w2 = #call lain_meta_emit_write(%pct, 3)
        %n_at = #lea(%base, %name_lo, 1, 0)
        %n_len = #sub[#bits<64>](%name_hi, %name_lo)
        %w3 = #call lain_meta_emit_write(%n_at, %n_len)
        %w4 = #call lain_meta_emit_write(%eqop, 3)
        %w5 = #call lain_meta_emit_write(%hif, 4)
        %cref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
        %clo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
        %chi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
        %w6 = #call meta_emit_ref2(%base, %len, %cref, %clo, %chi)
        %w7 = #call lain_meta_emit_write(%alp, 5)
        %w8 = #call meta_emit_repr(%ckind, %cwidth)
        %w9 = #call lain_meta_emit_write(%lh, 4)
        // 真分支：表达式降级在区域里面，结果 `#yield` 出来。
        %tst = #call meta_emit_expr(%base, %len, %ckind, %cwidth, %t_lo,
                                    %t_hi, %blk, 0, 0, 0, 0, 0)
        %tbad = #ne[#bits<32>](%tst, 0)
        %z1 = #if %tbad -> (#bits<32>) {
          #yield %tst
        } else {
          %w10 = #call lain_meta_emit_write(%yld, 11)
          %c1 = #call meta_cell_get(#lea(%sc, 168, 1, 0))
          %l1 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
          %h1 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
          %w11 = #call meta_emit_ref2(%base, %len, %c1, %l1, %h1)
          %w12 = #call lain_meta_emit_write(%nl, 1)
          // `else` 可选，但**带值** if 的两个区域都必须有值（LAINIR 的区域要 yield），
          // 所以这里必须有 else，否则干净地报 4。else 词就在块组的下一格。
          %ei = #add[#bits<64>](%bi, 1)
          %af = #call meta_cursor_next(%parent, %bi)
          %is_else = #call meta_node_is_word(%af, %base, %ekw, 4)
          %z3 = #if %is_else -> (#bits<32>) {
            %egrp = #call meta_cursor_next(%parent, %ei)
            %ek = #call meta_node_kind(%egrp)
            %ek2 = #eq[#bits<64>](%ek, 2)
            %enotgrp = #eq[#bits<1>](%ek2, 0)
            %z4 = #if %enotgrp -> (#bits<32>) {
              // `else` 后面不是块
              %f2 = #call lain_meta_fail(4)
              #yield 4
            } else {
              %w13 = #call lain_meta_emit_write(%ew, 11)
              %est = #call meta_emit_expr(%base, %len, %ckind, %cwidth,
                                          %t_lo, %t_hi, %egrp, 0, 0, 0,
                                          0, 0)
              %ebad = #ne[#bits<32>](%est, 0)
              %z5 = #if %ebad -> (#bits<32>) {
                #yield %est
              } else {
                %w14 = #call lain_meta_emit_write(%yld, 11)
                %c2 = #call meta_cell_get(#lea(%sc, 168, 1, 0))
                %l2 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
                %h2 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
                %w15 = #call meta_emit_ref2(%base, %len, %c2, %l2, %h2)
                %w16 = #call lain_meta_emit_write(%nl, 1)
                #yield 0
              }
              #yield %z5
            }
            #yield %z4
          } else {
            // 带值 if 缺 `else`
            %f3 = #call lain_meta_fail(4)
            #yield 4
          }
          %z3bad = #ne[#bits<32>](%z3, 0)
          %z6 = #if %z3bad -> (#bits<32>) {
            #yield %z3
          } else {
            %w17 = #call lain_meta_emit_write(%lend, 4)
            #yield 0
          }
          #yield %z6
        }
        #yield %z1
      }
      #yield %y
    }
    #yield %z
  }
  #return %s
}

// 函数体：`{` 语句* `}`。最后一条必须是 `return`。
//
// 语句序列的遍历是**块组上的游标**：`(body, si)`。每条语句走完之后从它自己的
// 「游标终点」继续 —— 不用 `;` 节点反查后继（`;` 只是位置上的一个词）。
// `let NAME: T = loop LABEL(p1: T1 = e1, ..., acc: Ta = e0) while <条件> { 赋值* };`
//
// 循环参数、条件、循环体都是**通用**形状：参数自带类型与初值，条件是一条任意表达式，
// 循环体是一串 `参数 = 表达式;`。降级成 LAINIR 的 `#loop`：
//
//   %NAME = #loop L<n>(%p1: T1 = <初值>, ...) -> (Ta) {
//       <条件指令>
//       #if <条件> {
//         <赋值指令>
//         #continue L<n>(<p1 的新值>, ...)
//       }
//       #break L<n>(%acc)
//   }
//
// 名字叫 `acc` 的参数就是循环的值：结果宽度取它声明的类型，条件为假时 `#break` 带走的
// 就是它。参数在一轮里可以多次赋值，**最后一次生效**（前面的值没人再用）。
//
// 条件的数字上下文取 `acc` 参数的类型：循环参数不在函数参数表里，
// `meta_word_type_name` 认不出它们，而 `meta_emit_expr` 需要一个类型来查算子的物理名。
//
// 参数块向 bump 分配器要（调用实参块同法），所以嵌套循环不会互相踩；块头（+56/+64）
// 与暂存区 2432/2440/2448 记下标签名与循环编号 —— 带名字的 `break` / `continue` 由 d3 接。
// `break LABEL(值);` / `continue LABEL(实参…);` —— 循环体内的显式跳转。
// 当前循环的参数块偏移放在暂存区 2456（`meta_lower_loop` 在降级循环体之前写入，
// 降级完恢复），块里给出标签、参数个数与每个参数的声明类型窗口。
#proc meta_lower_loop_jump(%base: #addr, %len: #bits<64>,
                           %parent: #bits<64>, %index: #bits<64>) -> #bits<32> {
  %sc = #call lain_meta_scratch_data()
  %boff = #call meta_cell_get(#lea(%sc, 2456, 1, 0))
  %noloop = #eq[#bits<64>](%boff, 0)
  #if %noloop {
    %f0 = #call lain_meta_fail(4)
    #return 4
  }
  %b = #lea(%sc, %boff, 1, 0)
  // `break` 还是 `continue`
  %kw = #call ast_child(%parent, %index)
  %isbrk = #call meta_node_is_word(%kw, %base, #data_addr meta_kw_break, 5)
  %iscont = #call meta_node_is_word(%kw, %base, #data_addr meta_kw_continue, 8)
  %known = #or[#bits<1>](%isbrk, %iscont)
  %unknown = #eq[#bits<1>](%known, 0)
  #if %unknown {
    %f1 = #call lain_meta_fail(4)
    #return 4
  }
  // 标签必须与当前循环同名：嵌套循环里用它指认跳哪一层
  %la = #call ast_child(%parent, #add[#bits<64>](%index, 1))
  %lk = #call meta_node_kind(%la)
  %lab_n = #call meta_node_len(%la)
  %llo = #call meta_cell_get(#lea(%b, 56, 1, 0))
  %lhi = #call meta_cell_get(#lea(%b, 64, 1, 0))
  %llen = #sub[#bits<64>](%lhi, %llo)
  %l_ok = #eq[#bits<64>](%lk, 1)
  %l_same = #eq[#bits<64>](%lab_n, %llen)
  %l0 = #and[#bits<1>](%l_ok, %l_same)
  %lst = #call meta_node_start(%la)
  %lcmp = #if %l0 -> (#bits<1>) {
    %eqb = #call meta_bytes_equal(#lea(%base, %lst, 1, 0),
                                   #lea(%base, %llo, 1, 0), %llen)
    #yield %eqb
  } else {
    #yield 0
  }
  %lbad = #eq[#bits<1>](%lcmp, 0)
  #if %lbad {
    %f2 = #call lain_meta_fail(4)
    #return 4
  }
  // `(实参…)`：`break` 只带循环的值，`continue` 要给每个参数一个值
  %ag = #call ast_child(%parent, #add[#bits<64>](%index, 2))
  %agk = #call meta_node_kind(%ag)
  %nparam = #call meta_cell_get(#lea(%b, 8, 1, 0))
  %wanted = #if %isbrk -> (#bits<64>) {
    #yield 1
  } else {
    #yield %nparam
  }
  // 实参个数不靠孩子数猜：一个实参可以是多 token 的表达式，个数由 `#continue` 的参数
  // 个数（或 `#break` 的 1）定，每个实参在逗号处收尾。
  %ag_ok = #eq[#bits<64>](%agk, 2)
  %head_bad = #eq[#bits<1>](%ag_ok, 0)
  #if %head_bad {
    %f3 = #call lain_meta_fail(4)
    #return 4
  }
  %lp_n = #call meta_cell_get(#lea(%b, 16, 1, 0))
  // `break` 直接发终止指令，循环体随后的收尾不再发；`continue` 只把实参记成
  // 「下一轮的值」，由循环体收尾那条 `#continue` 发出去 —— 区域里终止指令必须是
  // 最后一条，而值型循环又必须有一个 `#break`（验证器 2006）。终止标志写在
  // 暂存区 2464：1 表示区域已经被 `break` 终结。
  %tflag = #if %isbrk -> (#bits<64>) {
    #yield 1
  } else {
    #yield 0
  }
  %tset = #call meta_cell_put(#lea(%sc, 2464, 1, 0), %tflag)
  // 实参类型：`break` 就是循环的值（块头 +24/+32 与 +72/+80），
  // `continue` 按参数顺序取该参数的声明类型（参数项 +16/+24 与 +64/+72）。
  %akd = #call meta_cell_get(#lea(%b, 24, 1, 0))
  %awd = #call meta_cell_get(#lea(%b, 32, 1, 0))
  %at_lo = #call meta_cell_get(#lea(%b, 72, 1, 0))
  %at_hi = #call meta_cell_get(#lea(%b, 80, 1, 0))
  %gas = #loop g(%k: #bits<64> = 0, %pe: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%k, %wanted)
    #if %more {
      %is0 = #eq[#bits<64>](%k, 0)
      // 实参之间是逗号：下一个实参从上一个的终点之后一格开始
      %cpos = #if %is0 -> (#bits<64>) {
        #yield 0
      } else {
        #yield #add[#bits<64>](%pe, 1)
      }
      %cst = #if %is0 -> (#bits<1>) {
        #yield 1
      } else {
        %cm = #call ast_child(%ag, %pe)
        %cm_at = #call meta_node_start(%cm)
        %cm_b = #call bs_byte_at(%base, %cm_at, %len)
        %cm_is = #eq[#bits<8>](%cm_b, 44)
        #yield %cm_is
      }
      %c_bad = #eq[#bits<1>](%cst, 0)
      #if %c_bad {
        %f4 = #call lain_meta_fail(4)
        #break g(%f4)
      }
      %kslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
      %kq = #lea(%b, %kslot, 1, 0)
      %ekd = #call meta_cell_get(#lea(%kq, 16, 1, 0))
      %ewd = #call meta_cell_get(#lea(%kq, 24, 1, 0))
      %et_lo = #call meta_cell_get(#lea(%kq, 64, 1, 0))
      %et_hi = #call meta_cell_get(#lea(%kq, 72, 1, 0))
      %use_kd = #if %isbrk -> (#bits<64>) { #yield %akd } else { #yield %ekd }
      %use_wd = #if %isbrk -> (#bits<64>) { #yield %awd } else { #yield %ewd }
      %use_lo = #if %isbrk -> (#bits<64>) { #yield %at_lo } else { #yield %et_lo }
      %use_hi = #if %isbrk -> (#bits<64>) { #yield %at_hi } else { #yield %et_hi }
      %est = #call meta_emit_expr(%base, %len, %use_kd, %use_wd,
                                  %use_lo, %use_hi, %ag, %cpos, 0, 0, 0, 0)
      %ebad = #ne[#bits<32>](%est, 0)
      #if %ebad {
        #break g(%est)
      }
      %aref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %alo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %ahi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      %aend = #call meta_cell_get(#lea(%sc, 192, 1, 0))
      %send = #call meta_cell_put(#lea(%sc, 2504, 1, 0), %aend)
      %out = #if %isbrk -> (#bits<32>) {
        // break 只有一个实参，先存起来，等所有实参都降级完再发指令 ——
        // 实参里的临时指令必须发在 `#break` 之前。
        %q1 = #call meta_cell_put(#lea(%sc, 2480, 1, 0), %aref)
        %q2 = #call meta_cell_put(#lea(%sc, 2488, 1, 0), %alo)
        %q3 = #call meta_cell_put(#lea(%sc, 2496, 1, 0), %ahi)
        #yield 0
      } else {
        %st1 = #call meta_cell_put(#lea(%kq, 32, 1, 0), %aref)
        %st2 = #call meta_cell_put(#lea(%kq, 80, 1, 0), %alo)
        %st3 = #call meta_cell_put(#lea(%kq, 88, 1, 0), %ahi)
        #yield 0
      }
      #continue g(#add[#bits<64>](%k, 1), %aend)
    } else {
      #break g(0)
    }
  }
  %gbad = #ne[#bits<32>](%gas, 0)
  #if %gbad {
    #return %gas
  }
  // 多写的实参：最后一个实参的终点应该正好是实参组的尽头。
  %acount = #call ast_child_count(%ag)
  %lastend = #call meta_cell_get(#lea(%sc, 2504, 1, 0))
  %tail_ok = #eq[#bits<64>](%lastend, %acount)
  %tail_bad = #eq[#bits<1>](%tail_ok, 0)
  #if %tail_bad {
    %f5 = #call lain_meta_fail(4)
    #return 4
  }
  // `break`：实参已经算好，现在才发终止指令（临时指令都在它之前）。
  %bkey = #if %isbrk -> (#bits<32>) {
    %w1 = #call lain_meta_emit_write(#data_addr meta_st_ind4brk, 12)
    %w1a = #call meta_emit_uint(%lp_n)
    %w1b = #call lain_meta_emit_write(#data_addr meta_fn_lparen, 1)
    %bkr = #call meta_cell_get(#lea(%sc, 2480, 1, 0))
    %bkl = #call meta_cell_get(#lea(%sc, 2488, 1, 0))
    %bkh = #call meta_cell_get(#lea(%sc, 2496, 1, 0))
    %w1c = #call meta_emit_ref2(%base, %len, %bkr, %bkl, %bkh)
    %w1d = #call lain_meta_emit_write(#data_addr meta_st_rp, 2)
    #yield %w1
  } else {
    #yield 0
  }
  #return 0
}

// 内建的内存操作（lea / load）在**表达式**位置。它们不是用户函数，也不进作用域，
// 但形态和调用一样（名字后面跟实参组），所以挂在调用那条路上先认它们。
// 回 1 表示不是内建，调用方接着走用户函数那条路。
// 被调用者的名字是不是内建内存操作（load / lea）。是的话不让它走「声明调用」那条
// 路：那一路要先把名字登记进作用域，而内建没有声明。
#proc meta_is_builtin_name(%base: #addr, %c_lo: #bits<64>,
                           %c_hi: #bits<64>) -> #bits<1> {
  %name = #lea(%base, %c_lo, 1, 0)
  %a = #call meta_bytes_equal(%name, #data_addr meta_kw_load, 4)
  %b = #call meta_bytes_equal(%name, #data_addr meta_kw_lea, 3)
  %r = #or[#bits<1>](%a, %b)
  #return %r
}

#proc meta_emit_builtin_temp(%base: #addr, %len: #bits<64>,
                             %kind: #bits<64>, %width: #bits<64>,
                             %c_lo: #bits<64>, %c_hi: #bits<64>,
                             %args: #bits<64>) -> #bits<32> {
  %name = #lea(%base, %c_lo, 1, 0)
  %is_load = #call meta_bytes_equal(%name, #data_addr meta_kw_load, 4)
  %is_lea = #call meta_bytes_equal(%name, #data_addr meta_kw_lea, 3)
  %st = #if %is_load -> (#bits<32>) {
    %r1 = #call meta_emit_load_temp(%base, %len, %kind, %width, %args)
    #yield %r1
  } else {
    %inner = #if %is_lea -> (#bits<32>) {
      %r2 = #call meta_emit_lea_temp(%base, %len, %args)
      #yield %r2
    } else {
      #yield 1
    }
    #yield %inner
  }
  #return %st
}

// load(p) -> 先发 `  %r<n> = #load[<期望类型>](`，再发地址。
//
// 宽度**只由期望类型定**（let b: u8 = load(p) 里的 u8）：`#load[#bits<8>]` 是
// 类型实参，地址是操作数。偏移给字面 0（引擎没读第二个操作数，现在也只支持
// 一个实参，多写报 4）。
#proc meta_emit_load_temp(%base: #addr, %len: #bits<64>,
                          %kind: #bits<64>, %width: #bits<64>,
                          %args: #bits<64>) -> #bits<32> {
  %sc = #call lain_meta_scratch_data()
  %acount = #call ast_child_count(%args)
  %est = #call meta_emit_expr(%base, %len, 3, 64, 0, 0, %args, 0, 0, 0, 0, 0)
  %ebad = #ne[#bits<32>](%est, 0)
  #if %ebad {
    #return %est
  }
  %endi = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %done = #uge[#bits<64>](%endi, %acount)
  %tail = #eq[#bits<1>](%done, 0)
  #if %tail {
    #return 4
  }
  %aref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %alo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %ahi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  %buf = #data_addr lainir_text_buffer
  %alen = #call meta_render_ref2(%base, %len, %aref, %alo, %ahi, %buf)
  %tn = #call meta_next_temp()
  %w = #call lainir_load_at(%tn, %kind, %width, %buf, %alen)
  %s1 = #call meta_cell_put(#lea(%sc, 168, 1, 0), %tn)
  #return 0
}

// lea(p, i) -> 先发 `  %r<n> = #lea(`，再发两个操作数（缩放 1、偏移 0 = 地址加下标）。
//
// #lea 没有类型实参：结果就是 addr，基址必须是 addr（校验器管这一点）。
#proc meta_emit_lea_temp(%base: #addr, %len: #bits<64>,
                         %args: #bits<64>) -> #bits<32> {
  %sc = #call lain_meta_scratch_data()
  %acount = #call ast_child_count(%args)
  %a1 = #call meta_emit_expr(%base, %len, 3, 64, 0, 0, %args, 0, 0, 0, 0, 0)
  %b1 = #ne[#bits<32>](%a1, 0)
  #if %b1 {
    #return %a1
  }
  %e1 = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %r1 = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %l1 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %h1 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  // 第一个操作数先存起来：降级第二个实参时 +168/+176/+184 会被覆盖
  %s1 = #call meta_cell_put(#lea(%sc, 2512, 1, 0), %r1)
  %s2 = #call meta_cell_put(#lea(%sc, 2520, 1, 0), %l1)
  %s3 = #call meta_cell_put(#lea(%sc, 2528, 1, 0), %h1)
  %cc = #call ast_child(%args, %e1)
  %cat = #call meta_node_start(%cc)
  %cb = #call bs_byte_at(%base, %cat, %len)
  %iscomma = #eq[#bits<8>](%cb, 44)
  #if #eq[#bits<1>](%iscomma, 0) {
    #return 4
  }
  %start2 = #add[#bits<64>](%e1, 1)
  %a2 = #call meta_emit_expr(%base, %len, 0, 64, 0, 0, %args, %start2,
                             0, 0, 0, 0)
  %b2 = #ne[#bits<32>](%a2, 0)
  #if %b2 {
    #return %a2
  }
  %e2 = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %done = #uge[#bits<64>](%e2, %acount)
  %tail = #eq[#bits<1>](%done, 0)
  #if %tail {
    #return 4
  }
  %r2 = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %l2 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %h2 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  %o1 = #call meta_cell_get(#lea(%sc, 2512, 1, 0))
  %o1l = #call meta_cell_get(#lea(%sc, 2520, 1, 0))
  %o1h = #call meta_cell_get(#lea(%sc, 2528, 1, 0))
  %buf = #data_addr lainir_text_buffer
  %i1 = #lea(%buf, 96, 1, 0)
  %alen = #call meta_render_ref2(%base, %len, %o1, %o1l, %o1h, %buf)
  %ilen = #call meta_render_ref2(%base, %len, %r2, %l2, %h2, %i1)
  %tn = #call meta_next_temp()
  %w = #call lainir_lea_at(%tn, %buf, %alen, %i1, %ilen, 1, 0)
  %s4 = #call meta_cell_put(#lea(%sc, 168, 1, 0), %tn)
  #return 0
}

// store(p, v); -> `  #store[<v 的类型>](<v>, <p>)`
//
// 它是**语句**（#store 没有结果），所以不走表达式那条路，由 meta_lower_body 在
// `;` 之后接。操作数顺序是「值、目的地址」—— 与 load 的「地址、偏移」相反。
#proc meta_lower_store(%base: #addr, %len: #bits<64>, %parent: #bits<64>,
                       %index: #bits<64>, %r_t_lo: #bits<64>,
                       %r_t_hi: #bits<64>) -> #bits<32> {
  %sc = #call lain_meta_scratch_data()
  %grp = #call meta_cursor_next(%parent, %index)
  %acount = #call ast_child_count(%grp)
  %a1 = #call meta_emit_expr(%base, %len, 3, 64, 0, 0, %grp, 0, 0, 0, 0, 0)
  %b1 = #ne[#bits<32>](%a1, 0)
  #if %b1 {
    #return %a1
  }
  %e1 = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %r1 = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %l1 = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %h1 = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  %s1 = #call meta_cell_put(#lea(%sc, 2512, 1, 0), %r1)
  %s2 = #call meta_cell_put(#lea(%sc, 2520, 1, 0), %l1)
  %s3 = #call meta_cell_put(#lea(%sc, 2528, 1, 0), %h1)
  %cc = #call ast_child(%grp, %e1)
  %cat = #call meta_node_start(%cc)
  %cb = #call bs_byte_at(%base, %cat, %len)
  %iscomma = #eq[#bits<8>](%cb, 44)
  #if #eq[#bits<1>](%iscomma, 0) {
    #return 4
  }
  %start2 = #add[#bits<64>](%e1, 1)
  // 宽度取自**值自己的类型**：这是 store 与 load 唯一不同的地方
  %vt_lo = #call meta_value_type_window(%base, %len, %grp, %start2,
                                        %r_t_lo, %r_t_hi)
  %vt_hi = #call meta_cell_get(#lea(%sc, 0, 1, 0))
  %tid = #call meta_type_resolve(%base, %len, %vt_lo, %vt_hi)
  %nokind = #eq[#bits<64>](%tid, 0)
  #if %nokind {
    #return 5
  }
  %vkind = #call meta_tid_repr_kind(%tid)
  %vwidth = #call meta_tid_repr_width(%tid)
  %a2 = #call meta_emit_expr(%base, %len, %vkind, %vwidth, %vt_lo, %vt_hi,
                             %grp, %start2, 0, 0, 0, 0)
  %b2 = #ne[#bits<32>](%a2, 0)
  #if %b2 {
    #return %a2
  }
  %e2 = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %done = #uge[#bits<64>](%e2, %acount)
  %tail = #eq[#bits<1>](%done, 0)
  #if %tail {
    #return 4
  }
  %vref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %vlo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %vhi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  %ind = #data_addr meta_st_ind
  %w1 = #call lain_meta_emit_write(%ind, 2)
  %hs = #data_addr meta_hash_store
  %w2 = #call lain_meta_emit_write(%hs, 7)
  %w3 = #call meta_emit_repr(%vkind, %vwidth)
  %lblp = #data_addr meta_lbrack_lparen
  %w4 = #call lain_meta_emit_write(%lblp, 2)
  %w5 = #call meta_emit_ref2(%base, %len, %vref, %vlo, %vhi)
  %sep = #data_addr meta_o4
  %w6 = #call lain_meta_emit_write(%sep, 2)
  %o1 = #call meta_cell_get(#lea(%sc, 2512, 1, 0))
  %o1l = #call meta_cell_get(#lea(%sc, 2520, 1, 0))
  %o1h = #call meta_cell_get(#lea(%sc, 2528, 1, 0))
  %w7 = #call meta_emit_ref2(%base, %len, %o1, %o1l, %o1h)
  %rp = #data_addr meta_rparen
  %w8 = #call lain_meta_emit_write(%rp, 1)
  %nl = #data_addr meta_st_nl
  %w9 = #call lain_meta_emit_write(%nl, 1)
  #return 0
}


#proc meta_lower_loop(%base: #addr, %len: #bits<64>,
                      %parent: #bits<64>, %index: #bits<64>,
                      %n_lo: #bits<64>, %n_hi: #bits<64>) -> #bits<32> {
  // 形状：`loop` 标签 参数组 `while` 条件… 循环体组 `;`
  // `meta_cursor_next(p, i)` 取的是 p 的孩子 `i + 1`：循环头三格依次是
  // 标签、参数组、`while` 词。
  %label = #call meta_cursor_next(%parent, %index)
  %pgrp = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 1))
  %wh = #call meta_cursor_next(%parent, #add[#bits<64>](%index, 2))
  %lk = #call meta_node_kind(%label)
  %lab_ok = #eq[#bits<64>](%lk, 1)
  %pk = #call meta_node_kind(%pgrp)
  %pgrp_ok = #eq[#bits<64>](%pk, 2)
  %w_ok = #call meta_node_is_word(%wh, %base, #data_addr meta_kw_while, 5)
  %h0 = #and[#bits<1>](%lab_ok, %pgrp_ok)
  %head = #and[#bits<1>](%h0, %w_ok)
  %badhead = #eq[#bits<1>](%head, 0)
  #if %badhead {
    %f0 = #call lain_meta_fail(4)
    #return 4
  }
  // 参数个数：`名字 冒号 类型 等号 初值` 五格一组，组间一个逗号：n = (孩子数 + 1) / 6
  %pc = #call ast_child_count(%pgrp)
  %nparam = #udiv[#bits<64>](#add[#bits<64>](%pc, 1), 6)
  %no_par = #eq[#bits<64>](%nparam, 0)
  %too_many = #ugt[#bits<64>](%nparam, 8)
  %badn = #or[#bits<1>](%no_par, %too_many)
  #if %badn {
    %f1 = #call lain_meta_fail(4)
    #return 4
  }
  // 块布局：+0 水位，+8 参数个数，+16 循环编号，+24 acc 的 kind（哨兵 = 还没找到），
  // +32 acc 的宽度，+40/+48 acc 的名字窗口，+56/+64 标签窗口，+72/+80 acc 的类型窗口，
  // +88 + k*96 参数 k：名字起/止、kind、宽度、当前值、初值引用/起/止、类型窗口、
  // 显式 `continue` 实参的窗口（起 +80、止 +88，止为 0 表示没有）。
  %mark = #call meta_bump_mark()
  %bytes = #add[#bits<64>](88, #mul[#bits<64>](%nparam, 96))
  %blk = #call meta_bump_alloc(%bytes)
  %noblk = #eq[#bits<64>](%blk, 0xFFFFFFFFFFFFFFFF)
  #if %noblk {
    // 分配器已经报过 17
    #return 17
  }
  %sc = #call lain_meta_scratch_data()
  %b = #lea(%sc, %blk, 1, 0)
  %s0 = #call meta_cell_put(#lea(%b, 8, 1, 0), %nparam)
  %s1 = #call meta_cell_put(#lea(%b, 24, 1, 0), 0xFFFFFFFFFFFFFFFF)
  %lab_at = #call meta_node_start(%label)
  %lab_hi = #add[#bits<64>](%lab_at, #call meta_node_len(%label))
  %s2 = #call meta_cell_put(#lea(%b, 56, 1, 0), %lab_at)
  %s3 = #call meta_cell_put(#lea(%b, 64, 1, 0), %lab_hi)
  %lp_n = #call meta_next_temp()
  %s4 = #call meta_cell_put(#lea(%b, 16, 1, 0), %lp_n)
  // 标签与编号同时记进暂存区固定格（d3 解析带名字的 break / continue 要看它们）
  %s5 = #call meta_cell_put(#lea(%sc, 2432, 1, 0), %lab_at)
  %s6 = #call meta_cell_put(#lea(%sc, 2440, 1, 0), %lab_hi)
  %s7 = #call meta_cell_put(#lea(%sc, 2448, 1, 0), %lp_n)

  // 第一趟：每个参数的声明（名字、类型、acc 是哪一个）进块。
  %decl = #loop d(%k: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%k, %nparam)
    #if %more {
      %bi6 = #mul[#bits<64>](%k, 6)
      %nm = #call ast_child(%pgrp, %bi6)
      %col = #call ast_child(%pgrp, #add[#bits<64>](%bi6, 1))
      %ty = #call ast_child(%pgrp, #add[#bits<64>](%bi6, 2))
      %eqn = #call ast_child(%pgrp, #add[#bits<64>](%bi6, 3))
      %nk = #call meta_node_kind(%nm)
      %n_ok = #eq[#bits<64>](%nk, 1)
      %c_ok = #call meta_node_is_word(%col, %base, #data_addr meta_kw_colon, 1)
      %e_ok = #call meta_node_is_word(%eqn, %base, #data_addr meta_kw_eq, 1)
      %o0 = #and[#bits<1>](%n_ok, %c_ok)
      %shape = #and[#bits<1>](%o0, %e_ok)
      %bad = #eq[#bits<1>](%shape, 0)
      #if %bad {
        %fd = #call lain_meta_fail(4)
        #break d(%fd)
      }
      %t_lo = #call meta_node_start(%ty)
      %t_hi = #add[#bits<64>](%t_lo, #call meta_node_len(%ty))
      %tid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
      %no_type = #eq[#bits<64>](%tid, 0)
      #if %no_type {
        %ft = #call lain_meta_fail(5)
        #break d(%ft)
      }
      %info = #call meta_tid_repr(%tid)
      %kd = #and[#bits<64>](%info, 255)
      %wd = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)
      %n_at = #call meta_node_start(%nm)
      %n_hi2 = #add[#bits<64>](%n_at, #call meta_node_len(%nm))
      %pslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
      %q = #lea(%b, %pslot, 1, 0)
      %p0 = #call meta_cell_put(%q, %n_at)
      %p1 = #call meta_cell_put(#lea(%q, 8, 1, 0), %n_hi2)
      %p2 = #call meta_cell_put(#lea(%q, 16, 1, 0), %kd)
      %p3 = #call meta_cell_put(#lea(%q, 24, 1, 0), %wd)
      %p4 = #call meta_cell_put(#lea(%q, 32, 1, 0), 0xFFFFFFFFFFFFFFFF)
      // 声明的类型窗口：`continue` 的实参按它降级（上下文类型）
      %p5 = #call meta_cell_put(#lea(%q, 64, 1, 0), %t_lo)
      %p6 = #call meta_cell_put(#lea(%q, 72, 1, 0), %t_hi)
      %p7 = #call meta_cell_put(#lea(%q, 80, 1, 0), 0)
      %p8 = #call meta_cell_put(#lea(%q, 88, 1, 0), 0)
      // `acc`：循环的值。名字长度先对，再逐字节比。
      %nlen = #sub[#bits<64>](%n_hi2, %n_at)
      %len3 = #eq[#bits<64>](%nlen, 3)
      %isacc = #if %len3 -> (#bits<1>) {
        %eqb = #call meta_bytes_equal(#lea(%base, %n_at, 1, 0),
                                       #data_addr meta_kw_acc, 3)
        #yield %eqb
      } else {
        #yield 0
      }
      #if %isacc {
        %a0 = #call meta_cell_put(#lea(%b, 24, 1, 0), %kd)
        %a1 = #call meta_cell_put(#lea(%b, 32, 1, 0), %wd)
        %a2 = #call meta_cell_put(#lea(%b, 40, 1, 0), %n_at)
        %a3 = #call meta_cell_put(#lea(%b, 48, 1, 0), %n_hi2)
        %a4 = #call meta_cell_put(#lea(%b, 72, 1, 0), %t_lo)
        %a5 = #call meta_cell_put(#lea(%b, 80, 1, 0), %t_hi)
      }
      #continue d(#add[#bits<64>](%k, 1))
    } else {
      #break d(0)
    }
  }
  %dbad = #ne[#bits<32>](%decl, 0)
  #if %dbad {
    %rel0 = #call meta_bump_release(%mark)
    #return %decl
  }
  // 没有叫 `acc` 的参数，循环就没有值可取
  %akd0 = #call meta_cell_get(#lea(%b, 24, 1, 0))
  %no_acc = #eq[#bits<64>](%akd0, 0xFFFFFFFFFFFFFFFF)
  #if %no_acc {
    %fa0 = #call lain_meta_fail(4)
    %rel1 = #call meta_bump_release(%mark)
    #return 4
  }

  // 第二趟：初值各降级成一条表达式。指令**发在 `#loop` 那一行之前**（LAINIR 的循环
  // 参数初值在父区域求值），所以先把引用与源码范围存进块，再写表头。
  %inits = #loop i(%k: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%k, %nparam)
    #if %more {
      %bi6 = #mul[#bits<64>](%k, 6)
      %ty = #call ast_child(%pgrp, #add[#bits<64>](%bi6, 2))
      %t_lo = #call meta_node_start(%ty)
      %t_hi = #add[#bits<64>](%t_lo, #call meta_node_len(%ty))
      %pslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
      %q = #lea(%b, %pslot, 1, 0)
      %kd = #call meta_cell_get(#lea(%q, 16, 1, 0))
      %wd = #call meta_cell_get(#lea(%q, 24, 1, 0))
      %ii = #add[#bits<64>](%bi6, 4)
      %est = #call meta_emit_expr(%base, %len, %kd, %wd, %t_lo, %t_hi,
                                  %pgrp, %ii, 0, 0, 0, 0)
      %ibad = #ne[#bits<32>](%est, 0)
      #if %ibad {
        #break i(%est)
      }
      %ref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %lo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
      %hi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
      %w0 = #call meta_cell_put(#lea(%q, 40, 1, 0), %ref)
      %w1 = #call meta_cell_put(#lea(%q, 48, 1, 0), %lo)
      %w2 = #call meta_cell_put(#lea(%q, 56, 1, 0), %hi)
      #continue i(#add[#bits<64>](%k, 1))
    } else {
      #break i(0)
    }
  }
  %ibadv = #ne[#bits<32>](%inits, 0)
  #if %ibadv {
    %rel2 = #call meta_bump_release(%mark)
    #return %inits
  }

  // 表头：`  %NAME = #loop L<n>(%p1: T1 = <初值>, …) -> (Ta) {`
  %pct = #data_addr meta_st_pct
  %h1 = #call lain_meta_emit_write(%pct, 3)
  %nm_at = #lea(%base, %n_lo, 1, 0)
  %nm_n = #sub[#bits<64>](%n_hi, %n_lo)
  %h2 = #call lain_meta_emit_write(%nm_at, %nm_n)
  %lop = #data_addr meta_st_loopopen
  %h3 = #call lain_meta_emit_write(%lop, 10)
  %h4 = #call meta_emit_uint(%lp_n)
  %lp = #data_addr meta_fn_lparen
  %h5 = #call lain_meta_emit_write(%lp, 1)
  %hdr = #loop h(%k: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%k, %nparam)
    #if %more {
      #if #ne[#bits<64>](%k, 0) {
        %cs = #data_addr meta_o4
        %wc = #call lain_meta_emit_write(%cs, 2)
      }
      %pslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
      %q = #lea(%b, %pslot, 1, 0)
      %n_at = #call meta_cell_get(%q)
      %n_hi2 = #call meta_cell_get(#lea(%q, 8, 1, 0))
      %kd = #call meta_cell_get(#lea(%q, 16, 1, 0))
      %wd = #call meta_cell_get(#lea(%q, 24, 1, 0))
      %iref = #call meta_cell_get(#lea(%q, 40, 1, 0))
      %ilo = #call meta_cell_get(#lea(%q, 48, 1, 0))
      %ihi = #call meta_cell_get(#lea(%q, 56, 1, 0))
      %w3 = #call meta_emit_operand(%base, %n_at, %n_hi2, %len)
      %col = #data_addr meta_fn_colon
      %w4 = #call lain_meta_emit_write(%col, 2)
      %w5 = #call meta_emit_repr(%kd, %wd)
      %eqs = #data_addr meta_st_eqop
      %w6 = #call lain_meta_emit_write(%eqs, 3)
      %w7 = #call meta_emit_ref2(%base, %len, %iref, %ilo, %ihi)
      #continue h(#add[#bits<64>](%k, 1))
    } else {
      #break h(0)
    }
  }
  %rl = #data_addr meta_st_rlpar
  %h6 = #call lain_meta_emit_write(%rl, 6)
  %akd = #call meta_cell_get(#lea(%b, 24, 1, 0))
  %awd = #call meta_cell_get(#lea(%b, 32, 1, 0))
  %h7 = #call meta_emit_repr(%akd, %awd)
  %lh = #data_addr meta_st_lhead
  %h8 = #call lain_meta_emit_write(%lh, 4)

  // 条件：从 `while` 后面一格起，吃到循环体那个 `{` 组为止（表达式的终点判定已认它）。
  %ct_lo = #call meta_cell_get(#lea(%b, 72, 1, 0))
  %ct_hi = #call meta_cell_get(#lea(%b, 80, 1, 0))
  %cond_i = #add[#bits<64>](%index, 4)
  %cest = #call meta_emit_expr(%base, %len, %akd, %awd, %ct_lo, %ct_hi,
                               %parent, %cond_i, 0, 0, 0, 0)
  %cbad = #ne[#bits<32>](%cest, 0)
  #if %cbad {
    %rel3 = #call meta_bump_release(%mark)
    #return %cest
  }
  %cref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
  %clo = #call meta_cell_get(#lea(%sc, 176, 1, 0))
  %chi = #call meta_cell_get(#lea(%sc, 184, 1, 0))
  %bi = #call meta_cell_get(#lea(%sc, 192, 1, 0))
  %body = #call ast_child(%parent, %bi)
  %bk = #call meta_node_kind(%body)
  %isgrp = #eq[#bits<64>](%bk, 2)
  %notgrp = #eq[#bits<1>](%isgrp, 0)
  #if %notgrp {
    %fb0 = #call lain_meta_fail(4)
    %rel4 = #call meta_bump_release(%mark)
    #return 4
  }
  %c1 = #call lainir_indent4_write()
  %c2 = #call lainir_if_head_write()
  %c3 = #call meta_emit_ref2(%base, %len, %cref, %clo, %chi)
  %c4 = #call lainir_open_body()

  // 循环体里的 `break`/`continue` 靠暂存区 2456 找当前循环（嵌套时取最近一层）。
  %reg_cell = #lea(%sc, 2456, 1, 0)
  %reg_prev = #call meta_cell_get(%reg_cell)
  %reg_set = #call meta_cell_put(%reg_cell, %blk)
  // 循环体里出现过终止指令（`break`/`continue`）之后，剩余语句与收尾的
  // `#continue`/`#break` 都不再发 —— 区域里终止指令必须是最后一条。
  %term_cell = #lea(%sc, 2464, 1, 0)
  %term0 = #call meta_cell_put(%term_cell, 0)

  // 循环体：一串 `参数 = 表达式;` 与 `break`/`continue`。只动参数，别的目标一律报 4。
  %bcount = #call ast_child_count(%body)
  %sts = #loop s(%si: #bits<64> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%si, %bcount)
    #if %more {
      %nm = #call ast_child(%body, %si)
      // 显式跳转：`break LABEL(值);` / `continue LABEL(实参…);`
      %isbrk2 = #call meta_node_is_word(%nm, %base, #data_addr meta_kw_break, 5)
      %iscont2 = #call meta_node_is_word(%nm, %base, #data_addr meta_kw_continue, 8)
      %isjump = #or[#bits<1>](%isbrk2, %iscont2)
      #if %isjump {
        %ji = #call meta_find_semi_index(%base, %body, %si)
        %jnos = #eq[#bits<64>](%ji, 0xFFFFFFFFFFFFFFFF)
        #if %jnos {
          %fbj = #call lain_meta_fail(4)
          #break s(%fbj)
        }
        %jr = #call meta_lower_loop_jump(%base, %len, %body, %si)
        %jrbad = #ne[#bits<32>](%jr, 0)
        #if %jrbad {
          #break s(%jr)
        }
        #break s(0)
      }
      %eqn = #call ast_child(%body, #add[#bits<64>](%si, 1))
      %nk = #call meta_node_kind(%nm)
      %n_ok = #eq[#bits<64>](%nk, 1)
      %e_ok = #call meta_node_is_word(%eqn, %base, #data_addr meta_kw_eq, 1)
      %shape = #and[#bits<1>](%n_ok, %e_ok)
      %bad = #eq[#bits<1>](%shape, 0)
      #if %bad {
        %fb1 = #call lain_meta_fail(4)
        #break s(%fb1)
      }
      %n_at = #call meta_node_start(%nm)
      %n_hi2 = #add[#bits<64>](%n_at, #call meta_node_len(%nm))
      %nlen = #sub[#bits<64>](%n_hi2, %n_at)
      %kidx = #loop f(%k: #bits<64> = 0) -> (#bits<64>) {
        %km = #ult[#bits<64>](%k, %nparam)
        %r = #if %km -> (#bits<64>) {
          %kslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
          %kq = #lea(%b, %kslot, 1, 0)
          %pn_lo = #call meta_cell_get(%kq)
          %pn_hi = #call meta_cell_get(#lea(%kq, 8, 1, 0))
          %plen = #sub[#bits<64>](%pn_hi, %pn_lo)
          %lenok = #eq[#bits<64>](%plen, %nlen)
          %same = #if %lenok -> (#bits<1>) {
            %eqb = #call meta_bytes_equal(#lea(%base, %pn_lo, 1, 0),
                                           #lea(%base, %n_at, 1, 0), %plen)
            #yield %eqb
          } else {
            #yield 0
          }
          %hit = #if %same -> (#bits<64>) {
            #yield %k
          } else {
            #continue f(#add[#bits<64>](%k, 1))
          }
          #yield %hit
        } else {
          #break f(0xFFFFFFFFFFFFFFFF)
        }
        #yield %r
      }
      %nomatch = #eq[#bits<64>](%kidx, 0xFFFFFFFFFFFFFFFF)
      #if %nomatch {
        %fn0 = #call lain_meta_fail(4)
        #break s(%fn0)
      }
      %kslot = #add[#bits<64>](88, #mul[#bits<64>](%kidx, 96))
      %kq = #lea(%b, %kslot, 1, 0)
      %kd = #call meta_cell_get(#lea(%kq, 16, 1, 0))
      %wd = #call meta_cell_get(#lea(%kq, 24, 1, 0))
      %bi6 = #mul[#bits<64>](%kidx, 6)
      %ty = #call ast_child(%pgrp, #add[#bits<64>](%bi6, 2))
      %t_lo = #call meta_node_start(%ty)
      %t_hi = #add[#bits<64>](%t_lo, #call meta_node_len(%ty))
      %vi = #add[#bits<64>](%si, 2)
      %est = #call meta_emit_expr(%base, %len, %kd, %wd, %t_lo, %t_hi,
                                  %body, %vi, 1, 0, 0, 0)
      %sbad = #ne[#bits<32>](%est, 0)
      #if %sbad {
        #break s(%est)
      }
      %sref = #call meta_cell_get(#lea(%sc, 168, 1, 0))
      %send = #call meta_cell_get(#lea(%sc, 192, 1, 0))
      %sw = #call meta_cell_put(#lea(%kq, 32, 1, 0), %sref)
      #continue s(#add[#bits<64>](%send, 1))
    } else {
      #break s(0)
    }
  }
  %reg_back = #call meta_cell_put(%reg_cell, %reg_prev)
  %term = #call meta_cell_get(%term_cell)
  %sbad2 = #ne[#bits<32>](%sts, 0)
  #if %sbad2 {
    %rel5 = #call meta_bump_release(%mark)
    #return %sts
  }

  // `    #continue L<n>(<参数值…>)`：参数按声明顺序；一轮里没被赋值的参数把**自己的
  // 当前值**传下去（它的名字就是 `#loop` 绑的那个）。
  %termbad = #ne[#bits<64>](%term, 0)
  %epi = #if %termbad -> (#bits<32>) {
    #yield 0
  } else {
    %cont = #data_addr meta_st_ind4cont
    %v1 = #call lain_meta_emit_write(%cont, 15)
    %v2 = #call meta_emit_uint(%lp_n)
    %lp2 = #data_addr meta_fn_lparen
    %v3 = #call lain_meta_emit_write(%lp2, 1)
    %vals = #loop v(%k: #bits<64> = 0) -> (#bits<32>) {
      %more = #ult[#bits<64>](%k, %nparam)
      #if %more {
        #if #ne[#bits<64>](%k, 0) {
          %cs = #data_addr meta_o4
          %wc = #call lain_meta_emit_write(%cs, 2)
        }
        %pslot = #add[#bits<64>](88, #mul[#bits<64>](%k, 96))
        %q = #lea(%b, %pslot, 1, 0)
        %cur = #call meta_cell_get(#lea(%q, 32, 1, 0))
        %isnone = #eq[#bits<64>](%cur, 0xFFFFFFFFFFFFFFFF)
        %wv = #if %isnone -> (#bits<32>) {
          // 显式 `continue L(…)` 写过这个参数就用它的实参窗口，否则发参数自己的名字
          %ex_hi = #call meta_cell_get(#lea(%q, 88, 1, 0))
          %has_ex = #ne[#bits<64>](%ex_hi, 0)
          %we = #if %has_ex -> (#bits<32>) {
            %ex_lo = #call meta_cell_get(#lea(%q, 80, 1, 0))
            %wx = #call meta_emit_operand(%base, %ex_lo, %ex_hi, %len)
            #yield %wx
          } else {
            %pn_lo = #call meta_cell_get(%q)
            %pn_hi = #call meta_cell_get(#lea(%q, 8, 1, 0))
            %wp = #call meta_emit_operand(%base, %pn_lo, %pn_hi, %len)
            #yield %wp
          }
          #yield %we
        } else {
          %wt = #call meta_emit_temp_name(%cur)
          #yield %wt
        }
        #continue v(#add[#bits<64>](%k, 1))
      } else {
        #break v(0)
      }
    }
    %rp = #data_addr meta_st_rp
    %v4 = #call lain_meta_emit_write(%rp, 2)
    #yield 0
  }
  // `    }`：条件为假时从 `#if` 之后落下，`#break` 带走 `acc`
  %cl = #data_addr meta_st_ind4cl
  %v5 = #call lain_meta_emit_write(%cl, 6)
  %brk2 = #if %termbad -> (#bits<32>) {
    #yield 0
  } else {
    %brk = #data_addr meta_st_ind4brk
    %v6 = #call lain_meta_emit_write(%brk, 12)
    %v7 = #call meta_emit_uint(%lp_n)
    %lp3 = #data_addr meta_fn_lparen
    %v8 = #call lain_meta_emit_write(%lp3, 1)
    %a_lo = #call meta_cell_get(#lea(%b, 40, 1, 0))
    %a_hi = #call meta_cell_get(#lea(%b, 48, 1, 0))
    %v9 = #call meta_emit_operand(%base, %a_lo, %a_hi, %len)
    %rp2 = #data_addr meta_st_rp
    %v10 = #call lain_meta_emit_write(%rp2, 2)
    #yield 0
  }
  %le = #data_addr meta_st_lend
  %v11 = #call lain_meta_emit_write(%le, 4)
  %rel6 = #call meta_bump_release(%mark)
  #return 0
}

#proc meta_lower_body(%base: #addr, %len: #bits<64>,
                      %body: #bits<64>, %r_t_lo: #bits<64>,
                      %r_t_hi: #bits<64>) -> #bits<32> {
  // 诊断（走宿主槽，不落暂存区）：进入次数、body 引用、孩子个数。
  %dbg2 = #call ast_child_count(%body)
  %st = #loop stmts(%si: #bits<64> = 0,
                    %saw_ret: #bits<1> = 0) -> (#bits<32>) {
    %more = #ult[#bits<64>](%si, %dbg2)
    #if %more {
      %c = #call ast_child(%body, %si)
      // `if` 先分出去：它的 `;` 语义跟别的语句不一样（`meta_find_semi` 会一路找到
      // **后面**那条语句的 `;`，因为块里的 `;` 在组里面、不是兄弟）。
      %ck = #call meta_node_form(%body, %si)
      %is_if = #eq[#bits<64>](%ck, 11)
      #if %is_if {
        %ist = #call meta_lower_if(%base, %len, %body, %si, %c, %r_t_lo,
                                   %r_t_hi)
        %ibad = #ne[#bits<32>](%ist, 0)
        #if %ibad {
          #break stmts(%ist)
        }
        // 下一条语句从哪继续：条件是多 token 时块的位置不是常数，所以由
        // `meta_lower_if` 把「整条 if 之后的下标」和「有没有 else」写在暂存区
        // 2408/2416（它在返回前最后才写，块里的嵌套 if 覆盖不掉）。跳错的话
        // `else` 后面那个块会被当成一条新语句去 `meta_find_semi`，报一个跟真实原因
        // 无关的 21。
        %isc = #call lain_meta_scratch_data()
        %next0 = #call meta_cell_get(#lea(%isc, 2408, 1, 0))
        %eflag = #call meta_cell_get(#lea(%isc, 2416, 1, 0))
        %has_else = #ne[#bits<64>](%eflag, 0)
        // 有 `else` 说明两支都以 `return` 收尾（`meta_lower_body` 逼的），所以这条
        // 语句一定终结 —— `saw_ret` 跟着置 1。没有 `else` 就保持原样。
        #continue stmts(%next0, %has_else)
      }
      %semi_i = #call meta_find_semi_index(%base, %body, %si)
      %nosemi = #eq[#bits<64>](%semi_i, 0xFFFFFFFFFFFFFFFF)
      #if %nosemi {
        %f0 = #call lain_meta_fail(21)
        #break stmts(21)
      }
      // `;` 在哪个下标：语句从 %si 起，`;` 是这条语句的最后一格。
      %semi = #call ast_child(%body, %semi_i)
      // 内存写是**语句**（#store 没有结果），所以在这里接，不走表达式那条路。
      %is_store = #call meta_node_is_word(%c, %base, #data_addr meta_kw_store, 5)
      #if %is_store {
        %sst = #call meta_lower_store(%base, %len, %body, %si, %r_t_lo,
                                      %r_t_hi)
        %sbad3 = #ne[#bits<32>](%sst, 0)
        #if %sbad3 {
          #break stmts(%sst)
        }
        %snext = #add[#bits<64>](%semi_i, 1)
        #continue stmts(%snext, 0)
      }
      %handler = #call meta_syntax_lookup(%c, 1, 0, 2)
      %is_ret = #eq[#bits<64>](%handler, 8)
      %is_let = #eq[#bits<64>](%handler, 9)
      %s = #if %is_ret -> (#bits<32>) {
        %rvi = #add[#bits<64>](%si, 1)
        %r = #call meta_lower_stmt(%base, %len, %body, %si, %rvi, %semi, 1,
                                   0, 0, %r_t_lo, %r_t_hi)
        #yield %r
      } else {
        %l = #if %is_let -> (#bits<32>) {
          %ni = #add[#bits<64>](%si, 1)
          %name_node = #call ast_child(%body, %ni)
          %ai = #add[#bits<64>](%si, 2)
          %after = #call ast_child(%body, %ai)
          %ckw = #data_addr meta_kw_colon
          %has_colon = #call meta_node_is_word(%after, %base, %ckw, 1)
          %x = #if %has_colon -> (#bits<32>) {
            %ti = #add[#bits<64>](%si, 3)
            %t_node = #call ast_child(%body, %ti)
            %eqi = #add[#bits<64>](%si, 4)
            %eq_node = #call ast_child(%body, %eqi)
            %vi = #add[#bits<64>](%si, 5)
            %v = #call ast_child(%body, %vi)
            %t_lo = #call meta_node_start(%t_node)
            %t_hi = #add[#bits<64>](%t_lo, #call meta_node_len(%t_node))
            %n_lo = #call meta_node_start(%name_node)
            %n_hi = #add[#bits<64>](%n_lo,
                                    #call meta_node_len(%name_node))
            // `= for ...` 是循环，不是值：整条 `for` 自己发 `#loop`，
            // 结果绑在这个 `let` 的名字上。`for` 的位置就是 `%vi`。
            %for_handler = #call meta_syntax_lookup(%v, 1, 0, 2)
            %is_for = #eq[#bits<64>](%for_handler, 10)
            // `= loop …` 也是循环，但它不需要绑定的标注：循环参数自带类型，
            // 结果的宽度取名字是 `acc` 的那个参数声明的类型。
            %is_loop = #eq[#bits<64>](%for_handler, 13)
            %b = #if %is_for -> (#bits<32>) {
              %fr = #call meta_lower_for(%base, %len, %body, %vi, %n_lo,
                                         %n_hi, %t_lo, %t_hi)
              #yield %fr
            } else {
              %lb = #if %is_loop -> (#bits<32>) {
                %lr = #call meta_lower_loop(%base, %len, %body, %vi,
                                             %n_lo, %n_hi)
                #yield %lr
              } else {
                %st = #call meta_lower_stmt(%base, %len, %body, %si, %vi,
                                            %semi, 0, %n_lo, %n_hi, %t_lo,
                                            %t_hi)
                #yield %st
              }
              #yield %lb
            }
            #yield %b
          } else {
            // 没有类型标注：`let y = <值>;`。值在 si+3（`let`、名字、`=`、值）。
            // 类型窗口从**值**求（见 `meta_value_type_window`）：调用取被调方声明的
            // 返回类型、参数名取参数表、括号往里一层；都不是就退回本函数的返回类型
            // 当上下文 —— 本地变量本来就没有类型来源（`meta_word_type_name` 只认参数）。
            %eq_i2 = #add[#bits<64>](%si, 2)
            %eq_n2 = #call ast_child(%body, %eq_i2)
            %eqkw = #data_addr meta_kw_eq
            %is_eq2 = #call meta_node_is_word(%eq_n2, %base, %eqkw, 1)
            %y = #if %is_eq2 -> (#bits<32>) {
              %vi2 = #add[#bits<64>](%si, 3)
              %v2 = #call ast_child(%body, %vi2)
              %for_h2 = #call meta_syntax_lookup(%v2, 1, 0, 2)
              %is_for2 = #eq[#bits<64>](%for_h2, 10)
              %no_for2 = #eq[#bits<1>](%is_for2, 0)
              %n2_lo = #call meta_node_start(%name_node)
              %n2_hi = #add[#bits<64>](%n2_lo,
                                        #call meta_node_len(%name_node))
              %is_loop2 = #eq[#bits<64>](%for_h2, 13)
              %z = #if %no_for2 -> (#bits<32>) {
                %z2 = #if %is_loop2 -> (#bits<32>) {
                  %lr2 = #call meta_lower_loop(%base, %len, %body, %vi2,
                                                %n2_lo, %n2_hi)
                  #yield %lr2
                } else {
                  // `let b = load(p);`：内建返回值的宽度只能来自期望类型，值本身
                  // 推不出来 —— 拒，不猜（曾经拿本函数的返回类型顶上）。
                  %v2_at = #call meta_node_start(%v2)
                  %v2_hi = #add[#bits<64>](%v2_at,
                                            #call meta_node_len(%v2))
                  %v2_prim = #call meta_is_builtin_name(%base, %v2_at, %v2_hi)
                  %st2 = #if %v2_prim -> (#bits<32>) {
                    %f1d = #call lain_meta_fail(4)
                    #yield 4
                  } else {
                    %vt_lo = #call meta_value_type_window(%base, %len, %body, %vi2,
                                                          %r_t_lo, %r_t_hi)
                    %tsc = #call lain_meta_scratch_data()
                    %vt_hi = #call meta_cell_get(#lea(%tsc, 0, 1, 0))
                    %st3 = #call meta_lower_stmt(%base, %len, %body, %si, %vi2,
                                                 %semi, 0, %n2_lo, %n2_hi, %vt_lo,
                                                 %vt_hi)
                    #yield %st3
                  }
                  #yield %st2
                }
                #yield %z2
              } else {
                // `let y = for ...` 要累加器的类型才发得出 `#loop` 的结果宽度；
                // `loop` 不用（参数自带类型），`%no_for2` 那一支接两种循环。
                %f1b = #call lain_meta_fail(21)
                #yield 21
              }
              #yield %z
            } else {
              // 形状不像 `let 名字 = …`
              %f1c = #call lain_meta_fail(21)
              #yield 21
            }
            #yield %y
          }
          #yield %x
        } else {
          %f2 = #call lain_meta_fail(4)
          #yield 4
        }
        #yield %l
      }
      %bad = #ne[#bits<32>](%s, 0)
      #if %bad {
        #break stmts(%s)
      }
      // 下一条语句从 `;` 的下一格继续。`;` 是普通词，节点身份不决定后继 ——
      // 位置才决定。
      %nxsi = #add[#bits<64>](%semi_i, 1)
      #continue stmts(%nxsi, %is_ret)
    } else {
      %ok = #if %saw_ret -> (#bits<32>) {
        #yield 0
      } else {
        // 函数体结尾没有 return：LAINIR 的过程体必须以终结子收尾
        %f3 = #call lain_meta_fail(20)
        #yield 20
      }
      #break stmts(%ok)
    }
  }
  #return %st
}

// `%node` 这个词是不是**当前函数**的参数？是就回它**类型名**的起点（终点写进暂存区
// `+0` —— 那儿空着），不是回「无」。
//
// 「当前函数」靠 `+504`（`meta_lower_func` 写进去的参数组节点）。不建表：现走参数组的
// 孩子，找「名字 `:` 类型」这种形状，名字对上才算。**必须核对后面跟的是 `:`** ——
// 不然参数名碰巧和某个类型名同名时会认错。
#proc meta_word_type_name(%base: #addr, %len: #bits<64>,
                           %node: #bits<64>) -> #bits<64> {
  %k = #call meta_node_kind(%node)
  // AstIn 的物理 kind 始终是 Token=1 或 Group=2；语法形状只在旁表。
  %is_word = #eq[#bits<64>](%k, 1)
  %r = #if %is_word -> (#bits<64>) {
    %sc = #call lain_meta_scratch_data()
    %pn = #call meta_cell_get(#lea(%sc, 504, 1, 0))
    %gone = #eq[#bits<64>](%pn, 0)
    %hit = #if %gone -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %n_at = #call meta_node_start(%node)
      %n_hi = #add[#bits<64>](%n_at, #call meta_node_len(%node))
      // 参数组的第 0 个位置就是第一个参数 —— 扫描从游标 (参数组, 0) 开始。
      %f = #call meta_param_scan(%base, %len, %pn, 0, %n_at, %n_hi)
      #yield %f
    }
    #yield %hit
  } else {
    #yield 0xFFFFFFFFFFFFFFFF
  }
  #return %r
}

// 在参数组的孩子序列里找名字是 `[n_at, n_hi)` 的那个参数，回它类型名的起点（终点写
// `+0`）。找不到回「查不到」（非引用域）。吃游标 `(参数组, 下标)`。
#proc meta_param_scan(%base: #addr, %len: #bits<64>, %group: #bits<64>,
                       %index: #bits<64>, %n_at: #bits<64>,
                       %n_hi: #bits<64>) -> #bits<64> {
  %n_n = #sub[#bits<64>](%n_hi, %n_at)
  %count = #call ast_child_count(%group)
  %r = #loop s(%i: #bits<64> = %index) -> (#bits<64>) {
    %more = #ult[#bits<64>](%i, %count)
    #if %more {
      %c = #call ast_child(%group, %i)
      %c_at = #call meta_node_start(%c)
      %c_hi = #add[#bits<64>](%c_at, #call meta_node_len(%c))
      %c_n = #sub[#bits<64>](%c_hi, %c_at)
      %same_len = #eq[#bits<64>](%c_n, %n_n)
      %same = #if %same_len -> (#bits<1>) {
        %p = #lea(%base, %c_at, 1, 0)
        %q = #lea(%base, %n_at, 1, 0)
        %e = #call meta_bytes_equal(%p, %q, %c_n)
        #yield %e
      } else {
        #yield 0
      }
      %is_name = #if %same -> (#bits<64>) {
        // 名字后面必须正好是 `:`：那是**下一个位置**。
        %nx = #call meta_cursor_next(%group, %i)
        %nx_at = #call meta_node_start(%nx)
        %b = #call bs_byte_at(%base, %nx_at, %len)
        %is_colon = #eq[#bits<8>](%b, 58)
        %t = #if %is_colon -> (#bits<64>) {
          %tn = #call meta_cursor_next(%group, #add[#bits<64>](%i, 1))
          %t_lo = #call meta_node_start(%tn)
          %t_hi = #add[#bits<64>](%t_lo, #call meta_node_len(%tn))
          %sc = #call lain_meta_scratch_data()
          %s = #call meta_cell_put(#lea(%sc, 0, 1, 0), %t_hi)
          #yield %t_lo
        } else {
          #yield 0xFFFFFFFFFFFFFFFF
        }
        #yield %t
      } else {
        #yield 0xFFFFFFFFFFFFFFFF
      }
      %miss = #eq[#bits<64>](%is_name, 0xFFFFFFFFFFFFFFFF)
      #if %miss {
        %i2 = #add[#bits<64>](%i, 1)
        #continue s(%i2)
      }
      #break s(%is_name)
    } else {
      #break s(0xFFFFFFFFFFFFFFFF)
    }
  }
  #return %r
}

// `func NAME(p: T, ...) -> T { 语句* }`
//
// `%parent/%index` 是 `func` 这个词在顶层序列里的出现位置：名、参数组、`->`、返回
// 类型、体，全是「父组 + 下标 + n」。`%node` 仍然传进来（上游已经取到手，省一次）。
// 过程声明的**返回类型**窗口：起点是返回值，终点写进暂存区 `+0`（与
// `meta_word_type_name` 同一个约定 —— 调用方求完窗口要**紧接着**读 `+0`）。
// 找不到回「无」。
//
// 声明在作用域里的出现位置是（父组 `aux`、下标 `emitted`）；返回类型就在那个
// `func` 词的后面第 4 格 —— 与 `meta_lower_func_inner` 读的是同一个形状。按名字查表
// **不加**依赖边：调用那条路（`meta_scope_require_func`）已经加过了。
#proc meta_decl_ret_window(%name: #addr, %name_len: #bits<64>) -> #bits<64> {
  %index = #call meta_scope_find(%name, %name_len)
  %found = #ne[#bits<64>](%index, 0xFFFFFFFFFFFFFFFF)
  %kind = #if %found -> (#bits<64>) {
    %k = #call meta_scope_kind(%index)
    #yield %k
  } else { #yield 0 }
  %is_func = #eq[#bits<64>](%kind, 6)
  %r = #if %is_func -> (#bits<64>) {
    %parent = #call meta_scope_aux(%index)
    %at = #call meta_scope_emitted(%index)
    %ri = #add[#bits<64>](%at, 3)
    %ret_node = #call meta_cursor_next(%parent, %ri)
    %none = #eq[#bits<64>](%ret_node, 0)
    %w = #if %none -> (#bits<64>) {
      #yield 0xFFFFFFFFFFFFFFFF
    } else {
      %lo = #call meta_node_start(%ret_node)
      %hi = #add[#bits<64>](%lo, #call meta_node_len(%ret_node))
      %sc = #call lain_meta_scratch_data()
      %put = #call meta_cell_put(#lea(%sc, 0, 1, 0), %hi)
      #yield %lo
    }
    #yield %w
  } else {
    #yield 0xFFFFFFFFFFFFFFFF
  }
  #return %r
}

// 没有类型标注的绑定（`let y = <值>;`）：类型名窗口从**值**求出来。
//   调用 `f(...)`  -> 被调方声明的返回类型（`meta_decl_ret_window`）
//   参数名          -> 参数表里那个名字的类型（`meta_word_type_name`）
//   括号            -> 往里一层
//   其余（字面量 / 本地变量）-> 本函数的返回类型，只当**上下文**用：两个裸字面量的
//                    算子由 `meta_emit_expr` 自己退回「装得下的第一个类型」
#proc meta_value_type_window(%base: #addr, %len: #bits<64>,
                             %parent: #bits<64>, %vi: #bits<64>,
                             %r_t_lo: #bits<64>,
                             %r_t_hi: #bits<64>) -> #bits<64> {
  // `值 as T`：绑定声明的类型就是转换后的 T，与值本身的类型无关。
  %asx = #call meta_after_operand(%base, %len, %parent, %vi)
  %asc = #call ast_child(%parent, %asx)
  %asc_pos = #ne[#bits<64>](%asc, 0)
  %r_as = #if %asc_pos -> (#bits<64>) {
    %asc_kind = #call meta_node_kind(%asc)
    %asc_tok = #eq[#bits<64>](%asc_kind, 1)
    %asc_n = #call meta_node_len(%asc)
    %asc_two = #eq[#bits<64>](%asc_n, 2)
    %asc_at = #call meta_node_start(%asc)
    %asc_p = #lea(%base, %asc_at, 1, 0)
    %asc_same = #call meta_bytes_equal(%asc_p, #data_addr meta_kw_as, 2)
    %asc_a = #and[#bits<1>](%asc_tok, %asc_two)
    %asc_yes = #and[#bits<1>](%asc_a, %asc_same)
    %asc_w = #if %asc_yes -> (#bits<64>) {
      %ati = #add[#bits<64>](%asx, 1)
      %atn = #call ast_child(%parent, %ati)
      %atn_none = #eq[#bits<64>](%atn, 0)
      %asc_v = #if %atn_none -> (#bits<64>) {
        #yield 0xFFFFFFFFFFFFFFFF
      } else {
        %alo = #call meta_node_start(%atn)
        %ahi = #add[#bits<64>](%alo, #call meta_node_len(%atn))
        %asc_sc = #call lain_meta_scratch_data()
        %asc_put = #call meta_cell_put(#lea(%asc_sc, 0, 1, 0), %ahi)
        #yield %alo
      }
      #yield %asc_v
    } else {
      #yield 0xFFFFFFFFFFFFFFFF
    }
    #yield %asc_w
  } else {
    #yield 0xFFFFFFFFFFFFFFFF
  }
  %no_as = #eq[#bits<64>](%r_as, 0xFFFFFFFFFFFFFFFF)
  %r = #if %no_as -> (#bits<64>) {
  %form = #call meta_node_form(%parent, %vi)
  %is_group = #eq[#bits<64>](%form, 2)
  %r2 = #if %is_group -> (#bits<64>) {
    // 括号：值在组里面，游标进组、下标归零。
    %gv = #call ast_child(%parent, %vi)
    %gi = #call meta_value_type_window(%base, %len, %gv, 0, %r_t_lo,
                                       %r_t_hi)
    #yield %gi
  } else {
    %is_call = #eq[#bits<64>](%form, 5)
    %c = #if %is_call -> (#bits<64>) {
      %v = #call ast_child(%parent, %vi)
      %c_lo = #call meta_node_start(%v)
      %c_hi = #add[#bits<64>](%c_lo, #call meta_node_len(%v))
      %name = #lea(%base, %c_lo, 1, 0)
      %n_len = #sub[#bits<64>](%c_hi, %c_lo)
      %cwin = #call meta_decl_ret_window(%name, %n_len)
      #yield %cwin
    } else {
      %v2 = #call ast_child(%parent, %vi)
      %twin = #call meta_word_type_name(%base, %len, %v2)
      #yield %twin
    }
    %miss = #eq[#bits<64>](%c, 0xFFFFFFFFFFFFFFFF)
    %f = #if %miss -> (#bits<64>) {
      // 求不出来：退回本函数的返回类型，交给表达式发射器自己去定宽度。
      %sc = #call lain_meta_scratch_data()
      %put = #call meta_cell_put(#lea(%sc, 0, 1, 0), %r_t_hi)
      #yield %r_t_lo
    } else {
      #yield %c
    }
    #yield %f
  }
  #yield %r2
  } else {
    #yield %r_as
  }
  #return %r
}

#proc meta_lower_func(%base: #addr, %len: #bits<64>,
                      %parent: #bits<64>, %index: #bits<64>,
                      %node: #bits<64>) -> #bits<32> {
  // 参数组属于当前 lowering 调用层。旧值留在本过程的 LAINIR 调用帧中；内层返回后
  // 统一恢复共享格。mark 只负责回收内层遗漏的动态临时区，不为保存旧值额外占 scratch。
  %mark = #call meta_bump_mark()
  %scratch = #call lain_meta_scratch_data()
  %parent_params = #call meta_cell_get(#lea(%scratch, 504, 1, 0))
  %parent_decl = #call meta_cell_get(#lea(%scratch, 152, 1, 0))
  %name_node = #call meta_scope_name_of(%parent, %index)
  %name_lo = #call meta_node_start(%name_node)
  %name_len = #call meta_node_len(%name_node)
  %name = #lea(%base, %name_lo, 1, 0)
  %decl_index = #call meta_scope_find(%name, %name_len)
  %found = #ne[#bits<64>](%decl_index, 0xFFFFFFFFFFFFFFFF)
  %decl_kind = #if %found -> (#bits<64>) {
    %k = #call meta_scope_kind(%decl_index)
    #yield %k
  } else { #yield 0 }
  %is_func = #eq[#bits<64>](%decl_kind, 6)
  %identity_ok = #and[#bits<1>](%found, %is_func)
  #if #eq[#bits<1>](%identity_ok, 0) {
    %fail = #call lain_meta_fail(9414)
    %restore0 = #call meta_cell_put(#lea(%scratch, 504, 1, 0),
                                    %parent_params)
    %restore1 = #call meta_bump_release(%mark)
    #return 9414
  }
  %decl_set = #call meta_cell_put(#lea(%scratch, 152, 1, 0), %decl_index)
  %lowered = #call meta_lower_func_inner(%base, %len, %parent, %index,
                                         %node)
  %restore = #call meta_cell_put(#lea(%scratch, 504, 1, 0),
                                 %parent_params)
  %restore_decl = #call meta_cell_put(#lea(%scratch, 152, 1, 0),
                                      %parent_decl)
  %released = #call meta_bump_release(%mark)
  #return %lowered
}

#proc meta_lower_func_inner(%base: #addr, %len: #bits<64>,
                            %parent: #bits<64>, %index: #bits<64>,
                            %node: #bits<64>) -> #bits<32> {
  %ni = #add[#bits<64>](%index, 1)
  %name_node = #call meta_cursor_next(%parent, %index)
  %pi = #add[#bits<64>](%index, 2)
  %params = #call meta_cursor_next(%parent, %ni)
  // 当前函数的参数组节点记到暂存区 `+504`；外层包装负责保存并恢复调用层状态。
  // 为什么需要它：算子的操作数宽度该看**操作数自己**的类型，不是看绑定/返回的类型。
  // `func f(x: i32) -> bool { return x < 2; }` 里 `<` 的两个操作数是 i32，而 bool 的
  // op 表是空的 —— 拿绑定的类型去查表查不到 `<`。
  %scp = #call lain_meta_scratch_data()
  %sp = #call meta_cell_put(#lea(%scp, 504, 1, 0), %params)
  %ai = #add[#bits<64>](%index, 3)
  %arrow = #call meta_cursor_next(%parent, %pi)
  %ri = #add[#bits<64>](%index, 4)
  %ret_node = #call meta_cursor_next(%parent, %ai)
  %bi = #add[#bits<64>](%index, 5)
  %body = #call meta_cursor_next(%parent, %ri)

  // 诊断（安全区 1700..1740）：兄弟链每一跳。哪一跳变成 NONE 就是断点。
  %mf0 = #call lain_meta_scratch_data()
  %mfp0 = #call meta_cell_put(#lea(%mf0, 1700, 1, 0), %node)
  %mfp1 = #call meta_cell_put(#lea(%mf0, 1708, 1, 0), %name_node)
  %mfp2 = #call meta_cell_put(#lea(%mf0, 1716, 1, 0), %params)
  %mfp3 = #call meta_cell_put(#lea(%mf0, 1724, 1, 0), %arrow)
  %mfp4 = #call meta_cell_put(#lea(%mf0, 1732, 1, 0), %ret_node)
  %mfp5 = #call meta_cell_put(#lea(%mf0, 1740, 1, 0), %body)

  %r_lo = #call meta_node_start(%ret_node)
  %r_n = #call meta_node_len(%ret_node)
  %r_hi = #add[#bits<64>](%r_lo, %r_n)
  %hdr = #call meta_emit_proc_header(%base, %len, %name_node, %params,
                                     %ret_node)
  %hbad = #ne[#bits<32>](%hdr, 0)
  #if %hbad { #return %hdr }
  %ob = #data_addr meta_fn_open
  %w6 = #call lain_meta_emit_write(%ob, 3)
  // 语句序列
  %bst = #call meta_lower_body(%base, %len, %body, %r_lo, %r_hi)
  %bfail = #ne[#bits<32>](%bst, 0)
  #if %bfail { #return %bst }
  %ob2 = #data_addr meta_o6
  %w7 = #call lain_meta_emit_write(%ob2, 2)
  #return 0
}

// 函数头：proc 关键字 + 名字 + 参数表 + 结果类型。func 声明与 extern 声明共用它，
// 差别只在后面接函数体还是 #extern 链接名。
#proc meta_emit_proc_header(%base: #addr, %len: #bits<64>,
                             %name_node: #bits<64>, %params: #bits<64>,
                             %ret_node: #bits<64>) -> #bits<32> {
  %r_lo = #call meta_node_start(%ret_node)
  %r_n = #call meta_node_len(%ret_node)
  %r_hi = #add[#bits<64>](%r_lo, %r_n)
  %tid = #call meta_type_resolve(%base, %len, %r_lo, %r_hi)
  %no_type = #eq[#bits<64>](%tid, 0)
  %status = #if %no_type -> (#bits<32>) {
    %f0 = #call lain_meta_fail(5)
    #yield 5
  } else {
    %info = #call meta_tid_repr(%tid)
    %kind = #and[#bits<64>](%info, 255)
    %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)

    // 参数表渲染进缓冲区；循环带回「1 + 长度」，0 表示参数类型解析失败
    %buf = #data_addr lainir_text_buffer
    %colon = #data_addr meta_kw_colon
    %colon2 = #data_addr lainir_colon_text
    %comma = #data_addr lainir_comma
    %pcount = #call ast_child_count(%params)
    %pst = #loop ps(%pi2: #bits<64> = 0,
                    %lead: #bits<1> = 0,
                    %pat: #bits<64> = 0) -> (#bits<64>) {
      %more = #ult[#bits<64>](%pi2, %pcount)
      #if %more {
        %c = #call ast_child(%params, %pi2)
        %cni = #add[#bits<64>](%pi2, 1)
        %nx = #call meta_cursor_next(%params, %pi2)
        %is_colon = #call meta_node_is_word(%nx, %base, %colon, 1)
        %both = #and[#bits<1>](%is_colon, %lead)
        %pat2 = #if %both -> (#bits<64>) {
          %wc = #call lainir_buf_bytes(%buf, %pat, %comma, 2)
          #yield %wc
        } else {
          #yield %pat
        }
        %pat3 = #if %is_colon -> (#bits<64>) {
          %wp = #call lainir_buf_byte(%buf, %pat2, 37)
          %a_lo = #call meta_node_start(%c)
          %a_n = #call meta_node_len(%c)
          %a_at = #lea(%base, %a_lo, 1, 0)
          %wa = #call lainir_buf_bytes(%buf, %wp, %a_at, %a_n)
          %wk = #call lainir_buf_bytes(%buf, %wa, %colon2, 2)
          %tn = #call meta_cursor_next(%params, %cni)
          %t_lo = #call meta_node_start(%tn)
          %t_n = #call meta_node_len(%tn)
          %t_hi = #add[#bits<64>](%t_lo, %t_n)
          %ptid = #call meta_type_resolve(%base, %len, %t_lo, %t_hi)
          %pbad = #eq[#bits<64>](%ptid, 0)
          #if %pbad {
            %f1 = #call lain_meta_fail(5)
            #break ps(0)
          }
          %pinfo = #call meta_tid_repr(%ptid)
          %pk = #and[#bits<64>](%pinfo, 255)
          %pw = #and[#bits<64>](#lshr[#bits<64>](%pinfo, 8), 255)
          %wr = #call lainir_buf_repr(%buf, %wk, %pk, %pw)
          #yield %wr
        } else {
          #yield %pat2
        }
        #continue ps(%cni, 1, %pat3)
      } else {
        %done = #add[#bits<64>](1, %pat)
        #break ps(%done)
      }
    }
    %pfail = #eq[#bits<64>](%pst, 0)
    #if %pfail {
      #return 5
    }
    %plen = #sub[#bits<64>](%pst, 1)
    %n_lo = #call meta_node_start(%name_node)
    %n_n = #call meta_node_len(%name_node)
    %n_at = #lea(%base, %n_lo, 1, 0)
    %w5 = #call lainir_proc_head_full(%n_at, %n_n, %buf, %plen, %kind, %width)
    #yield 0
  }
  #return %status
}