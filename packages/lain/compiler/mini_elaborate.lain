// Module/function lookup, lexical scope resolution and type elaboration for M4.

let mini_syntax = import("packages::lain::compiler::mini_syntax");
let mini_type = import("packages::lain::compiler::mini_type");
let mini_module = import("packages::lain::compiler::mini_module");
let mini_middle = import("packages::lain::compiler::mini_middle");
let compiler_context = import("packages::lain::compiler::compiler_context");
@foreign(c, link_name = "core.string-append!")
let mini_elaborate_string_append = std::func(left: addr, right: addr) -> addr;

// M13 builds the callable environment once before elaborating bodies.  The
// earlier bootstrap path repeatedly rediscovered every callable by walking
// RawAst for every call expression, which made full self-compilation
// quadratic in expensive topology queries.  The table and duplicate policy
// are Lain-owned; the host supplies only the raw growable slots from M11.
@export
let M13ElaborationIndex: type = std::struct {
    functions: M11SymbolTable,
    types: M11SymbolTable,
    duplicate: i32,
}

let m13_index_callable = std::func(
    function: i32, index: M13ElaborationIndex) -> M13ElaborationIndex {
    if function == 0 { return index; }
    let name: addr = mini_syntax_function_name(function);
    let old: i32 = m11_symbol_table_find(index.functions, name);
    let duplicate: i32 = index.duplicate;
    if old != 0 {
        return m13_index_callable(
            mini_middle_next_callable(function),
            M13ElaborationIndex {
                functions: index.functions, duplicate: 1,
                types: index.types,
            });
    }
    return m13_index_callable(
        mini_middle_next_callable(function),
        M13ElaborationIndex {
            functions: m11_symbol_table_insert(
                index.functions, name, function),
            types: index.types,
            duplicate: duplicate,
        });
}

let m13_index_types = std::func(
    item: i32, index: M13ElaborationIndex) -> M13ElaborationIndex {
    if item == 0 { return index; }
    if mini_syntax_is_struct_declaration(item) == 1 {
        let name: addr = mini_syntax_text(
            mini_syntax_struct_name_node(item));
        if m11_symbol_table_find(index.types, name) != 0 {
            return m13_index_types(
                mini_middle_next_item(item),
                M13ElaborationIndex {
                    functions: index.functions, types: index.types,
                    duplicate: 1,
                });
        }
        return m13_index_types(
            mini_middle_next_item(item),
            M13ElaborationIndex {
                functions: index.functions,
                types: m11_symbol_table_insert(index.types, name, item),
                duplicate: index.duplicate,
            });
    }
    return m13_index_types(mini_middle_next_item(item), index);
}

let m13_index_new = std::func(root: i32) -> M13ElaborationIndex {
    let callables: M13ElaborationIndex = m13_index_callable(
        mini_middle_first_callable(root),
        M13ElaborationIndex {
            functions: m11_symbol_table_new(),
            types: m11_symbol_table_new(), duplicate: 0,
        });
    return m13_index_types(mini_middle_first_item(root), callables);
}

@export

let mini_elaborate_index_new = std::func(root: i32) -> M13ElaborationIndex {
    return m13_index_new(root);
}

let m13_index_destroy = std::func(index: M13ElaborationIndex) -> i32 {
    let functions: i32 = m11_symbol_table_destroy(index.functions);
    let types: i32 = m11_symbol_table_destroy(index.types);
    if functions == 1 { return types; }
    return 0;
}

@export

let mini_elaborate_index_destroy = std::func(index: M13ElaborationIndex) -> i32 {
    return m13_index_destroy(index);
}

let m13_find = std::func(index: M13ElaborationIndex, name: addr) -> i32 {
    return m11_symbol_table_find(index.functions, name);
}

@export

let mini_elaborate_find_callable = std::func(
    index: M13ElaborationIndex, name: addr) -> i32 {
    return m13_find(index, name);
}

let mini_name_visible = std::func(function: i32, body_start: i32, stop: i32, name: addr) -> i32 {
    if mini_syntax_param_named(mini_syntax_function_first_param(function), name) == 1 { return 1; }
    if mini_middle_find_visible_local(function, stop, name) != 0 { return 1; }
    return 0;
}

let mini_type_from_syntax = std::func(node: i32) -> i32 {
    if mini_syntax_is_atom_text(node, "i32") == 1 { return mini_type_i32(); }
    if mini_syntax_is_atom_text(node, "addr") == 1 { return mini_type_addr(); }
    if mini_syntax_is_unit_type(node) == 1 { return mini_type_unit(); }
    if mini_syntax_path_tail_is(node, "type") == 1 {
        return mini_type_type();
    }
    if mini_syntax_path_tail_is(node, "Module") == 1 {
        return mini_type_module();
    }
    if mini_syntax_path_tail_is(node, "module") == 1 {
        return mini_type_module();
    }
    if mini_syntax_path_tail_is(node, "Callable") == 1 {
        return mini_type_callable();
    }
    if mini_syntax_is_interface_dyn_type(node) == 1 {
        return mini_type_addr();
    }
    if mini_syntax_is_identifier(node) == 1 { return mini_type_addr(); }
    return mini_type_error();
}

// Constructor calls are Meta callables.  The value produced by `func` is a
// runtime callable unless a later elaboration rule supplies an explicit,
// valid phase.  Keeping phase as resolved data avoids encoding evaluation
// policy in the parser or in the constructor's spelling.
@export
let mini_elaborate_constructor_phase = std::func(item: i32) -> i32 {
    if mini_middle_binding_constructor_is(item, "func") == 1 {
        return mini_callable_phase_meta();
    }
    if mini_middle_binding_constructor_is(item, "struct") == 1 {
        return mini_callable_phase_meta();
    }
    if mini_middle_binding_constructor_is(item, "module") == 1 {
        return mini_callable_phase_meta();
    }
    if mini_middle_binding_constructor_is(item, "import") == 1 {
        return mini_callable_phase_meta();
    }
    return 0;
}

@export

let mini_elaborate_resolve_callable_phase = std::func(
    function: i32, requested_phase: i32) -> i32 {
    if mini_middle_binding_is_func(function) != 1 { return 0; }
    if requested_phase == 0 { return mini_callable_phase_runtime(); }
    if mini_callable_phase_valid(requested_phase) != 1 { return 0; }
    return requested_phase;
}

@export

let mini_elaborate_callable_phase = std::func(function: i32) -> i32 {
    return mini_elaborate_resolve_callable_phase(function, 0);
}

let mini_elaborate_binding_inferred_type = std::func(item: i32) -> i32 {
    if mini_middle_binding_is_func(item) == 1 {
        return mini_type_callable();
    }
    if mini_middle_binding_is_struct(item) == 1 {
        return mini_type_type();
    }
    if mini_middle_is_module_binding(item) == 1 {
        return mini_type_module();
    }
    if mini_middle_is_require_binding(item) == 1 {
        return mini_type_module();
    }
    let initializer: i32 = mini_middle_binding_initializer(item);
    if mini_syntax_is_i32_atom(initializer) == 1 { return mini_type_i32(); }
    if mini_syntax_is_string_atom(initializer) == 1 { return mini_type_addr(); }
    return mini_type_error();
}

@export

let mini_elaborate_binding_type = std::func(item: i32) -> i32 {
    let inferred: i32 = mini_elaborate_binding_inferred_type(item);
    let expected_node: i32 = mini_middle_binding_expected(item);
    if expected_node == 0 { return inferred; }
    let expected: i32 = mini_type_from_syntax(expected_node);
    if expected == mini_type_error() { return mini_type_error(); }
    if inferred == mini_type_error() { return mini_type_error(); }
    if mini_type_same(expected, inferred) != 1 { return mini_type_error(); }
    return expected;
}

let mini_validate_top_level_bindings = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_item_tag(item) == 5 {
        let inferred: i32 = mini_elaborate_binding_inferred_type(item);
        if inferred == mini_type_error() { return 12007; }
        let expected_node: i32 = mini_middle_binding_expected(item);
        if expected_node != 0 {
            let expected: i32 = mini_type_from_syntax(expected_node);
            if expected == mini_type_error() { return 12007; }
            if mini_type_same(expected, inferred) != 1 { return 12006; }
        }
        if mini_middle_binding_is_func(item) == 1 {
            if mini_elaborate_callable_phase(item) == 0 { return 12008; }
        }
    }
    return mini_validate_top_level_bindings(mini_middle_next_item(item));
}

let mini_interface_callee = std::func(
    index: M13ElaborationIndex, root: i32, node: i32) -> i32 {
    if mini_syntax_text_equal(
        mini_middle_interface_type_name(root),
        mini_syntax_interface_base_name(node)) != 1 { return 0; }
    let prefix: addr = mini_middle_interface_impl_prefix(root);
    if mini_syntax_text_equal(prefix, "") == 1 { return 0; }
    return m13_find(
        index,
        mini_elaborate_string_append(
            mini_elaborate_string_append(prefix, "_"),
            mini_syntax_interface_member_name(node)));
}

let mini_function_return_type = std::func(function: i32) -> i32 {
    return mini_type_from_syntax(mini_syntax_right(mini_syntax_function_signature(function)));
}

let m13_find_field_type = std::func(field: i32, name: addr) -> i32 {
    if field == 0 { return 0; }
    if mini_syntax_is_atom_text(field, ",") == 1 {
        return m13_find_field_type(mini_syntax_next(field), name);
    }
    if mini_syntax_is_infix(field, ":") == 1 {
        if mini_syntax_text_equal(
            mini_syntax_text(mini_syntax_left(field)), name) == 1 {
            return mini_syntax_right(field);
        }
    }
    return m13_find_field_type(mini_syntax_next(field), name);
}

let m13_struct_field_type = std::func(
    index: M13ElaborationIndex, type_node: i32, name: addr) -> i32 {
    if type_node == 0 { return 0; }
    let declaration: i32 = m11_symbol_table_find(
        index.types, mini_syntax_text(type_node));
    if declaration == 0 { return 0; }
    return m13_find_field_type(
        mini_syntax_struct_first_field(declaration), name);
}

let m13_type_size = std::func(type_node: i32) -> i32 {
    if mini_syntax_is_atom_text(type_node, "i32") == 1 { return 4; }
    if mini_syntax_is_atom_text(type_node, "bool") == 1 { return 4; }
    return 8;
}

let m13_field_offset_from = std::func(
    field: i32, name: addr, offset: i32, four_byte_tail: i32) -> i32 {
    if field == 0 { return -1; }
    if mini_syntax_is_atom_text(field, ",") == 1 {
        return m13_field_offset_from(
            mini_syntax_next(field), name, offset, four_byte_tail);
    }
    if mini_syntax_is_infix(field, ":") != 1 { return -1; }
    let size: i32 = m13_type_size(mini_syntax_right(field));
    if size == 8 {
        if four_byte_tail == 1 {
            if mini_syntax_text_equal(
                mini_syntax_text(mini_syntax_left(field)), name) == 1 {
                return offset + 4;
            }
            return m13_field_offset_from(
                mini_syntax_next(field), name, offset + 12, 0);
        }
        if mini_syntax_text_equal(
            mini_syntax_text(mini_syntax_left(field)), name) == 1 {
            return offset;
        }
        return m13_field_offset_from(
            mini_syntax_next(field), name, offset + 8, 0);
    }
    if mini_syntax_text_equal(
        mini_syntax_text(mini_syntax_left(field)), name) == 1 {
        return offset;
    }
    if four_byte_tail == 1 {
        return m13_field_offset_from(
            mini_syntax_next(field), name, offset + 4, 0);
    }
    return m13_field_offset_from(
        mini_syntax_next(field), name, offset + 4, 1);
}

let m13_struct_size_from = std::func(
    field: i32, offset: i32,
    four_byte_tail: i32, has_addr: i32) -> i32 {
    if field == 0 {
        if has_addr == 1 {
            if four_byte_tail == 1 { return offset + 4; }
        }
        return offset;
    }
    if mini_syntax_is_atom_text(field, ",") == 1 {
        return m13_struct_size_from(
            mini_syntax_next(field), offset, four_byte_tail, has_addr);
    }
    let size: i32 = m13_type_size(mini_syntax_right(field));
    if size == 8 {
        if four_byte_tail == 1 {
            return m13_struct_size_from(
                mini_syntax_next(field), offset + 12, 0, 1);
        }
        return m13_struct_size_from(
            mini_syntax_next(field), offset + 8, 0, 1);
    }
    if four_byte_tail == 1 {
        return m13_struct_size_from(
            mini_syntax_next(field), offset + 4, 0, has_addr);
    }
    return m13_struct_size_from(
        mini_syntax_next(field), offset + 4, 1, has_addr);
}

@export

let mini_elaborate_aggregate_size = std::func(
    index: M13ElaborationIndex, aggregate: i32) -> i32 {
    let declaration: i32 = m11_symbol_table_find(
        index.types,
        mini_syntax_text(mini_syntax_aggregate_type_node(aggregate)));
    if declaration == 0 { return 0; }
    return m13_struct_size_from(
        mini_syntax_struct_first_field(declaration), 0, 0, 0);
}

@export

let mini_elaborate_aggregate_field_offset = std::func(
    index: M13ElaborationIndex, aggregate: i32, name: addr) -> i32 {
    let declaration: i32 = m11_symbol_table_find(
        index.types,
        mini_syntax_text(mini_syntax_aggregate_type_node(aggregate)));
    if declaration == 0 { return -1; }
    return m13_field_offset_from(
        mini_syntax_struct_first_field(declaration), name, 0, 0);
}

@export

let mini_elaborate_field_offset_indexed = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let base_type: i32 = m13_expr_type_node(
        index, root, function, mini_syntax_left(node), body_start, stop);
    let declaration: i32 = m11_symbol_table_find(
        index.types, mini_syntax_text(base_type));
    if declaration == 0 { return -1; }
    return m13_field_offset_from(
        mini_syntax_struct_first_field(declaration),
        mini_syntax_text(mini_syntax_right(node)), 0, 0);
}

let m13_expr_type_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = mini_syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 10 { return mini_syntax_aggregate_type_node(node); }
    if tag == 2 {
        let name: addr = mini_syntax_text(node);
        let local: i32 = mini_middle_find_visible_local(
            function, stop, name);
        if local != 0 {
            let declared: i32 = mini_syntax_local_type_node(local);
            if declared != 0 { return declared; }
            return m13_expr_type_node(
                index, root, function,
                mini_syntax_local_value_node(local), body_start, local);
        }
        let param: i32 = mini_syntax_find_param(
            mini_syntax_function_first_param(function), name);
        if param == 0 { return 0; }
        return mini_syntax_param_type_node(param);
    }
    if tag == 4 {
        let callee: i32 = m13_find(index, mini_syntax_call_name(node));
        if callee == 0 { return 0; }
        return mini_syntax_right(mini_syntax_function_signature(callee));
    }
    if tag == 11 {
        let base_type: i32 = m13_expr_type_node(
            index, root, function, mini_syntax_left(node),
            body_start, stop);
        return m13_struct_field_type(
            index, base_type, mini_syntax_text(mini_syntax_right(node)));
    }
    return 0;
}

let mini_name_type = std::func(index: M13ElaborationIndex, root: i32, function: i32, body_start: i32, stop: i32, name: addr) -> i32 {
    let local: i32 = mini_middle_find_visible_local(function, stop, name);
    if local != 0 {
        let binding: i32 = mini_syntax_local_binding(local);
        return mini_expr_type(
            index, root, function, mini_syntax_local_value_node(local), body_start, local);
    }
    let param: i32 = mini_syntax_find_param(mini_syntax_function_first_param(function), name);
    if param == 0 { return mini_type_error(); }
    return mini_type_from_syntax(mini_syntax_param_type_node(param));
}

@export

let mini_elaborate_name_visible = std::func(function: i32, body_start: i32, stop: i32, name: addr) -> i32 {
    return mini_name_visible(function, body_start, stop, name);
}

@export

let mini_elaborate_name_is_local = std::func(function: i32, stop: i32, name: addr) -> i32 {
    if mini_middle_find_visible_local(function, stop, name) != 0 { return 1; }
    return 0;
}

let mini_expr_type = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = mini_syntax_expr_tag(node);
    if tag == 1 { return mini_type_i32(); }
    if tag == 2 {
        return mini_name_type(index, root, function, body_start, stop, mini_syntax_text(node));
    }
    if tag == 3 { return mini_type_i32(); }
    if tag == 4 {
        let callee: i32 = m13_find(index, mini_syntax_call_name(node));
        if callee == 0 { return mini_type_error(); }
        return mini_function_return_type(callee);
    }
    if tag == 5 { return mini_type_bool(); }
    if tag == 8 { return mini_type_bool(); }
    if tag == 12 { return mini_type_bool(); }
    if tag == 13 { return mini_type_bool(); }
    if tag == 14 { return mini_type_bool(); }
    if tag == 15 { return mini_type_bool(); }
    if tag == 16 { return mini_type_i32(); }
    if tag == 17 { return mini_type_i32(); }
    if tag == 18 { return mini_type_i32(); }
    if tag == 6 {
        return mini_expr_type(index, root, function, mini_syntax_if_then_expr(node), body_start, stop);
    }
    if tag == 7 { return mini_type_addr(); }
    if tag == 10 { return mini_type_addr(); }
    if tag == 11 {
        return mini_type_from_syntax(m13_expr_type_node(
            index, root, function, node, body_start, stop));
    }
    if tag == 19 { return mini_type_unit(); }
    if tag == 20 {
        let member: addr = mini_syntax_interface_member_name(node);
        if mini_syntax_text_equal(member, "make_dyn") == 1 {
            return mini_type_addr();
        }
        if mini_syntax_text_equal(member, "make_vtable") == 1 {
            return mini_type_addr();
        }
        let callee: i32 = mini_interface_callee(index, root, node);
        if callee == 0 { return mini_type_error(); }
        return mini_function_return_type(callee);
    }
    return mini_type_error();
}

let mini_validate_interface_call = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    if mini_syntax_text_equal(
        mini_middle_interface_type_name(root),
        mini_syntax_interface_base_name(node)) != 1 { return 2301; }
    let member: addr = mini_syntax_interface_member_name(node);
    let args: i32 = mini_syntax_interface_first_arg(node);
    if mini_syntax_text_equal(member, "make_vtable") == 1 {
        if mini_syntax_arg_count(args) != 0 { return 2303; }
        return 0;
    }
    if mini_syntax_text_equal(member, "make_dyn") == 1 {
        if mini_syntax_arg_count(args) != 2 { return 2303; }
        let first_code: i32 = mini_validate_expr(
            index, root, function, args, body_start, stop);
        if first_code != 0 { return first_code; }
        let table: i32 = mini_syntax_arg_next(args);
        if mini_syntax_expr_tag(table) != 20 { return 2304; }
        if mini_syntax_text_equal(
            mini_syntax_interface_member_name(table),
            "make_vtable") != 1 { return 2304; }
        return 0;
    }
    let callee: i32 = mini_interface_callee(index, root, node);
    if callee == 0 { return 2301; }
    if mini_syntax_arg_count(args) != mini_syntax_param_count(
        mini_syntax_function_first_param(callee)) { return 2303; }
    return mini_validate_args(
        index, root, function, args,
        mini_syntax_function_first_param(callee), body_start, stop);
}

let mini_validate_aggregate_fields = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    field: i32, body_start: i32, stop: i32) -> i32 {
    if field == 0 { return 0; }
    if mini_syntax_is_atom_text(field, ",") == 1 {
        return mini_validate_aggregate_fields(
            index, root, function, mini_syntax_next(field),
            body_start, stop);
    }
    if mini_syntax_is_infix(field, ":") != 1 { return 2601; }
    if mini_syntax_is_identifier(
        mini_syntax_aggregate_field_name_node(field)) != 1 { return 2601; }
    let code: i32 = mini_validate_expr(
        index, root, function,
        mini_syntax_aggregate_field_value(field), body_start, stop);
    if code != 0 { return code; }
    return mini_validate_aggregate_fields(
        index, root, function, mini_syntax_next(field), body_start, stop);
}

let m13_is_numeric_binary_tag = std::func(tag: i32) -> i32 {
    if tag == 12 { return 1; }
    if tag == 13 { return 1; }
    if tag == 14 { return 1; }
    if tag == 15 { return 1; }
    if tag == 16 { return 1; }
    if tag == 17 { return 1; }
    return 0;
}

@export

let mini_elaborate_expr_type = std::func(root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let index: M13ElaborationIndex = m13_index_new(root);
    let result: i32 = mini_expr_type(
        index, root, function, node, body_start, stop);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let mini_elaborate_expr_type_indexed = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    return mini_expr_type(
        index, root, function, node, body_start, stop);
}

let mini_validate_args = std::func(index: M13ElaborationIndex, root: i32, function: i32, arg: i32, param: i32, body_start: i32, stop: i32) -> i32 {
    if arg == 0 { return 0; }
    let code: i32 = mini_validate_expr(index, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    let expected: i32 = mini_type_from_syntax(mini_syntax_param_type_node(param));
    if mini_expr_type(index, root, function, arg, body_start, stop) != expected { return 2304; }
    return mini_validate_args(
        index, root, function, mini_syntax_arg_next(arg), mini_syntax_param_next(param), body_start, stop);
}

let mini_validate_call = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let name: addr = mini_syntax_call_name(node);
    if index.duplicate != 0 { return 2302; }
    let callee: i32 = m13_find(index, name);
    if callee == 0 { return 2301; }
    let args: i32 = mini_syntax_call_first_arg(node);
    if mini_syntax_arg_count(args) != mini_syntax_param_count(mini_syntax_function_first_param(callee)) {
        return 2303;
    }
    return mini_validate_args(
        index, root, function, args, mini_syntax_function_first_param(callee), body_start, stop);
}

let mini_validate_if = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let condition: i32 = mini_syntax_if_condition(node);
    let condition_code: i32 = mini_validate_expr(index, root, function, condition, body_start, stop);
    if condition_code != 0 { return condition_code; }
    if mini_expr_type(index, root, function, condition, body_start, stop) != mini_type_bool() { return 2401; }
    let then_expr: i32 = mini_syntax_if_then_expr(node);
    let else_expr: i32 = mini_syntax_if_else_expr(node);
    if then_expr == 0 { return 2403; }
    if else_expr == 0 { return 2403; }
    if mini_syntax_next(then_expr) != 0 { return 2403; }
    if mini_syntax_next(else_expr) != 0 { return 2403; }
    if mini_syntax_expr_tag(then_expr) == 6 { return 2405; }
    if mini_syntax_expr_tag(else_expr) == 6 { return 2405; }
    let then_code: i32 = mini_validate_expr(index, root, function, then_expr, body_start, stop);
    if then_code != 0 { return then_code; }
    let else_code: i32 = mini_validate_expr(index, root, function, else_expr, body_start, stop);
    if else_code != 0 { return else_code; }
    let then_type: i32 = mini_expr_type(index, root, function, then_expr, body_start, stop);
    let else_type: i32 = mini_expr_type(index, root, function, else_expr, body_start, stop);
    if then_type == mini_type_error() { return 2402; }
    if mini_type_same(then_type, else_type) != 1 { return 2402; }
    return 0;
}

let mini_validate_expr = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = mini_syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 19 {
        if mini_syntax_text_equal(
            mini_syntax_macro_name(node), "println") != 1 { return 2701; }
        if mini_middle_has_std_io_import(root) != 1 { return 2702; }
        let argument: i32 = mini_syntax_macro_first_arg(node);
        if mini_syntax_arg_count(argument) != 1 { return 2703; }
        if mini_syntax_is_string_atom(argument) != 1 { return 2704; }
        return 0;
    }
    if tag == 20 {
        return mini_validate_interface_call(
            index, root, function, node, body_start, stop);
    }
    if tag == 10 {
        return mini_validate_aggregate_fields(
            index, root, function,
            mini_syntax_aggregate_first_field(node), body_start, stop);
    }
    if tag == 11 {
        return mini_validate_expr(
            index, root, function, mini_syntax_left(node), body_start, stop);
    }
    if tag == 2 {
        if mini_name_visible(function, body_start, stop, mini_syntax_text(node)) == 1 { return 0; }
        return 2003;
    }
    if tag == 3 {
        let left_code: i32 = mini_validate_expr(index, root, function, mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_validate_expr(index, root, function, mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        if mini_expr_type(index, root, function, mini_syntax_left(node), body_start, stop) != mini_type_i32() { return 2201; }
        if mini_expr_type(index, root, function, mini_syntax_right(node), body_start, stop) != mini_type_i32() { return 2201; }
        return 0;
    }
    if tag == 4 { return mini_validate_call(index, root, function, node, body_start, stop); }
    if tag == 5 {
        let left_code: i32 = mini_validate_expr(index, root, function, mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_validate_expr(index, root, function, mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = mini_expr_type(index, root, function, mini_syntax_left(node), body_start, stop);
        let right_type: i32 = mini_expr_type(index, root, function, mini_syntax_right(node), body_start, stop);
        if left_type == mini_type_error() { return 2202; }
        if mini_type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 8 {
        let left_code: i32 = mini_validate_expr(index, root, function, mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_validate_expr(index, root, function, mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = mini_expr_type(index, root, function, mini_syntax_left(node), body_start, stop);
        let right_type: i32 = mini_expr_type(index, root, function, mini_syntax_right(node), body_start, stop);
        if left_type == mini_type_error() { return 2202; }
        if mini_type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if m13_is_numeric_binary_tag(tag) == 1 {
        let left_code: i32 = mini_validate_expr(
            index, root, function, mini_syntax_left(node),
            body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_validate_expr(
            index, root, function, mini_syntax_right(node),
            body_start, stop);
        if right_code != 0 { return right_code; }
        if mini_expr_type(
            index, root, function, mini_syntax_left(node),
            body_start, stop) != mini_type_i32() { return 2201; }
        if mini_expr_type(
            index, root, function, mini_syntax_right(node),
            body_start, stop) != mini_type_i32() { return 2201; }
        return 0;
    }
    if tag == 18 {
        let code: i32 = mini_validate_expr(
            index, root, function, mini_syntax_prefix_operand(node),
            body_start, stop);
        if code != 0 { return code; }
        if mini_expr_type(
            index, root, function, mini_syntax_prefix_operand(node),
            body_start, stop) != mini_type_i32() { return 2201; }
        return 0;
    }
    if tag == 6 { return mini_validate_if(index, root, function, node, body_start, stop); }
    if mini_syntax_kind(node) == 1 { return 2002; }
    return 2001;
}

let mini_validate_body = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = mini_syntax_form_tag(node);
    if form_tag == 1 { return mini_validate_body(index, root, function, mini_syntax_next(node), body_start); }
    if form_tag == 2 {
        let binding: i32 = mini_syntax_local_binding(node);
        if mini_syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = mini_syntax_local_name_node(node);
        if mini_syntax_is_identifier(name_node) != 1 { return 2101; }
        let name: addr = mini_syntax_text(name_node);
        if mini_name_visible(function, body_start, node, name) == 1 { return 2102; }
        let value: i32 = mini_syntax_local_value_node(node);
        if mini_syntax_expr_tag(value) == 6 { return 2404; }
        let value_code: i32 = mini_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = mini_expr_type(index, root, function, value, body_start, node);
        if value_type == mini_type_error() { return 2203; }
        let declared_type_node: i32 = mini_syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != mini_type_from_syntax(declared_type_node) { return 2203; }
        }
        return mini_validate_body(index, root, function, mini_syntax_next(node), body_start);
    }
    if mini_syntax_next(node) != 0 { return 2104; }
    let result_code: i32 = mini_validate_expr(index, root, function, node, body_start, node);
    if result_code != 0 { return result_code; }
    if mini_expr_type(index, root, function, node, body_start, node) != mini_function_return_type(function) { return 2204; }
    return 0;
}

let mini_only_separators = std::func(node: i32) -> i32 {
    if node == 0 { return 1; }
    if mini_syntax_form_tag(node) != 1 { return 0; }
    return mini_only_separators(mini_syntax_next(node));
}

let mini_validate_statement_block = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let form_tag: i32 = mini_syntax_form_tag(node);
    if form_tag == 1 {
        return mini_validate_statement_block(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let binding: i32 = mini_syntax_local_binding(node);
        if mini_syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = mini_syntax_local_name_node(node);
        if mini_syntax_is_identifier(name_node) != 1 { return 2101; }
        if mini_name_visible(
            function, body_start, node, mini_syntax_text(name_node)) == 1 {
            return 2102;
        }
        let value: i32 = mini_syntax_local_value_node(node);
        let value_code: i32 = mini_validate_expr(
            index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = mini_expr_type(
            index, root, function, value, body_start, node);
        if value_type == mini_type_error() { return 2203; }
        let declared_type_node: i32 = mini_syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != mini_type_from_syntax(declared_type_node) { return 2203; }
        }
        return mini_validate_statement_block(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = mini_validate_expr(
            index, root, function, node, body_start, node);
        if code != 0 { return code; }
        return mini_validate_statement_block(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = mini_syntax_return_expr(node);
        let value_code: i32 = mini_validate_expr(
            index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if mini_expr_type(index, root, function, value, body_start, node) !=
            mini_function_return_type(function) { return 2204; }
        if mini_only_separators(mini_syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = mini_syntax_if_statement_condition(node);
        let condition_code: i32 = mini_validate_expr(
            index, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if mini_expr_type(index, root, function, condition, body_start, node) !=
            mini_type_bool() { return 2401; }
        let branch: i32 = mini_syntax_left(mini_syntax_if_statement_body(node));
        let branch_code: i32 = mini_validate_statement_block(
            index, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return mini_validate_statement_block(
            index, root, function, mini_syntax_next(node), body_start);
    }
    return 2502;
}

let mini_validate_declared_body = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = mini_syntax_form_tag(node);
    if form_tag == 1 {
        return mini_validate_declared_body(index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let binding: i32 = mini_syntax_local_binding(node);
        if mini_syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = mini_syntax_local_name_node(node);
        if mini_syntax_is_identifier(name_node) != 1 { return 2101; }
        let name: addr = mini_syntax_text(name_node);
        if mini_name_visible(function, body_start, node, name) == 1 { return 2102; }
        let value: i32 = mini_syntax_local_value_node(node);
        let value_code: i32 = mini_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = mini_expr_type(index, root, function, value, body_start, node);
        if value_type == mini_type_error() { return 2203; }
        let declared_type_node: i32 = mini_syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != mini_type_from_syntax(declared_type_node) { return 2203; }
        }
        return mini_validate_declared_body(index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = mini_validate_expr(
            index, root, function, node, body_start, node);
        if code != 0 { return code; }
        // A canonical func body may use its final expression as the result.
        if mini_only_separators(mini_syntax_next(node)) == 1 {
            if mini_expr_type(
                index, root, function, node, body_start, node) !=
                mini_function_return_type(function) { return 2204; }
            return 0;
        }
        return mini_validate_declared_body(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = mini_syntax_return_expr(node);
        let value_code: i32 = mini_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if mini_expr_type(index, root, function, value, body_start, node) != mini_function_return_type(function) { return 2204; }
        if mini_only_separators(mini_syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = mini_syntax_if_statement_condition(node);
        let condition_code: i32 = mini_validate_expr(index, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if mini_expr_type(index, root, function, condition, body_start, node) != mini_type_bool() { return 2401; }
        let branch: i32 = mini_syntax_left(mini_syntax_if_statement_body(node));
        let branch_code: i32 = mini_validate_statement_block(index, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return mini_validate_declared_body(index, root, function, mini_syntax_next(node), body_start);
    }
    return 2502;
}

let mini_validate_param_names = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    let name: addr = mini_syntax_text(mini_syntax_param_name_node(param));
    if mini_syntax_param_named(mini_syntax_param_next(param), name) == 1 { return 2110; }
    return mini_validate_param_names(mini_syntax_param_next(param));
}

let mini_validate_function_semantics = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    let name: addr = mini_syntax_function_name(function);
    if index.duplicate != 0 { return 2111; }
    let param_code: i32 = mini_validate_param_names(mini_syntax_function_first_param(function));
    if param_code != 0 { return param_code; }
    let body: i32 = mini_syntax_function_body(function);
    let first: i32 = mini_syntax_left(body);
    return mini_validate_declared_body(index, root, function, first, first);
}

let mini_validate_functions = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    let code: i32 = mini_validate_function_semantics(index, root, function);
    if code != 0 { return code; }
    return mini_validate_functions(index, root, mini_middle_next_definition(function));
}

let mini_diagnostic_function = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> addr {
    if function == 0 { return ""; }
    if mini_validate_function_semantics(index, root, function) != 0 {
        return mini_syntax_function_name(function);
    }
    return mini_diagnostic_function(index, root, mini_middle_next_definition(function));
}

let mini_diagnostic_function_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    if mini_validate_function_semantics(index, root, function) != 0 {
        return function;
    }
    return mini_diagnostic_function_node(
        index, root, mini_middle_next_definition(function));
}

let m13_declared_failure_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let tag: i32 = mini_syntax_form_tag(node);
    if tag == 1 {
        return m13_declared_failure_node(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if tag == 2 {
        let value: i32 = mini_syntax_local_value_node(node);
        if mini_validate_expr(
            index, root, function, value, body_start, node) != 0 {
            return node;
        }
        let actual: i32 = mini_expr_type(
            index, root, function, value, body_start, node);
        let declared: i32 = mini_syntax_local_type_node(node);
        if actual == mini_type_error() { return node; }
        if declared != 0 {
            if actual != mini_type_from_syntax(declared) { return node; }
        }
        return m13_declared_failure_node(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if tag == 3 {
        if mini_validate_expr(
            index, root, function, node, body_start, node) != 0 {
            return node;
        }
        return m13_declared_failure_node(
            index, root, function, mini_syntax_next(node), body_start);
    }
    if tag == 4 {
        let value: i32 = mini_syntax_return_expr(node);
        if mini_validate_expr(
            index, root, function, value, body_start, node) != 0 {
            return node;
        }
        if mini_expr_type(
            index, root, function, value, body_start, node) !=
            mini_function_return_type(function) { return node; }
        return 0;
    }
    if tag == 5 {
        let condition: i32 = mini_syntax_if_statement_condition(node);
        if mini_validate_expr(
            index, root, function, condition, body_start, node) != 0 {
            return node;
        }
        let branch: i32 = mini_syntax_left(
            mini_syntax_if_statement_body(node));
        if mini_validate_statement_block(
            index, root, function, branch, branch) != 0 { return node; }
        return m13_declared_failure_node(
            index, root, function, mini_syntax_next(node), body_start);
    }
    return node;
}

let m13_failure_statement_from = std::func(
    index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    if mini_validate_function_semantics(index, root, function) != 0 {
        let body: i32 = mini_syntax_function_body(function);
        let first: i32 = mini_syntax_left(body);
        return m13_declared_failure_node(
            index, root, function, first, first);
    }
    return m13_failure_statement_from(
        index, root, mini_middle_next_definition(function));
}

@export

let mini_elaborate_diagnostic_statement_line = std::func(root: i32) -> i32 {
    if mini_middle_validate_program(root) != 0 { return 0; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let node: i32 = m13_failure_statement_from(
        index, root, mini_module_first_procedure(root));
    let line: i32 = mini_syntax_line(node);
    let destroyed: i32 = m13_index_destroy(index);
    return line;
}

@export

let mini_elaborate_diagnostic_statement_code = std::func(root: i32) -> i32 {
    if mini_middle_validate_program(root) != 0 {
        return mini_middle_validate_program(root);
    }
    let index: M13ElaborationIndex = m13_index_new(root);
    let function: i32 = mini_diagnostic_function_node(
        index, root, mini_module_first_procedure(root));
    let body: i32 = mini_syntax_function_body(function);
    let first: i32 = mini_syntax_left(body);
    let node: i32 = m13_declared_failure_node(
        index, root, function, first, first);
    let tag: i32 = mini_syntax_form_tag(node);
    if tag == 2 {
        let value: i32 = mini_syntax_local_value_node(node);
        let code: i32 = mini_validate_expr(
            index, root, function, value, first, node);
        if code != 0 {
            let destroyed_error: i32 = m13_index_destroy(index);
            return code;
        }
        let destroyed_mismatch: i32 = m13_index_destroy(index);
        return 2203;
    }
    let result: i32 = mini_validate_function_semantics(
        index, root, function);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let mini_elaborate_diagnostic_function_line = std::func(root: i32) -> i32 {
    if mini_middle_validate_program(root) != 0 { return 0; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let node: i32 = mini_diagnostic_function_node(
        index, root, mini_module_first_procedure(root));
    let line: i32 = mini_syntax_line(node);
    let destroyed: i32 = m13_index_destroy(index);
    return line;
}

@export

let mini_elaborate_diagnostic_function = std::func(root: i32) -> addr {
    if mini_middle_validate_program(root) != 0 { return ""; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let result: addr = mini_diagnostic_function(
        index, root, mini_module_first_procedure(root));
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let mini_elaborate_validate = std::func(root: i32) -> i32 {
    let syntax_code: i32 = mini_middle_validate_program(root);
    if syntax_code != 0 { return syntax_code; }
    let binding_code: i32 = mini_validate_top_level_bindings(
        mini_middle_first_item(root));
    if binding_code != 0 { return binding_code; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let result: i32 = mini_validate_functions(
        index, root, mini_module_first_procedure(root));
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

// Incremental entry used by named bootstrap compilation.  The selected
// definition is checked completely, including the signatures of every call
// it makes, without revalidating unrelated function bodies in the same
// source closure.
@export
let mini_elaborate_validate_named = std::func(root: i32, name: addr) -> i32 {
    if mini_syntax_kind(root) != 4 { return 1001; }
    let binding_code: i32 = mini_validate_top_level_bindings(
        mini_middle_first_item(root));
    if binding_code != 0 { return binding_code; }
    let index: M13ElaborationIndex = m13_index_new(root);
    if index.duplicate != 0 {
        let destroyed_duplicate: i32 = m13_index_destroy(index);
        return 2302;
    }
    let selected: i32 = m13_find(index, name);
    if selected == 0 {
        let destroyed_missing: i32 = m13_index_destroy(index);
        return 2301;
    }
    if mini_middle_is_procedure_definition(selected) != 1 { return 1002; }
    let syntax_code: i32 = mini_syntax_validate_function(selected);
    if syntax_code != 0 { return syntax_code; }
    let result: i32 = mini_validate_function_semantics(index, root, selected);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

// M5 module-context elaboration.  Canonical module bodies contain only
// unified let bindings.
let mini_workspace_type_from_syntax = std::func(node: i32) -> i32 {
    if mini_syntax_is_atom_text(node, "i32") == 1 { return mini_type_i32(); }
    if mini_syntax_is_atom_text(node, "addr") == 1 { return mini_type_addr(); }
    return mini_type_error();
}

let mini_workspace_function_return_type = std::func(function: i32) -> i32 {
    return mini_workspace_type_from_syntax(
        mini_syntax_right(mini_syntax_function_signature(function)));
}

let mini_workspace_name_type = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    body_start: i32, stop: i32, name: addr) -> i32 {
    let local: i32 = mini_middle_find_visible_local(function, stop, name);
    if local != 0 {
        return mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_local_value_node(local), body_start, local);
    }
    let param: i32 = mini_syntax_find_param(
        mini_syntax_function_first_param(function), name);
    if param == 0 { return mini_type_error(); }
    return mini_workspace_type_from_syntax(mini_syntax_param_type_node(param));
}

let mini_workspace_member_callee = std::func(
    workspace: ModuleWorkspace, module: i32, node: i32) -> i32 {
    let target: i32 = module_workspace_resolve_alias(
        workspace, module, mini_syntax_member_base_name(node));
    if target == 0 { return 0; }
    return mini_module_find_exported_procedure(
        target, mini_syntax_member_name(node));
}

let mini_workspace_expr_type = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = mini_syntax_expr_tag(node);
    if tag == 1 { return mini_type_i32(); }
    if tag == 7 { return mini_type_addr(); }
    if tag == 2 {
        return mini_workspace_name_type(
            workspace, module, root, function,
            body_start, stop, mini_syntax_text(node));
    }
    if tag == 3 { return mini_type_i32(); }
    if tag == 4 {
        let callee: i32 = mini_module_find_procedure(
            root, mini_syntax_call_name(node));
        if callee == 0 { return mini_type_error(); }
        return mini_workspace_function_return_type(callee);
    }
    if tag == 5 { return mini_type_bool(); }
    if tag == 8 { return mini_type_bool(); }
    if tag == 6 {
        return mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_if_then_expr(node), body_start, stop);
    }
    if tag == 9 {
        let callee: i32 = mini_workspace_member_callee(workspace, module, node);
        if callee == 0 { return mini_type_error(); }
        return mini_workspace_function_return_type(callee);
    }
    return mini_type_error();
}

@export

let mini_elaborate_module_expr_type_indexed = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    return mini_workspace_expr_type(
        workspace, module, root, function, node, body_start, stop);
}

let mini_workspace_validate_args = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    arg: i32, param: i32, body_start: i32, stop: i32) -> i32 {
    if arg == 0 { return 0; }
    let code: i32 = mini_workspace_validate_expr(
        workspace, module, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    let expected: i32 = mini_workspace_type_from_syntax(
        mini_syntax_param_type_node(param));
    if mini_workspace_expr_type(
        workspace, module, root, function, arg, body_start, stop) != expected {
        return 2304;
    }
    return mini_workspace_validate_args(
        workspace, module, root, function,
        mini_syntax_arg_next(arg), mini_syntax_param_next(param),
        body_start, stop);
}

let mini_workspace_validate_local_call = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let name: addr = mini_syntax_call_name(node);
    let matches: i32 = mini_module_procedure_name_count(root, name);
    if matches == 0 { return 2301; }
    if matches != 1 { return 2302; }
    let callee: i32 = mini_module_find_procedure(root, name);
    let args: i32 = mini_syntax_call_first_arg(node);
    if mini_syntax_arg_count(args) != mini_syntax_param_count(
        mini_syntax_function_first_param(callee)) { return 2303; }
    return mini_workspace_validate_args(
        workspace, module, root, function, args,
        mini_syntax_function_first_param(callee), body_start, stop);
}

let mini_workspace_validate_member_call = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let target: i32 = module_workspace_resolve_alias(
        workspace, module, mini_syntax_member_base_name(node));
    if target == 0 { return 4104; }
    let member: addr = mini_syntax_member_name(node);
    let any_binding: i32 = mini_module_find_binding(
        mini_module_first_body_item(target), member);
    if any_binding == 0 { return 4201; }
    if mini_module_summary_has_export(target, member) != 1 { return 4202; }
    let callee: i32 = mini_module_find_exported_procedure(target, member);
    if callee == 0 { return 4203; }
    let args: i32 = mini_syntax_member_first_arg(node);
    if mini_syntax_arg_count(args) != mini_syntax_param_count(
        mini_syntax_function_first_param(callee)) { return 2303; }
    return mini_workspace_validate_args(
        workspace, module, root, function, args,
        mini_syntax_function_first_param(callee), body_start, stop);
}

let mini_workspace_validate_if = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let condition: i32 = mini_syntax_if_condition(node);
    let condition_code: i32 = mini_workspace_validate_expr(
        workspace, module, root, function, condition, body_start, stop);
    if condition_code != 0 { return condition_code; }
    if mini_workspace_expr_type(
        workspace, module, root, function, condition, body_start, stop) !=
        mini_type_bool() { return 2401; }
    let then_expr: i32 = mini_syntax_if_then_expr(node);
    let else_expr: i32 = mini_syntax_if_else_expr(node);
    if then_expr == 0 { return 2403; }
    if else_expr == 0 { return 2403; }
    if mini_syntax_next(then_expr) != 0 { return 2403; }
    if mini_syntax_next(else_expr) != 0 { return 2403; }
    let then_code: i32 = mini_workspace_validate_expr(
        workspace, module, root, function, then_expr, body_start, stop);
    if then_code != 0 { return then_code; }
    let else_code: i32 = mini_workspace_validate_expr(
        workspace, module, root, function, else_expr, body_start, stop);
    if else_code != 0 { return else_code; }
    let then_type: i32 = mini_workspace_expr_type(
        workspace, module, root, function, then_expr, body_start, stop);
    let else_type: i32 = mini_workspace_expr_type(
        workspace, module, root, function, else_expr, body_start, stop);
    if then_type == mini_type_error() { return 2402; }
    if mini_type_same(then_type, else_type) != 1 { return 2402; }
    return 0;
}

let mini_workspace_validate_expr = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = mini_syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 2 {
        if mini_name_visible(
            function, body_start, stop, mini_syntax_text(node)) == 1 { return 0; }
        return 2003;
    }
    if tag == 3 {
        let left_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        if mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop) != mini_type_i32() {
            return 2201;
        }
        if mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop) != mini_type_i32() {
            return 2201;
        }
        return 0;
    }
    if tag == 4 {
        return mini_workspace_validate_local_call(
            workspace, module, root, function, node, body_start, stop);
    }
    if tag == 9 {
        return mini_workspace_validate_member_call(
            workspace, module, root, function, node, body_start, stop);
    }
    if tag == 5 {
        let left_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop);
        let right_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop);
        if left_type == mini_type_error() { return 2202; }
        if mini_type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 8 {
        let left_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_left(node), body_start, stop);
        let right_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function,
            mini_syntax_right(node), body_start, stop);
        if left_type == mini_type_error() { return 2202; }
        if mini_type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 6 {
        return mini_workspace_validate_if(
            workspace, module, root, function, node, body_start, stop);
    }
    if mini_syntax_kind(node) == 1 { return 2002; }
    return 2001;
}

let mini_workspace_validate_statement_block = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let form_tag: i32 = mini_syntax_form_tag(node);
    if form_tag == 1 {
        return mini_workspace_validate_statement_block(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let name_node: i32 = mini_syntax_local_name_node(node);
        if mini_syntax_is_identifier(name_node) != 1 { return 2101; }
        if mini_name_visible(
            function, body_start, node, mini_syntax_text(name_node)) == 1 {
            return 2102;
        }
        let value: i32 = mini_syntax_local_value_node(node);
        let value_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function, value, body_start, node);
        if value_type == mini_type_error() { return 2203; }
        let declared: i32 = mini_syntax_local_type_node(node);
        if declared != 0 {
            if value_type != mini_workspace_type_from_syntax(declared) {
                return 2203;
            }
        }
        return mini_workspace_validate_statement_block(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, node, body_start, node);
        if code != 0 { return code; }
        return mini_workspace_validate_statement_block(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = mini_syntax_return_expr(node);
        let value_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if mini_workspace_expr_type(
            workspace, module, root, function, value, body_start, node) !=
            mini_workspace_function_return_type(function) { return 2204; }
        if mini_only_separators(mini_syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = mini_syntax_if_statement_condition(node);
        let condition_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if mini_workspace_expr_type(
            workspace, module, root, function, condition, body_start, node) !=
            mini_type_bool() { return 2401; }
        let branch: i32 = mini_syntax_left(
            mini_syntax_if_statement_body(node));
        let branch_code: i32 = mini_workspace_validate_statement_block(
            workspace, module, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return mini_workspace_validate_statement_block(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    return 2502;
}

let mini_workspace_validate_body = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = mini_syntax_form_tag(node);
    if form_tag == 1 {
        return mini_workspace_validate_body(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let name_node: i32 = mini_syntax_local_name_node(node);
        if mini_syntax_is_identifier(name_node) != 1 { return 2101; }
        if mini_name_visible(
            function, body_start, node, mini_syntax_text(name_node)) == 1 {
            return 2102;
        }
        let value: i32 = mini_syntax_local_value_node(node);
        let value_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = mini_workspace_expr_type(
            workspace, module, root, function, value, body_start, node);
        if value_type == mini_type_error() { return 2203; }
        let declared: i32 = mini_syntax_local_type_node(node);
        if declared != 0 {
            if value_type != mini_workspace_type_from_syntax(declared) {
                return 2203;
            }
        }
        return mini_workspace_validate_body(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let result_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, node, body_start, node);
        if result_code != 0 { return result_code; }
        if mini_only_separators(mini_syntax_next(node)) == 1 {
            if mini_workspace_expr_type(
                workspace, module, root, function, node, body_start, node) !=
                mini_workspace_function_return_type(function) { return 2204; }
            return 0;
        }
        return mini_workspace_validate_body(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = mini_syntax_return_expr(node);
        let value_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if mini_workspace_expr_type(
            workspace, module, root, function, value, body_start, node) !=
            mini_workspace_function_return_type(function) { return 2204; }
        if mini_only_separators(mini_syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = mini_syntax_if_statement_condition(node);
        let condition_code: i32 = mini_workspace_validate_expr(
            workspace, module, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if mini_workspace_expr_type(
            workspace, module, root, function, condition, body_start, node) !=
            mini_type_bool() { return 2401; }
        let branch: i32 = mini_syntax_left(
            mini_syntax_if_statement_body(node));
        let branch_code: i32 = mini_workspace_validate_statement_block(
            workspace, module, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return mini_workspace_validate_body(
            workspace, module, root, function,
            mini_syntax_next(node), body_start);
    }
    return 2502;
}

let mini_workspace_validate_function = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> i32 {
    let param_code: i32 = mini_validate_param_names(
        mini_syntax_function_first_param(function));
    if param_code != 0 { return param_code; }
    let body: i32 = mini_syntax_function_body(function);
    let first: i32 = mini_syntax_left(body);
    return mini_workspace_validate_body(
        workspace, module, root, function, first, first);
}

let mini_workspace_validate_functions = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    let code: i32 = mini_workspace_validate_function(
        workspace, module, root, function);
    if code != 0 { return code; }
    return mini_workspace_validate_functions(
        workspace, module, root, mini_middle_next_definition(function));
}

@export

let mini_elaborate_validate_module_indexed = std::func(
    workspace: ModuleWorkspace, module: i32) -> i32 {
    let root: i32 = mini_module_body(module);
    return mini_workspace_validate_functions(
        workspace, module, root, mini_module_first_procedure(root));
}

let mini_workspace_diagnostic_function_from = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> addr {
    if function == 0 { return ""; }
    if mini_workspace_validate_function(
        workspace, module, root, function) != 0 {
        return mini_syntax_function_name(function);
    }
    return mini_workspace_diagnostic_function_from(
        workspace, module, root, mini_middle_next_definition(function));
}

@export

let mini_elaborate_module_diagnostic_function_indexed = std::func(
    workspace: ModuleWorkspace, module: i32) -> addr {
    let root: i32 = mini_module_body(module);
    return mini_workspace_diagnostic_function_from(
        workspace, module, root, mini_module_first_procedure(root));
}

// Historical single-root workspace adapters.  Stable compiler workspace
// paths build one ModuleWorkspace and use the indexed entries directly.
@export
let mini_elaborate_module_expr_type = std::func(
    root_workspace: i32, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: i32 = mini_elaborate_module_expr_type_indexed(
        workspace, module, root, function, node, body_start, stop);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}

@export

let mini_elaborate_validate_module = std::func(
    root_workspace: i32, module: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: i32 = mini_elaborate_validate_module_indexed(workspace, module);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}

@export

let mini_elaborate_module_diagnostic_function = std::func(
    root_workspace: i32, module: i32) -> addr {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: addr = mini_elaborate_module_diagnostic_function_indexed(
        workspace, module);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}
