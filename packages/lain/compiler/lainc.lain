import packages::lain::compiler::module_ast_score;
import packages::lain::compiler::ir_builder;
import packages::lain::compiler::diagnostic;
import packages::lain::compiler::compile_result;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

pub fn lainc_compile_module_result_score(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    return compile_result_score(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
}

pub fn lainc_compile_module_ok(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    return compile_result_ok(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
}

pub fn lainc_compile_module_diagnostic_code(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    return compile_result_diagnostic_code(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
}

pub fn lainc_compile_module_score(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let module_score: i32 = module_ast_score_summary(package_symbol + path_symbol, root, pub_symbol, fn_symbol, type_symbol);
    let ir_score: i32 = ir_build_const_score(main_symbol, module_score);
    let diag_score: i32 = diagnostic_score(0, main_symbol, 0, 0);
    return module_score + ir_score + diag_score;
}
