// Canonical structured-L1 text construction owned by Lain.
// Meta frontends use these operations instead of knowing textual punctuation.

// Bootstrap-only linear concatenation: each input fragment is consumed by the
// call.  This keeps whole-compiler L1 emission linear in memory.
@foreign(c, link_name = "core.string-append-linear!")
fn host_string_append(left: addr, right: addr) -> addr;

pub fn l1_text_concat(left: addr, right: addr) -> addr {
    return host_string_append(left, right);
}

pub fn l1_text_proc_begin(name: addr) -> addr {
    let a: addr = host_string_append("#proc ", name);
    return host_string_append(a, "() -> i32 { ");
}

pub fn l1_text_proc_begin_params(name: addr, params: addr) -> addr {
    return l1_text_proc_begin_typed(name, params, "i32");
}

pub fn l1_text_proc_begin_typed(name: addr, params: addr, return_type: addr) -> addr {
    let a: addr = host_string_append("#proc ", name);
    let b: addr = host_string_append(a, "(");
    let c: addr = host_string_append(b, params);
    let d: addr = host_string_append(c, ") -> ");
    let e: addr = host_string_append(d, return_type);
    return host_string_append(e, " { ");
}

pub fn l1_text_extern_proc(name: addr, params: addr, return_type: addr) -> addr {
    let a: addr = host_string_append("#extern #proc ", name);
    let b: addr = host_string_append(a, "(");
    let c: addr = host_string_append(b, params);
    let d: addr = host_string_append(c, ") -> ");
    let e: addr = host_string_append(d, return_type);
    return host_string_append(e, "; ");
}

pub fn l1_text_i32_parameter(index: addr, first: i32) -> addr {
    return l1_text_parameter("i32", index, first);
}

pub fn l1_text_parameter(type_name: addr, index: addr, first: i32) -> addr {
    if first == 1 {
        let a: addr = host_string_append(type_name, " %arg");
        return host_string_append(a, index);
    }
    let a: addr = host_string_append(", ", type_name);
    let b: addr = host_string_append(a, " %arg");
    return host_string_append(b, index);
}

pub fn l1_text_proc_end() -> addr {
    return "}";
}

pub fn l1_text_i32_binding(name: addr, value: addr) -> addr {
    return l1_text_binding(name, "i32", value);
}

pub fn l1_text_binding(name: addr, type_name: addr, value: addr) -> addr {
    let a: addr = host_string_append("#let %", name);
    let b: addr = host_string_append(a, ": ");
    let c: addr = host_string_append(b, type_name);
    let d: addr = host_string_append(c, " = ");
    let e: addr = host_string_append(d, value);
    return host_string_append(e, " ");
}

pub fn l1_text_i32_variable(name: addr) -> addr {
    return host_string_append("%", name);
}

pub fn l1_text_i32_add(left: addr, right: addr) -> addr {
    let a: addr = host_string_append("#add(", left);
    let b: addr = host_string_append(a, ", ");
    let c: addr = host_string_append(b, right);
    return host_string_append(c, ")");
}

pub fn l1_text_i32_eq(left: addr, right: addr) -> addr {
    let a: addr = host_string_append("#eq(", left);
    let b: addr = host_string_append(a, ", ");
    let c: addr = host_string_append(b, right);
    return host_string_append(c, ")");
}

pub fn l1_text_i32_ne(left: addr, right: addr) -> addr {
    let a: addr = host_string_append("#ne(", left);
    let b: addr = host_string_append(a, ", ");
    let c: addr = host_string_append(b, right);
    return host_string_append(c, ")");
}

pub fn l1_text_call(name: addr, args: addr) -> addr {
    let a: addr = host_string_append("#call ", name);
    let b: addr = host_string_append(a, "(");
    let c: addr = host_string_append(b, args);
    return host_string_append(c, ")");
}

pub fn l1_text_call_arg(value: addr, first: i32) -> addr {
    if first == 1 { return value; }
    return host_string_append(", ", value);
}

pub fn l1_text_return(value: addr) -> addr {
    let a: addr = host_string_append("#return ", value);
    return host_string_append(a, " ");
}

pub fn l1_text_if_return(condition: addr, then_value: addr, else_value: addr) -> addr {
    let a: addr = host_string_append("#if ", condition);
    let b: addr = host_string_append(a, " { #return ");
    let c: addr = host_string_append(b, then_value);
    let d: addr = host_string_append(c, " } else { #return ");
    let e: addr = host_string_append(d, else_value);
    return host_string_append(e, " } ");
}

pub fn l1_text_if_then(condition: addr, then_body: addr) -> addr {
    let a: addr = host_string_append("#if ", condition);
    let b: addr = host_string_append(a, " { ");
    let c: addr = host_string_append(b, then_body);
    return host_string_append(c, "} ");
}
