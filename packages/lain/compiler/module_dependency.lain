struct ModuleId {
    package_symbol: i32,
    path_symbol: i32,
}

struct DependencyEntry {
    module: ModuleId,
    has_next: i32,
    next: addr,
}

fn module_id_score(module: ModuleId) -> i32 {
    module.package_symbol + module.path_symbol
}

fn dependency_entry_score(entry: DependencyEntry) -> i32 {
    module_id_score(entry.module)
}

fn dependency_matches(entry: DependencyEntry, package_symbol: i32, path_symbol: i32) -> i32 {
    if entry.module.package_symbol != package_symbol {
        return 0;
    }
    if entry.module.path_symbol != path_symbol {
        return 0;
    }
    return 1;
}

fn dependency_list_contains(entry: DependencyEntry, package_symbol: i32, path_symbol: i32) -> i32 {
    if dependency_matches(entry, package_symbol, path_symbol) == 1 {
        return 1;
    }
    if entry.has_next == 0 {
        return 0;
    }
    return dependency_list_contains(entry.next, package_symbol, path_symbol);
}

fn dependency_list_score(entry: DependencyEntry) -> i32 {
    let self_score: i32 = dependency_entry_score(entry);
    let next_score: i32 = if entry.has_next == 0 {
        0
    } else {
        dependency_list_score(entry.next)
    };
    self_score + next_score
}

fn dependency_list_count(entry: DependencyEntry) -> i32 {
    let next_count: i32 = if entry.has_next == 0 {
        0
    } else {
        dependency_list_count(entry.next)
    };
    1 + next_count
}

pub fn module_dependency_pair_score(package_symbol: i32, path_a: i32, path_b: i32) -> i32 {
    let second_module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_b,
    };
    let second: DependencyEntry = DependencyEntry {
        module: second_module,
        has_next: 0,
        next: 0,
    };
    let first_module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_a,
    };
    let first: DependencyEntry = DependencyEntry {
        module: first_module,
        has_next: 1,
        next: second,
    };
    return dependency_list_count(first) + dependency_list_score(first);
}

pub fn module_dependency_pair_contains(package_symbol: i32, path_a: i32, path_b: i32, wanted_path: i32) -> i32 {
    let second_module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_b,
    };
    let second: DependencyEntry = DependencyEntry {
        module: second_module,
        has_next: 0,
        next: 0,
    };
    let first_module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_a,
    };
    let first: DependencyEntry = DependencyEntry {
        module: first_module,
        has_next: 1,
        next: second,
    };
    return dependency_list_contains(first, package_symbol, wanted_path);
}
