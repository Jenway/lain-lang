// Structured query protocol for one zero-copy M4 compilation session.
// The opaque session handle is the RawAst root owned by the host arena; all
// semantic result fields are computed and owned by Lain modules.

import packages::lain::compiler::mini_syntax;
import packages::lain::compiler::mini_elaborate;
import packages::lain::compiler::mini_lower;
import packages::lain::compiler::mini_diagnostic;
import packages::lain::compiler::mini_module;

pub fn mini_compile_result_ok(root: i32) -> i32 {
    if mini_elaborate_validate(root) == 0 { return 1; }
    return 0;
}

pub fn mini_compile_result_diagnostic_code(root: i32) -> i32 {
    return mini_elaborate_validate(root);
}

pub fn mini_compile_result_diagnostic_message(root: i32) -> addr {
    return mini_diagnostic_message(mini_elaborate_validate(root));
}

pub fn mini_compile_result_diagnostic_procedure(root: i32) -> addr {
    return mini_elaborate_diagnostic_function(root);
}

pub fn mini_compile_result_procedure_count(root: i32) -> i32 {
    return mini_module_procedure_count(root);
}

pub fn mini_compile_result_has_procedure(root: i32, name: addr) -> i32 {
    return mini_module_has_procedure(root, name);
}

pub fn mini_compile_result_dependency_count(root: i32) -> i32 {
    return mini_module_dependency_count(root);
}

pub fn mini_compile_result_l1_unit(root: i32) -> addr {
    // Contract: callers must observe `ok` before requesting the unit.  Keeping
    // this accessor pure lowering avoids a second whole-module elaboration.
    return mini_lower_validated(root);
}
