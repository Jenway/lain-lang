struct ModuleDiagnostic {
    code: i32,
    package_symbol: i32,
    path_symbol: i32,
    name_symbol: i32,
}

fn module_error_missing_export() -> i32 { 4101 }
fn module_error_missing_dependency() -> i32 { 4102 }
fn module_error_duplicate_export() -> i32 { 4103 }

fn module_diagnostic_score(diag: ModuleDiagnostic) -> i32 {
    diag.code + diag.package_symbol + diag.path_symbol + diag.name_symbol
}

pub fn module_diag_missing_export_score(package_symbol: i32, path_symbol: i32, name_symbol: i32) -> i32 {
    let diag: ModuleDiagnostic = ModuleDiagnostic {
        code: module_error_missing_export(),
        package_symbol: package_symbol,
        path_symbol: path_symbol,
        name_symbol: name_symbol,
    };
    return module_diagnostic_score(diag);
}

pub fn module_diag_missing_dependency_score(package_symbol: i32, path_symbol: i32) -> i32 {
    let diag: ModuleDiagnostic = ModuleDiagnostic {
        code: module_error_missing_dependency(),
        package_symbol: package_symbol,
        path_symbol: path_symbol,
        name_symbol: 0,
    };
    return module_diagnostic_score(diag);
}

pub fn module_diag_duplicate_export_score(package_symbol: i32, path_symbol: i32, name_symbol: i32) -> i32 {
    let diag: ModuleDiagnostic = ModuleDiagnostic {
        code: module_error_duplicate_export(),
        package_symbol: package_symbol,
        path_symbol: path_symbol,
        name_symbol: name_symbol,
    };
    return module_diagnostic_score(diag);
}
