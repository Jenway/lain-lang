struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn tag_atom() -> i32 { 1 }
fn tag_group() -> i32 { 2 }
fn tag_juxt() -> i32 { 3 }
fn tag_infix() -> i32 { 4 }
fn tag_postfix() -> i32 { 6 }

fn child_or_null(node: AstSexpr) -> addr {
    if node.has_child == 0 {
        0
    } else {
        node.first_child
    }
}

fn second_child_or_null(node: AstSexpr) -> addr {
    let first: AstSexpr = child_or_null(node);
    if first.has_next == 0 {
        0
    } else {
        first.next
    }
}

fn is_atom_symbol(node: AstSexpr, symbol: i32) -> i32 {
    if node.tag == tag_atom() {
        if node.symbol == symbol {
            1
        } else {
            0
        }
    } else {
        0
    }
}

fn count_params(param_group: AstSexpr, comma_symbol: i32) -> i32 {
    if param_group.has_child == 0 {
        0
    } else {
        count_param_nodes(param_group.first_child, comma_symbol)
    }
}

fn count_param_nodes(node: AstSexpr, comma_symbol: i32) -> i32 {
    let self_count: i32 = if is_atom_symbol(node, comma_symbol) == 1 {
        0
    } else {
        1
    };
    let next_count: i32 = if node.has_next == 0 {
        0
    } else {
        count_param_nodes(node.next, comma_symbol)
    };
    self_count + next_count
}

fn signature_call_or_null(signature: AstSexpr) -> addr {
    if signature.tag != tag_infix() {
        return 0;
    }
    let call_node: AstSexpr = child_or_null(signature);
    if call_node.tag != tag_postfix() {
        return 0;
    }
    return call_node;
}

fn signature_name(signature: AstSexpr) -> i32 {
    let call_node: AstSexpr = signature_call_or_null(signature);
    if call_node.tag != tag_postfix() {
        return 0;
    }
    let name_node: AstSexpr = child_or_null(call_node);
    return name_node.symbol;
}

fn signature_param_count(signature: AstSexpr, comma_symbol: i32) -> i32 {
    let call_node: AstSexpr = signature_call_or_null(signature);
    if call_node.tag != tag_postfix() {
        return 0;
    }
    let params_node: AstSexpr = second_child_or_null(call_node);
    return count_params(params_node, comma_symbol);
}

fn signature_ret(signature: AstSexpr) -> i32 {
    if signature.tag != tag_infix() {
        return 0;
    }
    let ret_node: AstSexpr = second_child_or_null(signature);
    return ret_node.symbol;
}

pub fn ast_sexpr_parse_fn_signature_name(signature: AstSexpr, comma_symbol: i32) -> i32 {
    return signature_name(signature);
}

pub fn ast_sexpr_parse_fn_signature_param_count(signature: AstSexpr, comma_symbol: i32) -> i32 {
    return signature_param_count(signature, comma_symbol);
}

pub fn ast_sexpr_parse_fn_signature_ret(signature: AstSexpr, comma_symbol: i32) -> i32 {
    return signature_ret(signature);
}
