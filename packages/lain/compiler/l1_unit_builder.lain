// Structured L1 construction policy retained after removal of the C node
// store.  The unresolved host_* calls below must become Lain data structures
// and mutations.

@export
let l1_unit_builder_new = std::func() -> i32 { return host_unit_new(); }
@export
let l1_unit_builder_proc = std::func(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_proc_new(unit, name, return_type);
}
@export
let l1_unit_builder_extern = std::func(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_proc_extern(unit, name, return_type);
}
@export
let l1_unit_builder_param = std::func(
    unit: i32, procedure: i32, type_tag: i32) -> i32 {
    return host_proc_param(unit, procedure, type_tag);
}
@export
let l1_unit_builder_proc_body = std::func(
    unit: i32, procedure: i32) -> i32 {
    return host_proc_body(unit, procedure);
}
@export
let l1_unit_builder_i32 = std::func(unit: i32, value: i32) -> i32 {
    return host_expr_i32(unit, value);
}
@export
let l1_unit_builder_string = std::func(unit: i32, value: addr) -> i32 {
    return host_expr_string(unit, value);
}
@export
let l1_unit_builder_arg = std::func(
    unit: i32, index: i32, type_tag: i32) -> i32 {
    return host_expr_arg(unit, index, type_tag);
}
@export
let l1_unit_builder_var = std::func(
    unit: i32, name: addr, type_tag: i32) -> i32 {
    return host_expr_var(unit, name, type_tag);
}
@export
let l1_unit_builder_add = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 1, left, right);
}
@export
let l1_unit_builder_eq = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 2, left, right);
}
@export
let l1_unit_builder_ne = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 3, left, right);
}
@export
let l1_unit_builder_lt = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 4, left, right);
}
@export
let l1_unit_builder_le = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 5, left, right);
}
@export
let l1_unit_builder_gt = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 6, left, right);
}
@export
let l1_unit_builder_ge = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 7, left, right);
}
@export
let l1_unit_builder_sub = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 8, left, right);
}
@export
let l1_unit_builder_mul = std::func(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 9, left, right);
}
@export
let l1_unit_builder_call = std::func(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_expr_call(unit, name, return_type);
}
@export
let l1_unit_builder_alloca = std::func(unit: i32, byte_size: i32) -> i32 {
    return host_expr_alloca(unit, byte_size);
}
@export
let l1_unit_builder_lea = std::func(
    unit: i32, base: i32, offset: i32) -> i32 {
    return host_expr_lea(unit, base, offset);
}
@export
let l1_unit_builder_load = std::func(
    unit: i32, address: i32, type_tag: i32) -> i32 {
    return host_expr_load(unit, address, type_tag);
}
@export
let l1_unit_builder_call_arg = std::func(
    unit: i32, call: i32, argument: i32) -> i32 {
    return host_call_arg(unit, call, argument);
}
@export
let l1_unit_builder_let = std::func(
    unit: i32, procedure: i32, name: addr,
    type_tag: i32, value: i32) -> i32 {
    return host_proc_let(procedure, name, type_tag, value);
}
@export
let l1_unit_builder_return = std::func(
    unit: i32, procedure: i32, value: i32) -> i32 {
    return host_proc_return(unit, procedure, value);
}
@export
let l1_unit_builder_store = std::func(
    unit: i32, procedure: i32, destination: i32,
    value: i32, type_tag: i32) -> i32 {
    return host_proc_store(procedure, destination, value, type_tag);
}
@export
let l1_unit_builder_if_return = std::func(
    unit: i32, procedure: i32, condition: i32,
    then_value: i32, else_value: i32) -> i32 {
    return host_proc_if_return(
        procedure, condition, then_value, else_value);
}
@export
let l1_unit_builder_if_return_then = std::func(
    unit: i32, procedure: i32,
    condition: i32, then_value: i32) -> i32 {
    return host_proc_if_return_then(procedure, condition, then_value);
}
@export
let l1_unit_builder_block_if = std::func(
    unit: i32, block: i32, condition: i32) -> i32 {
    return host_block_if(block, condition);
}
@export
let l1_unit_builder_block_else = std::func(
    unit: i32, then_block: i32) -> i32 {
    return host_block_else(then_block);
}
@export
let l1_unit_builder_block_let = std::func(
    unit: i32, block: i32, name: addr,
    type_tag: i32, value: i32) -> i32 {
    return host_block_let(block, name, type_tag, value);
}
@export
let l1_unit_builder_block_return = std::func(
    unit: i32, block: i32, value: i32) -> i32 {
    return host_block_return(block, value);
}
@export
let l1_unit_builder_block_call = std::func(
    unit: i32, block: i32, value: i32) -> i32 {
    return host_block_call(block, value);
}
@export
let l1_unit_builder_block_store = std::func(
    unit: i32, block: i32, destination: i32,
    value: i32, type_tag: i32) -> i32 {
    return host_block_store(block, destination, value, type_tag);
}
@export
let l1_unit_builder_block_set = std::func(
    unit: i32, block: i32, name: addr,
    type_tag: i32, value: i32) -> i32 {
    return host_block_set(block, name, type_tag, value);
}
@export
let l1_unit_builder_block_loop = std::func(
    unit: i32, block: i32) -> i32 {
    return host_block_loop(block);
}
@export
let l1_unit_builder_block_break = std::func(
    unit: i32, block: i32) -> i32 {
    return host_block_break(block);
}
@export
let l1_unit_builder_block_continue = std::func(
    unit: i32, block: i32) -> i32 {
    return host_block_continue(block);
}
@export
let l1_unit_builder_verify = std::func(unit: i32, entry: addr) -> i32 {
    return host_unit_verify(unit, entry);
}
@export
let l1_unit_builder_verify_code = std::func(unit: i32, entry: addr) -> i32 {
    return host_unit_verify_code(unit, entry);
}
@export
let l1_unit_builder_verify_message = std::func(unit: i32, entry: addr) -> addr {
    return host_unit_verify_message(unit, entry);
}
@export
let l1_unit_builder_destroy = std::func(unit: i32) -> i32 {
    return host_unit_destroy(unit);
}
@export
let l1_unit_builder_debug_text = std::func(unit: i32) -> addr {
    return host_unit_debug_text(unit);
}
