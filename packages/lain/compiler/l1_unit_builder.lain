// Lain-owned structured L1 construction API.
// The host stores opaque physical nodes; all construction policy lives in
// the Lain lowerer.

@foreign(c, link_name = "l1.unit-new!")
fn host_unit_new() -> i32;
@foreign(c, link_name = "l1.proc-new!")
fn host_proc_new(unit: i32, name: addr, return_type: i32) -> i32;
@foreign(c, link_name = "l1.proc-extern!")
fn host_proc_extern(unit: i32, name: addr, return_type: i32) -> i32;
@foreign(c, link_name = "l1.proc-param!")
fn host_proc_param(unit: i32, procedure: i32, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.proc-body!")
fn host_proc_body(unit: i32, procedure: i32) -> i32;
@foreign(c, link_name = "l1.expr-i32!")
fn host_expr_i32(unit: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.expr-string!")
fn host_expr_string(unit: i32, value: addr) -> i32;
@foreign(c, link_name = "l1.expr-arg!")
fn host_expr_arg(unit: i32, index: i32, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.expr-var!")
fn host_expr_var(unit: i32, name: addr, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.expr-binary!")
fn host_expr_binary(
    unit: i32, operation: i32, left: i32, right: i32) -> i32;
@foreign(c, link_name = "l1.expr-call!")
fn host_expr_call(unit: i32, name: addr, return_type: i32) -> i32;
@foreign(c, link_name = "l1.expr-alloca!")
fn host_expr_alloca(unit: i32, byte_size: i32) -> i32;
@foreign(c, link_name = "l1.expr-lea!")
fn host_expr_lea(unit: i32, base: i32, offset: i32) -> i32;
@foreign(c, link_name = "l1.expr-load!")
fn host_expr_load(unit: i32, address: i32, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.call-arg!")
fn host_call_arg(unit: i32, call: i32, argument: i32) -> i32;
@foreign(c, link_name = "l1.proc-let!")
fn host_proc_let(
    procedure: i32, name: addr, type_tag: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.proc-return!")
fn host_proc_return(unit: i32, procedure: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.proc-store!")
fn host_proc_store(
    procedure: i32, destination: i32, value: i32, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.proc-if-return!")
fn host_proc_if_return(
    procedure: i32, condition: i32, then_value: i32, else_value: i32) -> i32;
@foreign(c, link_name = "l1.proc-if-return-then!")
fn host_proc_if_return_then(
    procedure: i32, condition: i32, then_value: i32) -> i32;
@foreign(c, link_name = "l1.block-if!")
fn host_block_if(block: i32, condition: i32) -> i32;
@foreign(c, link_name = "l1.block-let!")
fn host_block_let(
    block: i32, name: addr, type_tag: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.block-return!")
fn host_block_return(block: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.block-call!")
fn host_block_call(block: i32, value: i32) -> i32;
@foreign(c, link_name = "l1.block-store!")
fn host_block_store(
    block: i32, destination: i32, value: i32, type_tag: i32) -> i32;
@foreign(c, link_name = "l1.unit-verify!")
fn host_unit_verify(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "l1.unit-verify-code!")
fn host_unit_verify_code(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "l1.unit-verify-message!")
fn host_unit_verify_message(unit: i32, entry: addr) -> addr;
@foreign(c, link_name = "core.destroy-lainir-unit!")
fn host_unit_destroy(unit: i32) -> i32;
@foreign(c, link_name = "core.lainir-unit-debug-text!")
fn host_unit_debug_text(unit: i32) -> addr;

pub fn l1_unit_builder_new() -> i32 { return host_unit_new(); }
pub fn l1_unit_builder_proc(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_proc_new(unit, name, return_type);
}
pub fn l1_unit_builder_extern(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_proc_extern(unit, name, return_type);
}
pub fn l1_unit_builder_param(
    unit: i32, procedure: i32, type_tag: i32) -> i32 {
    return host_proc_param(unit, procedure, type_tag);
}
pub fn l1_unit_builder_proc_body(
    unit: i32, procedure: i32) -> i32 {
    return host_proc_body(unit, procedure);
}
pub fn l1_unit_builder_i32(unit: i32, value: i32) -> i32 {
    return host_expr_i32(unit, value);
}
pub fn l1_unit_builder_string(unit: i32, value: addr) -> i32 {
    return host_expr_string(unit, value);
}
pub fn l1_unit_builder_arg(
    unit: i32, index: i32, type_tag: i32) -> i32 {
    return host_expr_arg(unit, index, type_tag);
}
pub fn l1_unit_builder_var(
    unit: i32, name: addr, type_tag: i32) -> i32 {
    return host_expr_var(unit, name, type_tag);
}
pub fn l1_unit_builder_add(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 1, left, right);
}
pub fn l1_unit_builder_eq(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 2, left, right);
}
pub fn l1_unit_builder_ne(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 3, left, right);
}
pub fn l1_unit_builder_lt(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 4, left, right);
}
pub fn l1_unit_builder_le(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 5, left, right);
}
pub fn l1_unit_builder_gt(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 6, left, right);
}
pub fn l1_unit_builder_ge(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 7, left, right);
}
pub fn l1_unit_builder_sub(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 8, left, right);
}
pub fn l1_unit_builder_mul(unit: i32, left: i32, right: i32) -> i32 {
    return host_expr_binary(unit, 9, left, right);
}
pub fn l1_unit_builder_call(
    unit: i32, name: addr, return_type: i32) -> i32 {
    return host_expr_call(unit, name, return_type);
}
pub fn l1_unit_builder_alloca(unit: i32, byte_size: i32) -> i32 {
    return host_expr_alloca(unit, byte_size);
}
pub fn l1_unit_builder_lea(
    unit: i32, base: i32, offset: i32) -> i32 {
    return host_expr_lea(unit, base, offset);
}
pub fn l1_unit_builder_load(
    unit: i32, address: i32, type_tag: i32) -> i32 {
    return host_expr_load(unit, address, type_tag);
}
pub fn l1_unit_builder_call_arg(
    unit: i32, call: i32, argument: i32) -> i32 {
    return host_call_arg(unit, call, argument);
}
pub fn l1_unit_builder_let(
    unit: i32, procedure: i32, name: addr,
    type_tag: i32, value: i32) -> i32 {
    return host_proc_let(procedure, name, type_tag, value);
}
pub fn l1_unit_builder_return(
    unit: i32, procedure: i32, value: i32) -> i32 {
    return host_proc_return(unit, procedure, value);
}
pub fn l1_unit_builder_store(
    unit: i32, procedure: i32, destination: i32,
    value: i32, type_tag: i32) -> i32 {
    return host_proc_store(procedure, destination, value, type_tag);
}
pub fn l1_unit_builder_if_return(
    unit: i32, procedure: i32, condition: i32,
    then_value: i32, else_value: i32) -> i32 {
    return host_proc_if_return(
        procedure, condition, then_value, else_value);
}
pub fn l1_unit_builder_if_return_then(
    unit: i32, procedure: i32,
    condition: i32, then_value: i32) -> i32 {
    return host_proc_if_return_then(procedure, condition, then_value);
}
pub fn l1_unit_builder_block_if(
    unit: i32, block: i32, condition: i32) -> i32 {
    return host_block_if(block, condition);
}
pub fn l1_unit_builder_block_let(
    unit: i32, block: i32, name: addr,
    type_tag: i32, value: i32) -> i32 {
    return host_block_let(block, name, type_tag, value);
}
pub fn l1_unit_builder_block_return(
    unit: i32, block: i32, value: i32) -> i32 {
    return host_block_return(block, value);
}
pub fn l1_unit_builder_block_call(
    unit: i32, block: i32, value: i32) -> i32 {
    return host_block_call(block, value);
}
pub fn l1_unit_builder_block_store(
    unit: i32, block: i32, destination: i32,
    value: i32, type_tag: i32) -> i32 {
    return host_block_store(block, destination, value, type_tag);
}
pub fn l1_unit_builder_verify(unit: i32, entry: addr) -> i32 {
    return host_unit_verify(unit, entry);
}
pub fn l1_unit_builder_verify_code(unit: i32, entry: addr) -> i32 {
    return host_unit_verify_code(unit, entry);
}
pub fn l1_unit_builder_verify_message(unit: i32, entry: addr) -> addr {
    return host_unit_verify_message(unit, entry);
}
pub fn l1_unit_builder_destroy(unit: i32) -> i32 {
    return host_unit_destroy(unit);
}
pub fn l1_unit_builder_debug_text(unit: i32) -> addr {
    return host_unit_debug_text(unit);
}
