@export
let L1 = std::module {

    let Type: type = std::struct {
        tag: i32,
        width: i32
    };

    let l1_type_i32 = std::func() -> Type {
        return Type {
            tag: 1,
            width: 32
        };
    };

    @export
    let l1_type_i32_tag = std::func() -> i32 {
        let ty : Type = l1_type_i32();
        return ty.tag;
    };
}
