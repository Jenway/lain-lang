import packages::lain::compiler::l1_region;
import packages::lain::compiler::l1_value;

struct L1Procedure { name: i32, parameter_count: i32, return_type_tag: i32, instruction_count: i32, body_score: i32 }

fn l1_procedure_return_i32(name: i32, value: i32) -> L1Procedure {
    return L1Procedure { name: name, parameter_count: 0, return_type_tag: l1_value_i32_type_tag(value), instruction_count: 1, body_score: l1_region_return_score(value) };
}

fn l1_procedure_add_i32(name: i32, left: i32, right: i32) -> L1Procedure {
    return L1Procedure { name: name, parameter_count: 0, return_type_tag: l1_value_i32_type_tag(left + right), instruction_count: 2, body_score: l1_region_add_score(left, right) };
}

pub fn l1_procedure_return_score(name: i32, value: i32) -> i32 {
    let procedure: L1Procedure = l1_procedure_return_i32(name, value);
    return procedure.name + procedure.parameter_count + procedure.return_type_tag + procedure.instruction_count + procedure.body_score;
}

pub fn l1_procedure_add_score(name: i32, left: i32, right: i32) -> i32 {
    let procedure: L1Procedure = l1_procedure_add_i32(name, left, right);
    return procedure.name + procedure.parameter_count + procedure.return_type_tag + procedure.instruction_count + procedure.body_score;
}
