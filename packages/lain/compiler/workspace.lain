// Orchestration for a workspace of Meta-owned Module values.

let syntax = import("packages::lain::compiler::syntax");
let types = import("packages::lain::compiler::types");
let compiler_context = import("packages::lain::compiler::compiler_context");
let modules = import("packages::lain::compiler::modules");
let elaborator = import("packages::lain::compiler::elaborator");
let lower = import("packages::lain::compiler::lower");
let diagnostics = import("packages::lain::compiler::diagnostics");
@export
let workspace_schema_version = std::func() -> i32 { return 5; }

let workspace_validate_modules = std::func(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let code: i32 = elaborator_validate_module_indexed(
        workspace, module_workspace_module_at(workspace, index));
    if code != 0 { return code; }
    return workspace_validate_modules(workspace, index + 1);
}

@export
let workspace_validate_indexed = std::func(workspace: ModuleWorkspace) -> i32 {
    let module_code: i32 = module_workspace_validate(workspace);
    if module_code != 0 { return module_code; }
    return workspace_validate_modules(workspace, 0);
}

let workspace_semantic_source_index_from = std::func(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    if elaborator_validate_module_indexed(
        workspace, module_workspace_module_at(workspace, index)) != 0 {
        return module_workspace_source_index_at(workspace, index);
    }
    return workspace_semantic_source_index_from(workspace, index + 1);
}

@export
let workspace_diagnostic_source_index_indexed = std::func(
    workspace: ModuleWorkspace) -> i32 {
    if module_workspace_validate(workspace) != 0 {
        return module_workspace_validation_source_index(workspace);
    }
    return workspace_semantic_source_index_from(workspace, 0);
}

@export
let workspace_validate = std::func(root: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root);
    let code: i32 = workspace_validate_indexed(workspace);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return code;
}

let workspace_semantic_diagnostic_module = std::func(
    workspace: ModuleWorkspace, index: i32) -> addr {
    if index == module_workspace_count(workspace) { return ""; }
    let module: i32 = module_workspace_module_at(workspace, index);
    if elaborator_validate_module_indexed(workspace, module) != 0 {
        return module_summary_name(module);
    }
    return workspace_semantic_diagnostic_module(
        workspace, index + 1);
}

let workspace_semantic_diagnostic_function = std::func(
    workspace: ModuleWorkspace, index: i32) -> addr {
    if index == module_workspace_count(workspace) { return ""; }
    let module: i32 = module_workspace_module_at(workspace, index);
    if elaborator_validate_module_indexed(workspace, module) != 0 {
        return elaborator_module_diagnostic_function_indexed(
            workspace, module);
    }
    return workspace_semantic_diagnostic_function(
        workspace, index + 1);
}

@export
let workspace_diagnostic_module_indexed = std::func(
    workspace: ModuleWorkspace) -> addr {
    return workspace_semantic_diagnostic_module(workspace, 0);
}

@export
let workspace_diagnostic_function_indexed = std::func(
    workspace: ModuleWorkspace) -> addr {
    return workspace_semantic_diagnostic_function(workspace, 0);
}

@export
let workspace_diagnostic_module = std::func(workspace: i32) -> addr {
    if module_validate_workspace(workspace) != 0 {
        return module_diagnostic_module(workspace);
    }
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    let result: addr = workspace_diagnostic_module_indexed(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return result;
}

@export
let workspace_diagnostic_function = std::func(workspace: i32) -> addr {
    if module_validate_workspace(workspace) != 0 { return ""; }
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    let result: addr = workspace_diagnostic_function_indexed(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return result;
}

@export
let workspace_ok = std::func(workspace: i32) -> i32 {
    if workspace_validate(workspace) == 0 { return 1; }
    return 0;
}

@export
let workspace_module_count = std::func(workspace: i32) -> i32 {
    return module_workspace_module_count(workspace);
}

@export
let workspace_dependency_count = std::func(workspace: i32) -> i32 {
    return module_view_workspace_dependency_count(workspace);
}

@export
let workspace_has_module = std::func(workspace: i32, name: addr) -> i32 {
    if module_view_workspace_find(workspace, name) != 0 { return 1; }
    return 0;
}

@export
let workspace_export_count = std::func(workspace: i32, module_name: addr) -> i32 {
    let module: i32 = module_view_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return module_summary_export_count(module);
}

@export
let workspace_has_export = std::func(
    workspace: i32, module_name: addr, name: addr) -> i32 {
    let module: i32 = module_view_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return module_summary_has_export(module, name);
}

@export
let workspace_export_param_count = std::func(
    workspace: i32, module_name: addr, name: addr) -> i32 {
    let module: i32 = module_view_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return module_summary_export_param_count(module, name);
}

@export
let workspace_export_return_type = std::func(
    workspace: i32, module_name: addr, name: addr) -> addr {
    let module: i32 = module_view_workspace_find(workspace, module_name);
    if module == 0 { return ""; }
    return module_summary_export_return_type(module, name);
}

@export
let workspace_diagnostic_message = std::func(workspace: i32) -> addr {
    return diagnostic_message(workspace_validate(workspace));
}

@export
let workspace_compile = std::func(workspace: i32) -> i32 {
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    if workspace_validate_indexed(index) != 0 {
        let destroyed_failure: i32 = module_workspace_destroy(index);
        return 0;
    }
    let unit: i32 = lower_workspace_validated(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return unit;
}

@export
let workspace_compile_indexed = std::func(workspace: ModuleWorkspace) -> i32 {
    if workspace_validate_indexed(workspace) != 0 { return 0; }
    return lower_workspace_validated(workspace);
}
