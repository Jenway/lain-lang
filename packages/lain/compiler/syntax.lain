// Zero-copy semantic views over topology-only RawAst handles.
// All knowledge of RawAst topology for the first Lain-owned domain lives here.

@foreign(c, link_name = "ast.parse!")
let ast_parse = std::func(source: addr, length: i32) -> i32;
@foreign(c, link_name = "ast.node-kind")
let ast_node_kind = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-left")
let ast_node_left = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-right")
let ast_node_right = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-op")
let ast_node_op = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-next")
let ast_node_next = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-text")
let ast_node_text = std::func(node: i32) -> addr;
@foreign(c, link_name = "ast.node-string-value")
let ast_node_string_value = std::func(node: i32) -> addr;
@foreign(c, link_name = "ast.node-is-atom-text")
let ast_node_is_atom_text = std::func(node: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.node-is-infix-text")
let ast_node_is_infix_text = std::func(node: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.node-atom-class")
let ast_node_atom_class = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-line")
let ast_node_line = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-origin")
let ast_node_origin = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-hygiene")
let ast_node_hygiene = std::func(node: i32) -> i32;

// Stable multi-source reader capability.  unit-root returns an opaque i32
// accepted by the ordinary ast.node-* functions below.  Store/unit ids exist
// only for explicit lifetime management; they do not leak through semantic
// syntax traversal.
@foreign(c, link_name = "ast.store-new!")
let ast_store_new = std::func() -> i32;
@foreign(c, link_name = "ast.store-destroy!")
let ast_store_destroy = std::func(store: i32) -> i32;
@foreign(c, link_name = "ast.unit-parse!")
let ast_unit_parse = std::func(store: i32, source: addr, length: i32) -> i32;
@foreign(c, link_name = "ast.unit-destroy!")
let ast_unit_destroy = std::func(store: i32, unit: i32) -> i32;
@foreign(c, link_name = "ast.unit-root")
let ast_unit_root = std::func(store: i32, unit: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-count")
let ast_unit_node_count = std::func(store: i32, unit: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-kind")
let ast_unit_node_kind = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-text")
let ast_unit_node_text = std::func(store: i32, unit: i32, node: i32) -> addr;
@foreign(c, link_name = "ast.unit-node-string-value")
let ast_unit_node_string_value = std::func(store: i32, unit: i32, node: i32) -> addr;
@foreign(c, link_name = "ast.unit-node-is-atom-text")
let ast_unit_node_is_atom_text = std::func(store: i32, unit: i32, node: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.unit-node-is-infix-text")
let ast_unit_node_is_infix_text = std::func(store: i32, unit: i32, node: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.unit-node-atom-class")
let ast_unit_node_atom_class = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-line")
let ast_unit_node_line = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-col")
let ast_unit_node_col = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-left")
let ast_unit_node_left = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-right")
let ast_unit_node_right = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-op")
let ast_unit_node_op = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "ast.unit-node-next")
let ast_unit_node_next = std::func(store: i32, unit: i32, node: i32) -> i32;
@foreign(c, link_name = "core.string-equal!")
let string_equal = std::func(left: addr, right: addr) -> i32;
@foreign(c, link_name = "core.string-to-i32!")
let string_to_i32 = std::func(text: addr) -> i32;
@foreign(c, link_name = "core.string-is-i32!")
let string_is_i32 = std::func(text: addr) -> i32;
@foreign(c, link_name = "core.i32-to-string!")
let i32_to_string = std::func(value: i32) -> addr;
@foreign(c, link_name = "core.string-first-byte!")
let string_first_byte = std::func(value: addr) -> i32;
@foreign(c, link_name = "core.string-length!")
let string_length = std::func(value: addr) -> i32;
@foreign(c, link_name = "core.string-append!")
let syntax_string_append = std::func(left: addr, right: addr) -> addr;

@export

let syntax_parse = std::func(source: addr, length: i32) -> i32 { return ast_parse(source, length); }
@export
let syntax_store_new = std::func() -> i32 { return ast_store_new(); }
@export
let syntax_store_destroy = std::func(store: i32) -> i32 { return ast_store_destroy(store); }
@export
let syntax_unit_parse = std::func(store: i32, source: addr, length: i32) -> i32 {
    return ast_unit_parse(store, source, length);
}
@export
let syntax_unit_destroy = std::func(store: i32, unit: i32) -> i32 {
    return ast_unit_destroy(store, unit);
}
@export
let syntax_unit_root = std::func(store: i32, unit: i32) -> i32 {
    return ast_unit_root(store, unit);
}
@export
let syntax_unit_node_count = std::func(store: i32, unit: i32) -> i32 {
    return ast_unit_node_count(store, unit);
}
@export
let syntax_unit_kind = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_kind(store, unit, node);
}
@export
let syntax_unit_text = std::func(store: i32, unit: i32, node: i32) -> addr {
    return ast_unit_node_text(store, unit, node);
}
@export
let syntax_unit_string_value = std::func(store: i32, unit: i32, node: i32) -> addr {
    return ast_unit_node_string_value(store, unit, node);
}
@export
let syntax_unit_is_atom_text = std::func(
    store: i32, unit: i32, node: i32, text: addr) -> i32 {
    return ast_unit_node_is_atom_text(store, unit, node, text);
}
@export
let syntax_unit_is_infix = std::func(
    store: i32, unit: i32, node: i32, text: addr) -> i32 {
    return ast_unit_node_is_infix_text(store, unit, node, text);
}
@export
let syntax_unit_atom_class = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_atom_class(store, unit, node);
}
@export
let syntax_unit_line = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_line(store, unit, node);
}
@export
let syntax_unit_col = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_col(store, unit, node);
}
@export
let syntax_unit_left = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_left(store, unit, node);
}
@export
let syntax_unit_right = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_right(store, unit, node);
}
@export
let syntax_unit_op = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_op(store, unit, node);
}
@export
let syntax_unit_next = std::func(store: i32, unit: i32, node: i32) -> i32 {
    return ast_unit_node_next(store, unit, node);
}
@export
let syntax_kind = std::func(node: i32) -> i32 { return ast_node_kind(node); }
@export
let syntax_left = std::func(node: i32) -> i32 { return ast_node_left(node); }
@export
let syntax_right = std::func(node: i32) -> i32 { return ast_node_right(node); }
@export
let syntax_op = std::func(node: i32) -> i32 { return ast_node_op(node); }
@export
let syntax_next = std::func(node: i32) -> i32 { return ast_node_next(node); }
@export
let syntax_text = std::func(node: i32) -> addr { return ast_node_text(node); }
@export
let syntax_string_value = std::func(node: i32) -> addr {
    return ast_node_string_value(node);
}
@export
let syntax_line = std::func(node: i32) -> i32 { return ast_node_line(node); }
@export
let syntax_origin = std::func(node: i32) -> i32 {
    return ast_node_origin(node);
}

let syntax_call_site_from = std::func(node: i32, depth: i32) -> i32 {
    if node == 0 { return 0; }
    if depth >= 64 { return node; }
    let origin: i32 = syntax_origin(node);
    if origin == 0 { return node; }
    if origin == node { return node; }
    return syntax_call_site_from(origin, depth + 1);
}

@export
let syntax_call_site = std::func(node: i32) -> i32 {
    return syntax_call_site_from(node, 0);
}
@export
let syntax_hygiene = std::func(node: i32) -> i32 {
    return ast_node_hygiene(node);
}
@export
let syntax_text_equal = std::func(left: addr, right: addr) -> i32 { return string_equal(left, right); }
@export
let syntax_i32_text = std::func(value: i32) -> addr { return i32_to_string(value); }
@export
let syntax_text_append = std::func(left: addr, right: addr) -> addr {
    return syntax_string_append(left, right);
}
@export
let syntax_i32_value = std::func(node: i32) -> i32 {
    return string_to_i32(syntax_text(node));
}

@export

let syntax_is_atom_text = std::func(node: i32, text: addr) -> i32 {
    return ast_node_is_atom_text(node, text);
}

@export

let syntax_is_infix = std::func(node: i32, op: addr) -> i32 {
    return ast_node_is_infix_text(node, op);
}

@export

let syntax_is_prefix = std::func(node: i32, op: addr) -> i32 {
    if syntax_kind(node) != 2 { return 0; }
    return syntax_is_atom_text(syntax_op(node), op);
}

@export

let syntax_prefix_operand = std::func(node: i32) -> i32 {
    return syntax_left(node);
}

@export

let syntax_is_juxt = std::func(node: i32) -> i32 { return syntax_is_infix(node, " "); }

@export

let syntax_is_i32_atom = std::func(node: i32) -> i32 {
    if ast_node_atom_class(node) == 1 { return 1; }
    return 0;
}

@export

let syntax_is_identifier = std::func(node: i32) -> i32 {
    if ast_node_atom_class(node) != 3 { return 0; }
    if syntax_is_atom_text(node, ";") == 1 { return 0; }
    if syntax_is_atom_text(node, ",") == 1 { return 0; }
    return 1;
}

// Identifier identity is spelling plus the expansion context that introduced
// it.  Parsed source and explicit call-site clones use context 0; freshly
// generated identifiers use their Meta expansion context.
@export
let syntax_identifier_equal = std::func(left: i32, right: i32) -> i32 {
    if syntax_is_identifier(left) != 1 { return 0; }
    if syntax_is_identifier(right) != 1 { return 0; }
    if string_equal(syntax_text(left), syntax_text(right)) != 1 { return 0; }
    if syntax_hygiene(left) != syntax_hygiene(right) { return 0; }
    return 1;
}

@export
let syntax_identifier_link_name = std::func(identifier: i32) -> addr {
    let spelling: addr = syntax_text(identifier);
    let context: i32 = syntax_hygiene(identifier);
    if context == 0 { return spelling; }
    return syntax_string_append(
        syntax_string_append(spelling, "__h"),
        syntax_i32_text(context));
}

@export

let syntax_is_string_atom = std::func(node: i32) -> i32 {
    if ast_node_atom_class(node) == 2 { return 1; }
    return 0;
}

// A surface path is topology, not a module decision.  In particular both
// `std::func` and a longer `packages::foo::bar` path remain ordinary `::`
// infix trees until Meta resolves them.
@export
let syntax_is_path = std::func(node: i32) -> i32 {
    if syntax_is_identifier(node) == 1 { return 1; }
    if syntax_is_infix(node, "::") != 1 { return 0; }
    if syntax_is_path(ast_node_left(node)) != 1 { return 0; }
    return syntax_is_identifier(ast_node_right(node));
}

@export

let syntax_path_tail = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, "::") == 1 {
        return ast_node_right(node);
    }
    return node;
}

@export

let syntax_path_tail_is = std::func(node: i32, name: addr) -> i32 {
    return syntax_is_atom_text(syntax_path_tail(node), name);
}

// Pratt topology for a qualified call is
// `(:: namespace (postfix callee (group ...)))`, whereas an unqualified call
// is the postfix node itself.  These helpers deliberately expose one view to
// Meta without assigning meaning to the namespace.
@export
let syntax_is_qualified_call = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, "::") != 1 { return 0; }
    if syntax_is_path(ast_node_left(node)) != 1 { return 0; }
    let invocation: i32 = ast_node_right(node);
    if ast_node_kind(invocation) != 3 { return 0; }
    if syntax_is_atom_text(ast_node_op(invocation), "(") != 1 { return 0; }
    return syntax_is_identifier(ast_node_left(invocation));
}

@export

let syntax_call_callee = std::func(node: i32) -> i32 {
    if syntax_is_qualified_call(node) == 1 {
        return ast_node_left(ast_node_right(node));
    }
    return ast_node_left(node);
}

@export

let syntax_call_namespace = std::func(node: i32) -> i32 {
    if syntax_is_qualified_call(node) == 1 {
        return ast_node_left(node);
    }
    return 0;
}

@export

let syntax_call_callee_is = std::func(node: i32, name: addr) -> i32 {
    if syntax_is_call(node) != 1 { return 0; }
    return syntax_is_atom_text(syntax_call_callee(node), name);
}

@export
let syntax_is_std_call = std::func(node: i32, name: addr) -> i32 {
    if syntax_is_qualified_call(node) != 1 { return 0; }
    let namespace: i32 = syntax_call_namespace(node);
    if syntax_is_atom_text(namespace, "std") != 1 { return 0; }
    return syntax_call_callee_is(node, name);
}

@export
let syntax_is_consteval_call = std::func(node: i32) -> i32 {
    if syntax_is_std_call(node, "consteval") != 1 { return 0; }
    if syntax_arg_count(syntax_call_first_arg(node)) != 1 { return 0; }
    return 1;
}

@export
let syntax_consteval_operand = std::func(node: i32) -> i32 {
    if syntax_is_consteval_call(node) != 1 { return 0; }
    return syntax_call_first_arg(node);
}

@export

let syntax_first_function = std::func(root: i32) -> i32 { return ast_node_left(root); }
@export
let syntax_function_next = std::func(function: i32) -> i32 { return ast_node_next(function); }
@export
let syntax_function_head = std::func(function: i32) -> i32 {
    if syntax_is_juxt(function) == 1 {
        if syntax_kind(ast_node_right(function)) == 4 {
            return ast_node_left(function);
        }
    }
    return function;
}
@export
let syntax_function_body = std::func(function: i32) -> i32 {
    if syntax_is_juxt(function) != 1 { return 0; }
    if syntax_kind(ast_node_right(function)) != 4 { return 0; }
    return ast_node_right(function);
}
@export
let syntax_function_signature = std::func(function: i32) -> i32 {
    return ast_node_right(syntax_function_head(function));
}
// There is one function surface form:
// `let name[: Expected] = [path::]func(params) -> Return { body }`.
// Historical `fn name`, `pub fn name`, and declaration-only `fn name` forms
// intentionally have no style and are rejected by domain validation.
@export
let syntax_function_style = std::func(function: i32) -> i32 {
    if syntax_is_juxt(function) != 1 { return 0; }
    let head: i32 = syntax_function_head(function);
    if syntax_is_juxt(head) != 1 { return 0; }
    if syntax_is_atom_text(ast_node_left(head), "let") != 1 { return 0; }
    let signature: i32 = ast_node_right(head);
    if syntax_is_infix(signature, "->") != 1 { return 0; }
    let binding: i32 = ast_node_left(signature);
    if syntax_is_infix(binding, "=") != 1 { return 0; }
    if syntax_call_callee_is(ast_node_right(binding), "func") != 1 {
        return 0;
    }
    return 1;
}
@export
let syntax_function_binding = std::func(function: i32) -> i32 {
    return ast_node_left(syntax_function_signature(function));
}
@export
let syntax_function_name_node = std::func(function: i32) -> i32 {
    let declared: i32 = ast_node_left(syntax_function_binding(function));
    if syntax_is_infix(declared, ":") == 1 {
        return ast_node_left(declared);
    }
    return declared;
}
@export
let syntax_function_name = std::func(function: i32) -> addr {
    return ast_node_text(syntax_function_name_node(function));
}
@export
let syntax_function_fn_form = std::func(function: i32) -> i32 {
    return ast_node_right(syntax_function_binding(function));
}
@export
let syntax_function_params = std::func(function: i32) -> i32 {
    return syntax_call_args(syntax_function_fn_form(function));
}
@export
let syntax_function_first_param = std::func(function: i32) -> i32 {
    return ast_node_left(syntax_function_params(function));
}

@export

let syntax_param_name_node = std::func(param: i32) -> i32 { return ast_node_left(param); }
@export
let syntax_param_type_node = std::func(param: i32) -> i32 { return ast_node_right(param); }
@export
let syntax_param_next = std::func(param: i32) -> i32 {
    let separator: i32 = ast_node_next(param);
    if separator == 0 { return 0; }
    return ast_node_next(separator);
}

@export

let syntax_param_count = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    return 1 + syntax_param_count(syntax_param_next(param));
}

@export

let syntax_param_named = std::func(param: i32, name: addr) -> i32 {
    if param == 0 { return 0; }
    if string_equal(ast_node_text(ast_node_left(param)), name) == 1 { return 1; }
    return syntax_param_named(syntax_param_next(param), name);
}

@export

let syntax_find_param = std::func(param: i32, name: addr) -> i32 {
    if param == 0 { return 0; }
    if string_equal(ast_node_text(ast_node_left(param)), name) == 1 { return param; }
    return syntax_find_param(syntax_param_next(param), name);
}

@export
let syntax_find_param_node = std::func(param: i32, reference: i32) -> i32 {
    if param == 0 { return 0; }
    if syntax_identifier_equal(
        syntax_param_name_node(param), reference) == 1 { return param; }
    return syntax_find_param_node(syntax_param_next(param), reference);
}

@export

let syntax_param_index = std::func(param: i32, name: addr, index: i32) -> i32 {
    if param == 0 { return 1000000; }
    if string_equal(ast_node_text(ast_node_left(param)), name) == 1 { return index; }
    return syntax_param_index(syntax_param_next(param), name, index + 1);
}

@export
let syntax_param_index_node = std::func(
    param: i32, reference: i32, index: i32) -> i32 {
    if param == 0 { return 1000000; }
    if syntax_identifier_equal(
        syntax_param_name_node(param), reference) == 1 { return index; }
    return syntax_param_index_node(
        syntax_param_next(param), reference, index + 1);
}

@export

let syntax_find_function = std::func(function: i32, name: addr) -> i32 {
    if function == 0 { return 0; }
    if string_equal(syntax_function_name(function), name) == 1 { return function; }
    return syntax_find_function(ast_node_next(function), name);
}

@export

let syntax_function_count = std::func(function: i32) -> i32 {
    if function == 0 { return 0; }
    return 1 + syntax_function_count(ast_node_next(function));
}

@export

let syntax_function_name_count = std::func(function: i32, name: addr) -> i32 {
    if function == 0 { return 0; }
    if string_equal(syntax_function_name(function), name) == 1 {
        return 1 + syntax_function_name_count(ast_node_next(function), name);
    }
    return syntax_function_name_count(ast_node_next(function), name);
}

@export

let syntax_is_call = std::func(node: i32) -> i32 {
    if syntax_is_qualified_call(node) == 1 { return 1; }
    if ast_node_kind(node) != 3 { return 0; }
    if syntax_is_atom_text(ast_node_op(node), "(") != 1 { return 0; }
    return syntax_is_identifier(ast_node_left(node));
}
@export
let syntax_is_macro_call = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if syntax_is_identifier(ast_node_left(node)) != 1 { return 0; }
    let invocation: i32 = ast_node_right(node);
    if syntax_is_prefix(invocation, "!") != 1 { return 0; }
    let args: i32 = syntax_prefix_operand(invocation);
    if syntax_kind(args) != 4 { return 0; }
    return syntax_is_atom_text(syntax_op(args), "(");
}
@export
let syntax_macro_name = std::func(node: i32) -> addr {
    return syntax_text(syntax_left(node));
}
@export
let syntax_macro_first_arg = std::func(node: i32) -> i32 {
    return syntax_left(
        syntax_prefix_operand(syntax_right(node)));
}
@export
let syntax_string_length = std::func(node: i32) -> i32 {
    return string_length(syntax_string_value(node));
}

@export

let syntax_text_length = std::func(value: addr) -> i32 {
    return string_length(value);
}
@export
let syntax_is_unit_type = std::func(node: i32) -> i32 {
    if syntax_kind(node) != 4 { return 0; }
    if syntax_is_atom_text(syntax_op(node), "(") != 1 { return 0; }
    if syntax_left(node) != 0 { return 0; }
    return 1;
}
@export
let syntax_call_name = std::func(node: i32) -> addr {
    return ast_node_text(syntax_call_callee(node));
}
@export
let syntax_call_args = std::func(node: i32) -> i32 {
    if syntax_is_qualified_call(node) == 1 {
        return ast_node_right(ast_node_right(node));
    }
    return ast_node_right(node);
}
@export
let syntax_call_first_arg = std::func(node: i32) -> i32 {
    return ast_node_left(syntax_call_args(node));
}
@export
let syntax_arg_next = std::func(arg: i32) -> i32 {
    let separator: i32 = ast_node_next(arg);
    if separator == 0 { return 0; }
    return ast_node_next(separator);
}
@export
let syntax_arg_count = std::func(arg: i32) -> i32 {
    if arg == 0 { return 0; }
    return 1 + syntax_arg_count(syntax_arg_next(arg));
}

// `Comptime` is not reader syntax.  These helpers only recognize the ordinary
// call topology so the elaborator can assign the Meta type-constructor
// meaning.  Keeping this test here avoids duplicating RawAst shape knowledge.
@export
let syntax_is_comptime_type = std::func(node: i32) -> i32 {
    if syntax_is_call(node) != 1 { return 0; }
    if syntax_call_namespace(node) != 0 { return 0; }
    if syntax_call_callee_is(node, "Comptime") != 1 { return 0; }
    if syntax_arg_count(syntax_call_first_arg(node)) != 1 { return 0; }
    return 1;
}

@export
let syntax_comptime_argument = std::func(node: i32) -> i32 {
    if syntax_is_comptime_type(node) != 1 { return 0; }
    return syntax_call_first_arg(node);
}

@export
let syntax_is_comptime_spelling = std::func(node: i32) -> i32 {
    if syntax_path_tail_is(node, "Comptime") == 1 { return 1; }
    if syntax_is_call(node) != 1 { return 0; }
    return syntax_call_callee_is(node, "Comptime");
}

@export
let syntax_param_is_compiletime = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    let type_node: i32 = syntax_param_type_node(param);
    if syntax_path_tail_is(type_node, "type") == 1 { return 1; }
    return syntax_is_comptime_type(type_node);
}

let syntax_params_have_compiletime = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    if syntax_param_is_compiletime(param) == 1 { return 1; }
    return syntax_params_have_compiletime(syntax_param_next(param));
}

@export
let syntax_function_is_generic = std::func(function: i32) -> i32 {
    return syntax_params_have_compiletime(
        syntax_function_first_param(function));
}

@export
let syntax_runtime_param_index = std::func(
    param: i32, name: addr, index: i32) -> i32 {
    if param == 0 { return 1000000; }
    if string_equal(syntax_text(syntax_param_name_node(param)), name) == 1 {
        if syntax_param_is_compiletime(param) == 1 { return 1000000; }
        return index;
    }
    if syntax_param_is_compiletime(param) == 1 {
        return syntax_runtime_param_index(
            syntax_param_next(param), name, index);
    }
    return syntax_runtime_param_index(
        syntax_param_next(param), name, index + 1);
}

@export
let syntax_runtime_param_index_node = std::func(
    param: i32, reference: i32, index: i32) -> i32 {
    if param == 0 { return 1000000; }
    if syntax_identifier_equal(
        syntax_param_name_node(param), reference) == 1 {
        if syntax_param_is_compiletime(param) == 1 { return 1000000; }
        return index;
    }
    if syntax_param_is_compiletime(param) == 1 {
        return syntax_runtime_param_index_node(
            syntax_param_next(param), reference, index);
    }
    return syntax_runtime_param_index_node(
        syntax_param_next(param), reference, index + 1);
}

// Qualified calls remain ordinary RawAst topology: `module.member(args)` is
// an infix `.` whose right side is a postfix paren group.  The reader assigns
// no module meaning; M5 module elaboration decides whether the left binding is
// a ModuleRef and whether the member is exported.
@export
let syntax_is_member_call = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, ".") != 1 { return 0; }
    if syntax_is_identifier(ast_node_left(node)) != 1 { return 0; }
    let member: i32 = ast_node_right(node);
    if ast_node_kind(member) != 3 { return 0; }
    if syntax_is_atom_text(ast_node_op(member), "(") != 1 { return 0; }
    return syntax_is_identifier(ast_node_left(member));
}

@export

let syntax_member_base_name = std::func(node: i32) -> addr {
    return ast_node_text(ast_node_left(node));
}

@export

let syntax_member_name = std::func(node: i32) -> addr {
    return ast_node_text(ast_node_left(ast_node_right(node)));
}

@export

let syntax_member_first_arg = std::func(node: i32) -> i32 {
    return ast_node_left(ast_node_right(ast_node_right(node)));
}

// Interface paths use the same postfix-call topology as module members, but
// retain `::` so Meta can distinguish a type-owned operation from a module
// alias without teaching the reader either concept.
@export
let syntax_is_interface_call = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, "::") != 1 { return 0; }
    if syntax_is_identifier(ast_node_left(node)) != 1 { return 0; }
    let member: i32 = ast_node_right(node);
    if ast_node_kind(member) != 3 { return 0; }
    if syntax_is_atom_text(ast_node_op(member), "(") != 1 { return 0; }
    return syntax_is_identifier(ast_node_left(member));
}

@export

let syntax_interface_base_name = std::func(node: i32) -> addr {
    return ast_node_text(ast_node_left(node));
}

@export

let syntax_interface_member_name = std::func(node: i32) -> addr {
    return ast_node_text(ast_node_left(ast_node_right(node)));
}

@export

let syntax_interface_first_arg = std::func(node: i32) -> i32 {
    return ast_node_left(ast_node_right(ast_node_right(node)));
}

@export

let syntax_is_interface_dyn_type = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, "::") != 1 { return 0; }
    if syntax_is_identifier(ast_node_left(node)) != 1 { return 0; }
    return syntax_is_atom_text(ast_node_right(node), "Dyn");
}

// if view for: if <cond> { <then> } else { <else> }
@export
let syntax_is_if = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    let with_else: i32 = ast_node_left(node);
    let else_body: i32 = ast_node_right(node);
    if ast_node_kind(else_body) != 4 { return 0; }
    if syntax_is_juxt(with_else) != 1 { return 0; }
    if syntax_is_atom_text(ast_node_right(with_else), "else") != 1 { return 0; }
    let with_then: i32 = ast_node_left(with_else);
    if syntax_is_juxt(with_then) != 1 { return 0; }
    if ast_node_kind(ast_node_right(with_then)) != 4 { return 0; }
    let with_cond: i32 = ast_node_left(with_then);
    if syntax_is_juxt(with_cond) != 1 { return 0; }
    return syntax_is_atom_text(ast_node_left(with_cond), "if");
}

@export

let syntax_is_if_statement = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if ast_node_kind(ast_node_right(node)) != 4 { return 0; }
    let with_condition: i32 = ast_node_left(node);
    if syntax_is_juxt(with_condition) != 1 { return 0; }
    return syntax_is_atom_text(ast_node_left(with_condition), "if");
}
@export
let syntax_if_statement_condition = std::func(node: i32) -> i32 {
    return ast_node_right(ast_node_left(node));
}
@export
let syntax_if_statement_body = std::func(node: i32) -> i32 { return ast_node_right(node); }

@export

let syntax_is_match = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if syntax_kind(syntax_right(node)) != 4 { return 0; }
    let with_target: i32 = syntax_left(node);
    if syntax_is_juxt(with_target) != 1 { return 0; }
    let prefix: i32 = syntax_left(with_target);
    if syntax_is_atom_text(prefix, "match") == 1 { return 1; }
    if syntax_is_juxt(prefix) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(prefix), "return") == 1 {
        return syntax_is_atom_text(syntax_right(prefix), "match");
    }
    if syntax_is_atom_text(syntax_left(prefix), "let") != 1 { return 0; }
    let binding: i32 = syntax_right(prefix);
    if syntax_is_infix(binding, "=") != 1 { return 0; }
    return syntax_is_atom_text(syntax_right(binding), "match");
}

@export
let syntax_match_has_return_prefix = std::func(node: i32) -> i32 {
    if syntax_is_match(node) != 1 { return 0; }
    let prefix: i32 = syntax_left(syntax_left(node));
    if syntax_is_juxt(prefix) != 1 { return 0; }
    return syntax_is_atom_text(syntax_left(prefix), "return");
}

@export
let syntax_match_has_binding_prefix = std::func(node: i32) -> i32 {
    if syntax_is_match(node) != 1 { return 0; }
    let prefix: i32 = syntax_left(syntax_left(node));
    if syntax_is_juxt(prefix) != 1 { return 0; }
    return syntax_is_atom_text(syntax_left(prefix), "let");
}

@export
let syntax_match_target = std::func(node: i32) -> i32 {
    return syntax_right(syntax_left(node));
}

@export
let syntax_match_first_arm = std::func(node: i32) -> i32 {
    return syntax_left(syntax_right(node));
}

@export
let syntax_match_arm_is_valid_shape = std::func(arm: i32) -> i32 {
    return syntax_is_infix(arm, "=>");
}

@export
let syntax_match_arm_pattern = std::func(arm: i32) -> i32 {
    return syntax_left(arm);
}

@export
let syntax_match_arm_value = std::func(arm: i32) -> i32 {
    return syntax_right(arm);
}

@export
let syntax_match_pattern_is_wildcard = std::func(pattern: i32) -> i32 {
    return syntax_is_atom_text(pattern, "_");
}

@export
let syntax_enum_reference_is_payload = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, ".") != 1 { return 0; }
    let member: i32 = syntax_right(node);
    if syntax_kind(member) != 3 { return 0; }
    if syntax_is_atom_text(syntax_op(member), "(") != 1 { return 0; }
    return syntax_is_identifier(syntax_left(member));
}

@export
let syntax_is_enum_reference = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, ".") != 1 { return 0; }
    let enum_type: i32 = syntax_left(node);
    if syntax_is_call(enum_type) != 1 { return 0; }
    if syntax_call_namespace(enum_type) != 0 { return 0; }
    if syntax_is_identifier(syntax_call_callee(enum_type)) != 1 {
        return 0;
    }
    if syntax_arg_count(syntax_call_first_arg(enum_type)) != 1 {
        return 0;
    }
    let member: i32 = syntax_right(node);
    if syntax_is_identifier(member) == 1 { return 1; }
    return syntax_enum_reference_is_payload(node);
}

@export
let syntax_enum_reference_type = std::func(node: i32) -> i32 {
    return syntax_left(node);
}

@export
let syntax_enum_reference_name_node = std::func(node: i32) -> i32 {
    let member: i32 = syntax_right(node);
    if syntax_is_identifier(member) == 1 { return member; }
    return syntax_left(member);
}

@export
let syntax_enum_reference_payload = std::func(node: i32) -> i32 {
    if syntax_enum_reference_is_payload(node) != 1 { return 0; }
    return syntax_left(syntax_right(syntax_right(node)));
}

@export

let syntax_is_return = std::func(node: i32) -> i32 {
    if syntax_is_match(node) == 1 {
        return syntax_match_has_return_prefix(node);
    }
    if syntax_is_juxt(node) != 1 { return 0; }
    let head: i32 = ast_node_left(node);
    if syntax_is_atom_text(head, "return") == 1 { return 1; }
    // `return Type { ... }` is a nested juxtaposition whose outer right side
    // is the brace group.  It is still one return form, not an expression
    // statement followed by a group.
    if syntax_is_juxt(head) == 1 {
        return syntax_is_atom_text(ast_node_left(head), "return");
    }
    return 0;
}
@export
let syntax_return_expr = std::func(node: i32) -> i32 {
    if syntax_is_match(node) == 1 { return node; }
    let head: i32 = ast_node_left(node);
    if syntax_is_atom_text(head, "return") == 1 {
        return ast_node_right(node);
    }
    // Keep the complete outer topology so the aggregate type name and brace
    // fields remain available to Meta lowering.
    return node;
}

@export

let syntax_is_aggregate_literal = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if syntax_kind(ast_node_right(node)) != 4 { return 0; }
    let head: i32 = ast_node_left(node);
    if syntax_is_identifier(head) == 1 { return 1; }
    if syntax_is_juxt(head) == 1 {
        if syntax_is_atom_text(ast_node_left(head), "return") == 1 {
            return syntax_is_identifier(ast_node_right(head));
        }
        if syntax_is_atom_text(ast_node_left(head), "let") == 1 {
            let assignment: i32 = ast_node_right(head);
            if syntax_is_infix(assignment, "=") == 1 {
                return syntax_is_identifier(ast_node_right(assignment));
            }
        }
    }
    return 0;
}

@export

let syntax_aggregate_type_node = std::func(node: i32) -> i32 {
    let head: i32 = ast_node_left(node);
    if syntax_is_identifier(head) == 1 { return head; }
    if syntax_is_atom_text(ast_node_left(head), "let") == 1 {
        return ast_node_right(ast_node_right(head));
    }
    return ast_node_right(head);
}

@export

let syntax_aggregate_first_field = std::func(node: i32) -> i32 {
    return ast_node_left(ast_node_right(node));
}

@export

let syntax_aggregate_field_name_node = std::func(field: i32) -> i32 {
    return ast_node_left(field);
}

@export

let syntax_aggregate_field_value = std::func(field: i32) -> i32 {
    return ast_node_right(field);
}

@export

let syntax_is_struct_declaration = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if syntax_kind(ast_node_right(node)) != 4 { return 0; }
    let head: i32 = ast_node_left(node);
    if syntax_is_juxt(head) != 1 { return 0; }
    if syntax_is_atom_text(ast_node_left(head), "let") != 1 { return 0; }
    let assignment: i32 = ast_node_right(head);
    if syntax_is_infix(assignment, "=") != 1 { return 0; }
    return syntax_path_tail_is(ast_node_right(assignment), "struct");
}

@export

let syntax_struct_name_node = std::func(node: i32) -> i32 {
    let assignment: i32 = ast_node_right(ast_node_left(node));
    let declared: i32 = ast_node_left(assignment);
    if syntax_is_infix(declared, ":") == 1 {
        return ast_node_left(declared);
    }
    return declared;
}

@export

let syntax_struct_first_field = std::func(node: i32) -> i32 {
    return ast_node_left(ast_node_right(node));
}

// Enum declarations are still ordinary unified bindings whose initializer is
// the Meta constructor `std::enum(...)` and whose body is a brace group.  These
// helpers expose only that RawAst topology; validation and TypeValue creation
// belong to the Lain-owned enum Meta library.
@export
let syntax_is_enum_declaration = std::func(node: i32) -> i32 {
    if syntax_is_juxt(node) != 1 { return 0; }
    if syntax_kind(ast_node_right(node)) != 4 { return 0; }
    let head: i32 = ast_node_left(node);
    if syntax_is_juxt(head) != 1 { return 0; }
    if syntax_is_atom_text(ast_node_left(head), "let") != 1 { return 0; }
    let assignment: i32 = ast_node_right(head);
    if syntax_is_infix(assignment, "=") != 1 { return 0; }
    let initializer: i32 = ast_node_right(assignment);
    if syntax_is_call(initializer) != 1 { return 0; }
    return syntax_call_callee_is(initializer, "enum");
}

@export
let syntax_enum_name_node = std::func(node: i32) -> i32 {
    let assignment: i32 = ast_node_right(ast_node_left(node));
    let declared: i32 = ast_node_left(assignment);
    if syntax_is_infix(declared, ":") == 1 {
        return ast_node_left(declared);
    }
    return declared;
}

@export
let syntax_enum_first_param = std::func(node: i32) -> i32 {
    let assignment: i32 = ast_node_right(ast_node_left(node));
    return syntax_call_first_arg(ast_node_right(assignment));
}

@export
let syntax_enum_first_variant = std::func(node: i32) -> i32 {
    return ast_node_left(ast_node_right(node));
}

@export
let syntax_enum_variant_is_payload = std::func(variant: i32) -> i32 {
    if syntax_is_call(variant) != 1 { return 0; }
    if syntax_call_namespace(variant) != 0 { return 0; }
    return syntax_is_identifier(syntax_call_callee(variant));
}

@export
let syntax_enum_variant_name_node = std::func(variant: i32) -> i32 {
    if syntax_is_identifier(variant) == 1 { return variant; }
    if syntax_enum_variant_is_payload(variant) == 1 {
        return syntax_call_callee(variant);
    }
    return 0;
}

@export
let syntax_enum_variant_payload = std::func(variant: i32) -> i32 {
    if syntax_enum_variant_is_payload(variant) != 1 { return 0; }
    return syntax_call_first_arg(variant);
}
@export
let syntax_if_condition = std::func(node: i32) -> i32 {
    return ast_node_right(ast_node_left(ast_node_left(ast_node_left(node))));
}
@export
let syntax_if_then_group = std::func(node: i32) -> i32 {
    return ast_node_right(ast_node_left(ast_node_left(node)));
}
@export
let syntax_if_else_group = std::func(node: i32) -> i32 { return ast_node_right(node); }
@export
let syntax_if_then_expr = std::func(node: i32) -> i32 {
    return ast_node_left(syntax_if_then_group(node));
}
@export
let syntax_if_else_expr = std::func(node: i32) -> i32 {
    return ast_node_left(syntax_if_else_group(node));
}

// Semantic expression tags: 1=i32, 2=name, 3=add, 4=call, 5=eq, 6=if,
// 7=string, 8=ne, 9=qualified module call, 19=macro invocation,
// 20=interface/type-owned call, 21=enum variant reference, 22=match.
@export
let syntax_expr_tag = std::func(node: i32) -> i32 {
    if syntax_is_match(node) == 1 { return 22; }
    if syntax_is_enum_reference(node) == 1 { return 21; }
    if syntax_is_i32_atom(node) == 1 { return 1; }
    if syntax_is_string_atom(node) == 1 { return 7; }
    if syntax_is_identifier(node) == 1 { return 2; }
    if syntax_is_infix(node, "+") == 1 { return 3; }
    if syntax_is_call(node) == 1 { return 4; }
    if syntax_is_infix(node, "==") == 1 { return 5; }
    if syntax_is_infix(node, "!=") == 1 { return 8; }
    if syntax_is_infix(node, "<") == 1 { return 12; }
    if syntax_is_infix(node, "<=") == 1 { return 13; }
    if syntax_is_infix(node, ">") == 1 { return 14; }
    if syntax_is_infix(node, ">=") == 1 { return 15; }
    if syntax_is_infix(node, "-") == 1 { return 16; }
    if syntax_is_infix(node, "*") == 1 { return 17; }
    if syntax_is_prefix(node, "-") == 1 { return 18; }
    if syntax_is_member_call(node) == 1 { return 9; }
    if syntax_is_if(node) == 1 { return 6; }
    if syntax_is_aggregate_literal(node) == 1 { return 10; }
    if syntax_is_macro_call(node) == 1 { return 19; }
    if syntax_is_interface_call(node) == 1 { return 20; }
    if syntax_is_infix(node, ".") == 1 { return 11; }
    return 0;
}

// Body form tags: 1=separator, 2=local let, 3=expression, 4=return, 5=if stmt.
@export
let syntax_form_tag = std::func(node: i32) -> i32 {
    if syntax_is_atom_text(node, ";") == 1 { return 1; }
    if syntax_is_return(node) == 1 { return 4; }
    if syntax_is_if_statement(node) == 1 { return 5; }
    if syntax_match_has_binding_prefix(node) == 1 { return 2; }
    if syntax_is_juxt(node) == 1 {
        if syntax_is_atom_text(ast_node_left(node), "let") == 1 { return 2; }
        let head: i32 = ast_node_left(node);
        if syntax_is_juxt(head) == 1 {
            if syntax_is_atom_text(
                ast_node_left(head), "let") == 1 { return 2; }
        }
    }
    return 3;
}

@export

let syntax_local_binding = std::func(form: i32) -> i32 {
    if syntax_match_has_binding_prefix(form) == 1 {
        return syntax_right(syntax_left(syntax_left(form)));
    }
    let head: i32 = syntax_left(form);
    if syntax_is_juxt(head) == 1 {
        if syntax_is_atom_text(syntax_left(head), "let") == 1 {
            return syntax_right(head);
        }
    }
    return syntax_right(form);
}

@export

let syntax_local_name_node = std::func(form: i32) -> i32 {
    if syntax_is_infix(
        syntax_left(syntax_local_binding(form)), ":") == 1 {
        return syntax_left(
            syntax_left(syntax_local_binding(form)));
    }
    return syntax_left(syntax_local_binding(form));
}

@export

let syntax_local_type_node = std::func(form: i32) -> i32 {
    if syntax_is_infix(
        syntax_left(syntax_local_binding(form)), ":") == 1 {
        return syntax_right(
            syntax_left(syntax_local_binding(form)));
    }
    return 0;
}

@export

let syntax_local_value_node = std::func(form: i32) -> i32 {
    if syntax_is_aggregate_literal(form) == 1 { return form; }
    if syntax_match_has_binding_prefix(form) == 1 { return form; }
    return syntax_right(syntax_local_binding(form));
}

let syntax_validate_params = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    if syntax_is_infix(param, ":") != 1 { return 1110; }
    if syntax_is_identifier(ast_node_left(param)) != 1 { return 1111; }
    if syntax_is_atom_text(ast_node_right(param), "i32") != 1 {
        if syntax_is_atom_text(ast_node_right(param), "addr") != 1 {
            if syntax_is_identifier(ast_node_right(param)) != 1 {
                if syntax_is_interface_dyn_type(
                    ast_node_right(param)) == 1 {
                    return syntax_validate_params_after_type(param);
                }
                if syntax_is_call(ast_node_right(param)) != 1 {
                    return 1112;
                }
            }
        }
    }
    return syntax_validate_params_after_type(param);
}

let syntax_validate_params_after_type = std::func(param: i32) -> i32 {
    let separator: i32 = ast_node_next(param);
    if separator == 0 { return 0; }
    if syntax_is_atom_text(separator, ",") != 1 { return 1113; }
    let next_param: i32 = ast_node_next(separator);
    if next_param == 0 { return 1114; }
    return syntax_validate_params(next_param);
}

@export

let syntax_validate_function = std::func(function: i32) -> i32 {
    if syntax_is_juxt(function) != 1 { return 1002; }
    let head: i32 = syntax_function_head(function);
    if syntax_is_juxt(head) != 1 { return 1003; }
    let style: i32 = syntax_function_style(function);
    if style == 0 { return 1004; }
    let signature: i32 = syntax_function_signature(function);
    if syntax_is_infix(signature, "->") != 1 { return 1101; }
    if syntax_is_atom_text(ast_node_right(signature), "i32") != 1 {
        if syntax_is_atom_text(ast_node_right(signature), "addr") != 1 {
            if syntax_is_unit_type(ast_node_right(signature)) != 1 {
                if syntax_is_identifier(ast_node_right(signature)) != 1 {
                    if syntax_is_call(ast_node_right(signature)) != 1 {
                        return 1102;
                    }
                }
            }
        }
    }
    let binding: i32 = syntax_function_binding(function);
    if style == 1 {
        if syntax_is_infix(binding, "=") != 1 { return 1103; }
    }
    if style != 1 {
        if ast_node_kind(binding) != 3 { return 1103; }
    }
    if syntax_is_identifier(syntax_function_name_node(function)) != 1 { return 1104; }
    let fn_form: i32 = syntax_function_fn_form(function);
    if syntax_is_call(fn_form) != 1 { return 1105; }
    if syntax_call_callee_is(fn_form, "func") != 1 { return 1106; }
    let params: i32 = syntax_function_params(function);
    if ast_node_kind(params) != 4 { return 1107; }
    let param_code: i32 = syntax_validate_params(ast_node_left(params));
    if param_code != 0 { return param_code; }
    let body: i32 = syntax_function_body(function);
    if body != 0 {
        if ast_node_kind(body) != 4 { return 1201; }
    }
    return 0;
}

let syntax_validate_functions = std::func(function: i32) -> i32 {
    if function == 0 { return 0; }
    let code: i32 = syntax_validate_function(function);
    if code != 0 { return code; }
    return syntax_validate_functions(ast_node_next(function));
}

@export

let syntax_validate_program = std::func(root: i32) -> i32 {
    if ast_node_kind(root) != 4 { return 1001; }
    let first: i32 = ast_node_left(root);
    if first == 0 { return 1005; }
    return syntax_validate_functions(first);
}

// Compatibility views for the first procedure.
@export
let syntax_program_top = std::func(root: i32) -> i32 { return syntax_first_function(root); }
@export
let syntax_program_head = std::func(root: i32) -> i32 { return syntax_function_head(syntax_first_function(root)); }
@export
let syntax_program_signature = std::func(root: i32) -> i32 { return syntax_function_signature(syntax_first_function(root)); }
@export
let syntax_program_binding = std::func(root: i32) -> i32 { return syntax_function_binding(syntax_first_function(root)); }
@export
let syntax_program_body = std::func(root: i32) -> i32 { return syntax_function_body(syntax_first_function(root)); }
