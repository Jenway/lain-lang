// M5 orchestration for a workspace of Meta-owned Module values.

import packages::lain::compiler::mini_syntax;
import packages::lain::compiler::mini_module;
import packages::lain::compiler::mini_elaborate;
import packages::lain::compiler::mini_lower_unit;
import packages::lain::compiler::mini_diagnostic;

pub fn mini_workspace_schema_version() -> i32 { return 5; }

fn mini_workspace_validate_modules(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let code: i32 = mini_elaborate_validate_module_indexed(
        workspace, module_workspace_module_at(workspace, index));
    if code != 0 { return code; }
    return mini_workspace_validate_modules(workspace, index + 1);
}

pub fn mini_workspace_validate_indexed(workspace: ModuleWorkspace) -> i32 {
    let module_code: i32 = module_workspace_validate(workspace);
    if module_code != 0 { return module_code; }
    return mini_workspace_validate_modules(workspace, 0);
}

fn mini_workspace_semantic_source_index_from(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    if mini_elaborate_validate_module_indexed(
        workspace, module_workspace_module_at(workspace, index)) != 0 {
        return module_workspace_source_index_at(workspace, index);
    }
    return mini_workspace_semantic_source_index_from(workspace, index + 1);
}

pub fn mini_workspace_diagnostic_source_index_indexed(
    workspace: ModuleWorkspace) -> i32 {
    if module_workspace_validate(workspace) != 0 {
        return module_workspace_validation_source_index(workspace);
    }
    return mini_workspace_semantic_source_index_from(workspace, 0);
}

pub fn mini_workspace_validate(root: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root);
    let code: i32 = mini_workspace_validate_indexed(workspace);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return code;
}

fn mini_workspace_semantic_diagnostic_module(
    workspace: ModuleWorkspace, index: i32) -> addr {
    if index == module_workspace_count(workspace) { return ""; }
    let module: i32 = module_workspace_module_at(workspace, index);
    if mini_elaborate_validate_module_indexed(workspace, module) != 0 {
        return mini_module_summary_name(module);
    }
    return mini_workspace_semantic_diagnostic_module(
        workspace, index + 1);
}

fn mini_workspace_semantic_diagnostic_function(
    workspace: ModuleWorkspace, index: i32) -> addr {
    if index == module_workspace_count(workspace) { return ""; }
    let module: i32 = module_workspace_module_at(workspace, index);
    if mini_elaborate_validate_module_indexed(workspace, module) != 0 {
        return mini_elaborate_module_diagnostic_function_indexed(
            workspace, module);
    }
    return mini_workspace_semantic_diagnostic_function(
        workspace, index + 1);
}

pub fn mini_workspace_diagnostic_module_indexed(
    workspace: ModuleWorkspace) -> addr {
    return mini_workspace_semantic_diagnostic_module(workspace, 0);
}

pub fn mini_workspace_diagnostic_function_indexed(
    workspace: ModuleWorkspace) -> addr {
    return mini_workspace_semantic_diagnostic_function(workspace, 0);
}

pub fn mini_workspace_diagnostic_module(workspace: i32) -> addr {
    if mini_module_validate_workspace(workspace) != 0 {
        return mini_module_diagnostic_module(workspace);
    }
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    let result: addr = mini_workspace_diagnostic_module_indexed(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return result;
}

pub fn mini_workspace_diagnostic_function(workspace: i32) -> addr {
    if mini_module_validate_workspace(workspace) != 0 { return ""; }
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    let result: addr = mini_workspace_diagnostic_function_indexed(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return result;
}

pub fn mini_workspace_ok(workspace: i32) -> i32 {
    if mini_workspace_validate(workspace) == 0 { return 1; }
    return 0;
}

pub fn mini_workspace_module_count(workspace: i32) -> i32 {
    return mini_module_workspace_module_count(workspace);
}

pub fn mini_workspace_dependency_count(workspace: i32) -> i32 {
    return mini_module_workspace_dependency_count(workspace);
}

pub fn mini_workspace_has_module(workspace: i32, name: addr) -> i32 {
    if mini_module_workspace_find(workspace, name) != 0 { return 1; }
    return 0;
}

pub fn mini_workspace_export_count(workspace: i32, module_name: addr) -> i32 {
    let module: i32 = mini_module_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return mini_module_summary_export_count(module);
}

pub fn mini_workspace_has_export(
    workspace: i32, module_name: addr, name: addr) -> i32 {
    let module: i32 = mini_module_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return mini_module_summary_has_export(module, name);
}

pub fn mini_workspace_export_param_count(
    workspace: i32, module_name: addr, name: addr) -> i32 {
    let module: i32 = mini_module_workspace_find(workspace, module_name);
    if module == 0 { return 0; }
    return mini_module_summary_export_param_count(module, name);
}

pub fn mini_workspace_export_return_type(
    workspace: i32, module_name: addr, name: addr) -> addr {
    let module: i32 = mini_module_workspace_find(workspace, module_name);
    if module == 0 { return ""; }
    return mini_module_summary_export_return_type(module, name);
}

pub fn mini_workspace_diagnostic_message(workspace: i32) -> addr {
    return mini_diagnostic_message(mini_workspace_validate(workspace));
}

pub fn mini_workspace_compile(workspace: i32) -> i32 {
    let index: ModuleWorkspace = module_workspace_from_root(workspace);
    if mini_workspace_validate_indexed(index) != 0 {
        let destroyed_failure: i32 = module_workspace_destroy(index);
        return 0;
    }
    let unit: i32 = mini_lower_unit_workspace_validated(index);
    let destroyed: i32 = module_workspace_destroy(index);
    return unit;
}

pub fn mini_workspace_compile_indexed(workspace: ModuleWorkspace) -> i32 {
    if mini_workspace_validate_indexed(workspace) != 0 { return 0; }
    return mini_lower_unit_workspace_validated(workspace);
}
