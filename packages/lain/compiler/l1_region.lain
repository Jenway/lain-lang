import packages::lain::compiler::l1_instruction;
import packages::lain::compiler::l1_value;

struct L1Region { instruction_count: i32, first_tag: i32, first_type: i32, first_left: i32, first_right: i32, second_tag: i32, second_type: i32, second_left: i32 }

fn l1_region_return_i32(value: i32) -> L1Region {
    return L1Region { instruction_count: 1, first_tag: l1_instruction_return_tag(value), first_type: l1_value_i32_type_tag(value), first_left: value, first_right: 0, second_tag: 0, second_type: 0, second_left: 0 };
}

fn l1_region_add_then_return_i32(left: i32, right: i32) -> L1Region {
    return L1Region { instruction_count: 2, first_tag: l1_instruction_add_tag(left, right), first_type: l1_instruction_add_type_tag(left, right), first_left: left, first_right: right, second_tag: l1_instruction_return_tag(left + right), second_type: l1_value_i32_type_tag(left + right), second_left: left + right };
}

pub fn l1_region_return_score(value: i32) -> i32 {
    let region: L1Region = l1_region_return_i32(value);
    return region.instruction_count + region.first_tag + region.first_type + region.first_left;
}

pub fn l1_region_add_score(left: i32, right: i32) -> i32 {
    let region: L1Region = l1_region_add_then_return_i32(left, right);
    return region.instruction_count + region.first_tag + region.first_type + region.first_left + region.first_right + region.second_tag + region.second_type + region.second_left;
}
