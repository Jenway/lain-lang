import packages::lain::compiler::ir_builder;

// Bootstrap Core: AstTree -> typed constant -> IR function builder.
// CHECK: #proc lower_i32_literal_function_score
// CHECK: #call ir_builder_ir_build_const_score
// CHECK: #return

struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

struct TypedConst {
    valid: i32,
    type_tag: i32,
    value: i32,
}

fn parse_i32_literal(node: AstTree, literal_tag: i32) -> TypedConst {
    if node.tag != literal_tag {
        return TypedConst { valid: 0, type_tag: 0, value: 0 };
    }
    return TypedConst { valid: 1, type_tag: 1, value: node.symbol };
}

pub fn lower_i32_literal_function_score(name: i32, node: AstTree, literal_tag: i32) -> i32 {
    let constant: TypedConst = parse_i32_literal(node, literal_tag);
    if constant.valid == 0 {
        return -1;
    }
    return ir_build_const_score(name, constant.value) + constant.type_tag;
}
