import packages::lain::compiler::module_ast_summary;
import packages::lain::compiler::module_ast_score;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

struct CompileResult {
    ok: i32,
    module_package: i32,
    module_path: i32,
    export_count: i32,
    has_ir: i32,
    ir_name: i32,
    ir_value: i32,
    has_diagnostic: i32,
    diagnostic_code: i32,
    diagnostic_message: i32,
}

fn compile_module(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> CompileResult {
    if root.tag != 2 {
        return CompileResult { ok: 0, module_package: package_symbol, module_path: path_symbol, export_count: 0, has_ir: 0, ir_name: 0, ir_value: 0, has_diagnostic: 1, diagnostic_code: 1001, diagnostic_message: main_symbol };
    }
    let exports: i32 = module_ast_summary_pub_fn_count(root, pub_symbol, fn_symbol);
    let module_value: i32 = module_ast_score_summary(package_symbol + path_symbol, root, pub_symbol, fn_symbol, type_symbol);
    return CompileResult { ok: 1, module_package: package_symbol, module_path: path_symbol, export_count: exports, has_ir: 1, ir_name: main_symbol, ir_value: module_value, has_diagnostic: 0, diagnostic_code: 0, diagnostic_message: 0 };
}

pub fn compile_result_score(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let result: CompileResult = compile_module(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
    return result.ok + result.module_package + result.module_path + result.export_count + result.has_ir + result.ir_name + result.ir_value + result.has_diagnostic + result.diagnostic_code + result.diagnostic_message;
}

pub fn compile_result_ok(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let result: CompileResult = compile_module(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
    return result.ok;
}

pub fn compile_result_diagnostic_code(package_symbol: i32, path_symbol: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let result: CompileResult = compile_module(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
    return result.diagnostic_code;
}
