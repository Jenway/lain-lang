import packages::lain::compiler::l1_type;

struct L1Value { tag: i32, type_tag: i32, payload: i32 }

fn l1_value_i32(value: i32) -> L1Value {
    return L1Value { tag: 1, type_tag: l1_type_i32_tag(), payload: value };
}

pub fn l1_value_i32_type_tag(value: i32) -> i32 {
    let result: L1Value = l1_value_i32(value);
    return result.type_tag;
}

pub fn l1_value_i32_payload(value: i32) -> i32 {
    let result: L1Value = l1_value_i32(value);
    return result.payload;
}
