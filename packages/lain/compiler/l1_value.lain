let l1_type = import("packages::lain::compiler::l1_type");
let L1Value: type = std::struct { tag: i32, type_tag: i32, payload: i32 }

let l1_value_i32 = std::func(value: i32) -> L1Value {
    return L1Value { tag: 1, type_tag: l1_type_i32_tag(), payload: value };
}

@export
let l1_value_i32_type_tag = std::func(value: i32) -> i32 {
    let result: L1Value = l1_value_i32(value);
    return result.type_tag;
}

@export
let l1_value_i32_payload = std::func(value: i32) -> i32 {
    let result: L1Value = l1_value_i32(value);
    return result.payload;
}
