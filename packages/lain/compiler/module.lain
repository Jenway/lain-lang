struct ModuleId {
    package_symbol: i32,
    path_symbol: i32,
}

struct ExportEntry {
    name: i32,
    kind: i32,
    type_symbol: i32,
    link_symbol: i32,
    has_next: i32,
    next: addr,
}

struct ModuleSummary {
    module: ModuleId,
    export_count: i32,
    first_export: addr,
    dependency_count: i32,
    first_dependency: addr,
}

fn export_kind_fn() -> i32 { 1 }
fn export_kind_type() -> i32 { 2 }
fn export_kind_module() -> i32 { 3 }

fn module_id_score(module: ModuleId) -> i32 {
    module.package_symbol + module.path_symbol
}

fn export_entry_score(entry: ExportEntry) -> i32 {
    entry.name + entry.kind + entry.type_symbol + entry.link_symbol
}

fn export_list_score(entry: ExportEntry) -> i32 {
    let self_score: i32 = export_entry_score(entry);
    let next_score: i32 = if entry.has_next == 0 {
        0
    } else {
        export_list_score(entry.next)
    };
    self_score + next_score
}

fn export_list_count(entry: ExportEntry) -> i32 {
    let next_count: i32 = if entry.has_next == 0 {
        0
    } else {
        export_list_count(entry.next)
    };
    1 + next_count
}

fn module_summary_score(summary: ModuleSummary) -> i32 {
    let export_score: i32 = if summary.export_count == 0 {
        0
    } else {
        export_list_score(summary.first_export)
    };
    module_id_score(summary.module)
        + summary.export_count
        + export_score
        + summary.dependency_count
}

pub fn module_make_id_score(package_symbol: i32, path_symbol: i32) -> i32 {
    let module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_symbol,
    };
    return module_id_score(module);
}

pub fn module_export_fn_score(name: i32, type_symbol: i32, link_symbol: i32) -> i32 {
    let entry: ExportEntry = ExportEntry {
        name: name,
        kind: export_kind_fn(),
        type_symbol: type_symbol,
        link_symbol: link_symbol,
        has_next: 0,
        next: 0,
    };
    return export_entry_score(entry);
}

pub fn module_summary_single_export_score(package_symbol: i32, path_symbol: i32, name: i32, type_symbol: i32, link_symbol: i32) -> i32 {
    let module: ModuleId = ModuleId {
        package_symbol: package_symbol,
        path_symbol: path_symbol,
    };
    let entry: ExportEntry = ExportEntry {
        name: name,
        kind: export_kind_fn(),
        type_symbol: type_symbol,
        link_symbol: link_symbol,
        has_next: 0,
        next: 0,
    };
    let summary: ModuleSummary = ModuleSummary {
        module: module,
        export_count: export_list_count(entry),
        first_export: entry,
        dependency_count: 0,
        first_dependency: 0,
    };
    return module_summary_score(summary);
}
