// Stable diagnostics for the first Lain-owned Meta domain.

pub fn mini_diagnostic_message(code: i32) -> addr {
    if code == 0 { return "ok"; }
    if code == 1001 { return "expected source root group"; }
    if code == 1002 { return "expected procedure binding and body"; }
    if code == 1003 { return "expected let procedure declaration"; }
    if code == 1004 { return "expected top-level let"; }
    if code == 1101 { return "expected procedure return arrow"; }
    if code == 1102 { return "mini-meta supports only i32 and addr returns"; }
    if code == 1103 { return "expected procedure name binding"; }
    if code == 1104 { return "expected procedure identifier"; }
    if code == 1105 { return "expected empty procedure parameter group"; }
    if code == 1106 { return "expected fn form"; }
    if code == 1107 { return "expected parameter group"; }
    if code == 1108 { return "unsupported parameter form"; }
    if code == 1110 { return "expected typed parameter"; }
    if code == 1111 { return "expected parameter identifier"; }
    if code == 1112 { return "M4 supports only i32 and addr parameters"; }
    if code == 1113 { return "expected comma between parameters"; }
    if code == 1114 { return "trailing parameter comma is not supported"; }
    if code == 1201 { return "expected procedure body group"; }
    if code == 2001 { return "unsupported i32 expression"; }
    if code == 2002 { return "unsupported i32 operator"; }
    if code == 2003 { return "unknown name or invalid i32 literal"; }
    if code == 2101 { return "malformed local let binding"; }
    if code == 2102 { return "duplicate local binding"; }
    if code == 2103 { return "procedure body has no result expression"; }
    if code == 2104 { return "result expression must be the final form"; }
    if code == 2110 { return "duplicate parameter binding"; }
    if code == 2111 { return "duplicate procedure binding"; }
    if code == 2201 { return "add operands must be i32"; }
    if code == 2202 { return "equality operands must be i32"; }
    if code == 2203 { return "local let value must be i32"; }
    if code == 2204 { return "procedure result must be i32"; }
    if code == 2301 { return "unknown procedure"; }
    if code == 2302 { return "ambiguous procedure"; }
    if code == 2303 { return "procedure argument count mismatch"; }
    if code == 2304 { return "procedure argument must be i32"; }
    if code == 2401 { return "if condition must be bool"; }
    if code == 2402 { return "if branches must produce i32"; }
    if code == 2403 { return "if branches must contain one expression"; }
    if code == 2404 { return "if expression is supported only as final result"; }
    if code == 2405 { return "nested if expression branch is not supported in M4"; }
    if code == 2501 { return "unreachable form after explicit return"; }
    if code == 2502 { return "declared procedure requires explicit return"; }
    return "unknown mini-meta diagnostic";
}
