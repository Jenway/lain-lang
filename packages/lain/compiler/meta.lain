// User attribute Meta: resolution, signature checking, L1 execution, and
// generated-syntax re-entry.  The first public slice deliberately exposes a
// small SyntaxList intrinsic set; the physical RawAst reader remains unaware
// of Meta, attributes, and expansion.

let syntax = import("packages::lain::compiler::syntax");
let surface_forms = import("packages::lain::compiler::surface_forms");
let generated_syntax = import("packages::lain::compiler::generated_syntax");
let l1_unit_builder = import("packages::lain::compiler::l1_unit_builder");
let l1_interpreter = import("packages::lain::compiler::l1_interpreter");

@foreign(c, link_name = "meta.syntax-enter!")
let meta_host_syntax_enter = std::func(
    store: i32, unit: i32, origin: i32, hygiene: i32) -> i32;
@foreign(c, link_name = "meta.syntax-leave!")
let meta_host_syntax_leave = std::func() -> i32;

let meta_attribute_name = std::func(item: i32) -> addr {
    if syntax_is_juxt(item) != 1 { return ""; }
    if syntax_is_atom_text(syntax_left(item), "@") != 1 { return ""; }
    let attribute: i32 = syntax_right(item);
    if syntax_is_identifier(attribute) == 1 { return syntax_text(attribute); }
    if syntax_is_call(attribute) == 1 { return syntax_call_name(attribute); }
    return "";
}

let meta_binding_is_meta = std::func(item: i32) -> i32 {
    if surface_is_binding(item) != 1 { return 0; }
    let initializer: i32 = surface_binding_initializer(item);
    if syntax_is_std_call(initializer, "meta") != 1 { return 0; }
    if syntax_arg_count(syntax_call_first_arg(initializer)) != 1 { return 0; }
    return 1;
}

let meta_binding_callable = std::func(item: i32) -> i32 {
    if meta_binding_is_meta(item) != 1 { return 0; }
    return syntax_call_first_arg(surface_binding_initializer(item));
}

@export
let MetaExpansion: type = std::struct {
    root: i32,
    diagnostic: i32,
    expansion_count: i32,
    syntax_store: i32,
    diagnostic_node: i32,
}

@export
let meta_expansion_destroy = std::func(expansion: MetaExpansion) -> i32 {
    return generated_syntax_store_destroy(expansion.syntax_store);
}

let meta_callable_head = std::func(callable: i32) -> i32 {
    if syntax_is_juxt(callable) != 1 { return 0; }
    if syntax_kind(syntax_right(callable)) != 4 { return 0; }
    return syntax_left(callable);
}

let meta_callable_fn = std::func(callable: i32) -> i32 {
    let head: i32 = meta_callable_head(callable);
    if syntax_is_infix(head, "->") != 1 { return 0; }
    let fn_form: i32 = syntax_left(head);
    if syntax_is_std_call(fn_form, "func") != 1 { return 0; }
    return fn_form;
}

let meta_callable_body = std::func(callable: i32) -> i32 {
    if meta_callable_head(callable) == 0 { return 0; }
    return syntax_right(callable);
}

let meta_param_is = std::func(
    param: i32, name: addr, type_name: addr) -> i32 {
    if param == 0 { return 0; }
    if syntax_is_atom_text(syntax_param_name_node(param), name) != 1 {
        return 0;
    }
    return syntax_path_tail_is(syntax_param_type_node(param), type_name);
}

let meta_callable_signature_valid = std::func(callable: i32) -> i32 {
    let fn_form: i32 = meta_callable_fn(callable);
    if fn_form == 0 { return 0; }
    let head: i32 = meta_callable_head(callable);
    if syntax_path_tail_is(syntax_right(head), "SyntaxList") != 1 {
        return 0;
    }
    let first: i32 = syntax_call_first_arg(fn_form);
    if syntax_arg_count(first) != 2 { return 0; }
    if meta_param_is(first, "context", "MetaContext") != 1 { return 0; }
    let second: i32 = syntax_arg_next(first);
    if meta_param_is(
        second, "invocation", "MetaInvocation") != 1 { return 0; }
    if meta_callable_body(callable) == 0 { return 0; }
    return 1;
}

let meta_find_definition_from = std::func(
    item: i32, name: addr) -> i32 {
    if item == 0 { return 0; }
    if meta_binding_is_meta(item) == 1 {
        if syntax_text_equal(surface_binding_name(item), name) == 1 {
            return item;
        }
    }
    return meta_find_definition_from(surface_next_item(item), name);
}

let meta_find_definition = std::func(root: i32, name: addr) -> i32 {
    return meta_find_definition_from(surface_first_item(root), name);
}

let meta_validate_definitions = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if meta_binding_is_meta(item) == 1 {
        if meta_callable_signature_valid(meta_binding_callable(item)) != 1 {
            return 2901;
        }
    }
    return meta_validate_definitions(surface_next_item(item));
}

let meta_has_definition = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if meta_binding_is_meta(item) == 1 { return 1; }
    return meta_has_definition(surface_next_item(item));
}

let meta_is_invocation_target = std::func(node: i32) -> i32 {
    if syntax_is_infix(node, ".") != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(node), "invocation") != 1 {
        return 0;
    }
    return syntax_is_atom_text(syntax_right(node), "target_syntax");
}

let meta_declare_extern_params = std::func(
    unit: i32, procedure: i32, count: i32) -> i32 {
    if count == 0 { return 1; }
    if l1_unit_builder_param(unit, procedure, 1) != 1 { return 0; }
    return meta_declare_extern_params(unit, procedure, count + -1);
}

let meta_declare_extern = std::func(
    unit: i32, name: addr, count: i32) -> i32 {
    let procedure: i32 = l1_unit_builder_extern(unit, name, 1);
    if procedure == 0 { return 0; }
    return meta_declare_extern_params(unit, procedure, count);
}

let meta_declare_capabilities = std::func(unit: i32) -> i32 {
    if meta_declare_extern(unit, "meta.syntax-clone!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-left!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-right!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-op!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-next!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-atom!", 1) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-group!", 2) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-prefix!", 2) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-postfix!", 2) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-infix!", 3) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-append!", 2) != 1 { return 0; }
    if meta_declare_extern(unit, "meta.syntax-list-empty!", 0) != 1 {
        return 0;
    }
    if meta_declare_extern(unit, "meta.syntax-list-one!", 1) != 1 { return 0; }
    return meta_declare_extern(unit, "meta.syntax-list-two!", 2);
}

let meta_l1_call0 = std::func(unit: i32, name: addr) -> i32 {
    return l1_unit_builder_call(unit, name, 1);
}

let meta_l1_call1 = std::func(
    unit: i32, name: addr, argument0: i32) -> i32 {
    let call: i32 = l1_unit_builder_call(unit, name, 1);
    if call == 0 { return 0; }
    if l1_unit_builder_call_arg(unit, call, argument0) != 1 { return 0; }
    return call;
}

let meta_l1_call2 = std::func(
    unit: i32, name: addr, argument0: i32, argument1: i32) -> i32 {
    let call: i32 = meta_l1_call1(unit, name, argument0);
    if call == 0 { return 0; }
    if l1_unit_builder_call_arg(unit, call, argument1) != 1 { return 0; }
    return call;
}

let meta_l1_call3 = std::func(
    unit: i32, name: addr, argument0: i32,
    argument1: i32, argument2: i32) -> i32 {
    let call: i32 = meta_l1_call2(unit, name, argument0, argument1);
    if call == 0 { return 0; }
    if l1_unit_builder_call_arg(unit, call, argument2) != 1 { return 0; }
    return call;
}

let meta_intrinsic_call_is_allowed = std::func(node: i32) -> i32 {
    if syntax_call_namespace(node) != 0 { return 0; }
    if syntax_call_callee_is(node, "syntax_list_empty") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_clone") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_left") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_right") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_op") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_next") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_atom") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_list_one") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_group") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_prefix") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_postfix") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_append") == 1 { return 1; }
    if syntax_call_callee_is(node, "syntax_list_two") == 1 { return 1; }
    return syntax_call_callee_is(node, "syntax_infix");
}

let meta_expression_capabilities_valid = std::func(node: i32) -> i32 {
    if node == 0 { return 1; }
    if syntax_is_call(node) == 1 {
        if meta_intrinsic_call_is_allowed(node) != 1 { return 0; }
    }
    if meta_expression_capabilities_valid(syntax_left(node)) != 1 {
        return 0;
    }
    if meta_expression_capabilities_valid(syntax_right(node)) != 1 {
        return 0;
    }
    if meta_expression_capabilities_valid(syntax_op(node)) != 1 {
        return 0;
    }
    return meta_expression_capabilities_valid(syntax_next(node));
}

let meta_lower_expression = std::func(unit: i32, node: i32) -> i32 {
    if meta_is_invocation_target(node) == 1 {
        return l1_unit_builder_arg(unit, 1, 1);
    }
    if syntax_is_i32_atom(node) == 1 {
        return l1_unit_builder_i32(unit, syntax_i32_value(node));
    }
    if syntax_is_call(node) != 1 { return 0; }
    if syntax_call_namespace(node) != 0 { return 0; }
    let first: i32 = syntax_call_first_arg(node);
    if syntax_call_callee_is(node, "syntax_list_empty") == 1 {
        if syntax_arg_count(first) != 0 { return 0; }
        return meta_l1_call0(unit, "meta.syntax-list-empty!");
    }
    if syntax_call_callee_is(node, "syntax_clone") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-clone!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_left") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-left!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_right") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-right!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_op") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-op!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_next") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-next!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_atom") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-atom!",
            l1_unit_builder_i32(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_list_one") == 1 {
        if syntax_arg_count(first) != 1 { return 0; }
        return meta_l1_call1(
            unit, "meta.syntax-list-one!",
            meta_lower_expression(unit, first));
    }
    if syntax_call_callee_is(node, "syntax_group") == 1 {
        if syntax_arg_count(first) != 2 { return 0; }
        return meta_l1_call2(
            unit, "meta.syntax-group!",
            l1_unit_builder_i32(unit, first),
            meta_lower_expression(unit, syntax_arg_next(first)));
    }
    if syntax_call_callee_is(node, "syntax_prefix") == 1 {
        if syntax_arg_count(first) != 2 { return 0; }
        return meta_l1_call2(
            unit, "meta.syntax-prefix!",
            l1_unit_builder_i32(unit, first),
            meta_lower_expression(unit, syntax_arg_next(first)));
    }
    if syntax_call_callee_is(node, "syntax_postfix") == 1 {
        if syntax_arg_count(first) != 2 { return 0; }
        return meta_l1_call2(
            unit, "meta.syntax-postfix!",
            meta_lower_expression(unit, first),
            meta_lower_expression(unit, syntax_arg_next(first)));
    }
    if syntax_call_callee_is(node, "syntax_append") == 1 {
        if syntax_arg_count(first) != 2 { return 0; }
        return meta_l1_call2(
            unit, "meta.syntax-append!",
            meta_lower_expression(unit, first),
            meta_lower_expression(unit, syntax_arg_next(first)));
    }
    if syntax_call_callee_is(node, "syntax_list_two") == 1 {
        if syntax_arg_count(first) != 2 { return 0; }
        return meta_l1_call2(
            unit, "meta.syntax-list-two!",
            meta_lower_expression(unit, first),
            meta_lower_expression(unit, syntax_arg_next(first)));
    }
    if syntax_call_callee_is(node, "syntax_infix") == 1 {
        if syntax_arg_count(first) != 3 { return 0; }
        let second: i32 = syntax_arg_next(first);
        return meta_l1_call3(
            unit, "meta.syntax-infix!",
            l1_unit_builder_i32(unit, first),
            meta_lower_expression(unit, second),
            meta_lower_expression(unit, syntax_arg_next(second)));
    }
    return 0;
}

let meta_execute = std::func(
    definition: i32, builder: GeneratedSyntaxStore,
    context_handle: i32, target_handle: i32) -> i32 {
    let body: i32 = meta_callable_body(meta_binding_callable(definition));
    let statement: i32 = syntax_left(body);
    if syntax_is_return(statement) != 1 { return -2; }
    if meta_expression_capabilities_valid(
        syntax_return_expr(statement)) != 1 { return -3; }
    let unit: i32 = l1_unit_builder_new();
    if unit == 0 { return -2; }
    if meta_declare_capabilities(unit) != 1 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    let name: addr = surface_binding_name(definition);
    let procedure: i32 = l1_unit_builder_proc(unit, name, 1);
    if procedure == 0 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    if l1_unit_builder_param(unit, procedure, 1) != 1 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    if l1_unit_builder_param(unit, procedure, 1) != 1 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    let result_value: i32 = meta_lower_expression(
        unit, syntax_return_expr(statement));
    if result_value == 0 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    if l1_unit_builder_return(unit, procedure, result_value) != 1 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -2;
    }
    let call_site: i32 = syntax_call_site(target_handle);
    if meta_host_syntax_enter(
        builder.store, builder.unit, call_site, context_handle) != 1 {
        let destroyed: i32 = l1_unit_builder_destroy(unit);
        return -4;
    }
    let result: i32 = l1_interpreter_run2(
        unit, name, context_handle, target_handle);
    let left: i32 = meta_host_syntax_leave();
    let status: i32 = l1_interpreter_result_status(result);
    let value: i32 = l1_interpreter_result_value(result);
    let destroyed_result: i32 = l1_interpreter_result_destroy(result);
    let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
    if status == 7002 { return -3; }
    if status == 7009 { return -4; }
    if status != 0 { return -2; }
    if generated_syntax_local_kind(builder, value) != 4 { return -2; }
    return value;
}

let meta_append_clone = std::func(
    builder: GeneratedSyntaxStore, previous: i32,
    source: i32) -> i32 {
    let cloned: i32 = generated_syntax_clone(builder, source);
    if cloned == 0 { return -1; }
    if previous != 0 {
        if generated_syntax_append(builder, previous, cloned) != 1 {
            return -1;
        }
    }
    return cloned;
}

let MetaExpandState: type = std::struct {
    source_root: i32,
    builder: GeneratedSyntaxStore,
    root: i32,
    previous: i32,
    count: i32,
    expansion_id: i32,
    error: i32,
    error_node: i32,
}

let meta_state_error_at = std::func(
    state: MetaExpandState, code: i32, node: i32) -> MetaExpandState {
    return MetaExpandState {
        source_root: state.source_root, builder: state.builder,
        root: state.root, previous: state.previous,
        count: state.count, expansion_id: state.expansion_id,
        error: code, error_node: node,
    };
}

let meta_state_error = std::func(
    state: MetaExpandState, code: i32) -> MetaExpandState {
    return meta_state_error_at(state, code, state.source_root);
}

let meta_increment = std::func(value: i32) -> i32 {
    return value + 1;
}

let meta_decrement = std::func(value: i32) -> i32 {
    return value + -1;
}

let meta_builtin_attribute = std::func(name: addr) -> i32 {
    if syntax_text_equal(name, "export") == 1 { return 1; }
    if syntax_text_equal(name, "foreign") == 1 { return 1; }
    if syntax_text_equal(name, "interface") == 1 { return 1; }
    if syntax_text_equal(name, "interface_impl") == 1 { return 1; }
    return 0;
}

let meta_state_append = std::func(
    state: MetaExpandState, source: i32) -> MetaExpandState {
    let cloned: i32 = meta_append_clone(
        state.builder, state.previous, source);
    if cloned == -1 { return meta_state_error(state, 2905); }
    if state.previous == 0 {
        if generated_syntax_set_first(
            state.builder, state.root, cloned) != 1 {
            return meta_state_error(state, 2905);
        }
    }
    return MetaExpandState {
        source_root: state.source_root, builder: state.builder,
        root: state.root, previous: cloned,
        count: meta_increment(state.count),
        expansion_id: state.expansion_id, error: 0, error_node: 0,
    };
}

let meta_state_adopt_nodes = std::func(
    state: MetaExpandState, node: i32) -> MetaExpandState {
    if node == 0 { return state; }
    if generated_syntax_local_kind(state.builder, node) == -1 {
        return meta_state_error(state, 2905);
    }
    let next: i32 = generated_syntax_local_next(state.builder, node);
    if state.previous == 0 {
        if generated_syntax_set_first(
            state.builder, state.root, node) != 1 {
            return meta_state_error(state, 2905);
        }
    }
    if state.previous != 0 {
        if generated_syntax_append(
            state.builder, state.previous, node) != 1 {
            return meta_state_error(state, 2905);
        }
    }
    return meta_state_adopt_nodes(
        MetaExpandState {
            source_root: state.source_root, builder: state.builder,
            root: state.root, previous: node,
            count: meta_increment(state.count),
            expansion_id: state.expansion_id, error: 0, error_node: 0,
        },
        next);
}

let meta_expand_items = std::func(
    item: i32, state: MetaExpandState) -> MetaExpandState {
    if item == 0 { return state; }
    if state.error != 0 { return state; }
    if meta_binding_is_meta(item) == 1 {
        return meta_expand_items(
            surface_next_item(item), state);
    }
    if surface_item_tag(item) == 1 {
        if state.expansion_id > 64 {
            return meta_state_error_at(state, 2904, item);
        }
        let name: addr = meta_attribute_name(item);
        let definition: i32 = meta_find_definition(
            state.source_root, name);
        if definition != 0 {
            let target: i32 = surface_next_item(item);
            if target == 0 { return meta_state_error_at(state, 2903, item); }
            let result: i32 = meta_execute(
                definition, state.builder, state.expansion_id, target);
            if result == -3 {
                return meta_state_error_at(state, 2906, target);
            }
            if result == -4 {
                return meta_state_error_at(state, 2905, target);
            }
            if result == -2 {
                return meta_state_error_at(state, 2903, target);
            }
            let adopted: MetaExpandState = meta_state_adopt_nodes(
                state,
                generated_syntax_local_left(state.builder, result));
            if adopted.error != 0 { return adopted; }
            return meta_expand_items(
                surface_next_item(target),
                MetaExpandState {
                    source_root: adopted.source_root,
                    builder: adopted.builder, root: adopted.root,
                    previous: adopted.previous, count: adopted.count,
                        expansion_id: meta_increment(
                            adopted.expansion_id),
                        error: 0, error_node: 0,
                });
        }
        if syntax_text_equal(name, "") != 1 {
            if meta_builtin_attribute(name) != 1 {
                return meta_state_error_at(state, 2902, item);
            }
        }
    }
    return meta_expand_items(
        surface_next_item(item), meta_state_append(state, item));
}

let meta_builder_for_pass = std::func(
    current_root: i32, current_store: i32,
    expansion_id: i32) -> GeneratedSyntaxStore {
    if current_store == 0 {
        return generated_syntax_new(
            expansion_id, syntax_call_site(current_root), expansion_id);
    }
    return generated_syntax_continue(
        current_store, expansion_id,
        syntax_call_site(current_root), expansion_id);
}

let meta_expand_fixed = std::func(
    current_root: i32, definition_root: i32,
    current_store: i32, expansion_id: i32) -> MetaExpansion {
    let builder: GeneratedSyntaxStore = meta_builder_for_pass(
        current_root, current_store, expansion_id);
    if builder.ok != 1 {
        return MetaExpansion {
            root: definition_root, diagnostic: 2905,
            expansion_count: meta_decrement(expansion_id),
            syntax_store: builder.store,
            diagnostic_node: syntax_call_site(current_root),
        };
    }
    let generated_root: i32 = generated_syntax_node(
        builder, 4, 0, 0, 0);
    if generated_root == 0 {
        return MetaExpansion {
            root: definition_root, diagnostic: 2905,
            expansion_count: meta_decrement(expansion_id),
            syntax_store: builder.store,
            diagnostic_node: syntax_call_site(current_root),
        };
    }
    let state: MetaExpandState = meta_expand_items(
        surface_first_item(current_root),
        MetaExpandState {
            source_root: definition_root, builder: builder,
            root: generated_root, previous: 0, count: 0,
            expansion_id: expansion_id, error: 0,
            error_node: 0,
        });
    if state.error != 0 {
        let diagnostic_node: i32 = syntax_call_site(state.error_node);
        let sealed_error: SyntaxList = generated_syntax_seal(
            builder, generated_root, state.count);
        return MetaExpansion {
            root: sealed_error.root, diagnostic: state.error,
            expansion_count: meta_decrement(state.expansion_id),
            syntax_store: sealed_error.store,
            diagnostic_node: diagnostic_node,
        };
    }
    let list: SyntaxList = generated_syntax_seal(
        builder, generated_root, state.count);
    if list.ok != 1 {
        return MetaExpansion {
            root: definition_root, diagnostic: 2905,
            expansion_count: meta_decrement(state.expansion_id),
            syntax_store: builder.store,
            diagnostic_node: syntax_call_site(current_root),
        };
    }
    if state.expansion_id == expansion_id {
        return MetaExpansion {
            root: list.root, diagnostic: 0,
            expansion_count: meta_decrement(state.expansion_id),
            syntax_store: list.store, diagnostic_node: 0,
        };
    }
    return meta_expand_fixed(
        list.root, definition_root, list.store, state.expansion_id);
}

@export
let meta_expand = std::func(root: i32) -> MetaExpansion {
    if meta_has_definition(surface_first_item(root)) != 1 {
        return MetaExpansion {
            root: root, diagnostic: 0, expansion_count: 0,
            syntax_store: 0, diagnostic_node: 0,
        };
    }
    let validation: i32 = meta_validate_definitions(
        surface_first_item(root));
    if validation != 0 {
        return MetaExpansion {
            root: root, diagnostic: validation, expansion_count: 0,
            syntax_store: 0, diagnostic_node: root,
        };
    }
    return meta_expand_fixed(root, root, 0, 1);
}
