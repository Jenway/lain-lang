// M12 explicit Lain-owned frontend pipeline.
//
// RawAst remains an opaque, topology-only substrate.  These records are the
// phase boundaries owned by Lain: domain parse, zero-copy Middle AST,
// elaboration, and structured L1 lowering.  No Scheme pass participates in
// this normal compiler entry.

let mini_syntax = import("packages::lain::compiler::mini_syntax");
let mini_middle = import("packages::lain::compiler::mini_middle");
let mini_module = import("packages::lain::compiler::mini_module");
let mini_elaborate = import("packages::lain::compiler::mini_elaborate");
let mini_lower_unit = import("packages::lain::compiler::mini_lower_unit");
let l1_unit_builder = import("packages::lain::compiler::l1_unit_builder");
let mini_diagnostic = import("packages::lain::compiler::mini_diagnostic");
let compiler_context = import("packages::lain::compiler::compiler_context");

@export
let ParsedProgram = std::struct {
    root: i32,
    item_count: i32,
    diagnostic: i32,
}

@export
let MiddleProgram = std::struct {
    root: i32,
    first_definition: i32,
    definition_count: i32,
    diagnostic: i32,
}

@export
let ElaboratedProgram = std::struct {
    root: i32,
    procedure_count: i32,
    diagnostic: i32,
}

@export
let LoweredProgram = std::struct {
    unit: i32,
    diagnostic: i32,
}

let m12_count_items = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    let item1: i32 = mini_middle_next_item(item);
    if item1 == 0 { return 1; }
    let item2: i32 = mini_middle_next_item(item1);
    if item2 == 0 { return 2; }
    let item3: i32 = mini_middle_next_item(item2);
    if item3 == 0 { return 3; }
    let item4: i32 = mini_middle_next_item(item3);
    if item4 == 0 { return 4; }
    let item5: i32 = mini_middle_next_item(item4);
    if item5 == 0 { return 5; }
    let item6: i32 = mini_middle_next_item(item5);
    if item6 == 0 { return 6; }
    let item7: i32 = mini_middle_next_item(item6);
    if item7 == 0 { return 7; }
    return 8 + m12_count_items(mini_middle_next_item(item7));
}

let m12_validate_binding = std::func(item: i32) -> i32 {
    if mini_syntax_is_identifier(
        mini_middle_binding_name_node(item)) != 1 { return 12002; }
    let body: i32 = mini_middle_binding_body(item);
    let body_constructor: i32 =
        mini_middle_binding_is_func(item)
        + mini_middle_binding_is_struct(item)
        + mini_middle_is_module_binding(item);
    if body != 0 {
        if body_constructor == 0 { return 12003; }
        return 0;
    }
    if mini_middle_binding_constructor_is(item, "struct") == 1 { return 12004; }
    if mini_middle_binding_constructor_is(item, "module") == 1 { return 12004; }
    return 0;
}

let m12_validate_attribute_target = std::func(item: i32) -> i32 {
    let target: i32 = mini_middle_next_item(item);
    if target == 0 { return 12005; }
    let tag: i32 = mini_middle_item_tag(target);
    if tag == 1 { return m12_validate_attribute_target(target); }
    if tag != 5 { return 12005; }
    return 0;
}

let m12_validate_domain_item = std::func(item: i32) -> i32 {
    let tag: i32 = mini_middle_item_tag(item);
    // RawAst accepts every topology.  The Meta/domain boundary accepts one
    // declaration model only: attributes plus unified let bindings.
    if tag == 0 { return 12001; }
    if tag == 1 {
        let attribute_code: i32 = m12_validate_attribute_target(item);
        if attribute_code != 0 { return attribute_code; }
    }
    if tag == 5 {
        let binding_code: i32 = m12_validate_binding(item);
        if binding_code != 0 { return binding_code; }
    }
    return 0;
}

let m12_validate_domain_items = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    let code0: i32 = m12_validate_domain_item(item);
    if code0 != 0 { return code0; }
    let item1: i32 = mini_middle_next_item(item);
    if item1 == 0 { return 0; }
    let code1: i32 = m12_validate_domain_item(item1);
    if code1 != 0 { return code1; }
    let item2: i32 = mini_middle_next_item(item1);
    if item2 == 0 { return 0; }
    let code2: i32 = m12_validate_domain_item(item2);
    if code2 != 0 { return code2; }
    let item3: i32 = mini_middle_next_item(item2);
    if item3 == 0 { return 0; }
    let code3: i32 = m12_validate_domain_item(item3);
    if code3 != 0 { return code3; }
    let item4: i32 = mini_middle_next_item(item3);
    if item4 == 0 { return 0; }
    let code4: i32 = m12_validate_domain_item(item4);
    if code4 != 0 { return code4; }
    let item5: i32 = mini_middle_next_item(item4);
    if item5 == 0 { return 0; }
    let code5: i32 = m12_validate_domain_item(item5);
    if code5 != 0 { return code5; }
    let item6: i32 = mini_middle_next_item(item5);
    if item6 == 0 { return 0; }
    let code6: i32 = m12_validate_domain_item(item6);
    if code6 != 0 { return code6; }
    let item7: i32 = mini_middle_next_item(item6);
    if item7 == 0 { return 0; }
    let code7: i32 = m12_validate_domain_item(item7);
    if code7 != 0 { return code7; }
    return m12_validate_domain_items(mini_middle_next_item(item7));
}

@export
let frontend_parse = std::func(root: i32) -> ParsedProgram {
    if mini_syntax_kind(root) != 4 {
        return ParsedProgram {
            root: root, item_count: 0, diagnostic: 1001,
        };
    }
    let first: i32 = mini_middle_first_item(root);
    if first == 0 {
        return ParsedProgram {
            root: root, item_count: 0, diagnostic: 1005,
        };
    }
    let diagnostic: i32 = m12_validate_domain_items(first);
    return ParsedProgram {
        root: root, item_count: m12_count_items(first),
        diagnostic: diagnostic,
    };
}

@export
let frontend_build_middle = std::func(parsed: ParsedProgram) -> MiddleProgram {
    if parsed.diagnostic != 0 {
        return MiddleProgram {
            root: parsed.root, first_definition: 0,
            definition_count: 0, diagnostic: parsed.diagnostic,
        };
    }
    let first: i32 = mini_middle_first_definition(parsed.root);
    let diagnostic: i32 = mini_middle_validate_program(parsed.root);
    return MiddleProgram {
        root: parsed.root, first_definition: first,
        definition_count: mini_middle_definition_count(first),
        diagnostic: diagnostic,
    };
}

@export
let frontend_elaborate = std::func(middle: MiddleProgram) -> ElaboratedProgram {
    if middle.diagnostic != 0 {
        return ElaboratedProgram {
            root: middle.root, procedure_count: middle.definition_count,
            diagnostic: middle.diagnostic,
        };
    }
    return ElaboratedProgram {
        root: middle.root,
        procedure_count: mini_module_procedure_count(middle.root),
        diagnostic: mini_elaborate_validate(middle.root),
    };
}

@export
let frontend_lower = std::func(elaborated: ElaboratedProgram) -> LoweredProgram {
    if elaborated.diagnostic != 0 {
        return LoweredProgram {
            unit: 0, diagnostic: elaborated.diagnostic,
        };
    }
    let unit: i32 = mini_lower_unit_plain_validated(elaborated.root);
    if unit == 0 {
        return LoweredProgram { unit: 0, diagnostic: 8002 };
    }
    return LoweredProgram { unit: unit, diagnostic: 0 };
}

@export
let frontend_compile = std::func(
    root: i32, source_length: i32) -> CompileResult {
    let context0: CompilerContext = compiler_context_new(root, source_length);
    let context1: CompilerContext = compiler_context_add_module(
        context0, "main", 1);
    let context2: CompilerContext = compiler_context_add_type(
        context1, "i32", 1);
    let context3: CompilerContext = compiler_context_add_type(
        context2, "bool", 2);
    let context4: CompilerContext = compiler_context_add_type(
        context3, "addr", 3);

    let parsed: ParsedProgram = frontend_parse(root);
    if parsed.diagnostic != 0 {
        let failed: CompilerContext = compiler_context_add_diagnostic(
            context4, parsed.diagnostic,
            mini_diagnostic_message(parsed.diagnostic),
            root, 0, source_length);
        return compiler_context_finish(failed);
    }

    let middle: MiddleProgram = frontend_build_middle(parsed);
    if middle.diagnostic != 0 {
        let failed: CompilerContext = compiler_context_add_diagnostic(
            context4, middle.diagnostic,
            mini_diagnostic_message(middle.diagnostic),
            root, 0, source_length);
        return compiler_context_finish(failed);
    }

    let elaborated: ElaboratedProgram = frontend_elaborate(middle);
    if elaborated.diagnostic != 0 {
        let failed: CompilerContext = compiler_context_add_diagnostic(
            context4, elaborated.diagnostic,
            mini_diagnostic_message(elaborated.diagnostic),
            root, 0, source_length);
        return compiler_context_finish(failed);
    }

    let lowered: LoweredProgram = frontend_lower(elaborated);
    if lowered.diagnostic != 0 {
        let failed: CompilerContext = compiler_context_add_diagnostic(
            context4, lowered.diagnostic,
            mini_diagnostic_message(lowered.diagnostic),
            root, 0, source_length);
        return compiler_context_finish(failed);
    }
    return compiler_context_finish(
        compiler_context_with_unit(context4, lowered.unit));
}

@export
let m12_frontend_phase_probe = std::func(source: addr, length: i32) -> i32 {
    let root: i32 = mini_syntax_parse(source, length);
    let parsed: ParsedProgram = frontend_parse(root);
    if parsed.diagnostic != 0 { return 1201; }
    let middle: MiddleProgram = frontend_build_middle(parsed);
    if middle.diagnostic != 0 { return 1202; }
    let elaborated: ElaboratedProgram = frontend_elaborate(middle);
    if elaborated.diagnostic != 0 { return 1203; }
    let lowered: LoweredProgram = frontend_lower(elaborated);
    if lowered.diagnostic != 0 { return 1204; }
    let destroyed: i32 = l1_unit_builder_destroy(lowered.unit);
    if destroyed != 1 { return 1205; }
    if parsed.item_count == 0 { return 1206; }
    if middle.definition_count == 0 { return 1207; }
    if elaborated.procedure_count == 0 { return 1208; }
    return 42;
}

@export
let m12_frontend_schema_version = std::func() -> i32 { return 12; }
