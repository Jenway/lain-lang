// Type objects for the Lain-owned Meta domain.

@export

let type_error = std::func() -> i32 { return 0; }
@export
let type_i32 = std::func() -> i32 { return 1; }
@export
let type_bool = std::func() -> i32 { return 2; }
@export
let type_addr = std::func() -> i32 { return 3; }
@export
let type_unit = std::func() -> i32 { return 4; }
@export
let type_type = std::func() -> i32 { return 5; }
@export
let type_module = std::func() -> i32 { return 6; }
@export
let type_callable = std::func() -> i32 { return 7; }

// Stable phase tags carried by resolved callables.  Surface spelling does
// not select evaluation behavior; Meta resolution assigns one of these tags.
@export
let callable_phase_meta = std::func() -> i32 { return 1; }
@export
let callable_phase_comptime = std::func() -> i32 { return 2; }
@export
let callable_phase_runtime = std::func() -> i32 { return 3; }

@export

let callable_phase_valid = std::func(phase: i32) -> i32 {
    if phase == callable_phase_meta() { return 1; }
    if phase == callable_phase_comptime() { return 1; }
    if phase == callable_phase_runtime() { return 1; }
    return 0;
}

@export

let type_same = std::func(left: i32, right: i32) -> i32 {
    if left == right { return 1; }
    return 0;
}
