// Type and compile-time value objects for the Lain-owned Meta domain.

@export
let TypeValue: type = std::struct {
    id: i32,
    kind: i32,
    argument: i32,
    owner: i32,
}

@export
let ComptimeValue: type = std::struct {
    type_id: i32,
    kind: i32,
    payload: i32,
    ok: i32,
}

// TypeKind is Meta-owned.  Only the concrete representation type reaches L1.
@export
let type_kind_builtin = std::func() -> i32 { return 1; }
@export
let type_kind_comptime = std::func() -> i32 { return 2; }
@export
let type_kind_nominal = std::func() -> i32 { return 3; }
@export
let type_kind_specialized = std::func() -> i32 { return 4; }

// Comptime(T) TypeIds are canonical and deterministic for the bootstrap
// scalar domain.  Dynamic nominal/specialized TypeIds are interned by the
// CompilerContext registry.
@export
let type_comptime_base = std::func() -> i32 { return 100; }

@export
let type_comptime = std::func(argument: i32) -> i32 {
    if argument == 1 { return type_comptime_base() + argument; }
    if argument == 2 { return type_comptime_base() + argument; }
    if argument == 5 { return type_comptime_base() + argument; }
    return 0;
}

@export
let type_is_comptime = std::func(type_id: i32) -> i32 {
    if type_id == type_comptime(1) { return 1; }
    if type_id == type_comptime(2) { return 1; }
    if type_id == type_comptime(5) { return 1; }
    return 0;
}

@export
let type_comptime_argument = std::func(type_id: i32) -> i32 {
    if type_is_comptime(type_id) != 1 { return 0; }
    return type_id + -100;
}

@export
let type_value = std::func(type_id: i32) -> TypeValue {
    if type_is_comptime(type_id) == 1 {
        return TypeValue {
            id: type_id, kind: type_kind_comptime(),
            argument: type_comptime_argument(type_id), owner: 0,
        };
    }
    if type_id >= 1 {
        if type_id <= 7 {
            return TypeValue {
                id: type_id, kind: type_kind_builtin(),
                argument: 0, owner: 0,
            };
        }
    }
    return TypeValue { id: 0, kind: 0, argument: 0, owner: 0 };
}

@export
let comptime_value_error = std::func() -> ComptimeValue {
    return ComptimeValue { type_id: 0, kind: 0, payload: 0, ok: 0 };
}

@export
let comptime_value_i32 = std::func(value: i32) -> ComptimeValue {
    return ComptimeValue { type_id: 1, kind: 1, payload: value, ok: 1 };
}

@export
let comptime_value_bool = std::func(value: i32) -> ComptimeValue {
    if value != 0 {
        return ComptimeValue { type_id: 2, kind: 2, payload: 1, ok: 1 };
    }
    return ComptimeValue { type_id: 2, kind: 2, payload: 0, ok: 1 };
}

@export
let comptime_value_type = std::func(type_id: i32) -> ComptimeValue {
    if type_id == 0 { return comptime_value_error(); }
    return ComptimeValue { type_id: 5, kind: 3, payload: type_id, ok: 1 };
}

@export
let comptime_value_same = std::func(
    left: ComptimeValue, right: ComptimeValue) -> i32 {
    if left.ok != 1 { return 0; }
    if right.ok != 1 { return 0; }
    if left.type_id != right.type_id { return 0; }
    if left.kind != right.kind { return 0; }
    if left.payload != right.payload { return 0; }
    return 1;
}

@export

let type_error = std::func() -> i32 { return 0; }
@export
let type_i32 = std::func() -> i32 { return 1; }
@export
let type_bool = std::func() -> i32 { return 2; }
@export
let type_addr = std::func() -> i32 { return 3; }
@export
let type_unit = std::func() -> i32 { return 4; }
@export
let type_type = std::func() -> i32 { return 5; }
@export
let type_module = std::func() -> i32 { return 6; }
@export
let type_callable = std::func() -> i32 { return 7; }

// Stable phase tags carried by resolved callables.  Surface spelling does
// not select evaluation behavior; Meta resolution assigns one of these tags.
@export
let callable_phase_meta = std::func() -> i32 { return 1; }
@export
let callable_phase_comptime = std::func() -> i32 { return 2; }
@export
let callable_phase_runtime = std::func() -> i32 { return 3; }

@export

let callable_phase_valid = std::func(phase: i32) -> i32 {
    if phase == callable_phase_meta() { return 1; }
    if phase == callable_phase_comptime() { return 1; }
    if phase == callable_phase_runtime() { return 1; }
    return 0;
}

@export

let type_same = std::func(left: i32, right: i32) -> i32 {
    if left == right { return 1; }
    return 0;
}
