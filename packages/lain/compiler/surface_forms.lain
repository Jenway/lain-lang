// Meta-owned binding views over topology-only RawAst forms.
//
// This is deliberately a semantic view owned by Lain.  The C RawAst reader
// still knows only topology.  The canonical declaration model is
// `let name : expected-shape = initializer`; functions, modules and imports
// are interpretations of the initializer, not distinct parser declarations.

let syntax = import("packages::lain::compiler::syntax");
@export
let surface_schema_version = std::func() -> i32 { return 5; }

// A binding with a block-producing initializer (`fn` or `module`) has the
// block juxtaposed after its head.  A simple binding (`require`, local value)
// is already its own head.
@export
let surface_binding_head = std::func(item: i32) -> i32 {
    if syntax_is_juxt(item) == 1 {
        if syntax_kind(syntax_right(item)) == 4 {
            return syntax_left(item);
        }
    }
    return item;
}

@export

let surface_binding_assignment = std::func(item: i32) -> i32 {
    let head: i32 = surface_binding_head(item);
    if syntax_is_juxt(head) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(head), "let") != 1 {
        return 0;
    }
    let tail: i32 = syntax_right(head);
    if syntax_is_infix(tail, "->") == 1 {
        if syntax_is_infix(syntax_left(tail), "=") == 1 {
            return syntax_left(tail);
        }
        return 0;
    }
    if syntax_is_infix(tail, "=") == 1 { return tail; }
    return 0;
}

@export

let surface_is_binding = std::func(item: i32) -> i32 {
    if surface_binding_assignment(item) != 0 { return 1; }
    return 0;
}

@export

let surface_binding_name_node = std::func(item: i32) -> i32 {
    let assignment: i32 = surface_binding_assignment(item);
    if assignment == 0 { return 0; }
    let declared: i32 = syntax_left(assignment);
    if syntax_is_infix(declared, ":") == 1 {
        return syntax_left(declared);
    }
    return declared;
}

@export

let surface_binding_name = std::func(item: i32) -> addr {
    return syntax_text(surface_binding_name_node(item));
}

@export

let surface_binding_expected = std::func(item: i32) -> i32 {
    let assignment: i32 = surface_binding_assignment(item);
    if assignment == 0 { return 0; }
    let declared: i32 = syntax_left(assignment);
    if syntax_is_infix(declared, ":") == 1 {
        return syntax_right(declared);
    }
    return 0;
}

@export

let surface_binding_initializer = std::func(item: i32) -> i32 {
    let assignment: i32 = surface_binding_assignment(item);
    if assignment == 0 { return 0; }
    return syntax_right(assignment);
}

@export

let surface_binding_body = std::func(item: i32) -> i32 {
    if syntax_is_juxt(item) != 1 { return 0; }
    if syntax_kind(syntax_right(item)) != 4 { return 0; }
    return syntax_right(item);
}

@export

let surface_binding_expected_is = std::func(item: i32, expected: addr) -> i32 {
    let shape: i32 = surface_binding_expected(item);
    if shape == 0 { return 0; }
    return syntax_is_atom_text(shape, expected);
}

@export

let surface_binding_initializer_is = std::func(item: i32, constructor: addr) -> i32 {
    let initializer: i32 = surface_binding_initializer(item);
    if initializer == 0 { return 0; }
    if syntax_is_call(initializer) == 1 {
        return syntax_call_callee_is(initializer, constructor);
    }
    return syntax_path_tail_is(initializer, constructor);
}

@export

let surface_binding_has_expected = std::func(item: i32) -> i32 {
    if surface_binding_expected(item) != 0 { return 1; }
    return 0;
}

// Constructor identity is resolved by Meta later.  The surface view only
// exposes a terminal path name so `std::func` and a prelude `func` have the
// same topology contract without being assumed to denote the same binding.
@export
let surface_binding_constructor_is = std::func(
    item: i32, constructor: addr) -> i32 {
    return surface_binding_initializer_is(item, constructor);
}

@export

let surface_binding_is_func = std::func(item: i32) -> i32 {
    if surface_is_binding(item) != 1 { return 0; }
    if surface_binding_constructor_is(item, "func") != 1 { return 0; }
    return 1;
}

@export

let surface_binding_is_struct = std::func(item: i32) -> i32 {
    if surface_is_binding(item) != 1 { return 0; }
    if surface_binding_constructor_is(item, "struct") != 1 { return 0; }
    if surface_binding_body(item) == 0 { return 0; }
    return 1;
}

@export

let surface_is_module_binding = std::func(item: i32) -> i32 {
    if surface_is_binding(item) != 1 { return 0; }
    if surface_binding_constructor_is(item, "module") != 1 { return 0; }
    if surface_binding_body(item) == 0 { return 0; }
    return 1;
}

@export

let surface_is_require_binding = std::func(item: i32) -> i32 {
    if surface_is_binding(item) != 1 { return 0; }
    let initializer: i32 = surface_binding_initializer(item);
    if syntax_is_call(initializer) != 1 { return 0; }
    if syntax_call_callee_is(initializer, "import") != 1 {
        return 0;
    }
    return 1;
}

@export

let surface_is_export_attribute = std::func(item: i32) -> i32 {
    if syntax_is_juxt(item) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(item), "@") != 1 { return 0; }
    return syntax_is_atom_text(syntax_right(item), "export");
}

@export

let surface_is_foreign_attribute = std::func(item: i32) -> i32 {
    if syntax_is_juxt(item) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(item), "@") != 1 {
        return 0;
    }
    let attribute: i32 = syntax_right(item);
    if syntax_is_call(attribute) != 1 { return 0; }
    return syntax_text_equal(
        syntax_call_name(attribute), "foreign");
}

@export

let surface_is_named_call_attribute = std::func(item: i32, name: addr) -> i32 {
    if syntax_is_juxt(item) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(item), "@") != 1 {
        return 0;
    }
    let attribute: i32 = syntax_right(item);
    if syntax_is_call(attribute) != 1 { return 0; }
    return syntax_text_equal(syntax_call_name(attribute), name);
}

let surface_attribute_first_arg_text = std::func(item: i32) -> addr {
    return syntax_text(
        syntax_call_first_arg(syntax_right(item)));
}

let surface_find_attribute_arg = std::func(item: i32, name: addr) -> addr {
    if item == 0 { return ""; }
    if surface_is_named_call_attribute(item, name) == 1 {
        return surface_attribute_first_arg_text(item);
    }
    return surface_find_attribute_arg(surface_next_item(item), name);
}

@export

let surface_interface_type_name = std::func(root: i32) -> addr {
    return surface_find_attribute_arg(
        surface_first_item(root), "interface");
}

@export

let surface_interface_impl_prefix = std::func(root: i32) -> addr {
    return surface_find_attribute_arg(
        surface_first_item(root), "interface_impl");
}

let surface_foreign_attribute_link = std::func(item: i32) -> addr {
    let attribute: i32 = syntax_right(item);
    let language: i32 = syntax_call_first_arg(attribute);
    let option: i32 = syntax_arg_next(language);
    if syntax_is_infix(option, "=") != 1 { return ""; }
    if syntax_is_atom_text(
        syntax_left(option), "link_name") != 1 { return ""; }
    let value: i32 = syntax_right(option);
    if syntax_is_string_atom(value) != 1 { return ""; }
    return syntax_string_value(value);
}

let surface_foreign_link_scan = std::func(
    item: i32, declaration: i32, pending: addr) -> addr {
    if item == 0 { return ""; }
    if item == declaration { return pending; }
    if surface_is_foreign_attribute(item) == 1 {
        return surface_foreign_link_scan(
            surface_next_item(item), declaration,
            surface_foreign_attribute_link(item));
    }
    return surface_foreign_link_scan(
        surface_next_item(item), declaration, "");
}

@export

let surface_foreign_link_name = std::func(
    root: i32, declaration: i32) -> addr {
    return surface_foreign_link_scan(
        surface_first_item(root), declaration, "");
}

let surface_foreign_link_precedes_scan = std::func(
    item: i32, declaration: i32, link: addr) -> i32 {
    if item == 0 { return 0; }
    if item == declaration { return 0; }
    if surface_is_foreign_attribute(item) == 1 {
        // The attribute immediately preceding `declaration` belongs to that
        // declaration and must not be mistaken for an earlier duplicate.
        if surface_next_item(item) == declaration { return 0; }
        if syntax_text_equal(
            surface_foreign_attribute_link(item), link) == 1 {
            return 1;
        }
    }
    return surface_foreign_link_precedes_scan(
        surface_next_item(item), declaration, link);
}

@export

let surface_foreign_link_precedes = std::func(
    root: i32, declaration: i32, link: addr) -> i32 {
    return surface_foreign_link_precedes_scan(
        surface_first_item(root), declaration, link);
}

@export

let surface_is_procedure_definition = std::func(item: i32) -> i32 {
    if surface_binding_is_func(item) != 1 { return 0; }
    if surface_binding_body(item) == 0 { return 0; }
    return 1;
}

// Top-level item tags.
// 1=attribute, 5=canonical let binding, 6=separator, 0=unsupported.
// There are deliberately no tags for import sugar, direct function
// declarations, or direct type declarations.
@export
let surface_item_tag = std::func(item: i32) -> i32 {
    if syntax_is_atom_text(item, ";") == 1 { return 6; }
    if syntax_is_juxt(item) != 1 { return 0; }
    if syntax_is_atom_text(syntax_left(item), "@") == 1 { return 1; }
    if surface_is_binding(item) == 1 { return 5; }
    return 0;
}

let surface_is_std_io_import = std::func(item: i32) -> i32 {
    if surface_is_require_binding(item) != 1 { return 0; }
    let initializer: i32 = surface_binding_initializer(item);
    let argument: i32 = syntax_call_first_arg(initializer);
    if syntax_is_string_atom(argument) != 1 { return 0; }
    return syntax_text_equal(
        syntax_string_value(argument), "std::io");
}

let surface_has_std_io_import_from = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if surface_is_std_io_import(item) == 1 { return 1; }
    return surface_has_std_io_import_from(surface_next_item(item));
}

@export

let surface_has_std_io_import = std::func(root: i32) -> i32 {
    return surface_has_std_io_import_from(surface_first_item(root));
}

@export

let surface_first_item = std::func(root: i32) -> i32 {
    return syntax_left(root);
}

@export

let surface_next_item = std::func(item: i32) -> i32 {
    return syntax_next(item);
}

@export

let surface_first_callable_from = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    let tag: i32 = surface_item_tag(item);
    if tag == 5 {
        if surface_binding_is_func(item) == 1 { return item; }
    }
    return surface_first_callable_from(surface_next_item(item));
}

@export

let surface_first_callable = std::func(root: i32) -> i32 {
    return surface_first_callable_from(surface_first_item(root));
}

@export

let surface_next_callable = std::func(item: i32) -> i32 {
    return surface_first_callable_from(surface_next_item(item));
}

@export

let surface_first_definition_from = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if surface_is_procedure_definition(item) == 1 { return item; }
    return surface_first_definition_from(surface_next_item(item));
}

@export

let surface_first_definition = std::func(root: i32) -> i32 {
    return surface_first_definition_from(surface_first_item(root));
}

@export

let surface_next_definition = std::func(item: i32) -> i32 {
    return surface_first_definition_from(surface_next_item(item));
}

@export

let surface_definition_count = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    return 1 + surface_definition_count(surface_next_definition(item));
}

@export

let surface_callable_name_count = std::func(item: i32, name: addr) -> i32 {
    if item == 0 { return 0; }
    if syntax_text_equal(syntax_function_name(item), name) == 1 {
        return 1 + surface_callable_name_count(
            surface_next_callable(item), name);
    }
    return surface_callable_name_count(surface_next_callable(item), name);
}

@export

let surface_find_callable = std::func(item: i32, name: addr) -> i32 {
    if item == 0 { return 0; }
    if syntax_text_equal(syntax_function_name(item), name) == 1 {
        return item;
    }
    return surface_find_callable(surface_next_callable(item), name);
}

let surface_validate_definitions = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    let code: i32 = syntax_validate_function(item);
    if code != 0 { return code; }
    return surface_validate_definitions(surface_next_definition(item));
}

@export

let surface_validate_program = std::func(root: i32) -> i32 {
    if syntax_kind(root) != 4 { return 1001; }
    let first: i32 = surface_first_definition(root);
    if first == 0 { return 1005; }
    return surface_validate_definitions(first);
}

// Lexical scope queries over a block's sibling list.  The target is a body
// form, not an arbitrary expression node.  Nested blocks inherit only the
// bindings encountered before their owning `if`; bindings after that `if`
// are never visible inside it.
let surface_tree_contains = std::func(node: i32, target: i32) -> i32 {
    if node == 0 { return 0; }
    if node == target { return 1; }
    if syntax_kind(node) == 4 {
        return surface_siblings_contain(syntax_left(node), target);
    }
    if surface_tree_contains(syntax_left(node), target) == 1 {
        return 1;
    }
    if surface_tree_contains(syntax_right(node), target) == 1 {
        return 1;
    }
    if surface_tree_contains(syntax_op(node), target) == 1 {
        return 1;
    }
    return 0;
}

let surface_siblings_contain = std::func(node: i32, target: i32) -> i32 {
    if node == 0 { return 0; }
    if surface_tree_contains(node, target) == 1 { return 1; }
    return surface_siblings_contain(syntax_next(node), target);
}

let surface_scope_scan = std::func(
    cursor: i32, target: i32, name: addr, candidate: i32) -> i32 {
    if cursor == 0 { return 0; }
    if cursor == target { return candidate; }
    if syntax_form_tag(cursor) == 5 {
        let branch: i32 = syntax_left(
            syntax_if_statement_body(cursor));
        if surface_siblings_contain(branch, target) == 1 {
            let nested: i32 = surface_scope_scan(branch, target, name, 0);
            if nested != 0 { return nested; }
            return candidate;
        }
    }
    if syntax_form_tag(cursor) == 2 {
        if syntax_text_equal(
            syntax_text(syntax_local_name_node(cursor)), name) == 1 {
            return surface_scope_scan(
                syntax_next(cursor), target, name, cursor);
        }
    }
    return surface_scope_scan(
        syntax_next(cursor), target, name, candidate);
}

@export

let surface_find_visible_local = std::func(
    function: i32, target: i32, name: addr) -> i32 {
    let body: i32 = syntax_function_body(function);
    return surface_scope_scan(
        syntax_left(body), target, name, 0);
}
