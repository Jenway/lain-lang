// Driver and result façade for the M4 Lain-owned Meta pipeline.

import packages::lain::compiler::mini_syntax;
import packages::lain::compiler::mini_compile_result;
import packages::lain::compiler::mini_diagnostic;
import packages::lain::compiler::mini_lower;

pub fn mini_meta_schema_version() -> i32 { return 4; }

pub fn mini_meta_begin(source: addr, length: i32) -> i32 {
    return mini_syntax_parse(source, length);
}

pub fn mini_meta_result_ok(root: i32) -> i32 {
    return mini_compile_result_ok(root);
}

pub fn mini_meta_result_diagnostic_code(root: i32) -> i32 {
    return mini_compile_result_diagnostic_code(root);
}

pub fn mini_meta_result_diagnostic_message(root: i32) -> addr {
    return mini_compile_result_diagnostic_message(root);
}

pub fn mini_meta_result_diagnostic_procedure(root: i32) -> addr {
    return mini_compile_result_diagnostic_procedure(root);
}

pub fn mini_meta_result_procedure_count(root: i32) -> i32 {
    return mini_compile_result_procedure_count(root);
}

pub fn mini_meta_result_has_procedure(root: i32, name: addr) -> i32 {
    return mini_compile_result_has_procedure(root, name);
}

pub fn mini_meta_result_dependency_count(root: i32) -> i32 {
    return mini_compile_result_dependency_count(root);
}

pub fn mini_meta_result_l1_unit(root: i32) -> addr {
    return mini_compile_result_l1_unit(root);
}

// Source-oriented wrappers retained for small callers.
pub fn mini_meta_validate(source: addr, length: i32) -> i32 {
    return mini_compile_result_diagnostic_code(mini_meta_begin(source, length));
}

pub fn mini_meta_diagnostic_procedure(source: addr, length: i32) -> addr {
    return mini_compile_result_diagnostic_procedure(mini_meta_begin(source, length));
}

pub fn mini_meta_compile(source: addr, length: i32) -> addr {
    let root: i32 = mini_meta_begin(source, length);
    if mini_compile_result_ok(root) != 1 { return ""; }
    return mini_compile_result_l1_unit(root);
}

pub fn mini_meta_compile_named(source: addr, length: i32, name: addr) -> addr {
    let root: i32 = mini_meta_begin(source, length);
    if mini_compile_result_ok(root) != 1 { return ""; }
    return mini_lower_named_validated(root, name);
}

pub fn mini_meta_procedure_count(source: addr, length: i32) -> i32 {
    return mini_compile_result_procedure_count(mini_meta_begin(source, length));
}

pub fn mini_meta_text_equal(left: addr, right: addr) -> i32 {
    return mini_syntax_text_equal(left, right);
}

pub fn mini_meta_diagnostic_message(code: i32) -> addr {
    return mini_diagnostic_message(code);
}
