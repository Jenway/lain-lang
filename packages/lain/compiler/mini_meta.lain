@foreign(c, link_name = "core.string-from-addr!")
fn mini_meta_copy_diagnostic_string(value: addr) -> addr;

// M10: these nominal types come from compiler_state's Meta-owned module
// interface.  No consumer-side structural ABI mirror is required.

pub fn mini_meta_schema_version() -> i32 { return 12; }

pub fn mini_meta_m11_context_probe(source: addr, length: i32) -> i32 {
    return compiler_context_runtime_probe();
}

pub fn mini_meta_m12_phase_probe(source: addr, length: i32) -> i32 {
    return m12_frontend_phase_probe(source, length);
}

// M13 stage gates deliberately repeat the preceding phases.  They are
// bootstrap observability entry points: the host can time the exact same
// stage-1 artifact at each boundary without moving compiler policy into C.
pub fn mini_meta_m13_parse_gate(source: addr, length: i32) -> i32 {
    let parsed: ParsedProgram = frontend_parse(
        mini_meta_begin(source, length));
    if parsed.diagnostic != 0 { return parsed.diagnostic; }
    return 42;
}

pub fn mini_meta_m13_middle_gate(source: addr, length: i32) -> i32 {
    let parsed: ParsedProgram = frontend_parse(
        mini_meta_begin(source, length));
    if parsed.diagnostic != 0 { return parsed.diagnostic; }
    let middle: MiddleProgram = frontend_build_middle(parsed);
    if middle.diagnostic != 0 { return middle.diagnostic; }
    return 42;
}

pub fn mini_meta_m13_elaborate_gate(source: addr, length: i32) -> i32 {
    let parsed: ParsedProgram = frontend_parse(
        mini_meta_begin(source, length));
    if parsed.diagnostic != 0 { return parsed.diagnostic; }
    let middle: MiddleProgram = frontend_build_middle(parsed);
    if middle.diagnostic != 0 { return middle.diagnostic; }
    let elaborated: ElaboratedProgram = frontend_elaborate(middle);
    if elaborated.diagnostic != 0 { return elaborated.diagnostic; }
    return 42;
}

pub fn mini_meta_m13_elaborate_failure_name(
    source: addr, length: i32) -> addr {
    return mini_elaborate_diagnostic_function(
        mini_meta_begin(source, length));
}

pub fn mini_meta_m13_elaborate_failure_line(
    source: addr, length: i32) -> i32 {
    return mini_elaborate_diagnostic_function_line(
        mini_meta_begin(source, length));
}

pub fn mini_meta_m13_elaborate_failure_statement_line(
    source: addr, length: i32) -> i32 {
    return mini_elaborate_diagnostic_statement_line(
        mini_meta_begin(source, length));
}

pub fn mini_meta_m13_elaborate_failure_statement_code(
    source: addr, length: i32) -> i32 {
    return mini_elaborate_diagnostic_statement_code(
        mini_meta_begin(source, length));
}

pub fn mini_meta_m13_lower_gate(source: addr, length: i32) -> i32 {
    let parsed: ParsedProgram = frontend_parse(
        mini_meta_begin(source, length));
    if parsed.diagnostic != 0 { return parsed.diagnostic; }
    let middle: MiddleProgram = frontend_build_middle(parsed);
    if middle.diagnostic != 0 { return middle.diagnostic; }
    let elaborated: ElaboratedProgram = frontend_elaborate(middle);
    if elaborated.diagnostic != 0 { return elaborated.diagnostic; }
    let lowered: LoweredProgram = frontend_lower(elaborated);
    if lowered.diagnostic != 0 { return lowered.diagnostic; }
    let destroyed: i32 = l1_unit_builder_destroy(lowered.unit);
    if destroyed != 1 { return 13001; }
    return 42;
}

pub fn mini_meta_m13_lower_failure_line(
    source: addr, length: i32) -> i32 {
    return mini_lower_unit_failure_line(mini_meta_begin(source, length));
}

pub fn mini_meta_m13_lower_failure_code(
    source: addr, length: i32) -> i32 {
    return mini_lower_unit_plain_failure_code(mini_meta_begin(source, length));
}

pub fn mini_meta_m13_lower_failure_message(
    source: addr, length: i32) -> addr {
    return mini_lower_unit_plain_failure_message(mini_meta_begin(source, length));
}

pub fn mini_meta_begin(source: addr, length: i32) -> i32 {
    return mini_syntax_parse(source, length);
}

pub fn mini_meta_result_ok(root: i32) -> i32 {
    if mini_elaborate_validate(root) == 0 { return 1; }
    return 0;
}

pub fn mini_meta_result_diagnostic_code(root: i32) -> i32 {
    return mini_elaborate_validate(root);
}

pub fn mini_meta_result_diagnostic_message(root: i32) -> addr {
    return mini_diagnostic_message(mini_elaborate_validate(root));
}

pub fn mini_meta_result_diagnostic_procedure(root: i32) -> addr {
    return mini_elaborate_diagnostic_function(root);
}

pub fn mini_meta_result_procedure_count(root: i32) -> i32 {
    return mini_module_procedure_count(root);
}

pub fn mini_meta_result_has_procedure(root: i32, name: addr) -> i32 {
    return mini_module_has_procedure(root, name);
}

pub fn mini_meta_result_dependency_count(root: i32) -> i32 {
    return mini_module_dependency_count(root);
}

pub fn mini_meta_result_l1_unit(root: i32) -> i32 {
    return mini_lower_unit_plain_validated(root);
}

// The normal internal compiler entry owns diagnostics, module/type tables,
// lexical scopes, and their lifetimes.  Historical milestone probes live in
// their own modules and do not participate in this path.
fn mini_meta_compile_context_root(
    root: i32, source_length: i32) -> CompileResult {
    return frontend_compile(root, source_length);
}

// Source-oriented wrappers retained for small callers.
pub fn mini_meta_validate(source: addr, length: i32) -> i32 {
    return mini_elaborate_validate(mini_meta_begin(source, length));
}

pub fn mini_meta_diagnostic_procedure(source: addr, length: i32) -> addr {
    return mini_elaborate_diagnostic_function(mini_meta_begin(source, length));
}

pub fn mini_meta_compile(source: addr, length: i32) -> i32 {
    let root: i32 = mini_meta_begin(source, length);
    let result: CompileResult = mini_meta_compile_context_root(
        root, length);
    let unit: i32 = compile_result_unit_or_zero(result);
    let destroyed: i32 = compile_result_destroy(result);
    return unit;
}

// M13 generation entry. Lain owns compilation and asks the physical L1
// arena only to serialize the unit it just built.
pub fn mini_meta_compile_text(source: addr, length: i32) -> addr {
    let unit: i32 = mini_meta_compile(source, length);
    if unit == 0 { return ""; }
    let text: addr = l1_unit_builder_debug_text(unit);
    let destroyed: i32 = l1_unit_builder_destroy(unit);
    return text;
}

pub fn mini_meta_compile_result_ok(source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let ok: i32 = compile_result_ok(result);
    if ok == 1 {
        let destroyed: i32 = l1_unit_builder_destroy(
            compile_result_unit_or_zero(result));
    }
    let destroyed_result: i32 = compile_result_destroy(result);
    return ok;
}

pub fn mini_meta_compile_result_diagnostic_count(
    source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let count: i32 = compile_result_diagnostic_count(result);
    let destroyed: i32 = compile_result_destroy(result);
    return count;
}

pub fn mini_meta_compile_result_module_count(
    source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let count: i32 = compile_result_module_count(result);
    if compile_result_ok(result) == 1 {
        let destroyed: i32 = l1_unit_builder_destroy(
            compile_result_unit_or_zero(result));
    }
    let destroyed_result: i32 = compile_result_destroy(result);
    return count;
}

pub fn mini_meta_compile_result_diagnostic_code(
    source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let code: i32 = compile_result_diagnostic_code(result, 0);
    let destroyed: i32 = compile_result_destroy(result);
    return code;
}

pub fn mini_meta_compile_result_diagnostic_message(
    source: addr, length: i32) -> addr {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    // Crossing the artifact ABI must produce a STRING value, not expose an
    // aggregate-owned raw address whose backing parsed module is about to be
    // released by the host.
    let message: addr = compile_result_diagnostic_message(result, 0);
    let destroyed: i32 = compile_result_destroy(result);
    return message;
}

pub fn mini_meta_compile_result_diagnostic_start(
    source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let start: i32 = compile_result_diagnostic_start(result, 0);
    let destroyed: i32 = compile_result_destroy(result);
    return start;
}

pub fn mini_meta_compile_result_diagnostic_end(
    source: addr, length: i32) -> i32 {
    let result: CompileResult = mini_meta_compile_context_root(
        mini_meta_begin(source, length), length);
    let end: i32 = compile_result_diagnostic_end(result, 0);
    let destroyed: i32 = compile_result_destroy(result);
    return end;
}

pub fn mini_meta_compile_named(source: addr, length: i32, name: addr) -> i32 {
    let root: i32 = mini_meta_begin(source, length);
    if mini_elaborate_validate_named(root, name) != 0 { return 0; }
    return mini_lower_unit_named_validated(root, name);
}

// M7: execute an existing structured unit with the Lain-owned interpreter.
// Argument order intentionally matches core.execute-compiler-artifact!'s
// (addr, i32) calling convention used by the bootstrap host.
pub fn mini_meta_interpret_entry(entry: addr, unit: i32) -> i32 {
    return l1_interpreter_run(unit, entry);
}

// M8: compile a temporary unit and evaluate it with the same Lain interpreter
// used by M7 runtime tests.  No host capability dispatch is available to the
// target unit; an extern call is reported as interpreter status 7002.
pub fn mini_meta_comptime(
    source: addr, length: i32, entry: addr) -> i32 {
    let root: i32 = mini_meta_begin(source, length);
    let compile_result: CompileResult = mini_meta_compile_context_root(
        root, length);
    if compile_result_ok(compile_result) == 0 {
        let code: i32 = compile_result_diagnostic_code(
            compile_result, 0);
        let destroyed_failure: i32 = compile_result_destroy(
            compile_result);
        return l1_interpreter_result_error(code);
    }
    let unit: i32 = compile_result_unit_or_zero(compile_result);
    let destroyed_compile_result: i32 = compile_result_destroy(
        compile_result);
    let result: i32 = l1_interpreter_run(unit, entry);
    let destroyed: i32 = l1_unit_builder_destroy(unit);
    return result;
}

pub fn mini_meta_comptime_main(source: addr, length: i32) -> i32 {
    return mini_meta_comptime(source, length, "main");
}

pub fn mini_meta_comptime_diagnostic_message(
    source: addr, length: i32) -> addr {
    let diagnostic: i32 = mini_elaborate_validate(
        mini_meta_begin(source, length));
    return mini_diagnostic_message(diagnostic);
}

pub fn mini_meta_comptime_named(
    source: addr, length: i32, entry: addr) -> i32 {
    let root: i32 = mini_meta_begin(source, length);
    let diagnostic: i32 = mini_elaborate_validate_named(root, entry);
    if diagnostic != 0 {
        return l1_interpreter_result_error(diagnostic);
    }
    let unit: i32 = mini_lower_unit_named_validated(root, entry);
    if unit == 0 { return l1_interpreter_result_error(8002); }
    let result: i32 = l1_interpreter_run(unit, entry);
    let destroyed: i32 = l1_unit_builder_destroy(unit);
    return result;
}

pub fn mini_meta_comptime_named_main(source: addr, length: i32) -> i32 {
    return mini_meta_comptime_named(source, length, "main");
}

// Feed the comptime result back into lowering by materializing a new unit
// whose `comptime_value` procedure returns the evaluated constant.
pub fn mini_meta_comptime_materialize_main(
    source: addr, length: i32) -> i32 {
    let result: i32 = mini_meta_comptime_main(source, length);
    if l1_interpreter_result_status(result) != 0 {
        let destroyed_result: i32 = l1_interpreter_result_destroy(result);
        return 0;
    }
    let value: i32 = l1_interpreter_result_value(result);
    let destroyed_result: i32 = l1_interpreter_result_destroy(result);
    let unit: i32 = l1_unit_builder_new();
    if unit == 0 { return 0; }
    let procedure: i32 = l1_unit_builder_proc(
        unit, "comptime_value", 1);
    let expression: i32 = l1_unit_builder_i32(unit, value);
    if procedure == 0 {
        let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
        return 0;
    }
    if expression == 0 {
        let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
        return 0;
    }
    if l1_unit_builder_return(
        unit, procedure, expression) != 1 {
        let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
        return 0;
    }
    if l1_unit_builder_verify(unit, "comptime_value") != 1 {
        let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
        return 0;
    }
    return unit;
}

