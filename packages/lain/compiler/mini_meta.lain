}

pub fn mini_meta_workspace_dependency_count(source: addr, length: i32) -> i32 {
    return mini_workspace_dependency_count(mini_meta_workspace_begin(source, length));
}

// Stable compiler artifact ABI.  Historical mini_meta_* exports remain for
// bootstrap compatibility, but the installed CLI uses only compiler_*.
pub fn compiler_compile_text(source: addr, length: i32) -> addr {
    return mini_meta_compile_text(source, length);
}

pub fn compiler_diagnostic_code(source: addr, length: i32) -> i32 {
    return mini_meta_compile_result_diagnostic_code(source, length);
}

pub fn compiler_diagnostic_message(source: addr, length: i32) -> addr {
    return mini_meta_compile_result_diagnostic_message(source, length);
}

pub fn compiler_diagnostic_start(source: addr, length: i32) -> i32 {
    return mini_meta_compile_result_diagnostic_start(source, length);
}

pub fn compiler_diagnostic_end(source: addr, length: i32) -> i32 {
    return mini_meta_compile_result_diagnostic_end(source, length);
}

pub fn compiler_compile_workspace_text(
    path_storage: i32, source_storage: i32, count: i32) -> addr {
    let input: WorkspaceInput = workspace_input_new(
        path_storage, source_storage, count);
    if input.diagnostic != 0 {
        let destroyed_failure: i32 = workspace_input_destroy(input);
        return "";
    }
    let workspace: ModuleWorkspace = workspace_input_module_workspace(input);
    let unit: i32 = mini_workspace_compile_indexed(workspace);
    if unit == 0 {
        let destroyed_failure: i32 = workspace_input_destroy(input);
        return "";
    }
    let text: addr = l1_unit_builder_debug_text(unit);
    let destroyed_unit: i32 = l1_unit_builder_destroy(unit);
    let destroyed: i32 = workspace_input_destroy(input);
    return text;
}

pub fn compiler_workspace_diagnostic_code(
    path_storage: i32, source_storage: i32, count: i32) -> i32 {
    let input: WorkspaceInput = workspace_input_new(
        path_storage, source_storage, count);
    if input.diagnostic != 0 {
        let code: i32 = input.diagnostic;
        let destroyed_failure: i32 = workspace_input_destroy(input);
        return code;
    }
    let workspace: ModuleWorkspace = workspace_input_module_workspace(input);
    let code: i32 = mini_workspace_validate_indexed(workspace);
    let destroyed: i32 = workspace_input_destroy(input);
    return code;
}

pub fn compiler_workspace_diagnostic_message(
    path_storage: i32, source_storage: i32, count: i32) -> addr {
    return mini_diagnostic_message(compiler_workspace_diagnostic_code(
        path_storage, source_storage, count));
}

pub fn compiler_workspace_diagnostic_path(
    path_storage: i32, source_storage: i32, count: i32) -> addr {
    let input: WorkspaceInput = workspace_input_new(
        path_storage, source_storage, count);
    let path: addr = workspace_input_diagnostic_path(input);
    let destroyed: i32 = workspace_input_destroy(input);
    return path;
}

pub fn compiler_schema_version() -> i32 { return 1; }
