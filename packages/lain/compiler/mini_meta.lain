// M14 CLI entry.  A workspace is a concatenation of explicit Module bindings;
// Lain resolves the module graph and returns one verifier-clean physical unit.
pub fn mini_meta_workspace_compile_text(source: addr, length: i32) -> addr {
    let unit: i32 = mini_meta_workspace_compile(source, length);
    if unit == 0 { return ""; }
    let text: addr = l1_unit_builder_debug_text(unit);
    let destroyed: i32 = l1_unit_builder_destroy(unit);
    return text;
}

pub fn mini_meta_workspace_diagnostic_code(
    source: addr, length: i32) -> i32 {
    return mini_workspace_validate(mini_meta_workspace_begin(source, length));
}

