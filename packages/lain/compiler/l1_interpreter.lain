// Lain interpreter policy retained after removal of the C node/frame stores.
// The unresolved host_* calls below must become ordinary Lain reads, frames
// and results.




@export
let l1_interpreter_schema_version = std::func() -> i32 { return 7; }

@export
let l1_interpreter_result_error = std::func(status: i32) -> i32 {
    return host_result_new(status, 0);
}
@export
let l1_interpreter_result_status = std::func(result: i32) -> i32 {
    return host_result_status(result);
}
@export
let l1_interpreter_result_value = std::func(result: i32) -> i32 {
    return host_result_value(result);
}
@export
let l1_interpreter_result_destroy = std::func(result: i32) -> i32 {
    return host_result_destroy(result);
}

let l1_interpreter_eval_expr = std::func(
    evaluation: i32, unit: i32, frame: i32, expression: i32) -> i32 {
    if host_eval_status(evaluation) != 0 { return 0; }
    let kind: i32 = host_expr_kind(unit, expression);
    if kind == 1 {
        return host_frame_var(frame, host_expr_name(unit, expression));
    }
    if kind == 2 { return host_read_expr_i32(unit, expression); }
    if kind == 3 {
        return host_frame_arg(frame, host_expr_index(unit, expression));
    }
    if kind == 4 {
        return l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_expr_child(unit, expression, 0))
            + l1_interpreter_eval_expr(
                evaluation, unit, frame,
                host_expr_child(unit, expression, 1));
    }
    if kind == 5 {
        if l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_expr_child(unit, expression, 0))
            == l1_interpreter_eval_expr(
                evaluation, unit, frame,
                host_expr_child(unit, expression, 1)) { return 1; }
        return 0;
    }
    if kind == 6 {
        if l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_expr_child(unit, expression, 0))
            != l1_interpreter_eval_expr(
                evaluation, unit, frame,
                host_expr_child(unit, expression, 1)) { return 1; }
        return 0;
    }
    if kind == 7 {
        return l1_interpreter_eval_call(
            evaluation, unit, frame, expression);
    }
    let ignored: i32 = host_eval_fail(evaluation, 7004);
    return 0;
}

let l1_interpreter_bind_call_args = std::func(
    evaluation: i32, unit: i32, caller_frame: i32,
    callee_frame: i32, call: i32, index: i32, count: i32) -> i32 {
    if index == count { return 1; }
    let value: i32 = l1_interpreter_eval_expr(
        evaluation, unit, caller_frame,
        host_read_call_arg(unit, call, index));
    if host_eval_status(evaluation) != 0 { return 0; }
    if host_frame_arg_set(callee_frame, index, value) != 1 { return 0; }
    return l1_interpreter_bind_call_args(
        evaluation, unit, caller_frame, callee_frame,
        call, index + 1, count);
}

let l1_interpreter_meta_arg = std::func(
    evaluation: i32, unit: i32, caller_frame: i32,
    call: i32, index: i32) -> i32 {
    return l1_interpreter_eval_expr(
        evaluation, unit, caller_frame,
        host_read_call_arg(unit, call, index));
}

let l1_interpreter_meta_result = std::func(
    evaluation: i32, value: i32) -> i32 {
    if value != 0 { return value; }
    let ignored: i32 = host_eval_fail(evaluation, 7009);
    return 0;
}

let l1_interpreter_eval_meta_call = std::func(
    evaluation: i32, unit: i32, caller_frame: i32,
    call: i32, name: addr) -> i32 {
    if l1_host_string_equal(name, "meta.syntax-list-empty!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_list_empty());
    }
    let argument0: i32 = l1_interpreter_meta_arg(
        evaluation, unit, caller_frame, call, 0);
    if host_eval_status(evaluation) != 0 { return 0; }
    if l1_host_string_equal(name, "meta.syntax-clone!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_clone(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-left!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_left(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-right!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_right(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-op!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_op(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-next!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_next(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-atom!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_atom(argument0));
    }
    if l1_host_string_equal(name, "meta.syntax-list-one!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_list_one(argument0));
    }
    let argument1: i32 = l1_interpreter_meta_arg(
        evaluation, unit, caller_frame, call, 1);
    if host_eval_status(evaluation) != 0 { return 0; }
    if l1_host_string_equal(name, "meta.syntax-group!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_group(argument0, argument1));
    }
    if l1_host_string_equal(name, "meta.syntax-prefix!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_prefix(argument0, argument1));
    }
    if l1_host_string_equal(name, "meta.syntax-postfix!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_postfix(argument0, argument1));
    }
    if l1_host_string_equal(name, "meta.syntax-append!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_append(argument0, argument1));
    }
    if l1_host_string_equal(name, "meta.syntax-list-two!") == 1 {
        return l1_interpreter_meta_result(
            evaluation, host_meta_syntax_list_two(argument0, argument1));
    }
    let argument2: i32 = l1_interpreter_meta_arg(
        evaluation, unit, caller_frame, call, 2);
    if host_eval_status(evaluation) != 0 { return 0; }
    if l1_host_string_equal(name, "meta.syntax-infix!") == 1 {
        return l1_interpreter_meta_result(
            evaluation,
            host_meta_syntax_infix(argument0, argument1, argument2));
    }
    let ignored: i32 = host_eval_fail(evaluation, 7002);
    return 0;
}

let l1_interpreter_eval_call = std::func(
    evaluation: i32, unit: i32, caller_frame: i32, call: i32) -> i32 {
    let name: addr = host_expr_name(unit, call);
    let procedure: i32 = host_find_proc(unit, name);
    if procedure == 0 {
        let ignored: i32 = host_eval_fail(evaluation, 7001);
        return 0;
    }
    let count: i32 = host_call_arg_count(unit, call);
    if host_proc_param_count(unit, procedure) != count {
        let ignored: i32 = host_eval_fail(evaluation, 7005);
        return 0;
    }
    if host_proc_is_extern(unit, procedure) == 1 {
        return l1_interpreter_eval_meta_call(
            evaluation, unit, caller_frame, call, name);
    }
    let callee_frame: i32 = host_frame_new(evaluation);
    if callee_frame == 0 { return 0; }
    if l1_interpreter_bind_call_args(
        evaluation, unit, caller_frame,
        callee_frame, call, 0, count) != 1 { return 0; }
    return l1_interpreter_eval_instructions(
        evaluation, unit, callee_frame,
        host_proc_first_inst(unit, procedure));
}

let l1_interpreter_eval_instructions = std::func(
    evaluation: i32, unit: i32, frame: i32, instruction: i32) -> i32 {
    if instruction == 0 {
        let ignored: i32 = host_eval_fail(evaluation, 7008);
        return 0;
    }
    let kind: i32 = host_inst_kind(unit, instruction);
    if kind == 1 {
        let value: i32 = l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_inst_expr(unit, instruction));
        if host_eval_status(evaluation) != 0 { return 0; }
        if host_frame_var_set(
            frame, host_inst_name(unit, instruction), value) != 1 {
            return 0;
        }
        return l1_interpreter_eval_instructions(
            evaluation, unit, frame,
            host_inst_next(unit, instruction));
    }
    if kind == 2 {
        let condition: i32 = l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_inst_expr(unit, instruction));
        if host_eval_status(evaluation) != 0 { return 0; }
        if condition != 0 {
            return l1_interpreter_eval_instructions(
                evaluation, unit, frame,
                host_inst_branch(unit, instruction, 1));
        }
        return l1_interpreter_eval_instructions(
            evaluation, unit, frame,
            host_inst_branch(unit, instruction, 0));
    }
    if kind == 3 {
        return l1_interpreter_eval_expr(
            evaluation, unit, frame,
            host_inst_expr(unit, instruction));
    }
    let ignored: i32 = host_eval_fail(evaluation, 7003);
    return 0;
}

@export
let l1_interpreter_run = std::func(unit: i32, entry: addr) -> i32 {
    let evaluation: i32 = host_eval_new();
    if evaluation == 0 { return host_result_new(7101, 0); }
    let procedure: i32 = host_find_proc(unit, entry);
    if procedure == 0 {
        let ignored: i32 = host_eval_fail(evaluation, 7001);
    }
    if procedure != 0 {
        if host_proc_is_extern(unit, procedure) == 1 {
            let ignored: i32 = host_eval_fail(evaluation, 7002);
        }
    }
    if procedure != 0 {
        if host_proc_param_count(unit, procedure) != 0 {
            let ignored: i32 = host_eval_fail(evaluation, 7005);
        }
    }
    if host_eval_status(evaluation) != 0 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    let frame: i32 = host_frame_new(evaluation);
    if frame == 0 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    let value: i32 = l1_interpreter_eval_instructions(
        evaluation, unit, frame,
        host_proc_first_inst(unit, procedure));
    let status: i32 = host_eval_status(evaluation);
    let destroyed: i32 = host_eval_destroy(evaluation);
    return host_result_new(status, value);
}

// Meta callables use two opaque i32 arguments (MetaContext and
// MetaInvocation handles).  They execute through the same evaluator as
// consteval and ordinary interpreted L1; this is an entry adapter, not a
// second evaluator.
@export
let l1_interpreter_run2 = std::func(
    unit: i32, entry: addr, argument0: i32, argument1: i32) -> i32 {
    let evaluation: i32 = host_eval_new();
    if evaluation == 0 { return host_result_new(7101, 0); }
    let procedure: i32 = host_find_proc(unit, entry);
    if procedure == 0 {
        let ignored: i32 = host_eval_fail(evaluation, 7001);
    }
    if procedure != 0 {
        if host_proc_is_extern(unit, procedure) == 1 {
            let ignored: i32 = host_eval_fail(evaluation, 7002);
        }
    }
    if procedure != 0 {
        if host_proc_param_count(unit, procedure) != 2 {
            let ignored: i32 = host_eval_fail(evaluation, 7005);
        }
    }
    if host_eval_status(evaluation) != 0 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    let frame: i32 = host_frame_new(evaluation);
    if frame == 0 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    if host_frame_arg_set(frame, 0, argument0) != 1 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    if host_frame_arg_set(frame, 1, argument1) != 1 {
        let failed_status: i32 = host_eval_status(evaluation);
        let destroyed: i32 = host_eval_destroy(evaluation);
        return host_result_new(failed_status, 0);
    }
    let value: i32 = l1_interpreter_eval_instructions(
        evaluation, unit, frame,
        host_proc_first_inst(unit, procedure));
    let status: i32 = host_eval_status(evaluation);
    let destroyed: i32 = host_eval_destroy(evaluation);
    return host_result_new(status, value);
}
