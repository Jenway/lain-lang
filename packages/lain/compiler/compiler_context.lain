// M11 Lain-owned compiler context and growable collection policy.
//
// The host exposes only opaque raw slot storage.  Lain owns length, capacity,
// geometric growth, parallel-table consistency, scope truncation, diagnostic
// lifetime, and success/failure policy.

let types = import("packages::lain::compiler::types");
let syntax = import("packages::lain::compiler::syntax");

@foreign(c, link_name = "compiler.storage-new!")
let host_storage_new = std::func(kind: i32) -> i32;
@foreign(c, link_name = "compiler.storage-reserve!")
let host_storage_reserve = std::func(storage: i32, capacity: i32) -> i32;
@foreign(c, link_name = "compiler.storage-set-i32!")
let host_storage_set_i32 = std::func(storage: i32, index: i32, value: i32) -> i32;
@foreign(c, link_name = "compiler.storage-get-i32!")
let host_storage_get_i32 = std::func(storage: i32, index: i32) -> i32;
@foreign(c, link_name = "compiler.storage-set-string!")
let host_storage_set_string = std::func(storage: i32, index: i32, value: addr) -> i32;
@foreign(c, link_name = "compiler.storage-get-string!")
let host_storage_get_string = std::func(storage: i32, index: i32) -> addr;
@foreign(c, link_name = "compiler.storage-destroy!")
let host_storage_destroy = std::func(storage: i32) -> i32;
@foreign(c, link_name = "core.string-equal!")
let host_string_equal = std::func(left: addr, right: addr) -> i32;
@foreign(c, link_name = "core.string-first-byte!")
let host_string_first_byte = std::func(value: addr) -> i32;
@foreign(c, link_name = "core.string-length!")
let host_string_length = std::func(value: addr) -> i32;

@export

let M11I32Vec: type = std::struct {
    storage: i32,
    len: i32,
    capacity: i32,
    ok: i32,
}

@export

let M11StringVec: type = std::struct {
    storage: i32,
    len: i32,
    capacity: i32,
    ok: i32,
}

let m11_next_capacity = std::func(capacity: i32) -> i32 {
    if capacity == 0 { return 4; }
    return capacity + capacity;
}

@export
let m11_i32_vec_new = std::func() -> M11I32Vec {
    let storage: i32 = host_storage_new(1);
    if storage == 0 {
        return M11I32Vec { storage: 0, len: 0, capacity: 0, ok: 0 };
    }
    return M11I32Vec { storage: storage, len: 0, capacity: 0, ok: 1 };
}

@export
let m11_string_vec_new = std::func() -> M11StringVec {
    let storage: i32 = host_storage_new(2);
    if storage == 0 {
        return M11StringVec { storage: 0, len: 0, capacity: 0, ok: 0 };
    }
    return M11StringVec { storage: storage, len: 0, capacity: 0, ok: 1 };
}

@export
let m11_i32_vec_push = std::func(vec: M11I32Vec, value: i32) -> M11I32Vec {
    if vec.ok == 0 { return vec; }
    let capacity: i32 = vec.capacity;
    if vec.len == capacity {
        let grown: i32 = m11_next_capacity(capacity);
        if host_storage_reserve(vec.storage, grown) == 0 {
            return M11I32Vec {
                storage: vec.storage, len: vec.len,
                capacity: vec.capacity, ok: 0,
            };
        }
        if host_storage_set_i32(vec.storage, vec.len, value) == 0 {
            return M11I32Vec {
                storage: vec.storage, len: vec.len,
                capacity: grown, ok: 0,
            };
        }
        let new_len: i32 = vec.len + 1;
        return M11I32Vec {
            storage: vec.storage, len: new_len,
            capacity: grown, ok: 1,
        };
    }
    if host_storage_set_i32(vec.storage, vec.len, value) == 0 {
        return M11I32Vec {
            storage: vec.storage, len: vec.len,
            capacity: vec.capacity, ok: 0,
        };
    }
    let new_len: i32 = vec.len + 1;
    return M11I32Vec {
        storage: vec.storage, len: new_len,
        capacity: vec.capacity, ok: 1,
    };
}

@export
let m11_string_vec_push = std::func(
    vec: M11StringVec, value: addr) -> M11StringVec {
    if vec.ok == 0 { return vec; }
    let capacity: i32 = vec.capacity;
    if vec.len == capacity {
        let grown: i32 = m11_next_capacity(capacity);
        if host_storage_reserve(vec.storage, grown) == 0 {
            return M11StringVec {
                storage: vec.storage, len: vec.len,
                capacity: vec.capacity, ok: 0,
            };
        }
        if host_storage_set_string(vec.storage, vec.len, value) == 0 {
            return M11StringVec {
                storage: vec.storage, len: vec.len,
                capacity: grown, ok: 0,
            };
        }
        let new_len: i32 = vec.len + 1;
        return M11StringVec {
            storage: vec.storage, len: new_len,
            capacity: grown, ok: 1,
        };
    }
    if host_storage_set_string(vec.storage, vec.len, value) == 0 {
        return M11StringVec {
            storage: vec.storage, len: vec.len,
            capacity: vec.capacity, ok: 0,
        };
    }
    let new_len: i32 = vec.len + 1;
    return M11StringVec {
        storage: vec.storage, len: new_len,
        capacity: vec.capacity, ok: 1,
    };
}

@export
let m11_i32_vec_get = std::func(vec: M11I32Vec, index: i32) -> i32 {
    if index < 0 { return 0; }
    if index >= vec.len { return 0; }
    return host_storage_get_i32(vec.storage, index);
}

@export
let m11_string_vec_get = std::func(vec: M11StringVec, index: i32) -> addr {
    if index < 0 { return ""; }
    if index >= vec.len { return ""; }
    return host_storage_get_string(vec.storage, index);
}

@export
let m11_i32_vec_truncate = std::func(vec: M11I32Vec, len: i32) -> M11I32Vec {
    if len < 0 { return vec; }
    if len > vec.len { return vec; }
    return M11I32Vec {
        storage: vec.storage, len: len,
        capacity: vec.capacity, ok: vec.ok,
    };
}

@export
let m11_string_vec_truncate = std::func(
    vec: M11StringVec, len: i32) -> M11StringVec {
    if len < 0 { return vec; }
    if len > vec.len { return vec; }
    return M11StringVec {
        storage: vec.storage, len: len,
        capacity: vec.capacity, ok: vec.ok,
    };
}

@export
let m11_i32_vec_destroy = std::func(vec: M11I32Vec) -> i32 {
    return host_storage_destroy(vec.storage);
}

@export
let m11_string_vec_destroy = std::func(vec: M11StringVec) -> i32 {
    return host_storage_destroy(vec.storage);
}

@export

let M11SymbolTable: type = std::struct {
    names: M11StringVec,
    hygiene_contexts: M11I32Vec,
    values: M11I32Vec,
    next: M11I32Vec,
    heads: M11I32Vec,
}

let m11_i32_vec_zeroed = std::func(length: i32) -> M11I32Vec {
    let storage: i32 = host_storage_new(1);
    if storage == 0 {
        return M11I32Vec { storage: 0, len: 0, capacity: 0, ok: 0 };
    }
    if host_storage_reserve(storage, length) == 0 {
        let destroyed: i32 = host_storage_destroy(storage);
        return M11I32Vec { storage: 0, len: 0, capacity: 0, ok: 0 };
    }
    return M11I32Vec {
        storage: storage, len: length, capacity: length, ok: 1,
    };
}

let m11_symbol_table_name_length = std::func(name: addr) -> i32 {
    let length: i32 = host_string_length(name);
    if length > 127 { return 127; }
    return length;
}

let m11_symbol_table_bucket = std::func(name: addr) -> i32 {
    let first: i32 = host_string_first_byte(name);
    let raw: i32 = first + first + first + first
        + m11_symbol_table_name_length(name);
    if raw >= 512 { return raw + -512; }
    return raw;
}

@export
let m11_symbol_table_new = std::func() -> M11SymbolTable {
    return M11SymbolTable {
        names: m11_string_vec_new(),
        hygiene_contexts: m11_i32_vec_new(),
        values: m11_i32_vec_new(),
        next: m11_i32_vec_new(), heads: m11_i32_vec_zeroed(512),
    };
}

let m11_symbol_table_insert_context = std::func(
    table: M11SymbolTable, name: addr,
    hygiene_context: i32, value: i32) -> M11SymbolTable {
    let names_before: M11StringVec = table.names;
    let heads: M11I32Vec = table.heads;
    let bucket: i32 = m11_symbol_table_bucket(name);
    let old_head: i32 = m11_i32_vec_get(heads, bucket);
    let stored: i32 = host_storage_set_i32(
        heads.storage, bucket, names_before.len + 1);
    return M11SymbolTable {
        names: m11_string_vec_push(table.names, name),
        hygiene_contexts: m11_i32_vec_push(
            table.hygiene_contexts, hygiene_context),
        values: m11_i32_vec_push(table.values, value),
        next: m11_i32_vec_push(table.next, old_head),
        heads: heads,
    };
}

@export
let m11_symbol_table_insert = std::func(
    table: M11SymbolTable, name: addr, value: i32) -> M11SymbolTable {
    return m11_symbol_table_insert_context(table, name, 0, value);
}

@export
let m11_symbol_table_insert_node = std::func(
    table: M11SymbolTable, identifier: i32,
    value: i32) -> M11SymbolTable {
    return m11_symbol_table_insert_context(
        table, syntax_text(identifier), syntax_hygiene(identifier), value);
}

let m11_symbol_table_find_from = std::func(
    table: M11SymbolTable, name: addr,
    hygiene_context: i32, entry: i32) -> i32 {
    if entry == 0 { return 0; }
    if host_string_equal(
        m11_string_vec_get(table.names, entry + -1), name) == 1 {
        if m11_i32_vec_get(
            table.hygiene_contexts, entry + -1) == hygiene_context {
            return m11_i32_vec_get(table.values, entry + -1);
        }
    }
    return m11_symbol_table_find_from(
        table, name, hygiene_context,
        m11_i32_vec_get(table.next, entry + -1));
}

@export
let m11_symbol_table_find = std::func(table: M11SymbolTable, name: addr) -> i32 {
    return m11_symbol_table_find_from(
        table, name, 0,
        m11_i32_vec_get(table.heads, m11_symbol_table_bucket(name)));
}

@export
let m11_symbol_table_find_node = std::func(
    table: M11SymbolTable, identifier: i32) -> i32 {
    let name: addr = syntax_text(identifier);
    return m11_symbol_table_find_from(
        table, name, syntax_hygiene(identifier),
        m11_i32_vec_get(table.heads, m11_symbol_table_bucket(name)));
}

@export
let m11_symbol_table_count = std::func(table: M11SymbolTable) -> i32 {
    let names: M11StringVec = table.names;
    return names.len;
}

@export
let m11_symbol_table_destroy = std::func(table: M11SymbolTable) -> i32 {
    let names: i32 = m11_string_vec_destroy(table.names);
    let hygiene: i32 = m11_i32_vec_destroy(table.hygiene_contexts);
    let values: i32 = m11_i32_vec_destroy(table.values);
    let next: i32 = m11_i32_vec_destroy(table.next);
    let heads: i32 = m11_i32_vec_destroy(table.heads);
    if names == 1 {
        if hygiene == 1 {
          if values == 1 {
            if next == 1 { return heads; }
          }
        }
    }
    return 0;
}

@export

let M11ScopeStack: type = std::struct {
    names: M11StringVec,
    type_ids: M11I32Vec,
    marks: M11I32Vec,
    depth: i32,
}

@export
let m11_scope_stack_new = std::func() -> M11ScopeStack {
    return M11ScopeStack {
        names: m11_string_vec_new(),
        type_ids: m11_i32_vec_new(),
        marks: m11_i32_vec_new(),
        depth: 0,
    };
}

@export
let m11_scope_enter = std::func(scopes: M11ScopeStack) -> M11ScopeStack {
    let names: M11StringVec = scopes.names;
    let depth: i32 = scopes.depth + 1;
    return M11ScopeStack {
        names: scopes.names,
        type_ids: scopes.type_ids,
        marks: m11_i32_vec_push(scopes.marks, names.len),
        depth: depth,
    };
}

@export
let m11_scope_bind = std::func(
    scopes: M11ScopeStack, name: addr, type_id: i32) -> M11ScopeStack {
    return M11ScopeStack {
        names: m11_string_vec_push(scopes.names, name),
        type_ids: m11_i32_vec_push(scopes.type_ids, type_id),
        marks: scopes.marks,
        depth: scopes.depth,
    };
}

@export
let m11_scope_exit = std::func(scopes: M11ScopeStack) -> M11ScopeStack {
    if scopes.depth == 0 { return scopes; }
    let marks: M11I32Vec = scopes.marks;
    let mark: i32 = m11_i32_vec_get(marks, marks.len + -1);
    let depth: i32 = scopes.depth + -1;
    return M11ScopeStack {
        names: m11_string_vec_truncate(scopes.names, mark),
        type_ids: m11_i32_vec_truncate(scopes.type_ids, mark),
        marks: m11_i32_vec_truncate(marks, marks.len + -1),
        depth: depth,
    };
}

let m11_scope_lookup_from = std::func(
    scopes: M11ScopeStack, name: addr, index: i32) -> i32 {
    if index < 0 { return 0; }
    if host_string_equal(m11_string_vec_get(scopes.names, index), name) == 1 {
        return m11_i32_vec_get(scopes.type_ids, index);
    }
    return m11_scope_lookup_from(scopes, name, index + -1);
}

@export
let m11_scope_lookup = std::func(scopes: M11ScopeStack, name: addr) -> i32 {
    let names: M11StringVec = scopes.names;
    return m11_scope_lookup_from(scopes, name, names.len + -1);
}

@export
let m11_scope_destroy = std::func(scopes: M11ScopeStack) -> i32 {
    let names: i32 = m11_string_vec_destroy(scopes.names);
    let types: i32 = m11_i32_vec_destroy(scopes.type_ids);
    let marks: i32 = m11_i32_vec_destroy(scopes.marks);
    if names == 1 {
        if types == 1 { return marks; }
    }
    return 0;
}

@export

let M11DiagnosticStore: type = std::struct {
    codes: M11I32Vec,
    messages: M11StringVec,
    nodes: M11I32Vec,
    starts: M11I32Vec,
    ends: M11I32Vec,
}

@export
let m11_diagnostics_new = std::func() -> M11DiagnosticStore {
    return M11DiagnosticStore {
        codes: m11_i32_vec_new(), messages: m11_string_vec_new(),
        nodes: m11_i32_vec_new(), starts: m11_i32_vec_new(),
        ends: m11_i32_vec_new(),
    };
}

@export
let m11_diagnostics_push = std::func(
    diagnostics: M11DiagnosticStore, code: i32, message: addr,
    node: i32, start: i32, end: i32) -> M11DiagnosticStore {
    return M11DiagnosticStore {
        codes: m11_i32_vec_push(diagnostics.codes, code),
        messages: m11_string_vec_push(diagnostics.messages, message),
        nodes: m11_i32_vec_push(diagnostics.nodes, node),
        starts: m11_i32_vec_push(diagnostics.starts, start),
        ends: m11_i32_vec_push(diagnostics.ends, end),
    };
}

@export
let m11_diagnostics_count = std::func(diagnostics: M11DiagnosticStore) -> i32 {
    let codes: M11I32Vec = diagnostics.codes;
    return codes.len;
}

@export
let m11_diagnostics_code = std::func(
    diagnostics: M11DiagnosticStore, index: i32) -> i32 {
    return m11_i32_vec_get(diagnostics.codes, index);
}

@export
let m11_diagnostics_message = std::func(
    diagnostics: M11DiagnosticStore, index: i32) -> addr {
    return m11_string_vec_get(diagnostics.messages, index);
}

@export
let m11_diagnostics_start = std::func(
    diagnostics: M11DiagnosticStore, index: i32) -> i32 {
    return m11_i32_vec_get(diagnostics.starts, index);
}

@export
let m11_diagnostics_end = std::func(
    diagnostics: M11DiagnosticStore, index: i32) -> i32 {
    return m11_i32_vec_get(diagnostics.ends, index);
}

@export
let m11_diagnostics_destroy = std::func(diagnostics: M11DiagnosticStore) -> i32 {
    let codes: i32 = m11_i32_vec_destroy(diagnostics.codes);
    let messages: i32 = m11_string_vec_destroy(diagnostics.messages);
    let nodes: i32 = m11_i32_vec_destroy(diagnostics.nodes);
    let starts: i32 = m11_i32_vec_destroy(diagnostics.starts);
    let ends: i32 = m11_i32_vec_destroy(diagnostics.ends);
    if codes == 1 {
        if messages == 1 {
            if nodes == 1 {
                if starts == 1 { return ends; }
            }
        }
    }
    return 0;
}

@export

let CompilerContext: type = std::struct {
    syntax_root: i32,
    source_length: i32,
    phase: i32,
    unit: i32,
    modules: M11SymbolTable,
    types: M11SymbolTable,
    type_kinds: M11I32Vec,
    type_arguments: M11I32Vec,
    type_owners: M11I32Vec,
    scopes: M11ScopeStack,
    diagnostics: M11DiagnosticStore,
}

@export

let CompileResult: type = std::struct {
    outcome_tag: i32,
    unit: i32,
    module_count: i32,
    diagnostics: M11DiagnosticStore,
}

@export
let TypeInternResult: type = std::struct {
    context: CompilerContext,
    type_id: i32,
}

let compiler_builtin_type_kinds = std::func() -> M11I32Vec {
    let values0: M11I32Vec = m11_i32_vec_new();
    let values1: M11I32Vec = m11_i32_vec_push(values0, 1);
    let values2: M11I32Vec = m11_i32_vec_push(values1, 1);
    let values3: M11I32Vec = m11_i32_vec_push(values2, 1);
    let values4: M11I32Vec = m11_i32_vec_push(values3, 1);
    let values5: M11I32Vec = m11_i32_vec_push(values4, 1);
    let values6: M11I32Vec = m11_i32_vec_push(values5, 1);
    return m11_i32_vec_push(values6, 1);
}

let compiler_builtin_type_zeros = std::func() -> M11I32Vec {
    let values0: M11I32Vec = m11_i32_vec_new();
    let values1: M11I32Vec = m11_i32_vec_push(values0, 0);
    let values2: M11I32Vec = m11_i32_vec_push(values1, 0);
    let values3: M11I32Vec = m11_i32_vec_push(values2, 0);
    let values4: M11I32Vec = m11_i32_vec_push(values3, 0);
    let values5: M11I32Vec = m11_i32_vec_push(values4, 0);
    let values6: M11I32Vec = m11_i32_vec_push(values5, 0);
    return m11_i32_vec_push(values6, 0);
}

let compiler_builtin_types = std::func() -> M11SymbolTable {
    let types0: M11SymbolTable = m11_symbol_table_new();
    let types1: M11SymbolTable = m11_symbol_table_insert(types0, "i32", 1);
    let types2: M11SymbolTable = m11_symbol_table_insert(types1, "bool", 2);
    let types3: M11SymbolTable = m11_symbol_table_insert(types2, "addr", 3);
    let types4: M11SymbolTable = m11_symbol_table_insert(types3, "unit", 4);
    let types5: M11SymbolTable = m11_symbol_table_insert(types4, "type", 5);
    let types6: M11SymbolTable = m11_symbol_table_insert(types5, "Module", 6);
    return m11_symbol_table_insert(types6, "Callable", 7);
}

@export
let compiler_context_new = std::func(
    syntax_root: i32, source_length: i32) -> CompilerContext {
    return CompilerContext {
        syntax_root: syntax_root, source_length: source_length,
        phase: 1, unit: 0,
        modules: m11_symbol_table_new(),
        types: compiler_builtin_types(),
        type_kinds: compiler_builtin_type_kinds(),
        type_arguments: compiler_builtin_type_zeros(),
        type_owners: compiler_builtin_type_zeros(),
        scopes: m11_scope_stack_new(),
        diagnostics: m11_diagnostics_new(),
    };
}

@export
let compiler_context_add_module = std::func(
    context: CompilerContext, name: addr, module_id: i32)
    -> CompilerContext {
    return CompilerContext {
        syntax_root: context.syntax_root,
        source_length: context.source_length,
        phase: context.phase, unit: context.unit,
        modules: m11_symbol_table_insert(context.modules, name, module_id),
        types: context.types,
        type_kinds: context.type_kinds,
        type_arguments: context.type_arguments,
        type_owners: context.type_owners,
        scopes: context.scopes,
        diagnostics: context.diagnostics,
    };
}

@export
let compiler_context_add_type = std::func(
    context: CompilerContext, name: addr, type_id: i32)
    -> CompilerContext {
    return CompilerContext {
        syntax_root: context.syntax_root,
        source_length: context.source_length,
        phase: context.phase, unit: context.unit,
        modules: context.modules,
        types: m11_symbol_table_insert(context.types, name, type_id),
        type_kinds: context.type_kinds,
        type_arguments: context.type_arguments,
        type_owners: context.type_owners,
        scopes: context.scopes, diagnostics: context.diagnostics,
    };
}

@export
let compiler_context_type_value = std::func(
    context: CompilerContext, type_id: i32) -> TypeValue {
    let type_kinds: M11I32Vec = context.type_kinds;
    if type_id <= 0 { return type_value(0); }
    if type_id > type_kinds.len { return type_value(0); }
    return TypeValue {
        id: type_id,
        kind: m11_i32_vec_get(context.type_kinds, type_id + -1),
        argument: m11_i32_vec_get(
            context.type_arguments, type_id + -1),
        owner: m11_i32_vec_get(context.type_owners, type_id + -1),
    };
}

let compiler_context_find_type_value = std::func(
    context: CompilerContext, kind: i32, argument: i32,
    owner: i32, index: i32) -> i32 {
    let type_kinds: M11I32Vec = context.type_kinds;
    if index >= type_kinds.len { return 0; }
    if m11_i32_vec_get(context.type_kinds, index) == kind {
        if m11_i32_vec_get(context.type_arguments, index) == argument {
            if m11_i32_vec_get(context.type_owners, index) == owner {
                return index + 1;
            }
        }
    }
    return compiler_context_find_type_value(
        context, kind, argument, owner, index + 1);
}

@export
let compiler_context_intern_type = std::func(
    context: CompilerContext, name: addr, kind: i32,
    argument: i32, owner: i32) -> TypeInternResult {
    let existing: i32 = compiler_context_find_type_value(
        context, kind, argument, owner, 0);
    if existing != 0 {
        return TypeInternResult { context: context, type_id: existing };
    }
    let type_kinds: M11I32Vec = context.type_kinds;
    let type_id: i32 = type_kinds.len + 1;
    let updated: CompilerContext = CompilerContext {
        syntax_root: context.syntax_root,
        source_length: context.source_length,
        phase: context.phase, unit: context.unit,
        modules: context.modules,
        types: m11_symbol_table_insert(context.types, name, type_id),
        type_kinds: m11_i32_vec_push(context.type_kinds, kind),
        type_arguments: m11_i32_vec_push(
            context.type_arguments, argument),
        type_owners: m11_i32_vec_push(context.type_owners, owner),
        scopes: context.scopes,
        diagnostics: context.diagnostics,
    };
    return TypeInternResult { context: updated, type_id: type_id };
}

@export
let compiler_context_add_diagnostic = std::func(
    context: CompilerContext, code: i32, message: addr,
    node: i32, start: i32, end: i32) -> CompilerContext {
    return CompilerContext {
        syntax_root: context.syntax_root,
        source_length: context.source_length,
        phase: 4, unit: 0,
        modules: context.modules, types: context.types,
        type_kinds: context.type_kinds,
        type_arguments: context.type_arguments,
        type_owners: context.type_owners,
        scopes: context.scopes,
        diagnostics: m11_diagnostics_push(
            context.diagnostics, code, message, node, start, end),
    };
}

@export
let compiler_context_with_unit = std::func(
    context: CompilerContext, unit: i32) -> CompilerContext {
    return CompilerContext {
        syntax_root: context.syntax_root,
        source_length: context.source_length,
        phase: 3, unit: unit,
        modules: context.modules, types: context.types,
        type_kinds: context.type_kinds,
        type_arguments: context.type_arguments,
        type_owners: context.type_owners,
        scopes: context.scopes, diagnostics: context.diagnostics,
    };
}

@export
let compiler_context_finish = std::func(context: CompilerContext) -> CompileResult {
    let module_count: i32 = m11_symbol_table_count(context.modules);
    let destroyed_modules: i32 = m11_symbol_table_destroy(context.modules);
    let destroyed_types: i32 = m11_symbol_table_destroy(context.types);
    let destroyed_type_kinds: i32 =
        m11_i32_vec_destroy(context.type_kinds);
    let destroyed_type_arguments: i32 =
        m11_i32_vec_destroy(context.type_arguments);
    let destroyed_type_owners: i32 =
        m11_i32_vec_destroy(context.type_owners);
    let destroyed_scopes: i32 = m11_scope_destroy(context.scopes);
    if m11_diagnostics_count(context.diagnostics) != 0 {
        return CompileResult {
            outcome_tag: 0, unit: 0, module_count: module_count,
            diagnostics: context.diagnostics,
        };
    }
    if context.unit == 0 {
        return CompileResult {
            outcome_tag: 0, unit: 0, module_count: module_count,
            diagnostics: context.diagnostics,
        };
    }
    return CompileResult {
        outcome_tag: 1, unit: context.unit, module_count: module_count,
        diagnostics: context.diagnostics,
    };
}

@export
let compile_result_destroy = std::func(result: CompileResult) -> i32 {
    return m11_diagnostics_destroy(result.diagnostics);
}

@export
let compile_result_ok = std::func(result: CompileResult) -> i32 {
    return result.outcome_tag;
}

@export
let compile_result_unit_or_zero = std::func(result: CompileResult) -> i32 {
    if result.outcome_tag == 0 { return 0; }
    return result.unit;
}

@export
let compile_result_module_count = std::func(result: CompileResult) -> i32 {
    return result.module_count;
}

@export
let compile_result_diagnostic_count = std::func(
    result: CompileResult) -> i32 {
    let diagnostics: M11DiagnosticStore = result.diagnostics;
    return m11_diagnostics_count(diagnostics);
}

@export
let compile_result_diagnostic_code = std::func(
    result: CompileResult, index: i32) -> i32 {
    let diagnostics: M11DiagnosticStore = result.diagnostics;
    return m11_diagnostics_code(diagnostics, index);
}

@export
let compile_result_diagnostic_message = std::func(
    result: CompileResult, index: i32) -> addr {
    let diagnostics: M11DiagnosticStore = result.diagnostics;
    return m11_diagnostics_message(diagnostics, index);
}

@export
let compile_result_diagnostic_start = std::func(
    result: CompileResult, index: i32) -> i32 {
    let diagnostics: M11DiagnosticStore = result.diagnostics;
    return m11_diagnostics_start(diagnostics, index);
}

@export
let compile_result_diagnostic_end = std::func(
    result: CompileResult, index: i32) -> i32 {
    let diagnostics: M11DiagnosticStore = result.diagnostics;
    return m11_diagnostics_end(diagnostics, index);
}

@export
let compiler_context_schema_version = std::func() -> i32 { return 1; }

// Exercises growth past the old four-diagnostic ceiling, shadowing, scope
// truncation, module/type tables, and owned message lifetime.
@export
let compiler_context_runtime_probe = std::func() -> i32 {
    let context0: CompilerContext = compiler_context_new(7, 99);
    let context1: CompilerContext = compiler_context_add_module(
        context0, "math", 40);
    let context2: CompilerContext = compiler_context_add_type(
        context1, "i32", 2);
    let module_value: i32 = m11_symbol_table_find(context2.modules, "math");
    let type_value: i32 = m11_symbol_table_find(context2.types, "i32");
    let scopes0: M11ScopeStack = m11_scope_enter(context2.scopes);
    let scopes1: M11ScopeStack = m11_scope_bind(scopes0, "x", 2);
    let inner0: M11ScopeStack = m11_scope_enter(scopes1);
    let inner1: M11ScopeStack = m11_scope_bind(inner0, "x", 3);
    let inner_value: i32 = m11_scope_lookup(inner1, "x");
    let outer: M11ScopeStack = m11_scope_exit(inner1);
    let outer_value: i32 = m11_scope_lookup(outer, "x");
    let context3: CompilerContext = CompilerContext {
        syntax_root: context2.syntax_root,
        source_length: context2.source_length,
        phase: context2.phase, unit: context2.unit,
        modules: context2.modules, types: context2.types,
        type_kinds: context2.type_kinds,
        type_arguments: context2.type_arguments,
        type_owners: context2.type_owners,
        scopes: outer, diagnostics: context2.diagnostics,
    };
    let context4: CompilerContext = compiler_context_add_diagnostic(
        context3, 1001, "d1", 1, 0, 1);
    let context5: CompilerContext = compiler_context_add_diagnostic(
        context4, 1002, "d2", 2, 1, 2);
    let context6: CompilerContext = compiler_context_add_diagnostic(
        context5, 1003, "d3", 3, 2, 3);
    let context7: CompilerContext = compiler_context_add_diagnostic(
        context6, 1004, "d4", 4, 3, 4);
    let context8: CompilerContext = compiler_context_add_diagnostic(
        context7, 1005, "d5", 5, 4, 5);
    let context9: CompilerContext = compiler_context_add_diagnostic(
        context8, 1006, "d6", 6, 5, 6);
    let result: CompileResult = compiler_context_finish(context9);
    let count: i32 = m11_diagnostics_count(result.diagnostics);
    let last: i32 = m11_diagnostics_code(result.diagnostics, 5);
    let destroyed: i32 = compile_result_destroy(result);
    if inner_value != 3 { return 301; }
    if outer_value != 2 { return 302; }
    if count != 6 { return 303; }
    if last != 1006 { return 304; }
    if destroyed != 1 { return 305; }
    if module_value != 40 { return 306; }
    return type_value + 40;
}
