// Lain-owned enum Meta library.
//
// RawAst only exposes the ordinary `let Name = std::enum(...) { ... }`
// topology.  This module validates that form, interns nominal and specialized
// TypeValues in CompilerContext, and computes the deterministic physical
// tag/payload layout consumed by later constructor and match lowering.

let syntax = import("packages::lain::compiler::syntax");
let surface_forms = import("packages::lain::compiler::surface_forms");
let types = import("packages::lain::compiler::types");
let compiler_context = import("packages::lain::compiler::compiler_context");

@export
let EnumRegistration: type = std::struct {
    context: CompilerContext,
    diagnostic: i32,
    node: i32,
}

@export
let EnumLayout: type = std::struct {
    tag_bits: i32,
    payload_size: i32,
    payload_align: i32,
    payload_offset: i32,
    size: i32,
    align: i32,
    ok: i32,
}

let enum_registration_ok = std::func(
    context: CompilerContext) -> EnumRegistration {
    return EnumRegistration {
        context: context, diagnostic: 0, node: 0,
    };
}

let enum_registration_error = std::func(
    context: CompilerContext, diagnostic: i32,
    node: i32) -> EnumRegistration {
    return EnumRegistration {
        context: context, diagnostic: diagnostic, node: node,
    };
}

let enum_is_separator = std::func(node: i32) -> i32 {
    if syntax_is_atom_text(node, ",") == 1 { return 1; }
    if syntax_is_atom_text(node, ";") == 1 { return 1; }
    return 0;
}

let enum_type_syntax_is_valid = std::func(node: i32) -> i32 {
    if syntax_is_identifier(node) == 1 { return 1; }
    if syntax_is_call(node) != 1 { return 0; }
    if syntax_call_namespace(node) != 0 { return 0; }
    if syntax_is_identifier(syntax_call_callee(node)) != 1 { return 0; }
    let argument: i32 = syntax_call_first_arg(node);
    if syntax_arg_count(argument) != 1 { return 0; }
    return enum_type_syntax_is_valid(argument);
}

let enum_param_diagnostic = std::func(declaration: i32) -> i32 {
    let param: i32 = syntax_enum_first_param(declaration);
    if param == 0 { return 0; }
    if syntax_arg_count(param) != 1 { return 3001; }
    if syntax_is_infix(param, ":") != 1 { return 3001; }
    if syntax_is_identifier(syntax_param_name_node(param)) != 1 {
        return 3001;
    }
    if syntax_path_tail_is(syntax_param_type_node(param), "type") != 1 {
        return 3001;
    }
    return 0;
}

let enum_variant_name_precedes = std::func(
    variant: i32, stop: i32, name_node: i32) -> i32 {
    if variant == 0 { return 0; }
    if variant == stop { return 0; }
    if enum_is_separator(variant) != 1 {
        let old_name: i32 = syntax_enum_variant_name_node(variant);
        if old_name != 0 {
            if syntax_identifier_equal(old_name, name_node) == 1 {
                return 1;
            }
        }
    }
    return enum_variant_name_precedes(
        syntax_next(variant), stop, name_node);
}

let enum_validate_variants = std::func(
    first: i32, variant: i32, count: i32) -> i32 {
    if variant == 0 {
        if count == 0 { return 3001; }
        return 0;
    }
    if enum_is_separator(variant) == 1 {
        return enum_validate_variants(
            first, syntax_next(variant), count);
    }
    let name_node: i32 = syntax_enum_variant_name_node(variant);
    if name_node == 0 { return 3001; }
    if enum_variant_name_precedes(first, variant, name_node) == 1 {
        return 3002;
    }
    if syntax_enum_variant_is_payload(variant) == 1 {
        let payload: i32 = syntax_enum_variant_payload(variant);
        if syntax_arg_count(payload) != 1 { return 3003; }
        if enum_type_syntax_is_valid(payload) != 1 { return 3003; }
    }
    return enum_validate_variants(
        first, syntax_next(variant), count + 1);
}

@export
let enum_declaration_diagnostic = std::func(
    declaration: i32) -> i32 {
    if syntax_is_enum_declaration(declaration) != 1 { return 3001; }
    if syntax_is_identifier(
        syntax_enum_name_node(declaration)) != 1 { return 3001; }
    let param_code: i32 = enum_param_diagnostic(declaration);
    if param_code != 0 { return param_code; }
    let first: i32 = syntax_enum_first_variant(declaration);
    return enum_validate_variants(first, first, 0);
}

let enum_register_definitions = std::func(
    context: CompilerContext, item: i32) -> EnumRegistration {
    if item == 0 { return enum_registration_ok(context); }
    if surface_binding_is_enum(item) != 1 {
        return enum_register_definitions(
            context, surface_next_item(item));
    }
    let code: i32 = enum_declaration_diagnostic(item);
    if code != 0 {
        return enum_registration_error(context, code, item);
    }
    let name_node: i32 = syntax_enum_name_node(item);
    let name: addr = syntax_text(name_node);
    if compiler_context_type_id(context, name) != 0 {
        return enum_registration_error(context, 3001, name_node);
    }
    let interned: TypeInternResult = compiler_context_intern_type(
        context, name, type_kind_nominal(), 0, item);
    return enum_register_definitions(
        interned.context, surface_next_item(item));
}

let enum_specialization_name = std::func(
    base: addr, argument: addr) -> addr {
    return syntax_text_append(
        syntax_text_append(base, "__T_"), argument);
}

let enum_maybe_register_application = std::func(
    context: CompilerContext, node: i32) -> EnumRegistration {
    if syntax_is_call(node) != 1 {
        return enum_registration_ok(context);
    }
    if syntax_call_namespace(node) != 0 {
        return enum_registration_ok(context);
    }
    let callee: i32 = syntax_call_callee(node);
    if syntax_is_identifier(callee) != 1 {
        return enum_registration_ok(context);
    }
    let owner_id: i32 = compiler_context_type_id(
        context, syntax_text(callee));
    if owner_id == 0 { return enum_registration_ok(context); }
    let owner: TypeValue = compiler_context_type_value(context, owner_id);
    if owner.kind != type_kind_nominal() {
        return enum_registration_ok(context);
    }
    let argument: i32 = syntax_call_first_arg(node);
    if syntax_arg_count(argument) != 1 {
        return enum_registration_error(context, 2812, node);
    }
    if syntax_is_identifier(argument) != 1 {
        return enum_registration_error(context, 2810, argument);
    }
    let argument_id: i32 = compiler_context_type_id(
        context, syntax_text(argument));
    // An unresolved identifier may be the declaration's compile-time type
    // parameter.  Its concrete TypeId is registered when the surrounding
    // callable is specialized.
    if argument_id == 0 { return enum_registration_ok(context); }
    let specialized_name: addr = enum_specialization_name(
        syntax_text(callee), syntax_text(argument));
    let interned: TypeInternResult = compiler_context_intern_type(
        context, specialized_name, type_kind_specialized(),
        argument_id, owner_id);
    return enum_registration_ok(interned.context);
}

let enum_register_type_syntax = std::func(
    context: CompilerContext, node: i32) -> EnumRegistration {
    if node == 0 { return enum_registration_ok(context); }
    let current: EnumRegistration =
        enum_maybe_register_application(context, node);
    if current.diagnostic != 0 { return current; }
    if syntax_is_call(node) != 1 { return current; }
    return enum_register_type_syntax(
        current.context, syntax_call_first_arg(node));
}

let enum_register_param_types = std::func(
    context: CompilerContext, param: i32) -> EnumRegistration {
    if param == 0 { return enum_registration_ok(context); }
    let current: EnumRegistration = enum_register_type_syntax(
        context, syntax_param_type_node(param));
    if current.diagnostic != 0 { return current; }
    return enum_register_param_types(
        current.context, syntax_param_next(param));
}

let enum_register_variant_types = std::func(
    context: CompilerContext, variant: i32) -> EnumRegistration {
    if variant == 0 { return enum_registration_ok(context); }
    if enum_is_separator(variant) == 1 {
        return enum_register_variant_types(
            context, syntax_next(variant));
    }
    let current: EnumRegistration = enum_register_type_syntax(
        context, syntax_enum_variant_payload(variant));
    if current.diagnostic != 0 { return current; }
    return enum_register_variant_types(
        current.context, syntax_next(variant));
}

let enum_register_body_types = std::func(
    context: CompilerContext, form: i32) -> EnumRegistration {
    if form == 0 { return enum_registration_ok(context); }
    let tag: i32 = syntax_form_tag(form);
    if tag == 2 {
        let local: EnumRegistration = enum_register_type_syntax(
            context, syntax_local_type_node(form));
        if local.diagnostic != 0 { return local; }
        return enum_register_body_types(
            local.context, syntax_next(form));
    }
    if tag == 5 {
        let nested: EnumRegistration = enum_register_body_types(
            context, syntax_left(syntax_if_statement_body(form)));
        if nested.diagnostic != 0 { return nested; }
        return enum_register_body_types(
            nested.context, syntax_next(form));
    }
    return enum_register_body_types(context, syntax_next(form));
}

let enum_register_item_types = std::func(
    context: CompilerContext, item: i32) -> EnumRegistration {
    if item == 0 { return enum_registration_ok(context); }
    let expected: EnumRegistration = enum_register_type_syntax(
        context, surface_binding_expected(item));
    if expected.diagnostic != 0 { return expected; }
    if surface_binding_is_func(item) == 1 {
        let params: EnumRegistration = enum_register_param_types(
            expected.context, syntax_function_first_param(item));
        if params.diagnostic != 0 { return params; }
        let returns: EnumRegistration = enum_register_type_syntax(
            params.context,
            syntax_right(syntax_function_signature(item)));
        if returns.diagnostic != 0 { return returns; }
        let body: EnumRegistration = enum_register_body_types(
            returns.context,
            syntax_left(syntax_function_body(item)));
        if body.diagnostic != 0 { return body; }
        return enum_register_item_types(
            body.context, surface_next_item(item));
    }
    if surface_binding_is_enum(item) == 1 {
        let variants: EnumRegistration = enum_register_variant_types(
            expected.context, syntax_enum_first_variant(item));
        if variants.diagnostic != 0 { return variants; }
        return enum_register_item_types(
            variants.context, surface_next_item(item));
    }
    return enum_register_item_types(
        expected.context, surface_next_item(item));
}

@export
let enum_register_program = std::func(
    context: CompilerContext, root: i32) -> EnumRegistration {
    let definitions: EnumRegistration = enum_register_definitions(
        context, surface_first_item(root));
    if definitions.diagnostic != 0 { return definitions; }
    return enum_register_item_types(
        definitions.context, surface_first_item(root));
}

let enum_variant_count = std::func(variant: i32) -> i32 {
    if variant == 0 { return 0; }
    if enum_is_separator(variant) == 1 {
        return enum_variant_count(syntax_next(variant));
    }
    return 1 + enum_variant_count(syntax_next(variant));
}

let enum_tag_bits_for_count = std::func(count: i32) -> i32 {
    if count <= 2 { return 1; }
    if count <= 4 { return 2; }
    if count <= 16 { return 4; }
    if count <= 256 { return 8; }
    if count <= 65536 { return 16; }
    return 32;
}

let enum_physical_size = std::func(type_id: i32) -> i32 {
    if type_id == type_i32() { return 4; }
    if type_id == type_bool() { return 4; }
    if type_id == type_addr() { return 8; }
    if type_id == type_type() { return 4; }
    return 8;
}

let enum_physical_align = std::func(type_id: i32) -> i32 {
    if type_id == type_addr() { return 8; }
    return 4;
}

let enum_declaration_param_name = std::func(
    declaration: i32) -> addr {
    let param: i32 = syntax_enum_first_param(declaration);
    if param == 0 { return ""; }
    return syntax_text(syntax_param_name_node(param));
}

let enum_payload_type_id = std::func(
    context: CompilerContext, declaration: i32,
    payload: i32, argument_id: i32) -> i32 {
    if payload == 0 { return 0; }
    if syntax_is_identifier(payload) != 1 { return type_addr(); }
    if syntax_text_equal(
        syntax_text(payload),
        enum_declaration_param_name(declaration)) == 1 {
        return argument_id;
    }
    return compiler_context_type_id(context, syntax_text(payload));
}

let enum_max_payload_size = std::func(
    context: CompilerContext, declaration: i32,
    variant: i32, argument_id: i32, maximum: i32) -> i32 {
    if variant == 0 { return maximum; }
    if enum_is_separator(variant) == 1 {
        return enum_max_payload_size(
            context, declaration, syntax_next(variant),
            argument_id, maximum);
    }
    let type_id: i32 = enum_payload_type_id(
        context, declaration,
        syntax_enum_variant_payload(variant), argument_id);
    let size: i32 = enum_physical_size(type_id);
    if syntax_enum_variant_is_payload(variant) != 1 {
        return enum_max_payload_size(
            context, declaration, syntax_next(variant),
            argument_id, maximum);
    }
    if size > maximum {
        return enum_max_payload_size(
            context, declaration, syntax_next(variant),
            argument_id, size);
    }
    return enum_max_payload_size(
        context, declaration, syntax_next(variant),
        argument_id, maximum);
}

let enum_max_payload_align = std::func(
    context: CompilerContext, declaration: i32,
    variant: i32, argument_id: i32, maximum: i32) -> i32 {
    if variant == 0 { return maximum; }
    if enum_is_separator(variant) == 1 {
        return enum_max_payload_align(
            context, declaration, syntax_next(variant),
            argument_id, maximum);
    }
    if syntax_enum_variant_is_payload(variant) != 1 {
        return enum_max_payload_align(
            context, declaration, syntax_next(variant),
            argument_id, maximum);
    }
    let type_id: i32 = enum_payload_type_id(
        context, declaration,
        syntax_enum_variant_payload(variant), argument_id);
    let align: i32 = enum_physical_align(type_id);
    if align > maximum {
        return enum_max_payload_align(
            context, declaration, syntax_next(variant),
            argument_id, align);
    }
    return enum_max_payload_align(
        context, declaration, syntax_next(variant),
        argument_id, maximum);
}

let enum_layout_error = std::func() -> EnumLayout {
    return EnumLayout {
        tag_bits: 0, payload_size: 0, payload_align: 0,
        payload_offset: 0, size: 0, align: 0, ok: 0,
    };
}

@export
let enum_layout = std::func(
    context: CompilerContext, type_id: i32) -> EnumLayout {
    let value: TypeValue = compiler_context_type_value(context, type_id);
    if value.kind == type_kind_specialized() {
        let declaration_value: TypeValue =
            compiler_context_type_value(context, value.owner);
        if declaration_value.kind != type_kind_nominal() {
            return enum_layout_error();
        }
        let declaration: i32 = declaration_value.owner;
        let first: i32 = syntax_enum_first_variant(declaration);
        let count: i32 = enum_variant_count(first);
        let payload_size: i32 = enum_max_payload_size(
            context, declaration, first, value.argument, 0);
        let payload_align: i32 = enum_max_payload_align(
            context, declaration, first, value.argument, 1);
        let payload_offset: i32 = payload_align;
        if payload_size == 0 {
            return EnumLayout {
                tag_bits: enum_tag_bits_for_count(count),
                payload_size: 0, payload_align: 1,
                payload_offset: 0, size: 1, align: 1, ok: 1,
            };
        }
        let total_size: i32 = payload_offset + payload_size;
        return EnumLayout {
            tag_bits: enum_tag_bits_for_count(count),
            payload_size: payload_size, payload_align: payload_align,
            payload_offset: payload_offset,
            size: total_size,
            align: payload_align, ok: 1,
        };
    }
    if value.kind != type_kind_nominal() { return enum_layout_error(); }
    let declaration: i32 = value.owner;
    if syntax_enum_first_param(declaration) != 0 {
        return enum_layout_error();
    }
    let first: i32 = syntax_enum_first_variant(declaration);
    let count: i32 = enum_variant_count(first);
    let payload_size: i32 = enum_max_payload_size(
        context, declaration, first, 0, 0);
    let payload_align: i32 = enum_max_payload_align(
        context, declaration, first, 0, 1);
    if payload_size == 0 {
        return EnumLayout {
            tag_bits: enum_tag_bits_for_count(count),
            payload_size: 0, payload_align: 1,
            payload_offset: 0, size: 1, align: 1, ok: 1,
        };
    }
    let total_size: i32 = payload_align + payload_size;
    return EnumLayout {
        tag_bits: enum_tag_bits_for_count(count),
        payload_size: payload_size, payload_align: payload_align,
        payload_offset: payload_align,
        size: total_size,
        align: payload_align, ok: 1,
    };
}

// Executable contract used by the self-hosting gate.  It exercises the
// complete parser -> enum registration -> TypeValue -> layout path inside the
// compiler artifact while the native launcher supplies the normal compiler
// capability allowlist.
@export
let enum_layout_contract = std::func() -> i32 {
    let source: addr = "let Option = std::enum(T: type) { None, Some(T), }; let use = std::func(value: Option(i32)) -> Option(i32) { return value; }; let main = std::func() -> i32 { return 42; };";
    let root: i32 = syntax_parse(source, syntax_text_length(source));
    let context: CompilerContext = compiler_context_new(
        root, syntax_text_length(source));
    let registration: EnumRegistration = enum_register_program(
        context, root);
    if registration.diagnostic != 0 {
        let failed: CompileResult = compiler_context_finish(
            registration.context);
        let destroyed: i32 = compile_result_destroy(failed);
        return 301;
    }
    let type_id: i32 = compiler_context_type_id(
        registration.context, "Option__T_i32");
    let layout: EnumLayout = enum_layout(registration.context, type_id);
    let result: CompileResult = compiler_context_finish(
        registration.context);
    let destroyed: i32 = compile_result_destroy(result);
    if type_id == 0 { return 302; }
    if layout.ok != 1 { return 303; }
    if layout.tag_bits != 1 { return 304; }
    if layout.payload_size != 4 { return 305; }
    if layout.payload_offset != 4 { return 306; }
    if layout.size != 8 { return 307; }
    if layout.align != 4 { return 308; }
    return 42;
}
