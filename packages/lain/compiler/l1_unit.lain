import packages::lain::compiler::l1_procedure;

struct L1Unit { procedure_count: i32, entry_name: i32, entry_instruction_count: i32, entry_score: i32, kind: i32, left: i32, right: i32 }

@foreign(c, link_name = "core.string-append!")
fn string_append(left: addr, right: addr) -> addr;

@foreign(c, link_name = "core.i32-to-string!")
fn i32_to_string(value: i32) -> addr;

fn emit_return_i32(value: i32) -> addr {
    let prefix: addr = "#proc main() -> i32 { #return ";
    let suffix: addr = " }";
    return string_append(string_append(prefix, i32_to_string(value)), suffix);
}

fn emit_add_i32(left: i32, right: i32) -> addr {
    let prefix: addr = "#proc main() -> i32 { %result = #add(";
    let middle: addr = ", ";
    let suffix: addr = ") #return %result }";
    return string_append(
        string_append(
            string_append(string_append(prefix, i32_to_string(left)), middle),
            i32_to_string(right)),
        suffix);
}

fn l1_unit_return_42(name: i32) -> L1Unit {
    return L1Unit { procedure_count: 1, entry_name: name, entry_instruction_count: 1, entry_score: l1_procedure_return_score(name, 42), kind: 1, left: 42, right: 0 };
}

fn l1_unit_add_40_2(name: i32) -> L1Unit {
    return L1Unit { procedure_count: 1, entry_name: name, entry_instruction_count: 2, entry_score: l1_procedure_add_score(name, 40, 2), kind: 2, left: 40, right: 2 };
}

pub fn l1_unit_return_42_text() -> addr {
    // Text emission is a narrow view of the L1Unit model.  It must not force
    // construction of the metadata-only procedure/region score graph: that
    // graph is useful to Lain-side model tests, but irrelevant to the emitted
    // `#return 42` program and unnecessarily widens the bootstrap link set.
    return emit_return_i32(42);
}

pub fn l1_unit_add_40_2_text() -> addr {
    return emit_add_i32(40, 2);
}

pub fn l1_unit_return_42_score(name: i32) -> i32 {
    let unit: L1Unit = l1_unit_return_42(name);
    return unit.procedure_count + unit.entry_name + unit.entry_instruction_count + unit.entry_score;
}

pub fn l1_unit_add_40_2_score(name: i32) -> i32 {
    let unit: L1Unit = l1_unit_add_40_2(name);
    return unit.procedure_count + unit.entry_name + unit.entry_instruction_count + unit.entry_score;
}

pub fn l1_unit_return_42_instruction_count(name: i32) -> i32 {
    let unit: L1Unit = l1_unit_return_42(name);
    return unit.entry_instruction_count;
}

pub fn l1_unit_add_40_2_instruction_count(name: i32) -> i32 {
    let unit: L1Unit = l1_unit_add_40_2(name);
    return unit.entry_instruction_count;
}
