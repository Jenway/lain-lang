// Lain-owned generated syntax policy over the topology-only arena substrate.
//
// Construction is mutable only inside an open builder.  `seal` publishes an
// immutable SyntaxList whose opaque root is accepted by ordinary syntax
// readers.  Raw parser arenas remain read-only.

let syntax = import("packages::lain::compiler::syntax");

@foreign(c, link_name = "ast.store-new!")
let generated_host_store_new = std::func() -> i32;
@foreign(c, link_name = "ast.store-destroy!")
let generated_host_store_destroy = std::func(store: i32) -> i32;
@foreign(c, link_name = "ast.unit-new-generated!")
let generated_host_unit_new = std::func(store: i32) -> i32;
@foreign(c, link_name = "ast.unit-atom!")
let generated_host_atom = std::func(
    store: i32, unit: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.unit-node!")
let generated_host_node = std::func(
    store: i32, unit: i32, kind: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-left!")
let generated_host_set_left = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-right!")
let generated_host_set_right = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-op!")
let generated_host_set_op = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-origin!")
let generated_host_set_origin = std::func(
    store: i32, unit: i32, node: i32, source: i32) -> i32;
@foreign(c, link_name = "ast.unit-append!")
let generated_host_append = std::func(
    store: i32, unit: i32, node: i32, next: i32) -> i32;
@foreign(c, link_name = "ast.unit-clone!")
let generated_host_clone = std::func(
    store: i32, unit: i32, source: i32) -> i32;
@foreign(c, link_name = "ast.unit-seal!")
let generated_host_seal = std::func(
    store: i32, unit: i32, root: i32) -> i32;

@export
let MetaContext: type = std::struct {
    expansion_id: i32,
    call_site_origin: i32,
    hygiene_context: i32,
    environment: i32,
}

@export
let MetaInvocation: type = std::struct {
    attribute_syntax: i32,
    attribute_arguments: i32,
    target_syntax: i32,
}

@export
let GeneratedSyntaxStore: type = std::struct {
    store: i32,
    unit: i32,
    expansion_id: i32,
    origin: i32,
    hygiene_context: i32,
    sealed: i32,
    ok: i32,
}

@export
let SyntaxList: type = std::struct {
    store: i32,
    unit: i32,
    root: i32,
    count: i32,
    expansion_id: i32,
    origin: i32,
    hygiene_context: i32,
    ok: i32,
}

@export
let generated_syntax_new = std::func(
    expansion_id: i32, origin: i32,
    hygiene_context: i32) -> GeneratedSyntaxStore {
    let store: i32 = generated_host_store_new();
    if store == 0 {
        return GeneratedSyntaxStore {
            store: 0, unit: 0, expansion_id: expansion_id,
            origin: origin, hygiene_context: hygiene_context,
            sealed: 0, ok: 0,
        };
    }
    let unit: i32 = generated_host_unit_new(store);
    if unit == 0 {
        let destroyed: i32 = generated_host_store_destroy(store);
        return GeneratedSyntaxStore {
            store: 0, unit: 0, expansion_id: expansion_id,
            origin: origin, hygiene_context: hygiene_context,
            sealed: 0, ok: 0,
        };
    }
    return GeneratedSyntaxStore {
        store: store, unit: unit, expansion_id: expansion_id,
        origin: origin, hygiene_context: hygiene_context,
        sealed: 0, ok: 1,
    };
}

@export
let generated_syntax_atom = std::func(
    builder: GeneratedSyntaxStore, text: addr) -> i32 {
    if builder.ok != 1 { return 0; }
    if builder.sealed != 0 { return 0; }
    let node: i32 = generated_host_atom(builder.store, builder.unit, text);
    if node == 0 { return 0; }
    if builder.origin != 0 {
        if generated_host_set_origin(
            builder.store, builder.unit, node, builder.origin) != 1 {
            return 0;
        }
    }
    return node;
}

@export
let generated_syntax_node = std::func(
    builder: GeneratedSyntaxStore, kind: i32,
    left: i32, right: i32, op: i32) -> i32 {
    if builder.ok != 1 { return 0; }
    if builder.sealed != 0 { return 0; }
    let node: i32 = generated_host_node(
        builder.store, builder.unit, kind);
    if node == 0 { return 0; }
    if left != 0 {
        if generated_host_set_left(
            builder.store, builder.unit, node, left) != 1 { return 0; }
    }
    if right != 0 {
        if generated_host_set_right(
            builder.store, builder.unit, node, right) != 1 { return 0; }
    }
    if op != 0 {
        if generated_host_set_op(
            builder.store, builder.unit, node, op) != 1 { return 0; }
    }
    if builder.origin != 0 {
        if generated_host_set_origin(
            builder.store, builder.unit, node, builder.origin) != 1 {
            return 0;
        }
    }
    return node;
}

@export
let generated_syntax_group = std::func(
    builder: GeneratedSyntaxStore, delimiter: addr,
    first: i32) -> i32 {
    let op: i32 = generated_syntax_atom(builder, delimiter);
    if op == 0 { return 0; }
    return generated_syntax_node(builder, 4, first, 0, op);
}

@export
let generated_syntax_prefix = std::func(
    builder: GeneratedSyntaxStore, operator: addr,
    operand: i32) -> i32 {
    let op: i32 = generated_syntax_atom(builder, operator);
    if op == 0 { return 0; }
    return generated_syntax_node(builder, 2, operand, 0, op);
}

@export
let generated_syntax_postfix = std::func(
    builder: GeneratedSyntaxStore, operand: i32,
    operator: addr) -> i32 {
    let op: i32 = generated_syntax_atom(builder, operator);
    if op == 0 { return 0; }
    return generated_syntax_node(builder, 3, operand, 0, op);
}

@export
let generated_syntax_infix = std::func(
    builder: GeneratedSyntaxStore, operator: addr,
    left: i32, right: i32) -> i32 {
    let op: i32 = generated_syntax_atom(builder, operator);
    if op == 0 { return 0; }
    return generated_syntax_node(builder, 1, left, right, op);
}

@export
let generated_syntax_append = std::func(
    builder: GeneratedSyntaxStore, node: i32, next: i32) -> i32 {
    if builder.ok != 1 { return 0; }
    if builder.sealed != 0 { return 0; }
    return generated_host_append(builder.store, builder.unit, node, next);
}

@export
let generated_syntax_set_first = std::func(
    builder: GeneratedSyntaxStore, group: i32, first: i32) -> i32 {
    if builder.ok != 1 { return 0; }
    if builder.sealed != 0 { return 0; }
    return generated_host_set_left(
        builder.store, builder.unit, group, first);
}

// clone is the explicit capture API: it preserves the call-site spelling and
// origin.  Fresh atoms built above belong to the expansion hygiene context.
@export
let generated_syntax_clone = std::func(
    builder: GeneratedSyntaxStore, source: i32) -> i32 {
    if builder.ok != 1 { return 0; }
    if builder.sealed != 0 { return 0; }
    return generated_host_clone(builder.store, builder.unit, source);
}

@export
let generated_syntax_seal = std::func(
    builder: GeneratedSyntaxStore, root: i32,
    count: i32) -> SyntaxList {
    if builder.ok != 1 {
        return SyntaxList {
            store: builder.store, unit: builder.unit, root: 0, count: 0,
            expansion_id: builder.expansion_id, origin: builder.origin,
            hygiene_context: builder.hygiene_context, ok: 0,
        };
    }
    let stable_root: i32 = generated_host_seal(
        builder.store, builder.unit, root);
    if stable_root == 0 {
        return SyntaxList {
            store: builder.store, unit: builder.unit, root: 0, count: 0,
            expansion_id: builder.expansion_id, origin: builder.origin,
            hygiene_context: builder.hygiene_context, ok: 0,
        };
    }
    return SyntaxList {
        store: builder.store, unit: builder.unit,
        root: stable_root, count: count,
        expansion_id: builder.expansion_id, origin: builder.origin,
        hygiene_context: builder.hygiene_context, ok: 1,
    };
}

@export
let generated_syntax_destroy = std::func(list: SyntaxList) -> i32 {
    return generated_host_store_destroy(list.store);
}
