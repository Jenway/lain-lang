// Type objects for the M4 Lain-owned Meta domain.

@export

let mini_type_error = std::func() -> i32 { return 0; }
@export
let mini_type_i32 = std::func() -> i32 { return 1; }
@export
let mini_type_bool = std::func() -> i32 { return 2; }
@export
let mini_type_addr = std::func() -> i32 { return 3; }
@export
let mini_type_unit = std::func() -> i32 { return 4; }
@export
let mini_type_type = std::func() -> i32 { return 5; }
@export
let mini_type_module = std::func() -> i32 { return 6; }
@export
let mini_type_callable = std::func() -> i32 { return 7; }

// Stable phase tags carried by resolved callables.  Surface spelling does
// not select evaluation behavior; Meta resolution assigns one of these tags.
@export
let mini_callable_phase_meta = std::func() -> i32 { return 1; }
@export
let mini_callable_phase_comptime = std::func() -> i32 { return 2; }
@export
let mini_callable_phase_runtime = std::func() -> i32 { return 3; }

@export

let mini_callable_phase_valid = std::func(phase: i32) -> i32 {
    if phase == mini_callable_phase_meta() { return 1; }
    if phase == mini_callable_phase_comptime() { return 1; }
    if phase == mini_callable_phase_runtime() { return 1; }
    return 0;
}

@export

let mini_type_same = std::func(left: i32, right: i32) -> i32 {
    if left == right { return 1; }
    return 0;
}
