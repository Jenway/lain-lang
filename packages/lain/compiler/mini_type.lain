// Type objects for the M4 Lain-owned Meta domain.

pub fn mini_type_error() -> i32 { return 0; }
pub fn mini_type_i32() -> i32 { return 1; }
pub fn mini_type_bool() -> i32 { return 2; }
pub fn mini_type_addr() -> i32 { return 3; }

pub fn mini_type_same(left: i32, right: i32) -> i32 {
    if left == right { return 1; }
    return 0;
}
