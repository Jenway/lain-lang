import packages::lain::compiler::module_ast_summary;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

pub fn module_ast_score_summary(base_score: i32, root: AstSexpr, pub_symbol: i32, fn_symbol: i32, type_symbol: i32) -> i32 {
    let count: i32 = module_ast_summary_pub_fn_count(root, pub_symbol, fn_symbol);
    return base_score + count + type_symbol;
}
