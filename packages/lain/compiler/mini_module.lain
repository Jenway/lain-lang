// Meta-owned callable summary for one M4 source closure.

import packages::lain::compiler::mini_syntax;
import packages::lain::compiler::mini_middle;

pub fn mini_module_first_procedure(root: i32) -> i32 {
    return mini_middle_first_definition(root);
}

pub fn mini_module_procedure_count(root: i32) -> i32 {
    return mini_middle_definition_count(mini_middle_first_definition(root));
}

pub fn mini_module_procedure_name_count(root: i32, name: addr) -> i32 {
    return mini_middle_callable_name_count(mini_middle_first_callable(root), name);
}

pub fn mini_module_find_procedure(root: i32, name: addr) -> i32 {
    return mini_middle_find_callable(mini_middle_first_callable(root), name);
}

pub fn mini_module_has_procedure(root: i32, name: addr) -> i32 {
    if mini_module_find_procedure(root, name) != 0 { return 1; }
    return 0;
}

// Cross-source dependency resolution remains an M5 concern.  M4 nevertheless
// exposes the field so callers do not infer module policy from RawAst.
pub fn mini_module_dependency_count(root: i32) -> i32 {
    if root == 0 { return 0; }
    return 0;
}
