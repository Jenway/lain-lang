// Meta-owned callable summaries plus M5 ModuleValue/ModuleSummary views.
// A module is a canonical let binding whose initializer is `module`; require
// is another let initializer.  No module/import policy exists in RawAst or L1.

import packages::lain::compiler::mini_syntax;
import packages::lain::compiler::mini_middle;
import packages::lain::compiler::compiler_context;

// A multi-source workspace cannot use RawAst sibling links to cross source
// unit boundaries.  This index is Meta-owned; its node values are stable
// opaque syntax handles supplied by the reader store.
pub struct ModuleWorkspace {
    modules: M11I32Vec,
    source_indices: M11I32Vec,
    order: M11I32Vec,
    diagnostic: i32,
    diagnostic_index: i32,
}

pub fn module_workspace_new() -> ModuleWorkspace {
    return ModuleWorkspace {
        modules: m11_i32_vec_new(),
        source_indices: m11_i32_vec_new(),
        order: m11_i32_vec_new(),
        diagnostic: 0,
        diagnostic_index: 0,
    };
}

pub fn module_workspace_count(workspace: ModuleWorkspace) -> i32 {
    let modules: M11I32Vec = workspace.modules;
    return modules.len;
}

pub fn module_workspace_order_count(workspace: ModuleWorkspace) -> i32 {
    let order: M11I32Vec = workspace.order;
    return order.len;
}

pub fn module_workspace_module_at(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    return m11_i32_vec_get(workspace.modules, index);
}

pub fn module_workspace_source_index_at(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    return m11_i32_vec_get(workspace.source_indices, index);
}

pub fn module_workspace_name_at(
    workspace: ModuleWorkspace, index: i32) -> addr {
    return mini_module_summary_name(
        module_workspace_module_at(workspace, index));
}

pub fn module_workspace_dependency_count_at(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    return mini_module_summary_dependency_count(
        module_workspace_module_at(workspace, index));
}

pub fn module_workspace_export_count_at(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    return mini_module_summary_export_count(
        module_workspace_module_at(workspace, index));
}

pub fn module_workspace_push(
    workspace: ModuleWorkspace, module: i32,
    source_index: i32) -> ModuleWorkspace {
    let modules: M11I32Vec = m11_i32_vec_push(workspace.modules, module);
    let sources: M11I32Vec = m11_i32_vec_push(
        workspace.source_indices, source_index);
    if modules.ok == 0 {
        return ModuleWorkspace {
            modules: modules, source_indices: sources,
            order: workspace.order, diagnostic: 4304,
            diagnostic_index: source_index,
        };
    }
    if sources.ok == 0 {
        return ModuleWorkspace {
            modules: modules, source_indices: sources,
            order: workspace.order, diagnostic: 4304,
            diagnostic_index: source_index,
        };
    }
    return ModuleWorkspace {
        modules: modules, source_indices: sources,
        order: workspace.order, diagnostic: workspace.diagnostic,
        diagnostic_index: workspace.diagnostic_index,
    };
}

fn module_workspace_add_root_modules(
    workspace: ModuleWorkspace, module: i32,
    source_index: i32) -> ModuleWorkspace {
    if module == 0 { return workspace; }
    let next: ModuleWorkspace = module_workspace_push(
        workspace, module, source_index);
    return module_workspace_add_root_modules(
        next, mini_module_next_module(module), source_index);
}

// Compatibility adapter for the historical single-root workspace API.
pub fn module_workspace_from_root(root: i32) -> ModuleWorkspace {
    let workspace: ModuleWorkspace = module_workspace_add_root_modules(
        module_workspace_new(), mini_module_first_module(root), 0);
    return module_workspace_build_order(workspace);
}

fn module_workspace_name_count_from(
    workspace: ModuleWorkspace, name: addr, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    if mini_syntax_text_equal(
        module_workspace_name_at(workspace, index), name) == 1 {
        return 1 + module_workspace_name_count_from(
            workspace, name, index + 1);
    }
    return module_workspace_name_count_from(workspace, name, index + 1);
}

pub fn module_workspace_name_count(
    workspace: ModuleWorkspace, name: addr) -> i32 {
    return module_workspace_name_count_from(workspace, name, 0);
}

fn module_workspace_find_index_from(
    workspace: ModuleWorkspace, name: addr, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return -1; }
    if mini_syntax_text_equal(
        module_workspace_name_at(workspace, index), name) == 1 {
        return index;
    }
    return module_workspace_find_index_from(workspace, name, index + 1);
}

pub fn module_workspace_find_index(
    workspace: ModuleWorkspace, name: addr) -> i32 {
    return module_workspace_find_index_from(workspace, name, 0);
}

pub fn module_workspace_find(
    workspace: ModuleWorkspace, name: addr) -> i32 {
    let index: i32 = module_workspace_find_index(workspace, name);
    if index < 0 { return 0; }
    return module_workspace_module_at(workspace, index);
}

pub fn module_workspace_resolve_alias(
    workspace: ModuleWorkspace, module: i32, alias: addr) -> i32 {
    let request: i32 = mini_module_find_dependency_alias(module, alias);
    if request == 0 { return 0; }
    return module_workspace_find(
        workspace, mini_module_dependency_target_name(request));
}

pub fn mini_module_first_procedure(root: i32) -> i32 {
    return mini_middle_first_definition(root);
}

pub fn mini_module_procedure_count(root: i32) -> i32 {
    return mini_middle_definition_count(mini_middle_first_definition(root));
}

pub fn mini_module_procedure_name_count(root: i32, name: addr) -> i32 {
    return mini_middle_callable_name_count(mini_middle_first_callable(root), name);
}

pub fn mini_module_find_procedure(root: i32, name: addr) -> i32 {
    return mini_middle_find_callable(mini_middle_first_callable(root), name);
}

pub fn mini_module_has_procedure(root: i32, name: addr) -> i32 {
    if mini_module_find_procedure(root, name) != 0 { return 1; }
    return 0;
}

// Cross-source dependency resolution remains an M5 concern.  M4 nevertheless
// exposes the field so callers do not infer module policy from RawAst.
pub fn mini_module_dependency_count(root: i32) -> i32 {
    if root == 0 { return 0; }
    return 0;
}

pub fn mini_module_first_module_from(item: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_module_binding(item) == 1 { return item; }
    return mini_module_first_module_from(mini_middle_next_item(item));
}

pub fn mini_module_first_module(workspace: i32) -> i32 {
    return mini_module_first_module_from(mini_middle_first_item(workspace));
}

pub fn mini_module_next_module(module: i32) -> i32 {
    return mini_module_first_module_from(mini_middle_next_item(module));
}

pub fn mini_module_workspace_module_count_from(module: i32) -> i32 {
    if module == 0 { return 0; }
    return 1 + mini_module_workspace_module_count_from(
        mini_module_next_module(module));
}

pub fn mini_module_workspace_module_count(workspace: i32) -> i32 {
    return mini_module_workspace_module_count_from(
        mini_module_first_module(workspace));
}

pub fn mini_module_summary_name(module: i32) -> addr {
    return mini_middle_binding_name(module);
}

pub fn mini_module_body(module: i32) -> i32 {
    return mini_middle_binding_body(module);
}

pub fn mini_module_first_body_item(module: i32) -> i32 {
    return mini_syntax_left(mini_module_body(module));
}

pub fn mini_module_workspace_name_count_from(module: i32, name: addr) -> i32 {
    if module == 0 { return 0; }
    if mini_syntax_text_equal(mini_module_summary_name(module), name) == 1 {
        return 1 + mini_module_workspace_name_count_from(
            mini_module_next_module(module), name);
    }
    return mini_module_workspace_name_count_from(
        mini_module_next_module(module), name);
}

pub fn mini_module_workspace_name_count(workspace: i32, name: addr) -> i32 {
    return mini_module_workspace_name_count_from(
        mini_module_first_module(workspace), name);
}

pub fn mini_module_workspace_find_from(module: i32, name: addr) -> i32 {
    if module == 0 { return 0; }
    if mini_syntax_text_equal(mini_module_summary_name(module), name) == 1 {
        return module;
    }
    return mini_module_workspace_find_from(mini_module_next_module(module), name);
}

pub fn mini_module_workspace_find(workspace: i32, name: addr) -> i32 {
    return mini_module_workspace_find_from(mini_module_first_module(workspace), name);
}

pub fn mini_module_first_dependency_from(item: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_require_binding(item) == 1 { return item; }
    return mini_module_first_dependency_from(mini_middle_next_item(item));
}

pub fn mini_module_first_dependency(module: i32) -> i32 {
    return mini_module_first_dependency_from(mini_module_first_body_item(module));
}

pub fn mini_module_next_dependency(binding: i32) -> i32 {
    return mini_module_first_dependency_from(mini_middle_next_item(binding));
}

pub fn mini_module_dependency_target_node(binding: i32) -> i32 {
    let initializer: i32 = mini_middle_binding_initializer(binding);
    return mini_syntax_call_first_arg(initializer);
}

pub fn mini_module_dependency_target_name(binding: i32) -> addr {
    return mini_syntax_text(mini_module_dependency_target_node(binding));
}

pub fn mini_module_summary_dependency_count_from(binding: i32) -> i32 {
    if binding == 0 { return 0; }
    return 1 + mini_module_summary_dependency_count_from(
        mini_module_next_dependency(binding));
}

pub fn mini_module_summary_dependency_count(module: i32) -> i32 {
    return mini_module_summary_dependency_count_from(
        mini_module_first_dependency(module));
}

fn mini_module_dependency_binding_at_from(
    binding: i32, wanted: i32, index: i32) -> i32 {
    if binding == 0 { return 0; }
    if index == wanted { return binding; }
    return mini_module_dependency_binding_at_from(
        mini_module_next_dependency(binding), wanted, index + 1);
}

pub fn mini_module_summary_dependency_name_at(
    module: i32, index: i32) -> addr {
    let binding: i32 = mini_module_dependency_binding_at_from(
        mini_module_first_dependency(module), index, 0);
    if binding == 0 { return ""; }
    return mini_module_dependency_target_name(binding);
}

pub fn mini_module_workspace_dependency_count_from(module: i32) -> i32 {
    if module == 0 { return 0; }
    return mini_module_summary_dependency_count(module) +
        mini_module_workspace_dependency_count_from(mini_module_next_module(module));
}

pub fn mini_module_workspace_dependency_count(workspace: i32) -> i32 {
    return mini_module_workspace_dependency_count_from(
        mini_module_first_module(workspace));
}

pub fn mini_module_find_dependency_alias_from(binding: i32, alias: addr) -> i32 {
    if binding == 0 { return 0; }
    if mini_syntax_text_equal(mini_middle_binding_name(binding), alias) == 1 {
        return binding;
    }
    return mini_module_find_dependency_alias_from(
        mini_module_next_dependency(binding), alias);
}

pub fn mini_module_find_dependency_alias(module: i32, alias: addr) -> i32 {
    return mini_module_find_dependency_alias_from(
        mini_module_first_dependency(module), alias);
}

pub fn mini_module_resolve_alias(workspace: i32, module: i32, alias: addr) -> i32 {
    let request: i32 = mini_module_find_dependency_alias(module, alias);
    if request == 0 { return 0; }
    return mini_module_workspace_find(
        workspace, mini_module_dependency_target_name(request));
}

fn mini_module_binding_name_count(item: i32, name: addr) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_binding(item) == 1 {
        if mini_syntax_text_equal(mini_middle_binding_name(item), name) == 1 {
            return 1 + mini_module_binding_name_count(
                mini_middle_next_item(item), name);
        }
    }
    return mini_module_binding_name_count(mini_middle_next_item(item), name);
}

pub fn mini_module_find_binding(item: i32, name: addr) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_binding(item) == 1 {
        if mini_syntax_text_equal(mini_middle_binding_name(item), name) == 1 {
            return item;
        }
    }
    return mini_module_find_binding(mini_middle_next_item(item), name);
}

fn mini_module_export_count_items(item: i32, pending: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_export_attribute(item) == 1 {
        return mini_module_export_count_items(mini_middle_next_item(item), 1);
    }
    if mini_middle_is_binding(item) == 1 {
        return pending + mini_module_export_count_items(
            mini_middle_next_item(item), 0);
    }
    return mini_module_export_count_items(mini_middle_next_item(item), pending);
}

pub fn mini_module_summary_export_count(module: i32) -> i32 {
    return mini_module_export_count_items(mini_module_first_body_item(module), 0);
}

fn mini_module_export_binding_at_items(
    item: i32, wanted: i32, index: i32, pending: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_export_attribute(item) == 1 {
        return mini_module_export_binding_at_items(
            mini_middle_next_item(item), wanted, index, 1);
    }
    if mini_middle_is_binding(item) == 1 {
        if pending == 1 {
            if index == wanted { return item; }
            return mini_module_export_binding_at_items(
                mini_middle_next_item(item), wanted, index + 1, 0);
        }
        return mini_module_export_binding_at_items(
            mini_middle_next_item(item), wanted, index, 0);
    }
    return mini_module_export_binding_at_items(
        mini_middle_next_item(item), wanted, index, pending);
}

pub fn mini_module_summary_export_binding_at(
    module: i32, index: i32) -> i32 {
    return mini_module_export_binding_at_items(
        mini_module_first_body_item(module), index, 0, 0);
}

pub fn mini_module_summary_export_name_at(
    module: i32, index: i32) -> addr {
    let binding: i32 = mini_module_summary_export_binding_at(module, index);
    if binding == 0 { return ""; }
    return mini_middle_binding_name(binding);
}

// Detached artifact ABI: 1=procedure, 2=non-procedure value binding.
pub fn mini_module_summary_export_kind_at(
    module: i32, index: i32) -> i32 {
    let binding: i32 = mini_module_summary_export_binding_at(module, index);
    if binding == 0 { return 0; }
    if mini_middle_is_procedure_definition(binding) == 1 { return 1; }
    return 2;
}

pub fn mini_module_summary_export_param_count_at(
    module: i32, index: i32) -> i32 {
    let binding: i32 = mini_module_summary_export_binding_at(module, index);
    if binding == 0 { return 0; }
    if mini_middle_is_procedure_definition(binding) != 1 { return 0; }
    return mini_syntax_param_count(mini_syntax_function_first_param(binding));
}

pub fn mini_module_summary_export_return_type_at(
    module: i32, index: i32) -> addr {
    let binding: i32 = mini_module_summary_export_binding_at(module, index);
    if binding == 0 { return ""; }
    if mini_middle_is_procedure_definition(binding) != 1 { return ""; }
    return mini_syntax_text(
        mini_syntax_right(mini_syntax_function_signature(binding)));
}

fn mini_module_find_exported_binding_items(
    item: i32, name: addr, pending: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_middle_is_export_attribute(item) == 1 {
        return mini_module_find_exported_binding_items(
            mini_middle_next_item(item), name, 1);
    }
    if mini_middle_is_binding(item) == 1 {
        if pending == 1 {
            if mini_syntax_text_equal(mini_middle_binding_name(item), name) == 1 {
                return item;
            }
        }
        return mini_module_find_exported_binding_items(
            mini_middle_next_item(item), name, 0);
    }
    return mini_module_find_exported_binding_items(
        mini_middle_next_item(item), name, pending);
}

pub fn mini_module_find_exported_binding(module: i32, name: addr) -> i32 {
    return mini_module_find_exported_binding_items(
        mini_module_first_body_item(module), name, 0);
}

pub fn mini_module_summary_has_export(module: i32, name: addr) -> i32 {
    if mini_module_find_exported_binding(module, name) != 0 { return 1; }
    return 0;
}

pub fn mini_module_find_exported_procedure(module: i32, name: addr) -> i32 {
    let binding: i32 = mini_module_find_exported_binding(module, name);
    if binding == 0 { return 0; }
    if mini_middle_is_procedure_definition(binding) != 1 { return 0; }
    return binding;
}

pub fn mini_module_summary_export_param_count(module: i32, name: addr) -> i32 {
    let binding: i32 = mini_module_find_exported_procedure(module, name);
    if binding == 0 { return 0; }
    return mini_syntax_param_count(mini_syntax_function_first_param(binding));
}

pub fn mini_module_summary_export_return_type(module: i32, name: addr) -> addr {
    let binding: i32 = mini_module_find_exported_procedure(module, name);
    if binding == 0 { return ""; }
    return mini_syntax_text(
        mini_syntax_right(mini_syntax_function_signature(binding)));
}

fn mini_module_validate_require(binding: i32) -> i32 {
    let initializer: i32 = mini_middle_binding_initializer(binding);
    let arg: i32 = mini_syntax_call_first_arg(initializer);
    if arg == 0 { return 4006; }
    if mini_syntax_arg_next(arg) != 0 { return 4006; }
    if mini_syntax_is_identifier(arg) != 1 { return 4006; }
    return 0;
}

fn mini_module_validate_body_items(item: i32, pending_export: i32) -> i32 {
    if item == 0 {
        if pending_export == 1 { return 4005; }
        return 0;
    }
    if mini_syntax_is_atom_text(item, ";") == 1 {
        return mini_module_validate_body_items(
            mini_middle_next_item(item), pending_export);
    }
    if mini_middle_is_export_attribute(item) == 1 {
        if pending_export == 1 { return 4005; }
        return mini_module_validate_body_items(mini_middle_next_item(item), 1);
    }
    if mini_middle_is_require_binding(item) == 1 {
        if pending_export == 1 { return 4007; }
        let require_code: i32 = mini_module_validate_require(item);
        if require_code != 0 { return require_code; }
        if mini_module_binding_name_count(
            mini_middle_next_item(item), mini_middle_binding_name(item)) != 0 {
            return 4004;
        }
        return mini_module_validate_body_items(mini_middle_next_item(item), 0);
    }
    if mini_middle_is_procedure_definition(item) == 1 {
        if mini_middle_is_binding(item) != 1 { return 4003; }
        let function_code: i32 = mini_syntax_validate_function(item);
        if function_code != 0 { return function_code; }
        if mini_module_binding_name_count(
            mini_middle_next_item(item), mini_middle_binding_name(item)) != 0 {
            return 4004;
        }
        return mini_module_validate_body_items(mini_middle_next_item(item), 0);
    }
    return 4003;
}

fn mini_module_validate_shape(module: i32) -> i32 {
    if mini_middle_is_module_binding(module) != 1 { return 4001; }
    if mini_syntax_is_identifier(mini_middle_binding_name_node(module)) != 1 {
        return 4001;
    }
    return mini_module_validate_body_items(mini_module_first_body_item(module), 0);
}

fn mini_module_validate_workspace_items(item: i32) -> i32 {
    if item == 0 { return 0; }
    if mini_syntax_is_atom_text(item, ";") == 1 {
        return mini_module_validate_workspace_items(mini_middle_next_item(item));
    }
    if mini_middle_is_module_binding(item) != 1 { return 4001; }
    let code: i32 = mini_module_validate_shape(item);
    if code != 0 { return code; }
    return mini_module_validate_workspace_items(mini_middle_next_item(item));
}

fn mini_module_validate_unique_modules(workspace: i32, module: i32) -> i32 {
    if module == 0 { return 0; }
    if mini_module_workspace_name_count(
        workspace, mini_module_summary_name(module)) != 1 { return 4002; }
    return mini_module_validate_unique_modules(workspace, mini_module_next_module(module));
}

fn mini_module_validate_dependencies_from(
    workspace: i32, binding: i32) -> i32 {
    if binding == 0 { return 0; }
    if mini_module_workspace_find(
        workspace, mini_module_dependency_target_name(binding)) == 0 {
        return 4101;
    }
    return mini_module_validate_dependencies_from(
        workspace, mini_module_next_dependency(binding));
}

fn mini_module_validate_dependencies(workspace: i32, module: i32) -> i32 {
    if module == 0 { return 0; }
    let code: i32 = mini_module_validate_dependencies_from(
        workspace, mini_module_first_dependency(module));
    if code != 0 { return code; }
    return mini_module_validate_dependencies(workspace, mini_module_next_module(module));
}

fn mini_module_validate_dependency_paths(
    workspace: i32, binding: i32, depth: i32, module_count: i32) -> i32 {
    if binding == 0 { return 0; }
    if depth == module_count { return 4103; }
    let target: i32 = mini_module_workspace_find(
        workspace, mini_module_dependency_target_name(binding));
    let child_code: i32 = mini_module_validate_dependency_paths(
        workspace, mini_module_first_dependency(target), depth + 1, module_count);
    if child_code != 0 { return child_code; }
    return mini_module_validate_dependency_paths(
        workspace, mini_module_next_dependency(binding), depth, module_count);
}

fn mini_module_validate_cycles_from(
    workspace: i32, module: i32, module_count: i32) -> i32 {
    if module == 0 { return 0; }
    let code: i32 = mini_module_validate_dependency_paths(
        workspace, mini_module_first_dependency(module), 0, module_count);
    if code != 0 { return code; }
    return mini_module_validate_cycles_from(
        workspace, mini_module_next_module(module), module_count);
}

pub fn mini_module_validate_workspace(workspace: i32) -> i32 {
    if mini_syntax_kind(workspace) != 4 { return 1001; }
    let module_count: i32 = mini_module_workspace_module_count(workspace);
    if module_count == 0 { return 4000; }
    let shape_code: i32 = mini_module_validate_workspace_items(
        mini_middle_first_item(workspace));
    if shape_code != 0 { return shape_code; }
    let unique_code: i32 = mini_module_validate_unique_modules(
        workspace, mini_module_first_module(workspace));
    if unique_code != 0 { return unique_code; }
    let dependency_code: i32 = mini_module_validate_dependencies(
        workspace, mini_module_first_module(workspace));
    if dependency_code != 0 { return dependency_code; }
    return mini_module_validate_cycles_from(
        workspace, mini_module_first_module(workspace), module_count);
}

fn mini_module_validation_code_for(workspace: i32, module: i32) -> i32 {
    let shape_code: i32 = mini_module_validate_shape(module);
    if shape_code != 0 { return shape_code; }
    if mini_module_workspace_name_count(
        workspace, mini_module_summary_name(module)) != 1 { return 4002; }
    let dependency_code: i32 = mini_module_validate_dependencies_from(
        workspace, mini_module_first_dependency(module));
    if dependency_code != 0 { return dependency_code; }
    return mini_module_validate_dependency_paths(
        workspace,
        mini_module_first_dependency(module),
        0,
        mini_module_workspace_module_count(workspace));
}

fn mini_module_diagnostic_module_from(workspace: i32, module: i32) -> addr {
    if module == 0 { return ""; }
    if mini_module_validation_code_for(workspace, module) != 0 {
        return mini_module_summary_name(module);
    }
    return mini_module_diagnostic_module_from(workspace, mini_module_next_module(module));
}

pub fn mini_module_diagnostic_module(workspace: i32) -> addr {
    return mini_module_diagnostic_module_from(
        workspace, mini_module_first_module(workspace));
}

fn module_workspace_dependency_count_from(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    return module_workspace_dependency_count_at(workspace, index) +
        module_workspace_dependency_count_from(workspace, index + 1);
}

pub fn module_workspace_dependency_count(workspace: ModuleWorkspace) -> i32 {
    return module_workspace_dependency_count_from(workspace, 0);
}

fn module_workspace_validate_shapes(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let code: i32 = mini_module_validate_shape(
        module_workspace_module_at(workspace, index));
    if code != 0 { return code; }
    return module_workspace_validate_shapes(workspace, index + 1);
}

fn module_workspace_validate_unique(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    if module_workspace_name_count(
        workspace, module_workspace_name_at(workspace, index)) != 1 {
        return 4002;
    }
    return module_workspace_validate_unique(workspace, index + 1);
}

fn module_workspace_validate_dependency_bindings(
    workspace: ModuleWorkspace, binding: i32) -> i32 {
    if binding == 0 { return 0; }
    if module_workspace_find(
        workspace, mini_module_dependency_target_name(binding)) == 0 {
        return 4101;
    }
    return module_workspace_validate_dependency_bindings(
        workspace, mini_module_next_dependency(binding));
}

fn module_workspace_validate_dependencies(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let code: i32 = module_workspace_validate_dependency_bindings(
        workspace, mini_module_first_dependency(
            module_workspace_module_at(workspace, index)));
    if code != 0 { return code; }
    return module_workspace_validate_dependencies(workspace, index + 1);
}

fn module_workspace_validate_dependency_path(
    workspace: ModuleWorkspace, binding: i32,
    depth: i32) -> i32 {
    if binding == 0 { return 0; }
    if depth == module_workspace_count(workspace) { return 4103; }
    let target: i32 = module_workspace_find(
        workspace, mini_module_dependency_target_name(binding));
    let child: i32 = module_workspace_validate_dependency_path(
        workspace, mini_module_first_dependency(target), depth + 1);
    if child != 0 { return child; }
    return module_workspace_validate_dependency_path(
        workspace, mini_module_next_dependency(binding), depth);
}

fn module_workspace_validate_cycles(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let code: i32 = module_workspace_validate_dependency_path(
        workspace, mini_module_first_dependency(
            module_workspace_module_at(workspace, index)), 0);
    if code != 0 { return code; }
    return module_workspace_validate_cycles(workspace, index + 1);
}

pub fn module_workspace_validate(workspace: ModuleWorkspace) -> i32 {
    if module_workspace_count(workspace) == 0 { return 4000; }
    let shape: i32 = module_workspace_validate_shapes(workspace, 0);
    if shape != 0 { return shape; }
    let unique: i32 = module_workspace_validate_unique(workspace, 0);
    if unique != 0 { return unique; }
    let dependencies: i32 = module_workspace_validate_dependencies(workspace, 0);
    if dependencies != 0 { return dependencies; }
    return module_workspace_validate_cycles(workspace, 0);
}

fn module_workspace_validation_index_from(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return 0; }
    let module: i32 = module_workspace_module_at(workspace, index);
    if mini_module_validate_shape(module) != 0 {
        return module_workspace_source_index_at(workspace, index);
    }
    if module_workspace_name_count(
        workspace, module_workspace_name_at(workspace, index)) != 1 {
        return module_workspace_source_index_at(workspace, index);
    }
    if module_workspace_validate_dependency_bindings(
        workspace, mini_module_first_dependency(module)) != 0 {
        return module_workspace_source_index_at(workspace, index);
    }
    if module_workspace_validate_dependency_path(
        workspace, mini_module_first_dependency(module), 0) != 0 {
        return module_workspace_source_index_at(workspace, index);
    }
    return module_workspace_validation_index_from(workspace, index + 1);
}

pub fn module_workspace_validation_source_index(
    workspace: ModuleWorkspace) -> i32 {
    return module_workspace_validation_index_from(workspace, 0);
}

fn module_workspace_order_contains(
    workspace: ModuleWorkspace, module_index: i32,
    position: i32) -> i32 {
    if position == module_workspace_order_count(workspace) { return 0; }
    if m11_i32_vec_get(workspace.order, position) == module_index { return 1; }
    return module_workspace_order_contains(
        workspace, module_index, position + 1);
}

fn module_workspace_dependencies_ready(
    workspace: ModuleWorkspace, binding: i32) -> i32 {
    if binding == 0 { return 1; }
    let target_index: i32 = module_workspace_find_index(
        workspace, mini_module_dependency_target_name(binding));
    if module_workspace_order_contains(
        workspace, target_index, 0) != 1 { return 0; }
    return module_workspace_dependencies_ready(
        workspace, mini_module_next_dependency(binding));
}

fn module_workspace_find_ready(
    workspace: ModuleWorkspace, index: i32) -> i32 {
    if index == module_workspace_count(workspace) { return -1; }
    if module_workspace_order_contains(workspace, index, 0) != 1 {
        if module_workspace_dependencies_ready(
            workspace, mini_module_first_dependency(
                module_workspace_module_at(workspace, index))) == 1 {
            return index;
        }
    }
    return module_workspace_find_ready(workspace, index + 1);
}

fn module_workspace_build_order_from(
    workspace: ModuleWorkspace) -> ModuleWorkspace {
    if module_workspace_order_count(workspace) == module_workspace_count(workspace) {
        return workspace;
    }
    let ready: i32 = module_workspace_find_ready(workspace, 0);
    if ready < 0 {
        return ModuleWorkspace {
            modules: workspace.modules,
            source_indices: workspace.source_indices,
            order: workspace.order, diagnostic: 4103,
            diagnostic_index: 0,
        };
    }
    let order: M11I32Vec = m11_i32_vec_push(workspace.order, ready);
    let next: ModuleWorkspace = ModuleWorkspace {
        modules: workspace.modules,
        source_indices: workspace.source_indices,
        order: order,
        diagnostic: workspace.diagnostic,
        diagnostic_index: workspace.diagnostic_index,
    };
    if order.ok == 0 {
        return ModuleWorkspace {
            modules: workspace.modules,
            source_indices: workspace.source_indices,
            order: order, diagnostic: 4304,
            diagnostic_index: module_workspace_source_index_at(
                workspace, ready),
        };
    }
    return module_workspace_build_order_from(next);
}

pub fn module_workspace_build_order(
    workspace: ModuleWorkspace) -> ModuleWorkspace {
    if workspace.diagnostic != 0 { return workspace; }
    let code: i32 = module_workspace_validate(workspace);
    if code != 0 {
        return ModuleWorkspace {
            modules: workspace.modules,
            source_indices: workspace.source_indices,
            order: workspace.order, diagnostic: code,
            diagnostic_index: module_workspace_validation_source_index(
                workspace),
        };
    }
    return module_workspace_build_order_from(workspace);
}

pub fn module_workspace_ordered_module(
    workspace: ModuleWorkspace, position: i32) -> i32 {
    return module_workspace_module_at(
        workspace, m11_i32_vec_get(workspace.order, position));
}

pub fn module_workspace_destroy(workspace: ModuleWorkspace) -> i32 {
    let modules: i32 = m11_i32_vec_destroy(workspace.modules);
    let sources: i32 = m11_i32_vec_destroy(workspace.source_indices);
    let order: i32 = m11_i32_vec_destroy(workspace.order);
    if modules != 1 { return 0; }
    if sources != 1 { return 0; }
    return order;
}
