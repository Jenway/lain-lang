// Stable diagnostics for the Lain-owned Meta domains.

@export

let diagnostic_message = std::func(code: i32) -> addr {
    if code == 0 { return "ok"; }
    if code == 1001 { return "expected source root group"; }
    if code == 1002 { return "expected procedure binding and body"; }
    if code == 1003 { return "expected let procedure declaration"; }
    if code == 1004 { return "expected top-level let"; }
    if code == 1101 { return "expected procedure return arrow"; }
    if code == 1102 { return "mini-meta supports only i32 and addr returns"; }
    if code == 1103 { return "expected procedure name binding"; }
    if code == 1104 { return "expected procedure identifier"; }
    if code == 1105 { return "expected empty procedure parameter group"; }
    if code == 1106 { return "expected fn form"; }
    if code == 1107 { return "expected parameter group"; }
    if code == 1108 { return "unsupported parameter form"; }
    if code == 1110 { return "expected typed parameter"; }
    if code == 1111 { return "expected parameter identifier"; }
    if code == 1112 { return "mini-meta supports only i32 and addr parameters"; }
    if code == 1113 { return "expected comma between parameters"; }
    if code == 1114 { return "trailing parameter comma is not supported"; }
    if code == 1201 { return "expected procedure body group"; }
    if code == 12001 { return "non-canonical top-level form; use let NAME[: TYPE] = INITIALIZER"; }
    if code == 12002 { return "binding name must be an identifier"; }
    if code == 12003 { return "only func, struct, and module constructors accept a body"; }
    if code == 12004 { return "func, struct, and module constructors require a body"; }
    if code == 12005 { return "attribute must be followed by a canonical let binding"; }
    if code == 12006 { return "binding expected type does not match its initializer"; }
    if code == 12007 { return "unable to infer top-level binding type"; }
    if code == 12008 { return "unknown callable phase"; }
    if code == 2001 { return "unsupported i32 expression"; }
    if code == 2002 { return "unsupported i32 operator"; }
    if code == 2003 { return "unknown name or invalid i32 literal"; }
    if code == 2101 { return "malformed local let binding"; }
    if code == 2102 { return "duplicate local binding"; }
    if code == 2103 { return "procedure body has no result expression"; }
    if code == 2104 { return "result expression must be the final form"; }
    if code == 2110 { return "duplicate parameter binding"; }
    if code == 2111 { return "duplicate procedure binding"; }
    if code == 2201 { return "add operands must be i32"; }
    if code == 2202 { return "equality operands must be i32"; }
    if code == 2203 { return "local let value must be i32"; }
    if code == 2204 { return "procedure result must be i32"; }
    if code == 2301 { return "unknown procedure"; }
    if code == 2302 { return "ambiguous procedure"; }
    if code == 2303 { return "procedure argument count mismatch"; }
    if code == 2304 { return "procedure argument must be i32"; }
    if code == 2401 { return "if condition must be bool"; }
    if code == 2402 { return "if branches must produce the same type"; }
    if code == 2403 { return "if branches must contain one expression"; }
    if code == 2501 { return "unreachable form after explicit return"; }
    if code == 2502 { return "declared procedure requires explicit return"; }
    if code == 2701 { return "unknown source macro"; }
    if code == 2702 { return "println! requires import std::io"; }
    if code == 2703 { return "println! expects one argument"; }
    if code == 2704 { return "println! expects a string literal"; }
    if code == 2801 { return "malformed Comptime(T) type"; }
    if code == 2802 { return "compile-time value required"; }
    if code == 2803 { return "compile-time expression depends on runtime state"; }
    if code == 2804 { return "LAIN-IR compile-time evaluation failed"; }
    if code == 2805 { return "capability is unavailable during consteval"; }
    if code == 2810 { return "invalid type argument"; }
    if code == 2811 { return "specialization depth exceeded"; }
    if code == 2812 { return "specialization argument type mismatch"; }
    if code == 2813 { return "unsupported compile-time value kind"; }
    if code == 2901 { return "invalid std::meta callable signature"; }
    if code == 2902 { return "unknown Meta attribute"; }
    if code == 2903 { return "invalid Meta expansion result"; }
    if code == 2904 { return "Meta expansion limit exceeded"; }
    if code == 2905 { return "invalid Syntax handle or hygiene context"; }
    if code == 2906 { return "capability unavailable to Meta callable"; }
    if code == 3001 { return "malformed enum declaration"; }
    if code == 3002 { return "duplicate enum variant"; }
    if code == 3003 { return "invalid enum variant payload"; }
    if code == 3010 { return "match target is not an enum"; }
    if code == 3011 { return "unknown or duplicate enum variant pattern"; }
    if code == 3012 { return "non-exhaustive match"; }
    if code == 3013 { return "unreachable match arm"; }
    if code == 3014 { return "match arm type mismatch"; }
    if code == 4000 { return "workspace contains no module binding"; }
    if code == 4001 { return "expected canonical module binding"; }
    if code == 4002 { return "duplicate module binding"; }
    if code == 4003 { return "unsupported module body binding"; }
    if code == 4004 { return "duplicate binding in module"; }
    if code == 4005 { return "dangling or duplicate export attribute"; }
    if code == 4006 { return "malformed import binding"; }
    if code == 4007 { return "an import binding cannot be exported"; }
    if code == 4101 { return "required module does not exist"; }
    if code == 4103 { return "module dependency cycle"; }
    if code == 4104 { return "unknown module alias"; }
    if code == 4201 { return "module member does not exist"; }
    if code == 4202 { return "module member is private"; }
    if code == 4203 { return "exported module member is not callable"; }
    if code == 4300 { return "workspace contains no source units"; }
    if code == 4301 { return "workspace source unit is empty"; }
    if code == 4302 { return "workspace source unit did not parse to a root"; }
    if code == 4303 { return "workspace source unit must contain one module"; }
    if code == 4304 { return "unable to allocate workspace syntax index"; }
    if code == 4400 { return "invalid compiler request mode"; }
    if code == 8002 { return "unable to lower a physical L1 unit"; }
    return "unknown mini-meta diagnostic";
}
