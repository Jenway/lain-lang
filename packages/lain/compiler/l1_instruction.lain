import packages::lain::compiler::l1_value;

struct L1Instruction { tag: i32, result_type_tag: i32, left: i32, right: i32 }

fn l1_instruction_add_i32(left_value: i32, right_value: i32) -> L1Instruction {
    return L1Instruction { tag: 1, result_type_tag: l1_value_i32_type_tag(left_value), left: l1_value_i32_payload(left_value), right: l1_value_i32_payload(right_value) };
}

fn l1_instruction_return_i32(value: i32) -> L1Instruction {
    return L1Instruction { tag: 2, result_type_tag: l1_value_i32_type_tag(value), left: l1_value_i32_payload(value), right: 0 };
}

pub fn l1_instruction_add_tag(left: i32, right: i32) -> i32 {
    let instruction: L1Instruction = l1_instruction_add_i32(left, right);
    return instruction.tag;
}

pub fn l1_instruction_add_type_tag(left: i32, right: i32) -> i32 {
    let instruction: L1Instruction = l1_instruction_add_i32(left, right);
    return instruction.result_type_tag;
}

pub fn l1_instruction_return_tag(value: i32) -> i32 {
    let instruction: L1Instruction = l1_instruction_return_i32(value);
    return instruction.tag;
}
