// Module/function lookup, lexical scope resolution and type elaboration.

let syntax = import("packages::lain::compiler::syntax");
let types = import("packages::lain::compiler::types");
let modules = import("packages::lain::compiler::modules");
let surface_forms = import("packages::lain::compiler::surface_forms");
let compiler_context = import("packages::lain::compiler::compiler_context");
let enums = import("packages::lain::compiler::enums");
@foreign(c, link_name = "core.string-append!")
let elaborator_string_append = std::func(left: addr, right: addr) -> addr;

// M13 builds the callable environment once before elaborating bodies.  The
// earlier bootstrap path repeatedly rediscovered every callable by walking
// RawAst for every call expression, which made full self-compilation
// quadratic in expensive topology queries.  The table and duplicate policy
// are Lain-owned; the host supplies only the raw growable slots from M11.
@export
let M13ElaborationIndex: type = std::struct {
    functions: M11SymbolTable,
    types: M11SymbolTable,
    duplicate: i32,
}

let m13_index_callable = std::func(
    function: i32, index: M13ElaborationIndex) -> M13ElaborationIndex {
    if function == 0 { return index; }
    let name_node: i32 = syntax_function_name_node(function);
    let old: i32 = m11_symbol_table_find_node(
        index.functions, name_node);
    let duplicate: i32 = index.duplicate;
    if old != 0 {
        return m13_index_callable(
            surface_next_callable(function),
            M13ElaborationIndex {
                functions: index.functions, duplicate: 1,
                types: index.types,
            });
    }
    return m13_index_callable(
        surface_next_callable(function),
        M13ElaborationIndex {
            functions: m11_symbol_table_insert_node(
                index.functions, name_node, function),
            types: index.types,
            duplicate: duplicate,
        });
}

let m13_type_declaration_name_node = std::func(item: i32) -> i32 {
    if syntax_is_struct_declaration(item) == 1 {
        return syntax_struct_name_node(item);
    }
    if syntax_is_enum_declaration(item) == 1 {
        return syntax_enum_name_node(item);
    }
    return 0;
}

let m13_index_types = std::func(
    item: i32, index: M13ElaborationIndex) -> M13ElaborationIndex {
    if item == 0 { return index; }
    let name_node: i32 = m13_type_declaration_name_node(item);
    if name_node != 0 {
        if m11_symbol_table_find_node(index.types, name_node) != 0 {
            return m13_index_types(
                surface_next_item(item),
                M13ElaborationIndex {
                    functions: index.functions, types: index.types,
                    duplicate: 1,
                });
        }
        return m13_index_types(
            surface_next_item(item),
            M13ElaborationIndex {
                functions: index.functions,
                types: m11_symbol_table_insert_node(
                    index.types, name_node, item),
                duplicate: index.duplicate,
            });
    }
    return m13_index_types(surface_next_item(item), index);
}

let m13_index_new = std::func(root: i32) -> M13ElaborationIndex {
    let callables: M13ElaborationIndex = m13_index_callable(
        surface_first_callable(root),
        M13ElaborationIndex {
            functions: m11_symbol_table_new(),
            types: m11_symbol_table_new(), duplicate: 0,
        });
    return m13_index_types(surface_first_item(root), callables);
}

@export

let elaborator_index_new = std::func(root: i32) -> M13ElaborationIndex {
    return m13_index_new(root);
}

let m13_index_destroy = std::func(index: M13ElaborationIndex) -> i32 {
    let functions: i32 = m11_symbol_table_destroy(index.functions);
    let types: i32 = m11_symbol_table_destroy(index.types);
    if functions == 1 { return types; }
    return 0;
}

@export

let elaborator_index_destroy = std::func(index: M13ElaborationIndex) -> i32 {
    return m13_index_destroy(index);
}

let m13_find = std::func(index: M13ElaborationIndex, name: addr) -> i32 {
    return m11_symbol_table_find(index.functions, name);
}

let m13_find_node = std::func(
    index: M13ElaborationIndex, identifier: i32) -> i32 {
    return m11_symbol_table_find_node(index.functions, identifier);
}

@export

let elaborator_find_callable = std::func(
    index: M13ElaborationIndex, name: addr) -> i32 {
    return m13_find(index, name);
}

@export
let elaborator_find_callable_node = std::func(
    index: M13ElaborationIndex, identifier: i32) -> i32 {
    return m13_find_node(index, identifier);
}

let elaborator_name_visible_impl = std::func(function: i32, body_start: i32, stop: i32, name: addr) -> i32 {
    if syntax_param_named(syntax_function_first_param(function), name) == 1 { return 1; }
    if surface_find_visible_local(function, stop, name) != 0 { return 1; }
    return 0;
}

let elaborator_name_visible_node_impl = std::func(
    function: i32, body_start: i32, stop: i32, reference: i32) -> i32 {
    if syntax_find_param_node(
        syntax_function_first_param(function), reference) != 0 { return 1; }
    if surface_find_visible_local_node(
        function, stop, reference) != 0 { return 1; }
    return 0;
}

let type_from_syntax = std::func(node: i32) -> i32 {
    if syntax_is_atom_text(node, "i32") == 1 { return type_i32(); }
    if syntax_is_atom_text(node, "bool") == 1 { return type_bool(); }
    if syntax_is_atom_text(node, "addr") == 1 { return type_addr(); }
    if syntax_is_unit_type(node) == 1 { return type_unit(); }
    if syntax_path_tail_is(node, "type") == 1 {
        return type_type();
    }
    if syntax_path_tail_is(node, "Module") == 1 {
        return type_module();
    }
    if syntax_path_tail_is(node, "module") == 1 {
        return type_module();
    }
    if syntax_path_tail_is(node, "Callable") == 1 {
        return type_callable();
    }
    if syntax_is_interface_dyn_type(node) == 1 {
        return type_addr();
    }
    if syntax_is_comptime_type(node) == 1 {
        return type_comptime(
            type_from_syntax(syntax_comptime_argument(node)));
    }
    // Nominal type application is a Meta-level specialization.  The
    // CompilerContext has already interned its TypeValue; the current
    // structured L1 subset represents enum values through an address until
    // constructor/match lowering supplies the concrete aggregate operations.
    if syntax_is_call(node) == 1 {
        if syntax_call_namespace(node) == 0 {
            if syntax_is_identifier(syntax_call_callee(node)) == 1 {
                if syntax_arg_count(syntax_call_first_arg(node)) == 1 {
                    return type_addr();
                }
            }
        }
    }
    if syntax_is_identifier(node) == 1 { return type_addr(); }
    return type_error();
}

let elaborator_type_syntax_diagnostic = std::func(node: i32) -> i32 {
    if syntax_is_comptime_spelling(node) == 1 {
        if syntax_is_comptime_type(node) != 1 { return 2801; }
        let argument: i32 = type_from_syntax(
            syntax_comptime_argument(node));
        if type_comptime(argument) == 0 { return 2801; }
    }
    if type_from_syntax(node) == type_error() { return 12007; }
    return 0;
}

// Constructor calls are Meta callables.  The value produced by `func` is a
// runtime callable unless a later elaboration rule supplies an explicit,
// valid phase.  Keeping phase as resolved data avoids encoding evaluation
// policy in the parser or in the constructor's spelling.
@export
let elaborator_constructor_phase = std::func(item: i32) -> i32 {
    if surface_binding_constructor_is(item, "func") == 1 {
        return callable_phase_meta();
    }
    if surface_binding_constructor_is(item, "struct") == 1 {
        return callable_phase_meta();
    }
    if surface_binding_constructor_is(item, "enum") == 1 {
        return callable_phase_meta();
    }
    if surface_binding_constructor_is(item, "module") == 1 {
        return callable_phase_meta();
    }
    if surface_binding_constructor_is(item, "import") == 1 {
        return callable_phase_meta();
    }
    return 0;
}

@export

let elaborator_resolve_callable_phase = std::func(
    function: i32, requested_phase: i32) -> i32 {
    if surface_binding_is_func(function) != 1 { return 0; }
    if requested_phase == 0 { return callable_phase_runtime(); }
    if callable_phase_valid(requested_phase) != 1 { return 0; }
    return requested_phase;
}

@export

let elaborator_callable_phase = std::func(function: i32) -> i32 {
    return elaborator_resolve_callable_phase(function, 0);
}

let elaborator_binding_inferred_type = std::func(item: i32) -> i32 {
    if surface_binding_is_func(item) == 1 {
        return type_callable();
    }
    if surface_binding_is_struct(item) == 1 {
        return type_type();
    }
    if surface_binding_is_enum(item) == 1 {
        return type_type();
    }
    if surface_is_module_binding(item) == 1 {
        return type_module();
    }
    if surface_is_require_binding(item) == 1 {
        return type_module();
    }
    let initializer: i32 = surface_binding_initializer(item);
    if syntax_is_i32_atom(initializer) == 1 { return type_i32(); }
    if syntax_is_atom_text(initializer, "true") == 1 { return type_bool(); }
    if syntax_is_atom_text(initializer, "false") == 1 { return type_bool(); }
    if syntax_is_string_atom(initializer) == 1 { return type_addr(); }
    return type_error();
}

@export

let elaborator_binding_type = std::func(item: i32) -> i32 {
    let inferred: i32 = elaborator_binding_inferred_type(item);
    let expected_node: i32 = surface_binding_expected(item);
    if expected_node == 0 { return inferred; }
    let expected: i32 = type_from_syntax(expected_node);
    if expected == type_error() { return type_error(); }
    if syntax_is_consteval_call(
        surface_binding_initializer(item)) == 1 {
        return expected;
    }
    if inferred == type_error() { return type_error(); }
    if type_is_comptime(expected) == 1 {
        if type_same(type_comptime_argument(expected), inferred) != 1 {
            return type_error();
        }
        return expected;
    }
    if type_same(expected, inferred) != 1 { return type_error(); }
    return expected;
}

let elaborator_validate_top_level_bindings = std::func(item: i32) -> i32 {
    if item == 0 { return 0; }
    if surface_item_tag(item) == 5 {
        let inferred: i32 = elaborator_binding_inferred_type(item);
        let expected_node: i32 = surface_binding_expected(item);
        if expected_node != 0 {
            let syntax_code: i32 =
                elaborator_type_syntax_diagnostic(expected_node);
            if syntax_code != 0 { return syntax_code; }
            let expected: i32 = type_from_syntax(expected_node);
            if syntax_is_consteval_call(
                surface_binding_initializer(item)) == 1 {
                return elaborator_validate_top_level_bindings(
                    surface_next_item(item));
            }
            if type_is_comptime(expected) == 1 {
                // The full expression evaluator is connected in the next
                // milestone.  Scalar literals are already persistent values.
                let initializer: i32 = surface_binding_initializer(item);
                if syntax_is_i32_atom(initializer) != 1 {
                    if syntax_is_atom_text(initializer, "true") != 1 {
                        if syntax_is_atom_text(initializer, "false") != 1 {
                            return 2802;
                        }
                    }
                }
                if type_same(
                    type_comptime_argument(expected), inferred) != 1 {
                    return 12006;
                }
            }
            if type_is_comptime(expected) != 1 {
                if type_same(expected, inferred) != 1 { return 12006; }
            }
        }
        if inferred == type_error() { return 12007; }
        if surface_binding_is_func(item) == 1 {
            if elaborator_callable_phase(item) == 0 { return 12008; }
        }
    }
    return elaborator_validate_top_level_bindings(surface_next_item(item));
}

let elaborator_validate_top_consteval = std::func(
    index: M13ElaborationIndex, root: i32, item: i32) -> i32 {
    if item == 0 { return 0; }
    if surface_item_tag(item) == 5 {
        let initializer: i32 = surface_binding_initializer(item);
        if syntax_is_std_call(initializer, "consteval") == 1 {
            if syntax_is_consteval_call(initializer) != 1 { return 2802; }
            let operand: i32 = syntax_consteval_operand(initializer);
            let dependency: i32 = elaborator_consteval_dependency_code(
                index, root, 0, operand, 0, 0);
            if dependency != 0 { return dependency; }
            let code: i32 = elaborator_validate_expr(
                index, root, 0, operand, 0, 0);
            if code != 0 { return code; }
        }
    }
    return elaborator_validate_top_consteval(
        index, root, surface_next_item(item));
}

let elaborator_interface_callee = std::func(
    index: M13ElaborationIndex, root: i32, node: i32) -> i32 {
    if syntax_text_equal(
        surface_interface_type_name(root),
        syntax_interface_base_name(node)) != 1 { return 0; }
    let prefix: addr = surface_interface_impl_prefix(root);
    if syntax_text_equal(prefix, "") == 1 { return 0; }
    return m13_find(
        index,
        elaborator_string_append(
            elaborator_string_append(prefix, "_"),
            syntax_interface_member_name(node)));
}

let elaborator_function_return_type = std::func(function: i32) -> i32 {
    return type_from_syntax(syntax_right(syntax_function_signature(function)));
}

let m13_find_field_type = std::func(field: i32, name: addr) -> i32 {
    if field == 0 { return 0; }
    if syntax_is_atom_text(field, ",") == 1 {
        return m13_find_field_type(syntax_next(field), name);
    }
    if syntax_is_infix(field, ":") == 1 {
        if syntax_text_equal(
            syntax_text(syntax_left(field)), name) == 1 {
            return syntax_right(field);
        }
    }
    return m13_find_field_type(syntax_next(field), name);
}

let m13_struct_field_type = std::func(
    index: M13ElaborationIndex, type_node: i32, name: addr) -> i32 {
    if type_node == 0 { return 0; }
    let declaration: i32 = m11_symbol_table_find(
        index.types, syntax_text(type_node));
    if declaration == 0 { return 0; }
    return m13_find_field_type(
        syntax_struct_first_field(declaration), name);
}

let m13_type_size = std::func(type_node: i32) -> i32 {
    if syntax_is_atom_text(type_node, "i32") == 1 { return 4; }
    if syntax_is_atom_text(type_node, "bool") == 1 { return 4; }
    return 8;
}

let m13_field_offset_from = std::func(
    field: i32, name: addr, offset: i32, four_byte_tail: i32) -> i32 {
    if field == 0 { return -1; }
    if syntax_is_atom_text(field, ",") == 1 {
        return m13_field_offset_from(
            syntax_next(field), name, offset, four_byte_tail);
    }
    if syntax_is_infix(field, ":") != 1 { return -1; }
    let size: i32 = m13_type_size(syntax_right(field));
    if size == 8 {
        if four_byte_tail == 1 {
            if syntax_text_equal(
                syntax_text(syntax_left(field)), name) == 1 {
                return offset + 4;
            }
            return m13_field_offset_from(
                syntax_next(field), name, offset + 12, 0);
        }
        if syntax_text_equal(
            syntax_text(syntax_left(field)), name) == 1 {
            return offset;
        }
        return m13_field_offset_from(
            syntax_next(field), name, offset + 8, 0);
    }
    if syntax_text_equal(
        syntax_text(syntax_left(field)), name) == 1 {
        return offset;
    }
    if four_byte_tail == 1 {
        return m13_field_offset_from(
            syntax_next(field), name, offset + 4, 0);
    }
    return m13_field_offset_from(
        syntax_next(field), name, offset + 4, 1);
}

let m13_struct_size_from = std::func(
    field: i32, offset: i32,
    four_byte_tail: i32, has_addr: i32) -> i32 {
    if field == 0 {
        if has_addr == 1 {
            if four_byte_tail == 1 { return offset + 4; }
        }
        return offset;
    }
    if syntax_is_atom_text(field, ",") == 1 {
        return m13_struct_size_from(
            syntax_next(field), offset, four_byte_tail, has_addr);
    }
    let size: i32 = m13_type_size(syntax_right(field));
    if size == 8 {
        if four_byte_tail == 1 {
            return m13_struct_size_from(
                syntax_next(field), offset + 12, 0, 1);
        }
        return m13_struct_size_from(
            syntax_next(field), offset + 8, 0, 1);
    }
    if four_byte_tail == 1 {
        return m13_struct_size_from(
            syntax_next(field), offset + 4, 0, has_addr);
    }
    return m13_struct_size_from(
        syntax_next(field), offset + 4, 1, has_addr);
}

@export

let elaborator_aggregate_size = std::func(
    index: M13ElaborationIndex, aggregate: i32) -> i32 {
    let declaration: i32 = m11_symbol_table_find(
        index.types,
        syntax_text(syntax_aggregate_type_node(aggregate)));
    if declaration == 0 { return 0; }
    return m13_struct_size_from(
        syntax_struct_first_field(declaration), 0, 0, 0);
}

@export

let elaborator_aggregate_field_offset = std::func(
    index: M13ElaborationIndex, aggregate: i32, name: addr) -> i32 {
    let declaration: i32 = m11_symbol_table_find(
        index.types,
        syntax_text(syntax_aggregate_type_node(aggregate)));
    if declaration == 0 { return -1; }
    return m13_field_offset_from(
        syntax_struct_first_field(declaration), name, 0, 0);
}

@export

let elaborator_field_offset_indexed = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let base_type: i32 = m13_expr_type_node(
        index, root, function, syntax_left(node), body_start, stop);
    let declaration: i32 = m11_symbol_table_find(
        index.types, syntax_text(base_type));
    if declaration == 0 { return -1; }
    return m13_field_offset_from(
        syntax_struct_first_field(declaration),
        syntax_text(syntax_right(node)), 0, 0);
}

let m13_enum_declaration = std::func(
    index: M13ElaborationIndex, enum_type: i32) -> i32 {
    if syntax_is_call(enum_type) != 1 { return 0; }
    let name_node: i32 = syntax_call_callee(enum_type);
    let declaration: i32 = m11_symbol_table_find_node(
        index.types, name_node);
    if declaration == 0 { return 0; }
    if syntax_is_enum_declaration(declaration) != 1 { return 0; }
    return declaration;
}

let m13_enum_reference_variant = std::func(
    index: M13ElaborationIndex, reference: i32) -> i32 {
    if syntax_is_enum_reference(reference) != 1 { return 0; }
    let declaration: i32 = m13_enum_declaration(
        index, syntax_enum_reference_type(reference));
    if declaration == 0 { return 0; }
    return enum_find_variant(
        syntax_enum_first_variant(declaration),
        syntax_enum_reference_name_node(reference));
}

@export
let elaborator_enum_declaration = std::func(
    index: M13ElaborationIndex, enum_type: i32) -> i32 {
    return m13_enum_declaration(index, enum_type);
}

@export
let elaborator_enum_reference_variant = std::func(
    index: M13ElaborationIndex, reference: i32) -> i32 {
    return m13_enum_reference_variant(index, reference);
}

let m13_match_next_arm = std::func(arm: i32) -> i32 {
    if arm == 0 { return 0; }
    let next: i32 = syntax_next(arm);
    if syntax_is_atom_text(next, ",") == 1 {
        return syntax_next(next);
    }
    return next;
}

let m13_match_pattern_variant = std::func(
    index: M13ElaborationIndex, pattern: i32) -> i32 {
    if syntax_match_pattern_is_wildcard(pattern) == 1 { return -1; }
    return m13_enum_reference_variant(index, pattern);
}

let m13_match_variant_precedes = std::func(
    index: M13ElaborationIndex, arm: i32,
    stop: i32, variant: i32) -> i32 {
    if arm == 0 { return 0; }
    if arm == stop { return 0; }
    if syntax_match_arm_is_valid_shape(arm) == 1 {
        let old: i32 = m13_match_pattern_variant(
            index, syntax_match_arm_pattern(arm));
        if old == variant { return 1; }
    }
    return m13_match_variant_precedes(
        index, m13_match_next_arm(arm), stop, variant);
}

let m13_match_shape_diagnostic = std::func(
    index: M13ElaborationIndex, declaration: i32,
    first: i32, arm: i32, covered: i32) -> i32 {
    if arm == 0 {
        if covered != enum_declaration_variant_count(declaration) {
            return 3012;
        }
        return 0;
    }
    if syntax_match_arm_is_valid_shape(arm) != 1 { return 3011; }
    let pattern: i32 = syntax_match_arm_pattern(arm);
    if syntax_match_pattern_is_wildcard(pattern) == 1 {
        if m13_match_next_arm(arm) != 0 { return 3013; }
        return 0;
    }
    let pattern_declaration: i32 = m13_enum_declaration(
        index, syntax_enum_reference_type(pattern));
    if pattern_declaration != declaration { return 3011; }
    let variant: i32 = m13_enum_reference_variant(index, pattern);
    if variant == 0 { return 3011; }
    if m13_match_variant_precedes(index, first, arm, variant) == 1 {
        return 3011;
    }
    let declared_payload: i32 = syntax_enum_variant_payload(variant);
    let pattern_payload: i32 = syntax_enum_reference_payload(pattern);
    if declared_payload == 0 {
        if pattern_payload != 0 { return 3011; }
    }
    if declared_payload != 0 {
        if pattern_payload == 0 { return 3011; }
        if syntax_arg_count(pattern_payload) != 1 { return 3011; }
        if syntax_is_identifier(pattern_payload) != 1 { return 3011; }
        if syntax_is_atom_text(pattern_payload, "_") == 1 { return 3011; }
    }
    return m13_match_shape_diagnostic(
        index, declaration, first, m13_match_next_arm(arm),
        covered + 1);
}

let m13_match_arm_binding = std::func(
    index: M13ElaborationIndex, arm: i32) -> i32 {
    let pattern: i32 = syntax_match_arm_pattern(arm);
    if syntax_match_pattern_is_wildcard(pattern) == 1 { return 0; }
    let variant: i32 = m13_enum_reference_variant(index, pattern);
    if variant == 0 { return 0; }
    if syntax_enum_variant_payload(variant) == 0 { return 0; }
    return syntax_enum_reference_payload(pattern);
}

let m13_match_arm_type_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    arm: i32, body_start: i32, stop: i32) -> i32 {
    let value: i32 = syntax_match_arm_value(arm);
    let binding: i32 = m13_match_arm_binding(index, arm);
    if binding != 0 {
        if syntax_identifier_equal(binding, value) == 1 {
            let pattern: i32 = syntax_match_arm_pattern(arm);
            let declaration: i32 = m13_enum_declaration(
                index, syntax_enum_reference_type(pattern));
            let variant: i32 = m13_enum_reference_variant(index, pattern);
            return enum_concrete_payload_type(
                declaration, variant,
                syntax_enum_reference_type(pattern));
        }
    }
    return m13_expr_type_node(
        index, root, function, value, body_start, stop);
}

let m13_match_result_type_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    match_node: i32, body_start: i32, stop: i32) -> i32 {
    let arm: i32 = syntax_match_first_arm(match_node);
    if arm == 0 { return 0; }
    return m13_match_arm_type_node(
        index, root, function, arm, body_start, stop);
}

let m13_expr_type_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 10 { return syntax_aggregate_type_node(node); }
    if tag == 21 { return syntax_enum_reference_type(node); }
    if tag == 22 {
        return m13_match_result_type_node(
            index, root, function, node, body_start, stop);
    }
    if tag == 2 {
        let local: i32 = surface_find_visible_local_node(
            function, stop, node);
        if local != 0 {
            let declared: i32 = syntax_local_type_node(local);
            if declared != 0 { return declared; }
            return m13_expr_type_node(
                index, root, function,
                syntax_local_value_node(local), body_start, local);
        }
        let param: i32 = syntax_find_param_node(
            syntax_function_first_param(function), node);
        if param == 0 { return 0; }
        return syntax_param_type_node(param);
    }
    if tag == 4 {
        let callee: i32 = m13_find_node(
            index, syntax_call_callee(node));
        if callee == 0 { return 0; }
        return syntax_right(syntax_function_signature(callee));
    }
    if tag == 11 {
        let base_type: i32 = m13_expr_type_node(
            index, root, function, syntax_left(node),
            body_start, stop);
        return m13_struct_field_type(
            index, base_type, syntax_text(syntax_right(node)));
    }
    return 0;
}

@export
let elaborator_expr_type_node_indexed = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    return m13_expr_type_node(
        index, root, function, node, body_start, stop);
}

let elaborator_name_type = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    body_start: i32, stop: i32, reference: i32) -> i32 {
    let local: i32 = surface_find_visible_local_node(
        function, stop, reference);
    if local != 0 {
        let binding: i32 = syntax_local_binding(local);
        return elaborator_expr_type_indexed_impl(
            index, root, function, syntax_local_value_node(local), body_start, local);
    }
    let param: i32 = syntax_find_param_node(
        syntax_function_first_param(function), reference);
    if param == 0 { return type_error(); }
    let param_type: i32 = type_from_syntax(syntax_param_type_node(param));
    if type_is_comptime(param_type) == 1 {
        return type_comptime_argument(param_type);
    }
    return param_type;
}

let elaborator_type_value_id_from_name = std::func(name: addr) -> i32 {
    if syntax_text_equal(name, "i32") == 1 { return type_i32(); }
    if syntax_text_equal(name, "bool") == 1 { return type_bool(); }
    if syntax_text_equal(name, "addr") == 1 { return type_addr(); }
    if syntax_text_equal(name, "unit") == 1 { return type_unit(); }
    if syntax_text_equal(name, "type") == 1 { return type_type(); }
    return 0;
}

let elaborator_type_value_id = std::func(node: i32) -> i32 {
    if syntax_is_identifier(node) != 1 { return 0; }
    return elaborator_type_value_id_from_name(syntax_text(node));
}

let elaborator_generic_bound_type = std::func(
    param: i32, arg: i32, target: addr) -> i32 {
    if param == 0 { return 0; }
    if syntax_path_tail_is(syntax_param_type_node(param), "type") == 1 {
        if syntax_text_equal(
            syntax_text(syntax_param_name_node(param)), target) == 1 {
            return elaborator_type_value_id(arg);
        }
    }
    return elaborator_generic_bound_type(
        syntax_param_next(param), syntax_arg_next(arg), target);
}

let elaborator_generic_return_type = std::func(
    callee: i32, args: i32) -> i32 {
    let return_node: i32 = syntax_right(
        syntax_function_signature(callee));
    if syntax_is_identifier(return_node) == 1 {
        let bound: i32 = elaborator_generic_bound_type(
            syntax_function_first_param(callee), args,
            syntax_text(return_node));
        if bound != 0 { return bound; }
    }
    return type_from_syntax(return_node);
}

@export

let elaborator_name_visible = std::func(function: i32, body_start: i32, stop: i32, name: addr) -> i32 {
    return elaborator_name_visible_impl(function, body_start, stop, name);
}

@export

let elaborator_name_is_local = std::func(function: i32, stop: i32, name: addr) -> i32 {
    if surface_find_visible_local(function, stop, name) != 0 { return 1; }
    return 0;
}

@export
let elaborator_name_node_is_local = std::func(
    function: i32, stop: i32, reference: i32) -> i32 {
    if surface_find_visible_local_node(
        function, stop, reference) != 0 { return 1; }
    return 0;
}

let elaborator_expr_type_indexed_impl = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    if syntax_is_consteval_call(node) == 1 {
        return elaborator_expr_type_indexed_impl(
            index, root, function, syntax_consteval_operand(node),
            body_start, stop);
    }
    let tag: i32 = syntax_expr_tag(node);
    if tag == 1 { return type_i32(); }
    if tag == 2 {
        return elaborator_name_type(
            index, root, function, body_start, stop, node);
    }
    if tag == 3 { return type_i32(); }
    if tag == 4 {
        let callee: i32 = m13_find_node(
            index, syntax_call_callee(node));
        if callee == 0 { return type_error(); }
        if syntax_function_is_generic(callee) == 1 {
            return elaborator_generic_return_type(
                callee, syntax_call_first_arg(node));
        }
        return elaborator_function_return_type(callee);
    }
    if tag == 5 { return type_bool(); }
    if tag == 8 { return type_bool(); }
    if tag == 12 { return type_bool(); }
    if tag == 13 { return type_bool(); }
    if tag == 14 { return type_bool(); }
    if tag == 15 { return type_bool(); }
    if tag == 16 { return type_i32(); }
    if tag == 17 { return type_i32(); }
    if tag == 18 { return type_i32(); }
    if tag == 6 {
        return elaborator_expr_type_indexed_impl(index, root, function, syntax_if_then_expr(node), body_start, stop);
    }
    if tag == 7 { return type_addr(); }
    if tag == 10 { return type_addr(); }
    if tag == 21 { return type_addr(); }
    if tag == 22 {
        return type_from_syntax(m13_match_result_type_node(
            index, root, function, node, body_start, stop));
    }
    if tag == 11 {
        return type_from_syntax(m13_expr_type_node(
            index, root, function, node, body_start, stop));
    }
    if tag == 19 { return type_unit(); }
    if tag == 20 {
        let member: addr = syntax_interface_member_name(node);
        if syntax_text_equal(member, "make_dyn") == 1 {
            return type_addr();
        }
        if syntax_text_equal(member, "make_vtable") == 1 {
            return type_addr();
        }
        let callee: i32 = elaborator_interface_callee(index, root, node);
        if callee == 0 { return type_error(); }
        return elaborator_function_return_type(callee);
    }
    return type_error();
}

let elaborator_validate_interface_call = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    if syntax_text_equal(
        surface_interface_type_name(root),
        syntax_interface_base_name(node)) != 1 { return 2301; }
    let member: addr = syntax_interface_member_name(node);
    let args: i32 = syntax_interface_first_arg(node);
    if syntax_text_equal(member, "make_vtable") == 1 {
        if syntax_arg_count(args) != 0 { return 2303; }
        return 0;
    }
    if syntax_text_equal(member, "make_dyn") == 1 {
        if syntax_arg_count(args) != 2 { return 2303; }
        let first_code: i32 = elaborator_validate_expr(
            index, root, function, args, body_start, stop);
        if first_code != 0 { return first_code; }
        let table: i32 = syntax_arg_next(args);
        if syntax_expr_tag(table) != 20 { return 2304; }
        if syntax_text_equal(
            syntax_interface_member_name(table),
            "make_vtable") != 1 { return 2304; }
        return 0;
    }
    let callee: i32 = elaborator_interface_callee(index, root, node);
    if callee == 0 { return 2301; }
    if syntax_arg_count(args) != syntax_param_count(
        syntax_function_first_param(callee)) { return 2303; }
    return elaborator_validate_args(
        index, root, function, args,
        syntax_function_first_param(callee), body_start, stop);
}

let elaborator_validate_aggregate_fields = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    field: i32, body_start: i32, stop: i32) -> i32 {
    if field == 0 { return 0; }
    if syntax_is_atom_text(field, ",") == 1 {
        return elaborator_validate_aggregate_fields(
            index, root, function, syntax_next(field),
            body_start, stop);
    }
    if syntax_is_infix(field, ":") != 1 { return 2601; }
    if syntax_is_identifier(
        syntax_aggregate_field_name_node(field)) != 1 { return 2601; }
    let code: i32 = elaborator_validate_expr(
        index, root, function,
        syntax_aggregate_field_value(field), body_start, stop);
    if code != 0 { return code; }
    return elaborator_validate_aggregate_fields(
        index, root, function, syntax_next(field), body_start, stop);
}

let m13_is_numeric_binary_tag = std::func(tag: i32) -> i32 {
    if tag == 12 { return 1; }
    if tag == 13 { return 1; }
    if tag == 14 { return 1; }
    if tag == 15 { return 1; }
    if tag == 16 { return 1; }
    if tag == 17 { return 1; }
    return 0;
}

@export

let elaborator_expr_type = std::func(root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let index: M13ElaborationIndex = m13_index_new(root);
    let result: i32 = elaborator_expr_type_indexed_impl(
        index, root, function, node, body_start, stop);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let elaborator_expr_type_indexed = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    return elaborator_expr_type_indexed_impl(
        index, root, function, node, body_start, stop);
}

let elaborator_validate_args = std::func(index: M13ElaborationIndex, root: i32, function: i32, arg: i32, param: i32, body_start: i32, stop: i32) -> i32 {
    if arg == 0 { return 0; }
    let code: i32 = elaborator_validate_expr(index, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    let expected: i32 = type_from_syntax(syntax_param_type_node(param));
    if elaborator_expr_type_indexed_impl(index, root, function, arg, body_start, stop) != expected { return 2304; }
    return elaborator_validate_args(
        index, root, function, syntax_arg_next(arg), syntax_param_next(param), body_start, stop);
}

let elaborator_validate_generic_args = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    arg: i32, param: i32, body_start: i32, stop: i32,
    type_name: addr, type_id: i32) -> i32 {
    if arg == 0 { return 0; }
    let param_type_node: i32 = syntax_param_type_node(param);
    if syntax_path_tail_is(param_type_node, "type") == 1 {
        let argument_type: i32 = elaborator_type_value_id(arg);
        if argument_type == 0 {
            if syntax_is_identifier(arg) != 1 { return 2810; }
            let caller_param: i32 = syntax_find_param_node(
                syntax_function_first_param(function), arg);
            if caller_param == 0 { return 2810; }
            if syntax_path_tail_is(
                syntax_param_type_node(caller_param), "type") != 1 {
                return 2810;
            }
            return elaborator_validate_generic_args(
                index, root, function, syntax_arg_next(arg),
                syntax_param_next(param), body_start, stop,
                syntax_text(syntax_param_name_node(param)), type_addr());
        }
        return elaborator_validate_generic_args(
            index, root, function, syntax_arg_next(arg),
            syntax_param_next(param), body_start, stop,
            syntax_text(syntax_param_name_node(param)), argument_type);
    }
    let code: i32 = elaborator_validate_expr(
        index, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    let expected: i32 = type_from_syntax(param_type_node);
    if syntax_is_atom_text(param_type_node, type_name) == 1 {
        if elaborator_expr_type_indexed_impl(
            index, root, function, arg, body_start, stop) != type_id {
            return 2812;
        }
    }
    if syntax_is_atom_text(param_type_node, type_name) != 1 {
        if type_is_comptime(expected) == 1 {
            if syntax_is_i32_atom(arg) != 1 {
                if syntax_is_identifier(arg) != 1 { return 2802; }
                let caller_param: i32 = syntax_find_param_node(
                    syntax_function_first_param(function), arg);
                if caller_param == 0 { return 2802; }
                let caller_type: i32 = type_from_syntax(
                    syntax_param_type_node(caller_param));
                if caller_type != expected { return 2812; }
            }
            if type_comptime_argument(expected) != type_i32() {
                return 2813;
            }
        }
        if type_is_comptime(expected) != 1 {
            if elaborator_expr_type_indexed_impl(
                index, root, function, arg, body_start, stop) != expected {
                return 2812;
            }
        }
    }
    return elaborator_validate_generic_args(
        index, root, function, syntax_arg_next(arg),
        syntax_param_next(param), body_start, stop,
        type_name, type_id);
}

let elaborator_validate_call = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    if index.duplicate != 0 { return 2302; }
    let callee: i32 = m13_find_node(
        index, syntax_call_callee(node));
    if callee == 0 { return 2301; }
    let args: i32 = syntax_call_first_arg(node);
    if syntax_arg_count(args) != syntax_param_count(syntax_function_first_param(callee)) {
        return 2303;
    }
    if syntax_function_is_generic(callee) == 1 {
        return elaborator_validate_generic_args(
            index, root, function, args,
            syntax_function_first_param(callee), body_start, stop, "", 0);
    }
    return elaborator_validate_args(
        index, root, function, args, syntax_function_first_param(callee), body_start, stop);
}

let elaborator_consteval_dependency_code = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 2 { return 2803; }
    if tag == 4 {
        if syntax_call_namespace(node) != 0 { return 2805; }
        let arg: i32 = syntax_call_first_arg(node);
        return elaborator_consteval_args_dependency_code(
            index, root, function, arg, body_start, stop);
    }
    if tag == 3 {
        let left: i32 = elaborator_consteval_dependency_code(
            index, root, function, syntax_left(node), body_start, stop);
        if left != 0 { return left; }
        return elaborator_consteval_dependency_code(
            index, root, function, syntax_right(node), body_start, stop);
    }
    if tag == 5 {
        let left: i32 = elaborator_consteval_dependency_code(
            index, root, function, syntax_left(node), body_start, stop);
        if left != 0 { return left; }
        return elaborator_consteval_dependency_code(
            index, root, function, syntax_right(node), body_start, stop);
    }
    if tag == 8 {
        let left: i32 = elaborator_consteval_dependency_code(
            index, root, function, syntax_left(node), body_start, stop);
        if left != 0 { return left; }
        return elaborator_consteval_dependency_code(
            index, root, function, syntax_right(node), body_start, stop);
    }
    if m13_is_numeric_binary_tag(tag) == 1 {
        let left: i32 = elaborator_consteval_dependency_code(
            index, root, function, syntax_left(node), body_start, stop);
        if left != 0 { return left; }
        return elaborator_consteval_dependency_code(
            index, root, function, syntax_right(node), body_start, stop);
    }
    return 2803;
}

let elaborator_consteval_args_dependency_code = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    arg: i32, body_start: i32, stop: i32) -> i32 {
    if arg == 0 { return 0; }
    let code: i32 = elaborator_consteval_dependency_code(
        index, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    return elaborator_consteval_args_dependency_code(
        index, root, function, syntax_arg_next(arg), body_start, stop);
}

let elaborator_validate_if = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    let condition: i32 = syntax_if_condition(node);
    let condition_code: i32 = elaborator_validate_expr(index, root, function, condition, body_start, stop);
    if condition_code != 0 { return condition_code; }
    if elaborator_expr_type_indexed_impl(index, root, function, condition, body_start, stop) != type_bool() { return 2401; }
    let then_expr: i32 = syntax_if_then_expr(node);
    let else_expr: i32 = syntax_if_else_expr(node);
    if then_expr == 0 { return 2403; }
    if else_expr == 0 { return 2403; }
    if syntax_next(then_expr) != 0 { return 2403; }
    if syntax_next(else_expr) != 0 { return 2403; }
    if syntax_expr_tag(then_expr) == 6 { return 2405; }
    if syntax_expr_tag(else_expr) == 6 { return 2405; }
    let then_code: i32 = elaborator_validate_expr(index, root, function, then_expr, body_start, stop);
    if then_code != 0 { return then_code; }
    let else_code: i32 = elaborator_validate_expr(index, root, function, else_expr, body_start, stop);
    if else_code != 0 { return else_code; }
    let then_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, then_expr, body_start, stop);
    let else_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, else_expr, body_start, stop);
    if then_type == type_error() { return 2402; }
    if type_same(then_type, else_type) != 1 { return 2402; }
    return 0;
}

let elaborator_validate_enum_reference = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let declaration: i32 = m13_enum_declaration(
        index, syntax_enum_reference_type(node));
    if declaration == 0 { return 3010; }
    let variant: i32 = m13_enum_reference_variant(index, node);
    if variant == 0 { return 3011; }
    let expected: i32 = syntax_enum_variant_payload(variant);
    let argument: i32 = syntax_enum_reference_payload(node);
    if expected == 0 {
        if argument != 0 { return 2812; }
        return 0;
    }
    if argument == 0 { return 2812; }
    if syntax_arg_count(argument) != 1 { return 2812; }
    let code: i32 = elaborator_validate_expr(
        index, root, function, argument, body_start, stop);
    if code != 0 { return code; }
    let expected_type_node: i32 = enum_concrete_payload_type(
        declaration, variant, syntax_enum_reference_type(node));
    let expected_type: i32 = type_from_syntax(expected_type_node);
    let actual_type: i32 = elaborator_expr_type_indexed_impl(
        index, root, function, argument, body_start, stop);
    if expected_type == type_error() { return 2812; }
    if type_same(expected_type, actual_type) != 1 { return 2812; }
    return 0;
}

let elaborator_validate_match_arms = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    arm: i32, body_start: i32, stop: i32,
    result_type: i32) -> i32 {
    if arm == 0 { return 0; }
    let value: i32 = syntax_match_arm_value(arm);
    let binding: i32 = m13_match_arm_binding(index, arm);
    if binding == 0 {
        let code: i32 = elaborator_validate_expr(
            index, root, function, value, body_start, stop);
        if code != 0 { return code; }
    }
    if binding != 0 {
        if syntax_identifier_equal(binding, value) != 1 {
            let code: i32 = elaborator_validate_expr(
                index, root, function, value, body_start, stop);
            if code != 0 { return code; }
        }
    }
    let arm_type_node: i32 = m13_match_arm_type_node(
        index, root, function, arm, body_start, stop);
    let arm_type: i32 = type_from_syntax(arm_type_node);
    if arm_type == type_error() { return 3014; }
    if result_type != 0 {
        if type_same(result_type, arm_type) != 1 { return 3014; }
    }
    if result_type == 0 {
        return elaborator_validate_match_arms(
            index, root, function, m13_match_next_arm(arm),
            body_start, stop, arm_type);
    }
    return elaborator_validate_match_arms(
        index, root, function, m13_match_next_arm(arm),
        body_start, stop, result_type);
}

let elaborator_validate_match = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let target: i32 = syntax_match_target(node);
    let target_code: i32 = elaborator_validate_expr(
        index, root, function, target, body_start, stop);
    if target_code != 0 { return target_code; }
    let enum_type: i32 = m13_expr_type_node(
        index, root, function, target, body_start, stop);
    let declaration: i32 = m13_enum_declaration(index, enum_type);
    if declaration == 0 { return 3010; }
    let first: i32 = syntax_match_first_arm(node);
    if first == 0 { return 3012; }
    let shape: i32 = m13_match_shape_diagnostic(
        index, declaration, first, first, 0);
    if shape != 0 { return shape; }
    return elaborator_validate_match_arms(
        index, root, function, first, body_start, stop, 0);
}

let elaborator_validate_expr = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32, stop: i32) -> i32 {
    if syntax_is_std_call(node, "consteval") == 1 {
        if syntax_is_consteval_call(node) != 1 { return 2802; }
        let operand: i32 = syntax_consteval_operand(node);
        let dependency: i32 = elaborator_consteval_dependency_code(
            index, root, function, operand, body_start, stop);
        if dependency != 0 { return dependency; }
        return elaborator_validate_expr(
            index, root, function, operand, body_start, stop);
    }
    let tag: i32 = syntax_expr_tag(node);
    if tag == 21 {
        return elaborator_validate_enum_reference(
            index, root, function, node, body_start, stop);
    }
    if tag == 22 {
        return elaborator_validate_match(
            index, root, function, node, body_start, stop);
    }
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 19 {
        if syntax_text_equal(
            syntax_macro_name(node), "println") != 1 { return 2701; }
        if surface_has_std_io_import(root) != 1 { return 2702; }
        let argument: i32 = syntax_macro_first_arg(node);
        if syntax_arg_count(argument) != 1 { return 2703; }
        if syntax_is_string_atom(argument) != 1 { return 2704; }
        return 0;
    }
    if tag == 20 {
        return elaborator_validate_interface_call(
            index, root, function, node, body_start, stop);
    }
    if tag == 10 {
        return elaborator_validate_aggregate_fields(
            index, root, function,
            syntax_aggregate_first_field(node), body_start, stop);
    }
    if tag == 11 {
        return elaborator_validate_expr(
            index, root, function, syntax_left(node), body_start, stop);
    }
    if tag == 2 {
        if elaborator_name_visible_node_impl(
            function, body_start, stop, node) == 1 { return 0; }
        return 2003;
    }
    if tag == 3 {
        let left_code: i32 = elaborator_validate_expr(index, root, function, syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = elaborator_validate_expr(index, root, function, syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        if elaborator_expr_type_indexed_impl(index, root, function, syntax_left(node), body_start, stop) != type_i32() { return 2201; }
        if elaborator_expr_type_indexed_impl(index, root, function, syntax_right(node), body_start, stop) != type_i32() { return 2201; }
        return 0;
    }
    if tag == 4 { return elaborator_validate_call(index, root, function, node, body_start, stop); }
    if tag == 5 {
        let left_code: i32 = elaborator_validate_expr(index, root, function, syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = elaborator_validate_expr(index, root, function, syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, syntax_left(node), body_start, stop);
        let right_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, syntax_right(node), body_start, stop);
        if left_type == type_error() { return 2202; }
        if type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 8 {
        let left_code: i32 = elaborator_validate_expr(index, root, function, syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = elaborator_validate_expr(index, root, function, syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, syntax_left(node), body_start, stop);
        let right_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, syntax_right(node), body_start, stop);
        if left_type == type_error() { return 2202; }
        if type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if m13_is_numeric_binary_tag(tag) == 1 {
        let left_code: i32 = elaborator_validate_expr(
            index, root, function, syntax_left(node),
            body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = elaborator_validate_expr(
            index, root, function, syntax_right(node),
            body_start, stop);
        if right_code != 0 { return right_code; }
        if elaborator_expr_type_indexed_impl(
            index, root, function, syntax_left(node),
            body_start, stop) != type_i32() { return 2201; }
        if elaborator_expr_type_indexed_impl(
            index, root, function, syntax_right(node),
            body_start, stop) != type_i32() { return 2201; }
        return 0;
    }
    if tag == 18 {
        let code: i32 = elaborator_validate_expr(
            index, root, function, syntax_prefix_operand(node),
            body_start, stop);
        if code != 0 { return code; }
        if elaborator_expr_type_indexed_impl(
            index, root, function, syntax_prefix_operand(node),
            body_start, stop) != type_i32() { return 2201; }
        return 0;
    }
    if tag == 6 { return elaborator_validate_if(index, root, function, node, body_start, stop); }
    if syntax_kind(node) == 1 { return 2002; }
    return 2001;
}

let elaborator_validate_body = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = syntax_form_tag(node);
    if form_tag == 1 { return elaborator_validate_body(index, root, function, syntax_next(node), body_start); }
    if form_tag == 2 {
        let binding: i32 = syntax_local_binding(node);
        if syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = syntax_local_name_node(node);
        if syntax_is_identifier(name_node) != 1 { return 2101; }
        if elaborator_name_visible_node_impl(
            function, body_start, node, name_node) == 1 { return 2102; }
        let value: i32 = syntax_local_value_node(node);
        if syntax_expr_tag(value) == 6 { return 2404; }
        let value_code: i32 = elaborator_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, value, body_start, node);
        if value_type == type_error() { return 2203; }
        let declared_type_node: i32 = syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != type_from_syntax(declared_type_node) { return 2203; }
        }
        return elaborator_validate_body(index, root, function, syntax_next(node), body_start);
    }
    if syntax_next(node) != 0 { return 2104; }
    let result_code: i32 = elaborator_validate_expr(index, root, function, node, body_start, node);
    if result_code != 0 { return result_code; }
    if elaborator_expr_type_indexed_impl(index, root, function, node, body_start, node) != elaborator_function_return_type(function) { return 2204; }
    return 0;
}

let elaborator_only_separators = std::func(node: i32) -> i32 {
    if node == 0 { return 1; }
    if syntax_form_tag(node) != 1 { return 0; }
    return elaborator_only_separators(syntax_next(node));
}

let elaborator_validate_statement_block = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let form_tag: i32 = syntax_form_tag(node);
    if form_tag == 1 {
        return elaborator_validate_statement_block(
            index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let binding: i32 = syntax_local_binding(node);
        if syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = syntax_local_name_node(node);
        if syntax_is_identifier(name_node) != 1 { return 2101; }
        if elaborator_name_visible_node_impl(
            function, body_start, node, name_node) == 1 {
            return 2102;
        }
        let value: i32 = syntax_local_value_node(node);
        let value_code: i32 = elaborator_validate_expr(
            index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = elaborator_expr_type_indexed_impl(
            index, root, function, value, body_start, node);
        if value_type == type_error() { return 2203; }
        let declared_type_node: i32 = syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != type_from_syntax(declared_type_node) { return 2203; }
        }
        return elaborator_validate_statement_block(
            index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = elaborator_validate_expr(
            index, root, function, node, body_start, node);
        if code != 0 { return code; }
        return elaborator_validate_statement_block(
            index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = syntax_return_expr(node);
        let value_code: i32 = elaborator_validate_expr(
            index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if elaborator_expr_type_indexed_impl(index, root, function, value, body_start, node) !=
            elaborator_function_return_type(function) { return 2204; }
        if elaborator_only_separators(syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = syntax_if_statement_condition(node);
        let condition_code: i32 = elaborator_validate_expr(
            index, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if elaborator_expr_type_indexed_impl(index, root, function, condition, body_start, node) !=
            type_bool() { return 2401; }
        let branch: i32 = syntax_left(syntax_if_statement_body(node));
        let branch_code: i32 = elaborator_validate_statement_block(
            index, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return elaborator_validate_statement_block(
            index, root, function, syntax_next(node), body_start);
    }
    return 2502;
}

let elaborator_validate_declared_body = std::func(index: M13ElaborationIndex, root: i32, function: i32, node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = syntax_form_tag(node);
    if form_tag == 1 {
        return elaborator_validate_declared_body(index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let binding: i32 = syntax_local_binding(node);
        if syntax_is_infix(binding, "=") != 1 { return 2101; }
        let name_node: i32 = syntax_local_name_node(node);
        if syntax_is_identifier(name_node) != 1 { return 2101; }
        if elaborator_name_visible_node_impl(
            function, body_start, node, name_node) == 1 { return 2102; }
        let value: i32 = syntax_local_value_node(node);
        let value_code: i32 = elaborator_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = elaborator_expr_type_indexed_impl(index, root, function, value, body_start, node);
        if value_type == type_error() { return 2203; }
        let declared_type_node: i32 = syntax_local_type_node(node);
        if declared_type_node != 0 {
            if value_type != type_from_syntax(declared_type_node) { return 2203; }
        }
        return elaborator_validate_declared_body(index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = elaborator_validate_expr(
            index, root, function, node, body_start, node);
        if code != 0 { return code; }
        // A canonical func body may use its final expression as the result.
        if elaborator_only_separators(syntax_next(node)) == 1 {
            if elaborator_expr_type_indexed_impl(
                index, root, function, node, body_start, node) !=
                elaborator_function_return_type(function) { return 2204; }
            return 0;
        }
        return elaborator_validate_declared_body(
            index, root, function, syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = syntax_return_expr(node);
        let value_code: i32 = elaborator_validate_expr(index, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if elaborator_expr_type_indexed_impl(index, root, function, value, body_start, node) != elaborator_function_return_type(function) { return 2204; }
        if elaborator_only_separators(syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = syntax_if_statement_condition(node);
        let condition_code: i32 = elaborator_validate_expr(index, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if elaborator_expr_type_indexed_impl(index, root, function, condition, body_start, node) != type_bool() { return 2401; }
        let branch: i32 = syntax_left(syntax_if_statement_body(node));
        let branch_code: i32 = elaborator_validate_statement_block(index, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return elaborator_validate_declared_body(index, root, function, syntax_next(node), body_start);
    }
    return 2502;
}

let elaborator_validate_param_names = std::func(param: i32) -> i32 {
    if param == 0 { return 0; }
    let name: addr = syntax_text(syntax_param_name_node(param));
    if syntax_param_named(syntax_param_next(param), name) == 1 { return 2110; }
    return elaborator_validate_param_names(syntax_param_next(param));
}

let elaborator_specialization_depth = std::func(
    index: M13ElaborationIndex, function: i32,
    origin: addr, depth: i32) -> i32 {
    if syntax_function_is_generic(function) != 1 { return 0; }
    let body: i32 = syntax_function_body(function);
    let form: i32 = syntax_left(body);
    let value: i32 = syntax_return_expr(form);
    if syntax_expr_tag(value) != 4 { return 0; }
    let callee: i32 = m13_find_node(
        index, syntax_call_callee(value));
    if callee == 0 { return 0; }
    if syntax_function_is_generic(callee) != 1 { return 0; }
    if syntax_text_equal(syntax_function_name(callee), origin) == 1 {
        return 0;
    }
    if depth >= 128 { return 2811; }
    return elaborator_specialization_depth(
        index, callee, origin, depth + 1);
}

let elaborator_validate_function_semantics = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    let name: addr = syntax_function_name(function);
    if index.duplicate != 0 { return 2111; }
    let param_code: i32 = elaborator_validate_param_names(syntax_function_first_param(function));
    if param_code != 0 { return param_code; }
    let depth_code: i32 = elaborator_specialization_depth(
        index, function, name, 1);
    if depth_code != 0 { return depth_code; }
    let body: i32 = syntax_function_body(function);
    let first: i32 = syntax_left(body);
    return elaborator_validate_declared_body(index, root, function, first, first);
}

let elaborator_validate_functions = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    let code: i32 = elaborator_validate_function_semantics(index, root, function);
    if code != 0 { return code; }
    return elaborator_validate_functions(index, root, surface_next_definition(function));
}

let diagnostic_function = std::func(index: M13ElaborationIndex, root: i32, function: i32) -> addr {
    if function == 0 { return ""; }
    if elaborator_validate_function_semantics(index, root, function) != 0 {
        return syntax_function_name(function);
    }
    return diagnostic_function(index, root, surface_next_definition(function));
}

let diagnostic_function_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    if elaborator_validate_function_semantics(index, root, function) != 0 {
        return function;
    }
    return diagnostic_function_node(
        index, root, surface_next_definition(function));
}

let m13_declared_failure_node = std::func(
    index: M13ElaborationIndex, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let tag: i32 = syntax_form_tag(node);
    if tag == 1 {
        return m13_declared_failure_node(
            index, root, function, syntax_next(node), body_start);
    }
    if tag == 2 {
        let value: i32 = syntax_local_value_node(node);
        if elaborator_validate_expr(
            index, root, function, value, body_start, node) != 0 {
            return node;
        }
        let actual: i32 = elaborator_expr_type_indexed_impl(
            index, root, function, value, body_start, node);
        let declared: i32 = syntax_local_type_node(node);
        if actual == type_error() { return node; }
        if declared != 0 {
            if actual != type_from_syntax(declared) { return node; }
        }
        return m13_declared_failure_node(
            index, root, function, syntax_next(node), body_start);
    }
    if tag == 3 {
        if elaborator_validate_expr(
            index, root, function, node, body_start, node) != 0 {
            return node;
        }
        return m13_declared_failure_node(
            index, root, function, syntax_next(node), body_start);
    }
    if tag == 4 {
        let value: i32 = syntax_return_expr(node);
        if elaborator_validate_expr(
            index, root, function, value, body_start, node) != 0 {
            return node;
        }
        if elaborator_expr_type_indexed_impl(
            index, root, function, value, body_start, node) !=
            elaborator_function_return_type(function) { return node; }
        return 0;
    }
    if tag == 5 {
        let condition: i32 = syntax_if_statement_condition(node);
        if elaborator_validate_expr(
            index, root, function, condition, body_start, node) != 0 {
            return node;
        }
        let branch: i32 = syntax_left(
            syntax_if_statement_body(node));
        if elaborator_validate_statement_block(
            index, root, function, branch, branch) != 0 { return node; }
        return m13_declared_failure_node(
            index, root, function, syntax_next(node), body_start);
    }
    return node;
}

let m13_failure_statement_from = std::func(
    index: M13ElaborationIndex, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    if elaborator_validate_function_semantics(index, root, function) != 0 {
        let body: i32 = syntax_function_body(function);
        let first: i32 = syntax_left(body);
        return m13_declared_failure_node(
            index, root, function, first, first);
    }
    return m13_failure_statement_from(
        index, root, surface_next_definition(function));
}

@export

let elaborator_diagnostic_statement_line = std::func(root: i32) -> i32 {
    if surface_validate_program(root) != 0 { return 0; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let node: i32 = m13_failure_statement_from(
        index, root, module_first_procedure(root));
    let line: i32 = syntax_line(node);
    let destroyed: i32 = m13_index_destroy(index);
    return line;
}

@export

let elaborator_diagnostic_statement_code = std::func(root: i32) -> i32 {
    if surface_validate_program(root) != 0 {
        return surface_validate_program(root);
    }
    let index: M13ElaborationIndex = m13_index_new(root);
    let function: i32 = diagnostic_function_node(
        index, root, module_first_procedure(root));
    let body: i32 = syntax_function_body(function);
    let first: i32 = syntax_left(body);
    let node: i32 = m13_declared_failure_node(
        index, root, function, first, first);
    let tag: i32 = syntax_form_tag(node);
    if tag == 2 {
        let value: i32 = syntax_local_value_node(node);
        let code: i32 = elaborator_validate_expr(
            index, root, function, value, first, node);
        if code != 0 {
            let destroyed_error: i32 = m13_index_destroy(index);
            return code;
        }
        let destroyed_mismatch: i32 = m13_index_destroy(index);
        return 2203;
    }
    let result: i32 = elaborator_validate_function_semantics(
        index, root, function);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let elaborator_diagnostic_function_line = std::func(root: i32) -> i32 {
    if surface_validate_program(root) != 0 { return 0; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let node: i32 = diagnostic_function_node(
        index, root, module_first_procedure(root));
    let line: i32 = syntax_line(node);
    let destroyed: i32 = m13_index_destroy(index);
    return line;
}

@export

let elaborator_diagnostic_function = std::func(root: i32) -> addr {
    if surface_validate_program(root) != 0 { return ""; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let result: addr = diagnostic_function(
        index, root, module_first_procedure(root));
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

@export

let elaborator_validate = std::func(root: i32) -> i32 {
    let syntax_code: i32 = surface_validate_program(root);
    if syntax_code != 0 { return syntax_code; }
    let binding_code: i32 = elaborator_validate_top_level_bindings(
        surface_first_item(root));
    if binding_code != 0 { return binding_code; }
    let index: M13ElaborationIndex = m13_index_new(root);
    let consteval_code: i32 = elaborator_validate_top_consteval(
        index, root, surface_first_item(root));
    if consteval_code != 0 {
        let destroyed_consteval: i32 = m13_index_destroy(index);
        return consteval_code;
    }
    let result: i32 = elaborator_validate_functions(
        index, root, module_first_procedure(root));
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

// Incremental entry used by named bootstrap compilation.  The selected
// definition is checked completely, including the signatures of every call
// it makes, without revalidating unrelated function bodies in the same
// source closure.
@export
let elaborator_validate_named = std::func(root: i32, name: addr) -> i32 {
    if syntax_kind(root) != 4 { return 1001; }
    let binding_code: i32 = elaborator_validate_top_level_bindings(
        surface_first_item(root));
    if binding_code != 0 { return binding_code; }
    let index: M13ElaborationIndex = m13_index_new(root);
    if index.duplicate != 0 {
        let destroyed_duplicate: i32 = m13_index_destroy(index);
        return 2302;
    }
    let consteval_code: i32 = elaborator_validate_top_consteval(
        index, root, surface_first_item(root));
    if consteval_code != 0 {
        let destroyed_consteval: i32 = m13_index_destroy(index);
        return consteval_code;
    }
    let selected: i32 = m13_find(index, name);
    if selected == 0 {
        let destroyed_missing: i32 = m13_index_destroy(index);
        return 2301;
    }
    if surface_is_procedure_definition(selected) != 1 { return 1002; }
    let syntax_code: i32 = syntax_validate_function(selected);
    if syntax_code != 0 { return syntax_code; }
    let result: i32 = elaborator_validate_function_semantics(index, root, selected);
    let destroyed: i32 = m13_index_destroy(index);
    return result;
}

// M5 module-context elaboration.  Canonical module bodies contain only
// unified let bindings.
let workspace_type_from_syntax = std::func(node: i32) -> i32 {
    if syntax_is_atom_text(node, "i32") == 1 { return type_i32(); }
    if syntax_is_atom_text(node, "addr") == 1 { return type_addr(); }
    return type_error();
}

let workspace_function_return_type = std::func(function: i32) -> i32 {
    return workspace_type_from_syntax(
        syntax_right(syntax_function_signature(function)));
}

let workspace_name_type = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    body_start: i32, stop: i32, reference: i32) -> i32 {
    let local: i32 = surface_find_visible_local_node(
        function, stop, reference);
    if local != 0 {
        return workspace_expr_type(
            workspace, module, root, function,
            syntax_local_value_node(local), body_start, local);
    }
    let param: i32 = syntax_find_param_node(
        syntax_function_first_param(function), reference);
    if param == 0 { return type_error(); }
    return workspace_type_from_syntax(syntax_param_type_node(param));
}

let workspace_member_callee = std::func(
    workspace: ModuleWorkspace, module: i32, node: i32) -> i32 {
    let target: i32 = module_workspace_resolve_alias(
        workspace, module, syntax_member_base_name(node));
    if target == 0 { return 0; }
    return module_find_exported_procedure(
        target, syntax_member_name(node));
}

let workspace_expr_type = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = syntax_expr_tag(node);
    if tag == 1 { return type_i32(); }
    if tag == 7 { return type_addr(); }
    if tag == 2 {
        return workspace_name_type(
            workspace, module, root, function,
            body_start, stop, node);
    }
    if tag == 3 { return type_i32(); }
    if tag == 4 {
        let callee: i32 = module_find_procedure(
            root, syntax_call_name(node));
        if callee == 0 { return type_error(); }
        return workspace_function_return_type(callee);
    }
    if tag == 5 { return type_bool(); }
    if tag == 8 { return type_bool(); }
    if tag == 6 {
        return workspace_expr_type(
            workspace, module, root, function,
            syntax_if_then_expr(node), body_start, stop);
    }
    if tag == 9 {
        let callee: i32 = workspace_member_callee(workspace, module, node);
        if callee == 0 { return type_error(); }
        return workspace_function_return_type(callee);
    }
    return type_error();
}

@export

let elaborator_module_expr_type_indexed = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    return workspace_expr_type(
        workspace, module, root, function, node, body_start, stop);
}

let workspace_validate_args = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    arg: i32, param: i32, body_start: i32, stop: i32) -> i32 {
    if arg == 0 { return 0; }
    let code: i32 = workspace_validate_expr(
        workspace, module, root, function, arg, body_start, stop);
    if code != 0 { return code; }
    let expected: i32 = workspace_type_from_syntax(
        syntax_param_type_node(param));
    if workspace_expr_type(
        workspace, module, root, function, arg, body_start, stop) != expected {
        return 2304;
    }
    return workspace_validate_args(
        workspace, module, root, function,
        syntax_arg_next(arg), syntax_param_next(param),
        body_start, stop);
}

let workspace_validate_local_call = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let name: addr = syntax_call_name(node);
    let matches: i32 = module_procedure_name_count(root, name);
    if matches == 0 { return 2301; }
    if matches != 1 { return 2302; }
    let callee: i32 = module_find_procedure(root, name);
    let args: i32 = syntax_call_first_arg(node);
    if syntax_arg_count(args) != syntax_param_count(
        syntax_function_first_param(callee)) { return 2303; }
    return workspace_validate_args(
        workspace, module, root, function, args,
        syntax_function_first_param(callee), body_start, stop);
}

let workspace_validate_member_call = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let target: i32 = module_workspace_resolve_alias(
        workspace, module, syntax_member_base_name(node));
    if target == 0 { return 4104; }
    let member: addr = syntax_member_name(node);
    let any_binding: i32 = module_find_binding(
        module_first_body_item(target), member);
    if any_binding == 0 { return 4201; }
    if module_summary_has_export(target, member) != 1 { return 4202; }
    let callee: i32 = module_find_exported_procedure(target, member);
    if callee == 0 { return 4203; }
    let args: i32 = syntax_member_first_arg(node);
    if syntax_arg_count(args) != syntax_param_count(
        syntax_function_first_param(callee)) { return 2303; }
    return workspace_validate_args(
        workspace, module, root, function, args,
        syntax_function_first_param(callee), body_start, stop);
}

let workspace_validate_if = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let condition: i32 = syntax_if_condition(node);
    let condition_code: i32 = workspace_validate_expr(
        workspace, module, root, function, condition, body_start, stop);
    if condition_code != 0 { return condition_code; }
    if workspace_expr_type(
        workspace, module, root, function, condition, body_start, stop) !=
        type_bool() { return 2401; }
    let then_expr: i32 = syntax_if_then_expr(node);
    let else_expr: i32 = syntax_if_else_expr(node);
    if then_expr == 0 { return 2403; }
    if else_expr == 0 { return 2403; }
    if syntax_next(then_expr) != 0 { return 2403; }
    if syntax_next(else_expr) != 0 { return 2403; }
    let then_code: i32 = workspace_validate_expr(
        workspace, module, root, function, then_expr, body_start, stop);
    if then_code != 0 { return then_code; }
    let else_code: i32 = workspace_validate_expr(
        workspace, module, root, function, else_expr, body_start, stop);
    if else_code != 0 { return else_code; }
    let then_type: i32 = workspace_expr_type(
        workspace, module, root, function, then_expr, body_start, stop);
    let else_type: i32 = workspace_expr_type(
        workspace, module, root, function, else_expr, body_start, stop);
    if then_type == type_error() { return 2402; }
    if type_same(then_type, else_type) != 1 { return 2402; }
    return 0;
}

let workspace_validate_expr = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let tag: i32 = syntax_expr_tag(node);
    if tag == 1 { return 0; }
    if tag == 7 { return 0; }
    if tag == 2 {
        if elaborator_name_visible_node_impl(
            function, body_start, stop, node) == 1 { return 0; }
        return 2003;
    }
    if tag == 3 {
        let left_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        if workspace_expr_type(
            workspace, module, root, function,
            syntax_left(node), body_start, stop) != type_i32() {
            return 2201;
        }
        if workspace_expr_type(
            workspace, module, root, function,
            syntax_right(node), body_start, stop) != type_i32() {
            return 2201;
        }
        return 0;
    }
    if tag == 4 {
        return workspace_validate_local_call(
            workspace, module, root, function, node, body_start, stop);
    }
    if tag == 9 {
        return workspace_validate_member_call(
            workspace, module, root, function, node, body_start, stop);
    }
    if tag == 5 {
        let left_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = workspace_expr_type(
            workspace, module, root, function,
            syntax_left(node), body_start, stop);
        let right_type: i32 = workspace_expr_type(
            workspace, module, root, function,
            syntax_right(node), body_start, stop);
        if left_type == type_error() { return 2202; }
        if type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 8 {
        let left_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_left(node), body_start, stop);
        if left_code != 0 { return left_code; }
        let right_code: i32 = workspace_validate_expr(
            workspace, module, root, function,
            syntax_right(node), body_start, stop);
        if right_code != 0 { return right_code; }
        let left_type: i32 = workspace_expr_type(
            workspace, module, root, function,
            syntax_left(node), body_start, stop);
        let right_type: i32 = workspace_expr_type(
            workspace, module, root, function,
            syntax_right(node), body_start, stop);
        if left_type == type_error() { return 2202; }
        if type_same(left_type, right_type) != 1 { return 2202; }
        return 0;
    }
    if tag == 6 {
        return workspace_validate_if(
            workspace, module, root, function, node, body_start, stop);
    }
    if syntax_kind(node) == 1 { return 2002; }
    return 2001;
}

let workspace_validate_statement_block = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 0; }
    let form_tag: i32 = syntax_form_tag(node);
    if form_tag == 1 {
        return workspace_validate_statement_block(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let name_node: i32 = syntax_local_name_node(node);
        if syntax_is_identifier(name_node) != 1 { return 2101; }
        if elaborator_name_visible_node_impl(
            function, body_start, node, name_node) == 1 {
            return 2102;
        }
        let value: i32 = syntax_local_value_node(node);
        let value_code: i32 = workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = workspace_expr_type(
            workspace, module, root, function, value, body_start, node);
        if value_type == type_error() { return 2203; }
        let declared: i32 = syntax_local_type_node(node);
        if declared != 0 {
            if value_type != workspace_type_from_syntax(declared) {
                return 2203;
            }
        }
        return workspace_validate_statement_block(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let code: i32 = workspace_validate_expr(
            workspace, module, root, function, node, body_start, node);
        if code != 0 { return code; }
        return workspace_validate_statement_block(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = syntax_return_expr(node);
        let value_code: i32 = workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if workspace_expr_type(
            workspace, module, root, function, value, body_start, node) !=
            workspace_function_return_type(function) { return 2204; }
        if elaborator_only_separators(syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = syntax_if_statement_condition(node);
        let condition_code: i32 = workspace_validate_expr(
            workspace, module, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if workspace_expr_type(
            workspace, module, root, function, condition, body_start, node) !=
            type_bool() { return 2401; }
        let branch: i32 = syntax_left(
            syntax_if_statement_body(node));
        let branch_code: i32 = workspace_validate_statement_block(
            workspace, module, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return workspace_validate_statement_block(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    return 2502;
}

let workspace_validate_body = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32,
    node: i32, body_start: i32) -> i32 {
    if node == 0 { return 2103; }
    let form_tag: i32 = syntax_form_tag(node);
    if form_tag == 1 {
        return workspace_validate_body(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 2 {
        let name_node: i32 = syntax_local_name_node(node);
        if syntax_is_identifier(name_node) != 1 { return 2101; }
        if elaborator_name_visible_node_impl(
            function, body_start, node, name_node) == 1 {
            return 2102;
        }
        let value: i32 = syntax_local_value_node(node);
        let value_code: i32 = workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        let value_type: i32 = workspace_expr_type(
            workspace, module, root, function, value, body_start, node);
        if value_type == type_error() { return 2203; }
        let declared: i32 = syntax_local_type_node(node);
        if declared != 0 {
            if value_type != workspace_type_from_syntax(declared) {
                return 2203;
            }
        }
        return workspace_validate_body(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 3 {
        let result_code: i32 = workspace_validate_expr(
            workspace, module, root, function, node, body_start, node);
        if result_code != 0 { return result_code; }
        if elaborator_only_separators(syntax_next(node)) == 1 {
            if workspace_expr_type(
                workspace, module, root, function, node, body_start, node) !=
                workspace_function_return_type(function) { return 2204; }
            return 0;
        }
        return workspace_validate_body(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    if form_tag == 4 {
        let value: i32 = syntax_return_expr(node);
        let value_code: i32 = workspace_validate_expr(
            workspace, module, root, function, value, body_start, node);
        if value_code != 0 { return value_code; }
        if workspace_expr_type(
            workspace, module, root, function, value, body_start, node) !=
            workspace_function_return_type(function) { return 2204; }
        if elaborator_only_separators(syntax_next(node)) != 1 { return 2501; }
        return 0;
    }
    if form_tag == 5 {
        let condition: i32 = syntax_if_statement_condition(node);
        let condition_code: i32 = workspace_validate_expr(
            workspace, module, root, function, condition, body_start, node);
        if condition_code != 0 { return condition_code; }
        if workspace_expr_type(
            workspace, module, root, function, condition, body_start, node) !=
            type_bool() { return 2401; }
        let branch: i32 = syntax_left(
            syntax_if_statement_body(node));
        let branch_code: i32 = workspace_validate_statement_block(
            workspace, module, root, function, branch, branch);
        if branch_code != 0 { return branch_code; }
        return workspace_validate_body(
            workspace, module, root, function,
            syntax_next(node), body_start);
    }
    return 2502;
}

let workspace_validate_function = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> i32 {
    let param_code: i32 = elaborator_validate_param_names(
        syntax_function_first_param(function));
    if param_code != 0 { return param_code; }
    let body: i32 = syntax_function_body(function);
    let first: i32 = syntax_left(body);
    return workspace_validate_body(
        workspace, module, root, function, first, first);
}

let workspace_validate_functions = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> i32 {
    if function == 0 { return 0; }
    let code: i32 = workspace_validate_function(
        workspace, module, root, function);
    if code != 0 { return code; }
    return workspace_validate_functions(
        workspace, module, root, surface_next_definition(function));
}

@export

let elaborator_validate_module_indexed = std::func(
    workspace: ModuleWorkspace, module: i32) -> i32 {
    let root: i32 = module_body(module);
    return workspace_validate_functions(
        workspace, module, root, module_first_procedure(root));
}

let workspace_diagnostic_function_from = std::func(
    workspace: ModuleWorkspace, module: i32, root: i32, function: i32) -> addr {
    if function == 0 { return ""; }
    if workspace_validate_function(
        workspace, module, root, function) != 0 {
        return syntax_function_name(function);
    }
    return workspace_diagnostic_function_from(
        workspace, module, root, surface_next_definition(function));
}

@export

let elaborator_module_diagnostic_function_indexed = std::func(
    workspace: ModuleWorkspace, module: i32) -> addr {
    let root: i32 = module_body(module);
    return workspace_diagnostic_function_from(
        workspace, module, root, module_first_procedure(root));
}

// Historical single-root workspace adapters.  Stable compiler workspace
// paths build one ModuleWorkspace and use the indexed entries directly.
@export
let elaborator_module_expr_type = std::func(
    root_workspace: i32, module: i32, root: i32, function: i32,
    node: i32, body_start: i32, stop: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: i32 = elaborator_module_expr_type_indexed(
        workspace, module, root, function, node, body_start, stop);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}

@export

let elaborator_validate_module = std::func(
    root_workspace: i32, module: i32) -> i32 {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: i32 = elaborator_validate_module_indexed(workspace, module);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}

@export

let elaborator_module_diagnostic_function = std::func(
    root_workspace: i32, module: i32) -> addr {
    let workspace: ModuleWorkspace = module_workspace_from_root(root_workspace);
    let result: addr = elaborator_module_diagnostic_function_indexed(
        workspace, module);
    let destroyed: i32 = module_workspace_destroy(workspace);
    return result;
}
