struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

struct TypeShape {
    name: i32,
    arg: i32,
    arg_count: i32,
}

pub fn type_application_score(name_symbol: i32, arg_symbol: i32) -> i32 {
    let shape: TypeShape = TypeShape {
        name: name_symbol,
        arg: arg_symbol,
        arg_count: 1,
    };
    shape.name + shape.arg + shape.arg_count
}

pub fn type_application_from_ast_score(name_tag: i32, name_symbol: i32, arg_tag: i32, arg_symbol: i32) -> i32 {
    let name_node: AstTree = AstTree {
        tag: name_tag,
        symbol: name_symbol,
        left: 0,
        right: 0,
    };
    let arg_node: AstTree = AstTree {
        tag: arg_tag,
        symbol: arg_symbol,
        left: 0,
        right: 0,
    };
    type_application_score(name_node.symbol, arg_node.symbol)
}
