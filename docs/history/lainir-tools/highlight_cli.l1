// Offline syntax-highlight entry point.
// Build this module together with source.l1 and highlight.l1.

#extern #proc bootstrap.source-count() -> #bits<64>;
#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(#bits<8> %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(#addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#extern #proc tool_source_new(#addr %data, #bits<64> %length) -> #addr;
#extern #proc tool_source_nil(#addr %source) -> #addr;
#extern #proc tool_lex_all(#addr %source) -> #addr;
#extern #proc tool_highlight_collect(#addr %source, #addr %tokens) -> #addr;
#extern #proc tool_highlight_category(#addr %item) -> #bits<32>;
#extern #proc tool_highlight_start(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_length(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_line(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_column(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_next(#addr %item) -> #addr;

#proc emit_decimal(#bits<64> %value) -> #unit {
  #let %buffer: #addr = #alloca(32)
  #let %position: #bits<64> = 31
  #let %remaining: #bits<64> = %value
  #if #eq(%remaining, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #loop digits {
    #if #eq(%remaining, 0) { #break digits }
    #let %digit: #bits<64> = #udiv(%remaining, 10)
    #let %remainder: #bits<64> = #sub(%remaining, #mul(%digit, 10))
    %position: #bits<64> = #sub(%position, 1)
    #store[#bits<8>] #add(%remainder, 48), #lea(
      base=%buffer, idx=%position, scale=1, offset=0
    )
    %remaining: #bits<64> = %digit
    #continue digits
  }
  #let %length: #bits<64> = #sub(31, %position)
  #let %index: #bits<64> = 0
  #loop bytes {
    #if #sge(%index, %length) { #break bytes }
    #call bootstrap.artifact-write-byte(#load[#bits<8>](#lea(
      base=%buffer, idx=#add(%position, %index), scale=1, offset=0
    )))
    %index: #bits<64> = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc emit_item(#addr %item) -> #unit {
  #call bootstrap.artifact-write-literal("{\"category\":")
  #call emit_decimal(#zext[#bits<64>](#call tool_highlight_category(%item)))
  #call bootstrap.artifact-write-literal(",\"start\":")
  #call emit_decimal(#call tool_highlight_start(%item))
  #call bootstrap.artifact-write-literal(",\"length\":")
  #call emit_decimal(#call tool_highlight_length(%item))
  #call bootstrap.artifact-write-literal(",\"line\":")
  #call emit_decimal(#call tool_highlight_line(%item))
  #call bootstrap.artifact-write-literal(",\"column\":")
  #call emit_decimal(#call tool_highlight_column(%item))
  #call bootstrap.artifact-write-literal("}")
  #return
}

#proc lainir_highlight() -> #bits<32> {
  #if #eq(#call bootstrap.source-count(), 0) { #return 1 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %source: #addr = #call tool_source_new(%data, %length)
  #let %tokens: #addr = #call tool_lex_all(%source)
  #let %items: #addr = #call tool_highlight_collect(%source, %tokens)
  #let %nil: #addr = #call tool_source_nil(%source)

  #call bootstrap.artifact-begin()
  #call bootstrap.artifact-write-literal("[")
  #let %item: #addr = %items
  #let %first: #bits<1> = 1
  #loop items {
    #if #call tool_is_nil(%source, %item) { #break items }
    #if #eq(%first, 0) {
      #call bootstrap.artifact-write-literal(",")
    }
    #call emit_item(%item)
    %first: #bits<1> = 0
    %item: #addr = #call tool_highlight_next(%item)
    #continue items
  }
  #call bootstrap.artifact-write-literal("]\n")
  #call bootstrap.artifact-finish()
  #return 0
}
