// ctprim.lain —— 编译期类型原语（Array/Ref/Mut/Slice/MutSlice/Fn/TypeBuilder）与类型工厂表达式求值。
// 单向依赖 state/types/ast/sym/ir/modules/tyreg/ctypes/tbuild/ctfor，不反向依赖 ctfn。
let st = import("src::driver::state");
let ax = import("src::syntax::ast");
let s = import("src::driver::sym");
let modules = import("src::sema::modules");
let ireg = import("src::sema::tyreg");
let ct = import("src::comptime::ctypes");
let tb = import("src::sema::tbuild");
let ctf = import("src::comptime::ctfor");

let arg_at = func(ab: Mut(ctf.CtVal), idx: u64) -> Mut(ctf.CtVal) {
  return ptr_cast(Mut(ctf.CtVal), ptr_cast(Mut(u8), ab) + idx * 24);
};

pub let as_type = func(k: Mut(st.State), v: Mut(ctf.CtVal)) -> u64 {
  if ctf.v_kind(v) == 1 { return ctf.v_a(v); }
  if ctf.v_kind(v) == 9 {
    let se: Mut(modules.SymEntry) = modules.sym_find(k, ctf.v_a(v), s.b_self_type());
    if is_null(se) == 0 and modules.sym_pub(se) == 1 {
      let sk: u64 = modules.sym_kind(se);
      if sk == modules.sym_kind_struct() or sk == modules.sym_kind_enum() {
        return ctf.tid_of_shape(k, modules.sym_shape(se));
      }
      if sk == modules.sym_kind_type_alias() {
        return modules.sym_qual(se);
      }
    }
  }
  ctf.fail_msg(k, "not a type", 10, ax.e_type());
  return 0;
};

let as_int = func(k: Mut(st.State), v: Mut(ctf.CtVal)) -> u64 {
  if ctf.v_kind(v) == 0 { return ctf.v_a(v); }
  ctf.fail_msg(k, "not an int", 10, ax.e_type());
  return 0;
};

let as_name = func(k: Mut(st.State), v: Mut(ctf.CtVal)) -> u64 {
  if ctf.v_kind(v) == 0 { return ctf.v_a(v); }
  if ctf.v_kind(v) == 3 { return s.intern(ptr_cast(Ref(u8), ctf.v_a(v)), ctf.v_b(v)); }
  ctf.fail_msg(k, "bad field name", 14, ax.e_type());
  return 0;
};

pub let arg_count_at = func(pg: u64, i: u64, n: u64) -> u64 {
  if i >= ax.n_count(pg) { return n; }
  if ax.is_comma(pg, i) == 1 { return arg_count_at(pg, i + 1, n); }
  return arg_count_at(pg, i + 1, n + 1);
};

pub let ct_prio = func(g: u64, i: u64) -> u64 {
  if ax.is_group(g, i) == 1 { return 0; }
  let op: u64 = ax.n_sym(g, i);
  if op == s.o_eq() or op == s.o_ne() { return 1; }
  if op == s.o_lt() or op == s.o_le() or op == s.o_gt() or op == s.o_ge() { return 2; }
  if op == s.o_plus() or op == s.o_minus() { return 3; }
  if op == s.o_star() or op == s.o_slash() or op == s.o_percent() { return 4; }
  return 0;
};

pub let ct_bin = func(k: Mut(st.State), op: u64, a: u64, b: u64) -> u64 {
  if op == s.o_eq() { return if a == b { 1 } else { 0 }; }
  if op == s.o_ne() { return if a != b { 1 } else { 0 }; }
  if op == s.o_lt() { return if a < b { 1 } else { 0 }; }
  if op == s.o_le() { return if a <= b { 1 } else { 0 }; }
  if op == s.o_gt() { return if a > b { 1 } else { 0 }; }
  if op == s.o_ge() { return if a >= b { 1 } else { 0 }; }
  return ctf.bin_int(k, op, a, b);
};

// 简单类型原语（仅用 ctfor.eval_expr 求实参，或由 ctfn 传入已求值的参数数组）。
pub let apply_prim = func(k: Mut(st.State), name: u64, ag: u64, ab: Mut(ctf.CtVal), nargs: u64, out: Mut(ctf.CtVal)) -> u64 {
  if name == s.t_array() {
    if nargs != 2 { ctf.fail_msg(k, "bad Array args", 14, ax.e_ast()); return 2; }
    let e: u64 = as_type(k, ab);
    let n: u64 = as_int(k, arg_at(ab, 1));
    if st.st_ok(k) != 0 { return 2; }
    ctf.v_set(out, 1, ct.array_t(k, e, n), 0);
    return 1;
  }
  if name == s.t_ref() or name == s.t_mut() or name == s.t_uninit() {
    if nargs != 1 { ctf.fail_msg(k, "bad Ref args", 12, ax.e_ast()); return 2; }
    let e: u64 = as_type(k, ab);
    if st.st_ok(k) != 0 { return 2; }
    let mv: u64 = if name == s.t_mut() { 1 } else { 0 };
    if name == s.t_uninit() {
      ctf.v_set(out, 1, ct.uninit_t(k, e), 0);
    } else {
      ctf.v_set(out, 1, ct.ref_t(k, e, mv), 0);
    }
    return 1;
  }
  if name == s.t_slice() or name == s.t_mutslice() {
    if nargs != 1 { ctf.fail_msg(k, "bad Slice args", 14, ax.e_ast()); return 2; }
    let e: u64 = as_type(k, ab);
    if st.st_ok(k) != 0 { return 2; }
    let mv: u64 = if name == s.t_mutslice() { 1 } else { 0 };
    ctf.v_set(out, 1, ct.slice_t(k, e, mv), 0);
    return 1;
  }
  if name == s.intern("record_begin", 12) {
    if nargs != 0 { ctf.fail_msg(k, "too many args", 13, ax.e_ast()); return 2; }
    let b: Mut(tb.TypeBuilder) = tb.record_begin(k);
    let ba: u64 = b as u64;
    ctf.v_set(out, 6, ba, 0);
    return 1;
  }
  if name == s.intern("record_add", 10) {
    if nargs != 3 { ctf.fail_msg(k, "bad record_add", 14, ax.e_ast()); return 2; }
    if ctf.v_kind(ab) != 6 { ctf.fail_msg(k, "bad builder", 11, ax.e_type()); return 2; }
    let nm: u64 = as_name(k, arg_at(ab, 1));
    let tt: u64 = as_type(k, arg_at(ab, 2));
    if st.st_ok(k) != 0 { return 2; }
    let r: u64 = tb.record_add(k, ptr_cast(Mut(tb.TypeBuilder), ctf.v_a(ab)), nm, tt);
    if st.st_ok(k) != 0 { return 2; }
    ctf.v_set(out, 0, r, 0);
    return 1;
  }
  if name == s.intern("record_end", 10) {
    if nargs != 1 { ctf.fail_msg(k, "bad record_end", 14, ax.e_ast()); return 2; }
    if ctf.v_kind(ab) != 6 { ctf.fail_msg(k, "bad builder", 11, ax.e_type()); return 2; }
    let id: u64 = tb.record_end(k, ptr_cast(Mut(tb.TypeBuilder), ctf.v_a(ab)));
    if st.st_ok(k) != 0 { return 2; }
    ctf.v_set(out, 1, id, 0);
    return 1;
  }
  if name == s.intern("type_name", 9) {
    if nargs != 1 { ctf.fail_msg(k, "bad type_name", 13, ax.e_ast()); return 2; }
    let t: u64 = ctf.as_tid(k, ab);
    if st.st_ok(k) != 0 { return 2; }
    let nm: u64 = ireg.type_name(k, t);
    let sa: Ref(u8) = modules.sym_addr(nm);
    let sau: u64 = sa as u64;
    ctf.v_set(out, 3, sau, modules.sym_len(nm));
    return 1;
  }
  return 0;
};

pub let prim_arity = func(name: u64) -> u64 {
  if name == s.intern("record_begin", 12) { return 1; }
  if name == s.t_ref() or name == s.t_mut() or name == s.t_uninit() or name == s.t_slice() or name == s.t_mutslice() { return 2; }
  if name == s.intern("record_end", 10) or name == s.intern("type_name", 9) { return 2; }
  if name == s.t_array() { return 3; }
  if name == s.intern("record_add", 10) { return 4; }
  return 0;
};
