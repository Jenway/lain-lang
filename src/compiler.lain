let st = import("src::driver::state");
let hr = import("src::driver::host_rt");
let modules = import("src::sema::modules");
let gn = import("src::sema::generics");
let agg = import("src::sema::agg");
let ev = import("src::sema::eval");
let ir = import("src::sema::ir_emit");

pub let status_ok = func() -> u64 { return 0; };
pub let status_no_source = func() -> u64 { return 1; };
pub let status_compile_failed = func() -> u64 { return 2; };

pub let Analysis = struct {
  state: Mut(st.State),
  status: u64,
  entry: u64,
};

let compile_all = func(k: Mut(st.State)) -> u64 {
  let i: u64 = 0;
  while i < hr.source_count() {
    ev.compile_source(k, i);
    let code: u64 = st.st_ok(k);
    if code != 0 {
      return code;
    }
    i = i + 1;
  };
  return 0;
};

pub let analyze_file = func(path: Slice(u8)) -> Analysis {
  hr.rt_init();
  let k: Mut(st.State) = st.st_new(65536);
  st.st_set_release_fast(k, 0);
  let src: u64 = hr.source_add_file(path);
  if src == hr.NO_SOURCE() {
    return Analysis { state: k, status: status_no_source(), entry: hr.NO_SOURCE() };
  }
  let name: u64 = hr.source_name(src);
  ir.mod_new(k, name);
  let code: u64 = compile_all(k);
  if code != 0 {
    return Analysis { state: k, status: status_compile_failed(), entry: src };
  }
  return Analysis { state: k, status: status_ok(), entry: src };
};

pub let print_diagnostics = func() -> () {
  hr.print_diags();
};

pub let error_offset = func(a: Analysis) -> u64 {
  if a.entry == hr.NO_SOURCE() {
    return 0;
  }
  return hr.source_err_offset(a.entry);
};

pub let source_count = func() -> u64 {
  return hr.source_count();
};

pub let source_path = func(i: u64) -> Slice(u8) {
  return hr.source_path_slice(i);
};

pub let source_root = func(i: u64) -> u64 {
  return hr.source_root(i);
};

pub let DepEdge = struct {
  from_src: u64,
  to_src: u64,
};

pub let DepGraph = struct {
  edges: MutSlice(DepEdge),
  count: u64,
};

let ModuleRecord = struct {
  alias: u64,
  src: u64,
  kind: u64,
  owner: u64,
  seal: u64,
  prefix: u64,
};

let module_record_bytes = func() -> u64 {
  return size_of(ModuleRecord);
};

pub let module_count = func(k: Mut(st.State)) -> u64 {
  return st.st_modused(k) / module_record_bytes();
};

let module_at = func(k: Mut(st.State), i: u64) -> Mut(modules.ModEntry) {
  let total: u64 = module_count(k);
  let base: Mut(modules.ModEntry) = ptr_cast(Mut(modules.ModEntry), st.st_modbase(k));
  let items: MutSlice(modules.ModEntry) = make_slice(MutSlice(modules.ModEntry), base, total);
  return mut_of((items[i]));
};

let parent_source = func(k: Mut(st.State), child: u64) -> u64 {
  let total: u64 = module_count(k);
  let i: u64 = 0;
  while i < total {
    let e: Mut(modules.ModEntry) = module_at(k, i);
    if (e.owner == child) and (e.kind == modules.mod_kind_parent()) {
      return e.src + 1;
    }
    i = i + 1;
  };
  return 0;
};

let owner_source = func(k: Mut(st.State), owner: u64) -> u64 {
  let count: u64 = hr.source_count();
  let cur: u64 = owner;
  let depth: u64 = 0;
  while (cur >= count) and (depth <= 16) {
    let parent: u64 = parent_source(k, cur);
    if parent == 0 {
      return count;
    }
    cur = parent - 1;
    depth = depth + 1;
  };
  if cur < count {
    return cur;
  }
  return count;
};

let edge_seen = func(edges: MutSlice(DepEdge), n: u64, from_src: u64, to_src: u64) -> bool {
  let i: u64 = 0;
  let found: u64 = 0;
  while (i < n) and (found == 0) {
    let e: Mut(DepEdge) = mut_of((edges[i]));
    if (e.from_src == from_src) and (e.to_src == to_src) {
      found = 1;
    }
    i = i + 1;
  };
  return found == 0;
};

pub let dep_edges = func(k: Mut(st.State)) -> DepGraph {
  let total: u64 = module_count(k);
  let cap: u64 = if total == 0 { 1 } else { total };
  let bytes: u64 = cap * size_of(DepEdge);
  let raw: Mut(DepEdge) = ptr_cast(Mut(DepEdge), hr.mem_alloc(bytes, 8));
  let items: MutSlice(DepEdge) = make_slice(MutSlice(DepEdge), raw, cap);
  let sources: u64 = hr.source_count();
  let count: u64 = 0;
  let i: u64 = 0;
  while i < total {
    let e: Mut(modules.ModEntry) = module_at(k, i);
    if (e.kind == modules.mod_kind_import()) and (e.src < sources) {
      let from_src: u64 = owner_source(k, e.owner);
      let to_src: u64 = e.src;
      if (from_src < sources) and (from_src != to_src) {
        if edge_seen(items, count, from_src, to_src) {
          let slot: Mut(DepEdge) = mut_of((items[count]));
          slot.from_src = from_src;
          slot.to_src = to_src;
          count = count + 1;
        }
      }
    }
    i = i + 1;
  };
  let graph: MutSlice(DepEdge) = make_slice(MutSlice(DepEdge), raw, count);
  return DepGraph { edges: graph, count: count };
};

pub let Symbol = struct {
  name: Slice(u8),
  kind: u64,
  src: u64,
  modv: u64,
  visible: u64,
  decl: u64,
  shape: u64,
  header: Mut(u8),
};

let symbol_name = func(h: u64) -> Slice(u8) {
  if h == 0 {
    return "";
  }
  return make_slice(Slice(u8), modules.sym_addr(h), modules.sym_len(h));
};

pub let sym_count = func(k: Mut(st.State)) -> u64 {
  return modules.sym_count(k);
};

pub let sym_info = func(k: Mut(st.State), i: u64) -> Symbol {
  let e: Mut(modules.SymEntry) = modules.sym_at(k, i);
  return Symbol {
    name: symbol_name(modules.sym_name(e)),
    kind: modules.sym_kind(e),
    src: modules.sym_src(e),
    modv: modules.sym_mod(e),
    visible: modules.sym_pub(e),
    decl: modules.sym_decl(e),
    shape: modules.sym_shape(e),
    header: modules.sym_sig(e),
  };
};

pub let kind_struct = func() -> u64 { return modules.sym_kind_struct(); };
pub let kind_enum = func() -> u64 { return modules.sym_kind_enum(); };
pub let kind_func = func() -> u64 { return modules.sym_kind_func(); };
pub let kind_generic = func() -> u64 { return modules.sym_kind_generic(); };
pub let kind_mod = func() -> u64 { return modules.sym_kind_mod(); };
pub let kind_sig = func() -> u64 { return modules.sym_kind_sig(); };

pub let is_type = func(s: Symbol) -> bool {
  if s.kind == kind_struct() { return true; }
  if s.kind == kind_enum() { return true; }
  if s.kind == kind_mod() { return true; }
  if s.kind == kind_sig() { return true; }
  return false;
};

pub let is_function = func(s: Symbol) -> bool {
  if s.kind == kind_func() { return true; }
  if s.kind == kind_generic() { return true; }
  return false;
};

pub let type_none = func() -> u64 { return 0; };
pub let type_struct = func() -> u64 { return 1; };
pub let type_enum = func() -> u64 { return 2; };
pub let type_cenum = func() -> u64 { return 3; };
pub let type_other = func() -> u64 { return 4; };

pub let type_kind = func(s: Symbol) -> u64 {
  if s.shape == 0 {
    return type_none();
  }
  let k: u64 = agg.shp_kind(s.shape);
  if k == agg.kind_struct() { return type_struct(); }
  if k == agg.kind_enum() { return type_enum(); }
  if k == agg.kind_cenum() { return type_cenum(); }
  return type_other();
};

pub let type_width = func(s: Symbol) -> u64 {
  if s.shape == 0 {
    return 0;
  }
  return agg.shp_und_w(s.shape);
};

pub let type_signed = func(s: Symbol) -> u64 {
  if s.shape == 0 {
    return 0;
  }
  return agg.shp_und_sg(s.shape);
};

pub let generic_body = func(s: Symbol) -> u64 {
  if is_null(s.header) {
    return 0;
  }
  let hdr: Mut(gn.GenHdr) = ptr_cast(Mut(gn.GenHdr), s.header);
  return hdr.body_i;
};
