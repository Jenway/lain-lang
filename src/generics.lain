// generics.lain —— Phase 2B ?{} 泛型模板登记、4 步单态化调度与待编队列。
// 单向依赖 state/types/ast/sym/agg/ir/modules/tyreg/tbuild/ctfor/ctfn/ctx/calls/given/genunify。
let st = import("state");
let ty = import("types");
let ax = import("ast");
let s = import("sym");
let ir = import("ir");
let modules = import("modules");
let ireg = import("tyreg");
let tb = import("tbuild");
let ctf = import("ctfor");
let ctp = import("ctprim");
let ctfn = import("ctfn");
let cx = import("ctx");
let cl = import("calls");
let gv = import("given");
let gu = import("genunify");

extern lain2_source_root(idx: u64) -> u64 = lain2_source_root;
extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;

struct GenHdr {
  decl_i: u64,
  src: u64,
  pg_i: u64,
  qg_i: u64,
  ret_i: u64,
  body_i: u64
}

struct GenQRec {
  mangled_q: u64,
  tpl_e: Mut(modules.SymEntry),
  nct: u64,
  names_arr: Mut(u64),
  vals_arr: Mut(ctf.CtVal),
  depth: u64
}

struct GenQBlk {
  pad0: u64,
  pad8: u64,
  pad16: u64,
  pad24: u64,
  pad32: u64,
  qbase: Mut(GenQRec),
  qn: u64,
  qhead: u64,
  depth: u64,
  seq: u64
}

func qblk(k: Mut(st.State)) -> Mut(GenQBlk) {
  return ptr_cast(Mut(GenQBlk), st.st_genblk(k));
}

func qrec_at(base: Mut(GenQRec), i: u64) -> Mut(GenQRec) {
  return ptr_cast(Mut(GenQRec), ptr_cast(Mut(u8), base) + i * 48);
}

func rtval_at(ab: Mut(ty.Val), i: u64) -> Mut(ty.Val) {
  return ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + i * 56);
}

func paramty_at(ps: Mut(ty.Ty), i: u64) -> Mut(ty.Ty) {
  return ptr_cast(Mut(ty.Ty), ptr_cast(Mut(u8), ps) + i * 32);
}

// --- 模板头（48B）：[decl_i@0, src@8, pg_i@16, qg_i@24, ret_i@32, body_i@40] ---
func reg_generic(k: Mut(st.State), name: u64, q: u64, decl_i: u64, pg_i: u64, qg_i: u64, ret_i: u64, body_i: u64) -> Mut(modules.SymEntry) {
  let hdr: Mut(GenHdr) = ptr_cast(Mut(GenHdr), st.st_ralloc(k, 48));
  hdr.decl_i = decl_i;
  hdr.src = st.st_src(k);
  hdr.pg_i = pg_i;
  hdr.qg_i = qg_i;
  hdr.ret_i = ret_i;
  hdr.body_i = body_i;
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_generic(), st.st_src(k), name, q, ptr_cast(Mut(u8), hdr), 0);
  modules.sym_set_decl(se, decl_i);
  modules.sym_set_src(se, st.st_src(k));
  return se;
}

// --- 待编队列（st_genblk +40/+48/+56，每条 48B） --------------------------
// [mangled_q@0, tpl_e@8, nct@16, names_arr@24, vals_arr@32, depth@40]
func gen_depth(k: Mut(st.State)) -> u64 { let gb: Mut(GenQBlk) = qblk(k); return gb.depth; }
func set_gen_depth(k: Mut(st.State), v: u64) -> u64 { let gb: Mut(GenQBlk) = qblk(k); gb.depth = v; return v; }

func genq_base(k: Mut(st.State)) -> Mut(GenQRec) {
  let gb: Mut(GenQBlk) = qblk(k);
  if (gb.qbase as u64) != 0 { return gb.qbase; }
  let qsz: u64 = 48 * 128;
  let nb: Mut(GenQRec) = ptr_cast(Mut(GenQRec), st.st_ralloc(k, qsz));
  gb.qbase = nb;
  return nb;
}

func genq_push(k: Mut(st.State), q: u64, tpl_e: Mut(modules.SymEntry), nct: u64, ctp_tbl: Mut(gu.CtParamRec), vals: Mut(ctf.CtVal)) -> u64 {
  let gb: Mut(GenQBlk) = qblk(k);
  let base: Mut(GenQRec) = genq_base(k);
  let n: u64 = gb.qn;
  if n >= 128 { ctf.fail_msg(k, "generic queue full", 18, ax.e_ast()); return 0; }
  let nms: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, nct * 8 + 8));
  let vcp: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_ralloc(k, nct * 24 + 8));
  let i: u64 = loop cp(i: u64 = 0) while i < nct {
    let cp_rec: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    deref(gu.word_at(nms, i)) = cp_rec.name;
    let src: Mut(ctf.CtVal) = gu.val_at(vals, i);
    let dst: Mut(ctf.CtVal) = gu.val_at(vcp, i);
    dst.kind = src.kind;
    dst.a = src.a;
    dst.b = src.b;
    i = i + 1;
  };
  let rec: Mut(GenQRec) = qrec_at(base, n);
  rec.mangled_q = q;
  rec.tpl_e = tpl_e;
  rec.nct = nct;
  rec.names_arr = nms;
  rec.vals_arr = vcp;
  rec.depth = gen_depth(k) + 1;
  gb.qn = n + 1;
  return 1;
}

func genq_pending(k: Mut(st.State)) -> Mut(GenQRec) {
  let gb: Mut(GenQBlk) = qblk(k);
  if is_null(gb.qbase) { return null_ref(Mut(GenQRec)); }
  let h: u64 = gb.qhead;
  if h >= gb.qn { return null_ref(Mut(GenQRec)); }
  gb.qhead = h + 1;
  return qrec_at(gb.qbase, h);
}

// --- 辅助：压入已绑定的编译期实参 ----------------------------------------
func push_bound(k: Mut(st.State), ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if i >= nct { return 1; }
  if deref(gu.word_at(bound, i)) == 1 {
    let cp_rec: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    let nm: u64 = cp_rec.name;
    let v: Mut(ctf.CtVal) = gu.val_at(vals, i);
    ctf.bind(k, nm, v.kind, v.a, v.b);
  }
  return push_bound(k, ctp_tbl, nct, vals, bound, i + 1);
}

// 解析调用点显式 ?{ key: val, ... }
func parse_explicit_q(k: Mut(st.State), qag: u64, i: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(qag);
  if i >= n { return 1; }
  if ax.is_comma(qag, i) == 1 { return parse_explicit_q(k, qag, i + 1, ctp_tbl, nct, vals, bound); }
  if ax.is_name(qag, i) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  if ctf.has_tok(qag, i + 1, s.p_colon()) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  let idx: u64 = gu.ct_find(ctp_tbl, nct, ax.n_sym(qag, i), 0);
  if idx == 999 { ctf.fail_msg(k, "unknown comptime arg", 20, ax.e_type()); return 0; }
  let ev: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let nj: u64 = gv.eval_witness(k, qag, i + 2, ev);
  if st.st_ok(k) != 0 { return 0; }
  let dst: Mut(ctf.CtVal) = gu.val_at(vals, idx);
  dst.kind = ctf.v_kind(ev);
  dst.a = ctf.v_a(ev);
  dst.b = ctf.v_b(ev);
  deref(gu.word_at(bound, idx)) = 1;
  return parse_explicit_q(k, qag, nj, ctp_tbl, nct, vals, bound);
}

// 逐个处理运行时实参：已知类型按 want 求值，含未绑定类型变量则 tnone 求值后合一。
func eval_rt_args(k: Mut(st.State), pg: u64, pi: u64, argsg: u64, ai: u64, idx: u64, ab: Mut(ty.Val),
                  ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let pn: u64 = ax.n_count(pg);
  let an: u64 = ax.n_count(argsg);
  if pi >= pn {
    if ai < an { ctf.fail_msg(k, "too many args", 13, ax.e_type()); }
    return idx;
  }
  if ax.is_comma(pg, pi) == 1 { return eval_rt_args(k, pg, pi + 1, argsg, ai, idx, ab, ctp_tbl, nct, vals, bound); }
  if ai >= an { ctf.fail_msg(k, "missing args", 12, ax.e_type()); return idx; }
  if ctf.has_tok(pg, pi + 1, s.p_colon()) == 0 { ctf.fail_msg(k, "expected :", 10, ax.e_ast()); return idx; }
  let te: u64 = gu.ct_skip_ty(pg, pi + 2);
  let v: Mut(ty.Val) = rtval_at(ab, idx);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  if gu.ast_has_unbound(pg, pi + 2, te, ctp_tbl, nct, bound) == 0 {
    let wt: Mut(ty.Ty) = ax.new_ty(k);
    cx.parse_type(k, pg, pi + 2, wt);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return idx; }
    let aj: u64 = core_expr(k, argsg, ai, 0, wt, v);
    if st.st_ok(k) != 0 { return idx; }
    if ty.vlit(v) == 0 {
      gu.unify_type(k, pg, pi + 2, te, ireg.tid_of(k, ty.vty(v)), ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return idx; }
    }
    let nj: u64 = if ax.is_comma(argsg, aj) == 1 { aj + 1 } else { aj };
    return eval_rt_args(k, pg, te, argsg, nj, idx + 1, ab, ctp_tbl, nct, vals, bound);
  }
  ctf.release(k, cm);
  let aj2: u64 = core_expr(k, argsg, ai, 0, cx.tnone(k), v);
  if st.st_ok(k) != 0 { return idx; }
  let atid: u64 = ireg.tid_of(k, ty.vty(v));
  gu.unify_type(k, pg, pi + 2, te, atid, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return idx; }
  let nj2: u64 = if ax.is_comma(argsg, aj2) == 1 { aj2 + 1 } else { aj2 };
  return eval_rt_args(k, pg, te, argsg, nj2, idx + 1, ab, ctp_tbl, nct, vals, bound);
}

// 用已解出的编译期参数，解析出隐式 given 实例。
func resolve_givens(k: Mut(st.State), qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if i >= nct { return 1; }
  if deref(gu.word_at(bound, i)) == 0 {
    let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    let cm: u64 = ctf.mark(k);
    push_bound(k, ctp_tbl, nct, vals, bound, 0);
    let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    ctfn.ct_eval(k, qg, p.ty_start, 0, tv);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return 0; }
    let target_tid: u64 = ctp.as_type(k, tv);
    if st.st_ok(k) != 0 { return 0; }
    if target_tid == tb.type_tid(k) {
      ctf.fail_msg(k, "cannot infer comptime param", 25, ax.e_type());
      return 0;
    }
    let ge: Mut(gv.GivenEntry) = gv.find_implicit(k, target_tid);
    if st.st_ok(k) != 0 { return 0; }
    let dst: Mut(ctf.CtVal) = gu.val_at(vals, i);
    dst.kind = 7;
    dst.a = target_tid;
    dst.b = ge.wrec;
    deref(gu.word_at(bound, i)) = 1;
  }
  return resolve_givens(k, qg, ctp_tbl, nct, vals, bound, i + 1);
}

func coerce_args(k: Mut(st.State), ab: Mut(ty.Val), ps: Mut(ty.Ty), i: u64, np: u64) -> u64 {
  if i >= np { return 1; }
  let v: Mut(ty.Val) = rtval_at(ab, i);
  let pt: Mut(ty.Ty) = paramty_at(ps, i);
  let c: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), pt, c);
  if st.st_ok(k) != 0 { return 0; }
  ty.val_at(v, c);
  return coerce_args(k, ab, ps, i + 1, np);
}

func build_sig(k: Mut(st.State), root: u64, pg: u64, ret_i: u64) -> Mut(u8) {
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np2: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  if ret_i != 0 { cx.parse_type(k, root, ret_i, rt); }
  return cx.sig_new(k, rt, np2, paramp);
}

func alloc_mangled(k: Mut(st.State), e: Mut(modules.SymEntry), src: u64, nct: u64, ctp_tbl: Mut(gu.CtParamRec), vals: Mut(ctf.CtVal), sg: Mut(u8)) -> u64 {
  let dp: u64 = gen_depth(k);
  if dp + 1 >= 64 { ctf.fail_msg(k, "generic recursion limit", 23, ax.e_type()); return 0; }
  let gb: Mut(GenQBlk) = qblk(k);
  let seq: u64 = gb.seq;
  gb.seq = seq + 1;
  let qn: u64 = modules.qual_num(k, src, modules.sym_name(e), seq);
  gu.cache_put(k, e as u64, nct, qn, sg, vals);
  genq_push(k, qn, e, nct, ctp_tbl, vals);
  return qn;
}

func ret_end(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return i; }
  if ctf.has_delim(g, i, ax.dl_brace()) == 1 { return i; }
  return ret_end(g, i + 1);
}

// --- 对外调用入口 ---------------------------------------------------------
func call_generic(k: Mut(st.State), e: Mut(modules.SymEntry), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val), next_box: Mut(u64)) -> u64 {
  let hdr: Mut(GenHdr) = ptr_cast(Mut(GenHdr), modules.sym_sig(e));
  let src: u64 = hdr.src;
  let root: u64 = lain2_source_root(src);
  let pg: u64 = ax.n_at(root, hdr.pg_i);
  let qg: u64 = ax.n_at(root, hdr.qg_i);
  let ret_i: u64 = hdr.ret_i;
  let ctp_tbl: Mut(gu.CtParamRec) = ptr_cast(Mut(gu.CtParamRec), st.st_alloc(k, 192));
  let nct: u64 = gu.parse_ctparams(k, qg, 0, ctp_tbl, 0);
  if st.st_ok(k) != 0 { return 0; }
  let vals: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 192));
  let bound: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let bslice: MutSlice(u64) = make_slice(MutSlice(u64), bound, 8);
  let zi: u64 = loop zb(z: u64 = 0) while z < 8 { bslice[z] = 0; z = z + 1; };
  let is_q: u64 = if ctf.has_tok(g, i + 2, s.p_qmark()) == 1 { ctf.has_delim(g, i + 3, ax.dl_brace()) } else { 0 };
  ax.box_put(next_box, if is_q == 1 { i + 4 } else { i + 2 });
  if is_q == 1 {
    if parse_explicit_q(k, ax.n_at(g, i + 3), 0, ctp_tbl, nct, vals, bound) == 0 { return 0; }
  }
  let absz: u64 = 16 * 56 + 8;
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, absz));
  let np: u64 = eval_rt_args(k, pg, 0, ax.n_at(g, i + 1), 0, 0, ab, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return 0; }
  if ret_i != 0 and ty.ty_known(want) == 1 {
    let re: u64 = ret_end(root, ret_i);
    if gu.ast_has_unbound(root, ret_i, re, ctp_tbl, nct, bound) == 1 {
      gu.unify_type(k, root, ret_i, re, ireg.tid_of(k, want), ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return 0; }
    }
  }
  if resolve_givens(k, qg, ctp_tbl, nct, vals, bound, 0) == 0 { return 0; }
  let hit: Mut(gu.MonoCacheRec) = gu.cache_find(k, e as u64, nct, vals);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  let sg_raw: Mut(u8) = if (hit as u64) != 0 {
    hit.concrete_sg
  } else {
    build_sig(k, root, pg, ret_i)
  };
  ctf.release(k, cm);
  if st.st_ok(k) != 0 { return 0; }
  let sg: Mut(cx.SigRec) = ptr_cast(Mut(cx.SigRec), sg_raw);
  if coerce_args(k, ab, sg.params, 0, np) == 0 { return 0; }
  let mq: u64 = if (hit as u64) != 0 { hit.mangled_q } else { alloc_mangled(k, e, src, nct, ctp_tbl, vals, sg_raw) };
  if st.st_ok(k) != 0 { return 0; }
  return cl.emit_prepared(k, mq, sg.ret, np, ab, want, out);
}
