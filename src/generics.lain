// generics.lain —— Phase 2B ?{} 泛型模板登记、4 步单态化调度与待编队列。
// 单向依赖 state/types/ast/sym/agg/ir/modules/tyreg/tbuild/ctfor/ctfn/ctx/calls/given/genunify。
extern lain2_source_root(idx: u64) -> u64 = lain2_source_root;
extern core_expr(k: addr, g: u64, i: u64, minp: u64, want: addr, out: addr) -> u64 = core__expr;
let st = import("state");
let ty = import("types");
let ax = import("ast");
let s = import("sym");
let ir = import("ir");
let modules = import("modules");
let ireg = import("tyreg");
let tb = import("tbuild");
let ctf = import("ctfor");
let ctp = import("ctprim");
let ctfn = import("ctfn");
let cx = import("ctx");
let cl = import("calls");
let gv = import("given");
let gu = import("genunify");

// --- 模板头（48B）：[decl_i@0, src@8, pg_i@16, qg_i@24, ret_i@32, body_i@40] ---
func reg_generic(k: addr, name: u64, q: u64, decl_i: u64, pg_i: u64, qg_i: u64, ret_i: u64, body_i: u64) -> addr {
  let hdr: addr = st.st_ralloc(k, 48);
  store(hdr, decl_i);
  store(hdr + 8, st.st_src(k));
  store(hdr + 16, pg_i);
  store(hdr + 24, qg_i);
  store(hdr + 32, ret_i);
  store(hdr + 40, body_i);
  let se: addr = modules.sym_add(k, modules.sym_kind_generic(), st.st_src(k), name, q, hdr, 0);
  modules.sym_set_decl(se, decl_i);
  modules.sym_set_src(se, st.st_src(k));
  return se;
}

// --- 待编队列（st_genblk +40/+48/+56，每条 48B） --------------------------
// [mangled_q@0, tpl_e@8, nct@16, names_arr@24, vals_arr@32, depth@40]
func gen_depth(k: addr) -> u64 { return load(st.st_genblk(k) + 64); }
func set_gen_depth(k: addr, v: u64) -> u64 { store(st.st_genblk(k) + 64, v); return v; }

func genq_base(k: addr) -> addr {
  let gb: addr = st.st_genblk(k);
  let b0u: u64 = load(gb + 40);
  if b0u != 0 { return b0u as addr; }
  let qsz: u64 = 48 * 128;
  let nb: addr = st.st_ralloc(k, qsz);
  store(gb + 40, nb as u64);
  return nb;
}

func genq_push(k: addr, q: u64, tpl_e: addr, nct: u64, ctp_tbl: addr, vals: addr) -> u64 {
  let gb: addr = st.st_genblk(k);
  let base: addr = genq_base(k);
  let n: u64 = load(gb + 48);
  if n >= 128 { ctf.fail_msg(k, "generic queue full", 18, ax.e_ast()); return 0; }
  let nms: addr = st.st_ralloc(k, nct * 8 + 8);
  let vcp: addr = st.st_ralloc(k, nct * 24 + 8);
  let i: u64 = loop cp(i: u64 = 0) while i < nct {
    let nm: u64 = load(ctp_tbl + i * 24);
    store(nms + i * 8, nm);
    let src: addr = vals + i * 24;
    let dst: addr = vcp + i * 24;
    let s0: u64 = load(src); let s1: u64 = load(src + 8); let s2: u64 = load(src + 16);
    store(dst, s0); store(dst + 8, s1); store(dst + 16, s2);
    i = i + 1;
  };
  let rec: addr = base + n * 48;
  store(rec, q); store(rec + 8, tpl_e as u64); store(rec + 16, nct);
  store(rec + 24, nms as u64); store(rec + 32, vcp as u64);
  store(rec + 40, gen_depth(k) + 1);
  store(gb + 48, n + 1);
  return 1;
}

func genq_pending(k: addr) -> addr {
  let gb: addr = st.st_genblk(k);
  let bu: u64 = load(gb + 40);
  if bu == 0 { return 0 as addr; }
  let n: u64 = load(gb + 48);
  let h: u64 = load(gb + 56);
  if h >= n { return 0 as addr; }
  store(gb + 56, h + 1);
  return (bu as addr) + h * 48;
}

// --- 辅助：压入已绑定的编译期实参 ----------------------------------------
func push_bound(k: addr, ctp_tbl: addr, nct: u64, vals: addr, bound: addr, i: u64) -> u64 {
  if i >= nct { return 1; }
  if load(bound + i * 8) == 1 {
    let nm: u64 = load(ctp_tbl + i * 24);
    let v: addr = vals + i * 24;
    let vk: u64 = load(v); let va: u64 = load(v + 8); let vb: u64 = load(v + 16);
    ctf.bind(k, nm, vk, va, vb);
  }
  return push_bound(k, ctp_tbl, nct, vals, bound, i + 1);
}

// 解析调用点显式 ?{ key: val, ... }
func parse_explicit_q(k: addr, qag: u64, i: u64, ctp_tbl: addr, nct: u64, vals: addr, bound: addr) -> u64 {
  let n: u64 = ax.n_count(qag);
  if i >= n { return 1; }
  if ax.is_comma(qag, i) == 1 { return parse_explicit_q(k, qag, i + 1, ctp_tbl, nct, vals, bound); }
  if ax.is_name(qag, i) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  if ctf.has_tok(qag, i + 1, s.p_colon()) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  let idx: u64 = gu.ct_find(ctp_tbl, nct, ax.n_sym(qag, i), 0);
  if idx == 999 { ctf.fail_msg(k, "unknown comptime arg", 20, ax.e_type()); return 0; }
  let ev: addr = st.st_alloc(k, 24);
  let nj: u64 = gv.eval_witness(k, qag, i + 2, ev);
  if st.st_ok(k) != 0 { return 0; }
  let dst: addr = vals + idx * 24;
  store(dst, ctf.v_kind(ev)); store(dst + 8, ctf.v_a(ev)); store(dst + 16, ctf.v_b(ev));
  store(bound + idx * 8, 1);
  return parse_explicit_q(k, qag, nj, ctp_tbl, nct, vals, bound);
}

// 逐个处理运行时实参：已知类型按 want 求值，含未绑定类型变量则 tnone 求值后合一。
func eval_rt_args(k: addr, pg: u64, pi: u64, argsg: u64, ai: u64, idx: u64, ab: addr,
                  ctp_tbl: addr, nct: u64, vals: addr, bound: addr) -> u64 {
  let pn: u64 = ax.n_count(pg);
  let an: u64 = ax.n_count(argsg);
  if pi >= pn {
    if ai < an { ctf.fail_msg(k, "too many args", 13, ax.e_type()); }
    return idx;
  }
  if ax.is_comma(pg, pi) == 1 { return eval_rt_args(k, pg, pi + 1, argsg, ai, idx, ab, ctp_tbl, nct, vals, bound); }
  if ai >= an { ctf.fail_msg(k, "missing args", 12, ax.e_type()); return idx; }
  if ctf.has_tok(pg, pi + 1, s.p_colon()) == 0 { ctf.fail_msg(k, "expected :", 10, ax.e_ast()); return idx; }
  let te: u64 = gu.ct_skip_ty(pg, pi + 2);
  let v: addr = ab + idx * 56;
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  if gu.ast_has_unbound(pg, pi + 2, te, ctp_tbl, nct, bound) == 0 {
    let wt: addr = ax.new_ty(k);
    cx.parse_type(k, pg, pi + 2, wt);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return idx; }
    let aj: u64 = core_expr(k, argsg, ai, 0, wt, v);
    if st.st_ok(k) != 0 { return idx; }
    if ty.vlit(v) == 0 {
      gu.unify_type(k, pg, pi + 2, te, ireg.tid_of(k, ty.vty(v)), ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return idx; }
    }
    let nj: u64 = if ax.is_comma(argsg, aj) == 1 { aj + 1 } else { aj };
    return eval_rt_args(k, pg, te, argsg, nj, idx + 1, ab, ctp_tbl, nct, vals, bound);
  }
  ctf.release(k, cm);
  let aj2: u64 = core_expr(k, argsg, ai, 0, cx.tnone(k), v);
  if st.st_ok(k) != 0 { return idx; }
  let atid: u64 = ireg.tid_of(k, ty.vty(v));
  gu.unify_type(k, pg, pi + 2, te, atid, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return idx; }
  let nj2: u64 = if ax.is_comma(argsg, aj2) == 1 { aj2 + 1 } else { aj2 };
  return eval_rt_args(k, pg, te, argsg, nj2, idx + 1, ab, ctp_tbl, nct, vals, bound);
}

// 用已解出的编译期参数，解析出隐式 given 实例。
func resolve_givens(k: addr, qg: u64, ctp_tbl: addr, nct: u64, vals: addr, bound: addr, i: u64) -> u64 {
  if i >= nct { return 1; }
  if load(bound + i * 8) == 0 {
    let p: addr = ctp_tbl + i * 24;
    let ts: u64 = load(p + 8);
    let cm: u64 = ctf.mark(k);
    push_bound(k, ctp_tbl, nct, vals, bound, 0);
    let tv: addr = st.st_alloc(k, 24);
    ctfn.ct_eval(k, qg, ts, 0, tv);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return 0; }
    let target_tid: u64 = ctp.as_type(k, tv);
    if st.st_ok(k) != 0 { return 0; }
    if target_tid == tb.type_tid(k) {
      ctf.fail_msg(k, "cannot infer comptime param", 25, ax.e_type());
      return 0;
    }
    let ge: addr = gv.find_implicit(k, target_tid);
    if st.st_ok(k) != 0 { return 0; }
    let dst: addr = vals + i * 24;
    let gw: u64 = load(ge + 16);
    store(dst, 7); store(dst + 8, target_tid); store(dst + 16, gw);
    store(bound + i * 8, 1);
  }
  return resolve_givens(k, qg, ctp_tbl, nct, vals, bound, i + 1);
}

func coerce_args(k: addr, ab: addr, ps: addr, i: u64, np: u64) -> u64 {
  if i >= np { return 1; }
  let v: addr = ab + i * 56;
  let pt: addr = ps + i * 32;
  let c: addr = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), pt, c);
  if st.st_ok(k) != 0 { return 0; }
  ty.val_at(v, c);
  return coerce_args(k, ab, ps, i + 1, np);
}

func build_sig(k: addr, root: u64, pg: u64, ret_i: u64) -> addr {
  let paramp: addr = st.st_alloc(k, 512);
  let syms: addr = st.st_alloc(k, 128);
  let np2: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let rt: addr = ax.new_ty(k);
  ty.ty_none(rt);
  if ret_i != 0 { cx.parse_type(k, root, ret_i, rt); }
  return cx.sig_new(k, rt, np2, paramp);
}

func alloc_mangled(k: addr, e: addr, src: u64, nct: u64, ctp_tbl: addr, vals: addr, sg: addr) -> u64 {
  let dp: u64 = gen_depth(k);
  if dp + 1 >= 64 { ctf.fail_msg(k, "generic recursion limit", 23, ax.e_type()); return 0; }
  let gb: addr = st.st_genblk(k);
  let seq: u64 = load(gb + 72);
  store(gb + 72, seq + 1);
  let qn: u64 = modules.qual_num(k, src, modules.sym_name(e), seq);
  gu.cache_put(k, e as u64, nct, qn, sg, vals);
  genq_push(k, qn, e, nct, ctp_tbl, vals);
  return qn;
}

// --- 对外调用入口 ---------------------------------------------------------
func call_generic(k: addr, e: addr, g: u64, i: u64, want: addr, out: addr, next_box: addr) -> u64 {
  let hdr: addr = modules.sym_sig(e);
  let src: u64 = load(hdr + 8);
  let root: u64 = lain2_source_root(src);
  let pg_i: u64 = load(hdr + 16);
  let qg_i: u64 = load(hdr + 24);
  let pg: u64 = ax.n_at(root, pg_i);
  let qg: u64 = ax.n_at(root, qg_i);
  let ret_i: u64 = load(hdr + 32);
  let ctp_tbl: addr = st.st_alloc(k, 192);
  let nct: u64 = gu.parse_ctparams(k, qg, 0, ctp_tbl, 0);
  if st.st_ok(k) != 0 { return 0; }
  let vals: addr = st.st_alloc(k, 192);
  let bound: addr = st.st_alloc(k, 64);
  let z0: u64 = 0;
  let zi: u64 = loop zb(z: u64 = 0) while z < 8 { store(bound + z * 8, z0); z = z + 1; };
  let is_q: u64 = if ctf.has_tok(g, i + 2, s.p_qmark()) == 1 { ctf.has_delim(g, i + 3, ax.dl_brace()) } else { 0 };
  ax.box_put(next_box, if is_q == 1 { i + 4 } else { i + 2 });
  if is_q == 1 {
    if parse_explicit_q(k, ax.n_at(g, i + 3), 0, ctp_tbl, nct, vals, bound) == 0 { return 0; }
  }
  let absz: u64 = 16 * 56 + 8;
  let ab: addr = st.st_alloc(k, absz);
  let np: u64 = eval_rt_args(k, pg, 0, ax.n_at(g, i + 1), 0, 0, ab, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return 0; }
  if resolve_givens(k, qg, ctp_tbl, nct, vals, bound, 0) == 0 { return 0; }
  let hit: addr = gu.cache_find(k, e as u64, nct, vals);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  let sg: addr = if hit as u64 != 0 {
    let sgu: u64 = load(hit + 24);
    sgu as addr
  } else {
    build_sig(k, root, pg, ret_i)
  };
  ctf.release(k, cm);
  if st.st_ok(k) != 0 { return 0; }
  let ps: addr = load(sg + 16) as addr;
  if coerce_args(k, ab, ps, 0, np) == 0 { return 0; }
  let mq: u64 = if hit as u64 != 0 { load(hit + 16) } else { alloc_mangled(k, e, src, nct, ctp_tbl, vals, sg) };
  if st.st_ok(k) != 0 { return 0; }
  let retp: u64 = load(sg + 8);
  return cl.emit_prepared(k, mq, retp as addr, np, ab, want, out);
}
