// The single lowering engine from elaborated program to dynamic L1 storage.
// It is used for both one-source and workspace requests.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");
let types: Module = import("packages::lain::compiler::types");
let elaborator: Module = import("packages::lain::compiler::elaborator");
let l1_builder: Module =
    import("packages::lain::compiler::l1_unit_builder");

@export
let lower: Module = std::module {

    @export
    let Lower = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let Surface: Module = elaborator.Elaborator(Memory);
        let Builder: Module = l1_builder.Builder(Memory);
        let L1: Module = Builder.L1;

        let Result: type = std::struct {
            unit: L1.Unit,
            entry: L1.ProcedureId,
            diagnostic: i32,
        };

        let TypeMapEntry: type = std::struct {
            meta: types.TypeId,
            physical: L1.TypeId,
        };

        let TypeMap: type = vector.Vec(
            TypeMapEntry,
            Memory.Allocation,
            Memory.Bounds,
        );

        let physical_type = std::func(
            mapping: &TypeMap,
            meta: types.TypeId,
        ) -> L1.TypeId ! {Memory.Bounds.Effect} {
            let index: usize = 0;
            while index < mapping.length() {
                let entry: &TypeMapEntry = mapping.get(index);
                if entry.meta == meta { return entry.physical; }
                index = index + 1;
            }
            return std::usize_max();
        };

        let lower_expression = std::func(
            program: &Surface.Program,
            unit: &mut L1.Unit,
            expression_id: Surface.ExprId,
            mapping: &TypeMap,
        ) -> L1.ExprId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let expression: &Surface.Expr =
                program.expressions.get(expression_id);
            let result_type: L1.TypeId =
                physical_type(mapping, expression.type_id);

            if expression.kind == 1 {
                return Builder.i32_literal(
                    unit,
                    result_type,
                    expression.i32_value,
                );
            }

            if expression.kind == 2 {
                let left: L1.ExprId = lower_expression(
                    program,
                    unit,
                    expression.left,
                    mapping,
                );
                let right: L1.ExprId = lower_expression(
                    program,
                    unit,
                    expression.right,
                    mapping,
                );
                return Builder.binary(
                    unit,
                    3,
                    result_type,
                    left,
                    right,
                );
            }

            if expression.kind == 3 {
                let call: L1.ExprId = Builder.call(
                    unit,
                    result_type,
                    expression.callee,
                );
                let index: usize = 0;
                while index < expression.arguments.length() {
                    let argument: L1.ExprId = lower_expression(
                        program,
                        unit,
                        *expression.arguments.get(index),
                        mapping,
                    );
                    Builder.append_call_argument(
                        unit,
                        call,
                        argument,
                    );
                    index = index + 1;
                }
                return call;
            }

            return std::usize_max();
        };

        let lower_function = std::func(
            program: &Surface.Program,
            unit: &mut L1.Unit,
            function_id: Surface.FunctionId,
            mapping: &TypeMap,
        ) -> L1.ProcedureId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let function: &Surface.Function =
                program.functions.get(function_id);
            let region: L1.RegionId = Builder.begin_region(unit);
            let value: L1.ExprId = lower_expression(
                program,
                unit,
                function.body,
                mapping,
            );
            let ignored: L1.InstructionId =
                Builder.append_return(unit, region, value);
            return Builder.add_procedure(
                unit,
                Memory.String.clone(&function.name),
                physical_type(mapping, function.return_type),
                region,
                false,
            );
        };

        let program = std::func(
            source: &Surface.Program,
        ) -> Result ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let unit: L1.Unit = Builder.new();
            let i32_type: L1.TypeId = L1.add_type(
                &mut unit,
                L1.Type { kind: 1, bit_width: 32 },
            );
            let mapping: TypeMap = TypeMap.new();
            mapping.push(TypeMapEntry {
                meta: source.types.builtins.i32,
                physical: i32_type,
            });
            let entry: L1.ProcedureId = std::usize_max();

            let index: usize = 0;
            while index < source.functions.length() {
                let lowered: L1.ProcedureId = lower_function(
                    source,
                    &mut unit,
                    index,
                    &mapping,
                );
                if index == source.entry {
                    entry = lowered;
                }
                index = index + 1;
            }

            // Function id zero is a valid first entry in the bootstrap ABI;
            // use the function table to detect the genuinely empty program.
            if source.functions.length() == 0 {
                return Result {
                    unit: unit,
                    entry: entry,
                    diagnostic: 4401,
                };
            }
            return Result {
                unit: unit,
                entry: entry,
                diagnostic: 0,
            };
        };

        return std::module {
            @export let L1: Module = L1;
            @export let Result: type = Result;
            @export let program = program;
        };
    };
};
