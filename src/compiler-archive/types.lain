// Compile-time type and module values owned by the Lain compiler.
//
// A source module imports this file as one namespace:
//
//   let types: Module = import("packages::lain::compiler::types");
//   let value: types.TypeValue = ...;
//
// TypeId is the identity used by elaboration and specialization.  Runtime
// representation is a separate property and only that representation reaches
// LAIN-IR.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");

@export
let types: Module = std::module {

    @export
    let TypeId: type = usize;

    @export
    let ModuleId: type = usize;

    @export
    let NamespaceId: type = usize;

    @export
    let TypeKind: type = i32;

    @export
    let ComptimeKind: type = i32;

    @export
    let Builtins: type = std::struct {
        i32: TypeId,
        bool: TypeId,
        addr: TypeId,
        unit: TypeId,
        type: TypeId,
        module: TypeId,
        callable: TypeId,
    };


    @export
    let TypeValue: type = std::struct {
        id: TypeId,
        kind: TypeKind,
        argument_start: usize,
        argument_count: usize,
        nominal_owner: ModuleId,
        namespace: NamespaceId,
    };


    // A ModuleValue is a compile-time value.  Its identity participates in a
    // specialization key; its namespace is the set of exported bindings.
    @export
    let ModuleValue: type = std::struct {
        id: ModuleId,
        namespace: NamespaceId,
    };


    @export
    let ComptimeValue: type = std::struct {
        type_id: TypeId,
        kind: ComptimeKind,
        i32_payload: i32,
        bool_payload: bool,
        type_payload: TypeId,
        module_payload: ModuleId,
        valid: bool,
    };


    @export
    let Registry = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let TypeVector: type = vector.Vec(
            TypeValue,
            Memory.Allocation,
            Memory.Bounds,
        );

        let TypeArgumentVector: type = vector.Vec(
            TypeId,
            Memory.Allocation,
            Memory.Bounds,
        );

        let ModuleVector: type = vector.Vec(
            ModuleValue,
            Memory.Allocation,
            Memory.Bounds,
        );

        let RegistryState: type = std::struct {
            values: TypeVector,
            arguments: TypeArgumentVector,
            modules: ModuleVector,
            builtins: Builtins,
        };

        let new = std::func() -> RegistryState
            ! {Memory.Allocation.Effect} {
            let state: RegistryState = RegistryState {
                values: TypeVector.new(),
                arguments: TypeArgumentVector.new(),
                modules: ModuleVector.new(),
                builtins: Builtins {
                    i32: 1,
                    bool: 2,
                    addr: 3,
                    unit: 4,
                    type: 5,
                    module: 6,
                    callable: 7,
                },
            };

            let id: TypeId = 1;
            while id <= 7 {
                state.values.push(TypeValue {
                    id: id,
                    kind: 1,
                    argument_start: 0,
                    argument_count: 0,
                    nominal_owner: 0,
                    namespace: 0,
                });
                id = id + 1;
            }
            return state;
        };

        let same_arguments = std::func(
            state: &RegistryState,
            value: &TypeValue,
            arguments: &TypeArgumentVector,
        ) -> bool ! {Memory.Bounds.Effect} {
            if value.argument_count != arguments.length() {
                return false;
            }

            let index: usize = 0;
            while index < value.argument_count {
                let stored: &TypeId = state.arguments.get(
                    value.argument_start + index,
                );
                let requested: &TypeId = arguments.get(index);
                if *stored != *requested {
                    return false;
                }
                index = index + 1;
            }
            return true;
        };

        let intern = std::func(
            state: &mut RegistryState,
            kind: TypeKind,
            owner: ModuleId,
            namespace: NamespaceId,
            arguments: &TypeArgumentVector,
        ) -> TypeId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let index: usize = 0;
            while index < state.values.length() {
                let candidate: &TypeValue = state.values.get(index);
                if candidate.kind == kind {
                    if candidate.nominal_owner == owner {
                        if same_arguments(state, candidate, arguments) {
                            return candidate.id;
                        }
                    }
                }
                index = index + 1;
            }

            let argument_start: usize = state.arguments.length();
            let argument_index: usize = 0;
            while argument_index < arguments.length() {
                state.arguments.push(*arguments.get(argument_index));
                argument_index = argument_index + 1;
            }

            // TypeId zero is reserved for "not a type".
            let id: TypeId = state.values.length() + 1;
            state.values.push(TypeValue {
                id: id,
                kind: kind,
                argument_start: argument_start,
                argument_count: arguments.length(),
                nominal_owner: owner,
                namespace: namespace,
            });
            return id;
        };

        let get = std::func(
            state: &RegistryState,
            id: TypeId,
        ) -> &TypeValue ! {Memory.Bounds.Effect} {
            if id == 0 {
                Memory.Bounds.check(0, state.values.length());
            }
            return state.values.get(id - 1);
        };

        return std::module {
            @export let State: type = RegistryState;
            @export let TypeArgumentVector: type = TypeArgumentVector;
            @export let new = new;
            @export let intern = intern;
            @export let get = get;
            @export
            let invalid_namespace = std::func() -> NamespaceId {
                return 0;
            };
        };
    };


    @export
    let kind_builtin = std::func() -> TypeKind { return 1; };

    @export
    let kind_comptime = std::func() -> TypeKind { return 2; };

    @export
    let kind_nominal = std::func() -> TypeKind { return 3; };

    @export
    let kind_specialized = std::func() -> TypeKind { return 4; };


    @export
    let comptime_i32 = std::func(
        type_id: TypeId,
        value: i32,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_id,
            kind: 1,
            i32_payload: value,
            bool_payload: false,
            type_payload: 0,
            module_payload: 0,
            valid: true,
        };
    };


    @export
    let comptime_bool = std::func(
        type_id: TypeId,
        value: bool,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_id,
            kind: 2,
            i32_payload: 0,
            bool_payload: value,
            type_payload: 0,
            module_payload: 0,
            valid: true,
        };
    };


    @export
    let comptime_type = std::func(
        type_type_id: TypeId,
        value: TypeId,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: type_type_id,
            kind: 3,
            i32_payload: 0,
            bool_payload: false,
            type_payload: value,
            module_payload: 0,
            valid: value != 0,
        };
    };


    @export
    let comptime_module = std::func(
        module_type_id: TypeId,
        value: ModuleId,
    ) -> ComptimeValue {
        return ComptimeValue {
            type_id: module_type_id,
            kind: 4,
            i32_payload: 0,
            bool_payload: false,
            type_payload: 0,
            module_payload: value,
            valid: value != 0,
        };
    };


    @export
    let same_comptime_value = std::func(
        left: &ComptimeValue,
        right: &ComptimeValue,
    ) -> bool {
        if !left.valid || !right.valid { return false; }
        if left.type_id != right.type_id { return false; }
        if left.kind != right.kind { return false; }

        if left.kind == 1 {
            return left.i32_payload == right.i32_payload;
        }
        if left.kind == 2 {
            return left.bool_payload == right.bool_payload;
        }
        if left.kind == 3 {
            return left.type_payload == right.type_payload;
        }
        if left.kind == 4 {
            return left.module_payload == right.module_payload;
        }
        return false;
    };


    @export
    let callable_phase_meta = std::func() -> i32 { return 1; };

    @export
    let callable_phase_comptime = std::func() -> i32 { return 2; };

    @export
    let callable_phase_runtime = std::func() -> i32 { return 3; };
};
