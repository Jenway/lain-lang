// Typed construction API for the Lain-owned dynamic L1 model.
//
// There are no host handles here.  Every returned id indexes storage in the
// caller's L1.Unit.

let memory_model: Module = import("std::memory_model");
let l1_ir: Module = import("packages::lain::compiler::l1_ir");

@export
let l1_builder: Module = std::module {

    @export
    let Builder = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let L1: Module = l1_ir.Model(Memory);

        let empty_name = std::func() -> Memory.String {
            return Memory.String.new();
        };

        let empty_expression = std::func() -> L1.Expr {
            return L1.Expr {
                kind: 0,
                result_type: 0,
                left: 0,
                right: 0,
                index: 0,
                i32_value: 0,
                procedure: std::usize_max(),
                arguments: L1.ExprIdVector.new(),
            };
        };

        let i32_literal = std::func(
            unit: &mut L1.Unit,
            type_id: L1.TypeId,
            value: i32,
        ) -> L1.ExprId ! {Memory.Allocation.Effect} {
            let expression: L1.Expr = empty_expression();
            expression.kind = 1;
            expression.result_type = type_id;
            expression.i32_value = value;
            return L1.add_expression(unit, expression);
        };

        let parameter = std::func(
            unit: &mut L1.Unit,
            type_id: L1.TypeId,
            index: usize,
        ) -> L1.ExprId ! {Memory.Allocation.Effect} {
            let expression: L1.Expr = empty_expression();
            expression.kind = 2;
            expression.result_type = type_id;
            expression.index = index;
            return L1.add_expression(unit, expression);
        };

        let binary = std::func(
            unit: &mut L1.Unit,
            kind: i32,
            type_id: L1.TypeId,
            left: L1.ExprId,
            right: L1.ExprId,
        ) -> L1.ExprId ! {Memory.Allocation.Effect} {
            let expression: L1.Expr = empty_expression();
            expression.kind = kind;
            expression.result_type = type_id;
            expression.left = left;
            expression.right = right;
            return L1.add_expression(unit, expression);
        };

        let call = std::func(
            unit: &mut L1.Unit,
            type_id: L1.TypeId,
            procedure: L1.ProcedureId,
        ) -> L1.ExprId ! {Memory.Allocation.Effect} {
            let expression: L1.Expr = empty_expression();
            expression.kind = 20;
            expression.result_type = type_id;
            expression.procedure = procedure;
            return L1.add_expression(unit, expression);
        };

        let append_return = std::func(
            unit: &mut L1.Unit,
            region: L1.RegionId,
            value: L1.ExprId,
        ) -> L1.InstructionId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            return L1.append_instruction(unit, region, L1.Instruction {
                kind: 1,
                name: empty_name(),
                expression: value,
                destination: 0,
                value_type: 0,
                first_region: 0,
                second_region: 0,
            });
        };

        let append_if = std::func(
            unit: &mut L1.Unit,
            region: L1.RegionId,
            condition: L1.ExprId,
            then_region: L1.RegionId,
            else_region: L1.RegionId,
        ) -> L1.InstructionId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            return L1.append_instruction(unit, region, L1.Instruction {
                kind: 2,
                name: empty_name(),
                expression: condition,
                destination: 0,
                value_type: 0,
                first_region: then_region,
                second_region: else_region,
            });
        };

        return std::module {
            @export let L1: Module = L1;
            @export let new = L1.new;
            @export let i32_literal = i32_literal;
            @export let parameter = parameter;
            @export let binary = binary;
            @export let call = call;
            @export let append_call_argument = L1.append_call_argument;
            @export let begin_region = L1.begin_region;
            @export let append_return = append_return;
            @export let append_if = append_if;
            @export let add_procedure = L1.add_procedure;
            @export let add_parameter = L1.add_parameter;
        };
    };
};
