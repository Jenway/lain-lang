let codes = import("src::ir::ir_codes");
let vf = import("src::ir::verify::model");
let checks = import("src::ir::verify::checks");
let tab = import("src::host::symtab");
let mem = import("std::mem");

let trap_u64 = func(syms: Mut(tab.HostSymTab), msg: Slice(u8), detail: u64) -> u64 {
  let seen: u64 = tab.trap_report(syms, msg, detail);
  return mem.halt_now(detail);
};

let trap_text = func(syms: Mut(tab.HostSymTab), msg: Slice(u8), detail: u64) -> Slice(u8) {
  let dead: u64 = trap_u64(syms, msg, detail);
  return "";
};

let CH_NEWLINE = func() -> u8 { return 10; };
let CH_SPACE = func() -> u8 { return 32; };
let CH_HASH = func() -> u8 { return 35; };
let CH_PERCENT = func() -> u8 { return 37; };
let CH_LPAREN = func() -> u8 { return 40; };
let CH_RPAREN = func() -> u8 { return 41; };
let CH_DIGIT_ZERO = func() -> u8 { return 48; };
let CH_RBRACK = func() -> u8 { return 93; };
let CH_RANGLE = func() -> u8 { return 62; };

pub let TextWriter = struct {
  buf: MutSlice(u8),
  len: u64,
  ok: u64,
};

pub let writer_new = func(buf: MutSlice(u8)) -> TextWriter {
  return TextWriter { buf: buf, len: 0, ok: 1 };
};

pub let writer_len = func(w: Mut(TextWriter)) -> u64 {
  return w.len;
};

pub let writer_ok = func(w: Mut(TextWriter)) -> u64 {
  return w.ok;
};

pub let put_byte = func(w: Mut(TextWriter), b: u8) -> u64 {
  if w.ok == 0 { return 0; }
  if w.len >= w.buf.len {
    w.ok = 0;
    return 0;
  }
  w.buf[w.len] = b;
  w.len = w.len + 1;
  return 1;
};

pub let put_str = func(w: Mut(TextWriter), s: Slice(u8)) -> u64 {
  let i: u64 = loop c(i: u64 = 0) while i < s.len {
    let rc: u64 = put_byte(w, s[i]);
    i = i + 1;
  };
  return 1;
};

pub let put_u64_dec = func(w: Mut(TextWriter), v: u64) -> u64 {
  if v >= 10 { put_u64_dec(w, v / 10); }
  let d: u8 = CH_DIGIT_ZERO() + ((v - v / 10 * 10) as u8);
  return put_byte(w, d);
};

pub let put_symbol = func(w: Mut(TextWriter), syms: Mut(tab.HostSymTab), h: u64) -> u64 {
  let n: u64 = tab.sym_len(syms, h);
  let p: Ref(u8) = tab.sym_addr(syms, h);
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let b: u8 = deref(p + i);
    let rc: u64 = put_byte(w, b);
    i = i + 1;
  };
  return 1;
};

pub let IrDataView = struct {
  symbol: u64,
  bytes: Ref(u8),
  size: u64,
  is_writable: u64,
};

pub let opcode_name = func(syms: Mut(tab.HostSymTab), k: u64) -> Slice(u8) {
  if k == codes.InstKind.Add as u64 { return "add"; }
  if k == codes.InstKind.Sub as u64 { return "sub"; }
  if k == codes.InstKind.Mul as u64 { return "mul"; }
  if k == codes.InstKind.SDiv as u64 { return "sdiv"; }
  if k == codes.InstKind.UDiv as u64 { return "udiv"; }
  if k == codes.InstKind.SRem as u64 { return "srem"; }
  if k == codes.InstKind.URem as u64 { return "urem"; }
  if k == codes.InstKind.And as u64 { return "and"; }
  if k == codes.InstKind.Or as u64 { return "or"; }
  if k == codes.InstKind.Xor as u64 { return "xor"; }
  if k == codes.InstKind.Shl as u64 { return "shl"; }
  if k == codes.InstKind.LShr as u64 { return "lshr"; }
  if k == codes.InstKind.AShr as u64 { return "ashr"; }
  if k == codes.InstKind.FAdd as u64 { return "fadd"; }
  if k == codes.InstKind.FSub as u64 { return "fsub"; }
  if k == codes.InstKind.FMul as u64 { return "fmul"; }
  if k == codes.InstKind.FDiv as u64 { return "fdiv"; }
  if k == codes.InstKind.FNeg as u64 { return "fneg"; }
  if k == codes.InstKind.Eq as u64 { return "eq"; }
  if k == codes.InstKind.Ne as u64 { return "ne"; }
  if k == codes.InstKind.SLt as u64 { return "slt"; }
  if k == codes.InstKind.SLe as u64 { return "sle"; }
  if k == codes.InstKind.SGt as u64 { return "sgt"; }
  if k == codes.InstKind.SGe as u64 { return "sge"; }
  if k == codes.InstKind.ULt as u64 { return "ult"; }
  if k == codes.InstKind.ULe as u64 { return "ule"; }
  if k == codes.InstKind.UGt as u64 { return "ugt"; }
  if k == codes.InstKind.UGe as u64 { return "uge"; }
  if k == codes.InstKind.FOEq as u64 { return "foeq"; }
  if k == codes.InstKind.FONe as u64 { return "fone"; }
  if k == codes.InstKind.FOLt as u64 { return "folt"; }
  if k == codes.InstKind.FOLe as u64 { return "fole"; }
  if k == codes.InstKind.FOGt as u64 { return "fogt"; }
  if k == codes.InstKind.FOGe as u64 { return "foge"; }
  if k == codes.InstKind.FUEq as u64 { return "fueq"; }
  if k == codes.InstKind.FUNe as u64 { return "fune"; }
  if k == codes.InstKind.FULt as u64 { return "fult"; }
  if k == codes.InstKind.FULE as u64 { return "fule"; }
  if k == codes.InstKind.FUGt as u64 { return "fugt"; }
  if k == codes.InstKind.FUGe as u64 { return "fuge"; }
  if k == codes.InstKind.ZExt as u64 { return "zext"; }
  if k == codes.InstKind.SExt as u64 { return "sext"; }
  if k == codes.InstKind.Trunc as u64 { return "trunc"; }
  if k == codes.InstKind.Bitcast as u64 { return "bitcast"; }
  if k == codes.InstKind.FPExt as u64 { return "fpext"; }
  if k == codes.InstKind.FPTrunc as u64 { return "fptrunc"; }
  if k == codes.InstKind.FPToSI as u64 { return "fptosi"; }
  if k == codes.InstKind.FPToUI as u64 { return "fptoui"; }
  if k == codes.InstKind.SIToFP as u64 { return "sitofp"; }
  if k == codes.InstKind.UIToFP as u64 { return "uitofp"; }
  if k == codes.InstKind.VAdd as u64 { return "vadd"; }
  if k == codes.InstKind.VSub as u64 { return "vsub"; }
  if k == codes.InstKind.VMul as u64 { return "vmul"; }
  if k == codes.InstKind.VDiv as u64 { return "vdiv"; }
  if k == codes.InstKind.VAnd as u64 { return "vand"; }
  if k == codes.InstKind.VOr as u64 { return "vor"; }
  if k == codes.InstKind.VXor as u64 { return "vxor"; }
  if k == codes.InstKind.VShl as u64 { return "vshl"; }
  if k == codes.InstKind.VShuffle as u64 { return "vshuffle"; }
  if k == codes.InstKind.VBroadcast as u64 { return "vbroadcast"; }
  if k == codes.InstKind.VExtract as u64 { return "vextract"; }
  if k == codes.InstKind.VInsert as u64 { return "vinsert"; }
  if k == codes.InstKind.VCmpEq as u64 { return "vcmpeq"; }
  if k == codes.InstKind.VCmpNe as u64 { return "vcmpne"; }
  if k == codes.InstKind.VCmpLt as u64 { return "vcmplt"; }
  if k == codes.InstKind.VCmpGt as u64 { return "vcmpgt"; }
  if k == codes.InstKind.Xchg as u64 { return "xchg"; }
  if k == codes.InstKind.Cmpxchg as u64 { return "cmpxchg"; }
  if k == codes.InstKind.RmwAdd as u64 { return "rmw_add"; }
  if k == codes.InstKind.RmwSub as u64 { return "rmw_sub"; }
  if k == codes.InstKind.RmwAnd as u64 { return "rmw_and"; }
  if k == codes.InstKind.RmwOr as u64 { return "rmw_or"; }
  if k == codes.InstKind.RmwXor as u64 { return "rmw_xor"; }
  if k == codes.InstKind.AtomicLoad as u64 { return "atomic_load"; }
  if k == codes.InstKind.AtomicStore as u64 { return "atomic_store"; }
  if k == codes.InstKind.AtomicFence as u64 { return "atomic_fence"; }
  if k == codes.InstKind.Lea as u64 { return "lea"; }
  if k == codes.InstKind.Load as u64 { return "load"; }
  if k == codes.InstKind.Store as u64 { return "store"; }
  if k == codes.InstKind.Alloca as u64 { return "alloca"; }
  if k == codes.InstKind.Call as u64 { return "call"; }
  if k == codes.InstKind.If as u64 { return "if"; }
  if k == codes.InstKind.Loop as u64 { return "loop"; }
  if k == codes.InstKind.Switch as u64 { return "switch"; }
  if k == codes.InstKind.Yield as u64 { return "yield"; }
  if k == codes.InstKind.Break as u64 { return "break"; }
  if k == codes.InstKind.Continue as u64 { return "continue"; }
  if k == codes.InstKind.Return as u64 { return "return"; }
  if k == codes.InstKind.Unreachable as u64 { return "unreachable"; }
  return trap_text(syms, "emit_text: opcode kind out of range", k);
};

pub let emit_type = func(w: Mut(TextWriter), syms: Mut(tab.HostSymTab), t: vf.IrType) -> u64 {
  if t.kind == codes.TyKind.Addr as u64 {
    let n: u64 = put_str(w, "#ad");
    return n + put_str(w, "dr");
  }
  if t.kind == vf.IR_TYPE_BOOL { return put_str(w, "#bits<1>"); }
  if t.kind == codes.TyKind.Bits as u64 {
    let a: u64 = put_str(w, "#bits<");
    let b: u64 = put_u64_dec(w, t.width);
    return put_byte(w, CH_RANGLE());
  }
  if t.kind == codes.TyKind.Floats as u64 {
    let a: u64 = put_str(w, "#f<");
    let b: u64 = put_u64_dec(w, t.width);
    return put_byte(w, CH_RANGLE());
  }
  if t.kind == codes.TyKind.Vec as u64 {
    let a: u64 = put_str(w, "#vec<");
    let b: u64 = put_u64_dec(w, t.width);
    return put_byte(w, CH_RANGLE());
  }
  return trap_u64(syms, "emit_text: type kind out of range", t.kind);
};

pub let TextEmitter = struct {
  w: Mut(TextWriter),
  syms: Mut(tab.HostSymTab),
  m: Ref(vf.IrModule),
  depth: u64,
  count: u64,
  names: Mut(u64),
  kinds: Mut(u64),
  widths: Mut(u64),
};

let word_slot = func(base: Mut(u64), i: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), ptr_cast(Mut(u8), base) + i * size_of(u64));
};

pub let emitter_new = func(w: Mut(TextWriter), syms: Mut(tab.HostSymTab),
                          m: Ref(vf.IrModule)) -> TextEmitter {
  let base: Mut(u64) = checks.large_bind_base();
  return TextEmitter {
    w: w,
    syms: syms,
    m: m,
    depth: 0,
    count: 0,
    names: base,
    kinds: word_slot(base, vf.LARGE_BINDINGS()),
    widths: word_slot(base, vf.LARGE_BINDINGS() * 2),
  };
};

let bind_one = func(em: Mut(TextEmitter), name: u64, kind: u64, width: u64) -> u64 {
  if name == 0 { return trap_u64(em.syms, "emit_text: binding name is zero", name); }
  if em.count >= vf.LARGE_BINDINGS() {
    return trap_u64(em.syms, "emit_text: binding table exhausted", em.count);
  }
  let at: u64 = em.count;
  deref(word_slot(em.names, at)) = name;
  deref(word_slot(em.kinds, at)) = kind;
  deref(word_slot(em.widths, at)) = width;
  em.count = at + 1;
  return 1;
};

let scan_binding = func(em: Mut(TextEmitter), name: u64, i: u64) -> u64 {
  if i >= em.count { return 0; }
  if deref(word_slot(em.names, i)) == name { return i + 1; }
  return scan_binding(em, name, i + 1);
};

let find_binding = func(em: Mut(TextEmitter), name: u64) -> u64 {
  if name == 0 { return 0; }
  return scan_binding(em, name, 0);
};

let bind_params = func(em: Mut(TextEmitter), base: Ref(vf.IrParam), count: u64, i: u64) -> u64 {
  if i >= count { return 1; }
  let p: vf.IrParam = vf.param_at_ref(base, i);
  let rc: u64 = bind_one(em, p.name, p.ty_kind, p.ty_width);
  return bind_params(em, base, count, i + 1);
};

let region_of = func(em: Mut(TextEmitter), ri: u64) -> vf.IrRegion {
  if ri == vf.NO_REGION() {
    let dead: u64 = trap_u64(em.syms, "emit_text: region handle is NO_REGION", ri);
  }
  if ri >= em.m.region_count {
    let dead: u64 = trap_u64(em.syms, "emit_text: region index out of range", ri);
  }
  return vf.region_at_ref(em.m.regions, ri);
};

let inst_of = func(em: Mut(TextEmitter), ii: u64) -> vf.IrInst {
  if ii >= em.m.inst_count {
    let dead: u64 = trap_u64(em.syms, "emit_text: instruction index out of range", ii);
  }
  return vf.inst_at_ref(em.m.insts, ii);
};

let case_of = func(em: Mut(TextEmitter), ci: u64) -> vf.IrCase {
  if ci >= em.m.case_count {
    let dead: u64 = trap_u64(em.syms, "emit_text: case index out of range", ci);
  }
  return vf.case_at_ref(em.m.cases, ci);
};

let region_inst = func(r: vf.IrRegion, i: u64) -> u64 {
  let base: Ref(u8) = ptr_cast(Ref(u8), r.insts);
  let p: Ref(u64) = ptr_cast(Ref(u64), base + i * size_of(u64));
  return deref(p);
};

let scan_proc = func(em: Mut(TextEmitter), name: u64, i: u64) -> u64 {
  if i >= em.m.proc_count { return 0; }
  let p: vf.IrProc = vf.proc_at_ref(em.m.procs, i);
  if p.name == name { return i + 1; }
  return scan_proc(em, name, i + 1);
};

let find_proc = func(em: Mut(TextEmitter), name: u64) -> u64 {
  if name == 0 { return 0; }
  return scan_proc(em, name, 0);
};

let result_type = func(em: Mut(TextEmitter), it: vf.IrInst, i: u64) -> vf.IrType {
  let k: u64 = it.kind;
  if (k >= codes.InstKind.Eq as u64) and (k <= codes.InstKind.UGe as u64) { return vf.type_bool(); }
  if (k >= codes.InstKind.FOEq as u64) and (k <= codes.InstKind.FUGe as u64) { return vf.type_bool(); }
  if k == codes.InstKind.Lea as u64 { return vf.type_addr(); }
  if k == codes.InstKind.Alloca as u64 { return vf.type_addr(); }
  if k == codes.InstKind.If as u64 {
    if it.body == vf.NO_REGION() { return vf.type_void(); }
    let r: vf.IrRegion = region_of(em, it.body);
    if i >= r.result_count { return vf.type_void(); }
    return vf.type_at_ref(r.results, i);
  }
  if k == codes.InstKind.Loop as u64 {
    if it.body == vf.NO_REGION() { return vf.type_void(); }
    let r: vf.IrRegion = region_of(em, it.body);
    if i >= r.result_count { return vf.type_void(); }
    return vf.type_at_ref(r.results, i);
  }
  if k == codes.InstKind.Switch as u64 {
    if it.default_body == vf.NO_REGION() { return vf.type_void(); }
    let r: vf.IrRegion = region_of(em, it.default_body);
    if i >= r.result_count { return vf.type_void(); }
    return vf.type_at_ref(r.results, i);
  }
  if (k == codes.InstKind.Call as u64) and (it.symbol != 0) {
    let pi: u64 = find_proc(em, it.symbol);
    if pi == 0 { return vf.type_void(); }
    let p: vf.IrProc = vf.proc_at_ref(em.m.procs, pi - 1);
    if i >= p.result_count { return vf.type_void(); }
    return vf.type_at_ref(p.results, i);
  }
  return vf.inst_ty(it);
};

let define_results = func(em: Mut(TextEmitter), it: vf.IrInst, i: u64) -> u64 {
  if i >= it.result_count { return 1; }
  let name: u64 = vf.inst_result_name(it, i);
  let t: vf.IrType = result_type(em, it, i);
  let rc: u64 = bind_one(em, name, t.kind, t.width);
  return define_results(em, it, i + 1);
};

let emit_indent = func(em: Mut(TextEmitter), n: u64) -> u64 {
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let rc: u64 = put_str(em.w, "  ");
    i = i + 1;
  };
  return 1;
};

let emit_operand = func(em: Mut(TextEmitter), op: vf.IrOperand) -> u64 {
  if op.kind == codes.OperandKind.Value as u64 {
    put_byte(em.w, CH_PERCENT());
    return put_symbol(em.w, em.syms, op.name);
  }
  return put_u64_dec(em.w, op.bits);
};

let emit_operand_type = func(em: Mut(TextEmitter), op: vf.IrOperand) -> u64 {
  if op.kind != codes.OperandKind.Value as u64 { return put_str(em.w, "#bits<64>"); }
  let p: u64 = find_binding(em, op.name);
  if p == 0 { return trap_u64(em.syms, "emit_text: operand binding is not defined", op.name); }
  let t: vf.IrType = vf.IrType {
    kind: deref(word_slot(em.kinds, p - 1)),
    width: deref(word_slot(em.widths, p - 1)),
  };
  return emit_type(em.w, em.syms, t);
};

let emit_operands = func(em: Mut(TextEmitter), it: vf.IrInst, i: u64) -> u64 {
  if i >= it.operand_count { return 1; }
  if i > 0 { put_str(em.w, ", "); }
  let op: vf.IrOperand = vf.inst_op(it, i);
  emit_operand(em, op);
  return emit_operands(em, it, i + 1);
};

let accepts_align = func(k: u64) -> u64 {
  if k == codes.InstKind.Load as u64 { return 1; }
  if k == codes.InstKind.Store as u64 { return 1; }
  return 0;
};

let emit_operand_list = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  put_byte(em.w, CH_LPAREN());
  emit_operands(em, it, 0);
  if (it.align != 0) and (accepts_align(it.kind) == 1) {
    if it.operand_count > 0 { put_str(em.w, ", "); }
    put_str(em.w, "align=");
    put_u64_dec(em.w, it.align);
  }
  return put_byte(em.w, CH_RPAREN());
};

let emit_type_arg = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  if it.has_ty == 0 { return 1; }
  put_str(em.w, "[");
  let t: vf.IrType = vf.inst_ty(it);
  emit_type(em.w, em.syms, t);
  return put_byte(em.w, CH_RBRACK());
};

let emit_results_prefix = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  if it.result_count == 0 { return 1; }
  let i: u64 = loop c(i: u64 = 0) while i < it.result_count {
    if i > 0 { put_str(em.w, ", "); }
    put_byte(em.w, CH_PERCENT());
    put_symbol(em.w, em.syms, vf.inst_result_name(it, i));
    i = i + 1;
  };
  return put_str(em.w, " = ");
};

let emit_region_results = func(em: Mut(TextEmitter), r: vf.IrRegion) -> u64 {
  if r.result_count == 0 { return 1; }
  put_str(em.w, " -> (");
  let i: u64 = loop c(i: u64 = 0) while i < r.result_count {
    if i > 0 { put_str(em.w, ", "); }
    emit_type(em.w, em.syms, vf.type_at_ref(r.results, i));
    i = i + 1;
  };
  return put_byte(em.w, CH_RPAREN());
};

let emit_proc_results = func(em: Mut(TextEmitter), p: vf.IrProc) -> u64 {
  if p.result_count == 0 { return 1; }
  put_str(em.w, " -> ");
  if p.result_count == 1 {
    let t: vf.IrType = vf.type_at_ref(p.results, 0);
    return emit_type(em.w, em.syms, t);
  }
  put_byte(em.w, CH_LPAREN());
  let i: u64 = loop c(i: u64 = 0) while i < p.result_count {
    if i > 0 { put_str(em.w, ", "); }
    emit_type(em.w, em.syms, vf.type_at_ref(p.results, i));
    i = i + 1;
  };
  return put_byte(em.w, CH_RPAREN());
};

let emit_params = func(em: Mut(TextEmitter), base: Ref(vf.IrParam), count: u64, i: u64) -> u64 {
  if i >= count { return 1; }
  if i > 0 { put_str(em.w, ", "); }
  let p: vf.IrParam = vf.param_at_ref(base, i);
  put_byte(em.w, CH_PERCENT());
  put_symbol(em.w, em.syms, p.name);
  put_str(em.w, ": ");
  emit_type(em.w, em.syms, vf.param_ty(p));
  return emit_params(em, base, count, i + 1);
};

let emit_loop_params = func(em: Mut(TextEmitter), r: vf.IrRegion, i: u64) -> u64 {
  if i >= r.param_count { return 1; }
  if i > 0 { put_str(em.w, ", "); }
  let p: vf.IrParam = vf.param_at_ref(r.params, i);
  put_byte(em.w, CH_PERCENT());
  put_symbol(em.w, em.syms, p.name);
  put_str(em.w, ": ");
  emit_type(em.w, em.syms, vf.param_ty(p));
  put_str(em.w, " = 0");
  return emit_loop_params(em, r, i + 1);
};

let emit_opcode = func(em: Mut(TextEmitter), k: u64) -> u64 {
  put_byte(em.w, CH_HASH());
  return put_str(em.w, opcode_name(em.syms, k));
};

let emit_insts = func(em: Mut(TextEmitter), r: vf.IrRegion, i: u64) -> u64 {
  if i >= r.inst_count { return 1; }
  let ii: u64 = region_inst(r, i);
  let rc: u64 = emit_inst(em, ii);
  return emit_insts(em, r, i + 1);
};

let emit_body = func(em: Mut(TextEmitter), ri: u64) -> u64 {
  let saved: u64 = em.count;
  let r: vf.IrRegion = region_of(em, ri);
  let e: u64 = emit_insts(em, r, 0);
  em.count = saved;
  return e;
};

let emit_block = func(em: Mut(TextEmitter), ri: u64) -> u64 {
  let saved: u64 = em.count;
  let r: vf.IrRegion = region_of(em, ri);
  let b: u64 = bind_params(em, r.params, r.param_count, 0);
  let e: u64 = emit_insts(em, r, 0);
  em.count = saved;
  return e;
};

let emit_if = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  put_str(em.w, "#if ");
  let op: vf.IrOperand = vf.inst_op(it, 0);
  emit_operand(em, op);
  if it.body != vf.NO_REGION() {
    let r: vf.IrRegion = region_of(em, it.body);
    emit_region_results(em, r);
  }
  put_str(em.w, " {\n");
  em.depth = em.depth + 1;
  emit_body(em, it.body);
  em.depth = em.depth - 1;
  emit_indent(em, em.depth);
  if it.else_body == vf.NO_REGION() {
    return put_str(em.w, "}\n");
  }
  put_str(em.w, "} else {\n");
  em.depth = em.depth + 1;
  emit_body(em, it.else_body);
  em.depth = em.depth - 1;
  emit_indent(em, em.depth);
  return put_str(em.w, "}\n");
};

let emit_loop = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  put_str(em.w, "#loop ");
  put_symbol(em.w, em.syms, it.label);
  put_byte(em.w, CH_LPAREN());
  let r: vf.IrRegion = region_of(em, it.body);
  emit_loop_params(em, r, 0);
  put_byte(em.w, CH_RPAREN());
  emit_region_results(em, r);
  put_str(em.w, " {\n");
  em.depth = em.depth + 1;
  emit_block(em, it.body);
  em.depth = em.depth - 1;
  emit_indent(em, em.depth);
  return put_str(em.w, "}\n");
};

let emit_cases = func(em: Mut(TextEmitter), it: vf.IrInst, i: u64) -> u64 {
  if i >= it.case_count { return 1; }
  let cs: vf.IrCase = case_of(em, it.cases_at + i);
  em.depth = em.depth + 1;
  emit_indent(em, em.depth);
  put_str(em.w, "case ");
  put_u64_dec(em.w, cs.value);
  put_str(em.w, " {\n");
  em.depth = em.depth + 1;
  emit_body(em, cs.body);
  em.depth = em.depth - 1;
  emit_indent(em, em.depth);
  put_str(em.w, "}\n");
  em.depth = em.depth - 1;
  return emit_cases(em, it, i + 1);
};

let emit_default_case = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  if it.default_body == vf.NO_REGION() { return 1; }
  em.depth = em.depth + 1;
  emit_indent(em, em.depth);
  put_str(em.w, "default {\n");
  em.depth = em.depth + 1;
  emit_body(em, it.default_body);
  em.depth = em.depth - 1;
  emit_indent(em, em.depth);
  put_str(em.w, "}\n");
  em.depth = em.depth - 1;
  return 1;
};

let emit_switch = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  put_str(em.w, "#switch");
  emit_type_arg(em, it);
  put_byte(em.w, CH_SPACE());
  let op: vf.IrOperand = vf.inst_op(it, 0);
  emit_operand(em, op);
  if it.default_body != vf.NO_REGION() {
    let r: vf.IrRegion = region_of(em, it.default_body);
    emit_region_results(em, r);
  }
  put_str(em.w, " {\n");
  emit_cases(em, it, 0);
  emit_default_case(em, it);
  emit_indent(em, em.depth);
  return put_str(em.w, "}\n");
};

let emit_jump = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  emit_opcode(em, it.kind);
  put_byte(em.w, CH_SPACE());
  put_symbol(em.w, em.syms, it.label);
  if it.operand_count > 0 {
    put_byte(em.w, CH_LPAREN());
    emit_operands(em, it, 0);
    put_byte(em.w, CH_RPAREN());
  }
  return put_byte(em.w, CH_NEWLINE());
};

let emit_terminator = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  emit_opcode(em, it.kind);
  let i: u64 = loop c(i: u64 = 0) while i < it.operand_count {
    if i == 0 {
      put_byte(em.w, CH_SPACE());
    } else {
      put_str(em.w, ", ");
    }
    let op: vf.IrOperand = vf.inst_op(it, i);
    emit_operand(em, op);
    i = i + 1;
  };
  return put_byte(em.w, CH_NEWLINE());
};

let emit_call_signature = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  put_str(em.w, " [(");
  let i: u64 = loop c(i: u64 = 1) while i < it.operand_count {
    if i > 1 { put_str(em.w, ", "); }
    emit_operand_type(em, vf.inst_op(it, i));
    i = i + 1;
  };
  put_byte(em.w, CH_RPAREN());
  if it.has_ty == 1 {
    put_str(em.w, " -> ");
    let t: vf.IrType = vf.inst_ty(it);
    emit_type(em.w, em.syms, t);
  }
  return put_byte(em.w, CH_RBRACK());
};

let emit_call_rest = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  if it.symbol != 0 {
    put_str(em.w, " @");
    put_symbol(em.w, em.syms, it.symbol);
  } else {
    emit_call_signature(em, it);
  }
  emit_operand_list(em, it);
  return put_byte(em.w, CH_NEWLINE());
};

let emit_generic = func(em: Mut(TextEmitter), it: vf.IrInst) -> u64 {
  emit_opcode(em, it.kind);
  if it.kind == codes.InstKind.Call as u64 {
    return emit_call_rest(em, it);
  }
  emit_type_arg(em, it);
  emit_operand_list(em, it);
  return put_byte(em.w, CH_NEWLINE());
};

let emit_inst = func(em: Mut(TextEmitter), ii: u64) -> u64 {
  if em.w.ok == 0 { return 0; }
  let it: vf.IrInst = inst_of(em, ii);
  let k: u64 = it.kind;
  emit_indent(em, em.depth);
  emit_results_prefix(em, it);
  if k == codes.InstKind.If as u64 {
    emit_if(em, it);
  } else if k == codes.InstKind.Loop as u64 {
    emit_loop(em, it);
  } else if k == codes.InstKind.Switch as u64 {
    emit_switch(em, it);
  } else if (k == codes.InstKind.Break as u64) or (k == codes.InstKind.Continue as u64) {
    emit_jump(em, it);
  } else if (k == codes.InstKind.Yield as u64) or (k == codes.InstKind.Return as u64) {
    emit_terminator(em, it);
  } else if k == codes.InstKind.Unreachable as u64 {
    put_str(em.w, "#unreachable\n");
  } else {
    emit_generic(em, it);
  }
  return define_results(em, it, 0);
};

let data_slot = func(base: Ref(IrDataView), i: u64) -> Ref(IrDataView) {
  let raw: Ref(u8) = ptr_cast(Ref(u8), base);
  return ptr_cast(Ref(IrDataView), raw + i * size_of(IrDataView));
};

let emit_data = func(em: Mut(TextEmitter), d: IrDataView) -> u64 {
  put_str(em.w, "data ");
  put_symbol(em.w, em.syms, d.symbol);
  if d.is_writable == 1 {
    put_str(em.w, " rw");
  } else {
    put_str(em.w, " ro");
  }
  put_str(em.w, " {");
  let i: u64 = loop c(i: u64 = 0) while i < d.size {
    let p: Ref(u8) = d.bytes + i;
    let byte: u64 = deref(p) as u64;
    put_byte(em.w, CH_SPACE());
    put_u64_dec(em.w, byte);
    i = i + 1;
  };
  return put_str(em.w, " }\n");
};

let emit_data_all = func(em: Mut(TextEmitter), base: Ref(IrDataView), count: u64, i: u64) -> u64 {
  if i >= count { return 1; }
  let d: IrDataView = deref(data_slot(base, i));
  emit_data(em, d);
  return emit_data_all(em, base, count, i + 1);
};

let emit_extern_attrs = func(em: Mut(TextEmitter), p: vf.IrProc) -> u64 {
  let first: u64 = 1;
  put_str(em.w, " #extern(");
  if p.abi != 0 {
    put_str(em.w, "abi=\"");
    put_u64_dec(em.w, p.abi);
    put_str(em.w, "\"");
    first = 0;
  }
  if p.lib != 0 {
    if first == 0 { put_str(em.w, ", "); }
    put_str(em.w, "lib=\"");
    put_u64_dec(em.w, p.lib);
    put_str(em.w, "\"");
    first = 0;
  }
  if p.is_variadic != 0 {
    if first == 0 { put_str(em.w, ", "); }
    put_str(em.w, "variadic");
    first = 0;
  }
  return put_str(em.w, ")");
};

let emit_proc = func(em: Mut(TextEmitter), p: vf.IrProc) -> u64 {
  put_str(em.w, "#proc ");
  put_symbol(em.w, em.syms, p.name);
  put_byte(em.w, CH_LPAREN());
  emit_params(em, p.params, p.param_count, 0);
  put_byte(em.w, CH_RPAREN());
  emit_proc_results(em, p);
  if p.is_extern == 1 {
    if (p.abi != 0) or (p.lib != 0) or (p.is_variadic != 0) {
      emit_extern_attrs(em, p);
    } else {
      put_str(em.w, " #extern");
    }
    put_str(em.w, " \"");
    if p.link_name != 0 {
      put_symbol(em.w, em.syms, p.link_name);
    } else {
      put_symbol(em.w, em.syms, p.name);
    }
    return put_str(em.w, "\"\n");
  }
  put_str(em.w, " {\n");
  em.depth = 1;
  em.count = 0;
  bind_params(em, p.params, p.param_count, 0);
  emit_body(em, p.body);
  em.depth = 0;
  return put_str(em.w, "}\n");
};

let emit_procs = func(em: Mut(TextEmitter), i: u64) -> u64 {
  if i >= em.m.proc_count { return 1; }
  if i > 0 { put_byte(em.w, CH_NEWLINE()); }
  let p: vf.IrProc = vf.proc_at_ref(em.m.procs, i);
  emit_proc(em, p);
  return emit_procs(em, i + 1);
};

pub let emit_module_text = func(w: Mut(TextWriter), syms: Mut(tab.HostSymTab),
                               m: Ref(vf.IrModule), data: Ref(IrDataView),
                               data_count: u64) -> u64 {
  if w.ok == 0 { return 0; }
  let start: u64 = w.len;
  let e0: TextEmitter = emitter_new(w, syms, m);
  let em: Mut(TextEmitter) = mut_of(e0);
  emit_data_all(em, data, data_count, 0);
  if data_count > 0 {
    if m.proc_count > 0 { put_byte(w, CH_NEWLINE()); }
  }
  emit_procs(em, 0);
  if w.ok == 0 { return 0; }
  return w.len - start;
};
