// 物理类型（L1TypeKind）
pub let TyKind = enum(u64) {
  Bits = 0,
  Floats = 1,
  Vec = 2,
  Addr = 3
};

// 内存序（L1MemOrder）
pub let OrderKind = enum(u64) {
  Relaxed = 0,
  Acquire = 1,
  Release = 2,
  AcqRel = 3,
  SeqCst = 4
};

// 操作数种类（L1OperandKind）
pub let OperandKind = enum(u64) {
  Value = 0,
  Int = 1,
  Float = 2
};

