// 物理类型（L1TypeKind）
pub let TyKind = enum(u64) {
  Bits = 0,
  Floats = 1,
  Vec = 2,
  Addr = 3
};

pub let TY_BITS = func() -> u64 { return TyKind.Bits as u64; };
pub let TY_FLOATS = func() -> u64 { return TyKind.Floats as u64; };
pub let TY_VEC = func() -> u64 { return TyKind.Vec as u64; };
pub let TY_ADDR = func() -> u64 { return TyKind.Addr as u64; };

// 内存序（L1MemOrder）
pub let OrderKind = enum(u64) {
  Relaxed = 0,
  Acquire = 1,
  Release = 2,
  AcqRel = 3,
  SeqCst = 4
};

pub let ORDER_RELAXED = func() -> u64 { return OrderKind.Relaxed as u64; };
pub let ORDER_ACQUIRE = func() -> u64 { return OrderKind.Acquire as u64; };
pub let ORDER_RELEASE = func() -> u64 { return OrderKind.Release as u64; };
pub let ORDER_ACQ_REL = func() -> u64 { return OrderKind.AcqRel as u64; };
pub let ORDER_SEQ_CST = func() -> u64 { return OrderKind.SeqCst as u64; };

// 操作数种类（L1OperandKind）
pub let OperandKind = enum(u64) {
  Value = 0,
  Int = 1,
  Float = 2
};

