// 验证器诊断码（verify.h）
pub let VerifyErr = enum(u64) {
  Ok = 0,
  DuplicateBinding = 2001,
  UndefinedValue = 2002,
  AfterTerminator = 2003,
  NoTypeForLiteral = 2004,
  BadOperandType = 2005,
  MissingYield = 2006,
  BadJumpArity = 2007,
  MissingType = 2008,
  BadCondition = 2009,
  DuplicateCase = 2010,
  BadCallArity = 2011,
  BadTail = 2012,
  BadMemoryWidth = 2013,
  AllocaNotConst = 2014,
  UnknownCallee = 2015,
  UnknownProc = 2016,
  UnknownSymbol = 2017,
  UnknownLoop = 2018,
  BadReturn = 2019,
  BadResultCount = 2020,
  BodyDeclaresResults = 2021,
  DuplicateSubroutine = 2022,
  DuplicateData = 2023,
  BadAllocaCount = 2024,
  SwitchNoDefault = 2029,
  WidthTooWide = 2026,
  ZeroWidth = 2027,
  OutOfMemory = 2028
};
