// LAINIR 模块表示与静态验证器的公共入口。
//
// 记录结构与构造器在 src::ir::verify::model，校验遍次在 src::ir::verify::checks；
// 本文件只把两者的公开名字原样导出，导出签名与拆分前完全一致。
let model = import("src::ir::verify::model");
let checks = import("src::ir::verify::checks");

// --- 类型 -----------------------------------------------------------------
pub let IrType = model.IrType;
pub let IrOperand = model.IrOperand;
pub let IrParam = model.IrParam;
pub let IrCase = model.IrCase;
pub let IrInst = model.IrInst;
pub let IrRegion = model.IrRegion;
pub let IrProc = model.IrProc;
pub let IrModule = model.IrModule;
pub let IrBuilder = model.IrBuilder;
pub let VfCtx = checks.VfCtx;

// --- 类型类别 -------------------------------------------------------------
pub let TY_VOID = func() -> u64 { return model.TY_VOID(); };
pub let TY_BITS = func() -> u64 { return model.TY_BITS(); };
pub let TY_FLOAT = func() -> u64 { return model.TY_FLOAT(); };
pub let TY_ADDR = func() -> u64 { return model.TY_ADDR(); };
pub let TY_BOOL = func() -> u64 { return model.TY_BOOL(); };
pub let TY_VEC = func() -> u64 { return model.TY_VEC(); };

// --- 操作数类别 -----------------------------------------------------------
pub let OP_VALUE = func() -> u64 { return model.OP_VALUE(); };
pub let OP_INT = func() -> u64 { return model.OP_INT(); };
pub let OP_FLOAT = func() -> u64 { return model.OP_FLOAT(); };

// --- 验证器错误码 ---------------------------------------------------------
pub let ERR_OK = func() -> u64 { return model.ERR_OK(); };
pub let ERR_BAD_OPCODE = func() -> u64 { return model.ERR_BAD_OPCODE(); };
pub let ERR_UNDEF_VAL = func() -> u64 { return model.ERR_UNDEF_VAL(); };
pub let ERR_TYPE_MISMATCH = func() -> u64 { return model.ERR_TYPE_MISMATCH(); };
pub let ERR_NO_TERM = func() -> u64 { return model.ERR_NO_TERM(); };
pub let ERR_DUP_DEF = func() -> u64 { return model.ERR_DUP_DEF(); };
pub let ERR_BAD_SWITCH = func() -> u64 { return model.ERR_BAD_SWITCH(); };
pub let ERR_BIND_CAP = func() -> u64 { return model.ERR_BIND_CAP(); };

// --- 容量上限 -------------------------------------------------------------
pub let MAX_OPERANDS = func() -> u64 { return model.MAX_OPERANDS(); };
pub let MAX_RESULTS = func() -> u64 { return model.MAX_RESULTS(); };
pub let MAX_BINDINGS = func() -> u64 { return model.MAX_BINDINGS(); };
pub let LARGE_BINDINGS = func() -> u64 { return model.LARGE_BINDINGS(); };
pub let MAX_LOOPS = func() -> u64 { return model.MAX_LOOPS(); };
pub let MAX_DEPTH = func() -> u64 { return model.MAX_DEPTH(); };
pub let INST_CAP = func() -> u64 { return model.INST_CAP(); };
pub let REGION_CAP = func() -> u64 { return model.REGION_CAP(); };
pub let PROC_CAP = func() -> u64 { return model.PROC_CAP(); };
pub let PARAM_CAP = func() -> u64 { return model.PARAM_CAP(); };
pub let TYPE_CAP = func() -> u64 { return model.TYPE_CAP(); };
pub let CASE_CAP = func() -> u64 { return model.CASE_CAP(); };
pub let NO_REGION = func() -> u64 { return model.NO_REGION(); };

// --- 构造器 ---------------------------------------------------------------
pub let op_zero = func() -> IrOperand { return model.op_zero(); };
pub let op_value = func(name: u64) -> IrOperand { return model.op_value(name); };
pub let op_int = func(bits: u64) -> IrOperand { return model.op_int(bits); };
pub let op_float = func(bits: u64) -> IrOperand { return model.op_float(bits); };
pub let type_void = func() -> IrType { return model.type_void(); };
pub let type_bits = func(w: u64) -> IrType { return model.type_bits(w); };
pub let type_float = func(w: u64) -> IrType { return model.type_float(w); };
pub let type_addr = func() -> IrType { return model.type_addr(); };
pub let type_bool = func() -> IrType { return model.type_bool(); };
pub let type_vec = func(w: u64) -> IrType { return model.type_vec(w); };
pub let param_new = func(name: u64, ty: IrType) -> IrParam { return model.param_new(name, ty); };
pub let case_new = func(value: u64, body: u64) -> IrCase { return model.case_new(value, body); };
pub let inst_new = func(kind: u64) -> IrInst { return model.inst_new(kind); };

pub let region_new = func(params: Ref(IrParam), param_count: u64,
                          results: Ref(IrType), result_count: u64,
                          insts: Ref(u64), inst_count: u64) -> IrRegion {
  return model.region_new(params, param_count, results, result_count, insts, inst_count);
};

pub let proc_new = func(name: u64, params: Ref(IrParam), param_count: u64,
                        results: Ref(IrType), result_count: u64) -> IrProc {
  return model.proc_new(name, params, param_count, results, result_count);
};

pub let module_new = func(name: u64, procs: Ref(IrProc), proc_count: u64,
                          regions: Ref(IrRegion), region_count: u64,
                          insts: Ref(IrInst), inst_count: u64,
                          cases: Ref(IrCase), case_count: u64,
                          scratch: Mut(u64)) -> IrModule {
  return model.module_new(name, procs, proc_count, regions, region_count,
                          insts, inst_count, cases, case_count, scratch);
};

// --- 指令修改 -------------------------------------------------------------
pub let inst_set_type = func(it: Mut(IrInst), kind: u64, width: u64) -> u64 {
  return model.inst_set_type(it, kind, width);
};

pub let inst_add_operand = func(it: Mut(IrInst), op: IrOperand) -> u64 {
  return model.inst_add_operand(it, op);
};

pub let inst_add_result = func(it: Mut(IrInst), name: u64) -> u64 {
  return model.inst_add_result(it, name);
};

pub let inst_set_body = func(it: Mut(IrInst), ri: u64) -> u64 { return model.inst_set_body(it, ri); };
pub let inst_set_else = func(it: Mut(IrInst), ri: u64) -> u64 { return model.inst_set_else(it, ri); };
pub let inst_set_default = func(it: Mut(IrInst), ri: u64) -> u64 { return model.inst_set_default(it, ri); };

pub let inst_set_cases = func(it: Mut(IrInst), at: u64, count: u64) -> u64 {
  return model.inst_set_cases(it, at, count);
};

pub let inst_set_label = func(it: Mut(IrInst), label: u64) -> u64 { return model.inst_set_label(it, label); };
pub let inst_set_symbol = func(it: Mut(IrInst), symbol: u64) -> u64 { return model.inst_set_symbol(it, symbol); };
pub let inst_set_align = func(it: Mut(IrInst), align: u64) -> u64 { return model.inst_set_align(it, align); };
pub let proc_set_body = func(p: Mut(IrProc), ri: u64) -> u64 { return model.proc_set_body(p, ri); };
pub let proc_set_extern = func(p: Mut(IrProc), link: u64) -> u64 { return model.proc_set_extern(p, link); };

pub let proc_set_abi = func(p: Mut(IrProc), abi: u64, lib: u64, is_variadic: u64) -> u64 {
  return model.proc_set_abi(p, abi, lib, is_variadic);
};

// --- 记录读取 -------------------------------------------------------------
pub let inst_op = func(it: IrInst, i: u64) -> IrOperand { return model.inst_op(it, i); };
pub let inst_result_name = func(it: IrInst, i: u64) -> u64 { return model.inst_result_name(it, i); };
pub let inst_ty = func(it: IrInst) -> IrType { return model.inst_ty(it); };
pub let param_ty = func(p: IrParam) -> IrType { return model.param_ty(p); };
pub let inst_slot = func(base: Ref(IrInst), i: u64) -> Mut(IrInst) { return model.inst_slot(base, i); };
pub let region_slot = func(base: Ref(IrRegion), i: u64) -> Mut(IrRegion) { return model.region_slot(base, i); };
pub let proc_slot = func(base: Ref(IrProc), i: u64) -> Mut(IrProc) { return model.proc_slot(base, i); };
pub let param_slot = func(base: Ref(IrParam), i: u64) -> Ref(IrParam) { return model.param_slot(base, i); };
pub let type_slot = func(base: Ref(IrType), i: u64) -> Ref(IrType) { return model.type_slot(base, i); };
pub let case_slot = func(base: Ref(IrCase), i: u64) -> Ref(IrCase) { return model.case_slot(base, i); };
pub let inst_at_ref = func(base: Ref(IrInst), i: u64) -> IrInst { return model.inst_at_ref(base, i); };
pub let region_at_ref = func(base: Ref(IrRegion), i: u64) -> IrRegion { return model.region_at_ref(base, i); };
pub let proc_at_ref = func(base: Ref(IrProc), i: u64) -> IrProc { return model.proc_at_ref(base, i); };
pub let param_at_ref = func(base: Ref(IrParam), i: u64) -> IrParam { return model.param_at_ref(base, i); };
pub let type_at_ref = func(base: Ref(IrType), i: u64) -> IrType { return model.type_at_ref(base, i); };
pub let case_at_ref = func(base: Ref(IrCase), i: u64) -> IrCase { return model.case_at_ref(base, i); };

// --- 构造器（顺序追加到原始字节区）---------------------------------------
pub let builder_new = func(arena: Mut(u8)) -> IrBuilder { return model.builder_new(arena); };
pub let builder_clear = func(b: Mut(IrBuilder)) -> u64 { return model.builder_clear(b); };
pub let add_inst = func(b: Mut(IrBuilder), kind: u64) -> Mut(IrInst) { return model.add_inst(b, kind); };

pub let add_region = func(b: Mut(IrBuilder), params: Ref(IrParam), param_count: u64,
                          results: Ref(IrType), result_count: u64,
                          insts: Ref(u64), inst_count: u64) -> Mut(IrRegion) {
  return model.add_region(b, params, param_count, results, result_count, insts, inst_count);
};

pub let add_proc = func(b: Mut(IrBuilder), name: u64,
                        params: Ref(IrParam), param_count: u64,
                        results: Ref(IrType), result_count: u64) -> Mut(IrProc) {
  return model.add_proc(b, name, params, param_count, results, result_count);
};

pub let add_param = func(b: Mut(IrBuilder), name: u64, ty: IrType) -> Ref(IrParam) {
  return model.add_param(b, name, ty);
};

pub let add_type = func(b: Mut(IrBuilder), ty: IrType) -> Ref(IrType) { return model.add_type(b, ty); };
pub let add_case = func(b: Mut(IrBuilder), value: u64, body: u64) -> Ref(IrCase) { return model.add_case(b, value, body); };
pub let builder_module = func(b: Mut(IrBuilder), name: u64) -> IrModule { return model.builder_module(b, name); };

// --- 验证 -----------------------------------------------------------------
pub let VF_SCRATCH = func() -> u64 { return checks.VF_SCRATCH(); };
pub let large_bind_base = func() -> Mut(u64) { return checks.large_bind_base(); };

pub let vf_new_with_data = func(m: Ref(IrModule), data_syms: Ref(u64), data_count: u64) -> VfCtx {
  return checks.vf_new_with_data(m, data_syms, data_count);
};

pub let verify_inst = func(c: Mut(VfCtx), ri: u64, ii: u64) -> u64 { return checks.verify_inst(c, ri, ii); };
pub let verify_region = func(c: Mut(VfCtx), ri: u64) -> u64 { return checks.verify_region(c, ri); };
pub let verify_proc = func(c: Mut(VfCtx), pi: u64) -> u64 { return checks.verify_proc(c, pi); };
pub let verify_module = func(m: Ref(IrModule)) -> u64 { return checks.verify_module(m); };
pub let verify_module_large = func(m: Ref(IrModule)) -> u64 { return checks.verify_module_large(m); };

pub let verify_module_with_data = func(m: Ref(IrModule), data_syms: Ref(u64), data_count: u64) -> u64 {
  return checks.verify_module_with_data(m, data_syms, data_count);
};
