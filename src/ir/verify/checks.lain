let codes = import("src::ir::ir_codes");
let model = import("src::ir::verify::model");

open model;

pub let VfCtx = struct {
  m: Ref(IrModule),

  data_words: Slice(u64),
  proc: u64,
  count: u64,
  bind_cap: u64,
  depth: u64,
  err: u64,

  words: MutSlice(u64),
  loop_depth: u64,
};

pub let VF_SCRATCH = func() -> u64 {
  return MAX_BINDINGS() * 3 + MAX_LOOPS() * 2;
};

let bank_words = func(bind_cap: u64) -> u64 {
  return bind_cap * 3 + MAX_LOOPS() * 2;
};

