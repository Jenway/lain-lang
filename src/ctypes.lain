// ctypes.lain —— 复合类型工厂与转换判定：Ref / Mut / Slice / MutSlice / Array / Fn。
// 一切编号与物理投影都在 tyreg，这里只负责造形状、查重、判可转换性与切片的
// 16 字节头构造。不 import ctx / core，避免环。
let st = import("state");
let ty = import("types");
let agg = import("agg");
let ireg = import("tyreg");
let ir = import("ir");

let shapes_used = func(k: Mut(st.State)) -> u64 { return st.st_shpused(k) / agg.shp_rec(); };

let shape_at = func(k: Mut(st.State), i: u64) -> u64 { return agg.shape_at(k, i); };

let scan_kind_elem = func(k: Mut(st.State), kind: u64, elem: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let sh: u64 = shape_at(k, i);
  let got: u64 = if agg.shp_kind(sh) == kind {
    if agg.shp_elem(sh) == elem { agg.shp_tid(sh) } else { 0 }
  } else {
    0
  };
  if got != 0 { return got; }
  return scan_kind_elem(k, kind, elem, i + 1, n);
};

let scan_array = func(k: Mut(st.State), elem: u64, cnt: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let sh: u64 = shape_at(k, i);
  let got: u64 = if agg.shp_kind(sh) == agg.kind_array() {
    if agg.shp_elem(sh) == elem {
      if agg.shp_len(sh) == cnt { agg.shp_tid(sh) } else { 0 }
    } else {
      0
    }
  } else {
    0
  };
  if got != 0 { return got; }
  return scan_array(k, elem, cnt, i + 1, n);
};

let sig_same = func(p: u64, q: u64, np: u64, i: u64) -> u64 {
  if i >= np { return 1; }
  let wp: Mut(u64) = ptr_cast(Mut(u64), p + i * 8);
  let wq: Mut(u64) = ptr_cast(Mut(u64), q + i * 8);
  if deref(wp) != deref(wq) { return 0; }
  return sig_same(p, q, np, i + 1);
};

let scan_fn = func(k: Mut(st.State), ret: u64, np: u64, sig: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let sh: u64 = shape_at(k, i);
  let got: u64 = if agg.shp_kind(sh) == agg.kind_fn() {
    if agg.shp_ret(sh) == ret {
      if agg.shp_len(sh) == np {
        let p: u64 = agg.shp_sig(sh);
        if sig_same(p, sig, np, 0) == 1 { agg.shp_tid(sh) } else { 0 }
      } else {
        0
      }
    } else {
      0
    }
  } else {
    0
  };
  if got != 0 { return got; }
  return scan_fn(k, ret, np, sig, i + 1, n);
};

// --- 工厂 ---------------------------------------------------------------
let ref_t = func(k: Mut(st.State), elem: u64, mutv: u64) -> u64 {
  let kind: u64 = if mutv == 1 { agg.kind_mut() } else { agg.kind_ref() };
  let hit: u64 = scan_kind_elem(k, kind, elem, 0, shapes_used(k));
  if hit != 0 { return hit; }
  let sh: u64 = agg.shp_new(k, kind, 0, st.st_src(k));
  let p: Mut(agg.Shape) = agg.shp_ptr(sh);
  p.size = 8;
  p.align = 8;
  let e1: u64 = agg.shp_set_elem(sh, elem);
  let id: u64 = ireg.ty_add(k, ireg.lk_of_shape(kind), 0, 0, sh);
  let t1: u64 = agg.shp_set_tid(sh, id);
  return id;
};

let slice_t = func(k: Mut(st.State), elem: u64, mutv: u64) -> u64 {
  let kind: u64 = if mutv == 1 { agg.kind_mutslice() } else { agg.kind_slice() };
  let hit: u64 = scan_kind_elem(k, kind, elem, 0, shapes_used(k));
  if hit != 0 { return hit; }
  let sh: u64 = agg.shp_new(k, kind, 0, st.st_src(k));
  let p: Mut(agg.Shape) = agg.shp_ptr(sh);
  p.size = 16;
  p.align = 8;
  let e1: u64 = agg.shp_set_elem(sh, elem);
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let r: u64 = ireg.project(k, elem, t);
  let m: Mut(agg.Member) = agg.add_member(k, sh, 0, 0, 0, 1, ty.tk(t), ty.tw(t), ty.tsg(t), ty.tsh(t));
  let id: u64 = ireg.ty_add(k, ireg.lk_of_shape(kind), 0, 0, sh);
  let t1: u64 = agg.shp_set_tid(sh, id);
  return id;
};

let array_t = func(k: Mut(st.State), elem: u64, cnt: u64) -> u64 {
  let hit: u64 = scan_array(k, elem, cnt, 0, shapes_used(k));
  if hit != 0 { return hit; }
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let r: u64 = ireg.project(k, elem, t);
  let sh: u64 = agg.array_new(k, agg.kind_array(), cnt, ty.tk(t), ty.tw(t), ty.tsg(t),
                              ty.tsh(t));
  let e1: u64 = agg.shp_set_elem(sh, elem);
  let id: u64 = ireg.ty_add(k, ireg.lk_array(), 0, 0, sh);
  let t1: u64 = agg.shp_set_tid(sh, id);
  return id;
};

// sig 是形参 TypeId 数组在持久池里的地址，np 项。
let fn_t = func(k: Mut(st.State), ret: u64, np: u64, sig: u64) -> u64 {
  let hit: u64 = scan_fn(k, ret, np, sig, 0, shapes_used(k));
  if hit != 0 { return hit; }
  let sh: u64 = agg.shp_new(k, agg.kind_fn(), 0, st.st_src(k));
  let p: Mut(agg.Shape) = agg.shp_ptr(sh);
  p.size = 8;
  p.align = 8;
  p.length = np;
  let r1: u64 = agg.shp_set_ret(sh, ret);
  let s1: u64 = agg.shp_set_sig(sh, sig);
  let id: u64 = ireg.ty_add(k, ireg.lk_fn(), 0, 0, sh);
  let t1: u64 = agg.shp_set_tid(sh, id);
  return id;
};

// --- 查询 ---------------------------------------------------------------
let kind_of = func(sh: u64) -> u64 { return agg.shp_kind(sh); };

let elem_tid = func(k: Mut(st.State), sh: u64) -> u64 {
  let e: u64 = agg.shp_elem(sh);
  if e != 0 { return e; }
  let m: Mut(agg.Member) = agg.mem_index(sh, 0);
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let r: u64 = agg.mem_ty(k, m, t);
  return ireg.tid_of(k, t);
};

let elem_ty = func(k: Mut(st.State), sh: u64, out: Mut(ty.Ty)) -> u64 {
  let id: u64 = elem_tid(k, sh);
  return ireg.project(k, id, out);
};

let elem_size = func(k: Mut(st.State), sh: u64) -> u64 {
  return ireg.size_of(k, elem_tid(k, sh));
};

// Fn 形状 → 24 字节签名记录：[形参个数, 返回类型, 形参类型表]，与 ctx.sig_new 同构。
let SigRec = struct {
  np: u64,
  ret: Mut(ty.Ty),
  params: Mut(ty.Ty)
};

let sig_of_fn = func(k: Mut(st.State), sh: u64) -> Mut(u8) {
  let np: u64 = agg.shp_len(sh);
  let ret: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let r1: u64 = ireg.project(k, agg.shp_ret(sh), ret);
  let tab: Mut(u8) = st.st_alloc(k, np * 32 + 8);
  let sigp: u64 = agg.shp_sig(sh);
  let i: u64 = loop c(i: u64 = 0) while i < np {
    let tp: Mut(u64) = ptr_cast(Mut(u64), sigp + i * 8);
    let dst: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), tab + i * 32);
    let e: u64 = ireg.project(k, deref(tp), dst);
    i = i + 1;
  };
  let rec: Mut(SigRec) = ptr_cast(Mut(SigRec), st.st_alloc(k, 24));
  rec.np = np;
  rec.ret = ret;
  rec.params = ptr_cast(Mut(ty.Ty), tab);
  return ptr_cast(Mut(u8), rec);
};

// --- 转换判定 -----------------------------------------------------------
// 0 同型、1 只改类型（Mut→Ref、MutSlice→Slice）、2 现造切片头、3 位模式直通、
// 4 数值转换走 cast、9 不允许。
let conv_kind = func(k: Mut(st.State), from: Mut(ty.Ty), to: Mut(ty.Ty)) -> u64 {
  let fsh: u64 = ty.tsh(from);
  let tsh: u64 = ty.tsh(to);
  if tsh == 0 {
    if fsh == 0 { return 4; }
    // 带形状的值物理上是指针：落到裸指针只改类型，落到字宽走 cast 的 BITCAST。
    if ty.tk(to) == 3 { return 3; }
    if ty.tk(to) == 0 and ty.tw(to) == 64 { return 4; }
    return 9;
  }
  if fsh == 0 {
    // 反向同理：字宽 → 带形状指针要真发 BITCAST，物理类型不能靠改标注糊过去。
    if ty.tk(from) == 3 and ty.tk(to) == 3 { return 3; }
    return 4;
  }
  if fsh == tsh { return 0; }
  let fk: u64 = agg.shp_kind(fsh);
  let tk: u64 = agg.shp_kind(tsh);
  let fe: u64 = agg.shp_elem(fsh);
  let te: u64 = agg.shp_elem(tsh);
  // 引用之间的元素差异只影响解引用时怎么解释这 8 个字节，物理上都是指针：
  // 允许改标注（Ref(T) 与 Ref(U) 之间、Ref 与 Mut 的只读方向），禁止 Ref→Mut。
  if tk == agg.kind_mut() {
    if fk == agg.kind_ref() { return 9; }
    if fk != agg.kind_mut() { return 9; }
    if fe == te { return 0; }
    return 3;
  }
  if tk == agg.kind_ref() {
    if fk == agg.kind_string() { return 3; }
    if fk != agg.kind_ref() and fk != agg.kind_mut() { return 9; }
    if fe == te { return 1; }
    return 3;
  }
  if tk == agg.kind_slice() or tk == agg.kind_mutslice() {
    if fk == agg.kind_slice() or fk == agg.kind_mutslice() {
      if fe != te { return 9; }
      if fk == tk { return 0; }
      if tk == agg.kind_slice() { return 1; }
      return 9;
    }
    if fk == agg.kind_array() { return 2; }
    if fk == agg.kind_string() {
      if tk == agg.kind_mutslice() { return 9; }
      return 2;
    }
    return 9;
  }
  // 两个 Fn 形状即使编号不同，也按签名内容判定是否同型（物理上都是指针）。
  if tk == agg.kind_fn() {
    if fk != agg.kind_fn() { return 9; }
    if agg.shp_ret(fsh) != agg.shp_ret(tsh) { return 9; }
    let np: u64 = agg.shp_len(fsh);
    if np != agg.shp_len(tsh) { return 9; }
    if sig_same(agg.shp_sig(fsh), agg.shp_sig(tsh), np, 0) == 1 { return 3; }
    return 9;
  }
  // 聚合与数组的形状不同就是不同的类型：绝不按「种类相同」放行。
  return 9;
};

// 聚合/数组/字符串的地址值 → 16 字节切片头 {ptr@0, len@8}。
let slice_wrap = func(k: Mut(st.State), v: Mut(ty.Val), from_sh: u64, to: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let cnt: u64 = agg.shp_len(from_sh);
  let obj: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  let base: u64 = agg.new_bytes(k, 16, 8, obj);
  let s1: u64 = agg.store_at(k, base, 0, v, ir.taddr(k));
  let lv: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  let ut: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let u: u64 = ty.ty_u64(ut);
  let l0: u64 = ty.val_lit(lv, cnt, ut);
  let s2: u64 = agg.store_at(k, base, 8, lv, ut);
  return ty.val_ref(out, base, to);
};
