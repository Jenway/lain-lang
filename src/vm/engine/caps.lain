pub let CapKind = enum(u64) {
  Function = 1,
  AstTxBegin = 2,
  AstTxCommit = 3,
  AstTxRollback = 4,
  AstMkToken = 5,
  AstMkGroup = 6,
  TypeRecBegin = 7,
  TypeRecAdd = 8,
  TypeRecEnd = 9
};

pub let kind_callable = func(kind: CapKind) -> u64 {
  let k: u64 = kind as u64;
  if k < (CapKind.Function as u64) { return 0; }
  if k > (CapKind.TypeRecEnd as u64) { return 0; }
  return 1;
};

pub let CapEntry = struct {
  link_name: u64,
  kind: CapKind,
  context: u64,
  invoke_fn: Fn((u64, Slice(u64)) -> u64),
};

pub let CapTable = module {
  pub let Self = struct {
    entries: Mut(CapEntry),
    count: u64,
    cap: u64,
    frozen: u64,
  };

  pub let entry_at = func(t: Mut(Self), i: u64) -> Mut(CapEntry) {
    return t.entries + i * size_of(CapEntry);
  };

  pub let new = func(entries: Mut(CapEntry), cap: u64) -> Self {
    return Self { entries: entries, count: 0, cap: cap, frozen: 0 };
  };

  pub let register = func(t: Mut(Self), link_name: u64, kind: CapKind, context: u64,
                          invoke_fn: Fn((u64, Slice(u64)) -> u64)) -> u64 {
    if t.frozen == 1 { return 0; }
    if t.count >= t.cap { return 0; }
    let p: Mut(CapEntry) = entry_at(t, t.count);
    p.link_name = link_name;
    p.kind = kind;
    p.context = context;
    p.invoke_fn = invoke_fn;
    t.count = t.count + 1;
    return 1;
  };

  pub let freeze = func(t: Mut(Self)) -> u64 {
    t.frozen = 1;
    return 1;
  };

  pub let is_frozen = func(t: Mut(Self)) -> u64 { return t.frozen; };

  pub let find = func(t: Mut(Self), link_name: u64, i: u64) -> u64 {
    if i >= t.count { return 0; }
    let entry: CapEntry = deref(entry_at(t, i));
    if entry.link_name == link_name { return i + 1; }
    return find(t, link_name, i + 1);
  };

  pub let invoke = func(t: Mut(Self), link_name: u64, args: Slice(u64)) -> u64 {
    let hit: u64 = find(t, link_name, 0);
    if hit == 0 { return 0; }
    let e: Mut(CapEntry) = entry_at(t, hit - 1);
    if kind_callable(e.kind) == 0 { return 0; }
    let fn: Fn((u64, Slice(u64)) -> u64) = e.invoke_fn;
    if (fn as u64) == 0 { return 0; }
    return fn(e.context, args);
  };
};
