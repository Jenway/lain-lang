let codes = import("src::ir::ir_codes");
let vf = import("src::ir::verify::model");

pub let MAX_OPERANDS: u64 = 16;
pub let MAX_RESULTS: u64 = 2;
pub let STACK_ALIGN: u64 = 16;

pub let VmStatus = enum(u64) {
  Ready = 0,
  Running = 1,
  Dead = 2,
  Blocked = 3
};

pub let SliceStatus = enum(u64) {
  Runnable = 0,
  Done = 1,
  Trapped = 2,
  Blocked = 3
};

pub let VmTrap = enum(u64) {
  None = 0,
  MemoryOob = 1,
  Alignment = 2,
  PermViolation = 3,
  ArithDomain = 4,
  CapDenied = 5,
  CapacityExceeded = 6,
  Unreachable = 7,
  State = 8,
  Fuel = 9,
  CallDepth = 10,
  Unimplemented = 11,
  StackOverflow = 12
};

pub let Subcode = enum(u64) {
  None = 0,
  FrameNoRegion = 1001,
  FrameOverflow = 1002,
  SlotOverflow = 1003,
  RegionNoResult = 1004,
  UnknownInst = 1005,
  BadFrameDistance = 1006,
  ResultNoSlot = 1007,
  ShiftTooWide = 1010,
  DivideByZero = 1011,
  IntOverflow = 1012,
  BadBitsOp = 1013,
  BadCompareOp = 1014,
  BadConvertOp = 1015,
  LoadFault = 1020,
  StoreFault = 1021,
  ReadOnly = 1022,
  Alignment = 1023,
  BadMemoryWidth = 1024,
  AllocaOverflow = 1030,
  StackUnavailable = 1031,
  StackExhausted = 1032,
  StackWindow = 1033,
  FuelExhausted = 1040,
  CallDepth = 1041,
  CallArity = 1050,
  CallNoSub = 1051,
  CallNoBody = 1052,
  CallOperands = 1053,
  IndirectNoCall = 1054,
  IndirectNoSub = 1055,
  ReturnNoSlot = 1056,
  YieldResults = 1057,
  BreakNoLoop = 1058,
  BreakResults = 1059,
  BreakNoSlot = 1060,
  ContinueNoLoop = 1061,
  ContinueParams = 1062,
  LoopNoRegion = 1063,
  LoopParams = 1064,
  SwitchNoCases = 1065,
  SwitchNoDefault = 1066,
  CapUnresolved = 1067,
  CapNotFunction = 1068,
  CapNoFn = 1069,
  EntryNotFound = 1070,
  ArenaTooSmall = 1071,
  FloatUnsupported = 1072,
  VectorUnsupported = 1073,
  AtomicUnsupported = 1074,
  AlreadyStarted = 1075,
  AssemblyFailed = 1076,
  AtomicOrder = 1077
};

pub let Quota = module {
  pub let Self = struct {
    max_steps: u64,
    max_stack_bytes: u64,
    max_call_depth: u64,
  };

  pub let new = func(max_steps: u64, max_stack_bytes: u64, max_call_depth: u64) -> Self {
    return Self {
      max_steps: max_steps,
      max_stack_bytes: max_stack_bytes,
      max_call_depth: max_call_depth,
    };
  };
};

pub let Value = struct {
  width: u64,
  bits: u64,
};

pub let VALUE_SIZE: u64 = size_of(Value);

pub let value_zero = func() -> Value {
  return Value { width: 64, bits: 0 };
};

pub let value_bits = func(bits: u64, width: u64) -> Value {
  return Value { width: width, bits: bits & width_mask(width) };
};

pub let max_u64 = func() -> u64 {
  let zero: u64 = 0;
  return zero - 1;
};

pub let width_mask = func(width: u64) -> u64 {
  if width == 0 { return 0; }
  if width >= 64 { return max_u64(); }
  let one: u64 = 1;
  return (one << width) - 1;
};

pub let sign_fill = func(bits: u64, width: u64) -> u64 {
  if (width == 0) or (width >= 64) { return bits; }
  let mask: u64 = width_mask(width);
  let sign: u64 = (bits >> (width - 1)) & 1;
  if sign == 0 { return bits & mask; }
  return (bits & mask) | (max_u64() ^ mask);
};

pub let type_width = func(kind: u64, width: u64) -> u64 {
  if kind == codes.TyKind.Addr as u64 { return 64; }
  if width == 0 { return 64; }
  return width;
};

pub let type_size = func(kind: u64, width: u64) -> u64 {
  if kind == codes.TyKind.Addr as u64 { return 8; }
  if width < 8 { return 1; }
  return width / 8;
};

pub let align_to = func(n: u64, a: u64) -> u64 {
  let mask: u64 = a - 1;
  return (n + mask) & (max_u64() ^ mask);
};

pub let TraceKind = enum(u64) {
  None = 0,
  Enter = 1,
  Exit = 2,
  Trap = 3
};

pub let TraceEvent = struct {
  sub_sym: u64,
  depth: u64,
  steps: u64,
  kind: TraceKind,
};

pub let TRACE_EVENT_SIZE: u64 = size_of(TraceEvent);

pub let trace_none = func() -> TraceEvent {
  return TraceEvent { sub_sym: 0, depth: 0, steps: 0, kind: TraceKind.None };
};

pub let Result = struct {
  status: u64,
  steps_used: u64,
  result_width: u64,
  result_bits: u64,
  result_val: Mut(Value),
  trap_kind: u64,
  trap_status: u64,
};

let trap_cell: Array(u64, 2) = [64, 0];

let trap_value_ptr = func() -> Mut(Value) {
  return ptr_cast(Mut(Value), mut_of(trap_cell));
};

pub let vm_trap_result_bits = func(trap_kind: u64, trap_status: u64) -> Result {
  return Result {
    status: SliceStatus.Trapped as u64,
    steps_used: 0,
    result_width: 64,
    result_bits: 0,
    result_val: trap_value_ptr(),
    trap_kind: trap_kind,
    trap_status: trap_status,
  };
};

pub let vm_trap_result = func(trap_kind: VmTrap, trap_status: Subcode) -> Result {
  return vm_trap_result_bits(trap_kind as u64, trap_status as u64);
};

pub let param_type_at = func(params: Ref(vf.IrParam), i: u64) -> vf.IrType {
  let param: vf.IrParam = vf.param_at_ref(params, i);
  return vf.IrType { kind: param.ty_kind, width: param.ty_width };
};

pub let result_type_at = func(results: Ref(vf.IrType), i: u64) -> vf.IrType {
  return vf.type_at_ref(results, i);
};
