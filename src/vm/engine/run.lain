let codes = import("src::ir::ir_codes");
let vf = import("src::ir::verify::model");
let vs = import("src::vm::vspace");
let im = import("src::vm::image");
let st = import("src::vm::engine::state");
let caps = import("src::vm::engine::caps");
let tcbmod = import("src::vm::engine::tcb");
let ops = import("src::vm::engine::ops");

let TCB = tcbmod.TCB;
let Frame = tcbmod.Frame;

pub let vm_step = func(tcb: Mut(TCB)) -> st.Result {
  if (tcb.state as u64) == (st.VmStatus.Blocked as u64) {
    tcb.slice = st.SliceStatus.Blocked;
    return TCB.outcome(tcb);
  }
  if (tcb.state as u64) != (st.VmStatus.Running as u64) { return TCB.outcome(tcb); }
  if (tcb.quota_steps != 0) and (tcb.steps >= tcb.quota_steps) {
    TCB.trap(tcb, st.VmTrap.Fuel, st.Subcode.FuelExhausted);
    return TCB.outcome(tcb);
  }
  if tcb.frame_count == 0 {
    TCB.trap(tcb, st.VmTrap.State, st.Subcode.FrameNoRegion);
    return TCB.outcome(tcb);
  }
  let frame: Mut(Frame) = TCB.frame_at(tcb, tcb.frame_count - 1);
  let rec: im.ImageRegion = im.vm_region(tcb.image, frame.region);
  if rec.valid == 0 {
    TCB.trap(tcb, st.VmTrap.State, st.Subcode.FrameNoRegion);
    return TCB.outcome(tcb);
  }
  tcb.cur_region = frame.region;
  tcb.cur_position = frame.position;

  if frame.position >= rec.inst_count {
    if rec.result_count > 0 {
      TCB.trap(tcb, st.VmTrap.State, st.Subcode.RegionNoResult);
      return TCB.outcome(tcb);
    }
    let zero: st.Value = st.value_zero();
    let left: u64 = TCB.leave_frame(tcb, 0, zero, zero);
    return TCB.outcome(tcb);
  }
  let inst: vf.IrInst = im.vm_inst(tcb.image, frame.region, frame.position);
  if inst.kind >= codes.InstKind.Count as u64 {
    TCB.trap(tcb, st.VmTrap.State, st.Subcode.UnknownInst);
    return TCB.outcome(tcb);
  }
  let saved_count: u64 = tcb.frame_count;
  let saved_region: u64 = frame.region;
  let saved_position: u64 = frame.position;
  let ran: u64 = ops.dispatch(tcb, inst);
  tcb.steps = tcb.steps + 1;
  if ran != st.SliceStatus.Runnable as u64 { return TCB.outcome(tcb); }

  if tcb.frame_count == saved_count {
    let now: Mut(Frame) = TCB.frame_at(tcb, tcb.frame_count - 1);
    let stays: u64 = if (now.region == saved_region) and (now.position == saved_position) { 1 } else { 0 };
    if (stays == 1) and (inst.kind != codes.InstKind.Continue as u64) {
      now.position = saved_position + 1;
    }
  }
  return TCB.outcome(tcb);
};

pub let vm_tcb_start = func(tcb: Mut(TCB), entry: u64, args: Slice(u64)) -> u64 {
  if tcb.frame_count != 0 {
    return TCB.reject(tcb, st.Subcode.AlreadyStarted);
  }
  if (entry == im.NO_INDEX()) or (entry >= im.vm_sub_count(tcb.image)) {
    return TCB.reject(tcb, st.Subcode.EntryNotFound);
  }
  let sub: im.SubInfo = im.vm_sub(tcb.image, entry);
  if sub.body_region == im.NO_REGION() {
    return TCB.reject(tcb, st.Subcode.CallNoBody);
  }
  if args.len != sub.param_count {
    return TCB.reject(tcb, st.Subcode.CallArity);
  }
  if sub.param_count > st.MAX_OPERANDS {
    return TCB.reject(tcb, st.Subcode.CallOperands);
  }
  let rec: im.ImageRegion = im.vm_region(tcb.image, sub.body_region);
  if rec.valid == 0 {
    return TCB.reject(tcb, st.Subcode.FrameNoRegion);
  }
  if rec.slot_count > tcb.slot_cap {
    return TCB.reject(tcb, st.Subcode.SlotOverflow);
  }
  let f: Mut(Frame) = TCB.frame_at(tcb, 0);
  f.region = sub.body_region;
  f.position = 0;
  f.slot_base = 0;
  f.slot_count = rec.slot_count;
  f.parent_position = 0;
  f.label = 0;
  f.is_call_frame = 1;
  f.stack_mark = 0;
  TCB.clear_slots(tcb, 0, rec.slot_count);
  tcb.frame_count = 1;
  tcb.call_depth = 1;
  tcb.stack_used = 0;
  tcb.stack_peak = 0;
  tcb.steps = 0;
  tcb.has_result = 0;
  tcb.result_width = 64;
  tcb.result_bits = 0;
  tcb.trap_kind = st.VmTrap.None;
  tcb.trap_status = st.Subcode.None;
  tcb.trap_region = 0;
  tcb.trap_position = 0;
  tcb.slice = st.SliceStatus.Runnable;
  let bound: u64 = bind_entry_args(tcb, sub, args, 0);
  if bound != 0 { return bound; }
  tcb.state = st.VmStatus.Running;
  return st.SliceStatus.Runnable as u64;
};

let bind_entry_args = func(tcb: Mut(TCB), sub: im.SubInfo, args: Slice(u64), i: u64) -> u64 {
  if i >= sub.param_count { return 0; }
  let ty: vf.IrType = st.param_type_at(sub.params, i);
  let w: u64 = st.type_width(ty.kind, ty.width);
  let dst: Mut(st.Value) = TCB.slot_at(tcb, i);
  dst.width = w;
  dst.bits = args[i] & st.width_mask(w);
  return bind_entry_args(tcb, sub, args, i + 1);
};

let run_to_end = func(tcb: Mut(TCB)) -> st.Result {
  let spun: st.Result = loop spin(step: st.Result = vm_step(tcb)) while step.status == (st.SliceStatus.Runnable as u64) {
    step = vm_step(tcb);
  };
  return spun;
};

pub let vm_apply = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                        table: Mut(caps.CapTable), quota: st.Quota, owner: u64,
                        entry: u64, args: Slice(u64),
                        arena: MutSlice(u8)) -> st.Result {
  let empty: MutSlice(st.TraceEvent) =
      make_slice(MutSlice(st.TraceEvent), null_ref(Mut(st.TraceEvent)), 0);
  let count0: u64 = 0;
  let count: Mut(u64) = mut_of(count0);
  return vm_apply_traced(image, space, table, quota, owner, entry, args, arena, empty, count);
};

pub let vm_apply_traced = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                               table: Mut(caps.CapTable), quota: st.Quota, owner: u64,
                               entry: u64, args: Slice(u64), arena: MutSlice(u8),
                               trace: MutSlice(st.TraceEvent),
                               count: Mut(u64)) -> st.Result {
  let need: u64 = TCB.bytes(image, quota);
  if arena.len < need { return st.vm_trap_result(st.VmTrap.State, st.Subcode.ArenaTooSmall); }
  let lease: vs.StackLease = vs.vm_no_lease();
  if quota.max_stack_bytes > 0 {
    lease = vs.vm_alloc_stack(space, quota.max_stack_bytes, owner);
    if vs.vm_lease_none(lease) != 0 {
      return st.vm_trap_result(st.VmTrap.CapacityExceeded, st.Subcode.StackExhausted);
    }
  }
  let tcb: TCB = TCB.blank();
  let live: Mut(TCB) = mut_of(tcb);
  let made: u64 = TCB.init(image, space, table, quota, lease, owner, arena, live);
  if made == 0 {
    if vs.vm_lease_none(lease) == 0 {
      let dropped: u64 = vs.vm_free_stack(space, lease);
    }
    return st.vm_trap_result(st.VmTrap.State, st.Subcode.ArenaTooSmall);
  }
  let traced: u64 = TCB.set_trace(live, trace, count);
  let started: u64 = vm_tcb_start(live, entry, args);
  let result: st.Result = if started != (st.SliceStatus.Runnable as u64) { TCB.outcome(live) } else { run_to_end(live) };
  let closed: u64 = TCB.release(live);
  if vs.vm_lease_none(lease) == 0 {
    let freed: u64 = vs.vm_free_stack(space, lease);
  }
  return result;
};
