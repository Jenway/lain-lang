pub let TRAP_NONE = func() -> u64 { return 0; };
pub let TRAP_MEMORY_OOB = func() -> u64 { return 1; };
pub let TRAP_ALIGNMENT = func() -> u64 { return 2; };
pub let TRAP_PERM_VIOLATION = func() -> u64 { return 3; };
pub let TRAP_ARITH_DOMAIN = func() -> u64 { return 4; };
pub let TRAP_CAP_DENIED = func() -> u64 { return 5; };
pub let TRAP_CAPACITY_EXCEEDED = func() -> u64 { return 6; };
pub let TRAP_UNREACHABLE = func() -> u64 { return 7; };
pub let TRAP_STATE = func() -> u64 { return 8; };
pub let TRAP_FUEL = func() -> u64 { return 9; };
pub let TRAP_CALL_DEPTH = func() -> u64 { return 10; };
pub let TRAP_UNIMPLEMENTED = func() -> u64 { return 11; };
pub let TRAP_STACK_OVERFLOW = func() -> u64 { return 12; };

