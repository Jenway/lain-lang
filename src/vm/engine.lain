// --- 帧与 TCB -------------------------------------------------------------
pub let Frame = st.Frame;

pub let TCB = st.TCB;

// TCB 的 UFCS 入口：调用方 use 本模块后可以写 tcb.vm_step()、tcb.vm_tcb_steps()
// 这类形式，接收者可以是 TCB、Ref(TCB) 或 Mut(TCB)。
pub let Self = TCB;

// 引擎对外交出的执行结果。result_width/result_bits 是可直接读的摊平副本；
// result_val 指向同一个值（当前前端把聚合字段表示成指针，所以这里就是指针）。
pub let VmResult = st.VmResult;

// --- TCB 的读写面 ---------------------------------------------------------
