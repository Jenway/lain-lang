pub let vm_tcb_steps = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_steps(tcb); };
pub let vm_tcb_stack_peak = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_stack_peak(tcb); };
