let vs = import("src::vm::vspace");
let im = import("src::vm::image");
let st = import("src::vm::engine::state");
let run = import("src::vm::engine::run");

pub let MAX_OPERANDS = func() -> u64 { return st.MAX_OPERANDS(); };
pub let MAX_RESULTS = func() -> u64 { return st.MAX_RESULTS(); };

pub let VM_READY = func() -> u64 { return st.VM_READY(); };
pub let VM_RUNNING = func() -> u64 { return st.VM_RUNNING(); };
pub let VM_DEAD = func() -> u64 { return st.VM_DEAD(); };
pub let VM_BLOCKED = func() -> u64 { return st.VM_BLOCKED(); };

pub let SLICE_RUNNABLE = func() -> u64 { return st.SLICE_RUNNABLE(); };
pub let SLICE_DONE = func() -> u64 { return st.SLICE_DONE(); };
pub let SLICE_TRAPPED = func() -> u64 { return st.SLICE_TRAPPED(); };
pub let SLICE_BLOCKED = func() -> u64 { return st.SLICE_BLOCKED(); };

pub let TRAP_NONE = func() -> u64 { return st.TRAP_NONE(); };
pub let TRAP_MEMORY_OOB = func() -> u64 { return st.TRAP_MEMORY_OOB(); };
pub let TRAP_ALIGNMENT = func() -> u64 { return st.TRAP_ALIGNMENT(); };
pub let TRAP_PERM_VIOLATION = func() -> u64 { return st.TRAP_PERM_VIOLATION(); };
pub let TRAP_ARITH_DOMAIN = func() -> u64 { return st.TRAP_ARITH_DOMAIN(); };
pub let TRAP_CAP_DENIED = func() -> u64 { return st.TRAP_CAP_DENIED(); };
pub let TRAP_CAPACITY_EXCEEDED = func() -> u64 { return st.TRAP_CAPACITY_EXCEEDED(); };
pub let TRAP_UNREACHABLE = func() -> u64 { return st.TRAP_UNREACHABLE(); };
pub let TRAP_STATE = func() -> u64 { return st.TRAP_STATE(); };
pub let TRAP_FUEL = func() -> u64 { return st.TRAP_FUEL(); };
pub let TRAP_CALL_DEPTH = func() -> u64 { return st.TRAP_CALL_DEPTH(); };
pub let TRAP_UNIMPLEMENTED = func() -> u64 { return st.TRAP_UNIMPLEMENTED(); };
pub let TRAP_STACK_OVERFLOW = func() -> u64 { return st.TRAP_STACK_OVERFLOW(); };

pub let VmQuota = st.VmQuota;

pub let quota_new = func(max_steps: u64, max_stack_bytes: u64, max_call_depth: u64) -> VmQuota {
  return st.quota_new(max_steps, max_stack_bytes, max_call_depth);
};

pub let VmValue = st.VmValue;

pub let value_zero = func() -> VmValue {
  return st.value_zero();
};

pub let value_bits = func(bits: u64, width: u64) -> VmValue {
  return st.value_bits(bits, width);
};

pub let max_u64 = func() -> u64 {
  return st.max_u64();
};

pub let width_mask = func(width: u64) -> u64 {
  return st.width_mask(width);
};

pub let sign_fill = func(bits: u64, width: u64) -> u64 {
  return st.sign_fill(bits, width);
};

pub let type_width = func(kind: u64, width: u64) -> u64 {
  return st.type_width(kind, width);
};

pub let type_size = func(kind: u64, width: u64) -> u64 {
  return st.type_size(kind, width);
};

pub let VmCaps = sig {
  pub let Self: Type;
  pub let invoke: Fn((Mut(Self), u64, Slice(u64)) -> u64);
};

pub let CAP_FUNCTION = func() -> u64 { return st.CAP_FUNCTION(); };
pub let CAP_AST_TX_BEGIN = func() -> u64 { return st.CAP_AST_TX_BEGIN(); };
pub let CAP_AST_TX_COMMIT = func() -> u64 { return st.CAP_AST_TX_COMMIT(); };
pub let CAP_AST_TX_ROLLBACK = func() -> u64 { return st.CAP_AST_TX_ROLLBACK(); };
pub let CAP_AST_MK_TOKEN = func() -> u64 { return st.CAP_AST_MK_TOKEN(); };
pub let CAP_AST_MK_GROUP = func() -> u64 { return st.CAP_AST_MK_GROUP(); };
pub let CAP_TYPE_REC_BEGIN = func() -> u64 { return st.CAP_TYPE_REC_BEGIN(); };
pub let CAP_TYPE_REC_ADD = func() -> u64 { return st.CAP_TYPE_REC_ADD(); };
pub let CAP_TYPE_REC_END = func() -> u64 { return st.CAP_TYPE_REC_END(); };

pub let cap_kind_callable = func(kind: u64) -> u64 {
  return st.cap_kind_callable(kind);
};

pub let VmCapEntry = st.VmCapEntry;

pub let VmCapTable = st.VmCapTable;

pub let caps_new = func(entries: Mut(VmCapEntry), cap: u64) -> VmCapTable {
  return st.caps_new(entries, cap);
};

pub let caps_register = func(t: Mut(VmCapTable), link_name: u64, kind: u64, context: u64,
                            invoke_fn: Fn((u64, Slice(u64)) -> u64)) -> u64 {
  return st.caps_register(t, link_name, kind, context, invoke_fn);
};

pub let caps_freeze = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_freeze(t);
};

pub let caps_is_frozen = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_is_frozen(t);
};

pub let caps_find = func(t: Mut(VmCapTable), link_name: u64, i: u64) -> u64 {
  return st.caps_find(t, link_name, i);
};

pub let VmCapHost: VmCaps = module {
  pub let Self = VmCapTable;
  pub let invoke = func(self: Mut(VmCapTable), link_name: u64, args: Slice(u64)) -> u64 {
    return st.caps_invoke(self, link_name, args);
  };
};

pub let EP_IDLE = func() -> u64 { return st.EP_IDLE(); };
pub let EP_SENDER_PARKED = func() -> u64 { return st.EP_SENDER_PARKED(); };
pub let EP_RECEIVER_PARKED = func() -> u64 { return st.EP_RECEIVER_PARKED(); };
pub let EP_SENDER_DELIVERED = func() -> u64 { return st.EP_SENDER_DELIVERED(); };

pub let EP_OK = func() -> u64 { return st.EP_OK(); };
pub let EP_BLOCKED = func() -> u64 { return st.EP_BLOCKED(); };
pub let EP_BUSY = func() -> u64 { return st.EP_BUSY(); };

pub let Endpoint = st.Endpoint;

pub let endpoint_new = func(id: u64) -> Endpoint {
  return st.endpoint_new(id);
};

pub let endpoint_state = func(ep: Ref(Endpoint)) -> u64 {
  return st.endpoint_state(ep);
};

pub let endpoint_peer = func(ep: Ref(Endpoint)) -> u64 {
  return st.endpoint_peer(ep);
};

pub let endpoint_send = func(ep: Mut(Endpoint), who: u64, value: VmValue,
                             out_who: Mut(u64)) -> u64 {
  return st.endpoint_send(ep, who, value, out_who);
};

pub let endpoint_recv = func(ep: Mut(Endpoint), who: u64, out: Mut(VmValue),
                             out_who: Mut(u64)) -> u64 {
  return st.endpoint_recv(ep, who, out, out_who);
};

pub let endpoint_cancel = func(ep: Mut(Endpoint), who: u64) -> u64 {
  return st.endpoint_cancel(ep, who);
};

pub let VmTraceEvent = st.VmTraceEvent;

pub let TRACE_ENTER = func() -> u64 { return st.TRACE_ENTER(); };
pub let TRACE_EXIT = func() -> u64 { return st.TRACE_EXIT(); };
pub let TRACE_TRAP = func() -> u64 { return st.TRACE_TRAP(); };

pub let Frame = st.Frame;

pub let TCB = st.TCB;

pub let Self = TCB;

pub let VmResult = st.VmResult;

