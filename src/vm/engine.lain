let vs = import("src::vm::vspace");
let im = import("src::vm::image");
let st = import("src::vm::engine::state");
let run = import("src::vm::engine::run");

pub let MAX_OPERANDS = st.MAX_OPERANDS;
pub let MAX_RESULTS = st.MAX_RESULTS;

pub let Quota = st.Quota;

pub let VmStatus = module {
  pub let Ready: u64 = st.VmStatus.Ready as u64;
  pub let Running: u64 = st.VmStatus.Running as u64;
  pub let Dead: u64 = st.VmStatus.Dead as u64;
  pub let Blocked: u64 = st.VmStatus.Blocked as u64;
};

pub let SliceStatus = module {
  pub let Runnable: u64 = st.SliceStatus.Runnable as u64;
  pub let Done: u64 = st.SliceStatus.Done as u64;
  pub let Trapped: u64 = st.SliceStatus.Trapped as u64;
  pub let Blocked: u64 = st.SliceStatus.Blocked as u64;
};

pub let VmTrap = module {
  pub let None: u64 = st.VmTrap.None as u64;
  pub let MemoryOob: u64 = st.VmTrap.MemoryOob as u64;
  pub let Alignment: u64 = st.VmTrap.Alignment as u64;
  pub let PermViolation: u64 = st.VmTrap.PermViolation as u64;
  pub let ArithDomain: u64 = st.VmTrap.ArithDomain as u64;
  pub let CapDenied: u64 = st.VmTrap.CapDenied as u64;
  pub let CapacityExceeded: u64 = st.VmTrap.CapacityExceeded as u64;
  pub let Unreachable: u64 = st.VmTrap.Unreachable as u64;
  pub let State: u64 = st.VmTrap.State as u64;
  pub let Fuel: u64 = st.VmTrap.Fuel as u64;
  pub let CallDepth: u64 = st.VmTrap.CallDepth as u64;
  pub let Unimplemented: u64 = st.VmTrap.Unimplemented as u64;
  pub let StackOverflow: u64 = st.VmTrap.StackOverflow as u64;
};

pub let VmValue = st.VmValue;

pub let value_zero = func() -> VmValue {
  return st.value_zero();
};

pub let value_bits = func(bits: u64, width: u64) -> VmValue {
  return st.value_bits(bits, width);
};

pub let max_u64 = func() -> u64 {
  return st.max_u64();
};

pub let width_mask = func(width: u64) -> u64 {
  return st.width_mask(width);
};

pub let sign_fill = func(bits: u64, width: u64) -> u64 {
  return st.sign_fill(bits, width);
};

pub let type_width = func(kind: u64, width: u64) -> u64 {
  return st.type_width(kind, width);
};

pub let type_size = func(kind: u64, width: u64) -> u64 {
  return st.type_size(kind, width);
};

pub let VmCaps = sig {
  pub let Self: Type;
  pub let invoke: Fn((Mut(Self), u64, Slice(u64)) -> u64);
};

pub let CAP_FUNCTION = func() -> u64 { return st.CAP_FUNCTION(); };
pub let CAP_AST_TX_BEGIN = func() -> u64 { return st.CAP_AST_TX_BEGIN(); };
pub let CAP_AST_TX_COMMIT = func() -> u64 { return st.CAP_AST_TX_COMMIT(); };
pub let CAP_AST_TX_ROLLBACK = func() -> u64 { return st.CAP_AST_TX_ROLLBACK(); };
pub let CAP_AST_MK_TOKEN = func() -> u64 { return st.CAP_AST_MK_TOKEN(); };
pub let CAP_AST_MK_GROUP = func() -> u64 { return st.CAP_AST_MK_GROUP(); };
pub let CAP_TYPE_REC_BEGIN = func() -> u64 { return st.CAP_TYPE_REC_BEGIN(); };
pub let CAP_TYPE_REC_ADD = func() -> u64 { return st.CAP_TYPE_REC_ADD(); };
pub let CAP_TYPE_REC_END = func() -> u64 { return st.CAP_TYPE_REC_END(); };

pub let cap_kind_callable = func(kind: u64) -> u64 {
  return st.cap_kind_callable(kind);
};

pub let VmCapEntry = st.VmCapEntry;

pub let VmCapTable = st.VmCapTable;

pub let caps_new = func(entries: Mut(VmCapEntry), cap: u64) -> VmCapTable {
  return st.caps_new(entries, cap);
};

pub let caps_register = func(t: Mut(VmCapTable), link_name: u64, kind: u64, context: u64,
                            invoke_fn: Fn((u64, Slice(u64)) -> u64)) -> u64 {
  return st.caps_register(t, link_name, kind, context, invoke_fn);
};

pub let caps_freeze = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_freeze(t);
};

pub let caps_is_frozen = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_is_frozen(t);
};

pub let caps_find = func(t: Mut(VmCapTable), link_name: u64, i: u64) -> u64 {
  return st.caps_find(t, link_name, i);
};

pub let VmCapHost: VmCaps = module {
  pub let Self = VmCapTable;
  pub let invoke = func(self: Mut(VmCapTable), link_name: u64, args: Slice(u64)) -> u64 {
    return st.caps_invoke(self, link_name, args);
  };
};

pub let EP_IDLE = func() -> u64 { return st.EP_IDLE(); };
pub let EP_SENDER_PARKED = func() -> u64 { return st.EP_SENDER_PARKED(); };
pub let EP_RECEIVER_PARKED = func() -> u64 { return st.EP_RECEIVER_PARKED(); };
pub let EP_SENDER_DELIVERED = func() -> u64 { return st.EP_SENDER_DELIVERED(); };

pub let EP_OK = func() -> u64 { return st.EP_OK(); };
pub let EP_BLOCKED = func() -> u64 { return st.EP_BLOCKED(); };
pub let EP_BUSY = func() -> u64 { return st.EP_BUSY(); };

pub let Endpoint = st.Endpoint;

pub let endpoint_new = func(id: u64) -> Endpoint {
  return st.endpoint_new(id);
};

pub let endpoint_state = func(ep: Ref(Endpoint)) -> u64 {
  return st.endpoint_state(ep);
};

pub let endpoint_peer = func(ep: Ref(Endpoint)) -> u64 {
  return st.endpoint_peer(ep);
};

pub let endpoint_send = func(ep: Mut(Endpoint), who: u64, value: VmValue,
                             out_who: Mut(u64)) -> u64 {
  return st.endpoint_send(ep, who, value, out_who);
};

pub let endpoint_recv = func(ep: Mut(Endpoint), who: u64, out: Mut(VmValue),
                             out_who: Mut(u64)) -> u64 {
  return st.endpoint_recv(ep, who, out, out_who);
};

pub let endpoint_cancel = func(ep: Mut(Endpoint), who: u64) -> u64 {
  return st.endpoint_cancel(ep, who);
};

pub let VmTraceEvent = st.VmTraceEvent;

pub let TRACE_ENTER = func() -> u64 { return st.TRACE_ENTER(); };
pub let TRACE_EXIT = func() -> u64 { return st.TRACE_EXIT(); };
pub let TRACE_TRAP = func() -> u64 { return st.TRACE_TRAP(); };

pub let Frame = st.Frame;

pub let TCB = st.TCB;

pub let Self = TCB;

pub let VmResult = st.VmResult;

pub let vm_tcb_state = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_state(tcb); };
pub let vm_tcb_steps = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_steps(tcb); };
pub let vm_tcb_stack_peak = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_stack_peak(tcb); };
pub let vm_tcb_has_result = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_has_result(tcb); };
pub let vm_tcb_result = func(tcb: Ref(TCB)) -> VmValue {
  return st.vm_tcb_result(tcb);
};
pub let vm_tcb_trap_kind = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_kind(tcb); };
pub let vm_tcb_trap_status = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_status(tcb); };
pub let vm_tcb_trap_region = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_region(tcb); };
pub let vm_tcb_trap_position = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_position(tcb); };
pub let vm_tcb_current_region = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_current_region(tcb); };
pub let vm_tcb_call_depth = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_call_depth(tcb); };
pub let vm_tcb_frame_count = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_frame_count(tcb); };

pub let vm_tcb_frame_region = func(tcb: Ref(TCB), i: u64) -> u64 {
  return st.vm_tcb_frame_region(tcb, i);
};

pub let vm_tcb_frame_position = func(tcb: Ref(TCB), i: u64) -> u64 {
  return st.vm_tcb_frame_position(tcb, i);
};

pub let vm_tcb_frame_slot_base = func(tcb: Ref(TCB), i: u64) -> u64 {
  return st.vm_tcb_frame_slot_base(tcb, i);
};

pub let vm_tcb_frame_slot_count = func(tcb: Ref(TCB), i: u64) -> u64 {
  return st.vm_tcb_frame_slot_count(tcb, i);
};

pub let vm_tcb_slot = func(tcb: Ref(TCB), i: u64) -> VmValue {
  return st.vm_tcb_slot(tcb, i);
};

pub let vm_tcb_block = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_block(tcb);
};

pub let vm_tcb_wake = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_wake(tcb);
};

pub let vm_tcb_yield = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_yield(tcb);
};

pub let vm_tcb_resume = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_resume(tcb);
};

pub let frame_cap_of = func(image: Ref(im.VmImage), quota: Quota) -> u64 {
  return st.frame_cap_of(image, quota);
};

pub let vm_tcb_bytes = func(image: Ref(im.VmImage), quota: Quota) -> u64 {
  return st.vm_tcb_bytes(image, quota);
};

pub let vm_tcb_blank = func() -> TCB {
  return st.vm_tcb_blank();
};

pub let vm_tcb_new = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                          caps: Mut(VmCapTable), quota: Quota,
                          lease: vs.StackLease, owner: u64,
                          arena: MutSlice(u8), out: Mut(TCB)) -> u64 {
  return st.vm_tcb_new(image, space, caps, quota, lease, owner, arena, out);
};

pub let vm_tcb_set_trace = func(tcb: Mut(TCB), buf: MutSlice(VmTraceEvent),
                                count: Mut(u64)) -> u64 {
  return st.vm_tcb_set_trace(tcb, buf, count);
};

pub let vm_tcb_trace_count = func(tcb: Ref(TCB)) -> u64 {
  return st.vm_tcb_trace_count(tcb);
};

pub let vm_tcb_trace_cap = func(tcb: Ref(TCB)) -> u64 {
  return st.vm_tcb_trace_cap(tcb);
};

pub let vm_tcb_free = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_free(tcb);
};

pub let vm_result_trap = func(trap_kind: u64) -> VmResult {
  return st.vm_trap_result_bits(trap_kind, st.Subcode.AssemblyFailed as u64);
};

pub let vm_step = func(tcb: Mut(TCB)) -> VmResult {
  return run.vm_step(tcb);
};

pub let vm_tcb_start = func(tcb: Mut(TCB), entry: u64, args: Slice(u64)) -> u64 {
  return run.vm_tcb_start(tcb, entry, args);
};

pub let vm_apply = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                        caps: Mut(VmCapTable), quota: Quota, owner: u64,
                        entry: u64, args: Slice(u64),
                        arena: MutSlice(u8)) -> VmResult {
  return run.vm_apply(image, space, caps, quota, owner, entry, args, arena);
};

pub let vm_apply_traced = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                               caps: Mut(VmCapTable), quota: Quota, owner: u64,
                               entry: u64, args: Slice(u64), arena: MutSlice(u8),
                               trace: MutSlice(VmTraceEvent),
                               count: Mut(u64)) -> VmResult {
  return run.vm_apply_traced(image, space, caps, quota, owner, entry, args, arena, trace, count);
};
