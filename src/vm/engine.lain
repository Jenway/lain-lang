let ST_BREAK_NO_LOOP = func() -> u64 { return 1058; };
let ST_BREAK_RESULTS = func() -> u64 { return 1059; };
let ST_BREAK_NO_SLOT = func() -> u64 { return 1060; };
let ST_CONTINUE_NO_LOOP = func() -> u64 { return 1061; };
