// src/vm/engine.lain —— 确定性沙箱执行引擎（Lain-VM 的 CU + ALU）。
//
// 引擎不分配：帧栈、SSA 值槽与实参暂存区都在调用方给的一块字节区里按容量切出来。
// 引擎不调度：一次只推进一个 TCB。引擎不吞故障：出问题就地记进 TCB 并返回
// SLICE_TRAPPED，由宿主决定诊断与回收。
//
// 位置约定与内核一致：分派**之前**不推进 position。算子执行期间
// cur_region/cur_position 就是当前这条指令；分派之后，如果算子没换帧也没动位置，
// 引擎才把 position 推进一格。
//
// 地址模型：`#addr` 是单字无类型数值，引擎只做位模式算术。合法性完全由
// `VSpace` 的可访问窗口在访问那一刻判定；构造（`#lea`、`#alloca`）不判权限。
//
// 浮点：当前前端没有 f64 类型，浮点算子与浮点比较一律以 TRAP_UNIMPLEMENTED
// 确定性拒绝（状态 1072），不做任何静默错值。整数、位、比较、转换、访存、
// 调用与结构化控制流全部实现。
//
// 依赖契约（src/vm/vspace.lain）：
//   VmSpace / StackLease / MEM_READ / MEM_WRITE / MEM_CALL
//   vm_alloc_stack / vm_free_stack / vm_no_lease / vm_lease_none
//   vm_borrow / vm_end_borrow / vm_set_accessible
//   vm_lease_base / vm_lease_capacity / vm_check / vm_load / vm_store
// 依赖契约（src/vm/image.lain）：
//   VmImage / NO_REGION / NO_INDEX / ImageRegion / InstMeta / OperandRef /
//   ParamInit / CaseInfo / SubInfo
//   vm_region / vm_inst / vm_inst_meta / vm_operand_ref / vm_result_slot /
//   vm_param_init / vm_case / vm_symbol_addr / vm_sub / vm_sub_count /
//   vm_sub_addr / vm_sub_at / vm_sub_index_by_body /
//   vm_max_region_depth / vm_max_slots
//
// `vm_result_slot` 返回的下标相对帧的 slot_base；`vm_param_init` 的初值按
// 父帧（执行 #loop 那一帧）求值。
//
// VmResult.result_val 是指向同一个结果值的指针：当前前端把聚合里的聚合字段
// 表示成指针，调用方因此可以写 `result.result_val.bits`（与 `result.result_bits`
// 等价）。
//
// 本模块的结构体只放标量与指针字段：当前前端对「指针寻址的聚合里的聚合字段」
// 会多走一次解引用，所以配额、租约、结果都摊平成标量；需要交出聚合时（唯一的
// 例子是 VmResult.result_val）就交一个指针。依赖的 VmSpace / VmImage 只经访问器
// 使用，引擎不读它们的字段布局。
let codes = import("src::ir::ir_codes");
let vf = import("src::ir::verify");
let vs = import("src::vm::vspace");
let im = import("src::vm::image");

// --- 上限 -----------------------------------------------------------------
pub let MAX_OPERANDS = func() -> u64 { return 16; };
pub let MAX_RESULTS = func() -> u64 { return 2; };
let STACK_ALIGN = func() -> u64 { return 16; };

// --- 执行状态与切片结果 ----------------------------------------------------
pub let VM_READY = func() -> u64 { return 0; };
pub let VM_RUNNING = func() -> u64 { return 1; };
pub let VM_DEAD = func() -> u64 { return 2; };
pub let VM_BLOCKED = func() -> u64 { return 3; };

pub let SLICE_RUNNABLE = func() -> u64 { return 0; };
pub let SLICE_DONE = func() -> u64 { return 1; };
pub let SLICE_TRAPPED = func() -> u64 { return 2; };
pub let SLICE_BLOCKED = func() -> u64 { return 3; };

