};

pub let vm_tcb_blank = func() -> TCB {
  return st.vm_tcb_blank();
};

pub let vm_tcb_new = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                          caps: Mut(VmCapTable), quota: VmQuota,
                          lease: vs.StackLease, owner: u64,
                          arena: MutSlice(u8), out: Mut(TCB)) -> u64 {
  return st.vm_tcb_new(image, space, caps, quota, lease, owner, arena, out);
};

pub let vm_tcb_set_trace = func(tcb: Mut(TCB), buf: MutSlice(VmTraceEvent),
                                count: Mut(u64)) -> u64 {
  return st.vm_tcb_set_trace(tcb, buf, count);
};

pub let vm_tcb_trace_count = func(tcb: Ref(TCB)) -> u64 {
  return st.vm_tcb_trace_count(tcb);
};

pub let vm_tcb_trace_cap = func(tcb: Ref(TCB)) -> u64 {
  return st.vm_tcb_trace_cap(tcb);
};

pub let vm_tcb_free = func(tcb: Mut(TCB)) -> u64 {
  return st.vm_tcb_free(tcb);
};

// --- 结果装配 -------------------------------------------------------------
// 只知故障类别时的装配失败结果。
pub let vm_result_trap = func(trap_kind: u64) -> VmResult {
  return st.vm_result_trap(trap_kind);
};

// --- CU -------------------------------------------------------------------
// 推进一步。前置条件：TCB 处于 RUNNING；不满足时不动任何状态，原样返回当前切片结果。
pub let vm_step = func(tcb: Mut(TCB)) -> VmResult {
  return run.vm_step(tcb);
};

// 进入一个子过程：压根帧、把参数绑到最前面几个槽、置 RUNNING。
pub let vm_tcb_start = func(tcb: Mut(TCB), entry: u64, args: Slice(u64)) -> u64 {
  return run.vm_tcb_start(tcb, entry, args);
};

// apply 的物理契约：独立栈租约、独立 TCB、限额执行、终态交付。
// arena 里切出帧栈与值槽；栈租约按 max_stack_bytes 向 space 申请，结束后释放。
pub let vm_apply = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                        caps: Mut(VmCapTable), quota: VmQuota, owner: u64,
                        entry: u64, args: Slice(u64),
                        arena: MutSlice(u8)) -> VmResult {
  return run.vm_apply(image, space, caps, quota, owner, entry, args, arena);
};

// 与 vm_apply 相同，只是多挂一块轨迹缓冲区。空切片等价于不挂。
pub let vm_apply_traced = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                               caps: Mut(VmCapTable), quota: VmQuota, owner: u64,
                               entry: u64, args: Slice(u64), arena: MutSlice(u8),
                               trace: MutSlice(VmTraceEvent),
                               count: Mut(u64)) -> VmResult {
  return run.vm_apply_traced(image, space, caps, quota, owner, entry, args, arena, trace, count);
};
