let vs = import("src::vm::vspace");
let im = import("src::vm::image");
let st = import("src::vm::engine::state");
let cs = import("src::vm::engine::caps");
let ip = import("src::vm::engine::ipc");
let tb = import("src::vm::engine::tcb");
let run = import("src::vm::engine::run");

pub let MAX_OPERANDS = st.MAX_OPERANDS;
pub let MAX_RESULTS = st.MAX_RESULTS;

pub let Quota = st.Quota;

pub let VmStatus = module {
  pub let Ready: u64 = st.VmStatus.Ready as u64;
  pub let Running: u64 = st.VmStatus.Running as u64;
  pub let Dead: u64 = st.VmStatus.Dead as u64;
  pub let Blocked: u64 = st.VmStatus.Blocked as u64;
};

pub let SliceStatus = module {
  pub let Runnable: u64 = st.SliceStatus.Runnable as u64;
  pub let Done: u64 = st.SliceStatus.Done as u64;
  pub let Trapped: u64 = st.SliceStatus.Trapped as u64;
  pub let Blocked: u64 = st.SliceStatus.Blocked as u64;
};

pub let VmTrap = module {
  pub let None: u64 = st.VmTrap.None as u64;
  pub let MemoryOob: u64 = st.VmTrap.MemoryOob as u64;
  pub let Alignment: u64 = st.VmTrap.Alignment as u64;
  pub let PermViolation: u64 = st.VmTrap.PermViolation as u64;
  pub let ArithDomain: u64 = st.VmTrap.ArithDomain as u64;
  pub let CapDenied: u64 = st.VmTrap.CapDenied as u64;
  pub let CapacityExceeded: u64 = st.VmTrap.CapacityExceeded as u64;
  pub let Unreachable: u64 = st.VmTrap.Unreachable as u64;
  pub let State: u64 = st.VmTrap.State as u64;
  pub let Fuel: u64 = st.VmTrap.Fuel as u64;
  pub let CallDepth: u64 = st.VmTrap.CallDepth as u64;
  pub let Unimplemented: u64 = st.VmTrap.Unimplemented as u64;
  pub let StackOverflow: u64 = st.VmTrap.StackOverflow as u64;
};

pub let Value = st.Value;

pub let value_zero = func() -> Value {
  return st.value_zero();
};

pub let value_bits = func(bits: u64, width: u64) -> Value {
  return st.value_bits(bits, width);
};

pub let max_u64 = func() -> u64 {
  return st.max_u64();
};

pub let width_mask = func(width: u64) -> u64 {
  return st.width_mask(width);
};

pub let sign_fill = func(bits: u64, width: u64) -> u64 {
  return st.sign_fill(bits, width);
};

pub let type_width = func(kind: u64, width: u64) -> u64 {
  return st.type_width(kind, width);
};

pub let type_size = func(kind: u64, width: u64) -> u64 {
  return st.type_size(kind, width);
};

pub let Caps = sig {
  pub let Self: Type;
  pub let invoke: Fn((Mut(Self), u64, Slice(u64)) -> u64);
};

pub let CapKind = module {
  pub let Function: u64 = cs.CapKind.Function as u64;
  pub let AstTxBegin: u64 = cs.CapKind.AstTxBegin as u64;
  pub let AstTxCommit: u64 = cs.CapKind.AstTxCommit as u64;
  pub let AstTxRollback: u64 = cs.CapKind.AstTxRollback as u64;
  pub let AstMkToken: u64 = cs.CapKind.AstMkToken as u64;
  pub let AstMkGroup: u64 = cs.CapKind.AstMkGroup as u64;
  pub let TypeRecBegin: u64 = cs.CapKind.TypeRecBegin as u64;
  pub let TypeRecAdd: u64 = cs.CapKind.TypeRecAdd as u64;
  pub let TypeRecEnd: u64 = cs.CapKind.TypeRecEnd as u64;
};

pub let cap_kind_callable = func(kind: u64) -> u64 {
  return cs.kind_callable(kind as cs.CapKind);
};

pub let CapEntry = cs.CapEntry;

pub let CapTable = cs.CapTable;

pub let caps_new = func(entries: Mut(CapEntry), cap: u64) -> CapTable {
  return CapTable.new(entries, cap);
};

pub let caps_register = func(t: Mut(CapTable), link_name: u64, kind: u64, context: u64,
                            invoke_fn: Fn((u64, Slice(u64)) -> u64)) -> u64 {
  return CapTable.register(t, link_name, kind as cs.CapKind, context, invoke_fn);
};

pub let caps_freeze = func(t: Mut(CapTable)) -> u64 {
  return CapTable.freeze(t);
};

pub let caps_is_frozen = func(t: Mut(CapTable)) -> u64 {
  return CapTable.is_frozen(t);
};

pub let caps_find = func(t: Mut(CapTable), link_name: u64, i: u64) -> u64 {
  return CapTable.find(t, link_name, i);
};

pub let VmCapHost: Caps = module {
  pub let Self = CapTable.Self;
  pub let invoke = func(self: Mut(CapTable), link_name: u64, args: Slice(u64)) -> u64 {
    return CapTable.invoke(self, link_name, args);
  };
};

pub let EpState = module {
  pub let Idle: u64 = ip.EpState.Idle as u64;
  pub let SenderParked: u64 = ip.EpState.SenderParked as u64;
  pub let ReceiverParked: u64 = ip.EpState.ReceiverParked as u64;
  pub let SenderDelivered: u64 = ip.EpState.SenderDelivered as u64;
};

pub let EpStatus = module {
  pub let Ok: u64 = ip.EpStatus.Ok as u64;
  pub let Blocked: u64 = ip.EpStatus.Blocked as u64;
  pub let Busy: u64 = ip.EpStatus.Busy as u64;
};

pub let Endpoint = ip.Endpoint;

pub let endpoint_new = func(id: u64) -> Endpoint {
  return Endpoint.new(id);
};

pub let endpoint_state = func(ep: Ref(Endpoint)) -> u64 {
  return Endpoint.state(ep) as u64;
};

pub let endpoint_peer = func(ep: Ref(Endpoint)) -> u64 {
  return Endpoint.peer(ep);
};

pub let endpoint_send = func(ep: Mut(Endpoint), who: u64, value: Value,
                             out_who: Mut(u64)) -> u64 {
  return Endpoint.send(ep, who, value, out_who) as u64;
};

pub let endpoint_recv = func(ep: Mut(Endpoint), who: u64, out: Mut(Value),
                             out_who: Mut(u64)) -> u64 {
  return Endpoint.recv(ep, who, out, out_who) as u64;
};

pub let endpoint_cancel = func(ep: Mut(Endpoint), who: u64) -> u64 {
  return Endpoint.cancel(ep, who);
};

pub let TraceEvent = st.TraceEvent;

pub let TraceKind = module {
  pub let None: u64 = st.TraceKind.None as u64;
  pub let Enter: u64 = st.TraceKind.Enter as u64;
  pub let Exit: u64 = st.TraceKind.Exit as u64;
  pub let Trap: u64 = st.TraceKind.Trap as u64;
};

pub let trace_none = func() -> TraceEvent {
  return st.trace_none();
};

pub let Frame = tb.Frame;

pub let TCB = tb.TCB;

pub let Self = TCB;

pub let Result = st.Result;

pub let vm_tcb_state = func(tcb: Ref(TCB)) -> u64 { return TCB.state(tcb); };
pub let vm_tcb_steps = func(tcb: Ref(TCB)) -> u64 { return TCB.steps(tcb); };
pub let vm_tcb_stack_peak = func(tcb: Ref(TCB)) -> u64 { return TCB.stack_peak(tcb); };
pub let vm_tcb_has_result = func(tcb: Ref(TCB)) -> u64 { return TCB.has_result(tcb); };
pub let vm_tcb_result = func(tcb: Ref(TCB)) -> Value {
  return TCB.result_value(tcb);
};
pub let vm_tcb_trap_kind = func(tcb: Ref(TCB)) -> u64 { return TCB.trap_kind(tcb); };
pub let vm_tcb_trap_status = func(tcb: Ref(TCB)) -> u64 { return TCB.trap_status(tcb); };
pub let vm_tcb_trap_region = func(tcb: Ref(TCB)) -> u64 { return TCB.trap_region(tcb); };
pub let vm_tcb_trap_position = func(tcb: Ref(TCB)) -> u64 { return TCB.trap_position(tcb); };
pub let vm_tcb_current_region = func(tcb: Ref(TCB)) -> u64 { return TCB.current_region(tcb); };
pub let vm_tcb_call_depth = func(tcb: Ref(TCB)) -> u64 { return TCB.call_depth(tcb); };
pub let vm_tcb_frame_count = func(tcb: Ref(TCB)) -> u64 { return TCB.frame_count(tcb); };

pub let vm_tcb_frame_region = func(tcb: Ref(TCB), i: u64) -> u64 {
  return TCB.frame_region(tcb, i);
};

pub let vm_tcb_frame_position = func(tcb: Ref(TCB), i: u64) -> u64 {
  return TCB.frame_position(tcb, i);
};

pub let vm_tcb_frame_slot_base = func(tcb: Ref(TCB), i: u64) -> u64 {
  return TCB.frame_slot_base(tcb, i);
};

pub let vm_tcb_frame_slot_count = func(tcb: Ref(TCB), i: u64) -> u64 {
  return TCB.frame_slot_count(tcb, i);
};

pub let vm_tcb_slot = func(tcb: Ref(TCB), i: u64) -> Value {
  return TCB.slot(tcb, i);
};

pub let vm_tcb_block = func(tcb: Mut(TCB)) -> u64 {
  return TCB.block(tcb);
};

pub let vm_tcb_wake = func(tcb: Mut(TCB)) -> u64 {
  return TCB.wake(tcb);
};

pub let vm_tcb_yield = func(tcb: Mut(TCB)) -> u64 {
  return TCB.park(tcb);
};

pub let vm_tcb_resume = func(tcb: Mut(TCB)) -> u64 {
  return TCB.resume(tcb);
};

pub let frame_cap_of = func(image: Ref(im.VmImage), quota: Quota) -> u64 {
  return TCB.capacity(image, quota);
};

pub let vm_tcb_bytes = func(image: Ref(im.VmImage), quota: Quota) -> u64 {
  return TCB.bytes(image, quota);
};

pub let vm_tcb_blank = func() -> TCB {
  return TCB.blank();
};

pub let vm_tcb_new = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                          caps: Mut(CapTable), quota: Quota,
                          lease: vs.StackLease, owner: u64,
                          arena: MutSlice(u8), out: Mut(TCB)) -> u64 {
  return TCB.init(image, space, caps, quota, lease, owner, arena, out);
};

pub let vm_tcb_set_trace = func(tcb: Mut(TCB), buf: MutSlice(TraceEvent),
                                count: Mut(u64)) -> u64 {
  return TCB.set_trace(tcb, buf, count);
};

pub let vm_tcb_trace_count = func(tcb: Ref(TCB)) -> u64 {
  return TCB.trace_count(tcb);
};

pub let vm_tcb_trace_cap = func(tcb: Ref(TCB)) -> u64 {
  return TCB.trace_cap(tcb);
};

pub let vm_tcb_free = func(tcb: Mut(TCB)) -> u64 {
  return TCB.release(tcb);
};

pub let vm_result_trap = func(trap_kind: u64) -> Result {
  return st.vm_trap_result_bits(trap_kind, st.Subcode.AssemblyFailed as u64);
};

pub let vm_step = func(tcb: Mut(TCB)) -> Result {
  return run.vm_step(tcb);
};

pub let vm_tcb_start = func(tcb: Mut(TCB), entry: u64, args: Slice(u64)) -> u64 {
  return run.vm_tcb_start(tcb, entry, args);
};

pub let vm_apply = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                        caps: Mut(CapTable), quota: Quota, owner: u64,
                        entry: u64, args: Slice(u64),
                        arena: MutSlice(u8)) -> Result {
  return run.vm_apply(image, space, caps, quota, owner, entry, args, arena);
};

pub let vm_apply_traced = func(image: Ref(im.VmImage), space: Mut(vs.VmSpace),
                               caps: Mut(CapTable), quota: Quota, owner: u64,
                               entry: u64, args: Slice(u64), arena: MutSlice(u8),
                               trace: MutSlice(TraceEvent),
                               count: Mut(u64)) -> Result {
  return run.vm_apply_traced(image, space, caps, quota, owner, entry, args, arena, trace, count);
};
