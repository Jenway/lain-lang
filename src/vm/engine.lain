// --- 配额 -----------------------------------------------------------------
pub let VmQuota = st.VmQuota;

pub let quota_new = func(max_steps: u64, max_stack_bytes: u64, max_call_depth: u64) -> VmQuota {
  return st.quota_new(max_steps, max_stack_bytes, max_call_depth);
};

// --- 值 -------------------------------------------------------------------
pub let VmValue = st.VmValue;

pub let value_zero = func() -> VmValue {
  return st.value_zero();
};

pub let value_bits = func(bits: u64, width: u64) -> VmValue {
  return st.value_bits(bits, width);
};

// --- 最大值与位宽助手 -----------------------------------------------------
pub let max_u64 = func() -> u64 {
  return st.max_u64();
};

pub let width_mask = func(width: u64) -> u64 {
  return st.width_mask(width);
};

pub let sign_fill = func(bits: u64, width: u64) -> u64 {
  return st.sign_fill(bits, width);
};

pub let type_width = func(kind: u64, width: u64) -> u64 {
  return st.type_width(kind, width);
};

pub let type_size = func(kind: u64, width: u64) -> u64 {
  return st.type_size(kind, width);
};

// --- 能力空间 -------------------------------------------------------------
// 宿主能力的契约：Self 是宿主自己的状态类型，invoke 吃掉它、符号号与参数词。
pub let VmCaps = sig {
  pub let Self: Type;
  pub let invoke: Fn((Mut(Self), u64, Slice(u64)) -> u64);
};

pub let CAP_FUNCTION = func() -> u64 { return st.CAP_FUNCTION(); };
pub let CAP_AST_TX_BEGIN = func() -> u64 { return st.CAP_AST_TX_BEGIN(); };
pub let CAP_AST_TX_COMMIT = func() -> u64 { return st.CAP_AST_TX_COMMIT(); };
pub let CAP_AST_TX_ROLLBACK = func() -> u64 { return st.CAP_AST_TX_ROLLBACK(); };
pub let CAP_AST_MK_TOKEN = func() -> u64 { return st.CAP_AST_MK_TOKEN(); };
pub let CAP_AST_MK_GROUP = func() -> u64 { return st.CAP_AST_MK_GROUP(); };
pub let CAP_TYPE_REC_BEGIN = func() -> u64 { return st.CAP_TYPE_REC_BEGIN(); };
pub let CAP_TYPE_REC_ADD = func() -> u64 { return st.CAP_TYPE_REC_ADD(); };
pub let CAP_TYPE_REC_END = func() -> u64 { return st.CAP_TYPE_REC_END(); };

pub let cap_kind_callable = func(kind: u64) -> u64 {
  return st.cap_kind_callable(kind);
};

pub let VmCapEntry = st.VmCapEntry;

pub let VmCapTable = st.VmCapTable;

pub let caps_new = func(entries: Mut(VmCapEntry), cap: u64) -> VmCapTable {
  return st.caps_new(entries, cap);
};

pub let caps_register = func(t: Mut(VmCapTable), link_name: u64, kind: u64, context: u64,
                            invoke_fn: Fn((u64, Slice(u64)) -> u64)) -> u64 {
  return st.caps_register(t, link_name, kind, context, invoke_fn);
};

pub let caps_freeze = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_freeze(t);
};

pub let caps_is_frozen = func(t: Mut(VmCapTable)) -> u64 {
  return st.caps_is_frozen(t);
};

pub let caps_find = func(t: Mut(VmCapTable), link_name: u64, i: u64) -> u64 {
  return st.caps_find(t, link_name, i);
};

// VmCaps 的引擎侧见证：一张冻结过的能力表就是它的 Self。
pub let VmCapHost: VmCaps = module {
  pub let Self = VmCapTable;
  pub let invoke = func(self: Mut(VmCapTable), link_name: u64, args: Slice(u64)) -> u64 {
    return st.caps_invoke(self, link_name, args);
  };
};

