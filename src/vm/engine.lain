pub let vm_tcb_result = func(tcb: Ref(TCB)) -> VmValue {
  return st.vm_tcb_result(tcb);
};
pub let vm_tcb_trap_kind = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_kind(tcb); };
pub let vm_tcb_trap_status = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_status(tcb); };
pub let vm_tcb_trap_region = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_region(tcb); };
pub let vm_tcb_trap_position = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_trap_position(tcb); };
pub let vm_tcb_current_region = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_current_region(tcb); };
pub let vm_tcb_call_depth = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_call_depth(tcb); };
pub let vm_tcb_frame_count = func(tcb: Ref(TCB)) -> u64 { return st.vm_tcb_frame_count(tcb); };

