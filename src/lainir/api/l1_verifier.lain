// Structural verifier for dynamic L1.  It checks ids and procedure/region
// shape without adding source-language policy.

let memory_model: Module = import("std::memory_model");
let l1_ir: Module = import("packages::lain::lainir::api::l1_ir");

@export
let l1_verifier: Module = std::module {
    @export
    let Verifier = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let L1: Module = l1_ir.Model(Memory);

        let same_type = std::func(
            unit: &L1.Unit,
            left: L1.TypeId,
            right: L1.TypeId,
        ) -> bool ! {Memory.Bounds.Effect} {
            if left >= unit.types.length()
                || right >= unit.types.length() {
                return false;
            }
            let left_value: &L1.Type = unit.types.get(left);
            let right_value: &L1.Type = unit.types.get(right);
            return left_value.kind == right_value.kind
                && left_value.bit_width == right_value.bit_width;
        };

        let expression = std::func(
            unit: &L1.Unit,
            id: L1.ExprId,
        ) -> i32 ! {Memory.Bounds.Effect} {
            if id >= unit.expressions.length() { return 7201; }
            let value: &L1.Expr = unit.expressions.get(id);
            if value.result_type >= unit.types.length() { return 7202; }
            let result_type: &L1.Type = unit.types.get(value.result_type);
            if value.kind == 1 && result_type.kind != 1 { return 7210; }
            if value.kind == 18
                && (result_type.kind != 5
                    || (result_type.bit_width != 32
                        && result_type.bit_width != 64)) {
                return 7210;
            }
            if value.kind >= 3 && value.kind <= 17 {
                if value.left >= unit.expressions.length() {
                    return 7201;
                }
                if value.right >= unit.expressions.length() {
                    return 7201;
                }
                let left_value: &L1.Expr = unit.expressions.get(value.left);
                let right_value: &L1.Expr = unit.expressions.get(value.right);
                if !same_type(
                    unit, left_value.result_type, right_value.result_type
                ) {
                    return 7205;
                }
                if value.kind >= 6 {
                    let result: &L1.Type = unit.types.get(value.result_type);
                    if result.kind != 1 || result.bit_width != 1 {
                        return 7205;
                    }
                } else if !same_type(
                    unit, left_value.result_type, value.result_type
                ) {
                    return 7205;
                }
            }
            if value.kind == 20 {
                if value.procedure >= unit.procedures.length() {
                    return 7204;
                }
                let procedure: &L1.Procedure =
                    unit.procedures.get(value.procedure);
                if !same_type(unit, value.result_type, procedure.return_type) {
                    return 7205;
                }
                if value.arguments.length()
                    != procedure.parameter_types.length() {
                    return 7206;
                }
                let index: usize = 0;
                while index < value.arguments.length() {
                    let argument: L1.ExprId = *value.arguments.get(index);
                    if argument >= unit.expressions.length() {
                        return 7201;
                    }
                    let argument_value: &L1.Expr =
                        unit.expressions.get(argument);
                    if !same_type(
                        unit,
                        argument_value.result_type,
                        *procedure.parameter_types.get(index),
                    ) {
                        return 7207;
                    }
                    index = index + 1;
                }
            }
            if value.kind == 21 {
                if value.left >= unit.expressions.length() { return 7201; }
                let address: &L1.Expr = unit.expressions.get(value.left);
                let address_type: &L1.Type = unit.types.get(address.result_type);
                if address_type.kind != 2 { return 7211; }
                let index: usize = 0;
                while index < value.arguments.length() {
                    if *value.arguments.get(index) >= unit.expressions.length() {
                        return 7201;
                    }
                    index = index + 1;
                }
            }
            if value.kind >= 30 && value.kind <= 33 {
                if value.left >= unit.expressions.length() { return 7201; }
                let source: &L1.Expr = unit.expressions.get(value.left);
                let source_type: &L1.Type = unit.types.get(source.result_type);
                if value.kind <= 32 {
                    if source_type.kind != 1 || result_type.kind != 1 {
                        return 7210;
                    }
                    if value.kind <= 31
                        && result_type.bit_width <= source_type.bit_width {
                        return 7210;
                    }
                    if value.kind == 32
                        && result_type.bit_width >= source_type.bit_width {
                        return 7210;
                    }
                } else if source_type.bit_width != result_type.bit_width {
                    return 7210;
                }
            }
            if value.kind == 40 {
                if value.procedure >= unit.procedures.length()
                    || result_type.kind != 2 { return 7211; }
            }
            if value.kind == 41 {
                if value.index >= unit.data.length()
                    || result_type.kind != 2 { return 7211; }
            }
            if value.kind == 42 {
                if value.size == 0 || result_type.kind != 2 { return 7211; }
            }
            if value.kind == 43 {
                if value.left >= unit.expressions.length()
                    || value.right >= unit.expressions.length()
                    || value.scale == 0
                    || result_type.kind != 2 { return 7211; }
                let base: &L1.Expr = unit.expressions.get(value.left);
                let base_type: &L1.Type = unit.types.get(base.result_type);
                let index_value: &L1.Expr = unit.expressions.get(value.right);
                let index_type: &L1.Type = unit.types.get(index_value.result_type);
                if base_type.kind != 2 || index_type.kind != 1 {
                    return 7211;
                }
            }
            if value.kind == 44 {
                if value.left >= unit.expressions.length() { return 7201; }
                let address: &L1.Expr = unit.expressions.get(value.left);
                if unit.types.get(address.result_type).kind != 2 { return 7211; }
            }
            if value.kind >= 60 && value.kind <= 65 {
                if value.left >= unit.expressions.length()
                    || value.right >= unit.expressions.length() { return 7201; }
                let left_value: &L1.Expr = unit.expressions.get(value.left);
                let right_value: &L1.Expr = unit.expressions.get(value.right);
                if !same_type(unit, left_value.result_type, right_value.result_type)
                    || unit.types.get(left_value.result_type).kind != 5 {
                    return 7210;
                }
                if value.kind <= 63 {
                    if !same_type(unit, left_value.result_type, value.result_type) {
                        return 7210;
                    }
                } else if result_type.kind != 1 || result_type.bit_width != 1 {
                    return 7210;
                }
            }
            if value.kind != 1 && value.kind != 2 && value.kind != 18
                && (value.kind < 3 || value.kind > 17)
                && value.kind != 20 && value.kind != 21
                && (value.kind < 30 || value.kind > 33)
                && (value.kind < 40 || value.kind > 44)
                && (value.kind < 60 || value.kind > 65) {
                return 7212;
            }
            return 0;
        };

        let region = std::func(
            unit: &L1.Unit,
            id: L1.RegionId,
            return_type: L1.TypeId,
        ) -> i32 ! {Memory.Bounds.Effect} {
            if id >= unit.regions.length() { return 7203; }
            let value: &L1.Region = unit.regions.get(id);
            let index: usize = 0;
            while index < value.instructions.length() {
                let instruction: &L1.Instruction =
                    value.instructions.get(index);
                if instruction.kind == 1 {
                    let code: i32 = expression(unit, instruction.expression);
                    if code != 0 { return code; }
                    if instruction.expression >= unit.expressions.length()
                        || !same_type(
                            unit,
                            unit.expressions.get(instruction.expression).result_type,
                            return_type,
                        ) {
                        return 7208;
                    }
                }
                if instruction.kind == 2 {
                    let code: i32 = expression(unit, instruction.expression);
                    if code != 0 { return code; }
                    if instruction.first_region >= unit.regions.length()
                        || instruction.second_region
                            >= unit.regions.length() {
                        return 7203;
                    }
                    let condition: &L1.Expr =
                        unit.expressions.get(instruction.expression);
                    let condition_type: &L1.Type =
                        unit.types.get(condition.result_type);
                    if condition_type.kind != 1
                        || condition_type.bit_width != 1 {
                        return 7209;
                    }
                    let first_code: i32 =
                        region(unit, instruction.first_region, return_type);
                    if first_code != 0 { return first_code; }
                    let second_code: i32 =
                        region(unit, instruction.second_region, return_type);
                    if second_code != 0 { return second_code; }
                }
                if instruction.kind == 3 {
                    if instruction.first_region >= unit.regions.length() {
                        return 7203;
                    }
                    let body_code: i32 =
                        region(unit, instruction.first_region, return_type);
                    if body_code != 0 { return body_code; }
                }
                if instruction.kind == 6 {
                    let value_code: i32 = expression(unit, instruction.expression);
                    if value_code != 0 { return value_code; }
                    let address_code: i32 = expression(unit, instruction.destination);
                    if address_code != 0 { return address_code; }
                    if instruction.value_type >= unit.types.length() {
                        return 7202;
                    }
                    let stored: &L1.Expr = unit.expressions.get(instruction.expression);
                    let destination: &L1.Expr =
                        unit.expressions.get(instruction.destination);
                    if !same_type(unit, stored.result_type, instruction.value_type)
                        || unit.types.get(destination.result_type).kind != 2 {
                        return 7211;
                    }
                }
                if instruction.kind < 1 || instruction.kind > 6 {
                    return 7213;
                }
                index = index + 1;
            }
            return 0;
        };

        let unit = std::func(
            value: &L1.Unit,
            entry: L1.ProcedureId,
        ) -> i32 ! {Memory.Bounds.Effect} {
            if entry >= value.procedures.length() { return 7204; }
            let data_index: usize = 0;
            while data_index < value.data.length() {
                let item: &L1.Data = value.data.get(data_index);
                if item.size == 0 || item.alignment == 0
                    || item.initializer.length() > item.size {
                    return 7214;
                }
                data_index = data_index + 1;
            }
            let index: usize = 0;
            while index < value.procedures.length() {
                let procedure: &L1.Procedure =
                    value.procedures.get(index);
                if procedure.return_type >= value.types.length() {
                    return 7202;
                }
                if !procedure.is_external {
                    let code: i32 =
                        region(value, procedure.body, procedure.return_type);
                    if code != 0 { return code; }
                }
                index = index + 1;
            }
            return 0;
        };

        return std::module {
            @export let L1: Module = L1;
            @export let expression = expression;
            @export let region = region;
            @export let unit = unit;
        };
    };
};
