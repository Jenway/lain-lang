// Deterministic text view of dynamic L1.

let memory_model: Module = import("std::memory_model");
let l1_ir: Module = import("packages::lain::lainir::api::l1_ir");

@export
let l1_printer: Module = std::module {
    @export
    let Printer = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let L1: Module = l1_ir.Model(Memory);

        let append_literal = std::func(
            output: &mut Memory.String,
            literal: addr,
            length: usize,
        ) -> unit ! {Memory.Allocation.Effect} {
            let index: usize = 0;
            while index < length {
                Memory.String.append_byte(
                    output,
                    std::load_bits(8, literal + index),
                );
                index = index + 1;
            }
        };

        let append_positive_i32 = std::func(
            output: &mut Memory.String,
            value: i32,
        ) -> unit ! {Memory.Allocation.Effect} {
            if value >= 10 {
                append_positive_i32(output, value / 10);
            }
            let digit: i32 = value % 10;
            let ascii: i32 = 48 + digit;
            Memory.String.append_byte(output, ascii);
        };

        let append_i32 = std::func(
            output: &mut Memory.String,
            value: i32,
        ) -> unit ! {Memory.Allocation.Effect} {
            if value < 0 {
                Memory.String.append_byte(output, 45);
                // The evaluator's first scalar domain excludes i32::min from
                // text materialization; verifier diagnostic 7205 covers it.
                append_positive_i32(output, -value);
                return;
            }
            append_positive_i32(output, value);
        };

        let append_positive_u64 = std::func(
            output: &mut Memory.String, value: u64,
        ) -> unit ! {Memory.Allocation.Effect} {
            if value >= 10 { append_positive_u64(output, value / 10); }
            Memory.String.append_byte(output, 48 + (value % 10) as i32);
        };

        let append_i64 = std::func(
            output: &mut Memory.String, value: i64,
        ) -> unit ! {Memory.Allocation.Effect} {
            if value < 0 {
                Memory.String.append_byte(output, 45);
                append_positive_u64(output, (0 as u64) - (value as u64));
                return;
            }
            append_positive_u64(output, value as u64);
        };

        let append_usize = std::func(
            output: &mut Memory.String, value: usize,
        ) -> unit ! {Memory.Allocation.Effect} {
            if value >= 10 { append_usize(output, value / 10); }
            Memory.String.append_byte(output, 48 + (value % 10));
        };

        let physical_type = std::func(
            output: &mut Memory.String, unit: &L1.Unit, id: L1.TypeId,
        ) -> unit ! {
            Memory.Allocation.Effect, Memory.Bounds.Effect,
        } {
            let value: &L1.Type = unit.types.get(id);
            if value.kind == 1 {
                append_literal(output, "#bits<", 6);
                append_usize(output, value.bit_width);
                append_literal(output, ">", 1);
            } else if value.kind == 2 {
                append_literal(output, "#addr", 5);
            } else if value.kind == 3 {
                append_literal(output, "#unit", 5);
            } else if value.kind == 4 {
                append_literal(output, "#never", 6);
            } else if value.kind == 5 {
                append_literal(output, "#float<", 7);
                append_usize(output, value.bit_width);
                append_literal(output, ">", 1);
            } else {
                append_literal(output, "#invalid", 8);
            }
        };

        let expression = std::func(
            output: &mut Memory.String,
            unit: &L1.Unit,
            id: L1.ExprId,
        ) -> unit ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let value: &L1.Expr = unit.expressions.get(id);
            if value.kind == 1 {
                append_i64(output, value.wide_value as i64);
                return;
            }
            if value.kind == 2 {
                append_literal(output, "%p", 2);
                append_usize(output, value.index);
                return;
            }
            if value.kind >= 3 && value.kind <= 17 {
                if value.kind == 3 { append_literal(output, "#add(", 5); }
                else if value.kind == 4 { append_literal(output, "#sub(", 5); }
                else if value.kind == 5 { append_literal(output, "#mul(", 5); }
                else if value.kind == 6 { append_literal(output, "#eq(", 4); }
                else if value.kind == 7 { append_literal(output, "#ne(", 4); }
                else if value.kind == 8 { append_literal(output, "#slt(", 5); }
                else if value.kind == 9 { append_literal(output, "#sle(", 5); }
                else if value.kind == 10 { append_literal(output, "#sgt(", 5); }
                else if value.kind == 11 { append_literal(output, "#sge(", 5); }
                else if value.kind == 12 { append_literal(output, "#sdiv(", 6); }
                else if value.kind == 13 { append_literal(output, "#udiv(", 6); }
                else if value.kind == 14 { append_literal(output, "#ult(", 5); }
                else if value.kind == 15 { append_literal(output, "#ule(", 5); }
                else if value.kind == 16 { append_literal(output, "#ugt(", 5); }
                else { append_literal(output, "#uge(", 5); }
                expression(output, unit, value.left);
                append_literal(output, ", ", 2);
                expression(output, unit, value.right);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 20 {
                append_literal(output, "#call ", 6);
                Memory.String.append(
                    output,
                    &unit.procedures.get(value.procedure).name,
                );
                append_literal(output, "(", 1);
                let index: usize = 0;
                while index < value.arguments.length() {
                    if index != 0 {
                        append_literal(output, ", ", 2);
                    }
                    expression(
                        output,
                        unit,
                        *value.arguments.get(index),
                    );
                    index = index + 1;
                }
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 21 {
                append_literal(output, "#call_indirect[(", 16);
                let index: usize = 0;
                while index < value.arguments.length() {
                    if index != 0 { append_literal(output, ", ", 2); }
                    physical_type(
                        output, unit,
                        unit.expressions.get(*value.arguments.get(index)).result_type,
                    );
                    index = index + 1;
                }
                append_literal(output, ") -> ", 5);
                physical_type(output, unit, value.result_type);
                append_literal(output, "](", 2);
                expression(output, unit, value.left);
                index = 0;
                while index < value.arguments.length() {
                    append_literal(output, ", ", 2);
                    expression(output, unit, *value.arguments.get(index));
                    index = index + 1;
                }
                append_literal(output, ")", 1);
                return;
            }
            if value.kind >= 30 && value.kind <= 33 {
                if value.kind == 30 { append_literal(output, "#zext[", 6); }
                else if value.kind == 31 { append_literal(output, "#sext[", 6); }
                else if value.kind == 32 { append_literal(output, "#trunc[", 7); }
                else { append_literal(output, "#bitcast[", 9); }
                physical_type(output, unit, value.result_type);
                append_literal(output, "](", 2);
                expression(output, unit, value.left);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 40 {
                append_literal(output, "#proc_addr(", 11);
                Memory.String.append(
                    output, &unit.procedures.get(value.procedure).name
                );
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 41 {
                append_literal(output, "#data_addr(", 11);
                Memory.String.append(output, &unit.data.get(value.index).name);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 42 {
                append_literal(output, "#alloca(", 8);
                append_usize(output, value.size);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 43 {
                append_literal(output, "#lea(base=", 10);
                expression(output, unit, value.left);
                append_literal(output, ", idx=", 6);
                expression(output, unit, value.right);
                append_literal(output, ", scale=", 8);
                append_usize(output, value.scale);
                append_literal(output, ", offset=", 9);
                append_i32(output, value.offset as i32);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind == 44 {
                append_literal(output, "#load[", 6);
                physical_type(output, unit, value.result_type);
                append_literal(output, "](", 2);
                expression(output, unit, value.left);
                append_literal(output, ")", 1);
                return;
            }
            if value.kind >= 60 && value.kind <= 65 {
                if value.kind == 60 { append_literal(output, "#fadd(", 6); }
                else if value.kind == 61 { append_literal(output, "#fsub(", 6); }
                else if value.kind == 62 { append_literal(output, "#fmul(", 6); }
                else if value.kind == 63 { append_literal(output, "#fdiv(", 6); }
                else if value.kind == 64 { append_literal(output, "#feq(", 5); }
                else { append_literal(output, "#flt(", 5); }
                expression(output, unit, value.left);
                append_literal(output, ", ", 2);
                expression(output, unit, value.right);
                append_literal(output, ")", 1);
                return;
            }
            append_literal(output, "#invalid", 8);
        };

        let region = std::func(
            output: &mut Memory.String,
            unit: &L1.Unit,
            id: L1.RegionId,
        ) -> unit ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let value: &L1.Region = unit.regions.get(id);
            let index: usize = 0;
            while index < value.instructions.length() {
                let instruction: &L1.Instruction =
                    value.instructions.get(index);
                if instruction.kind == 1 {
                    append_literal(output, "#return ", 8);
                    expression(output, unit, instruction.expression);
                } else if instruction.kind == 2 {
                    append_literal(output, "#if ", 4);
                    expression(output, unit, instruction.expression);
                    append_literal(output, " { ", 3);
                    region(output, unit, instruction.first_region);
                    append_literal(output, "} else { ", 9);
                    region(output, unit, instruction.second_region);
                    append_literal(output, "}", 1);
                } else if instruction.kind == 3 {
                    append_literal(output, "#loop { ", 8);
                    region(output, unit, instruction.first_region);
                    append_literal(output, "}", 1);
                } else if instruction.kind == 4 {
                    append_literal(output, "#break", 6);
                } else if instruction.kind == 5 {
                    append_literal(output, "#continue", 9);
                } else if instruction.kind == 6 {
                    append_literal(output, "#store[", 7);
                    physical_type(output, unit, instruction.value_type);
                    append_literal(output, "] ", 2);
                    expression(output, unit, instruction.expression);
                    append_literal(output, ", ", 2);
                    expression(output, unit, instruction.destination);
                } else {
                    append_literal(output, "#invalid", 8);
                }
                append_literal(output, " ", 1);
                index = index + 1;
            }
        };

        let unit = std::func(
            value: &L1.Unit,
        ) -> Memory.String ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let output: Memory.String = Memory.String.new();
            let procedure_index: usize = 0;
            while procedure_index < value.procedures.length() {
                let procedure: &L1.Procedure =
                    value.procedures.get(procedure_index);
                append_literal(&mut output, "#proc ", 6);
                Memory.String.append(&mut output, &procedure.name);
                append_literal(&mut output, "(", 1);
                let parameter_index: usize = 0;
                while parameter_index < procedure.parameter_types.length() {
                    if parameter_index != 0 {
                        append_literal(&mut output, ", ", 2);
                    }
                    physical_type(
                        &mut output, value,
                        *procedure.parameter_types.get(parameter_index),
                    );
                    append_literal(&mut output, " %p", 3);
                    append_usize(&mut output, parameter_index);
                    parameter_index = parameter_index + 1;
                }
                append_literal(&mut output, ") -> ", 5);
                physical_type(&mut output, value, procedure.return_type);
                if procedure.is_external {
                    append_literal(&mut output, ";\n", 2);
                    procedure_index = procedure_index + 1;
                    continue;
                }
                append_literal(&mut output, " { ", 3);
                region(&mut output, value, procedure.body);
                append_literal(&mut output, "}\n", 2);
                procedure_index = procedure_index + 1;
            }
            return output;
        };

        return std::module {
            @export let L1: Module = L1;
            @export let unit = unit;
        };
    };
};
