// LSP document features implemented on top of the LAIN-IR source frontend.
//
// This module is deliberately a companion to lsp.l1: it owns neither the
// protocol loop nor host IO.  lsp.l1 supplies the document model and stream
// writers, while source.l1/highlight.l1 supply lossless lexing and spans.

#extern #proc lsp.allocate(#bits<64> %size) -> #addr;
#extern #proc lsp.flush() -> #unit;
#extern #proc lsp_byte_at(#addr %data, #bits<64> %index) -> #bits<8>;
#extern #proc lsp_load64(#addr %base, #bits<64> %offset) -> #bits<64>;
#extern #proc lsp_load_addr(#addr %base, #bits<64> %offset) -> #addr;
#extern #proc lsp_cstring_length(#addr %data) -> #bits<64>;
#extern #proc lsp_decimal_length(#bits<64> %value) -> #bits<64>;
#extern #proc lsp.write-byte(#bits<8> %byte) -> #unit;
#extern #proc lsp_write_literal(#addr %text) -> #unit;
#extern #proc lsp_write_decimal(#bits<64> %value) -> #unit;
#extern #proc lsp_write_bytes(#addr %data, #bits<64> %length) -> #unit;
#extern #proc lsp_write_json_response(#bits<64> %id, #addr %result) -> #unit;

#extern #proc lsp_document_is_nil(#addr %document) -> #bits<1>;
#extern #proc lsp_document_text(#addr %document) -> #addr;
#extern #proc lsp_document_length(#addr %document) -> #bits<64>;
#extern #proc lsp_document_cache_source(#addr %document) -> #addr;
#extern #proc lsp_document_cache_tokens(#addr %document) -> #addr;
#extern #proc lsp_document_cache_ast(#addr %document) -> #addr;
#extern #proc lsp_document_cache_dirty(#addr %document) -> #bits<64>;
#extern #proc lsp_document_cache_set(#addr %document, #addr %source, #addr %tokens, #addr %ast) -> #unit;
#extern #proc lsp_document_dirty_start(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_end(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_old_start(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_old_end(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_start_line(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_start_character(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_end_line(#addr %document) -> #bits<64>;
#extern #proc lsp_document_dirty_end_character(#addr %document) -> #bits<64>;
#extern #proc lsp_document_previous_length(#addr %document) -> #bits<64>;
#extern #proc lsp_document_change_is_range(#addr %document) -> #bits<1>;
#extern #proc lsp_document_replacement_end_line(#addr %document) -> #bits<64>;
#extern #proc lsp_document_replacement_end_character(#addr %document) -> #bits<64>;
#extern #proc lsp_document_token_scan_set(#addr %document, #bits<64> %start, #bits<64> %end, #bits<1> %full) -> #unit;

#extern #proc tool_source_new(#addr %data, #bits<64> %length) -> #addr;
#extern #proc tool_source_nil(#addr %source) -> #addr;
#extern #proc tool_is_nil(#addr %source, #addr %value) -> #bits<1>;
#extern #proc tool_lex_all(#addr %source) -> #addr;
#extern #proc tool_lex_window(#addr %source, #bits<64> %start, #bits<64> %end, #bits<64> %line, #bits<64> %column) -> #addr;
#extern #proc tool_token_kind(#addr %token) -> #bits<32>;
#extern #proc tool_token_start(#addr %token) -> #bits<64>;
#extern #proc tool_token_length(#addr %token) -> #bits<64>;
#extern #proc tool_token_line(#addr %token) -> #bits<64>;
#extern #proc tool_token_column(#addr %token) -> #bits<64>;
#extern #proc tool_token_leading_trivia(#addr %token) -> #addr;
#extern #proc tool_token_next(#addr %token) -> #addr;
#extern #proc tool_token_link(#addr %last, #addr %next) -> #unit;
#extern #proc tool_token_set_location(#addr %token, #bits<64> %start, #bits<64> %line, #bits<64> %column) -> #unit;
#extern #proc tool_trivia_start(#addr %trivia) -> #bits<64>;
#extern #proc tool_trivia_length(#addr %trivia) -> #bits<64>;
#extern #proc tool_trivia_kind(#addr %trivia) -> #bits<32>;
#extern #proc tool_trivia_line(#addr %trivia) -> #bits<64>;
#extern #proc tool_trivia_column(#addr %trivia) -> #bits<64>;
#extern #proc tool_trivia_next(#addr %trivia) -> #addr;
#extern #proc tool_trivia_set_location(#addr %trivia, #bits<64> %start, #bits<64> %line, #bits<64> %column) -> #unit;
#extern #proc parser_new(#addr %source, #addr %tokens) -> #addr;
#extern #proc parser_parse_module(#addr %cursor) -> #addr;
#extern #proc tool_highlight_collect(#addr %source, #addr %tokens) -> #addr;
#extern #proc tool_highlight_category(#addr %item) -> #bits<32>;
#extern #proc tool_highlight_start(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_length(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_line(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_column(#addr %item) -> #bits<64>;
#extern #proc tool_highlight_next(#addr %item) -> #addr;
#extern #proc tool_source_diagnostics(#addr %source) -> #addr;
#extern #proc tool_source_diagnostic_count(#addr %source) -> #bits<64>;
#extern #proc tool_diag_severity(#addr %diag) -> #bits<32>;
#extern #proc tool_diag_start(#addr %diag) -> #bits<64>;
#extern #proc tool_diag_length(#addr %diag) -> #bits<64>;
#extern #proc tool_diag_line(#addr %diag) -> #bits<64>;
#extern #proc tool_diag_column(#addr %diag) -> #bits<64>;
#extern #proc tool_diag_message(#addr %diag) -> #addr;
#extern #proc tool_diag_message_length(#addr %diag) -> #bits<64>;
#extern #proc tool_diag_next(#addr %diag) -> #addr;

// The generic response writer in lsp.l1 takes a NUL-terminated literal.  The
// two feature responses below are dynamic, so they write the frame header and
// JSON body directly while retaining all protocol code in LAIN-IR.
#proc lsp_tools_write_header(#bits<64> %id, #bits<64> %body_length) -> #unit {
  #call lsp_write_literal("Content-Length: ")
  #call lsp_write_decimal(%body_length)
  #call lsp_write_literal("\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":")
  #call lsp_write_decimal(%id)
  #call lsp_write_literal(",\"result\":")
  #return
}

#proc lsp_tools_write_u64(#bits<64> %value) -> #unit {
  #call lsp_write_decimal(%value)
  #return
}

// -------------------------- incremental tokens -------------------------
// A ranged edit is expanded to whole token boundaries.  The token immediately
// before the edit is included as well: inserting an identifier character next
// to it can merge two formerly separate tokens.  Trivia attached to that
// token expands the left edge further so comments/whitespace are not split.
#proc lsp_tools_token_before_start(
  #addr %source, #addr %tokens, #bits<64> %limit
) -> #addr {
  #let %nil: #addr = #call tool_source_nil(%source)
  #let %current: #addr = %tokens
  #let %previous: #addr = %nil
  #loop before_start {
    #if #call tool_is_nil(%source, %current) { #break before_start }
    #if #eq(#call tool_token_kind(%current), 0) { #break before_start }
    #if #ge(#call tool_token_start(%current), %limit) { #break before_start }
    %previous: #addr = %current
    %current: #addr = #call tool_token_next(%current)
    #continue before_start
  }
  #return %previous
}

#proc lsp_tools_token_overlap(
  #addr %source, #addr %tokens, #bits<64> %offset
) -> #addr {
  #let %nil: #addr = #call tool_source_nil(%source)
  #let %current: #addr = %tokens
  #let %previous: #addr = %nil
  #loop overlap {
    #if #call tool_is_nil(%source, %current) { #return %previous }
    #if #eq(#call tool_token_kind(%current), 0) { #return %previous }
    #let %start: #bits<64> = #call tool_token_start(%current)
    #let %end: #bits<64> = #add(%start, #call tool_token_length(%current))
    #if #gt(%end, %offset) { #return %current }
    %previous: #addr = %current
    %current: #addr = #call tool_token_next(%current)
    #continue overlap
  }
  #return %previous
}

#proc lsp_tools_token_window_start(
  #addr %source, #addr %token
) -> #bits<64> {
  #let %start: #bits<64> = #call tool_token_start(%token)
  #let %trivia: #addr = #call tool_token_leading_trivia(%token)
  #loop leading_start {
    #if #call tool_is_nil(%source, %trivia) { #break leading_start }
    %start: #bits<64> = #call tool_trivia_start(%trivia)
    %trivia: #addr = #call tool_trivia_next(%trivia)
    #continue leading_start
  }
  #return %start
}

#proc lsp_tools_token_window_line(
  #addr %source, #addr %token
) -> #bits<64> {
  #let %line: #bits<64> = #call tool_token_line(%token)
  #let %trivia: #addr = #call tool_token_leading_trivia(%token)
  #if #eq(#call tool_is_nil(%source, %trivia), 0) {
    %line: #bits<64> = #call tool_trivia_line(%trivia)
  }
  #return %line
}

#proc lsp_tools_token_window_column(
  #addr %source, #addr %token
) -> #bits<64> {
  #let %column: #bits<64> = #call tool_token_column(%token)
  #let %trivia: #addr = #call tool_token_leading_trivia(%token)
  #if #eq(#call tool_is_nil(%source, %trivia), 0) {
    %column: #bits<64> = #call tool_trivia_column(%trivia)
  }
  #return %column
}

#proc lsp_tools_token_after_end(
  #addr %source, #addr %tokens, #bits<64> %offset
) -> #addr {
  #let %nil: #addr = #call tool_source_nil(%source)
  #let %current: #addr = %tokens
  #loop after_end {
    #if #call tool_is_nil(%source, %current) { #return %nil }
    #if #eq(#call tool_token_kind(%current), 0) { #return %nil }
    #let %start: #bits<64> = #call tool_token_start(%current)
    #let %end: #bits<64> = #add(%start, #call tool_token_length(%current))
    #if #gt(%end, %offset) {
      #return #call tool_token_next(%current)
    }
    %current: #addr = #call tool_token_next(%current)
    #continue after_end
  }
  #return %nil
}

#proc lsp_tools_token_unbounded(
  #addr %source, #addr %token
) -> #bits<1> {
  #if #call tool_is_nil(%source, %token) { #return 0 }
  // A changed string can lose its closing quote; a changed invalid token may
  // be the scanner's view of an unterminated string.  In either case the
  // lexical state can consume the entire suffix, so use the full-source
  // fallback for correctness.
  #if #eq(#call tool_token_kind(%token), 3) { #return 1 }
  #if #eq(#call tool_token_kind(%token), 7) { #return 1 }
  #let %trivia: #addr = #call tool_token_leading_trivia(%token)
  #loop comment_trivia {
    #if #call tool_is_nil(%source, %trivia) { #break comment_trivia }
    #if #eq(#call tool_trivia_kind(%trivia), 2) { #return 1 }
    #if #eq(#call tool_trivia_kind(%trivia), 3) { #return 1 }
    %trivia: #addr = #call tool_trivia_next(%trivia)
    #continue comment_trivia
  }
  #return 0
}

#proc lsp_tools_token_eof(#addr %source, #addr %tokens) -> #addr {
  #let %current: #addr = %tokens
  #loop find_eof {
    #if #call tool_is_nil(%source, %current) { #return %current }
    #if #eq(#call tool_token_kind(%current), 0) { #return %current }
    %current: #addr = #call tool_token_next(%current)
    #continue find_eof
  }
  #return %current
}

#proc lsp_tools_token_comment_at(
  #addr %source, #addr %token, #bits<64> %offset
) -> #bits<1> {
  #let %trivia: #addr = #call tool_token_leading_trivia(%token)
  #loop comment_at {
    #if #call tool_is_nil(%source, %trivia) { #break comment_at }
    #let %start: #bits<64> = #call tool_trivia_start(%trivia)
    #let %end: #bits<64> = #add(%start, #call tool_trivia_length(%trivia))
    #if #eq(#call tool_trivia_kind(%trivia), 2) {
      #if #ge(%offset, %start) {
        #if #le(%offset, %end) { #return 1 }
      }
    }
    #if #eq(#call tool_trivia_kind(%trivia), 3) {
      #if #ge(%offset, %start) {
        #if #le(%offset, %end) { #return 1 }
      }
    }
    %trivia: #addr = #call tool_trivia_next(%trivia)
    #continue comment_at
  }
  #return 0
}

#proc lsp_tools_shift_line(
  #bits<64> %line, #bits<64> %old_end_line, #bits<64> %new_end_line
) -> #bits<64> {
  #if #lt(%line, %old_end_line) { #return %line }
  #return #add(%new_end_line, #sub(%line, %old_end_line))
}

#proc lsp_tools_shift_column(
  #bits<64> %line, #bits<64> %column, #bits<64> %old_end_line,
  #bits<64> %old_end_column, #bits<64> %new_end_line,
  #bits<64> %new_end_column
) -> #bits<64> {
  #if #eq(%line, %old_end_line) {
    #return #add(%new_end_column, #sub(%column, %old_end_column))
  }
  #return %column
}

#proc lsp_tools_adjust_trivia(
  #addr %source, #addr %trivia, #bits<64> %old_end_line,
  #bits<64> %old_end_column, #bits<64> %new_end_line,
  #bits<64> %new_end_column, #bits<64> %delta, #bits<1> %subtract
) -> #unit {
  #let %current: #addr = %trivia
  #loop adjust_trivia {
    #if #call tool_is_nil(%source, %current) { #break adjust_trivia }
    #let %start: #bits<64> = #call tool_trivia_start(%current)
    #if #eq(%subtract, 0) {
      %start: #bits<64> = #add(%start, %delta)
    } else {
      %start: #bits<64> = #sub(%start, %delta)
    }
    #let %line: #bits<64> = #call tool_trivia_line(%current)
    #let %column: #bits<64> = #call tool_trivia_column(%current)
    #let %new_line: #bits<64> = #call lsp_tools_shift_line(
      %line, %old_end_line, %new_end_line
    )
    %column: #bits<64> = #call lsp_tools_shift_column(
      %line, %column, %old_end_line, %old_end_column,
      %new_end_line, %new_end_column
    )
    #call tool_trivia_set_location(%current, %start, %new_line, %column)
    %current: #addr = #call tool_trivia_next(%current)
    #continue adjust_trivia
  }
  #return
}

#proc lsp_tools_adjust_suffix(
  #addr %source, #addr %suffix, #bits<64> %old_end_line,
  #bits<64> %old_end_column, #bits<64> %new_end_line,
  #bits<64> %new_end_column, #bits<64> %delta, #bits<1> %subtract
) -> #unit {
  #let %current: #addr = %suffix
  #loop adjust_suffix {
    #if #call tool_is_nil(%source, %current) { #break adjust_suffix }
    #let %start: #bits<64> = #call tool_token_start(%current)
    #if #eq(%subtract, 0) {
      %start: #bits<64> = #add(%start, %delta)
    } else {
      %start: #bits<64> = #sub(%start, %delta)
    }
    #let %line: #bits<64> = #call tool_token_line(%current)
    #let %column: #bits<64> = #call tool_token_column(%current)
    #let %new_line: #bits<64> = #call lsp_tools_shift_line(
      %line, %old_end_line, %new_end_line
    )
    %column: #bits<64> = #call lsp_tools_shift_column(
      %line, %column, %old_end_line, %old_end_column,
      %new_end_line, %new_end_column
    )
    #call tool_token_set_location(%current, %start, %new_line, %column)
    #call lsp_tools_adjust_trivia(
      %source, #call tool_token_leading_trivia(%current),
      %old_end_line, %old_end_column, %new_end_line, %new_end_column,
      %delta, %subtract
    )
    %current: #addr = #call tool_token_next(%current)
    #continue adjust_suffix
  }
  #return
}

// Build a new linked stream by replacing only the expanded edit window.  The
// caller supplies the new source snapshot; old prefix/suffix records are
// reused and their absolute locations are shifted in place.
#proc lsp_tools_lex_incremental(
  #addr %document, #addr %source, #addr %old_tokens, #bits<64> %old_length,
  #bits<64> %new_length, #bits<64> %old_start, #bits<64> %old_end,
  #bits<64> %old_end_line, #bits<64> %old_end_column,
  #bits<64> %new_end_line, #bits<64> %new_end_column
) -> #addr {
  #let %nil: #addr = #call tool_source_nil(%source)
  #let %window_token: #addr = #call lsp_tools_token_overlap(
    %source, %old_tokens, %old_start
  )
  #if #call tool_is_nil(%source, %window_token) {
    #call lsp_document_token_scan_set(%document, 0, %new_length, 1)
    #return #call tool_lex_all(%source)
  }
  #let %edit_token: #addr = %window_token
  // Include the token preceding the overlap to protect token merging at the
  // left boundary.  At the beginning of the file there is no prefix.
  #let %prefix_last: #addr = #call lsp_tools_token_before_start(
    %source, %old_tokens, #call tool_token_start(%window_token)
  )
  #if #eq(#call tool_token_kind(%window_token), 0) {
    %window_token: #addr = %prefix_last
  } else {
    #if #call tool_is_nil(%source, %prefix_last) {
    } else {
      %window_token: #addr = %prefix_last
      %prefix_last: #addr = #call lsp_tools_token_before_start(
        %source, %old_tokens, #call tool_token_start(%window_token)
      )
    }
  }
  #if #call tool_is_nil(%source, %window_token) {
    #call lsp_document_token_scan_set(%document, 0, %new_length, 1)
    #return #call tool_lex_all(%source)
  }
  #let %scan_start: #bits<64> = #call lsp_tools_token_window_start(
    %source, %window_token
  )
  #let %scan_line: #bits<64> = #call lsp_tools_token_window_line(
    %source, %window_token
  )
  #let %scan_column: #bits<64> = #call lsp_tools_token_window_column(
    %source, %window_token
  )
  #let %overlap_end: #addr = #call lsp_tools_token_overlap(
    %source, %old_tokens, %old_end
  )
  #let %scan_end_old: #bits<64> = %old_length
  #let %suffix: #addr = %nil
  #if #call tool_is_nil(%source, %overlap_end) {
  } else {
    #if #eq(#call tool_token_kind(%overlap_end), 0) {
      %scan_end_old: #bits<64> = #call tool_token_start(%overlap_end)
    } else {
      %scan_end_old: #bits<64> = #add(
        #call tool_token_start(%overlap_end),
        #call tool_token_length(%overlap_end)
      )
      %suffix: #addr = #call tool_token_next(%overlap_end)
    }
  }
  #if #call lsp_tools_token_unbounded(%source, %edit_token) {
    // A quote/comment delimiter edit can change lexical state beyond the
    // old token boundary.  This is the deliberate correctness fallback;
    // ordinary edits still splice a finite window.
    %scan_end_old: #bits<64> = %old_length
    %suffix: #addr = %nil
  }
  #let %eof: #addr = #call lsp_tools_token_eof(%source, %old_tokens)
  #if #call lsp_tools_token_comment_at(%source, %eof, %old_start) {
    %scan_end_old: #bits<64> = %old_length
    %suffix: #addr = %nil
  }
  #let %delta: #bits<64> = 0
  #let %subtract: #bits<1> = 0
  #if #ge(%new_length, %old_length) {
    %delta: #bits<64> = #sub(%new_length, %old_length)
  } else {
    %delta: #bits<64> = #sub(%old_length, %new_length)
    %subtract: #bits<1> = 1
  }
  #let %scan_end: #bits<64> = %scan_end_old
  #if #eq(%subtract, 0) {
    %scan_end: #bits<64> = #add(%scan_end_old, %delta)
  } else {
    %scan_end: #bits<64> = #sub(%scan_end_old, %delta)
  }
  #if #gt(%scan_end, %new_length) { %scan_end: #bits<64> = %new_length }
  #call lsp_tools_adjust_suffix(
    %source, %suffix, %old_end_line, %old_end_column,
    %new_end_line, %new_end_column, %delta, %subtract
  )
  #let %window_tokens: #addr = #call tool_lex_window(
    %source, %scan_start, %scan_end, %scan_line, %scan_column
  )
  #call lsp_document_token_scan_set(%document, %scan_start, %scan_end, 0)
  #let %window_first: #addr = %window_tokens
  #let %window_last: #addr = %nil
  #let %cursor: #addr = %window_tokens
  #loop window_real {
    #if #call tool_is_nil(%source, %cursor) { #break window_real }
    #if #eq(#call tool_token_kind(%cursor), 0) { #break window_real }
    %window_last: #addr = %cursor
    %cursor: #addr = #call tool_token_next(%cursor)
    #continue window_real
  }
  #if #call tool_is_nil(%source, %window_last) {
    #if #call tool_is_nil(%source, %suffix) {
      // The window's own EOF is the correct terminator when it reaches EOF.
      %window_first: #addr = %window_tokens
    } else {
      %window_first: #addr = %suffix
    }
  } else {
    #call tool_token_link(%window_last, %suffix)
  }
  #if #call tool_is_nil(%source, %prefix_last) {
    #return %window_first
  }
  #call tool_token_link(%prefix_last, %window_first)
  #return %old_tokens
}

// Build the source/token/parser cache exactly once per document version.  The
// parser mutates the source's diagnostic list; keeping that source in the
// document cache makes diagnostics, semantic tokens, and formatting observe
// the same snapshot.
#proc lsp_tools_prepare_document(#addr %document) -> #addr {
  #if #call lsp_document_is_nil(%document) { #return %document }
  #let %source: #addr = #call lsp_document_cache_source(%document)
  #let %tokens: #addr = #call lsp_document_cache_tokens(%document)
  #let %ast: #addr = #call lsp_document_cache_ast(%document)
  #if #ne(#call lsp_document_cache_dirty(%document), 0) {
    #let %old_source: #addr = %source
    #let %old_tokens: #addr = %tokens
    #let %old_length: #bits<64> = #call lsp_document_previous_length(%document)
    #let %text: #addr = #call lsp_document_text(%document)
    #let %length: #bits<64> = #call lsp_document_length(%document)
    %source: #addr = #call tool_source_new(%text, %length)
    #let %scan_start: #bits<64> = 0
    #let %scan_end: #bits<64> = %length
    #let %scan_full: #bits<1> = 1
    #if #call lsp_document_change_is_range(%document) {
      #if #call tool_is_nil(%source, %old_tokens) {
        %tokens: #addr = #call tool_lex_all(%source)
      } else {
        %tokens: #addr = #call lsp_tools_lex_incremental(
          %document, %source, %old_tokens, %old_length, %length,
          #call lsp_document_dirty_old_start(%document),
          #call lsp_document_dirty_old_end(%document),
          #call lsp_document_dirty_end_line(%document),
          #call lsp_document_dirty_end_character(%document),
          #call lsp_document_replacement_end_line(%document),
          #call lsp_document_replacement_end_character(%document)
        )
        %scan_full: #bits<1> = 0
      }
    } else {
      %tokens: #addr = #call tool_lex_all(%source)
    }
    #if #eq(%scan_full, 1) {
      #call lsp_document_token_scan_set(%document, %scan_start, %scan_end, 1)
    }
    #let %cursor: #addr = #call parser_new(%source, %tokens)
    %ast: #addr = #call parser_parse_module(%cursor)
    #call lsp_document_cache_set(%document, %source, %tokens, %ast)
  }
  #return %source
}

#proc lsp_tools_semantic_item_length(
  #addr %item, #bits<64> %previous_line, #bits<64> %previous_column
) -> #bits<64> {
  #let %line: #bits<64> = #call tool_highlight_line(%item)
  #let %column: #bits<64> = #call tool_highlight_column(%item)
  #let %delta_line: #bits<64> = #sub(%line, %previous_line)
  #let %delta_column: #bits<64> = %column
  #if #eq(%delta_line, 0) {
    %delta_column: #bits<64> = #sub(%column, %previous_column)
  }
  #let %category: #bits<64> = #zext[#bits<64>](#call tool_highlight_category(%item))
  // [deltaLine,deltaStart,length,tokenType,tokenModifiers]
  #return #add(
    #add(#call lsp_decimal_length(%delta_line), #call lsp_decimal_length(%delta_column)),
    #add(#call lsp_decimal_length(#call tool_highlight_length(%item)),
      #add(#call lsp_decimal_length(#sub(%category, 1)),
        #add(#call lsp_decimal_length(0), 6)))
  )
}

#proc lsp_tools_semantic_body_length(#addr %source, #addr %items) -> #bits<64> {
  #let %length: #bits<64> = #call lsp_cstring_length("{\"data\":[")
  #let %item: #addr = %items
  #let %line: #bits<64> = 0
  #let %column: #bits<64> = 0
  #let %first: #bits<1> = 1
  #loop count {
    #if #call tool_is_nil(%source, %item) { #break count }
    #let %category: #bits<32> = #call tool_highlight_category(%item)
    #if #ne(%category, 0) {
      #if #eq(%first, 0) { %length: #bits<64> = #add(%length, 1) }
      %length: #bits<64> = #add(%length,
        #call lsp_tools_semantic_item_length(%item, %line, %column))
      %first: #bits<1> = 0
      %line: #bits<64> = #call tool_highlight_line(%item)
      %column: #bits<64> = #call tool_highlight_column(%item)
    }
    %item: #addr = #call tool_highlight_next(%item)
    #continue count
  }
  #return #add(%length, 2) // ]}
}

#proc lsp_tools_write_semantic_item(
  #addr %item, #bits<64> %previous_line, #bits<64> %previous_column
) -> #unit {
  #let %line: #bits<64> = #call tool_highlight_line(%item)
  #let %column: #bits<64> = #call tool_highlight_column(%item)
  #let %delta_line: #bits<64> = #sub(%line, %previous_line)
  #let %delta_column: #bits<64> = %column
  #if #eq(%delta_line, 0) {
    %delta_column: #bits<64> = #sub(%column, %previous_column)
  }
  #let %category: #bits<64> = #zext[#bits<64>](#call tool_highlight_category(%item))
  #call lsp_write_literal("[")
  #call lsp_tools_write_u64(%delta_line)
  #call lsp_write_literal(",")
  #call lsp_tools_write_u64(%delta_column)
  #call lsp_write_literal(",")
  #call lsp_tools_write_u64(#call tool_highlight_length(%item))
  #call lsp_write_literal(",")
  #call lsp_tools_write_u64(#sub(%category, 1))
  #call lsp_write_literal(",0]")
  #return
}

// Respond to textDocument/semanticTokens/full.  The token legend is stable:
// comment,string,number,directive,identifier,operator,punctuation,invalid.
#proc lsp_write_semantic_tokens_response(#bits<64> %id, #addr %document) -> #unit {
  #if #call lsp_document_is_nil(%document) {
    #call lsp_write_json_response(%id, "{\"data\":[]}")
    #return
  }
  #let %source: #addr = #call lsp_tools_prepare_document(%document)
  #let %tokens: #addr = #call lsp_document_cache_tokens(%document)
  #let %items: #addr = #call tool_highlight_collect(%source, %tokens)
  #let %result_length: #bits<64> = #call lsp_tools_semantic_body_length(%source, %items)
  #let %body_length: #bits<64> = #add(
    #add(#call lsp_cstring_length("{\"jsonrpc\":\"2.0\",\"id\":"),
      #call lsp_decimal_length(%id)),
    #add(#call lsp_cstring_length(",\"result\":"), %result_length))
  %body_length: #bits<64> = #add(%body_length, 1)
  #call lsp_tools_write_header(%id, %body_length)
  #call lsp_write_literal("{\"data\":[")
  #let %item: #addr = %items
  #let %line: #bits<64> = 0
  #let %column: #bits<64> = 0
  #let %first: #bits<1> = 1
  #loop write_items {
    #if #call tool_is_nil(%source, %item) { #break write_items }
    #let %category: #bits<32> = #call tool_highlight_category(%item)
    #if #ne(%category, 0) {
      #if #eq(%first, 0) { #call lsp_write_literal(",") }
      #call lsp_tools_write_semantic_item(%item, %line, %column)
      %first: #bits<1> = 0
      %line: #bits<64> = #call tool_highlight_line(%item)
      %column: #bits<64> = #call tool_highlight_column(%item)
    }
    %item: #addr = #call tool_highlight_next(%item)
    #continue write_items
  }
  #call lsp_write_literal("]}")
  #call lsp_write_literal("}")
  #call lsp.flush()
  #return
}

// ----------------------------- formatting -------------------------------
// Formatting is a canonical full-document edit.  The in-memory sink below
// mirrors formatter.l1, so the response is generated inside LAIN-IR and the
// host never receives a syntax-aware formatting request.
#proc lsp_tools_text_end_line(#addr %text, #bits<64> %length) -> #bits<64> {
  #let %line: #bits<64> = 0
  #let %index: #bits<64> = 0
  #loop scan {
    #if #ge(%index, %length) { #break scan }
    #if #eq(#call lsp_byte_at(%text, %index), 10) {
      %line: #bits<64> = #add(%line, 1)
    }
    %index: #bits<64> = #add(%index, 1)
    #continue scan
  }
  #return %line
}

#proc lsp_tools_text_end_column(#addr %text, #bits<64> %length) -> #bits<64> {
  #let %column: #bits<64> = 0
  #let %index: #bits<64> = 0
  #loop scan {
    #if #ge(%index, %length) { #break scan }
    #if #eq(#call lsp_byte_at(%text, %index), 10) {
      %column: #bits<64> = 0
    } else {
      %column: #bits<64> = #add(%column, 1)
    }
    %index: #bits<64> = #add(%index, 1)
    #continue scan
  }
  #return %column
}

#proc lsp_tools_json_text_length(#addr %text, #bits<64> %length) -> #bits<64> {
  #let %out: #bits<64> = 0
  #let %index: #bits<64> = 0
  #loop scan {
    #if #ge(%index, %length) { #break scan }
    #let %byte: #bits<8> = #call lsp_byte_at(%text, %index)
    #if #eq(%byte, 34) {
      %out: #bits<64> = #add(%out, 2)
    } else {
      #if #eq(%byte, 92) {
        %out: #bits<64> = #add(%out, 2)
      } else {
        #if #eq(%byte, 8) {
          %out: #bits<64> = #add(%out, 2)
        } else {
          #if #eq(%byte, 9) {
            %out: #bits<64> = #add(%out, 2)
          } else {
            #if #eq(%byte, 10) {
              %out: #bits<64> = #add(%out, 2)
            } else {
              #if #eq(%byte, 12) {
                %out: #bits<64> = #add(%out, 2)
              } else {
                #if #eq(%byte, 13) {
                  %out: #bits<64> = #add(%out, 2)
                } else {
                  #if #lt(%byte, 32) {
                    %out: #bits<64> = #add(%out, 6)
                  } else {
                    %out: #bits<64> = #add(%out, 1)
                  }
                }
              }
            }
          }
        }
      }
    }
    %index: #bits<64> = #add(%index, 1)
    #continue scan
  }
  #return %out
}

#proc lsp_tools_write_json_text(#addr %text, #bits<64> %length) -> #unit {
  #let %index: #bits<64> = 0
  #loop write {
    #if #ge(%index, %length) { #break write }
    #let %byte: #bits<8> = #call lsp_byte_at(%text, %index)
    #if #eq(%byte, 34) {
      #call lsp_write_literal("\\\"")
    } else {
      #if #eq(%byte, 92) {
        #call lsp_write_literal("\\\\")
      } else {
        #if #eq(%byte, 8) {
          #call lsp_write_literal("\\b")
        } else {
          #if #eq(%byte, 9) {
            #call lsp_write_literal("\\t")
          } else {
            #if #eq(%byte, 10) {
              #call lsp_write_literal("\\n")
            } else {
              #if #eq(%byte, 12) {
                #call lsp_write_literal("\\f")
              } else {
                #if #eq(%byte, 13) {
                  #call lsp_write_literal("\\r")
                } else {
                  #call lsp.write-byte(%byte)
                }
              }
            }
          }
        }
      }
    }
    %index: #bits<64> = #add(%index, 1)
    #continue write
  }
  #return
}

#proc lsp_tools_diag_end_line(
  #addr %text, #bits<64> %start, #bits<64> %length, #bits<64> %line
) -> #bits<64> {
  #let %result_line: #bits<64> = %line
  #let %index: #bits<64> = 0
  #loop scan {
    #if #ge(%index, %length) { #break scan }
    #if #eq(#call lsp_byte_at(%text, #add(%start, %index)), 10) {
      %result_line: #bits<64> = #add(%result_line, 1)
    }
    %index: #bits<64> = #add(%index, 1)
    #continue scan
  }
  #return %result_line
}

#proc lsp_tools_diag_end_column(
  #addr %text, #bits<64> %start, #bits<64> %length, #bits<64> %column
) -> #bits<64> {
  #let %result_column: #bits<64> = %column
  #let %index: #bits<64> = 0
  #loop scan {
    #if #ge(%index, %length) { #break scan }
    #if #eq(#call lsp_byte_at(%text, #add(%start, %index)), 10) {
      %result_column: #bits<64> = 0
    } else {
      %result_column: #bits<64> = #add(%result_column, 1)
    }
    %index: #bits<64> = #add(%index, 1)
    #continue scan
  }
  #return %result_column
}

#proc lsp_tools_diag_item_length(
  #addr %text, #addr %diag
) -> #bits<64> {
  #let %start_line: #bits<64> = #call tool_diag_line(%diag)
  #let %start_column: #bits<64> = #call tool_diag_column(%diag)
  #let %start: #bits<64> = #call tool_diag_start(%diag)
  #let %length: #bits<64> = #call tool_diag_length(%diag)
  #let %end_line: #bits<64> = #call lsp_tools_diag_end_line(%text, %start, %length, %start_line)
  #let %end_column: #bits<64> = #call lsp_tools_diag_end_column(%text, %start, %length, %start_column)
  #let %message: #addr = #call tool_diag_message(%diag)
  #let %message_length: #bits<64> = #call tool_diag_message_length(%diag)
  #let %size: #bits<64> = #call lsp_cstring_length("{\"range\":{\"start\":{\"line\":")
  %size: #bits<64> = #add(%size, #call lsp_decimal_length(%start_line))
  %size: #bits<64> = #add(%size, #call lsp_cstring_length(",\"character\":"))
  %size: #bits<64> = #add(%size, #call lsp_decimal_length(%start_column))
  %size: #bits<64> = #add(%size, #call lsp_cstring_length("},\"end\":{\"line\":"))
  %size: #bits<64> = #add(%size, #call lsp_decimal_length(%end_line))
  %size: #bits<64> = #add(%size, #call lsp_cstring_length(",\"character\":"))
  %size: #bits<64> = #add(%size, #call lsp_decimal_length(%end_column))
  %size: #bits<64> = #add(%size, #call lsp_cstring_length("}},\"severity\":"))
  %size: #bits<64> = #add(%size, #call lsp_decimal_length(#zext[#bits<64>](#call tool_diag_severity(%diag))))
  %size: #bits<64> = #add(%size, #call lsp_cstring_length(",\"message\":\""))
  %size: #bits<64> = #add(%size, #call lsp_tools_json_text_length(%message, %message_length))
  %size: #bits<64> = #add(%size, 2) // closing quote and object
  #return %size
}

#proc lsp_tools_write_diag_item(#addr %text, #addr %diag) -> #unit {
  #let %start_line: #bits<64> = #call tool_diag_line(%diag)
  #let %start_column: #bits<64> = #call tool_diag_column(%diag)
  #let %start: #bits<64> = #call tool_diag_start(%diag)
  #let %length: #bits<64> = #call tool_diag_length(%diag)
  #let %end_line: #bits<64> = #call lsp_tools_diag_end_line(%text, %start, %length, %start_line)
  #let %end_column: #bits<64> = #call lsp_tools_diag_end_column(%text, %start, %length, %start_column)
  #call lsp_write_literal("{\"range\":{\"start\":{\"line\":")
  #call lsp_write_decimal(%start_line)
  #call lsp_write_literal(",\"character\":")
  #call lsp_write_decimal(%start_column)
  #call lsp_write_literal("},\"end\":{\"line\":")
  #call lsp_write_decimal(%end_line)
  #call lsp_write_literal(",\"character\":")
  #call lsp_write_decimal(%end_column)
  #call lsp_write_literal("}},\"severity\":")
  #call lsp_write_decimal(#zext[#bits<64>](#call tool_diag_severity(%diag)))
  #call lsp_write_literal(",\"message\":\"")
  #call lsp_tools_write_json_text(#call tool_diag_message(%diag), #call tool_diag_message_length(%diag))
  #call lsp_write_literal("\"}")
  #return
}

#proc lsp_write_publish_diagnostics(#addr %document, #addr %source) -> #unit {
  #let %text: #addr = #call lsp_document_text(%document)
  #let %diagnostics: #addr = #call tool_source_diagnostics(%source)
  #let %body_length: #bits<64> = #call lsp_cstring_length(
    "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
  %body_length: #bits<64> = #add(%body_length,
    #call lsp_tools_json_text_length(#call lsp_document_uri(%document), #call lsp_load64(%document, 8)))
  %body_length: #bits<64> = #add(%body_length, #call lsp_cstring_length("\",\"diagnostics\":["))
  #let %item: #addr = %diagnostics
  #let %first: #bits<1> = 1
  #loop count {
    #if #call tool_is_nil(%source, %item) { #break count }
    #if #eq(%first, 0) { %body_length: #bits<64> = #add(%body_length, 1) }
    %body_length: #bits<64> = #add(%body_length, #call lsp_tools_diag_item_length(%text, %item))
    %first: #bits<1> = 0
    %item: #addr = #call tool_diag_next(%item)
    #continue count
  }
  %body_length: #bits<64> = #add(%body_length, 3) // ]}}
  #call lsp_write_literal("Content-Length: ")
  #call lsp_write_decimal(%body_length)
  #call lsp_write_literal("\r\n\r\n{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"")
  #call lsp_tools_write_json_text(#call lsp_document_uri(%document), #call lsp_load64(%document, 8))
  #call lsp_write_literal("\",\"diagnostics\":[")
  %item: #addr = %diagnostics
  %first: #bits<1> = 1
  #loop write {
    #if #call tool_is_nil(%source, %item) { #break write }
    #if #eq(%first, 0) { #call lsp_write_literal(",") }
    #call lsp_tools_write_diag_item(%text, %item)
    %first: #bits<1> = 0
    %item: #addr = #call tool_diag_next(%item)
    #continue write
  }
  #call lsp_write_literal("]}}")
  #call lsp.flush()
  #return
}

// The same byte policy as formatter.l1, with an in-memory sink for LSP.  The
// sink is a LAIN-IR record, so formatting remains testable without a host
// callback and the C side never sees source syntax.
// Format state: data@0, length@8, output@16, capacity@24, position@32,
// depth@40, line_start@48, need_space@56.
#proc lsp_fmt_load64(#addr %state, #bits<64> %offset) -> #bits<64> {
  #return #load[#bits<64>](#lea(base=%state, idx=%offset, scale=1, offset=0))
}

#proc lsp_fmt_store64(#addr %state, #bits<64> %offset, #bits<64> %value) -> #unit {
  #store[#bits<64>] %value, #lea(base=%state, idx=%offset, scale=1, offset=0)
  #return
}

#proc lsp_fmt_byte(#addr %state, #bits<64> %index) -> #bits<8> {
  #let %data: #addr = #load[addr](#lea(base=%state, idx=0, scale=1, offset=0))
  #return #call lsp_byte_at(%data, %index)
}

#proc lsp_fmt_emit(#addr %state, #bits<8> %byte) -> #unit {
  #let %position: #bits<64> = #call lsp_fmt_load64(%state, 32)
  #let %output: #addr = #load[addr](#lea(base=%state, idx=0, scale=1, offset=16))
  #store[#bits<8>] %byte, #lea(base=%output, idx=%position, scale=1, offset=0)
  #call lsp_fmt_store64(%state, 32, #add(%position, 1))
  #return
}

#proc lsp_fmt_space(#addr %state) -> #unit { #call lsp_fmt_emit(%state, 32) }
#proc lsp_fmt_newline(#addr %state) -> #unit { #call lsp_fmt_emit(%state, 10) }

#proc lsp_fmt_indent(#addr %state) -> #unit {
  #let %index: #bits<64> = 0
  #let %depth: #bits<64> = #call lsp_fmt_load64(%state, 40)
  #loop indent {
    #if #ge(%index, #mul(%depth, 2)) { #break indent }
    #call lsp_fmt_space(%state)
    %index: #bits<64> = #add(%index, 1)
    #continue indent
  }
}

#proc lsp_fmt_word(#bits<8> %byte) -> #bits<1> {
  #if #ge(%byte, 48) { #if #le(%byte, 57) { #return 1 } }
  #if #ge(%byte, 65) { #if #le(%byte, 90) { #return 1 } }
  #if #ge(%byte, 97) { #if #le(%byte, 122) { #return 1 } }
  #if #eq(%byte, 35) { #return 1 }
  #if #eq(%byte, 37) { #return 1 }
  #if #eq(%byte, 95) { #return 1 }
  #if #eq(%byte, 46) { #return 1 }
  #if #eq(%byte, 45) { #return 1 }
  #return 0
}

#proc lsp_fmt_hspace(#bits<8> %byte) -> #bits<1> {
  #if #eq(%byte, 32) { #return 1 }
  #if #eq(%byte, 9) { #return 1 }
  #if #eq(%byte, 13) { #return 1 }
  #return 0
}

#proc lsp_fmt_copy_string(#addr %state, #bits<64> %length, #bits<64> %start) -> #bits<64> {
  #let %index: #bits<64> = %start
  #loop string {
    #if #ge(%index, %length) { #return %index }
    #let %byte: #bits<8> = #call lsp_fmt_byte(%state, %index)
    #call lsp_fmt_emit(%state, %byte)
    %index: #bits<64> = #add(%index, 1)
    #if #eq(%byte, 92) {
      #if #lt(%index, %length) {
        #call lsp_fmt_emit(%state, #call lsp_fmt_byte(%state, %index))
        %index: #bits<64> = #add(%index, 1)
      }
    } else {
      #if #eq(%byte, 34) { #return %index }
    }
    #continue string
  }
}

#proc lsp_fmt_copy_comment(#addr %state, #bits<64> %length, #bits<64> %start) -> #bits<64> {
  #let %index: #bits<64> = #add(%start, 2)
  #call lsp_fmt_emit(%state, 47)
  #call lsp_fmt_emit(%state, 47)
  #loop comment {
    #if #ge(%index, %length) { #return %index }
    #let %byte: #bits<8> = #call lsp_fmt_byte(%state, %index)
    #if #eq(%byte, 10) { #return %index }
    #call lsp_fmt_emit(%state, %byte)
    %index: #bits<64> = #add(%index, 1)
    #continue comment
  }
}

#proc lsp_fmt_copy_word(#addr %state, #bits<64> %length, #bits<64> %start) -> #bits<64> {
  #let %index: #bits<64> = %start
  #loop word {
    #if #ge(%index, %length) { #return %index }
    #let %byte: #bits<8> = #call lsp_fmt_byte(%state, %index)
    #if #eq(#call lsp_fmt_word(%byte), 0) { #return %index }
    #call lsp_fmt_emit(%state, %byte)
    %index: #bits<64> = #add(%index, 1)
    #continue word
  }
}

#proc lsp_tools_format_memory(#addr %data, #bits<64> %length) -> #addr {
  #let %state: #addr = #call lsp.allocate(64)
  #let %output: #addr = #call lsp.allocate(#add(#mul(%length, 16), 1024))
  #store %data, #lea(base=%state, idx=0, scale=1, offset=0)
  #call lsp_fmt_store64(%state, 8, %length)
  #store %output, #lea(base=%state, idx=0, scale=1, offset=16)
  #call lsp_fmt_store64(%state, 24, #add(#mul(%length, 16), 1024))
  #call lsp_fmt_store64(%state, 32, 0)
  #call lsp_fmt_store64(%state, 40, 0)
  #call lsp_fmt_store64(%state, 48, 1)
  #call lsp_fmt_store64(%state, 56, 0)
  #let %index: #bits<64> = 0
  #loop source {
    #if #ge(%index, %length) { #break source }
    #let %byte: #bits<8> = #call lsp_fmt_byte(%state, %index)
    #let %at_start: #bits<64> = #call lsp_fmt_load64(%state, 48)
    #if #eq(%byte, 10) {
      #if #eq(%at_start, 0) { #call lsp_fmt_newline(%state) }
      #call lsp_fmt_store64(%state, 48, 1)
      #call lsp_fmt_store64(%state, 56, 0)
      %index: #bits<64> = #add(%index, 1)
      #continue source
    }
    #if #call lsp_fmt_hspace(%byte) {
      %index: #bits<64> = #add(%index, 1)
      #continue source
    }
    #if #eq(%at_start, 1) {
      #if #ne(%byte, 125) {
        #call lsp_fmt_indent(%state)
        #call lsp_fmt_store64(%state, 48, 0)
      }
    }
    #if #eq(%byte, 47) {
      #if #lt(#add(%index, 1), %length) {
        #if #eq(#call lsp_fmt_byte(%state, #add(%index, 1)), 47) {
          #if #eq(#call lsp_fmt_load64(%state, 56), 1) { #call lsp_fmt_space(%state) }
          %index: #bits<64> = #call lsp_fmt_copy_comment(%state, %length, %index)
          #call lsp_fmt_store64(%state, 56, 0)
          #continue source
