#proc lsp_write_formatting_response(#bits<64> %id, #addr %document) -> #unit {
  #if #call lsp_document_is_nil(%document) {
    #call lsp_write_json_response(%id, "[]")
    #return
  }
  #let %text: #addr = #call lsp_document_text(%document)
  #let %length: #bits<64> = #call lsp_document_length(%document)
  #let %formatted: #addr = #call lsp_tools_format_memory(%text, %length)
  #let %formatted_text: #addr = #load[#addr](#lea(base=%formatted, idx=0, scale=1, offset=0))
  #let %formatted_length: #bits<64> = #call lsp_fmt_load64(%formatted, 8)
  #let %escaped: #bits<64> = #call lsp_tools_json_text_length(%formatted_text, %formatted_length)
  #let %line: #bits<64> = #call lsp_tools_text_end_line(%formatted_text, %formatted_length)
  #let %column: #bits<64> = #call lsp_tools_text_end_column(%formatted_text, %formatted_length)
  #let %result_length: #bits<64> =
    #call lsp_cstring_length("[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":")
  %result_length: #bits<64> = #add(%result_length, #call lsp_decimal_length(%line))
  %result_length: #bits<64> = #add(%result_length, #call lsp_cstring_length(",\"character\":"))
  %result_length: #bits<64> = #add(%result_length, #call lsp_decimal_length(%column))
  %result_length: #bits<64> = #add(%result_length, #call lsp_cstring_length("}},\"newText\":\""))
  %result_length: #bits<64> = #add(%result_length, %escaped)
  %result_length: #bits<64> = #add(%result_length, #call lsp_cstring_length("\"}]"))
  #let %body_length: #bits<64> = #add(
    #add(#call lsp_cstring_length("{\"jsonrpc\":\"2.0\",\"id\":"), #call lsp_decimal_length(%id)),
    #add(#call lsp_cstring_length(",\"result\":"), %result_length))
  %body_length: #bits<64> = #add(%body_length, 1)
  #call lsp_tools_write_header(%id, %body_length)
  #call lsp_write_literal("[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":")
  #call lsp_write_decimal(%line)
  #call lsp_write_literal(",\"character\":")
  #call lsp_write_decimal(%column)
  #call lsp_write_literal("}},\"newText\":\"")
  #call lsp_tools_write_json_text(%formatted_text, %formatted_length)
  #call lsp_write_literal("\"}]")
  #call lsp_write_literal("}")
  #call lsp.flush()
  #return
}
