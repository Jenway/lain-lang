// Transitional compiler entry.
//
// The entry is deliberately named `compiler_compile` so the bootstrap host
// can stabilize around one call.  Its first accepted source form is the
// function slice in lower_func.l1; later Meta/elaboration/lowering phases will
// be added behind this same boundary.

#extern #proc compiler_request_new() -> #addr;
#extern #proc compiler_request_set_root(#addr %request, #bits<64> %root) -> #unit;
#extern #proc compiler_request_set_require_main(#addr %request, #bits<1> %required) -> #unit;
#extern #proc bootstrap.source-count() -> #bits<64>;
#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(#bits<8> %byte) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc compiler_compile_request(#addr %request) -> #addr;
#extern #proc compiler_result_status(#addr %result) -> #bits<32>;

#proc compiler_compile() -> #bits<32> {
  #let %request: #addr = #call compiler_request_new()
  #let %result: #addr = #call compiler_compile_request(%request)
  #return #call compiler_result_status(%result)
}

// Library compilation is the entry used for a source closure that does not
// itself declare a native `main` (for example the canonical compiler modules).
#proc compiler_compile_library() -> #bits<32> {
  #let %request: #addr = #call compiler_request_new()
  #call compiler_request_set_root(
    %request, #sub(#call bootstrap.source-count(), 1)
  )
  #call compiler_request_set_require_main(%request, 0)
  #let %result: #addr = #call compiler_compile_request(%request)
  #return #call compiler_result_status(%result)
}

// LAIN-IR bootstrap boundary. The stage-0 interpreter accepts a verified
// LAIN-IR bundle as its source. This entry preserves that bundle through a
// LAIN-IR-owned entry so stage2 and stage3 do not depend on a native lainc.
#proc compiler_reemit_l1() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) { #return 5000 }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #call bootstrap.artifact-begin()
  #let %index: #bits<64> = 0
  #loop bytes {
    #if #sge(%index, %length) { #break bytes }
    #call bootstrap.artifact-write-byte(
      #load[#bits<8>](#lea(base=%data, idx=%index, scale=1, offset=0))
    )
    %index: #bits<64> = #add(%index, 1)
    #continue bytes
  }
  #call bootstrap.artifact-finish()
  #return 0
}
