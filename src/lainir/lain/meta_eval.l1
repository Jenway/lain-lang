// Compile-time evaluation of operands.
//
// The evaluator returns Meta/eval result objects.  It does not emit runtime
// LAIN-IR; runtime lowering stays in lower_program and the later lower_* files.

#extern #proc program_is_std_module_value(
  addr %source, addr %value_node
) -> i1;

#proc program_eval_param_value(
  addr %source, addr %function, addr %node, addr %arguments
) -> addr {
  #if #call program_function_is_nil(%function) {
    #return #call eval_result_new(5108, 0)
  }
  #let %params: addr = #call raw_node_first(
    #call program_function_params(%function)
  )
  #let %data: addr = #call tool_source_data(%source)
  #let %index: #bits<64> = 0
  #loop parameters {
    #if #call raw_is_nil(%params) { #break parameters }
    #if #eq(
      #call raw_node_length(%params), #call raw_node_length(%node)
    ) {
      #let %offset: #bits<64> = 0
      #let %same: i1 = 1
      #loop compare {
        #if #ge(%offset, #call raw_node_length(%node)) {
          #break compare
        }
        #if #ne(
          #call tool_byte_at(
            %data, #add(#call raw_node_start(%params), %offset)
          ),
          #call tool_byte_at(
            %data, #add(#call raw_node_start(%node), %offset)
          )
        ) {
          %same: i1 = 0
          #break compare
        }
        %offset: #bits<64> = #add(%offset, 1)
        #continue compare
      }
      #if %same {
        #return #load[addr](
          #lea(base=%arguments, idx=%index, scale=8, offset=0)
        )
      }
    }
    #let %colon: addr = #call raw_node_next(%params)
    #let %type: addr = #call raw_node_next(%colon)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #let %separator: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%separator) { #break parameters }
    %params: addr = #call raw_node_next(%separator)
    %index: #bits<64> = #add(%index, 1)
    #continue parameters
  }
  #return #call eval_result_new(5108, 0)
}

#proc program_eval_operand(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %node
) -> addr {
  #if #call program_is_boolean(%source, %node) {
    #return #call eval_result_new(
      0, #call program_boolean_value(%source, %node)
    )
  }
  #if #call program_is_decimal(%source, %node) {
    #let %parsed: addr = #call program_parse_decimal(%source, %node)
    #return #call eval_result_new(
      #call program_result_status(%parsed),
      #call program_result_value(%parsed)
    )
  }
  #if #call program_is_external_vec_call(%source, %node) {
    #let %environment: addr = #call program_unit_meta_environment(%unit)
    #if #eq(#call program_function_is_nil(%function), 0) {
      #let %function_environment: addr = #call program_function_environment(
        %function
      )
      #if #eq(#call raw_is_nil(%function_environment), 0) {
        %environment: addr = %function_environment
      }
    }
    #let %existing: addr = #call meta_env_lookup_path(
      %environment, %source, %node
    )
    #if #eq(#call meta_value_kind(%existing), 0) {
      #return #call program_eval_external_vec(%source, %node)
    }
  }
  #if #call program_is_std_path(%source, %node) {
    #let %member: addr = #call program_operand_name(%source, %node)
    #if #call meta_atom_equal(
      %source, %member, "type_with_namespace", 19
    ) {
      #return #call program_eval_type_with_namespace(
        %unit, %source, %function, %arguments,
        #call program_operand_group(%source, %node)
      )
    }
  }
  #if #call program_is_std_meta_object(%source, %node) {
    #return #call program_eval_std_meta_object(%source, %node)
  }
  #let %name: addr = #call program_operand_name(%source, %node)
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #eq(#call raw_is_nil(%group), 0) {
    #let %environment: addr = #call program_unit_meta_environment(%unit)
    #if #eq(#call program_function_is_nil(%function), 0) {
      #let %function_environment: addr =
        #call program_function_environment(%function)
      #if #eq(#call raw_is_nil(%function_environment), 0) {
        %environment: addr = %function_environment
      }
    }
    #return #call program_eval_call_environment(
      %unit, %source, %function, %arguments,
      %node, %group, %environment
    )
  }
  #if #call program_is_record_literal(%source, %node) {
    #let %record_type: addr = #call program_find_type(
      %unit, %source, %name
    )
    #if #eq(#call raw_is_nil(%record_type), 0) {
      #return #call eval_result_object(
        0,
        #call meta_value_type(
          #call program_type_source(%record_type), %name,
          #call program_type_binding(%record_type)
        )
      )
    }
  }
  #let %environment: addr = #call program_unit_meta_environment(%unit)
  #if #eq(#call program_function_is_nil(%function), 0) {
    #let %function_environment: addr =
      #call program_function_environment(%function)
    #if #eq(#call raw_is_nil(%function_environment), 0) {
      %environment: addr = %function_environment
    }
  }
  #let %meta_value: addr = #call meta_env_lookup_path(
    %environment, %source, %node
  )
  #if #eq(#call raw_is_nil(%meta_value), 0) {
    #if #ne(#call meta_value_kind(%meta_value), 1) {
      #return #call eval_result_object(0, %meta_value)
    }
    #return #call eval_result_new(
      0, #call meta_value_scalar_number(%meta_value)
    )
  }
  #if #call program_type_valid_in_unit(%unit, %source, %node) {
    #return #call eval_result_object(
      0, #call meta_value_type(%source, %node, %node)
    )
  }
  #let %parameter: addr = #call program_eval_param_value(
    %source, %function, %name, %arguments
  )
  #if #eq(#call eval_status(%parameter), 0) { #return %parameter }
  #let %constant: addr = #call program_find_constant(
    %unit, %source, %name
  )
  #if #eq(#call raw_is_nil(%constant), 0) {
    #return #call eval_result_new(
      0, #call program_constant_value(%constant)
    )
  }
  #return #call eval_result_new(5108, 0)
}

#proc program_eval_value_expression(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %left
) -> addr {
  #let %left_result: addr = #call program_eval_operand(
    %unit, %source, %function, %arguments, %left
  )
  #if #ne(#call eval_status(%left_result), 0) {
    #return %left_result
  }
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return %left_result }
  #if #call program_is_semicolon(%source, %operator) {
    #return %left_result
  }
  #if #call meta_atom_equal(%source, %operator, ",", 1) {
    #return %left_result
  }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return #call eval_result_new(3102, 0)
  }
  #let %right: addr = #call raw_node_next(%operator)
  #if #call raw_is_nil(%right) { #return #call eval_result_new(3102, 0) }
  #let %right_result: addr = #call program_eval_value_expression(
    %unit, %source, %function, %arguments, %right
  )
  #if #ne(#call eval_status(%right_result), 0) {
    #return %right_result
  }
  #let %left_value: #bits<64> = #call eval_value(%left_result)
  #let %right_value: #bits<64> = #call eval_value(%right_result)
  #if #call meta_atom_equal(%source, %operator, "+", 1) {
    #return #call eval_result_new(0, #add(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "-", 1) {
    #return #call eval_result_new(0, #sub(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "*", 1) {
    #return #call eval_result_new(0, #mul(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "==", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#eq(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "!=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#ne(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "<", 1) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#lt(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "<=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#le(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, ">", 1) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#gt(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, ">=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#ge(%left_value, %right_value))
    )
  }
  #if #eq(%right_value, 0) {
    #return #call eval_result_new(3103, 0)
  }
  #return #call eval_result_new(0, #div(%left_value, %right_value))
}

#proc program_eval_bind_parameters(
  addr %unit, addr %source, addr %function,
  addr %arguments, addr %environment
) -> #bits<32> {
  #let %param: addr = #call raw_node_first(
    #call program_function_params(%function)
  )
  #let %index: #bits<64> = 0
  #loop parameters {
    #if #call raw_is_nil(%param) { #return 0 }
    #let %argument: addr = #load[addr](
      #lea(base=%arguments, idx=%index, scale=8, offset=0)
    )
    #if #call eval_result_is_object(%argument) {
      #call meta_env_bind(
        %environment, %source, %param, #call eval_object(%argument)
      )
    } else {
      #call meta_env_bind(
        %environment, %source, %param,
        #call meta_value_scalar(
          %source, %param, #call eval_value(%argument)
        )
      )
    }
    #let %colon: addr = #call raw_node_next(%param)
    #let %type: addr = #call raw_node_next(%colon)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #let %separator: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%separator) { #return 0 }
    %param: addr = #call raw_node_next(%separator)
    %index: #bits<64> = #add(%index, 1)
    #continue parameters
  }
}

#proc program_eval_type_with_namespace_environment(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %environment, addr %group
) -> addr {
  #let %type_argument: addr = #call raw_node_first(%group)
  #let %comma: addr = #call raw_node_next(%type_argument)
  #if #call raw_is_nil(%comma) {
    #return #call eval_result_new(3102, 0)
  }
  #let %namespace_argument: addr = #call raw_node_next(%comma)
  #if #call raw_is_nil(%namespace_argument) {
    #return #call eval_result_new(3102, 0)
  }
  #let %type_result: addr = #call program_eval_operand_environment(
    %unit, %source, %function, %arguments, %environment, %type_argument
  )
  #if #ne(#call eval_status(%type_result), 0) {
    #return %type_result
  }
  #if #eq(#call eval_result_is_object(%type_result), 0) {
    #return #call eval_result_new(3102, 0)
  }
  #let %namespace_result: addr = #call program_eval_operand_environment(
    %unit, %source, %function, %arguments,
    %environment, %namespace_argument
  )
  #if #ne(#call eval_status(%namespace_result), 0) {
    #return %namespace_result
  }
  #if #eq(#call eval_result_is_object(%namespace_result), 0) {
    #return #call eval_result_new(3102, 0)
  }
  #let %type_value: addr = #call eval_object(%type_result)
  #let %namespace_value: addr = #call eval_object(%namespace_result)
  #if #ne(#call meta_value_kind(%namespace_value), 2) {
    #return #call eval_result_new(3102, 0)
  }
  #return #call eval_result_object(
    0,
    #call meta_value_type_with_namespace(
      %source, %type_argument,
      #call meta_value_payload(%type_value),
      #call meta_value_environment(%namespace_value)
    )
  )
}

#proc program_eval_type_with_namespace(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %group
) -> addr {
  #let %environment: addr = #call program_unit_meta_environment(%unit)
  #if #eq(#call program_function_is_nil(%function), 0) {
    #let %function_environment: addr =
      #call program_function_environment(%function)
    #if #eq(#call raw_is_nil(%function_environment), 0) {
      %environment: addr = %function_environment
    }
  }
  #return #call program_eval_type_with_namespace_environment(
    %unit, %source, %function, %arguments,
    %environment, %group
  )
}

#proc program_eval_function(
  addr %unit, addr %function, addr %arguments
) -> addr {
  #call program_unit_set_meta_stage(%unit, 11)
  #if #call program_unit_meta_step_inc(%unit) {
    #call program_unit_set_validation_function(%unit, %function)
    #return #call eval_result_new(5124, 0)
  }
  #let %source: addr = #call program_function_source(%function)
  #let %old_environment: addr = #call program_function_environment(
    %function
  )
  #let %parent: addr = %old_environment
  #if #call raw_is_nil(%parent) {
    %parent: addr = #call program_unit_meta_environment(%unit)
  }
  #let %environment: addr = #call meta_env_new(%parent)
  #call program_function_set_environment(%function, %environment)
  #let %parameter_status: #bits<32> = #call program_eval_bind_parameters(
    %unit, %source, %function, %arguments, %environment
  )
  #if #ne(%parameter_status, 0) {
    #call program_function_set_environment(%function, %old_environment)
    #return #call eval_result_new(%parameter_status, 0)
  }
  #let %statement: addr = #call raw_node_first(
    #call program_function_body(%function)
  )
  #loop statements {
    #if #call raw_is_nil(%statement) {
      #call program_function_set_environment(%function, %old_environment)
      #return #call eval_result_new(3101, 0)
    }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %local_status: #bits<32> = #call program_eval_local_binding(
        %unit, %source, %function, %statement, %environment
      )
      #if #ne(%local_status, 0) {
        #call program_unit_set_debug_module_kind(%unit, 4601)
        #call program_unit_set_debug_source_index(
          %unit, #call raw_node_start(%statement)
        )
        #call program_function_set_environment(%function, %old_environment)
        #return #call eval_result_new(%local_status, 0)
      }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "return", 6) {
      #let %value: addr = #call raw_node_next(%statement)
      #if #call program_is_std_module_value(%source, %value) {
        #let %module_environment: addr = #call meta_env_new(%environment)
        #let %module_value: addr = #call meta_value_module(
          %source, %value,
          #call program_std_module_value_group(%source, %value),
          %module_environment
        )
        #let %module_status: #bits<32> = #call program_collect_module(
          %unit, %source,
          #call program_function_source_index(%function),
          #call program_std_module_value_group(%source, %value),
          %module_environment
        )
        #if #ne(%module_status, 0) {
          #call program_function_set_environment(%function, %old_environment)
          #return #call eval_result_new(%module_status, 0)
        }
        #call program_function_set_environment(%function, %old_environment)
        #return #call eval_result_object(0, %module_value)
      }
      #let %result: addr = #call program_eval_value_expression(
        %unit, %source, %function, %arguments, %value
      )
      #if #ne(#call eval_status(%result), 0) {
        #call program_unit_set_debug_module_kind(%unit, 4602)
        #call program_unit_set_debug_source_index(
          %unit, #call raw_node_start(%value)
        )
      }
      #call program_function_set_environment(%function, %old_environment)
      #return %result
    }
    #call program_function_set_environment(%function, %old_environment)
    #return #call eval_result_new(3101, 0)
  }
}

#proc program_eval_operand_environment(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %environment, addr %node
) -> addr {
  #if #call program_is_boolean(%source, %node) {
    #return #call eval_result_new(
      0, #call program_boolean_value(%source, %node)
    )
  }
  #if #call program_is_decimal(%source, %node) {
    #let %parsed: addr = #call program_parse_decimal(%source, %node)
    #return #call eval_result_new(
      #call program_result_status(%parsed),
      #call program_result_value(%parsed)
    )
  }
  #if #call program_is_external_vec_call(%source, %node) {
    #let %existing: addr = #call meta_env_lookup_path(
      %environment, %source, %node
    )
    #if #eq(#call meta_value_kind(%existing), 0) {
      #return #call program_eval_external_vec(%source, %node)
    }
  }
  #if #call program_is_std_path(%source, %node) {
    #let %member: addr = #call program_operand_name(%source, %node)
    #if #call meta_atom_equal(
      %source, %member, "type_with_namespace", 19
    ) {
      #return #call program_eval_type_with_namespace_environment(
        %unit, %source, %function, %arguments, %environment,
        #call program_operand_group(%source, %node)
      )
    }
  }
  #if #call program_is_std_meta_object(%source, %node) {
    #return #call program_eval_std_meta_object(%source, %node)
  }
  #let %name: addr = #call program_operand_name(%source, %node)
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #eq(#call raw_is_nil(%group), 0) {
    #return #call program_eval_call_environment(
      %unit, %source, %function, %arguments,
      %node, %group, %environment
    )
  }
  #if #call program_is_record_literal(%source, %node) {
    #let %record_type: addr = #call program_find_type(
      %unit, %source, %name
    )
    #if #eq(#call raw_is_nil(%record_type), 0) {
      #return #call eval_result_object(
        0,
        #call meta_value_type(
          #call program_type_source(%record_type), %name,
          #call program_type_binding(%record_type)
        )
      )
    }
  }
  #let %meta_value: addr = #call meta_env_lookup_path(
    %environment, %source, %node
  )
  #if #eq(#call raw_is_nil(%meta_value), 0) {
    #if #ne(#call meta_value_kind(%meta_value), 1) {
      #return #call eval_result_object(0, %meta_value)
    }
    #return #call eval_result_new(
      0, #call meta_value_scalar_number(%meta_value)
    )
  }
  #if #call program_type_valid_in_unit(%unit, %source, %node) {
    #return #call eval_result_object(
      0, #call meta_value_type(%source, %node, %node)
    )
  }
  #let %parameter: addr = #call program_eval_param_value(
    %source, %function, %name, %arguments
  )
  #if #eq(#call eval_status(%parameter), 0) { #return %parameter }
  #let %constant: addr = #call program_find_constant(
    %unit, %source, %name
  )
  #if #eq(#call raw_is_nil(%constant), 0) {
    #return #call eval_result_new(
      0, #call program_constant_value(%constant)
    )
  }
  #return #call eval_result_new(5108, 0)
}

#proc program_eval_value_environment(
  addr %unit, addr %source, addr %function, addr %arguments,
  addr %environment, addr %left
) -> addr {
  #let %left_result: addr = #call program_eval_operand_environment(
    %unit, %source, %function, %arguments, %environment, %left
  )
  #if #ne(#call eval_status(%left_result), 0) {
    #return %left_result
  }
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return %left_result }
  #if #call program_is_semicolon(%source, %operator) {
    #return %left_result
  }
  #if #call meta_atom_equal(%source, %operator, ",", 1) {
    #return %left_result
  }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return #call eval_result_new(3102, 0)
  }
  #let %operator_end: addr = #call program_value_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #if #call raw_is_nil(%right) { #return #call eval_result_new(3102, 0) }
  #let %right_result: addr = #call program_eval_value_environment(
    %unit, %source, %function, %arguments, %environment, %right
  )
  #if #ne(#call eval_status(%right_result), 0) {
    #return %right_result
  }
  #let %left_value: #bits<64> = #call eval_value(%left_result)
  #let %right_value: #bits<64> = #call eval_value(%right_result)
  #if #call meta_atom_equal(%source, %operator, "+", 1) {
    #return #call eval_result_new(0, #add(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "-", 1) {
    #return #call eval_result_new(0, #sub(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "*", 1) {
    #return #call eval_result_new(0, #mul(%left_value, %right_value))
  }
  #if #call meta_atom_equal(%source, %operator, "==", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#eq(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "!=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#ne(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "<", 1) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#lt(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, "<=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#le(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, ">", 1) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#gt(%left_value, %right_value))
    )
  }
  #if #call meta_atom_equal(%source, %operator, ">=", 2) {
    #return #call eval_result_new(
      0, #zext[#bits<64>](#ge(%left_value, %right_value))
    )
  }
  #if #eq(%right_value, 0) {
    #return #call eval_result_new(3103, 0)
  }
  #return #call eval_result_new(0, #div(%left_value, %right_value))
}

#proc program_eval_call_environment(
  addr %unit, addr %source, addr %caller, addr %caller_arguments,
  addr %callee, addr %group, addr %environment
) -> addr {
  #call program_unit_set_meta_callee(%unit, #call raw_node_start(%callee))
  #if #call program_unit_meta_step_inc(%unit) {
    #call program_unit_set_validation_node(%unit, %source, %callee)
    #return #call eval_result_new(5124, 0)
  }
  // The compiler's physical lowering does not need to execute every method
  // body while building a module factory.  Keep the first large API closure
  // bounded: factories still return their concrete type/module descriptor,
  // while runtime method calls are resolved later by lowering.
  #if #call program_is_external_vec_call(%source, %callee) {
    #let %existing: addr = #call meta_env_lookup_path(
      %environment, %source, %callee
    )
    #if #eq(#call meta_value_kind(%existing), 0) {
      #return #call program_eval_external_vec(%source, %callee)
    }
  }
  #let %path_start: #bits<64> = #call raw_node_start(%callee)
  #let %path_length: #bits<64> = #call raw_node_length(%callee)
  #let %path_data: addr = #call tool_source_data(%source)
  #let %path_index: #bits<64> = 0
  #loop first_segment {
    #if #ge(%path_index, %path_length) { #break first_segment }
    #if #eq(
      #call tool_byte_at(%path_data, #add(%path_start, %path_index)), 46
    ) { #break first_segment }
    %path_index: #bits<64> = #add(%path_index, 1)
    #continue first_segment
  }
  #let %first_value: addr = #call meta_env_lookup_span(
    %environment, %source, %path_start, %path_index
  )
  #if #eq(#call meta_value_kind(%first_value), 0) {
    #call program_unit_set_first_path_kind(%unit, 0)
  } else {
    #call program_unit_set_first_path_kind(
      %unit, #call meta_value_kind(%first_value)
    )
  }
  #let %target: addr = #call program_nil()
  #let %meta_value: addr = #call meta_env_lookup_path(
    %environment, %source, %callee
  )
  #if #eq(#call meta_value_kind(%meta_value), 0) {
    #call program_unit_set_path_kind(%unit, 0)
  } else {
    #call program_unit_set_path_kind(
      %unit, #call meta_value_kind(%meta_value)
    )
    #if #eq(#call meta_value_kind(%meta_value), 3) {
      %target: addr = #call meta_value_payload(%meta_value)
    }
  }
  #if #call program_function_is_nil(%target) {
    %target: addr = #call program_find_function_for_caller(
      %unit, %source, %caller, %callee
    )
  }
  #if #call program_function_is_nil(%target) {
    #if #call program_function_is_nil(%caller) {
    } else {
      #call program_unit_set_validation_function(%unit, %caller)
    }
    #if #eq(#call meta_value_kind(%first_value), 0) {
      #if #call program_function_is_nil(%caller) {
      } else {
        #call program_unit_set_validation_function(%unit, %caller)
      }
      #call program_unit_set_validation_node(%unit, %source, %callee)
      #return #call eval_result_new(5108, 0)
    }
    #call program_unit_set_validation_node(%unit, %source, %callee)
    #return #call eval_result_new(5108, 0)
  }
  #let %argument: addr = #call raw_node_first(%group)
  #let %count: #bits<64> = 0
  #loop count_arguments {
    #if #call raw_is_nil(%argument) { #break count_arguments }
    %count: #bits<64> = #add(%count, 1)
    #let %separator: addr = #call raw_node_next(%argument)
    #if #call raw_is_nil(%separator) { #break count_arguments }
    %argument: addr = #call raw_node_next(%separator)
    #continue count_arguments
  }
  #if #ne(%count, #call program_function_count(%target)) {
    #call program_unit_set_call_context(
      %unit, #call program_function_count(%target), %count,
      #call program_function_source_index(%target)
    )
    #call program_unit_set_validation_function(%unit, %target)
    #call program_unit_set_validation_node(%unit, %source, %callee)
    #return #call eval_result_new(5109, 0)
  }
  #let %arguments: addr = #call bootstrap.allocate-pages(#mul(%count, 8))
  #let %value_argument: addr = #call raw_node_first(%group)
  #let %index: #bits<64> = 0
  #loop evaluate_arguments {
    #if #call raw_is_nil(%value_argument) { #break evaluate_arguments }
    #let %value: addr = #call program_eval_value_environment(
      %unit, %source, %caller, %caller_arguments,
      %environment, %value_argument
    )
    #if #ne(#call eval_status(%value), 0) { #return %value }
    #store %value,
      #lea(base=%arguments, idx=%index, scale=8, offset=0)
    %index: #bits<64> = #add(%index, 1)
    #let %argument_end: addr = #call program_value_expression_end(
      %source, %value_argument
    )
    #let %separator: addr = #call raw_node_next(%argument_end)
    #if #call raw_is_nil(%separator) { #break evaluate_arguments }
    %value_argument: addr = #call raw_node_next(%separator)
    #continue evaluate_arguments
  }
  #let %cached: addr = #call program_eval_cache_lookup(
    %unit, %target, %arguments, %count
  )
  #if #call program_unit_cache_hit(%unit) {
    #return %cached
  }
  #let %evaluated: addr = #call program_eval_function(
    %unit, %target, %arguments
  )
  #if #eq(#call eval_status(%evaluated), 0) {
    #call program_eval_cache_store(
      %unit, %target, %arguments, %count, %evaluated
    )
  }
  #return %evaluated
}

#proc program_eval_call(
  addr %unit, addr %source, addr %caller, addr %caller_arguments,
  addr %callee, addr %group
) -> addr {
  #let %environment: addr = #call program_unit_meta_environment(%unit)
  #if #eq(#call program_function_is_nil(%caller), 0) {
    #let %caller_environment: addr =
      #call program_function_environment(%caller)
    #if #eq(#call raw_is_nil(%caller_environment), 0) {
      %environment: addr = %caller_environment
    }
  }
  #return #call program_eval_call_environment(
    %unit, %source, %caller, %caller_arguments,
    %callee, %group, %environment
  )
}

#proc program_eval_consteval_group_direct(
  addr %unit, addr %source, addr %group
) -> addr {
  #let %first: addr = #call raw_node_first(%group)
  #let %next: addr = #call raw_node_next(%first)
  #if #eq(#call raw_node_kind(%next), 2) {
    #if #eq(#call raw_node_delimiter(%next), 40) {
      #return #call program_eval_call(
        %unit, %source, #call program_nil(), #call program_nil(),
        %first, %next
      )
    }
  }
  #return #call eval_group(%source, %group)
}

// All compile-time execution crosses the LAIN-IR #eval boundary here.  The
// evaluator body remains an ordinary L1 routine so it can share the existing
// Meta data structures; the block is the explicit phase boundary used by the
// compiler when invoking it.
#proc program_eval_consteval_group(
  addr %unit, addr %source, addr %group
) -> addr {
  #let %result: addr = #eval {
    #return #call program_eval_consteval_group_direct(
      %unit, %source, %group
    )
  }
  #return %result
}
