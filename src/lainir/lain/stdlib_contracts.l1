// Compiler-core declarations for semantic procedures implemented by the
// bootstrap standard library.  Keeping these declarations in one small file
// makes the split explicit and gives every core pass the same ABI signatures.

#extern #proc program_import_argument(
  #addr %source, #addr %let_node
) -> #addr;
#extern #proc program_import_name_start(
  #addr %source, #addr %argument
) -> #bits<64>;
#extern #proc program_import_name_length(
  #addr %source, #addr %argument, #bits<64> %name_start
) -> #bits<64>;
#extern #proc program_collect_module(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %group,
  #addr %environment
) -> #bits<32>;
#extern #proc program_collect_source(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %root
) -> #bits<32>;
#extern #proc program_prebind_top_level_modules(
  #addr %unit, #addr %environment, #addr %source, #addr %root
) -> #unit;
#extern #proc program_collect_types_group(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %group
) -> #bits<32>;
#extern #proc program_collect_types(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %root
) -> #bits<32>;
#extern #proc program_collect(#addr %source, #addr %root) -> #addr;

#extern #proc program_type_width(#addr %source, #addr %node) -> #bits<64>;
#extern #proc program_type_is_address(#addr %source, #addr %node) -> #bits<1>;
#extern #proc program_type_valid(#addr %source, #addr %node) -> #bits<1>;
#extern #proc program_type_width_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<64>;
#extern #proc program_type_valid_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<1>;
#extern #proc program_type_is_address_in_unit(
  #addr %unit, #addr %source, #addr %node
) -> #bits<1>;
#extern #proc program_is_type_binding(#addr %source, #addr %let_node) -> #bits<1>;
#extern #proc program_type_binding_value(#addr %source, #addr %let_node) -> #addr;
#extern #proc program_type_value_is_std_constructor(
  #addr %source, #addr %value
) -> #bits<1>;
#extern #proc program_type_value_is_constructor(
  #addr %source, #addr %value
) -> #bits<1>;
#extern #proc program_collect_type_candidate(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %let_node
) -> #bits<32>;
#extern #proc program_register_local_type(
  #addr %unit, #addr %source, #bits<64> %source_index, #addr %let_node
) -> #bits<32>;
#extern #proc program_type_end(#addr %source, #addr %node) -> #addr;
#extern #proc meta_lookup_type_binding(
  #addr %environment, #addr %source, #addr %node
) -> #addr;
#extern #proc meta_lookup_first_type_value(#addr %environment) -> #addr;
#extern #proc meta_lookup_concrete_type_value(
  #addr %environment, #addr %source
) -> #addr;
#extern #proc meta_lookup_type_parameter_value(#addr %environment) -> #addr;
#extern #proc meta_function_type_value(
  #addr %environment, #addr %source, #addr %type
) -> #addr;

#extern #proc program_record_field_name_matches(
  #addr %field_source, #addr %field, #addr %node_source, #addr %node
) -> #bits<1>;
#extern #proc program_record_field_for_node(
  #addr %node_source, #addr %record_source, #addr %binding, #addr %node
) -> #addr;
#extern #proc program_record_field_type(#addr %source, #addr %field) -> #addr;
#extern #proc program_record_field_offset(
  #addr %node_source, #addr %record_source, #addr %binding, #addr %node
) -> #bits<64>;
#extern #proc program_record_descriptor_for_field(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_meta_type_for_field(
  #addr %unit, #addr %source, #addr %function, #addr %type
) -> #addr;
#extern #proc program_record_binding_for_field(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_source_for_field(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_type_for_field(
  #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_type_for_nested_ufcs(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_meta_type_for_nested_ufcs(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_type_for_ufcs_field(
  #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_literal_group(#addr %source, #addr %node) -> #addr;
#extern #proc program_is_record_literal(#addr %source, #addr %node) -> #bits<1>;
#extern #proc program_record_group_for_binding(
  #addr %source, #addr %binding
) -> #addr;
#extern #proc program_record_binding_for_literal(
  #addr %unit, #addr %source, #addr %node
) -> #addr;
#extern #proc program_record_source_for_literal(
  #addr %unit, #addr %source, #addr %node
) -> #addr;
#extern #proc program_record_meta_type_for_literal(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_binding_for_literal_in_function(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_source_for_literal_in_function(
  #addr %unit, #addr %source, #addr %function, #addr %node
) -> #addr;
#extern #proc program_record_size(
  #addr %record_source, #addr %binding
) -> #bits<64>;
#extern #proc program_record_literal_has_field(
  #addr %group_source, #addr %group, #addr %wanted_source, #addr %wanted
) -> #bits<1>;
#extern #proc program_record_literal_has_prior_field(
  #addr %source, #addr %group, #addr %target
) -> #bits<1>;
#extern #proc program_record_field_start(
  #addr %source, #addr %node
) -> #bits<64>;
#extern #proc program_record_field_length(
  #addr %source, #addr %node
) -> #bits<64>;
#extern #proc program_record_binding_scan_group(
  #addr %source, #addr %group, #addr %wanted_source, #addr %wanted
) -> #addr;
#extern #proc program_find_record_type_by_scan(
  #addr %unit, #addr %source, #addr %node
) -> #addr;
