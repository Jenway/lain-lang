// Unified Lain frontend driver.
//
// RawAst, meta, compile-time evaluation, and workspace resolution remain
// separate libraries.  This entry only schedules them and records their
// results in one deterministic artifact; it does not teach the RawAst parser
// any Lain keywords.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.release-pages(addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc raw_parse(addr %source, addr %tokens) -> addr;
#extern #proc raw_is_nil(addr %node) -> i1;
#extern #proc meta_record_group(addr %source, addr %root) -> addr;
#extern #proc meta_record_build(addr %source, addr %root) -> addr;
#extern #proc meta_record_dump(addr %source, addr %root) -> #unit;
#extern #proc module_group(addr %source, addr %root) -> addr;
#extern #proc meta_module_build(addr %source, addr %root) -> addr;
#extern #proc meta_module_dump(addr %source, addr %root) -> #unit;
#extern #proc eval_consteval_group(addr %source, addr %root) -> addr;
#extern #proc eval_status(addr %result) -> i32;
#extern #proc eval_value(addr %result) -> i64;
#extern #proc meta_write_decimal(i64 %value) -> #unit;

#extern #proc workspace_sorted_indices() -> addr;
#extern #proc workspace_cache_build() -> addr;
#extern #proc workspace_cache_source(addr %cache, i64 %index) -> addr;
#extern #proc workspace_cache_root(addr %cache, i64 %index) -> addr;
#extern #proc workspace_cache_imports(addr %cache, i64 %index) -> i64;
#extern #proc workspace_cache_resolved_import_count(addr %cache, i64 %index) -> i64;
#extern #proc workspace_cache_has_cycle(addr %cache, i64 %index) -> i1;
#extern #proc workspace_cache_write_module(addr %cache, i64 %index) -> #unit;

#proc driver_write_eval(addr %result) -> #unit {
  #if #eq(#call eval_status(%result), 0) {
    #call bootstrap.artifact-write-literal("(eval ")
    #call meta_write_decimal(#call eval_value(%result))
    #call bootstrap.artifact-write-byte(41)
  } else {
    #call bootstrap.artifact-write-literal("(error ")
    #call meta_write_decimal(
      #zext[#bits<64>](#call eval_status(%result))
    )
    #call bootstrap.artifact-write-byte(41)
  }
  #call bootstrap.artifact-write-byte(10)
  #return
}

#proc driver_write_semantics(addr %cache, i64 %index) -> #unit {
  #let %source: addr = #call workspace_cache_source(%cache, %index)
  #let %root: addr = #call workspace_cache_root(%cache, %index)
  #let %module: addr = #call module_group(%source, %root)
  #if #call raw_is_nil(%module) {
    #call bootstrap.artifact-write-byte(10)
  } else {
    #call bootstrap.artifact-write-literal("\n  ")
    #call meta_module_dump(%source, %root)
  }
  #let %record: addr = #call meta_record_group(%source, %root)
  #if #call raw_is_nil(%record) {
    #call bootstrap.artifact-write-byte(10)
  } else {
    #call bootstrap.artifact-write-literal("\n  ")
    #call meta_record_dump(%source, %root)
  }
  #let %result: addr = #call eval_consteval_group(%source, %root)
  #if #ne(#call eval_status(%result), 3100) {
    #call bootstrap.artifact-write-literal("  ")
    #call driver_write_eval(%result)
  }
  #return
}

#proc driver_module_diagnostic(addr %cache, i64 %index) -> i32 {
  #let %source: addr = #call workspace_cache_source(%cache, %index)
  #let %root: addr = #call workspace_cache_root(%cache, %index)
  #let %imports: i64 = #call workspace_cache_imports(%cache, %index)
  #let %resolved: i64 = #call workspace_cache_resolved_import_count(%cache, %index)
  #if #gt(#sub(%imports, %resolved), 0) {
    #return 4101
  }
  #if #call workspace_cache_has_cycle(%cache, %index) { #return 4103 }
  #let %module: addr = #call module_group(%source, %root)
  #if #eq(#call raw_is_nil(%module), 0) {
    #let %module_descriptor: addr = #call meta_module_build(%source, %root)
    #let %module_status: i32 = #load[i32](
      #lea(base=%module_descriptor, idx=0, scale=0, offset=48)
    )
    #if #ne(%module_status, 0) { #return %module_status }
  }
  #let %record: addr = #call meta_record_group(%source, %root)
  #if #eq(#call raw_is_nil(%record), 0) {
    #let %type: addr = #call meta_record_build(%source, %root)
    #let %meta_status: i32 = #load[i32](
      #lea(base=%type, idx=0, scale=0, offset=64)
    )
    #if #ne(%meta_status, 0) { #return %meta_status }
  }
  #let %result: addr = #call eval_consteval_group(%source, %root)
  #let %eval_status_value: i32 = #call eval_status(%result)
  #if #ne(%eval_status_value, 3100) {
    #if #ne(%eval_status_value, 0) { #return %eval_status_value }
  }
  #return 0
}

#proc lain_compile_dump() -> i32 {
  #let %count: i64 = #call bootstrap.source-count()
  #let %cache: addr = #call workspace_cache_build()
  #let %order: addr = #call workspace_sorted_indices()
  #call bootstrap.artifact-begin()
  #call bootstrap.artifact-write-literal("(lain ")
  #call meta_write_decimal(%count)
  #let %status: i32 = 0
  #let %rank: i64 = 0
  #loop modules {
    #if #ge(%rank, %count) { #break modules }
    #let %index: i64 = #load[i64](
      #lea(base=%order, idx=%rank, scale=8, offset=0)
    )
    #call workspace_cache_write_module(%cache, %index)
    #call driver_write_semantics(%cache, %index)
    #let %module_status: i32 = #call driver_module_diagnostic(%cache, %index)
    #if #eq(%status, 0) {
      #if #ne(%module_status, 0) {
        %status: i32 = %module_status
      }
    }
    #call bootstrap.release-pages(
      #call workspace_cache_source(%cache, %index)
    )
    %rank: i64 = #add(%rank, 1)
    #continue modules
  }
  #call bootstrap.artifact-write-literal(")\n")
  #call bootstrap.artifact-finish()
  #return %status
}
