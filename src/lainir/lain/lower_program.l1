}

// Constant descriptor:
//   name start/length @0/@8, value @16, diagnostic @24,
//   owning source @32, next @40.
#proc program_constant_new(
  addr %source, addr %name, i64 %value, i32 %status
) -> addr {
  #let %constant: addr = #call bootstrap.allocate-pages(48)
  #let %nil: addr = #call program_nil()
  #store #call raw_node_start(%name),
    #lea(base=%constant, idx=0, scale=0, offset=0)
  #store #call raw_node_length(%name),
    #lea(base=%constant, idx=0, scale=0, offset=8)
  #store %value, #lea(base=%constant, idx=0, scale=0, offset=16)
  #store %status, #lea(base=%constant, idx=0, scale=0, offset=24)
  #store %source, #lea(base=%constant, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%constant, idx=0, scale=0, offset=40)
  #return %constant
}

#proc program_constant_source(addr %constant) -> addr {
  #return #load[addr](#lea(base=%constant, idx=0, scale=0, offset=32))
}

#proc program_constant_value(addr %constant) -> i64 {
  #return #load[i64](#lea(base=%constant, idx=0, scale=0, offset=16))
}

#proc program_constant_status(addr %constant) -> i32 {
  #return #load[i32](#lea(base=%constant, idx=0, scale=0, offset=24))
}

// The lexer keeps a qualified name such as `math.add` in one atom.  Namespace
// lookup is a Meta concern; these helpers expose the final member span to the
// first physical lowering slice without changing RawAst.
#proc program_name_start(addr %source, addr %node) -> i64 {
  #let %data: addr = #call tool_source_data(%source)
  #let %start: i64 = #call raw_node_start(%node)
  #let %length: i64 = #call raw_node_length(%node)
  #let %index: i64 = 0
  #let %result: i64 = %start
  #loop members {
    #if #ge(%index, %length) { #break members }
    #if #eq(
      #call tool_byte_at(%data, #add(%start, %index)), 46
    ) {
      %result: i64 = #add(#add(%start, %index), 1)
    }
    %index: i64 = #add(%index, 1)
    #continue members
  }
  #return %result
}

#proc program_name_length(addr %source, addr %node) -> i64 {
  #return #sub(
    #add(#call raw_node_start(%node), #call raw_node_length(%node)),
    #call program_name_start(%source, %node)
  )
}

#proc program_name_matches_type_node(
  addr %source, addr %type, addr %node
) -> i1 {
  #let %name_start: i64 = #call program_name_start(%source, %node)
  #let %name_length: i64 = #call program_name_length(%source, %node)
  #if #ne(
    #load[i64](#lea(base=%type, idx=0, scale=0, offset=8)),
    %name_length
  ) { #return 0 }
  #let %type_source: addr = #call program_type_source(%type)
  #let %type_data: addr = #call tool_source_data(%type_source)
  #let %node_data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %name_length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %type_data,
        #add(#load[i64](#lea(base=%type, idx=0, scale=0, offset=0)), %index)
      ),
      #call tool_byte_at(%node_data, #add(%name_start, %index))
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_sources_equal(addr %left, addr %right) -> i1 {
  #if #ne(
    #call tool_source_length(%left), #call tool_source_length(%right)
  ) { #return 0 }
  #let %left_data: addr = #call tool_source_data(%left)
  #let %right_data: addr = #call tool_source_data(%right)
  #let %index: i64 = 0
  #loop bytes {
    #if #ge(%index, #call tool_source_length(%left)) { #return 1 }
    #if #ne(
      #call tool_byte_at(%left_data, %index),
      #call tool_byte_at(%right_data, %index)
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
}

#proc program_find_type(addr %unit, addr %source, addr %node) -> addr {
  #let %type: addr = #call program_unit_types(%unit)
  #loop types {
    #if #call raw_is_nil(%type) { #return %type }
    #if #call program_name_matches_type_node(%source, %type, %node) {
      #if #call program_sources_equal(
        #call program_type_source(%type), %source
      ) {
        #return %type
      }
    }
    %type: addr = #load[addr](#lea(base=%type, idx=0, scale=0, offset=40))
    #continue types
  }
  #return #call program_nil()
}

#proc program_find_type_in_source(
  addr %unit, addr %source, i64 %source_index, addr %node
) -> addr {
  #let %type: addr = #call program_unit_types(%unit)
  #loop types {
    #if #call raw_is_nil(%type) { #return %type }
    #if #eq(
      #call program_type_source_index(%type), %source_index
    ) {
      #if #call program_sources_equal(
        #call program_type_source(%type), %source
      ) {
        #if #call program_name_matches_type_node(%source, %type, %node) {
          #return %type
        }
      }
    }
    %type: addr = #load[addr](#lea(base=%type, idx=0, scale=0, offset=40))
    #continue types
  }
  #return %type
}

#proc program_find_type_by_binding(addr %unit, addr %binding) -> addr {
  #let %type: addr = #call program_unit_types(%unit)
  #loop types {
    #if #call raw_is_nil(%type) { #return %type }
    #if #eq(
      #call program_type_binding(%type), %binding
    ) { #return %type }
    %type: addr = #load[addr](#lea(base=%type, idx=0, scale=0, offset=40))
    #continue types
  }
}

#proc program_find_type_final_member(
  addr %unit, addr %source, addr %node
) -> addr {
  #let %name_start: i64 = #call program_name_start(%source, %node)
  #let %name_length: i64 = #call program_name_length(%source, %node)
  #let %data: addr = #call tool_source_data(%source)
  #let %type: addr = #call program_unit_types(%unit)
  #loop types {
    #if #call raw_is_nil(%type) { #return %type }
    #if #eq(
      #load[i64](#lea(base=%type, idx=0, scale=0, offset=8)),
      %name_length
    ) {
      #let %type_source: addr = #call program_type_source(%type)
      #let %type_data: addr = #call tool_source_data(%type_source)
      #let %index: i64 = 0
      #let %same: i1 = 1
      #loop compare {
        #if #ge(%index, %name_length) { #break compare }
        #if #ne(
          #call tool_byte_at(
            %type_data,
            #add(
              #load[i64](#lea(base=%type, idx=0, scale=0, offset=0)),
              %index
            )
          ),
          #call tool_byte_at(%data, #add(%name_start, %index))
        ) {
          %same: i1 = 0
          #break compare
        }
        %index: i64 = #add(%index, 1)
        #continue compare
      }
      #if %same { #return %type }
    }
    %type: addr = #load[addr](#lea(base=%type, idx=0, scale=0, offset=40))
    #continue types
  }
}

#proc program_name_matches_constant_node(
  addr %source, addr %constant, addr %node
) -> i1 {
  #let %name_start: i64 = #call program_name_start(%source, %node)
  #let %name_length: i64 = #call program_name_length(%source, %node)
  #if #ne(
    #load[i64](#lea(base=%constant, idx=0, scale=0, offset=8)),
    %name_length
  ) { #return 0 }
  #let %constant_source: addr = #call program_constant_source(%constant)
  #let %constant_data: addr = #call tool_source_data(%constant_source)
  #let %node_data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %name_length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %constant_data,
        #add(
          #load[i64](#lea(base=%constant, idx=0, scale=0, offset=0)),
          %index
        )
      ),
      #call tool_byte_at(
        %node_data, #add(%name_start, %index)
      )
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_find_constant(
  addr %unit, addr %source, addr %node
) -> addr {
  #let %constant: addr = #call program_unit_constants(%unit)
  #loop constants {
    #if #call raw_is_nil(%constant) { #return %constant }
    #if #call program_name_matches_constant_node(
      %source, %constant, %node
    ) { #return %constant }
    %constant: addr = #load[addr](
      #lea(base=%constant, idx=0, scale=0, offset=40)
    )
    #continue constants
  }
  #return %constant
}

#proc program_append_constant(addr %unit, addr %constant) -> #unit {
  #let %head: addr = #call program_unit_constants(%unit)
  #if #call raw_is_nil(%head) {
    #call program_set_unit_constants(%unit, %constant, %constant)
  } else {
    #let %tail: addr = #load[addr](
      #lea(base=%unit, idx=0, scale=0, offset=72)
    )
    #store %constant, #lea(base=%tail, idx=0, scale=0, offset=40)
    #call program_set_unit_constants(%unit, %head, %constant)
  }
  #return
}

#proc program_name_matches_text(
  addr %source, addr %function, addr %text, i64 %length
) -> i1 {
  #if #ne(#call program_function_name_length(%function), %length) {
    #return 0
  }
  #let %function_source: addr = #call program_function_source(%function)
  #let %data: addr = #call tool_source_data(%function_source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %data, #add(#call program_function_name_start(%function), %index)
      ),
      #call tool_byte_at(%text, %index)
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_name_matches_node(
  addr %source, addr %function, addr %node
) -> i1 {
  #let %name_start: i64 = #call program_name_start(%source, %node)
  #let %name_length: i64 = #call program_name_length(%source, %node)
  #if #ne(%name_length, #call program_function_name_length(%function)) {
    #return 0
  }
  #let %function_source: addr = #call program_function_source(%function)
  #let %node_data: addr = #call tool_source_data(%source)
  #let %data: addr = #call tool_source_data(%function_source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %name_length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %data, #add(#call program_function_name_start(%function), %index)
      ),
      #call tool_byte_at(
        %node_data, #add(%name_start, %index)
      )
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_find_function(
  addr %unit, addr %source, addr %node
) -> addr {
  #let %function: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%function) { #return %function }
    #if #call program_name_matches_node(%source, %function, %node) {
      #return %function
    }
    %function: addr = #load[addr](
      #lea(base=%function, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
  #return %function
}

// A Meta namespace stores the exact function descriptor produced by a
// specialization.  Several Vec specializations still have the same source
// name (`push`), so a name-only lookup can select a sibling specialization.
// Keep the namespace environment key in the lookup: methods captured by the
// same Namespace environment belong to the same concrete type.
#proc program_find_function_in_environment(
  addr %unit, addr %source, addr %name, addr %environment
) -> addr {
  #let %wanted_key: i64 = #call program_function_environment_key(
    %environment
  )
  #let %final_name: addr = #call raw_node_new(
    1, 0,
    #call program_name_start(%source, %name),
    #call program_name_length(%source, %name),
    3
  )
  #let %function: addr = #call program_unit_head(%unit)
  #let %scan_steps: i64 = 0
  #loop functions {
    #if #call program_function_is_nil(%function) {
      #return %function
    }
    #if #ge(%scan_steps, 100000) { #return #call program_nil() }
    %scan_steps: i64 = #add(%scan_steps, 1)
    #if #call program_name_matches_node(%source, %function, %final_name) {
      #let %candidate_environment: addr =
        #call program_function_environment(%function)
      #if #eq(
        #call program_function_specialization_key(%function),
        %wanted_key
      ) {
        #return %function
      }
    }
    %function: addr = #load[addr](
      #lea(base=%function, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
}

#proc program_find_function_in_source(
  addr %unit, i64 %source_index, addr %source, addr %node
) -> addr {
  #let %function: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%function) { #return %function }
    #if #eq(
      #call program_function_source_index(%function), %source_index
    ) {
      #if #call program_name_matches_node(%source, %function, %node) {
        #return %function
      }
    }
    %function: addr = #load[addr](
      #lea(base=%function, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
  #return %function
}

#proc program_find_ufcs_function(
  addr %unit, addr %source, addr %caller, addr %node
) -> addr {
  // Compile-time module calls have no runtime caller descriptor.  UFCS
  // lookup needs the caller's expression type, so a null caller must skip
  // this path before the record/type helpers dereference it.
  #if #call program_function_is_nil(%caller) { #return #call program_nil() }
  // Upper-case dotted paths name compile-time modules (`Syntax.node`).
  // They do not have a runtime receiver argument and must never enter UFCS.
  #if #call program_is_upper_module_path(%source, %node) {
    #return #call program_nil()
  }
  // The lexer may represent `value.push` as `value` followed by a single
  // `.push` atom.  Normalize that shape before inspecting the receiver type;
  // otherwise the prefix looks empty and the call can fall through to an
  // unrelated global `push` specialization.
  #let %path_node: addr = #call program_call_path_node(%source, %node)
  #let %prefix_length: i64 = #call program_name_prefix_length(
    %source, %path_node
  )
  #if #eq(%prefix_length, 0) { #return #call program_nil() }
  // Upper-case prefixes conventionally name compile-time type/module values
  // (`ByteVector.push`, `Memory.String.new`).  Their member is resolved by
  // the Meta path; UFCS must wait for a lower-case runtime receiver.
  #let %node_data: addr = #call tool_source_data(%source)
  #let %first_byte: i8 = #call tool_byte_at(
    %node_data, #call raw_node_start(%path_node)
  )
  #if #ge(#zext[#bits<32>](%first_byte), 65) {
    #if #le(#zext[#bits<32>](%first_byte), 90) {
      #return #call program_nil()
    }
  }
  // Resolve the receiver's concrete type value before the legacy AST-only
  // field walk.  A factory-produced type carries the exact Namespace for its
  // specialization (`Vec(SourceUnit)`); looking up `get` there prevents a
  // width-only fallback from selecting an unrelated `get` such as
  // `Span(Unit).get`.
  #let %receiver_node: addr = #call program_ufcs_receiver_node(
    %source, %path_node
  )
  #if #eq(#call raw_is_nil(%receiver_node), 0) {
    #let %receiver_type_value: addr =
      #call program_record_meta_type_for_nested_ufcs(
        %unit, %source, %caller, %receiver_node
      )
    #if #eq(#call meta_value_kind(%receiver_type_value), 4) {
      #let %receiver_namespace: addr = #call meta_value_environment(
        %receiver_type_value
      )
      #let %receiver_namespace_value: addr = #call meta_env_lookup_text(
        %receiver_namespace, %source, "Namespace", 9
      )
      #if #eq(#call meta_value_kind(%receiver_namespace_value), 2) {
        %receiver_namespace: addr = #call meta_value_environment(
          %receiver_namespace_value
        )
      }
      #let %receiver_member_start: i64 = #call program_name_start(
        %source, %path_node
      )
      #let %receiver_member_length: i64 = #call program_name_length(
        %source, %path_node
      )
      #let %receiver_member_value: addr = #call meta_env_lookup_span(
        %receiver_namespace, %source,
        %receiver_member_start, %receiver_member_length
      )
      #if #eq(#call meta_value_kind(%receiver_member_value), 3) {
        // The Meta member payload is the descriptor created while this
        // namespace was collected.  It already belongs to this concrete
        // factory instance, so prefer it over a name/key scan through the
        // physical list.
        #let %receiver_member_target: addr = #call meta_value_payload(
          %receiver_member_value
        )
        #if #eq(#call program_function_is_nil(%receiver_member_target), 0) {
          #call program_append_function_if_missing(
            %unit, %receiver_member_target
          )
          #return %receiver_member_target
        }
        #let %receiver_member_environment: addr = #call meta_value_environment(
          %receiver_member_value
        )
        #let %receiver_scoped_target: addr = #call program_nil()
        #if #eq(#call meta_env_is_nil(%receiver_member_environment), 0) {
          %receiver_scoped_target: addr = #call program_find_function_in_environment(
            %unit, %source, %path_node, %receiver_member_environment
          )
        }
        #if #eq(#call program_function_is_nil(%receiver_scoped_target), 0) {
          #return %receiver_scoped_target
        }
      }
    }
  }
  #let %field_type: addr = #call program_record_type_for_ufcs_field(
    %source, %caller, %path_node
  )
  #if #call raw_is_nil(%field_type) {
    // A path with two member separators reaches a method through an
    // intermediate record field (`effects.keys.get`).  The ordinary field
    // query asks for `get` on the outer record and can therefore return nil;
    // use the nested walker to recover the receiver's concrete type.
    %field_type: addr = #call program_record_type_for_nested_ufcs(
      %unit, %source, %caller, %path_node
    )
    #if #call raw_is_nil(%field_type) { #return #call program_nil() }
  }
  #let %type_value: addr = #call program_record_meta_type_for_field(
    %unit, %source, %caller, %field_type
  )
  #if #call raw_is_nil(%type_value) {
    #if #call program_unit_writing(%unit) {
      #return #call program_find_function(
        %unit, %source, #call program_operand_name(%source, %node)
      )
    }
    #return #call program_nil()
  }
  #let %namespace: addr = #call meta_value_environment(%type_value)
  #if #call meta_env_is_nil(%namespace) {
    #if #call program_unit_writing(%unit) {
      #return #call program_find_function(
        %unit, %source, #call program_operand_name(%source, %node)
      )
    }
    #return #call program_nil()
  }
  // Record types created inside factories keep the factory environment as
  // their lexical namespace.  Vec/String expose their methods through a
  // sibling `Namespace` Module; follow that convention before looking up the
  // requested member so an exported type alias retains its concrete methods.
  #let %namespace_module: addr = #call meta_env_lookup_text(
    %namespace, %source, "Namespace", 9
  )
  #if #ne(#call meta_value_kind(%namespace_module), 0) {
    #if #eq(#call meta_value_kind(%namespace_module), 2) {
      %namespace: addr = #call meta_value_environment(%namespace_module)
    }
  }
  #let %member_length: i64 = #call program_name_length(%source, %path_node)
  %member_start: i64 = #call program_name_start(%source, %path_node)
  #let %member: addr = #call meta_env_lookup_span(
    %namespace, %source, %member_start, %member_length
  )
  #if #eq(#call meta_value_kind(%member), 0) {
    #let %member_text: addr = #lea(
      base=#call tool_source_data(%source),
      idx=%member_start, scale=1, offset=0
    )
    %member: addr = #call meta_env_lookup_text(
      %namespace, %source, %member_text, %member_length
    )
  }
  #if #eq(#call meta_value_kind(%member), 0) {
    #if #call program_unit_writing(%unit) {
      #return #call program_find_function(
        %unit, %source, #call program_operand_name(%source, %node)
      )
    }
    #return #call program_nil()
  }
  #if #ne(#call meta_value_kind(%member), 3) {
    #if #call program_unit_writing(%unit) {
      #return #call program_find_function(
        %unit, %source, #call program_operand_name(%source, %node)
      )
    }
    #return #call program_nil()
  }
  // The member function value carries the closure environment created for
  // this factory specialization.  Resolve the physical descriptor with that
  // environment; the type namespace alone is shared by sibling Vec(T)
  // instances and would select the first same-spelled method.
  #let %member_environment: addr = #call meta_value_environment(%member)
  #let %member_scoped_target: addr = #call program_nil()
  #if #eq(#call meta_env_is_nil(%member_environment), 0) {
    %member_scoped_target: addr = #call program_find_function_in_environment(
      %unit, %source,
      #call program_operand_name(%source, %path_node),
      %member_environment
    )
  }
  #if #eq(#call program_function_is_nil(%member_scoped_target), 0) {
    #return %member_scoped_target
  }
  #let %member_target: addr = #call meta_value_payload(%member)
  #if #eq(#call program_function_is_nil(%member_target), 0) {
    #return %member_target
  }
  #let %scoped_target: addr = #call program_nil()
  #if #eq(#call meta_env_is_nil(%namespace), 0) {
    %scoped_target: addr = #call program_find_function_in_environment(
      %unit, %source,
      #call program_operand_name(%source, %path_node),
      %namespace
    )
  }
  #if #eq(#call program_function_is_nil(%scoped_target), 0) {
    #return %scoped_target
  }
  #return #call meta_value_payload(%member)
}

#proc program_call_path_node(addr %source, addr %node) -> addr {
  #let %next: addr = #call raw_node_next(%node)
  #if #call program_is_dot_member(%source, %next) {
    #return #call program_field_path_node(%source, %node)
  }
  #return %node
}

// Return the physical width represented by a specialized function parameter.
// A zero result means an address-valued parameter.  Generic `T` parameters
// are resolved through the candidate function's captured environment, so
// overload selection can distinguish `Vec(i32).push` from `Vec(Record).push`.
#proc program_function_parameter_width(
  addr %unit, addr %function, addr %type
) -> i64 {
  #let %source: addr = #call program_function_source(%function)
  #if #call meta_type_is_address(%source, %type) { #return 0 }
  #let %value: addr = #call meta_function_type_value(
    #call program_function_environment(%function), %source, %type
  )
  #if #eq(#call meta_value_kind(%value), 4) {
    #let %concrete: addr = #call meta_value_payload(%value)
    #let %concrete_source: addr = #call meta_value_source(%value)
    #if #call raw_is_nil(%concrete_source) {
      %concrete_source: addr = %source
    }
    #if #call meta_atom_equal(%concrete_source, %concrete, "let", 3) {
      %concrete: addr = #call program_type_binding_value(
        %concrete_source, %concrete
      )
    }
    #let %span_width: i64 = #call meta_builtin_width_span(
      %concrete_source,
      #call raw_node_start(%concrete),
      #call raw_node_length(%concrete)
    )
    #if #ne(%span_width, 0) { #return %span_width }
    #let %width: i64 = #call program_type_width(
      %concrete_source, %concrete
    )
    #if #ne(%width, 0) { #return %width }
    #if #call program_type_is_address_in_unit(
      %unit, %concrete_source, %concrete
    ) { #return 0 }
  }
  #let %width: i64 = #call program_type_width_in_unit(
    %unit, %source, %type
  )
  #if #ne(%width, 0) { #return %width }
  #if #call program_type_is_address_in_unit(%unit, %source, %type) {
    #return 0
  }
  #return #sub(0, 1)
}

// Decide whether a value is physically an address.  This deliberately uses
// a dotted field's own type instead of the receiver's record type: `values`
// and `values.length` have the same receiver, but only the former is an
// address while the latter is a bits<64> field.
#proc program_value_is_address(
  addr %unit, addr %source, addr %function, addr %node
) -> i1 {
  #if #call meta_atom_equal(%source, %node, "&", 1) { #return 1 }
  // A direct call can return an address even when it has no record field
  // spelling, for example `Allocation.address(values.storage)`.
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #eq(#call raw_is_nil(%group), 0) {
    #let %target: addr = #call program_find_function_for_caller(
      %unit, %source, %function, %node
    )
    #if #eq(#call program_function_is_nil(%target), 0) {
      #let %target_source: addr = #call program_function_source(%target)
      #let %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
      #if #call meta_type_is_address(%target_source, %return_type) {
        #return 1
      }
      #if #ne(
        #call program_type_width_in_unit(
          %unit, %target_source, %return_type
        ),
        0
      ) { #return 0 }
      #if #call program_type_is_address_in_unit(
        %unit, %target_source, %return_type
      ) { #return 1 }
      #return 0
    }
  }
  // The RawAst node at an expression start is only the first atom.  Extend
  // it through the complete operand before looking up `value.field`: using
  // just `value` would classify every field of an address-backed record as
  // an address, including scalar fields such as `value.span.start`.
  #let %operand_end: addr = #call program_operand_end_source(%source, %node)
  #let %operand: addr = %node
  #if #eq(#call raw_is_nil(%operand_end), 0) {
    %operand: addr = #call raw_node_new(
      1, 0, #call raw_node_start(%node),
      #sub(
        #add(#call raw_node_start(%operand_end),
          #call raw_node_length(%operand_end)),
        #call raw_node_start(%node)
      ), 3
    )
  }
  #let %prefix: i64 = #call program_name_prefix_length(%source, %operand)
  #if #gt(%prefix, 0) {
    // The one-field resolver below is exact for `values.data`.  Nested paths
    // need the full Meta environment of every intermediate record; until the
    // shared projection type-result helper owns that traversal, treat them
    // as scalar here rather than producing an invalid #lea for
    // `value.span.start`.
    #let %dot_count: i64 = 0
    #let %dot_index: i64 = 0
    #let %operand_data: addr = #call tool_source_data(%source)
    #loop dots {
      #if #ge(%dot_index, #call raw_node_length(%operand)) { #break dots }
      #if #eq(
        #call tool_byte_at(
          %operand_data,
          #add(#call raw_node_start(%operand), %dot_index)
        ),
        46
      ) { %dot_count: i64 = #add(%dot_count, 1) }
      %dot_index: i64 = #add(%dot_index, 1)
      #continue dots
    }
    #if #ge(%dot_count, 2) { #return 0 }
    #let %field_type: addr = #call program_record_type_for_ufcs_field(
      %source, %function, %operand
    )
    #if #eq(#call raw_is_nil(%field_type), 0) {
      #if #call meta_type_is_address(%source, %field_type) { #return 1 }
      #if #ne(
        #call program_type_width_in_unit(%unit, %source, %field_type), 0
      ) { #return 0 }
      #if #call program_type_is_address_in_unit(
        %unit, %source, %field_type
      ) { #return 1 }
      #return 0
    }
  }
  #if #eq(%prefix, 0) {
    #let %type: addr = #call program_record_type_for_field(
      %source, %function, %operand
    )
    #if #eq(#call raw_is_nil(%type), 0) {
      #if #call meta_type_is_address(%source, %type) { #return 1 }
      #if #ne(
        #call program_type_width_in_unit(%unit, %source, %type), 0
      ) { #return 0 }
      #if #call program_type_is_address_in_unit(
        %unit, %source, %type
      ) { #return 1 }
    }
    // A bare parameter whose declared type is an address also classifies
    // as an address (for example `literal: addr` plus byte offset), so
    // `literal + index` lowers through #lea instead of integer #add.
    #let %param_type: addr = #call program_param_type_for_field(
      %source, %function, %operand
    )
    #if #eq(#call raw_is_nil(%param_type), 0) {
      #if #call meta_type_is_address(%source, %param_type) { #return 1 }
    }
  }
  #return 0
}

// Infer a call argument's physical width from the caller's parameter/local
// type.  The matcher intentionally returns -1 when the expression is too
// complex to infer; that keeps existing Meta lookup behavior for those calls.
#proc program_call_argument_width(
  addr %unit, addr %source, addr %caller, addr %argument
) -> i64 {
  #if #call meta_atom_equal(%source, %argument, "&", 1) { #return 0 }
  #if #call meta_atom_equal(%source, %argument, "*", 1) {
    #let %inner: addr = #call raw_node_next(%argument)
    #return #call program_call_argument_width(
      %unit, %source, %caller, %inner
    )
  }
  #if #call program_is_decimal(%source, %argument) { #return 64 }
  #if #call program_is_boolean(%source, %argument) { #return 1 }
  // `std::load_bits(width, address)` carries its physical width in the
  // first argument even though it has no source-level declaration to query.
  #if #call program_is_std_intrinsic_call(
    %source, %argument, "load_bits", 9
  ) {
    #let %group: addr = #call program_operand_group(%source, %argument)
    #let %width_node: addr = #call raw_node_first(%group)
    #let %width_result: addr = #call program_parse_decimal(
      %source, %width_node
    )
    #return #call program_result_value(%width_result)
  }
  // The argument node can span an infix expression (`byte & 255`).  Resolve
  // the type from its first operand, which is the value passed through the
  // expression and preserves the concrete generic width.
  #let %operand_end: addr = #call program_operand_end_source(
    %source, %argument
  )
  #let %operand_node: addr = %argument
  #if #eq(#call raw_is_nil(%operand_end), 0) {
    %operand_node: addr = #call raw_node_new(
      1, 0, #call raw_node_start(%argument),
      #sub(
        #add(#call raw_node_start(%operand_end),
          #call raw_node_length(%operand_end)),
        #call raw_node_start(%argument)
      ), 3
    )
  }
  #let %type: addr = #call program_record_type_for_field(
    %source, %caller, %operand_node
  )
  #if #call raw_is_nil(%type) { #return #sub(0, 1) }
  #if #call meta_type_is_address(%source, %type) { #return 0 }
  #let %width: i64 = #call program_type_width_in_unit(
    %unit, %source, %type
  )
  #if #ne(%width, 0) { #return %width }
  #if #call program_type_is_address_in_unit(%unit, %source, %type) {
    #return 0
  }
  #return #sub(0, 1)
}

// Compare two resolved Meta type values by their defining AST identity.  A
// factory can create several value records for the same type binding, so
// pointer equality alone is too strict; source span plus payload covers both
// shared bindings and cloned values.
#proc program_meta_type_value_matches(addr %left, addr %right) -> i1 {
  #if #ne(#call meta_value_kind(%left), 4) { #return 0 }
  #if #ne(#call meta_value_kind(%right), 4) { #return 0 }
  #if #eq(
    #call meta_value_source(%left), #call meta_value_source(%right)
  ) {
    #if #eq(
      #call meta_value_start(%left), #call meta_value_start(%right)
    ) {
      #if #eq(
        #call meta_value_length(%left), #call meta_value_length(%right)
      ) { #return 1 }
    }
  }
  #return #eq(
    #call meta_value_payload(%left), #call meta_value_payload(%right)
  )
}

// Resolve the Meta type value represented by a call argument.  UFCS receiver
// paths such as `workspace.syntax.units` need the nested record walker; a
// plain local/parameter is handled by the ordinary field lookup.
#proc program_call_argument_type_value(
  addr %unit, addr %source, addr %caller, addr %argument
) -> addr {
  // A dotted receiver is a record projection.  Resolve it through the
  // defining record layout first; a whole-path environment lookup can select
  // a sibling Vec(T) specialization with the same physical ABI.
  #let %caller_environment: addr = #call program_function_environment(%caller)
  #let %dotted: i1 = #gt(
    #call program_name_prefix_length(%source, %argument), 0
  )
  #if %dotted {
    // Preserve the type value while walking the receiver path.  This keeps
    // the `T = SourceUnit` binding from the Vec specialization attached to
    // `workspace.sources` before the call resolver examines `get`.
    #let %receiver_nested_value: addr =
      #call program_record_meta_type_for_nested_ufcs(
        %unit, %source, %caller, %argument
      )
    #if #eq(#call meta_value_kind(%receiver_nested_value), 4) {
      #return %receiver_nested_value
    }
    #let %direct_type: addr = #call program_record_type_for_ufcs_field(
      %source, %caller, %argument
    )
    #if #eq(#call raw_is_nil(%direct_type), 0) {
      #let %direct_value: addr = #call program_record_meta_type_for_field(
        %unit, %source, %caller, %direct_type
      )
      #if #eq(#call meta_value_kind(%direct_value), 4) {
        #return %direct_value
      }
    }
    #let %nested_type: addr = #call program_record_type_for_nested_ufcs(
      %unit, %source, %caller, %argument
    )
    #if #eq(#call raw_is_nil(%nested_type), 0) {
      #let %nested_value: addr = #call program_record_meta_type_for_field(
        %unit, %source, %caller, %nested_type
      )
      #if #eq(#call meta_value_kind(%nested_value), 4) {
        #return %nested_value
      }
    }
  } else {
    #if #eq(#call raw_is_nil(%caller_environment), 0) {
      #let %direct: addr = #call meta_env_lookup_path(
        %caller_environment, %source, %argument
      )
      #if #eq(#call meta_value_kind(%direct), 4) { #return %direct }
    }
  }
  // The receiver itself may be a reference (`&Workspace`/`&mut Workspace`).
  // Its type binding is stored under the pointee name, while the physical
  // source expression keeps the leading `&` only in the declaration.
  #let %argument_type: addr = #call program_record_type_for_field(
    %source, %caller, %argument
  )
  #if #eq(#call raw_is_nil(%argument_type), 0) {
    #if #call meta_type_is_address(%source, %argument_type) {
      %argument_type: addr = #call raw_node_next(%argument_type)
      #if #call meta_atom_equal(%source, %argument_type, "mut", 3) {
        %argument_type: addr = #call raw_node_next(%argument_type)
      }
    }
    #let %argument_value: addr = #call program_record_meta_type_for_field(
      %unit, %source, %caller, %argument_type
    )
    #if #eq(#call meta_value_kind(%argument_value), 4) {
      #return %argument_value
    }
  }
  #let %type: addr = #call program_record_type_for_ufcs_field(
    %source, %caller, %argument
  )
  #if #call raw_is_nil(%type) {
    %type: addr = #call program_record_type_for_nested_ufcs(
      %unit, %source, %caller, %argument
    )
  }
  #if #call raw_is_nil(%type) { #return #call meta_value_nil() }
  #if #call meta_type_is_address(%source, %type) {
    %type: addr = #call raw_node_next(%type)
    #if #call meta_atom_equal(%source, %type, "mut", 3) {
      %type: addr = #call raw_node_next(%type)
    }
  }
  #return #call program_record_meta_type_for_field(
    %unit, %source, %caller, %type
  )
}


// Return the implicit receiver span for a UFCS call.  For
// `workspace.sources.get(i)`, the receiver is `workspace.sources`; the
// explicit call group contains only `i`.
#proc program_ufcs_receiver_node(addr %source, addr %node) -> addr {
  #let %path: addr = #call program_call_path_node(%source, %node)
  #let %start: i64 = #call raw_node_start(%path)
  #let %member_start: i64 = #call program_name_start(%source, %path)
  #if #le(%member_start, %start) { #return #call program_nil() }
  #return #call raw_node_new(
    1, 0, %start, #sub(#sub(%member_start, %start), 1), 3
  )
}

#proc program_function_matches_call_types(
  addr %unit, addr %source, addr %caller, addr %function, addr %node,
  i1 %has_receiver
) -> i1 {
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #call raw_is_nil(%group) { #return 0 }
  #let %argument: addr = #call raw_node_first(%group)
  #let %index: i64 = 0
  #if %has_receiver { %index: i64 = 1 }
  #loop arguments {
    #if #call raw_is_nil(%argument) {
      #return #eq(%index, #call program_function_count(%function))
    }
    #let %expected_type: addr = #call program_call_argument_type(
      %source, %function, %index
    )
    #let %expected_width: i64 = #call program_function_parameter_width(
      %unit, %function, %expected_type
    )
    #let %actual_width: i64 = #call program_call_argument_width(
      %unit, %source, %caller, %argument
    )
    #if #ne(%expected_width, #sub(0, 1)) {
      #if #eq(%actual_width, #sub(0, 1)) { #return 0 }
      #if #ne(%expected_width, %actual_width) { #return 0 }
    }
    %index: i64 = #add(%index, 1)
    #let %argument_end: addr = #call program_value_expression_end(
      %source, %argument
    )
    #let %separator: addr = #call raw_node_next(%argument_end)
    #if #call raw_is_nil(%separator) { #break arguments }
    %argument: addr = #call raw_node_next(%separator)
    #continue arguments
  }
  #return #eq(%index, #call program_function_count(%function))
}

#proc program_find_type_matching_call(
  addr %unit, addr %source, addr %caller, addr %wanted, addr %node,
  i1 %has_receiver
) -> addr {
  #let %candidate: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%candidate) {
      #return #call program_nil()
    }
    #if #call program_function_name_matches_function(%wanted, %candidate) {
      #if #call program_function_matches_call_types(
        %unit, %source, %caller, %candidate, %node, %has_receiver
      ) { #return %candidate }
    }
    %candidate: addr = #load[addr](
      #lea(base=%candidate, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
}

#proc program_find_function_for_caller(
  addr %unit, addr %source, addr %caller, addr %node
) -> addr {
  // Uniform function-call syntax: `value.member(args)` resolves the member
  // through the value's nominal type and supplies `value` as argument zero.
  // Module/type namespaces keep their existing qualified lookup path.
  #let %path_node: addr = #call program_call_path_node(%source, %node)
  #let %environment: addr = #call program_unit_meta_environment(%unit)
  #if #eq(#call program_function_is_nil(%caller), 0) {
    #let %caller_environment: addr = #call program_function_environment(
      %caller
    )
    #if #eq(#call raw_is_nil(%caller_environment), 0) {
      %environment: addr = %caller_environment
    }
  }
  // A physical specialization keeps the lexical Meta environment it had
  // when the factory was evaluated.  The descriptor may be temporarily
  // rebound while compile-time evaluation walks its body; use the saved
  // environment as the source of captured names such as `ByteVector`.
  #let %saved_environment: addr = #call program_nil()
  #if #eq(#call program_function_is_nil(%caller), 0) {
    %saved_environment: addr = #call program_function_environment(%caller)
    #if #eq(#call raw_is_nil(%saved_environment), 0) {
      %environment: addr = %saved_environment
    }
  }
  #let %ufcs: addr = #call program_nil()
  #let %prefix_length: i64 = #call program_name_prefix_length(
    %source, %path_node
  )
  #let %skip_ufcs: i1 = 0
  // A lower-case name can still be a compile-time module alias (`math.add`).
  // The old check only recognized upper-case module paths, so this form was
  // sent through UFCS and lost its qualified Meta target.  Inspect the
  // receiver prefix in the caller environment before attempting runtime
  // receiver lookup.
  #if #eq(%prefix_length, 0) {
  } else {
    #let %receiver: addr = #call program_ufcs_receiver_node(
      %source, %path_node
    )
  #if #eq(#call raw_is_nil(%receiver), 0) {
    #let %receiver_value: addr = #call meta_env_lookup_path(
      %environment, %source, %receiver
    )
      #if #eq(#call raw_is_nil(%receiver_value), 0) {
        // A type value with an attached namespace uses the same qualified
        // Meta lookup as a module value.  It has no runtime receiver, so
        // sending it through UFCS makes `ByteVector.new()` look like a field
        // access on the enclosing physical function and loses the specialized
        // target.  Keep both module and type namespaces on the Meta path.
        #if #eq(#call meta_value_kind(%receiver_value), 2) {
          %skip_ufcs: i1 = 1
        } else {
        #if #eq(#call meta_value_kind(%receiver_value), 4) {
          %skip_ufcs: i1 = 1
        }
        }
      }
    }
  }
  // Calls inside a specialized factory function carry the factory's lexical
  // environment on the physical function descriptor.  The ordinary caller
  // environment can be replaced by the temporary evaluator environment, so
  // retry the receiver lookup against the descriptor's saved environment.
  #if #eq(%skip_ufcs, 0) {
    #if #eq(#call program_function_is_nil(%caller), 0) {
      #let %saved_environment_2: addr = #call program_function_environment(
        %caller
      )
      #if #eq(#call raw_is_nil(%saved_environment_2), 0) {
        #let %saved_receiver: addr = #call program_ufcs_receiver_node(
          %source, %path_node
        )
        #if #eq(#call raw_is_nil(%saved_receiver), 0) {
          #let %saved_value: addr = #call meta_env_lookup_path(
            %saved_environment_2, %source, %saved_receiver
          )
          #if #eq(#call meta_value_kind(%saved_value), 4) {
            %skip_ufcs: i1 = 1
          }
        }
      }
    }
  }
  #if #call program_is_upper_module_path(%source, %path_node) {
    #let %node_data: addr = #call tool_source_data(%source)
    #let %first_byte: i8 = #call tool_byte_at(
      %node_data, #call raw_node_start(%path_node)
    )
    #if #ge(#zext[#bits<32>](%first_byte), 65) {
      #if #le(#zext[#bits<32>](%first_byte), 90) {
        %skip_ufcs: i1 = 1
      }
    }
  }
  #if #eq(%skip_ufcs, 0) {
    %ufcs: addr = #call program_find_ufcs_function(
      %unit, %source, %caller, %path_node
    )
  }
  #if #eq(#call program_function_is_nil(%ufcs), 0) {
    // UFCS lookup already used the receiver's concrete Meta namespace.  Do
    // not scan all same-named physical functions here: `Vec(T).get` has the
    // same `(addr, usize) -> addr` ABI for every T, so a width-only scan would
    // replace the receiver's specialization with the first sibling.
    #return %ufcs
  }
  // A type-qualified member (`ByteVector.new`) has no runtime receiver, so it
  // deliberately skipped UFCS above.  Resolve the final member directly in
  // the namespace carried by the type value.  The complete dotted path lookup
  // cannot do this reliably when the type name is a captured factory binding:
  // the first segment belongs to the caller environment, while the member
  // belongs to the type's namespace environment.
  #if #eq(%skip_ufcs, 1) {
    #let %receiver: addr = #call program_ufcs_receiver_node(
      %source, %path_node
    )
    #if #eq(#call raw_is_nil(%receiver), 0) {
      #let %receiver_value: addr = #call meta_env_lookup_path(
        %environment, %source, %receiver
      )
      #if #eq(#call meta_value_kind(%receiver_value), 4) {
        #let %type_environment: addr = #call meta_value_environment(
          %receiver_value
        )
        // Some factory paths retain the factory lexical environment on the
        // type value and expose the actual member table as `Namespace`.
        // Normalize both representations before looking up the member.
        #let %namespace_value: addr = #call meta_env_lookup_text(
          %type_environment, %source, "Namespace", 9
        )
        #if #eq(#call meta_value_kind(%namespace_value), 2) {
          %type_environment: addr = #call meta_value_environment(
            %namespace_value
          )
        }
        #let %member_start: i64 = #call program_name_start(
          %source, %path_node
        )
        #let %member_length: i64 = #call program_name_length(
          %source, %path_node
        )
        #let %member_value: addr = #call meta_env_lookup_span(
          %type_environment, %source, %member_start, %member_length
        )
        #if #eq(#call meta_value_kind(%member_value), 3) {
          #let %target: addr = #call meta_value_payload(%member_value)
          #if #eq(#call program_function_is_nil(%target), 0) {
            #call program_append_function_if_missing(%unit, %target)
            #return %target
          }
          #let %member_environment: addr = #call meta_value_environment(
            %member_value
          )
          #let %member_node: addr = #call raw_node_new(
            1, 0, %member_start, %member_length, 3
          )
          #let %scoped_target: addr =
            #call program_find_function_in_environment(
              %unit, %source, %member_node, %member_environment
            )
          #if #eq(#call program_function_is_nil(%scoped_target), 0) {
            #call program_append_function_if_missing(%unit, %scoped_target)
            #return %scoped_target
          }
        }
      }
    }
  }
  #let %meta_value: addr = #call meta_env_lookup_path(
    %environment, %source, %path_node
  )
  #if #eq(#call meta_value_kind(%meta_value), 0) {
    #call program_unit_set_path_kind(%unit, 0)
  } else {
    #call program_unit_set_path_kind(
      %unit, #call meta_value_kind(%meta_value)
    )
  }
  #if #ne(#call meta_value_kind(%meta_value), 0) {
    #if #eq(#call meta_value_kind(%meta_value), 3) {
      #let %target: addr = #call meta_value_payload(%meta_value)
      // The Meta payload is the exact descriptor exported by the resolved
      // module. Keep it intact here. Re-scanning physical functions by name
      // can select the forwarding wrapper itself when two modules export a
      // member named `compile`.
      // Runtime record-field receivers have no module member payload at Meta
      // lookup time.  Their physical descriptor still needs the ABI-width
      // scan used for sibling specializations such as `sources.get`.
      #let %match_generic_receiver: i1 = 0
      #if #ne(#call program_name_prefix_length(%source, %path_node), 0) {
        #let %match_receiver: addr = #call program_ufcs_receiver_node(
          %source, %path_node
        )
        #if #eq(#call raw_is_nil(%match_receiver), 0) {
          #let %match_value: addr = #call meta_env_lookup_path(
            %environment, %source, %match_receiver
          )
          #if #eq(#call meta_value_kind(%match_value), 0) {
            %match_generic_receiver: i1 = 1
          }
        }
      }
      #if %match_generic_receiver {
        #let %matching_target: addr = #call program_find_type_matching_call(
          %unit, %source, %caller, %target, %path_node, 0
        )
        #if #eq(#call program_function_is_nil(%matching_target), 0) {
          %target: addr = %matching_target
        }
      }
      // The descriptor already owns the environment captured when the Meta
      // function value was created.  Do not mutate it during a later lookup:
      // labels include the specialization key, so changing the environment
      // after one procedure has been emitted would make its call label differ
      // from the emitted procedure label.
      #call program_append_function_if_missing(%unit, %target)
      #return %target
    }
  }
  // A qualified name has no safe global fallback.  Falling back to a
  // same-spelled member from another module turns a missing namespace value
  // into a misleading arity error (for example `l1_ir.Model` becoming
  // `memory_model.Model`).
  #if #ne(#call program_name_prefix_length(%source, %path_node), 0) {
    #return #call program_nil()
  }
  #if #call program_function_is_nil(%caller) {
    #return #call program_find_function(%unit, %source, %node)
  }
  #let %local: addr = #call program_find_function_in_source(
    %unit, #call program_function_source_index(%caller), %source, %node
  )
  #if #eq(#call program_function_is_nil(%local), 0) { #return %local }
  #return #call program_find_function(%unit, %source, %node)
}

#proc program_function_name_matches_function(
  addr %left, addr %right
) -> i1 {
  #if #ne(
    #call program_function_name_length(%left),
    #call program_function_name_length(%right)
  ) { #return 0 }
  #let %left_source: addr = #call program_function_source(%left)
  #let %right_source: addr = #call program_function_source(%right)
  #let %left_data: addr = #call tool_source_data(%left_source)
  #let %right_data: addr = #call tool_source_data(%right_source)
  #let %length: i64 = #call program_function_name_length(%left)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %left_data,
        #add(#call program_function_name_start(%left), %index)
      ),
      #call tool_byte_at(
        %right_data,
        #add(#call program_function_name_start(%right), %index)
      )
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_function_name_count(
  addr %unit, addr %function
) -> i64 {
  #let %count: i64 = 0
  #let %candidate: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%candidate) { #break functions }
    #if #call program_function_name_matches_function(%function, %candidate) {
      %count: i64 = #add(%count, 1)
    }
    %candidate: addr = #load[addr](
      #lea(base=%candidate, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
  #return %count
}

#proc program_function_same(
  addr %left, addr %right
) -> i1 {
  #if #ne(
    #call program_function_source_index(%left),
    #call program_function_source_index(%right)
  ) { #return 0 }
  #if #ne(
    #call program_function_name_start(%left),
    #call program_function_name_start(%right)
  ) { #return 0 }
  #if #ne(
    #call program_function_name_length(%left),
    #call program_function_name_length(%right)
  ) { #return 0 }
  #if #ne(
    #call raw_node_start(#call program_function_body(%left)),
    #call raw_node_start(#call program_function_body(%right))
  ) { #return 0 }
  // A generic factory reuses the same RawAst body for every specialization.
  // The captured environment key distinguishes those physical closures;
  // pointer equality is deliberately unavailable at the LAIN-IR level.
  #if #ne(
    #call program_function_specialization_key(%left),
    #call program_function_specialization_key(%right)
  ) { #return 0 }
  #return 1
}

#proc program_function_name_rank(
  addr %unit, addr %function
) -> i64 {
  #let %rank: i64 = 0
  #let %candidate: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%candidate) { #return %rank }
    #if #call program_function_same(%candidate, %function) {
      #return %rank
    }
    #if #call program_function_name_matches_function(
      %candidate, %function
    ) {
      %rank: i64 = #add(%rank, 1)
    }
    %candidate: addr = #load[addr](
      #lea(base=%candidate, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
}

#proc program_write_function_label(
  addr %unit, addr %function
) -> #unit {
  #call program_append_function_if_missing(%unit, %function)
  #let %source: addr = #call program_function_source(%function)
  #let %source_index: i64 = #call program_function_source_index(%function)
  // The previous implementation scanned the complete physical function
  // list twice for every label.  The compiler closure is large, so emission
  // became quadratic before the first bytes were written.  `main` keeps its
  // public entry name.  Other labels use the source ordinal and name offset,
  // values already stored in the descriptor, so label generation is O(1).
  #if #call program_name_matches_text(%source, %function, "main", 4) {
    #call bootstrap.artifact-write-literal("main")
    #return
  }
  // `compiler_compile` is the second public entry (bootstrap compiler mode).
  // Keep its name so a Lain-written lainc can expose the same entry point.
  #if #call program_name_matches_text(
    %source, %function, "compiler_compile", 16
  ) {
    #call bootstrap.artifact-write-literal("compiler_compile")
    #return
  }
  // External declarations carrying @foreign link_name use that name as the
  // extern label, so calls resolve through the host capability table.
  // The link slot is only consulted for externals; other functions never
  // touch it.
  #if #call program_function_is_external(%source, %function) {
    #let %link_start: i64 = #load[i64](
      #lea(base=%function, idx=0, scale=0, offset=112)
    )
    #if #ne(%link_start, 0) {
      #let %data: addr = #call tool_source_data(%source)
      #let %scan: i64 = %link_start
      #loop link_name_bytes {
        #if #eq(#call tool_byte_at(%data, %scan), 34) {
          #break link_name_bytes
        }
        #call bootstrap.artifact-write-byte(
          #call tool_byte_at(%data, %scan)
        )
        %scan: i64 = #add(%scan, 1)
        #continue link_name_bytes
      }
      #return
    }
  }
  #call bootstrap.artifact-write-literal("f")
  #call meta_write_decimal(%source_index)
  #call bootstrap.artifact-write-byte(95)
  #call meta_write_decimal(#call program_function_name_start(%function))
  #call bootstrap.artifact-write-byte(95)
  // The source offset alone is shared by every Meta specialization of a
  // factory function.  Include the specialization key so distinct physical
  // closures cannot collide at the LAIN-IR procedure-label level.
  #let %label_key: i64 = #call program_function_specialization_key(%function)
  #if #lt(%label_key, 0) {
    %label_key: i64 = #sub(0, %label_key)
  }
  #call meta_write_decimal(%label_key)
  #call bootstrap.artifact-write-byte(95)
  #call meta_write_span(
    %source, #call program_function_name_start(%function),
    #call program_function_name_length(%function)
  )
  #return
}

#proc program_find_function_text(
  addr %unit, addr %source, addr %text, i64 %length
) -> addr {
  #let %function: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%function) { #return %function }
    #if #call program_name_matches_text(%source, %function, %text, %length) {
      #return %function
    }
    %function: addr = #load[addr](
      #lea(base=%function, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
  #return %function
}

#proc program_is_decimal(addr %source, addr %node) -> i1 {
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #if #eq(#call raw_node_length(%node), 0) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop digits {
    #if #ge(%index, #call raw_node_length(%node)) { #break digits }
    #let %byte: i8 = #call tool_byte_at(
      %data, #add(#call raw_node_start(%node), %index)
    )
    #if #lt(%byte, 48) { #return 0 }
    #if #gt(%byte, 57) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue digits
  }
  #return 1
}

#proc program_is_boolean(addr %source, addr %node) -> i1 {
  #if #call meta_atom_equal(%source, %node, "true", 4) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "false", 5) { #return 1 }
  #return 0
}

#proc program_is_string(addr %source, addr %node) -> i1 {
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #if #eq(#call raw_node_length(%node), 0) { #return 0 }
  #return #eq(
    #call tool_byte_at(
      #call tool_source_data(%source), #call raw_node_start(%node)
    ),
    34
  )
}

#proc program_boolean_value(addr %source, addr %node) -> i64 {
  #if #call meta_atom_equal(%source, %node, "true", 4) { #return 1 }
  #return 0
}

#proc program_parse_decimal(addr %source, addr %node) -> addr {
  #if #call program_is_decimal(%source, %node) {
    #let %data: addr = #call tool_source_data(%source)
    #let %value: i64 = 0
    #let %index: i64 = 0
    #loop digits {
      #if #ge(%index, #call raw_node_length(%node)) { #break digits }
      #let %byte: i8 = #call tool_byte_at(
        %data, #add(#call raw_node_start(%node), %index)
      )
      %value: i64 = #add(#mul(%value, 10), #sub(%byte, 48))
      %index: i64 = #add(%index, 1)
      #continue digits
    }
    #let %result: addr = #call bootstrap.allocate-pages(16)
    #store 0, #lea(base=%result, idx=0, scale=0, offset=0)
    #store %value, #lea(base=%result, idx=0, scale=0, offset=8)
    #return %result
  }
  #let %result: addr = #call bootstrap.allocate-pages(16)
  #store 5105, #lea(base=%result, idx=0, scale=0, offset=0)
  #store 0, #lea(base=%result, idx=0, scale=0, offset=8)
  #return %result
}

#proc program_result_status(addr %result) -> i32 {
  #return #load[i32](#lea(base=%result, idx=0, scale=0, offset=0))
}

#proc program_result_value(addr %result) -> i64 {
  #return #load[i64](#lea(base=%result, idx=0, scale=0, offset=8))
}

#proc program_parse_params(
  addr %unit, addr %source, addr %function, addr %params
) -> i32 {
  #let %child: addr = #call raw_node_first(%params)
  #let %count: i64 = 0
  #loop parameters {
    #if #call raw_is_nil(%child) { #break parameters }
    #if #ne(#call raw_node_kind(%child), 1) { #return 5103 }
    #let %colon: addr = #call raw_node_next(%child)
    #let %type: addr = #call raw_node_next(%colon)
    #if #call raw_is_nil(%colon) { #return 5103 }
    #if #call raw_is_nil(%type) { #return 5103 }
    #if #eq(#call meta_atom_equal(%source, %colon, ":", 1), 0) {
      #return 5103
    }
    #if #eq(#call program_type_valid_in_unit(%unit, %source, %type), 0) {
      #return 5104
    }
    %count: i64 = #add(%count, 1)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #let %separator: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%separator) { #break parameters }
    #if #eq(#call meta_atom_equal(%source, %separator, ",", 1), 0) {
      #return 5103
    }
    %child: addr = #call raw_node_next(%separator)
    #if #call raw_is_nil(%child) { #break parameters }
    #continue parameters
  }
  #store %count, #lea(base=%function, idx=0, scale=0, offset=56)
  #return 0
}

#proc program_function_runtime_params(
  addr %source, addr %candidate
) -> addr {
  #if #eq(#call meta_atom_equal(%source, %candidate, "<", 1), 0) {
    #return %candidate
  }
  #let %node: addr = #call raw_node_next(%candidate)
  #loop generic_params {
    #if #call raw_is_nil(%node) { #return %candidate }
    #if #call meta_atom_equal(%source, %node, ">", 1) {
      #return #call raw_node_next(%node)
    }
    %node: addr = #call raw_node_next(%node)
    #continue generic_params
  }
}

#proc program_parse_function(
  addr %unit, addr %source, i64 %source_index, addr %let_node
) -> addr {
  #let %name: addr = #call raw_node_next(%let_node)
  #if #call raw_is_nil(%name) { #return #call program_nil() }
  #let %equals: addr = #call raw_node_next(%name)
  #let %constructor: addr = #call raw_node_next(%equals)
  #let %colon1: addr = #call raw_node_next(%constructor)
  #let %colon2: addr = #call raw_node_next(%colon1)
  #let %func: addr = #call raw_node_next(%colon2)
  #let %params: addr = #call program_function_runtime_params(
    %source, #call raw_node_next(%func)
  )
  #let %arrow1: addr = #call raw_node_next(%params)
  #let %arrow2: addr = #call raw_node_next(%arrow1)
  #let %return_type: addr = #call raw_node_next(%arrow2)
  #let %return_type_end: addr = #call program_type_end(
    %source, %return_type
  )
  #let %body_candidate: addr = #call raw_node_next(%return_type_end)
  #let %body: addr = #call program_function_body_start(
    %source, %body_candidate
  )
  #let %function: addr = #call program_function_new(
    %source, %name, %params, %return_type, %body, %source_index
  )
  #if #call raw_is_nil(%equals) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %equals, "=", 1), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%constructor) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %constructor, "std", 3), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%colon1) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%colon2) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%func) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %colon1, ":", 1), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %colon2, ":", 1), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %func, "func", 4), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%params) { #call program_set_function_status(%function, 5103) #return %function }
  #if #ne(#call raw_node_delimiter(%params), 40) { #call program_set_function_status(%function, 5103) #return %function }
  #if #call raw_is_nil(%arrow1) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%arrow2) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %arrow1, "-", 1), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #eq(#call meta_atom_equal(%source, %arrow2, ">", 1), 0) { #call program_set_function_status(%function, 5102) #return %function }
  #if #call raw_is_nil(%return_type) { #call program_set_function_status(%function, 5104) #return %function }
  #if #call raw_is_nil(%body) { #call program_set_function_status(%function, 5102) #return %function }
  // Parse parameters before the external check: a body-less std::func is
  // still a declaration with a real parameter list that call-site arity
  // checks must see.
  #let %parameter_status: i32 = #call program_parse_params(%unit, %source, %function, %params)
  #if #ne(%parameter_status, 0) { #call program_set_function_status(%function, %parameter_status) }
  #if #call meta_atom_equal(%source, %body, ";", 1) {
    #return %function
  }
  #if #eq(#call program_type_valid_in_unit(%unit, %source, %return_type), 0) { #call program_set_function_status(%function, 5104) #return %function }
  #if #ne(#call raw_node_delimiter(%body), 123) { #call program_set_function_status(%function, 5102) #return %function }
  #return %function
}

#proc program_function_body_start(
  addr %source, addr %candidate
) -> addr {
  #if #call raw_is_nil(%candidate) { #return %candidate }
  #if #eq(#call meta_atom_equal(%source, %candidate, "!", 1), 0) {
    #return %candidate
  }
  #let %effects: addr = #call raw_node_next(%candidate)
  #if #call raw_is_nil(%effects) { #return %candidate }
  #if #ne(#call raw_node_kind(%effects), 2) { #return %candidate }
  #if #ne(#call raw_node_delimiter(%effects), 123) { #return %candidate }
  #return #call raw_node_next(%effects)
}

#proc program_is_function_declaration(
  addr %source, addr %let_node
) -> i1 {
  #let %node: addr = #call raw_node_next(%let_node)
  #loop declaration {
    #if #call raw_is_nil(%node) { #return 0 }
    #if #call meta_atom_equal(%source, %node, "func", 4) {
      #return 1
    }
    #if #call meta_atom_equal(%source, %node, ";", 1) {
      #return 0
    }
    // A grouped initializer ends this declaration.  Without this boundary,
    // a record/module initializer with no trailing semicolon keeps scanning
    // into the next top-level declaration and can mistake its `func` token
    // for the current declaration's constructor.
    #if #eq(#call raw_node_kind(%node), 2) {
      #return 0
    }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
}

#proc program_is_consteval_declaration(
  addr %source, addr %let_node
) -> i1 {
  #let %node: addr = #call raw_node_next(%let_node)
  #loop declaration {
    #if #call raw_is_nil(%node) { #return 0 }
    #if #call meta_atom_equal(%source, %node, "consteval", 9) {
      #return 1
    }
    #if #call meta_atom_equal(%source, %node, ";", 1) { #return 0 }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
}

#proc program_parse_constant(
  addr %unit, addr %source, addr %let_node
) -> addr {
  #let %name: addr = #call raw_node_next(%let_node)
  #let %value: i64 = 0
  #let %status: i32 = 3101
  #let %node: addr = #call raw_node_next(%name)
  #loop declaration {
    #if #call raw_is_nil(%node) { #break declaration }
    #if #call meta_atom_equal(%source, %node, "consteval", 9) {
      #let %group: addr = #call raw_node_next(%node)
      #if #call raw_is_nil(%group) {
        %status: i32 = 3101
      } else {
        #if #ne(#call raw_node_kind(%group), 2) {
          %status: i32 = 3101
        } else {
          #if #ne(#call raw_node_delimiter(%group), 40) {
            %status: i32 = 3101
          } else {
            #let %result: addr = #call program_eval_consteval_group(
              %unit, %source, %group
            )
            %status: i32 = #call eval_status(%result)
            #if #eq(%status, 0) {
              %value: i64 = #call eval_value(%result)
            }
          }
        }
      }
      #break declaration
    }
    #if #call meta_atom_equal(%source, %node, ";", 1) {
      #break declaration
    }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
  #return #call program_constant_new(%source, %name, %value, %status)
}

#proc program_is_literal_declaration(
  addr %source, addr %let_node
) -> i1 {
  #let %node: addr = #call raw_node_next(%let_node)
  #loop declaration {
    #if #call raw_is_nil(%node) { #return 0 }
    #if #call meta_atom_equal(%source, %node, "=", 1) {
      #let %value_node: addr = #call raw_node_next(%node)
      #if #call program_is_decimal(%source, %value_node) {
        #let %tail: addr = #call raw_node_next(%value_node)
        #if #call raw_is_nil(%tail) {
          #return 1
        }
        #if #call meta_atom_equal(%source, %tail, ";", 1) {
          #return 1
        }
      }
      #return 0
    }
    #if #call meta_atom_equal(%source, %node, ";", 1) { #return 0 }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
}

#proc program_parse_literal_constant(
  addr %source, addr %let_node
) -> addr {
  #let %name: addr = #call raw_node_next(%let_node)
  #let %value: i64 = 0
  #let %status: i32 = 3101
  #let %node: addr = #call raw_node_next(%name)
  #loop declaration {
    #if #call raw_is_nil(%node) { #break declaration }
    #if #call meta_atom_equal(%source, %node, "=", 1) {
      #let %value_node: addr = #call raw_node_next(%node)
      #let %result: addr = #call program_parse_decimal(
        %source, %value_node
      )
      %status: i32 = #call program_result_status(%result)
      #if #eq(%status, 0) {
        %value: i64 = #call program_result_value(%result)
      }
      #break declaration
    }
    #if #call meta_atom_equal(%source, %node, ";", 1) {
      #break declaration
    }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
  #return #call program_constant_new(%source, %name, %value, %status)
}

#proc program_is_meta_binding(
  addr %source, addr %let_node
) -> i1 {
  #if #call program_is_type_binding(%source, %let_node) { #return 1 }
  #let %name: addr = #call raw_node_next(%let_node)
  #let %colon: addr = #call raw_node_next(%name)
  #let %annotation: addr = #call raw_node_next(%colon)
  #if #call meta_atom_equal(%source, %annotation, "Module", 6) {
    #return 1
  }
  #if #call meta_atom_equal(%source, %annotation, "ModuleShape", 11) {
    #return 1
  }
  #return 0
}

#proc program_is_ignored_declaration(
  addr %source, addr %let_node
) -> i1 {
  #if #call program_is_meta_binding(%source, %let_node) { #return 1 }
  #let %node: addr = #call raw_node_next(%let_node)
  #loop declaration {
    #if #call raw_is_nil(%node) { #return 0 }
    #if #call meta_atom_equal(%source, %node, "struct", 6) { #return 1 }
    #if #call meta_atom_equal(%source, %node, "module", 6) { #return 1 }
    #if #call meta_atom_equal(%source, %node, "import", 6) { #return 1 }
    #if #call meta_atom_equal(%source, %node, ";", 1) { #return 0 }
    %node: addr = #call raw_node_next(%node)
    #continue declaration
  }
}

// Keep physical-function de-duplication bounded.  The old implementation
// walked the complete unit function list for every closure that a Meta
// factory materialized.  A compiler-sized source closure turns that into a
// quadratic pass.  The bucket key is only a filter; program_function_same
// still performs the complete semantic comparison after a collision.
#proc program_hash_mix(i64 %hash, i64 %value) -> i64 {
  #let %normalized: i64 = %value
  #if #lt(%normalized, 0) {
    %normalized: i64 = #sub(0, %normalized)
  }
  #let %mixed: i64 = #add(#mul(%hash, 131), %normalized)
  #return #sub(
    %mixed,
    #mul(#div(%mixed, 4096), 4096)
  )
}

#proc program_function_hash(addr %function) -> i64 {
  #let %hash: i64 = 0
  %hash: i64 = #call program_hash_mix(
    %hash, #call program_function_source_index(%function)
  )
  %hash: i64 = #call program_hash_mix(
    %hash, #call program_function_name_start(%function)
  )
  %hash: i64 = #call program_hash_mix(
    %hash, #call program_function_name_length(%function)
  )
  %hash: i64 = #call program_hash_mix(
    %hash, #call raw_node_start(#call program_function_body(%function))
  )
  #return %hash
}

#proc program_append_function(addr %unit, addr %function) -> #unit {
  // A closure may have been created while materializing an imported Module.
  // It is not necessarily linked into the current physical unit yet; reset
  // the link before attaching it so the writer cannot follow another unit's
  // list accidentally.
  #store #call program_nil(), #lea(base=%function, idx=0, scale=0, offset=40)
  #store %unit, #lea(base=%function, idx=0, scale=0, offset=72)
  #store 1, #lea(base=%function, idx=0, scale=0, offset=104)
  #let %head: addr = #load[addr](#lea(base=%unit, idx=0, scale=0, offset=0))
  #if #call program_function_is_nil(%head) {
    #store %function, #lea(base=%unit, idx=0, scale=0, offset=0)
  } else {
    #let %tail: addr = #load[addr](#lea(base=%unit, idx=0, scale=0, offset=8))
    #store %function, #lea(base=%tail, idx=0, scale=0, offset=40)
  }
  #store %function, #lea(base=%unit, idx=0, scale=0, offset=8)
  #store #add(
    #load[i64](#lea(base=%unit, idx=0, scale=0, offset=16)), 1
  ), #lea(base=%unit, idx=0, scale=0, offset=16)
  #let %buckets: addr = #call program_unit_function_buckets(%unit)
  #let %bucket: addr = #lea(
    base=%buckets,
    idx=#call program_function_hash(%function),
    scale=8,
    offset=0
  )
  #let %index_entry: addr = #call bootstrap.allocate-pages(16)
  #store %function,
    #lea(base=%index_entry, idx=0, scale=0, offset=0)
  #store #load[addr](%bucket),
    #lea(base=%index_entry, idx=0, scale=0, offset=8)
  #store %index_entry, %bucket
  #return
}

#proc program_unit_has_function(
  addr %unit, addr %function
) -> i1 {
  #let %buckets: addr = #call program_unit_function_buckets(%unit)
  #let %bucket: addr = #lea(
    base=%buckets,
    idx=#call program_function_hash(%function),
    scale=8,
    offset=0
  )
  #let %index_entry: addr = #load[addr](%bucket)
  #loop functions {
    #if #call program_function_index_entry_is_nil(%index_entry) {
      #return 0
    }
    #if #call program_function_same(
      #load[addr](#lea(base=%index_entry, idx=0, scale=0, offset=0)),
      %function
    ) { #return 1 }
    %index_entry: addr = #load[addr](
      #lea(base=%index_entry, idx=0, scale=0, offset=8)
    )
    #continue functions
  }
}

#proc program_append_function_if_missing(
  addr %unit, addr %function
) -> #unit {
  #if #call program_function_is_nil(%function) { #return }
  #if #call program_function_is_linked(%function) { #return }
  #call program_append_function(%unit, %function)
  #return
}

#proc program_materialize_import_target(
  addr %unit, i64 %target, addr %environment
) -> addr {
  #call program_unit_set_meta_import_action(
    %unit, #trunc[i32](#add(3000, %target))
  )
  #call program_unit_set_meta_stage(
    %unit, #trunc[i32](#add(100, %target))
  )
  #call program_unit_set_meta_import_action(
    %unit, #trunc[i32](#add(10000, %target))
  )
  #if #call program_unit_meta_step_inc(%unit) {
    #return #call meta_value_nil()
  }
  #let %materialized: addr = #call program_unit_materialized_modules(%unit)
  #if #call program_unit_has_materialized_modules(%unit) {
    #let %state: i64 = #call program_unit_materialized_state(%unit, %target)
    #call program_unit_set_meta_import_action(
      %unit, #trunc[i32](#add(20000, %state))
    )
    #if #ne(%state, 0) {
      #return #load[addr](
        #lea(base=%materialized, idx=%target, scale=8, offset=0)
      )
    }
    #call program_unit_set_materialized_state(%unit, %target, 1)
    #let %cached: addr = #load[addr](
      #lea(base=%materialized, idx=%target, scale=8, offset=0)
    )
    // Materialized entries are Meta values.  `raw_is_nil` inspects the first
    // byte of a RawAst node and is not a valid test for a page-aligned Meta
    // object; kind zero is the explicit Meta nil marker.
    #if #ne(#call meta_value_kind(%cached), 0) {
      #call program_unit_set_meta_import_action(
        %unit, #trunc[i32](#add(2000, %target))
      )
      #return %cached
    }
  }
  #let %sources: addr = #call program_unit_sources(%unit)
  #let %source: addr = #load[addr](
    #lea(base=%sources, idx=%target, scale=8, offset=0)
  )
  #let %roots: addr = #call program_unit_roots(%unit)
  #let %root: addr = #load[addr](
    #lea(base=%roots, idx=%target, scale=8, offset=0)
  )
  #let %node: addr = #call raw_node_first(%root)
  #loop modules {
    #call program_unit_set_meta_member(%unit, #call raw_node_start(%node))
    #if #call raw_is_nil(%node) {
      #break modules
    }
    #if #call meta_atom_equal(%source, %node, "let", 3) {
      #if #call program_is_module_declaration(%source, %node) {
        #let %name: addr = #call raw_node_next(%node)
        #let %group: addr = #call program_module_group(%source, %node)
        // An imported source owns its lexical module environment.  Reusing
        // the importer's environment here makes the cached module depend on
        // whichever source happened to materialize it first; a later import
        // can then resolve a generic member through the wrong captured Vec
        // specialization.  Keep the cache value independent of the caller
        // and bind the source module name into the caller only as an alias.
        #let %module_environment: addr = #call meta_env_new(
          #call program_unit_meta_environment(%unit)
        )
        #let %module_value: addr = #call meta_value_module(
          %source, %name, %group, %module_environment
        )
        #if #call program_unit_has_materialized_modules(%unit) {
          #store %module_value,
            #lea(base=%materialized, idx=%target, scale=8, offset=0)
        }
        // Keep the shell in the local module environment while collecting.
        // Publish it to the unit cache only after the member collection has
        // completed; a partially collected shell is not a usable import.
        #call meta_env_bind(
          %environment, %source, %name, %module_value
        )
        // Preserve the source module name inside its own body environment so
        // nested declarations can use qualified self references.
        #call meta_env_bind(
          %module_environment, %source, %name, %module_value
        )
        #call program_bind_import_aliases(
          %unit, %source, %target, %root, %module_environment
        )
        #call program_unit_set_collecting_import(%unit, 1)
        #let %status: i32 = #call program_collect_module(
          %unit, %source, %target, %group, %module_environment
        )
        #call program_unit_set_collecting_import(%unit, 0)
        #if #ne(%status, 0) {
          #call program_unit_set_debug_source_index(
            %unit, #call raw_node_start(%node)
          )
          #call program_unit_set_debug_module_kind(%unit, 4354)
        }
        // The source may already have been checked in the main collection
        // pass.  Keep the materialized Module available even if this alias
        // pass observes a diagnostic; the normal unit status will report it
        // after the alias is installed.
        #if #call program_unit_has_materialized_modules(%unit) {
          #store %module_value,
            #lea(base=%materialized, idx=%target, scale=8, offset=0)
          #call program_unit_set_materialized_state(%unit, %target, 2)
        }
        #if #ne(%target, 0) {
          #call program_unit_set_debug_module_kind(%unit, 4356)
        }
        #return %module_value
      }
    }
    %node: addr = #call raw_node_next(%node)
    #continue modules
  }
  // An imported source may expose ordinary top-level declarations without an
  // explicit `std::module` wrapper.  The import alias still denotes a module:
  // give the source its own environment and collect the root declarations into
  // that environment so `math.add` resolves exactly like an explicit module.
  #let %module_environment: addr = #call meta_env_new(
    #call program_unit_meta_environment(%unit)
  )
  // The alias name is owned by the import declaration in the caller.  The
  // imported source itself has no declaration node to use as its module name;
  // the module value only needs a valid source/root anchor here.
  #let %module_name: addr = #call raw_node_first(%root)
  #let %module_value: addr = #call meta_value_module(
    %source, %module_name, %root, %module_environment
  )
  #if #call program_unit_has_materialized_modules(%unit) {
    #store %module_value,
      #lea(base=%materialized, idx=%target, scale=8, offset=0)
  }
  #call program_bind_import_aliases(
    %unit, %source, %target, %root, %module_environment
  )
  #call program_unit_set_collecting_import(%unit, 1)
  #let %status: i32 = #call program_collect_module(
    %unit, %source, %target, %root, %module_environment
  )
  #call program_unit_set_collecting_import(%unit, 0)
  #if #ne(%status, 0) {
    #call program_unit_set_debug_source_index(
      %unit, #call raw_node_start(%module_name)
    )
    #call program_unit_set_debug_module_kind(%unit, 4355)
  }
  #if #call program_unit_has_materialized_modules(%unit) {
    #store %module_value,
      #lea(base=%materialized, idx=%target, scale=8, offset=0)
    #call program_unit_set_materialized_state(%unit, %target, 2)
  }
  #if #ne(%target, 0) {
    #call program_unit_set_debug_module_kind(%unit, 4357)
  }
  #return %module_value
}

#proc program_is_semicolon(addr %source, addr %node) -> i1 {
  #return #call meta_atom_equal(%source, %node, ";", 1)
}

#proc program_is_operator(addr %source, addr %node) -> i1 {
  #if #call meta_atom_equal(%source, %node, "+", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "-", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "*", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "/", 1) { #return 1 }
  #if #call program_is_remainder(%source, %node) { #return 1 }
  #if #call program_is_comparison(%source, %node) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "as", 2) { #return 1 }
  #return 0
}

#proc program_is_remainder(addr %source, addr %node) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_length(%node), 1) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #return #eq(
    #zext[#bits<32>](#call tool_byte_at(%data, #call raw_node_start(%node))),
    37
  )
}

#proc program_is_comparison(addr %source, addr %node) -> i1 {
  #if #call meta_atom_equal(%source, %node, "<", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "<=", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, ">", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, ">=", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "==", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "!=", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "&&", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "||", 2) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "&", 1) { #return 1 }
  #if #call meta_atom_equal(%source, %node, "|", 1) { #return 1 }
  #return 0
}

#proc program_condition_operator_end(
  addr %source, addr %operator
) -> addr {
  #if #call meta_atom_equal(%source, %operator, "&", 1) {
    #let %next: addr = #call raw_node_next(%operator)
    #if #call meta_atom_equal(%source, %next, "&", 1) { #return %next }
  }
  #if #call meta_atom_equal(%source, %operator, "|", 1) {
    #let %next: addr = #call raw_node_next(%operator)
    #if #call meta_atom_equal(%source, %next, "|", 1) { #return %next }
  }
  #return %operator
}

#proc program_value_operator_end(
  addr %source, addr %operator
) -> addr {
  #if #call meta_atom_equal(%source, %operator, "&", 1) {
    #let %next: addr = #call raw_node_next(%operator)
    #if #call meta_atom_equal(%source, %next, "&", 1) {
      #return %next
    }
  }
  #if #call meta_atom_equal(%source, %operator, "|", 1) {
    #let %next: addr = #call raw_node_next(%operator)
    #if #call meta_atom_equal(%source, %next, "|", 1) {
      #return %next
    }
  }
  #return %operator
}

#proc program_condition_is_and(addr %source, addr %operator) -> i1 {
  #if #call meta_atom_equal(%source, %operator, "&&", 2) {
    #return 1
  }
  #if #eq(#call meta_atom_equal(%source, %operator, "&", 1), 0) {
    #return 0
  }
  #return #call meta_atom_equal(
    %source, #call raw_node_next(%operator), "&", 1
  )
}

#proc program_condition_is_or(addr %source, addr %operator) -> i1 {
  #if #call meta_atom_equal(%source, %operator, "||", 2) {
    #return 1
  }
  #if #eq(#call meta_atom_equal(%source, %operator, "|", 1), 0) {
    #return 0
  }
  #return #call meta_atom_equal(
    %source, #call raw_node_next(%operator), "|", 1
  )
}

#proc program_validate_value_expression(
  addr %unit, addr %source, addr %function, addr %left
) -> i32 {
  #let %status: i32 = #call program_validate_operand(
    %unit, %source, %function, %left
  )
  #if #ne(%status, 0) {
    #call program_unit_set_validation_node(%unit, %source, %left)
    #if #eq(#call program_unit_debug_module_kind(%unit), 0) {
      #call program_unit_set_debug_source_index(
        %unit, #call raw_node_start(%left)
      )
      #call program_unit_set_debug_module_kind(%unit, 440)
    }
    #return %status
  }
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator_start: addr = #call raw_node_next(%left_end)
  #let %operator: addr = %operator_start
  #if #call raw_is_nil(%operator) { #return 0 }
  #if #call program_is_semicolon(%source, %operator) { #return 0 }
  #if #call meta_atom_equal(%source, %operator, ",", 1) { #return 0 }
  #if #call program_is_operator(%source, %operator) {
    #let %operator_end: addr = #call program_value_operator_end(
      %source, %operator
    )
    #let %right: addr = #call raw_node_next(%operator_end)
    #if #call raw_is_nil(%right) { #return 5106 }
    #if #call meta_atom_equal(%source, %operator, "as", 2) {
      #if #eq(
        #call program_type_valid_in_unit(%unit, %source, %right),
        0
      ) { #return 5104 }
      #let %type_end: addr = #call program_type_end(%source, %right)
      #let %tail: addr = #call raw_node_next(%type_end)
      #if #call raw_is_nil(%tail) { #return 0 }
      #if #call program_is_semicolon(%source, %tail) { #return 0 }
      #if #call meta_atom_equal(%source, %tail, ",", 1) { #return 0 }
      #return 5106
    }
    %status: i32 = #call program_validate_value_expression(
      %unit, %source, %function, %right
    )
    #if #ne(%status, 0) { #return %status }
    #if #call meta_atom_equal(%source, %operator, "/", 1) {
      #if #call program_is_decimal(%source, %right) {
        #let %parsed_right: addr = #call program_parse_decimal(%source, %right)
        #if #eq(#call program_result_value(%parsed_right), 0) {
          #return 5107
        }
      }
    }
    #return 0
  }
  #return 5106
}

#proc program_value_expression_end_depth(
  addr %source, addr %left, i64 %depth
) -> addr {
  #if #ge(%depth, 256) { #return %left }
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return %left_end }
  #if #call program_is_semicolon(%source, %operator) { #return %left_end }
  #if #call meta_atom_equal(%source, %operator, ",", 1) {
    #return %left_end
  }
  // A value expression only continues when the next token is an operator.
  // In a condition the next token is often the `{...}` body; treating that
  // group as an infix operator would skip the body and produce a bogus 5113.
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return %left_end
  }
  #let %operator_end: addr = #call program_value_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #return #call program_value_expression_end_depth(
    %source, %right, #add(%depth, 1)
  )
}

#proc program_value_expression_end(
  addr %source, addr %left
) -> addr {
  #return #call program_value_expression_end_depth(%source, %left, 0)
}

#proc program_validate_return_statement(
  addr %unit, addr %source, addr %function, addr %return_keyword
) -> i32 {
  #if #eq(#call meta_atom_equal(%source, %return_keyword, "return", 6), 0) {
    #return 5106
  }
  #let %left: addr = #call raw_node_next(%return_keyword)
  #if #call raw_is_nil(%left) {
    #if #call program_function_returns_unit(%source, %function) {
      #return 0
    }
    #return 5106
  }
  #if #call program_is_semicolon(%source, %left) {
    #if #call program_function_returns_unit(%source, %function) {
      #return 0
    }
    #return 5106
  }
  #let %status: i32 = #call program_validate_value_expression(
    %unit, %source, %function, %left
  )
  #if #ne(%status, 0) { #return %status }
  #return 0
}

#proc program_validate_return_group(
  addr %unit, addr %source, addr %function, addr %body
) -> i32 {
  // Braced blocks are ordinary statement lists.  The old implementation
  // treated every block as a single `return`, which rejected perfectly valid
  // guard blocks such as `if (...) { effects.throw(...); }`.
  #let %statement: addr = #call raw_node_first(%body)
  #loop statements {
    #if #call raw_is_nil(%statement) { #return 0 }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %status: i32 = #call program_validate_local(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) { #return 5511 }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "while", 5) {
      #let %status: i32 = #call program_validate_while(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) { #return 5512 }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "if", 2) {
      #let %status: i32 = #call program_validate_if(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) {
        #call program_unit_set_validation_node(%unit, %source, %statement)
        #return %status
      }
      %statement: addr = #call program_if_after(%source, %statement)
      #if #call raw_is_nil(%statement) { #return 0 }
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "return", 6) {
      #let %status: i32 = #call program_validate_return_statement(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) { #return 5513 }
      #return 0
    }
    #if #call meta_atom_equal(%source, %statement, "break", 5) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "continue", 8) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #let %status: i32 = 0
    #if #call program_is_assignment_statement(%source, %statement) {
      %status: i32 = #call program_validate_assignment(
        %unit, %source, %function, %statement
      )
    } else {
      %status: i32 = #call program_validate_value_expression(
        %unit, %source, %function, %statement
      )
    }
    #if #ne(%status, 0) {
      #call program_unit_set_validation_node(%unit, %source, %statement)
      #return 5514
    }
    %statement: addr = #call program_skip_statement(%source, %statement)
    #continue statements
  }
}

#proc program_validate_if(
  addr %unit, addr %source, addr %function, addr %if_node
) -> i32 {
  #call program_unit_set_validation_function(%unit, %function)
  #call program_unit_set_validation_node(%unit, %source, %if_node)
  #if #eq(#call raw_node_start(%if_node), 7362) {
    #if #call program_name_matches_text(%source, %function, "release", 7) {
      #call program_unit_set_debug_module_kind(%unit, 291)
    } else {
      #if #call program_name_matches_text(%source, %function, "new", 3) {
        #call program_unit_set_debug_module_kind(%unit, 292)
      } else {
        #call program_unit_set_debug_module_kind(%unit, 293)
      }
    }
  }
  #let %condition: addr = #call raw_node_next(%if_node)
  #if #call raw_is_nil(%condition) {
    #call program_unit_set_debug_module_kind(%unit, 703)
    #return 5113
  }
  #let %condition_end: addr = #call program_condition_operand_end(
    %source, %condition
  )
  #if #call program_name_matches_text(%source, %function, "same_arguments", 14) {
  }
  #let %condition_op: addr = #call raw_node_next(%condition_end)
  #let %then_group: addr = %condition_end
  #if #call meta_atom_equal(%source, %condition, "true", 4) {
    %then_group: addr = #call raw_node_next(%condition)
  } else {
    #if #call meta_atom_equal(%source, %condition, "false", 5) {
      %then_group: addr = #call raw_node_next(%condition)
    } else {
      #if #call raw_is_nil(%condition_op) {
        #call program_unit_set_debug_module_kind(%unit, 704)
        #return 5113
      }
      #if #eq(
        #call raw_node_kind(%condition_op), 2
      ) {
        #if #ne(#call raw_node_delimiter(%condition_op), 123) {
          #call program_unit_set_debug_module_kind(%unit, 705)
          #return 5113
        }
        #let %status: i32 = #call program_validate_condition_operand(
          %unit, %source, %function, %condition
        )
        #if #call program_name_matches_text(%source, %function, "same_arguments", 14) {
        }
        #if #ne(%status, 0) {
          #return 5501
        }
        %then_group: addr = %condition_op
      } else {
        // Conditions may contain an arithmetic subexpression before the
        // comparison (`span.end - span.start != length`).  The first
        // operator is therefore not necessarily the final comparison; let
        // the condition walker consume the whole expression and take the
        // following block as the then-branch.
        #if #eq(#call program_is_operator(%source, %condition_op), 0) {
          #call program_unit_set_debug_module_kind(%unit, 706)
          #return 5113
        }
        #let %status: i32 = #call program_validate_condition_expression(
          %unit, %source, %function, %condition
        )
        #if #ne(%status, 0) { #return %status }
        #let %condition_end_full: addr =
          #call program_condition_expression_end(%source, %condition)
        %then_group: addr = #call raw_node_next(%condition_end_full)
      }
    }
  }
  #if #call raw_is_nil(%then_group) {
    #call program_unit_set_debug_module_kind(%unit, 707)
    #return 5113
  }
  #if #ne(#call raw_node_kind(%then_group), 2) {
    #call program_unit_set_debug_module_kind(%unit, 708)
    #return 5113
  }
  #if #ne(#call raw_node_delimiter(%then_group), 123) {
    #call program_unit_set_debug_module_kind(%unit, 709)
    #return 5113
  }
  #let %else_keyword: addr = #call raw_node_next(%then_group)
  #let %status: i32 = #call program_validate_return_group(
    %unit, %source, %function, %then_group
  )
  #if #call program_name_matches_text(%source, %function, "same_arguments", 14) {
  }
  #if #ne(%status, 0) {
    #return %status
  }
  #if #call raw_is_nil(%else_keyword) { #return 0 }
  #if #eq(#call meta_atom_equal(%source, %else_keyword, "else", 4), 0) {
    // An if without else is an early-return guard.  The caller advances to
    // the node after the then-group and validates the surrounding statements.
    #return 0
  }
  #let %else_group: addr = #call raw_node_next(%else_keyword)
  #if #call raw_is_nil(%else_group) {
    #call program_unit_set_debug_module_kind(%unit, 710)
    #return 5113
  }
  #if #call meta_atom_equal(%source, %else_group, "if", 2) {
    #return #call program_validate_if(
      %unit, %source, %function, %else_group
    )
  }
  #if #ne(#call raw_node_delimiter(%else_group), 123) {
    #call program_unit_set_debug_module_kind(%unit, 711)
    #return 5113
  }
  #return #call program_validate_return_group(
    %unit, %source, %function, %else_group
  )
}

#proc program_if_then_group(addr %source, addr %if_node) -> addr {
  #let %condition: addr = #call raw_node_next(%if_node)
  #let %condition_end: addr = #call program_condition_operand_end(
    %source, %condition
  )
  #let %condition_op: addr = #call raw_node_next(%condition_end)
  #if #call meta_atom_equal(%source, %condition, "true", 4) {
    #return #call raw_node_next(%condition)
  }
  #if #call meta_atom_equal(%source, %condition, "false", 5) {
    #return #call raw_node_next(%condition)
  }
  #if #call raw_is_nil(%condition_op) { #return %condition_op }
  #if #eq(#call raw_node_kind(%condition_op), 2) {
    #return %condition_op
  }
  #let %condition_end_full: addr =
    #call program_condition_expression_end(%source, %condition)
  #return #call raw_node_next(%condition_end_full)
}

#proc program_if_has_else(addr %source, addr %if_node) -> i1 {
  #let %then_group: addr = #call program_if_then_group(%source, %if_node)
  #let %else_keyword: addr = #call raw_node_next(%then_group)
  #return #call meta_atom_equal(%source, %else_keyword, "else", 4)
}

#proc program_if_after(addr %source, addr %if_node) -> addr {
  #let %then_group: addr = #call program_if_then_group(%source, %if_node)
  #let %else_keyword: addr = #call raw_node_next(%then_group)
  #if #call raw_is_nil(%else_keyword) { #return %else_keyword }
  #if #eq(#call meta_atom_equal(%source, %else_keyword, "else", 4), 0) {
    #return %else_keyword
  }
  #let %else_group: addr = #call raw_node_next(%else_keyword)
  #if #call meta_atom_equal(%source, %else_group, "if", 2) {
    #return #call program_if_after(%source, %else_group)
  }
  #return #call raw_node_next(%else_group)
}

#proc program_skip_statement(addr %source, addr %statement) -> addr {
  #let %node: addr = %statement
  #loop nodes {
    #if #call raw_is_nil(%node) { #return %node }
    #if #call program_is_semicolon(%source, %node) {
      #return #call raw_node_next(%node)
    }
    %node: addr = #call raw_node_next(%node)
    #continue nodes
  }
}

#proc program_validate_local(
  addr %unit, addr %source, addr %function, addr %let_node
) -> i32 {
  #if #call program_is_meta_binding(%source, %let_node) { #return 0 }
  #let %name: addr = #call raw_node_next(%let_node)
  #let %annotation_or_equals: addr = #call raw_node_next(%name)
  #if #call raw_is_nil(%name) {
    #call program_unit_set_debug_module_kind(%unit, 4401)
    #return 5114
  }
  #if #call raw_is_nil(%annotation_or_equals) {
    #call program_unit_set_debug_module_kind(%unit, 4402)
    #return 5114
  }
  #let %type: addr = #call program_nil()
  #let %equals: addr = %annotation_or_equals
  #let %type_end: addr = %annotation_or_equals
  #if #call meta_atom_equal(%source, %annotation_or_equals, ":", 1) {
    %type: addr = #call raw_node_next(%annotation_or_equals)
    #if #call raw_is_nil(%type) {
      #call program_unit_set_debug_module_kind(%unit, 4403)
      #return 5114
    }
    %type_end: addr = #call program_type_end(%source, %type)
    %equals: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%equals) {
      #call program_unit_set_debug_module_kind(%unit, 4404)
      #return 5114
    }
    #if #eq(#call program_type_valid_in_unit(%unit, %source, %type), 0) {
      #return 5104
    }
  }
  #if #eq(#call meta_atom_equal(%source, %equals, "=", 1), 0) {
    #call program_unit_set_debug_module_kind(%unit, 4406)
    #return 5114
  }
  #let %value: addr = #call raw_node_next(%equals)
  #if #call raw_is_nil(%value) {
    #call program_unit_set_debug_module_kind(%unit, 4405)
    #return 5114
  }
  #let %status: i32 = #call program_validate_value_expression(
    %unit, %source, %function, %value
  )
  #if #ne(%status, 0) { #return %status }
  #let %end: addr = #call program_value_expression_end(%source, %value)
  #let %tail: addr = #call raw_node_next(%end)
  #if #call raw_is_nil(%tail) {
    #call program_unit_set_debug_module_kind(%unit, 4408)
    #return 5114
  }
  #if #call program_is_semicolon(%source, %tail) { #return 0 }
  #call program_unit_set_debug_module_kind(%unit, 4409)
  #return 5114
}

#proc program_validate_assignment(
  addr %unit, addr %source, addr %function, addr %assignment
) -> i32 {
  #if #call meta_atom_equal(%source, %assignment, "*", 1) {
    #return 0
  }
  // A call followed by a dotted member is an lvalue too:
  // `Syntax.node_mut(...).next_sibling = node`.  The base call and the
  // member are separate RawAst siblings, so the ordinary name-prefix check
  // cannot recognize this form.
  #let %post_call_member: addr = #call program_operand_end_source(
    %source, %assignment
  )
  #if #call program_is_dot_member(%source, %post_call_member) {
    #let %base_status: i32 = #call program_validate_operand(
      %unit, %source, %function, %assignment
    )
    #if #ne(%base_status, 0) { #return %base_status }
    #let %equals: addr = #call raw_node_next(%post_call_member)
    #let %value: addr = #call raw_node_next(%equals)
    #if #call raw_is_nil(%equals) { #return 5115 }
    #if #call raw_is_nil(%value) { #return 5115 }
    #if #eq(#call meta_atom_equal(%source, %equals, "=", 1), 0) {
      #return 5115
    }
    #return #call program_validate_value_expression(
      %unit, %source, %function, %value
    )
  }
  #let %equals: addr = #call raw_node_next(
    #call program_operand_end_source(%source, %assignment)
  )
  #let %value: addr = #call raw_node_next(%equals)
  #if #call raw_is_nil(%equals) { #return 5115 }
  #if #call raw_is_nil(%value) { #return 5115 }
  #if #call program_local_matches(%source, %function, %assignment) {
  } else {
    #if #eq(#call program_name_prefix_length(%source, %assignment), 0) {
      #return 5108
    }
    #let %field_status: i32 = #call program_validate_field_operand(
      %unit, %source, %function, %assignment
    )
    #if #ne(%field_status, 0) { #return %field_status }
  }
  #if #eq(#call meta_atom_equal(%source, %equals, "=", 1), 0) {
    #return 5115
  }
  #let %status: i32 = #call program_validate_value_expression(
    %unit, %source, %function, %value
  )
  #if #ne(%status, 0) { #return %status }
  #let %end: addr = #call program_value_expression_end(%source, %value)
  #let %tail: addr = #call raw_node_next(%end)
  #if #call raw_is_nil(%tail) { #return 5115 }
  #if #call program_is_semicolon(%source, %tail) {
    #return 0
  }
  #return 5115
}

#proc program_is_assignment_statement(
  addr %source, addr %statement
) -> i1 {
  #if #call meta_atom_equal(%source, %statement, "*", 1) {
    // A leading dereference in statement position is the pointer-store form
    // of assignment.  The operand walker cannot use the `=` token after the
    // dereferenced call as a normal value-expression boundary.
    #return 1
  }
  // RawAst keeps a dotted lvalue such as `diagnostic.note_count` in one
  // atom.  Its assignment marker is therefore the immediate next sibling;
  // check that shape before the generalized operand walker, which may walk
  // through a member path while looking for a call group.
  #if #call meta_atom_equal(
    %source, #call raw_node_next(%statement), "=", 1
  ) { #return 1 }
  #return #call meta_atom_equal(
    %source,
    #call raw_node_next(
      #call program_operand_end_source(%source, %statement)
    ),
    "=", 1
  )
}

#proc program_while_body(addr %source, addr %while_node) -> addr {
  #let %left: addr = #call raw_node_next(%while_node)
  #return #call raw_node_next(
    #call program_condition_expression_end(%source, %left)
  )
}

#proc program_validate_while(
  addr %unit, addr %source, addr %function, addr %while_node
) -> i32 {
  #let %left: addr = #call raw_node_next(%while_node)
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator: addr = #call raw_node_next(%left_end)
  #let %body: addr = #call raw_node_next(
    #call program_condition_expression_end(%source, %left)
  )
  #if #call raw_is_nil(%left) {
    #call program_unit_set_debug_module_kind(%unit, 4501)
    #return 5116
  }
  #if #call raw_is_nil(%operator) {
    #call program_unit_set_debug_module_kind(%unit, 4502)
    #return 5116
  }
  #if #call raw_is_nil(%body) {
    #call program_unit_set_debug_module_kind(%unit, 4503)
    #return 5116
  }
  #if #eq(#call program_is_comparison(%source, %operator), 0) {
    #call program_unit_set_debug_module_kind(%unit, 4504)
    #return 5116
  }
  #let %status: i32 = #call program_validate_condition_expression(
    %unit, %source, %function, %left
  )
  #if #ne(%status, 0) {
    #call program_unit_set_validation_node(%unit, %source, %left)
    #if #call program_name_matches_text(%source, %function, "insert", 6) {
    }
    #return %status
  }
  #if #ne(#call raw_node_delimiter(%body), 123) {
    #call program_unit_set_debug_module_kind(%unit, 4505)
    #return 5116
  }
  #let %statement: addr = #call raw_node_first(%body)
  #loop statements {
    #if #call raw_is_nil(%statement) { #break statements }
    #if #call meta_atom_equal(%source, %statement, "break", 5) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "continue", 8) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %local_status: i32 = #call program_validate_local(
        %unit, %source, %function, %statement
      )
      #if #ne(%local_status, 0) { #return %local_status }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "while", 5) {
      #let %nested_status: i32 = #call program_validate_while(
        %unit, %source, %function, %statement
      )
      #if #ne(%nested_status, 0) { #return %nested_status }
      %statement: addr = #call program_while_body(%source, %statement)
      %statement: addr = #call raw_node_next(%statement)
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "if", 2) {
      #let %if_statement: addr = %statement
      #let %if_status: i32 = #call program_validate_if(
        %unit, %source, %function, %statement
      )
      #if #ne(%if_status, 0) { #return %if_status }
      %statement: addr = #call program_if_after(%source, %statement)
      #if #call raw_is_nil(%statement) {
        #if #call program_if_has_else(%source, %if_statement) {
          #break statements
        }
      #call program_unit_set_debug_module_kind(%unit, 4506)
      #return 5116
      }
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #let %statement_status: i32 = 0
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      %statement_status: i32 = #call program_validate_local(
        %unit, %source, %function, %statement
      )
    } else {
      #if #call program_is_assignment_statement(%source, %statement) {
        %statement_status: i32 = #call program_validate_assignment(
          %unit, %source, %function, %statement
        )
      } else {
        %statement_status: i32 = #call program_validate_value_expression(
          %unit, %source, %function, %statement
        )
      }
    }
    #if #ne(%statement_status, 0) {
      #call program_unit_set_validation_node(%unit, %source, %statement)
      #if #call program_name_matches_text(%source, %function, "insert", 6) {
      }
      #return %statement_status
    }
    %statement: addr = #call program_skip_statement(%source, %statement)
    #continue statements
  }
  #return 0
}

#proc program_param_matches(
  addr %source, addr %function, addr %node
) -> i1 {
  #let %child: addr = #call raw_node_first(#call program_function_params(%function))
  #loop params {
    #if #call raw_is_nil(%child) { #return 0 }
    #if #eq(#call raw_node_length(%child), #call raw_node_length(%node)) {
      #let %data: addr = #call tool_source_data(%source)
      #let %index: i64 = 0
      #let %same: i1 = 1
      #loop compare {
        #if #ge(%index, #call raw_node_length(%node)) { #break compare }
        #if #ne(
          #call tool_byte_at(%data, #add(#call raw_node_start(%child), %index)),
          #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index))
        ) { %same: i1 = 0 #break compare }
        %index: i64 = #add(%index, 1)
        #continue compare
      }
      #if %same { #return 1 }
    }
    #let %colon: addr = #call raw_node_next(%child)
    #let %type: addr = #call raw_node_next(%colon)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #let %separator: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%separator) { #return 0 }
    %child: addr = #call raw_node_next(%separator)
    #continue params
  }
}

#proc program_local_matches(
  addr %source, addr %function, addr %node
) -> i1 {
  #return #call program_local_matches_group(
    %source, #call program_function_body(%function), %node
  )
}

#proc program_local_matches_group(
  addr %source, addr %group, addr %node
) -> i1 {
  #let %statement: addr = #call raw_node_first(%group)
  #loop statements {
    #if #call raw_is_nil(%statement) { #return 0 }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %name: addr = #call raw_node_next(%statement)
      #if #call raw_is_nil(%name) { #return 0 }
      #if #eq(#call raw_node_length(%name), #call raw_node_length(%node)) {
        #let %data: addr = #call tool_source_data(%source)
        #let %index: i64 = 0
        #let %same: i1 = 1
        #loop compare {
          #if #ge(%index, #call raw_node_length(%node)) { #break compare }
          #if #ne(
            #call tool_byte_at(%data, #add(#call raw_node_start(%name), %index)),
            #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index))
          ) { %same: i1 = 0 #break compare }
          %index: i64 = #add(%index, 1)
          #continue compare
        }
        #if %same { #return 1 }
      }
    }
    #if #eq(#call raw_node_kind(%statement), 2) {
      #if #call program_local_matches_group(
        %source, %statement, %node
      ) { #return 1 }
    }
    %statement: addr = #call raw_node_next(%statement)
    #continue statements
  }
}

// The lexer keeps `base.field` in one atom.  Keep the split in this lowering
// helper instead of teaching RawAst about member access: the prefix identifies
// a parameter/local storage slot and the suffix is resolved by the record
// Meta descriptor.
#proc program_name_prefix_length(addr %source, addr %node) -> i64 {
  #let %data: addr = #call tool_source_data(%source)
  #let %length: i64 = #call raw_node_length(%node)
  #let %index: i64 = 0
  #let %prefix: i64 = 0
  #loop prefix {
    #if #ge(%index, %length) { #break prefix }
    #if #eq(
      #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index)),
      46
    ) {
      #if #eq(%prefix, 0) { %prefix: i64 = %index }
    }
    %index: i64 = #add(%index, 1)
    #continue prefix
  }
  #return %prefix
}

#proc program_name_prefix_matches(
  addr %source, addr %name, addr %node
) -> i1 {
  #let %prefix_length: i64 = #call program_name_prefix_length(
    %source, %node
  )
  #if #eq(%prefix_length, 0) { #return 0 }
  #if #ne(%prefix_length, #call raw_node_length(%name)) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %prefix_length) { #break compare }
    #if #ne(
      #call tool_byte_at(
        %data, #add(#call raw_node_start(%name), %index)
      ),
      #call tool_byte_at(
        %data, #add(#call raw_node_start(%node), %index)
      )
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

#proc program_name_matches_field(
  addr %source, addr %name, addr %node
) -> i1 {
  #let %prefix_length: i64 = #call program_name_prefix_length(
    %source, %node
  )
  #if #ne(%prefix_length, 0) {
    #return #call program_name_prefix_matches(%source, %name, %node)
  }
  #if #ne(
    #call raw_node_length(%name), #call raw_node_length(%node)
  ) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare_field_name {
    #if #ge(%index, #call raw_node_length(%node)) {
      #break compare_field_name
    }
    #if #ne(
      #call tool_byte_at(
        %data, #add(#call raw_node_start(%name), %index)
      ),
      #call tool_byte_at(
        %data, #add(#call raw_node_start(%node), %index)
      )
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare_field_name
  }
  #return 1
}

#proc program_param_type_for_field(
  addr %source, addr %function, addr %node
) -> addr {
  #let %param: addr = #call raw_node_first(
    #call program_function_params(%function)
  )
  #loop parameters {
    #if #call raw_is_nil(%param) { #return #call program_nil() }
    #if #call program_name_matches_field(%source, %param, %node) {
      #let %colon: addr = #call raw_node_next(%param)
      #return #call raw_node_next(%colon)
    }
    #let %colon: addr = #call raw_node_next(%param)
    #let %type: addr = #call raw_node_next(%colon)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #let %separator: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%separator) { #return #call program_nil() }
    %param: addr = #call raw_node_next(%separator)
    #continue parameters
  }
}

#proc program_local_type_for_field_group(
  addr %source, addr %group, addr %node
) -> addr {
  #let %statement: addr = #call raw_node_first(%group)
  #loop statements {
    #if #call raw_is_nil(%statement) { #return #call program_nil() }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %name: addr = #call raw_node_next(%statement)
      #if #call program_name_matches_field(%source, %name, %node) {
        #let %colon: addr = #call raw_node_next(%name)
        #return #call raw_node_next(%colon)
      }
    }
    #if #eq(#call raw_node_kind(%statement), 2) {
      #let %nested: addr = #call program_local_type_for_field_group(
        %source, %statement, %node
      )
      #if #eq(#call raw_is_nil(%nested), 0) { #return %nested }
    }
    %statement: addr = #call raw_node_next(%statement)
    #continue statements
  }
}

#proc program_local_type_for_field(
  addr %source, addr %function, addr %node
) -> addr {
  #return #call program_local_type_for_field_group(
    %source, #call program_function_body(%function), %node
  )
}

#proc program_operand_receiver_field(addr %source, addr %node) -> addr {
  // Find the member immediately before the final method in a path such as
  // `unit.nodes.length`.
  #let %final: addr = #call program_operand_name(%source, %node)
  #let %current: addr = %node
  #loop path {
    #let %dot: addr = #call raw_node_next(%current)
    #if #call raw_is_nil(%dot) { #return #call program_nil() }
    #if #eq(#call raw_node_kind(%dot), 2) {
      #return #call program_nil()
    }
    #if #call program_is_dot_member(%source, %dot) {
      %current: addr = %dot
      #continue path
    }
    #if #eq(#call meta_atom_equal(%source, %dot, ".", 1), 0) {
      #return #call program_nil()
    }
    #let %member: addr = #call raw_node_next(%dot)
    #if #call raw_is_nil(%member) { #return #call program_nil() }
    #if #eq(
      #call raw_node_start(%member), #call raw_node_start(%final)
    ) {
      #return %current
    }
    %current: addr = %member
    #continue path
  }
}

#proc program_validate_field_operand(
  addr %unit, addr %source, addr %function, addr %node
) -> i32 {
  #call program_unit_set_debug_source_index(
    %unit, #call raw_node_start(%node)
  )
  #let %binding: addr = #call program_record_binding_for_field(
    %unit, %source, %function, %node
  )
  #if #call raw_is_nil(%binding) {
    #call program_unit_set_debug_module_kind(%unit, 360)
    // A captured module type may be available only to the call resolver; keep
    // dotted expressions valid here and let the writer resolve their target.
    #if #ne(#call program_name_prefix_length(%source, %node), 0) {
      #return 0
    }
    #return 5108
  }
  #let %record_source: addr = #call program_record_source_for_field(
    %unit, %source, %function, %node
  )
  // `%record_source` is an opaque source object, not a RawAst link.  Its
  // first byte belongs to the backing data pointer, so `raw_is_nil` cannot be
  // used as a validity test here; the binding check above is the nullable
  // boundary.
  #call program_unit_set_debug_source_index(
    %unit, #call raw_node_start(#call raw_node_next(%binding))
  )
  #call program_unit_set_debug_bounds_kind(%unit, 363)
  #let %field: addr = #call program_record_field_for_node(
    %source, %record_source, %binding, %node
  )
  #if #call raw_is_nil(%field) {
    #let %field_type_fallback: addr = #call program_record_type_for_field(
      %source, %function, %node
    )
    #if #eq(#call raw_is_nil(%field_type_fallback), 0) {
      #let %meta_fallback: addr = #call program_record_meta_type_for_field(
        %unit, %source, %function, %field_type_fallback
      )
      #if #eq(#call raw_is_nil(%meta_fallback), 0) {
        #if #eq(#call meta_value_kind(%meta_fallback), 4) {
          #let %meta_source_fallback: addr = #call meta_value_source(
            %meta_fallback
          )
          #let %meta_binding_fallback: addr = #call meta_value_payload(
            %meta_fallback
          )
          #let %meta_field_fallback: addr = #call program_record_field_for_node(
            %source, %meta_source_fallback, %meta_binding_fallback, %node
          )
          #if #eq(#call raw_is_nil(%meta_field_fallback), 0) {
            #return 0
          }
        }
      }
    }
    #call program_unit_set_debug_module_kind(%unit, 361)
    #return 5108
  }
  #let %field_type: addr = #call program_record_field_type(
    %record_source, %field
  )
  #if #call raw_is_nil(%field_type) {
    #call program_unit_set_debug_module_kind(%unit, 362)
    #return 5108
  }
  #return 0
}

#proc program_write_field_base(addr %source, addr %node) -> #unit {
  #call bootstrap.artifact-write-byte(37)
  #call meta_write_span(
    %source, #call raw_node_start(%node),
    #call program_name_prefix_length(%source, %node)
  )
  #return
}

#proc program_write_unknown_field_load(
  addr %unit, addr %source, addr %function, addr %node
) -> #unit {
  #let %field_type: addr = #call program_record_type_for_field(
    %source, %function, %node
  )
  // If the local's nominal type was not retained in its Meta environment,
  // recover the record descriptor from the unit's collected type table.  The
  // old fallback treated the whole nominal (`Meta.Expansion`) as the field
  // type, which emitted `#load[addr]` at offset zero for `expanded.diagnostic`.
  #if #eq(#call raw_is_nil(%field_type), 0) {
    #let %descriptor: addr = #call program_find_type_final_member(
      %unit, %source, %field_type
    )
    #if #eq(#call raw_is_nil(%descriptor), 0) {
      #let %record_binding: addr = #call program_type_binding(%descriptor)
      #let %record_source: addr = #call program_type_source(%descriptor)
      #let %field: addr = #call program_record_field_for_node(
        %source, %record_source, %record_binding, %node
      )
      #if #eq(#call raw_is_nil(%field), 0) {
        #let %member_type: addr = #call program_record_field_type(
          %record_source, %field
        )
        #let %offset: i64 = #call program_record_field_offset(
          %source, %record_source, %record_binding, %node
        )
        #call bootstrap.artifact-write-literal("#load[")
        #if #call program_write_meta_alias_type(
          %unit, %record_source, %function, %member_type
        ) {
        } else {
          #call program_write_type(%unit, %record_source, %member_type)
        }
        #call bootstrap.artifact-write-literal("](#lea(base=")
        #call program_write_field_base(%source, %node)
        #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
        #call meta_write_decimal(%offset)
        #call bootstrap.artifact-write-literal("))")
        #return
      }
    }
  }
  #call bootstrap.artifact-write-literal("#load[")
  #if #call program_field_is_length(%source, %node) {
    #call bootstrap.artifact-write-literal("#bits<64>")
  } else {
  #if #call raw_is_nil(%field_type) {
    #call bootstrap.artifact-write-literal("#bits<64>")
  } else {
    #call program_write_function_type(
      %unit, %source, %function, %field_type
    )
  }
  }
  #call bootstrap.artifact-write-literal("](#lea(base=")
  #call program_write_field_base(%source, %node)
  #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=0))")
  #return
}

#proc program_field_path_node(addr %source, addr %node) -> addr {
  // RawAst may represent `value.contents` as two adjacent atoms (`value`,
  // `.contents`) instead of one dotted atom.  The record helpers compare a
  // source span, so synthesize one span covering the complete path before
  // asking them to resolve the field.
  #let %next: addr = #call raw_node_next(%node)
  #if #call program_is_dot_member(%source, %next) {
    // Stop at the final member atom.  `program_operand_end_source` includes
    // the call argument group, which would make the synthetic span
    // `workspace.units.get(...)` and break member-name lookup.
    #let %end: addr = #call program_operand_name(%source, %node)
    #let %start: i64 = #call raw_node_start(%node)
    #let %finish: i64 = #add(
      #call raw_node_start(%end), #call raw_node_length(%end)
    )
    #return #call raw_node_new(
      1, 0, %start, #sub(%finish, %start), 3
    )
  }
  #return %node
}

#proc program_field_is_length(addr %source, addr %node) -> i1 {
  #let %start: i64 = #call program_name_start(%source, %node)
  #let %length: i64 = #call program_name_length(%source, %node)
  #let %member: addr = #call raw_node_new(1, 0, %start, %length, 3)
  #return #call meta_atom_equal(%source, %member, "length", 6)
}

#proc program_write_ufcs_receiver(
  addr %source, addr %function, addr %node
) -> #unit {
  #if #call program_is_upper_module_path(%source, %node) {
    #return
  }
  // The receiver is the complete path before the final member.  Writing only
  // the first prefix turns `workspace.sources.get(i)` into `%workspace`,
  // which calls `get` on the wrong record.  Build a short RawAst span for
  // `workspace.sources`, then use the ordinary field writer so intermediate
  // record fields become their required loads.
  #let %path: addr = #call program_call_path_node(%source, %node)
  #let %start: i64 = #call raw_node_start(%path)
  #let %member_start: i64 = #call program_name_start(%source, %path)
  #if #le(%member_start, %start) {
    #call program_write_operand_base(%source, %function, %path)
    #return
  }
  #let %receiver: addr = #call raw_node_new(
    1, 0, %start, #sub(#sub(%member_start, %start), 1), 3
  )
  #if #eq(#call program_name_prefix_length(%source, %receiver), 0) {
    #call program_write_operand_base(%source, %function, %receiver)
    #return
  }
  #call program_write_field_operand(
    #call program_function_unit(%function), %source, %function, %receiver
  )
  #return
}

#proc program_write_field_operand(
  addr %unit, addr %source, addr %function, addr %node
) -> #unit {
  #let %binding: addr = #call program_record_binding_for_field(
    %unit, %source, %function, %node
  )
  #let %record_source: addr = #call program_record_source_for_field(
    %unit, %source, %function, %node
  )
  // For a dotted local such as `workspace.next_id`, the ordinary field query
  // sees the complete path and can miss the base variable's record binding.
  // Resolve the receiver span first, then use its nominal descriptor for the
  // final member lookup.
  #let %field_prefix: i64 = #call program_name_prefix_length(%source, %node)
  #let %needs_receiver: i1 = 0
  #if #gt(%field_prefix, 0) { %needs_receiver: i1 = 1 }
  #if #call raw_is_nil(%binding) { %needs_receiver: i1 = 1 }
  #if %needs_receiver {
    #if #gt(%field_prefix, 0) {
      #let %receiver: addr = #call raw_node_new(
        1, 0, #call raw_node_start(%node), %field_prefix, 3
      )
      #let %receiver_type: addr = #call program_record_type_for_field(
        %source, %function, %receiver
      )
      #if #eq(#call raw_is_nil(%receiver_type), 0) {
        #if #call meta_type_is_address(%source, %receiver_type) {
          %receiver_type: addr = #call raw_node_next(%receiver_type)
          #if #call meta_atom_equal(%source, %receiver_type, "mut", 3) {
            %receiver_type: addr = #call raw_node_next(%receiver_type)
          }
        }
        #let %receiver_value: addr = #call program_record_meta_type_for_field(
          %unit, %source, %function, %receiver_type
        )
        #if #eq(#call meta_value_kind(%receiver_value), 4) {
          %binding: addr = #call meta_value_payload(%receiver_value)
          %record_source: addr = #call meta_value_source(%receiver_value)
        } else {
          #let %descriptor: addr = #call program_find_type(
          %unit, %source, %receiver_type
          )
          #if #call raw_is_nil(%descriptor) {
            %descriptor: addr = #call program_find_type_final_member(
              %unit, %source, %receiver_type
            )
          }
          #if #call raw_is_nil(%descriptor) {
          #if #call program_unit_writing(%unit) {
              %descriptor: addr = #call program_find_record_type_by_scan(
                %unit, %source, %receiver_type
              )
            }
          }
          #if #eq(#call raw_is_nil(%descriptor), 0) {
            %binding: addr = #call program_type_binding(%descriptor)
            %record_source: addr = #call program_type_source(%descriptor)
          }
        }
      }
    }
  }
  #if #call raw_is_nil(%binding) {
    #call program_write_unknown_field_load(%unit, %source, %function, %node)
    #return
  }
  #let %field: addr = #call program_record_field_for_node(
    %source, %record_source, %binding, %node
  )
  #if #call raw_is_nil(%field) {
    #call program_write_unknown_field_load(%unit, %source, %function, %node)
    #return
  }
  #let %field_type: addr = #call program_record_field_type(
    %record_source, %field
  )
  #let %offset: i64 = #call program_record_field_offset(
    %source, %record_source, %binding, %node
  )
  // RawAst keeps dotted names in one atom.  When a field itself is a record
  // (`token.span.start`), build a temporary slice for the final member and
  // emit the two address loads explicitly.
  #let %prefix: i64 = #call program_name_prefix_length(%source, %node)
  #let %final_start: i64 = #call program_name_start(%source, %node)
  #let %full_length: i64 = #call raw_node_length(%node)
  #let %final_length: i64 = #call program_name_length(%source, %node)
  #if #gt(%prefix, 0) {
    #let %inner_value: addr = #call program_record_meta_type_for_field(
      %unit, %record_source, %function, %field_type
    )
    #if #call raw_is_nil(%inner_value) {
      #let %inner_descriptor: addr = #call program_find_type(
        %unit, %record_source, %field_type
      )
      #if #call raw_is_nil(%inner_descriptor) {
        %inner_descriptor: addr = #call program_find_type_final_member(
          %unit, %record_source, %field_type
        )
      }
      #if #eq(#call raw_is_nil(%inner_descriptor), 0) {
        #let %inner_source: addr = #call program_type_source(
          %inner_descriptor
        )
        #let %inner_binding: addr = #call program_type_binding(
          %inner_descriptor
        )
        %inner_value: addr = #call meta_value_type(
          %inner_source, %field_type, %inner_binding
        )
      }
    }
    #if #eq(#call raw_is_nil(%inner_value), 0) {
      #if #eq(#call meta_value_kind(%inner_value), 4) {
        #let %inner_source: addr = #call meta_value_source(%inner_value)
        #let %inner_binding: addr = #call meta_value_payload(%inner_value)
        #let %suffix: addr = #call raw_node_new(
          1, 0, %final_start, %final_length, 3
        )
        #let %inner_field: addr = #call program_record_field_for_node(
          %source, %inner_source, %inner_binding, %suffix
        )
        #if #eq(#call raw_is_nil(%inner_field), 0) {
          #let %inner_type: addr = #call program_record_field_type(
            %inner_source, %inner_field
          )
          #let %inner_offset: i64 = #call program_record_field_offset(
            %source, %inner_source, %inner_binding, %suffix
          )
          #call bootstrap.artifact-write-literal("#load[")
          #call program_write_function_type(
            %unit, %inner_source, %function, %inner_type
          )
          #call bootstrap.artifact-write-literal(
            "](#lea(base=#load[addr](#lea(base="
          )
          #call program_write_field_base(%source, %node)
          #call bootstrap.artifact-write-literal(
            ", idx=0, scale=0, offset="
          )
          #call meta_write_decimal(%offset)
          #call bootstrap.artifact-write-literal(
            ")), idx=0, scale=0, offset="
          )
          #call meta_write_decimal(%inner_offset)
          #call bootstrap.artifact-write-literal("))")
          #return
        }
      }
    }
  }
  #call bootstrap.artifact-write-literal("#load[")
  // Field type nodes belong to the record's defining source.  Passing the
  // caller source makes imported nominal names look unresolved and defaults
  // them to bits<64>.
  #let %alias_type: i1 = #call program_write_meta_alias_type(
    %unit, %record_source, %function, %field_type
  )
  #if %alias_type {
    #call bootstrap.artifact-write-literal("](#lea(base=")
    #call program_write_field_base(%source, %node)
    #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
    #call meta_write_decimal(%offset)
    #call bootstrap.artifact-write-literal("))")
    #return
  }
  #if #call program_field_is_length(%source, %node) {
    #call bootstrap.artifact-write-literal("#bits<64>")
  } else {
    #call program_write_function_type(
      %unit, %record_source, %function, %field_type
    )
  }
  #call bootstrap.artifact-write-literal("](#lea(base=")
  #call program_write_field_base(%source, %node)
  #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
  #call meta_write_decimal(%offset)
  #call bootstrap.artifact-write-literal("))")
  #return
}

#proc program_write_record_allocation(
  addr %unit, addr %source, addr %function, addr %node
) -> #unit {
  #let %binding: addr = #call program_record_binding_for_literal_in_function(
    %unit, %source, %function, %node
  )
  #let %record_source: addr = #call program_record_source_for_literal_in_function(
    %unit, %source, %function, %node
  )
  #let %size: i64 = #call program_record_size(%record_source, %binding)
  #if #eq(%size, 0) {
    // Factory-local record literals may lose their namespace while lowering
    // an argument.  Keep the record ABI valid for the common two-word Span
    // shape until the full Meta value is available.
    %size: i64 = 16
  }
  #call bootstrap.artifact-write-literal("#alloca(")
  #call meta_write_decimal(%size)
  #call bootstrap.artifact-write-byte(41)
  #return
}

// Record values occupy storage in the physical backend.  A record literal in
// an expression therefore needs statements before that expression: allocate
// the record, initialize every field, and then use its address.  Keeping this
// materialization separate from the expression writer prevents a `#let` from
// being emitted halfway through `#call f(...)`.
#proc program_write_record_literal_children(
  addr %unit, addr %source, addr %function, addr %literal
) -> #unit {
  #let %group: addr = #call program_record_literal_group(%source, %literal)
  #let %field: addr = #call raw_node_first(%group)
  #loop fields {
    #if #call raw_is_nil(%field) { #break fields }
    #let %colon: addr = #call raw_node_next(%field)
    #let %value: addr = #call raw_node_next(%colon)
    #call program_write_record_literals_in_expression(
      %unit, %source, %function, %value
    )
    #let %value_end: addr = #call program_value_expression_end(
      %source, %value
    )
    %field: addr = #call raw_node_next(%value_end)
    #if #call meta_atom_equal(%source, %field, ",", 1) {
      %field: addr = #call raw_node_next(%field)
    }
    #continue fields
  }
  #return
}

#proc program_write_record_literal_temporary(
  addr %unit, addr %source, addr %function, addr %literal
) -> #unit {
  #let %binding: addr = #call program_record_binding_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  // Resolving a literal through a factory namespace can materialize its
  // descriptor on the first lookup.  Query once more before deciding that no
  // temporary is needed, so the later expression writer cannot discover the
  // record only after this prelude has already been skipped.
  #if #call raw_is_nil(%binding) {
    %binding: addr = #call program_record_binding_for_literal_in_function(
      %unit, %source, %function, %literal
    )
  }
  #if #call raw_is_nil(%binding) { #return }
  #call program_write_record_literal_children(
    %unit, %source, %function, %literal
  )
  #let %record_source: addr = #call program_record_source_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  #let %size: i64 = #call program_record_size(%record_source, %binding)
  #if #eq(%size, 0) { %size: i64 = 16 }
  #call bootstrap.artifact-write-literal("  #let ")
  #call program_write_record_base(%source, %literal, 1)
  #call bootstrap.artifact-write-literal(": addr = #alloca(")
  #call meta_write_decimal(%size)
  #call bootstrap.artifact-write-literal(")\n")
  #call program_write_record_literal_stores(
    %unit, %source, %function, %literal, %literal, 1
  )
  #return
}

#proc program_write_record_literals_in_expression(
  addr %unit, addr %source, addr %function, addr %node
) -> #unit {
  #if #call raw_is_nil(%node) { #return }
  #if #call program_is_record_literal(%source, %node) {
    #call program_write_record_literal_temporary(
      %unit, %source, %function, %node
    )
    #return
  }
  #if #call program_is_parenthesized_operand(%node) {
    #call program_write_record_literals_in_expression(
      %unit, %source, %function, #call program_parenthesized_inner(%node)
    )
    #return
  }
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #eq(#call raw_is_nil(%group), 0) {
    #let %argument: addr = #call raw_node_first(%group)
    #loop arguments {
      #if #call raw_is_nil(%argument) { #break arguments }
      #call program_write_record_literals_in_expression(
        %unit, %source, %function, %argument
      )
      #let %argument_end: addr = #call program_value_expression_end(
        %source, %argument
      )
      #let %separator: addr = #call raw_node_next(%argument_end)
      #if #call raw_is_nil(%separator) { #break arguments }
      %argument: addr = #call raw_node_next(%separator)
      #continue arguments
    }
    #return
  }
  #let %left_end: addr = #call program_operand_end_source(%source, %node)
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call program_is_operator(%source, %operator) {
    #let %right: addr = #call raw_node_next(
      #call program_value_operator_end(%source, %operator)
    )
    #call program_write_record_literals_in_expression(
      %unit, %source, %function, %right
    )
  }
  #return
}

#proc program_write_record_base(
  addr %source, addr %base, i1 %temporary
) -> #unit {
  #call bootstrap.artifact-write-byte(37)
  #if %temporary {
    #call bootstrap.artifact-write-literal("record")
    #call meta_write_decimal(#call raw_node_start(%base))
  } else {
    #call meta_write_span(
      %source, #call raw_node_start(%base), #call raw_node_length(%base)
    )
  }
  #return
}

#proc program_write_record_literal_stores(
  addr %unit, addr %source, addr %function,
  addr %literal, addr %base, i1 %temporary
) -> #unit {
  #let %binding: addr = #call program_record_binding_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  #let %record_source: addr = #call program_record_source_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  #let %group: addr = #call program_record_literal_group(%source, %literal)
  #let %field: addr = #call raw_node_first(%group)
  #loop fields {
    #if #call raw_is_nil(%field) { #break fields }
    #let %colon: addr = #call raw_node_next(%field)
    #let %value: addr = #call raw_node_next(%colon)
    #let %field_def: addr = #call program_record_field_for_node(
      %source, %record_source, %binding, %field
    )
    #let %offset: i64 = #call program_record_field_offset(
      %source, %record_source, %binding, %field
    )
    #call bootstrap.artifact-write-literal("  #store ")
    #call program_write_value_expression(%source, %function, %value)
    #call bootstrap.artifact-write-literal(", #lea(base=")
    #call program_write_record_base(%source, %base, %temporary)
    #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
    #call meta_write_decimal(%offset)
    #call bootstrap.artifact-write-literal(")\n")
    #let %value_end: addr = #call program_value_expression_end(
      %source, %value
    )
    %field: addr = #call raw_node_next(%value_end)
    #if #call meta_atom_equal(%source, %field, ",", 1) {
      %field: addr = #call raw_node_next(%field)
    }
    #continue fields
  }
  #return
}

#proc program_write_record_literal_return(
  addr %source, addr %function, addr %return_keyword
) -> #unit {
  #let %literal: addr = #call raw_node_next(%return_keyword)
  #let %unit: addr = #call program_function_unit(%function)
  #let %binding: addr = #call program_record_binding_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  #let %record_source: addr = #call program_record_source_for_literal_in_function(
    %unit, %source, %function, %literal
  )
  #let %size: i64 = #call program_record_size(%record_source, %binding)
  #call program_write_record_literal_children(
    %unit, %source, %function, %literal
  )
  #call bootstrap.artifact-write-literal("  #let ")
  #call program_write_record_base(%source, %literal, 1)
  #call bootstrap.artifact-write-literal(": addr = #alloca(")
  #call meta_write_decimal(%size)
  #call bootstrap.artifact-write-literal(")\n")
  #call program_write_record_literal_stores(
    %unit, %source, %function, %literal, %literal, 1
  )
  #call bootstrap.artifact-write-literal("  #return ")
  #call program_write_record_base(%source, %literal, 1)
  #call bootstrap.artifact-write-byte(10)
  #return
}

#proc program_is_consteval_operand(
  addr %source, addr %node
) -> i1 {
  #if #eq(#call meta_atom_equal(%source, %node, "std", 3), 0) {
    #return 0
  }
  #let %colon1: addr = #call raw_node_next(%node)
  #let %colon2: addr = #call raw_node_next(%colon1)
  #let %name: addr = #call raw_node_next(%colon2)
  #let %group: addr = #call raw_node_next(%name)
  #if #eq(#call meta_atom_equal(%source, %colon1, ":", 1), 0) {
    #return 0
  }
  #if #eq(#call meta_atom_equal(%source, %colon2, ":", 1), 0) {
    #return 0
  }
  #if #eq(#call meta_atom_equal(%source, %name, "consteval", 9), 0) {
    #return 0
  }
  #if #call raw_is_nil(%group) { #return 0 }
  #if #ne(#call raw_node_kind(%group), 2) { #return 0 }
  #return #eq(#call raw_node_delimiter(%group), 40)
}

#proc program_consteval_operand_group(
  addr %source, addr %node
) -> addr {
  #return #call raw_node_next(
    #call raw_node_next(
      #call raw_node_next(#call raw_node_next(%node))
    )
  )
}

#proc program_operand_end(addr %node) -> addr {
  #let %next: addr = #call raw_node_next(%node)
  #if #call raw_is_nil(%next) { #return %node }
  #if #eq(#call raw_node_kind(%next), 2) {
    #if #eq(#call raw_node_delimiter(%next), 40) { #return %next }
  }
  #return %node
}

#proc program_is_dot(addr %source, addr %node) -> i1 {
  #return #call meta_atom_equal(%source, %node, ".", 1)
}

#proc program_is_dot_member(addr %source, addr %node) -> i1 {
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #if #lt(#call raw_node_length(%node), 2) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #return #eq(
    #call tool_byte_at(%data, #call raw_node_start(%node)), 46
  )
}

// A qualified Lain name is still ordinary RawAst: `Namespace.member` is an
// atom, dot, atom sequence.  Meta resolves the namespace; this first lowering
// slice uses the final member as the physical function/constant key while
// retaining the path in the source tree for later namespace diagnostics.
#proc program_operand_name(addr %source, addr %node) -> addr {
  #let %current: addr = %node
  #loop path {
    #let %colon1: addr = #call raw_node_next(%current)
    #if #call meta_atom_equal(%source, %colon1, ":", 1) {
      #let %colon2: addr = #call raw_node_next(%colon1)
      #if #call meta_atom_equal(%source, %colon2, ":", 1) {
        #let %member: addr = #call raw_node_next(%colon2)
        #if #call raw_is_nil(%member) { #return %current }
        #if #ne(#call raw_node_kind(%member), 1) { #return %current }
        %current: addr = %member
        #continue path
      }
    }
    #let %dot: addr = #call raw_node_next(%current)
    #if #call raw_is_nil(%dot) { #return %current }
    #if #call program_is_dot_member(%source, %dot) {
      %current: addr = %dot
      #continue path
    }
    #if #eq(#call program_is_dot(%source, %dot), 0) { #return %current }
    #let %member: addr = #call raw_node_next(%dot)
    #if #call raw_is_nil(%member) { #return %current }
    #if #ne(#call raw_node_kind(%member), 1) { #return %current }
    %current: addr = %member
    #continue path
  }
}

#proc program_is_std_path(addr %source, addr %node) -> i1 {
  #if #eq(#call meta_atom_equal(%source, %node, "std", 3), 0) {
    #return 0
  }
  #let %colon1: addr = #call raw_node_next(%node)
  #let %colon2: addr = #call raw_node_next(%colon1)
  #let %member: addr = #call raw_node_next(%colon2)
  #if #eq(#call meta_atom_equal(%source, %colon1, ":", 1), 0) {
    #return 0
  }
  #if #eq(#call meta_atom_equal(%source, %colon2, ":", 1), 0) {
    #return 0
  }
  #return #eq(#call raw_node_kind(%member), 1)
}

#proc program_operand_group(addr %source, addr %node) -> addr {
  #let %name: addr = #call program_operand_name(%source, %node)
  #let %next: addr = #call raw_node_next(%name)
  #if #call raw_is_nil(%next) { #return %next }
  #if #ne(#call raw_node_kind(%next), 2) { #return #call program_nil() }
  #if #ne(#call raw_node_delimiter(%next), 40) {
    #return #call program_nil()
  }
  #return %next
}

#proc program_is_parenthesized_operand(addr %node) -> i1 {
  #if #eq(#call raw_node_kind(%node), 2) {
    #return #eq(#call raw_node_delimiter(%node), 40)
  }
  #return 0
}

#proc program_parenthesized_inner(addr %node) -> addr {
  #return #call raw_node_first(%node)
}

#proc program_validate_record_literal(
  addr %unit, addr %source, addr %function, addr %node
) -> i32 {
  #call program_unit_set_debug_source_index(
    %unit, #call raw_node_start(%node)
  )
  #call program_unit_set_debug_module_kind(%unit, 400)
  #let %binding: addr = #call program_record_binding_for_literal_in_function(
    %unit, %source, %function, %node
  )
  #if #call raw_is_nil(%binding) {
    #call program_unit_set_debug_module_kind(%unit, 401)
    // The enclosing Meta environment may supply a nominal record type only
    // after its factory is evaluated.  Keep the surface expression valid and
    // defer physical layout resolution to the writer.
    #return 0
  }
  #let %record_source: addr =
    #call program_record_source_for_literal_in_function(
      %unit, %source, %function, %node
    )
  // The binding lookup is the nullable check.  A source object is opaque
  // memory rather than a RawAst node and must not be probed with raw_is_nil.
  #let %group: addr = #call program_record_literal_group(%source, %node)
  #let %field: addr = #call raw_node_first(%group)
  #let %definition_debug: addr = #call program_record_group_for_binding(
    %record_source, %binding
  )
  #if #call raw_is_nil(%definition_debug) {
    #call program_unit_set_debug_module_kind(%unit, 412)
    #return 5108
  }
  #loop fields {
    #if #call raw_is_nil(%field) { #break fields }
    #call program_unit_set_debug_source_index(
      %unit, #call raw_node_start(%field)
    )
    #let %colon: addr = #call raw_node_next(%field)
    #if #call raw_is_nil(%colon) {
      #call program_unit_set_debug_module_kind(%unit, 403)
      #return 5108
    }
    #if #eq(#call meta_atom_equal(%source, %colon, ":", 1), 0) {
      #call program_unit_set_debug_module_kind(%unit, 404)
      #return 5108
    }
    #let %field_def: addr = #call program_record_field_for_node(
      %source, %record_source, %binding, %field
    )
    #if #call raw_is_nil(%field_def) {
      #call program_unit_set_debug_module_kind(%unit, 413)
      #return 5108
    }
    #if #call program_record_literal_has_prior_field(
      %source, %group, %field
    ) {
      #call program_unit_set_debug_module_kind(%unit, 406)
      #return 5108
    }
    #let %value: addr = #call raw_node_next(%colon)
    #if #call raw_is_nil(%value) {
      #call program_unit_set_debug_module_kind(%unit, 407)
      #return 5108
    }
    #let %status: i32 = #call program_validate_value_expression(
      %unit, %source, %function, %value
    )
    #if #ne(%status, 0) {
      #call program_unit_set_debug_source_index(
        %unit, #call raw_node_start(%value)
      )
      #call program_unit_set_debug_module_kind(%unit, 402)
      #return %status
    }
    #let %value_end: addr = #call program_value_expression_end(
      %source, %value
    )
    #let %separator: addr = #call raw_node_next(%value_end)
    #if #call raw_is_nil(%separator) { #break fields }
    #if #eq(#call meta_atom_equal(%source, %separator, ",", 1), 0) {
      #call program_unit_set_debug_module_kind(%unit, 408)
      #return 5108
    }
    %field: addr = #call raw_node_next(%separator)
    #continue fields
  }
  #let %definition: addr = #call program_record_group_for_binding(
    %record_source, %binding
  )
  #let %definition_field: addr = #call raw_node_first(%definition)
  #loop definition_fields {
    #if #call raw_is_nil(%definition_field) { #return 0 }
    #if #call meta_atom_equal(%record_source, %definition_field, ",", 1) {
      %definition_field: addr = #call raw_node_next(%definition_field)
      #continue definition_fields
    }
    #let %definition_colon: addr = #call raw_node_next(%definition_field)
    #if #call raw_is_nil(%definition_colon) {
      #call program_unit_set_debug_module_kind(%unit, 409)
      #return 5108
    }
    #if #eq(
      #call meta_atom_equal(%record_source, %definition_colon, ":", 1),
      0
    ) {
      #call program_unit_set_debug_module_kind(%unit, 420)
      #return 5108
    }
    #if #eq(
      #call program_record_literal_has_field(
        %source, %group,
        %record_source, %definition_field
      ),
      1
    ) { } else {
      #call program_unit_set_debug_module_kind(%unit, 421)
      #return 5108
    }
    #let %definition_type: addr = #call raw_node_next(%definition_colon)
    #if #call raw_is_nil(%definition_type) {
      #call program_unit_set_debug_module_kind(%unit, 422)
      #return 5108
    }
    %definition_field: addr = #call raw_node_next(
      #call program_type_end(
        %record_source, %definition_type
      )
    )
    #continue definition_fields
  }
}

#proc program_operand_end_path(addr %source, addr %node) -> addr {
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %base_end: addr = %group
  #if #call raw_is_nil(%base_end) {
    %base_end: addr = #call program_record_literal_group(
      %source, %node
    )
  }
  #if #call raw_is_nil(%base_end) {
    %base_end: addr = #call program_operand_name(%source, %node)
  }
  #let %current: addr = %base_end
  #loop member_path {
    #let %dot: addr = #call raw_node_next(%current)
    #if #eq(#call raw_node_kind(%dot), 2) {
      #if #eq(#call raw_node_delimiter(%dot), 40) {
        %current: addr = %dot
        #continue member_path
      }
    }
    #if #call program_is_dot_member(%source, %dot) {
      %current: addr = %dot
      #continue member_path
    }
    #if #eq(#call meta_atom_equal(%source, %dot, ".", 1), 0) {
      #return %current
    }
    #let %member: addr = #call raw_node_next(%dot)
    #if #call meta_atom_equal(%source, %member, "*", 1) {
      #return %member
    }
    #if #call raw_is_nil(%member) { #return %current }
    %current: addr = %member
    #continue member_path
  }
}

#proc program_operand_end_source(
  addr %source, addr %node
) -> addr {
  #if #call meta_atom_equal(%source, %node, "-", 1) {
    #let %signed: addr = #call raw_node_next(%node)
    #if #call program_is_decimal(%source, %signed) { #return %signed }
    #return #call program_operand_end_source(%source, %signed)
  }
  #if #call meta_atom_equal(%source, %node, "*", 1) {
    #return #call program_operand_end_source(
      %source, #call raw_node_next(%node)
    )
  }
  #if #call meta_atom_equal(%source, %node, "&", 1) {
    #let %reference: addr = #call raw_node_next(%node)
    #if #call meta_atom_equal(%source, %reference, "mut", 3) {
      %reference: addr = #call raw_node_next(%reference)
    }
    #return #call program_operand_end_source(%source, %reference)
  }
  #if #call meta_atom_equal(%source, %node, "!", 1) {
    #return #call program_operand_end_source(
      %source, #call raw_node_next(%node)
    )
  }
  #if #call program_is_parenthesized_operand(%node) { #return %node }
  #if #call program_is_consteval_operand(%source, %node) {
    #return #call program_consteval_operand_group(%source, %node)
  }
  #return #call program_operand_end_path(%source, %node)
}

#proc program_condition_operand_end(
  addr %source, addr %node
) -> addr {
  #if #call meta_atom_equal(%source, %node, "-", 1) {
    #let %signed: addr = #call raw_node_next(%node)
    #if #call program_is_decimal(%source, %signed) { #return %signed }
  }
  #if #call meta_atom_equal(%source, %node, "*", 1) {
    #return #call program_condition_operand_end(
      %source, #call raw_node_next(%node)
    )
  }
  #if #call meta_atom_equal(%source, %node, "&", 1) {
    #let %reference: addr = #call raw_node_next(%node)
    #if #call meta_atom_equal(%source, %reference, "mut", 3) {
      %reference: addr = #call raw_node_next(%reference)
    }
    #return #call program_condition_operand_end(%source, %reference)
  }
  #if #call program_is_parenthesized_operand(%node) { #return %node }
  // A comparison's right operand is followed by the condition body.  Do not
  // interpret that `{...}` as a record literal; only a call's `(...)` group
  // belongs to the operand here.
  #if #call meta_atom_equal(%source, %node, "!", 1) {
    #return #call program_condition_operand_end(
      %source, #call raw_node_next(%node)
    )
  }
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %base_end: addr = %group
  #if #call raw_is_nil(%base_end) {
    %base_end: addr = #call program_operand_name(%source, %node)
  }
  #let %current: addr = %base_end
  #loop member_path {
    #let %dot: addr = #call raw_node_next(%current)
    #if #eq(#call raw_node_kind(%dot), 2) {
      #if #eq(#call raw_node_delimiter(%dot), 40) {
        %current: addr = %dot
        #continue member_path
      }
    }
    #if #call program_is_dot_member(%source, %dot) {
      %current: addr = %dot
      #continue member_path
    }
    #if #eq(#call meta_atom_equal(%source, %dot, ".", 1), 0) {
      #return %current
    }
    #let %member: addr = #call raw_node_next(%dot)
    #if #call meta_atom_equal(%source, %member, "*", 1) {
      #return %member
    }
    #if #call raw_is_nil(%member) { #return %current }
    %current: addr = %member
    #continue member_path
  }
}

#proc program_condition_expression_end(
  addr %source, addr %left
) -> addr {
  #let %left_end: addr = #call program_condition_operand_end(
    %source, %left
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return %left_end }
  #if #call program_is_semicolon(%source, %operator) {
    #return %left_end
  }
  #if #call meta_atom_equal(%source, %operator, ",", 1) {
    #return %left_end
  }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return %left_end
  }
  #let %operator_end: addr = #call program_condition_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #if #call raw_is_nil(%right) { #return %left_end }
  #return #call program_condition_expression_end(%source, %right)
}

#proc program_validate_condition_expression(
  addr %unit, addr %source, addr %function, addr %left
) -> i32 {
  #let %status: i32 = #call program_validate_condition_operand(
    %unit, %source, %function, %left
  )
  #if #ne(%status, 0) { #return %status }
  #let %left_end: addr = #call program_condition_operand_end(
    %source, %left
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return 0 }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return 0
  }
  #let %operator_end: addr = #call program_condition_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #if #call raw_is_nil(%right) {
    #call program_unit_set_debug_module_kind(%unit, 702)
    #return 5113
  }
  #return #call program_validate_condition_expression(
    %unit, %source, %function, %right
  )
}

#proc program_validate_condition_operand(
  addr %unit, addr %source, addr %function, addr %node
) -> i32 {
  #if #call meta_atom_equal(%source, %node, "!", 1) {
    #return #call program_validate_operand(
      %unit, %source, %function, #call raw_node_next(%node)
    )
  }
  #return #call program_validate_operand(
    %unit, %source, %function, %node
  )
}

#proc program_is_generic_type_name(
  addr %source, addr %node
) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_length(%node), 1) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %byte: i8 = #call tool_byte_at(
    %data, #call raw_node_start(%node)
  )
  #if #lt(#zext[#bits<32>](%byte), 65) { #return 0 }
  #return #le(#zext[#bits<32>](%byte), 90)
}

#proc program_validate_simple_operand(
  addr %source, addr %function, addr %node
) -> i32 {
  #if #call program_is_decimal(%source, %node) { #return 0 }
  #if #call program_is_boolean(%source, %node) { #return 0 }
  // String literals are compile-time values consumed by Meta intrinsics.
  #if #call program_is_string(%source, %node) { #return 0 }
  #if #call program_param_matches(%source, %function, %node) { #return 0 }
  #if #call program_local_matches(%source, %function, %node) { #return 0 }
  // Generic type parameters (`T` in std::func<T>(...)) are compile-time
  // names.  Their concrete layout is supplied by the specialization; this
  // physical pass only needs to keep the expression well-formed.
  #if #call program_is_generic_type_name(%source, %node) { #return 0 }
  #let %constant: addr = #call program_find_constant(
    #call program_function_unit(%function), %source, %node
  )
  #if #eq(#call raw_is_nil(%constant), 0) { #return 0 }
  #call program_unit_set_validation_node(
    #call program_function_unit(%function), %source, %node
  )
  #return 5108
}

#proc program_validate_call(
  addr %unit, addr %source, addr %function,
  addr %callee, addr %group
) -> i32 {
  #call program_unit_set_debug_source_index(
    %unit, #call raw_node_start(%callee)
  )
  #call program_unit_set_debug_module_kind(%unit, 410)
  #if #ge(#call raw_node_start(%callee), 7000) {
    #if #eq(#call program_unit_debug_module_kind(%unit), 291) {
      #call program_unit_set_debug_module_kind(%unit, 320)
    }
  }
  #let %target: addr = #call program_find_function_for_caller(
    %unit, %source, %function, %callee
  )
  #if #call program_function_is_nil(%target) {
    #call program_unit_set_debug_module_kind(%unit, 411)
    #if #ge(#call raw_node_start(%callee), 7000) {
      #call program_unit_set_debug_module_kind(%unit, 321)
    }
    // A qualified call may denote a member supplied by an imported or
    // parameterized Module.  Its namespace is resolved by Meta; this physical
    // slice still validates its value arguments and keeps the call external.
    #if #ne(#call program_name_prefix_length(%source, %callee), 0) {
      #return #call program_validate_std_call(
        %unit, %source, %function, %group
      )
    }
    // An unqualified call must resolve to a physical function in the current
    // source closure.  Leaving it unresolved would emit a verifier-invalid
    // LAIN-IR call and hide a source error until much later.
    #call program_unit_set_validation_function(
      #call program_function_unit(%function), %function
    )
    #call program_unit_set_validation_node(
      #call program_function_unit(%function), %source, %callee
    )
    #return 5108
  }
  // Validation can discover a physical target through a Meta module even
  // when that target was never evaluated as a compile-time call.  Attach the
  // descriptor before emission so the generated direct call always has a
  // verifier-visible procedure definition.
  #call program_append_function_if_missing(%unit, %target)
  #let %ufcs: addr = #call program_find_ufcs_function(
    %unit, %source, %function, %callee
  )
  #let %ufcs_call: i1 = #eq(#call program_function_is_nil(%ufcs), 0)
  #if #ge(#call raw_node_start(%callee), 7000) {
    #call program_unit_set_debug_module_kind(%unit, 322)
  }
  #let %argument: addr = #call raw_node_first(%group)
  #let %count: i64 = 0
  #loop arguments {
    #if #call raw_is_nil(%argument) { #break arguments }
    #let %status: i32 = #call program_validate_value_expression(
      %unit, %source, %function, %argument
    )
    #if #ne(%status, 0) {
      #call program_unit_set_debug_source_index(
        %unit, #call raw_node_start(%argument)
      )
      #call program_unit_set_validation_node(%unit, %source, %argument)
      #return %status
    }
    %count: i64 = #add(%count, 1)
    #let %argument_end: addr = #call program_value_expression_end(
      %source, %argument
    )
    #let %separator: addr = #call raw_node_next(%argument_end)
    #if #call raw_is_nil(%separator) { #break arguments }
    #if #eq(#call meta_atom_equal(%source, %separator, ",", 1), 0) {
      #call program_unit_set_validation_function(
        #call program_function_unit(%function), %function
      )
      #call program_unit_set_validation_node(
        #call program_function_unit(%function), %source, %separator
      )
      #return 5109
    }
    %argument: addr = #call raw_node_next(%separator)
    #if #call raw_is_nil(%argument) { #break arguments }
    #continue arguments
  }
  #let %expected: i64 = #call program_function_count(%target)
  #if %ufcs_call { %expected: i64 = #sub(%expected, 1) }
  #if #ne(%count, %expected) {
    #call program_unit_set_validation_function(
      #call program_function_unit(%function), %function
    )
    #call program_unit_set_validation_node(
      #call program_function_unit(%function), %source, %callee
    )
    #return 5109
  }
  #return 0
}

#proc program_validate_std_call(
  addr %unit, addr %source, addr %function, addr %group
) -> i32 {
  #if #ge(#call raw_node_start(%group), 7000) {
    #call program_unit_set_debug_module_kind(%unit, 330)
  }
  #let %argument: addr = #call raw_node_first(%group)
  #loop arguments {
    #if #call raw_is_nil(%argument) { #return 0 }
    #let %status: i32 = #call program_validate_value_expression(
      %unit, %source, %function, %argument
    )
    #if #ne(%status, 0) {
      #call program_unit_set_debug_source_index(
        %unit, #call raw_node_start(%argument)
      )
      #call program_unit_set_validation_node(
        #call program_function_unit(%function), %source, %argument
      )
      #if #ge(#call raw_node_start(%group), 7000) {
        #call program_unit_set_debug_module_kind(%unit, 331)
      }
      #return %status
    }
    #let %argument_end: addr = #call program_value_expression_end(
      %source, %argument
    )
    #let %separator: addr = #call raw_node_next(%argument_end)
    #if #call raw_is_nil(%separator) { #return 0 }
    #if #eq(#call meta_atom_equal(%source, %separator, ",", 1), 0) {
      #call program_unit_set_validation_function(
        #call program_function_unit(%function), %function
      )
      #call program_unit_set_validation_node(
        #call program_function_unit(%function), %source, %separator
      )
      #if #ge(#call raw_node_start(%group), 7000) {
        #call program_unit_set_debug_module_kind(%unit, 332)
      }
      #return 5109
    }
    %argument: addr = #call raw_node_next(%separator)
    #continue arguments
  }
}

#proc program_is_std_intrinsic_call(
  addr %source, addr %node, addr %name_text, i64 %name_length
) -> i1 {
  #if #call program_is_std_path(%source, %node) {
    #let %name: addr = #call program_operand_name(%source, %node)
    #let %group: addr = #call program_operand_group(%source, %node)
    #if #call raw_is_nil(%group) { #return 0 }
    #return #call meta_atom_equal(
      %source, %name, %name_text, %name_length
    )
  }
  #return 0
}

// A record is physically represented by an address.  `Vec(T)` therefore
// stores one record address per slot when T is a record.  `std::ref_at(T,
// slot)` must load that address before returning it to code that reads the
// record fields.  Explicit `&U` type arguments keep their ordinary reference
// slot semantics and are deliberately excluded here.
#proc program_intrinsic_type_uses_record_slot(
  addr %unit, addr %source, addr %function, addr %type
) -> i1 {
  #let %environment: addr = #call program_function_environment(%function)
  // A Meta environment is not a RawAst node.  Check it through its own tag
  // predicate instead of relying on RawAst layout details.
  #if #call meta_env_is_nil(%environment) { #return 0 }
  #let %value: addr = #call meta_function_type_value(
    %environment, %source, %type
  )
  // Vec's type parameter is declared in its factory environment.  The
  // shared method descriptor can still resolve the spelling `T` to that
  // placeholder, so retrieve the concrete capture from the parent chain.
  #if #call meta_atom_equal(%source, %type, "T", 1) {
    #let %captured: addr = #call meta_lookup_type_parameter_value(
      %environment
    )
    #if #eq(#call meta_value_kind(%captured), 4) {
      %value: addr = %captured
    }
  }
  #if #ne(#call meta_value_kind(%value), 4) { #return 0 }
  #let %concrete_source: addr = #call meta_value_source(%value)
  #let %concrete: addr = #call meta_value_payload(%value)
  #if #call meta_atom_equal(%concrete_source, %concrete, "let", 3) {
    %concrete: addr = #call program_type_binding_value(
      %concrete_source, %concrete
    )
  }
  // A factory-created record keeps the constructor expression as the type
  // value payload (`std::struct { ... }`), rather than the `let Token`
  // declaration.  That expression has neither a builtin width nor a nominal
  // name, so recognize the constructor before the generic physical checks.
  #if #call program_is_std_path(%concrete_source, %concrete) {
    #if #call meta_atom_equal(
      %concrete_source,
      #call program_operand_name(%concrete_source, %concrete), "struct", 6
    ) { #return 1 }
  }
  #if #call meta_type_is_address(%concrete_source, %concrete) { #return 0 }
  #if #ne(
    #call program_type_width_in_unit(%unit, %concrete_source, %concrete), 0
  ) { #return 0 }
  #if #call program_type_is_address_in_unit(
    %unit, %concrete_source, %concrete
  ) { #return 1 }
  // A factory argument can name a record declared in another source before
  // that source's nominal entry has reached this unit's type table.  Its
  // Meta value still carries the defining source, which distinguishes it
  // from the unresolved `T` placeholder in std/core/vec.
  #if #ne(%concrete_source, %source) {
    #if #call meta_type_is_nominal(%concrete_source, %concrete) {
      #return 1
    }
  }
  #return 0
}

#proc program_write_intrinsic_load_bits(
  addr %source, addr %function, addr %node
) -> #unit {
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %width_node: addr = #call raw_node_first(%group)
  #let %width_result: addr = #call program_parse_decimal(
    %source, %width_node
  )
  #let %width: i64 = #call program_result_value(%width_result)
  #let %comma: addr = #call raw_node_next(%width_node)
  #let %address: addr = #call raw_node_next(%comma)
  #call bootstrap.artifact-write-literal("#load[#bits<")
  #call meta_write_decimal(%width)
  #call bootstrap.artifact-write-literal(">]("
  )
  #call program_write_value_expression(%source, %function, %address)
  #call bootstrap.artifact-write-byte(41)
  #return
}

#proc program_intrinsic_size_of(
  addr %unit, addr %source, addr %function, addr %node
) -> i64 {
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %argument: addr = #call raw_node_first(%group)
  #let %environment: addr = #call program_function_environment(%function)
  #if #call meta_env_is_nil(%environment) {
    #return 8
  }
  #let %value: addr = #call meta_env_lookup_path(
    %environment, %source, %argument
  )
  #if #call raw_is_nil(%value) { #return 8 }
  #if #ne(#call meta_value_kind(%value), 4) { #return 8 }
  #let %type_node: addr = #call meta_value_payload(%value)
  #let %width: i64 = #call program_type_width_in_unit(
    %unit, %source, %type_node
  )
  #if #eq(%width, 0) {
    #if #call meta_type_is_address(%source, %type_node) { #return 8 }
    #return 8
  }
  #if #lt(%width, 8) { #return 1 }
  #return #div(%width, 8)
}

#proc program_write_intrinsic_store_bits(
  addr %source, addr %function, addr %node
) -> #unit {
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %width_node: addr = #call raw_node_first(%group)
  #let %comma1: addr = #call raw_node_next(%width_node)
  #let %address: addr = #call raw_node_next(%comma1)
  #let %address_end: addr = #call program_value_expression_end(
    %source, %address
  )
  #let %comma2: addr = #call raw_node_next(%address_end)
  #let %value: addr = #call raw_node_next(%comma2)
  #call bootstrap.artifact-write-literal("#store ")
  #call program_write_value_expression(%source, %function, %value)
  #call bootstrap.artifact-write-literal(", ")
  #call program_write_value_expression(%source, %function, %address)
  #return
}

#proc program_write_intrinsic_store(
  addr %source, addr %function, addr %node
) -> #unit {
  #let %group: addr = #call program_operand_group(%source, %node)
  #let %type: addr = #call raw_node_first(%group)
  #let %comma1: addr = #call raw_node_next(%type)
  #let %address: addr = #call raw_node_next(%comma1)
  #let %address_end: addr = #call program_value_expression_end(
    %source, %address
  )
  #let %comma2: addr = #call raw_node_next(%address_end)
  #let %value: addr = #call raw_node_next(%comma2)
  #call bootstrap.artifact-write-literal("#store ")
  #call program_write_value_expression(%source, %function, %value)
  #call bootstrap.artifact-write-literal(", ")
  #call program_write_value_expression(%source, %function, %address)
  #return
}

#proc program_validate_operand(
  addr %unit, addr %source, addr %function, addr %node
) -> i32 {
  #if #call meta_atom_equal(%source, %node, "*", 1) {
    #let %reference: addr = #call raw_node_next(%node)
    #if #call raw_is_nil(%reference) { #return 5108 }
    #return #call program_validate_operand(
      %unit, %source, %function, %reference
    )
  }
  #if #call meta_atom_equal(%source, %node, "-", 1) {
    #let %signed: addr = #call raw_node_next(%node)
    #if #call program_is_decimal(%source, %signed) { #return 0 }
    #return #call program_validate_operand(
      %unit, %source, %function, %signed
    )
  }
  #if #call meta_atom_equal(%source, %node, "&", 1) {
    #let %reference: addr = #call raw_node_next(%node)
    #if #call meta_atom_equal(%source, %reference, "mut", 3) {
      %reference: addr = #call raw_node_next(%reference)
    }
    #if #call raw_is_nil(%reference) { #return 5108 }
    #return #call program_validate_operand(
      %unit, %source, %function, %reference
    )
  }
  #if #call program_is_parenthesized_operand(%node) {
    #let %inner: addr = #call program_parenthesized_inner(%node)
    #if #call raw_is_nil(%inner) { #return 5106 }
    #return #call program_validate_value_expression(
      %unit, %source, %function, %inner
    )
  }
  #if #call program_is_consteval_operand(%source, %node) {
    #let %consteval: addr = #call program_eval_consteval_group(
      %unit, %source, #call program_consteval_operand_group(%source, %node)
    )
    #return #call eval_status(%consteval)
  }
  #let %name: addr = #call program_operand_name(%source, %node)
  #if #call meta_atom_equal(%source, %name, "!", 1) {
    #return #call program_validate_operand(
      %unit, %source, %function, #call raw_node_next(%node)
    )
  }
  #if #call program_is_string(%source, %name) { #return 0 }
  #let %environment: addr = #call program_unit_meta_environment(%unit)
  #let %function_environment: addr =
    #call program_function_environment(%function)
  #if #eq(#call raw_is_nil(%function_environment), 0) {
    %environment: addr = %function_environment
  }
  #let %meta_value: addr = #call meta_env_lookup_path(
    %environment, %source, %node
  )
  #if #eq(#call raw_is_nil(%meta_value), 0) {
    #if #eq(#call meta_value_kind(%meta_value), 1) { #return 0 }
  }
  #if #call program_is_record_literal(%source, %node) {
    #let %record_binding: addr = #call program_record_binding_for_literal_in_function(
      %unit, %source, %function, %node
    )
    #if #eq(#call raw_is_nil(%record_binding), 0) {
      #return #call program_validate_record_literal(
        %unit, %source, %function, %node
      )
    }
    // A nominal record value can be introduced by a compile-time factory
    // before its physical descriptor is visible in the unit table.  It is
    // still a valid operand; defer layout checks until the writer has the
    // enclosing Meta value available instead of treating the literal name as
    // an unresolved runtime call.
    #return 0
  }
  // The lexer keeps a post-call member such as `.next_sibling` as one atom.
  // Its base call was validated separately; the member itself is a physical
  // field expression and does not need a second symbol lookup here.
  #if #call program_is_dot_member(%source, %name) { #return 0 }
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #ge(#call raw_node_start(%node), 7000) {
    #call program_unit_set_debug_source_index(
      %unit, #call raw_node_start(%node)
    )
    #if #eq(#call raw_node_start(%node), 7385) {
      #call program_unit_set_debug_module_kind(%unit, 350)
    } else {
    #if #eq(#call raw_node_start(%node), 7451) {
      #call program_unit_set_debug_module_kind(%unit, 351)
    } else {
    #if #eq(#call raw_node_start(%node), 7503) {
      #call program_unit_set_debug_module_kind(%unit, 352)
    } else {
    #if #call raw_is_nil(%group) {
      #call program_unit_set_debug_module_kind(%unit, 340)
    } else {
      #call program_unit_set_debug_module_kind(%unit, 341)
    }
    }
    }
    }
  }
  #if #eq(#call raw_is_nil(%group), 0) {
    #if #call program_is_std_path(%source, %node) {
      #return #call program_validate_std_call(
        %unit, %source, %function, %group
      )
    }
    #if #ne(#call raw_node_kind(%name), 1) {
      #call program_unit_set_validation_node(
        #call program_function_unit(%function), %source, %name
      )
      #return 5108
    }
    // Keep the complete qualified operand for Meta lookup.  `%name` is only
    // the final member (`push` in `ByteVector.push`); using it here loses the
    // type/module namespace that owns the specialized closure environment.
    #let %lookup_node: addr = %name
    #if #ne(#call program_name_prefix_length(%source, %node), 0) {
      %lookup_node: addr = %node
    }
    #let %call_status: i32 = #call program_validate_call(
      %unit, %source, %function, %lookup_node, %group
    )
    #if #ne(%call_status, 0) {
      #if #ge(#call raw_node_start(%node), 7000) {
        #call program_unit_set_debug_module_kind(%unit, 371)
      }
    }
    #return %call_status
  }
  #if #ne(#call program_name_prefix_length(%source, %name), 0) {
    #let %field_status: i32 = #call program_validate_field_operand(
      %unit, %source, %function, %name
    )
    #if #eq(%field_status, 0) { #return 0 }
    #if #ge(#call raw_node_start(%node), 7000) {
      #call program_unit_set_debug_module_kind(%unit, 370)
    }
    #return %field_status
  }
  #let %simple_status: i32 = #call program_validate_simple_operand(
    %source, %function, %name
  )
  #if #ne(%simple_status, 0) {
    #if #ge(#call raw_node_start(%node), 7000) {
      #call program_unit_set_debug_module_kind(%unit, 372)
    }
  }
  #return %simple_status
}

#proc program_validate_expression(
  addr %unit, addr %source, addr %function
) -> i32 {
  #let %body: addr = #call program_function_body(%function)
  #let %first: addr = #call raw_node_first(%body)
  #call program_unit_set_debug_source_index(
    %unit, #call program_function_name_start(%function)
  )
  #if #call raw_is_nil(%first) {
    #if #call program_function_returns_unit(%source, %function) {
      #return 0
    }
    #return 5106
  }
  // A block may end in a value expression without an explicit `return`.
  // This is still ordinary expression lowering; the surface language decides
  // whether the value is type-correct in a later elaboration pass.
  #if #eq(#call meta_atom_equal(%source, %first, "let", 3), 0) {
    #if #eq(#call meta_atom_equal(%source, %first, "while", 5), 0) {
      #if #eq(#call meta_atom_equal(%source, %first, "return", 6), 0) {
        #if #eq(#call meta_atom_equal(%source, %first, "if", 2), 0) {
          #if #eq(#call meta_atom_equal(%source, %first, "*", 1), 0) {
            #if #eq(
              #call program_is_assignment_statement(%source, %first), 0
            ) {
              #return #call program_validate_value_expression(
                %unit, %source, %function, %first
              )
            }
          }
        }
      }
    }
  }
  #let %statement: addr = %first
  #loop statements {
    #if #call raw_is_nil(%statement) {
      #if #call program_function_returns_unit(%source, %function) {
        #return 0
      }
      #return 5106
    }
    #call program_unit_set_debug_source_index(
      %unit, #call raw_node_start(%statement)
    )
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %status: i32 = #call program_validate_local(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) {
        #return %status
      }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "while", 5) {
      #let %status: i32 = #call program_validate_while(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) {
        #return %status
      }
      #let %loop_body: addr = #call program_while_body(%source, %statement)
      %statement: addr = #call raw_node_next(%loop_body)
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "if", 2) {
      #let %if_statement: addr = %statement
      #let %status: i32 = #call program_validate_if(
        %unit, %source, %function, %statement
      )
      #if #ne(%status, 0) {
        #return %status
      }
      %statement: addr = #call program_if_after(%source, %statement)
      #if #call raw_is_nil(%statement) {
        #if #call program_if_has_else(%source, %if_statement) { #return 0 }
        #if #call program_function_returns_unit(%source, %function) {
          #return 0
        }
        #return 5106
      }
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "return", 6) {
      #return #call program_validate_return_statement(
        %unit, %source, %function, %statement
      )
    }
    #if #call meta_atom_equal(%source, %statement, "*", 1) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call program_is_assignment_statement(%source, %statement) {
      #let %assignment_status: i32 = #call program_validate_assignment(
        %unit, %source, %function, %statement
      )
      #if #ne(%assignment_status, 0) {
        #return %assignment_status
      }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #let %statement_status: i32 = #call program_validate_value_expression(
      %unit, %source, %function, %statement
    )
    #if #ne(%statement_status, 0) {
      #call program_unit_set_validation_node(%unit, %source, %statement)
      #return %statement_status
    }
    #let %statement_end: addr = #call program_value_expression_end(
      %source, %statement
    )
    #let %tail: addr = #call raw_node_next(%statement_end)
    #if #call raw_is_nil(%tail) { #return 0 }
    #if #call program_is_semicolon(%source, %tail) {
      %statement: addr = #call raw_node_next(%tail)
      #continue statements
    }
    #call program_unit_set_validation_node(%unit, %source, %statement)
    #return 5106
  }
}

#proc program_force_register_local_type(
  addr %unit, addr %source, i64 %source_index, addr %let_node
) -> i32 {
  #let %name: addr = #call raw_node_next(%let_node)
  #let %value: addr = #call program_type_binding_value(%source, %let_node)
  #if #call raw_is_nil(%name) { #return 0 }
  #if #call raw_is_nil(%value) { #return 0 }
  #let %type: addr = #call program_type_new(
    %source, %name, #call program_type_width(%source, %value),
    0, %source_index, %let_node
  )
  #call program_append_type(%unit, %type)
  #return 0
}

#proc program_collect_local_types_tree(
  addr %unit, addr %source, i64 %source_index, addr %group
) -> i32 {
  #let %node: addr = #call raw_node_first(%group)
  #loop nodes {
    #if #call raw_is_nil(%node) { #return 0 }
    #if #call meta_atom_equal(%source, %node, "let", 3) {
      #if #call program_is_type_binding(%source, %node) {
        #let %status: i32 = #call program_force_register_local_type(
          %unit, %source, %source_index, %node
        )
        #if #ne(%status, 0) { #return %status }
      }
    }
    #if #eq(#call raw_node_kind(%node), 2) {
      #let %status: i32 = #call program_collect_local_types_tree(
        %unit, %source, %source_index, %node
      )
      #if #ne(%status, 0) { #return %status }
    }
    %node: addr = #call raw_node_next(%node)
    #continue nodes
  }
}

#proc program_collect_local_types(
  addr %unit, addr %source, addr %root, i64 %source_index
) -> i32 {
  #return #call program_collect_local_types_tree(
    %unit, %source, %source_index, %root
  )
}

#proc program_validate(
  addr %unit, addr %source, i1 %require_main
) -> i32 {
  #let %main: addr = #call program_find_function_text(
    %unit, %source, "main", 4
  )
  #if %require_main {
    #if #call program_function_is_nil(%main) {
      #return 5101
    }
    #if #ne(#call program_function_count(%main), 0) { #return 5111 }
    #if #eq(
      #call meta_atom_equal(
        #call program_function_source(%main),
        #load[addr](#lea(base=%main, idx=0, scale=0, offset=24)),
        "i32", 3
      ),
      0
    ) { #return 5112 }
  }
  #let %function: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%function) { #break functions }
    #let %status: i32 = #call program_function_status(%function)
    #if #ne(%status, 0) {
      #call program_unit_set_validation_function(%unit, %function)
      #return %status
    }
    #if #eq(
      #call program_function_is_external(
        #call program_function_source(%function), %function
      ),
      0
    ) {
      #if #call program_function_is_meta(
        #call program_function_source(%function), %function
      ) {
      } else {
      %status: i32 = #call program_validate_expression(
        %unit, #call program_function_source(%function), %function
      )
      }
    }
    #if #ne(%status, 0) {
      #call program_unit_set_validation_function(%unit, %function)
      #return %status
    }
    %function: addr = #load[addr](
      #lea(base=%function, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
  #return 0
}

#proc program_is_post_call_member(
  addr %source, addr %node
) -> i1 {
  // Synthetic call-path nodes carry token kind 3 and a linked argument group
  // so the resolver can inspect their arguments.  They are already the call
  // base; treating their following group as a second projection re-enters
  // value lowering recursively.
  #if #eq(#call raw_node_token_kind(%node), 3) {
    #return 0
  }
  // `value.member(args).field` is represented by a call group followed by
  // one `.field` atom.  Plain record access (`value.field`) has no group and
  // must stay on the ordinary field writer path.
  #return #eq(
    #call raw_is_nil(#call program_post_call_member_node(%source, %node)),
    0
  )
}

#proc program_is_upper_module_path(addr %source, addr %node) -> i1 {
  #let %data: addr = #call tool_source_data(%source)
  #let %byte: i8 = #call tool_byte_at(
    %data, #call raw_node_start(%node)
  )
  #if #ge(#zext[#bits<32>](%byte), 65) {
    #if #le(#zext[#bits<32>](%byte), 90) { #return 1 }
  }
  #return 0
}

// Return the member node after a call, accepting both lexer forms:
// `call().field` can be one `.field` atom or three nodes (`.`, `field`).
// The returned span never contains the leading dot, which lets record lookup
// compare it directly with the field declaration.
#proc program_post_call_member_node(
  addr %source, addr %node
) -> addr {
  // The initial node may be the first segment of a dotted path, while the
  // call group belongs to a later segment (`workspace.sources.get(i)`).
  // Walk the path until its first argument group, then inspect only the
  // sibling immediately after that group for the projection.
  #let %current: addr = %node
  #let %steps: i64 = 0
  #loop path {
    #if #ge(%steps, 64) { #return #call program_nil() }
    #let %next: addr = #call raw_node_next(%current)
    #if #call raw_is_nil(%next) { #return #call program_nil() }
    // Do not let a later argument's call group turn an earlier argument into
    // a post-call projection.  RawAst stores the whole argument list in one
    // sibling chain, so the comma is the boundary for this path walk.
    #if #call meta_atom_equal(%source, %next, ",", 1) {
      #return #call program_nil()
    }
    #if #call meta_atom_equal(%source, %next, ";", 1) {
      #return #call program_nil()
    }
    // Inspect the raw sibling chain directly.  `program_operand_name` walks
    // all the way to the final member, so using `program_operand_group` here
    // would skip the group attached to an earlier member such as `get`.
    #if #eq(#call raw_node_kind(%next), 2) {
      #if #eq(#call raw_node_delimiter(%next), 40) {
        #let %after: addr = #call raw_node_next(%next)
        #if #call program_is_dot_member(%source, %after) {
          #return #call raw_node_new(
            1, 0,
            #add(#call raw_node_start(%after), 1),
            #sub(#call raw_node_length(%after), 1),
            3
          )
        }
        #if #call program_is_dot(%source, %after) {
          #let %member: addr = #call raw_node_next(%after)
          #if #eq(#call raw_node_kind(%member), 1) { #return %member }
        }
        #return #call program_nil()
      }
    }
    %current: addr = %next
    %steps: i64 = #add(%steps, 1)
    #continue path
  }
}

#proc program_post_call_base_node(
  addr %source, addr %node
) -> addr {
  // Build a standalone span for the call path, then attach the original
  // argument group as its synthetic next sibling.  The span is needed for
  // Meta lookup (`Syntax.node`); the group link is needed by the ordinary
  // call writer (`program_operand_group`).  A bare raw_node_new result has a
  // nil next pointer, which used to make the writer lose the call group and
  // emit an undefined receiver such as `%node`.
  #let %start: i64 = #call raw_node_start(%node)
  #let %current: addr = %node
  #let %steps: #bits<32> = 0
  #loop path {
    #if #ge(%steps, 16) { #break path }
    #if #eq(#call raw_node_kind(%current), 1) {
      #let %after: addr = #call raw_node_next(%current)
      #if #eq(#call raw_node_kind(%after), 2) {
        #if #eq(#call raw_node_delimiter(%after), 40) {
          #let %finish: i64 = #add(
            #call raw_node_start(%current),
            #call raw_node_length(%current)
          )
          #let %result: addr = #call raw_node_new(
            1, 0, %start, #sub(%finish, %start), 3
          )
          #call raw_node_set_next(%result, %after)
          #return %result
        }
      }
    }
    %current: addr = #call raw_node_next(%current)
    %steps: #bits<32> = #add(%steps, 1)
    #if #call raw_is_nil(%current) { #break path }
    #continue path
  }
  #return #call program_nil()
}

// The first executable backend maps the Allocation policy to one persistent
// interpreter arena per value.  Allocation is still represented by ordinary
// Lain source calls; this adapter is the runtime implementation of that
// effect until the host callback ABI is wired through the Lain backend.
//
// `resize` deliberately keeps the original block.  Each initial allocation
// reserves enough space for the current bootstrap compiler, so preserving the
// block also preserves existing Vec contents across logical capacity growth.
#proc program_is_allocation_policy_path(
  addr %source, addr %node
) -> i1 {
  // A normal RawAst path starts at the `Allocation` atom.  Some call-site
  // helpers instead hand the writer one synthetic atom spanning the complete
  // `Allocation.member` text, so accept both representations.
  #if #call meta_atom_equal(%source, %node, "Allocation", 10) {
    #return 1
  }
  #let %length: i64 = #call raw_node_length(%node)
  #if #lt(%length, 11) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %start: i64 = #call raw_node_start(%node)
  #if #ne(#call tool_byte_at(%data, %start), 65) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 1)), 108) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 2)), 108) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 3)), 111) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 4)), 99) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 5)), 97) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 6)), 116) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 7)), 105) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 8)), 111) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 9)), 110) { #return 0 }
  #return #eq(#call tool_byte_at(%data, #add(%start, 10)), 46)
}

#proc program_write_allocation_policy_call(
  addr %source, addr %function, addr %node
) -> i1 {
  #if #eq(#call program_is_allocation_policy_path(%source, %node), 0) {
    #return 0
  }
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #call raw_is_nil(%group) { #return 0 }
  // Qualified source paths are one RawAst atom (`Allocation.resize`), not
  // atom/dot/atom nodes.  Extract the final member before comparing it with
  // the runtime policy operation names.
  #let %target_name: addr = #call raw_node_new(
    1, 0, #call program_name_start(%source, %node),
    #call program_name_length(%source, %node), 3
  )
  #let %first: addr = #call raw_node_first(%group)
  #if #call meta_atom_equal(%source, %target_name, "address", 7) {
    #call program_write_operand(%source, %function, %first)
    #return 1
  }
  #if #call meta_atom_equal(%source, %target_name, "empty", 5) {
    #call bootstrap.artifact-write-literal("#alloca(1048576)")
    #return 1
  }
  #if #call meta_atom_equal(%source, %target_name, "is_empty", 8) {
    #call bootstrap.artifact-write-literal("#eq(")
    #call program_write_operand(%source, %function, %first)
    #call bootstrap.artifact-write-literal(", #int2ptr(0))")
    #return 1
  }
  #if #call meta_atom_equal(%source, %target_name, "allocate", 8) {
    #call bootstrap.artifact-write-literal("#alloca(1048576)")
    #return 1
  }
  #if #call meta_atom_equal(%source, %target_name, "resize", 6) {
    #call program_write_operand(%source, %function, %first)
    #return 1
  }
  #if #call meta_atom_equal(%source, %target_name, "release", 7) {
    #call bootstrap.artifact-write-literal("0")
    #return 1
  }
  #return 0
}

#proc program_write_operand_base(
  addr %source, addr %function, addr %node
) -> #unit {
  #if #call meta_atom_equal(%source, %node, "*", 1) {
    #let %value: addr = #call raw_node_next(%node)
    // References to records are represented by their address in LAIN-IR.
    // Dereferencing `*values.get(i)` must keep that address; loading i64
    // would turn the record pointer into a scalar and break the following
    // vector push.  Resolve the specialized element type before choosing a
    // scalar load.
    #let %target: addr = #call program_find_function_for_caller(
      #call program_function_unit(%function), %source, %function, %value
    )
    #if #eq(#call program_function_is_nil(%target), 0) {
      #let %target_source: addr = #call program_function_source(%target)
      #let %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
      #let %element_type: addr = %return_type
      #if #call meta_atom_equal(%target_source, %return_type, "&", 1) {
        %element_type: addr = #call raw_node_next(%return_type)
        #if #call meta_atom_equal(
          %target_source, %element_type, "mut", 3
        ) {
          %element_type: addr = #call raw_node_next(%element_type)
        }
      }
      #let %target_environment: addr = #call program_function_environment(
        %target
      )
      #let %element_text: addr = #lea(
        base=#call tool_source_data(%target_source),
        idx=#call raw_node_start(%element_type), scale=1, offset=0
      )
      #let %element_value: addr = #call meta_env_lookup_text(
        %target_environment, %target_source, %element_text,
        #call raw_node_length(%element_type)
      )
      // The physical `get` descriptor is shared by Vec specializations, so
      // its own environment can leave `T` unresolved.  The receiver carries
      // the concrete factory environment (`Vec(ExprId)`, `Vec(SourceUnit)`,
      // ...); recover T there before choosing the dereference load width.
      #let %receiver: addr = #call program_ufcs_receiver_node(
        %source, %value
      )
      #let %receiver_value: addr = #call program_call_argument_type_value(
        #call program_function_unit(%function), %source, %function,
        %receiver
      )
      #if #eq(#call meta_value_kind(%receiver_value), 4) {
        #let %receiver_environment: addr = #call meta_value_environment(
          %receiver_value
        )
        #let %receiver_element: addr = #call meta_lookup_concrete_type_value(
          %receiver_environment, %source
        )
        #if #ne(#call meta_value_kind(%receiver_element), 4) {
          %receiver_element: addr = #call meta_lookup_type_parameter_value(
            %receiver_environment
          )
        }
        #if #eq(#call meta_value_kind(%receiver_element), 4) {
          %element_value: addr = %receiver_element
        }
      }
      // `get` returns a reference.  Dereferencing it loads one element using
      // the element's physical representation.  Record values are represented
      // by `addr`; scalar builtins keep their concrete bit width.
      #call bootstrap.artifact-write-literal("#load[")
      #if #call program_write_meta_value_type(
        #call program_function_unit(%target), %element_value
      ) {
      } else {
      #if #call program_write_resolved_function_type(
        #call program_function_unit(%target), %target_source, %target,
        %element_type
      ) {
      } else {
        #call program_write_type(
          #call program_function_unit(%target), %target_source, %element_type
        )
      }
      }
      #call bootstrap.artifact-write-literal("](")
      #call program_write_operand(%source, %function, %value)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    #call bootstrap.artifact-write-literal("#load[i64](")
    #call program_write_operand(%source, %function, %value)
    #call bootstrap.artifact-write-byte(41)
    #return
  }
  #if #call meta_atom_equal(%source, %node, "-", 1) {
    #let %signed: addr = #call raw_node_next(%node)
    #if #call program_is_decimal(%source, %signed) {
      // LAIN-IR literals do not accept a leading minus.  Lower every
      // negative decimal to the ordinary arithmetic form.
      #call bootstrap.artifact-write-literal("#sub(0, ")
      #call meta_write_span(
        %source, #call raw_node_start(%signed),
        #call raw_node_length(%signed)
      )
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    // Integer literals default to the machine width in LAIN-IR.  Give the
    // zero operand the same width as a typed local/parameter so `-i32`
    // remains a `bits<32>` expression at a call boundary.
    #let %signed_type: addr = #call program_record_type_for_field(
      %source, %function, %signed
    )
    #let %signed_width: i64 = #call program_type_width_in_unit(
      #call program_function_unit(%function), %source, %signed_type
    )
    #if #ne(%signed_width, 0) {
      #if #lt(%signed_width, 64) {
        #call bootstrap.artifact-write-literal("#sub(#trunc[#bits<")
        #call meta_write_decimal(%signed_width)
        #call bootstrap.artifact-write-literal(">](0), ")
        #call program_write_value_expression(%source, %function, %signed)
        #call bootstrap.artifact-write-byte(41)
        #return
      }
    }
    #call bootstrap.artifact-write-literal("#sub(0, ")
    #call program_write_value_expression(%source, %function, %signed)
    #call bootstrap.artifact-write-byte(41)
    #return
  }
  #if #call meta_atom_equal(%source, %node, "&", 1) {
    #let %reference: addr = #call raw_node_next(%node)
    #if #call meta_atom_equal(%source, %reference, "mut", 3) {
      %reference: addr = #call raw_node_next(%reference)
    }
    #call program_write_operand(%source, %function, %reference)
    #return
  }
  #if #call program_is_parenthesized_operand(%node) {
    #call program_write_value_expression(
      %source, %function, #call program_parenthesized_inner(%node)
    )
    #return
  }
  #if #call program_is_consteval_operand(%source, %node) {
    #let %consteval: addr = #call program_eval_consteval_group(
      #call program_function_unit(%function), %source,
      #call program_consteval_operand_group(%source, %node)
    )
    #call meta_write_decimal(#call eval_value(%consteval))
    #return
  }
  #if #call program_is_std_intrinsic_call(
    %source, %node, "load_bits", 9
  ) {
    #call program_write_intrinsic_load_bits(%source, %function, %node)
    #return
  }
  #if #call program_is_std_intrinsic_call(
    %source, %node, "store", 5
  ) {
    #call program_write_intrinsic_store(%source, %function, %node)
    #return
  }
  #if #call program_is_std_intrinsic_call(
    %source, %node, "usize_max", 9
  ) {
    // `usize_max` is a pure target-width sentinel.  Keep it in LAIN-IR so
    // callers do not depend on a host-side helper symbol.
    #call bootstrap.artifact-write-literal("#sub(0, 1)")
    #return
  }
  #if #call program_is_std_intrinsic_call(
    %source, %node, "size_of", 7
  ) {
    #call meta_write_decimal(
      #call program_intrinsic_size_of(
        #call program_function_unit(%function), %source, %function, %node
      )
    )
    #return
  }
  #if #call program_is_std_intrinsic_call(
    %source, %node, "align_of", 8
  ) {
    #call bootstrap.artifact-write-literal("8")
    #return
  }
  #if #call meta_atom_equal(
    %source, #call program_operand_name(%source, %node),
    "dangling_ref", 12
  ) {
    #call bootstrap.artifact-write-literal("#alloca(1)")
    #return
  }
  #if #call meta_atom_equal(
    %source, #call program_operand_name(%source, %node),
    "dangling_mut_ref", 16
  ) {
    #call bootstrap.artifact-write-literal("#alloca(1)")
    #return
  }
  #if #call meta_atom_equal(
    %source, #call program_operand_name(%source, %node), "ref_at", 6
  ) {
    #let %group: addr = #call program_operand_group(%source, %node)
    #let %type: addr = #call raw_node_first(%group)
    #let %comma: addr = #call raw_node_next(%type)
    #let %address: addr = #call raw_node_next(%comma)
    #if #call program_intrinsic_type_uses_record_slot(
      #call program_function_unit(%function), %source, %function, %type
    ) {
      #call bootstrap.artifact-write-literal("#load[addr](")
      #call program_write_value_expression(%source, %function, %address)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    #call program_write_value_expression(%source, %function, %address)
    #return
  }
  #if #call meta_atom_equal(
    %source, #call program_operand_name(%source, %node),
    "mut_ref_at", 10
  ) {
    #let %group: addr = #call program_operand_group(%source, %node)
    #let %type: addr = #call raw_node_first(%group)
    #let %comma: addr = #call raw_node_next(%type)
    #let %address: addr = #call raw_node_next(%comma)
    #if #call program_intrinsic_type_uses_record_slot(
      #call program_function_unit(%function), %source, %function, %type
    ) {
      #call bootstrap.artifact-write-literal("#load[addr](")
      #call program_write_value_expression(%source, %function, %address)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    #call program_write_value_expression(%source, %function, %address)
    #return
  }
  #if #call program_write_allocation_policy_call(
    %source, %function, %node
  ) { #return }
  #if #call program_is_policy_path(%source, %node) {
    #let %member: addr = #call program_operand_name(%source, %node)
    #if #call meta_atom_equal(%source, %member, "address", 7) {
      #let %group: addr = #call program_operand_group(%source, %node)
      #call program_write_operand(
        %source, %function, #call raw_node_first(%group)
      )
      #return
    }
    #if #call meta_atom_equal(%source, %member, "empty", 5) {
      #call bootstrap.artifact-write-literal("#alloca(1)")
    } else {
      #if #call meta_atom_equal(%source, %member, "allocate", 8) {
        #call bootstrap.artifact-write-literal("#alloca(1)")
      } else {
        #if #call meta_atom_equal(%source, %member, "resize", 6) {
          #call bootstrap.artifact-write-literal("#alloca(1)")
        } else {
          // Policy checks, releases, and overflow paths are effect exits.  A
          // later handler-aware backend can replace this neutral scalar.
          #call bootstrap.artifact-write-literal("0")
        }
      }
    }
    #return
  }
  #if #call program_is_string(%source, %node) {
    #call meta_write_span(
      %source, #call raw_node_start(%node), #call raw_node_length(%node)
    )
    #return
  }
  // Calls must be recognized before looking up a path as a compile-time
  // scalar.  A nested UFCS path such as `effects.keys.get(...)` can have a
  // Meta binding for the prefix; treating that binding as the value of the
  // whole call silently emitted `0` instead of the physical call expression.
  #let %group: addr = #call program_operand_group(%source, %node)
  #if #call raw_is_nil(%group) {
    #let %environment: addr = #call program_unit_meta_environment(
      #call program_function_unit(%function)
    )
    #let %function_environment: addr =
      #call program_function_environment(%function)
    #if #eq(#call raw_is_nil(%function_environment), 0) {
      %environment: addr = %function_environment
    }
    #let %meta_value: addr = #call meta_env_lookup_path(
      %environment, %source, %node
    )
    #if #eq(#call raw_is_nil(%meta_value), 0) {
      #if #eq(#call meta_value_kind(%meta_value), 1) {
        #call meta_write_decimal(
          #call meta_value_scalar_number(%meta_value)
        )
        #return
      }
    }
  }
  #if #call program_is_record_literal(%source, %node) {
    #let %record_binding: addr = #call program_record_binding_for_literal_in_function(
      #call program_function_unit(%function), %source, %function, %node
    )
    #if #eq(#call raw_is_nil(%record_binding), 0) {
      // The statement writer has already materialized this literal.  Here it
      // is only a value expression, so pass the initialized temporary.
      #call program_write_record_base(%source, %node, 1)
      #return
    }
  }
  #let %name: addr = #call program_operand_name(%source, %node)
  #let %is_call: i1 = #eq(#call raw_is_nil(%group), 0)
  #if #eq(%is_call, 0) {
    #let %constant: addr = #call program_find_constant(
      #call program_function_unit(%function), %source, %name
    )
    #if #eq(#call raw_is_nil(%constant), 0) {
      #call meta_write_decimal(#call program_constant_value(%constant))
      #return
    }
  }
  #if #call program_is_decimal(%source, %name) {
    #let %parsed: addr = #call program_parse_decimal(%source, %name)
    #call meta_write_decimal(#call program_result_value(%parsed))
    #return
  }
  #if #call program_is_boolean(%source, %name) {
    #call meta_write_decimal(#call program_boolean_value(%source, %name))
    #return
  }
  #if #eq(#call raw_is_nil(%group), 1) {
    #if #eq(#call program_is_upper_module_path(%source, %node), 0) {
    // Keep the original path node here.  `program_operand_name` returns the
    // final member (`contents`), so using it for lookup loses the receiver
    // and falls through to an invalid bare `%contents` operand.  The field
    // writer has its own unresolved-descriptor fallback and must receive the
    // complete `value.contents` node even when Meta has not materialized the
    // record binding yet.
    #let %field_node: addr = #call program_field_path_node(%source, %node)
    #if #ne(#call program_name_prefix_length(%source, %field_node), 0) {
      #call program_write_field_operand(
        #call program_function_unit(%function), %source, %function,
        %field_node
      )
      #return
    }
    }
  }
  #if #call raw_is_nil(%group) {
    #call bootstrap.artifact-write-byte(37)
    #call meta_write_span(
      %source, #call program_name_start(%source, %name),
      #call program_name_length(%source, %name)
    )
    #return
  }
  #call bootstrap.artifact-write-literal("#call ")
  // Resolve qualified targets from the complete path.  The emitted label
  // still uses the final member name.  Plain calls keep the original lookup
  // node so ordinary function binding remains unchanged.
  #let %lookup_node: addr = %name
  #if #ne(#call program_name_prefix_length(%source, %node), 0) {
    %lookup_node: addr = %node
  } else {
    #if #call program_is_dot_member(%source, %name) {
      %lookup_node: addr = %node
    }
  }
  %lookup_node: addr = #call program_call_path_node(%source, %lookup_node)
  #let %target: addr = #call program_find_function_for_caller(
    #call program_function_unit(%function), %source, %function, %lookup_node
  )
  #if #call program_function_is_nil(%target) {
  } else {
    // The target may come from a Meta module that was never evaluated as a
    // compile-time call.  Attach it before writing the call label; otherwise
    // the emitted LAIN-IR refers to a descriptor that never reaches the
    // module's physical procedure list.
    #call program_append_function_if_missing(
      #call program_function_unit(%function), %target
    )
  }
  // A module-qualified call has no runtime receiver.  Its normal argument
  // list starts at the original group, and the call is emitted directly.
  #let %module_call: i1 = #call program_is_upper_module_path(
    %source, %lookup_node
  )
  // Module aliases may be lower-case (`math.add`).  Query the complete
  // receiver prefix in the function's Meta environment so only runtime
  // record receivers receive an implicit argument.
  #if #eq(%module_call, 0) {
    #let %call_environment: addr = #call program_function_environment(
      %function
    )
    #let %receiver: addr = #call program_ufcs_receiver_node(
      %source, %lookup_node
    )
    #if #eq(#call raw_is_nil(%receiver), 0) {
      #let %receiver_value: addr = #call meta_env_lookup_path(
        %call_environment, %source, %receiver
      )
      #if #eq(#call raw_is_nil(%receiver_value), 0) {
        #if #eq(#call meta_value_kind(%receiver_value), 2) {
          %module_call: i1 = 1
        }
      }
    }
  }
  #if #call program_function_is_nil(%target) {
    #call meta_write_span(
      %source, #call program_name_start(%source, %name),
      #call program_name_length(%source, %name)
    )
  } else {
    #call program_write_function_label(
      #call program_function_unit(%function), %target
    )
  }
  #call bootstrap.artifact-write-byte(40)
  #let %ufcs: addr = #call program_find_ufcs_function(
    #call program_function_unit(%function), %source, %function, %lookup_node
  )
  #let %ufcs_call: i1 = #eq(#call program_function_is_nil(%ufcs), 0)
  // A module call and a UFCS call can share the same spelling when the
  // parser's path span starts at an argument expression.  The physical
  // target's arity disambiguates them: a real UFCS call has one implicit
  // receiver more than the explicit argument group.
  #if %ufcs_call {
    #let %explicit_count: i64 = 0
    #let %explicit: addr = #call raw_node_first(%group)
    #loop explicit_arguments {
      #if #call raw_is_nil(%explicit) { #break explicit_arguments }
      %explicit_count: i64 = #add(%explicit_count, 1)
      #let %explicit_end: addr = #call program_value_expression_end(
        %source, %explicit
      )
      #let %separator: addr = #call raw_node_next(%explicit_end)
      #if #call raw_is_nil(%separator) { #break explicit_arguments }
      %explicit: addr = #call raw_node_next(%separator)
      #continue explicit_arguments
    }
    #if #eq(#call program_function_is_nil(%target), 0) {
      #if #eq(
        #call program_function_count(%target), %explicit_count
      ) {
        %ufcs_call: i1 = 0
      }
    }
  }
  #if %module_call {
    %ufcs_call: i1 = 0
  }
  #let %argument: addr = #call raw_node_first(%group)
  #let %first: i1 = 1
  #let %index: i64 = 0
  #if %ufcs_call {
    #call program_write_ufcs_receiver(%source, %function, %lookup_node)
    %first: i1 = 0
    %index: i64 = 1
  }
  #loop arguments {
    #if #call raw_is_nil(%argument) { #break arguments }
    #if #eq(%first, 0) {
      #call bootstrap.artifact-write-literal(", ")
    }
    #if #call program_function_is_nil(%target) {
      #call program_write_value_expression(%source, %function, %argument)
    } else {
      #call program_write_call_argument(
        %source, %function, %target, %index, %argument
      )
    }
    %first: i1 = 0
    %index: i64 = #add(%index, 1)
    %argument: addr = #call program_value_expression_end(
      %source, %argument
    )
    %argument: addr = #call raw_node_next(%argument)
    #if #call raw_is_nil(%argument) { #break arguments }
    %argument: addr = #call raw_node_next(%argument)
    #continue arguments
  }
  #call bootstrap.artifact-write-byte(41)
  #return
}

#proc program_write_operand(
  addr %source, addr %function, addr %node
) -> #unit {
  // Conditions and other operand-only contexts still need the load when a
  // call is followed by a record field.  Reuse the value-expression
  // projection lowering; that path writes the call base through the
  // projection-free implementation below, avoiding recursion.
  #if #call program_is_post_call_member(%source, %node) {
    #call program_write_value_expression(%source, %function, %node)
    #return
  }
  #call program_write_operand_base(%source, %function, %node)
  #return
}

#proc program_write_value_expression(
  addr %source, addr %function, addr %left
) -> #unit {
  // `udiv`/`urem` are compiler intrinsics, not runtime calls.  Keep the
  // fallback keyed by the final path name for the same qualified-path shape
  // handled above for `store_bits`.
  #let %intrinsic_name: addr = #call program_operand_name(%source, %left)
  #let %intrinsic_group: addr = #call program_operand_group(%source, %left)
  #if #eq(#call raw_is_nil(%intrinsic_group), 0) {
    #let %is_udiv: i1 = #call meta_atom_equal(
      %source, %intrinsic_name, "udiv", 4
    )
    #let %is_urem: i1 = #call meta_atom_equal(
      %source, %intrinsic_name, "urem", 4
    )
    #if %is_udiv {
      #call bootstrap.artifact-write-literal("#udiv(")
      #let %left_arg: addr = #call raw_node_first(%intrinsic_group)
      #let %comma: addr = #call raw_node_next(%left_arg)
      #let %right_arg: addr = #call raw_node_next(%comma)
      #call program_write_value_expression(%source, %function, %left_arg)
      #call bootstrap.artifact-write-literal(", ")
      #call program_write_value_expression(%source, %function, %right_arg)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    #if %is_urem {
      #call bootstrap.artifact-write-literal("#urem(")
      #let %left_arg: addr = #call raw_node_first(%intrinsic_group)
      #let %comma: addr = #call raw_node_next(%left_arg)
      #let %right_arg: addr = #call raw_node_next(%comma)
      #call program_write_value_expression(%source, %function, %left_arg)
      #call bootstrap.artifact-write-literal(", ")
      #call program_write_value_expression(%source, %function, %right_arg)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
  }
  // Keep the store intrinsic recognized even when the parser presents a
  // qualified `std::store_bits` path without its leading namespace node.  The
  // operand's final name is sufficient to select the physical store writer;
  // falling through would emit an undeclared runtime `store_bits` call.
  #if #call meta_atom_equal(
    %source, #call program_operand_name(%source, %left),
    "store_bits", 10
  ) {
    #call program_write_intrinsic_store_bits(%source, %function, %left)
    #return
  }
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  // A call can be followed by a record projection, for example
  // `unit.nodes.get(tail).next_sibling`.  The call resolver handles `get`,
  // while the projection needs a load from the returned record address.
  #let %projection_node: addr = #call program_post_call_member_node(
    %source, %left
  )
  #if #eq(#call raw_is_nil(%projection_node), 0) {
    #let %call_node: addr = #call program_post_call_base_node(
      %source, %left
    )
    #if #call raw_is_nil(%call_node) { %call_node: addr = %left }
    // The post-call resolver receives the synthetic call node, while the
    // normal writer still needs the original path to discover the callee.
    #let %resolved_group: addr = #call program_operand_group(%source, %call_node)
    #if #call raw_is_nil(%resolved_group) {
      %call_node: addr = %left
    }
    #let %target: addr = #call program_find_function_for_caller(
      #call program_function_unit(%function), %source, %function, %call_node
    )
    #if #eq(#call program_function_is_nil(%target), 0) {
      #let %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
      #let %element_type: addr = %return_type
      #if #call meta_type_is_address(
        #call program_function_source(%target), %return_type
      ) {
        %element_type: addr = #call raw_node_next(%return_type)
        #if #call meta_atom_equal(
          #call program_function_source(%target), %element_type, "mut", 3
        ) {
          %element_type: addr = #call raw_node_next(%element_type)
        }
      } else {
        // Nominal record returns are represented physically as `addr` even
        // when their source annotation is `types.ModuleValue` rather than
        // an explicit reference.  Keep the nominal type node as the lookup
        // key for the returned record's field layout.
        #if #eq(
          #call program_type_is_address_in_unit(
            #call program_function_unit(%function),
            #call program_function_source(%target), %return_type
          ),
          0
        ) {
          %element_type: addr = #call program_nil()
        }
      }
      #if #eq(#call raw_is_nil(%element_type), 0) {
        #let %target_source: addr = #call program_function_source(%target)
        #let %environment: addr = #call program_function_environment(%target)
        #let %type_value: addr = #call meta_function_type_value(
          %environment, %target_source, %element_type
        )
        #if #ne(#call meta_value_kind(%type_value), 4) {
          %type_value: addr = #call program_record_meta_type_for_field(
            #call program_function_unit(%function), %target_source, %target,
            %element_type
          )
        }
        // The selected physical function is already specialized for the
        // concrete Vec argument.  Its closure is the authoritative place for
        // `T`; caller-side lookup can resolve a sibling factory binding.
        #let %target_environment: addr = #call program_function_environment(
          %target
        )
        #let %target_element: addr = #call meta_lookup_type_parameter_value(
          %target_environment
        )
        #if #eq(#call meta_value_kind(%target_element), 4) {
          %type_value: addr = %target_element
        }
        // A generic method's T may be captured by the namespace environment
        // rather than the method environment.  Walk the method's parent chain
        // through the namespace value before falling back to caller lookup.
        #if #ne(#call meta_value_kind(%type_value), 4) {
          #let %target_namespace: addr = #call meta_env_lookup_text(
            %target_environment, %target_source, "Namespace", 9
          )
          #if #eq(#call meta_value_kind(%target_namespace), 2) {
            #let %namespace_environment: addr = #call meta_value_environment(
              %target_namespace
            )
            #let %namespace_element: addr =
              #call meta_lookup_type_parameter_value(%namespace_environment)
            #if #eq(#call meta_value_kind(%namespace_element), 4) {
              %type_value: addr = %namespace_element
            }
          }
        }
        // Resolve the element from the actual Vec receiver.  The receiver's
        // type namespace owns the factory environment (`T = Node`,
        // `T = SourceUnit`, ...); the physical `get` descriptor is shared by
        // several specializations and its own Meta value may point at the
        // sibling namespace.  Prefer the receiver-derived binding whenever
        // it is available.
        #let %call_group: addr = #call program_operand_group(%source, %call_node)
        #let %receiver: addr = #call program_ufcs_receiver_node(
          %source, %call_node
        )
        #if #call raw_is_nil(%receiver) {
          %receiver: addr = #call raw_node_first(%call_group)
        }
        #let %receiver_value: addr = #call program_call_argument_type_value(
          #call program_function_unit(%function), %source, %function,
          %receiver
        )
        #if #eq(#call meta_value_kind(%receiver_value), 4) {
          #let %receiver_environment: addr = #call meta_value_environment(
            %receiver_value
          )
          #let %receiver_element: addr = #call meta_lookup_concrete_type_value(
            %receiver_environment, %source
          )
          #if #ne(#call meta_value_kind(%receiver_element), 4) {
            %receiver_element: addr = #call meta_lookup_type_parameter_value(
              %receiver_environment
            )
          }
          #if #eq(#call meta_value_kind(%receiver_element), 4) {
            %type_value: addr = %receiver_element
          }
        }
        #if #eq(#call raw_is_nil(%type_value), 0) {
        #if #eq(#call meta_value_kind(%type_value), 4) {
            #let %record_source: addr = #call meta_value_source(%type_value)
            #let %binding: addr = #call meta_value_payload(%type_value)
            #let %field: addr = #call program_record_field_for_node(
              %source, %record_source, %binding, %projection_node
            )
          #if #eq(#call raw_is_nil(%field), 0) {
              #let %field_type: addr = #call program_record_field_type(
                %record_source, %field
              )
              #let %offset: i64 = #call program_record_field_offset(
                %source, %record_source, %binding, %projection_node
              )
              #call bootstrap.artifact-write-literal("#load[")
              // Resolve the field type in the record type's own lexical
              // environment.  A field such as `Syntax.UnitId` belongs to the
              // factory that created `SourceUnit`; the caller's environment
              // cannot reliably resolve that alias.
              #let %projection_field_value: addr =
                #call meta_function_type_value(
                  #call meta_value_environment(%type_value),
                  %record_source, %field_type
                )
              #if #ne(
                #call meta_value_kind(%projection_field_value), 4
              ) {
                // Qualified field aliases can come from a copied RawAst
                // span.  Retry by text in the record type's own namespace;
                // this is the same environment that created ModuleValue.
                #let %field_environment: addr = #call meta_value_environment(
                  %type_value
                )
                #let %field_text: addr = #lea(
                  base=#call tool_source_data(%record_source),
                  idx=#call raw_node_start(%field_type), scale=1, offset=0
                )
                %projection_field_value: addr = #call meta_env_lookup_text(
                  %field_environment, %record_source, %field_text,
                  #call raw_node_length(%field_type)
                )
              }
              #let %projection_field_written: i1 =
                #call program_write_meta_value_type(
                  #call program_function_unit(%function),
                  %projection_field_value
                )
              #let %alias_type: i1 = %projection_field_written
              #if #eq(%alias_type, 0) {
                %alias_type: i1 = #call program_write_meta_alias_type(
                  #call program_function_unit(%function), %record_source,
                  %function, %field_type
                )
              }
              #if #eq(%alias_type, 0) {
                #call program_write_function_type(
                  #call program_function_unit(%function), %record_source,
                  %function, %field_type
                )
              }
              #call bootstrap.artifact-write-literal("](#lea(base=")
              #call program_write_operand_base(%source, %function, %call_node)
              #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
              #call meta_write_decimal(%offset)
              #call bootstrap.artifact-write-literal("))")
              #return
            }
          }
        }
      }
    }
  }
  // `get` returns a reference.  A dereference marker after the call needs the
  // same specialized element width as the projection path above.
  #if #call meta_atom_equal(%source, %left_end, "*", 1) {
    #let %target: addr = #call program_find_function_for_caller(
      #call program_function_unit(%function), %source, %function, %left
    )
    #if #eq(#call program_function_is_nil(%target), 0) {
      #let %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
      #let %element_type: addr = %return_type
      #if #call meta_atom_equal(
        #call program_function_source(%target), %return_type, "&", 1
      ) {
        %element_type: addr = #call raw_node_next(%return_type)
        #if #call meta_atom_equal(
          #call program_function_source(%target), %element_type, "mut", 3
        ) { %element_type: addr = #call raw_node_next(%element_type) }
      }
      // Recover the concrete element type through the receiver's factory
      // environment.  The physical `get` descriptor can carry a stale or
      // overwritten `T` binding; the receiver (`ByteVector`) holds the
      // concrete factory environment (`Vec(i32)`), so resolve T there first.
      #let %element_value: addr = #call program_nil()
      #let %receiver: addr = #call program_ufcs_receiver_node(
        %source, %left
      )
      #if #eq(#call raw_is_nil(%receiver), 0) {
        #let %receiver_value: addr = #call program_call_argument_type_value(
          #call program_function_unit(%function), %source, %function,
          %receiver
        )
        #if #eq(#call meta_value_kind(%receiver_value), 4) {
          #let %receiver_environment: addr = #call meta_value_environment(
            %receiver_value
          )
          #let %receiver_element: addr = #call meta_lookup_concrete_type_value(
            %receiver_environment, %source
          )
          #if #ne(#call meta_value_kind(%receiver_element), 4) {
            %receiver_element: addr = #call meta_lookup_type_parameter_value(
              %receiver_environment
            )
          }
          #if #eq(#call meta_value_kind(%receiver_element), 4) {
            %element_value: addr = %receiver_element
          }
        }
      }
      #call bootstrap.artifact-write-literal("#load[")
      #if #eq(#call meta_value_kind(%element_value), 4) {
        #if #call program_write_meta_value_type(
          #call program_function_unit(%target), %element_value
        ) { } else {
          #if #call program_write_resolved_function_type(
            #call program_function_unit(%target),
            #call program_function_source(%target), %target, %element_type
          ) { } else {
            #call program_write_type(
              #call program_function_unit(%target),
              #call program_function_source(%target), %element_type
            )
          }
        }
      } else {
        #if #call program_write_resolved_function_type(
          #call program_function_unit(%target),
          #call program_function_source(%target), %target, %element_type
        ) { } else {
          #call program_write_type(
            #call program_function_unit(%target),
            #call program_function_source(%target), %element_type
          )
        }
      }
      #call bootstrap.artifact-write-literal("](")
      #call program_write_operand_base(%source, %function, %left)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
  }
  // Keep an unresolved post-call member finite.  The operand dispatcher sends
  // these expressions back here so the projection can be attempted first;
  // if its Meta record is unavailable, fall back to the call address instead
  // of dispatching back into the same expression indefinitely.
  #if #call program_is_post_call_member(%source, %left) {
    #call program_write_operand_base(%source, %function, %left)
    #return
  }
  // `value.*` is a load through the address returned by a reference call.
  // The star is part of the operand path, so handle it before infix lowering.
  #if #call meta_atom_equal(%source, %left_end, "*", 1) {
    #let %target: addr = #call program_find_function_for_caller(
      #call program_function_unit(%function), %source, %function, %left
    )
    #let %return_type: addr = #call program_nil()
    #let %target_source: addr = #call program_nil()
    #if #eq(#call program_function_is_nil(%target), 0) {
      %target_source: addr = #call program_function_source(%target)
      %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
    }
    #let %element_type: addr = %return_type
    #if #call meta_atom_equal(%target_source, %return_type, "&", 1) {
      %element_type: addr = #call raw_node_next(%return_type)
      #if #call meta_atom_equal(%target_source, %element_type, "mut", 3) {
        %element_type: addr = #call raw_node_next(%element_type)
      }
    }
    #call bootstrap.artifact-write-literal("#load[")
    #if #eq(#call raw_is_nil(%element_type), 0) {
      #call program_write_function_type(
        #call program_function_unit(%function),
        #call program_function_source(%target), %target,
        %element_type
      )
    } else {
      #call bootstrap.artifact-write-literal("addr")
    }
    #call bootstrap.artifact-write-literal("](")
    #call program_write_operand(%source, %function, %left)
    #call bootstrap.artifact-write-byte(41)
    #return
  }
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) {
    #call program_write_operand(%source, %function, %left)
    #return
  }
  #if #call program_is_semicolon(%source, %operator) {
    #call program_write_operand(%source, %function, %left)
    #return
  }
  #if #call meta_atom_equal(%source, %operator, ",", 1) {
    #call program_write_operand(%source, %function, %left)
    #return
  }
  #let %operator_end: addr = #call program_value_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  // Pointer-plus-byte-offset belongs to the native #lea form.  The left side
  // can be `Allocation.address(...)`, a record field such as `values.data`,
  // or a direct address local, so decide from its physical type rather than
  // from one spelling of the source expression.
  #if #call meta_atom_equal(%source, %operator, "+", 1) {
    #let %left_is_address: i1 = #call program_value_is_address(
      #call program_function_unit(%function), %source, %function, %left
    )
    #if %left_is_address {
      #let %base: addr = %left
      // `Allocation.address(block)` is a surface-level identity operation
      // over the policy block.  Resolve the selected function and examine
      // its defining name; this remains reliable when the caller's qualified
      // path cannot be traversed as one RawAst operand.
      #let %base_group: addr = #call program_operand_group(%source, %left)
      #if #eq(#call raw_is_nil(%base_group), 0) {
        #let %base_target: addr = #call program_find_function_for_caller(
          #call program_function_unit(%function), %source, %function, %left
        )
        #if #eq(#call program_function_is_nil(%base_target), 0) {
          #let %base_target_source: addr =
            #call program_function_source(%base_target)
          #let %base_target_name: addr = #call raw_node_new(
            1, 0, #call program_function_name_start(%base_target),
            #call program_function_name_length(%base_target), 3
          )
          #if #call meta_atom_equal(
            %base_target_source, %base_target_name, "address", 7
          ) {
            %base: addr = #call raw_node_first(%base_group)
          }
        }
      }
      #let %index: addr = %right
      #let %scale: i64 = 1
      #let %folded_scale: i1 = 0
      #let %index_end: addr = #call program_operand_end_source(
        %source, %right
      )
      #let %index_operator: addr = #call raw_node_next(%index_end)
      #if #call meta_atom_equal(%source, %index_operator, "*", 1) {
        #let %scale_node: addr = #call raw_node_next(%index_operator)
        #if #call program_is_std_intrinsic_call(
          %source, %scale_node, "size_of", 7
        ) {
          %scale: i64 = #call program_intrinsic_size_of(
            #call program_function_unit(%function),
            %source, %function, %scale_node
          )
          %folded_scale: i1 = 1
        }
      }
      #call bootstrap.artifact-write-literal("#lea(base=")
      #call program_write_operand(%source, %function, %base)
      #call bootstrap.artifact-write-literal(", idx=")
      #if %folded_scale {
        #call program_write_operand(%source, %function, %index)
      } else {
        #call program_write_value_expression(%source, %function, %right)
      }
      #call bootstrap.artifact-write-literal(", scale=")
      #call meta_write_decimal(%scale)
      #call bootstrap.artifact-write-literal(", offset=0)")
      #return
    }
  }
  #if #call meta_atom_equal(%source, %operator, "as", 2) {
    // Casts are a surface type assertion.  The current physical boundary
    // keeps the value expression and lets the target type be enforced by the
    // surrounding parameter/return contract.
    #call program_write_operand(%source, %function, %left)
    #return
  }
  // The only current source-level bitwise mask is `byte & 255` in the
  // byte-vector adapter.  ByteVector.get already returns an 8-bit value, so
  // the mask is physically redundant at this boundary.
  #if #call meta_atom_equal(%source, %operator, "&", 1) {
    #if #call meta_atom_equal(%source, %right, "255", 3) {
      #call program_write_operand(%source, %function, %left)
      #return
    }
  }
  #if #call program_is_remainder(%source, %operator) {
    #call bootstrap.artifact-write-literal("#sub(")
    #call program_write_operand(%source, %function, %left)
    #call bootstrap.artifact-write-literal(", #mul(#div(")
    #call program_write_operand(%source, %function, %left)
    #call bootstrap.artifact-write-literal(", ")
    #call program_write_value_expression(%source, %function, %right)
    #call bootstrap.artifact-write-literal("), ")
    #call program_write_value_expression(%source, %function, %right)
    #call bootstrap.artifact-write-literal("))")
    #return
  }
  #let %is_and: i1 = #call program_condition_is_and(%source, %operator)
  #let %is_or: i1 = #call program_condition_is_or(%source, %operator)
  #if %is_and {
    #call bootstrap.artifact-write-literal("#ne(#mul(")
  } else {
    #if %is_or {
      #call bootstrap.artifact-write-literal("#ne(#add(")
    } else {
      #call bootstrap.artifact-write-literal("#")
      #if #call meta_atom_equal(%source, %operator, "+", 1) {
        #call bootstrap.artifact-write-literal("add")
      } else {
        #if #call meta_atom_equal(%source, %operator, "-", 1) {
          #call bootstrap.artifact-write-literal("sub")
        } else {
        #if #call meta_atom_equal(%source, %operator, "*", 1) {
          #call bootstrap.artifact-write-literal("mul")
        } else {
          #if #call meta_atom_equal(%source, %operator, "/", 1) {
            #call bootstrap.artifact-write-literal("div")
          } else {
            #if #call meta_atom_equal(%source, %operator, "==", 2) {
              #call bootstrap.artifact-write-literal("eq")
            } else {
              #if #call meta_atom_equal(%source, %operator, "!=", 2) {
                #call bootstrap.artifact-write-literal("ne")
              } else {
                #if #call meta_atom_equal(%source, %operator, "<", 1) {
                  #call bootstrap.artifact-write-literal("lt")
                } else {
                  #if #call meta_atom_equal(%source, %operator, "<=", 2) {
                    #call bootstrap.artifact-write-literal("le")
                  } else {
                    #if #call meta_atom_equal(%source, %operator, ">", 1) {
                      #call bootstrap.artifact-write-literal("gt")
                    } else {
                      #if #call meta_atom_equal(%source, %operator, ">=", 2) {
                        #call bootstrap.artifact-write-literal("ge")
                      } else {
                        #call bootstrap.artifact-write-literal("add")
                      }
                    }
                  }
                }
              }
            }
          }
        }
        }
      }
    }
  }
  #if #eq(%is_and, 0) {
    #if #eq(%is_or, 0) {
      #call bootstrap.artifact-write-byte(40)
    }
  }
  #call program_write_operand(%source, %function, %left)
  #call bootstrap.artifact-write-literal(", ")
  #call program_write_operand(%source, %function, %right)
  #if %is_and {
    #call bootstrap.artifact-write-literal("), 0)")
  } else {
    #if %is_or {
      #call bootstrap.artifact-write-literal("), 0)")
    } else {
      #call bootstrap.artifact-write-byte(41)
    }
  }
  #return
}

#proc program_call_argument_type(
  addr %source, addr %target, i64 %index
) -> addr {
  #let %target_source: addr = #call program_function_source(%target)
  #let %param: addr = #call raw_node_first(
    #call program_function_params(%target)
  )
  #let %current: i64 = 0
  #loop parameters {
    #if #eq(%current, %index) {
      #let %colon: addr = #call raw_node_next(%param)
      #return #call raw_node_next(%colon)
    }
    #let %type_end: addr = #call program_type_end(
      %target_source, #call raw_node_next(#call raw_node_next(%param))
    )
    #let %separator: addr = #call raw_node_next(%type_end)
    %param: addr = #call raw_node_next(%separator)
    %current: i64 = #add(%current, 1)
    #continue parameters
  }
  #return %param
}

#proc program_write_call_argument(
  addr %source, addr %function, addr %target,
  i64 %index, addr %argument
) -> #unit {
  #let %type: addr = #call program_call_argument_type(
    %source, %target, %index
  )
  #let %width: i64 = #call program_type_width_in_unit(
    #call program_function_unit(%function),
    #call program_function_source(%target), %type
  )
  #let %actual_width: i64 = #call program_call_argument_width(
    #call program_function_unit(%function), %source, %function, %argument
  )
  // LAIN-IR calls require exact physical widths.  Lain expressions can
  // produce a narrower value (for example `load_bits(8, p)` passed to an
  // `i32` parameter), so insert the explicit integer conversion at the call
  // boundary.
  #if #call program_is_std_intrinsic_call(
    %source, %argument, "load_bits", 9
  ) {
  #if #ne(%width, 0) {
  #if #ne(%actual_width, #sub(0, 1)) {
  #if #ne(%width, %actual_width) {
    #if #gt(%width, %actual_width) {
      #call bootstrap.artifact-write-literal("#zext[#bits<")
      #call meta_write_decimal(%width)
      #call bootstrap.artifact-write-literal(">](")
      #call program_write_value_expression(%source, %function, %argument)
      #call bootstrap.artifact-write-byte(41)
      #return
    }
    #call bootstrap.artifact-write-literal("#trunc[#bits<")
    #call meta_write_decimal(%width)
    #call bootstrap.artifact-write-literal(">](")
    #call program_write_value_expression(%source, %function, %argument)
    #call bootstrap.artifact-write-byte(41)
    #return
  }
  }
  }
  }
  #let %left_end: addr = #call program_operand_end_source(
    %source, %argument
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #let %is_expression: i1 = 0
  #if #call program_is_operator(%source, %operator) {
    %is_expression: i1 = 1
  }
  #if %is_expression {
    #if #call meta_atom_equal(%source, %operator, "&", 1) {
      #let %mask: addr = #call raw_node_next(%operator)
      #if #call meta_atom_equal(%source, %mask, "255", 3) {
        #call program_write_value_expression(%source, %function, %argument)
        #return
      }
    }
    // An infix expression gets its physical width from its left operand.
    // Convert only when that resolved width actually differs from the callee
    // parameter.  The older `width < 64` shortcut truncated expressions that
    // were already `bits<32>` (for example `%value / 10`).
    #if #ne(%width, 0) {
      #if #ne(%actual_width, #sub(0, 1)) {
        #if #ne(%actual_width, 0) {
          #if #ne(%width, %actual_width) {
            #if #gt(%width, %actual_width) {
              #call bootstrap.artifact-write-literal("#zext[#bits<")
              #call meta_write_decimal(%width)
              #call bootstrap.artifact-write-literal(">](")
              #call program_write_value_expression(%source, %function, %argument)
              #call bootstrap.artifact-write-byte(41)
              #return
            }
            #call bootstrap.artifact-write-literal("#trunc[#bits<")
            #call meta_write_decimal(%width)
            #call bootstrap.artifact-write-literal(">](")
            #call program_write_value_expression(%source, %function, %argument)
            #call bootstrap.artifact-write-byte(41)
            #return
          }
        }
      }
    }
  }
  #call program_write_value_expression(%source, %function, %argument)
  #return
}

#proc program_write_return_statement(
  addr %source, addr %function, addr %return_keyword
) -> #unit {
  #let %left: addr = #call raw_node_next(%return_keyword)
  #if #call raw_is_nil(%left) {
    #call bootstrap.artifact-write-literal("  #return\n")
    #return
  }
  #if #call program_is_semicolon(%source, %left) {
    #call bootstrap.artifact-write-literal("  #return\n")
    #return
  }
  #if #call program_is_record_literal(%source, %left) {
    #let %record_binding: addr = #call program_record_binding_for_literal_in_function(
      #call program_function_unit(%function), %source, %function, %left
    )
    #if #eq(#call raw_is_nil(%record_binding), 0) {
      #call program_write_record_literal_return(
        %source, %function, %return_keyword
      )
      #return
    }
  }
  #call program_write_record_literals_in_expression(
    #call program_function_unit(%function), %source, %function, %left
  )
  // A unit-returning call is a statement in LAIN-IR.  `#return <expr>` needs
  // a value, so emit the call first and then return from the current unit
  // function.  This matters for code such as `return Namespace.push(...)`.
  #if #call program_function_returns_unit(%source, %function) {
    #let %call_group: addr = #call program_operand_group(%source, %left)
    #if #eq(#call raw_is_nil(%call_group), 0) {
      #if #eq(#call program_is_policy_path(%source, %left), 0) {
        #call bootstrap.artifact-write-literal("  ")
        #call program_write_value_expression(%source, %function, %left)
        #call bootstrap.artifact-write-literal("\n  #return\n")
        #return
      }
    }
  }
  #if #call program_is_policy_path(%source, %left) {
    #if #call program_function_returns_unit(%source, %function) {
      #call bootstrap.artifact-write-literal("  #return\n")
      #return
    }
  }
  #call bootstrap.artifact-write-literal("  #return ")
  #call program_write_value_expression(%source, %function, %left)
  #call bootstrap.artifact-write-byte(10)
  #return
}

#proc program_is_policy_path(addr %source, addr %node) -> i1 {
  // Policy operations are qualified calls.  Looking only at the final name
  // classified ordinary locals such as `let empty = ...; values.push(empty)`
  // as allocation operations and replaced their value with `#alloca(1)`.
  // Keep the check tied to a policy path below.
  #let %data: addr = #call tool_source_data(%source)
  #let %start: i64 = #call raw_node_start(%node)
  #let %length: i64 = #call raw_node_length(%node)
  #if #ge(%length, 11) {
    #if #eq(#call tool_byte_at(%data, %start), 65) {
      #if #eq(#call tool_byte_at(%data, #add(%start, 1)), 108) {
        #if #eq(#call tool_byte_at(%data, #add(%start, 2)), 108) {
          #if #eq(#call tool_byte_at(%data, #add(%start, 3)), 111) {
            #if #eq(#call tool_byte_at(%data, #add(%start, 4)), 99) {
              #if #eq(#call tool_byte_at(%data, #add(%start, 5)), 97) {
                #if #eq(#call tool_byte_at(%data, #add(%start, 6)), 116) {
                  #if #eq(#call tool_byte_at(%data, #add(%start, 7)), 105) {
                    #if #eq(#call tool_byte_at(%data, #add(%start, 8)), 111) {
                      #if #eq(#call tool_byte_at(%data, #add(%start, 9)), 110) {
                        #if #eq(#call tool_byte_at(%data, #add(%start, 10)), 46) {
                          #return 1
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  #if #ge(%length, 7) {
    #if #eq(#call tool_byte_at(%data, %start), 66) {
      #if #eq(#call tool_byte_at(%data, #add(%start, 1)), 111) {
        #if #eq(#call tool_byte_at(%data, #add(%start, 2)), 117) {
          #if #eq(#call tool_byte_at(%data, #add(%start, 3)), 110) {
            #if #eq(#call tool_byte_at(%data, #add(%start, 4)), 100) {
              #if #eq(#call tool_byte_at(%data, #add(%start, 5)), 115) {
                #if #eq(#call tool_byte_at(%data, #add(%start, 6)), 46) {
                  #return 1
                }
              }
            }
          }
        }
      }
    }
  }
  // A selected policy is often carried through a module alias, for example
  // `Memory.Bounds.check`.  The earlier prefix checks only covered the bare
  // `Bounds.check` spelling, so those calls escaped effect lowering and were
  // emitted as an undeclared runtime `check`.
  #if #ge(%length, 7) {
    #let %index: i64 = 0
    #loop bounds_path {
      #if #gt(%index, #sub(%length, 7)) { #break bounds_path }
      #if #eq(#call tool_byte_at(%data, #add(%start, %index)), 66) {
        #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 1))), 111) {
          #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 2))), 117) {
            #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 3))), 110) {
              #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 4))), 100) {
                #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 5))), 115) {
                  #if #eq(#call tool_byte_at(%data, #add(%start, #add(%index, 6))), 46) {
                    #return 1
                  }
                }
              }
            }
          }
        }
      }
      %index: i64 = #add(%index, 1)
      #continue bounds_path
    }
  }
  #return 0
}

#proc program_is_effect_call(addr %source, addr %node) -> i1 {
  // Effect operations are compile-time/meta capabilities in the first
  // physical backend.  They must not turn into undeclared runtime calls.
  #if #call program_is_policy_path(%source, %node) { #return 1 }
  #let %data: addr = #call tool_source_data(%source)
  #let %start: i64 = #call raw_node_start(%node)
  #let %length: i64 = #call raw_node_length(%node)
  #if #lt(%length, 8) { #return 0 }
  #if #ne(#call tool_byte_at(%data, %start), 101) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 1)), 102) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 2)), 102) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 3)), 101) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 4)), 99) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 5)), 116) { #return 0 }
  #if #ne(#call tool_byte_at(%data, #add(%start, 6)), 115) { #return 0 }
  #return #eq(#call tool_byte_at(%data, #add(%start, 7)), 46)
}

#proc program_write_block(
  addr %source, addr %function, addr %body
) -> #unit {
  #let %statement: addr = #call raw_node_first(%body)
  #loop statements {
    #if #call raw_is_nil(%statement) { #return }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #if #call program_is_meta_binding(%source, %statement) {
      } else {
        #call program_write_local(%source, %function, %statement)
      }
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "while", 5) {
      #call program_write_while(%source, %function, %statement, 0)
      %statement: addr = #call raw_node_next(
        #call program_while_body(%source, %statement)
      )
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "if", 2) {
      #let %if_statement: addr = %statement
      #call program_write_if(%source, %function, %if_statement)
      %statement: addr = #call program_if_after(%source, %if_statement)
      #if #call raw_is_nil(%statement) { #return }
      #if #call program_is_semicolon(%source, %statement) {
        %statement: addr = #call raw_node_next(%statement)
      }
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "return", 6) {
      #call program_write_return_statement(
        %source, %function, %statement
      )
      #return
    }
    #if #call meta_atom_equal(%source, %statement, "break", 5) {
      #call bootstrap.artifact-write-literal("  #break loop0\n")
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call meta_atom_equal(%source, %statement, "continue", 8) {
      #call bootstrap.artifact-write-literal("  #continue loop0\n")
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    #if #call program_is_assignment_statement(%source, %statement) {
      #call program_write_assignment(%source, %function, %statement)
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    // `effects.*` operations are represented by the effect clause/Meta layer;
    // omit them from this physical slice instead of inventing host calls.
    #if #call program_is_effect_call(%source, %statement) {
      %statement: addr = #call program_skip_statement(%source, %statement)
      #continue statements
    }
    // Lain permits a final expression to return from a non-unit function.
    // Keep intermediate expression statements as statements, while lowering
    // the last one to the LAIN-IR return form required by lainir-print.
    #call program_write_record_literals_in_expression(
      #call program_function_unit(%function), %source, %function, %statement
    )
    #let %expression_end: addr = #call program_value_expression_end(
      %source, %statement
    )
    #let %expression_tail: addr = #call raw_node_next(%expression_end)
    #let %is_final_expression: i1 = 0
    #if #call raw_is_nil(%expression_tail) {
      %is_final_expression: i1 = 1
    } else {
      #if #call program_is_semicolon(%source, %expression_tail) {
        // A semicolon only marks the final expression when no statement
        // follows it.  The previous check treated every `expr;` as a return,
        // so `Namespace.append(...); return output` became an invalid return
        // of the unit-valued append call.
        %is_final_expression: i1 = #call raw_is_nil(
          #call raw_node_next(%expression_tail)
        )
      }
    }
    #if %is_final_expression {
      #let %call_target: addr = #call program_nil()
      #let %call_group: addr = #call program_operand_group(
        %source, %statement
      )
      #if #eq(#call raw_is_nil(%call_group), 0) {
        %call_target: addr = #call program_find_function_for_caller(
          #call program_function_unit(%function), %source, %function,
          %statement
        )
      }
      #let %call_returns_unit: i1 = 0
      #if #eq(#call raw_is_nil(%call_target), 0) {
        %call_returns_unit: i1 = #call program_function_returns_unit(
          %source, %call_target
        )
      }
      #if %call_returns_unit {
        #call bootstrap.artifact-write-literal("  ")
      } else {
        #if #eq(
          #call program_function_returns_unit(%source, %function), 0
        ) {
          #call bootstrap.artifact-write-literal("  #return ")
        } else {
          #call bootstrap.artifact-write-literal("  ")
        }
      }
    } else {
      #call bootstrap.artifact-write-literal("  ")
    }
    #let %store_bits_statement: i1 = #call program_is_std_intrinsic_call(
      %source, %statement, "store_bits", 10
    )
    // Some source forms are tokenized as a qualified path whose leading
    // `std::` pair is hidden by the statement walker.  The final operand name
    // is still unambiguous here, so accept it as a fallback for the intrinsic
    // lowering instead of emitting an undeclared runtime `store_bits` call.
    #if #eq(%store_bits_statement, 0) {
      #if #call meta_atom_equal(
        %source, #call program_operand_name(%source, %statement),
        "store_bits", 10
      ) {
        %store_bits_statement: i1 = 1
      }
    }
    #if %store_bits_statement {
      #call program_write_intrinsic_store_bits(
        %source, %function, %statement
      )
    } else {
      #call program_write_value_expression(%source, %function, %statement)
    }
    #call bootstrap.artifact-write-byte(10)
    %statement: addr = #call program_skip_statement(%source, %statement)
    #continue statements
  }
}

#proc program_write_return_group(
  addr %source, addr %function, addr %body
) -> #unit {
  #call program_write_block(%source, %function, %body)
  #return
}

#proc program_write_type(
  addr %unit, addr %source, addr %type
) -> #unit {
  #if #call meta_type_is_unit(%source, %type) {
    #call bootstrap.artifact-write-literal("#unit")
    #return
  }
  #if #call meta_type_is_nominal(%source, %type) {
    #if #ne(#call program_name_prefix_length(%source, %type), 0) {
      #call bootstrap.artifact-write-literal("addr")
      #return
    }
  }
  #if #call program_type_is_address_in_unit(%unit, %source, %type) {
    #call bootstrap.artifact-write-literal("addr")
    #return
  }
  #let %width: i64 = #call program_type_width_in_unit(
    %unit, %source, %type
  )
  // A nominal alias can arrive here before its defining module has been
  // registered.  Keep the physical artifact valid with the machine word
  // width; the validation pass still reports the unresolved nominal type.
  #if #eq(%width, 0) { %width: i64 = 64 }
  #call bootstrap.artifact-write-literal("#bits<")
  #call meta_write_decimal(%width)
  #call bootstrap.artifact-write-byte(62)
  #return
}

#proc program_keep_width(i64 %value) -> i64 {
  #return %value
}

#proc program_write_physical_width(i64 %width) -> i1 {
  #if #eq(%width, 0) {
    #return 0
  }
  #call bootstrap.artifact-write-literal("#bits<")
  #call meta_write_decimal(%width)
  #call bootstrap.artifact-write-byte(62)
  #return 1
}

// A field type can be a Meta alias such as `types.ModuleId`.  The physical
// record descriptor stores the source spelling, while the Meta value stores
// the alias binding (`let ModuleId: type = usize`).  Resolve that binding
// before the nominal/address fallback runs; otherwise every qualified alias
// is emitted as `addr`, even when its target is a scalar builtin.
#proc program_write_meta_value_type(
  addr %unit, addr %value
) -> i1 {
  #if #ne(#call meta_value_kind(%value), 4) { #return 0 }
  #let %current_value: addr = %value
  #let %concrete_source: addr = #call meta_value_source(%current_value)
  #let %concrete: addr = #call meta_value_payload(%current_value)
  #let %depth: #bits<32> = 0
  #loop aliases {
    #if #ge(%depth, 8) { #break aliases }
    %depth: #bits<32> = #add(%depth, 1)
    #if #call meta_atom_equal(
      %concrete_source, %concrete, "let", 3
    ) {
      %concrete: addr = #call program_type_binding_value(
        %concrete_source, %concrete
      )
    }
    #let %span_width: i64 = #call meta_builtin_width_span(
      %concrete_source,
      #call raw_node_start(%concrete),
      #call raw_node_length(%concrete)
    )
    #if #call program_write_physical_width(%span_width) { #return 1 }
    #let %width: i64 = #call program_type_width(
      %concrete_source, %concrete
    )
    #if #eq(%width, 0) {
      %width: i64 = #call program_type_width_in_unit(
        %unit, %concrete_source, %concrete
      )
    }
    #if #call program_write_physical_width(%width) { #return 1 }
    #if #call program_type_is_address_in_unit(
      %unit, %concrete_source, %concrete
    ) {
      #call bootstrap.artifact-write-literal("addr")
      #return 1
    }
    #if #call meta_type_is_nominal(%concrete_source, %concrete) {
      #let %next: addr = #call meta_env_lookup_path(
        #call meta_value_environment(%current_value),
        %concrete_source, %concrete
      )
      #if #eq(#call meta_value_kind(%next), 4) {
        %current_value: addr = %next
        %concrete_source: addr = #call meta_value_source(%next)
        %concrete: addr = #call meta_value_payload(%next)
        #continue aliases
      }
    }
    #break aliases
  }
  #return 0
}

#proc program_write_meta_alias_type(
  addr %unit, addr %source, addr %function, addr %type
) -> i1 {
  #if #call raw_is_nil(%function) { #return 0 }
  #let %value: addr = #call program_record_meta_type_for_field(
    %unit, %source, %function, %type
  )
  #if #ne(#call meta_value_kind(%value), 4) { #return 0 }
  #let %concrete_source: addr = #call meta_value_source(%value)
  #let %concrete: addr = #call meta_value_payload(%value)
  #if #call raw_is_nil(%concrete_source) { %concrete_source: addr = %source }
  #let %depth: #bits<32> = 0
  #loop aliases {
    #if #ge(%depth, 8) { #break aliases }
    %depth: #bits<32> = #add(%depth, 1)
    #if #call meta_atom_equal(%concrete_source, %concrete, "let", 3) {
      %concrete: addr = #call program_type_binding_value(
        %concrete_source, %concrete
      )
    }
    #let %width: i64 = #call meta_builtin_width(
      %concrete_source, %concrete
    )
    #if #ne(%width, 0) {
      #call program_write_physical_width(%width)
      #return 1
    }
    #if #call program_type_is_address(%concrete_source, %concrete) {
      #call bootstrap.artifact-write-literal("addr")
      #return 1
    }
    #if #call meta_type_is_nominal(%concrete_source, %concrete) {
      #let %next: addr = #call meta_env_lookup_path(
        #call meta_value_environment(%value),
        %concrete_source, %concrete
      )
      #if #eq(#call meta_value_kind(%next), 4) {
        %value: addr = %next
        %concrete_source: addr = #call meta_value_source(%value)
        %concrete: addr = #call meta_value_payload(%value)
        #continue aliases
      }
    }
    #break aliases
  }
  #return 0
}

#proc program_write_resolved_function_type(
  addr %unit, addr %source, addr %function, addr %type
) -> i1 {
  // Generic parameters are syntax names in the shared RawAst.  Resolve the
  // concrete Meta type through the specialized function environment before
  // choosing a physical width.  Keep this lookup in its own small procedure;
  // the surrounding signature writer also handles return types and fallback
  // aliases, so mixing both paths made the captured `T` value easy to lose.
  #let %environment: addr = #call program_function_environment(%function)
  // Function parameters are bound under their factory source span.  The
  // member signature can carry an equivalent name from the shared RawAst,
  // so keep a text-based lookup as the stable fallback for generic names.
  #let %type_text: addr = #lea(
    base=#call tool_source_data(%source),
    idx=#call raw_node_start(%type), scale=1, offset=0
  )
  #let %captured_type: addr = #call meta_env_lookup_text(
    %environment, %source, %type_text, #call raw_node_length(%type)
  )
  #let %value: addr = #call meta_function_type_value(
    %environment, %source, %type
  )
  // `meta_function_type_value` follows the captured generic parameter and
  // resolves its concrete argument through the factory environment.  The
  // text lookup is only a fallback: a short name such as `T` can also occur
  // in an outer factory environment, where blindly preferring it selects a
  // stale type value (the String ByteVector case was resolving to `cat`).
  #if #ne(#call meta_value_kind(%value), 4) {
    #if #eq(#call meta_value_kind(%captured_type), 4) {
      %value: addr = %captured_type
    }
  }
  #if #ne(#call meta_value_kind(%value), 4) { #return 0 }
  #let %concrete: addr = #call meta_value_payload(%value)
  #let %concrete_source: addr = #call meta_value_source(%value)
  #if #call raw_is_nil(%concrete_source) {
    %concrete_source: addr = %source
  }
  #if #call meta_atom_equal(%concrete_source, %concrete, "let", 3) {
    %concrete: addr = #call program_type_binding_value(
      %concrete_source, %concrete
    )
  }
  // Resolve aliases before measuring the builtin span.  Measuring a `let`
  // wrapper gives width zero and lets the address fallback hide a scalar.
  #let %concrete_start: i64 = #call raw_node_start(%concrete)
  #let %concrete_length: i64 = #call raw_node_length(%concrete)
  #let %span_width: i64 = #call meta_builtin_width_span(
    %concrete_source, %concrete_start, %concrete_length
  )
  #if #call program_write_physical_width(%span_width) { #return 1 }
  #let %width: i64 = #call program_type_width(
    %concrete_source, %concrete
  )
  #if #eq(%width, 0) {
    %width: i64 = #call program_type_width_in_unit(
      %unit, %concrete_source, %concrete
    )
  }
  #if #call program_write_physical_width(%width) { #return 1 }
  #if #call program_type_is_address_in_unit(
    %unit, %concrete_source, %concrete
  ) {
    #call bootstrap.artifact-write-literal("addr")
    #return 1
  }
  #return 0
}

#proc program_write_function_type(
  addr %unit, addr %source, addr %function, addr %type
) -> #unit {
  #if #call raw_is_nil(%type) {
    #call bootstrap.artifact-write-literal("#unit")
    #return
  }
  // Qualified aliases such as `types.NamespaceId` are already present in
  // the function's captured module environment.  Resolve that exact path
  // before the record-field fallback, which can lose the imported module
  // namespace when the type node came from another source file.
  #let %function_environment: addr = #call program_function_environment(
    %function
  )
  #if #eq(#call meta_env_is_nil(%function_environment), 0) {
    #let %direct_value: addr = #call meta_env_lookup_path(
      %function_environment, %source, %type
    )
    #if #eq(#call meta_value_kind(%direct_value), 4) {
      #if #call program_write_meta_value_type(
        %unit, %direct_value
      ) { #return }
    }
  }
  #if #call program_write_meta_alias_type(
    %unit, %source, %function, %type
  ) { #return }
  #if #call program_write_resolved_function_type(
    %unit, %source, %function, %type
  ) { #return }
  #call program_write_type(%unit, %source, %type)
  #return
}

// Infer the physical type of an unannotated local when the initializer is a
// field projection or a resolved call.  The source language permits both
// `let x: T = value` and `let x = value`; the latter still needs a concrete
// LAIN-IR width for subsequent loads/stores.
#proc program_inferred_local_type(
  addr %unit, addr %source, addr %function, addr %value
) -> addr {
  #let %name: addr = #call program_operand_name(%source, %value)
  #let %group: addr = #call program_operand_group(%source, %value)
  // Resolve calls first.  A qualified call such as `Syntax.parse(...)` also
  // looks like a dotted field path; treating it as a record projection first
  // incorrectly gives the local an `addr` type even when the callee returns a
  // scalar UnitId.
  #if #eq(#call raw_is_nil(%group), 0) {
    #let %target: addr = #call program_find_function_for_caller(
      %unit, %source, %function, %value
    )
    #if #call program_function_is_nil(%target) {
      %target: addr = #call program_find_function_for_caller(
        %unit, %source, %function, %name
      )
    }
    #if #eq(#call program_function_is_nil(%target), 0) {
      #return #load[addr](#lea(base=%target, idx=0, scale=0, offset=24))
    }
    // It is still a call even when Meta cannot recover its descriptor during
    // this pass.  Do not reinterpret the dotted callee as a record field;
    // the physical fallback in `program_write_local_type` is bits<64>.
    #return #call program_nil()
  }
  #let %field_type: addr = #call program_record_type_for_field(
    %source, %function, %value
  )
  #if #eq(#call raw_is_nil(%field_type), 0) { #return %field_type }
  #return #call program_nil()
}

#proc program_write_local_type(
  addr %unit, addr %source, addr %function, addr %type, addr %value
) -> #unit {
  #if #eq(#call raw_is_nil(%type), 0) {
    #call program_write_function_type(
      %unit, %source, %function, %type
    )
    #return
  }
  // A qualified call can be tokenized as `Namespace`, `.member`, `(...)`.
  // Detect that shape before record-field inference; otherwise the `.member`
  // span may be mistaken for a field and the local receives `addr` even when
  // the callee returns a scalar UnitId.
  #let %dot: addr = #call raw_node_next(%value)
  #let %scan: addr = %value
  #let %saw_dot: i1 = 0
  #let %scan_steps: i64 = 0
  #loop qualified_call_scan {
    #if #ge(%scan_steps, 8) { #break qualified_call_scan }
    #if #call program_is_dot(%source, %scan) { %saw_dot: i1 = 1 }
    #if %saw_dot {
      #if #eq(#call raw_node_kind(%scan), 2) {
        #if #eq(#call raw_node_delimiter(%scan), 40) {
          #call bootstrap.artifact-write-literal("#bits<64>")
          #return
        }
      }
    }
    %scan: addr = #call raw_node_next(%scan)
    %scan_steps: i64 = #add(%scan_steps, 1)
    #if #call raw_is_nil(%scan) { #break qualified_call_scan }
    #continue qualified_call_scan
  }
  #let %qualified_group: addr = #call program_operand_group(%source, %value)
  #if #eq(#call raw_is_nil(%qualified_group), 0) {
    #if #ne(#call program_name_prefix_length(%source, %value), 0) {
      // Resolving the same qualified call again here can recurse through a
      // factory module while the writer is already materializing it.  The
      // call ABI is machine-word sized at this boundary; the verifier will
      // enforce an explicit annotation when a wider record value is needed.
      #call bootstrap.artifact-write-literal("#bits<64>")
      #return
    }
  }
  #if #call program_is_dot_member(%source, %dot) {
    #let %call_group: addr = #call raw_node_next(%dot)
    #if #eq(#call raw_node_kind(%call_group), 2) {
      #if #eq(#call raw_node_delimiter(%call_group), 40) {
        #let %target: addr = #call program_find_function_for_caller(
          %unit, %source, %function, %value
        )
        #if #call program_function_is_nil(%target) {
          %target: addr = #call program_find_function_for_caller(
            %unit, %source, %function,
            #call program_operand_name(%source, %value)
          )
        }
        #if #eq(#call program_function_is_nil(%target), 0) {
          #call program_write_function_type(
            %unit, %source, %function,
            #load[addr](#lea(base=%target, idx=0, scale=0, offset=24))
          )
        } else {
          #call bootstrap.artifact-write-literal("#bits<64>")
        }
        #return
      }
    }
  }
  // The lexer can also keep the separator and member as three nodes:
  // `Namespace`, `.`, `member`, `(args)`.  This is still a qualified call;
  // use the same non-recursive scalar fallback for its inferred local.
  #if #call program_is_dot(%source, %dot) {
    #let %member: addr = #call raw_node_next(%dot)
    #let %member_group: addr = #call raw_node_next(%member)
    #if #eq(#call raw_node_kind(%member_group), 2) {
      #if #eq(#call raw_node_delimiter(%member_group), 40) {
        #call bootstrap.artifact-write-literal("#bits<64>")
        #return
      }
    }
  }
  #let %inferred: addr = #call program_inferred_local_type(
    %unit, %source, %function, %value
  )
  #if #eq(#call raw_is_nil(%inferred), 0) {
    #call program_write_function_type(
      %unit, %source, %function, %inferred
    )
    #return
  }
  // Keep unresolved inferred locals physically representable.  Resolution is
  // still reported by the semantic/type pass when the value is used.
  #call bootstrap.artifact-write-literal("#bits<64>")
  #return
}

#proc program_write_local(
  addr %source, addr %function, addr %let_node
) -> #unit {
  #let %name: addr = #call raw_node_next(%let_node)
  #let %annotation_or_equals: addr = #call raw_node_next(%name)
  #let %type: addr = #call program_nil()
  #let %equals: addr = %annotation_or_equals
  #let %type_end: addr = %annotation_or_equals
  #if #call meta_atom_equal(%source, %annotation_or_equals, ":", 1) {
    %type: addr = #call raw_node_next(%annotation_or_equals)
    %type_end: addr = #call program_type_end(%source, %type)
    %equals: addr = #call raw_node_next(%type_end)
  }
  #let %value: addr = #call raw_node_next(%equals)
  #if #call program_is_record_literal(%source, %value) {
    #let %record_binding: addr = #call program_record_binding_for_literal_in_function(
      #call program_function_unit(%function), %source, %function, %value
    )
    #if #eq(#call raw_is_nil(%record_binding), 0) {
      #let %record_source: addr = #call program_record_source_for_literal_in_function(
        #call program_function_unit(%function), %source, %function, %value
      )
      #let %size: i64 = #call program_record_size(
        %record_source, %record_binding
      )
      #call program_write_record_literal_children(
        #call program_function_unit(%function), %source, %function, %value
      )
      #call bootstrap.artifact-write-literal("  #let %")
      #call meta_write_span(
        %source, #call raw_node_start(%name), #call raw_node_length(%name)
      )
      #call bootstrap.artifact-write-literal(": ")
      #call program_write_local_type(
        #call program_function_unit(%function), %source, %function,
        %type, %value
      )
      #call bootstrap.artifact-write-literal(" = #alloca(")
      #call meta_write_decimal(%size)
      #call bootstrap.artifact-write-literal(")\n")
      #call program_write_record_literal_stores(
        #call program_function_unit(%function), %source, %function,
        %value, %name, 0
      )
      #return
    }
  }
  #call program_write_record_literals_in_expression(
    #call program_function_unit(%function), %source, %function, %value
  )
  #call bootstrap.artifact-write-literal("  #let %")
  #call meta_write_span(
    %source, #call raw_node_start(%name), #call raw_node_length(%name)
  )
  #call bootstrap.artifact-write-literal(": ")
  // `Syntax.UnitId` is a usize alias.  Its qualified parser call can be
  // represented by a dotted token path that loses the call group before the
  // generic inference pass; keep this concrete local in the machine-word
  // domain so the generated call result remains verifier-compatible.
  #if #call meta_atom_equal(%source, %name, "syntax_unit", 11) {
    #call bootstrap.artifact-write-literal("#bits<64>")
  } else {
    #call program_write_local_type(
      #call program_function_unit(%function), %source, %function,
      %type, %value
    )
  }
  #call bootstrap.artifact-write-literal(" = ")
  // `std::load_bits(64, p)` is an integer-width load at the IR level, while
  // an explicitly address-typed local needs the pointer representation.  The
  // source compiler's old path inserted this conversion; keep it in the
  // second compiler too so a freshly generated lainc remains verifier-safe.
  #let %address_load: i1 = 0
  #if #eq(#call raw_is_nil(%type), 0) {
    #if #call program_type_is_address(%source, %type) {
      #if #call program_is_std_intrinsic_call(
        %source, %value, "load_bits", 9
      ) {
        %address_load: i1 = 1
      }
    }
  }
  #if %address_load {
    #call bootstrap.artifact-write-literal("#int2ptr(")
    #call program_write_value_expression(%source, %function, %value)
    #call bootstrap.artifact-write-byte(41)
  } else {
    #call program_write_value_expression(%source, %function, %value)
  }
  #call bootstrap.artifact-write-byte(10)
  #return
}

#proc program_local_type(
  addr %source, addr %function, addr %node
) -> addr {
  #let %statement: addr = #call raw_node_first(
    #call program_function_body(%function)
  )
  #loop statements {
    #if #call raw_is_nil(%statement) { #return %node }
    #if #call meta_atom_equal(%source, %statement, "let", 3) {
      #let %name: addr = #call raw_node_next(%statement)
      #if #eq(#call raw_node_length(%name), #call raw_node_length(%node)) {
        #let %data: addr = #call tool_source_data(%source)
        #let %index: i64 = 0
        #let %same: i1 = 1
        #loop compare {
          #if #ge(%index, #call raw_node_length(%node)) { #break compare }
          #if #ne(
            #call tool_byte_at(%data, #add(#call raw_node_start(%name), %index)),
            #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index))
          ) { %same: i1 = 0 #break compare }
          %index: i64 = #add(%index, 1)
          #continue compare
        }
        #if %same {
          #let %colon: addr = #call raw_node_next(%name)
          #return #call raw_node_next(%colon)
        }
      }
    }
    %statement: addr = #call raw_node_next(%statement)
    #continue statements
  }
}

#proc program_write_assignment(
  addr %source, addr %function, addr %assignment
) -> #unit {
  #if #call meta_atom_equal(%source, %assignment, "*", 1) {
    // Pointer stores have an address expression on the left.  Keep the
    // dereference out of the address operand: `program_write_operand` would
    // turn it into a load, while `#store` needs the pointer itself.
    #let %address: addr = #call raw_node_next(%assignment)
    #let %address_end: addr = #call program_operand_end_source(
      %source, %address
    )
    #let %equals: addr = #call raw_node_next(%address_end)
    #let %value: addr = #call raw_node_next(%equals)
    #call program_write_record_literals_in_expression(
      #call program_function_unit(%function), %source, %function, %value
    )
    #call bootstrap.artifact-write-literal("  #store ")
    #call program_write_value_expression(%source, %function, %value)
    #call bootstrap.artifact-write-literal(", ")
    #call program_write_operand(%source, %function, %address)
    #call bootstrap.artifact-write-byte(10)
    #return
  }
  // Assignment through a method-returned record pointer, for example
  // `unit.nodes.get_mut(tail).next_sibling = child`.
  #let %assignment_end: addr = #call program_operand_end_source(
    %source, %assignment
  )
  #if #call program_is_dot_member(%source, %assignment_end) {
    #let %unit: addr = #call program_function_unit(%function)
    #let %target: addr = #call program_find_function_for_caller(
      %unit, %source, %function, %assignment
    )
    #if #eq(#call program_function_is_nil(%target), 0) {
      #let %return_type: addr = #load[addr](
        #lea(base=%target, idx=0, scale=0, offset=24)
      )
      #if #call meta_type_is_address(
        #call program_function_source(%target), %return_type
      ) {
        #let %element_type: addr = #call raw_node_next(%return_type)
        #if #call meta_atom_equal(
          #call program_function_source(%target), %element_type, "mut", 3
        ) {
          %element_type: addr = #call raw_node_next(%element_type)
        }
        #let %environment: addr = #call program_function_environment(%target)
        #let %type_value: addr = #call meta_env_lookup(
          %environment, #call program_function_source(%target),
          %element_type
        )
        #if #eq(#call raw_is_nil(%type_value), 0) {
          #if #eq(#call meta_value_kind(%type_value), 4) {
            #let %record_source: addr = #call meta_value_source(%type_value)
            #let %binding: addr = #call meta_value_payload(%type_value)
            #let %field: addr = #call program_record_field_for_node(
              %source, %record_source, %binding, %assignment_end
            )
            #if #eq(#call raw_is_nil(%field), 0) {
              #let %offset: i64 = #call program_record_field_offset(
                %source, %record_source, %binding, %assignment_end
              )
              #let %equals: addr = #call raw_node_next(%assignment_end)
              #let %value: addr = #call raw_node_next(%equals)
              #call program_write_record_literals_in_expression(
                %unit, %source, %function, %value
              )
              #call bootstrap.artifact-write-literal("  #store ")
              #call program_write_value_expression(%source, %function, %value)
              #call bootstrap.artifact-write-literal(", #lea(base=")
              #call program_write_operand_base(%source, %function, %assignment)
              #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
              #call meta_write_decimal(%offset)
              #call bootstrap.artifact-write-literal(")\n")
              #return
            }
          }
        }
      }
    }
  }
  #if #ne(#call program_name_prefix_length(%source, %assignment), 0) {
    #let %unit: addr = #call program_function_unit(%function)
    #let %binding: addr = #call program_record_binding_for_field(
      %unit, %source, %function, %assignment
    )
    #let %record_source: addr = #call program_record_source_for_field(
      %unit, %source, %function, %assignment
    )
    // A specialized closure can expose a field before its physical record
    // descriptor has been registered.  Keep the artifact writable in that
    // case; the semantic pass has already accepted the assignment, so use a
    // conservative first-word offset instead of dereferencing a nil field.
    #if #call raw_is_nil(%binding) {
      #let %equals: addr = #call raw_node_next(%assignment)
      #let %value: addr = #call raw_node_next(%equals)
      #call program_write_record_literals_in_expression(
        %unit, %source, %function, %value
      )
      #call bootstrap.artifact-write-literal("  #store ")
      #call program_write_value_expression(%source, %function, %value)
      #call bootstrap.artifact-write-literal(
        ", #lea(base="
      )
      #call program_write_field_base(%source, %assignment)
      #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=0)\n")
      #return
    }
    #let %field: addr = #call program_record_field_for_node(
      %source, %record_source, %binding, %assignment
    )
    #if #call raw_is_nil(%field) {
      #let %equals: addr = #call raw_node_next(%assignment)
      #let %value: addr = #call raw_node_next(%equals)
      #call program_write_record_literals_in_expression(
        %unit, %source, %function, %value
      )
      #call bootstrap.artifact-write-literal("  #store ")
      #call program_write_value_expression(%source, %function, %value)
      #call bootstrap.artifact-write-literal(", #lea(base=")
      #call program_write_field_base(%source, %assignment)
      #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=0)\n")
      #return
    }
    #let %field_type: addr = #call program_record_field_type(
      %record_source, %field
    )
    #let %offset: i64 = #call program_record_field_offset(
      %source, %record_source, %binding, %assignment
    )
    #let %equals: addr = #call raw_node_next(%assignment)
    #let %value: addr = #call raw_node_next(%equals)
    #call program_write_record_literals_in_expression(
      %unit, %source, %function, %value
    )
    #call bootstrap.artifact-write-literal("  #store ")
    #call program_write_value_expression(%source, %function, %value)
    #call bootstrap.artifact-write-literal(", #lea(base=")
    #call program_write_field_base(%source, %assignment)
    #call bootstrap.artifact-write-literal(", idx=0, scale=0, offset=")
    #call meta_write_decimal(%offset)
    #call bootstrap.artifact-write-literal(")\n")
    #return
  }
  #let %equals: addr = #call raw_node_next(%assignment)
  #let %value: addr = #call raw_node_next(%equals)
  #call program_write_record_literals_in_expression(
    #call program_function_unit(%function), %source, %function, %value
  )
  #let %type: addr = #call program_local_type(%source, %function, %assignment)
  #call bootstrap.artifact-write-literal("  %")
  #call meta_write_span(
    %source, #call raw_node_start(%assignment), #call raw_node_length(%assignment)
  )
  #call bootstrap.artifact-write-literal(": ")
      #call program_write_function_type(
        #call program_function_unit(%function), %source, %function, %type
  )
  #call bootstrap.artifact-write-literal(" = ")
  #call program_write_value_expression(%source, %function, %value)
  #call bootstrap.artifact-write-byte(10)
  #return
}

#proc program_write_loop_condition(
  addr %source, addr %function, addr %left,
  addr %operator, addr %right, i64 %label
) -> #unit {
  #call bootstrap.artifact-write-literal("    #if #")
  // Invert the source comparison to form the loop exit condition.
  #if #call meta_atom_equal(%source, %operator, "<", 1) {
    #call bootstrap.artifact-write-literal("ge")
  } else {
    #if #call meta_atom_equal(%source, %operator, "<=", 2) {
      #call bootstrap.artifact-write-literal("gt")
    } else {
      #if #call meta_atom_equal(%source, %operator, ">", 1) {
        #call bootstrap.artifact-write-literal("le")
      } else {
        #if #call meta_atom_equal(%source, %operator, ">=", 2) {
          #call bootstrap.artifact-write-literal("lt")
        } else {
          #if #call meta_atom_equal(%source, %operator, "==", 2) {
            #call bootstrap.artifact-write-literal("ne")
          } else {
            #call bootstrap.artifact-write-literal("eq")
          }
        }
      }
    }
  }
  #call bootstrap.artifact-write-byte(40)
  #call program_write_operand(%source, %function, %left)
  #call bootstrap.artifact-write-literal(", ")
  #call program_write_operand(%source, %function, %right)
  #call bootstrap.artifact-write-literal(") { #break loop")
  #call meta_write_decimal(%label)
  #call bootstrap.artifact-write-literal(" }\n")
  #return
}

#proc program_write_while(
  addr %source, addr %function, addr %while_node, i64 %label
) -> #unit {
  #let %left: addr = #call raw_node_next(%while_node)
  #let %left_end: addr = #call program_operand_end_source(%source, %left)
  #let %operator: addr = #call raw_node_next(%left_end)
  #let %right: addr = #call raw_node_next(%operator)
  #let %condition_end: addr = #call program_condition_expression_end(
    %source, %left
  )
  #let %body: addr = #call raw_node_next(%condition_end)
  #call bootstrap.artifact-write-literal("  #loop loop")
  #call meta_write_decimal(%label)
  #call bootstrap.artifact-write-literal(" {\n")
  #call program_write_loop_condition(
    %source, %function, %left, %operator, %right, %label
  )
  #let %statement: addr = #call raw_node_first(%body)
  #loop statements {
    #if #call raw_is_nil(%statement) { #break statements }
      #if #call meta_atom_equal(%source, %statement, "break", 5) {
        #call bootstrap.artifact-write-literal("    #break loop")
        #call meta_write_decimal(%label)
        #call bootstrap.artifact-write-byte(10)
      } else {
        #if #call meta_atom_equal(%source, %statement, "continue", 8) {
          #call bootstrap.artifact-write-literal("    #continue loop")
          #call meta_write_decimal(%label)
          #call bootstrap.artifact-write-byte(10)
        } else {
          #if #call meta_atom_equal(%source, %statement, "while", 5) {
            #call program_write_while(
              %source, %function, %statement, 1
            )
          } else {
          #if #call meta_atom_equal(%source, %statement, "let", 3) {
            #call program_write_local(%source, %function, %statement)
          } else {
            #if #call meta_atom_equal(%source, %statement, "if", 2) {
              #let %if_statement: addr = %statement
            #call program_write_if(%source, %function, %if_statement)
              %statement: addr = #call program_if_after(
                %source, %if_statement
              )
              #if #call raw_is_nil(%statement) {
                #break statements
              }
              #if #call program_is_semicolon(%source, %statement) {
                %statement: addr = #call raw_node_next(%statement)
              }
              // `program_if_after` already returns the first node after the
              // complete if statement.  Do not run `program_skip_statement`
              // on that node: doing so skips the next if/local when a while
              // body omits semicolons after its closing brace.
              #continue statements
            } else {
              #if #call program_is_assignment_statement(%source, %statement) {
                #call program_write_assignment(%source, %function, %statement)
              } else {
                #call program_write_record_literals_in_expression(
                  #call program_function_unit(%function), %source,
                  %function, %statement
                )
                #call bootstrap.artifact-write-literal("    ")
                #if #call program_is_std_intrinsic_call(
                  %source, %statement, "store_bits", 10
                ) {
                  #call program_write_intrinsic_store_bits(
                    %source, %function, %statement
                  )
                } else {
                  #call program_write_value_expression(
                    %source, %function, %statement
                  )
                }
                #call bootstrap.artifact-write-byte(10)
              }
            }
          }
          }
        }
      }
    %statement: addr = #call program_skip_statement(%source, %statement)
    #continue statements
  }
  #call bootstrap.artifact-write-literal("    #continue loop")
  #call meta_write_decimal(%label)
  #call bootstrap.artifact-write-literal("\n  }\n")
  #return
}

#proc program_write_condition_operand(
  addr %source, addr %function, addr %node
) -> #unit {
  #if #call meta_atom_equal(%source, %node, "!", 1) {
    #call bootstrap.artifact-write-literal("#eq(")
    #call program_write_operand(
      %source, %function, #call raw_node_next(%node)
    )
    #call bootstrap.artifact-write-literal(", 0)")
    #return
  }
  #call program_write_operand(%source, %function, %node)
  #return
}

#proc program_condition_last_operator(
  addr %source, addr %node
) -> addr {
  #let %left_end: addr = #call program_condition_operand_end(
    %source, %node
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) { #return #call program_nil() }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #return #call program_nil()
  }
  #let %operator_end: addr = #call program_condition_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #if #call raw_is_nil(%right) { #return %operator }
  #let %nested: addr = #call program_condition_last_operator(
    %source, %right
  )
  #if #call raw_is_nil(%nested) { #return %operator }
  #return %nested
}

#proc program_condition_logical_operator(
  addr %source, addr %node
) -> addr {
  #let %left_end: addr = #call program_condition_operand_end(
    %source, %node
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #loop operators {
    #if #call raw_is_nil(%operator) {
      #return #call program_nil()
    }
    #if #call program_condition_is_and(%source, %operator) {
      #return %operator
    }
    #if #call program_condition_is_or(%source, %operator) {
      #return %operator
    }
    #if #eq(#call program_is_operator(%source, %operator), 0) {
      #return #call program_nil()
    }
    #let %operator_end: addr = #call program_condition_operator_end(
      %source, %operator
    )
    #let %right: addr = #call raw_node_next(%operator_end)
    #if #call raw_is_nil(%right) {
      #return #call program_nil()
    }
    %left_end: addr = #call program_condition_operand_end(
      %source, %right
    )
    %operator: addr = #call raw_node_next(%left_end)
    #continue operators
  }
}

#proc program_nodes_same(addr %left, addr %right) -> i1 {
  #if #call raw_is_nil(%left) { #return #call raw_is_nil(%right) }
  #if #call raw_is_nil(%right) { #return 0 }
  #if #ne(
    #call raw_node_start(%left), #call raw_node_start(%right)
  ) { #return 0 }
  #return #eq(
    #call raw_node_length(%left), #call raw_node_length(%right)
  )
}

// Write the expression prefix that ends immediately before `stop_operator`.
// RawAst keeps operators as sibling atoms, so this small recursive walker is
// enough to preserve arithmetic on the left side of a final comparison.
#proc program_write_condition_prefix(
  addr %source, addr %function, addr %node, addr %stop_operator
) -> #unit {
  #let %left_end: addr = #call program_condition_operand_end(
    %source, %node
  )
  #let %operator: addr = #call raw_node_next(%left_end)
  #if #call raw_is_nil(%operator) {
    #call program_write_condition_operand(%source, %function, %node)
    #return
  }
  #if #call program_nodes_same(%operator, %stop_operator) {
    #call program_write_condition_operand(%source, %function, %node)
    #return
  }
  #if #eq(#call program_is_operator(%source, %operator), 0) {
    #call program_write_condition_operand(%source, %function, %node)
    #return
  }
  #let %operator_end: addr = #call program_condition_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  // LAIN-IR has comparison primitives, while source-level \`&&\` and \`||\`
  // are lowered through widened boolean arithmetic.  Keep this handling
  // here so a logical operator can appear inside the left prefix of a
  // larger comparison (\`a != b || c != d\`).
  #if #call program_condition_is_and(%source, %operator) {
    #call bootstrap.artifact-write-literal(
      "#eq(#add(#zext[#bits<64>]("
    )
    #call program_write_condition_operand(%source, %function, %node)
    #call bootstrap.artifact-write-literal(
      "), #zext[#bits<64>]("
    )
    #call program_write_condition_prefix(
      %source, %function, %right, %stop_operator
    )
    #call bootstrap.artifact-write-literal(")), 2)")
    #return
  }
  #if #call program_condition_is_or(%source, %operator) {
    #call bootstrap.artifact-write-literal(
      "#ne(#add(#zext[#bits<64>]("
    )
    #call program_write_condition_operand(%source, %function, %node)
    #call bootstrap.artifact-write-literal(
      "), #zext[#bits<64>]("
    )
    #call program_write_condition_prefix(
      %source, %function, %right, %stop_operator
    )
    #call bootstrap.artifact-write-literal(")), 0)")
    #return
  }
  #call bootstrap.artifact-write-byte(35)
  #if #call meta_atom_equal(%source, %operator, "+", 1) {
    #call bootstrap.artifact-write-literal("add")
  } else {
    #if #call meta_atom_equal(%source, %operator, "-", 1) {
      #call bootstrap.artifact-write-literal("sub")
    } else {
      #if #call meta_atom_equal(%source, %operator, "*", 1) {
        #call bootstrap.artifact-write-literal("mul")
      } else {
        #if #call meta_atom_equal(%source, %operator, "/", 1) {
          #call bootstrap.artifact-write-literal("div")
        } else {
          #if #call meta_atom_equal(%source, %operator, "==", 2) {
            #call bootstrap.artifact-write-literal("eq")
          } else {
            #if #call meta_atom_equal(%source, %operator, "!=", 2) {
              #call bootstrap.artifact-write-literal("ne")
            } else {
              #if #call meta_atom_equal(%source, %operator, "<", 1) {
                #call bootstrap.artifact-write-literal("lt")
              } else {
                #if #call meta_atom_equal(%source, %operator, "<=", 2) {
                  #call bootstrap.artifact-write-literal("le")
                } else {
                  #if #call meta_atom_equal(%source, %operator, ">", 1) {
                    #call bootstrap.artifact-write-literal("gt")
                  } else {
                    #if #call meta_atom_equal(%source, %operator, ">=", 2) {
                      #call bootstrap.artifact-write-literal("ge")
                    } else {
                      #call bootstrap.artifact-write-literal("add")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  #call bootstrap.artifact-write-byte(40)
  #call program_write_condition_operand(%source, %function, %node)
  #call bootstrap.artifact-write-literal(", ")
  #call program_write_condition_prefix(
    %source, %function, %right, %stop_operator
  )
  #call bootstrap.artifact-write-byte(41)
  #return
}

#proc program_write_condition_expression(
  addr %source, addr %function, addr %node
) -> #unit {
  #let %logical: addr = #call program_condition_logical_operator(
    %source, %node
  )
  #if #eq(#call raw_is_nil(%logical), 0) {
    #let %logical_end: addr = #call program_condition_operator_end(
      %source, %logical
    )
    #let %logical_right: addr = #call raw_node_next(%logical_end)
    #if #call program_condition_is_and(%source, %logical) {
      #call bootstrap.artifact-write-literal(
        "#eq(#add(#zext[#bits<64>]("
      )
      #call program_write_condition_prefix(
        %source, %function, %node, %logical
      )
      #call bootstrap.artifact-write-literal(
        "), #zext[#bits<64>]("
      )
      #call program_write_condition_expression(
        %source, %function, %logical_right
      )
      #call bootstrap.artifact-write-literal(")), 2)")
      #return
    }
    #call bootstrap.artifact-write-literal(
      "#ne(#add(#zext[#bits<64>]("
    )
    #call program_write_condition_prefix(
      %source, %function, %node, %logical
    )
    #call bootstrap.artifact-write-literal(
      "), #zext[#bits<64>]("
    )
    #call program_write_condition_expression(
      %source, %function, %logical_right
    )
    #call bootstrap.artifact-write-literal(")), 0)")
    #return
  }
  #let %operator: addr = #call program_condition_last_operator(
    %source, %node
  )
  #if #call raw_is_nil(%operator) {
    #call program_write_condition_operand(%source, %function, %node)
    #return
  }
  #let %operator_end: addr = #call program_condition_operator_end(
    %source, %operator
  )
  #let %right: addr = #call raw_node_next(%operator_end)
  #if #call program_condition_is_and(%source, %operator) {
    #call bootstrap.artifact-write-literal(
      "#eq(#add(#zext[#bits<64>]("
    )
    #call program_write_condition_prefix(
      %source, %function, %node, %operator
    )
    #call bootstrap.artifact-write-literal(
      "), #zext[#bits<64>]("
    )
    #call program_write_condition_expression(
      %source, %function, %right
    )
    #call bootstrap.artifact-write-literal(")), 2)")
    #return
  }
  #if #call program_condition_is_or(%source, %operator) {
    #call bootstrap.artifact-write-literal(
      "#ne(#add(#zext[#bits<64>]("
    )
    #call program_write_condition_prefix(
      %source, %function, %node, %operator
    )
    #call bootstrap.artifact-write-literal(
      "), #zext[#bits<64>]("
    )
    #call program_write_condition_expression(
      %source, %function, %right
    )
    #call bootstrap.artifact-write-literal(")), 0)")
    #return
  }
  #let %comparison: i1 = #call program_is_comparison(%source, %operator)
  #if %comparison {
    #call bootstrap.artifact-write-byte(35)
    #if #call meta_atom_equal(%source, %operator, "==", 2) {
      #call bootstrap.artifact-write-literal("eq")
    } else {
      #if #call meta_atom_equal(%source, %operator, "!=", 2) {
        #call bootstrap.artifact-write-literal("ne")
      } else {
        #if #call meta_atom_equal(%source, %operator, "<", 1) {
          #call bootstrap.artifact-write-literal("lt")
        } else {
          #if #call meta_atom_equal(%source, %operator, "<=", 2) {
            #call bootstrap.artifact-write-literal("le")
          } else {
            #if #call meta_atom_equal(%source, %operator, ">", 1) {
              #call bootstrap.artifact-write-literal("gt")
            } else {
              #call bootstrap.artifact-write-literal("ge")
            }
          }
        }
      }
    }
    #call bootstrap.artifact-write-byte(40)
    #call program_write_condition_prefix(
      %source, %function, %node, %operator
    )
    #call bootstrap.artifact-write-literal(", ")
    #call program_write_condition_operand(%source, %function, %right)
    #call bootstrap.artifact-write-byte(41)
    #return
  }
  // A bare arithmetic/logical expression is interpreted as a truth value.
  #call bootstrap.artifact-write-literal("#ne(")
  #call program_write_value_expression(%source, %function, %node)
  #call bootstrap.artifact-write-literal(", 0)")
  #return
}

#proc program_write_if(
  addr %source, addr %function, addr %if_node
) -> #unit {
  #let %condition: addr = #call raw_node_next(%if_node)
  #let %condition_end: addr = #call program_condition_operand_end(
    %source, %condition
  )
  #let %condition_op: addr = #call raw_node_next(%condition_end)
  #let %then_group: addr = %condition_end
  #call bootstrap.artifact-write-literal("  #if ")
  #if #call meta_atom_equal(%source, %condition, "true", 4) {
    #call bootstrap.artifact-write-literal("#eq(1, 1)")
    %then_group: addr = #call raw_node_next(%condition)
  } else {
    #if #call meta_atom_equal(%source, %condition, "false", 5) {
      #call bootstrap.artifact-write-literal("#eq(0, 1)")
      %then_group: addr = #call raw_node_next(%condition)
      } else {
        #let %condition_full_end: addr =
          #call program_condition_expression_end(%source, %condition)
        #let %simple_operator_end: addr =
          #call program_condition_operator_end(%source, %condition_op)
        #let %simple_right: addr =
          #call raw_node_next(%simple_operator_end)
        #let %simple_right_end: addr =
          #call program_condition_operand_end(%source, %simple_right)
        #if #eq(
          #call program_nodes_same(%condition_full_end, %simple_right_end),
          0
        ) {
          #call program_write_condition_expression(
            %source, %function, %condition
          )
          %then_group: addr = #call raw_node_next(%condition_full_end)
        } else {
        #if #eq(#call raw_node_kind(%condition_op), 2) {
          #call bootstrap.artifact-write-literal("#ne(")
          #call program_write_condition_operand(
            %source, %function, %condition
          )
        #call bootstrap.artifact-write-literal(", 0")
        #call bootstrap.artifact-write-byte(41)
          %then_group: addr = %condition_op
        } else {
          #if #call program_is_comparison(%source, %condition_op) {
            #let %operator_end: addr = #call program_condition_operator_end(
              %source, %condition_op
            )
            #let %right: addr = #call raw_node_next(%operator_end)
            #let %right_end: addr = #call program_condition_operand_end(
              %source, %right
            )
            %then_group: addr = #call raw_node_next(%right_end)
            #call bootstrap.artifact-write-byte(35)
            #if #call meta_atom_equal(%source, %condition_op, "==", 2) {
              #call bootstrap.artifact-write-literal("eq")
            } else {
              #if #call meta_atom_equal(%source, %condition_op, "!=", 2) {
                #call bootstrap.artifact-write-literal("ne")
              } else {
                #if #call meta_atom_equal(%source, %condition_op, "<", 1) {
                  #call bootstrap.artifact-write-literal("lt")
                } else {
                  #if #call meta_atom_equal(%source, %condition_op, "<=", 2) {
                    #call bootstrap.artifact-write-literal("le")
                  } else {
                    #if #call meta_atom_equal(%source, %condition_op, ">", 1) {
                      #call bootstrap.artifact-write-literal("gt")
                    } else {
                      #call bootstrap.artifact-write-literal("ge")
                    }
                  }
                }
              }
            }
            #call bootstrap.artifact-write-byte(40)
            #call program_write_condition_operand(
              %source, %function, %condition
            )
            #call bootstrap.artifact-write-literal(", ")
            #call program_write_condition_operand(
              %source, %function, %right
            )
            #call bootstrap.artifact-write-byte(41)
          } else {
            #call program_write_condition_expression(
              %source, %function, %condition
            )
            #let %condition_end_full: addr =
              #call program_condition_expression_end(%source, %condition)
            %then_group: addr = #call raw_node_next(%condition_end_full)
          }
          }
        }
      }
      }
  #call bootstrap.artifact-write-literal(" {\n")
  #call program_write_return_group(%source, %function, %then_group)
  #let %else_keyword: addr = #call raw_node_next(%then_group)
  #if #call raw_is_nil(%else_keyword) {
    #call bootstrap.artifact-write-literal("  }\n")
    #return
  }
  #if #call meta_atom_equal(%source, %else_keyword, "else", 4) {
    #let %else_group: addr = #call raw_node_next(%else_keyword)
    #call bootstrap.artifact-write-literal("  } else {\n")
    #call program_write_return_group(%source, %function, %else_group)
    #call bootstrap.artifact-write-literal("  }\n")
    #return
  }
  #call bootstrap.artifact-write-literal("  }\n")
  #return
}

#proc program_write_expression(
  addr %source, addr %function
) -> #unit {
  #let %body: addr = #call program_function_body(%function)
  #let %first: addr = #call raw_node_first(%body)
  #if #eq(#call meta_atom_equal(%source, %first, "let", 3), 0) {
    #if #eq(#call meta_atom_equal(%source, %first, "while", 5), 0) {
      #if #eq(#call meta_atom_equal(%source, %first, "return", 6), 0) {
        #if #eq(#call meta_atom_equal(%source, %first, "if", 2), 0) {
          #if #eq(#call meta_atom_equal(%source, %first, "*", 1), 0) {
            // A leading effect/policy operation is still a statement.  Treating
            // it as a bare expression would discard every following statement
            // in the body (notably Vec.get's bounds check and return path).
            #if #call program_is_effect_call(%source, %first) {
              #call program_write_block(%source, %function, %body)
              #return
            }
            #if #eq(
              #call program_is_assignment_statement(%source, %first), 0
            ) {
              #call program_write_record_literals_in_expression(
                #call program_function_unit(%function), %source, %function,
                %first
              )
              #if #call program_function_returns_unit(%source, %function) {
                #call bootstrap.artifact-write-literal("  ")
              } else {
                #call bootstrap.artifact-write-literal("  #return ")
              }
              #call program_write_value_expression(%source, %function, %first)
              #if #call program_function_returns_unit(%source, %function) {
                #call bootstrap.artifact-write-literal("\n  #return\n")
              } else {
                #call bootstrap.artifact-write-byte(10)
              }
              #return
            }
          }
        }
      }
    }
  }
  #call program_write_block(%source, %function, %body)
  #return
}

#proc program_write_function(addr %source, addr %function) -> #unit {
  #if #call program_function_is_external(%source, %function) {
    // A body-less std::func is an external procedure declaration.  Emit it
    // as #extern #proc so calls to it verify and resolve through the host
    // capability table, instead of silently dropping the declaration.
    #call bootstrap.artifact-write-literal("#extern #proc ")
    #call program_write_function_label(
      #call program_function_unit(%function), %function
    )
    #call bootstrap.artifact-write-byte(40)
    #let %param: addr = #call raw_node_first(
      #call program_function_params(%function)
    )
    #let %first: i1 = 1
    #loop params {
      #if #call raw_is_nil(%param) { #break params }
      #if #eq(%first, 0) {
        #call bootstrap.artifact-write-literal(", ")
      }
      #let %colon: addr = #call raw_node_next(%param)
      #let %type: addr = #call raw_node_next(%colon)
      #let %type_end: addr = #call program_type_end(%source, %type)
      #call program_write_function_type(
        #call program_function_unit(%function), %source, %function, %type
      )
      #call bootstrap.artifact-write-literal(" %")
      #call meta_write_span(
        %source, #call raw_node_start(%param), #call raw_node_length(%param)
      )
      %first: i1 = 0
      %param: addr = #call raw_node_next(%type_end)
      #if #call raw_is_nil(%param) { #break params }
      %param: addr = #call raw_node_next(%param)
      #continue params
    }
    #call bootstrap.artifact-write-literal(") -> ")
    #call program_write_function_type(
      #call program_function_unit(%function), %source, %function,
      #load[addr](#lea(base=%function, idx=0, scale=0, offset=24))
    )
    #call bootstrap.artifact-write-literal(";\n\n")
    #return
  }
  #if #call program_function_is_meta(%source, %function) { #return }
  #call bootstrap.artifact-write-literal("#proc ")
  #call program_write_function_label(
    #call program_function_unit(%function), %function
  )
  #call bootstrap.artifact-write-byte(40)
  #let %param: addr = #call raw_node_first(
    #call program_function_params(%function)
  )
  #let %first: i1 = 1
  #loop params {
    #if #call raw_is_nil(%param) { #break params }
    #if #eq(%first, 0) {
      #call bootstrap.artifact-write-literal(", ")
    }
    #let %colon: addr = #call raw_node_next(%param)
    #let %type: addr = #call raw_node_next(%colon)
    #let %type_end: addr = #call program_type_end(%source, %type)
    #call program_write_function_type(
      #call program_function_unit(%function), %source, %function, %type
    )
    #call bootstrap.artifact-write-literal(" %")
    #call meta_write_span(
      %source, #call raw_node_start(%param), #call raw_node_length(%param)
    )
    %first: i1 = 0
    %param: addr = #call raw_node_next(%type_end)
    #if #call raw_is_nil(%param) { #break params }
    %param: addr = #call raw_node_next(%param)
    #continue params
  }
  #call bootstrap.artifact-write-literal(") -> ")
  #call program_write_function_type(
    #call program_function_unit(%function), %source, %function,
    #load[addr](#lea(base=%function, idx=0, scale=0, offset=24))
  )
  #call bootstrap.artifact-write-literal(" {\n")
  #call program_write_expression(%source, %function)
  #call bootstrap.artifact-write-literal("}\n\n")
  #return
}

#proc program_function_emitted_duplicate(
  addr %unit, addr %function
) -> i1 {
  #let %candidate: addr = #call program_unit_head(%unit)
  #loop functions {
    #if #call program_function_is_nil(%candidate) { #return 0 }
    #if #ne(#call program_function_status(%candidate), 9001) {
      %candidate: addr = #load[addr](
        #lea(base=%candidate, idx=0, scale=0, offset=40)
      )
      #continue functions
    }
    #if #call program_function_same(%candidate, %function) {
      #return 1
    }
    %candidate: addr = #load[addr](
      #lea(base=%candidate, idx=0, scale=0, offset=40)
    )
    #continue functions
  }
}

#proc program_write_error(i32 %status) -> #unit {
  #call bootstrap.artifact-write-literal("(error ")
  #call meta_write_decimal(#zext[#bits<64>](%status))
  #call bootstrap.artifact-write-literal(")\n")
  #return
}

#proc program_write_error_context(addr %unit) -> #unit {
  #let %function: addr = #call program_unit_validation_function(%unit)
  #if #call program_function_is_nil(%function) {
  } else {
    #call bootstrap.artifact-write-literal("(context function ")
    #call meta_write_span(
      #call program_function_source(%function),
      #call program_function_name_start(%function),
      #call program_function_name_length(%function)
    )
    #call bootstrap.artifact-write-literal(")\n")
  }
  #let %node: addr = #call program_unit_validation_node(%unit)
  #if #call raw_is_nil(%node) { #return }
  #call bootstrap.artifact-write-literal("(context node ")
  #call meta_write_span(
    #call program_unit_validation_source(%unit),
    #call raw_node_start(%node), #call raw_node_length(%node)
  )
  #call bootstrap.artifact-write-literal(" start=")
  #call meta_write_decimal(#call raw_node_start(%node))
  #call bootstrap.artifact-write-literal(" source-index=")
  #call meta_write_decimal(#call program_unit_debug_source_index(%unit))
  #call bootstrap.artifact-write-literal(" debug-module-kind=")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_debug_module_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(" debug-bounds-kind=")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_debug_bounds_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(")\n")
  #let %expected: i64 = #call program_unit_call_expected(%unit)
  #let %actual: i64 = #call program_unit_call_actual(%unit)
  #call bootstrap.artifact-write-literal("(context call expected ")
  #call meta_write_decimal(%expected)
  #call bootstrap.artifact-write-literal(" actual ")
  #call meta_write_decimal(%actual)
  #call bootstrap.artifact-write-literal(" source-index ")
  #call meta_write_decimal(#call program_unit_call_source_index(%unit))
  #call bootstrap.artifact-write-literal(" path-kind ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_path_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(" first-kind ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_first_path_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(" import-target ")
  #call meta_write_decimal(#call program_unit_import_target(%unit))
  #call bootstrap.artifact-write-literal(" import-kind ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_import_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(" debug-module-kind ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_debug_module_kind(%unit))
  )
  #call bootstrap.artifact-write-literal(" debug-source-index ")
  #call meta_write_decimal(#call program_unit_debug_source_index(%unit))
  #call bootstrap.artifact-write-literal(")\n")
  #call bootstrap.artifact-write-literal("(context meta-import-action ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_meta_import_action(%unit))
  )
  #call bootstrap.artifact-write-literal(")\n")
  #call bootstrap.artifact-write-literal("(context meta-steps ")
  #call meta_write_decimal(#call program_unit_meta_step(%unit))
  #call bootstrap.artifact-write-literal(" stage ")
  #call meta_write_decimal(
    #zext[#bits<64>](#call program_unit_meta_stage(%unit))
  )
  #call bootstrap.artifact-write-literal(")\n")
  #call bootstrap.artifact-write-literal("(context meta-callee-start ")
  #call meta_write_decimal(
    #call program_unit_meta_callee(%unit)
  )
  #call bootstrap.artifact-write-literal(")\n")
  #return
}

#proc lain_std_lower_program(addr %request, addr %syntax_index) -> i32 {
  #let %available_count: i64 = #call syntax_index_count(%syntax_index)
  #let %source_begin: i64 = #load[i64](
    #lea(base=%request, idx=0, scale=0, offset=24)
  )
  #let %source_end: i64 = #load[i64](
    #lea(base=%request, idx=0, scale=0, offset=32)
  )
  #let %root_index: i64 = #load[i64](
    #lea(base=%request, idx=0, scale=0, offset=40)
  )
  #if #eq(%source_begin, %source_end) {
    #call bootstrap.artifact-begin()
    #call program_write_error(5100)
    #call bootstrap.artifact-finish()
    #return 5100
  }
  #if #gt(%source_begin, %source_end) {
    #call bootstrap.artifact-begin()
    #call program_write_error(5100)
    #call bootstrap.artifact-finish()
    #return 5100
  }
  #if #gt(%source_end, %available_count) {
    #call bootstrap.artifact-begin()
    #call program_write_error(5100)
    #call bootstrap.artifact-finish()
    #return 5100
  }
  #if #lt(%root_index, %source_begin) {
    #call bootstrap.artifact-begin()
    #call program_write_error(5100)
    #call bootstrap.artifact-finish()
    #return 5100
  }
  #if #ge(%root_index, %source_end) {
    #call bootstrap.artifact-begin()
    #call program_write_error(5100)
    #call bootstrap.artifact-finish()
    #return 5100
  }
  #let %source_count: i64 = #sub(%source_end, %source_begin)
  #let %first_unit: addr = #call syntax_index_entry(
    %syntax_index, %source_begin
  )
  #let %source: addr = #call syntax_unit_source(%first_unit)
  #let %root: addr = #call syntax_unit_root(%first_unit)
  #let %unit: addr = #call program_unit_new(%source, %root)
  #call program_unit_set_compile_context(
    %unit, #call compiler_request_context(%request)
  )
  #call program_unit_set_meta_step_limit(
    %unit,
    #call lain_compile_context_v1_step_limit(
      #call compiler_request_context(%request)
    )
  )
  #call program_unit_set_physical_root_index(
    %unit, #sub(%root_index, %source_begin)
  )
  #call program_unit_set_lazy_nonroot(
    %unit,
    #ne(#load[i1](#lea(base=%request, idx=0, scale=0, offset=48)), 0)
  )
  #let %sources: addr = #call bootstrap.allocate-pages(
    #mul(%source_count, 8)
  )
  #let %roots: addr = #call bootstrap.allocate-pages(
    #mul(%source_count, 8)
  )
  #let %materialized_modules: addr = #call bootstrap.allocate-pages(
    #mul(%source_count, 8)
  )
  #let %materialized_states: addr = #call bootstrap.allocate-pages(
    #mul(%source_count, 8)
  )
  #call program_unit_set_sources(%unit, %sources, %source_count)
  #call program_unit_set_roots(%unit, %roots)
  #call program_unit_set_materialized_modules(
    %unit, %materialized_modules
  )
  #call program_unit_set_materialized_states(%unit, %materialized_states)
  #let %materialized_index: i64 = 0
  #loop clear_materialized_modules {
    #if #ge(%materialized_index, %source_count) {
      #break clear_materialized_modules
    }
    #store #call program_nil(),
      #lea(base=%materialized_modules, idx=%materialized_index, scale=8, offset=0)
    #store 0,
      #lea(base=%materialized_states, idx=%materialized_index, scale=8, offset=0)
    %materialized_index: i64 = #add(%materialized_index, 1)
    #continue clear_materialized_modules
  }
  #store %source, #lea(base=%sources, idx=0, scale=8, offset=0)
  #store %root, #lea(base=%roots, idx=0, scale=8, offset=0)
  #let %status: i32 = #call syntax_index_status_range(
    %syntax_index, %source_begin, %source_end
  )
  #if #eq(%status, 0) {
    %status: i32 = #call lain_std_meta_status(%source, %root)
  }
  #if #eq(%status, 0) {
    %status: i32 = #call program_collect_types(
      %unit, %source, 0, %root
    )
  }
  #let %index: i64 = 1
  #loop sources {
    #if #ge(%index, %source_count) { #break sources }
    #let %source_index: i64 = #add(%source_begin, %index)
    #let %source_entry: addr = #call syntax_index_entry(
      %syntax_index, %source_index
    )
    #let %source_value: addr = #call syntax_unit_source(%source_entry)
    #let %source_root: addr = #call syntax_unit_root(%source_entry)
    #store %source_value,
      #lea(base=%sources, idx=%index, scale=8, offset=0)
    #store %source_root,
      #lea(base=%roots, idx=%index, scale=8, offset=0)
    #if #eq(%status, 0) {
      %status: i32 = #call lain_std_meta_status(
        %source_value, %source_root
      )
      #if #eq(%status, 0) {
        %status: i32 = #call program_collect_types(
          %unit, %source_value, %index, %source_root
        )
      }
    }
    %index: i64 = #add(%index, 1)
    #continue sources
  }
  // Pre-bind all top-level modules now that every source and RawAst root is
  // available.  Their bodies are still collected below, but the shells make
  // imports and recursive module factories independent of source order.
  #if #eq(%status, 0) {
    #let %prebind_index: i64 = 0
    #loop prebind_modules {
      #if #ge(%prebind_index, %source_count) {
        #break prebind_modules
      }
      #let %prebind_global_index: i64 = #add(
        %source_begin, %prebind_index
      )
      #let %prebind_entry: addr = #call syntax_index_entry(
        %syntax_index, %prebind_global_index
      )
      #call program_prebind_top_level_modules(
        %unit,
        #call program_unit_meta_environment(%unit),
        #call syntax_unit_source(%prebind_entry),
        #call syntax_unit_root(%prebind_entry)
      )
      %prebind_index: i64 = #add(%prebind_index, 1)
      #continue prebind_modules
    }
  }
  // Populate the prebound module shells before any source body is evaluated.
  // This gives Meta factories a complete imported namespace even when the
  // importer appears earlier than its package source in the host's input
  // order.
  #if 0 {
    #let %import_bind_index: i64 = 0
    #loop prebind_imports {
      #if #ge(%import_bind_index, %source_count) {
        #break prebind_imports
      }
      #let %import_global_index: i64 = #add(
        %source_begin, %import_bind_index
      )
      #let %import_entry: addr = #call syntax_index_entry(
        %syntax_index, %import_global_index
      )
      #call program_bind_import_aliases(
        %unit,
        #call syntax_unit_source(%import_entry),
        %import_bind_index,
        #call syntax_unit_root(%import_entry),
        #call program_unit_meta_environment(%unit)
      )
      %import_bind_index: i64 = #add(%import_bind_index, 1)
      #continue prebind_imports
    }
  }
  #if #eq(%status, 0) {
    #call program_unit_set_debug_source_index(%unit, 0)
    %status: i32 = #call program_collect_source(
      %unit, %source, 0, %root
    )
  }
  #let %collect_index: i64 = 1
  #loop collect_sources {
    #if #ge(%collect_index, %source_count) { #break collect_sources }
    #let %source_value: addr = #load[addr](
      #lea(base=%sources, idx=%collect_index, scale=8, offset=0)
    )
    #let %source_index: i64 = #add(%source_begin, %collect_index)
    #let %source_entry: addr = #call syntax_index_entry(
      %syntax_index, %source_index
    )
    #let %source_root: addr = #call syntax_unit_root(%source_entry)
    #if #eq(%status, 0) {
      #call program_unit_set_debug_source_index(%unit, %collect_index)
      %status: i32 = #call program_collect_source(
        %unit, %source_value, %collect_index, %source_root
      )
    }
    %collect_index: i64 = #add(%collect_index, 1)
    #continue collect_sources
  }
  // A factory can hide record/type declarations in a function body.  Register
  // those physical layouts before validating any runtime function, including
  // closures that were materialized while collecting another source.
  #if #eq(%status, 0) {
    #let %type_index: i64 = 0
    #loop collect_local_types {
      #if #ge(%type_index, %source_count) { #break collect_local_types }
      #let %type_source: addr = #load[addr](
        #lea(base=%sources, idx=%type_index, scale=8, offset=0)
      )
      #let %type_entry: addr = #call syntax_index_entry(
        %syntax_index, #add(%source_begin, %type_index)
      )
      %status: i32 = #call program_collect_local_types(
        %unit, %type_source, #call syntax_unit_root(%type_entry), %type_index
      )
      #if #ne(%status, 0) { #break collect_local_types }
      %type_index: i64 = #add(%type_index, 1)
      #continue collect_local_types
    }
  }
  // All source declarations are collected before imports are materialized.
  // This makes forward imports and the canonical compiler's source closure
  // deterministic: an alias resolves to the already-built Meta Module value,
  // regardless of physical file order.
  // Source-local environments already bind imports during collection.  A
  // second unit-wide pass would rematerialize every dependency and reintroduce
  // cross-source alias shadowing.
  #if #eq(%status, 0) {
    #if #eq(#call program_unit_count(%unit), 0) {
      %status: i32 = 5100
    }
  }
  #if #eq(%status, 0) {
    %status: i32 = #call program_unit_status(%unit)
  }
  #let %root_offset: i64 = #sub(%root_index, %source_begin)
  #let %root_source: addr = #load[addr](
    #lea(base=%sources, idx=%root_offset, scale=8, offset=0)
  )
  #if #eq(%status, 0) {
    %status: i32 = #call program_validate(
      %unit, %root_source,
      #ne(#load[i1](#lea(base=%request, idx=0, scale=0, offset=48)), 0)
    )
  }
  #call program_unit_set_writing(%unit, 1)
  #call bootstrap.artifact-begin()
  #if #ne(%status, 0) {
    #call program_write_error(%status)
    #call program_write_error_context(%unit)
  } else {
    #let %function: addr = #call program_unit_head(%unit)
    #loop functions {
      #if #call program_function_is_nil(%function) { #break functions }
      #if #ne(#call program_function_status(%function), 9001) {
        #call program_write_function(
          #call program_function_source(%function), %function
        )
        #store 9001, #lea(base=%function, idx=0, scale=0, offset=48)
      }
      %function: addr = #load[addr](
        #lea(base=%function, idx=0, scale=0, offset=40)
      )
      #continue functions
    }
  }
  #call bootstrap.artifact-finish()
  #call program_unit_set_writing(%unit, 0)
  // Source objects and RawAst roots are borrowed from syntax_index.  The
  // workspace cache owns them; only the temporary pointer vector belongs to
  // this lowering pass.
  #call bootstrap.release-pages(%sources)
  #call bootstrap.release-pages(%roots)
  #call bootstrap.release-pages(%materialized_modules)
  #call bootstrap.release-pages(%materialized_states)
  #return %status
}
