// Multi-function source-to-LAIN-IR lowering slice.
//
// This is the next step after lower_func.l1.  It keeps the surface parser
// generic, collects `std::func` declarations as Meta-owned descriptors, checks
// parameter names, direct calls, and a small return-expression grammar, then
// emits ordinary executable LAIN-IR.  It is deliberately not a compiler
// magic parser: every source-level decision is made in this LAIN-IR module.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.release-pages(addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_source_data(addr %source) -> addr;
#extern #proc tool_source_length(addr %source) -> i64;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc raw_parse(addr %source, addr %tokens) -> addr;
#extern #proc raw_node_new(
  i32 %kind, i32 %delimiter, i64 %start, i64 %length, i32 %token_kind
) -> addr;
#extern #proc raw_is_nil(addr %node) -> i1;
#extern #proc raw_node_kind(addr %node) -> i32;
#extern #proc raw_node_delimiter(addr %node) -> i32;
#extern #proc raw_node_start(addr %node) -> i64;
#extern #proc raw_node_length(addr %node) -> i64;
#extern #proc raw_node_first(addr %node) -> addr;
#extern #proc raw_node_next(addr %node) -> addr;
#extern #proc raw_node_set_next(addr %node, addr %next) -> #unit;
#extern #proc raw_node_token_kind(addr %node) -> i32;
#extern #proc tool_byte_at(addr %data, i64 %index) -> i8;
#extern #proc meta_atom_equal(
  addr %source, addr %node, addr %text, i64 %length
) -> i1;
#extern #proc meta_write_decimal(i64 %value) -> #unit;
#extern #proc meta_write_span(
  addr %source, i64 %start, i64 %length
) -> #unit;
#extern #proc meta_record_group(addr %source, addr %root) -> addr;
#extern #proc meta_record_build(addr %source, addr %root) -> addr;
#extern #proc meta_record_group_from_binding(
  addr %source, addr %let_node
) -> addr;
#extern #proc meta_type_size(addr %source, addr %node) -> i64;
#extern #proc meta_type_alignment(addr %source, addr %node) -> i64;
#extern #proc meta_align_up(i64 %value, i64 %alignment) -> i64;
#extern #proc module_group(addr %source, addr %root) -> addr;
#extern #proc meta_module_build(addr %source, addr %root) -> addr;
#extern #proc program_is_module_declaration(
  addr %source, addr %let_node
) -> i1;
#extern #proc program_module_group(
  addr %source, addr %let_node
) -> addr;
#extern #proc meta_module_validate_binding(
  addr %source, addr %let_node
) -> i32;
#extern #proc meta_builtin_width(addr %source, addr %node) -> i64;
#extern #proc meta_builtin_width_span(
  addr %source, i64 %start, i64 %length
) -> i64;
#extern #proc meta_type_is_nominal(addr %source, addr %node) -> i1;
#extern #proc meta_type_is_unit(addr %source, addr %node) -> i1;
#extern #proc lain_std_meta_status(addr %source, addr %root) -> i32;
#extern #proc program_bind_import_aliases(
  addr %unit, addr %source, #bits<64> %source_index,
  addr %root, addr %environment
) -> #unit;
#extern #proc meta_env_new(addr %parent) -> addr;
#extern #proc meta_env_is_nil(addr %environment) -> i1;
#extern #proc meta_env_binding_is_nil(addr %binding) -> i1;
#extern #proc meta_env_bind(
  addr %environment, addr %source, addr %name, addr %value
) -> #unit;
#extern #proc meta_env_lookup(
  addr %environment, addr %source, addr %name
) -> addr;
#extern #proc meta_env_lookup_local(
  addr %environment, addr %source, addr %name
) -> addr;
#extern #proc meta_env_lookup_text(
  addr %environment, addr %source, addr %text, i64 %length
) -> addr;
#extern #proc meta_env_count(addr %environment) -> i64;
#extern #proc meta_env_parent(addr %environment) -> addr;
#extern #proc meta_env_lookup_span(
  addr %environment, addr %source, i64 %start, i64 %length
) -> addr;
#extern #proc meta_value_function(
  addr %source, addr %name, addr %function, addr %environment
) -> addr;
#extern #proc meta_value_module(
  addr %source, addr %name, addr %group, addr %environment
) -> addr;
#extern #proc meta_value_type(
  addr %source, addr %name, addr %binding
) -> addr;
#extern #proc meta_value_type_with_namespace(
  addr %source, addr %name, addr %binding, addr %environment
) -> addr;
#extern #proc meta_value_scalar(
  addr %source, addr %node, i64 %number
) -> addr;
#extern #proc meta_value_nil() -> addr;
#extern #proc meta_env_lookup_path(
  addr %environment, addr %source, addr %node
) -> addr;
#extern #proc meta_value_kind(addr %value) -> i32;
#extern #proc meta_value_source(addr %value) -> addr;
#extern #proc meta_value_start(addr %value) -> i64;
#extern #proc meta_value_length(addr %value) -> i64;
#extern #proc meta_value_payload(addr %value) -> addr;
#extern #proc meta_value_environment(addr %value) -> addr;
#extern #proc meta_value_scalar_number(addr %value) -> i64;
#extern #proc program_unit_meta_step_inc(addr %unit) -> i1;
#extern #proc compiler_request_context(addr %request) -> addr;
#extern #proc lain_compile_context_v1_step_limit(addr %context) -> i64;
#extern #proc program_unit_set_meta_step_limit(
  addr %unit, i64 %limit
) -> #unit;
#extern #proc program_unit_set_meta_member(addr %unit, i64 %start) -> #unit;
#extern #proc program_unit_set_meta_callee(addr %unit, i64 %start) -> #unit;
#extern #proc program_unit_set_validation_node(
  addr %unit, addr %source, addr %node
) -> #unit;
#extern #proc eval_result_new(i32 %status, i64 %value) -> addr;
#extern #proc eval_result_object(i32 %status, addr %object) -> addr;
#extern #proc eval_status(addr %result) -> i32;
#extern #proc eval_value(addr %result) -> i64;
#extern #proc eval_result_is_object(addr %result) -> i1;
#extern #proc eval_object(addr %result) -> addr;
#extern #proc syntax_index_count(addr %index) -> i64;
#extern #proc syntax_index_entry(addr %index, i64 %ordinal) -> addr;
#extern #proc syntax_index_status(addr %index) -> i32;
#extern #proc syntax_index_status_range(
  addr %index, i64 %begin, i64 %end
) -> i32;
#extern #proc workspace_import_count(addr %source, addr %root) -> i64;
#extern #proc workspace_import_target(
  i64 %source_index, addr %source, addr %root,
  i64 %source_count, i64 %ordinal
) -> i64;
#extern #proc syntax_unit_source(addr %unit) -> addr;
#extern #proc syntax_unit_root(addr %unit) -> addr;

// Function descriptor:
//   name start/length @0/@8, parameter group @16, return type @24,
//   body @32, next @40, diagnostic @48, parameter count @56,
//   owning source @64, owning unit @72, source ordinal @80,
//   lexical Meta environment @88, specialization key @96,
//   linked-to-unit marker @104.
#proc program_nil() -> addr {
  // Keep a second zeroed word so function descriptors can use their
  // name-length field to distinguish the sentinel from a real function.
  #let %nil: addr = #call bootstrap.allocate-pages(16)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=0)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=8)
  #return %nil
}

#proc program_unit_new(addr %source, addr %root) -> addr {
  // Unit: first/last function @0/@8, count @16, diagnostic @24,
  // first source/root @32/@40, source vector/count @48/@56,
  // constant head/tail @64/@72, type head/tail @80/@88,
  // Meta lexical environment @96, validation function @104,
  // validation source/node @112/@120, call expected/actual/source-index
  // @128/@136/@144, Meta path kind @152, first-segment kind @160,
  // last import target/kind @168/@176, source roots @208,
  // materialized module cache @216, Meta-evaluation step counter @224,
  // cache-hit flag @232, cache-entry count @240,
  // materialized-module construction states @288, Meta-evaluation cache
  // head/tail @264/@272, physical-function hash buckets @280,
  // import-collection flag @320, physical root index @328,
  // lazy-nonroot flag @336, Meta step limit @344, compile context @352.
  #let %unit: addr = #call bootstrap.allocate-pages(360)
  #let %nil: addr = #call program_nil()
  #let %function_buckets: addr = #call bootstrap.allocate-pages(32768)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=0)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=16)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=24)
  #store %source, #lea(base=%unit, idx=0, scale=0, offset=32)
  #store %root, #lea(base=%unit, idx=0, scale=0, offset=40)
  #store #call program_nil(), #lea(base=%unit, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=56)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=64)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=72)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=80)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=88)
  #store #call meta_env_new(%nil),
    #lea(base=%unit, idx=0, scale=0, offset=96)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=104)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=112)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=120)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=128)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=136)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=144)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=152)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=160)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=168)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=176)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=184)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=192)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=200)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=208)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=216)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=224)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=232)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=240)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=248)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=256)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=288)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=296)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=300)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=320)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=328)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=336)
  // Preserve the previous runaway-evaluation guard as the default policy;
  // callers can replace it through program_unit_set_meta_step_limit.
  #store 50000, #lea(base=%unit, idx=0, scale=0, offset=344)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=264)
  #store %nil, #lea(base=%unit, idx=0, scale=0, offset=272)
  #store %function_buckets,
    #lea(base=%unit, idx=0, scale=0, offset=280)
  #store 0, #lea(base=%unit, idx=0, scale=0, offset=352)
  #let %bucket_index: i64 = 0
  #loop clear_function_buckets {
    #if #ge(%bucket_index, 4096) { #break clear_function_buckets }
    #store %nil,
      #lea(base=%function_buckets, idx=%bucket_index, scale=8, offset=0)
    %bucket_index: i64 = #add(%bucket_index, 1)
    #continue clear_function_buckets
  }
  #return %unit
}

#proc program_function_new(
  addr %source, addr %name, addr %params, addr %return_type, addr %body,
  i64 %source_index
) -> addr {
  #let %function: addr = #call bootstrap.allocate-pages(120)
  #let %nil: addr = #call program_nil()
  #store #call raw_node_start(%name),
    #lea(base=%function, idx=0, scale=0, offset=0)
  #store #call raw_node_length(%name),
    #lea(base=%function, idx=0, scale=0, offset=8)
  #store %params, #lea(base=%function, idx=0, scale=0, offset=16)
  #store %return_type, #lea(base=%function, idx=0, scale=0, offset=24)
  #store %body, #lea(base=%function, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%function, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%function, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%function, idx=0, scale=0, offset=56)
  #store %source, #lea(base=%function, idx=0, scale=0, offset=64)
  #store #call program_nil(), #lea(base=%function, idx=0, scale=0, offset=72)
  #store %source_index, #lea(base=%function, idx=0, scale=0, offset=80)
  #store %nil, #lea(base=%function, idx=0, scale=0, offset=88)
  #store 0, #lea(base=%function, idx=0, scale=0, offset=96)
  #store 0, #lea(base=%function, idx=0, scale=0, offset=104)
  // @foreign link_name content start (0 when absent).
  #store 0, #lea(base=%function, idx=0, scale=0, offset=112)
  #return %function
}

#proc program_function_source(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=64))
}

#proc program_function_unit(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=72))
}

#proc program_function_is_linked(addr %function) -> i1 {
  #return #load[i1](#lea(base=%function, idx=0, scale=0, offset=104))
}

#proc program_function_environment(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=88))
}

#proc program_function_set_environment(
  addr %function, addr %environment
) -> #unit {
  #store %environment, #lea(base=%function, idx=0, scale=0, offset=88)
  #store #call program_function_environment_key(%environment),
    #lea(base=%function, idx=0, scale=0, offset=96)
  #return
}

#proc program_function_environment_key_depth(
  addr %environment, i64 %depth
) -> i64 {
  #if #ge(%depth, 256) { #return 0 }
  #if #call meta_env_is_nil(%environment) { #return 0 }
  #let %key: i64 = #load[i64](
    #lea(base=%environment, idx=0, scale=0, offset=32)
  )
  #let %binding: addr = #load[addr](
    #lea(base=%environment, idx=0, scale=0, offset=16)
  )
  #let %binding_steps: i64 = 0
  #loop bindings {
    #if #call meta_env_binding_is_nil(%binding) { #break bindings }
    #if #ge(%binding_steps, 256) { #break bindings }
    %binding_steps: i64 = #add(%binding_steps, 1)
    %key: i64 = #add(
      #mul(%key, 131),
      #load[i64](#lea(base=%binding, idx=0, scale=0, offset=16))
    )
    %key: i64 = #add(
      #mul(%key, 131),
      #load[i64](#lea(base=%binding, idx=0, scale=0, offset=24))
    )
    #let %value: addr = #load[addr](
      #lea(base=%binding, idx=0, scale=0, offset=32)
    )
    #if #ne(#call meta_value_kind(%value), 0) {
      #let %value_source: addr = #load[addr](
        #lea(base=%value, idx=0, scale=0, offset=8)
      )
      %key: i64 = #add(
        #mul(%key, 131),
        #zext[#bits<64>](#call meta_value_kind(%value))
      )
      %key: i64 = #add(
        #mul(%key, 131),
        #call tool_source_length(%value_source)
      )
      %key: i64 = #add(
        #mul(%key, 131),
        #load[i64](#lea(base=%value, idx=0, scale=0, offset=16))
      )
      %key: i64 = #add(
        #mul(%key, 131),
        #load[i64](#lea(base=%value, idx=0, scale=0, offset=24))
      )
    }
    %binding: addr = #load[addr](
      #lea(base=%binding, idx=0, scale=0, offset=40)
    )
    #continue bindings
  }
  #let %parent: addr = #load[addr](
    #lea(base=%environment, idx=0, scale=0, offset=8)
  )
  #if #eq(#call meta_env_is_nil(%parent), 0) {
    %key: i64 = #add(
      #mul(%key, 131),
      #call program_function_environment_key_depth(
        %parent, #add(%depth, 1)
      )
    )
  }
  #return %key
}

#proc program_function_environment_key(addr %environment) -> i64 {
  #return #call program_function_environment_key_depth(%environment, 0)
}

#proc program_function_specialization_key(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=96))
}

#proc program_function_name_start(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=0))
}

#proc program_function_name_length(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=8))
}

#proc program_function_is_nil(addr %function) -> i1 {
  // `raw_is_nil` checks the first byte of a RawAst node.  A physical
  // function stores its name start at offset zero, so that byte can legally
  // be zero when the source span is page-aligned.  Function descriptors have
  // a non-zero name length; the shared sentinel has both words zero.
  #return #eq(
    #load[i64](#lea(base=%function, idx=0, scale=0, offset=8)),
    0
  )
}

#proc program_function_index_entry_is_nil(addr %entry) -> i1 {
  // Index nodes are heap addresses too, so `raw_is_nil(%entry)` can mistake
  // an aligned node for the sentinel.  The first field is the function
  // descriptor; its stable name-length check gives us the real nil test.
  #if #eq(
    #load[i64](#lea(base=%entry, idx=0, scale=0, offset=8)),
    0
  ) { #return 1 }
  #return #call program_function_is_nil(
    #load[addr](#lea(base=%entry, idx=0, scale=0, offset=0))
  )
}

#proc program_function_params(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=16))
}

#proc program_function_body(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=32))
}

#proc program_function_source_index(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=80))
}

#proc program_function_count(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=56))
}

#proc program_function_status(addr %function) -> i32 {
  #return #load[i32](#lea(base=%function, idx=0, scale=0, offset=48))
}

#proc program_function_is_external(
  addr %source, addr %function
) -> i1 {
  #return #call meta_atom_equal(
    %source, #call program_function_body(%function), ";", 1
  )
}

#proc program_function_returns_unit(
  addr %source, addr %function
) -> i1 {
  // `std::func(...) { ... }` has an implicit unit result.  Keep the missing
  // arrow/type as a nil syntax node in the descriptor and treat it exactly
  // like an explicit `-> unit` throughout validation and emission.
  #let %return_type: addr = #load[addr](
    #lea(base=%function, idx=0, scale=0, offset=24)
  )
  #if #call raw_is_nil(%return_type) { #return 1 }
  #return #call meta_type_is_unit(
    %source, %return_type
  )
}

#proc program_node_has_meta_constructor(
  addr %source, addr %node
) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #eq(#call raw_node_kind(%node), 1) {
    #if #call meta_atom_equal(%source, %node, "std", 3) {
      #let %colon1: addr = #call raw_node_next(%node)
      #let %colon2: addr = #call raw_node_next(%colon1)
      #let %member: addr = #call raw_node_next(%colon2)
      #if #call meta_atom_equal(%source, %colon1, ":", 1) {
        #if #call meta_atom_equal(%source, %colon2, ":", 1) {
          #if #call meta_atom_equal(%source, %member, "module", 6) {
            #return 1
          }
          #if #call meta_atom_equal(%source, %member, "effect", 6) {
            #return 1
          }
          #if #call meta_atom_equal(
            %source, %member, "handler", 7
          ) { #return 1 }
          #if #call meta_atom_equal(
            %source, %member, "effect_operation", 16
          ) { #return 1 }
          #if #call meta_atom_equal(
            %source, %member, "type_with_namespace", 19
          ) { #return 1 }
          #if #call meta_atom_equal(
            %source, %member, "handler_type", 12
          ) { #return 1 }
          #if #call meta_atom_equal(
            %source, %member, "meta_type", 9
          ) { #return 1 }
        }
      }
    }
    #return 0
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #return 0 }
    #if #call program_node_has_meta_constructor(%source, %child) {
      #return 1
    }
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
}

#proc program_function_is_meta(
  addr %source, addr %function
) -> i1 {
  #let %return_type: addr = #load[addr](
    #lea(base=%function, idx=0, scale=0, offset=24)
  )
  #if #call meta_atom_equal(%source, %return_type, "type", 4) {
    #return 1
  }
  // A function returning Module/ModuleShape is still a physical function
  // when it simply forwards a module-shaped value.  The body scan below
  // identifies actual Meta constructors such as `std::module { ... }`.
  #let %return_name: addr = #call program_operand_name(
    %source, %return_type
  )
  // A module-valued forwarding call is a compile-time factory wrapper.  A
  // module-valued identity function still has a physical ABI and is kept for
  // nominal-parameter lowering, so inspect the returned expression before
  // classifying it as Meta.
  #if #call meta_atom_equal(%source, %return_name, "Module", 6) {
    #let %statement: addr = #call raw_node_first(
      #call program_function_body(%function)
    )
    #loop module_return_scan {
      #if #call raw_is_nil(%statement) { #break module_return_scan }
      #if #call meta_atom_equal(%source, %statement, "return", 6) {
        #let %value: addr = #call raw_node_next(%statement)
        #if #eq(#call raw_is_nil(
          #call program_operand_group(%source, %value)
        ), 0) { #return 1 }
        #break module_return_scan
      }
      %statement: addr = #call raw_node_next(%statement)
      #continue module_return_scan
    }
  }
  #if #call meta_atom_equal(%source, %return_name, "ModuleShape", 11) {
    #return 1
  }
  #if #call meta_atom_equal(%source, %return_name, "Effect", 6) {
    #return 1
  }
  #if #call meta_atom_equal(%source, %return_name, "EffectSet", 9) {
    #return 1
  }
  #if #call meta_atom_equal(%source, %return_type, "effects.Effect", 14) {
    #return 1
  }
  #if #call meta_atom_equal(%source, %return_type, "effects.EffectSet", 17) {
    #return 1
  }
  #return #call program_node_has_meta_constructor(
    %source, #call program_function_body(%function)
  )
}

