#proc program_unit_meta_step_inc(addr %unit) -> i1 {
  #let %step: #bits<64> = #add(
    #load[#bits<64>](#lea(base=%unit, idx=0, scale=0, offset=224)), 1
  )
  #store %step, #lea(base=%unit, idx=0, scale=0, offset=224)
  #let %limit: i64 = #load[i64](
    #lea(base=%unit, idx=0, scale=0, offset=344)
  )
  // A zero limit disables the guard.  Non-zero limits preserve the old
  // inclusive boundary and make the policy explicit per compilation unit.
  #if #eq(%limit, 0) { #return 0 }
  #return #ge(%step, %limit)
}

