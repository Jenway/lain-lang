// Type descriptor:
//   name start/length @0/@8, physical width (0 means address) @16,
//   diagnostic @24, owning source @32, next @40, source ordinal @48,
//   defining let binding @56.
#proc program_type_new(
  addr %source, addr %name, i64 %width, i32 %status, i64 %source_index,
  addr %binding
) -> addr {
  #let %type: addr = #call bootstrap.allocate-pages(64)
  #let %nil: addr = #call program_nil()
  #store #call raw_node_start(%name),
    #lea(base=%type, idx=0, scale=0, offset=0)
  #store #call raw_node_length(%name),
    #lea(base=%type, idx=0, scale=0, offset=8)
  #store %width, #lea(base=%type, idx=0, scale=0, offset=16)
  #store %status, #lea(base=%type, idx=0, scale=0, offset=24)
  #store %source, #lea(base=%type, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%type, idx=0, scale=0, offset=40)
  #store %source_index, #lea(base=%type, idx=0, scale=0, offset=48)
  #store %binding, #lea(base=%type, idx=0, scale=0, offset=56)
  #return %type
}

#proc program_type_status(addr %type) -> i32 {
  #return #load[i32](#lea(base=%type, idx=0, scale=0, offset=24))
}

#proc program_type_width_value(addr %type) -> i64 {
  #return #load[i64](#lea(base=%type, idx=0, scale=0, offset=16))
}

#proc program_type_source(addr %type) -> addr {
  #return #load[addr](#lea(base=%type, idx=0, scale=0, offset=32))
}

#proc program_type_source_index(addr %type) -> i64 {
  #return #load[i64](#lea(base=%type, idx=0, scale=0, offset=48))
}

#proc program_type_binding(addr %type) -> addr {
  #return #load[addr](#lea(base=%type, idx=0, scale=0, offset=56))
}

#proc program_append_type(addr %unit, addr %type) -> #unit {
  #let %head: addr = #call program_unit_types(%unit)
  #if #call raw_is_nil(%head) {
    #call program_set_unit_types(%unit, %type, %type)
  } else {
    #let %tail: addr = #load[addr](#lea(base=%unit, idx=0, scale=0, offset=88))
    #store %type, #lea(base=%tail, idx=0, scale=0, offset=40)
    #call program_set_unit_types(%unit, %head, %type)
  }
  #return
}

