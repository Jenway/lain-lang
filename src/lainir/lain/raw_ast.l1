// Lain surface parser, first LAIN-IR vertical slice.
//
// This parser deliberately knows nothing about `let`, `record`, `type`,
// `module`, or any other Lain meaning.  It consumes the shared lossless lexer
// and builds only atoms and delimiter groups.  The semantic interpretation is
// a later meta/domain-parser phase.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.release-pages(addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_source_nil(addr %source) -> addr;
#extern #proc tool_is_nil(addr %source, addr %value) -> i1;
#extern #proc tool_source_data(addr %source) -> addr;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc tool_byte_at(addr %data, i64 %index) -> i8;
#extern #proc tool_token_kind(addr %token) -> i32;
#extern #proc tool_token_start(addr %token) -> i64;
#extern #proc tool_token_length(addr %token) -> i64;
#extern #proc tool_token_next(addr %token) -> addr;

// RawAst node layout:
//   kind @0 (1 atom, 2 group), delimiter @4,
//   source start @8, source length @16, first child @24,
//   last child @32, next sibling @40, token kind @48,
//   child count @56.
#proc raw_node_nil() -> addr {
  #let %nil: addr = #call bootstrap.allocate-pages(64)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=0)
  // The sentinel is a real RawAst node.  Keep every pointer slot self-linked
  // so callers may safely ask for first/last/next before checking raw_is_nil.
  // The old zero-filled assumption was false for the page allocator and made
  // a harmless traversal of the sentinel dereference address 0.
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=4)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=16)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=24)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=56)
  #return %nil
}

#proc raw_is_nil(addr %node) -> i1 {
  #return #eq(#load[i8](%node), 0)
}

#proc raw_node_new(
  i32 %kind, i32 %delimiter, i64 %start, i64 %length, i32 %token_kind
) -> addr {
  #let %node: addr = #call bootstrap.allocate-pages(64)
  #let %nil: addr = #call raw_node_nil()
  #store %kind, #lea(base=%node, idx=0, scale=0, offset=0)
  #store %delimiter, #lea(base=%node, idx=0, scale=0, offset=4)
  #store %start, #lea(base=%node, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%node, idx=0, scale=0, offset=16)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=24)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=40)
  #store %token_kind, #lea(base=%node, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%node, idx=0, scale=0, offset=56)
  #return %node
}

#proc raw_node_kind(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=0))
}

#proc raw_node_delimiter(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=4))
}

#proc raw_node_start(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=8))
}

#proc raw_node_length(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=16))
}

#proc raw_node_first(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=24))
}

#proc raw_node_last(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=32))
}

#proc raw_node_next(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=40))
}

#proc raw_node_token_kind(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=48))
}

#proc raw_node_set_next(addr %node, addr %next) -> #unit {
  #store %next, #lea(base=%node, idx=0, scale=0, offset=40)
  #return
}

#proc raw_append(addr %parent, addr %child) -> #unit {
  #let %first: addr = #call raw_node_first(%parent)
  #let %last: addr = #call raw_node_last(%parent)
  #if #call raw_is_nil(%first) {
    #store %child, #lea(base=%parent, idx=0, scale=0, offset=24)
  } else {
    #call raw_node_set_next(%last, %child)
  }
  #store %child, #lea(base=%parent, idx=0, scale=0, offset=32)
  #store #add(
    #load[i64](#lea(base=%parent, idx=0, scale=0, offset=56)),
    1
  ), #lea(base=%parent, idx=0, scale=0, offset=56)
  #return
}

// Cursor layout: current token @0, end position of last consumed token @8.
#proc raw_cursor_new(addr %token) -> addr {
  #let %cursor: addr = #call bootstrap.allocate-pages(16)
  #store %token, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #return %cursor
}

#proc raw_cursor_token(addr %cursor) -> addr {
  #return #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=0))
}

#proc raw_cursor_set_token(addr %cursor, addr %token) -> #unit {
  #store %token, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #return
}

#proc raw_cursor_end(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=8))
}

#proc raw_cursor_set_end(addr %cursor, i64 %end) -> #unit {
  #store %end, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #return
}

#proc raw_matching_close(i8 %open) -> i8 {
  #if #eq(%open, 40) { #return 41 }
  #if #eq(%open, 91) { #return 93 }
  #if #eq(%open, 123) { #return 125 }
  #return 0
}

#proc raw_is_open(i8 %byte) -> i1 {
  #if #eq(%byte, 40) { #return 1 }
  #if #eq(%byte, 91) { #return 1 }
  #if #eq(%byte, 123) { #return 1 }
  #return 0
}

// Parse children until EOF or the requested closing delimiter.  The cursor is
// advanced past a matching close, so callers can continue appending siblings.
#proc raw_parse_children(
  addr %source, addr %cursor, addr %parent, i8 %close
) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #loop children {
    #let %token: addr = #call raw_cursor_token(%cursor)
    #if #call tool_is_nil(%source, %token) { #break children }
    #let %kind: i32 = #call tool_token_kind(%token)
    #if #eq(%kind, 0) { #break children }
    #let %start: i64 = #call tool_token_start(%token)
    #let %length: i64 = #call tool_token_length(%token)
    #let %byte: i8 = #call tool_byte_at(%data, %start)
    #if #ne(%close, 0) {
      #if #eq(%byte, %close) {
        #call raw_cursor_set_token(%cursor, #call tool_token_next(%token))
        #call raw_cursor_set_end(%cursor, #add(%start, %length))
        #return
      }
    }
    #call raw_cursor_set_token(%cursor, #call tool_token_next(%token))
    #if #call raw_is_open(%byte) {
      #let %group: addr = #call raw_node_new(2, #zext[#bits<32>](%byte), %start, 0, 0)
      #call raw_parse_children(
        %source, %cursor, %group, #call raw_matching_close(%byte)
      )
      #let %end: i64 = #call raw_cursor_end(%cursor)
      #if #eq(%end, 0) { %end: i64 = #add(%start, %length) }
      #store #sub(%end, %start), #lea(base=%group, idx=0, scale=0, offset=16)
      #call raw_append(%parent, %group)
    } else {
      #let %atom: addr = #call raw_node_new(
        1, 0, %start, %length, %kind
      )
      #call raw_append(%parent, %atom)
      #call raw_cursor_set_end(%cursor, #add(%start, %length))
    }
    #continue children
  }
  #return
}

#proc raw_parse(addr %source, addr %tokens) -> addr {
  #let %length: i64 = #load[i64](#lea(base=%source, idx=0, scale=0, offset=8))
  #let %root: addr = #call raw_node_new(2, 0, 0, %length, 0)
  #let %cursor: addr = #call raw_cursor_new(%tokens)
  #call raw_parse_children(%source, %cursor, %root, 0)
  #return %root
}

#proc raw_dump_bytes(addr %data, i64 %start, i64 %length) -> #unit {
  #let %index: i64 = 0
  #loop bytes {
    #if #ge(%index, %length) { #break bytes }
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #add(%start, %index))
    )
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc raw_dump(addr %source, addr %node) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #if #eq(#call raw_node_kind(%node), 1) {
    #call bootstrap.artifact-write-literal("(atom ")
    #call raw_dump_bytes(
      %data, #call raw_node_start(%node), #call raw_node_length(%node)
    )
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(#call raw_node_delimiter(%node), 0) {
    #call bootstrap.artifact-write-literal("(root")
  } else {
    #call bootstrap.artifact-write-literal("(group ")
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #call raw_node_start(%node))
    )
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop dump_children {
    #if #call raw_is_nil(%child) { #break dump_children }
    #call bootstrap.artifact-write-literal(" ")
    #call raw_dump(%source, %child)
    %child: addr = #call raw_node_next(%child)
    #continue dump_children
  }
  #call bootstrap.artifact-write-literal(")")
  #return
}

#proc lain_raw_ast_dump() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #call bootstrap.artifact-begin()
  #call raw_dump(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return 0
}

// ---------------------------------------------------------------------------
// AST view and transform operations.
//
// RawAst is a topology-only tree: atoms (kind 1) and delimiter groups
// (kind 2).  The functions below layer the first semantic views on top of
// that topology and add the structural transforms macros and lowering will
// need.  They are self-contained (only bootstrap/tool externs), so the same
// bundle can be exercised directly by the seed runner.
// ---------------------------------------------------------------------------

// Compare the text of node [start, start+length) with a literal string.
// Returns 1 when equal.  length is in bytes; text must be null-terminated.
#proc ast_span_equal(
  addr %source, addr %node, addr %text, i64 %length
) -> i1 {
  #if #ne(#call raw_node_length(%node), %length) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %length) { #break compare }
    #if #ne(
      #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index)),
      #call tool_byte_at(%text, %index)
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

// Is node an atom (identifier) whose text equals `text`?
#proc ast_is_atom(addr %source, addr %node, addr %text, i64 %length) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #return #call ast_span_equal(%source, %node, %text, %length)
}

// Is node the `Name(args)` postfix-call topology: an atom followed by a
// parenthesised group?  Vec(i32), foo(x) and Result(i32, Error) all share
// this shape; the caller decides whether it is a call or a type application.
#proc ast_is_postfix_group(addr %node) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #let %group: addr = #call raw_node_next(%node)
  #if #call raw_is_nil(%group) { #return 0 }
  #if #ne(#call raw_node_kind(%group), 2) { #return 0 }
  #if #ne(#call raw_node_delimiter(%group), 40) { #return 0 }
  #return 1
}

// The callee/name node of a postfix-group node (the leading atom).
#proc ast_postfix_name(addr %node) -> addr {
  #if #eq(#call ast_is_postfix_group(%node), 0) { #return #call raw_node_nil() }
  #return %node
}

// The argument group node of a postfix-group node (the following paren).
#proc ast_postfix_args(addr %node) -> addr {
  #if #eq(#call ast_is_postfix_group(%node), 0) { #return #call raw_node_nil() }
  #return #call raw_node_next(%node)
}

// Is node a call `name(args)` (name is an identifier, group is paren)?
// Type applications share the topology but are distinguished by context;
// this predicate is the call view of the shared shape.
#proc ast_is_call(addr %node) -> i1 {
  #return #call ast_is_postfix_group(%node)
}

// Count the nodes in the subtree rooted at node (inclusive).  Iterative
// traversal with an explicit stack of work items: each frame holds a node
// and the next sibling to visit after its subtree.  Depth-bounded at 256.
#proc ast_node_count(addr %root) -> i64 {
  // Stack frame: [node @0, next @8] on a 16-byte page chain.
  #let %stack: addr = #call bootstrap.allocate-pages(#mul(16, 256))
  #let %sp: i64 = 0
  #let %count: i64 = 0
  // Push (root, nil).
  #store %root, #lea(base=%stack, idx=%sp, scale=16, offset=0)
  #store #call raw_node_nil(), #lea(base=%stack, idx=%sp, scale=16, offset=8)
  %sp: i64 = #add(%sp, 1)
  #loop walk {
    #if #eq(%sp, 0) { #break walk }
    %sp: i64 = #sub(%sp, 1)
    #let %node: addr = #load[addr](#lea(base=%stack, idx=%sp, scale=16, offset=0))
    #let %next: addr = #load[addr](#lea(base=%stack, idx=%sp, scale=16, offset=8))
    #if #call raw_is_nil(%node) {
      #if #call raw_is_nil(%next) { #continue walk }
      // Advance to the sibling.
      #store %next, #lea(base=%stack, idx=%sp, scale=16, offset=0)
      #store #call raw_node_nil(), #lea(base=%stack, idx=%sp, scale=16, offset=8)
      %sp: i64 = #add(%sp, 1)
      #continue walk
    }
    %count: i64 = #add(%count, 1)
    // Push (first_child, next_sibling).
    #store #call raw_node_first(%node), #lea(base=%stack, idx=%sp, scale=16, offset=0)
    #store #call raw_node_next(%node), #lea(base=%stack, idx=%sp, scale=16, offset=8)
    %sp: i64 = #add(%sp, 1)
    #continue walk
  }
  #call bootstrap.release-pages(%stack)
  #return %count
}

// Replace the first child of parent whose address equals old_child with
// new_child, keeping the sibling chain: the replacement takes over the
// old child's next link.  Returns 1 when a replacement happened.
#proc ast_replace_child(
  addr %parent, addr %old_child, addr %new_child
) -> i1 {
  #let %child: addr = #call raw_node_first(%parent)
  #let %prev: addr = #call raw_node_nil()
  #let %replaced: i1 = 0
  #loop scan {
    #if #call raw_is_nil(%child) { #break scan }
    #if #eq(%child, %old_child) {
      // The replacement continues the old child's sibling chain.
      #call raw_node_set_next(%new_child, #call raw_node_next(%child))
      #if #eq(#call raw_is_nil(%prev), 0) {
        #call raw_node_set_next(%prev, %new_child)
      } else {
        #store %new_child, #lea(base=%parent, idx=0, scale=0, offset=24)
      }
      %replaced: i1 = 1
      #break scan
    }
    %prev: addr = %child
    %child: addr = #call raw_node_next(%child)
    #continue scan
  }
  #return %replaced
}

// Remove the first child of parent whose address equals child, splicing
// the sibling chain.  Returns 1 when a removal happened.
#proc ast_remove_child(addr %parent, addr %child) -> i1 {
  #let %c: addr = #call raw_node_first(%parent)
  #let %prev: addr = #call raw_node_nil()
  #let %removed: i1 = 0
  #loop scan {
    #if #call raw_is_nil(%c) { #break scan }
    #if #eq(%c, %child) {
      #if #eq(#call raw_is_nil(%prev), 0) {
        #call raw_node_set_next(%prev, #call raw_node_next(%c))
      } else {
        #store #call raw_node_next(%c), #lea(base=%parent, idx=0, scale=0, offset=24)
      }
      %removed: i1 = 1
      #break scan
    }
    %prev: addr = %c
    %c: addr = #call raw_node_next(%c)
    #continue scan
  }
  #return %removed
}

// Deep-copy the subtree rooted at node.  Returns a fresh, disconnected tree
// with identical topology, spans and token kinds.  Depth-bounded at 256.
#proc ast_copy(addr %node) -> addr {
  #let %kind: i32 = #call raw_node_kind(%node)
  #let %copy: addr = #call raw_node_new(
    %kind,
    #call raw_node_delimiter(%node),
    #call raw_node_start(%node),
    #call raw_node_length(%node),
    #call raw_node_token_kind(%node)
  )
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #call raw_append(%copy, #call ast_copy(%child))
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return %copy
}

// Add delta to every node start in the subtree rooted at node.  Used to
// rebase a subtree parsed from a sub-buffer back to the parent source's
// coordinates.  Recursive (depth bounded by tree depth).
#proc ast_relocate(addr %node, i64 %delta) -> #unit {
  #let %start: i64 = #call raw_node_start(%node)
  #store #add(%start, %delta), #lea(base=%node, idx=0, scale=0, offset=8)
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #call ast_relocate(%child, %delta)
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return
}

// Parse the source text [start, start+length) of source into a fresh,
// independent AST tree.  A temporary source object is built over the same
// data bytes, lexed and parsed; the resulting nodes are then rebased by
// `start` so their spans refer back to the parent source.  This is the
// text -> AST generation direction used by macro expansion.
#proc ast_from_text(addr %source, i64 %start, i64 %length) -> addr {
  #let %data: addr = #call tool_source_data(%source)
  #let %sub_data: addr = #lea(base=%data, idx=%start, scale=1, offset=0)
  #let %sub: addr = #call tool_source_new(%sub_data, %length)
  #let %tokens: addr = #call tool_lex_all(%sub)
  #let %root: addr = #call raw_parse(%sub, %tokens)
  #call ast_relocate(%root, %start)
  #call bootstrap.release-pages(%sub)
  #return %root
}

// Find the first atom child of parent whose text equals `text`; returns
// nil when absent.  Walks the sibling chain only (no descent).
#proc ast_find_atom(
  addr %source, addr %parent, addr %text, i64 %length
) -> addr {
  #let %child: addr = #call raw_node_first(%parent)
  #loop scan {
    #if #call raw_is_nil(%child) { #break scan }
    #if #eq(#call ast_is_atom(%source, %child, %text, %length), 1) {
      #return %child
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan
  }
  #return #call raw_node_nil()
}

// Find the first atom in a whole subtree (depth-first) whose text equals
// `text`.  Returns nil when absent.  This is the template placeholder
// search used by macro instantiation.
#proc ast_find_atom_deep(
  addr %source, addr %node, addr %text, i64 %length
) -> addr {
  #if #call raw_is_nil(%node) { #return #call raw_node_nil() }
  #if #eq(#call ast_is_atom(%source, %node, %text, %length), 1) {
    #return %node
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #let %hit: addr = #call ast_find_atom_deep(%source, %child, %text, %length)
    #if #eq(#call raw_is_nil(%hit), 0) { #return %hit }
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return #call raw_node_nil()
}

// Write the source text of an AST subtree to the artifact stream: atoms
// emit their original bytes, groups emit the opening delimiter, each child
// in order, and the matching closing delimiter.  A root node (delimiter 0)
// emits its children with no wrapper.  This is the AST -> text direction:
// together with raw_parse (text -> AST) it closes the round trip that
// macro expansion needs.
#proc ast_write(addr %source, addr %node) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #if #eq(#call raw_node_kind(%node), 1) {
    #call raw_dump_bytes(
      %data, #call raw_node_start(%node), #call raw_node_length(%node)
    )
    #return
  }
  #let %delim: i32 = #call raw_node_delimiter(%node)
  #if #ne(%delim, 0) {
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #call raw_node_start(%node))
    )
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop write_children {
    #if #call raw_is_nil(%child) { #break write_children }
    #call ast_write(%source, %child)
    %child: addr = #call raw_node_next(%child)
    #continue write_children
  }
  #if #ne(%delim, 0) {
    #call bootstrap.artifact-write-byte(
      #call raw_matching_close(#trunc[#bits<8>](#trunc[#bits<32>](#zext[#bits<64>](%delim))))
    )
  }
  #return
}

// Write a non-negative integer in decimal to the artifact stream.
#proc ast_write_decimal(i64 %value) -> #unit {
  #if #eq(%value, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #let %buffer: addr = #alloca(32)
  #let %index: i64 = 32
  #let %remaining: i64 = %value
  #loop digits {
    #if #eq(%remaining, 0) { #break digits }
    %index: i64 = #sub(%index, 1)
    #let %quotient: i64 = #div(%remaining, 10)
    #let %digit: i64 = #sub(
      %remaining, #mul(%quotient, 10)
    )
    #store #trunc[#bits<8>](#add(48, %digit)),
      #lea(base=%buffer, idx=%index, scale=1, offset=0)
    %remaining: i64 = %quotient
    #continue digits
  }
  #loop write_digits {
    #if #ge(%index, 32) { #break write_digits }
    #call bootstrap.artifact-write-byte(
      #load[i8](#lea(base=%buffer, idx=%index, scale=1, offset=0))
    )
    %index: i64 = #add(%index, 1)
    #continue write_digits
  }
  #return
}

// Probe entry: parse `let x = foo(1, 2);`, then exercise the AST views and
// transforms.  Writes one line per check to the artifact:
//   call:<0|1> name:<text> args_count:<n> nodes:<n> replaced:<0|1> after:<n>
// Returns 0 when every check produced the expected result.
#proc lain_ast_ops_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #let %buf: addr = #call bootstrap.allocate-pages(4096)
  #let %buflen: i64 = 0
  #call bootstrap.artifact-begin()
  // Find the top-level `foo(1, 2)` postfix group: the second child of the
  // `let` statement's initializer position.  Walk top-level: root children
  // are (let, x, =, foo-group, ;) — locate the node whose text is "foo" and
  // which is a postfix group.
  #let %child: addr = #call raw_node_first(%root)
  #let %found: addr = #call raw_node_nil()
  #loop scan_root {
    #if #call raw_is_nil(%child) { #break scan_root }
    #if #eq(#call ast_is_call(%child), 1) {
      %found: addr = %child
      #break scan_root
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_root
  }
  #if #call raw_is_nil(%found) { %status: i32 = 3 }
  // call:1
  #call bootstrap.artifact-write-literal("call:")
  #call ast_write_decimal(#zext[#bits<64>](#call ast_is_call(%found)))
  // name:foo
  #call bootstrap.artifact-write-literal(" name:")
  #let %name: addr = #call ast_postfix_name(%found)
  #call raw_dump_bytes(
    %data, #call raw_node_start(%name), #call raw_node_length(%name)
  )
  // args:  the paren group child count (foo, 1, 2 => 3)
  #call bootstrap.artifact-write-literal(" args:")
  #call ast_write_decimal(#call ast_node_count(#call ast_postfix_args(%found)))
  // nodes: whole-tree count
  #call bootstrap.artifact-write-literal(" nodes:")
  #call ast_write_decimal(#call ast_node_count(%root))
  // replace: swap found's first arg atom (1) for a copy of the second (2)
  #let %args: addr = #call ast_postfix_args(%found)
  #let %first_arg: addr = #call raw_node_first(%args)
  #let %second_arg: addr = #call raw_node_next(#call raw_node_next(%first_arg))
  #let %repl: addr = #call ast_copy(%second_arg)
  #let %replaced: i1 = #call ast_replace_child(%args, %first_arg, %repl)
  #call bootstrap.artifact-write-literal(" replaced:")
  #call ast_write_decimal(#zext[#bits<64>](%replaced))
  #call bootstrap.artifact-write-literal(" after:")
  #call ast_write_decimal(#call ast_node_count(%args))
  // text: the transformed call written back as source text (name + args)
  #call bootstrap.artifact-write-literal(" text:")
  #call ast_write(%source, %found)
  #call ast_write(%source, %args)
  // copy: deep copy of the paren args group preserves node count
  #let %copy: addr = #call ast_copy(#call ast_postfix_args(%found))
  #call bootstrap.artifact-write-literal(" copy:")
  #call ast_write_decimal(#call ast_node_count(%copy))
  // gen: re-parse the original call text into a fresh AST and write it back
  #let %gen: addr = #call ast_from_text(
    %source, #call raw_node_start(%found), 9
  )
  #call bootstrap.artifact-write-literal(" gen:")
  #call ast_write_decimal(#call ast_node_count(%gen))
  #call bootstrap.artifact-write-literal(" gentext:")
  #call ast_write(%source, #call raw_node_first(%gen))
  #call ast_write(%source, #call raw_node_next(#call raw_node_first(%gen)))
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Macro-instantiation probe.  Fixture:
//   let y = twice(21);
//   let t = (x + x);
// "twice" is treated as a macro whose expansion template is the
// parenthesised body of `let t = <template>;`.  The probe:
//   1. finds the `twice(21)` call and parses its argument (21) into an AST;
//   2. finds the template group after `let t = ` and parses it into an AST;
//   3. replaces every `x` placeholder in the template with a copy of the
//      argument subtree (macro instantiation);
//   4. writes the instantiated template back as text.
// Output line: tmpl:<text> args:<count> first_x:<0|1> inst:<text>
#proc lain_macro_expand_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // 1. Find the `twice(21)` call and the template group.
  #let %child: addr = #call raw_node_first(%root)
  #let %call: addr = #call raw_node_nil()
  #let %template: addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
        %call: addr = %child
      }
    }
    // Template: `let t = (x + x);` — after `t` and `=` is the group.
    #if #eq(#call ast_is_atom(%source, %child, "t", 1), 1) {
      #let %eq: addr = #call raw_node_next(%child)
      #if #eq(#call raw_is_nil(%eq), 0) {
        #if #eq(#call ast_is_atom(%source, %eq, "=", 1), 1) {
          %template: addr = #call raw_node_next(%eq)
        }
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // 2. Argument subtree: parse `twice(`'s first argument span.
  #let %args: addr = #call ast_postfix_args(%call)
  #let %first_arg: addr = #call raw_node_first(%args)
  #let %arg_tree: addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  #call bootstrap.artifact-write-literal(" tmpl:")
  #call ast_write(%source, %template)
  #call bootstrap.artifact-write-literal(" args:")
  #call ast_write_decimal(#call ast_node_count(%arg_tree))
  // 3. Instantiate: replace each `x` placeholder in the template group
  //    with a copy of the argument subtree.
  #let %x1: addr = #call ast_find_atom(%source, %template, "x", 1)
  #let %found_x: i1 = 0
  #if #eq(#call raw_is_nil(%x1), 0) {
    #call ast_replace_child(%template, %x1, #call ast_copy(%arg_tree))
    %found_x: i1 = 1
  }
  #let %x2: addr = #call ast_find_atom(%source, %template, "x", 1)
  #if #eq(#call raw_is_nil(%x2), 0) {
    #call ast_replace_child(%template, %x2, #call ast_copy(%arg_tree))
  }
  #call bootstrap.artifact-write-literal(" first_x:")
  #call ast_write_decimal(#zext[#bits<64>](%found_x))
  // 4. Write the instantiated template.
  #call bootstrap.artifact-write-literal(" inst:")
  #call ast_write(%source, %template)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Macro-declaration probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// The probe recognises `let NAME = macro(PARAM) { TEMPLATE };`, extracts
// the macro name, parameter and template group, finds the call site,
// substitutes the argument for the parameter in the template and writes
// the expansion back.
// Output: name:<m> param:<p> tmpl:<t> arg:<a> inst:<expanded>
#proc lain_macro_decl_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Walk top-level: the declaration is `let twice = macro (x) { ... };`
  // parsed as: let, twice, =, macro, (x), { ... }, ;
  // `macro` is an atom followed by its parameter group `(x)`; the template
  // brace group follows that.  Find the `macro` atom.
  #let %child: addr = #call raw_node_first(%root)
  #let %macro_atom: addr = #call raw_node_nil()
  #let %call: addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: addr = %child
      } else {
        #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
          %call: addr = %child
        }
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // Parameter group is the sibling after `macro`.
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  // Template brace group follows the parameter group.
  #let %template_brace: addr = #call raw_node_next(%param_group)
  // Macro name: `let` NAME `=` `macro` -> two siblings before macro_atom.
  #let %name: addr = #call raw_node_nil()
  #let %scan: addr = #call raw_node_first(%root)
  #loop find_name {
    #if #call raw_is_nil(%scan) { #break find_name }
    #if #eq(#call raw_node_next(%scan), %macro_atom) {
      // scan is `=`; two before it is the name.
      %name: addr = #call raw_node_nil()
      #let %scan2: addr = #call raw_node_first(%root)
      #loop find_name2 {
        #if #call raw_is_nil(%scan2) { #break find_name2 }
        #if #eq(#call raw_node_next(%scan2), %scan) {
          %name: addr = %scan2
          #break find_name2
        }
        %scan2: addr = #call raw_node_next(%scan2)
        #continue find_name2
      }
      #break find_name
    }
    %scan: addr = #call raw_node_next(%scan)
    #continue find_name
  }
  // Macro parameter: first child of the parameter group (the atom `x`).
  #let %param: addr = #call raw_node_first(%param_group)
  // Template body: the brace group `{ (x + x) }`'s first child is the
  // inner paren group `(x + x)` — substitute inside it.
  #let %body: addr = #call raw_node_first(%template_brace)
  // Call argument: first child of twice(...)'s arg group (the atom `21`).
  #let %call_arg: addr = #call raw_node_first(
    #call ast_postfix_args(%call)
  )
  #let %arg_tree: addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Output fields.
  #call bootstrap.artifact-write-literal(" name:")
  #call raw_dump_bytes(
    %data, #call raw_node_start(%name), #call raw_node_length(%name)
  )
  #call bootstrap.artifact-write-literal(" param:")
  #call raw_dump_bytes(
    %data, #call raw_node_start(%param), #call raw_node_length(%param)
  )
  #call bootstrap.artifact-write-literal(" tmpl:")
  #call ast_write(%source, %body)
  #call bootstrap.artifact-write-literal(" arg:")
  #call ast_write(%source, %arg_tree)
  // Instantiate: replace every atom whose text equals the param inside the
  // template body with a copy of the argument subtree.  Two explicit
  // passes cover `x + x` without a substitution loop.
  #let %plen: i64 = #call raw_node_length(%param)
  #let %pdata: addr = #call tool_source_data(%source)
  #let %pstart: i64 = #call raw_node_start(%param)
  #let %hit1: addr = #call raw_node_nil()
  #let %c2: addr = #call raw_node_first(%body)
  #loop find_in_body1 {
    #if #call raw_is_nil(%c2) { #break find_in_body1 }
    #if #eq(
      #call ast_span_equal(
        %source, %c2,
        #lea(base=%pdata, idx=%pstart, scale=1, offset=0),
        %plen
      ),
      1
    ) {
      %hit1: addr = %c2
      #break find_in_body1
    }
    %c2: addr = #call raw_node_next(%c2)
    #continue find_in_body1
  }
  #if #eq(#call raw_is_nil(%hit1), 0) {
    #call ast_replace_child(%body, %hit1, #call ast_copy(%arg_tree))
  }
  #let %hit2: addr = #call raw_node_nil()
  #let %c3: addr = #call raw_node_first(%body)
  #loop find_in_body2 {
    #if #call raw_is_nil(%c3) { #break find_in_body2 }
    #if #eq(
      #call ast_span_equal(
        %source, %c3,
        #lea(base=%pdata, idx=%pstart, scale=1, offset=0),
        %plen
      ),
      1
    ) {
      %hit2: addr = %c3
      #break find_in_body2
    }
    %c3: addr = #call raw_node_next(%c3)
    #continue find_in_body2
  }
  #if #eq(#call raw_is_nil(%hit2), 0) {
    #call ast_replace_child(%body, %hit2, #call ast_copy(%arg_tree))
  }
  #call bootstrap.artifact-write-literal(" inst:")
  #call ast_write(%source, %body)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Program-level macro expansion probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// The probe recognises the macro declaration, removes it from the tree,
// then replaces the call site `twice(21)` with the expanded template
// `(21 + 21)` inside the tree, and writes the whole program back.
// Output: prog:<full program text with the call expanded>
#proc lain_macro_program_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Find the `macro` atom; its parameter group and template brace are the
  // next two siblings; the declaration spans from `let` to `;`.
  #let %child: addr = #call raw_node_first(%root)
  #let %macro_atom: addr = #call raw_node_nil()
  #let %call_name: addr = #call raw_node_nil()
  #let %call_group: addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: addr = %child
      } else {
        #if #eq(#call ast_span_equal(%source, %child, "twice", 5), 1) {
          %call_name: addr = %child
          %call_group: addr = #call raw_node_next(%child)
        }
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_top
  }
  // Template body: brace group after the parameter group.
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  #let %template_brace: addr = #call raw_node_next(%param_group)
  #let %body: addr = #call raw_node_first(%template_brace)
  // Macro parameter text.
  #let %param: addr = #call raw_node_first(%param_group)
  #let %plen: i64 = #call raw_node_length(%param)
  #let %pdata: addr = #call tool_source_data(%source)
  #let %pstart: i64 = #call raw_node_start(%param)
  // Call argument subtree.
  #let %call_arg: addr = #call raw_node_first(%call_group)
  #let %arg_tree: addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Substitute both placeholders in the template body.
  #let %hit1: addr = #call raw_node_nil()
  #let %c2: addr = #call raw_node_first(%body)
  #loop find1 {
    #if #call raw_is_nil(%c2) { #break find1 }
    #if #eq(#call ast_span_equal(%source, %c2, #lea(base=%pdata, idx=%pstart, scale=1, offset=0), %plen), 1) {
      %hit1: addr = %c2
      #break find1
    }
    %c2: addr = #call raw_node_next(%c2)
    #continue find1
  }
  #if #eq(#call raw_is_nil(%hit1), 0) {
    #call ast_replace_child(%body, %hit1, #call ast_copy(%arg_tree))
  }
  #let %hit2: addr = #call raw_node_nil()
  #let %c3: addr = #call raw_node_first(%body)
  #loop find2 {
    #if #call raw_is_nil(%c3) { #break find2 }
    #if #eq(#call ast_span_equal(%source, %c3, #lea(base=%pdata, idx=%pstart, scale=1, offset=0), %plen), 1) {
      %hit2: addr = %c3
      #break find2
    }
    %c3: addr = #call raw_node_next(%c3)
    #continue find2
  }
  #if #eq(#call raw_is_nil(%hit2), 0) {
    #call ast_replace_child(%body, %hit2, #call ast_copy(%arg_tree))
  }
  // The expanded template subtree now replaces the call site: first remove
  // the call's arg group, then replace the call name atom with a copy of
  // the expanded body (keeping the declaration's own template intact).
  #call ast_remove_child(%root, %call_group)
  #call ast_replace_child(%root, %call_name, #call ast_copy(%body))
  // Remove the macro declaration: the first seven root children are
  // `let` `twice` `=` `macro` `(x)` `{template}` `;`.  Remove them in
  // order by repeatedly deleting the first root child.
  #let %count: i64 = 0
  #loop remove_decl {
    #if #ge(%count, 7) { #break remove_decl }
    #let %first: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: i64 = #add(%count, 1)
    #continue remove_decl
  }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Find the next macro call site in the root's sibling chain: a postfix
// group whose name atom's text equals `text` (length `len`).  Returns the
// name atom, or nil when none remains.  Single loop, no nesting.
#proc ast_find_macro_call(
  addr %source, addr %root, addr %text, i64 %len
) -> addr {
  #let %c: addr = #call raw_node_first(%root)
  #loop scan {
    #if #call raw_is_nil(%c) { #break scan }
    #if #eq(#call ast_is_postfix_group(%c), 1) {
      #if #eq(#call ast_span_equal(%source, %c, %text, %len), 1) {
        #return %c
      }
    }
    %c: addr = #call raw_node_next(%c)
    #continue scan
  }
  #return #call raw_node_nil()
}

// Depth-first search for a macro call site anywhere in the tree: a
// postfix group whose name atom's text equals `text`.  Recurses into
// group children so calls nested inside expanded templates are found.
#proc ast_find_macro_call_deep(
  addr %source, addr %node, addr %text, i64 %len
) -> addr {
  #if #call raw_is_nil(%node) { #return #call raw_node_nil() }
  #if #eq(#call ast_is_postfix_group(%node), 1) {
    #if #eq(#call ast_span_equal(%source, %node, %text, %len), 1) {
      #return %node
    }
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #let %hit: addr = #call ast_find_macro_call_deep(%source, %child, %text, %len)
    #if #eq(#call raw_is_nil(%hit), 0) { #return %hit }
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return #call raw_node_nil()
}

// Find the parent group whose sibling chain contains `node`, searching
// depth-first from root.  Returns the parent or nil.
#proc ast_find_parent(addr %root, addr %node) -> addr {
  #let %child: addr = #call raw_node_first(%root)
  #loop scan {
    #if #call raw_is_nil(%child) { #break scan }
    #if #eq(%child, %node) { #return %root }
    #if #eq(#call raw_node_kind(%child), 2) {
      #let %p: addr = #call ast_find_parent(%child, %node)
      #if #eq(#call raw_is_nil(%p), 0) { #return %p }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan
  }
  #return #call raw_node_nil()
}

// Expand one macro call site in place.  call_name is the name atom of the
// call (`twice`), call_group its argument group `(args)`.  The template
// body (a group like `(x + x)`) has every atom matching the macro
// parameter's text replaced by a copy of the argument subtree, then the
// call's arg group is removed and the call name atom is replaced by the
// expanded body.  This mutates the sibling chain under the call's parent.
#proc ast_expand_macro_call(
  addr %source,
  addr %root,
  addr %call_name,
  addr %call_group,
  addr %body_template,
  addr %param
) -> #unit {
  // Argument subtree from the call's first arg.
  #let %call_arg: addr = #call raw_node_first(%call_group)
  #let %arg_tree: addr = #call ast_from_text(
    %source,
    #call raw_node_start(%call_arg),
    #call raw_node_length(%call_arg)
  )
  // Parameter span for placeholder matching.
  #let %plen: i64 = #call raw_node_length(%param)
  #let %pdata: addr = #call tool_source_data(%source)
  #let %pstart: i64 = #call raw_node_start(%param)
  // Work on a copy of the template so each expansion starts fresh.
  #let %body: addr = #call ast_copy(%body_template)
  // Replace every placeholder (deep search handles placeholders nested
  // inside groups like `(inc(x))`).
  #let %ph: addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
  #call ast_substitute(%source, %body, %ph, %plen, %arg_tree)
  // Splice the expansion into the call site: find the call's parent
  // (it may be nested inside a group), replace the name atom there (the
  // expansion takes over the name's next link, which is the arg group),
  // then remove the now-dangling arg group.
  #let %parent: addr = #call ast_find_parent(%root, %call_name)
  #if #eq(#call raw_is_nil(%parent), 0) {
    #call ast_replace_child(%parent, %call_name, %body)
    #call ast_remove_child(%parent, %call_group)
  }
  #return
}

// Replace every atom in the subtree rooted at node whose text equals
// placeholder [ph, ph+plen) with a copy of arg_tree.  Recursive descent:
// for each child, if it is a matching atom, replace it in this node's
// sibling chain; otherwise recurse into the child's subtree.
#proc ast_substitute(
  addr %source,
  addr %node,
  addr %ph,
  i64 %plen,
  addr %arg_tree
) -> #unit {
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #if #eq(#call ast_is_atom(%source, %child, %ph, %plen), 1) {
      #call ast_replace_child(%node, %child, #call ast_copy(%arg_tree))
    } else {
      #if #eq(#call raw_node_kind(%child), 2) {
        #call ast_substitute(%source, %child, %ph, %plen, %arg_tree)
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return
}

// Multi-call-site macro expansion probe.  Fixture:
//   let twice = macro(x) { (x + x) };
//   let a = twice(21);
//   let b = twice(5);
//   let c = twice(1);
// End offset of the argument expression starting at atom `node` inside a
// group: scan siblings until a top-level comma or the group end.  Returns
// the end offset of the last expression atom.
#proc ast_arg_expr_end(addr %source, addr %node) -> i64 {
  #let %cur: addr = %node
  #let %end: i64 = #add(
    #call raw_node_start(%cur), #call raw_node_length(%cur)
  )
  #let %scanning: i1 = 1
  #loop scan {
    #if #eq(%scanning, 0) { #break scan }
    #let %nxt: addr = #call raw_node_next(%cur)
    #if #eq(#call raw_is_nil(%nxt), 0) {
      #if #eq(#call ast_is_atom(%source, %nxt, ",", 1), 1) {
        %scanning: i1 = 0
      } else {
        %cur: addr = %nxt
        %end: i64 = #add(
          #call raw_node_start(%cur), #call raw_node_length(%cur)
        )
      }
    } else {
      %scanning: i1 = 0
    }
    #continue scan
  }
  #return %end
}

// Replace every parameter placeholder in `body` with the corresponding
// argument subtree.  Both groups are `atom , atom , ...` sibling chains
// (the comma is an atom whose text is ",").  Positions pair up:
// param[0] -> arg[0], param[1] -> arg[1], etc.  An argument may be a
// whole expression (`2 * 3`), so its span runs to the next comma.  Uses
// ast_substitute for each pair so nested placeholders are replaced too.
#proc ast_substitute_params(
  addr %source,
  addr %body,
  addr %param_group,
  addr %arg_group
) -> #unit {
  #let %p: addr = #call raw_node_first(%param_group)
  #let %a: addr = #call raw_node_first(%arg_group)
  #let %done: i1 = 0
  #loop pairs {
    #if #eq(%done, 1) { #break pairs }
    #if #eq(#call raw_is_nil(%p), 0) {
      #if #eq(#call raw_is_nil(%a), 0) {
        // p is a param atom, a is the first atom of the matching argument.
        #let %pdata: addr = #call tool_source_data(%source)
        #let %plen: i64 = #call raw_node_length(%p)
        #let %pstart: i64 = #call raw_node_start(%p)
        #let %ph: addr = #lea(base=%pdata, idx=%pstart, scale=1, offset=0)
        #let %aend: i64 = #call ast_arg_expr_end(%source, %a)
        #let %arg_tree: addr = #call ast_from_text(
          %source,
          #call raw_node_start(%a),
          #sub(%aend, #call raw_node_start(%a))
        )
        #call ast_substitute(%source, %body, %ph, %plen, %arg_tree)
        // Advance p past any comma, then a past its whole expression and
        // the following comma.
        #let %pn: addr = #call raw_node_next(%p)
        #if #eq(#call raw_is_nil(%pn), 0) {
          #if #eq(#call ast_is_atom(%source, %pn, ",", 1), 1) {
            %p: addr = #call raw_node_next(%pn)
          } else {
            %p: addr = %pn
          }
        } else {
          %p: addr = %pn
        }
        // Move a to the next argument: walk to the node whose end equals
        // aend, then take its next (the comma) and skip it.
        #let %an: addr = %a
        #let %a_done: i1 = 0
        #loop advance_a {
          #if #eq(%a_done, 1) { #break advance_a }
          #if #eq(#call raw_is_nil(%an), 0) {
            #if #eq(
              #add(#call raw_node_start(%an), #call raw_node_length(%an)),
              %aend
            ) {
              %an: addr = #call raw_node_next(%an)
              %a_done: i1 = 1
            } else {
              %an: addr = #call raw_node_next(%an)
            }
          } else {
            %a_done: i1 = 1
          }
          #continue advance_a
        }
        #if #eq(#call raw_is_nil(%an), 0) {
          #if #eq(#call ast_is_atom(%source, %an, ",", 1), 1) {
            %a: addr = #call raw_node_next(%an)
          } else {
            %a: addr = %an
          }
        } else {
          %a: addr = %an
        }
      } else {
        %done: i1 = 1
      }
    } else {
      %done: i1 = 1
    }
    #continue pairs
  }
  #return
}

// Multi-parameter macro expansion probe.  Fixture:
//   let add = macro(x, y) { (x + y) };
//   let z = add(3, 4);
// The probe recognises the declaration, removes it, expands the call by
// substituting each parameter with its matching argument, and writes the
// program back.
// Output: prog:<rewritten program>
#proc lain_macro_multi_param_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: addr = #call raw_node_first(%root)
  #let %macro_atom: addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: addr = %child
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  #let %template_brace: addr = #call raw_node_next(%param_group)
  #let %body: addr = #call raw_node_first(%template_brace)
  // Locate the call site `add(3, 4)`.
  #let %call_name: addr = #call ast_find_macro_call(%source, %root, "add", 3)
  #let %call_group: addr = #call raw_node_next(%call_name)
  // Remove the declaration (7 top-level nodes).
  #let %count: i64 = 0
  #loop remove_decl {
    #if #ge(%count, 7) { #break remove_decl }
    #let %first: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: i64 = #add(%count, 1)
    #continue remove_decl
  }
  // Expand: substitute params with args, then replace the call site.
  #let %expanded_body: addr = #call ast_copy(%body)
  #call ast_substitute_params(%source, %expanded_body, %param_group, %call_group)
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}
// Multi-call-site macro expansion probe (one macro name, many calls).
#proc lain_macro_multi_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Find the macro declaration.
  #let %child: addr = #call raw_node_first(%root)
  #let %macro_atom: addr = #call raw_node_nil()
  #loop scan_top {
    #if #call raw_is_nil(%child) { #break scan_top }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: addr = %child
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_top
  }
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  #let %template_brace: addr = #call raw_node_next(%param_group)
  #let %body_template: addr = #call raw_node_first(%template_brace)
  #let %param: addr = #call raw_node_first(%param_group)
  // Expand every call site whose name is `twice`.
  #let %expanded: i64 = 0
  #let %scanning: i1 = 1
  #loop expand_all {
    #if #eq(%scanning, 0) { #break expand_all }
    #let %name_node: addr = #call ast_find_macro_call(
      %source, %root, "twice", 5
    )
    #if #eq(#call raw_is_nil(%name_node), 0) {
      #let %group_node: addr = #call raw_node_next(%name_node)
      #call ast_expand_macro_call(
        %source, %root, %name_node, %group_node, %body_template, %param
      )
      %expanded: i64 = #add(%expanded, 1)
    } else {
      %scanning: i1 = 0
    }
    #continue expand_all
  }
  // Remove the macro declaration (first seven root children).
  #let %count: i64 = 0
  #loop remove_decl {
    #if #ge(%count, 7) { #break remove_decl }
    #let %first: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: i64 = #add(%count, 1)
    #continue remove_decl
  }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-literal(" expanded:")
  #call ast_write_decimal(%expanded)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Find the template info for macro `name` (length `len`) in the root's
// sibling chain: returns the parameter atom of the matching declaration,
// or nil.  The template brace is its next sibling, the body is inside it.
// Assumes the declaration shape `let NAME = macro(P) { BODY };`.
#proc ast_macro_param(addr %source, addr %root, addr %text, i64 %len) -> addr {
  #let %c: addr = #call raw_node_first(%root)
  #loop scan {
    #if #call raw_is_nil(%c) { #break scan }
    #if #eq(#call ast_is_postfix_group(%c), 1) {
      #if #eq(#call ast_span_equal(%source, %c, %text, %len), 1) {
        // c is the NAME atom of `let NAME = macro(P) {...}`; the macro
        // atom and its param group follow the `=`.
        #return %c
      }
    }
    %c: addr = #call raw_node_next(%c)
    #continue scan
  }
  #return #call raw_node_nil()
}

// Nested macro expansion probe.  Fixture:
//   let inc = macro(x) { (x + 1) };
//   let twice = macro(x) { (inc(x) + inc(x)) };
//   let y = twice(21);
// Expanding `twice(21)` first yields `(inc(21) + inc(21))`; the loop then
// expands the inner `inc` calls to `(21 + 1)` each.  Expansion repeats
// until no macro call remains, then declarations are removed and the
// whole program is written back.
// Output: prog:<rewritten program> expanded:<count>
#proc lain_macro_nested_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Locate both declarations by finding each `macro` postfix group.
  // `let NAME = macro (P) {B} ;`: macro's previous sibling is `=`, whose
  // previous sibling is NAME; macro's next is (P), then {B}.
  #let %inc_param: addr = #call raw_node_nil()
  #let %inc_body: addr = #call raw_node_nil()
  #let %twice_param: addr = #call raw_node_nil()
  #let %twice_body: addr = #call raw_node_nil()
  #let %child: addr = #call raw_node_first(%root)
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        // NAME is two siblings before macro; (P) and {B} follow it.
        #let %eq_node: addr = #call raw_node_nil()
        #let %name_node: addr = #call raw_node_nil()
        #let %scan2: addr = #call raw_node_first(%root)
        #loop find_eq {
          #if #call raw_is_nil(%scan2) { #break find_eq }
          #if #eq(#call raw_node_next(%scan2), %child) {
            %eq_node: addr = %scan2
            #break find_eq
          }
          %scan2: addr = #call raw_node_next(%scan2)
          #continue find_eq
        }
        #let %scan3: addr = #call raw_node_first(%root)
        #loop find_name {
          #if #call raw_is_nil(%scan3) { #break find_name }
          #if #eq(#call raw_node_next(%scan3), %eq_node) {
            %name_node: addr = %scan3
            #break find_name
          }
          %scan3: addr = #call raw_node_next(%scan3)
          #continue find_name
        }
        #let %param_group: addr = #call raw_node_next(%child)
        #let %brace: addr = #call raw_node_next(%param_group)
        #if #eq(#call ast_span_equal(%source, %name_node, "inc", 3), 1) {
          %inc_param: addr = #call raw_node_first(%param_group)
          %inc_body: addr = #call raw_node_first(%brace)
        }
        #if #eq(#call ast_span_equal(%source, %name_node, "twice", 5), 1) {
          %twice_param: addr = #call raw_node_first(%param_group)
          %twice_body: addr = #call raw_node_first(%brace)
        }
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  // Remove both macro declarations before expanding, so deep searches do
  // not mistake template internals for call sites.  Each declaration is
  // 7 top-level nodes (let NAME = macro (P) {B} ;).
  #let %rcount: i64 = 0
  #loop remove_decls {
    #if #ge(%rcount, 14) { #break remove_decls }
    #let %rfirst: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%rfirst), 0) {
      #call ast_remove_child(%root, %rfirst)
    }
    %rcount: i64 = #add(%rcount, 1)
    #continue remove_decls
  }
  // Expand every macro call until none remains.  Prefer expanding `inc`
  // (the inner macro) first so `twice` templates containing `inc` are
  // re-scanned after their own expansion.
  #let %expanded: i64 = 0
  #let %scanning: i1 = 1
  #loop expand_all {
    #if #eq(%scanning, 0) { #break expand_all }
    #if #ge(%expanded, 12) { #break expand_all }
    #let %name_node: addr = #call ast_find_macro_call_deep(
      %source, %root, "inc", 3
    )
    #let %group_node: addr = #call raw_node_nil()
    #let %param_sel: addr = %inc_param
    #let %body_sel: addr = %inc_body
    #if #eq(#call raw_is_nil(%name_node), 0) {
      %group_node: addr = #call raw_node_next(%name_node)
    } else {
      %name_node: addr = #call ast_find_macro_call_deep(
        %source, %root, "twice", 5
      )
      %param_sel: addr = %twice_param
      %body_sel: addr = %twice_body
      #if #eq(#call raw_is_nil(%name_node), 0) {
        %group_node: addr = #call raw_node_next(%name_node)
      }
    }
    #if #eq(#call raw_is_nil(%name_node), 0) {
      #call ast_expand_macro_call(
        %source, %root, %name_node, %group_node, %body_sel, %param_sel
      )
      %expanded: i64 = #add(%expanded, 1)
    } else {
      %scanning: i1 = 0
    }
    #continue expand_all
  }
  // Verify the expansion left no macro calls behind: count residual
  // `twice` / `inc` call sites anywhere in the tree.
  #let %residual: i64 = 0
  #let %rnode: addr = #call ast_find_macro_call_deep(%source, %root, "inc", 3)
  #if #eq(#call raw_is_nil(%rnode), 0) { %residual: i64 = #add(%residual, 1) }
  #let %rnode2: addr = #call ast_find_macro_call_deep(%source, %root, "twice", 5)
  #if #eq(#call raw_is_nil(%rnode2), 0) { %residual: i64 = #add(%residual, 1) }
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-literal(" expanded:")
  #call ast_write_decimal(%expanded)
  #call bootstrap.artifact-write-literal(" residual:")
  #call ast_write_decimal(%residual)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Integrated AST-ops probe: one run demonstrates the whole mechanism.
// Fixture:
//   let twice = macro(x) { (x + x) };
//   let y = twice(21);
// Steps: parse, view the call (ast_is_call/postfix), transform a copy
// (replace first arg), expand the macro call, remove the declaration,
// write the program back and count the result.
// Output: view:<0|1> replaced:<0|1> prog:<text>
#proc lain_ast_all_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // 1. View: find the `twice(21)` call.
  #let %name_node: addr = #call ast_find_macro_call(%source, %root, "twice", 5)
  #let %view: i1 = 0
  #if #eq(#call raw_is_nil(%name_node), 0) { %view: i1 = 1 }
  // 2. Transform: copy the call's argument group and replace its first
  //    argument with a copy of itself — proves copy+replace on a subtree
  //    without touching the original tree.
  #let %replaced: i1 = 0
  #if #eq(%view, 1) {
    #let %group_node: addr = #call raw_node_next(%name_node)
    #let %arg_copy: addr = #call ast_copy(%group_node)
    #let %first_arg: addr = #call raw_node_first(%arg_copy)
    #if #eq(#call raw_is_nil(%first_arg), 0) {
      #call ast_replace_child(
        %arg_copy, %first_arg, #call ast_copy(%first_arg)
      )
      %replaced: i1 = 1
    }
  }
  // 3. Macro expansion: find and remove the declaration, expand the call.
  #let %macro_atom: addr = #call ast_find_macro_call(%source, %root, "macro", 5)
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  #let %template_brace: addr = #call raw_node_next(%param_group)
  #let %body: addr = #call raw_node_first(%template_brace)
  #let %param: addr = #call raw_node_first(%param_group)
  #let %call_name: addr = #call ast_find_macro_call(%source, %root, "twice", 5)
  #if #eq(#call raw_is_nil(%call_name), 0) {
    #let %call_group: addr = #call raw_node_next(%call_name)
    #call ast_expand_macro_call(
      %source, %root, %call_name, %call_group, %body, %param
    )
  }
  // 4. Remove the declaration (7 top-level nodes) and write back.
  #let %count: i64 = 0
  #loop remove_decl {
    #if #ge(%count, 7) { #break remove_decl }
    #let %first: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: i64 = #add(%count, 1)
    #continue remove_decl
  }
  #call bootstrap.artifact-write-literal("view:")
  #call ast_write_decimal(#zext[#bits<64>](%view))
  #call bootstrap.artifact-write-literal(" replaced:")
  #call ast_write_decimal(#zext[#bits<64>](%replaced))
  #call bootstrap.artifact-write-literal(" prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}

// Compile-integration probe: expand a macro whose template is a bare
// expression, so the expansion is plain Lain the reference compiler can
// compile.  Fixture:
//   let val = macro(x) { x };
//   let y = val(42);
// Expansion yields `let y = 42;`.  The test harness appends a `main` and
// compiles it with the reference lainc, proving macro output is
// compilable Lain, not just parseable.
// Output: prog:<rewritten program>
#proc lain_macro_compile_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #call bootstrap.artifact-begin()
  // Locate the `macro` declaration.
  #let %child: addr = #call raw_node_first(%root)
  #let %macro_atom: addr = #call raw_node_nil()
  #loop scan_decls {
    #if #call raw_is_nil(%child) { #break scan_decls }
    #if #eq(#call ast_is_postfix_group(%child), 1) {
      #if #eq(#call ast_span_equal(%source, %child, "macro", 5), 1) {
        %macro_atom: addr = %child
      }
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_decls
  }
  #let %param_group: addr = #call raw_node_next(%macro_atom)
  #let %template_brace: addr = #call raw_node_next(%param_group)
  #let %body: addr = #call raw_node_first(%template_brace)
  #let %param: addr = #call raw_node_first(%param_group)
  // Locate the call `val(42)`.
  #let %call_name: addr = #call ast_find_macro_call(%source, %root, "val", 3)
  #let %call_group: addr = #call raw_node_next(%call_name)
  // Remove the declaration (7 top-level nodes).
  #let %count: i64 = 0
  #loop remove_decl {
    #if #ge(%count, 7) { #break remove_decl }
    #let %first: addr = #call raw_node_first(%root)
    #if #eq(#call raw_is_nil(%first), 0) {
      #call ast_remove_child(%root, %first)
    }
    %count: i64 = #add(%count, 1)
    #continue remove_decl
  }
  // Expand: the template body is the bare placeholder `x`; substitute
  // the argument, then replace the call site with the expansion.
  #let %expanded_body: addr = #call ast_copy(%body)
  #let %ph: addr = #call tool_source_data(%source)
  #let %pstart: i64 = #call raw_node_start(%param)
  #let %plen: i64 = #call raw_node_length(%param)
  #let %ph_off: addr = #lea(base=%ph, idx=%pstart, scale=1, offset=0)
  #let %first_arg: addr = #call raw_node_first(%call_group)
  #let %arg_tree: addr = #call ast_from_text(
    %source,
    #call raw_node_start(%first_arg),
    #call raw_node_length(%first_arg)
  )
  // If the whole template body is the placeholder itself (bare `x`),
  // the expansion is just the argument subtree.
  #if #eq(#call ast_is_atom(%source, %body, %ph_off, %plen), 1) {
    %expanded_body: addr = #call ast_copy(%arg_tree)
  } else {
    #call ast_substitute(%source, %expanded_body, %ph_off, %plen, %arg_tree)
  }
  #call ast_replace_child(%root, %call_name, %expanded_body)
  #call ast_remove_child(%root, %call_group)
  // Write the whole program back.
  #call bootstrap.artifact-write-literal("prog:")
  #call ast_write(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}
