// Lain surface parser, first LAIN-IR vertical slice.
//
// This parser deliberately knows nothing about `let`, `record`, `type`,
// `module`, or any other Lain meaning.  It consumes the shared lossless lexer
// and builds only atoms and delimiter groups.  The semantic interpretation is
// a later meta/domain-parser phase.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.release-pages(addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_source_nil(addr %source) -> addr;
#extern #proc tool_is_nil(addr %source, addr %value) -> i1;
#extern #proc tool_source_data(addr %source) -> addr;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc tool_byte_at(addr %data, i64 %index) -> i8;
#extern #proc tool_token_kind(addr %token) -> i32;
#extern #proc tool_token_start(addr %token) -> i64;
#extern #proc tool_token_length(addr %token) -> i64;
#extern #proc tool_token_next(addr %token) -> addr;

// RawAst node layout:
//   kind @0 (1 atom, 2 group), delimiter @4,
//   source start @8, source length @16, first child @24,
//   last child @32, next sibling @40, token kind @48,
//   child count @56.
#proc raw_node_nil() -> addr {
  #let %nil: addr = #call bootstrap.allocate-pages(64)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=0)
  // The sentinel is a real RawAst node.  Keep every pointer slot self-linked
  // so callers may safely ask for first/last/next before checking raw_is_nil.
  // The old zero-filled assumption was false for the page allocator and made
  // a harmless traversal of the sentinel dereference address 0.
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=4)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=16)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=24)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%nil, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%nil, idx=0, scale=0, offset=56)
  #return %nil
}

#proc raw_is_nil(addr %node) -> i1 {
  #return #eq(#load[i8](%node), 0)
}

#proc raw_node_new(
  i32 %kind, i32 %delimiter, i64 %start, i64 %length, i32 %token_kind
) -> addr {
  #let %node: addr = #call bootstrap.allocate-pages(64)
  #let %nil: addr = #call raw_node_nil()
  #store %kind, #lea(base=%node, idx=0, scale=0, offset=0)
  #store %delimiter, #lea(base=%node, idx=0, scale=0, offset=4)
  #store %start, #lea(base=%node, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%node, idx=0, scale=0, offset=16)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=24)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=32)
  #store %nil, #lea(base=%node, idx=0, scale=0, offset=40)
  #store %token_kind, #lea(base=%node, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%node, idx=0, scale=0, offset=56)
  #return %node
}

#proc raw_node_kind(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=0))
}

#proc raw_node_delimiter(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=4))
}

#proc raw_node_start(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=8))
}

#proc raw_node_length(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=16))
}

#proc raw_node_first(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=24))
}

#proc raw_node_last(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=32))
}

#proc raw_node_next(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=40))
}

#proc raw_node_token_kind(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=48))
}

#proc raw_node_set_next(addr %node, addr %next) -> #unit {
  #store %next, #lea(base=%node, idx=0, scale=0, offset=40)
  #return
}

#proc raw_append(addr %parent, addr %child) -> #unit {
  #let %first: addr = #call raw_node_first(%parent)
  #let %last: addr = #call raw_node_last(%parent)
  #if #call raw_is_nil(%first) {
    #store %child, #lea(base=%parent, idx=0, scale=0, offset=24)
  } else {
    #call raw_node_set_next(%last, %child)
  }
  #store %child, #lea(base=%parent, idx=0, scale=0, offset=32)
  #store #add(
    #load[i64](#lea(base=%parent, idx=0, scale=0, offset=56)),
    1
  ), #lea(base=%parent, idx=0, scale=0, offset=56)
  #return
}

// Cursor layout: current token @0, end position of last consumed token @8.
#proc raw_cursor_new(addr %token) -> addr {
  #let %cursor: addr = #call bootstrap.allocate-pages(16)
  #store %token, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #return %cursor
}

#proc raw_cursor_token(addr %cursor) -> addr {
  #return #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=0))
}

#proc raw_cursor_set_token(addr %cursor, addr %token) -> #unit {
  #store %token, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #return
}

#proc raw_cursor_end(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=8))
}

#proc raw_cursor_set_end(addr %cursor, i64 %end) -> #unit {
  #store %end, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #return
}

#proc raw_matching_close(i8 %open) -> i8 {
  #if #eq(%open, 40) { #return 41 }
  #if #eq(%open, 91) { #return 93 }
  #if #eq(%open, 123) { #return 125 }
  #return 0
}

#proc raw_is_open(i8 %byte) -> i1 {
  #if #eq(%byte, 40) { #return 1 }
  #if #eq(%byte, 91) { #return 1 }
  #if #eq(%byte, 123) { #return 1 }
  #return 0
}

// Parse children until EOF or the requested closing delimiter.  The cursor is
// advanced past a matching close, so callers can continue appending siblings.
#proc raw_parse_children(
  addr %source, addr %cursor, addr %parent, i8 %close
) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #loop children {
    #let %token: addr = #call raw_cursor_token(%cursor)
    #if #call tool_is_nil(%source, %token) { #break children }
    #let %kind: i32 = #call tool_token_kind(%token)
    #if #eq(%kind, 0) { #break children }
    #let %start: i64 = #call tool_token_start(%token)
    #let %length: i64 = #call tool_token_length(%token)
    #let %byte: i8 = #call tool_byte_at(%data, %start)
    #if #ne(%close, 0) {
      #if #eq(%byte, %close) {
        #call raw_cursor_set_token(%cursor, #call tool_token_next(%token))
        #call raw_cursor_set_end(%cursor, #add(%start, %length))
        #return
      }
    }
    #call raw_cursor_set_token(%cursor, #call tool_token_next(%token))
    #if #call raw_is_open(%byte) {
      #let %group: addr = #call raw_node_new(2, #zext[#bits<32>](%byte), %start, 0, 0)
      #call raw_parse_children(
        %source, %cursor, %group, #call raw_matching_close(%byte)
      )
      #let %end: i64 = #call raw_cursor_end(%cursor)
      #if #eq(%end, 0) { %end: i64 = #add(%start, %length) }
      #store #sub(%end, %start), #lea(base=%group, idx=0, scale=0, offset=16)
      #call raw_append(%parent, %group)
    } else {
      #let %atom: addr = #call raw_node_new(
        1, 0, %start, %length, %kind
      )
      #call raw_append(%parent, %atom)
      #call raw_cursor_set_end(%cursor, #add(%start, %length))
    }
    #continue children
  }
  #return
}

#proc raw_parse(addr %source, addr %tokens) -> addr {
  #let %length: i64 = #load[i64](#lea(base=%source, idx=0, scale=0, offset=8))
  #let %root: addr = #call raw_node_new(2, 0, 0, %length, 0)
  #let %cursor: addr = #call raw_cursor_new(%tokens)
  #call raw_parse_children(%source, %cursor, %root, 0)
  #return %root
}

#proc raw_dump_bytes(addr %data, i64 %start, i64 %length) -> #unit {
  #let %index: i64 = 0
  #loop bytes {
    #if #ge(%index, %length) { #break bytes }
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #add(%start, %index))
    )
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc raw_dump(addr %source, addr %node) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #if #eq(#call raw_node_kind(%node), 1) {
    #call bootstrap.artifact-write-literal("(atom ")
    #call raw_dump_bytes(
      %data, #call raw_node_start(%node), #call raw_node_length(%node)
    )
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(#call raw_node_delimiter(%node), 0) {
    #call bootstrap.artifact-write-literal("(root")
  } else {
    #call bootstrap.artifact-write-literal("(group ")
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #call raw_node_start(%node))
    )
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop dump_children {
    #if #call raw_is_nil(%child) { #break dump_children }
    #call bootstrap.artifact-write-literal(" ")
    #call raw_dump(%source, %child)
    %child: addr = #call raw_node_next(%child)
    #continue dump_children
  }
  #call bootstrap.artifact-write-literal(")")
  #return
}

#proc lain_raw_ast_dump() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #call bootstrap.artifact-begin()
  #call raw_dump(%source, %root)
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return 0
}

// ---------------------------------------------------------------------------
// AST view and transform operations.
//
// RawAst is a topology-only tree: atoms (kind 1) and delimiter groups
// (kind 2).  The functions below layer the first semantic views on top of
// that topology and add the structural transforms macros and lowering will
// need.  They are self-contained (only bootstrap/tool externs), so the same
// bundle can be exercised directly by the seed runner.
// ---------------------------------------------------------------------------

// Compare the text of node [start, start+length) with a literal string.
// Returns 1 when equal.  length is in bytes; text must be null-terminated.
#proc ast_span_equal(
  addr %source, addr %node, addr %text, i64 %length
) -> i1 {
  #if #ne(#call raw_node_length(%node), %length) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %index: i64 = 0
  #loop compare {
    #if #ge(%index, %length) { #break compare }
    #if #ne(
      #call tool_byte_at(%data, #add(#call raw_node_start(%node), %index)),
      #call tool_byte_at(%text, %index)
    ) { #return 0 }
    %index: i64 = #add(%index, 1)
    #continue compare
  }
  #return 1
}

// Is node an atom (identifier) whose text equals `text`?
#proc ast_is_atom(addr %source, addr %node, addr %text, i64 %length) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #return #call ast_span_equal(%source, %node, %text, %length)
}

// Is node the `Name(args)` postfix-call topology: an atom followed by a
// parenthesised group?  Vec(i32), foo(x) and Result(i32, Error) all share
// this shape; the caller decides whether it is a call or a type application.
#proc ast_is_postfix_group(addr %node) -> i1 {
  #if #call raw_is_nil(%node) { #return 0 }
  #if #ne(#call raw_node_kind(%node), 1) { #return 0 }
  #let %group: addr = #call raw_node_next(%node)
  #if #call raw_is_nil(%group) { #return 0 }
  #if #ne(#call raw_node_kind(%group), 2) { #return 0 }
  #if #ne(#call raw_node_delimiter(%group), 40) { #return 0 }
  #return 1
}

// The callee/name node of a postfix-group node (the leading atom).
#proc ast_postfix_name(addr %node) -> addr {
  #if #eq(#call ast_is_postfix_group(%node), 0) { #return #call raw_node_nil() }
  #return %node
}

// The argument group node of a postfix-group node (the following paren).
#proc ast_postfix_args(addr %node) -> addr {
  #if #eq(#call ast_is_postfix_group(%node), 0) { #return #call raw_node_nil() }
  #return #call raw_node_next(%node)
}

// Is node a call `name(args)` (name is an identifier, group is paren)?
// Type applications share the topology but are distinguished by context;
// this predicate is the call view of the shared shape.
#proc ast_is_call(addr %node) -> i1 {
  #return #call ast_is_postfix_group(%node)
}

// Count the nodes in the subtree rooted at node (inclusive).  Iterative
// traversal with an explicit stack of work items: each frame holds a node
// and the next sibling to visit after its subtree.  Depth-bounded at 256.
#proc ast_node_count(addr %root) -> i64 {
  // Stack frame: [node @0, next @8] on a 16-byte page chain.
  #let %stack: addr = #call bootstrap.allocate-pages(#mul(16, 256))
  #let %sp: i64 = 0
  #let %count: i64 = 0
  // Push (root, nil).
  #store %root, #lea(base=%stack, idx=%sp, scale=16, offset=0)
  #store #call raw_node_nil(), #lea(base=%stack, idx=%sp, scale=16, offset=8)
  %sp: i64 = #add(%sp, 1)
  #loop walk {
    #if #eq(%sp, 0) { #break walk }
    %sp: i64 = #sub(%sp, 1)
    #let %node: addr = #load[addr](#lea(base=%stack, idx=%sp, scale=16, offset=0))
    #let %next: addr = #load[addr](#lea(base=%stack, idx=%sp, scale=16, offset=8))
    #if #call raw_is_nil(%node) {
      #if #call raw_is_nil(%next) { #continue walk }
      // Advance to the sibling.
      #store %next, #lea(base=%stack, idx=%sp, scale=16, offset=0)
      #store #call raw_node_nil(), #lea(base=%stack, idx=%sp, scale=16, offset=8)
      %sp: i64 = #add(%sp, 1)
      #continue walk
    }
    %count: i64 = #add(%count, 1)
    // Push (first_child, next_sibling).
    #store #call raw_node_first(%node), #lea(base=%stack, idx=%sp, scale=16, offset=0)
    #store #call raw_node_next(%node), #lea(base=%stack, idx=%sp, scale=16, offset=8)
    %sp: i64 = #add(%sp, 1)
    #continue walk
  }
  #call bootstrap.release-pages(%stack)
  #return %count
}

// Replace the first child of parent whose address equals old_child with
// new_child, keeping the sibling chain: the replacement takes over the
// old child's next link.  Returns 1 when a replacement happened.
#proc ast_replace_child(
  addr %parent, addr %old_child, addr %new_child
) -> i1 {
  #let %child: addr = #call raw_node_first(%parent)
  #let %prev: addr = #call raw_node_nil()
  #let %replaced: i1 = 0
  #loop scan {
    #if #call raw_is_nil(%child) { #break scan }
    #if #eq(%child, %old_child) {
      // The replacement continues the old child's sibling chain.
      #call raw_node_set_next(%new_child, #call raw_node_next(%child))
      #if #eq(#call raw_is_nil(%prev), 0) {
        #call raw_node_set_next(%prev, %new_child)
      } else {
        #store %new_child, #lea(base=%parent, idx=0, scale=0, offset=24)
      }
      %replaced: i1 = 1
      #break scan
    }
    %prev: addr = %child
    %child: addr = #call raw_node_next(%child)
    #continue scan
  }
  #return %replaced
}

// Deep-copy the subtree rooted at node.  Returns a fresh, disconnected tree
// with identical topology, spans and token kinds.  Depth-bounded at 256.
#proc ast_copy(addr %node) -> addr {
  #let %kind: i32 = #call raw_node_kind(%node)
  #let %copy: addr = #call raw_node_new(
    %kind,
    #call raw_node_delimiter(%node),
    #call raw_node_start(%node),
    #call raw_node_length(%node),
    #call raw_node_token_kind(%node)
  )
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #call raw_append(%copy, #call ast_copy(%child))
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return %copy
}

// Add delta to every node start in the subtree rooted at node.  Used to
// rebase a subtree parsed from a sub-buffer back to the parent source's
// coordinates.  Recursive (depth bounded by tree depth).
#proc ast_relocate(addr %node, i64 %delta) -> #unit {
  #let %start: i64 = #call raw_node_start(%node)
  #store #add(%start, %delta), #lea(base=%node, idx=0, scale=0, offset=8)
  #let %child: addr = #call raw_node_first(%node)
  #loop children {
    #if #call raw_is_nil(%child) { #break children }
    #call ast_relocate(%child, %delta)
    %child: addr = #call raw_node_next(%child)
    #continue children
  }
  #return
}

// Parse the source text [start, start+length) of source into a fresh,
// independent AST tree.  A temporary source object is built over the same
// data bytes, lexed and parsed; the resulting nodes are then rebased by
// `start` so their spans refer back to the parent source.  This is the
// text -> AST generation direction used by macro expansion.
#proc ast_from_text(addr %source, i64 %start, i64 %length) -> addr {
  #let %data: addr = #call tool_source_data(%source)
  #let %sub_data: addr = #lea(base=%data, idx=%start, scale=1, offset=0)
  #let %sub: addr = #call tool_source_new(%sub_data, %length)
  #let %tokens: addr = #call tool_lex_all(%sub)
  #let %root: addr = #call raw_parse(%sub, %tokens)
  #call ast_relocate(%root, %start)
  #call bootstrap.release-pages(%sub)
  #return %root
}

// Write the source text of an AST subtree to the artifact stream: atoms
// emit their original bytes, groups emit the opening delimiter, each child
// in order, and the matching closing delimiter.  A root node (delimiter 0)
// emits its children with no wrapper.  This is the AST -> text direction:
// together with raw_parse (text -> AST) it closes the round trip that
// macro expansion needs.
#proc ast_write(addr %source, addr %node) -> #unit {
  #let %data: addr = #call tool_source_data(%source)
  #if #eq(#call raw_node_kind(%node), 1) {
    #call raw_dump_bytes(
      %data, #call raw_node_start(%node), #call raw_node_length(%node)
    )
    #return
  }
  #let %delim: i32 = #call raw_node_delimiter(%node)
  #if #ne(%delim, 0) {
    #call bootstrap.artifact-write-byte(
      #call tool_byte_at(%data, #call raw_node_start(%node))
    )
  }
  #let %child: addr = #call raw_node_first(%node)
  #loop write_children {
    #if #call raw_is_nil(%child) { #break write_children }
    #call ast_write(%source, %child)
    %child: addr = #call raw_node_next(%child)
    #continue write_children
  }
  #if #ne(%delim, 0) {
    #call bootstrap.artifact-write-byte(
      #call raw_matching_close(#trunc[#bits<8>](#trunc[#bits<32>](#zext[#bits<64>](%delim))))
    )
  }
  #return
}

// Write a non-negative integer in decimal to the artifact stream.
#proc ast_write_decimal(i64 %value) -> #unit {
  #if #eq(%value, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #let %buffer: addr = #alloca(32)
  #let %index: i64 = 32
  #let %remaining: i64 = %value
  #loop digits {
    #if #eq(%remaining, 0) { #break digits }
    %index: i64 = #sub(%index, 1)
    #let %quotient: i64 = #div(%remaining, 10)
    #let %digit: i64 = #sub(
      %remaining, #mul(%quotient, 10)
    )
    #store #trunc[#bits<8>](#add(48, %digit)),
      #lea(base=%buffer, idx=%index, scale=1, offset=0)
    %remaining: i64 = %quotient
    #continue digits
  }
  #loop write_digits {
    #if #ge(%index, 32) { #break write_digits }
    #call bootstrap.artifact-write-byte(
      #load[i8](#lea(base=%buffer, idx=%index, scale=1, offset=0))
    )
    %index: i64 = #add(%index, 1)
    #continue write_digits
  }
  #return
}

// Probe entry: parse `let x = foo(1, 2);`, then exercise the AST views and
// transforms.  Writes one line per check to the artifact:
//   call:<0|1> name:<text> args_count:<n> nodes:<n> replaced:<0|1> after:<n>
// Returns 0 when every check produced the expected result.
#proc lain_ast_ops_probe() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %root: addr = #call raw_parse(%source, %tokens)
  #let %status: i32 = 0
  #let %buf: addr = #call bootstrap.allocate-pages(4096)
  #let %buflen: i64 = 0
  #call bootstrap.artifact-begin()
  // Find the top-level `foo(1, 2)` postfix group: the second child of the
  // `let` statement's initializer position.  Walk top-level: root children
  // are (let, x, =, foo-group, ;) — locate the node whose text is "foo" and
  // which is a postfix group.
  #let %child: addr = #call raw_node_first(%root)
  #let %found: addr = #call raw_node_nil()
  #loop scan_root {
    #if #call raw_is_nil(%child) { #break scan_root }
    #if #eq(#call ast_is_call(%child), 1) {
      %found: addr = %child
      #break scan_root
    }
    %child: addr = #call raw_node_next(%child)
    #continue scan_root
  }
  #if #call raw_is_nil(%found) { %status: i32 = 3 }
  // call:1
  #call bootstrap.artifact-write-literal("call:")
  #call ast_write_decimal(#zext[#bits<64>](#call ast_is_call(%found)))
  // name:foo
  #call bootstrap.artifact-write-literal(" name:")
  #let %name: addr = #call ast_postfix_name(%found)
  #call raw_dump_bytes(
    %data, #call raw_node_start(%name), #call raw_node_length(%name)
  )
  // args:  the paren group child count (foo, 1, 2 => 3)
  #call bootstrap.artifact-write-literal(" args:")
  #call ast_write_decimal(#call ast_node_count(#call ast_postfix_args(%found)))
  // nodes: whole-tree count
  #call bootstrap.artifact-write-literal(" nodes:")
  #call ast_write_decimal(#call ast_node_count(%root))
  // replace: swap found's first arg atom (1) for a copy of the second (2)
  #let %args: addr = #call ast_postfix_args(%found)
  #let %first_arg: addr = #call raw_node_first(%args)
  #let %second_arg: addr = #call raw_node_next(#call raw_node_next(%first_arg))
  #let %repl: addr = #call ast_copy(%second_arg)
  #let %replaced: i1 = #call ast_replace_child(%args, %first_arg, %repl)
  #call bootstrap.artifact-write-literal(" replaced:")
  #call ast_write_decimal(#zext[#bits<64>](%replaced))
  #call bootstrap.artifact-write-literal(" after:")
  #call ast_write_decimal(#call ast_node_count(%args))
  // text: the transformed call written back as source text (name + args)
  #call bootstrap.artifact-write-literal(" text:")
  #call ast_write(%source, %found)
  #call ast_write(%source, %args)
  // copy: deep copy of the paren args group preserves node count
  #let %copy: addr = #call ast_copy(#call ast_postfix_args(%found))
  #call bootstrap.artifact-write-literal(" copy:")
  #call ast_write_decimal(#call ast_node_count(%copy))
  // gen: re-parse the original call text into a fresh AST and write it back
  #let %gen: addr = #call ast_from_text(
    %source, #call raw_node_start(%found), 9
  )
  #call bootstrap.artifact-write-literal(" gen:")
  #call ast_write_decimal(#call ast_node_count(%gen))
  #call bootstrap.artifact-write-literal(" gentext:")
  #call ast_write(%source, #call raw_node_first(%gen))
  #call ast_write(%source, #call raw_node_next(#call raw_node_first(%gen)))
  #call bootstrap.artifact-write-byte(10)
  #call bootstrap.artifact-finish()
  #call bootstrap.release-pages(%source)
  #return %status
}
