// Typed EvalResult ABI shared by the bootstrap evaluator and Meta passes.
//
// EvalResult: status @0, kind @4, scalar value @8, object handle @16,
// resource owner @24, VSpace identity @32, generation @40.  The owner is an
// ABI handle, not a language-level ownership or borrow-checking construct.
// Kind 0 is a scalar; 1 is an unclassified Meta value; 2 is a type;
// 3 is a module; 4 is an AST/syntax value.  Status 0 means success.

#extern #proc bootstrap.allocate-pages(#bits<64> %size) -> #addr;
#extern #proc bootstrap.release-pages(#addr %memory) -> #unit;
#extern #proc meta_value_kind(#addr %value) -> #bits<32>;

#proc eval_result_new_owned_vspace(
  #bits<32> %status, #bits<64> %value, #addr %owner,
  #addr %vspace, #bits<64> %generation
) -> #addr {
  #let %result: #addr = #call bootstrap.allocate-pages(48)
  #store %status, #lea(base=%result, idx=0, scale=0, offset=0)
  #store 0, #lea(base=%result, idx=0, scale=0, offset=4)
  #store %value, #lea(base=%result, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%result, idx=0, scale=0, offset=16)
  #store %owner, #lea(base=%result, idx=0, scale=0, offset=24)
  #store %vspace, #lea(base=%result, idx=0, scale=0, offset=32)
  #store %generation, #lea(base=%result, idx=0, scale=0, offset=40)
  #return %result
}

#proc eval_result_new_owned(
  #bits<32> %status, #bits<64> %value, #addr %owner
) -> #addr {
  #return #call eval_result_new_owned_vspace(
    %status, %value, %owner, %owner, 1
  )
}

#proc eval_result_new(#bits<32> %status, #bits<64> %value) -> #addr {
  #return #call eval_result_new_owned(%status, %value, #int2ptr(0))
}

// Every returned record has one caller-owned allocation.  Caches retain a
// separate copy through eval_result_clone, so a caller may release its record
// after consuming the scalar/object handle without invalidating cached data.
#proc eval_result_clone(#addr %result) -> #addr {
  #if #eq(#ptr2int(%result), 0) { #return #int2ptr(0) }
  #let %copy: #addr = #call bootstrap.allocate-pages(48)
  #store #call eval_status(%result),
    #lea(base=%copy, idx=0, scale=0, offset=0)
  #store #call eval_result_kind(%result),
    #lea(base=%copy, idx=0, scale=0, offset=4)
  #store #call eval_value(%result),
    #lea(base=%copy, idx=0, scale=0, offset=8)
  #store #call eval_object(%result),
    #lea(base=%copy, idx=0, scale=0, offset=16)
  #store #call eval_result_owner(%result),
    #lea(base=%copy, idx=0, scale=0, offset=24)
  #store #call eval_result_vspace(%result),
    #lea(base=%copy, idx=0, scale=0, offset=32)
  #store #call eval_result_generation(%result),
    #lea(base=%copy, idx=0, scale=0, offset=40)
  #return %copy
}

#proc eval_result_release(#addr %result) -> #unit {
  #if #eq(#ptr2int(%result), 0) { #return }
  #call bootstrap.release-pages(%result)
  #return
}

#proc eval_result_object_owned_vspace(
  #bits<32> %status, #addr %object, #addr %owner,
  #addr %vspace, #bits<64> %generation
) -> #addr {
  // Object results carry a Meta value handle.  Meta nil is represented by a
  // tagged value rather than a raw null pointer, so inspect its tag before
  // publishing the result to the next pass.
  #let %meta_kind: #bits<32> = #call meta_value_kind(%object)
  #if #eq(%meta_kind, 0) {
    #let %error: #bits<32> = %status
    #if #eq(%error, 0) { %error: #bits<32> = 5108 }
    #return #call eval_result_new_owned(%error, 0, %owner)
  }
  #let %result: #addr = #call bootstrap.allocate-pages(48)
  #let %kind: #bits<32> = 1
  #if #eq(%meta_kind, 4) { %kind: #bits<32> = 2 }
  #if #eq(%meta_kind, 2) { %kind: #bits<32> = 3 }
  #if #eq(%meta_kind, 5) { %kind: #bits<32> = 4 }
  #store %status, #lea(base=%result, idx=0, scale=0, offset=0)
  #store %kind, #lea(base=%result, idx=0, scale=0, offset=4)
  #store 0, #lea(base=%result, idx=0, scale=0, offset=8)
  #store %object, #lea(base=%result, idx=0, scale=0, offset=16)
  #store %owner, #lea(base=%result, idx=0, scale=0, offset=24)
  #store %vspace, #lea(base=%result, idx=0, scale=0, offset=32)
  #store %generation, #lea(base=%result, idx=0, scale=0, offset=40)
  #return %result
}

#proc eval_result_object_owned(
  #bits<32> %status, #addr %object, #addr %owner
) -> #addr {
  #return #call eval_result_object_owned_vspace(
    %status, %object, %owner, %owner, 1
  )
}

#proc eval_result_object(#bits<32> %status, #addr %object) -> #addr {
  #return #call eval_result_object_owned(%status, %object, #int2ptr(0))
}

#proc eval_status(#addr %result) -> #bits<32> {
  #return #load[#bits<32>](#lea(base=%result, idx=0, scale=0, offset=0))
}

#proc eval_value(#addr %result) -> #bits<64> {
  #return #load[#bits<64>](#lea(base=%result, idx=0, scale=0, offset=8))
}

#proc eval_result_is_object(#addr %result) -> #bits<1> {
  #return #ne(#load[#bits<32>](#lea(base=%result, idx=0, scale=0, offset=4)), 0)
}

#proc eval_result_kind(#addr %result) -> #bits<32> {
  #return #load[#bits<32>](#lea(base=%result, idx=0, scale=0, offset=4))
}

#proc eval_object(#addr %result) -> #addr {
  #return #load[#addr](#lea(base=%result, idx=0, scale=0, offset=16))
}

#proc eval_result_owner(#addr %result) -> #addr {
  #return #load[#addr](#lea(base=%result, idx=0, scale=0, offset=24))
}

#proc eval_result_vspace(#addr %result) -> #addr {
  #return #load[#addr](#lea(base=%result, idx=0, scale=0, offset=32))
}

#proc eval_result_generation(#addr %result) -> #bits<64> {
  #return #load[#bits<64>](#lea(base=%result, idx=0, scale=0, offset=40))
}

#proc eval_result_set_owner(#addr %result, #addr %owner) -> #unit {
  #store %owner, #lea(base=%result, idx=0, scale=0, offset=24)
  #return
}

#proc eval_result_owner_matches_owner(
  #addr %result, #addr %owner
) -> #bits<1> {
  #return #eq(
    #ptr2int(#call eval_result_owner(%result)), #ptr2int(%owner)
  )
}

#proc eval_result_transfer_owner(
  #addr %result, #addr %from_owner, #addr %to_owner
) -> #bits<1> {
  #if #eq(#call eval_result_owner_matches_owner(%result, %from_owner), 0) {
    #return 0
  }
  #call eval_result_set_owner(%result, %to_owner)
  #return 1
}
