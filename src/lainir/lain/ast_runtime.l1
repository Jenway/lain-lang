// Stable AstApi v1 handles for Meta and the bootstrap standard library.
//
// The implementation stays in raw_ast.l1.  This file is the versioned ABI
// surface: callers use these names and do not depend on RawAst field offsets.
// A returned addr is an AST handle owned by the current compile context.

#proc lain_ast_v1_nil() -> addr {
  #return #call raw_node_nil()
}

#proc lain_ast_v1_is_nil(addr %node) -> i1 {
  #return #call raw_is_nil(%node)
}

#proc lain_ast_v1_node_kind(addr %node) -> i32 {
  #return #call raw_node_kind(%node)
}

#proc lain_ast_v1_node_delimiter(addr %node) -> i32 {
  #return #call raw_node_delimiter(%node)
}

#proc lain_ast_v1_node_start(addr %node) -> i64 {
  #return #call raw_node_start(%node)
}

#proc lain_ast_v1_node_length(addr %node) -> i64 {
  #return #call raw_node_length(%node)
}

#proc lain_ast_v1_node_origin_source(addr %node) -> addr {
  #return #call raw_node_origin_source(%node)
}

#proc lain_ast_v1_node_origin_start(addr %node) -> i64 {
  #return #call raw_node_origin_start(%node)
}

#proc lain_ast_v1_node_origin_length(addr %node) -> i64 {
  #return #call raw_node_origin_length(%node)
}

#proc lain_ast_v1_node_syntax_context(addr %node) -> i64 {
  #return #call raw_node_syntax_context(%node)
}

#proc lain_ast_v1_set_syntax_context(addr %node, i64 %context) -> #unit {
  #call raw_node_set_syntax_context(%node, %context)
  #return
}

#proc lain_ast_v1_syntax_context_new() -> addr {
  #return #call raw_syntax_context_new()
}

#proc lain_ast_v1_syntax_context_fresh(addr %context) -> i64 {
  #return #call raw_syntax_context_fresh(%context)
}

#proc lain_ast_v1_syntax_context_source(addr %context) -> addr {
  #return #call raw_syntax_context_source(%context)
}

#proc lain_ast_v1_syntax_context_append(
  addr %context, addr %text, i64 %length
) -> i64 {
  #return #call raw_syntax_context_append(%context, %text, %length)
}

#proc lain_ast_v1_fresh_atom(
  addr %context, addr %text, i64 %length, i32 %token_kind
) -> addr {
  #return #call raw_syntax_context_fresh_atom(
    %context, %text, %length, %token_kind
  )
}

#proc lain_ast_v1_syntax_context_release(addr %context) -> #unit {
  #call raw_syntax_context_release(%context)
  #return
}

#proc lain_ast_v1_node_origin_present(addr %node) -> i1 {
  #return #call raw_node_origin_present(%node)
}

#proc lain_ast_v1_attach_origin(
  addr %node, addr %source, i64 %start, i64 %length
) -> #unit {
  #call raw_node_set_origin(%node, %source, %start, %length)
  #return
}

#proc lain_ast_v1_first_child(addr %node) -> addr {
  #return #call raw_node_first(%node)
}

#proc lain_ast_v1_last_child(addr %node) -> addr {
  #return #call raw_node_last(%node)
}

#proc lain_ast_v1_next_sibling(addr %node) -> addr {
  #return #call raw_node_next(%node)
}

#proc lain_ast_v1_parent(addr %root, addr %node) -> addr {
  #return #call ast_find_parent(%root, %node)
}

#proc lain_ast_v1_new_atom(
  i64 %start, i64 %length, i32 %token_kind
) -> addr {
  #return #call raw_node_new(1, 0, %start, %length, %token_kind)
}

#proc lain_ast_v1_new_group(
  i32 %delimiter, i64 %start, i64 %length
) -> addr {
  #return #call raw_node_new(2, %delimiter, %start, %length, 0)
}

#proc lain_ast_v1_append(addr %parent, addr %child) -> #unit {
  #call raw_append(%parent, %child)
  #return
}

#proc lain_ast_v1_copy(addr %node) -> addr {
  #return #call ast_copy(%node)
}

#proc lain_ast_v1_replace(
  addr %parent, addr %old_child, addr %new_child
) -> i1 {
  #return #call ast_replace_child(%parent, %old_child, %new_child)
}

#proc lain_ast_v1_remove(addr %parent, addr %child) -> i1 {
  #return #call ast_remove_child(%parent, %child)
}

#proc lain_ast_v1_from_text(
  addr %source, i64 %start, i64 %length
) -> addr {
  #return #call ast_from_text(%source, %start, %length)
}

#proc lain_ast_v1_write(addr %source, addr %node) -> #unit {
  #call ast_write(%source, %node)
  #return
}
