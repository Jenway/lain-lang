// Parsed source-unit cache for the unified frontend driver.
//
// Each source is lexed and converted to RawAst once.  After all units exist,
// import targets are resolved into edge vectors; later graph checks consume
// those vectors rather than reparsing source text.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc raw_parse(addr %source, addr %tokens) -> addr;
#extern #proc workspace_node_count(addr %root) -> i64;
#extern #proc workspace_import_count(addr %source, addr %root) -> i64;
#extern #proc workspace_import_target(
  i64 %source_index, addr %source, addr %root,
  i64 %source_count, i64 %ordinal
) -> i64;
#extern #proc workspace_import_is_std_ordinal(
  addr %source, addr %root, i64 %ordinal
) -> i1;
#extern #proc bootstrap.source-path-data(i64 %index) -> addr;
#extern #proc bootstrap.source-path-length(i64 %index) -> i64;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc tool_byte_at(addr %data, i64 %index) -> i8;
#extern #proc meta_write_decimal(i64 %value) -> #unit;
// Header count @0.  Entry stride 40, beginning at @8:
// source @0, root @8, node count @16, import count @24, edge vector @32.
#proc workspace_cache_entry(addr %cache, i64 %index) -> addr {
  #return #lea(base=%cache, idx=%index, scale=40, offset=8)
}

#proc workspace_cache_source(addr %cache, i64 %index) -> addr {
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #return #load[addr](#lea(base=%entry, idx=0, scale=0, offset=0))
}

#proc workspace_cache_root(addr %cache, i64 %index) -> addr {
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #return #load[addr](#lea(base=%entry, idx=0, scale=0, offset=8))
}

#proc workspace_cache_nodes(addr %cache, i64 %index) -> i64 {
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #return #load[i64](#lea(base=%entry, idx=0, scale=0, offset=16))
}

#proc workspace_cache_imports(addr %cache, i64 %index) -> i64 {
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #return #load[i64](#lea(base=%entry, idx=0, scale=0, offset=24))
}

#proc workspace_cache_edges(addr %cache, i64 %index) -> addr {
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #return #load[addr](#lea(base=%entry, idx=0, scale=0, offset=32))
}

#proc workspace_cache_build() -> addr {
  #let %count: i64 = #call bootstrap.source-count()
  #let %cache: addr = #call bootstrap.allocate-pages(#add(8, #mul(%count, 40)))
  #store %count, #lea(base=%cache, idx=0, scale=0, offset=0)
  #let %index: i64 = 0
  #loop sources {
    #if #ge(%index, %count) { #break sources }
    #let %data: addr = #call bootstrap.source-data(%index)
    #let %length: i64 = #call bootstrap.source-length(%index)
    #let %source: addr = #call tool_source_new(%data, %length)
    #let %tokens: addr = #call tool_lex_all(%source)
    #let %root: addr = #call raw_parse(%source, %tokens)
    #let %entry: addr = #call workspace_cache_entry(%cache, %index)
    #store %source, #lea(base=%entry, idx=0, scale=0, offset=0)
    #store %root, #lea(base=%entry, idx=0, scale=0, offset=8)
    #store #call workspace_node_count(%root),
      #lea(base=%entry, idx=0, scale=0, offset=16)
    #store #call workspace_import_count(%source, %root),
      #lea(base=%entry, idx=0, scale=0, offset=24)
    %index: i64 = #add(%index, 1)
    #continue sources
  }
  // Resolve every import after all source units have been parsed.  The edge
  // vector stores a source-count sentinel for malformed or unresolved forms,
  // so later meta phases never need to walk RawAst again.
  %index: i64 = 0
  #loop edges {
    #if #ge(%index, %count) { #break edges }
    #let %entry: addr = #call workspace_cache_entry(%cache, %index)
    #let %source: addr = #load[addr](#lea(base=%entry, idx=0, scale=0, offset=0))
    #let %root: addr = #load[addr](#lea(base=%entry, idx=0, scale=0, offset=8))
    #let %imports: i64 = #load[i64](#lea(base=%entry, idx=0, scale=0, offset=24))
    #let %edges_data: addr = #call bootstrap.allocate-pages(#mul(%imports, 8))
    #store %edges_data, #lea(base=%entry, idx=0, scale=0, offset=32)
    #let %ordinal: i64 = 0
    #loop edge_items {
      #if #ge(%ordinal, %imports) { #break edge_items }
      #store #call workspace_import_target(
        %index, %source, %root, %count, %ordinal
      ), #lea(base=%edges_data, idx=%ordinal, scale=8, offset=0)
      %ordinal: i64 = #add(%ordinal, 1)
      #continue edge_items
    }
    %index: i64 = #add(%index, 1)
    #continue edges
  }
  #return %cache
}

#proc workspace_cache_resolved_import_count(addr %cache, i64 %index) -> i64 {
  #let %imports: i64 = #call workspace_cache_imports(%cache, %index)
  #let %source_count: i64 = #call bootstrap.source-count()
  #let %edges: addr = #call workspace_cache_edges(%cache, %index)
  #let %entry: addr = #call workspace_cache_entry(%cache, %index)
  #let %source: addr = #load[addr](#lea(base=%entry, idx=0, scale=0, offset=0))
  #let %root: addr = #load[addr](#lea(base=%entry, idx=0, scale=0, offset=8))
  #let %resolved: i64 = 0
  #let %ordinal: i64 = 0
  #loop edges {
    #if #ge(%ordinal, %imports) { #break edges }
    #if #lt(#load[i64](#lea(base=%edges, idx=%ordinal, scale=8, offset=0)), %source_count) {
      %resolved: i64 = #add(%resolved, 1)
    } else {
      #if #call workspace_import_is_std_ordinal(%source, %root, %ordinal) {
        %resolved: i64 = #add(%resolved, 1)
      }
    }
    %ordinal: i64 = #add(%ordinal, 1)
    #continue edges
  }
  #return %resolved
}

#proc workspace_cache_reaches_cycle(
  addr %cache, i64 %start, i64 %current,
  i64 %source_count, addr %states
) -> i1 {
  #let %state: i64 = #load[i64](
    #lea(base=%states, idx=%current, scale=8, offset=0)
  )
  #if #eq(%state, 1) { #return 1 }
  #if #eq(%state, 2) { #return 0 }
  #store 1, #lea(base=%states, idx=%current, scale=8, offset=0)
  #let %imports: i64 = #call workspace_cache_imports(%cache, %current)
  #let %edges: addr = #call workspace_cache_edges(%cache, %current)
  #let %ordinal: i64 = 0
  #loop imports {
    #if #ge(%ordinal, %imports) { #break imports }
    #let %target: i64 = #load[i64](
      #lea(base=%edges, idx=%ordinal, scale=8, offset=0)
    )
    #if #lt(%target, %source_count) {
      #if #eq(%target, %start) { #return 1 }
      #if #call workspace_cache_reaches_cycle(
        %cache, %start, %target, %source_count, %states
      ) { #return 1 }
    }
    %ordinal: i64 = #add(%ordinal, 1)
    #continue imports
  }
  #store 2, #lea(base=%states, idx=%current, scale=8, offset=0)
  #return 0
}

#proc workspace_cache_has_cycle(addr %cache, i64 %source_index) -> i1 {
  #let %source_count: i64 = #call bootstrap.source-count()
  #let %states: addr = #call bootstrap.allocate-pages(#mul(%source_count, 8))
  #let %index: i64 = 0
  #loop clear {
    #if #ge(%index, %source_count) { #break clear }
    #store 0, #lea(base=%states, idx=%index, scale=8, offset=0)
    %index: i64 = #add(%index, 1)
    #continue clear
  }
  #return #call workspace_cache_reaches_cycle(
    %cache, %source_index, %source_index, %source_count, %states
  )
}

#proc workspace_cache_write_bytes(addr %data, i64 %length) -> #unit {
  #let %index: i64 = 0
  #loop bytes {
    #if #ge(%index, %length) { #break bytes }
    #call bootstrap.artifact-write-byte(#call tool_byte_at(%data, %index))
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc workspace_cache_write_module(addr %cache, i64 %index) -> #unit {
  #let %path: addr = #call bootstrap.source-path-data(%index)
  #let %path_length: i64 = #call bootstrap.source-path-length(%index)
  #let %imports: i64 = #call workspace_cache_imports(%cache, %index)
  #let %resolved: i64 = #call workspace_cache_resolved_import_count(%cache, %index)
  #let %unresolved: i64 = #sub(%imports, %resolved)
  #let %cycle: i1 = #call workspace_cache_has_cycle(%cache, %index)
  #let %diagnostic: i32 = 0
  #if #gt(%unresolved, 0) {
    %diagnostic: i32 = 4101
  } else {
    #if %cycle { %diagnostic: i32 = 4103 }
  }
  #call bootstrap.artifact-write-literal(" (module ")
  #call workspace_cache_write_bytes(%path, %path_length)
  #call bootstrap.artifact-write-literal(" nodes=")
  #call meta_write_decimal(#call workspace_cache_nodes(%cache, %index))
  #call bootstrap.artifact-write-literal(" imports=")
  #call meta_write_decimal(%imports)
  #call bootstrap.artifact-write-literal(" resolved=")
  #call meta_write_decimal(%resolved)
  #call bootstrap.artifact-write-literal(" unresolved=")
  #call meta_write_decimal(%unresolved)
  #call bootstrap.artifact-write-literal(" cycle=")
  #if %cycle {
    #call bootstrap.artifact-write-byte(49)
  } else {
    #call bootstrap.artifact-write-byte(48)
  }
  #call bootstrap.artifact-write-literal(" diagnostic=")
  #call meta_write_decimal(#zext[#bits<64>](%diagnostic))
  #call bootstrap.artifact-write-byte(41)
  #return
}
