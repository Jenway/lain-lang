// In-memory source workspace.  Single-file compilation is represented by a
// workspace containing one SourceBuffer.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");
let source: Module = import("std::core::source");
let syntax: Module = import("packages::lain::compiler::syntax");

@export
let source_workspace: Module = std::module {

    @export
    let SourceWorkspace = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let Syntax: Module = syntax.Syntax(Memory);
        let SourceBuffer: std::type = source.SourceBuffer(Memory);

        let SourceUnit: std::type = std::struct {
            id: usize,
            source: SourceBuffer,
            syntax_unit: Syntax.UnitId,
        };

        let SourceUnitVector: std::type = vector.Vec(
            SourceUnit,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Workspace: std::type = std::struct {
            syntax: Syntax.Store,
            sources: SourceUnitVector,
        };

        let new = std::func() -> Workspace {
            return Workspace {
                syntax: Syntax.new_store(),
                sources: SourceUnitVector.new(),
            };
        };

        let add = std::func(
            workspace: &mut Workspace,
            value: &SourceBuffer,
        ) -> usize ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let id: usize = workspace.sources.length();
            let syntax_unit: Syntax.UnitId = Syntax.parse(
                &mut workspace.syntax,
                value.contents,
            );
            workspace.sources.push(SourceUnit {
                id: id,
                source: SourceBuffer {
                    path: Memory.String.clone(&value.path),
                    contents: value.contents,
                },
                syntax_unit: syntax_unit,
            });
            return id;
        };

        return std::module {
            @export let SourceBuffer: std::type = SourceBuffer;
            @export let SourceUnit: std::type = SourceUnit;
            @export let Workspace: std::type = Workspace;
            @export let new = new;
            @export let add = add;
        };
    };
};
