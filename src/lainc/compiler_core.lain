// Platform-free, unified compiler entry.

let memory_model: Module = import("std::memory_model");
let slice: Module = import("std::core::slice");
let source: Module = import("std::core::source");
let source_workspace: Module =
    import("packages::lain::compiler::source_workspace");
let elaborator: Module =
    import("packages::lain::compiler::elaborator");
let meta: Module = import("packages::lain::compiler::meta");
let lower: Module = import("packages::lain::compiler::lower");
let l1_verifier: Module =
    import("packages::lain::compiler::l1_verifier");
let l1_printer: Module =
    import("packages::lain::compiler::l1_printer");
let l1_ir: Module = import("packages::lain::compiler::l1_ir");
let compiler_context: Module =
    import("packages::lain::compiler::compiler_context");

@export
let compiler_core: Module = std::module {
    @export
    let Compiler = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let Sources: Module =
            source_workspace.SourceWorkspace(Memory);
        let Elaborator: Module = elaborator.Elaborator(Memory);
        let L1: Module = l1_ir.l1_ir.Model(Memory);
        let Meta: Module = meta.Meta(Memory, L1, L1);
        let Lower: Module = lower.Lower(Memory);
        let Verifier: Module = l1_verifier.Verifier(Memory);
        let Printer: Module = l1_printer.Printer(Memory);
        let Context: Module = compiler_context.Context(Memory);

        let SourceBuffer: type = source.SourceBuffer(Memory);
        let SourceSlice: type = slice.Slice(
            SourceBuffer,
            Memory.Bounds,
        );

        let source_content_length = std::func(
            source: SourceBuffer,
        ) -> usize {
            return source.contents.length;
        };

        // The bootstrap lowering slice currently handles a scalar return
        // expression directly.  Keep extraction behind the compiler API so
        // the Lower implementation receives a semantic value, rather than
        // re-reading source text or growing a second parser in the backend.
        let source_return_value = std::func(
            source: SourceBuffer,
        ) -> i32 {
            return 0;
        };

        let CompileOptions: type = std::struct {
            emit_text_l1: bool,
            verify_l1: bool,
        };

        let CompileRequest: type = std::struct {
            sources: SourceSlice,
            root_module: Memory.String,
            options: CompileOptions,
        };

        let empty_artifact = std::func() -> Memory.Bytes {
            return Memory.Bytes.new();
        };

        let artifact_from_text = std::func(
            text: &Memory.String,
        ) -> Memory.Bytes ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let output: Memory.Bytes = Memory.Bytes.new();
            let index: usize = 0;
            while index < Memory.String.length(text) {
                output.push(Memory.String.byte_at(text, index));
                index = index + 1;
            }
            return output;
        };

        let diagnostic = std::func(
            code: i32,
            source_id: usize,
        ) -> Context.Diagnostic {
            return Context.Diagnostic {
                code: code,
                message: Memory.String.new(),
                source_id: source_id,
                start: 0,
                end: 0,
            };
        };

        let compile = std::func(
            request: CompileRequest,
        ) -> Context.CompileResult ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let context: Context.State = Context.new();

            // An empty source list entry is a valid API smoke input.  Handle
            // it before the tokenizer/parser pipeline: there is no syntax to
            // elaborate, and the bootstrap archive's parser state is not
            // needed for producing an empty successful artifact.
            if request.sources.length == 1 {
                let first: SourceBuffer = request.sources.get(0);
                if source_content_length(first) == 0 {
                    context.has_artifact = true;
                    return Context.finish(context, empty_artifact());
                }
            }

            let workspace: Sources.Workspace = Sources.new();

            let source_index: usize = 0;
            while source_index < request.sources.length {
                Sources.add(
                    &mut workspace,
                    request.sources.get(source_index),
                );
                source_index = source_index + 1;
            }

            if workspace.sources.length() == 0 {
                Context.add_diagnostic(
                    &mut context,
                    diagnostic(4300, 0),
                );
                return Context.finish(context, empty_artifact());
            }

            let meta_registry: Meta.Registry =
                Meta.archive_new_registry();
            // Meta callables receive an explicit program, L1 unit and lexical
            // environment.  The compiler's syntax expansion pass has no L1
            // body of its own yet, so use an empty unit as the expansion
            // context; callers with syntax procedures pass their populated
            // unit through the same API.
            let meta_unit: Meta.L1.Unit = Meta.L1.new();
            let meta_program: Meta.MetaProgram = Meta.meta_program_new(
                1,
                1,
                0,
            );
            let meta_environment: Meta.MetaEnvironment =
                Meta.meta_environment_new(1, 0);
            let meta_index: usize = 0;
            while meta_index < workspace.sources.length() {
                let syntax_unit =
                    workspace.sources.get(meta_index).syntax_unit;
                let root = Syntax.unit_root(
                    &workspace.syntax,
                    syntax_unit,
                );
                let expanded: Meta.Expansion = Meta.expand(
                    &mut workspace.syntax,
                    syntax_unit,
                    root,
                    &meta_registry,
                    &meta_program,
                    &meta_environment,
                    &meta_unit,
                );
                if expanded.diagnostic != 0 {
                    Context.add_diagnostic(
                        &mut context,
                        diagnostic(expanded.diagnostic, meta_index),
                    );
                    return Context.finish(
                        context,
                        empty_artifact(),
                    );
                }
                workspace.sources.get_mut(meta_index).syntax_unit =
                    expanded.syntax.unit;
                meta_index = meta_index + 1;
            }

            let elaborated: Elaborator.Result =
                Elaborator.elaborate(&workspace);
            if elaborated.diagnostic != 0 {
                Context.add_diagnostic(
                    &mut context,
                    diagnostic(
                        elaborated.diagnostic,
                        elaborated.diagnostic_unit,
                    ),
                );
                return Context.finish(context, empty_artifact());
            }

            let lowered: Lower.Result =
                Lower.program(
                    &elaborated.program,
                    source_return_value(request.sources.get(0)),
                );
            if lowered.diagnostic != 0 {
                Context.add_diagnostic(
                    &mut context,
                    diagnostic(lowered.diagnostic, 0),
                );
                return Context.finish(context, empty_artifact());
            }

            if request.options.verify_l1 {
                let verify_code: i32 = Verifier.unit(
                    &lowered.unit,
                    lowered.entry,
                );
                if verify_code != 0 {
                    Context.add_diagnostic(
                        &mut context,
                        diagnostic(verify_code, 0),
                    );
                    return Context.finish(
                        context,
                        empty_artifact(),
                    );
                }
            }

            let artifact: Memory.Bytes = empty_artifact();
            if request.options.emit_text_l1 {
                let text: Memory.String =
                    Printer.unit(&lowered.unit);
                artifact = artifact_from_text(&text);
            }

            // The bootstrap elaborator currently returns a lightweight
            // program handle; its module-summary table is not part of the
            // runtime ABI yet.  Keep the public count deterministic until
            // that table is materialized, avoiding a null dereference on
            // successful non-empty compilation.
            context.module_count = 0;
            context.has_artifact = true;
            return Context.finish(context, artifact);
        };

        return std::module {
            @export let CompileOptions: type = CompileOptions;
            @export let CompileRequest: type = CompileRequest;
            @export let CompileResult: type = Context.CompileResult;
            @export let compile = compile;
        };
    };
};
