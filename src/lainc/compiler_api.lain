// Public in-memory API specialized by a MemoryModel Module.

let memory_model: Module = import("std::memory_model");
let compiler_core: Module =
    import("packages::lain::compiler::compiler_core");
let lainir_api: Module =
    import("packages::lain::lainir::api_contract");

@export
let compiler_api: Module = std::module {
    @export
    let API = std::func(
        Memory: memory_model.Shape,
        Ir: lainir_api.CapabilitiesShape,
    ) -> Module {
        let Compiler: Module = compiler_core.Compiler(Memory, Ir);

        return std::module {
            @export
            let CompileOptions: type =
                Compiler.CompileOptions;

            @export
            let CompileRequest: type =
                Compiler.CompileRequest;

            @export
            let CompileResult: type =
                Compiler.CompileResult;

            @export
            let compile = std::func(
                request: Compiler.CompileRequest,
            ) -> Compiler.CompileResult ! {
                Memory.Allocation.Effect,
                Memory.Bounds.Effect,
            } {
                return Compiler.compile(request);
            };

            // Diagnostics remain compiler-owned values.  Clients can inspect
            // their stable fields without learning the Context vector layout.
            @export
            let diagnostic_count = std::func(
                result: &Compiler.CompileResult,
            ) -> usize {
                return result.diagnostics.length();
            };

            @export
            let diagnostic_code = std::func(
                result: &Compiler.CompileResult,
                index: usize,
            ) -> i32 ! {Memory.Bounds.Effect} {
                return result.diagnostics.get(index).code;
            };

            @export
            let diagnostic_source_id = std::func(
                result: &Compiler.CompileResult,
                index: usize,
            ) -> usize ! {Memory.Bounds.Effect} {
                return result.diagnostics.get(index).source_id;
            };

            @export
            let diagnostic_start = std::func(
                result: &Compiler.CompileResult,
                index: usize,
            ) -> usize ! {Memory.Bounds.Effect} {
                return result.diagnostics.get(index).start;
            };

            @export
            let diagnostic_end = std::func(
                result: &Compiler.CompileResult,
                index: usize,
            ) -> usize ! {Memory.Bounds.Effect} {
                return result.diagnostics.get(index).end;
            };

            @export
            let diagnostic_message = std::func(
                result: &Compiler.CompileResult,
                index: usize,
            ) -> Memory.String ! {
                Memory.Allocation.Effect,
                Memory.Bounds.Effect,
            } {
                return Memory.String.clone(
                    &result.diagnostics.get(index).message,
                );
            };

            @export
            let schema_version =
                std::func() -> i32 { return 3; };
        };
    };
};
