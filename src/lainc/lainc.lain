// Thin compiler entry.
//
// The entry does not choose an allocator, bounds policy, or platform.  Those
// are capabilities owned by the embedding program.  `compiler_api.API` is a
// compile-time factory: the embedding program supplies a MemoryModel Module
// plus a LAINIR capability provider and receives the concrete request/result
// types plus `compile`.

let compiler_api: Module =
    import("packages::lain::compiler::compiler_api");

@export
let lainc: Module = std::module {
    @export
    let API = compiler_api.compiler_api.API;
};
