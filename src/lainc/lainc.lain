                off = 4;
                w = 4;
            } else if index == 2 {
                off = 8;
                w = 4;
            } else if index == 3 {
                off = 12;
                faddr = 1;
            } else if index == 4 {
                off = 20;
                faddr = 1;
            } else if index == 5 {
                off = 28;
                w = 64;
            } else if index == 6 {
                off = 36;
                w = 64;
            } else if index == 7 {
                off = 44;
                w = 64;
            } else if index == 8 {
                off = 52;
                w = 64;
            } else if index == 9 {
                off = 60;
                w = 1;
            }
