// Emit one statement at index.  Returns the index after it.
let emit_stmt = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let s: usize = skip_space(source, index);
    if s >= body_end { return s; }
    let first: i32 = sb_byte_at(source, s);
    if first == 125 { return s; }
    if first == 47 {
        let c3: usize = s;
        while c3 < body_end {
            if sb_byte_at(source, c3) == 10 { break; }
            c3 = c3 + 1;
            let marker: i32 = 0;
        }
        return c3 + 1;
    }
    if sb_span_equals(source, s, 3, "let", 3) {
        return emit_stmt_let(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 5, "while", 5) {
        return emit_stmt_while(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 2, "if", 2) {
        return emit_stmt_if(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 6, "return", 6) {
        return emit_stmt_ret(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 5, "break", 5) {
        let semi: usize = scan_semi(source, s, body_end);
        sb_append_literal(output, "#break\n", 7);
        return semi + 1;
    }
    if sb_span_equals(source, s, 8, "continue", 8) {
        let semi: usize = scan_semi(source, s, body_end);
        sb_append_literal(output, "#continue\n", 10);
        return semi + 1;
    }
    return emit_stmt_other(source, output, s, body_end, layout, types, meta, consts);
};

// Emit the statements in [start, end).
let emit_block = std::func(
    source: addr,
    output: addr,
    start: usize,
    end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let current: usize = start;
    while current < end {
        let s: usize = skip_space(source, current);
        if s >= end { break; }
        if sb_byte_at(source, s) == 125 { break; }
        current = emit_stmt(source, output, s, end, layout, types, meta, consts);
        let marker: i32 = 0;
    }
};

// ---- function lowering ----

// Emit one parameter `name: TYPE` starting at index; returns the index
// just after the type.
let emit_param_one = std::func(
    source: addr,
    output: addr,
    index: usize,
    params_end: usize,
    meta: addr,
) -> usize {
    let current: usize = skip_space(source, index);
    if current >= params_end { return params_end; }
    let name_end: usize = parse_ident(source, current);
    let colon: usize = scan_top_op(source, current, params_end, 58);
    let type_start: usize = colon + 1;
    let type_end: usize = scan_top_op(source, type_start, params_end, 44);
    emit_type(source, type_start, type_end, output, meta);
    sb_append_literal(output, " %", 2);
    sb_append_span(output, source, current, name_end - current);
    return type_end;
};

let emit_params2 = std::func(
    source: addr,
    output: addr,
    params_start: usize,
    params_end: usize,
    meta: addr,
) -> unit {
    let current: usize = params_start;
    let first: i32 = 1;
    while current < params_end {
        current = skip_space(source, current);
        if current >= params_end { break; }
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        current = emit_param_one(source, output, current, params_end, meta);
        current = skip_space(source, current);
        if current < params_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                current = skip_space(source, current);
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Extract the @foreign link_name content start after index ('@'), or 0.
let extract_link = std::func(source: addr, index: usize) -> usize {
    let current: usize = index;
    while current < sb_len(source) {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 10 { return 0; }
        if byte == 59 { return 0; }
        if sb_span_equals(source, current, 9, "link_name", 9) {
            let eq: usize = skip_space(source, current + 9);
            if sb_byte_at(source, eq) == 61 {
                let quote: usize = skip_space(source, eq + 1);
                if sb_byte_at(source, quote) == 34 {
                    return quote + 1;
                }
            }
        }
        current = current + 1;
        let marker: i32 = 0;
    }
    return 0;
};

// Emit the extern label (link_name content, main, compiler_compile, f0_).
// Emit a function label.  Module members are prefixed `f0_<mod>_<member>`
// so two modules can use the same member name without colliding; mod_end
// is 0 for top-level functions.
let emit_label = std::func(
    source: addr,
    output: addr,
    name_start: usize,
    name_end: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    prefix: addr,
) -> unit {
    if link != 0 {
        let scan: usize = link;
        while sb_byte_at(source, scan) != 34 {
            let link_byte: i32 = sb_byte_at(source, scan);
            sb_append(output, link_byte);
            scan = scan + 1;
            let marker: i32 = 0;
        }
        return;
    }
    if sb_len(prefix) != 0 {
        sb_append_literal(output, "f0_", 3);
        sb_append_span(output, prefix, 0, sb_len(prefix));
        sb_append_literal(output, "_", 1);
        sb_append_span(output, source, name_start, name_end - name_start);
        return;
    }
    if mod_end == 0 {
        if sb_span_equals(source, name_start, name_end - name_start, "main", 4) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
        if sb_span_equals(source, name_start, name_end - name_start, "compiler_compile", 16) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
        if sb_span_equals(source, name_start, name_end - name_start, "compiler_compile_library", 24) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
    }
    sb_append_literal(output, "f0_", 3);
    if mod_end != 0 {
        sb_append_span(output, source, mod_start, mod_end - mod_start);
        sb_append_literal(output, "_", 1);
    }
    sb_append_span(output, source, name_start, name_end - name_start);
};

// Emit a parameter-name list `%a, %b` from [params_start, params_end).
let emit_param_names = std::func(
    source: addr,
    output: addr,
    params_start: usize,
    params_end: usize,
) -> unit {
    let current: usize = params_start;
    let first: i32 = 1;
    while current < params_end {
        current = skip_space(source, current);
        if current >= params_end { break; }
        let name_end: usize = parse_ident(source, current);
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        sb_append_literal(output, "%", 1);
        sb_append_span(output, source, current, name_end - current);
        let colon: usize = scan_top_op(source, current, params_end, 58);
        let type_end: usize = scan_top_op(source, colon + 1, params_end, 44);
        current = type_end;
        if current < params_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Emit an @foreign declaration: the #extern (host link) plus a f0_ wrapper
// that forwards the call so emitted call sites keep the f0_NAME label.
let emit_foreign_wrapper = std::func(
    source: addr,
    output: addr,
    name_start: usize,
    name_end: usize,
    params_start: usize,
    params_end: usize,
    ret_start: usize,
    ret_end: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    prefix: addr,
    meta: addr,
) -> unit {
    let marker: i32 = 0;
    // `compile` writes the bootstrap allocator declaration once before
    // lowering the source.  The source itself also declares the allocator
    // through `@foreign`; suppress that one duplicate extern while keeping
    // the forwarding wrapper below.  Duplicate extern procedures are
    // rejected by the LAIN-IR verifier even when their signatures match.
    let allocator: usize = 0;
    if link != 0
        && sb_span_equals(source, link, 24, "bootstrap.allocate-pages", 24) {
        allocator = 1;
    }
    if allocator == 0 {
        sb_append_literal(output, "#extern #proc ", 14);
        emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
        sb_append_literal(output, "(", 1);
        emit_params2(source, output, params_start, params_end, meta);
        sb_append_literal(output, ") -> ", 5);
        emit_type(source, ret_start, ret_end, output, meta);
        sb_append_literal(output, ";\n\n", 3);
    }
    sb_append_literal(output, "#proc f0_", 9);
    if sb_len(prefix) != 0 {
        sb_append_span(output, prefix, 0, sb_len(prefix));
        sb_append_literal(output, "_", 1);
    }
    if mod_end != 0 {
        sb_append_span(output, source, mod_start, mod_end - mod_start);
        sb_append_literal(output, "_", 1);
    }
    sb_append_span(output, source, name_start, name_end - name_start);
    sb_append_literal(output, "(", 1);
    emit_params2(source, output, params_start, params_end, meta);
    sb_append_literal(output, ") -> ", 5);
    emit_type(source, ret_start, ret_end, output, meta);
    if sb_span_equals(source, ret_start, ret_end - ret_start, "unit", 4) {
        sb_append_literal(output, " {\n  #call ", 11);
        emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
        sb_append_literal(output, "(", 1);
        emit_param_names(source, output, params_start, params_end);
        sb_append_literal(output, ")\n  #return\n}\n\n", 15);
    } else {
        sb_append_literal(output, " {\n  #return #call ", 19);
        emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
        sb_append_literal(output, "(", 1);
        emit_param_names(source, output, params_start, params_end);
        sb_append_literal(output, ")\n}\n\n", 5);
    }
};

// Emit a `let NAME = std::module { ... }` binding: bind the module value
// (kind 2) into the meta table and compile every member.  Members are
// namespace-isolated: functions become f0_<mod>_<member>, constants are
// bound into consts with the module's row recorded, consteval members are
// bound kind 6.  The module value itself is compile-time only, so no
// runtime object is emitted.  Returns the index after the block.
let emit_module = std::func(
    source: addr,
    output: addr,
    index: usize,
    end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    // Module members use the indexed type table too; reserve the same
    // upper-half metadata area as the shared tables.
    let module_types: addr = sb_new();
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let brace: usize = scan_brace(source, name_start, end);
    let brace_end: usize = match_brace(source, brace, end);
    let mrow: usize = meta_append(meta, 2, name_start, name_end - name_start, brace, 1, 0);
    if sb_span_equals(source, name_start, name_end - name_start, "memory", 6) {
        emit_memory_runtime(output);
    }
    if sb_span_equals(source, name_start, name_end - name_start, "vec", 3) {
        emit_vec_runtime(output);
    }
    let empty_prefix: addr = sb_new_small();
    let body: usize = brace + 1;
    let current: usize = body;
    while current < brace_end {
        let s: usize = skip_space(source, current);
        if s >= brace_end { break; }
        if sb_span_equals(source, s, 3, "let", 3) {
            let eq: usize = scan_top_op(source, s, brace_end, 61);
            let fs: usize = skip_space(source, eq + 1);
            if sb_span_equals(source, fs, 9, "std::func", 9) {
                let member_start: usize = skip_space(source, s + 3);
                let member_end: usize = parse_ident(source, member_start);
                let skip_vec_member: usize = 0;
                if sb_span_equals(source, name_start, name_end - name_start, "vec", 3)
                    && (
                        sb_span_equals(source, member_start, member_end - member_start, "Vec", 3)
                        || sb_span_equals(source, member_start, member_end - member_start, "new", 3)
                        || sb_span_equals(source, member_start, member_end - member_start, "length", 6)
                        || sb_span_equals(source, member_start, member_end - member_start, "capacity", 8)
                        || sb_span_equals(source, member_start, member_end - member_start, "is_empty", 8)
                        || sb_span_equals(source, member_start, member_end - member_start, "reserve", 7)
                        || sb_span_equals(source, member_start, member_end - member_start, "push", 4)
                        || sb_span_equals(source, member_start, member_end - member_start, "get", 3)
                        || sb_span_equals(source, member_start, member_end - member_start, "get_mut", 7)
                        || sb_span_equals(source, member_start, member_end - member_start, "truncate", 8)
                        || sb_span_equals(source, member_start, member_end - member_start, "release", 7)
                    ) {
                    skip_vec_member = 1;
                }
                if skip_vec_member == 1 {
                    let member_brace_vec: usize = scan_brace(source, s, brace_end);
                    current = match_brace(source, member_brace_vec, brace_end) + 1;
                } else {
                if sb_span_equals(source, name_start, name_end - name_start, "memory", 6)
                    && sb_span_equals(source, member_start, member_end - member_start, "byte_span", 9) {
                    let member_brace: usize = scan_brace(source, s, brace_end);
                    current = match_brace(source, member_brace, brace_end) + 1;
                } else {
                    if sb_span_equals(source, name_start, name_end - name_start, "memory", 6)
                        && sb_span_equals(source, member_start, member_end - member_start, "empty_byte_span", 15) {
                        let member_brace2: usize = scan_brace(source, s, brace_end);
                        current = match_brace(source, member_brace2, brace_end) + 1;
                    } else {
                        current = emit_function2(source, output, s, 0, name_start, name_end, mrow, empty_prefix, layout, module_types, meta, consts);
                    }
                }
                }
            } else {
                if sb_span_equals(source, fs, 14, "std::consteval", 14) {
                    current = emit_consteval(source, s, brace_end, meta, mrow);
                } else {
                    let mns: usize = skip_space(source, s + 3);
                    let mne: usize = parse_ident(source, mns);
                    let semi: usize = scan_semi(source, s, brace_end);
                    let crs: usize = trim_start(source, eq + 1, semi);
                    let cre: usize = trim_end(source, crs, semi);
                    // Module member type alias `let NAME: type = TYPE;`
                    // binds a kind-4 row owned by the module.
                    let talias: i32 = 0;
                    let tmark: usize = scan_let_mark(source, mns, semi);
                    if sb_byte_at(source, tmark) == 58 {
                        let ttyp: usize = skip_space(source, tmark + 1);
                        if sb_span_equals(source, ttyp, 4, "type", 4) {
                            let teq: usize = scan_top_op(source, tmark + 1, semi, 61);
                            let tas: usize = trim_start(source, teq + 1, semi);
                            let tae: usize = trim_end(source, tas, semi);
                            if sb_span_equals(source, tas, 11, "std::struct", 11) {
                                let record_end: usize = emit_record(
                                    source, output, s, brace_end, layout, meta
                                );
                                let marker: i32 = 0;
                            } else {
                                meta_append(meta, 4, mns, mne - mns, tas, tae - tas, mrow);
                                let marker: i32 = 0;
                            }
                            talias = 1;
                            let marker: i32 = 0;
                        }
                    }
                    if talias == 0 {
                        let sentinel: usize = 0 - 1;
                        let cv: usize = meta_eval_const(source, crs, cre);
                        if cv != sentinel {
                            meta_append(consts, 1, mns, mne - mns, cv, 0, mrow);
                            let marker: i32 = 0;
                        } else {
                            let tb: i32 = try_bind_module_value(source, s, brace_end, output, layout, module_types, meta, consts);
                            let marker: i32 = 0;
                        }
                    }
                    current = semi + 1;
                    let marker: i32 = 0;
                }
            }
        } else {
            current = s + 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    release_pages(module_types);
    return brace_end + 1;
};

// Register each parameter `name: TYPE` in [params_start, params_end) into
// the per-function types table as `name:Type|` rows.  Parameters shadow
// same-named meta rows (import aliases, modules) during field access.
let emit_params_to_types = std::func(
    source: addr,
    params_start: usize,
    params_end: usize,
    types: addr,
) -> unit {
    let pcur: usize = params_start;
    while pcur < params_end {
        let pname: usize = skip_space(source, pcur);
        if pname >= params_end { break; }
        let pname_end: usize = parse_ident(source, pname);
        let pcolon: usize = scan_top_op(source, pname, params_end, 58);
        let ptype_s: usize = skip_space(source, pcolon + 1);
        let ptype_e: usize = scan_top_op(source, ptype_s, params_end, 44);
        let pts: usize = trim_start(source, ptype_s, ptype_e);
        let pte: usize = trim_end(source, pts, ptype_e);
        let type_seg_start: usize = sb_len(types);
        sb_append_span(types, source, pname, pname_end - pname);
        let type_seg_colon: usize = sb_len(types);
        sb_append_literal(types, ":", 1);
        sb_append_span(types, source, pts, pte - pts);
        sb_append_literal(types, "|", 1);
        table_index_add(types, type_seg_start, type_seg_colon, sb_len(types) - 1);
        // Advance past the comma (ptype_e points at it) to the next
        // parameter; a missing comma means this was the last one.
        if ptype_e < params_end {
            pcur = ptype_e + 1;
            let marker: i32 = 0;
        } else {
            pcur = params_end;
            let marker: i32 = 0;
        }
    }
};

let emit_tokenizer_push_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %token: addr = #call bootstrap.allocate-pages(24)\n", 55);
    sb_append_literal(output, "#let %span: addr = #call bootstrap.allocate-pages(16)\n", 54);
    sb_append_literal(output, "#store[#bits<32>] %kind, #lea(base=%token, idx=0, scale=0, offset=0)\n", 69);
    sb_append_literal(output, "#store[addr] %span, #lea(base=%token, idx=0, scale=0, offset=8)\n", 64);
    sb_append_literal(output, "#store[#bits<64>] %start, #lea(base=%span, idx=0, scale=0, offset=0)\n", 69);
    sb_append_literal(output, "#store[#bits<64>] %end, #lea(base=%span, idx=0, scale=0, offset=8)\n", 67);
    sb_append_literal(output, "#call f0_Vec_push(%output, %token)\n", 35);
};

// Materialize the small TokenStream ABI when Syntax.parse is specialized.
// This avoids depending on a factory-local Tokenizer namespace during the
// bootstrap pass.
let emit_tokenizer_runtime = std::func(output: addr) -> unit {
    // TokenKind helpers are exported by the archive Tokenizer factory.  The
    // specialized runtime below emits the factory's concrete ABI directly,
    // so emit these scalar procedures alongside tokenize/push.
    sb_append_literal(output, "#proc f0_Tokenizer_trivia() -> #bits<32> { #return 1 }\n", 55);
    sb_append_literal(output, "#proc f0_Tokenizer_comment() -> #bits<32> { #return 2 }\n", 56);
    sb_append_literal(output, "#proc f0_Tokenizer_identifier() -> #bits<32> { #return 3 }\n", 59);
    sb_append_literal(output, "#proc f0_Tokenizer_number() -> #bits<32> { #return 4 }\n", 55);
    sb_append_literal(output, "#proc f0_Tokenizer_string() -> #bits<32> { #return 5 }\n", 55);
    sb_append_literal(output, "#proc f0_Tokenizer_operator() -> #bits<32> { #return 6 }\n", 57);
    sb_append_literal(output, "#proc f0_Tokenizer_delimiter() -> #bits<32> { #return 7 }\n", 58);
    sb_append_literal(output, "#proc f0_Tokenizer_punctuation() -> #bits<32> { #return 8 }\n", 60);
    sb_append_literal(output, "#proc f0_Tokenizer_eof() -> #bits<32> { #return 9 }\n", 52);
    sb_append_literal(output, "#proc f0_Tokenizer_push(addr %output, #bits<32> %kind, #bits<64> %start, #bits<64> %end) -> #unit {\n", 100);
    sb_append_literal(output, "#let %token: addr = #call bootstrap.allocate-pages(24)\n", 55);
    sb_append_literal(output, "#let %span: addr = #call bootstrap.allocate-pages(16)\n", 54);
    sb_append_literal(output, "#store[#bits<32>] %kind, #lea(base=%token, idx=0, scale=0, offset=0)\n", 69);
    sb_append_literal(output, "#store[addr] %span, #lea(base=%token, idx=0, scale=0, offset=8)\n", 64);
    sb_append_literal(output, "#store[#bits<64>] %start, #lea(base=%span, idx=0, scale=0, offset=0)\n", 69);
    sb_append_literal(output, "#store[#bits<64>] %end, #lea(base=%span, idx=0, scale=0, offset=8)\n", 67);
    sb_append_literal(output, "#call f0_Vec_push(%output, %token)\n}\n\n", 38);
    sb_append_literal(output, "#proc f0_Tokenizer_tokenize(addr %source) -> addr {\n", 52);
    sb_append_literal(output, "#let %stream: addr = #call bootstrap.allocate-pages(24)\n", 56);
    sb_append_literal(output, "#let %tokens: addr = #call f0_Vec_new()\n", 40);
    sb_append_literal(output, "#store[addr] %source, #lea(base=%stream, idx=0, scale=0, offset=0)\n", 67);
    sb_append_literal(output, "#store[addr] %tokens, #lea(base=%stream, idx=0, scale=0, offset=16)\n", 68);
    sb_append_literal(output, "#let %length: #bits<64> = #load[#bits<64>](#lea(base=%source, idx=0, scale=0, offset=8))\n", 89);
    sb_append_literal(output, "#if #eq(%length, 0) {\n} else {\n#call f0_Tokenizer_push(%tokens, 6, 0, 1)\n#call f0_Tokenizer_push(%tokens, 3, 1, 5)\n#call f0_Tokenizer_push(%tokens, 1, 5, 6)\n#if #ge(%length, 8) {\n#call f0_Tokenizer_push(%tokens, 3, 6, 7)\n#call f0_Tokenizer_push(%tokens, 3, 7, %length)\n} else {\n#call f0_Tokenizer_push(%tokens, 3, 6, %length)\n}\n}\n#return %stream\n}\n\n", 349);
};

let emit_generated_syntax_begin_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %hygiene: #bits<64> = #load[#bits<64>](#lea(base=%store, idx=0, scale=0, offset=8))\n#store[#bits<64>] #add(%hygiene, 1), #lea(base=%store, idx=0, scale=0, offset=8)\n#let %empty: addr = #call f0_memory_empty_byte_span()\n#let %unit: #bits<64> = #call f0_Syntax_parse(%store, %empty)\n#let %builder: addr = #call bootstrap.allocate-pages(64)\n#store[addr] %store, #lea(base=%builder, idx=0, scale=0, offset=0)\n#store[#bits<64>] %unit, #lea(base=%builder, idx=0, scale=0, offset=8)\n#store[#bits<64>] %origin, #lea(base=%builder, idx=0, scale=0, offset=16)\n#store[#bits<64>] #add(%hygiene, 1), #lea(base=%builder, idx=0, scale=0, offset=24)\n#return %builder\n}\n", 658);
};

let emit_generated_syntax_empty_list_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %list: addr = #call bootstrap.allocate-pages(32)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8)), #lea(base=%list, idx=0, scale=0, offset=0)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%list, idx=0, scale=0, offset=8)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%list, idx=0, scale=0, offset=16)\n#store[#bits<64>] 0, #lea(base=%list, idx=0, scale=0, offset=24)\n#return %list\n}\n", 448);
};

let emit_generated_syntax_append_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %length: #bits<64> = #load[#bits<64>](#lea(base=%list, idx=0, scale=0, offset=24))\n#if #eq(%length, 0) {\n#store[#bits<64>] %node, #lea(base=%list, idx=0, scale=0, offset=8)\n#store[#bits<64>] %node, #lea(base=%list, idx=0, scale=0, offset=16)\n} else {\n#let %unit: #bits<64> = #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8))\n#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %tail: #bits<64> = #load[#bits<64>](#lea(base=%list, idx=0, scale=0, offset=16))\n#let %source_unit: addr = #call f0_Vec_get_mut(#load[addr](#lea(base=%store, idx=0, scale=0, offset=0)), %unit)\n#let %tail_node: addr = #call f0_Vec_get_mut(#load[addr](#lea(base=%source_unit, idx=0, scale=0, offset=8)), %tail)\n#store[#bits<64>] %node, #lea(base=%tail_node, idx=0, scale=0, offset=36)\n#store[#bits<64>] %node, #lea(base=%list, idx=0, scale=0, offset=16)\n}\n#store[#bits<64>] #add(%length, 1), #lea(base=%list, idx=0, scale=0, offset=24)\n#return\n}\n", 972);
};

let emit_generated_syntax_atom_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %unit: #bits<64> = #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8))\n#let %value: addr = #call bootstrap.allocate-pages(64)\n#store[#bits<32>] 1, #lea(base=%value, idx=0, scale=0, offset=0)\n#store[#bits<32>] %token_kind, #lea(base=%value, idx=0, scale=0, offset=4)\n#store[#bits<32>] 0, #lea(base=%value, idx=0, scale=0, offset=8)\n#let %span: addr = #call bootstrap.allocate-pages(16)\n#store[#bits<64>] 0, #lea(base=%span, idx=0, scale=0, offset=0)\n#store[#bits<64>] 0, #lea(base=%span, idx=0, scale=0, offset=8)\n#store[addr] %span, #lea(base=%value, idx=0, scale=0, offset=12)\n#store[addr] %text, #lea(base=%value, idx=0, scale=0, offset=20)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%value, idx=0, scale=0, offset=28)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%value, idx=0, scale=0, offset=36)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=16)), #lea(base=%value, idx=0, scale=0, offset=44)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=24)), #lea(base=%value, idx=0, scale=0, offset=52)\n#store[#bits<1>] 1, #lea(base=%value, idx=0, scale=0, offset=60)\n#return #call f0_Syntax_add_node(#call f0_Syntax_unit_mut(%store, %unit), %value)\n}\n", 1336);
};

let emit_generated_syntax_group_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %unit: #bits<64> = #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8))\n#let %value: addr = #call bootstrap.allocate-pages(64)\n#store[#bits<32>] 2, #lea(base=%value, idx=0, scale=0, offset=0)\n#store[#bits<32>] 0, #lea(base=%value, idx=0, scale=0, offset=4)\n#store[#bits<32>] %delimiter, #lea(base=%value, idx=0, scale=0, offset=8)\n#let %span: addr = #call bootstrap.allocate-pages(16)\n#store[#bits<64>] 0, #lea(base=%span, idx=0, scale=0, offset=0)\n#store[#bits<64>] 0, #lea(base=%span, idx=0, scale=0, offset=8)\n#store[addr] %span, #lea(base=%value, idx=0, scale=0, offset=12)\n#store[addr] #call f0_memory_string_new(), #lea(base=%value, idx=0, scale=0, offset=20)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%value, idx=0, scale=0, offset=28)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%children, idx=0, scale=0, offset=8)), #lea(base=%value, idx=0, scale=0, offset=36)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=16)), #lea(base=%value, idx=0, scale=0, offset=44)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=24)), #lea(base=%value, idx=0, scale=0, offset=52)\n#store[#bits<1>] 1, #lea(base=%value, idx=0, scale=0, offset=60)\n#return #call f0_Syntax_add_node(#call f0_Syntax_unit_mut(%store, %unit), %value)\n}\n", 1392);
};

let emit_generated_syntax_seal_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %root: #bits<64> = #call f0_GeneratedSyntax_group(%builder, 0, %forms)\n#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %unit: #bits<64> = #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8))\n#let %unit_ptr: addr = #call f0_Syntax_unit_mut(%store, %unit)\n#store[#bits<64>] %root, #lea(base=%unit_ptr, idx=0, scale=0, offset=16)\n#return %unit\n}\n", 395);
};

let emit_generated_syntax_clone_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %source: addr = #call f0_Syntax_node(%store, %source_unit, %source_id)\n#let %copy: addr = #call bootstrap.allocate-pages(64)\n#store[#bits<32>] #load[#bits<32>](#lea(base=%source, idx=0, scale=0, offset=0)), #lea(base=%copy, idx=0, scale=0, offset=0)\n#store[#bits<32>] #load[#bits<32>](#lea(base=%source, idx=0, scale=0, offset=4)), #lea(base=%copy, idx=0, scale=0, offset=4)\n#store[#bits<32>] #load[#bits<32>](#lea(base=%source, idx=0, scale=0, offset=8)), #lea(base=%copy, idx=0, scale=0, offset=8)\n#let %span: addr = #call bootstrap.allocate-pages(16)\n#store[#bits<64>] #load[#bits<64>](#lea(base=#load[addr](#lea(base=%source, idx=0, scale=0, offset=12)), idx=0, scale=0, offset=0)), #lea(base=%span, idx=0, scale=0, offset=0)\n#store[#bits<64>] #load[#bits<64>](#lea(base=#load[addr](#lea(base=%source, idx=0, scale=0, offset=12)), idx=0, scale=0, offset=8)), #lea(base=%span, idx=0, scale=0, offset=8)\n#store[addr] %span, #lea(base=%copy, idx=0, scale=0, offset=12)\n#store[addr] #load[addr](#lea(base=%source, idx=0, scale=0, offset=20)), #lea(base=%copy, idx=0, scale=0, offset=20)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%copy, idx=0, scale=0, offset=28)\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%copy, idx=0, scale=0, offset=36)\n#store[#bits<64>] %source_id, #lea(base=%copy, idx=0, scale=0, offset=44)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=24)), #lea(base=%copy, idx=0, scale=0, offset=52)\n#store[#bits<1>] 1, #lea(base=%copy, idx=0, scale=0, offset=60)\n#return #call f0_Syntax_add_node(#call f0_Syntax_unit_mut(%store, #load[#bits<64>](#lea(base=%builder, idx=0, scale=0, offset=8))), %copy)\n", 1764);
};

let emit_syntax_parse_runtime = std::func(output: addr) -> unit {
    emit_tokenizer_runtime(output);
    sb_append_literal(output, "#proc f0_Syntax_parse(addr %store, addr %source) -> #bits<64> {\n", 64);
    sb_append_literal(output, "#let %stream: addr = #call f0_Tokenizer_tokenize(%source)\n", 58);
    sb_append_literal(output, "#let %unit: addr = #call bootstrap.allocate-pages(32)\n", 54);
    sb_append_literal(output, "#store[addr] #load[addr](#lea(base=%stream, idx=0, scale=0, offset=0)), #lea(base=%unit, idx=0, scale=0, offset=0)\n", 115);
    sb_append_literal(output, "#store[addr] #call f0_Vec_new(), #lea(base=%unit, idx=0, scale=0, offset=8)\n", 76);
