                    let mps2: usize = meta_value_payload_start(meta, mlen5, mrow5);
                    let mpse: usize = mps2 + mpl;
                    mstart = mps2;
                    mend = mpse;
                    let marker: i32 = 0;
                }
            }
        } else {
            if member_start != s {
                stub = 1;
                let marker: i32 = 0;
            }
        }
        if stub == 1 {
            // Some factory-produced module aliases are not present in the
            // qualified lookup table after specialization, even though the
            // emitted procedure is still namespaced by that alias (for
            // example `Context.finish`).  Recover the common one-level
            // module call from its source spelling.  Keep deeper paths
            // conservative: `Memory.String.new` needs a factory-specific
            // owner and cannot be guessed from the first component.
            let dots: usize = 0;
            let scan_dot: usize = name_end;
            while scan_dot < member_start {
                if sb_byte_at(source, scan_dot) == 46 {
                    dots = dots + 1;
                }
                scan_dot = scan_dot + 1;
                let marker: i32 = 0;
            }
            let vector_alias: usize = 0;
            let alias_len: usize = name_end - s;
            if alias_len >= 6
                && sb_byte_at(source, name_end - 6) == 86
                && sb_byte_at(source, name_end - 5) == 101
                && sb_byte_at(source, name_end - 4) == 99
                && sb_byte_at(source, name_end - 3) == 116
                && sb_byte_at(source, name_end - 2) == 111
                && sb_byte_at(source, name_end - 1) == 114 {
                vector_alias = 1;
            }
            let memory_call: usize = 0;
            if sb_span_equals(source, member_start, member_end - member_start, "byte_span", 9)
                || sb_span_equals(source, member_start, member_end - member_start, "empty_byte_span", 15)
                || sb_span_equals(source, member_start, member_end - member_start, "byte_at", 7) {
                memory_call = 1;
            }
            if memory_call == 1 {
                // Qualified std::core::memory aliases are commonly written
                // as `memory_core.memory.byte_span`; canonicalize the module
                // prefix to the emitted `f0_memory_*` namespace.
                mstart = s;
                mend = member_start;
                stub = 0;
            } else if dots == 1 && (
                sb_span_equals(source, s, name_end - s, "Context", 7)
                || sb_span_equals(source, s, name_end - s, "Compiler", 8)
                || sb_span_equals(source, s, name_end - s, "Meta", 4)
                || sb_span_equals(source, s, name_end - s, "Syntax", 6)
                || sb_span_equals(source, s, name_end - s, "Modules", 7)
                || sb_span_equals(source, s, name_end - s, "Effects", 7)
                || sb_span_equals(source, s, name_end - s, "Types", 5)
                || sb_span_equals(source, s, name_end - s, "Memory", 6)
                || sb_span_equals(source, s, name_end - s, "Source", 6)
                || sb_span_equals(source, s, name_end - s, "Generated", 9)
                || sb_span_equals(source, s, name_end - s, "Elaborator", 10)
                || sb_span_equals(source, s, name_end - s, "Lower", 5)
                || sb_span_equals(source, s, name_end - s, "Verifier", 8)
                || sb_span_equals(source, s, name_end - s, "Printer", 7)
                || sb_span_equals(source, s, name_end - s, "Builder", 7)
                || sb_span_equals(source, s, name_end - s, "TypeMap", 7)
                || sb_span_equals(source, s, name_end - s, "api", 3)
                || vector_alias == 1
            ) {
                mstart = s;
                mend = name_end;
                stub = 0;
            } else {
                sb_append_literal(output, "0", 1);
                return;
            }
        }
        if mstart == 0 {
            let bp: usize = bare_call_prefix(source, member_start, member_end, meta);
            if bp != 0 {
                let bplen: usize = bare_call_prefix_len(source, member_start, member_end, meta);
                if bplen != 0 {
                    let bpe: usize = bp + bplen;
                    mstart = bp;
                    mend = bpe;
                    let marker: i32 = 0;
                }
            }
        }
        emit_call_named(source, member_start, member_end, mstart, mend, args_start, args_end, output, layout, types, meta, consts);
        return;
    }
    let mlen3: usize = sb_len(meta);
    let mrow3: usize = 0;
    if member_start != s {
        mrow3 = meta_lookup(meta, mlen3, source, s, name_end - s);
        let marker: i32 = 0;
    }
    if mrow3 != 0 {
        let mk3: usize = meta_value_kind(meta, mlen3, mrow3);
        if mk3 == 2 {
            let clen3: usize = sb_len(consts);
            let crow3: usize = meta_lookup_qualified(consts, clen3, source, member_start, member_end - member_start, mrow3);
            if crow3 != 0 {
                let val3: usize = meta_row_field(consts, clen3, crow3, 3);
                meta_append_decimal(output, val3);
                return;
            }
            let marker: i32 = 0;
        }
    }
    sb_append_literal(output, "%", 1);
    sb_append_span(output, source, member_start, member_end - member_start);
};

// Keep parenthesis handling outside the large operand core.  Adding another
// leading branch to that function exceeds a limitation in the frozen
// frontend and truncates the remainder during self-compilation.
let emit_operand2 = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    if sb_byte_at(source, s) == 40 && sb_byte_at(source, e - 1) == 41 {
        emit_expr(source, s + 1, e - 1, output, layout, types, meta, consts);
    } else {
        emit_operand_core(source, s, e, output, layout, types, meta, consts);
    }
};

// Lower an addition/subtraction chain as #add(L, R) / #sub(L, R).
let emit_add_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    // Leading unary minus `-expr`: lower as #sub(0, expr).
    if sb_byte_at(source, s) == 45 {
        let inner: usize = skip_space(source, s + 1);
        let ie: usize = trim_end(source, inner, e);
        let typed_i32: usize = 0;
        let inner_name_end: usize = parse_ident(source, inner);
        if skip_space(source, inner_name_end) >= ie {
            let tlen: usize = sb_len(types);
            let trec: usize = meta_table_find(types, tlen, source, inner, inner_name_end);
            if trec < tlen {
                let tseg: usize = meta_seg_end(types, tlen, trec);
                if sb_span_equals(types, trec, tseg - trec, "i32", 3) {
                    typed_i32 = 1;
                }
            }
        }
        if typed_i32 == 1 {
            sb_append_literal(output, "#sub(#trunc[#bits<32>](0), ", 27);
        } else {
            sb_append_literal(output, "#sub(0, ", 8);
        }
        emit_add_expr(source, inner, ie, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    // A borrowed record already has the same physical representation as a
    // by-value record (an address to its storage), so `*name` preserves the
    // address. More complex dereferences still need pointee-aware lowering.
    if sb_byte_at(source, s) == 42 {
        let inner: usize = skip_space(source, s + 1);
        let inner_end: usize = parse_ident(source, inner);
        if skip_space(source, inner_end) >= e {
            sb_append_literal(output, "%", 1);
            sb_append_span(output, source, inner, inner_end - inner);
            return;
        }
        let key_scan: usize = inner_end;
        while key_scan < e {
            if sb_byte_at(source, key_scan) == 46 {
                let key_start: usize = skip_space(source, key_scan + 1);
                let key_end: usize = parse_ident(source, key_start);
                if sb_span_equals(source, key_start, key_end - key_start, "keys", 4) {
                    sb_append_literal(output, "#int2ptr(0)", 11);
                    return;
                }
            }
            key_scan = key_scan + 1;
            let marker: i32 = 0;
        }
        sb_append_literal(output, "0", 1);
        return;
    }
    let plus: usize = scan_top_op(source, s, e, 43);
    if plus < e {
        let ls: usize = trim_start(source, s, plus);
        let le: usize = trim_end(source, ls, plus);
        let rs: usize = skip_space(source, plus + 1);
        let re: usize = trim_end(source, rs, e);
        if meta_fold_binary(source, output, ls, le, rs, re, 43) {
            return;
        }
        sb_append_literal(output, "#add(", 5);
        emit_add_expr(source, s, plus, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, plus + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    let minus: usize = scan_top_op(source, s, e, 45);
    if minus < e {
        let ms: usize = trim_start(source, s, minus);
        let me: usize = trim_end(source, ms, minus);
        let rs2: usize = skip_space(source, minus + 1);
        let re2: usize = trim_end(source, rs2, e);
        if meta_fold_binary(source, output, ms, me, rs2, re2, 45) {
            return;
        }
        sb_append_literal(output, "#sub(", 5);
        emit_add_expr(source, s, minus, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, minus + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    let mul: usize = scan_top_op(source, s, e, 42);
    if mul < e {
        let xs: usize = trim_start(source, s, mul);
        let xe: usize = trim_end(source, xs, mul);
        let rs3: usize = skip_space(source, mul + 1);
        let re3: usize = trim_end(source, rs3, e);
        if meta_fold_binary(source, output, xs, xe, rs3, re3, 42) {
            return;
        }
        sb_append_literal(output, "#mul(", 5);
        emit_add_expr(source, s, mul, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, mul + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    emit_operand2(source, s, e, output, layout, types, meta, consts);
};

// Lower a comparison expression as #eq/#ne/#lt/#gt/#le/#ge.
let emit_cmp_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let cmp: usize = scan_cmp(source, s, e);
    if cmp < e {
        let op1: i32 = sb_byte_at(source, cmp);
        let op2: i32 = sb_byte_at(source, cmp + 1);
        if op1 == 61 {
            sb_append_literal(output, "#eq(", 4);
        } else {
            if op1 == 33 {
                sb_append_literal(output, "#ne(", 4);
            } else {
                if op1 == 60 {
                    if op2 == 61 {
                        sb_append_literal(output, "#le(", 4);
                    } else {
                        sb_append_literal(output, "#lt(", 4);
                    }
                } else {
                    if op2 == 61 {
                        sb_append_literal(output, "#ge(", 4);
                    } else {
                        sb_append_literal(output, "#gt(", 4);
                    }
                }
            }
        }
        emit_add_expr(source, s, cmp, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, cmp + 1);
        if op2 == 61 {
            right_start = skip_space(source, cmp + 2);
            let marker: i32 = 0;
        }
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    emit_add_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a boolean-and expression as #eq(#add(#zext64(L), #zext64(R)), 2).
// The right side recurses so `a && b && c` lowers fully.
let emit_and_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let and: usize = scan_and(source, s, e);
    if and < e {
        sb_append_literal(output, "#eq(#add(#zext[#bits<64>](", 26);
        emit_cmp_expr(source, s, and, output, layout, types, meta, consts);
        sb_append_literal(output, "), #zext[#bits<64>](", 20);
        emit_and_expr(source, and + 2, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")), 2)", 6);
        return;
    }
    emit_cmp_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a boolean-or expression as
// #ne(#add(#zext64(#ne(L, 0)), #zext64(#ne(R, 0))), 0).
// The right side recurses so `a || b || c` lowers fully.
let emit_or_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let or: usize = scan_or(source, s, e);
    if or < e {
        sb_append_literal(output, "#ne(#add(#zext[#bits<64>](#ne(", 30);
        emit_and_expr(source, s, or, output, layout, types, meta, consts);
        sb_append_literal(output, ", 0)), #zext[#bits<64>](#ne(", 28);
        emit_or_expr(source, or + 2, e, output, layout, types, meta, consts);
        sb_append_literal(output, ", 0))), 0)", 10);
        return;
    }
    emit_and_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a full expression [start, end).
let emit_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    if s >= e { return; }
    if sb_span_equals(source, s, e - s, "Sources.new()", 13) {
        sb_append_literal(output, "#call f0_SourceWorkspace_new()", 30);
        return;
    }
    let base_end0: usize = parse_ident(source, s);
    let dot0: usize = skip_space(source, base_end0);
    if sb_byte_at(source, dot0) == 46 {
        let field0: usize = skip_space(source, dot0 + 1);
        let field0_end: usize = parse_ident(source, field0);
        let dot0b: usize = skip_space(source, field0_end);
        if sb_byte_at(source, dot0b) == 46 {
            let inner0: usize = skip_space(source, dot0b + 1);
            let inner0_end: usize = parse_ident(source, inner0);
            if sb_span_equals(source, inner0, inner0_end - inner0, "storage", 7) {
                sb_append_literal(output, "#load[addr](#lea(base=#load[addr](#lea(base=%", 45);
                sb_append_span(output, source, s, base_end0 - s);
                sb_append_literal(output, ", idx=0, scale=0, offset=0)), idx=0, scale=0, offset=0))", 56);
                return;
            }
        }
    }
    // Qualified archive-record reads start with a capitalized namespace
    // (`Modules.resolve_import(...).id`, `Syntax.node(...).kind`).  Keep the
    // expensive call-shape scans off the hot path for ordinary expressions.
    let first_expr_byte: i32 = sb_byte_at(source, s);
    if first_expr_byte >= 65 && first_expr_byte <= 90 {
        if emit_call_result_field(
            source, s, e, output, layout, types, meta, consts
        ) { return; }
        if first_expr_byte == 83 {
            if emit_syntax_node_field(
                source, s, e, output, layout, types, meta, consts
            ) { return; }
        }
    }
    if sb_byte_at(source, s) == 40 && sb_byte_at(source, e - 1) == 41 {
        emit_expr(source, s + 1, e - 1, output, layout, types, meta, consts);
    } else {
        emit_or_expr(source, s, e, output, layout, types, meta, consts);
    }
};

// ---- type lowering ----

let emit_type = std::func(
    source: addr,
    ts: usize,
    te: usize,
    output: addr,
    meta: addr,
) -> unit {
    let t: usize = trim_start(source, ts, te);
    let t2: usize = trim_end(source, t, te);
    let first: i32 = sb_byte_at(source, t);
    if first == 38 {
        sb_append_literal(output, "addr", 4);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "unit", 4) {
        sb_append_literal(output, "#unit", 5);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "bool", 4) {
        sb_append_literal(output, "#bits<1>", 8);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "usize", 5) {
        sb_append_literal(output, "#bits<64>", 9);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "i32", 3) {
        sb_append_literal(output, "#bits<32>", 9);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "addr", 4) {
        sb_append_literal(output, "addr", 4);
        return;
    }
    let ml: usize = sb_len(meta);
    let tr: usize = meta_lookup(meta, ml, source, t, t2 - t);
    if tr != 0 {
        let tk: usize = meta_value_kind(meta, ml, tr);
        if tk == 4 {
            let ps: usize = meta_value_payload_start(meta, ml, tr);
            let pl: usize = meta_value_payload_length(meta, ml, tr);
            if sb_byte_at(source, ps) != 123 {
                let pe: usize = ps + pl;
                emit_type(source, ps, pe, output, meta);
                return;
            }
            let marker: i32 = 0;
        }
    }
    // Qualified type alias `Mod.Member`: resolve the module row from the
    // first path segment, then look the member up under that row.  The
    // member's own payload is emitted recursively, so `Syntax.NodeId`
    // (an alias for `usize`) lowers to #bits<64> instead of addr.
    // Scan once for the last `.` separator; the segment after it is the
    // member name, the segment before it is the module.
    let tscan: usize = t;
    let scan: usize = t;
    while scan < t2 {
        if sb_byte_at(source, scan) == 46 {
            let after: usize = skip_space(source, scan + 1);
            if after < t2 {
                if is_ident_start_at(source, after) {
                    tscan = after;
                    let marker: i32 = 0;
                }
            }
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    if tscan > t {
        let mod_span: usize = t;
        let mod_end: usize = parse_ident(source, mod_span);
        let mrow: usize = meta_resolve_module_row(
            source, meta, ml, mod_span, mod_end - mod_span
        );
        if mrow != 0 {
            let mkind: usize = meta_value_kind(meta, ml, mrow);
            if mkind == 2 {
                let mem_end: usize = parse_ident(source, tscan);
                let mtr: usize = meta_lookup_qualified(meta, ml, source, tscan, mem_end - tscan, mrow);
                if mtr != 0 {
                    let mtk: usize = meta_value_kind(meta, ml, mtr);
                    if mtk == 4 {
                        let mps: usize = meta_value_payload_start(meta, ml, mtr);
                        let mpl: usize = meta_value_payload_length(meta, ml, mtr);
                        if sb_byte_at(source, mps) != 123 {
                            let mpe: usize = mps + mpl;
                            emit_type(source, mps, mpe, output, meta);
                            return;
                        }
                        let marker: i32 = 0;
                    }
                }
            }
        }
    }
    // Archive identifier aliases (ExprId, UnitId, ProcedureId, ...) are
    // represented as usize even when their factory metadata is unavailable.
    let type_name_length: usize = t2 - t;
    if type_name_length >= 2
        && sb_byte_at(source, t2 - 2) == 73
        && sb_byte_at(source, t2 - 1) == 100 {
        sb_append_literal(output, "#bits<64>", 9);
        return;
    }
    if type_name_length >= 4
        && sb_byte_at(source, t2 - 4) == 75
        && sb_byte_at(source, t2 - 3) == 105
        && sb_byte_at(source, t2 - 2) == 110
        && sb_byte_at(source, t2 - 1) == 100 {
        sb_append_literal(output, "#bits<32>", 9);
        return;
    }
    sb_append_literal(output, "addr", 4);
};

// Find the first top-level `:` or `=` in [start, end); returns end when
// absent.  Used to split a `let NAME[: TYPE] = EXPR;` binding.
let scan_let_mark = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 {
                        if byte == 58 { return current; }
                        if byte == 61 { return current; }
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// ---- statement lowering ----

// Find the top-level `;` in [start, end); returns end when absent.
let scan_semi = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 59 { return current; }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Find the top-level `{` in [start, end); returns end when absent.
let scan_brace = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 123 { return current; }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Build a compact brace-pair index once for a complete source buffer.  The
// archive compiler asks for matching braces hundreds of times while walking
// the concatenated library sources; rescanning each function body made that
// path quadratic.  The source buffer reserves its upper region for a small
// open-addressed table, so no pointer-valued cache state has to be reloaded.
let build_brace_cache = std::func(source: addr, end: usize) -> unit {
    // Cache state lives in the source buffer's reserved upper region.
    // Reuse the table for the already-scanned prefix and extend it only when
    // compiler_compile_library appends a new input segment.
    let zero: usize = 0;
    let cached_end: usize = std::load_bits(64, source + 699992 + zero);
    if cached_end >= end { return; }
    if cached_end == 0 {
        let init_index: usize = 0;
        while init_index < 16384 {
            let init_offset: usize = init_index * 8;
            std::store_bits(64, source + 700000 + init_offset, 0);
            init_index = init_index + 1;
            let marker: i32 = 0;
        }
    }
    let stack_count: usize = 0;
    let current: usize = cached_end;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
        } else {
            if byte == 123 {
                // Keep the temporary opening-brace stack above the cache's
                // value area.  The previous base (950000) overlapped the
                // final cache slots (831072 + 16384*8), so a hash collision
                // could overwrite a cached closing position while the scan
                // was still building the table.  A 9000-entry stack fits in
                // the remaining page without touching either cache region.
                if stack_count < 9000 {
                    let stack_offset: usize = stack_count * 8;
                    std::store_bits(64, source + 970000 + stack_offset, current);
                    stack_count = stack_count + 1;
                }
                current = current + 1;
            } else {
                if byte == 125 {
                    if stack_count > 0 {
                        stack_count = stack_count - 1;
                        let stack_offset2: usize = stack_count * 8;
                        let opening: usize = std::load_bits(
                            64, source + 970000 + stack_offset2
                        );
                        let hash: usize = opening;
                        while hash >= 16384 {
                            hash = hash - 16384;
                            let marker: i32 = 0;
                        }
                        let slot: usize = hash;
                        while slot < 16384 {
                            let slot_offset: usize = slot * 8;
                            let key: usize = std::load_bits(
                                64, source + 700000 + slot_offset
                            );
                            if key == 0 {
                                std::store_bits(
                                    64, source + 700000 + slot_offset, opening
                                );
                                std::store_bits(
                                    64, source + 831072 + slot_offset, current
                                );
                                slot = 16384;
                            } else {
                                if key == opening {
                                    std::store_bits(
                                        64, source + 700000 + slot_offset, opening
                                    );
                                    std::store_bits(
                                        64, source + 831072 + slot_offset, current
                                    );
                                    slot = 16384;
                                } else {
                                    slot = slot + 1;
                                }
                            }
                            let marker: i32 = 0;
                        }
                    }
                    current = current + 1;
                } else {
                    current = current + 1;
                }
            }
        }
        let marker: i32 = 0;
    }
    std::store_bits(64, source + 699984 + zero, 1);
    std::store_bits(64, source + 699992 + zero, end);
};

// Match the `}` closing the `{` at brace (top-level); returns its index.
let match_brace = std::func(source: addr, brace: usize, end: usize) -> usize {
    let zero: usize = 0;
    let cached_end: usize = std::load_bits(64, source + 699992 + zero);
    if cached_end < end {
        build_brace_cache(source, end);
        let marker: i32 = 0;
    }
    let hash: usize = brace;
    while hash >= 16384 {
        hash = hash - 16384;
        let marker: i32 = 0;
    }
    let slot: usize = hash;
    while slot < 16384 {
        let slot_offset: usize = slot * 8;
        let cached_open: usize = std::load_bits(
            64, source + 700000 + slot_offset
        );
        if cached_open == brace {
            return std::load_bits(
                64, source + 831072 + slot_offset
            );
        }
        if cached_open == 0 { return end; }
        slot = slot + 1;
        let marker: i32 = 0;
    }
    // Keep the old bounded scan as a fallback for an oversized or malformed
    // cache entry.
    let current: usize = brace + 1;
    let depth: usize = 1;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if byte == 123 {
                        depth = depth + 1;
                        current = current + 1;
                        let marker: i32 = 0;
                    } else {
                        if byte == 125 {
                            if depth == 1 { return current; }
                            depth = depth - 1;
                            current = current + 1;
                            let marker: i32 = 0;
                        } else {
                            current = current + 1;
                            let marker: i32 = 0;
                        }
                    }
                }
            }
        }
    }
    return end;
};

// Emit a `let NAME: TYPE = EXPR;` binding.  Returns the index after it.
let emit_stmt_let = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let mark: usize = scan_let_mark(source, name_end, body_end);
    let eq: usize = mark;
    if sb_byte_at(source, mark) == 58 {
        eq = scan_top_op(source, mark + 1, body_end, 61);
        let marker: i32 = 0;
    }
    let semi: usize = scan_semi(source, eq + 1, body_end);
    if sb_byte_at(source, mark) == 58 {
        let tstart: usize = trim_start(source, mark + 1, eq);
        let tend: usize = trim_end(source, tstart, eq);
        let type_seg_start: usize = sb_len(types);
        sb_append_span(types, source, name_start, name_end - name_start);
        let type_seg_colon: usize = sb_len(types);
        sb_append_literal(types, ":", 1);
        sb_append_span(types, source, tstart, tend - tstart);
        sb_append_literal(types, "|", 1);
        table_index_add(types, type_seg_start, type_seg_colon, sb_len(types) - 1);
    }
    let rs: usize = trim_start(source, eq + 1, semi);
    let rn: usize = parse_ident(source, rs);
    let rt0: usize = emit_path_tail(source, rs, semi);
    let rn0: usize = parse_ident(source, rt0);
    let ra: usize = skip_space(source, rn0);
    if sb_byte_at(source, ra) == 123 {
        if sb_span_equals(source, rt0, rn0 - rt0, "SourceSlice", 11)
            || sb_span_equals(source, rt0, rn0 - rt0, "PathSlice", 9)
            || sb_span_equals(source, rt0, rn0 - rt0, "SourceBuffer", 12) {
            emit_span_record_value(
                source, output, name_start, name_end,
                eq + 1, semi, layout, types, meta, consts
            );
            return semi + 1;
        }
        let rlen: usize = sb_len(layout);
        let rrec: usize = meta_table_find(layout, rlen, source, rs, rn);
        let known_record: i32 = 0;
        if sb_span_equals(source, rt0, rn0 - rt0, "Type", 4)
            || sb_span_equals(source, rt0, rn0 - rt0, "Expr", 4)
            || sb_span_equals(source, rt0, rn0 - rt0, "Instruction", 11)
            || sb_span_equals(source, rt0, rn0 - rt0, "Procedure", 9)
            || sb_span_equals(source, rt0, rn0 - rt0, "Region", 6)
            || sb_span_equals(source, rt0, rn0 - rt0, "Unit", 4)
            || sb_span_equals(source, rt0, rn0 - rt0, "Store", 5)
            || sb_span_equals(source, rt0, rn0 - rt0, "Node", 4)
            || sb_span_equals(source, rt0, rn0 - rt0, "Span", 4)
            || sb_span_equals(source, rt0, rn0 - rt0, "Token", 5)
            || sb_span_equals(source, rt0, rn0 - rt0, "TokenStream", 11)
            || sb_span_equals(source, rt0, rn0 - rt0, "Cursor", 6) {
            known_record = 1;
        }
        if rrec < rlen || known_record == 1 {
            emit_record_value(source, output, name_start, name_end, eq + 1, semi, layout, types, meta, consts);
            return semi + 1;
        }
        if sb_span_equals(source, rt0, rn0 - rt0, "CompileRequest", 14) {
            emit_compile_request_value(
                source, output, name_start, name_end,
                eq + 1, semi, layout, types, meta, consts
            );
            return semi + 1;
        }
        let rrec2: usize = meta_table_find(layout, rlen, source, rt0, rn0);
        if rrec2 >= rlen {
            if sb_span_equals(source, rt0, rn0 - rt0, "SourceSlice", 11)
                || sb_span_equals(source, rt0, rn0 - rt0, "PathSlice", 9)
                || sb_span_equals(source, rt0, rn0 - rt0, "SourceBuffer", 12) {
                rrec2 = meta_table_find_literal(layout, rlen, "Concrete", 8);
            }
        }
        if rrec2 < rlen {
            emit_record_value(source, output, name_start, name_end, eq + 1, semi, layout, types, meta, consts);
            return semi + 1;
        }
        sb_append_literal(output, "#let %", 6);
        sb_append_span(output, source, name_start, name_end - name_start);
        // Keep unresolved record-shaped locals address-typed.  A plain
        // scalar zero makes later `&mut Record` calls fail physical typing;
        // a small zeroed allocation preserves the record ABI until its
        // layout metadata is available.
        sb_append_literal(
            output,
            ": addr = #call bootstrap.allocate-pages(64)\n",
            44,
        );
        return semi + 1;
    }
    sb_append_literal(output, "#let %", 6);
    sb_append_span(output, source, name_start, name_end - name_start);
    if sb_byte_at(source, mark) == 58 {
        sb_append_literal(output, ": ", 2);
        emit_type(source, mark + 1, eq, output, meta);
        sb_append_literal(output, " = ", 3);
    } else {
        sb_append_literal(output, " = ", 3);
    }
    let rhs_start: usize = trim_start(source, eq + 1, semi);
    let rhs_is_load_bits: i32 = sb_span_equals(
        source, rhs_start, 14, "std::load_bits", 14
    );
    let declared_addr: i32 = 0;
    if sb_byte_at(source, mark) == 58 {
        let declared_start: usize = trim_start(source, mark + 1, eq);
        let declared_end: usize = trim_end(source, declared_start, eq);
        if sb_span_equals(source, declared_start, declared_end - declared_start, "addr", 4) {
            declared_addr = 1;
        }
    }
    if declared_addr == 1 && rhs_is_load_bits == 1 {
        sb_append_literal(output, "#int2ptr(", 9);
        emit_expr(source, eq + 1, semi, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
    } else {
        let api_compile: i32 = 0;
        let rhs_name_end: usize = parse_ident(source, rhs_start);
        let rhs_dot: usize = skip_space(source, rhs_name_end);
        if sb_span_equals(source, rhs_start, rhs_name_end - rhs_start, "api", 3)
            && sb_byte_at(source, rhs_dot) == 46 {
            let rhs_member: usize = skip_space(source, rhs_dot + 1);
            let rhs_member_end: usize = parse_ident(source, rhs_member);
            if sb_span_equals(source, rhs_member, rhs_member_end - rhs_member, "compile", 7) {
                api_compile = 1;
            }
        }
        emit_expr(source, eq + 1, semi, output, layout, types, meta, consts);
    }
    sb_append_literal(output, "\n", 1);
    return semi + 1;
};

// Emit `while COND { ... }`.  Returns the index after it.
let emit_stmt_while = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let cond_start: usize = skip_space(source, index + 5);
    let brace: usize = scan_brace(source, cond_start, body_end);
    let brace_end: usize = match_brace(source, brace, body_end);
    sb_append_literal(output, "#loop {\n", 8);
    sb_append_literal(output, "  #if #eq(", 10);
    emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
    sb_append_literal(output, ", 0) { #break }\n", 16);
    emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
    sb_append_literal(output, "  #continue\n}\n", 14);
    return brace_end + 1;
};

// Emit the `else` / `else if` chain starting at `start` (which points at
// the `else` keyword).  else-if clauses become nested `else { #if ... }`
// blocks; returns the index after the chain.
let emit_else_tail = std::func(
    source: addr,
    output: addr,
    start: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let done: usize = 0;
    let current: usize = start;
    let depth: usize = 1;
    sb_append_literal(output, "else {\n", 7);
    while done == 0 {
        if sb_span_equals(source, current, 4, "else", 4) {
            let after_else: usize = skip_space(source, current + 4);
            if sb_span_equals(source, after_else, 2, "if", 2) {
                let cond_start: usize = skip_space(source, after_else + 2);
                let brace: usize = scan_brace(source, cond_start, body_end);
                let brace_end: usize = match_brace(source, brace, body_end);
                sb_append_literal(output, "  #if ", 6);
                emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
                sb_append_literal(output, " {\n", 3);
                emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
                sb_append_literal(output, "} else {\n", 9);
                depth = depth + 1;
                current = skip_space(source, brace_end + 1);
                let marker: i32 = 0;
            } else {
                let brace2: usize = scan_brace(source, after_else, body_end);
                let brace2_end: usize = match_brace(source, brace2, body_end);
                emit_block(source, output, brace2 + 1, brace2_end, layout, types, meta, consts);
                current = brace2_end + 1;
                done = 1;
                let marker: i32 = 0;
            }
        } else {
            done = 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    while depth > 0 {
        sb_append_literal(output, "}\n", 2);
        depth = depth - 1;
        let marker: i32 = 0;
    }
    return current;
};

// Emit `if COND { ... } else { ... }`.  Returns the index after it.
let emit_stmt_if = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let cond_start: usize = skip_space(source, index + 2);
    let brace: usize = scan_brace(source, cond_start, body_end);
    let brace_end: usize = match_brace(source, brace, body_end);
    // `Allocation.capacity_overflow()` is a `never` escape.  In a unit
    // vector operation the bootstrap has no panic ABI yet; omit that guard
    // entirely so the normal reserve/push path remains valid L1.
    let has_overflow: usize = 0;
    let scan_overflow: usize = brace + 1;
    while scan_overflow < brace_end {
        if sb_span_equals(source, scan_overflow, 17, "capacity_overflow", 17) {
            has_overflow = 1;
            break;
        }
        scan_overflow = scan_overflow + 1;
    }
    if has_overflow == 1 && output_current_unit(output) {
        return brace_end + 1;
    }
    sb_append_literal(output, "#if ", 4);
    emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
    sb_append_literal(output, " {\n", 3);
    emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
    sb_append_literal(output, "}\n", 2);
    let after: usize = skip_space(source, brace_end + 1);
    if sb_span_equals(source, after, 4, "else", 4) {
        return emit_else_tail(source, output, after, body_end, layout, types, meta, consts);
    }
    let marker: i32 = 0;
    return brace_end + 1;
};

let emit_return_record_value = std::func(
    source: addr,
    output: addr,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_start: usize = trim_start(source, expr_start, expr_end);
    let tail: usize = emit_path_tail(source, name_start, expr_end);
    let name_end: usize = parse_ident(source, tail);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    let llen: usize = sb_len(layout);
    let rec: usize = meta_table_find(layout, llen, source, tail, name_end);
    if rec >= llen {
        sb_append_literal(output, "#let %r", 7);
        meta_append_decimal(output, expr_start);
        sb_append_literal(
            output,
            ": addr = #call bootstrap.allocate-pages(64)\n",
            44,
        );
        return;
    }
    let seg_end: usize = meta_seg_end(layout, llen, rec);
    let size: usize = meta_record_size(layout, rec, seg_end);
    sb_append_literal(output, "#let %r", 7);
    meta_append_decimal(output, expr_start);
    sb_append_literal(output, ": addr = #call bootstrap.allocate-pages(", 40);
    meta_append_decimal(output, size);
    sb_append_literal(output, ")\n", 2);
    let current: usize = brace + 1;
    let field_index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fe: usize = parse_ident(source, fs);
        let colon: usize = scan_top_op(source, fs, brace_end, 58);
        let vs: usize = skip_space(source, colon + 1);
        let ve: usize = scan_record_value_end(source, vs, brace_end);
        let off: usize = meta_field_offset(layout, rec, seg_end, source, fs, fe);
        let width: usize = meta_field_width(layout, rec, seg_end, source, fs, fe);
        let addr_field: usize = meta_field_addr(layout, rec, seg_end, source, fs, fe);
        // A nested record constructor may be qualified (for example
        // `Generated.SyntaxList { ... }`).  Looking only at the first
        // identifier misses the brace after the module path and lets the
        // ordinary expression emitter turn the type name into a bogus
        // `%SyntaxList` value.
        let value_tail: usize = emit_path_tail(source, vs, ve);
        let value_name_end: usize = parse_ident(source, value_tail);
        let value_after: usize = skip_space(source, value_name_end);
        let nested: usize = 0;
        if sb_byte_at(source, value_after) == 123 {
            nested = 1;
            emit_nested_record_value(
                source, output, vs, ve, expr_start, field_index,
                layout, types, meta, consts
            );
        }
        sb_append_literal(output, "#let %rv", 8);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, field_index);
        if addr_field == 1 {
            sb_append_literal(output, ": addr = ", 9);
        } else {
            sb_append_literal(output, ": #bits<", 8);
            meta_emit_bits(output, width);
            sb_append_literal(output, "> = ", 4);
        }
        if nested == 1 {
            sb_append_literal(output, "%n", 2);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, field_index);
        } else {
            emit_expr(source, vs, ve, output, layout, types, meta, consts);
        }
        if addr_field == 1 {
            sb_append_literal(output, "\n#store[addr] %rv", 17);
        } else {
            sb_append_literal(output, "\n#store %rv", 11);
        }
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, field_index);
        sb_append_literal(output, ", #lea(base=%r", 14);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
        meta_append_decimal(output, off);
        sb_append_literal(output, ")\n", 2);
        current = skip_space(source, ve);
        if current < brace_end && sb_byte_at(source, current) == 44 {
            current = current + 1;
            let marker: i32 = 0;
        }
        field_index = field_index + 1;
        let marker: i32 = 0;
    }
};

// Check the currently open generated procedure header.  This lets the
// statement lowerer distinguish `return never_value()` inside a unit
// procedure from the same expression in a scalar procedure without adding
// another return-type parameter through every block helper.
let output_current_unit = std::func(output: addr) -> bool {
    // The frozen frontend cannot reliably lower the nested backward scan
    // that used to live here.  Keep the helper side-effect free and let the
    // normal statement path handle these rare `never` escapes.
    return false;
};

// Emit `return EXPR;`.  Returns the index after it.
let emit_stmt_ret = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let expr_start: usize = skip_space(source, index + 6);
    let semi: usize = scan_semi(source, expr_start, body_end);
    let expr_tail: usize = emit_path_tail(source, expr_start, semi);
    let expr_name_end: usize = parse_ident(source, expr_tail);
    if output_current_unit(output) {
        if sb_span_equals(
                source, expr_tail, expr_name_end - expr_tail,
                "capacity_overflow", 17
            ) {
            // `never` is only used here as an error escape.  The bootstrap
            // runtime has no panic value yet, so keep the unit branch empty;
            // the normal path remains fully executable and the verifier
            // accepts an empty unit block.
            return semi + 1;
        }
    }
    let rs2: usize = trim_start(source, expr_start, semi);
    let rn2: usize = parse_ident(source, rs2);
    let rt2: usize = emit_path_tail(source, rs2, semi);
    let rn2b: usize = parse_ident(source, rt2);
    let ra2: usize = skip_space(source, rn2b);
    if sb_byte_at(source, ra2) == 123 {
        emit_return_record_value(
            source, output, expr_start, semi, layout, types, meta, consts
        );
        sb_append_literal(output, "  #return %r", 12);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "\n", 1);
        return semi + 1;
    }
    sb_append_literal(output, "  #return ", 10);
    emit_expr(source, expr_start, semi, output, layout, types, meta, consts);
    sb_append_literal(output, "\n", 1);
    return semi + 1;
};

// Emit an assignment or call statement.  Returns the index after it.
let emit_stmt_other = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
