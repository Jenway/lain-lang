// Bind a compile-time function declaration
// `let NAME = std::consteval(params) -> T { body }` into the meta table
// (kind 6) without emitting any product.  Payload: params_start, body_open.
// mrow is the owning module's meta row (0 for top-level).
let emit_consteval = std::func(
    source: addr,
    index: usize,
    end: usize,
    meta: addr,
    mrow: usize,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let params_start: usize = name_end;
    while params_start < end && sb_byte_at(source, params_start) != 40 {
        params_start = params_start + 1;
        let marker: i32 = 0;
    }
    if params_start >= end { return end; }
    let params_end: usize = params_start + 1;
    while params_end < end && sb_byte_at(source, params_end) != 41 {
        params_end = params_end + 1;
        let marker: i32 = 0;
    }
    if params_end >= end { return end; }
    let scan: usize = params_end + 1;
    let body_open: usize = scan;
    while body_open < end {
        let b: i32 = sb_byte_at(source, body_open);
        if b == 123 { break; }
        if b == 59 { break; }
        body_open = body_open + 1;
        let marker: i32 = 0;
    }
    meta_append(meta, 6, name_start, name_end - name_start, params_start, body_open, mrow);
    if sb_byte_at(source, body_open) == 123 {
        return match_brace(source, body_open, end) + 1;
    }
    return scan_semi(source, body_open, end) + 1;
};

// Detect a top-level consteval call `let NAME = CV(args);` with the
// expression [crs, cre) and alias [cns, cne): evaluate and bind into
// consts.  Returns 1 when bound.
let try_consteval_call = std::func(
    source: addr,
    crs: usize,
    cre: usize,
    cns: usize,
    cne: usize,
    meta: addr,
    consts: addr,
    sentinel: usize,
) -> i32 {
    let cne2: usize = parse_ident(source, crs);
    let csep: usize = skip_space(source, cne2);
    let cmod_row: usize = 0;
    let cmem_start: usize = crs;
    let cmem_end: usize = cne2;
    if sb_byte_at(source, csep) == 46 {
        let cnext: usize = skip_space(source, csep + 1);
        if is_ident_start_at(source, cnext) {
            let mlen3: usize = sb_len(meta);
            let mrow4: usize = meta_lookup(meta, mlen3, source, crs, cne2 - crs);
            if mrow4 != 0 {
                let mk4: usize = meta_value_kind(meta, mlen3, mrow4);
                if mk4 == 2 {
                    cmod_row = mrow4;
                    cmem_start = cnext;
                    cmem_end = parse_ident(source, cnext);
                    let marker: i32 = 0;
                }
            }
        }
    }
    if sb_byte_at(source, cmem_end) != 40 { return 0; }
    let mlen2: usize = sb_len(meta);
    let crow2: usize = 0;
    if cmod_row != 0 {
        crow2 = meta_lookup_qualified(meta, mlen2, source, cmem_start, cmem_end - cmem_start, cmod_row);
    } else {
        crow2 = meta_lookup(meta, mlen2, source, cmem_start, cmem_end - cmem_start);
    }
    if crow2 == 0 { return 0; }
    let ck: usize = meta_value_kind(meta, mlen2, crow2);
    if ck != 6 { return 0; }
    let aend: usize = cmem_end + 1;
    let adepth: usize = 1;
    let adone: usize = 0;
    while adone == 0 {
        // A malformed qualified call must fail as a Meta diagnostic rather
        // than scanning past the current initializer and corrupting the
        // shared source buffer.  This guard is especially important for
        // module consteval members, whose callee span is split at the dot.
        if aend >= cre { return 0; }
        if sb_byte_at(source, aend) == 41 {
            adepth = adepth - 1;
            if adepth == 0 {
                adone = 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        } else {
            if sb_byte_at(source, aend) == 40 {
                adepth = adepth + 1;
                aend = aend + 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        }
    }
    let outer0: addr = sb_new();
    let cv2: usize = meta_call_consteval(source, meta, mlen2, crow2, cmem_end + 1, aend, consts, 1, outer0);
    if cv2 != sentinel {
        meta_append(consts, 1, cns, cne - cns, cv2, 0, 0);
        return 1;
    }
    return 0;
};

// Evaluate a type-factory alias such as `IntVec: type = vector.Vec(...)`.
// Besides recording the type span, this materializes the factory namespace
// once so calls like IntVec.new/IntVec.push have real procedures to target.
let try_bind_type_factory = std::func(
    source: addr,
    output: addr,
    alias_start: usize,
    alias_end: usize,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> i32 {
    let member_start: usize = emit_path_tail(source, expr_start, expr_end);
    let member_end: usize = parse_ident(source, member_start);
    let mlen: usize = sb_len(meta);
    let row: usize = meta_lookup(meta, mlen, source, member_start, member_end - member_start);
    if row == 0 { return 0; }
    if meta_value_kind(meta, mlen, row) != 3 { return 0; }
    let call_after: usize = skip_space(source, member_end);
    if sb_byte_at(source, call_after) != 40 { return 0; }
    let ignored: usize = eval_module_factory(
        source, output, expr_start, expr_end,
        alias_start, alias_end - alias_start,
        layout, types, meta, consts
    );
    return 1;
};

// Compile one source program into LAIN-IR text appended to output, sharing
// the session tables (layout/types/meta/consts).  prefix is a non-empty
// buffer when this source is an import library: top-level names are
// emitted as f0_<basename>_<name>.  Returns 0 on success.
let compile_source = std::func(
    source: addr,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
    prefix: addr,
    seg_begin: usize,
    seg_end2: usize,
) -> i32 {
    // `source` is shared by compiler_compile_library while it appends each
    // input segment.  The brace cache is keyed by positions in that buffer,
    // so a table built for an earlier segment cannot be reused after the
    // buffer grows; invalidate it before scanning this segment.
    let cache_zero: usize = 0;
