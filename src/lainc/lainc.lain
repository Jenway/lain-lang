                    let eq: usize = scan_top_op(source, index, length, 61);
                    let func_start: usize = skip_space(source, eq + 1);
                    if sb_span_equals(source, func_start, 6, "import", 6) {
                        index = bind_import(source, index, length, meta);
                    } else {
                    if sb_span_equals(source, func_start, 11, "std::struct", 11) {
                        index = emit_record(source, output, index, length, layout, meta);
                    } else {
                        if sb_span_equals(source, func_start, 14, "std::consteval", 14) {
                            index = emit_consteval(source, index, length, meta, 0);
                        } else {
                            if sb_span_equals(source, func_start, 11, "std::module", 11) {
                            index = emit_module(source, output, index, length, layout, types, meta, consts);
                        } else {
                            if sb_span_equals(source, func_start, 9, "std::func", 9) {
                                index = emit_function2_context(
                                    source, output, index, link, 0, 0, 0,
                                    prefix, specialization_context
                                );
                                link = 0;
                        } else {
                            let semi: usize = scan_semi(source, index, length);
                            let cns: usize = skip_space(source, index + 3);
                            let cne: usize = parse_ident(source, cns);
                            let crs: usize = trim_start(source, eq + 1, semi);
                            let cre: usize = trim_end(source, crs, semi);
                            // Top-level type alias `let NAME: type = TYPE;`:
                            // bind a kind-4 meta row (payload = the type
                            // span) so emit_type can resolve it.
                            let tmark: usize = scan_let_mark(source, cns, semi);
                            if sb_byte_at(source, tmark) == 58 {
                                let ttyp: usize = skip_space(source, tmark + 1);
                                if sb_span_equals(source, ttyp, 4, "type", 4) {
                                    let teq: usize = scan_top_op(source, tmark + 1, semi, 61);
                                    let tas: usize = trim_start(source, teq + 1, semi);
                                    let tae: usize = trim_end(source, tas, semi);
                                    meta_append(meta, 4, cns, cne - cns, tas, tae - tas, 0);
                                    let factory_bound: i32 = try_bind_type_factory(
                                        source, output, cns, cne,
                                        tas, tae, layout, types, meta, consts
                                    );
                                    let marker: i32 = 0;
                                }
                            }
                            let sentinel: usize = 0 - 1;
                            let cval: usize = meta_eval_const(source, crs, cre);
                            if cval != sentinel {
                                meta_append(consts, 1, cns, cne - cns, cval, 0, 0);
                                let marker: i32 = 0;
                            } else {
                                // `consts` already contains exactly the
                                // kind-1 rows copied into the old temporary
                                // environment.  Nested evaluation is read
                                // only, so reuse it instead of allocating a
                                // 1 MiB metadata table for every fallback.
                                let cval2: usize = meta_eval_nested(source, crs, cre, consts);
                                if cval2 != sentinel {
                                    meta_append(consts, 1, cns, cne - cns, cval2, 0, 0);
                                    let marker: i32 = 0;
                                } else {
                                    let tb: i32 = try_bind_module_value(source, index, length, output, layout, types, meta, consts);
                                    if tb == 0 {
                                        let tc: i32 = try_consteval_call(source, crs, cre, cns, cne, meta, consts, sentinel);
                                        let marker: i32 = 0;
                                    }
                                    let marker: i32 = 0;
                                }
                            }
                            index = semi + 1;
                            let marker: i32 = 0;
                        }
                    }
                }
                }
                    }
            } else {
                index = index + 1;
                let marker: i32 = 0;
            }
        }
    }
    }
    return 0;
};

// Compile the source program into LAIN-IR text.  Returns 0 on success.
let emit_bootstrap_externs = std::func(output: addr) -> unit {
    sb_append_literal(
        output,
        "#extern #proc bootstrap.allocate-pages(#bits<64> %size) -> #addr;\n\n",
        67,
    );
};

let compile = std::func(
    source: addr,
    output: addr,
) -> i32 {
    if true {
        emit_bootstrap_externs(output);
    }
    let layout: addr = sb_new();
    let types: addr = sb_new();
    let meta: addr = sb_new();
    let consts: addr = sb_new();
    let empty_prefix: addr = sb_new_small();
    let src_len: usize = sb_len(source);
    let status: i32 = compile_source(source, output, layout, types, meta, consts, empty_prefix, 0, src_len);
    let marker: i32 = 0;
    return status;
};

// Compile the hard-coded add+main source and return the emitted LAIN-IR.
let emit = std::func() -> addr {
    let source: addr = sb_new();
    sb_append_literal(
        source,
        "let add = std::func(x: i32, y: i32) -> i32 {\n    return x + y;\n};\nlet main = std::func() -> i32 {\n    return add(40, 2);\n};",
        123,
    );
    let output: addr = sb_new();
    let status: i32 = compile(source, output);
    let marker: i32 = 0;
    return output;
};

// Write a buffer's bytes to the artifact stream.
let write_buffer_to_artifact = std::func(buf: addr) -> unit {
    let length: usize = sb_len(buf);
    // Keep the final write in terms of the sentinel-aware byte accessor.
    // Passing `buf + 8` as an address argument used to lower to integer
    // `#add(%buf, 8)`, which traps in the interpreter.  This loop is only
    // on the artifact-output path, so correctness is more important than
    // the small amount of host I/O it adds.
    let index: usize = 0;
    while index < length {
        let byte: i32 = sb_byte_at(buf, index);
        if byte != 0 {
            artifact_write_byte(byte);
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

// Compile and write the emitted LAIN-IR to the artifact stream.
// The artifact (product.l1) is then verified and executed by the harness.
let main = std::func() -> i32 {
    let emitted: addr = emit();
    let marker: i32 = 0;
    artifact_begin();
    write_buffer_to_artifact(emitted);
    artifact_finish();
    return 0;
};

// compiler_compile entry: compile the first host source and write the
// artifact.  Returns the compile status.
let compiler_compile = std::func() -> i32 {
    let source: addr = sb_from_source();
    let output: addr = sb_new();
    let status: i32 = compile(source, output);
    let marker: i32 = 0;
    artifact_begin();
    write_buffer_to_artifact(output);
    artifact_finish();
    return status;
};

// Append host source `idx` to the shared big buffer; returns the new
// buffer length.
let append_source_to_big = std::func(big: addr, idx: usize) -> usize {
    let src: addr = sb_from_source_index(idx);
    let length: usize = sb_len(src);
    let data: addr = sb_load_addr_at(src, 16);
    sb_append_raw_span(big, data, length);
    return sb_len(big);
};

// compiler_compile_library entry: compile every host source as one library
// session.  All sources are concatenated into one shared source buffer so
// meta-table name offsets are globally consistent across files; sources
// before the last are import libraries (top-level names get the
// source-basename prefix f0_<basename>_<name>), the last is the entry (no
// prefix).  Sources must be ordered dependency-first.  The product is a
// single LAIN-IR artifact.
let compiler_compile_library = std::func() -> i32 {
    let count: usize = source_count();
    let layout: addr = sb_new();
    let types: addr = sb_new();
    let meta: addr = sb_new();
    let consts: addr = sb_new();
    let output: addr = sb_new();
    let big: addr = sb_new();
    let empty_prefix: addr = sb_new_small();
    let cursor: usize = 0;
    let idx: usize = 0;
    let status: i32 = 0;
    emit_bootstrap_externs(output);
    while idx < count {
        let seg_begin: usize = cursor;
        let seg_end2: usize = append_source_to_big(big, idx);
        cursor = seg_end2;
        if idx + 1 < count {
            let prefix2: addr = source_basename(idx);
            status = compile_source(big, output, layout, types, meta, consts, prefix2, seg_begin, seg_end2);
            let marker: i32 = 0;
        } else {
            status = compile_source(big, output, layout, types, meta, consts, empty_prefix, seg_begin, seg_end2);
            let marker: i32 = 0;
        }
        idx = idx + 1;
        let marker: i32 = 0;
    }
    artifact_begin();
    write_buffer_to_artifact(output);
    artifact_finish();
    return status;
};
