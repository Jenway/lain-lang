    let index_start: usize = end;
    if sb_byte_at(source, plus) == 43 {
        index_start = skip_space(source, plus + 1);
    }
    sb_append_literal(output, "#lea(base=#load[addr](#lea(base=%", 33);
    sb_append_span(output, source, start, base_end - start);
    sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
