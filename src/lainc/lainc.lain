                    off = 0;
                    is_addr = 1;
                } else if sb_span_equals(source, field_start, field_end - field_start, "first_child", 11) {
                    off = 28;
                } else if sb_span_equals(source, field_start, field_end - field_start, "next_sibling", 12) {
                    off = 36;
                } else if sb_span_equals(source, field_start, field_end - field_start, "origin", 6) {
