// Context-aware entry point used by factory specialization.  Keeping the
// legacy emitter intact lets the migration proceed one call chain at a time;
// all table arguments for this path are now recovered from the same context
// object, and the key is read so instrumentation can identify the active
// specialization environment.
let emit_function2_context = std::func(
    source: addr,
    output: addr,
    index: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    mrow: usize,
    prefix: addr,
    context: addr,
) -> usize {
    // Read the flat slots directly here.  This keeps the hot emitter path to
    // four loads instead of four nested helper calls per declaration while
    // the context migration is in progress.
    let context_layout: addr = std::load_bits(64, context + 0);
    let context_types: addr = std::load_bits(64, context + 8);
    let context_meta: addr = std::load_bits(64, context + 16);
    let context_consts: addr = std::load_bits(64, context + 24);
    return emit_function2(
        source, output, index, link, mod_start, mod_end, mrow, prefix,
        context_layout, context_types, context_meta, context_consts,
    );
};

// Emit a `let NAME: type = std::struct { ... }` binding: record field
// widths/offsets into the layout table.  No LAIN-IR is emitted for the type
// itself.  Returns the index after the declaration.
let emit_record = std::func(
    source: addr,
    output: addr,
    index: usize,
    end: usize,
    layout: addr,
    meta: addr,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let brace: usize = scan_brace(source, name_start, end);
    let brace_end: usize = match_brace(source, brace, end);
    meta_append(meta, 4, name_start, name_end - name_start, brace, 1, 0);
    let layout_seg_start: usize = sb_len(layout);
    sb_append_span(layout, source, name_start, name_end - name_start);
    let layout_seg_colon: usize = sb_len(layout);
    sb_append_literal(layout, ":", 1);
    let body: usize = brace + 1;
    let current: usize = body;
    let offset: usize = 0;
    while current < brace_end {
        let s: usize = skip_space(source, current);
        if s >= brace_end { break; }
        let field_end: usize = parse_ident(source, s);
        let colon: usize = scan_top_op(source, s, brace_end, 58);
        let type_start: usize = skip_space(source, colon + 1);
        let type_end: usize = meta_scan_type_end(source, brace_end, type_start);
        let t: usize = trim_start(source, type_start, type_end);
        let t2: usize = trim_end(source, t, type_end);
        let width: usize = 8;
        if sb_span_equals(source, t, t2 - t, "bool", 4) {
            width = 1;
            let marker: i32 = 0;
        }
        if sb_span_equals(source, t, t2 - t, "i32", 3) {
            width = 4;
            let marker: i32 = 0;
        }
        if sb_span_equals(source, t, t2 - t, "usize", 5) {
            width = 8;
            let marker: i32 = 0;
        }
        // Record whether the field type lowers to an address, so record
        // constructors can store addr-typed values (Memory.String etc.)
        // with the right physical type.  The type span here is a source
        // offset, so meta_type_is_addr is valid on it.
        let faddr: usize = meta_type_is_addr(source, t, t2, meta);
        sb_append_span(layout, source, s, field_end - s);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, offset);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, width);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, faddr);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, t);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, t2);
        sb_append_literal(layout, "#", 1);
        offset = offset + width;
        current = type_end;
        current = skip_space(source, current);
        if current < brace_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
    sb_append_literal(layout, "=", 1);
    meta_append_decimal(layout, offset);
    sb_append_literal(layout, "|", 1);
    table_index_add(layout, layout_seg_start, layout_seg_colon, sb_len(layout) - 1);
    return brace_end + 1;
};

// Is the type span [ts, te) lowered to an address?  Mirrors emit_type's
// decision: `&` references, `addr`, and any type the emitter cannot
// resolve to a scalar bits type (record payloads, cross-module aliases,
// unknown names) are all `addr`; the scalar keywords are bits.
let meta_type_is_addr = std::func(
    source: addr,
    ts: usize,
    te: usize,
    meta: addr,
) -> usize {
    let t: usize = trim_start(source, ts, te);
    let t2: usize = trim_end(source, t, te);
    let first: i32 = sb_byte_at(source, t);
    if first == 38 { return 1; }
    if sb_span_equals(source, t, t2 - t, "addr", 4) { return 1; }
    if sb_span_equals(source, t, t2 - t, "unit", 4) { return 0; }
    if sb_span_equals(source, t, t2 - t, "bool", 4) { return 0; }
    if sb_span_equals(source, t, t2 - t, "usize", 5) { return 0; }
    if sb_span_equals(source, t, t2 - t, "i32", 3) { return 0; }
    let ml: usize = sb_len(meta);
    let tr: usize = meta_lookup(meta, ml, source, t, t2 - t);
    if tr != 0 {
        let tk: usize = meta_value_kind(meta, ml, tr);
        if tk == 4 {
            let ps: usize = meta_value_payload_start(meta, ml, tr);
            let pl: usize = meta_value_payload_length(meta, ml, tr);
            if sb_byte_at(source, ps) != 123 {
                let pe: usize = ps + pl;
                return meta_type_is_addr(source, ps, pe, meta);
            }
            let marker: i32 = 0;
        }
    }
    // Qualified type alias: resolve the module row, then the member, and
    // recurse into the member's payload (mirrors emit_type).  Scan once
    // for the last `.` separator.
    let tscan: usize = t;
    let scan: usize = t;
    while scan < t2 {
        if sb_byte_at(source, scan) == 46 {
            let after: usize = skip_space(source, scan + 1);
            if after < t2 {
                if is_ident_start_at(source, after) {
                    tscan = after;
                    let marker: i32 = 0;
                }
            }
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    if tscan > t {
        let mod_span: usize = t;
        let mod_end: usize = parse_ident(source, mod_span);
        let mrow: usize = meta_resolve_module_row(
            source, meta, ml, mod_span, mod_end - mod_span
        );
        if mrow != 0 {
            let mkind: usize = meta_value_kind(meta, ml, mrow);
            if mkind == 2 {
                let mem_end: usize = parse_ident(source, tscan);
                let mtr: usize = meta_lookup_qualified(meta, ml, source, tscan, mem_end - tscan, mrow);
                if mtr != 0 {
                    let mtk: usize = meta_value_kind(meta, ml, mtr);
                    if mtk == 4 {
                        let mps: usize = meta_value_payload_start(meta, ml, mtr);
                        let mpl: usize = meta_value_payload_length(meta, ml, mtr);
                        if sb_byte_at(source, mps) != 123 {
                            let mpe: usize = mps + mpl;
                            return meta_type_is_addr(source, mps, mpe, meta);
                        }
                        let marker: i32 = 0;
                    }
                }
            }
        }
    }
    return 1;
};

// Emit a record constructor `Name { f: v, ... }` at [expr_start, expr_end)
// into output as
//   #let %var: addr = #alloca(<size>)
//   #let %v<i>: #bits<W> = <value>
//   #store %v<i>, #lea(base=%var, idx=0, scale=0, offset=<off>)
// for every field; `var` is the binding being assigned.
let emit_bool_options_value = std::func(
    source: addr,
    output: addr,
    expr_start: usize,
    expr_end: usize,
    owner_start: usize,
    owner_index: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_end: usize = parse_ident(source, expr_start);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    sb_append_literal(output, "#let %n", 7);
    meta_append_decimal(output, owner_start);
    sb_append_literal(output, "_", 1);
    meta_append_decimal(output, owner_index);
    sb_append_literal(output, ": addr = #alloca(2)\n", 20);
    let current: usize = brace + 1;
    let index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fname_end: usize = parse_ident(source, fs);
        let fcolon: usize = scan_top_op(source, fs, brace_end, 58);
        let vstart: usize = skip_space(source, fcolon + 1);
        let vend: usize = scan_record_value_end(source, vstart, brace_end);
        sb_append_literal(output, "#let %nv", 8);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ": #bits<1> = ", 13);
        emit_expr(source, vstart, vend, output, layout, types, meta, consts);
        sb_append_literal(output, "\n#store %nv", 11);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ", #lea(base=%n", 14);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
        meta_append_decimal(output, index);
        sb_append_literal(output, ")\n", 2);
        current = skip_space(source, vend);
        if current < brace_end && sb_byte_at(source, current) == 44 {
            current = current + 1;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

let emit_nested_record_value = std::func(
    source: addr,
    output: addr,
    expr_start: usize,
    expr_end: usize,
    owner_start: usize,
    owner_index: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_start: usize = trim_start(source, expr_start, expr_end);
    let name_start2: usize = emit_path_tail(source, name_start, expr_end);
    let name_end: usize = parse_ident(source, name_start2);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    let len: usize = sb_len(layout);
    let rec: usize = meta_table_find(layout, len, source, name_start2, name_end);
    let fixed_kind: usize = 0;
    if sb_span_equals(source, name_start2, name_end - name_start2, "Span", 4) {
        fixed_kind = 1;
    } else if sb_span_equals(source, name_start2, name_end - name_start2, "Node", 4) {
        fixed_kind = 2;
    } else if sb_span_equals(source, name_start, name_end - name_start, "Syntax.Node", 11) {
        fixed_kind = 2;
    }
    if rec >= len {
        if sb_span_equals(source, name_start2, name_end - name_start2, "SourceSlice", 11)
            || sb_span_equals(source, name_start2, name_end - name_start2, "PathSlice", 9)
            || sb_span_equals(source, name_start2, name_end - name_start2, "SourceBuffer", 12) {
            rec = meta_table_find_literal(layout, len, "Concrete", 8);
        }
    }
    if rec >= len && fixed_kind == 0 { return; }
    let seg_end: usize = len;
    let size: usize = 16;
    if fixed_kind == 0 {
        seg_end = meta_seg_end(layout, len, rec);
        size = meta_record_size(layout, rec, seg_end);
    } else if fixed_kind == 2 {
        size = 64;
    }
    sb_append_literal(output, "#let %n", 7);
    meta_append_decimal(output, owner_start);
    sb_append_literal(output, "_", 1);
    meta_append_decimal(output, owner_index);
    sb_append_literal(output, ": addr = #call bootstrap.allocate-pages(", 40);
    meta_append_decimal(output, size);
    sb_append_literal(output, ")\n", 2);
    let current: usize = brace + 1;
    let index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fname_end: usize = parse_ident(source, fs);
        let fcolon: usize = scan_top_op(source, fs, brace_end, 58);
        let vstart: usize = skip_space(source, fcolon + 1);
        let vend: usize = scan_record_value_end(source, vstart, brace_end);
        let off: usize = meta_field_offset(layout, rec, seg_end, source, fs, fname_end);
        let w: usize = meta_field_width(layout, rec, seg_end, source, fs, fname_end);
        let faddr: usize = meta_field_addr(layout, rec, seg_end, source, fs, fname_end);
        if fixed_kind == 1 {
            if sb_span_equals(source, fs, fname_end - fs, "start", 5) {
                off = 0;
            } else if sb_span_equals(source, fs, fname_end - fs, "end", 3) {
                off = 8;
            }
            w = 64;
            faddr = 0;
        } else if fixed_kind == 2 {
            if index == 0 {
                off = 0;
                w = 4;
            } else if index == 1 {
                off = 4;
                w = 4;
            } else if index == 2 {
                off = 8;
                w = 4;
            } else if index == 3 {
                off = 12;
                faddr = 1;
            } else if index == 4 {
                off = 20;
                faddr = 1;
            } else if index == 5 {
                off = 28;
                w = 64;
            } else if index == 6 {
                off = 36;
                w = 64;
            } else if index == 7 {
                off = 44;
                w = 64;
            } else if index == 8 {
                off = 52;
                w = 64;
            } else if index == 9 {
                off = 60;
                w = 1;
            }
        }
        // Node's i32 discriminator fields are sometimes emitted through the
        // generic nested-record path, where the factory name is unavailable.
        // Preserve their widths by declaration order; Span keeps its explicit
        // 64-bit override above.
        if fixed_kind != 1 {
            if index == 0 || index == 1 || index == 2 {
                w = 4;
            } else if index == 9 {
                w = 1;
            }
        }
        sb_append_literal(output, "#let %nv", 8);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        if faddr == 1 {
            sb_append_literal(output, ": addr = ", 9);
        } else {
            sb_append_literal(output, ": #bits<", 8);
            meta_emit_bits(output, w);
            sb_append_literal(output, "> = ", 4);
        }
        emit_expr(source, vstart, vend, output, layout, types, meta, consts);
        sb_append_literal(output, "\n#store %nv", 11);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ", #lea(base=%n", 14);
        meta_append_decimal(output, owner_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, owner_index);
        sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
        meta_append_decimal(output, off);
        sb_append_literal(output, ")\n", 2);
        current = skip_space(source, vend);
        if current < brace_end && sb_byte_at(source, current) == 44 {
            current = current + 1;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

let emit_span_record_value = std::func(
    source: addr,
    output: addr,
    var_name_start: usize,
    var_name_end: usize,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    // The constructor may be qualified (`source.SourceBuffer { ... }`).
    // Use the path tail when deciding whether the two fields are address
    // shaped; looking only at the first segment made `contents` become a
    // scalar zero in the archive entry fixture.
    let name_tail: usize = emit_path_tail(source, expr_start, expr_end);
    let name_end: usize = parse_ident(source, name_tail);
    let is_buffer: usize = 0;
    if sb_span_equals(source, name_tail, name_end - name_tail, "SourceBuffer", 12) {
        is_buffer = 1;
    }
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    sb_append_literal(output, "#let %", 6);
    sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
    // The helper also handles SourceSlice.  A 24-byte allocation is safe for
    // its 16-byte prefix and is required for SourceBuffer's inline ByteSpan.
    sb_append_literal(output, ": addr = #call bootstrap.allocate-pages(24)\n", 44);
    let current: usize = brace + 1;
    let index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fname_end: usize = parse_ident(source, fs);
        let fcolon: usize = scan_top_op(source, fs, brace_end, 58);
        let vstart: usize = skip_space(source, fcolon + 1);
        let vend: usize = scan_record_value_end(source, vstart, brace_end);
        let is_data: usize = 0;
        let is_contents: usize = 0;
        // SourceSlice uses `data`, while SourceBuffer uses `path` and
        // `contents`; all three are address-shaped in the physical record.
        // The helper is only selected for these record families, so the
        // field name is a more reliable discriminator than the qualified
        // constructor spelling.
        if sb_span_equals(source, fs, fname_end - fs, "data", 4)
            || sb_span_equals(source, fs, fname_end - fs, "path", 4)
            || sb_span_equals(source, fs, fname_end - fs, "contents", 8) {
            is_data = 1;
        }
        if sb_span_equals(source, fs, fname_end - fs, "contents", 8) {
            // `contents` is the inline ByteSpan field of SourceBuffer.  The
            // constructor spelling can be qualified or specialized, so the
            // field itself is the stable discriminator here.
            is_contents = 1;
            is_buffer = 1;
        }
        sb_append_literal(output, "#let %sv", 8);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        if is_data == 1 {
            sb_append_literal(output, ": addr = ", 9);
        } else {
            sb_append_literal(output, ": #bits<64> = ", 14);
        }
        let value_name_end: usize = parse_ident(source, vstart);
        if is_data == 1
            && sb_span_equals(source, vstart, value_name_end - vstart, "memory", 6) {
            sb_append_literal(output, "#int2ptr(0)", 11);
        } else {
            emit_expr(source, vstart, vend, output, layout, types, meta, consts);
        }
        if is_contents == 1 {
            sb_append_literal(output, "\n#let %sv", 9);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, "_data: addr = #load[addr](#lea(base=%sv", 39);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, ", idx=0, scale=0, offset=0))\n#store %sv", 39);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, "_data, #lea(base=%", 18);
            sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
            sb_append_literal(output, ", idx=0, scale=0, offset=8)\n#let %sv", 36);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, "_len: #bits<64> = #load[#bits<64>](#lea(base=%sv", 48);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, ", idx=0, scale=0, offset=8))\n#store %sv", 39);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, "_len, #lea(base=%", 17);
            sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
            sb_append_literal(output, ", idx=0, scale=0, offset=16)\n", 29);
        } else {
            sb_append_literal(output, "\n#store %sv", 11);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
            sb_append_literal(output, ", #lea(base=%", 13);
            sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
            sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
            if index == 0 { sb_append_literal(output, "0", 1); }
            else { sb_append_literal(output, "8", 1); }
            sb_append_literal(output, ")\n", 2);
        }
        current = skip_space(source, vend);
        if current < brace_end && sb_byte_at(source, current) == 44 {
            current = current + 1;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

// The factory-scoped API record can be absent from the lightweight layout
// table when the request fixture is the final source in a library session.
// Its physical ABI is stable: three address-shaped fields (SourceSlice,
// String, CompileOptions) at offsets 0, 8 and 16.
let emit_compile_request_value = std::func(
    source: addr,
    output: addr,
    var_name_start: usize,
    var_name_end: usize,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_tail: usize = emit_path_tail(source, expr_start, expr_end);
    let name_end: usize = parse_ident(source, name_tail);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    sb_append_literal(output, "#let %", 6);
    sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
    sb_append_literal(output, ": addr = #call bootstrap.allocate-pages(24)\n", 44);
    let current: usize = brace + 1;
    let index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fname_end: usize = parse_ident(source, fs);
        let fcolon: usize = scan_top_op(source, fs, brace_end, 58);
        let vstart: usize = skip_space(source, fcolon + 1);
        let vend: usize = scan_record_value_end(source, vstart, brace_end);
        let faddr: usize = 1;
        let nested_options: usize = 0;
        if sb_span_equals(source, fs, fname_end - fs, "options", 7) {
            nested_options = 1;
        }
        if nested_options == 1 {
            emit_bool_options_value(
                source, output, vstart, vend, expr_start, index,
                layout, types, meta, consts
            );
        }
        sb_append_literal(output, "#let %v", 7);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ": addr = ", 9);
        if nested_options == 1 {
            sb_append_literal(output, "%n", 2);
            meta_append_decimal(output, expr_start);
            sb_append_literal(output, "_", 1);
            meta_append_decimal(output, index);
        } else {
            emit_expr(source, vstart, vend, output, layout, types, meta, consts);
        }
        sb_append_literal(output, "\n#store[addr] %v", 16);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ", #lea(base=%", 13);
        sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
        sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
        meta_append_decimal(output, index * 8);
        sb_append_literal(output, ")\n", 2);
        current = skip_space(source, vend);
        if current < brace_end && sb_byte_at(source, current) == 44 {
            current = current + 1;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

let emit_record_value = std::func(
    source: addr,
    output: addr,
    var_name_start: usize,
    var_name_end: usize,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_start: usize = trim_start(source, expr_start, expr_end);
    let name_start2: usize = emit_path_tail(source, name_start, expr_end);
    let name_end: usize = parse_ident(source, name_start2);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    let len: usize = sb_len(layout);
    let rec: usize = meta_table_find(layout, len, source, name_start2, name_end);
    // Dynamic L1 model records are factory-local aliases.  When their
    // specialized layout is not present in this compilation unit, preserve
    // their stable physical ABI explicitly instead of falling back to the
    // one-byte record placeholder.  That placeholder corrupts neighboring
    // vectors as soon as a field is stored.
    let fixed_kind: usize = 0;
    if sb_span_equals(source, name_start2, name_end - name_start2, "Type", 4) {
        fixed_kind = 1;
    } else if sb_span_equals(source, name_start2, name_end - name_start2, "Expr", 4) {
        fixed_kind = 2;
    } else if sb_span_equals(source, name_start2, name_end - name_start2, "Instruction", 11) {
