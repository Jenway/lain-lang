let emit_syntax_append_child_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %target: addr = #call f0_Vec_get_mut(#load[addr](#lea(base=%unit, idx=0, scale=0, offset=8)), %parent)\n", 108);
    sb_append_literal(output, "#if #eq(#load[#bits<64>](#lea(base=%target, idx=0, scale=0, offset=28)), #call f0_Syntax_invalid_node()) {\n", 107);
    sb_append_literal(output, "#store[#bits<64>] %child, #lea(base=%target, idx=0, scale=0, offset=28)\n", 72);
    sb_append_literal(output, "  #return\n", 10);
    sb_append_literal(output, "}\n", 2);
    sb_append_literal(output, "#let %tail: #bits<64> = #load[#bits<64>](#lea(base=%target, idx=0, scale=0, offset=28))\n", 88);
    sb_append_literal(output, "#loop {\n", 8);
    sb_append_literal(output, "#let %tail_node: addr = #call f0_Vec_get(#load[addr](#lea(base=%unit, idx=0, scale=0, offset=8)), %tail)\n", 105);
    sb_append_literal(output, "#if #eq(#load[#bits<64>](#lea(base=%tail_node, idx=0, scale=0, offset=36)), #call f0_Syntax_invalid_node()) {\n", 110);
    sb_append_literal(output, "#store[#bits<64>] %child, #lea(base=%tail_node, idx=0, scale=0, offset=36)\n", 75);
    sb_append_literal(output, "  #return\n", 10);
    sb_append_literal(output, "}\n", 2);
    sb_append_literal(output, "%tail = #load[#bits<64>](#lea(base=%tail_node, idx=0, scale=0, offset=36))\n", 75);
    sb_append_literal(output, "  #continue\n", 12);
    sb_append_literal(output, "}\n", 2);
};

