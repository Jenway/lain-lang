// src/lainc/lainc.lain — M1: Lain-written lainc with calls and arithmetic.
//
// Compiles this Lain subset into LAIN-IR text:
//   let add = std::func(x: i32, y: i32) -> i32 { return x + y; };
//   let main = std::func() -> i32 { return add(40, 2); };
// ->
//   #proc f0_add(#bits<32> %x, #bits<32> %y) -> #bits<32> {
//     #return #add(%x, %y)
//   }
//   #proc main() -> #bits<32> {
//     #return #call f0_add(40, 2)
//   }
//
// Frozen-lainc workarounds:
//   - lead every function with a `let` (call-first truncates the body)
//   - follow calls inside if-branches with a `let`
//   - string-literal lengths must be exact
//   - no top-level std::struct bindings (record + later functions => 3005)
//
// Entries:
//   emit() -> String : compile the hard-coded add+main source
//   main() -> i32    : compile and verify the emitted text exactly

let string_mod: Module = import("std::core::string");
let bounds: Module = import("std::bounds");
let arena: Module = import("std::core::arena_min");
let String: type = string_mod.string.String(
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);

// ---- byte helpers ----
let is_space = std::func(byte: i32) -> bool {
    if byte == 32 { return true; }
    if byte == 10 { return true; }
    return false;
};

let is_digit = std::func(byte: i32) -> bool {
    return byte >= 48 && byte <= 57;
};

let is_ident_start = std::func(byte: i32) -> bool {
    if byte >= 97 && byte <= 122 { return true; }
    if byte >= 65 && byte <= 90 { return true; }
    return false;
};

let is_ident_char = std::func(byte: i32) -> bool {
    if is_ident_start(byte) { return true; }
    return is_digit(byte);
};

// ---- scanning helpers ----
let skip_space = std::func(source: &String, index: usize) -> usize {
    let current: usize = index;
    while current < String.length(source) {
        let byte: i32 = String.byte_at(source, current);
        if is_space(byte) == false { return current; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

// Parse an identifier starting at index; returns the index just after it.
let parse_ident = std::func(source: &String, index: usize) -> usize {
    let current: usize = index;
    while current < String.length(source) {
        let byte: i32 = String.byte_at(source, current);
        if is_ident_char(byte) == false { break; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

// Append source bytes [start, start+length) to output.
let append_span = std::func(
    source: &String,
    start: usize,
    length: usize,
    output: &mut String,
) -> unit {
    let index: usize = 0;
    while index < length {
        String.append_byte(
            output,
            String.byte_at(source, start + index),
        );
        index = index + 1;
        let marker: i32 = 0;
    }
};

// Append a literal byte string to a String.
let append_literal = std::func(
    output: &mut String,
    literal: addr,
    length: usize,
) -> unit {
    let index: usize = 0;
    while index < length {
        String.append_byte(
            output,
            std::load_bits(8, literal + index),
        );
        index = index + 1;
        let marker: i32 = 0;
    }
};

// Does the source span [start, start+length) equal the literal text?
let span_equals = std::func(
    source: &String,
    start: usize,
    length: usize,
    literal: addr,
    literal_length: usize,
) -> bool {
    if length != literal_length { return false; }
    let index: usize = 0;
    while index < length {
        let byte: i32 = String.byte_at(source, start + index);
        if byte != std::load_bits(8, literal + index) { return false; }
        index = index + 1;
        let marker: i32 = 0;
    }
    return true;
};

// Emit one operand covering [start, end): number (verbatim), param
// (%name), or call (#call f0_NAME(args)).
let emit_operand = std::func(
    source: &String,
    start: usize,
    end: usize,
    output: &mut String,
) -> unit {
    let first: i32 = String.byte_at(source, start);
    if is_digit(first) {
        append_span(source, start, end - start, output);
        return;
    }
    let name_end: usize = parse_ident(source, start);
    let after: usize = skip_space(source, name_end);
    if String.byte_at(source, after) == 40 {
        let args_start: usize = after + 1;
        let args_end: usize = args_start;
        while String.byte_at(source, args_end) != 41 {
            args_end = args_end + 1;
            let marker: i32 = 0;
        }
        append_literal(output, "#call f0_", 8);
        append_span(source, start, name_end - start, output);
        append_literal(output, "(", 1);
        append_span(source, args_start, args_end - args_start, output);
        append_literal(output, ")", 1);
        return;
    }
    append_literal(output, "%", 1);
    append_span(source, start, name_end - start, output);
};

// Emit one function body starting after the opening brace: `  #return EXPR\n`.
let emit_body = std::func(
    source: &String,
    output: &mut String,
    body_start: usize,
) -> unit {
    let return_at: usize = skip_space(source, body_start);
    let expr_start: usize = skip_space(source, return_at + 6);
    let semi: usize = expr_start;
    while String.byte_at(source, semi) != 59 {
        semi = semi + 1;
        let marker: i32 = 0;
    }
    let plus: usize = expr_start;
    let plus_found: i32 = 0;
    while plus < semi {
        if String.byte_at(source, plus) == 43 {
            plus_found = 1;
            let marker: i32 = 0;
            break;
        }
        plus = plus + 1;
        let marker: i32 = 0;
    }
    append_literal(output, "  #return ", 10);
    if plus_found == 1 {
        append_literal(output, "#add(", 5);
        emit_operand(source, expr_start, plus, output);
        append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, plus + 1);
        emit_operand(source, right_start, semi, output);
        append_literal(output, ")", 1);
    } else {
        emit_operand(source, expr_start, semi, output);
    }
    append_literal(output, "\n", 1);
};

// Emit a parameter list [start, end): `x: i32, y: i32` ->
// `#bits<32> %x, #bits<32> %y`.
let emit_params = std::func(
    source: &String,
    output: &mut String,
    params_start: usize,
    params_end: usize,
) -> unit {
    let current: usize = params_start;
    let first: i32 = 1;
    while current < params_end {
        current = skip_space(source, current);
        let name_end: usize = parse_ident(source, current);
        if first == 1 {
            first = 0;
        } else {
            append_literal(output, ", ", 2);
        }
        append_literal(output, "#bits<32> %", 11);
        append_span(source, current, name_end - current, output);
        let scanning: i32 = 1;
        while scanning == 1 && current < params_end {
            let byte: i32 = String.byte_at(source, current);
            if byte == 44 {
                current = current + 1;
                scanning = 0;
                let marker: i32 = 0;
            } else {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker2: i32 = 0;
    }
};

// Emit one top-level function declaration.  Returns the index after it.
let emit_function = std::func(
    source: &String,
    output: &mut String,
    index: usize,
) -> usize {
    let current: usize = index + 3;
    current = skip_space(source, current);
    let name_end: usize = parse_ident(source, current);
    let params_start: usize = current;
    while String.byte_at(source, params_start) != 40 {
        params_start = params_start + 1;
        let marker: i32 = 0;
    }
    let params_end: usize = params_start + 1;
    while String.byte_at(source, params_end) != 41 {
        params_end = params_end + 1;
        let marker: i32 = 0;
    }
    let body_open: usize = params_end + 1;
    while String.byte_at(source, body_open) != 123 {
        body_open = body_open + 1;
        let marker: i32 = 0;
    }
    append_literal(output, "#proc ", 6);
    if span_equals(source, current, name_end - current, "main", 4) {
        append_span(source, current, name_end - current, output);
    } else {
        append_literal(output, "f0_", 3);
        append_span(source, current, name_end - current, output);
    }
    append_literal(output, "(", 1);
    emit_params(source, output, params_start + 1, params_end);
    append_literal(output, ") -> #bits<32> {\n", 18);
    emit_body(source, output, body_open + 1);
    append_literal(output, "}\n", 2);
    current = body_open + 1;
    while String.byte_at(source, current) != 125 {
        current = current + 1;
        let marker: i32 = 0;
    }
    // Skip the closing '}' and the terminating ';' so the driver loop
    // resumes at the next declaration, not in the middle of this one.
    current = current + 1;
    while String.byte_at(source, current) != 59 {
        current = current + 1;
        let marker: i32 = 0;
    }
    return current + 1;
};

// Compile the source program into LAIN-IR text.  Returns 0 on success.
let compile = std::func(
    source: &String,
    output: &mut String,
) -> i32 {
    let index: usize = 0;
    let length: usize = String.length(source);
    while index < length {
        index = skip_space(source, index);
        if index >= length { break; }
        index = emit_function(source, output, index);
        let marker: i32 = 0;
    }
    return 0;
};

// Compile the hard-coded add+main source and return the emitted LAIN-IR.
let emit = std::func() -> String {
    let source: String = String.new();
    append_literal(
        &mut source,
        "let add = std::func(x: i32, y: i32) -> i32 {\n    return x + y;\n};\nlet main = std::func() -> i32 {\n    return add(40, 2);\n};",
        123,
    );
    let output: String = String.new();
    let status: i32 = compile(&source, &mut output);
    let marker: i32 = 0;
    return output;
};

// Compile and verify the emitted text exactly inside the Lain layer.
let main = std::func() -> i32 {
    let emitted: String = emit();
    if String.equal_literal(
        &emitted,
        "#proc f0_add(#bits<32> %x, #bits<32> %y) -> #bits<32> {\n  #return #add(%x, %y)\n}\n#proc main() -> #bits<32> {\n  #return #call f0_add(40, 2)\n}\n",
        141,
    ) {
        return 1;
    }
    return 0;
};
