// Emit a single operand [start, end): number, string literal, identifier,
// &x, or call.
let emit_operand_core = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
