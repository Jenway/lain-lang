// Trim [start, end) to the non-space core; returns the new start.
let trim_start = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    while current < end {
        if is_space_at(source, current) == false { return current; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

// Trim trailing spaces; returns the new end.
let trim_end = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = end;
    while current > start {
        let byte: i32 = sb_byte_at(source, current - 1);
        if is_space(byte) == false { return current; }
        current = current - 1;
        let marker: i32 = 0;
    }
    return current;
};

// ---- expression lowering ----

let emit_known_data_addr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    base_end: usize,
    field_end: usize,
) -> unit {
    let plus: usize = skip_space(source, field_end);
    let index_start: usize = end;
    if sb_byte_at(source, plus) == 43 {
        index_start = skip_space(source, plus + 1);
    }
    sb_append_literal(output, "#lea(base=#load[addr](#lea(base=%", 33);
    sb_append_span(output, source, start, base_end - start);
    sb_append_literal(output, ", idx=0, scale=0, offset=0)), idx=", 34);
    if index_start < end {
        if is_digit_at(source, index_start) == false {
            sb_append_literal(output, "%", 1);
        }
        sb_append_span(output, source, index_start, end - index_start);
        sb_append_literal(output, ", scale=1, offset=0)", 20);
    } else {
        sb_append_literal(output, "0, scale=0, offset=0)", 21);
    }
};

let layout_find_for_type = std::func(
    layout: addr,
    types: addr,
    type_start: usize,
    type_end: usize,
) -> usize {
    let start: usize = type_start;
    if sb_byte_at(types, start) == 38 {
        start = skip_space(types, start + 1);
        if sb_span_equals(types, start, 3, "mut", 3) {
            start = skip_space(types, start + 3);
            let marker: i32 = 0;
        }
    }
    let tail: usize = emit_path_tail(types, start, type_end);
    let tail_end: usize = parse_ident(types, tail);
    let found: usize = meta_table_find(layout, sb_len(layout), types, tail, tail_end);
    if found < sb_len(layout) { return found; }
    // All Vec specializations use the same physical triple
    // (storage:length:capacity).  Their source aliases are distinct, so
    // recover the shared Concrete layout when the alias name ends in
    // `Vector` and no dedicated record row exists.
    let alias_len: usize = tail_end - tail;
    if alias_len >= 6
        && sb_byte_at(types, tail_end - 6) == 86
        && sb_byte_at(types, tail_end - 5) == 101
        && sb_byte_at(types, tail_end - 4) == 99
        && sb_byte_at(types, tail_end - 3) == 116
        && sb_byte_at(types, tail_end - 2) == 111
        && sb_byte_at(types, tail_end - 1) == 114 {
        return meta_table_find_literal(layout, sb_len(layout), "Concrete", 8);
    }
    return found;
};

let emit_addr_field_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
) -> bool {
    let base_end: usize = parse_ident(source, start);
    let dot: usize = skip_space(source, base_end);
    if sb_byte_at(source, dot) != 46 { return 0; }
    let field_start: usize = skip_space(source, dot + 1);
    let field_end: usize = parse_ident(source, field_start);
    let dot2: usize = skip_space(source, field_end);
    if sb_byte_at(source, dot2) == 46 {
        let inner_start: usize = skip_space(source, dot2 + 1);
        let inner_end: usize = parse_ident(source, inner_start);
