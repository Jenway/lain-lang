            if sb_byte_at(source, second_end) == 43 {
                scanning2 = 0;
                let marker: i32 = 0;
            } else {
                second_end = second_end + 1;
                let marker: i32 = 0;
            }
        } else {
            scanning2 = 0;
            let marker: i32 = 0;
        }
    }
    sb_append_literal(output, "#lea(base=%", 11);
    sb_append_span(output, source, s, base_end - s);
    sb_append_literal(output, ", idx=", 6);
    if item1_end == current {
        sb_append_literal(output, "0, scale=0, offset=0)", 21);
    } else {
        let item_end: usize = trim_end(source, current, item1_end);
        if is_digit(item_first) {
            if second_start >= e {
                // A single numeric displacement is an offset, not an index.
                // The old lowering emitted an empty `%` index for forms such
                // as `buf + 524280`, producing invalid LAIN-IR.
                sb_append_literal(output, "0, scale=0, offset=", 19);
                sb_append_span(output, source, current, item_end - current);
                sb_append_literal(output, ")", 1);
