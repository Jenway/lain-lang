let emit_meta_program_add_procedure_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %count: #bits<64> = #load[#bits<64>](#lea(base=%program, idx=0, scale=0, offset=32))\n#if #lt(%count, 64) {\n#let %procedure_table: addr = #load[addr](#lea(base=%program, idx=0, scale=0, offset=24))\n#let %table_offset: #bits<64> = #mul(%count, 8)\n#store[addr] %procedure, #lea(base=%procedure_table, idx=%table_offset, scale=1, offset=0)\n}\n#if #eq(%count, 0) {\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=0)), #lea(base=%program, idx=0, scale=0, offset=40)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=16)), #lea(base=%program, idx=0, scale=0, offset=48)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=24)), #lea(base=%program, idx=0, scale=0, offset=56)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=32)), #lea(base=%program, idx=0, scale=0, offset=64)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=40)), #lea(base=%program, idx=0, scale=0, offset=72)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%procedure, idx=0, scale=0, offset=48)), #lea(base=%program, idx=0, scale=0, offset=80)\n}\n#store[#bits<64>] #add(%count, 1), #lea(base=%program, idx=0, scale=0, offset=32)\n}\n", 1263);
};

