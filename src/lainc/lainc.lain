// src/lainc/lainc.lain ? M2: self-hosting lainc.
//
// Self-contained: no std imports.  String buffers are managed through
// bootstrap.allocate-pages plus byte load/store primitives, so the emitted
// LAIN-IR for this file is self-contained and can compile itself
// (gen2 == gen3 fixed point).
//
// The compiler in this file lowers a Lain subset into LAIN-IR text:
//   top-level `let NAME = std::func(...) -> T { stmts }` declarations
//   (plus body-less external declarations after @foreign), with statements
//   let / while / if / else / return / break / assignment / calls and
//   expressions numbers, identifiers, calls, +, comparisons, &&, string
//   literals, &x.  The emitted text uses deterministic labels (f0_NAME)
//   and direct #call / #load / #store forms.
//
// Entries:
//   emit() -> addr          : compile the hard-coded add+main source
//   main() -> i32           : write emit()'s product to the artifact
//   compiler_compile() -> i32 : compile host source 0, write the artifact
//   compiler_compile_library() -> i32 : compile all host sources as one
//     library session (imports bind across files; last source is entry)

@foreign(c, link_name = "bootstrap.allocate-pages")
let allocate_pages = std::func(size: usize) -> addr;

// Host capabilities for writing the compiled product to the artifact file.
@foreign(c, link_name = "bootstrap.artifact-begin")
let artifact_begin = std::func() -> unit;
@foreign(c, link_name = "bootstrap.artifact-write-byte")
let artifact_write_byte = std::func(byte: i32) -> unit;
@foreign(c, link_name = "bootstrap.artifact-finish")
let artifact_finish = std::func() -> unit;

// Host capabilities for reading the source program to compile.
@foreign(c, link_name = "bootstrap.source-count")
let source_count = std::func() -> usize;
@foreign(c, link_name = "bootstrap.source-length")
let source_length = std::func(index: usize) -> usize;
@foreign(c, link_name = "bootstrap.source-data")
let source_data = std::func(index: usize) -> addr;
@foreign(c, link_name = "bootstrap.source-path-data")
let source_path_data = std::func(index: usize) -> addr;
@foreign(c, link_name = "bootstrap.source-path-length")
let source_path_length = std::func(index: usize) -> usize;

// ---- self-contained string buffers ----
// Layout: [8-byte length][data bytes...].

let sb_new = std::func() -> addr {
    let buf: addr = allocate_pages(1048576);
    std::store_bits(64, buf, 0);
    let marker: i32 = 0;
    return buf;
};

let sb_len = std::func(buf: addr) -> usize {
    return std::load_bits(64, buf);
};

let sb_byte_at = std::func(buf: addr, index: usize) -> i32 {
    return std::load_bits(8, buf + 8 + index);
};

// Byte load through an address parameter; the frozen frontend lowers
// `addr + usize` to #lea only for parameters, so address arithmetic must
// live inside a function whose base is a parameter.
let sb_byte_at_addr = std::func(source: addr, index: usize) -> i32 {
    return std::load_bits(8, source + index);
};

let sb_append = std::func(buf: addr, byte: i32) -> unit {
    let len: usize = std::load_bits(64, buf);
    std::store_bits(8, buf + 8 + len, byte);
    std::store_bits(64, buf, len + 1);
    let marker: i32 = 0;
};

let sb_append_literal = std::func(
    buf: addr,
    literal: addr,
    length: usize,
) -> unit {
    let index: usize = 0;
    while index < length {
        sb_append(buf, std::load_bits(8, literal + index));
        index = index + 1;
        let marker: i32 = 0;
    }
};

let sb_append_span = std::func(
    buf: addr,
    source: addr,
    start: usize,
    length: usize,
) -> unit {
    let index: usize = 0;
    while index < length {
        sb_append(buf, sb_byte_at(source, start + index));
        index = index + 1;
        let marker: i32 = 0;
    }
};

let sb_span_equals = std::func(
    source: addr,
    start: usize,
    length: usize,
    literal: addr,
    literal_length: usize,
) -> bool {
    if length != literal_length { return false; }
    let index: usize = 0;
    while index < length {
        if sb_byte_at(source, start + index) != std::load_bits(8, literal + index) {
            return false;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
    return true;
};

let sb_from_source_index = std::func(index: usize) -> addr {
    let length: usize = source_length(index);
    let data: addr = source_data(index);
    let buf: addr = sb_new();
    let i2: usize = 0;
    while i2 < length {
        sb_append(buf, sb_byte_at_addr(data, i2));
        i2 = i2 + 1;
        let marker: i32 = 0;
    }
    let marker: i32 = 0;
    return buf;
};

let sb_from_source = std::func() -> addr {
    return sb_from_source_index(0);
};

// Compare [start_a, start_a+length) of buf_a against [start_b, start_b+
// length) of buf_b byte-wise.
let sb_span_eq_buf = std::func(
    buf_a: addr,
    start_a: usize,
    buf_b: addr,
    start_b: usize,
    length: usize,
) -> bool {
    let index: usize = 0;
    let same: i32 = 1;
    while index < length {
        if sb_byte_at(buf_a, start_a + index) != sb_byte_at(buf_b, start_b + index) {
            same = 0;
            let marker: i32 = 0;
            break;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
    if same == 1 { return true; }
    return false;
};

// Copy the basename (last path component, without extension) of host
// source `index` into a fresh buffer.
let source_basename = std::func(index: usize) -> addr {
    let plen: usize = source_path_length(index);
    let pdata: addr = source_path_data(index);
    let buf: addr = sb_new();
    let start: usize = 0;
    let scan: usize = 0;
    while scan < plen {
        let b: i32 = sb_byte_at_addr(pdata, scan);
        if b == 47 {
            start = scan + 1;
            let marker: i32 = 0;
        }
        if b == 92 {
            start = scan + 1;
            let marker: i32 = 0;
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    let end: usize = start;
    while end < plen {
        let b2: i32 = sb_byte_at_addr(pdata, end);
        if b2 == 46 { break; }
        end = end + 1;
        let marker: i32 = 0;
    }
    let i3: usize = start;
    while i3 < end {
        sb_append(buf, sb_byte_at_addr(pdata, i3));
        i3 = i3 + 1;
        let marker: i32 = 0;
    }
    let marker: i32 = 0;
    return buf;
};

// Copy the final `::` component of an `import("...")` literal spanning
// [start, end) of source into a fresh buffer.
let import_last_component = std::func(source: addr, start: usize, end: usize) -> addr {
    let q1: usize = start;
    while q1 < end {
        if sb_byte_at(source, q1) == 34 { break; }
        q1 = q1 + 1;
        let marker: i32 = 0;
    }
    let q2: usize = q1 + 1;
    while q2 < end {
        if sb_byte_at(source, q2) == 34 { break; }
        q2 = q2 + 1;
        let marker: i32 = 0;
    }
    let last: usize = q1 + 1;
    let scan: usize = q1 + 1;
    while scan < q2 {
        if sb_byte_at(source, scan) == 58 {
            if scan + 1 < q2 {
                if sb_byte_at(source, scan + 1) == 58 {
                    last = scan + 2;
                    let marker: i32 = 0;
                }
            }
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    let buf: addr = sb_new();
    let i4: usize = last;
    while i4 < q2 {
        sb_append(buf, sb_byte_at(source, i4));
        i4 = i4 + 1;
        let marker: i32 = 0;
    }
    let marker: i32 = 0;
    return buf;
};

// Find the host source whose basename equals `name`; returns its index,
// or source_count() when absent.
let import_find_source = std::func(name: addr) -> usize {
    let count: usize = source_count();
    let index: usize = 0;
    let found: i32 = 0;
    while found == 0 {
        if index >= count { break; }
        let base: addr = source_basename(index);
        if sb_len(base) == sb_len(name) {
            if sb_span_eq_buf(base, 0, name, 0, sb_len(name)) {
                found = 1;
                let marker: i32 = 0;
                break;
            }
        }
        index = index + 1;
        let marker: i32 = 0;
    }
    return index;
};

// Bind `let NAME: Module = import("...");` at index: the import alias gets
// a kind-2 module row whose payload is the target host source index, or 0
// for std:: imports (external capability stubs, no host source).
// Returns the index after the declaration.
let bind_import = std::func(source: addr, index: usize, end: usize, meta: addr) -> usize {
    let eq: usize = scan_top_op(source, index, end, 61);
    let fs: usize = skip_space(source, eq + 1);
    let semi: usize = scan_semi(source, index, end);
    let ns: usize = skip_space(source, index + 3);
    let ne: usize = parse_ident(source, ns);
    let comp: addr = import_last_component(source, fs, semi);
    let target: usize = import_find_source(comp);
    let q1: usize = fs;
    while q1 < semi {
        if sb_byte_at(source, q1) == 34 { break; }
        q1 = q1 + 1;
        let marker: i32 = 0;
    }
    let stdstub: usize = 0;
    if sb_span_equals(source, q1 + 1, 5, "std::", 5) {
        stdstub = 1;
        let marker: i32 = 0;
    }
    if stdstub == 1 {
        meta_append(meta, 2, ns, ne - ns, 0, 0, 0);
    } else {
        meta_append(meta, 2, ns, ne - ns, target, 1, 0);
    }
    let marker: i32 = 0;
    return semi + 1;
};

// Execute a module factory call `MOD.FACTORY(ARGS)` spanning [fs, fe):
// the factory body is scanned as a compile-time module construction.
// std::func members are emitted as f0_<factory>_<member> and bound under
// a new module row whose payload is the factory-name span (payload_length
// = its length, > 1, marking a factory-produced module value); consteval
// and record members bind normally.  Returns the new module row (0 on
// failure).
let eval_module_factory = std::func(
    source: addr,
    output: addr,
    fs: usize,
    fe: usize,
    alias_ns: usize,
    alias_nl: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let member_start: usize = emit_path_tail(source, fs, fe);
    let member_end: usize = parse_ident(source, member_start);
    let flen: usize = sb_len(meta);
    let flen2: usize = member_end - member_start;
    let frow: usize = meta_lookup(meta, flen, source, member_start, flen2);
    let zero: usize = 0;
    if frow == 0 { return zero; }
    let fkind: usize = meta_value_kind(meta, flen, frow);
    if fkind != 3 { return zero; }
    let body_open: usize = meta_value_payload_start(meta, flen, frow);
    let fbuf: addr = sb_new();
    let i5: usize = member_start;
    while i5 < member_end {
        sb_append(fbuf, sb_byte_at(source, i5));
        i5 = i5 + 1;
        let marker: i32 = 0;
    }
    let mrow7: usize = meta_append(meta, 2, alias_ns, alias_nl, member_start, flen2, 0);
    let body_end: usize = match_brace(source, body_open, sb_len(source));
    let current: usize = body_open + 1;
    while current < body_end {
        let s: usize = skip_space(source, current);
        if s >= body_end { break; }
        if sb_span_equals(source, s, 3, "let", 3) {
            let eq2: usize = scan_top_op(source, s, body_end, 61);
            let fs2: usize = skip_space(source, eq2 + 1);
            if sb_span_equals(source, fs2, 9, "std::func", 9) {
                current = emit_function2(source, output, s, 0, 0, 0, mrow7, fbuf, layout, types, meta, consts);
            } else {
                if sb_span_equals(source, fs2, 14, "std::consteval", 14) {
                    current = emit_consteval(source, s, body_end, meta, mrow7);
                } else {
                    if sb_span_equals(source, fs2, 11, "std::struct", 11) {
                        current = emit_record(source, output, s, body_end, layout, meta);
                    } else {
                        let semi2: usize = scan_semi(source, s, body_end);
                        let crs2: usize = trim_start(source, eq2 + 1, semi2);
                        let cre2: usize = trim_end(source, crs2, semi2);
                        let sentinel2: usize = 0 - 1;
                        let cv2: usize = meta_eval_const(source, crs2, cre2);
                        if cv2 != sentinel2 {
                            let mns2: usize = skip_space(source, s + 3);
                            let mne2: usize = parse_ident(source, mns2);
                            meta_append(consts, 1, mns2, mne2 - mns2, cv2, 0, mrow7);
                            let marker: i32 = 0;
                        } else {
                            let mns2: usize = skip_space(source, s + 3);
                            let mne2: usize = parse_ident(source, mns2);
                            let mark3: usize = scan_let_mark(source, mns2, semi2);
                            let is_type_alias: usize = 0;
                            if sb_byte_at(source, mark3) == 58 {
                                let typ_s2: usize = skip_space(source, mark3 + 1);
                                if sb_span_equals(source, typ_s2, 4, "type", 4) {
                                    is_type_alias = 1;
                                    let eq3: usize = scan_top_op(source, mark3 + 1, semi2, 61);
                                    let te_s: usize = trim_start(source, eq3 + 1, semi2);
                                    let te_e: usize = trim_end(source, te_s, semi2);
                                    meta_append(meta, 4, mns2, mne2 - mns2, te_s, te_e - te_s, mrow7);
                                    let marker: i32 = 0;
                                }
                            }
                            if is_type_alias == 0 {
                                let tb2: i32 = try_bind_module_value(source, s, body_end, output, layout, types, meta, consts);
                                let marker: i32 = 0;
                            }
                            let marker: i32 = 0;
                        }
                        current = semi2 + 1;
                        let marker: i32 = 0;
                    }
                }
            }
        } else {
            current = scan_return_module(source, output, s, body_end, layout, types, meta, consts, mrow7, fbuf);
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    return mrow7;
};

// Scan `return std::module { ... };` at index: emit any inline std::func
// members (eof/trivia/comment/...) as f0_<factory>_<name> and skip the
// rest.  Returns the index after the return statement.
let scan_return_module = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
    mrow7: usize,
    fbuf: addr,
) -> usize {
    let rs3: usize = skip_space(source, index + 6);
    let re3: usize = parse_ident(source, rs3);
    let ra3: usize = skip_space(source, re3);
    if sb_span_equals(source, rs3, re3 - rs3, "std", 3) == false {
        let semi3: usize = scan_semi(source, index, body_end);
        return semi3 + 1;
    }
    if sb_byte_at(source, ra3) != 58 {
        let semi3: usize = scan_semi(source, index, body_end);
        return semi3 + 1;
    }
    let rmod: usize = skip_space(source, ra3 + 2);
    if sb_span_equals(source, rmod, 6, "module", 6) == false {
        let semi3: usize = scan_semi(source, index, body_end);
        return semi3 + 1;
    }
    let rbrace: usize = scan_brace(source, rmod, body_end);
    let rbrace_end: usize = match_brace(source, rbrace, body_end);
    let rcur: usize = rbrace + 1;
    while rcur < rbrace_end {
        let rm: usize = skip_space(source, rcur);
        if rm >= rbrace_end { break; }
        if sb_span_equals(source, rm, 3, "let", 3) {
            let req: usize = scan_top_op(source, rm, rbrace_end, 61);
            let rfs: usize = skip_space(source, req + 1);
            if sb_span_equals(source, rfs, 9, "std::func", 9) {
                rcur = emit_function2(source, output, rm, 0, 0, 0, mrow7, fbuf, layout, types, meta, consts);
            } else {
                let rsemi: usize = scan_semi(source, rm, rbrace_end);
                rcur = rsemi + 1;
                let marker: i32 = 0;
            }
        } else {
            rcur = rm + 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    return rbrace_end + 1;
};

// Detect `let NAME: Module = MOD.FACTORY(ARGS);` at index: evaluate the
// factory and bind NAME to the produced module value.  Returns 1 when
// handled.
let try_bind_module_value = std::func(
    source: addr,
    index: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> i32 {
    let eq: usize = scan_top_op(source, index, end, 61);
    let semi: usize = scan_semi(source, index, end);
    let mns: usize = skip_space(source, index + 3);
    let mne: usize = parse_ident(source, mns);
    let mark: usize = scan_let_mark(source, mns, semi);
    if sb_byte_at(source, mark) != 58 { return 0; }
    let typ_s: usize = skip_space(source, mark + 1);
    if sb_span_equals(source, typ_s, 6, "Module", 6) == false { return 0; }
    let call_s: usize = skip_space(source, eq + 1);
    let call_e: usize = trim_end(source, call_s, semi);
    let fe2: usize = parse_ident(source, call_s);
    let after: usize = skip_space(source, fe2);
    if sb_byte_at(source, after) != 46 { return 0; }
    let clen: usize = sb_len(meta);
    let clen2: usize = fe2 - call_s;
    let cmod: usize = meta_lookup(meta, clen, source, call_s, clen2);
    if cmod == 0 { return 0; }
    let ck: usize = meta_value_kind(meta, clen, cmod);
    if ck != 2 { return 0; }
    let mrow8: usize = eval_module_factory(source, output, call_s, call_e, mns, mne - mns, layout, types, meta, consts);
    if mrow8 == 0 { return 0; }
    return 1;
};

// ---- meta tables ----
// Layout table format: `Name:field#offset#...=size|...`
//   each record is `TypeName:` then `field#byteoffset#` pairs then `=size`
//   and a `|` separator.  Types table format: `name:TypeName|...`.

// Parse a decimal number in [start, end) of buf.
let meta_parse_decimal = std::func(buf: addr, start: usize, end: usize) -> usize {
    let value: usize = 0;
    let index: usize = start;
    while index < end {
        let byte: i32 = sb_byte_at(buf, index);
        if is_digit(byte) {
            let digit: usize = byte - 48;
            value = value * 10;
            value = value + digit;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
    return value;
};

// One decimal digit of v into tmp (via the digits lookup table); returns
// v / 10.  Factored out because the frozen front-end drops statements that
// directly follow an inner while loop inside an outer loop body.
let meta_append_digit = std::func(tmp: addr, digits: addr, v: usize) -> usize {
    let n: usize = 0;
    let r: usize = v;
    let ten: usize = 10;
    let one: usize = 1;
    while r >= ten {
        r = r - ten;
        n = n + one;
        let marker: i32 = 0;
    }
    sb_append_span(tmp, digits, r, 1);
    return n;
};

// Append a decimal number to buf.
let meta_append_decimal = std::func(buf: addr, value: usize) -> unit {
    if value == 0 {
        sb_append(buf, 48);
        let marker: i32 = 0;
    } else {
        let tmp: addr = sb_new();
        let digits: addr = sb_new();
        sb_append_literal(digits, "0123456789", 10);
        let v: usize = value;
        while v > 0 {
            v = meta_append_digit(tmp, digits, v);
            let marker: i32 = 0;
        }
        let index: usize = sb_len(tmp);
        while index > 0 {
            sb_append(buf, sb_byte_at(tmp, index - 1));
            index = index - 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
};

// Find the content start of record `name` in buf (after the colon), or
// buf_len when absent.
//
// NOTE: the frozen front-end drops `let` bindings that directly follow an
// inner while loop inside an outer loop body, so the segment/colon scans are
// factored into separate functions.
let meta_seg_end = std::func(buf: addr, buf_len: usize, index: usize) -> usize {
    let seg_end: usize = index;
    while seg_end < buf_len {
        if sb_byte_at(buf, seg_end) == 124 { break; }
        seg_end = seg_end + 1;
        let marker: i32 = 0;
    }
    return seg_end;
};

let meta_seg_colon = std::func(buf: addr, seg_end: usize, index: usize) -> usize {
    let colon: usize = index;
    while colon < seg_end {
        if sb_byte_at(buf, colon) == 58 { break; }
        colon = colon + 1;
        let marker: i32 = 0;
    }
    return colon;
};

let meta_table_find = std::func(
    buf: addr,
    buf_len: usize,
    source: addr,
    name_start: usize,
    name_end: usize,
) -> usize {
    let index: usize = 0;
    let found: i32 = 0;
    while found == 0 {
        if index >= buf_len { break; }
        let seg_end: usize = meta_seg_end(buf, buf_len, index);
        let colon: usize = meta_seg_colon(buf, seg_end, index);
        let seg_len: usize = name_end - name_start;
        let clen: usize = colon - index;
        if clen == seg_len {
            let same: i32 = 1;
            let i: usize = 0;
            while i < seg_len {
                if sb_byte_at(buf, index + i) != sb_byte_at(source, name_start + i) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 { return colon + 1; }
        }
        index = seg_end + 1;
        let marker: i32 = 0;
    }
    return buf_len;
};

// Find the byte offset of field `fname` in the layout segment [rec, seg_end).
// Returns -1 when absent.
let meta_field_name_end = std::func(buf: addr, seg_end: usize, index: usize) -> usize {
    let name_end: usize = index;
    while name_end < seg_end {
        if sb_byte_at(buf, name_end) == 35 { break; }
        name_end = name_end + 1;
        let marker: i32 = 0;
    }
    return name_end;
};

let meta_field_num_end = std::func(buf: addr, seg_end: usize, name_end: usize) -> usize {
    let num_end: usize = name_end + 1;
    while num_end < seg_end {
        if sb_byte_at(buf, num_end) == 35 { break; }
        num_end = num_end + 1;
        let marker: i32 = 0;
    }
    return num_end;
};

let meta_field_w_end = std::func(buf: addr, seg_end: usize, num_end: usize) -> usize {
    // num_end points at the first `#` after the offset number; this scans
    // to the `#` that closes the width number.  The addr flag follows.
    let w_end: usize = num_end + 1;
    while w_end < seg_end {
        if sb_byte_at(buf, w_end) == 35 { break; }
        w_end = w_end + 1;
        let marker: i32 = 0;
    }
    return w_end;
};

// Index of the next field's name: skip the width number and the addr flag
// that follow `#offset#`.  w_end is the `#` closing the width.
let meta_field_next = std::func(buf: addr, seg_end: usize, w_end: usize) -> usize {
    let a_end: usize = w_end + 1;
    while a_end < seg_end {
        if sb_byte_at(buf, a_end) == 35 { break; }
        a_end = a_end + 1;
        let marker: i32 = 0;
    }
    return a_end + 1;
};

// Read the addr flag (0 = bits field, 1 = address field) of field `fname`
// in the layout segment, or max-1 when absent.
let meta_field_addr = std::func(
    buf: addr,
    rec: usize,
    seg_end: usize,
    source: addr,
    fname_start: usize,
    fname_end: usize,
) -> usize {
    let index: usize = rec;
    let found: i32 = 0;
    while found == 0 {
        if index >= seg_end { break; }
        let name_end: usize = meta_field_name_end(buf, seg_end, index);
        let num_end: usize = meta_field_num_end(buf, seg_end, name_end);
        let flen: usize = fname_end - fname_start;
        let nlen: usize = name_end - index;
        if nlen == flen {
            let same: i32 = 1;
            let i: usize = 0;
            while i < flen {
                if sb_byte_at(buf, index + i) != sb_byte_at(source, fname_start + i) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 {
                // addr flag starts after `#width#`; read up to the next `#`.
                let w_end: usize = meta_field_w_end(buf, seg_end, num_end);
                let flag_end: usize = w_end + 1;
                while flag_end < seg_end {
                    if sb_byte_at(buf, flag_end) == 35 { break; }
                    flag_end = flag_end + 1;
                    let marker: i32 = 0;
                }
                return meta_parse_decimal(buf, w_end + 1, flag_end);
            }
        }
        index = meta_field_next(buf, seg_end, meta_field_w_end(buf, seg_end, num_end));
        let marker: i32 = 0;
    }
    return 0 - 1;
};

let meta_field_offset = std::func(
    buf: addr,
    rec: usize,
    seg_end: usize,
    source: addr,
    fname_start: usize,
    fname_end: usize,
) -> usize {
    let index: usize = rec;
    let found: i32 = 0;
    while found == 0 {
        if index >= seg_end { break; }
        let name_end: usize = meta_field_name_end(buf, seg_end, index);
        let num_end: usize = meta_field_num_end(buf, seg_end, name_end);
        let flen: usize = fname_end - fname_start;
        let nlen: usize = name_end - index;
        if nlen == flen {
            let same: i32 = 1;
            let i: usize = 0;
            while i < flen {
                if sb_byte_at(buf, index + i) != sb_byte_at(source, fname_start + i) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 {
                return meta_parse_decimal(buf, name_end + 1, num_end);
            }
        }
        index = meta_field_next(buf, seg_end, meta_field_w_end(buf, seg_end, num_end));
        let marker: i32 = 0;
    }
    return 0 - 1;
};

// Find the byte width of field `fname` in the layout segment, or max-1.
let meta_field_width = std::func(
    buf: addr,
    rec: usize,
    seg_end: usize,
    source: addr,
    fname_start: usize,
    fname_end: usize,
) -> usize {
    let index: usize = rec;
    let found: i32 = 0;
    while found == 0 {
        if index >= seg_end { break; }
        let name_end: usize = meta_field_name_end(buf, seg_end, index);
        let num_end: usize = meta_field_num_end(buf, seg_end, name_end);
        let flen: usize = fname_end - fname_start;
        let nlen: usize = name_end - index;
        if nlen == flen {
            let same: i32 = 1;
            let i: usize = 0;
            while i < flen {
                if sb_byte_at(buf, index + i) != sb_byte_at(source, fname_start + i) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 {
                return meta_parse_decimal(
                    buf, num_end + 1, meta_field_w_end(buf, seg_end, num_end)
                );
            }
        }
        index = meta_field_next(buf, seg_end, meta_field_w_end(buf, seg_end, num_end));
        let marker: i32 = 0;
    }
    return 0 - 1;
};

// Find the total size in the layout segment (after `=`), or max-1.
let meta_record_size = std::func(
    buf: addr,
    rec: usize,
    seg_end: usize,
) -> usize {
    let eq: usize = rec;
    while eq < seg_end {
        if sb_byte_at(buf, eq) == 61 { break; }
        eq = eq + 1;
        let marker: i32 = 0;
    }
    if eq >= seg_end { return 0 - 1; }
    return meta_parse_decimal(buf, eq + 1, seg_end);
};

// Scan a field type name in [type_start, brace_end) up to `,` or `}`.
// Factored out because the frozen front-end drops `let` bindings that
// directly follow an inner while loop inside an outer loop body.
let meta_scan_type_end = std::func(
    source: addr,
    brace_end: usize,
    type_start: usize,
) -> usize {
    let type_end: usize = type_start;
    let scanning: i32 = 1;
    while scanning == 1 {
        if type_end >= brace_end {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, type_end);
            if b == 44 {
                scanning = 0;
                let marker: i32 = 0;
            } else {
                if b == 125 {
                    scanning = 0;
                    let marker: i32 = 0;
                } else {
                    type_end = type_end + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return type_end;
};

// Emit the #bits width text for a field byte width (1/4/8).
let meta_emit_bits = std::func(output: addr, w: usize) -> unit {
    if w == 1 {
        sb_append_literal(output, "1", 1);
    } else {
        if w == 4 {
            sb_append_literal(output, "32", 2);
        } else {
            sb_append_literal(output, "64", 2);
        }
    }
};

// ---- meta objects ----
// Compile-time meta objects are rows in one text table.  References are row
// numbers (usize); this sidesteps pointer indirection, which the frozen
// front-end cannot lower (it refuses #store targets that are not #addr,
// usize->addr assignment, and load_bits results as addr returns).
//
// Row format (6 fields, 6 '|' separators):
//   kind|name_start|name_length|payload_start|payload_length|mod_row|
// kind: 0 = nil, 1 = scalar, 2 = module, 3 = function, 4 = type.
// mod_row: 1-based row of the owning module (0 = top-level).

let meta_pipe_count = std::func(buf: addr, len: usize) -> usize {
    let index: usize = 0;
    let count: usize = 0;
    while index < len {
        if sb_byte_at(buf, index) == 124 {
            count = count + 1;
            let marker: i32 = 0;
        }
        index = index + 1;
        let marker: i32 = 0;
    }
    return count;
};

let meta_rows = std::func(buf: addr, len: usize) -> usize {
    let pipes: usize = meta_pipe_count(buf, len);
    let rows: usize = 0;
    let rem: usize = pipes;
    while rem >= 6 {
        rem = rem - 6;
        rows = rows + 1;
        let marker: i32 = 0;
    }
    return rows;
};

// Parse the segment after the (seg+1)-th '|' in [start, len).
let meta_field = std::func(buf: addr, len: usize, seg: usize) -> usize {
    let index: usize = 0;
    let count: usize = 0;
    let seg_start: usize = 0;
    let found: i32 = 0;
    while found == 0 {
        if index >= len {
            found = 1;
            let marker: i32 = 0;
        } else {
            if sb_byte_at(buf, index) == 124 {
                count = count + 1;
                if count == seg {
                    seg_start = index + 1;
                    let marker: i32 = 0;
                }
                if count > seg {
                    found = 1;
                    let marker: i32 = 0;
                } else {
                    index = index + 1;
                    let marker: i32 = 0;
                }
            } else {
                index = index + 1;
                let marker: i32 = 0;
            }
        }
    }
    return meta_parse_decimal(buf, seg_start, index);
};

// Field of the row-th row (1-based; row 0 returns 0).
let meta_row_field = std::func(buf: addr, len: usize, row: usize, field: usize) -> usize {
    let six: usize = 6;
    let prior: usize = row - 1;
    let seg: usize = prior * six;
    if row == 0 { return 0; }
    let seg2: usize = seg + field;
    return meta_field(buf, len, seg2);
};

// Append a row; returns its 1-based row number.
let meta_append = std::func(
    table: addr,
    kind: usize,
    ns: usize,
    nl: usize,
    ps: usize,
    pl: usize,
    mrow: usize,
) -> usize {
    let rows: usize = meta_rows(table, sb_len(table));
    meta_append_decimal(table, kind);
    sb_append_literal(table, "|", 1);
    meta_append_decimal(table, ns);
    sb_append_literal(table, "|", 1);
    meta_append_decimal(table, nl);
    sb_append_literal(table, "|", 1);
    meta_append_decimal(table, ps);
    sb_append_literal(table, "|", 1);
    meta_append_decimal(table, pl);
    sb_append_literal(table, "|", 1);
    meta_append_decimal(table, mrow);
    sb_append_literal(table, "|", 1);
    return rows + 1;
};

// Look up a name span [ns, ns+nl) among kind!=0 rows; returns row or 0.
let meta_lookup = std::func(
    table: addr,
    len: usize,
    source: addr,
    ns: usize,
    nl: usize,
) -> usize {
    let rows: usize = meta_rows(table, len);
    let row: usize = 1;
    let found: i32 = 0;
    while found == 0 {
        if row > rows { break; }
        let rn: usize = meta_row_field(table, len, row, 1);
        let rl: usize = meta_row_field(table, len, row, 2);
        if rl == nl {
            let same: i32 = 1;
            let i: usize = 0;
            while i < nl {
                let rb: usize = rn + i;
                let nb: usize = ns + i;
                if sb_byte_at(source, rb) != sb_byte_at(source, nb) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 {
                let k: usize = meta_row_field(table, len, row, 0);
                if k != 0 { return row; }
            }
        }
        row = row + 1;
        let marker: i32 = 0;
    }
    return 0;
};

// Look up a name span among rows of a specific kind.  Unlike meta_lookup
// (which returns the first non-zero row), this finds a row whose kind
// matches, so a module-value binding (kind 2) can shadow an earlier
// factory-member row (kind 3) with the same name.
let meta_lookup_kind = std::func(
    table: addr,
    len: usize,
    source: addr,
    ns: usize,
    nl: usize,
    want: usize,
) -> usize {
    let rows: usize = meta_rows(table, len);
    let row: usize = 1;
    let found: i32 = 0;
    while found == 0 {
        if row > rows { break; }
        let rn: usize = meta_row_field(table, len, row, 1);
        let rl: usize = meta_row_field(table, len, row, 2);
        if rl == nl {
            let same: i32 = 1;
            let i: usize = 0;
            while i < nl {
                let rb: usize = rn + i;
                let nb: usize = ns + i;
                if sb_byte_at(source, rb) != sb_byte_at(source, nb) {
                    same = 0;
                    let marker: i32 = 0;
                    break;
                }
                i = i + 1;
                let marker: i32 = 0;
            }
            if same == 1 {
                let k: usize = meta_row_field(table, len, row, 0);
                if k == want { return row; }
            }
        }
        row = row + 1;
        let marker: i32 = 0;
    }
    return 0;
};

// Look up a name span among rows owned by module row `mrow` (field 5).
// Returns the row or 0.  Used for module member resolution so two modules
// can share member names.
let meta_lookup_qualified = std::func(
    table: addr,
    len: usize,
    source: addr,
    ns: usize,
    nl: usize,
    mrow: usize,
) -> usize {
    let rows: usize = meta_rows(table, len);
    let row: usize = 1;
    let found: i32 = 0;
    while found == 0 {
        if row > rows { break; }
        let modr: usize = meta_row_field(table, len, row, 5);
        if modr == mrow {
            let rn: usize = meta_row_field(table, len, row, 1);
            let rl: usize = meta_row_field(table, len, row, 2);
            if rl == nl {
                let same: i32 = 1;
                let i: usize = 0;
                while i < nl {
                    let rb: usize = rn + i;
                    let nb: usize = ns + i;
                    if sb_byte_at(source, rb) != sb_byte_at(source, nb) {
                        same = 0;
                        let marker: i32 = 0;
                        break;
                    }
                    i = i + 1;
                    let marker: i32 = 0;
                }
                if same == 1 {
                    let k: usize = meta_row_field(table, len, row, 0);
                    if k != 0 { return row; }
                }
            }
        }
        row = row + 1;
        let marker: i32 = 0;
    }
    return 0;
};

let meta_value_kind = std::func(table: addr, len: usize, row: usize) -> usize {
    return meta_row_field(table, len, row, 0);
};
let meta_value_name_start = std::func(table: addr, len: usize, row: usize) -> usize {
    return meta_row_field(table, len, row, 1);
};
let meta_value_name_length = std::func(table: addr, len: usize, row: usize) -> usize {
    return meta_row_field(table, len, row, 2);
};
let meta_value_payload_start = std::func(table: addr, len: usize, row: usize) -> usize {
    return meta_row_field(table, len, row, 3);
};
let meta_value_payload_length = std::func(table: addr, len: usize, row: usize) -> usize {
    return meta_row_field(table, len, row, 4);
};

// True when [start, end) of source is a plain decimal number.
let meta_is_number = std::func(source: addr, start: usize, end: usize) -> bool {
    let index: usize = start;
    let all: i32 = 1;
    if start >= end { return false; }
    while index < end {
        let b: i32 = sb_byte_at(source, index);
        if is_digit(b) {
            index = index + 1;
            let marker: i32 = 0;
        } else {
            all = 0;
            let marker: i32 = 0;
            break;
        }
    }
    if all == 1 { return true; }
    return false;
};

// Fold a binary operation on two decimal literals (+/-/*); returns true
// when the result was written instead of the #op form.
let meta_fold_binary = std::func(
    source: addr,
    output: addr,
    ls: usize,
    le: usize,
    rs: usize,
    re: usize,
    op: i32,
) -> bool {
    if meta_is_number(source, ls, le) {
        if meta_is_number(source, rs, re) {
            let lv: usize = meta_parse_decimal(source, ls, le);
            let rv: usize = meta_parse_decimal(source, rs, re);
            if op == 43 {
                let sum: usize = lv + rv;
                meta_append_decimal(output, sum);
                return true;
            }
            if op == 42 {
                let prod: usize = lv * rv;
                meta_append_decimal(output, prod);
                return true;
            }
            if lv >= rv {
                let diff: usize = lv - rv;
                meta_append_decimal(output, diff);
                return true;
            }
        }
    }
    return false;
};

// Evaluate a constant expression [start, end): a decimal literal or
// literal op literal (+/-/*).  Returns max-1 when not evaluable.
let meta_eval_const = std::func(source: addr, start: usize, end: usize) -> usize {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    if meta_is_number(source, s, e) {
        return meta_parse_decimal(source, s, e);
    }
    let plus: usize = scan_top_op(source, s, e, 43);
    if plus < e {
        let ls: usize = trim_start(source, s, plus);
        let le: usize = trim_end(source, ls, plus);
        let rs: usize = skip_space(source, plus + 1);
        let re: usize = trim_end(source, rs, e);
        if meta_is_number(source, ls, le) {
            if meta_is_number(source, rs, re) {
                let lv: usize = meta_parse_decimal(source, ls, le);
                let rv: usize = meta_parse_decimal(source, rs, re);
                let sum: usize = lv + rv;
                return sum;
            }
        }
    }
    let minus: usize = scan_top_op(source, s, e, 45);
    if minus < e {
        let ls: usize = trim_start(source, s, minus);
        let le: usize = trim_end(source, ls, minus);
        let rs: usize = skip_space(source, minus + 1);
        let re: usize = trim_end(source, rs, e);
        if meta_is_number(source, ls, le) {
            if meta_is_number(source, rs, re) {
                let lv: usize = meta_parse_decimal(source, ls, le);
                let rv: usize = meta_parse_decimal(source, rs, re);
                if lv >= rv {
                    let diff: usize = lv - rv;
                    return diff;
                }
            }
        }
    }
    let mul: usize = scan_top_op(source, s, e, 42);
    if mul < e {
        let ls: usize = trim_start(source, s, mul);
        let le: usize = trim_end(source, ls, mul);
        let rs: usize = skip_space(source, mul + 1);
        let re: usize = trim_end(source, rs, e);
        if meta_is_number(source, ls, le) {
            if meta_is_number(source, rs, re) {
                let lv: usize = meta_parse_decimal(source, ls, le);
                let rv: usize = meta_parse_decimal(source, rs, re);
                let prod: usize = lv * rv;
                return prod;
            }
        }
    }
    return 0 - 1;
};

// Evaluate one compile-time operand: decimal literal or parameter ref.
let meta_eval_operand = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
) -> usize {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    if meta_is_number(source, s, e) {
        return meta_parse_decimal(source, s, e);
    }
    let ne: usize = parse_ident(source, s);
    let after: usize = skip_space(source, ne);
    if after >= e {
        let plen: usize = sb_len(params);
        let prow: usize = meta_lookup(params, plen, source, s, ne - s);
        if prow != 0 {
            return meta_row_field(params, plen, prow, 3);
        }
    }
    return 0 - 1;
};

// Evaluate a compile-time expression of the form `operand op operand`
// (single level, no recursion); returns max-1 when not evaluable.
let meta_eval_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let plus: usize = scan_top_op(source, s, e, 43);
    if plus < e {
        let lv: usize = meta_eval_operand(source, s, plus, params);
        let rv: usize = meta_eval_operand(source, plus + 1, e, params);
        if lv != sentinel {
            if rv != sentinel {
                let sum: usize = lv + rv;
                return sum;
            }
        }
    }
    let minus: usize = scan_top_op(source, s, e, 45);
    if minus < e {
        let lv: usize = meta_eval_operand(source, s, minus, params);
        let rv: usize = meta_eval_operand(source, minus + 1, e, params);
        if lv != sentinel {
            if rv != sentinel {
                if lv >= rv {
                    let diff: usize = lv - rv;
                    return diff;
                }
            }
        }
    }
    let mul: usize = scan_top_op(source, s, e, 42);
    if mul < e {
        let lv: usize = meta_eval_operand(source, s, mul, params);
        let rv: usize = meta_eval_operand(source, mul + 1, e, params);
        if lv != sentinel {
            if rv != sentinel {
                let prod: usize = lv * rv;
                return prod;
            }
        }
    }
    let operand: usize = meta_eval_operand(source, s, e, params);
    if operand != sentinel { return operand; }
    return meta_eval_nested(source, s, e, params);
};

// ---- nested compile-time arithmetic (iterative shunting-yard) ----
// The frozen bootstrap frontend forbids recursive Lain functions and
// compound expressions, so nested consteval arithmetic is evaluated with
// two explicit stacks (values and operators) and single-operation steps.

// Precedence of a compile-time operator byte: * = 2, + and - = 1.
let meta_op_prec = std::func(op: i32) -> usize {
    if op == 42 { return 2; }
    return 1;
};

// Push a value onto the value stack (format `;v1;v2`, values only).
let meta_stack_push = std::func(vals: addr, v: usize) -> unit {
    sb_append(vals, 59);
    meta_append_decimal(vals, v);
};

// Pop the top value from the value stack; returns max-1 when empty.
let meta_stack_pop = std::func(vals: addr) -> usize {
    let vlen: usize = sb_len(vals);
    if vlen == 0 { return 0 - 1; }
    let sep: usize = vlen - 1;
    while sep > 0 {
        if sb_byte_at(vals, sep) == 59 { break; }
        sep = sep - 1;
        let marker: i32 = 0;
    }
    let v: usize = meta_parse_decimal(vals, sep + 1, vlen);
    std::store_bits(64, vals, sep);
    return v;
};

// Fold operator-stack entries whose precedence is >= the incoming one.
// Returns 1 on success, 0 when a fold failed (e.g. subtraction underflow).
let meta_fold_ops = std::func(
    vals: addr,
    ops: addr,
    incoming: i32,
    sentinel: usize,
) -> i32 {
    let done: i32 = 0;
    while done == 0 {
        let olen: usize = sb_len(ops);
        if olen == 0 {
            done = 1;
            let marker: i32 = 0;
        } else {
            let top: i32 = sb_byte_at(ops, olen - 1);
            if meta_op_prec(top) < meta_op_prec(incoming) {
                done = 1;
                let marker: i32 = 0;
            } else {
                let rv: usize = meta_stack_pop(vals);
                let lv: usize = meta_stack_pop(vals);
                if rv == sentinel { return 0; }
                if lv == sentinel { return 0; }
                let res: usize = 0 - 1;
                if top == 43 { res = lv + rv; }
                if top == 45 {
                    if lv >= rv {
                        res = lv - rv;
                        let marker: i32 = 0;
                    }
                }
                if top == 42 { res = lv * rv; }
                if res == sentinel { return 0; }
                meta_stack_push(vals, res);
                std::store_bits(64, ops, olen - 1);
                let marker: i32 = 0;
            }
        }
    }
    return 1;
};

// Fold every remaining operator.  Returns 1 on success, 0 on failure.
let meta_fold_all = std::func(
    vals: addr,
    ops: addr,
    sentinel: usize,
) -> i32 {
    let done: i32 = 0;
    while done == 0 {
        let olen: usize = sb_len(ops);
        if olen == 0 {
            done = 1;
            let marker: i32 = 0;
        } else {
            let top: i32 = sb_byte_at(ops, olen - 1);
            let rv: usize = meta_stack_pop(vals);
            let lv: usize = meta_stack_pop(vals);
            if rv == sentinel { return 0; }
            if lv == sentinel { return 0; }
            let res: usize = 0 - 1;
            if top == 43 { res = lv + rv; }
            if top == 45 {
                if lv >= rv {
                    res = lv - rv;
                    let marker: i32 = 0;
                }
            }
            if top == 42 { res = lv * rv; }
            if res == sentinel { return 0; }
            meta_stack_push(vals, res);
            std::store_bits(64, ops, olen - 1);
            let marker: i32 = 0;
        }
    }
    return 1;
};

// End of one operand token: a decimal digit run or an identifier.
let meta_operand_end = std::func(source: addr, s: usize, e: usize) -> usize {
    if is_digit(sb_byte_at(source, s)) {
        let cur: usize = s;
        while cur < e {
            if is_digit(sb_byte_at(source, cur)) {
                cur = cur + 1;
                let marker: i32 = 0;
            } else {
                break;
            }
        }
        return cur;
    }
    return parse_ident(source, s);
};

// Evaluate a nested compile-time arithmetic expression [start, end):
// decimal literals and parameter references joined by + - * with the
// usual precedence, left-associative.  Returns max-1 when not evaluable.
// Parentheses are not supported yet (returns max-1, safe fallback).
let meta_eval_nested = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let vals: addr = sb_new();
    let ops: addr = sb_new();
    let cur: usize = trim_start(source, start, end);
    let limit: usize = trim_end(source, cur, end);
    let scanning: i32 = 1;
    while scanning == 1 {
        if cur >= limit {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, cur);
            if b == 43 {
                let ok: i32 = meta_fold_ops(vals, ops, 43, sentinel);
                if ok == 0 { return sentinel; }
                sb_append(ops, 43);
                cur = skip_space(source, cur + 1);
                let marker: i32 = 0;
            } else {
                if b == 45 {
                    let ok: i32 = meta_fold_ops(vals, ops, 45, sentinel);
                    if ok == 0 { return sentinel; }
                    sb_append(ops, 45);
                    cur = skip_space(source, cur + 1);
                    let marker: i32 = 0;
                } else {
                    if b == 42 {
                        let ok: i32 = meta_fold_ops(vals, ops, 42, sentinel);
                        if ok == 0 { return sentinel; }
                        sb_append(ops, 42);
                        cur = skip_space(source, cur + 1);
                        let marker: i32 = 0;
                    } else {
                        let oe: usize = meta_operand_end(source, cur, limit);
                        let v: usize = meta_eval_operand(source, cur, oe, params);
                        if v == sentinel { return sentinel; }
                        meta_stack_push(vals, v);
                        cur = skip_space(source, oe);
                        let marker: i32 = 0;
                    }
                }
            }
        }
    }
    let ok2: i32 = meta_fold_all(vals, ops, sentinel);
    if ok2 == 0 { return sentinel; }
    let result: usize = meta_stack_pop(vals);
    return result;
};

// Find the closing paren for the call group whose opening `(` is at [open,
// end); returns the position of the matching `)`, or end when unbalanced.
let meta_scan_call_end = std::func(source: addr, open: usize, end: usize) -> usize {
    let aend: usize = open + 1;
    let adepth: usize = 1;
    let adone: usize = 0;
    while adone == 0 {
        if aend >= end { return end; }
        if sb_byte_at(source, aend) == 41 {
            adepth = adepth - 1;
            if adepth == 0 {
                adone = 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        } else {
            if sb_byte_at(source, aend) == 40 {
                adepth = adepth + 1;
                aend = aend + 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        }
    }
    return aend;
};

// Evaluate one compile-time operand, additionally recognizing a call
// `name(args)` or `mod.name(args)` to a consteval (kind 6) function row.
// end is the expression end (not the operand end): a call's `)` lies after
// the callee identifier.  The callee is evaluated with calls=0 (pure body),
// so calls may not nest inside a callee; this avoids recursive Lain
// functions (the frozen bootstrap lowers value-returning recursion
// incorrectly).  Returns the call result or max-1 when not evaluable.
let meta_eval_operand_call = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let oe: usize = meta_operand_end(source, s, e);
    let after: usize = skip_space(source, oe);
    if after >= e {
        return meta_eval_operand(source, s, oe, params);
    }
    if sb_byte_at(source, after) != 40 {
        if sb_byte_at(source, after) != 46 {
            return meta_eval_operand(source, s, oe, params);
        }
    }
    let cmod_row: usize = 0;
    let cmem_start: usize = s;
    let cmem_end: usize = oe;
    let csep2: usize = after;
    if sb_byte_at(source, csep2) == 46 {
        let cnext: usize = skip_space(source, csep2 + 1);
        if is_ident_start(sb_byte_at(source, cnext)) {
            let mlen3: usize = sb_len(meta);
            let mrow4: usize = meta_lookup(meta, mlen3, source, s, oe - s);
            if mrow4 != 0 {
                let mk4: usize = meta_value_kind(meta, mlen3, mrow4);
                if mk4 == 2 {
                    cmod_row = mrow4;
                    cmem_start = cnext;
                    cmem_end = parse_ident(source, cnext);
                    let marker: i32 = 0;
                }
            }
        }
    }
    if sb_byte_at(source, cmem_end) != 40 { return sentinel; }
    let crow2: usize = 0;
    if cmod_row != 0 {
        crow2 = meta_lookup_qualified(meta, mlen, source, cmem_start, cmem_end - cmem_start, cmod_row);
    } else {
        crow2 = meta_lookup(meta, mlen, source, cmem_start, cmem_end - cmem_start);
    }
    if crow2 == 0 { return sentinel; }
    let ck: usize = meta_value_kind(meta, mlen, crow2);
    if ck != 6 { return sentinel; }
    let aend: usize = meta_scan_call_end(source, cmem_end, e);
    if aend >= e { return sentinel; }
    return meta_call_consteval(source, meta, mlen, crow2, cmem_end + 1, aend, consts, 0, params);
};

// End of a full operand at [start, limit): the identifier itself, or the
// complete `mod.name(...)` call group (path segments joined by `.` plus the
// balanced parentheses).  Returns the index after the operand.
let meta_operand_call_end = std::func(source: addr, start: usize, limit: usize) -> usize {
    let cur: usize = meta_operand_end(source, start, limit);
    let scanning: i32 = 1;
    while scanning == 1 {
        if cur >= limit {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, cur);
            if b == 46 {
                let nxt: usize = skip_space(source, cur + 1);
                cur = parse_ident(source, nxt);
                let marker: i32 = 0;
            } else {
                if b == 40 {
                    let close: usize = meta_scan_call_end(source, cur, limit);
                    cur = close + 1;
                    let marker: i32 = 0;
                } else {
                    scanning = 0;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return cur;
};

// Nested expression evaluator with call recognition: same as
// meta_eval_nested, but operands may be consteval calls.  The callee body
// is evaluated purely (calls=0), so calls inside a callee are not folded.
let meta_eval_nested_call = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let vals: addr = sb_new();
    let ops: addr = sb_new();
    let cur: usize = trim_start(source, start, end);
    let limit: usize = trim_end(source, cur, end);
    let scanning: i32 = 1;
    while scanning == 1 {
        if cur >= limit {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, cur);
            if b == 43 {
                let ok: i32 = meta_fold_ops(vals, ops, 43, sentinel);
                if ok == 0 { return sentinel; }
                sb_append(ops, 43);
                cur = skip_space(source, cur + 1);
                let marker: i32 = 0;
            } else {
                if b == 45 {
                    let ok: i32 = meta_fold_ops(vals, ops, 45, sentinel);
                    if ok == 0 { return sentinel; }
                    sb_append(ops, 45);
                    cur = skip_space(source, cur + 1);
                    let marker: i32 = 0;
                } else {
                    if b == 42 {
                        let ok: i32 = meta_fold_ops(vals, ops, 42, sentinel);
                        if ok == 0 { return sentinel; }
                        sb_append(ops, 42);
                        cur = skip_space(source, cur + 1);
                        let marker: i32 = 0;
                    } else {
                        let v: usize = meta_eval_operand_call(source, cur, limit, params, meta, mlen, consts);
                        if v == sentinel { return sentinel; }
                        meta_stack_push(vals, v);
                        cur = skip_space(source, meta_operand_call_end(source, cur, limit));
                    }
                }
            }
        }
    }
    let ok2: i32 = meta_fold_all(vals, ops, sentinel);
    if ok2 == 0 { return sentinel; }
    let result: usize = meta_stack_pop(vals);
    return result;
};

// Evaluate a single compile-time comparison [start, end):
// `operand cmp operand` with cmp in == != < <= > >=.
// Returns 1 (true), 0 (false), or max-1 when not evaluable.
let meta_eval_cond_single = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let op: usize = scan_cmp(source, s, e);
    if op >= e { return sentinel; }
    let lv: usize = meta_eval_operand(source, s, op, params);
    let b1: i32 = sb_byte_at(source, op);
    let b2: i32 = 0;
    let rstart: usize = op + 1;
    if op + 1 < e {
        b2 = sb_byte_at(source, op + 1);
        let marker: i32 = 0;
    }
    if b2 == 61 { rstart = op + 2; }
    let rv: usize = meta_eval_operand(source, rstart, e, params);
    if lv == sentinel { return sentinel; }
    if rv == sentinel { return sentinel; }
    let eq2: i32 = 0;
    if b2 == 61 { eq2 = 1; }
    let result: usize = 0;
    if b1 == 61 {
        if eq2 == 1 {
            if lv == rv { result = 1; }
        }
    } else {
        if b1 == 33 {
            if eq2 == 1 {
                if lv != rv { result = 1; }
            }
        } else {
            if b1 == 60 {
                if eq2 == 1 {
                    if lv <= rv { result = 1; }
                } else {
                    if lv < rv { result = 1; }
                }
            } else {
                if b1 == 62 {
                    if eq2 == 1 {
                        if lv >= rv { result = 1; }
                    } else {
                        if lv > rv { result = 1; }
                    }
                }
            }
        }
    }
    return result;
};

// Same as meta_eval_cond_single, but the two operands may be consteval
// calls (`name(args)` or `mod.name(args)`): each operand is evaluated
// through meta_eval_operand_call, whose callee is evaluated purely
// (calls=0), so calls inside a condition cannot recurse.  Returns 1/0, or
// max-1 when not evaluable.
let meta_eval_cond_single_call = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let op: usize = scan_cmp(source, s, e);
    if op >= e { return sentinel; }
    let lv: usize = meta_eval_operand_call(source, s, op, params, meta, mlen, consts);
    let b1: i32 = sb_byte_at(source, op);
    let b2: i32 = 0;
    let rstart: usize = op + 1;
    if op + 1 < e {
        b2 = sb_byte_at(source, op + 1);
        let marker: i32 = 0;
    }
    if b2 == 61 { rstart = op + 2; }
    let rv: usize = meta_eval_operand_call(source, rstart, e, params, meta, mlen, consts);
    if lv == sentinel { return sentinel; }
    if rv == sentinel { return sentinel; }
    let eq2: i32 = 0;
    if b2 == 61 { eq2 = 1; }
    let result: usize = 0;
    if b1 == 61 {
        if eq2 == 1 {
            if lv == rv { result = 1; }
        }
    } else {
        if b1 == 33 {
            if eq2 == 1 {
                if lv != rv { result = 1; }
            }
        } else {
            if b1 == 60 {
                if eq2 == 1 {
                    if lv <= rv { result = 1; }
                } else {
                    if lv < rv { result = 1; }
                }
            } else {
                if b1 == 62 {
                    if eq2 == 1 {
                        if lv >= rv { result = 1; }
                    } else {
                        if lv > rv { result = 1; }
                    }
                }
            }
        }
    }
    return result;
};

// Precedence of a compile-time boolean operator: && = 2, || = 1.
let meta_bool_prec = std::func(op: i32) -> usize {
    if op == 38 { return 2; }
    return 1;
};

// Fold boolean operator-stack entries whose precedence is >= the incoming
// one.  Returns 1 on success, 0 when a fold failed.
let meta_fold_bool_ops = std::func(
    vals: addr,
    ops: addr,
    incoming: i32,
    sentinel: usize,
) -> i32 {
    let done: i32 = 0;
    while done == 0 {
        let olen: usize = sb_len(ops);
        if olen == 0 {
            done = 1;
            let marker: i32 = 0;
        } else {
            let top: i32 = sb_byte_at(ops, olen - 1);
            if meta_bool_prec(top) < meta_bool_prec(incoming) {
                done = 1;
                let marker: i32 = 0;
            } else {
                let rv: usize = meta_stack_pop(vals);
                let lv: usize = meta_stack_pop(vals);
                if rv == sentinel { return 0; }
                if lv == sentinel { return 0; }
                let lz: usize = 0;
                let rz: usize = 0;
                if lv != 0 { lz = 1; }
                if rv != 0 { rz = 1; }
                let res: usize = 0;
                if top == 38 {
                    if lz == 1 {
                        if rz == 1 { res = 1; }
                    }
                } else {
                    if lz == 1 { res = 1; }
                    if rz == 1 { res = 1; }
                }
                meta_stack_push(vals, res);
                std::store_bits(64, ops, olen - 1);
                let marker: i32 = 0;
            }
        }
    }
    return 1;
};

// Evaluate a compile-time condition [start, end) with && and ||:
// comparisons joined by && (precedence 2) and || (precedence 1),
// left-associative, iteratively (two explicit stacks; no recursion).
// Comparison operands may be consteval calls (meta_eval_cond_single_call),
// whose callees are evaluated purely.  Returns 1 (true), 0 (false), or
// max-1 when not evaluable.
let meta_eval_bool = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
) -> usize {
    let sentinel: usize = 0 - 1;
    let vals: addr = sb_new();
    let ops: addr = sb_new();
    let cur: usize = trim_start(source, start, end);
    let limit: usize = trim_end(source, cur, end);
    let scanning: i32 = 1;
    while scanning == 1 {
        if cur >= limit {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            let and: usize = scan_and(source, cur, limit);
            let or: usize = scan_or(source, cur, limit);
            let stop: usize = limit;
            if and < stop { stop = and; }
            if or < stop { stop = or; }
            let cv: usize = meta_eval_cond_single_call(source, cur, stop, params, meta, mlen, consts);
            if cv == sentinel { return sentinel; }
            meta_stack_push(vals, cv);
            if stop >= limit {
                scanning = 0;
                let marker: i32 = 0;
            } else {
                let b: i32 = sb_byte_at(source, stop);
                let ok: i32 = meta_fold_bool_ops(vals, ops, b, sentinel);
                if ok == 0 { return sentinel; }
                sb_append(ops, b);
                cur = skip_space(source, stop + 2);
                let marker: i32 = 0;
            }
        }
    }
    let ok2: i32 = meta_fold_bool_ops(vals, ops, 124, sentinel);
    if ok2 == 0 { return sentinel; }
    let result: usize = meta_stack_pop(vals);
    return result;
};

// Copy every kind-1 row of the consts table into the params table, so
// compile-time argument expressions can reference already bound top-level
// constants.  Single loop, no nesting.
let meta_consteval_copy_consts = std::func(consts: addr, params: addr) -> unit {
    let clen: usize = sb_len(consts);
    let crows: usize = meta_rows(consts, clen);
    let crow: usize = 1;
    let done: i32 = 0;
    while done == 0 {
        if crow > crows {
            done = 1;
            let marker: i32 = 0;
        } else {
            let ck: usize = meta_row_field(consts, clen, crow, 0);
            if ck == 1 {
                let cns: usize = meta_row_field(consts, clen, crow, 1);
                let cnl: usize = meta_row_field(consts, clen, crow, 2);
                let cps: usize = meta_row_field(consts, clen, crow, 3);
                meta_append(params, 1, cns, cnl, cps, 0, 0);
                let marker: i32 = 0;
            }
            crow = crow + 1;
            let marker: i32 = 0;
        }
    }
};

// Is the name span [ns, ns+nl) one of this function's parameter names?
// Parameters live in [ps+1, params_end) as `name: type` comma-separated.
let meta_span_is_param = std::func(
    source: addr,
    ns: usize,
    nl: usize,
    ps: usize,
    params_end: usize,
) -> i32 {
    let cur: usize = ps + 1;
    let found: i32 = 0;
    let done: i32 = 0;
    while done == 0 {
        if cur >= params_end {
            done = 1;
            let marker: i32 = 0;
        } else {
            let pn: usize = parse_ident(source, cur);
            let pl: usize = pn - cur;
            if pl == nl {
                let same: i32 = 1;
                let i: usize = 0;
                while i < nl {
                    if sb_byte_at(source, cur + i) != sb_byte_at(source, ns + i) {
                        same = 0;
                        let marker: i32 = 0;
                        break;
                    }
                    i = i + 1;
                    let marker: i32 = 0;
                }
                if same == 1 {
                    found = 1;
                    done = 1;
                    let marker: i32 = 0;
                }
            }
            let after: usize = skip_space(source, pn);
            let colon: usize = after;
            if colon < params_end {
                if sb_byte_at(source, colon) == 58 {
                    let ts: usize = skip_space(source, colon + 1);
                    let te: usize = ts;
                    let tdone: i32 = 0;
                    while tdone == 0 {
                        if te >= params_end {
                            tdone = 1;
                            let marker: i32 = 0;
                        } else {
                            if sb_byte_at(source, te) == 44 {
                                tdone = 1;
                                let marker: i32 = 0;
                            } else {
                                te = te + 1;
                                let marker: i32 = 0;
                            }
                        }
                    }
                    let nxt: usize = te;
                    if nxt < params_end {
                        cur = skip_space(source, nxt + 1);
                        let marker: i32 = 0;
                    } else {
                        cur = params_end;
                        let marker: i32 = 0;
                    }
                } else {
                    if sb_byte_at(source, colon) == 44 {
                        cur = skip_space(source, colon + 1);
                        let marker: i32 = 0;
                    } else {
                        cur = params_end;
                        let marker: i32 = 0;
                    }
                }
            } else {
                cur = params_end;
                let marker: i32 = 0;
            }
        }
    }
    return found;
};

// Copy every kind-1 row of the caller's environment (outer) into params,
// skipping rows whose name is one of this function's parameters (the
// callee's own binding must shadow the caller's same-named variable).
// Single loop, no nesting.
let meta_consteval_copy_outer_skip = std::func(
    source: addr,
    outer: addr,
    params: addr,
    ps: usize,
    params_end: usize,
) -> unit {
    let olen: usize = sb_len(outer);
    let orows: usize = meta_rows(outer, olen);
    let orow: usize = 1;
    let done: i32 = 0;
    while done == 0 {
        if orow > orows {
            done = 1;
            let marker: i32 = 0;
        } else {
            let ok: usize = meta_row_field(outer, olen, orow, 0);
            if ok == 1 {
                let ons: usize = meta_row_field(outer, olen, orow, 1);
                let onl: usize = meta_row_field(outer, olen, orow, 2);
                let opsv: usize = meta_row_field(outer, olen, orow, 3);
                let skip: i32 = meta_span_is_param(source, ons, onl, ps, params_end);
                if skip == 0 {
                    meta_append(params, 1, ons, onl, opsv, 0, 0);
                    let marker: i32 = 0;
                }
            }
            orow = orow + 1;
            let marker: i32 = 0;
        }
    }
};

// Call a consteval (kind 6) function row with arguments [args_start,
// args_end); binds parameters then evaluates the return expression.
// calls = 1 allows the body expression to call other consteval functions
// (operands go through meta_eval_operand_call); calls = 0 evaluates the
// body purely.  Nested calls never recurse into another calls=1 frame, so
// no recursive Lain function is generated.  outer is the caller's parameter
// environment (its kind-1 rows are copied in so argument expressions can
// reference caller parameters); pass nil (0) at top level.
let meta_call_consteval = std::func(
    source: addr,
    meta: addr,
    mlen: usize,
    row: usize,
    args_start: usize,
    args_end: usize,
    consts: addr,
    calls: i32,
    outer: addr,
) -> usize {
    let params: addr = sb_new();
    meta_consteval_copy_consts(consts, params);
    let ps: usize = meta_value_payload_start(meta, mlen, row);
    let body: usize = meta_value_payload_length(meta, mlen, row);
    let params_end: usize = ps + 1;
    let pdone2: i32 = 0;
    while pdone2 == 0 {
        if sb_byte_at(source, params_end) == 41 {
            pdone2 = 1;
            let marker: i32 = 0;
        } else {
            params_end = params_end + 1;
            let marker: i32 = 0;
        }
    }
    meta_consteval_copy_outer_skip(source, outer, params, ps, params_end);
    let sentinel: usize = 0 - 1;
    let pcur: usize = ps + 1;
    let acur: usize = args_start;
    let pdone: i32 = 0;
    while pdone == 0 {
        if pcur >= params_end {
            pdone = 1;
            let marker: i32 = 0;
        } else {
            let pn: usize = parse_ident(source, pcur);
            let psep: usize = scan_top_op(source, pn, params_end, 44);
            let asep: usize = scan_top_op(source, acur, args_end, 44);
            let av: usize = 0 - 1;
            if calls == 1 {
                av = meta_eval_nested_call(source, acur, asep, params, meta, mlen, consts);
                let marker: i32 = 0;
            } else {
                av = meta_eval_nested(source, acur, asep, params);
                let marker: i32 = 0;
            }
            if av != sentinel {
                meta_append(params, 1, pcur, pn - pcur, av, 0, 0);
                let marker: i32 = 0;
            }
            pcur = skip_space(source, psep + 1);
            acur = skip_space(source, asep + 1);
            let marker: i32 = 0;
        }
    }
    let src_len: usize = sb_len(source);
    let brace_end: usize = match_brace(source, body, src_len);
    let after_locals: usize = meta_consteval_bind_locals(source, body + 1, brace_end, params);
    let stmt: usize = skip_space(source, after_locals);
    if sb_span_equals(source, stmt, 2, "if", 2) {
        let iv: usize = meta_consteval_run_if(source, stmt, brace_end, params, meta, mlen, consts, calls);
        if iv != sentinel { return iv; }
    }
    let ret: usize = after_locals;
    let scanning: i32 = 1;
    while scanning == 1 {
        if sb_byte_at(source, ret) == 114 {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            ret = ret + 1;
            let marker: i32 = 0;
        }
    }
    let rexpr: usize = skip_space(source, ret + 6);
    let rsemi: usize = scan_semi(source, rexpr, brace_end);
    let value: usize = 0 - 1;
    if calls == 1 {
        value = meta_eval_nested_call(source, rexpr, rsemi, params, meta, mlen, consts);
        let marker: i32 = 0;
    } else {
        value = meta_eval_expr(source, rexpr, rsemi, params);
        let marker: i32 = 0;
    }
    return value;
};

// Evaluate a consteval if/else-if/else chain starting at `stmt` (which
// points at "if").  Returns the branch value or max-1 when the chain did
// not produce a value (no branch taken, or a condition was not evaluable).
// Iterative: each else-if is one loop turn (no recursive Lain function).
let meta_consteval_run_if = std::func(
    source: addr,
    stmt: usize,
    brace_end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
    calls: i32,
) -> usize {
    let sentinel: usize = 0 - 1;
    let current: usize = stmt;
    let running: i32 = 1;
    let result: usize = sentinel;
    while running == 1 {
        if sb_span_equals(source, current, 2, "if", 2) {
            let cond_start: usize = skip_space(source, current + 2);
            let brace: usize = scan_brace(source, cond_start, brace_end);
            let cond: usize = meta_eval_bool(source, cond_start, brace, params, meta, mlen, consts);
            let then_close: usize = match_brace(source, brace, brace_end);
            if cond == 1 {
                result = meta_consteval_eval_branch(source, brace + 1, then_close, params, meta, mlen, consts, calls);
                running = 0;
                let marker: i32 = 0;
            } else {
                let after_then: usize = skip_space(source, then_close + 1);
                if sb_span_equals(source, after_then, 4, "else", 4) {
                    let after_else: usize = skip_space(source, after_then + 4);
                    if sb_span_equals(source, after_else, 2, "if", 2) {
                        current = after_else;
                        let marker: i32 = 0;
                    } else {
                        let else_brace: usize = scan_brace(source, after_else, brace_end);
                        let else_close: usize = match_brace(source, else_brace, brace_end);
                        result = meta_consteval_eval_branch(source, else_brace + 1, else_close, params, meta, mlen, consts, calls);
                        running = 0;
                        let marker: i32 = 0;
                    }
                } else {
                    running = 0;
                    let marker: i32 = 0;
                }
            }
        } else {
            running = 0;
            let marker: i32 = 0;
        }
    }
    return result;
};

// Evaluate a consteval branch [start, end): bind local lets, then find the
// return expression and evaluate it.  Returns the value or max-1.
// calls selects call-recognizing evaluation (same as meta_call_consteval).
let meta_consteval_eval_branch = std::func(
    source: addr,
    start: usize,
    end: usize,
    params: addr,
    meta: addr,
    mlen: usize,
    consts: addr,
    calls: i32,
) -> usize {
    let sentinel: usize = 0 - 1;
    let after_locals: usize = meta_consteval_bind_locals(source, start, end, params);
    let ret: usize = after_locals;
    let scanning: i32 = 1;
    while scanning == 1 {
        if sb_byte_at(source, ret) == 114 {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            ret = ret + 1;
            let marker: i32 = 0;
        }
    }
    let rexpr: usize = skip_space(source, ret + 6);
    let rsemi: usize = scan_semi(source, rexpr, end);
    let value: usize = 0 - 1;
    if calls == 1 {
        value = meta_eval_nested_call(source, rexpr, rsemi, params, meta, mlen, consts);
        let marker: i32 = 0;
    } else {
        value = meta_eval_expr(source, rexpr, rsemi, params);
        let marker: i32 = 0;
    }
    return value;
};

// Bind compile-time local `let NAME = EXPR;` declarations in a consteval
// body [start, body_end) into the params table (locals shadow nothing; the
// table is searched by name span, so later lets can reference earlier ones).
// Returns the index after the last bound let (the return statement lies
// after it).  Uses a single loop with no nesting to satisfy the frozen
// bootstrap constraints.
let meta_consteval_bind_locals = std::func(
    source: addr,
    start: usize,
    body_end: usize,
    params: addr,
) -> usize {
    let cur: usize = start;
    let sentinel: usize = 0 - 1;
    let last: usize = start;
    let scanning: i32 = 1;
    while scanning == 1 {
        let s: usize = skip_space(source, cur);
        if s >= body_end {
            scanning = 0;
            let marker: i32 = 0;
        } else {
            if sb_span_equals(source, s, 3, "let", 3) {
                let ns: usize = skip_space(source, s + 3);
                let ne: usize = parse_ident(source, ns);
                let eq: usize = skip_space(source, ne);
                if sb_byte_at(source, eq) == 61 {
                    let es: usize = skip_space(source, eq + 1);
                    let semi: usize = scan_semi(source, es, body_end);
                    let v: usize = meta_eval_nested(source, es, semi, params);
                    if v != sentinel {
                        meta_append(params, 1, ns, ne - ns, v, 0, 0);
                        let marker: i32 = 0;
                    }
                    cur = semi + 1;
                    last = cur;
                    let marker: i32 = 0;
                } else {
                    scanning = 0;
                    let marker: i32 = 0;
                }
            } else {
                scanning = 0;
                let marker: i32 = 0;
            }
        }
    }
    return last;
};

// ---- byte helpers ----
let is_space = std::func(byte: i32) -> bool {
    if byte == 32 { return true; }
    if byte == 10 { return true; }
    return false;
};

let is_digit = std::func(byte: i32) -> bool {
    if byte < 48 { return false; }
    if byte > 57 { return false; }
    return true;
};

let is_ident_start = std::func(byte: i32) -> bool {
    if byte >= 97 && byte <= 122 { return true; }
    if byte >= 65 && byte <= 90 { return true; }
    return false;
};

let is_ident_char = std::func(byte: i32) -> bool {
    if is_ident_start(byte) { return true; }
    if is_digit(byte) { return true; }
    if byte == 95 { return true; }
    return false;
};

// ---- scanning helpers ----
let skip_space = std::func(source: addr, index: usize) -> usize {
    let current: usize = index;
    while current < sb_len(source) {
        let byte: i32 = sb_byte_at(source, current);
        if is_space(byte) == false { return current; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

let parse_ident = std::func(source: addr, index: usize) -> usize {
    let current: usize = index;
    while current < sb_len(source) {
        let byte: i32 = sb_byte_at(source, current);
        if is_ident_char(byte) == false { break; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

// Skip a string literal starting at a quote; returns the index after it.
let skip_string = std::func(source: addr, index: usize) -> usize {
    let current: usize = index + 1;
    while sb_byte_at(source, current) != 34 {
        current = current + 1;
        let marker: i32 = 0;
    }
    return current + 1;
};

// Find the first top-level occurrence of a single-char operator op in
// [start, end), skipping string literals and parenthesised groups.
// Returns end when absent.
let scan_top_op = std::func(
    source: addr,
    start: usize,
    end: usize,
    op: i32,
) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == op {
                        return current;
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Find the first top-level comparison operator in [start, end); returns
// end when absent.  == != < > <= >=
let scan_cmp = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 {
                        if byte == 61 { return current; }
                        if byte == 33 {
                            // `!=` is a comparison; a bare `!` is unary
                            // not and must not split the expression.
                            if current + 1 < end {
                                if sb_byte_at(source, current + 1) == 61 {
                                    return current;
                                }
                                let marker: i32 = 0;
                            }
                        }
                        if byte == 60 { return current; }
                        if byte == 62 { return current; }
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Find the first top-level `&&` (two ampersands) in [start, end); returns
// the position of the first ampersand, or end when absent.
let scan_and = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 38 {
                        if sb_byte_at(source, current + 1) == 38 {
                            return current;
                        }
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Find the first top-level `||` in [start, end); returns end when absent.
let scan_or = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 124 {
                        if sb_byte_at(source, current + 1) == 124 {
                            return current;
                        }
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Trim [start, end) to the non-space core; returns the new start.
let trim_start = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    while current < end {
        if is_space(sb_byte_at(source, current)) == false { return current; }
        current = current + 1;
        let marker: i32 = 0;
    }
    return current;
};

// Trim trailing spaces; returns the new end.
let trim_end = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = end;
    while current > start {
        let byte: i32 = sb_byte_at(source, current - 1);
        if is_space(byte) == false { return current; }
        current = current - 1;
        let marker: i32 = 0;
    }
    return current;
};

// ---- expression lowering ----

// Lower an address expression [start, end) as #lea(base=.., idx=..).
// Forms: BASE + IDX or BASE + NUM + IDX (over the address chain).
let emit_addr_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let base_end: usize = parse_ident(source, s);
    let current: usize = skip_space(source, base_end);
    if sb_byte_at(source, current) == 43 {
        current = skip_space(source, current + 1);
        let marker: i32 = 0;
    }
    let item_first: i32 = sb_byte_at(source, current);
    let item1_end: usize = current;
    let scanning: i32 = 1;
    while scanning == 1 {
        if item1_end < e {
            if sb_byte_at(source, item1_end) == 43 {
                scanning = 0;
                let marker: i32 = 0;
            } else {
                item1_end = item1_end + 1;
                let marker: i32 = 0;
            }
        } else {
            scanning = 0;
            let marker: i32 = 0;
        }
    }
    let second_start: usize = skip_space(source, item1_end);
    if sb_byte_at(source, second_start) == 43 {
        second_start = skip_space(source, second_start + 1);
        let marker: i32 = 0;
    }
    let second_end: usize = second_start;
    let scanning2: i32 = 1;
    while scanning2 == 1 {
        if second_end < e {
            if sb_byte_at(source, second_end) == 43 {
                scanning2 = 0;
                let marker: i32 = 0;
            } else {
                second_end = second_end + 1;
                let marker: i32 = 0;
            }
        } else {
            scanning2 = 0;
            let marker: i32 = 0;
        }
    }
    sb_append_literal(output, "#lea(base=%", 11);
    sb_append_span(output, source, s, base_end - s);
    sb_append_literal(output, ", idx=", 6);
    if item1_end == current {
        sb_append_literal(output, "0, scale=0, offset=0)", 21);
    } else {
        if is_digit(item_first) {
            let off_end: usize = trim_end(source, current, item1_end);
            sb_append_literal(output, "%", 1);
            sb_append_span(output, source, second_start, second_end - second_start);
            sb_append_literal(output, ", scale=1, offset=", 18);
            sb_append_span(output, source, current, off_end - current);
            sb_append_literal(output, ")", 1);
        } else {
            let off_end: usize = trim_end(source, current, item1_end);
            sb_append_literal(output, "%", 1);
            sb_append_span(output, source, current, off_end - current);
            sb_append_literal(output, ", scale=1, offset=0)", 20);
        }
    }
};

// Emit one argument spanning from arg_start; returns the index after it.
let emit_arg_one = std::func(
    source: addr,
    arg_start: usize,
    args_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let arg_end: usize = arg_start;
    let depth: usize = 0;
    let arg_done: i32 = 0;
    while arg_done == 0 {
        if arg_end < args_end {
            let byte: i32 = sb_byte_at(source, arg_end);
            if byte == 34 {
                arg_end = skip_string(source, arg_end);
                let marker: i32 = 0;
            } else {
                if byte == 40 {
                    depth = depth + 1;
                    arg_end = arg_end + 1;
                    let marker: i32 = 0;
                } else {
                    if byte == 41 {
                        depth = depth - 1;
                        arg_end = arg_end + 1;
                        let marker: i32 = 0;
                    } else {
                        if byte == 123 {
                            depth = depth + 1;
                            arg_end = arg_end + 1;
                            let marker: i32 = 0;
                        } else {
                            if byte == 125 {
                                depth = depth - 1;
                                arg_end = arg_end + 1;
                                let marker: i32 = 0;
                            } else {
                                if depth == 0 && byte == 44 {
                                    arg_done = 1;
                                    let marker: i32 = 0;
                                } else {
                                    arg_end = arg_end + 1;
                                    let marker: i32 = 0;
                                }
                            }
                        }
                    }
                }
            }
        } else {
            arg_done = 1;
            let marker: i32 = 0;
        }
    }
    let ts: usize = trim_start(source, arg_start, arg_end);
    let amut: usize = 0;
    if sb_byte_at(source, ts) == 38 {
        let after_amp: usize = skip_space(source, ts + 1);
        if sb_span_equals(source, after_amp, 3, "mut", 3) {
            amut = 1;
            let marker: i32 = 0;
        }
    }
    if amut == 1 {
        let ident_s: usize = skip_space(source, ts + 4);
        sb_append_literal(output, "%", 1);
        sb_append_span(output, source, ident_s, parse_ident(source, ident_s) - ident_s);
        return arg_end;
    }
    let ane: usize = parse_ident(source, ts);
    let aaf: usize = skip_space(source, ane);
    if sb_byte_at(source, aaf) == 46 {
        let tlen: usize = sb_len(types);
        let trec: usize = meta_table_find(types, tlen, source, ts, ane);
        let resolvable: usize = 0;
        if trec < tlen {
            let tseg: usize = meta_seg_end(types, tlen, trec);
            let llen: usize = sb_len(layout);
            let lrec: usize = meta_table_find(layout, llen, types, trec, tseg);
            if lrec < llen {
                resolvable = 1;
                let marker: i32 = 0;
            }
        }
        if resolvable == 0 {
            let afin: usize = emit_path_tail(source, ts, arg_end);
            let afend: usize = parse_ident(source, afin);
            let afaf: usize = skip_space(source, afend);
            // An unresolved element-access argument (store.arguments.get(i),
            // effects.keys.get_mut(i), ...) returns an address in the
            // archive, so a bare 0 would not type-check against an addr
            // parameter.  Lower those to #int2ptr(0).  get()/get_mut()
            // are the vector accessors; other method chains (byte_at,
            // length, ...) stay 0.
            if sb_byte_at(source, afaf) == 40 {
                let mname_s: usize = afin;
                let mname_e: usize = afend;
                let is_get: usize = 0;
                if sb_span_equals(source, mname_s, mname_e - mname_s, "get", 3) {
                    is_get = 1;
                    let marker: i32 = 0;
                }
                if sb_span_equals(source, mname_s, mname_e - mname_s, "get_mut", 7) {
                    is_get = 1;
                    let marker: i32 = 0;
                }
                if is_get == 1 {
                    sb_append_literal(output, "#int2ptr(0)", 11);
                    return arg_end;
                }
                let marker: i32 = 0;
            }
            if sb_byte_at(source, afaf) != 40 {
                let mlen8: usize = sb_len(meta);
                let mrow8: usize = meta_lookup(meta, mlen8, source, ts, ane - ts);
                if mrow8 != 0 {
                    let mk8: usize = meta_value_kind(meta, mlen8, mrow8);
                    if mk8 == 2 {
                        sb_append_literal(output, "#alloca(1)", 10);
                        return arg_end;
                    }
                }
                sb_append_literal(output, "%", 1);
                sb_append_span(output, source, ts, ane - ts);
                return arg_end;
            }
        }
    }
    emit_expr(source, arg_start, arg_end, output, layout, types, meta, consts);
    return arg_end;
};

// Emit the argument list (args_start, args_end) with each argument lowered.
let emit_call_args = std::func(
    source: addr,
    args_start: usize,
    args_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let current: usize = args_start;
    let first: i32 = 1;
    while current < args_end {
        let arg_start: usize = skip_space(source, current);
        if arg_start >= args_end { break; }
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        current = emit_arg_one(source, arg_start, args_end, output, layout, types, meta, consts);
        current = skip_space(source, current);
        if current < args_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Return the start of the last segment of a qualified path `a.b.c` /
// `a::b`, or the original start when there is no path.  Module members are
// emitted as f0_<member>, so call sites use the last segment as the callee.
let emit_path_tail = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let tail: usize = start;
    let scan: usize = parse_ident(source, start);
    let done: i32 = 0;
    while done == 0 {
        let sep: usize = skip_space(source, scan);
        if sep >= end {
            done = 1;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, sep);
            if b == 46 {
                let next: usize = skip_space(source, sep + 1);
                if next < end {
                    if is_ident_start(sb_byte_at(source, next)) {
                        tail = next;
                        scan = parse_ident(source, next);
                        let marker: i32 = 0;
                    } else {
                        done = 1;
                        let marker: i32 = 0;
                    }
                } else {
                    done = 1;
                    let marker: i32 = 0;
                }
            } else {
                if b == 58 {
                    if sb_byte_at(source, sep + 1) == 58 {
                        let next: usize = skip_space(source, sep + 2);
                        if next < end {
                            if is_ident_start(sb_byte_at(source, next)) {
                                tail = next;
                                scan = parse_ident(source, next);
                                let marker: i32 = 0;
                            } else {
                                done = 1;
                                let marker: i32 = 0;
                            }
                        } else {
                            done = 1;
                            let marker: i32 = 0;
                        }
                    } else {
                        done = 1;
                        let marker: i32 = 0;
                    }
                } else {
                    done = 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return tail;
};

// Emit a call NAME(args) where name spans [name_start, name_end).
// mod_start/mod_end name the module the member belongs to (0/0 for
// top-level functions), producing #call f0_<mod>_<member>.
let emit_call_named = std::func(
    source: addr,
    name_start: usize,
    name_end: usize,
    mod_start: usize,
    mod_end: usize,
    args_start: usize,
    args_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let marker: i32 = 0;
    sb_append_literal(output, "#call f0_", 9);
    if mod_end != 0 {
        sb_append_span(output, source, mod_start, mod_end - mod_start);
        sb_append_literal(output, "_", 1);
    }
    sb_append_span(output, source, name_start, name_end - name_start);
    sb_append_literal(output, "(", 1);
    emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
    sb_append_literal(output, ")", 1);
};

// Emit std::load_bits / std::store_bits; returns true when handled.
let emit_std_intrinsic = std::func(
    source: addr,
    name_start: usize,
    name_end: usize,
    expr_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> bool {
    let after: usize = skip_space(source, name_end);
    if sb_byte_at(source, after) != 58 { return 0; }
    let member: usize = skip_space(source, after + 2);
    let member_end: usize = parse_ident(source, member);
    if sb_byte_at(source, member_end) != 40 { return 0; }
    let args_start: usize = member_end + 1;
    let args_end: usize = args_start;
    let depth: usize = 0;
    while args_end < expr_end {
        let byte: i32 = sb_byte_at(source, args_end);
        if byte == 34 {
            args_end = skip_string(source, args_end);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                args_end = args_end + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    if depth == 0 { break; }
                    depth = depth - 1;
                    args_end = args_end + 1;
                    let marker: i32 = 0;
                } else {
                    args_end = args_end + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    if sb_span_equals(source, member, member_end - member, "load_bits", 9) {
        let width_start: usize = skip_space(source, args_start);
        let width_end: usize = width_start;
        let width_done: i32 = 0;
        while width_done == 0 {
            if width_end < args_end {
                if sb_byte_at(source, width_end) == 44 {
                    width_done = 1;
                    let marker: i32 = 0;
                } else {
                    width_end = width_end + 1;
                    let marker: i32 = 0;
                }
            } else {
                width_done = 1;
                let marker: i32 = 0;
            }
        }
        let addr_start: usize = skip_space(source, width_end + 1);
        let addr_end: usize = trim_end(source, addr_start, args_end);
        if sb_span_equals(source, width_start, width_end - width_start, "8", 1) {
            sb_append_literal(output, "#zext[#bits<32>](", 17);
        }
        sb_append_literal(output, "#load[#bits<", 12);
        sb_append_span(output, source, width_start, width_end - width_start);
        sb_append_literal(output, ">", 1);
        sb_append_literal(output, "]", 1);
        sb_append_literal(output, "(", 1);
        emit_addr_expr(source, addr_start, addr_end, output);
        sb_append_literal(output, ")", 1);
        if sb_span_equals(source, width_start, width_end - width_start, "8", 1) {
            sb_append_literal(output, ")", 1);
        }
        return 1;
    }
    if sb_span_equals(source, member, member_end - member, "store_bits", 10) {
        let width_start: usize = skip_space(source, args_start);
        let width_end: usize = width_start;
        let width_done: i32 = 0;
        while width_done == 0 {
            if width_end < args_end {
                if sb_byte_at(source, width_end) == 44 {
                    width_done = 1;
                    let marker: i32 = 0;
                } else {
                    width_end = width_end + 1;
                    let marker: i32 = 0;
                }
            } else {
                width_done = 1;
                let marker: i32 = 0;
            }
        }
        let addr_start: usize = skip_space(source, width_end + 1);
        let addr_mid: usize = addr_start;
        let depth2: usize = 0;
        let addr_done: i32 = 0;
        while addr_done == 0 {
            if addr_mid < args_end {
                let b: i32 = sb_byte_at(source, addr_mid);
                if b == 34 {
                    addr_mid = skip_string(source, addr_mid);
                    let marker: i32 = 0;
                } else {
                    if b == 40 {
                        depth2 = depth2 + 1;
                        addr_mid = addr_mid + 1;
                        let marker: i32 = 0;
                    } else {
                        if b == 41 {
                            depth2 = depth2 - 1;
                            addr_mid = addr_mid + 1;
                            let marker: i32 = 0;
                        } else {
                            if depth2 == 0 && b == 44 {
                                addr_done = 1;
                                let marker: i32 = 0;
                            } else {
                                addr_mid = addr_mid + 1;
                                let marker: i32 = 0;
                            }
                        }
                    }
                }
            } else {
                addr_done = 1;
                let marker: i32 = 0;
            }
        }
        let value_start: usize = skip_space(source, addr_mid + 1);
        let value_end: usize = trim_end(source, value_start, args_end);
        sb_append_literal(output, "#store ", 7);
        emit_expr(source, value_start, value_end, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        emit_addr_expr(source, addr_start, addr_mid, output);
        return 1;
    }
    return 0;
};

// Resolve the factory prefix for a bare member call: when the callee is a
// std::func member of a factory-produced module (kind 3 with a non-zero
// owning module row whose payload names the factory), returns the factory
// name start offset; 0 otherwise.
let bare_call_prefix = std::func(
    source: addr,
    member_start: usize,
    member_end: usize,
    meta: addr,
) -> usize {
    let mlen: usize = sb_len(meta);
    let mrow: usize = meta_lookup(meta, mlen, source, member_start, member_end - member_start);
    if mrow == 0 { return 0; }
    let mk: usize = meta_value_kind(meta, mlen, mrow);
    if mk != 3 { return 0; }
    let owner: usize = meta_row_field(meta, mlen, mrow, 5);
    if owner == 0 { return 0; }
    let pl: usize = meta_value_payload_length(meta, mlen, owner);
    if pl <= 1 { return 0; }
    return meta_value_payload_start(meta, mlen, owner);
};

// The length of the factory-name prefix for a bare member call; 0 when
// the callee has no factory owner.
let bare_call_prefix_len = std::func(
    source: addr,
    member_start: usize,
    member_end: usize,
    meta: addr,
) -> usize {
    let mlen: usize = sb_len(meta);
    let mrow: usize = meta_lookup(meta, mlen, source, member_start, member_end - member_start);
    if mrow == 0 { return 0; }
    let mk: usize = meta_value_kind(meta, mlen, mrow);
    if mk != 3 { return 0; }
    let owner: usize = meta_row_field(meta, mlen, mrow, 5);
    if owner == 0 { return 0; }
    let pl: usize = meta_value_payload_length(meta, mlen, owner);
    if pl <= 1 { return 0; }
    return pl;
};

// Emit a single operand [start, end): number, string literal, identifier,
// &x, or call.
let emit_operand2 = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let first: i32 = sb_byte_at(source, s);
    // Unary not `!expr`: lower as #eq(expr, 0).
    if first == 33 {
        let inner: usize = skip_space(source, s + 1);
        sb_append_literal(output, "#eq(", 4);
        emit_operand2(source, inner, e, output, layout, types, meta, consts);
        sb_append_literal(output, ", 0)", 4);
        return;
    }
    if first == 34 {
        sb_append_span(output, source, s, e - s);
        return;
    }
    if first == 38 {
        let inner: usize = skip_space(source, s + 1);
        sb_append_literal(output, "%", 1);
        sb_append_span(output, source, inner, parse_ident(source, inner) - inner);
        return;
    }
    if is_digit(first) {
        sb_append_span(output, source, s, e - s);
        return;
    }
    let name_end: usize = parse_ident(source, s);
    let field_after: usize = skip_space(source, name_end);
    if sb_byte_at(source, field_after) == 46 {
        let fstart: usize = skip_space(source, field_after + 1);
        let fend: usize = parse_ident(source, fstart);
        let tlen: usize = sb_len(types);
        let trec: usize = meta_table_find(types, tlen, source, s, name_end);
        if trec < tlen {
            let tseg: usize = meta_seg_end(types, tlen, trec);
            // The declared type may be a borrow `&T`; strip the `&` before
            // looking the record up in the layout table.
            let lts: usize = trec;
            let lte: usize = tseg;
            if sb_byte_at(source, lts) == 38 {
                let after_amp: usize = skip_space(source, lts + 1);
                if sb_span_equals(source, after_amp, 3, "mut", 3) {
                    lts = skip_space(source, after_amp + 3);
                    let marker: i32 = 0;
                } else {
                    lts = after_amp;
                    let marker: i32 = 0;
                }
            }
            let llen: usize = sb_len(layout);
            let lrec: usize = meta_table_find(layout, llen, types, lts, lte);
            if lrec < llen {
                let fchk: usize = skip_space(source, fend);
                if sb_byte_at(source, fchk) == 46 {
                    sb_append_literal(output, "0", 1);
                    return;
                }
                if sb_byte_at(source, fchk) == 40 {
                    sb_append_literal(output, "0", 1);
                    return;
                }
                let lseg: usize = meta_seg_end(layout, llen, lrec);
                let off: usize = meta_field_offset(layout, lrec, lseg, source, fstart, fend);
                let w: usize = meta_field_width(layout, lrec, lseg, source, fstart, fend);
                sb_append_literal(output, "#load[#bits<", 12);
                meta_emit_bits(output, w);
                sb_append_literal(output, ">](#lea(base=%", 14);
                sb_append_span(output, source, s, name_end - s);
                sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
                meta_append_decimal(output, off);
                sb_append_literal(output, "))", 2);
                return;
            }
        }
        let mlen7: usize = sb_len(meta);
        let mrow7b: usize = meta_lookup(meta, mlen7, source, s, name_end - s);
        if mrow7b == 0 {
            let mfin: usize = emit_path_tail(source, s, e);
            let mfend: usize = parse_ident(source, mfin);
            let mfafter: usize = skip_space(source, mfend);
            if sb_byte_at(source, mfafter) == 40 {
                let marker: i32 = 0;
            } else {
                sb_append_literal(output, "0", 1);
                return;
            }
        }
    }
    if sb_span_equals(source, s, name_end - s, "std", 3) {
        if emit_std_intrinsic(source, s, name_end, e, output, layout, types, meta, consts) == 1 {
            return;
        }
    }
    if sb_span_equals(source, s, name_end - s, "true", 4) {
        sb_append_literal(output, "1", 1);
        return;
    }
    if sb_span_equals(source, s, name_end - s, "false", 5) {
        sb_append_literal(output, "0", 1);
        return;
    }
    let clen: usize = sb_len(consts);
    let crow: usize = meta_lookup(consts, clen, source, s, name_end - s);
    if crow != 0 {
        let val: usize = meta_row_field(consts, clen, crow, 3);
        meta_append_decimal(output, val);
        return;
    }
    let member_start: usize = emit_path_tail(source, s, e);
    let member_end: usize = parse_ident(source, member_start);
    let after: usize = skip_space(source, member_end);
    if sb_byte_at(source, after) == 40 {
        let args_start: usize = after + 1;
        let args_end: usize = args_start;
        let depth: usize = 0;
        while args_end < e {
            let byte: i32 = sb_byte_at(source, args_end);
            if byte == 34 {
                args_end = skip_string(source, args_end);
                let marker: i32 = 0;
            } else {
                if byte == 40 {
                    depth = depth + 1;
                    args_end = args_end + 1;
                    let marker: i32 = 0;
                } else {
                    if byte == 41 {
                        if depth == 0 { break; }
                        depth = depth - 1;
                        args_end = args_end + 1;
                        let marker: i32 = 0;
                    } else {
                        args_end = args_end + 1;
                        let marker: i32 = 0;
                    }
                }
            }
        }
        let mstart: usize = 0;
        let mend: usize = 0;
        if member_start != s {
            let mlen2: usize = sb_len(meta);
            let mrow2: usize = meta_lookup(meta, mlen2, source, s, name_end - s);
            if mrow2 != 0 {
                let mk2: usize = meta_value_kind(meta, mlen2, mrow2);
                if mk2 == 2 {
                    mstart = s;
                    mend = name_end;
                    let marker: i32 = 0;
                }
            }
        }
        let stub: usize = 0;
        if mstart != 0 {
            let mlen5: usize = sb_len(meta);
            let mrow5: usize = meta_lookup(meta, mlen5, source, mstart, mend - mstart);
            let mpl: usize = meta_value_payload_length(meta, mlen5, mrow5);
            if mpl == 0 {
                stub = 1;
                let marker: i32 = 0;
            } else {
                if mpl > 1 {
                    let mps2: usize = meta_value_payload_start(meta, mlen5, mrow5);
                    let mpse: usize = mps2 + mpl;
                    mstart = mps2;
                    mend = mpse;
                    let marker: i32 = 0;
                }
            }
        } else {
            if member_start != s {
                stub = 1;
                let marker: i32 = 0;
            }
        }
        if stub == 1 {
            sb_append_literal(output, "0", 1);
            return;
        }
        if mstart == 0 {
            let bp: usize = bare_call_prefix(source, member_start, member_end, meta);
            if bp != 0 {
                let bplen: usize = bare_call_prefix_len(source, member_start, member_end, meta);
                if bplen != 0 {
                    let bpe: usize = bp + bplen;
                    mstart = bp;
                    mend = bpe;
                    let marker: i32 = 0;
                }
            }
        }
        emit_call_named(source, member_start, member_end, mstart, mend, args_start, args_end, output, layout, types, meta, consts);
        return;
    }
    let mlen3: usize = sb_len(meta);
    let mrow3: usize = 0;
    if member_start != s {
        mrow3 = meta_lookup(meta, mlen3, source, s, name_end - s);
        let marker: i32 = 0;
    }
    if mrow3 != 0 {
        let mk3: usize = meta_value_kind(meta, mlen3, mrow3);
        if mk3 == 2 {
            let clen3: usize = sb_len(consts);
            let crow3: usize = meta_lookup_qualified(consts, clen3, source, member_start, member_end - member_start, mrow3);
            if crow3 != 0 {
                let val3: usize = meta_row_field(consts, clen3, crow3, 3);
                meta_append_decimal(output, val3);
                return;
            }
            let marker: i32 = 0;
        }
    }
    sb_append_literal(output, "%", 1);
    sb_append_span(output, source, member_start, member_end - member_start);
};

// Lower an addition/subtraction chain as #add(L, R) / #sub(L, R).
let emit_add_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    // Leading unary minus `-expr`: lower as #sub(0, expr).
    if sb_byte_at(source, s) == 45 {
        let inner: usize = skip_space(source, s + 1);
        let ie: usize = trim_end(source, inner, e);
        sb_append_literal(output, "#sub(0, ", 8);
        emit_add_expr(source, inner, ie, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    // Leading dereference `*expr`: the archive uses it on vector get()
    // results; lower to 0 (capability stub) so the expression stays
    // verifier-clean.  Full deref needs the pointee type.
    if sb_byte_at(source, s) == 42 {
        sb_append_literal(output, "0", 1);
        return;
    }
    let plus: usize = scan_top_op(source, s, e, 43);
    if plus < e {
        let ls: usize = trim_start(source, s, plus);
        let le: usize = trim_end(source, ls, plus);
        let rs: usize = skip_space(source, plus + 1);
        let re: usize = trim_end(source, rs, e);
        if meta_fold_binary(source, output, ls, le, rs, re, 43) {
            return;
        }
        sb_append_literal(output, "#add(", 5);
        emit_add_expr(source, s, plus, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, plus + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    let minus: usize = scan_top_op(source, s, e, 45);
    if minus < e {
        let ms: usize = trim_start(source, s, minus);
        let me: usize = trim_end(source, ms, minus);
        let rs2: usize = skip_space(source, minus + 1);
        let re2: usize = trim_end(source, rs2, e);
        if meta_fold_binary(source, output, ms, me, rs2, re2, 45) {
            return;
        }
        sb_append_literal(output, "#sub(", 5);
        emit_add_expr(source, s, minus, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, minus + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    let mul: usize = scan_top_op(source, s, e, 42);
    if mul < e {
        let xs: usize = trim_start(source, s, mul);
        let xe: usize = trim_end(source, xs, mul);
        let rs3: usize = skip_space(source, mul + 1);
        let re3: usize = trim_end(source, rs3, e);
        if meta_fold_binary(source, output, xs, xe, rs3, re3, 42) {
            return;
        }
        sb_append_literal(output, "#mul(", 5);
        emit_add_expr(source, s, mul, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, mul + 1);
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    emit_operand2(source, s, e, output, layout, types, meta, consts);
};

// Lower a comparison expression as #eq/#ne/#lt/#gt/#le/#ge.
let emit_cmp_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let cmp: usize = scan_cmp(source, s, e);
    if cmp < e {
        let op1: i32 = sb_byte_at(source, cmp);
        let op2: i32 = sb_byte_at(source, cmp + 1);
        if op1 == 61 {
            sb_append_literal(output, "#eq(", 4);
        } else {
            if op1 == 33 {
                sb_append_literal(output, "#ne(", 4);
            } else {
                if op1 == 60 {
                    if op2 == 61 {
                        sb_append_literal(output, "#le(", 4);
                    } else {
                        sb_append_literal(output, "#lt(", 4);
                    }
                } else {
                    if op2 == 61 {
                        sb_append_literal(output, "#ge(", 4);
                    } else {
                        sb_append_literal(output, "#gt(", 4);
                    }
                }
            }
        }
        emit_add_expr(source, s, cmp, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        let right_start: usize = skip_space(source, cmp + 1);
        if op2 == 61 {
            right_start = skip_space(source, cmp + 2);
            let marker: i32 = 0;
        }
        emit_add_expr(source, right_start, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    emit_add_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a boolean-and expression as #eq(#add(#zext64(L), #zext64(R)), 2).
// The right side recurses so `a && b && c` lowers fully.
let emit_and_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let and: usize = scan_and(source, s, e);
    if and < e {
        sb_append_literal(output, "#eq(#add(#zext[#bits<64>](", 26);
        emit_cmp_expr(source, s, and, output, layout, types, meta, consts);
        sb_append_literal(output, "), #zext[#bits<64>](", 20);
        emit_and_expr(source, and + 2, e, output, layout, types, meta, consts);
        sb_append_literal(output, ")), 2)", 6);
        return;
    }
    emit_cmp_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a boolean-or expression as
// #ne(#add(#zext64(#ne(L, 0)), #zext64(#ne(R, 0))), 0).
// The right side recurses so `a || b || c` lowers fully.
let emit_or_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    let or: usize = scan_or(source, s, e);
    if or < e {
        sb_append_literal(output, "#ne(#add(#zext[#bits<64>](#ne(", 30);
        emit_and_expr(source, s, or, output, layout, types, meta, consts);
        sb_append_literal(output, ", 0)), #zext[#bits<64>](#ne(", 28);
        emit_or_expr(source, or + 2, e, output, layout, types, meta, consts);
        sb_append_literal(output, ", 0))), 0)", 10);
        return;
    }
    emit_and_expr(source, s, e, output, layout, types, meta, consts);
};

// Lower a full expression [start, end).
let emit_expr = std::func(
    source: addr,
    start: usize,
    end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let s: usize = trim_start(source, start, end);
    let e: usize = trim_end(source, s, end);
    if s >= e { return; }
    emit_or_expr(source, s, e, output, layout, types, meta, consts);
};

// ---- type lowering ----

let emit_type = std::func(
    source: addr,
    ts: usize,
    te: usize,
    output: addr,
    meta: addr,
) -> unit {
    let t: usize = trim_start(source, ts, te);
    let t2: usize = trim_end(source, t, te);
    let first: i32 = sb_byte_at(source, t);
    if first == 38 {
        sb_append_literal(output, "addr", 4);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "unit", 4) {
        sb_append_literal(output, "#unit", 5);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "bool", 4) {
        sb_append_literal(output, "#bits<1>", 8);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "usize", 5) {
        sb_append_literal(output, "#bits<64>", 9);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "i32", 3) {
        sb_append_literal(output, "#bits<32>", 9);
        return;
    }
    if sb_span_equals(source, t, t2 - t, "addr", 4) {
        sb_append_literal(output, "addr", 4);
        return;
    }
    let ml: usize = sb_len(meta);
    let tr: usize = meta_lookup(meta, ml, source, t, t2 - t);
    if tr != 0 {
        let tk: usize = meta_value_kind(meta, ml, tr);
        if tk == 4 {
            let ps: usize = meta_value_payload_start(meta, ml, tr);
            let pl: usize = meta_value_payload_length(meta, ml, tr);
            if sb_byte_at(source, ps) != 123 {
                let pe: usize = ps + pl;
                emit_type(source, ps, pe, output, meta);
                return;
            }
            let marker: i32 = 0;
        }
    }
    // Qualified type alias `Mod.Member`: resolve the module row from the
    // first path segment, then look the member up under that row.  The
    // member's own payload is emitted recursively, so `Syntax.NodeId`
    // (an alias for `usize`) lowers to #bits<64> instead of addr.
    // Scan once for the last `.` separator; the segment after it is the
    // member name, the segment before it is the module.
    let tscan: usize = t;
    let scan: usize = t;
    while scan < t2 {
        if sb_byte_at(source, scan) == 46 {
            let after: usize = skip_space(source, scan + 1);
            if after < t2 {
                if is_ident_start(sb_byte_at(source, after)) {
                    tscan = after;
                    let marker: i32 = 0;
                }
            }
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    if tscan > t {
        let mod_span: usize = t;
        let mod_end: usize = parse_ident(source, mod_span);
        let mrow: usize = meta_lookup_kind(meta, ml, source, mod_span, mod_end - mod_span, 2);
        if mrow != 0 {
            let mkind: usize = meta_value_kind(meta, ml, mrow);
            if mkind == 2 {
                let mem_end: usize = parse_ident(source, tscan);
                let mtr: usize = meta_lookup_qualified(meta, ml, source, tscan, mem_end - tscan, mrow);
                if mtr != 0 {
                    let mtk: usize = meta_value_kind(meta, ml, mtr);
                    if mtk == 4 {
                        let mps: usize = meta_value_payload_start(meta, ml, mtr);
                        let mpl: usize = meta_value_payload_length(meta, ml, mtr);
                        if sb_byte_at(source, mps) != 123 {
                            let mpe: usize = mps + mpl;
                            emit_type(source, mps, mpe, output, meta);
                            return;
                        }
                        let marker: i32 = 0;
                    }
                }
            }
        }
    }
    sb_append_literal(output, "addr", 4);
};

// Find the first top-level `:` or `=` in [start, end); returns end when
// absent.  Used to split a `let NAME[: TYPE] = EXPR;` binding.
let scan_let_mark = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 {
                        if byte == 58 { return current; }
                        if byte == 61 { return current; }
                    }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// ---- statement lowering ----

// Find the top-level `;` in [start, end); returns end when absent.
let scan_semi = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 59 { return current; }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Find the top-level `{` in [start, end); returns end when absent.
let scan_brace = std::func(source: addr, start: usize, end: usize) -> usize {
    let current: usize = start;
    let depth: usize = 0;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if depth == 0 && byte == 123 { return current; }
                    current = current + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return end;
};

// Match the `}` closing the `{` at brace (top-level); returns its index.
let match_brace = std::func(source: addr, brace: usize, end: usize) -> usize {
    let current: usize = brace + 1;
    let depth: usize = 1;
    while current < end {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 34 {
            current = skip_string(source, current);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                current = current + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    depth = depth - 1;
                    current = current + 1;
                    let marker: i32 = 0;
                } else {
                    if byte == 123 {
                        depth = depth + 1;
                        current = current + 1;
                        let marker: i32 = 0;
                    } else {
                        if byte == 125 {
                            if depth == 1 { return current; }
                            depth = depth - 1;
                            current = current + 1;
                            let marker: i32 = 0;
                        } else {
                            current = current + 1;
                            let marker: i32 = 0;
                        }
                    }
                }
            }
        }
    }
    return end;
};

// Emit a `let NAME: TYPE = EXPR;` binding.  Returns the index after it.
let emit_stmt_let = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let mark: usize = scan_let_mark(source, name_end, body_end);
    let eq: usize = mark;
    if sb_byte_at(source, mark) == 58 {
        eq = scan_top_op(source, mark + 1, body_end, 61);
        let marker: i32 = 0;
    }
    let semi: usize = scan_semi(source, eq + 1, body_end);
    if sb_byte_at(source, mark) == 58 {
        let tstart: usize = trim_start(source, mark + 1, eq);
        let tend: usize = trim_end(source, tstart, eq);
        sb_append_span(types, source, name_start, name_end - name_start);
        sb_append_literal(types, ":", 1);
        sb_append_span(types, source, tstart, tend - tstart);
        sb_append_literal(types, "|", 1);
    }
    let rs: usize = trim_start(source, eq + 1, semi);
    let rn: usize = parse_ident(source, rs);
    let rt0: usize = emit_path_tail(source, rs, semi);
    let rn0: usize = parse_ident(source, rt0);
    let ra: usize = skip_space(source, rn0);
    if sb_byte_at(source, ra) == 123 {
        let rlen: usize = sb_len(layout);
        let rrec: usize = meta_table_find(layout, rlen, source, rs, rn);
        if rrec < rlen {
            emit_record_value(source, output, name_start, name_end, eq + 1, semi, layout, types, meta, consts);
            return semi + 1;
        }
        let rrec2: usize = meta_table_find(layout, rlen, source, rt0, rn0);
        if rrec2 < rlen {
            emit_record_value(source, output, name_start, name_end, eq + 1, semi, layout, types, meta, consts);
            return semi + 1;
        }
        sb_append_literal(output, "#let %", 6);
        sb_append_span(output, source, name_start, name_end - name_start);
        sb_append_literal(output, " = 0\n", 5);
        return semi + 1;
    }
    sb_append_literal(output, "#let %", 6);
    sb_append_span(output, source, name_start, name_end - name_start);
    if sb_byte_at(source, mark) == 58 {
        sb_append_literal(output, ": ", 2);
        emit_type(source, mark + 1, eq, output, meta);
        sb_append_literal(output, " = ", 3);
    } else {
        sb_append_literal(output, " = ", 3);
    }
    emit_expr(source, eq + 1, semi, output, layout, types, meta, consts);
    sb_append_literal(output, "\n", 1);
    return semi + 1;
};

// Emit `while COND { ... }`.  Returns the index after it.
let emit_stmt_while = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let cond_start: usize = skip_space(source, index + 5);
    let brace: usize = scan_brace(source, cond_start, body_end);
    let brace_end: usize = match_brace(source, brace, body_end);
    sb_append_literal(output, "#loop {\n", 8);
    sb_append_literal(output, "  #if #eq(", 10);
    emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
    sb_append_literal(output, ", 0) { #break }\n", 16);
    emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
    sb_append_literal(output, "  #continue\n}\n", 14);
    return brace_end + 1;
};

// Emit the `else` / `else if` chain starting at `start` (which points at
// the `else` keyword).  else-if clauses become nested `else { #if ... }`
// blocks; returns the index after the chain.
let emit_else_tail = std::func(
    source: addr,
    output: addr,
    start: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let done: usize = 0;
    let current: usize = start;
    let depth: usize = 1;
    sb_append_literal(output, "else {\n", 7);
    while done == 0 {
        if sb_span_equals(source, current, 4, "else", 4) {
            let after_else: usize = skip_space(source, current + 4);
            if sb_span_equals(source, after_else, 2, "if", 2) {
                let cond_start: usize = skip_space(source, after_else + 2);
                let brace: usize = scan_brace(source, cond_start, body_end);
                let brace_end: usize = match_brace(source, brace, body_end);
                sb_append_literal(output, "  #if ", 6);
                emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
                sb_append_literal(output, " {\n", 3);
                emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
                sb_append_literal(output, "} else {\n", 9);
                depth = depth + 1;
                current = skip_space(source, brace_end + 1);
                let marker: i32 = 0;
            } else {
                let brace2: usize = scan_brace(source, after_else, body_end);
                let brace2_end: usize = match_brace(source, brace2, body_end);
                emit_block(source, output, brace2 + 1, brace2_end, layout, types, meta, consts);
                current = brace2_end + 1;
                done = 1;
                let marker: i32 = 0;
            }
        } else {
            done = 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    while depth > 0 {
        sb_append_literal(output, "}\n", 2);
        depth = depth - 1;
        let marker: i32 = 0;
    }
    return current;
};

// Emit `if COND { ... } else { ... }`.  Returns the index after it.
let emit_stmt_if = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let cond_start: usize = skip_space(source, index + 2);
    let brace: usize = scan_brace(source, cond_start, body_end);
    let brace_end: usize = match_brace(source, brace, body_end);
    sb_append_literal(output, "#if ", 4);
    emit_expr(source, cond_start, brace, output, layout, types, meta, consts);
    sb_append_literal(output, " {\n", 3);
    emit_block(source, output, brace + 1, brace_end, layout, types, meta, consts);
    sb_append_literal(output, "}\n", 2);
    let after: usize = skip_space(source, brace_end + 1);
    if sb_span_equals(source, after, 4, "else", 4) {
        return emit_else_tail(source, output, after, body_end, layout, types, meta, consts);
    }
    let marker: i32 = 0;
    return brace_end + 1;
};

// Emit `return EXPR;`.  Returns the index after it.
let emit_stmt_ret = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let expr_start: usize = skip_space(source, index + 6);
    let semi: usize = scan_semi(source, expr_start, body_end);
    let rs2: usize = trim_start(source, expr_start, semi);
    let rn2: usize = parse_ident(source, rs2);
    let ra2: usize = skip_space(source, rn2);
    if sb_byte_at(source, ra2) == 123 {
        sb_append_literal(output, "  #return 0\n", 12);
        return semi + 1;
    }
    sb_append_literal(output, "  #return ", 10);
    emit_expr(source, expr_start, semi, output, layout, types, meta, consts);
    sb_append_literal(output, "\n", 1);
    return semi + 1;
};

// Emit an assignment or call statement.  Returns the index after it.
let emit_stmt_other = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let s: usize = skip_space(source, index);
    let semi: usize = scan_semi(source, s, body_end);
    let name_end: usize = parse_ident(source, s);
    let after: usize = skip_space(source, name_end);
    if sb_byte_at(source, after) == 61 {
        sb_append_literal(output, "%", 1);
        sb_append_span(output, source, s, name_end - s);
        sb_append_literal(output, " = ", 3);
        emit_expr(source, after + 1, semi, output, layout, types, meta, consts);
        sb_append_literal(output, "\n", 1);
        return semi + 1;
    }
    let eq2: usize = scan_top_op(source, s, semi, 61);
    let is_eq_cmp: usize = 0;
    if eq2 + 1 < semi {
        if sb_byte_at(source, eq2 + 1) == 61 {
            is_eq_cmp = 1;
            let marker: i32 = 0;
        }
    }
    if is_eq_cmp == 0 {
        if eq2 < semi {
            sb_append_literal(output, "#let %_", 7);
            meta_append_decimal(output, semi);
            sb_append_literal(output, " = ", 3);
            emit_expr(source, eq2 + 1, semi, output, layout, types, meta, consts);
            sb_append_literal(output, "\n", 1);
            return semi + 1;
        }
    }
    emit_expr(source, s, semi, output, layout, types, meta, consts);
    let olen: usize = sb_len(output);
    if olen >= 2 {
        let o3: usize = olen - 1;
        let last1: i32 = sb_byte_at(output, o3);
        if last1 == 48 {
            std::store_bits(64, output, o3);
            sb_append_literal(output, "#let %_", 7);
            meta_append_decimal(output, semi);
            sb_append_literal(output, " = 0\n", 5);
            return semi + 1;
        }
    }
    sb_append_literal(output, "\n", 1);
    return semi + 1;
};

// Emit one statement at index.  Returns the index after it.
let emit_stmt = std::func(
    source: addr,
    output: addr,
    index: usize,
    body_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let s: usize = skip_space(source, index);
    if s >= body_end { return s; }
    let first: i32 = sb_byte_at(source, s);
    if first == 125 { return s; }
    if first == 47 {
        let c3: usize = s;
        while c3 < body_end {
            if sb_byte_at(source, c3) == 10 { break; }
            c3 = c3 + 1;
            let marker: i32 = 0;
        }
        return c3 + 1;
    }
    if sb_span_equals(source, s, 3, "let", 3) {
        return emit_stmt_let(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 5, "while", 5) {
        return emit_stmt_while(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 2, "if", 2) {
        return emit_stmt_if(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 6, "return", 6) {
        return emit_stmt_ret(source, output, s, body_end, layout, types, meta, consts);
    }
    if sb_span_equals(source, s, 5, "break", 5) {
        let semi: usize = scan_semi(source, s, body_end);
        sb_append_literal(output, "#break\n", 7);
        return semi + 1;
    }
    return emit_stmt_other(source, output, s, body_end, layout, types, meta, consts);
};

// Emit the statements in [start, end).
let emit_block = std::func(
    source: addr,
    output: addr,
    start: usize,
    end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let current: usize = start;
    while current < end {
        let s: usize = skip_space(source, current);
        if s >= end { break; }
        if sb_byte_at(source, s) == 125 { break; }
        current = emit_stmt(source, output, s, end, layout, types, meta, consts);
        let marker: i32 = 0;
    }
};

// ---- function lowering ----

// Emit one parameter `name: TYPE` starting at index; returns the index
// just after the type.
let emit_param_one = std::func(
    source: addr,
    output: addr,
    index: usize,
    params_end: usize,
    meta: addr,
) -> usize {
    let current: usize = skip_space(source, index);
    if current >= params_end { return params_end; }
    let name_end: usize = parse_ident(source, current);
    let colon: usize = scan_top_op(source, current, params_end, 58);
    let type_start: usize = colon + 1;
    let type_end: usize = scan_top_op(source, type_start, params_end, 44);
    emit_type(source, type_start, type_end, output, meta);
    sb_append_literal(output, " %", 2);
    sb_append_span(output, source, current, name_end - current);
    return type_end;
};

let emit_params2 = std::func(
    source: addr,
    output: addr,
    params_start: usize,
    params_end: usize,
    meta: addr,
) -> unit {
    let current: usize = params_start;
    let first: i32 = 1;
    while current < params_end {
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        current = emit_param_one(source, output, current, params_end, meta);
        current = skip_space(source, current);
        if current < params_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                current = skip_space(source, current);
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Extract the @foreign link_name content start after index ('@'), or 0.
let extract_link = std::func(source: addr, index: usize) -> usize {
    let current: usize = index;
    while current < sb_len(source) {
        let byte: i32 = sb_byte_at(source, current);
        if byte == 10 { return 0; }
        if byte == 59 { return 0; }
        if sb_span_equals(source, current, 9, "link_name", 9) {
            let eq: usize = skip_space(source, current + 9);
            if sb_byte_at(source, eq) == 61 {
                let quote: usize = skip_space(source, eq + 1);
                if sb_byte_at(source, quote) == 34 {
                    return quote + 1;
                }
            }
        }
        current = current + 1;
        let marker: i32 = 0;
    }
    return 0;
};

// Emit the extern label (link_name content, main, compiler_compile, f0_).
// Emit a function label.  Module members are prefixed `f0_<mod>_<member>`
// so two modules can use the same member name without colliding; mod_end
// is 0 for top-level functions.
let emit_label = std::func(
    source: addr,
    output: addr,
    name_start: usize,
    name_end: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    prefix: addr,
) -> unit {
    if link != 0 {
        let scan: usize = link;
        while sb_byte_at(source, scan) != 34 {
            sb_append(output, sb_byte_at(source, scan));
            scan = scan + 1;
            let marker: i32 = 0;
        }
        return;
    }
    if sb_len(prefix) != 0 {
        sb_append_literal(output, "f0_", 3);
        sb_append_span(output, prefix, 0, sb_len(prefix));
        sb_append_literal(output, "_", 1);
        sb_append_span(output, source, name_start, name_end - name_start);
        return;
    }
    if mod_end == 0 {
        if sb_span_equals(source, name_start, name_end - name_start, "main", 4) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
        if sb_span_equals(source, name_start, name_end - name_start, "compiler_compile", 16) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
        if sb_span_equals(source, name_start, name_end - name_start, "compiler_compile_library", 24) {
            sb_append_span(output, source, name_start, name_end - name_start);
            return;
        }
    }
    sb_append_literal(output, "f0_", 3);
    if mod_end != 0 {
        sb_append_span(output, source, mod_start, mod_end - mod_start);
        sb_append_literal(output, "_", 1);
    }
    sb_append_span(output, source, name_start, name_end - name_start);
};

// Emit a parameter-name list `%a, %b` from [params_start, params_end).
let emit_param_names = std::func(
    source: addr,
    output: addr,
    params_start: usize,
    params_end: usize,
) -> unit {
    let current: usize = params_start;
    let first: i32 = 1;
    while current < params_end {
        current = skip_space(source, current);
        let name_end: usize = parse_ident(source, current);
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        sb_append_literal(output, "%", 1);
        sb_append_span(output, source, current, name_end - current);
        let colon: usize = scan_top_op(source, current, params_end, 58);
        let type_end: usize = scan_top_op(source, colon + 1, params_end, 44);
        current = type_end;
        if current < params_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Emit an @foreign declaration: the #extern (host link) plus a f0_ wrapper
// that forwards the call so emitted call sites keep the f0_NAME label.
let emit_foreign_wrapper = std::func(
    source: addr,
    output: addr,
    name_start: usize,
    name_end: usize,
    params_start: usize,
    params_end: usize,
    ret_start: usize,
    ret_end: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    prefix: addr,
    meta: addr,
) -> unit {
    let marker: i32 = 0;
    sb_append_literal(output, "#extern #proc ", 14);
    emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
    sb_append_literal(output, "(", 1);
    emit_params2(source, output, params_start, params_end, meta);
    sb_append_literal(output, ") -> ", 5);
    emit_type(source, ret_start, ret_end, output, meta);
    sb_append_literal(output, ";\n\n", 3);
    sb_append_literal(output, "#proc f0_", 9);
    if sb_len(prefix) != 0 {
        sb_append_span(output, prefix, 0, sb_len(prefix));
        sb_append_literal(output, "_", 1);
    }
    if mod_end != 0 {
        sb_append_span(output, source, mod_start, mod_end - mod_start);
        sb_append_literal(output, "_", 1);
    }
    sb_append_span(output, source, name_start, name_end - name_start);
    sb_append_literal(output, "(", 1);
    emit_params2(source, output, params_start, params_end, meta);
    sb_append_literal(output, ") -> ", 5);
    emit_type(source, ret_start, ret_end, output, meta);
    if sb_span_equals(source, ret_start, ret_end - ret_start, "unit", 4) {
        sb_append_literal(output, " {\n  #call ", 11);
        emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
        sb_append_literal(output, "(", 1);
        emit_param_names(source, output, params_start, params_end);
        sb_append_literal(output, ")\n  #return\n}\n\n", 15);
    } else {
        sb_append_literal(output, " {\n  #return #call ", 19);
        emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
        sb_append_literal(output, "(", 1);
        emit_param_names(source, output, params_start, params_end);
        sb_append_literal(output, ")\n}\n\n", 5);
    }
};

// Emit a `let NAME = std::module { ... }` binding: bind the module value
// (kind 2) into the meta table and compile every member.  Members are
// namespace-isolated: functions become f0_<mod>_<member>, constants are
// bound into consts with the module's row recorded, consteval members are
// bound kind 6.  The module value itself is compile-time only, so no
// runtime object is emitted.  Returns the index after the block.
let emit_module = std::func(
    source: addr,
    output: addr,
    index: usize,
    end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let types: addr = sb_new();
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let brace: usize = scan_brace(source, name_start, end);
    let brace_end: usize = match_brace(source, brace, end);
    let mrow: usize = meta_append(meta, 2, name_start, name_end - name_start, brace, 1, 0);
    let empty_prefix: addr = sb_new();
    let body: usize = brace + 1;
    let current: usize = body;
    while current < brace_end {
        let s: usize = skip_space(source, current);
        if s >= brace_end { break; }
        if sb_span_equals(source, s, 3, "let", 3) {
            let eq: usize = scan_top_op(source, s, brace_end, 61);
            let fs: usize = skip_space(source, eq + 1);
            if sb_span_equals(source, fs, 9, "std::func", 9) {
                current = emit_function2(source, output, s, 0, name_start, name_end, mrow, empty_prefix, layout, types, meta, consts);
            } else {
                if sb_span_equals(source, fs, 14, "std::consteval", 14) {
                    current = emit_consteval(source, s, brace_end, meta, mrow);
                } else {
                    let mns: usize = skip_space(source, s + 3);
                    let mne: usize = parse_ident(source, mns);
                    let semi: usize = scan_semi(source, s, brace_end);
                    let crs: usize = trim_start(source, eq + 1, semi);
                    let cre: usize = trim_end(source, crs, semi);
                    // Module member type alias `let NAME: type = TYPE;`
                    // binds a kind-4 row owned by the module.
                    let talias: i32 = 0;
                    let tmark: usize = scan_let_mark(source, mns, semi);
                    if sb_byte_at(source, tmark) == 58 {
                        let ttyp: usize = skip_space(source, tmark + 1);
                        if sb_span_equals(source, ttyp, 4, "type", 4) {
                            let teq: usize = scan_top_op(source, tmark + 1, semi, 61);
                            let tas: usize = trim_start(source, teq + 1, semi);
                            let tae: usize = trim_end(source, tas, semi);
                            meta_append(meta, 4, mns, mne - mns, tas, tae - tas, mrow);
                            talias = 1;
                            let marker: i32 = 0;
                        }
                    }
                    if talias == 0 {
                        let sentinel: usize = 0 - 1;
                        let cv: usize = meta_eval_const(source, crs, cre);
                        if cv != sentinel {
                            meta_append(consts, 1, mns, mne - mns, cv, 0, mrow);
                            let marker: i32 = 0;
                        } else {
                            let tb: i32 = try_bind_module_value(source, s, brace_end, output, layout, types, meta, consts);
                            let marker: i32 = 0;
                        }
                    }
                    current = semi + 1;
                    let marker: i32 = 0;
                }
            }
        } else {
            current = s + 1;
            let marker: i32 = 0;
        }
        let marker: i32 = 0;
    }
    return brace_end + 1;
};

// Emit one top-level function declaration at index ('let').  Returns the
// index after it.  link is the pending @foreign link_name content start
// (0 when none).  mod_start/mod_end name the enclosing module (0/0 for
// top-level functions); module members are emitted as f0_<mod>_<member>.
// mrow is the meta row of the owning module (0 for top-level).  prefix is
// a non-empty buffer when this source is an import library: top-level
// names become f0_<basename>_<name>.
let emit_function2 = std::func(
    source: addr,
    output: addr,
    index: usize,
    link: usize,
    mod_start: usize,
    mod_end: usize,
    mrow: usize,
    prefix: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> usize {
    let types: addr = sb_new();
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let params_start: usize = name_end;
    while sb_byte_at(source, params_start) != 40 {
        params_start = params_start + 1;
        let marker: i32 = 0;
    }
    let params_end: usize = params_start + 1;
    while sb_byte_at(source, params_end) != 41 {
        params_end = params_end + 1;
        let marker: i32 = 0;
    }
    let scan: usize = params_end + 1;
    let body_open: usize = scan;
    while body_open < sb_len(source) {
        let b: i32 = sb_byte_at(source, body_open);
        if b == 33 {
            let eb: usize = body_open + 1;
            while eb < sb_len(source) {
                if sb_byte_at(source, eb) == 123 { break; }
                eb = eb + 1;
                let marker: i32 = 0;
            }
            body_open = match_brace(source, eb, sb_len(source)) + 1;
            let marker: i32 = 0;
        } else {
            if b == 123 { break; }
            if b == 59 { break; }
            body_open = body_open + 1;
            let marker: i32 = 0;
        }
    }
    let arrow: usize = params_end;
    while sb_byte_at(source, arrow) != 62 {
        arrow = arrow + 1;
        let marker: i32 = 0;
    }
    let ret_start: usize = skip_space(source, arrow + 1);
    let ret_end: usize = ret_start;
    while ret_end < body_open {
        let b: i32 = sb_byte_at(source, ret_end);
        if b == 123 { break; }
        if b == 59 { break; }
        if b == 33 { break; }
        ret_end = ret_end + 1;
        let marker: i32 = 0;
    }
    meta_append(meta, 3, name_start, name_end - name_start, body_open, 1, mrow);
    if sb_byte_at(source, body_open) == 59 {
        emit_foreign_wrapper(
            source, output, name_start, name_end,
            params_start + 1, params_end, ret_start, ret_end, link,
            mod_start, mod_end, prefix, meta
        );
        return scan_semi(source, body_open, sb_len(source)) + 1;
    }
    let rtrim: usize = trim_start(source, ret_start, ret_end);
    let rtrim2: usize = trim_end(source, rtrim, ret_end);
    if sb_span_equals(source, rtrim, rtrim2 - rtrim, "Module", 6) {
        return match_brace(source, body_open, sb_len(source)) + 1;
    }
    // Register each parameter's type in the per-function types table so
    // parameter names shadow same-named meta rows (an import alias, a
    // module, ...).  Without this, `effects.keys.length()` in a function
    // whose parameter is also named `effects` resolves the parameter as a
    // module and emits a bogus f0_effects_* call.
    let pcur: usize = params_start + 1;
    while pcur < params_end {
        let pname: usize = skip_space(source, pcur);
        if pname >= params_end { break; }
        let pname_end: usize = parse_ident(source, pname);
        let pcolon: usize = scan_top_op(source, pname, params_end, 58);
        let ptype_s: usize = skip_space(source, pcolon + 1);
        let ptype_e: usize = scan_top_op(source, ptype_s, params_end, 44);
        let pts: usize = trim_start(source, ptype_s, ptype_e);
        let pte: usize = trim_end(source, pts, ptype_e);
        sb_append_span(types, source, pname, pname_end - pname);
        sb_append_literal(types, ":", 1);
        sb_append_span(types, source, pts, pte - pts);
        sb_append_literal(types, "|", 1);
        pcur = ptype_e;
        let marker: i32 = 0;
    }
    sb_append_literal(output, "#proc ", 6);
    emit_label(source, output, name_start, name_end, link, mod_start, mod_end, prefix);
    sb_append_literal(output, "(", 1);
    emit_params2(source, output, params_start + 1, params_end, meta);
    sb_append_literal(output, ") -> ", 5);
    emit_type(source, ret_start, ret_end, output, meta);
    sb_append_literal(output, " {\n", 3);
    emit_block(source, output, body_open + 1, match_brace(source, body_open, sb_len(source)), layout, types, meta, consts);
    sb_append_literal(output, "}\n", 2);
    return match_brace(source, body_open, sb_len(source)) + 1;
};

// Emit a `let NAME: type = std::struct { ... }` binding: record field
// widths/offsets into the layout table.  No LAIN-IR is emitted for the type
// itself.  Returns the index after the declaration.
let emit_record = std::func(
    source: addr,
    output: addr,
    index: usize,
    end: usize,
    layout: addr,
    meta: addr,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let brace: usize = scan_brace(source, name_start, end);
    let brace_end: usize = match_brace(source, brace, end);
    meta_append(meta, 4, name_start, name_end - name_start, brace, 1, 0);
    sb_append_span(layout, source, name_start, name_end - name_start);
    sb_append_literal(layout, ":", 1);
    let body: usize = brace + 1;
    let current: usize = body;
    let offset: usize = 0;
    while current < brace_end {
        let s: usize = skip_space(source, current);
        if s >= brace_end { break; }
        let field_end: usize = parse_ident(source, s);
        let colon: usize = scan_top_op(source, s, brace_end, 58);
        let type_start: usize = skip_space(source, colon + 1);
        let type_end: usize = meta_scan_type_end(source, brace_end, type_start);
        let t: usize = trim_start(source, type_start, type_end);
        let t2: usize = trim_end(source, t, type_end);
        let width: usize = 8;
        if sb_span_equals(source, t, t2 - t, "bool", 4) {
            width = 1;
            let marker: i32 = 0;
        }
        if sb_span_equals(source, t, t2 - t, "i32", 3) {
            width = 4;
            let marker: i32 = 0;
        }
        if sb_span_equals(source, t, t2 - t, "usize", 5) {
            width = 8;
            let marker: i32 = 0;
        }
        // Record whether the field type lowers to an address, so record
        // constructors can store addr-typed values (Memory.String etc.)
        // with the right physical type.  The type span here is a source
        // offset, so meta_type_is_addr is valid on it.
        let faddr: usize = meta_type_is_addr(source, t, t2, meta);
        sb_append_span(layout, source, s, field_end - s);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, offset);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, width);
        sb_append_literal(layout, "#", 1);
        meta_append_decimal(layout, faddr);
        sb_append_literal(layout, "#", 1);
        offset = offset + width;
        current = type_end;
        current = skip_space(source, current);
        if current < brace_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
    sb_append_literal(layout, "=", 1);
    meta_append_decimal(layout, offset);
    sb_append_literal(layout, "|", 1);
    return brace_end + 1;
};

// Is the type span [ts, te) lowered to an address?  Mirrors emit_type's
// decision: `&` references, `addr`, and any type the emitter cannot
// resolve to a scalar bits type (record payloads, cross-module aliases,
// unknown names) are all `addr`; the scalar keywords are bits.
let meta_type_is_addr = std::func(
    source: addr,
    ts: usize,
    te: usize,
    meta: addr,
) -> usize {
    let t: usize = trim_start(source, ts, te);
    let t2: usize = trim_end(source, t, te);
    let first: i32 = sb_byte_at(source, t);
    if first == 38 { return 1; }
    if sb_span_equals(source, t, t2 - t, "addr", 4) { return 1; }
    if sb_span_equals(source, t, t2 - t, "unit", 4) { return 0; }
    if sb_span_equals(source, t, t2 - t, "bool", 4) { return 0; }
    if sb_span_equals(source, t, t2 - t, "usize", 5) { return 0; }
    if sb_span_equals(source, t, t2 - t, "i32", 3) { return 0; }
    let ml: usize = sb_len(meta);
    let tr: usize = meta_lookup(meta, ml, source, t, t2 - t);
    if tr != 0 {
        let tk: usize = meta_value_kind(meta, ml, tr);
        if tk == 4 {
            let ps: usize = meta_value_payload_start(meta, ml, tr);
            let pl: usize = meta_value_payload_length(meta, ml, tr);
            if sb_byte_at(source, ps) != 123 {
                let pe: usize = ps + pl;
                return meta_type_is_addr(source, ps, pe, meta);
            }
            let marker: i32 = 0;
        }
    }
    // Qualified type alias: resolve the module row, then the member, and
    // recurse into the member's payload (mirrors emit_type).  Scan once
    // for the last `.` separator.
    let tscan: usize = t;
    let scan: usize = t;
    while scan < t2 {
        if sb_byte_at(source, scan) == 46 {
            let after: usize = skip_space(source, scan + 1);
            if after < t2 {
                if is_ident_start(sb_byte_at(source, after)) {
                    tscan = after;
                    let marker: i32 = 0;
                }
            }
        }
        scan = scan + 1;
        let marker: i32 = 0;
    }
    if tscan > t {
        let mod_span: usize = t;
        let mod_end: usize = parse_ident(source, mod_span);
        let mrow: usize = meta_lookup_kind(meta, ml, source, mod_span, mod_end - mod_span, 2);
        if mrow != 0 {
            let mkind: usize = meta_value_kind(meta, ml, mrow);
            if mkind == 2 {
                let mem_end: usize = parse_ident(source, tscan);
                let mtr: usize = meta_lookup_qualified(meta, ml, source, tscan, mem_end - tscan, mrow);
                if mtr != 0 {
                    let mtk: usize = meta_value_kind(meta, ml, mtr);
                    if mtk == 4 {
                        let mps: usize = meta_value_payload_start(meta, ml, mtr);
                        let mpl: usize = meta_value_payload_length(meta, ml, mtr);
                        if sb_byte_at(source, mps) != 123 {
                            let mpe: usize = mps + mpl;
                            return meta_type_is_addr(source, mps, mpe, meta);
                        }
                        let marker: i32 = 0;
                    }
                }
            }
        }
    }
    return 1;
};

// Emit a record constructor `Name { f: v, ... }` at [expr_start, expr_end)
// into output as
//   #let %var: addr = #alloca(<size>)
//   #let %v<i>: #bits<W> = <value>
//   #store %v<i>, #lea(base=%var, idx=0, scale=0, offset=<off>)
// for every field; `var` is the binding being assigned.
let emit_record_value = std::func(
    source: addr,
    output: addr,
    var_name_start: usize,
    var_name_end: usize,
    expr_start: usize,
    expr_end: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let name_start: usize = trim_start(source, expr_start, expr_end);
    let name_start2: usize = emit_path_tail(source, name_start, expr_end);
    let name_end: usize = parse_ident(source, name_start2);
    let brace: usize = scan_brace(source, name_end, expr_end);
    let brace_end: usize = match_brace(source, brace, expr_end);
    let len: usize = sb_len(layout);
    let rec: usize = meta_table_find(layout, len, source, name_start2, name_end);
    if rec >= len { return; }
    let seg_end: usize = meta_seg_end(layout, len, rec);
    let size: usize = meta_record_size(layout, rec, seg_end);
    sb_append_literal(output, "#let %", 6);
    sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
    sb_append_literal(output, ": addr = #alloca(", 17);
    meta_append_decimal(output, size);
    sb_append_literal(output, ")\n", 2);
    let body: usize = brace + 1;
    let current: usize = body;
    let index: usize = 0;
    while current < brace_end {
        let fs: usize = skip_space(source, current);
        if fs >= brace_end { break; }
        let fname_end: usize = parse_ident(source, fs);
        let fcolon: usize = scan_top_op(source, fs, brace_end, 58);
        let vstart: usize = skip_space(source, fcolon + 1);
        let vend: usize = meta_scan_type_end(source, brace_end, vstart);
        let off: usize = meta_field_offset(layout, rec, seg_end, source, fs, fname_end);
        let w: usize = meta_field_width(layout, rec, seg_end, source, fs, fname_end);
        let faddr: usize = meta_field_addr(layout, rec, seg_end, source, fs, fname_end);
        sb_append_literal(output, "#let %v", 7);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        // A field whose declared type is pointer-shaped (Memory.String,
        // &mut T, record aliases) stores an address; scalar fields store
        // their byte width.  The addr flag is recorded in the layout table
        // by emit_record, so no type-table lookup is needed here.
        if faddr == 1 {
            sb_append_literal(output, ": addr = ", 9);
        } else {
            sb_append_literal(output, ": #bits<", 8);
            meta_emit_bits(output, w);
            sb_append_literal(output, "> = ", 4);
        }
        emit_expr(source, vstart, vend, output, layout, types, meta, consts);
        sb_append_literal(output, "\n", 1);
        sb_append_literal(output, "#store %v", 9);
        meta_append_decimal(output, expr_start);
        sb_append_literal(output, "_", 1);
        meta_append_decimal(output, index);
        sb_append_literal(output, ", #lea(base=%", 13);
        sb_append_span(output, source, var_name_start, var_name_end - var_name_start);
        sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
        meta_append_decimal(output, off);
        sb_append_literal(output, ")\n", 2);
        current = vend;
        current = skip_space(source, current);
        if current < brace_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        index = index + 1;
        let marker: i32 = 0;
    }
};

// Bind a compile-time function declaration
// `let NAME = std::consteval(params) -> T { body }` into the meta table
// (kind 6) without emitting any product.  Payload: params_start, body_open.
// mrow is the owning module's meta row (0 for top-level).
let emit_consteval = std::func(
    source: addr,
    index: usize,
    end: usize,
    meta: addr,
    mrow: usize,
) -> usize {
    let name_start: usize = skip_space(source, index + 3);
    let name_end: usize = parse_ident(source, name_start);
    let params_start: usize = name_end;
    while sb_byte_at(source, params_start) != 40 {
        params_start = params_start + 1;
        let marker: i32 = 0;
    }
    let params_end: usize = params_start + 1;
    while sb_byte_at(source, params_end) != 41 {
        params_end = params_end + 1;
        let marker: i32 = 0;
    }
    let scan: usize = params_end + 1;
    let body_open: usize = scan;
    while body_open < end {
        let b: i32 = sb_byte_at(source, body_open);
        if b == 123 { break; }
        if b == 59 { break; }
        body_open = body_open + 1;
        let marker: i32 = 0;
    }
    meta_append(meta, 6, name_start, name_end - name_start, params_start, body_open, mrow);
    if sb_byte_at(source, body_open) == 123 {
        return match_brace(source, body_open, end) + 1;
    }
    return scan_semi(source, body_open, end) + 1;
};

// Detect a top-level consteval call `let NAME = CV(args);` with the
// expression [crs, cre) and alias [cns, cne): evaluate and bind into
// consts.  Returns 1 when bound.
let try_consteval_call = std::func(
    source: addr,
    crs: usize,
    cre: usize,
    cns: usize,
    cne: usize,
    meta: addr,
    consts: addr,
    sentinel: usize,
) -> i32 {
    let cne2: usize = parse_ident(source, crs);
    let csep: usize = skip_space(source, cne2);
    let cmod_row: usize = 0;
    let cmem_start: usize = crs;
    let cmem_end: usize = cne2;
    if sb_byte_at(source, csep) == 46 {
        let cnext: usize = skip_space(source, csep + 1);
        if is_ident_start(sb_byte_at(source, cnext)) {
            let mlen3: usize = sb_len(meta);
            let mrow4: usize = meta_lookup(meta, mlen3, source, crs, cne2 - crs);
            if mrow4 != 0 {
                let mk4: usize = meta_value_kind(meta, mlen3, mrow4);
                if mk4 == 2 {
                    cmod_row = mrow4;
                    cmem_start = cnext;
                    cmem_end = parse_ident(source, cnext);
                    let marker: i32 = 0;
                }
            }
        }
    }
    if sb_byte_at(source, cmem_end) != 40 { return 0; }
    let mlen2: usize = sb_len(meta);
    let crow2: usize = 0;
    if cmod_row != 0 {
        crow2 = meta_lookup_qualified(meta, mlen2, source, cmem_start, cmem_end - cmem_start, cmod_row);
    } else {
        crow2 = meta_lookup(meta, mlen2, source, cmem_start, cmem_end - cmem_start);
    }
    if crow2 == 0 { return 0; }
    let ck: usize = meta_value_kind(meta, mlen2, crow2);
    if ck != 6 { return 0; }
    let aend: usize = cmem_end + 1;
    let adepth: usize = 1;
    let adone: usize = 0;
    while adone == 0 {
        if sb_byte_at(source, aend) == 41 {
            adepth = adepth - 1;
            if adepth == 0 {
                adone = 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        } else {
            if sb_byte_at(source, aend) == 40 {
                adepth = adepth + 1;
                aend = aend + 1;
                let marker: i32 = 0;
            } else {
                aend = aend + 1;
                let marker: i32 = 0;
            }
        }
    }
    let outer0: addr = sb_new();
    let cv2: usize = meta_call_consteval(source, meta, mlen2, crow2, cmem_end + 1, aend, consts, 1, outer0);
    if cv2 != sentinel {
        meta_append(consts, 1, cns, cne - cns, cv2, 0, 0);
        return 1;
    }
    return 0;
};

// Compile one source program into LAIN-IR text appended to output, sharing
// the session tables (layout/types/meta/consts).  prefix is a non-empty
// buffer when this source is an import library: top-level names are
// emitted as f0_<basename>_<name>.  Returns 0 on success.
let compile_source = std::func(
    source: addr,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
    prefix: addr,
    seg_begin: usize,
    seg_end2: usize,
) -> i32 {
    let index: usize = seg_begin;
    let length: usize = seg_end2;
    let link: usize = 0;
    while index < length {
        index = skip_space(source, index);
        if index >= length { break; }
        let first: i32 = sb_byte_at(source, index);
        if first == 47 {
            while index < length {
                if sb_byte_at(source, index) == 10 { break; }
                index = index + 1;
                let marker: i32 = 0;
            }
            let marker: i32 = 0;
        } else {
            if first == 64 {
                link = extract_link(source, index);
                while index < length {
                    if sb_byte_at(source, index) == 10 { break; }
                    index = index + 1;
                    let marker: i32 = 0;
                }
                let marker: i32 = 0;
            } else {
                if sb_span_equals(source, index, 3, "let", 3) {
                    let eq: usize = scan_top_op(source, index, length, 61);
                    let func_start: usize = skip_space(source, eq + 1);
                    if sb_span_equals(source, func_start, 6, "import", 6) {
                        index = bind_import(source, index, length, meta);
                    } else {
                    if sb_span_equals(source, func_start, 11, "std::struct", 11) {
                        index = emit_record(source, output, index, length, layout, meta);
                    } else {
                        if sb_span_equals(source, func_start, 14, "std::consteval", 14) {
                            index = emit_consteval(source, index, length, meta, 0);
                        } else {
                            if sb_span_equals(source, func_start, 11, "std::module", 11) {
                            index = emit_module(source, output, index, length, layout, types, meta, consts);
                        } else {
                            if sb_span_equals(source, func_start, 9, "std::func", 9) {
                                index = emit_function2(source, output, index, link, 0, 0, 0, prefix, layout, types, meta, consts);
                                link = 0;
                        } else {
                            let semi: usize = scan_semi(source, index, length);
                            let cns: usize = skip_space(source, index + 3);
                            let cne: usize = parse_ident(source, cns);
                            let crs: usize = trim_start(source, eq + 1, semi);
                            let cre: usize = trim_end(source, crs, semi);
                            // Top-level type alias `let NAME: type = TYPE;`:
                            // bind a kind-4 meta row (payload = the type
                            // span) so emit_type can resolve it.
                            let tmark: usize = scan_let_mark(source, cns, semi);
                            if sb_byte_at(source, tmark) == 58 {
                                let ttyp: usize = skip_space(source, tmark + 1);
                                if sb_span_equals(source, ttyp, 4, "type", 4) {
                                    let teq: usize = scan_top_op(source, tmark + 1, semi, 61);
                                    let tas: usize = trim_start(source, teq + 1, semi);
                                    let tae: usize = trim_end(source, tas, semi);
                                    meta_append(meta, 4, cns, cne - cns, tas, tae - tas, 0);
                                    let marker: i32 = 0;
                                }
                            }
                            let sentinel: usize = 0 - 1;
                            let cval: usize = meta_eval_const(source, crs, cre);
                            if cval != sentinel {
                                meta_append(consts, 1, cns, cne - cns, cval, 0, 0);
                                let marker: i32 = 0;
                            } else {
                                let env2: addr = sb_new();
                                meta_consteval_copy_consts(consts, env2);
                                let cval2: usize = meta_eval_nested(source, crs, cre, env2);
                                if cval2 != sentinel {
                                    meta_append(consts, 1, cns, cne - cns, cval2, 0, 0);
                                    let marker: i32 = 0;
                                } else {
                                    let tb: i32 = try_bind_module_value(source, index, length, output, layout, types, meta, consts);
                                    if tb == 0 {
                                        let tc: i32 = try_consteval_call(source, crs, cre, cns, cne, meta, consts, sentinel);
                                        let marker: i32 = 0;
                                    }
                                    let marker: i32 = 0;
                                }
                            }
                            index = semi + 1;
                            let marker: i32 = 0;
                        }
                    }
                }
                }
                    }
            } else {
                index = index + 1;
                let marker: i32 = 0;
            }
        }
    }
    }
    return 0;
};

// Compile the source program into LAIN-IR text.  Returns 0 on success.
let compile = std::func(
    source: addr,
    output: addr,
) -> i32 {
    let layout: addr = sb_new();
    let types: addr = sb_new();
    let meta: addr = sb_new();
    let consts: addr = sb_new();
    let empty_prefix: addr = sb_new();
    let src_len: usize = sb_len(source);
    let status: i32 = compile_source(source, output, layout, types, meta, consts, empty_prefix, 0, src_len);
    let marker: i32 = 0;
    return status;
};

// Compile the hard-coded add+main source and return the emitted LAIN-IR.
let emit = std::func() -> addr {
    let source: addr = sb_new();
    sb_append_literal(
        source,
        "let add = std::func(x: i32, y: i32) -> i32 {\n    return x + y;\n};\nlet main = std::func() -> i32 {\n    return add(40, 2);\n};",
        123,
    );
    let output: addr = sb_new();
    let status: i32 = compile(source, output);
    let marker: i32 = 0;
    return output;
};

// Write a buffer's bytes to the artifact stream.
let write_buffer_to_artifact = std::func(buf: addr) -> unit {
    let index: usize = 0;
    let length: usize = sb_len(buf);
    while index < length {
        artifact_write_byte(sb_byte_at(buf, index));
        index = index + 1;
        let marker: i32 = 0;
    }
};

// Compile and write the emitted LAIN-IR to the artifact stream.
// The artifact (product.l1) is then verified and executed by the harness.
let main = std::func() -> i32 {
    let emitted: addr = emit();
    let marker: i32 = 0;
    artifact_begin();
    write_buffer_to_artifact(emitted);
    artifact_finish();
    return 0;
};

// compiler_compile entry: compile the first host source and write the
// artifact.  Returns the compile status.
let compiler_compile = std::func() -> i32 {
    let source: addr = sb_from_source();
    let output: addr = sb_new();
    let status: i32 = compile(source, output);
    let marker: i32 = 0;
    artifact_begin();
    write_buffer_to_artifact(output);
    artifact_finish();
    return status;
};

// Append host source `idx` to the shared big buffer; returns the new
// buffer length.
let append_source_to_big = std::func(big: addr, idx: usize) -> usize {
    let src: addr = sb_from_source_index(idx);
    let i6: usize = 0;
    while i6 < sb_len(src) {
        sb_append(big, sb_byte_at(src, i6));
        i6 = i6 + 1;
        let marker: i32 = 0;
    }
    let marker: i32 = 0;
    return sb_len(big);
};

// compiler_compile_library entry: compile every host source as one library
// session.  All sources are concatenated into one shared source buffer so
// meta-table name offsets are globally consistent across files; sources
// before the last are import libraries (top-level names get the
// source-basename prefix f0_<basename>_<name>), the last is the entry (no
// prefix).  Sources must be ordered dependency-first.  The product is a
// single LAIN-IR artifact.
let compiler_compile_library = std::func() -> i32 {
    let count: usize = source_count();
    let layout: addr = sb_new();
    let types: addr = sb_new();
    let meta: addr = sb_new();
    let consts: addr = sb_new();
    let output: addr = sb_new();
    let big: addr = sb_new();
    let empty_prefix: addr = sb_new();
    let cursor: usize = 0;
    let idx: usize = 0;
    let status: i32 = 0;
    while idx < count {
        let seg_begin: usize = cursor;
        let seg_end2: usize = append_source_to_big(big, idx);
        cursor = seg_end2;
        if idx + 1 < count {
            let prefix2: addr = source_basename(idx);
            status = compile_source(big, output, layout, types, meta, consts, prefix2, seg_begin, seg_end2);
            let marker: i32 = 0;
        } else {
            status = compile_source(big, output, layout, types, meta, consts, empty_prefix, seg_begin, seg_end2);
            let marker: i32 = 0;
        }
        idx = idx + 1;
        let marker: i32 = 0;
    }
    artifact_begin();
    write_buffer_to_artifact(output);
    artifact_finish();
    return status;
};

