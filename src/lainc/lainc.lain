let emit_meta_eval_syntax_expr_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#proc f0_Meta_eval_syntax_expr(addr %unit, #bits<64> %id, #bits<32> %parameter, #bits<64> %depth) -> addr {\n#if #ge(%depth, 128) {\n#return #call f0_Meta_direct_result_new(7108, 0)\n}\n#if #ge(%id, #call f0_Vec_length(#load[addr](#lea(base=%unit, idx=0, scale=0, offset=8)))) {\n#return #call f0_Meta_direct_result_new(7104, 0)\n}\n#let %expression: addr = #call f0_Vec_get(#load[addr](#lea(base=%unit, idx=0, scale=0, offset=8)), %id)\n#let %kind: #bits<32> = #load[#bits<32>](#lea(base=%expression, idx=0, scale=0, offset=0))\n#if #eq(%kind, 1) {\n#return #call f0_Meta_direct_result_new(0, #load[#bits<32>](#lea(base=%expression, idx=0, scale=0, offset=40)))\n}\n#if #eq(%kind, 2) {\n#if #ne(#load[#bits<64>](#lea(base=%expression, idx=0, scale=0, offset=32)), 0) {\n#return #call f0_Meta_direct_result_new(7105, 0)\n}\n#return #call f0_Meta_direct_result_new(0, %parameter)\n}\n#if #ge(%kind, 3) {\n#if #le(%kind, 11) {\n#let %left: addr = #call f0_Meta_eval_syntax_expr(%unit, #load[#bits<64>](#lea(base=%expression, idx=0, scale=0, offset=16)), %parameter, #add(%depth, 1))\n#if #ne(#call f0_Meta_result_status(%left), 0) {\n#return %left\n}\n#let %right: addr = #call f0_Meta_eval_syntax_expr(%unit, #load[#bits<64>](#lea(base=%expression, idx=0, scale=0, offset=24)), %parameter, #add(%depth, 1))\n#if #ne(#call f0_Meta_result_status(%right), 0) {\n#return %right\n}\n#let %a: #bits<32> = #call f0_Meta_result_value(%left)\n#let %b: #bits<32> = #call f0_Meta_result_value(%right)\n#let %value: #bits<32> = 0\n#if #eq(%kind, 3) { %value = #add(%a, %b) }\n#if #eq(%kind, 4) { %value = #sub(%a, %b) }\n#if #eq(%kind, 5) { %value = #mul(%a, %b) }\n#if #eq(%kind, 6) { %value = #eq(%a, %b) }\n#if #eq(%kind, 7) { %value = #ne(%a, %b) }\n#if #eq(%kind, 8) { %value = #lt(%a, %b) }\n#if #eq(%kind, 9) { %value = #le(%a, %b) }\n#if #eq(%kind, 10) { %value = #gt(%a, %b) }\n#if #eq(%kind, 11) { %value = #ge(%a, %b) }\n#return #call f0_Meta_direct_result_new(0, %value)\n}\n}\n#return #call f0_Meta_direct_result_new(7104, 0)\n}\n", 1985);
};

let emit_meta_invoke_syntax_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#if #eq(#load[#bits<64>](#lea(base=%program, idx=0, scale=0, offset=0)), 0) {\n#return #call f0_Meta_expansion_make(2908, 0)\n}\n", 126);
    sb_append_literal(output, "#if #ne(%callable, 0) {\n#return #call f0_Meta_expansion_make(2902, 0)\n}\n", 72);
    sb_append_literal(output, "#if #ne(#load[#bits<64>](#lea(base=%program, idx=0, scale=0, offset=56)), #call f0_Meta_callable_phase_syntax()) {\n#return #call f0_Meta_expansion_make(2907, 0)\n}\n", 163);
    sb_append_literal(output, "#let %procedure: #bits<64> = #load[#bits<64>](#lea(base=%program, idx=0, scale=0, offset=48))\n#let %body: #bits<64> = #call f0_Model_unit_procedure_body(%unit, %procedure)\n#let %expression: #bits<64> = #call f0_Model_unit_region_first_expression(%unit, %body)\n", 260);
    sb_append_literal(output, "#let %target: #bits<64> = #load[#bits<64>](#lea(base=%invocation, idx=0, scale=0, offset=16))\n#let %result: addr = #call f0_Meta_eval_syntax_expr(%unit, %expression, #trunc[#bits<32>](%target), 0)\n#if #ne(#call f0_Meta_result_status(%result), 0) {\n#return #call f0_Meta_expansion_make(#call f0_Meta_result_status(%result), 0)\n}\n", 328);
    sb_append_literal(output, "#let %returned: #bits<64> = #zext[#bits<64>](#call f0_Meta_result_value(%result))\n#if #eq(%returned, #call f0_Syntax_invalid_node()) {\n#return #call f0_Meta_expansion_make(2905, 0)\n}\n#let %output: addr = #call f0_GeneratedSyntax_empty_list(%builder)\n#let %cursor: #bits<64> = %returned\n#let %count: #bits<64> = 0\n", 311);
    sb_append_literal(output, "#loop {\n#if #ge(%count, 64) {\n#return #call f0_Meta_expansion_make(2904, 0)\n}\n#if #eq(%cursor, #call f0_Syntax_invalid_node()) {\n#break\n}\n#let %store: addr = #load[addr](#lea(base=%builder, idx=0, scale=0, offset=0))\n#let %source_unit: addr = #call f0_Vec_get(#load[addr](#lea(base=%store, idx=0, scale=0, offset=0)), #load[#bits<64>](#lea(base=%context, idx=0, scale=0, offset=8)))\n#let %nodes: addr = #load[addr](#lea(base=%source_unit, idx=0, scale=0, offset=8))\n#if #ge(%cursor, #call f0_Vec_length(%nodes)) {\n#return #call f0_Meta_expansion_make(2905, 0)\n}\n#let %clone: #bits<64> = #call f0_GeneratedSyntax_clone_from(%builder, #load[#bits<64>](#lea(base=%context, idx=0, scale=0, offset=8)), %cursor, 1)\n#call f0_GeneratedSyntax_append(%builder, %output, %clone)\n#let %source_node: addr = #call f0_Syntax_node(%store, #load[#bits<64>](#lea(base=%context, idx=0, scale=0, offset=8)), %cursor)\n%cursor = #load[#bits<64>](#lea(base=%source_node, idx=0, scale=0, offset=36))\n%count = #add(%count, 1)\n#continue\n}\n", 1012);
    sb_append_literal(output, "#let %expansion: addr = #call bootstrap.allocate-pages(40)\n#store[addr] %output, #lea(base=%expansion, idx=0, scale=0, offset=0)\n#store[#bits<64>] 0, #lea(base=%expansion, idx=0, scale=0, offset=8)\n#store[#bits<64>] 0, #lea(base=%expansion, idx=0, scale=0, offset=16)\n#store[#bits<64>] #load[#bits<64>](#lea(base=%output, idx=0, scale=0, offset=24)), #lea(base=%expansion, idx=0, scale=0, offset=24)\n#store[#bits<32>] 0, #lea(base=%expansion, idx=0, scale=0, offset=32)\n#return %expansion\n}\n", 489);
};

