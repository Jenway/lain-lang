// src/lainc/lainc.lain — M0/M1: Lain-written lainc.
//
// Compiles the smallest Lain subset into LAIN-IR text:
//   let main = std::func() -> i32 { return N; };
// -> #proc main() -> #bits<32> { #return N }
//
// Frozen-lainc workarounds observed during M0:
//   - a non-root function whose first statement is a call has its body
//     truncated (lead every function with a `let`)
//   - a call as the final statement of an if branch becomes a `return`
//     (follow such calls with a `let`)
//   - addr+usize arithmetic needs the #lea path (fixed in frozen lainc)
//   - string literals are passed as (addr, length); lengths must be exact
//
// Entry points:
//   emit() -> String : compile the hard-coded source, return the LAIN-IR
//   main() -> i32    : compile and verify the emitted text inside Lain

let string_mod: Module = import("std::core::string");
let bounds: Module = import("std::bounds");
let arena: Module = import("std::core::arena_min");
let String: type = string_mod.string.String(
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);

// Append a literal byte string to a String.
let append_literal = std::func(
    output: &mut String,
    literal: addr,
    length: usize,
) -> unit {
    let index: usize = 0;
    while index < length {
        String.append_byte(
            output,
            std::load_bits(8, literal + index),
        );
        index = index + 1;
    }
};

// Does the source contain the word "return" starting at index?
let is_return_at = std::func(
    source: &String,
    index: usize,
) -> bool {
    if String.byte_at(source, index) != 114 { return false; }
    if String.byte_at(source, index + 1) != 101 { return false; }
    if String.byte_at(source, index + 2) != 116 { return false; }
    if String.byte_at(source, index + 3) != 117 { return false; }
    if String.byte_at(source, index + 4) != 114 { return false; }
    if String.byte_at(source, index + 5) != 110 { return false; }
    return true;
};

// Scan the source for the decimal digits of the return value and emit
// a minimal LAIN-IR procedure into output.  Returns the digit count.
let compile = std::func(
    source: &String,
    output: &mut String,
) -> i32 {
    let digits: i32 = 0;
    append_literal(output, "#proc main() -> #bits<32> {\n  #return ", 38);
    let index: usize = 0;
    let length: usize = String.length(source);
    let capturing: i32 = 0;
    while index < length {
        let byte: i32 = String.byte_at(source, index);
        if capturing == 0 {
            if is_return_at(source, index) {
                capturing = 1;
                let marker: i32 = 0;
            }
        } else {
            if byte >= 48 && byte <= 57 {
                String.append_byte(output, byte);
                digits = digits + 1;
                let marker: i32 = 0;
            }
        }
        index = index + 1;
        let marker2: i32 = 0;
    }
    append_literal(output, "\n}\n", 3);
    return digits;
};

// Compile the hard-coded return_42 source and return the emitted LAIN-IR
// text.  This entry is exercised by `lainir-seed run src_lainc.l1 emit`,
// which prints the String result.
let emit = std::func() -> String {
    let source: String = String.new();
    append_literal(
        &mut source,
        "let main = std::func() -> i32 { return 42; };",
        45,
    );
    let output: String = String.new();
    let digits: i32 = compile(&source, &mut output);
    let marker: i32 = 0;
    return output;
};

// Compile and verify the emitted text inside the Lain layer.
// Return codes: 1 = emitted text matches expectations exactly.
let main = std::func() -> i32 {
    let emitted: String = emit();
    if String.equal_literal(
        &emitted,
        "#proc main() -> #bits<32> {\n  #return 42\n}\n",
        43,
    ) {
        return 1;
    }
    return 0;
};
