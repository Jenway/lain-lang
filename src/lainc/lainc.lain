        if sb_span_equals(source, ts, ane - ts, "mapping", 7)
            || sb_span_equals(source, ts, ane - ts, "unit", 4) {
            sb_append_literal(output, "%", 1);
            sb_append_span(output, source, ts, ane - ts);
            return arg_end;
        }
    }
    if sb_byte_at(source, aaf) == 46 {
        let method_start: usize = emit_path_tail(source, ts, arg_end);
        let method_end: usize = parse_ident(source, method_start);
        let method_after: usize = skip_space(source, method_end);
        if sb_byte_at(source, method_after) == 40 {
            if sb_span_equals(
                source, method_start, method_end - method_start, "get", 3
            ) {
                sb_append_literal(output, "#int2ptr(0)", 11);
                return arg_end;
            }
            if sb_span_equals(
                source, method_start, method_end - method_start, "get_mut", 7
            ) {
                sb_append_literal(output, "#int2ptr(0)", 11);
                return arg_end;
            }
        }
        let tlen: usize = sb_len(types);
        let trec: usize = meta_table_find(types, tlen, source, ts, ane);
        let resolvable: usize = 0;
        if trec < tlen {
            let tseg: usize = meta_seg_end(types, tlen, trec);
            let llen: usize = sb_len(layout);
            let lrec: usize = layout_find_for_type(layout, types, trec, tseg);
            if lrec < llen {
                resolvable = 1;
                let marker: i32 = 0;
            }
        }
        if resolvable == 0 {
            let afin: usize = emit_path_tail(source, ts, arg_end);
            let afend: usize = parse_ident(source, afin);
            let afaf: usize = skip_space(source, afend);
            // An unresolved element-access argument (store.arguments.get(i),
            // effects.keys.get_mut(i), ...) returns an address in the
            // archive, so a bare 0 would not type-check against an addr
            // parameter.  Lower those to #int2ptr(0).  get()/get_mut()
            // are the vector accessors; other method chains (byte_at,
            // length, ...) stay 0.
            if sb_byte_at(source, afaf) == 40 {
                let mname_s: usize = afin;
                let mname_e: usize = afend;
                let is_get: usize = 0;
                if sb_span_equals(source, mname_s, mname_e - mname_s, "get", 3) {
                    is_get = 1;
                    let marker: i32 = 0;
                }
                if sb_span_equals(source, mname_s, mname_e - mname_s, "get_mut", 7) {
                    is_get = 1;
                    let marker: i32 = 0;
                }
                if is_get == 1 {
                    sb_append_literal(output, "#int2ptr(0)", 11);
                    return arg_end;
                }
                let marker: i32 = 0;
            }
            if sb_byte_at(source, afaf) != 40 {
                // A qualified record literal whose specialized layout is not
                // available in this compilation unit still has address
                // shape.  Preserve that shape with a small temporary rather
                // than leaking the module name as an undefined value (for
                // example `Lex.Span { ... }` in the core parser).
                if sb_byte_at(source, afaf) == 123 {
                    sb_append_literal(output, "#alloca(1)", 10);
                    return arg_end;
                }
                let mlen8: usize = sb_len(meta);
                let mrow8: usize = meta_lookup(meta, mlen8, source, ts, ane - ts);
                if mrow8 != 0 {
                    let mk8: usize = meta_value_kind(meta, mlen8, mrow8);
                    if mk8 == 2 {
                        sb_append_literal(output, "#alloca(1)", 10);
                        return arg_end;
                    }
                }
                sb_append_literal(output, "%", 1);
                sb_append_span(output, source, ts, ane - ts);
                return arg_end;
            }
        }
    }
    emit_expr(source, arg_start, arg_end, output, layout, types, meta, consts);
    return arg_end;
};

// Emit the argument list (args_start, args_end) with each argument lowered.
let emit_call_args = std::func(
    source: addr,
    args_start: usize,
    args_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let current: usize = args_start;
    let first: i32 = 1;
    while current < args_end {
        let arg_start: usize = skip_space(source, current);
        if arg_start >= args_end { break; }
        if first == 1 {
            first = 0;
        } else {
            sb_append_literal(output, ", ", 2);
        }
        current = emit_arg_one(source, arg_start, args_end, output, layout, types, meta, consts);
        current = skip_space(source, current);
        if current < args_end {
            if sb_byte_at(source, current) == 44 {
                current = current + 1;
                let marker: i32 = 0;
            }
        }
        let marker: i32 = 0;
    }
};

// Return the start of the last segment of a qualified path `a.b.c` /
// `a::b`, or the original start when there is no path.  Module members are
// emitted as f0_<member>, so call sites use the last segment as the callee.
let emit_path_tail = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let tail: usize = start;
    let scan: usize = parse_ident(source, start);
    let done: i32 = 0;
    while done == 0 {
        let sep: usize = skip_space(source, scan);
        if sep >= end {
            done = 1;
            let marker: i32 = 0;
        } else {
            let b: i32 = sb_byte_at(source, sep);
            if b == 46 {
                let next: usize = skip_space(source, sep + 1);
                if next < end {
                    if is_ident_start_at(source, next) {
                        tail = next;
                        scan = parse_ident(source, next);
                        let marker: i32 = 0;
                    } else {
                        done = 1;
                        let marker: i32 = 0;
                    }
                } else {
                    done = 1;
                    let marker: i32 = 0;
                }
            } else {
                if b == 58 {
                    if sb_byte_at(source, sep + 1) == 58 {
                        let next: usize = skip_space(source, sep + 2);
                        if next < end {
                            if is_ident_start_at(source, next) {
                                tail = next;
                                scan = parse_ident(source, next);
                                let marker: i32 = 0;
                            } else {
                                done = 1;
                                let marker: i32 = 0;
                            }
                        } else {
                            done = 1;
                            let marker: i32 = 0;
                        }
                    } else {
                        done = 1;
                        let marker: i32 = 0;
                    }
                } else {
                    done = 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    return tail;
};

// Emit a call NAME(args) where name spans [name_start, name_end).
// mod_start/mod_end name the module the member belongs to (0/0 for
// top-level functions), producing #call f0_<mod>_<member>.
let emit_call_named = std::func(
    source: addr,
    name_start: usize,
    name_end: usize,
    mod_start: usize,
    mod_end: usize,
    args_start: usize,
    args_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> unit {
    let marker: i32 = 0;
    // Archive Meta uses the same allocator capability as the self-hosting
    // compiler.  The archive foreign-attribute path currently records the
    // extern but can miss its f0_ forwarding wrapper, so lower this one
    // canonical capability directly at call sites.
    if sb_span_equals(source, name_start, name_end - name_start, "allocate_pages", 14) {
        sb_append_literal(output, "#call bootstrap.allocate-pages(", 31);
        emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return;
    }
    sb_append_literal(output, "#call f0_", 9);
        if mod_end != 0 {
        if sb_span_equals(source, mod_start, mod_end - mod_start, "TypeMap", 7)
            && sb_span_equals(source, name_start, name_end - name_start, "new", 3) {
            sb_append_literal(output, "Vec_new(", 8);
            emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
            sb_append_literal(output, ")", 1);
            return;
        }
        if sb_span_equals(source, mod_start, mod_end - mod_start, "api", 3) {
            // `api` is the local alias for the public compiler API module.
            // Its specialized archive namespace is `f0_API_*`.
            sb_append_literal(output, "API_", 4);
            sb_append_span(output, source, name_start, name_end - name_start);
            sb_append_literal(output, "(", 1);
            emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
            sb_append_literal(output, ")", 1);
            return;
        } else {
        // `Generated` is the local alias bound to the
        // `generated_syntax.GeneratedSyntax(Memory)` factory instance.  Its
        // physical procedure namespace keeps the concrete factory name.
        if sb_span_equals(source, mod_start, mod_end - mod_start, "Generated", 9) {
            sb_append_literal(output, "GeneratedSyntax", 15);
        } else {
        // The public compiler factory is commonly bound as lowercase
        // `compiler`, while its emitted namespace is the canonical factory
        // name `Compiler`.
        if sb_span_equals(source, mod_start, mod_end - mod_start, "compiler", 8) {
            sb_append_literal(output, "Compiler", 8);
        } else {
            let mod_len: usize = mod_end - mod_start;
            let mod_tail: usize = emit_path_tail(source, mod_start, mod_end);
            let mod_tail_end: usize = parse_ident(source, mod_tail);
            if sb_span_equals(source, mod_tail, mod_tail_end - mod_tail, "memory", 6) {
                sb_append_literal(output, "memory", 6);
            } else if mod_len >= 6
                && sb_byte_at(source, mod_end - 6) == 86
                && sb_byte_at(source, mod_end - 5) == 101
                && sb_byte_at(source, mod_end - 4) == 99
                && sb_byte_at(source, mod_end - 3) == 116
                && sb_byte_at(source, mod_end - 2) == 111
                && sb_byte_at(source, mod_end - 1) == 114 {
                sb_append_literal(output, "Vec", 3);
            } else {
                sb_append_span(output, source, mod_start, mod_end - mod_start);
            }
        }
        }
        sb_append_literal(output, "_", 1);
        }
    }
    sb_append_span(output, source, name_start, name_end - name_start);
    sb_append_literal(output, "(", 1);
    emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
    sb_append_literal(output, ")", 1);
};

// Emit std::load_bits / std::store_bits; returns true when handled.
let emit_std_intrinsic = std::func(
    source: addr,
    name_start: usize,
    name_end: usize,
    expr_end: usize,
    output: addr,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> bool {
    let after: usize = skip_space(source, name_end);
    if sb_byte_at(source, after) != 58 { return 0; }
    let member: usize = skip_space(source, after + 2);
    let member_end: usize = parse_ident(source, member);
    if sb_byte_at(source, member_end) != 40 { return 0; }
    let args_start: usize = member_end + 1;
    let args_end: usize = args_start;
    let depth: usize = 0;
    while args_end < expr_end {
        let byte: i32 = sb_byte_at(source, args_end);
        if byte == 34 {
            args_end = skip_string(source, args_end);
            let marker: i32 = 0;
        } else {
            if byte == 40 {
                depth = depth + 1;
                args_end = args_end + 1;
                let marker: i32 = 0;
            } else {
                if byte == 41 {
                    if depth == 0 { break; }
                    depth = depth - 1;
                    args_end = args_end + 1;
                    let marker: i32 = 0;
                } else {
                    args_end = args_end + 1;
                    let marker: i32 = 0;
                }
            }
        }
    }
    // Address-valued stores need an explicit physical type. Keep this as a
    // distinct source intrinsic so lowering remains stable even when the
    // enclosing function's parameter table is unavailable during self-hosting.
    if sb_span_equals(source, member, member_end - member, "store_addr", 10) {
        let address_start: usize = skip_space(source, args_start);
        let address_mid: usize = address_start;
        let address_depth: usize = 0;
        let address_done: i32 = 0;
        while address_done == 0 {
            if address_mid < args_end {
                let b: i32 = sb_byte_at(source, address_mid);
                if b == 40 {
                    address_depth = address_depth + 1;
                    address_mid = address_mid + 1;
                    let marker: i32 = 0;
                } else if b == 41 {
                    address_depth = address_depth - 1;
                    address_mid = address_mid + 1;
                    let marker: i32 = 0;
                } else if address_depth == 0 && b == 44 {
                    address_done = 1;
                    let marker: i32 = 0;
                } else {
                    address_mid = address_mid + 1;
                    let marker: i32 = 0;
                }
            } else {
                address_done = 1;
                let marker: i32 = 0;
            }
        }
        let value_start: usize = skip_space(source, address_mid + 1);
        let value_end: usize = trim_end(source, value_start, args_end);
        sb_append_literal(output, "#store[addr] ", 13);
        emit_expr(source, value_start, value_end, output, layout, types, meta, consts);
        sb_append_literal(output, ", ", 2);
        emit_addr_expr(source, address_start, address_mid, output, layout, types);
        return 1;
    }
    let is_udiv: bool = sb_span_equals(
        source, member, member_end - member, "udiv", 4
    );
    let is_urem: bool = sb_span_equals(
        source, member, member_end - member, "urem", 4
    );
    if is_udiv {
        sb_append_literal(output, "#udiv(", 6);
        emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return 1;
    }
    if is_urem {
        sb_append_literal(output, "#urem(", 6);
        emit_call_args(source, args_start, args_end, output, layout, types, meta, consts);
        sb_append_literal(output, ")", 1);
        return 1;
    }
    if sb_span_equals(source, member, member_end - member, "load_bits", 9) {
        let width_start: usize = skip_space(source, args_start);
        let width_end: usize = width_start;
        let width_done: i32 = 0;
        while width_done == 0 {
            if width_end < args_end {
                if sb_byte_at(source, width_end) == 44 {
                    width_done = 1;
                    let marker: i32 = 0;
                } else {
                    width_end = width_end + 1;
                    let marker: i32 = 0;
                }
            } else {
                width_done = 1;
                let marker: i32 = 0;
            }
        }
        let addr_start: usize = skip_space(source, width_end + 1);
        let addr_end: usize = trim_end(source, addr_start, args_end);
        if sb_span_equals(source, width_start, width_end - width_start, "8", 1) {
            sb_append_literal(output, "#zext[#bits<32>](", 17);
        }
        sb_append_literal(output, "#load[#bits<", 12);
        sb_append_span(output, source, width_start, width_end - width_start);
        sb_append_literal(output, ">", 1);
        sb_append_literal(output, "]", 1);
        sb_append_literal(output, "(", 1);
        emit_addr_expr(source, addr_start, addr_end, output, layout, types);
        sb_append_literal(output, ")", 1);
        if sb_span_equals(source, width_start, width_end - width_start, "8", 1) {
            sb_append_literal(output, ")", 1);
        }
        return 1;
    }
    if sb_span_equals(source, member, member_end - member, "store_bits", 10) {
        let width_start: usize = skip_space(source, args_start);
        let width_end: usize = width_start;
        let width_done: i32 = 0;
        while width_done == 0 {
            if width_end < args_end {
                if sb_byte_at(source, width_end) == 44 {
                    width_done = 1;
                    let marker: i32 = 0;
                } else {
                    width_end = width_end + 1;
                    let marker: i32 = 0;
                }
            } else {
                width_done = 1;
                let marker: i32 = 0;
            }
        }
        let addr_start: usize = skip_space(source, width_end + 1);
        let addr_mid: usize = addr_start;
        let depth2: usize = 0;
        let addr_done: i32 = 0;
        while addr_done == 0 {
            if addr_mid < args_end {
                let b: i32 = sb_byte_at(source, addr_mid);
                if b == 34 {
                    addr_mid = skip_string(source, addr_mid);
                    let marker: i32 = 0;
                } else {
                    if b == 40 {
                        depth2 = depth2 + 1;
                        addr_mid = addr_mid + 1;
                        let marker: i32 = 0;
                    } else {
                        if b == 41 {
                            depth2 = depth2 - 1;
                            addr_mid = addr_mid + 1;
                            let marker: i32 = 0;
                        } else {
                            if depth2 == 0 && b == 44 {
                                addr_done = 1;
                                let marker: i32 = 0;
                            } else {
                                addr_mid = addr_mid + 1;
                                let marker: i32 = 0;
                            }
                        }
                    }
                }
            } else {
                addr_done = 1;
                let marker: i32 = 0;
            }
        }
        let value_start: usize = skip_space(source, addr_mid + 1);
        let value_end: usize = trim_end(source, value_start, args_end);
        if sb_span_equals(source, width_start, width_end - width_start, "65", 2) {
            sb_append_literal(output, "#store[addr] ", 13);
            emit_expr(source, value_start, value_end, output, layout, types, meta, consts);
            sb_append_literal(output, ", ", 2);
            emit_addr_expr(source, addr_start, addr_mid, output, layout, types);
            return 1;
        }
        sb_append_literal(output, "#store[#bits<", 13);
        sb_append_span(output, source, width_start, width_end - width_start);
        sb_append_literal(output, ">] ", 3);
        if sb_span_equals(source, width_start, width_end - width_start, "8", 1) {
            sb_append_literal(output, "#trunc[#bits<8>](", 17);
            emit_expr(source, value_start, value_end, output, layout, types, meta, consts);
            sb_append_literal(output, ")", 1);
        } else {
            emit_expr(source, value_start, value_end, output, layout, types, meta, consts);
        }
        sb_append_literal(output, ", ", 2);
        emit_addr_expr(source, addr_start, addr_mid, output, layout, types);
        return 1;
    }
    return 0;
};

// Resolve the factory prefix for a bare member call: when the callee is a
// std::func member of a factory-produced module (kind 3 with a non-zero
// owning module row whose payload names the factory), returns the factory
// name start offset; 0 otherwise.
let bare_call_prefix = std::func(
    source: addr,
    member_start: usize,
    member_end: usize,
    meta: addr,
) -> usize {
    let mlen: usize = sb_len(meta);
    let mrow: usize = meta_lookup_kind_latest(
        meta, mlen, source, member_start, member_end - member_start, 3
    );
    if mrow == 0 { return 0; }
    let owner: usize = meta_row_field(meta, mlen, mrow, 5);
    if owner == 0 { return 0; }
    let pl: usize = meta_value_payload_length(meta, mlen, owner);
    if pl <= 1 { return 0; }
    return meta_value_payload_start(meta, mlen, owner);
};

// The length of the factory-name prefix for a bare member call; 0 when
// the callee has no factory owner.
let bare_call_prefix_len = std::func(
    source: addr,
    member_start: usize,
    member_end: usize,
    meta: addr,
) -> usize {
    let mlen: usize = sb_len(meta);
    let mrow: usize = meta_lookup_kind_latest(
        meta, mlen, source, member_start, member_end - member_start, 3
    );
    if mrow == 0 { return 0; }
    let owner: usize = meta_row_field(meta, mlen, mrow, 5);
    if owner == 0 { return 0; }
    let pl: usize = meta_value_payload_length(meta, mlen, owner);
    if pl <= 1 { return 0; }
    return pl;
};

let emit_nested_field2 = std::func(
    source: addr,
    output: addr,
    layout: addr,
    base_start: usize,
    base_end: usize,
    first_start: usize,
    first_end: usize,
    second_start: usize,
    second_end: usize,
    record: usize,
) -> bool {
    let llen: usize = sb_len(layout);
    let record_end: usize = meta_seg_end(layout, llen, record);
    let field_ts: usize = meta_field_type_start(
        layout, record, record_end, source, first_start, first_end
    );
    let field_te: usize = meta_field_type_end(
        layout, record, record_end, source, first_start, first_end
    );
    let nested_rec: usize = meta_table_find(
        layout, llen, source, field_ts, field_te
    );
    if nested_rec >= llen { return 0; }
    let nested_seg: usize = meta_seg_end(layout, llen, nested_rec);
    let first_off: usize = meta_field_offset(
        layout, record, record_end, source, first_start, first_end
    );
    let second_off: usize = meta_field_offset(
        layout, nested_rec, nested_seg, source, second_start, second_end
    );
    let second_w: usize = meta_field_width(
        layout, nested_rec, nested_seg, source, second_start, second_end
    );
    let second_addr: usize = meta_field_addr(
        layout, nested_rec, nested_seg, source, second_start, second_end
    );
    if second_addr == 1 {
        sb_append_literal(output, "#load[addr](#lea(base=%", 23);
    } else {
        sb_append_literal(output, "#load[#bits<", 12);
        meta_emit_bits(output, second_w);
        sb_append_literal(output, ">](#lea(base=%", 14);
    }
    sb_append_literal(output, "#load[addr](#lea(base=%", 23);
    sb_append_span(output, source, base_start, base_end - base_start);
    sb_append_literal(output, ", idx=0, scale=0, offset=", 25);
    meta_append_decimal(output, first_off);
    sb_append_literal(output, "0", 1);
    sb_append_literal(output, ")), idx=0, scale=0, offset=", 27);
    meta_append_decimal(output, second_off);
    sb_append_literal(output, "0", 1);
    sb_append_literal(output, "))", 2);
    return 1;
};

let emit_integer_cast = std::func(
    source: addr,
    output: addr,
    start: usize,
    end: usize,
) -> bool {
    let digit_end: usize = start;
    while digit_end < end {
        if is_digit_at(source, digit_end) == false { break; }
        digit_end = digit_end + 1;
        let marker: i32 = 0;
    }
    let after_digit: usize = skip_space(source, digit_end);
    if sb_span_equals(source, after_digit, 2, "as", 2) {
        let cast_type: usize = skip_space(source, after_digit + 2);
        if sb_span_equals(source, cast_type, 4, "addr", 4) {
            sb_append_literal(output, "#int2ptr(", 9);
            sb_append_span(output, source, start, digit_end - start);
            sb_append_literal(output, ")", 1);
            return 1;
        }
    }
    return 0;
};

let emit_vec_double_get = std::func(
    source: addr,
    output: addr,
    base_start: usize,
    base_end: usize,
    method_start: usize,
    method_end: usize,
    open: usize,
    expr_end: usize,
    outer_offset: usize,
    layout: addr,
    types: addr,
    meta: addr,
    consts: addr,
) -> bool {
    let mutating: usize = 0;
    if sb_span_equals(source, method_start, method_end - method_start, "get_mut", 7) {
        mutating = 1;
    } else {
        if sb_span_equals(source, method_start, method_end - method_start, "get", 3) == false {
            return 0;
        }
    }
    if mutating == 1 {
        // handled below with the mutating vector accessor
    }
