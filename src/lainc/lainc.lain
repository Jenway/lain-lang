    sb_append_literal(output, "#let %length: #bits<64> = #load[#bits<64>](#lea(base=%source, idx=0, scale=0, offset=8))\n#let %opening: addr = #call bootstrap.allocate-pages(16)\n#store[#bits<64>] 0, #lea(base=%opening, idx=0, scale=0, offset=0)\n#store[#bits<64>] 0, #lea(base=%opening, idx=0, scale=0, offset=8)\n#if #ne(%length, 0) {\n#store[#bits<64>] #call f0_Syntax_read_group(%unit, %stream, %cursor, 0, %opening), #lea(base=%unit, idx=0, scale=0, offset=16)\n} else {\n#store[#bits<64>] #call f0_Syntax_invalid_node(), #lea(base=%unit, idx=0, scale=0, offset=16)\n}\n", 535);
    sb_append_literal(output, "#let %id: #bits<64> = #call f0_Vec_length(#load[addr](#lea(base=%store, idx=0, scale=0, offset=0)))\n#call f0_Vec_push(#load[addr](#lea(base=%store, idx=0, scale=0, offset=0)), %unit)\n#return %id\n}\n", 197);
