let emit_syntax_token_equal_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %unit: addr = #call f0_Vec_get(#load[addr](#lea(base=%store, idx=0, scale=0, offset=0)), %unit_id)\n", 104);
    sb_append_literal(output, "#let %value: addr = #call f0_Vec_get(#load[addr](#lea(base=%unit, idx=0, scale=0, offset=8)), %node_id)\n", 104);
    sb_append_literal(output, "#if #ne(#load[#bits<32>](#lea(base=%value, idx=0, scale=0, offset=0)), 1) {\n", 76);
