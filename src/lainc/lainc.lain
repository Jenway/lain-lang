let emit_elaborator_add_expression_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %id: #bits<64> = #call f0_Vec_length(#load[addr](#lea(base=%program, idx=0, scale=0, offset=16)))\n", 103);
    sb_append_literal(output, "#call f0_Vec_push(#load[addr](#lea(base=%program, idx=0, scale=0, offset=16)), %value)\n", 87);
    sb_append_literal(output, "  #return %id\n", 14);
};

let emit_elaborator_declare_function_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %id: #bits<64> = #call f0_Vec_length(#load[addr](#lea(base=%program, idx=0, scale=0, offset=24)))\n", 103);
    sb_append_literal(output, "#let %function: addr = #call bootstrap.allocate-pages(56)\n", 58);
    sb_append_literal(output, "#store[#bits<64>] %id, #lea(base=%function, idx=0, scale=0, offset=0)\n", 70);
    sb_append_literal(output, "#store[#bits<64>] %owner, #lea(base=%function, idx=0, scale=0, offset=8)\n", 73);
    sb_append_literal(output, "#store[addr] %name, #lea(base=%function, idx=0, scale=0, offset=16)\n", 68);
    sb_append_literal(output, "#store[addr] #call f0_Vec_new(), #lea(base=%function, idx=0, scale=0, offset=24)\n", 81);
    sb_append_literal(output, "#store[#bits<64>] %return_type, #lea(base=%function, idx=0, scale=0, offset=32)\n", 80);
    sb_append_literal(output, "#store[addr] #call f0_Effects_new_store(), #lea(base=%function, idx=0, scale=0, offset=40)\n", 91);
    sb_append_literal(output, "#store[#bits<64>] %body, #lea(base=%function, idx=0, scale=0, offset=48)\n", 73);
    sb_append_literal(output, "#call f0_Vec_push(#load[addr](#lea(base=%program, idx=0, scale=0, offset=24)), %function)\n", 90);
    sb_append_literal(output, "  #return %id\n", 14);
};

let emit_modules_declare_runtime = std::func(output: addr) -> unit {
    sb_append_literal(output, "#let %id: #bits<64> = #load[#bits<64>](#lea(base=%workspace, idx=0, scale=0, offset=8))\n", 88);
    sb_append_literal(output, "#store[#bits<64>] #add(%id, 1), #lea(base=%workspace, idx=0, scale=0, offset=8)\n", 80);
    sb_append_literal(output, "#let %summary: addr = #call bootstrap.allocate-pages(48)\n", 57);
    sb_append_literal(output, "#store[#bits<64>] %id, #lea(base=%summary, idx=0, scale=0, offset=0)\n", 69);
    sb_append_literal(output, "#store[addr] %name, #lea(base=%summary, idx=0, scale=0, offset=8)\n", 66);
    sb_append_literal(output, "#store[#bits<64>] %source_id, #lea(base=%summary, idx=0, scale=0, offset=16)\n", 77);
    sb_append_literal(output, "#store[addr] #call f0_Vec_new(), #lea(base=%summary, idx=0, scale=0, offset=24)\n", 80);
    sb_append_literal(output, "#store[addr] #call f0_Vec_new(), #lea(base=%summary, idx=0, scale=0, offset=32)\n", 80);
    sb_append_literal(output, "#store[#bits<64>] %namespace, #lea(base=%summary, idx=0, scale=0, offset=40)\n", 77);
    sb_append_literal(output, "#call f0_Vec_push(#load[addr](#lea(base=%workspace, idx=0, scale=0, offset=0)), %summary)\n", 90);
    sb_append_literal(output, "  #return %id\n", 14);
};

// Emit one top-level function declaration at index ('let').  Returns the
