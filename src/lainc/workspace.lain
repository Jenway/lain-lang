// One workspace model for both single-source and multi-source compilation.

let memory_model: Module = import("std::memory_model");
let source_workspace: Module =
    import("packages::lain::compiler::source_workspace");
let modules: Module = import("packages::lain::compiler::modules");
let module_artifact: Module =
    import("packages::lain::compiler::module_artifact");

@export
let workspace: Module = std::module {
    @export
    let Workspace = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let Sources: Module =
            source_workspace.SourceWorkspace(Memory);
        let Modules: Module = modules.Modules(Memory);
        let Artifact: Module = module_artifact.Artifact(Memory);

        return std::module {
            @export let Sources: Module = Sources;
            @export let Modules: Module = Modules;
            @export let Artifact: Module = Artifact;
        };
    };
};
