// LAINIR -> C99 后端：把内存里的 LAINIR 模块确定性地写成标准 C99 文本。
// 输出放在调用方给的 MutSlice(u8) 里；写满时 writer 标记失败，后续写入不再推进。
// 实现分在 writer / inst / module 三个子模块里，本文件只做公开面转发。
let vf = import("src::ir::verify::model");
let tab = import("src::host::symtab");
let wr = import("src::backend::c99::writer");
let inst = import("src::backend::c99::inst");
let modu = import("src::backend::c99::module");

pub let C99Writer = wr.C99Writer;
pub let Self = C99Writer;
pub let C99Emitter = inst.C99Emitter;

pub let set_syms = func(s: Mut(tab.HostSymTab)) -> u64 {
  return wr.set_syms(s);
};

pub let new_writer = func(buf: MutSlice(u8)) -> C99Writer {
  return wr.new_writer(buf);
};

pub let writer_set_split = func(w: Mut(C99Writer), v: u64) -> u64 {
  return wr.writer_set_split(w, v);
};

pub let writer_new = func(buf: MutSlice(u8)) -> C99Writer {
  return wr.writer_new(buf);
};

pub let writer_len = func(w: Mut(C99Writer)) -> u64 {
  return wr.writer_len(w);
};

pub let writer_ok = func(w: Mut(C99Writer)) -> u64 {
  return wr.writer_ok(w);
};

pub let put_byte = func(w: Mut(C99Writer), b: u8) -> u64 {
  return wr.put_byte(w, b);
};

pub let put_str = func(w: Mut(C99Writer), s: Slice(u8)) -> u64 {
  return wr.put_str(w, s);
};

pub let put_line = func(w: Mut(C99Writer), s: Slice(u8)) -> u64 {
  return wr.put_line(w, s);
};

pub let put_u64_dec = func(w: Mut(C99Writer), v: u64) -> u64 {
  return wr.put_u64_dec(w, v);
};

pub let put_u64_hex = func(w: Mut(C99Writer), v: u64) -> u64 {
  return wr.put_u64_hex(w, v);
};

pub let put_hex2 = func(w: Mut(C99Writer), v: u64) -> u64 {
  return wr.put_hex2(w, v);
};

pub let put_u64_lit = func(w: Mut(C99Writer), v: u64) -> u64 {
  return wr.put_u64_lit(w, v);
};

pub let c_type_name = func(t: vf.IrType) -> Slice(u8) {
  return wr.c_type_name(t);
};

pub let emit_type = func(w: Mut(C99Writer), t: vf.IrType) -> u64 {
  return wr.emit_type(w, t);
};

pub let put_sanitized = func(w: Mut(C99Writer), h: u64) -> u64 {
  return wr.put_sanitized(w, h);
};

pub let find_proc = func(m: Ref(vf.IrModule), name: u64) -> u64 {
  return wr.find_proc(m, name);
};

pub let emitter_new = func(w: Mut(C99Writer), m: Ref(vf.IrModule)) -> C99Emitter {
  return inst.emitter_new(w, m);
};

pub let emit_region = func(em: Mut(C99Emitter), ri: u64, yield_inst: u64, yield_region: u64) -> u64 {
  return inst.emit_region(em, ri, yield_inst, yield_region);
};

pub let emit_proc_signature = func(w: Mut(C99Writer), m: Ref(vf.IrModule), p: vf.IrProc) -> u64 {
  return modu.emit_proc_signature(w, m, p);
};

pub let compute_reachable_procs = func(m: Ref(vf.IrModule), entry_proc: u64) -> MutSlice(u64) {
  return wr.compute_reachable_procs(m, entry_proc);
};

pub let release_reachable_procs = func(mark: MutSlice(u64)) -> u64 {
  return wr.release_reachable_procs(mark);
};

pub let reachable_proc_count = func(mark: MutSlice(u64)) -> u64 {
  return wr.reachable_proc_count(mark);
};

pub let emit_all_proc_decls = func(w: Mut(C99Writer), m: Ref(vf.IrModule), i: u64) -> u64 {
  return modu.emit_all_proc_decls(w, m, i);
};

pub let emit_reachable_proc_decls = func(w: Mut(C99Writer), m: Ref(vf.IrModule),
                                        mark: MutSlice(u64)) -> u64 {
  return modu.emit_reachable_proc_decls(w, m, mark);
};

pub let emit_reachable_proc_bodies_range = func(w: Mut(C99Writer), m: Ref(vf.IrModule),
                                               mark: MutSlice(u64), lo: u64,
                                               hi: u64) -> u64 {
  return modu.emit_reachable_proc_bodies_range(w, m, mark, lo, hi);
};

pub let emit_proc_decl = func(w: Mut(C99Writer), m: Ref(vf.IrModule), pi: u64) -> u64 {
  return modu.emit_proc_decl(w, m, pi);
};

pub let emit_data_decl = func(w: Mut(C99Writer), symbol: u64, bytes: Slice(u8), is_writable: u64) -> u64 {
  return modu.emit_data_decl(w, symbol, bytes, is_writable);
};

pub let emit_data_decl_shared = func(w: Mut(C99Writer), symbol: u64, bytes: Slice(u8), is_writable: u64) -> u64 {
  return modu.emit_data_decl_shared(w, symbol, bytes, is_writable);
};

pub let emit_data_decl_extern = func(w: Mut(C99Writer), symbol: u64, bytes: Slice(u8), is_writable: u64) -> u64 {
  return modu.emit_data_decl_extern(w, symbol, bytes, is_writable);
};

pub let emit_proc_body_c99 = func(w: Mut(C99Writer), m: Ref(vf.IrModule), pi: u64) -> u64 {
  return modu.emit_proc_body_c99(w, m, pi);
};

pub let emit_proc_c99 = func(w: Mut(C99Writer), m: Ref(vf.IrModule), pi: u64) -> u64 {
  return modu.emit_proc_c99(w, m, pi);
};

pub let emit_preamble_lib = func(w: Mut(C99Writer)) -> u64 {
  return modu.emit_preamble_lib(w);
};

pub let emit_preamble = func(w: Mut(C99Writer)) -> u64 {
  return modu.emit_preamble(w);
};

pub let emit_split_preamble_shared = func(w: Mut(C99Writer)) -> u64 {
  return modu.emit_split_preamble_shared(w);
};

pub let emit_split_main_globals = func(w: Mut(C99Writer)) -> u64 {
  return modu.emit_split_main_globals(w);
};

pub let emit_entry_main = func(w: Mut(C99Writer), m: Ref(vf.IrModule), entry_sym: u64, print_result: u64) -> u64 {
  return modu.emit_entry_main(w, m, entry_sym, print_result);
};

pub let fnv1a_hash = func(buf: Slice(u8)) -> u64 {
  return modu.fnv1a_hash(buf);
};
