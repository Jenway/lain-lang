// 符号：关键字、标点、运算符与基础类型名的 SymId。
// lain2_sym_intern 幂等：重复驻留同一个名字拿回同一个句柄，
// 所以这些访问器随用随取，不需要缓存表。
extern lain2_sym_intern(p: Ref(u8), n: u64) -> u64 = lain2_sym_intern;

pub let intern = func(p: Ref(u8), n: u64) -> u64 {
  return lain2_sym_intern(p, n);
};

pub let k_func = func() -> u64 { return lain2_sym_intern("func", 4); };

pub let k_let = func() -> u64 { return lain2_sym_intern("let", 3); };

pub let k_if = func() -> u64 { return lain2_sym_intern("if", 2); };

