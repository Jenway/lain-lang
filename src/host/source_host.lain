let sym = import("src::host::symtab");
let rd = import("src::frontend::reader");
let ao = import("src::meta::ast_out");
let meta = import("src::meta::ast");
let mem = import("std::mem");

let trap_with = func(msg: Slice(u8), detail: u64) -> u64 {
  sym.trap_note(msg, detail);
  let dead: u64 = mem.trap_abort(detail);
  return dead;
};

pub let CLASS_AST_IN = func() -> u64 { return 1; };
pub let CLASS_AST_OUT = func() -> u64 { return 2; };
pub let CLASS_SYM = func() -> u64 { return 3; };

let CLASS_SHIFT = func() -> u64 { return 28; };
let SOURCE_SHIFT = func() -> u64 { return 20; };
let INDEX_MASK = func() -> u64 { return 0x0FFFFFFF; };
let SOURCE_MASK = func() -> u64 { return 0xFF; };
let SLOT_MASK = func() -> u64 { return 0xFFFFF; };

pub let NO_NODE = func() -> u64 { return 0xFFFFFFFF; };

pub let NO_SOURCE = func() -> u64 { return 0xFFFFFFFF; };

let handle_ast_in = func(source: u64, slot: u64) -> u64 {
  return (CLASS_AST_IN() << CLASS_SHIFT()) |
         ((source & SOURCE_MASK()) << SOURCE_SHIFT()) | (slot & SLOT_MASK());
};

let handle_ast_out = func(index: u64) -> u64 {
  return (CLASS_AST_OUT() << CLASS_SHIFT()) | (index & INDEX_MASK());
};

let handle_sym = func(id: u64) -> u64 {
  return (CLASS_SYM() << CLASS_SHIFT()) | (id & INDEX_MASK());
};

let class_of = func(h: u64) -> u64 { return h >> CLASS_SHIFT(); };
let source_of = func(h: u64) -> u64 { return (h >> SOURCE_SHIFT()) & SOURCE_MASK(); };
let slot_of = func(h: u64) -> u64 { return h & SLOT_MASK(); };
let out_index_of = func(h: u64) -> u64 { return h & INDEX_MASK(); };

let out_handle = func(index: u64) -> u64 {
  if index == meta.NO_NODE() { return NO_NODE(); }
  if index > INDEX_MASK() {
    return trap_with("source_host: out_handle index overflow", index);
  }
  return handle_ast_out(index);
};

pub let Source = struct {
  name: u64,
  text_ptr: Ref(u8),
  text_len: u64,
  ast_nodes: Ref(rd.RawNode),
  ast_node_count: u64,
  ast_children: Ref(u32),
  ast_child_count: u64,
  ast_spans: Ref(rd.Span),
  ast_root: u64,

  root_handle: u64,
  ast_kind: u64,
  ast_err_line: u64,
  ast_err_col: u64,
  ast_err_offset: u64,
  ast_needed: u64,
  ast_bytes: u64,
};

pub let HostSources = struct {
  syms: Mut(sym.HostSymTab),
  out: Mut(ao.AstOut),
  sources: Mut(Source),
  source_cap: u64,
  source_count: u64,
  kids: Mut(u32),
  kids_cap: u64,
  err_kind: u64,
  err_line: u64,
  err_col: u64,
  err_offset: u64,
  err_needed: u64,
};

pub let Self = HostSources;

let trap_source = func(h: Mut(HostSources), cause: u64) -> Mut(Source) {
  trap_with("source_host: source index out of range", cause);
  return h.sources;
};

let source_at = func(h: Mut(HostSources), src: u64) -> Mut(Source) {
  if src >= h.source_count { return trap_source(h, src); }
  return h.sources + src * size_of(Source);
};

let trap_ref = func(msg: Slice(u8), cause: u64) -> Ref(u8) {
  trap_with(msg, cause);
  return null_ref(Ref(u8));
};

pub let host_sources_new = func(syms: Mut(sym.HostSymTab), out: Mut(ao.AstOut),
                                source_cap: u64, kids_cap: u64) -> HostSources {
  if source_cap == 0 {
    trap_with("source_host: host_sources_new zero source capacity", source_cap);
  }
  if kids_cap == 0 {
    trap_with("source_host: host_sources_new zero kids capacity", kids_cap);
  }
  let src_bytes: u64 = source_cap * size_of(Source);
  let kid_bytes: u64 = kids_cap * 4;
  let src_mem: Mut(u8) = sym.mem_alloc(syms, src_bytes, 8);
  let kid_mem: Mut(u8) = sym.mem_alloc(syms, kid_bytes, 8);
  return HostSources {
    syms: syms,
    out: out,
    sources: ptr_cast(Mut(Source), src_mem),
    source_cap: source_cap,
    source_count: 0,
    kids: ptr_cast(Mut(u32), kid_mem),
    kids_cap: kids_cap,
    err_kind: rd.ReadStatus.Ok as u64,
    err_line: 0,
    err_col: 0,
    err_offset: 0,
    err_needed: 0,
  };
};

pub let new = func(syms: Mut(sym.HostSymTab), out: Mut(ao.AstOut), source_cap: u64,
                   kids_cap: u64) -> HostSources {
  return host_sources_new(syms, out, source_cap, kids_cap);
};

let clear_error = func(h: Mut(HostSources)) {
  h.err_kind = rd.ReadStatus.Ok as u64;
  h.err_line = 0;
  h.err_col = 0;
  h.err_offset = 0;
  h.err_needed = 0;
};

let fail_with = func(h: Mut(HostSources), ast: rd.RawAst) -> u64 {
  h.err_kind = ast.kind;
  h.err_line = ast.err_line;
  h.err_col = ast.err_col;
  h.err_offset = ast.err_offset;
  h.err_needed = ast.needed;
  return NO_SOURCE();
};

pub let last_error_kind = func(h: Mut(HostSources)) -> u64 { return h.err_kind; };
pub let last_error_line = func(h: Mut(HostSources)) -> u64 { return h.err_line; };
pub let last_error_col = func(h: Mut(HostSources)) -> u64 { return h.err_col; };
pub let last_error_offset = func(h: Mut(HostSources)) -> u64 { return h.err_offset; };
pub let last_error_needed = func(h: Mut(HostSources)) -> u64 { return h.err_needed; };

pub let source_count = func(h: Mut(HostSources)) -> u64 { return h.source_count; };

pub let source_add = func(h: Mut(HostSources), name: Slice(u8), text: Slice(u8)) -> u64 {
  clear_error(h);
  if h.source_count >= h.source_cap {
    return trap_with("source_host: source_add capacity", h.source_count);
  }

  let probe: MutSlice(u8) = make_slice(MutSlice(u8), null_ref(Mut(u8)), 0);
  let counted: rd.RawAst = rd.parse(text, probe);
  if counted.kind != rd.ReadStatus.ErrCapacity as u64 {
    if counted.kind != rd.ReadStatus.Ok as u64 { return fail_with(h, counted); }
    return trap_with("source_host: source_add unexpected reader kind",
                     counted.kind);
  }
  let need: u64 = counted.needed;
  if need == 0 {
    return trap_with("source_host: source_add empty arena need", need);
  }
  let block: Mut(u8) = sym.mem_alloc(h.syms, need, 8);
  let arena: MutSlice(u8) = make_slice(MutSlice(u8), block, need);
  let ast: rd.RawAst = rd.parse(text, arena);
  if ast.kind != rd.ReadStatus.Ok as u64 {
    return trap_with("source_host: source_add reparse failed", ast.kind);
  }
  if ast.root > SLOT_MASK() {
    return trap_with("source_host: source_add root slot overflow", ast.root);
  }
  if ast.node_count > SLOT_MASK() {
    return trap_with("source_host: source_add node count overflow",
                     ast.node_count);
  }
  let id: u64 = h.source_count;
  if id > SOURCE_MASK() {
    return trap_with("source_host: source_add source id overflow", id);
  }

  let name_sym: u64 = 0;
  if name.len > 0 {
    name_sym = sym.sym_intern(h.syms, name.ptr, name.len);
    if name_sym > INDEX_MASK() {
      return trap_with("source_host: source_add name symbol overflow",
                       name_sym);
    }
  }
  let rec: Mut(Source) = h.sources + id * size_of(Source);
  rec.name = name_sym;
  rec.text_ptr = text.ptr;
  rec.text_len = text.len;
  rec.ast_nodes = ast.nodes;
  rec.ast_node_count = ast.node_count;
  rec.ast_children = ast.children;
  rec.ast_child_count = ast.child_count;
  rec.ast_spans = ast.spans;
  rec.ast_root = ast.root;
  rec.root_handle = 0;
  rec.ast_kind = ast.kind;
  rec.ast_err_line = ast.err_line;
  rec.ast_err_col = ast.err_col;
  rec.ast_err_offset = ast.err_offset;
  rec.ast_needed = ast.needed;
  rec.ast_bytes = ast.bytes;
  h.source_count = id + 1;
  return id;
};

pub let ast_parse_snippet = func(h: Mut(HostSources), text: Slice(u8)) -> u64 {
  let empty: Slice(u8) = "";
  return source_add(h, empty, text);
};

pub let source_name = func(h: Mut(HostSources), src: u64) -> u64 {
  let rec: Mut(Source) = source_at(h, src);
  return rec.name;
};

pub let source_text_slice = func(h: Mut(HostSources), src: u64) -> Slice(u8) {
  if src >= h.source_count { return ""; }
  let rec: Mut(Source) = h.sources + src * size_of(Source);
  return make_slice(Slice(u8), rec.text_ptr, rec.text_len);
};

pub let source_err_line = func(h: Mut(HostSources), src: u64) -> u64 {
  let rec: Mut(Source) = source_at(h, src);
  return rec.ast_err_line;
};

pub let source_err_col = func(h: Mut(HostSources), src: u64) -> u64 {
  let rec: Mut(Source) = source_at(h, src);
  return rec.ast_err_col;
};

pub let source_err_offset = func(h: Mut(HostSources), src: u64) -> u64 {
  let rec: Mut(Source) = source_at(h, src);
  return rec.ast_err_offset;
};

let line_origin = func(text: Slice(u8), line: u64) -> u64 {
  if line <= 1 { return 0; }
  return loop c(i: u64 = 0, want: u64 = 1, start: u64 = 0) while i <= text.len {
    if i == text.len { break c(text.len); }
    let b: u8 = text[i];
    if b == 10 {
      want = want + 1;
      start = i + 1;
      if want >= line { break c(i + 1); }
    }
    i = i + 1;
  };
};

pub let line_col_offset = func(text: Slice(u8), line: u64, col: u64) -> u64 {
  let start: u64 = line_origin(text, line);
  let ahead: u64 = if col == 0 { 0 } else { col - 1 };
  let at: u64 = start + ahead;
  if at > text.len { return text.len; }
  return at;
};

let source_ast = func(rec: Mut(Source)) -> rd.RawAst {
  return rd.RawAst {
    nodes: rec.ast_nodes,
    node_count: rec.ast_node_count,
    children: rec.ast_children,
    child_count: rec.ast_child_count,
    spans: rec.ast_spans,
    root: rec.ast_root,
    kind: rec.ast_kind,
    err_line: rec.ast_err_line,
    err_col: rec.ast_err_col,
    err_offset: rec.ast_err_offset,
    needed: rec.ast_needed,
    bytes: rec.ast_bytes,
  };
};

pub let source_root = func(h: Mut(HostSources), src: u64) -> u64 {
  let rec: Mut(Source) = source_at(h, src);
  let cooked: u64 = rec.root_handle;
  if cooked != 0 { return cooked; }
  let ast: rd.RawAst = source_ast(rec);
  return handle_ast_in(src, ast.root);
};

pub let set_source_root = func(h: Mut(HostSources), src: u64, root: u64) -> u64 {
  if src >= h.source_count { return NO_SOURCE(); }
  if root == 0 { return NO_SOURCE(); }
  let rec: Mut(Source) = h.sources + src * size_of(Source);
  rec.root_handle = root;
  return root;
};

let trap_raw = func(cause: u64) -> rd.RawNode {
  trap_with("source_host: node index out of range", cause);
  return rd.RawNode {
    kind: 0,
    flags: 0,
    payload: 0,
    child_count: 0,
    span_id: 0,
  };
};

let raw_at = func(h: Mut(HostSources), src: u64, slot: u64) -> rd.RawNode {
  let rec: Mut(Source) = source_at(h, src);
  let ast: rd.RawAst = source_ast(rec);
  if slot >= ast.node_count { return trap_raw(slot); }
  return rd.node_get(ast.nodes, slot);
};

let is_raw_group = func(kind: u64) -> u64 {
  if kind >= rd.RawKind.GroupParen as u64 { return 1; }
  return 0;
};

let raw_group_delim = func(kind: u64) -> u64 {
  if kind == rd.RawKind.GroupParen as u64 { return 40; }
  if kind == rd.RawKind.GroupBracket as u64 { return 91; }
  if kind == rd.RawKind.GroupBrace as u64 { return 123; }
  return 0;
};

pub let ast_kind = func(h: Mut(HostSources), node: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let n: rd.RawNode = raw_at(h, source_of(node), slot_of(node));
    if is_raw_group(n.kind) == 1 { return meta.NodeKind.Group as u64; }
    return meta.NodeKind.Token as u64;
  }
  if cls == CLASS_AST_OUT() { return ao.node_kind(h.out, out_index_of(node)); }
  return trap_with("source_host: ast_kind unknown handle class", node);
};

pub let ast_delim = func(h: Mut(HostSources), node: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let n: rd.RawNode = raw_at(h, source_of(node), slot_of(node));
    return raw_group_delim(n.kind);
  }
  if cls == CLASS_AST_OUT() { return ao.node_delim(h.out, out_index_of(node)); }
  return trap_with("source_host: ast_delim unknown handle class", node);
};

pub let ast_sym = func(h: Mut(HostSources), node: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {

    let src: u64 = source_of(node);
    let slot: u64 = slot_of(node);
    let n: rd.RawNode = raw_at(h, src, slot);
    if is_raw_group(n.kind) == 1 { return 0; }
    let rec: Mut(Source) = source_at(h, src);
    let ast: rd.RawAst = source_ast(rec);
    let sp: rd.Span = rd.node_span(ast, slot);
    if sp.len == 0 { return 0; }
    let id: u64 = sym.sym_intern(h.syms, rec.text_ptr + sp.offset, sp.len);
    if id > INDEX_MASK() {
      return trap_with("source_host: ast_sym symbol overflow", id);
    }
    return handle_sym(id);
  }
  if cls == CLASS_AST_OUT() {
    let id: u64 = ao.node_sym(h.out, out_index_of(node));
    if id == 0 { return 0; }
    if id > INDEX_MASK() {
      return trap_with("source_host: ast_sym stored symbol overflow", id);
    }
    return handle_sym(id);
  }
  return trap_with("source_host: ast_sym unknown handle class", node);
};

pub let ast_child_count = func(h: Mut(HostSources), node: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let n: rd.RawNode = raw_at(h, source_of(node), slot_of(node));
    if is_raw_group(n.kind) == 0 { return 0; }
    return n.child_count;
  }
  if cls == CLASS_AST_OUT() { return ao.child_count(h.out, out_index_of(node)); }
  return trap_with("source_host: ast_child_count unknown handle class", node);
};

pub let ast_child = func(h: Mut(HostSources), node: u64, i: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let src: u64 = source_of(node);
    let slot: u64 = slot_of(node);
    let n: rd.RawNode = raw_at(h, src, slot);
    if is_raw_group(n.kind) == 0 {
      return trap_with("source_host: ast_child on token node", node);
    }
    if i >= n.child_count {
      return trap_with("source_host: ast_child index out of range", i);
    }
    let rec: Mut(Source) = source_at(h, src);
    let ast: rd.RawAst = source_ast(rec);
    let child: u64 = rd.child_id(ast, slot, i);
    if child > SLOT_MASK() {
      return trap_with("source_host: ast_child slot overflow", child);
    }
    return handle_ast_in(src, child);
  }
  if cls == CLASS_AST_OUT() {
    let child: u64 = ao.child_at(h.out, out_index_of(node), i);
    if child > INDEX_MASK() {
      return trap_with("source_host: ast_child index overflow", child);
    }
    return handle_ast_out(child);
  }
  return trap_with("source_host: ast_child unknown handle class", node);
};

pub let ast_literal_addr = func(h: Mut(HostSources), node: u64) -> Ref(u8) {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let src: u64 = source_of(node);
    let slot: u64 = slot_of(node);
    let n: rd.RawNode = raw_at(h, src, slot);
    if is_raw_group(n.kind) == 1 { return null_ref(Ref(u8)); }
    let rec: Mut(Source) = source_at(h, src);
    let ast: rd.RawAst = source_ast(rec);
    let sp: rd.Span = rd.node_span(ast, slot);
    return rec.text_ptr + sp.offset;
  }
  if cls == CLASS_AST_OUT() {
    let a: Mut(ao.AstOut) = h.out;
    let idx: u64 = out_index_of(node);
    if ao.node_kind(a, idx) != meta.NodeKind.Token as u64 { return null_ref(Ref(u8)); }
    let text: Slice(u8) = ao.text_of(a, idx);
    return text.ptr;
  }
  return trap_ref("source_host: ast_literal_addr unknown handle class", node);
};

pub let ast_literal_len = func(h: Mut(HostSources), node: u64) -> u64 {
  let cls: u64 = class_of(node);
  if cls == CLASS_AST_IN() {
    let src: u64 = source_of(node);
    let slot: u64 = slot_of(node);
    let n: rd.RawNode = raw_at(h, src, slot);
    if is_raw_group(n.kind) == 1 { return 0; }
    let rec: Mut(Source) = source_at(h, src);
    let ast: rd.RawAst = source_ast(rec);
    let sp: rd.Span = rd.node_span(ast, slot);
    return sp.len;
  }
  if cls == CLASS_AST_OUT() {
    let a: Mut(ao.AstOut) = h.out;
    let idx: u64 = out_index_of(node);
    if ao.node_kind(a, idx) != meta.NodeKind.Token as u64 { return 0; }
    let text: Slice(u8) = ao.text_of(a, idx);
    return text.len;
  }
  return trap_with("source_host: ast_literal_len unknown handle class", node);
};

let root_index = func(h: Mut(HostSources), root: u64) -> u64 {
  if root == NO_NODE() { return meta.NO_NODE(); }
  if class_of(root) != CLASS_AST_OUT() {
    return trap_with("source_host: ast_tx_commit root not ast_out", root);
  }
  return out_index_of(root);
};

let sym_index = func(h: Mut(HostSources), v: u64) -> u64 {
  if v == 0 { return 0; }
  if class_of(v) != CLASS_SYM() {
    return trap_with("source_host: symbol handle not sym class", v);
  }
  return out_index_of(v);
};

let origin_key = func(h: Mut(HostSources), v: u64) -> u64 {
  if v == 0 { return 0; }
  if v == NO_NODE() { return NO_NODE(); }
  let cls: u64 = class_of(v);
  if (cls == CLASS_AST_IN()) or (cls == CLASS_AST_OUT()) { return v; }
  return trap_with("source_host: origin handle not an ast node", v);
};

pub let ast_tx_begin = func(h: Mut(HostSources)) -> u64 {
  return ao.tx_begin(h.out);
};

pub let ast_tx_commit = func(h: Mut(HostSources), tx: u64, root: u64) -> u64 {
  let idx: u64 = root_index(h, root);
  let committed: u64 = ao.tx_commit(h.out, tx, idx);
  return out_handle(committed);
};

pub let ast_tx_rollback = func(h: Mut(HostSources), tx: u64) -> u64 {
  let restored: u64 = ao.tx_rollback(h.out, tx);
  return out_handle(restored);
};

pub let ast_mk_token = func(h: Mut(HostSources), sym_handle: u64, origin: u64,
                            text: Slice(u8)) -> u64 {
  let sym_id: u64 = sym_index(h, sym_handle);
  let origin_id: u64 = origin_key(h, origin);
  let id: u64 = ao.mk_token(h.out, sym_id, origin_id, 0, text);
  return out_handle(id);
};

let token_index = func(h: Mut(HostSources), kid: u64) -> u64 {
  if ast_kind(h, kid) != meta.NodeKind.Token as u64 {
    return trap_with("source_host: ast_mk_group expects token node", kid);
  }
  let sym_id: u64 = sym_index(h, ast_sym(h, kid));
  let text: Slice(u8) = make_slice(Slice(u8), ast_literal_addr(h, kid),
                                  ast_literal_len(h, kid));
  return ao.mk_token(h.out, sym_id, kid, 0, text);
};

pub let ast_mk_group = func(h: Mut(HostSources), delim: u64, kids: Slice(u32)) -> u64 {
  let n: u64 = kids.len;
  if n > h.kids_cap {
    return trap_with("source_host: ast_mk_group kids capacity", n);
  }
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let raw: u32 = kids[i];
    let kid: u64 = raw as u64;
    let idx: u64 = if class_of(kid) == CLASS_AST_IN() { token_index(h, kid) } else {
      if class_of(kid) != CLASS_AST_OUT() {
        return trap_with("source_host: ast_mk_group unknown kid class", kid);
      }
      out_index_of(kid)
    };
    let slot: Mut(u32) = h.kids + i * 4;
    deref(slot) = idx as u32;
    i = i + 1;
  };
  let view: Slice(u32) = make_slice(Slice(u32), ptr_cast(Ref(u32), h.kids), n);
  let id: u64 = ao.mk_group(h.out, delim, 0, view);
  return out_handle(id);
};
