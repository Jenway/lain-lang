pub let MODULE_CAP = func() -> u64 { return 16; };
pub let FRAME_CAP = func() -> u64 { return 64; };
pub let DIAG_CAP = func() -> u64 { return 256; };
pub let DIAG_MESSAGE_MAX = func() -> u64 { return 512; };
pub let INIT_CAP = func() -> u64 { return 4; };
pub let INIT_INST_CAP = func() -> u64 { return 16; };
pub let HANDLE_STRIDE = func() -> u64 { return 4294967296; };

pub let HOST_OK = func() -> u64 { return 0; };
pub let HOST_ERR_STATE = func() -> u64 { return 1; };
pub let HOST_ERR_ARG = func() -> u64 { return 2; };
pub let HOST_ERR_HANDLE = func() -> u64 { return 3; };
pub let HOST_ERR_CAPACITY = func() -> u64 { return 4; };
pub let HOST_ERR_RANGE = func() -> u64 { return 5; };
pub let HOST_ERR_TYPE = func() -> u64 { return 6; };
pub let HOST_ERR_IR = func() -> u64 { return 7; };

pub let DataRec = struct {
  symbol: u64,
  bytes: Ref(u8),
  size: u64,
  is_writable: u64,
};

pub let Diag = struct {
  span: u64,
  level: u64,
  message: Ref(u8),
  length: u64,
};

pub let Frame = struct {
  params: Mut(vf.IrParam),
  param_cap: u64,
  param_count: u64,
  results: Mut(vf.IrType),
  result_cap: u64,
  result_count: u64,
  insts: Mut(u64),
  inst_cap: u64,
  inst_count: u64,
};

pub let ProcState = struct {
  open: u64,
  is_extern: u64,
  name: u64,
  link_name: u64,
  abi: u64,
  lib: u64,
  is_variadic: u64,
  params: Mut(vf.IrParam),
  param_cap: u64,
  param_count: u64,
  results: Mut(vf.IrType),
  result_cap: u64,
  result_count: u64,
  depth: u64,
  cases: Mut(vf.IrCase),
  case_cap: u64,
  case_count: u64,
};

pub let ModState = struct {
  in_use: u64,
  name: u64,
  procs: Mut(vf.IrProc),
  proc_cap: u64,
  proc_count: u64,
  regions: Mut(vf.IrRegion),
  region_cap: u64,
  region_count: u64,
  insts: Mut(vf.IrInst),
  inst_cap: u64,
  inst_count: u64,
  cases: Mut(vf.IrCase),
  case_cap: u64,
  case_count: u64,
  scratch: Mut(u64),
  data: Mut(DataRec),
  data_cap: u64,
  data_count: u64,
  args: Mut(vf.IrOperand),
  arg_count: u64,
  frames: Mut(Frame),
  depth: u64,
  proc: Mut(ProcState),
};

pub let HostIr = struct {
  arena: Mut(u8),
  cap: u64,
  used: u64,
  err: u64,
  last_verify: u64,
  mods: Mut(ModState),
  mod_cap: u64,
  diags: Mut(Diag),
  diag_cap: u64,
  diag_count: u64,
};

pub let Self = HostIr;

let IrProcCell = struct { v: vf.IrProc };
let IrRegionCell = struct { v: vf.IrRegion };
let IrInstCell = struct { v: vf.IrInst };
let IrParamCell = struct { v: vf.IrParam };
let IrTypeCell = struct { v: vf.IrType };
let IrCaseCell = struct { v: vf.IrCase };
let IrOperandCell = struct { v: vf.IrOperand };

let zero_bytes = func(p: Mut(u8), n: u64) -> u64 {
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let q: Mut(u8) = p + i;
    deref(q) = 0;
    i = i + 1;
  };
  return 0;
};

let copy_bytes = func(dst: Mut(u8), src: Ref(u8), n: u64) -> u64 {
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let d: Mut(u8) = dst + i;
    let s: Ref(u8) = src + i;
    deref(d) = deref(s);
    i = i + 1;
  };
  return 0;
};

let fail_msg = func(h: Mut(HostIr), msg: Slice(u8), code: u64) -> u64 {
  if h.err == 0 {
    h.err = code;
  }
  tab.trap_note(msg, code);
  mem.trap_abort(code);
};

let msg_state = func() -> Slice(u8) { return "ir_host: state mismatch"; };
let msg_arg = func() -> Slice(u8) { return "ir_host: invalid argument"; };
let msg_handle = func() -> Slice(u8) { return "ir_host: invalid mod handle"; };
let msg_capacity = func() -> Slice(u8) { return "ir_host: capacity exhausted"; };
let msg_range = func() -> Slice(u8) { return "ir_host: range violation"; };
let msg_type = func() -> Slice(u8) { return "ir_host: invalid type code"; };
let msg_ir = func() -> Slice(u8) { return "ir_host: verification failed"; };

let msg_for = func(code: u64) -> Slice(u8) {
  if code == HOST_ERR_STATE() { return msg_state(); }
  if code == HOST_ERR_ARG() { return msg_arg(); }
  if code == HOST_ERR_HANDLE() { return msg_handle(); }
  if code == HOST_ERR_CAPACITY() { return msg_capacity(); }
  if code == HOST_ERR_RANGE() { return msg_range(); }
  if code == HOST_ERR_TYPE() { return msg_type(); }
  return msg_ir();
};

let fail = func(h: Mut(HostIr), code: u64) -> u64 {
  return fail_msg(h, msg_for(code), code);
};

let trap_host = func(cause: u64) -> Mut(HostIr) {
  tab.trap_note("ir_host: host_new arena too small", cause);
  mem.trap_abort(cause);
};

let mod_slot = func(base: Mut(ModState), cap: u64, i: u64) -> Mut(ModState) {
  let s: MutSlice(ModState) = make_slice(MutSlice(ModState), base, cap);
  return mut_of((s[i]));
};

let frame_slot = func(base: Mut(Frame), cap: u64, i: u64) -> Mut(Frame) {
  let s: MutSlice(Frame) = make_slice(MutSlice(Frame), base, cap);
  return mut_of((s[i]));
};

let proc_slot = func(base: Mut(vf.IrProc), cap: u64, i: u64) -> Mut(vf.IrProc) {
  let s: MutSlice(vf.IrProc) = make_slice(MutSlice(vf.IrProc), base, cap);
  return mut_of((s[i]));
};

let region_slot = func(base: Mut(vf.IrRegion), cap: u64, i: u64) -> Mut(vf.IrRegion) {
  let s: MutSlice(vf.IrRegion) = make_slice(MutSlice(vf.IrRegion), base, cap);
  return mut_of((s[i]));
};

let inst_slot = func(base: Mut(vf.IrInst), cap: u64, i: u64) -> Mut(vf.IrInst) {
  let s: MutSlice(vf.IrInst) = make_slice(MutSlice(vf.IrInst), base, cap);
  return mut_of((s[i]));
};

let param_slot = func(base: Mut(vf.IrParam), cap: u64, i: u64) -> Mut(vf.IrParam) {
  let s: MutSlice(vf.IrParam) = make_slice(MutSlice(vf.IrParam), base, cap);
  return mut_of((s[i]));
};

let type_slot = func(base: Mut(vf.IrType), cap: u64, i: u64) -> Mut(vf.IrType) {
  let s: MutSlice(vf.IrType) = make_slice(MutSlice(vf.IrType), base, cap);
  return mut_of((s[i]));
};

let case_slot = func(base: Mut(vf.IrCase), cap: u64, i: u64) -> Mut(vf.IrCase) {
  let s: MutSlice(vf.IrCase) = make_slice(MutSlice(vf.IrCase), base, cap);
  return mut_of((s[i]));
};

let data_slot = func(base: Mut(DataRec), cap: u64, i: u64) -> Mut(DataRec) {
  let s: MutSlice(DataRec) = make_slice(MutSlice(DataRec), base, cap);
  return mut_of((s[i]));
};

let diag_slot = func(base: Mut(Diag), cap: u64, i: u64) -> Mut(Diag) {
  let s: MutSlice(Diag) = make_slice(MutSlice(Diag), base, cap);
  return mut_of((s[i]));
};

let operand_slot = func(base: Mut(vf.IrOperand), cap: u64, i: u64) -> Mut(vf.IrOperand) {
  let s: MutSlice(vf.IrOperand) = make_slice(MutSlice(vf.IrOperand), base, cap);
  return mut_of((s[i]));
};

let arena_take = func(h: Mut(HostIr), bytes: u64, align: u64) -> Mut(u8) {
  if bytes == 0 { return null_ref(Mut(u8)); }
  let a: u64 = if align == 0 { 1 } else { align };
  let base: u64 = h.arena as u64;
  let want: u64 = h.used;
  let miss: u64 = want % a;
  let off: u64 = if miss == 0 { want } else { want + (a - miss) };
  if (off + bytes) > h.cap {
    fail_msg(h, "ir_host: arena_take capacity", HOST_ERR_CAPACITY());
  }
  h.used = off + bytes;
  return h.arena + off;
};

let arena_zero = func(h: Mut(HostIr), bytes: u64, align: u64) -> Mut(u8) {
  let p: Mut(u8) = arena_take(h, bytes, align);
  if is_null(p) { return p; }
  let rc: u64 = zero_bytes(p, bytes);
  return p;
};

let grow_bytes = func(h: Mut(HostIr), old: Mut(u8), old_cap: u64, new_cap: u64,
                      elem: u64) -> Mut(u8) {
  let p: Mut(u8) = arena_zero(h, new_cap * elem, 8);
  if is_null(p) {
    return fail_msg(h, "ir_host: grow_bytes capacity", HOST_ERR_CAPACITY());
  }
  if old_cap != 0 {
    let rc: u64 = copy_bytes(p, ptr_cast(Ref(u8), old), old_cap * elem);
  }
  return p;
};

pub let host_new = func(arena: Mut(u8), bytes: u64) -> Mut(HostIr) {
  if is_null(arena) { return trap_host(HOST_ERR_ARG()); }
  let need: u64 = size_of(HostIr);
  let raw: u64 = arena as u64;
  let miss: u64 = raw % 8;
  let pad: u64 = if miss == 0 { 0 } else { 8 - miss };
  let used: u64 = pad + need;
  if bytes < used { return trap_host(HOST_ERR_CAPACITY()); }
  let hp: Mut(HostIr) = ptr_cast(Mut(HostIr), arena + pad);
  deref(hp) = HostIr {
    arena: arena,
    cap: bytes,
    used: used,
    err: 0,
    last_verify: 0,
    mods: null_ref(Mut(ModState)),
    mod_cap: 0,
    diags: null_ref(Mut(Diag)),
    diag_cap: 0,
    diag_count: 0,
  };
  let mod_bytes: u64 = MODULE_CAP() * size_of(ModState);
  let mp: Mut(u8) = arena_zero(hp, mod_bytes, 8);
  hp.mods = ptr_cast(Mut(ModState), mp);
  hp.mod_cap = MODULE_CAP();
  let diag_bytes: u64 = DIAG_CAP() * size_of(Diag);
  let dp: Mut(u8) = arena_zero(hp, diag_bytes, 8);
  hp.diags = ptr_cast(Mut(Diag), dp);
  hp.diag_cap = DIAG_CAP();
  return hp;
};

pub let host_ok = func(h: Mut(HostIr)) -> u64 {
  if is_null(h) { return 0; }
  if h.err == 0 { return 1; }
  return 0;
};

pub let host_error = func(h: Mut(HostIr)) -> u64 {
  if is_null(h) { return HOST_ERR_HANDLE(); }
  return h.err;
};

pub let host_last_verify = func(h: Mut(HostIr)) -> u64 {
  if is_null(h) { return HOST_ERR_HANDLE(); }
  return h.last_verify;
};

pub let host_diag_count = func(h: Mut(HostIr)) -> u64 {
  if is_null(h) { return 0; }
  return h.diag_count;
};

pub let host_diag_span = func(h: Mut(HostIr), i: u64) -> u64 {
  if is_null(h) { return 0; }
  if i >= h.diag_count { return 0; }
  let d: Mut(Diag) = diag_slot(h.diags, h.diag_cap, i);
  return d.span;
};

pub let host_diag_level = func(h: Mut(HostIr), i: u64) -> u64 {
  if is_null(h) { return 0; }
  if i >= h.diag_count { return 0; }
  let d: Mut(Diag) = diag_slot(h.diags, h.diag_cap, i);
  return d.level;
};

pub let host_diag_message = func(h: Mut(HostIr), i: u64) -> Slice(u8) {
  if is_null(h) { return make_slice(Slice(u8), null_ref(Ref(u8)), 0); }
  if i >= h.diag_count { return make_slice(Slice(u8), null_ref(Ref(u8)), 0); }
  let d: Mut(Diag) = diag_slot(h.diags, h.diag_cap, i);
  return make_slice(Slice(u8), d.message, d.length);
};

let mod_at = func(h: Mut(HostIr), i: u64) -> Mut(ModState) {
  if i >= h.mod_cap { return null_ref(Mut(ModState)); }
  return mod_slot(h.mods, h.mod_cap, i);
};

let mod_index = func(h: Mut(HostIr), m: Mut(ModState)) -> u64 {
  let base: u64 = h.mods as u64;
  let here: u64 = m as u64;
  return (here - base) / size_of(ModState);
};

let mod_of_handle = func(h: Mut(HostIr), modv: u64) -> Mut(ModState) {
  if modv == 0 { return null_ref(Mut(ModState)); }
  let i: u64 = modv - 1;
  let m: Mut(ModState) = mod_at(h, i);
  if is_null(m) { return m; }
  if m.in_use == 0 { return null_ref(Mut(ModState)); }
  return m;
};

let free_slot_at = func(h: Mut(HostIr), i: u64) -> u64 {
  if i >= h.mod_cap { return i; }
  let m: Mut(ModState) = mod_slot(h.mods, h.mod_cap, i);
  if m.in_use == 0 { return i; }
  return free_slot_at(h, i + 1);
};

let free_slot = func(h: Mut(HostIr)) -> u64 {
  return free_slot_at(h, 0);
};

let type_code_ok = func(k: u64) -> u64 {
  if k <= 4 { return 1; }
  return 0;
};

let type_from = func(k: u64, w: u64) -> vf.IrType {
  if k == 1 { return vf.type_bits(w); }
  if k == 2 { return vf.type_float(w); }
  if k == 3 { return vf.type_vec(w); }
  if k == 4 { return vf.type_addr(); }
  return vf.type_void();
};

let set_inst_type = func(it: Mut(vf.IrInst), k: u64, w: u64) -> u64 {
  if k == 0 { return 0; }
  let t: vf.IrType = type_from(k, w);
  return vf.inst_set_type(it, t.kind, t.width);
};

let mod_ensure_proc = func(h: Mut(HostIr), m: Mut(ModState)) -> u64 {
  if m.proc_count < m.proc_cap { return 0; }
  let nc: u64 = if m.proc_cap == 0 { INIT_CAP() } else { m.proc_cap * 2 };
  let p: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), m.procs), m.proc_cap, nc,
                              size_of(IrProcCell));
  if is_null(p) { return 1; }
  m.procs = ptr_cast(Mut(vf.IrProc), p);
  m.proc_cap = nc;
  return 0;
};

let mod_ensure_region = func(h: Mut(HostIr), m: Mut(ModState)) -> u64 {
  if m.region_count < m.region_cap { return 0; }
  let nc: u64 = if m.region_cap == 0 { INIT_CAP() } else { m.region_cap * 2 };
  let p: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), m.regions), m.region_cap, nc,
                              size_of(IrRegionCell));
  if is_null(p) { return 1; }
  m.regions = ptr_cast(Mut(vf.IrRegion), p);
  m.region_cap = nc;
  return 0;
};

let mod_ensure_inst = func(h: Mut(HostIr), m: Mut(ModState)) -> u64 {
  if m.inst_count < m.inst_cap { return 0; }
  let nc: u64 = if m.inst_cap == 0 { INIT_INST_CAP() } else { m.inst_cap * 2 };
  let p: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), m.insts), m.inst_cap, nc,
                              size_of(IrInstCell));
  if is_null(p) { return 1; }
  m.insts = ptr_cast(Mut(vf.IrInst), p);
