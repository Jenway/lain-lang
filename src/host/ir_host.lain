  let p: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), f.insts), f.inst_cap, nc,
                              size_of(u64));
  if is_null(p) { return 1; }
  f.insts = ptr_cast(Mut(u64), p);
  f.inst_cap = nc;
  return 0;
};

let proc_ensure_param = func(h: Mut(HostIr), p: Mut(ProcState)) -> u64 {
  if p.param_count < p.param_cap { return 0; }
  let nc: u64 = if p.param_cap == 0 { INIT_CAP() } else { p.param_cap * 2 };
  let q: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), p.params), p.param_cap, nc,
                              size_of(IrParamCell));
  if is_null(q) { return 1; }
  p.params = ptr_cast(Mut(vf.IrParam), q);
  p.param_cap = nc;
  return 0;
};

let proc_ensure_result = func(h: Mut(HostIr), p: Mut(ProcState)) -> u64 {
  let none: u64 = vf.MAX_RESULTS();
  if p.result_count >= none { return 1; }
  if p.result_count < p.result_cap { return 0; }
  let nc: u64 = if p.result_cap == 0 { none } else { p.result_cap * 2 };
  let q: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), p.results), p.result_cap, nc,
                              size_of(IrTypeCell));
  if is_null(q) { return 1; }
  p.results = ptr_cast(Mut(vf.IrType), q);
  p.result_cap = nc;
  return 0;
};

let proc_ensure_case = func(h: Mut(HostIr), p: Mut(ProcState)) -> u64 {
  if p.case_count < p.case_cap { return 0; }
  let nc: u64 = if p.case_cap == 0 { INIT_CAP() } else { p.case_cap * 2 };
  let q: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), p.cases), p.case_cap, nc,
                              size_of(IrCaseCell));
  if is_null(q) { return 1; }
  p.cases = ptr_cast(Mut(vf.IrCase), q);
  p.case_cap = nc;
  return 0;
};

let publish_params = func(h: Mut(HostIr), src: Ref(vf.IrParam), count: u64) -> Ref(vf.IrParam) {
  if count == 0 { return null_ref(Ref(vf.IrParam)); }
  let bytes: u64 = count * size_of(IrParamCell);
  let p: Mut(u8) = arena_zero(h, bytes, 8);
  if is_null(p) { return null_ref(Ref(vf.IrParam)); }
  let rc: u64 = copy_bytes(p, ptr_cast(Ref(u8), src), bytes);
  return ptr_cast(Ref(vf.IrParam), p);
};

let publish_types = func(h: Mut(HostIr), src: Ref(vf.IrType), count: u64) -> Ref(vf.IrType) {
  if count == 0 { return null_ref(Ref(vf.IrType)); }
  let bytes: u64 = count * size_of(IrTypeCell);
  let p: Mut(u8) = arena_zero(h, bytes, 8);
  if is_null(p) { return null_ref(Ref(vf.IrType)); }
  let rc: u64 = copy_bytes(p, ptr_cast(Ref(u8), src), bytes);
  return ptr_cast(Ref(vf.IrType), p);
};

let publish_insts = func(h: Mut(HostIr), src: Ref(u64), count: u64) -> Ref(u64) {
  if count == 0 { return null_ref(Ref(u64)); }
  let bytes: u64 = count * size_of(u64);
  let p: Mut(u8) = arena_zero(h, bytes, 8);
  if is_null(p) { return null_ref(Ref(u64)); }
  let rc: u64 = copy_bytes(p, ptr_cast(Ref(u8), src), bytes);
  return ptr_cast(Ref(u64), p);
};

let finalize_proc = func(h: Mut(HostIr), m: Mut(ModState), body: u64) -> u64 {
  let p: Mut(ProcState) = m.proc;
  let rc: u64 = mod_ensure_proc(h, m);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let params: Ref(vf.IrParam) = publish_params(h, ptr_cast(Ref(vf.IrParam), p.params),
                                              p.param_count);
  let results: Ref(vf.IrType) = publish_types(h, ptr_cast(Ref(vf.IrType), p.results),
                                              p.result_count);
  let slot: Mut(vf.IrProc) = proc_slot(m.procs, m.proc_cap, m.proc_count);
  deref(slot) = vf.proc_new(p.name, params, p.param_count, results, p.result_count);
  let brc: u64 = vf.proc_set_body(slot, body);
  m.proc_count = m.proc_count + 1;
  p.open = 0;
  return 0;
};

let find_extern_at = func(m: Mut(ModState), name: u64, link: u64, i: u64) -> u64 {
  if i >= m.proc_count { return 0; }
  let p: Mut(vf.IrProc) = proc_slot(m.procs, m.proc_cap, i);
  if p.is_extern == 1 {
    if (p.name == name) and (p.link_name == link) { return i + 1; }
  }
  return find_extern_at(m, name, link, i + 1);
};

let find_extern = func(m: Mut(ModState), name: u64, link: u64) -> u64 {
  return find_extern_at(m, name, link, 0);
};

let finalize_extern = func(h: Mut(HostIr), m: Mut(ModState)) -> u64 {
  let p: Mut(ProcState) = m.proc;
  let dup: u64 = find_extern(m, p.name, p.link_name);
  if dup != 0 {
    p.open = 0;
    return 0;
  }
  let rc: u64 = mod_ensure_proc(h, m);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let params: Ref(vf.IrParam) = publish_params(h, ptr_cast(Ref(vf.IrParam), p.params),
                                              p.param_count);
  let results: Ref(vf.IrType) = publish_types(h, ptr_cast(Ref(vf.IrType), p.results),
                                              p.result_count);
  let slot: Mut(vf.IrProc) = proc_slot(m.procs, m.proc_cap, m.proc_count);
  deref(slot) = vf.proc_new(p.name, params, p.param_count, results, p.result_count);
  let erc: u64 = vf.proc_set_extern(slot, p.link_name);
  let arc: u64 = vf.proc_set_abi(slot, p.abi, p.lib, p.is_variadic);
  m.proc_count = m.proc_count + 1;
  p.open = 0;
  return 0;
};

let make_inst = func(h: Mut(HostIr), m: Mut(ModState), kind: u64) -> Mut(vf.IrInst) {
  let src: u64 = mod_ensure_inst(h, m);
  if src != 0 {
    fail_msg(h, "ir_host: make_inst module inst capacity", HOST_ERR_CAPACITY());
    return null_ref(Mut(vf.IrInst));
  }
  let ii: u64 = m.inst_count;
  let slot: Mut(vf.IrInst) = inst_slot(m.insts, m.inst_cap, ii);
  deref(slot) = vf.inst_new(kind);
  m.inst_count = ii + 1;
  let f: Mut(Frame) = frame_slot(m.frames, FRAME_CAP(), m.depth - 1);
  let frc: u64 = frame_ensure_inst(h, f);
  if frc != 0 {
    fail_msg(h, "ir_host: make_inst frame inst capacity", HOST_ERR_CAPACITY());
    return null_ref(Mut(vf.IrInst));
  }
  let f_insts: MutSlice(u64) = make_slice(MutSlice(u64), f.insts, f.inst_cap);
  f_insts[f.inst_count] = ii;
  f.inst_count = f.inst_count + 1;
  return slot;
};

let take_args = func(h: Mut(HostIr), m: Mut(ModState), it: Mut(vf.IrInst)) -> u64 {
  let n: u64 = m.arg_count;
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let op: Mut(vf.IrOperand) = operand_slot(m.args, vf.MAX_OPERANDS(), i);
    let rc: u64 = vf.inst_add_operand(it, deref(op));
    i = i + 1;
  };
  m.arg_count = 0;
  return 0;
};

let drop_args = func(m: Mut(ModState)) -> u64 {
  m.arg_count = 0;
  return 0;
};

let data_find_at = func(m: Mut(ModState), name: u64, i: u64) -> u64 {
  if i >= m.data_count { return 0; }
  let rec: Mut(DataRec) = data_slot(m.data, m.data_cap, i);
  if rec.symbol == name { return i + 1; }
  return data_find_at(m, name, i + 1);
};

let region_handle = func(mi: u64, ri: u64) -> u64 {
  return (mi + 1) * HANDLE_STRIDE() + ri + 1;
};

let handle_mod = func(raw: u64) -> u64 {
  return raw / HANDLE_STRIDE() - 1;
};

let handle_region = func(raw: u64) -> u64 {
  return raw % HANDLE_STRIDE() - 1;
};

let resolve_region = func(h: Mut(HostIr), m: Mut(ModState), raw: u64) -> u64 {
  if raw == 0 { return vf.NO_REGION(); }
  let mm: Mut(ModState) = mod_of_handle(h, handle_mod(raw) + 1);
  if is_null(mm) { fail(h, HOST_ERR_HANDLE()); return vf.NO_REGION(); }
  if (mm as u64) != (m as u64) { fail(h, HOST_ERR_HANDLE()); return vf.NO_REGION(); }
  let ri: u64 = handle_region(raw);
  if ri >= m.region_count { fail(h, HOST_ERR_HANDLE()); return vf.NO_REGION(); }
  return ri;
};

let init_module = func(h: Mut(HostIr), slot: u64, name: u64) -> Mut(ModState) {
  let m: Mut(ModState) = mod_slot(h.mods, h.mod_cap, slot);
  let rc: u64 = zero_bytes(ptr_cast(Mut(u8), m), size_of(ModState));
  m.name = name;
  let pc: u64 = INIT_CAP();
  let pr: Mut(u8) = arena_zero(h, pc * size_of(IrProcCell), 8);
  m.procs = ptr_cast(Mut(vf.IrProc), pr);
  m.proc_cap = pc;
  let rr: Mut(u8) = arena_zero(h, pc * size_of(IrRegionCell), 8);
  m.regions = ptr_cast(Mut(vf.IrRegion), rr);
  m.region_cap = pc;
  let ic: u64 = INIT_INST_CAP();
  let ir: Mut(u8) = arena_zero(h, ic * size_of(IrInstCell), 8);
  m.insts = ptr_cast(Mut(vf.IrInst), ir);
  m.inst_cap = ic;
  let cr: Mut(u8) = arena_zero(h, pc * size_of(IrCaseCell), 8);
  m.cases = ptr_cast(Mut(vf.IrCase), cr);
  m.case_cap = pc;
  let srf: Mut(u8) = arena_zero(h, checks.VF_SCRATCH() * size_of(u64), 8);
  m.scratch = ptr_cast(Mut(u64), srf);
  let dr: Mut(u8) = arena_zero(h, pc * size_of(DataRec), 8);
  m.data = ptr_cast(Mut(DataRec), dr);
  m.data_cap = pc;
  let ar: Mut(u8) = arena_zero(h, vf.MAX_OPERANDS() * size_of(IrOperandCell), 8);
  m.args = ptr_cast(Mut(vf.IrOperand), ar);
  let fr: Mut(u8) = arena_zero(h, FRAME_CAP() * size_of(Frame), 8);
  m.frames = ptr_cast(Mut(Frame), fr);
  let psr: Mut(u8) = arena_zero(h, size_of(ProcState), 8);
  m.proc = ptr_cast(Mut(ProcState), psr);
  if h.err != 0 { return m; }
  m.in_use = 1;
  return m;
};

let module_of = func(h: Mut(HostIr), m: Mut(ModState)) -> vf.IrModule {
  return vf.module_new(m.name,
                       ptr_cast(Ref(vf.IrProc), m.procs), m.proc_count,
                       ptr_cast(Ref(vf.IrRegion), m.regions), m.region_count,
                       ptr_cast(Ref(vf.IrInst), m.insts), m.inst_count,
                       ptr_cast(Ref(vf.IrCase), m.cases), m.case_count,
                       m.scratch);
};

pub let ir_mod_new = func(h: Mut(HostIr), name: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let slot: u64 = free_slot(h);
  if slot >= h.mod_cap { return fail(h, HOST_ERR_CAPACITY()); }
  let m: Mut(ModState) = init_module(h, slot, name);
  if h.err != 0 { return 0; }
  return slot + 1;
};

pub let ir_data_add = func(h: Mut(HostIr), modv: u64, name: u64, bytes: Ref(u8),
                           size: u64, is_writable: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if (size != 0) and is_null(bytes) { return fail(h, HOST_ERR_RANGE()); }
  let rc: u64 = mod_ensure_data(h, m);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let stored: Mut(u8) = arena_take(h, size, 8);
  if (size != 0) and is_null(stored) { return 0; }
  if size != 0 {
    let cc: u64 = copy_bytes(stored, bytes, size);
  }
  let slot: Mut(DataRec) = data_slot(m.data, m.data_cap, m.data_count);
  slot.symbol = name;
  slot.bytes = ptr_cast(Ref(u8), stored);
  slot.size = size;
  slot.is_writable = is_writable;
  m.data_count = m.data_count + 1;
  return m.data_count;
};

pub let ir_data_find = func(h: Mut(HostIr), modv: u64, name: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  return data_find_at(m, name, 0);
};

pub let ir_proc_begin = func(h: Mut(HostIr), modv: u64, name: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open != 0 { return fail(h, HOST_ERR_STATE()); }
  p.open = 1;
  p.is_extern = 0;
  p.name = name;
  p.link_name = 0;
  p.abi = 0;
  p.lib = 0;
  p.is_variadic = 0;
  p.param_count = 0;
  p.result_count = 0;
  p.depth = 0;
  p.case_count = 0;
  m.depth = 0;
  return 0;
};

pub let ir_proc_extern_abi = func(h: Mut(HostIr), modv: u64, name: u64, link: u64,
                                   abi: u64, lib: u64, is_variadic: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open != 0 { return fail(h, HOST_ERR_STATE()); }
  p.open = 1;
  p.is_extern = 1;
  p.name = name;
  p.link_name = link;
  p.abi = abi;
  p.lib = lib;
  p.is_variadic = is_variadic;
  p.param_count = 0;
  p.result_count = 0;
  p.depth = 0;
  p.case_count = 0;
  m.depth = 0;
  return 0;
};

pub let ir_proc_extern = func(h: Mut(HostIr), modv: u64, name: u64, link: u64) -> u64 {
  return ir_proc_extern_abi(h, modv, name, link, 0, 0, 0);
};

pub let ir_proc_param = func(h: Mut(HostIr), modv: u64, name: u64, k: u64,
                             w: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open == 0 { return fail(h, HOST_ERR_STATE()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if k == 0 { return fail(h, HOST_ERR_TYPE()); }
  let rc: u64 = proc_ensure_param(h, p);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrParam) = param_slot(p.params, p.param_cap, p.param_count);
  deref(slot) = vf.param_new(name, type_from(k, w));
  p.param_count = p.param_count + 1;
  return p.param_count;
};

pub let ir_proc_result = func(h: Mut(HostIr), modv: u64, k: u64, w: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open == 0 { return fail(h, HOST_ERR_STATE()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if k == 0 { return fail(h, HOST_ERR_TYPE()); }
  let rc: u64 = proc_ensure_result(h, p);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrType) = type_slot(p.results, p.result_cap, p.result_count);
  deref(slot) = type_from(k, w);
  p.result_count = p.result_count + 1;
  return p.result_count;
};

pub let ir_proc_end = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.is_extern == 1 {
    if p.open == 0 { return m.proc_count; }
    if p.depth != 0 { return fail(h, HOST_ERR_STATE()); }
    let rc: u64 = finalize_extern(h, m);
    if rc != 0 { return 0; }
    return m.proc_count;
  }
  if p.open != 0 { return fail(h, HOST_ERR_STATE()); }
  return m.proc_count;
};

pub let ir_region_begin = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open == 0 { return fail(h, HOST_ERR_STATE()); }
  if m.depth >= FRAME_CAP() { return fail(h, HOST_ERR_CAPACITY()); }
  let f: Mut(Frame) = frame_slot(m.frames, FRAME_CAP(), m.depth);
  f.param_count = 0;
  f.result_count = 0;
  f.inst_count = 0;
  m.depth = m.depth + 1;
  p.depth = m.depth;
  return m.depth;
};

pub let ir_region_param = func(h: Mut(HostIr), modv: u64, name: u64, k: u64,
                               w: u64, ik: u64, ib: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if m.depth == 0 { return fail(h, HOST_ERR_STATE()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if k == 0 { return fail(h, HOST_ERR_TYPE()); }
  if ik > 2 { return fail(h, HOST_ERR_ARG()); }
  if (ik == 2) and (ib == 0) { return fail(h, HOST_ERR_ARG()); }
  let f: Mut(Frame) = frame_slot(m.frames, FRAME_CAP(), m.depth - 1);
  let rc: u64 = frame_ensure_param(h, f);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrParam) = param_slot(f.params, f.param_cap, f.param_count);
  deref(slot) = vf.param_new(name, type_from(k, w));
  f.param_count = f.param_count + 1;
  return f.param_count;
};

pub let ir_region_result = func(h: Mut(HostIr), modv: u64, k: u64, w: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if m.depth == 0 { return fail(h, HOST_ERR_STATE()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if k == 0 { return fail(h, HOST_ERR_TYPE()); }
  let f: Mut(Frame) = frame_slot(m.frames, FRAME_CAP(), m.depth - 1);
  if f.result_count >= vf.MAX_RESULTS() { return fail(h, HOST_ERR_CAPACITY()); }
  let rc: u64 = frame_ensure_result(h, f);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrType) = type_slot(f.results, f.result_cap, f.result_count);
  deref(slot) = type_from(k, w);
  f.result_count = f.result_count + 1;
  return f.result_count;
};

pub let ir_region_end = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open == 0 { return fail(h, HOST_ERR_STATE()); }
  let depth: u64 = m.depth;
  if depth == 0 { return fail(h, HOST_ERR_STATE()); }
  let frc: u64 = mod_ensure_region(h, m);
  if frc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let f: Mut(Frame) = frame_slot(m.frames, FRAME_CAP(), depth - 1);
  let params: Ref(vf.IrParam) = publish_params(h, ptr_cast(Ref(vf.IrParam), f.params),
                                              f.param_count);

  let rsrc: Ref(vf.IrType) = if depth == 1 {
    ptr_cast(Ref(vf.IrType), p.results)
  } else {
    ptr_cast(Ref(vf.IrType), f.results)
  };
  let rcount: u64 = if depth == 1 { p.result_count } else { f.result_count };
  let results: Ref(vf.IrType) = publish_types(h, rsrc, rcount);
  let insts: Ref(u64) = publish_insts(h, ptr_cast(Ref(u64), f.insts), f.inst_count);
  if h.err != 0 { return 0; }
  let ri: u64 = m.region_count;
  let slot: Mut(vf.IrRegion) = region_slot(m.regions, m.region_cap, ri);
  deref(slot) = vf.region_new(params, f.param_count, results, rcount,
                              insts, f.inst_count);
  m.region_count = ri + 1;
  m.depth = depth - 1;
  p.depth = m.depth;
  if m.depth == 0 {
    let rc: u64 = finalize_proc(h, m, ri);
    if rc != 0 { return 0; }
  }
  let mi: u64 = mod_index(h, m);
  return region_handle(mi, ri);
};

pub let ir_args_reset = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  return drop_args(m);
};

pub let ir_arg_ref = func(h: Mut(HostIr), modv: u64, name: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if m.arg_count >= vf.MAX_OPERANDS() { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrOperand) = operand_slot(m.args, vf.MAX_OPERANDS(), m.arg_count);
  deref(slot) = vf.op_value(name);
  m.arg_count = m.arg_count + 1;
  return m.arg_count;
};

pub let ir_arg_int = func(h: Mut(HostIr), modv: u64, bits: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if m.arg_count >= vf.MAX_OPERANDS() { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrOperand) = operand_slot(m.args, vf.MAX_OPERANDS(), m.arg_count);
  deref(slot) = vf.op_int(bits);
  m.arg_count = m.arg_count + 1;
  return m.arg_count;
};

pub let ir_arg_float = func(h: Mut(HostIr), modv: u64, bits: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  if m.arg_count >= vf.MAX_OPERANDS() { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrOperand) = operand_slot(m.args, vf.MAX_OPERANDS(), m.arg_count);
  deref(slot) = vf.op_float(bits);
  m.arg_count = m.arg_count + 1;
  return m.arg_count;
};

pub let ir_inst = func(h: Mut(HostIr), modv: u64, kind: u64, res: u64, k: u64,
                       w: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if kind >= codes.InstKind.Count as u64 { return fail(h, HOST_ERR_ARG()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  let it: Mut(vf.IrInst) = make_inst(h, m, kind);
  if is_null(it) { return 0; }
  if res != 0 {
    let rc: u64 = vf.inst_add_result(it, res);
  }
  let tc: u64 = set_inst_type(it, k, w);
  let ac: u64 = take_args(h, m, it);
  return 1;
};

pub let ir_inst_if = func(h: Mut(HostIr), modv: u64, res: u64, cond: u64,
                          then_r: u64, else_r: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if cond == 0 { return fail(h, HOST_ERR_ARG()); }
  let then_i: u64 = resolve_region(h, m, then_r);
  if then_i == vf.NO_REGION() { return 0; }
  let it: Mut(vf.IrInst) = make_inst(h, m, codes.InstKind.If as u64);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let op: u64 = vf.inst_add_operand(it, vf.op_value(cond));
  let b1: u64 = vf.inst_set_body(it, then_i);
  if else_r != 0 {
    let else_i: u64 = resolve_region(h, m, else_r);
    if else_i == vf.NO_REGION() { return 0; }
    let b2: u64 = vf.inst_set_else(it, else_i);
  }
  return 1;
};

pub let ir_inst_loop = func(h: Mut(HostIr), modv: u64, res: u64, label: u64,
                            body: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if label == 0 { return fail(h, HOST_ERR_ARG()); }
  let body_i: u64 = resolve_region(h, m, body);
  if body_i == vf.NO_REGION() { return 0; }
  let it: Mut(vf.IrInst) = make_inst(h, m, codes.InstKind.Loop as u64);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let lb: u64 = vf.inst_set_label(it, label);
  let bd: u64 = vf.inst_set_body(it, body_i);
  return 1;
};

pub let ir_case_add = func(h: Mut(HostIr), modv: u64, value: u64, body: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if p.open == 0 { return fail(h, HOST_ERR_STATE()); }
  let body_i: u64 = resolve_region(h, m, body);
  if body_i == vf.NO_REGION() { return 0; }
  let rc: u64 = proc_ensure_case(h, p);
  if rc != 0 { return fail(h, HOST_ERR_CAPACITY()); }
  let slot: Mut(vf.IrCase) = case_slot(p.cases, p.case_cap, p.case_count);
  deref(slot) = vf.case_new(value, body_i);
  p.case_count = p.case_count + 1;
  return p.case_count;
};

pub let ir_inst_switch = func(h: Mut(HostIr), modv: u64, res: u64, selector: u64,
                              k: u64, w: u64, def: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if selector == 0 { return fail(h, HOST_ERR_ARG()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if k == 0 { return fail(h, HOST_ERR_TYPE()); }
  if def == 0 { return fail(h, HOST_ERR_ARG()); }
  let def_i: u64 = resolve_region(h, m, def);
  if def_i == vf.NO_REGION() { return 0; }
  let it: Mut(vf.IrInst) = make_inst(h, m, codes.InstKind.Switch as u64);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let tc: u64 = set_inst_type(it, k, w);
  let op: u64 = vf.inst_add_operand(it, vf.op_value(selector));
  let at: u64 = m.case_count;
  let n: u64 = p.case_count;
  if n != 0 {
    let need: u64 = at + n;
    if need > m.case_cap {
      let nc: u64 = if need > m.case_cap * 2 { need } else { m.case_cap * 2 };
      let grown: Mut(u8) = grow_bytes(h, ptr_cast(Mut(u8), m.cases), m.case_cap,
                                     nc, size_of(IrCaseCell));
      if is_null(grown) { return 0; }
      m.cases = ptr_cast(Mut(vf.IrCase), grown);
      m.case_cap = nc;
    }
    let bytes: u64 = n * size_of(IrCaseCell);
    let dst_cases: MutSlice(vf.IrCase) =
        make_slice(MutSlice(vf.IrCase), m.cases, m.case_cap);
    let dst: Mut(u8) = ptr_cast(Mut(u8), mut_of((dst_cases[at])));
    let rc: u64 = copy_bytes(dst, ptr_cast(Ref(u8), p.cases), bytes);
    m.case_count = need;
  }
  let cs: u64 = vf.inst_set_cases(it, at, n);
  let db: u64 = vf.inst_set_default(it, def_i);
  p.case_count = 0;
  return 1;
};

pub let ir_inst_jump = func(h: Mut(HostIr), modv: u64, kind: u64, label: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if kind != codes.InstKind.Break as u64 {
    if kind != codes.InstKind.Continue as u64 {
      if kind != codes.InstKind.Return as u64 {
        if kind != codes.InstKind.Yield as u64 {
          if kind != codes.InstKind.Unreachable as u64 {
            return fail(h, HOST_ERR_ARG());
          }
        }
      }
    }
  }
  let it: Mut(vf.IrInst) = make_inst(h, m, kind);
  if is_null(it) { return 0; }
  if label != 0 {
    let lb: u64 = vf.inst_set_label(it, label);
  }
  let ac: u64 = take_args(h, m, it);
  return 1;
};

pub let ir_inst_call = func(h: Mut(HostIr), modv: u64, res: u64, callee: u64,
                            tail: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if callee == 0 { return fail(h, HOST_ERR_ARG()); }
  let it: Mut(vf.IrInst) = make_inst(h, m, codes.InstKind.Call as u64);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let sy: u64 = vf.inst_set_symbol(it, callee);
  let ac: u64 = take_args(h, m, it);
  return 1;
};

pub let ir_inst_call_indirect = func(h: Mut(HostIr), modv: u64, res: u64, k: u64,
                                     w: u64, plo: u64, phi: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  if (k == 0) and (res != 0) { return fail(h, HOST_ERR_ARG()); }
  if (k != 0) and (res == 0) { return fail(h, HOST_ERR_ARG()); }
  if m.arg_count == 0 { return fail(h, HOST_ERR_ARG()); }
  let it: Mut(vf.IrInst) = make_inst(h, m, codes.InstKind.Call as u64);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let tc: u64 = set_inst_type(it, k, w);
  let ac: u64 = take_args(h, m, it);
  return 1;
};

pub let ir_inst_mem = func(h: Mut(HostIr), modv: u64, kind: u64, res: u64, k: u64,
                           w: u64, order: u64, vol: u64, align: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if kind != codes.InstKind.Load as u64 {
    if kind != codes.InstKind.Store as u64 {
      if kind != codes.InstKind.Alloca as u64 { return fail(h, HOST_ERR_ARG()); }
    }
  }
  if order > codes.OrderKind.SeqCst as u64 { return fail(h, HOST_ERR_ARG()); }
  if type_code_ok(k) == 0 { return fail(h, HOST_ERR_TYPE()); }
  let it: Mut(vf.IrInst) = make_inst(h, m, kind);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let tc: u64 = set_inst_type(it, k, w);
  let al: u64 = vf.inst_set_align(it, align);
  let ac: u64 = take_args(h, m, it);
  return 1;
};

pub let ir_inst_symbol = func(h: Mut(HostIr), modv: u64, kind: u64, res: u64,
                              symbol: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let p: Mut(ProcState) = m.proc;
  if (p.open == 0) or (m.depth == 0) { return fail(h, HOST_ERR_STATE()); }
  if kind >= codes.InstKind.Count as u64 { return fail(h, HOST_ERR_ARG()); }
  if symbol == 0 { return fail(h, HOST_ERR_ARG()); }
  let it: Mut(vf.IrInst) = make_inst(h, m, kind);
  if is_null(it) { return 0; }
  if res != 0 {
    let rr: u64 = vf.inst_add_result(it, res);
  }
  let sy: u64 = vf.inst_set_symbol(it, symbol);
  return 1;
};

pub let ir_mod_verify = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return HOST_ERR_HANDLE(); }
  if h.err != 0 { return h.err; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let modval: vf.IrModule = module_of(h, m);
  let code: u64 = 0;
  if m.data_count == 0 {
    code = checks.verify_module_large(ref_of(modval));
  } else {
    let raw: Mut(u8) = arena_take(h, m.data_count * size_of(u64), 8);
    if is_null(raw) {
      return fail_msg(h, "ir_host: ir_mod_verify data arena", HOST_ERR_CAPACITY());
    }
    let syms: MutSlice(u64) =
        make_slice(MutSlice(u64), ptr_cast(Mut(u64), raw), m.data_count);
    let i: u64 = loop c(i: u64 = 0) while i < m.data_count {
      let d: Mut(DataRec) = data_slot(m.data, m.data_cap, i);
      syms[i] = d.symbol;
      i = i + 1;
    };
    code = checks.verify_module_with_data(ref_of(modval), ptr_cast(Ref(u64), raw),
                                      m.data_count);
  }
  h.last_verify = code;
  return code;
};

let clone_region = func(h: Mut(HostIr), src: Mut(vf.IrRegion), dst: Mut(vf.IrRegion)) -> u64 {
  let r: vf.IrRegion = deref(src);
  let params: Ref(vf.IrParam) = publish_params(h, r.params, r.param_count);
  let results: Ref(vf.IrType) = publish_types(h, r.results, r.result_count);
  let insts: Ref(u64) = publish_insts(h, r.insts, r.inst_count);
  deref(dst) = vf.region_new(params, r.param_count, results, r.result_count,
                             insts, r.inst_count);
  return 0;
};

let clone_proc = func(h: Mut(HostIr), src: Mut(vf.IrProc), dst: Mut(vf.IrProc)) -> u64 {
  let p: vf.IrProc = deref(src);
  let params: Ref(vf.IrParam) = publish_params(h, p.params, p.param_count);
  let results: Ref(vf.IrType) = publish_types(h, p.results, p.result_count);
  deref(dst) = vf.proc_new(p.name, params, p.param_count, results, p.result_count);
  if p.is_extern == 1 {
    let rc: u64 = vf.proc_set_extern(dst, p.link_name);
  } else {
    let rc: u64 = vf.proc_set_body(dst, p.body);
  }
  return 0;
};

pub let ir_mod_clone_completed = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let src: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(src) { return fail(h, HOST_ERR_HANDLE()); }
  let slot: u64 = free_slot(h);
  if slot >= h.mod_cap { return fail(h, HOST_ERR_CAPACITY()); }
  let m: Mut(ModState) = init_module(h, slot, src.name);
  if h.err != 0 { return 0; }
  let di: u64 = loop c(di: u64 = 0) while di < src.data_count {
    let s: Mut(DataRec) = data_slot(src.data, src.data_cap, di);
    let rc: u64 = mod_ensure_data(h, m);
    if h.err != 0 { break c(di); }
    let stored: Mut(u8) = arena_take(h, s.size, 8);
    if h.err != 0 { break c(di); }
    if s.size != 0 {
      let cc: u64 = copy_bytes(stored, s.bytes, s.size);
    }
    let d: Mut(DataRec) = data_slot(m.data, m.data_cap, m.data_count);
    d.symbol = s.symbol;
    d.bytes = ptr_cast(Ref(u8), stored);
    d.size = s.size;
    d.is_writable = s.is_writable;
    m.data_count = m.data_count + 1;
    di = di + 1;
  };
  let ii: u64 = loop c(ii: u64 = 0) while ii < src.inst_count {
    let s: Mut(vf.IrInst) = inst_slot(src.insts, src.inst_cap, ii);
    let rc: u64 = mod_ensure_inst(h, m);
    if h.err != 0 { break c(ii); }
    let d: Mut(vf.IrInst) = inst_slot(m.insts, m.inst_cap, ii);
    deref(d) = deref(s);
    m.inst_count = ii + 1;
    ii = ii + 1;
  };
  let ri: u64 = loop c(ri: u64 = 0) while ri < src.region_count {
    let rc: u64 = mod_ensure_region(h, m);
    if h.err != 0 { break c(ri); }
    let s: Mut(vf.IrRegion) = region_slot(src.regions, src.region_cap, ri);
    let d: Mut(vf.IrRegion) = region_slot(m.regions, m.region_cap, ri);
    let cc: u64 = clone_region(h, s, d);
    m.region_count = ri + 1;
    ri = ri + 1;
  };
  let ci: u64 = loop c(ci: u64 = 0) while ci < src.case_count {
    let rc: u64 = mod_ensure_case(h, m);
    if h.err != 0 { break c(ci); }
    let s: Mut(vf.IrCase) = case_slot(src.cases, src.case_cap, ci);
    let d: Mut(vf.IrCase) = case_slot(m.cases, m.case_cap, ci);
    deref(d) = deref(s);
    m.case_count = ci + 1;
    ci = ci + 1;
  };
  let pi: u64 = loop c(pi: u64 = 0) while pi < src.proc_count {
    let rc: u64 = mod_ensure_proc(h, m);
    if h.err != 0 { break c(pi); }
    let s: Mut(vf.IrProc) = proc_slot(src.procs, src.proc_cap, pi);
    let d: Mut(vf.IrProc) = proc_slot(m.procs, m.proc_cap, pi);
    let cc: u64 = clone_proc(h, s, d);
    m.proc_count = pi + 1;
    pi = pi + 1;
  };
  if h.err != 0 { m.in_use = 0; return 0; }
  return slot + 1;
};

pub let ir_mod_free = func(h: Mut(HostIr), modv: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  m.in_use = 0;
  return 0;
};

let emit_data = func(w: Mut(c99.C99Writer), m: Mut(ModState), i: u64) -> u64 {
  if i >= m.data_count { return 1; }
  let rec: Mut(DataRec) = data_slot(m.data, m.data_cap, i);
  let bytes: Slice(u8) = make_slice(Slice(u8), rec.bytes, rec.size);
  let n: u64 = c99.emit_data_decl(w, rec.symbol, bytes, rec.is_writable);
  if n == 0 { return 0; }
  return emit_data(w, m, i + 1);
};

let emit_procs = func(w: Mut(c99.C99Writer), mv: Ref(vf.IrModule), count: u64,
                      i: u64) -> u64 {
  if i >= count { return 1; }
  let n: u64 = c99.emit_proc_c99(w, mv, i);
  let modv: vf.IrModule = deref(mv);
  let p: vf.IrProc = vf.proc_at_ref(modv.procs, i);
  if p.is_extern == 0 {
    if n == 0 { return 0; }
  }
  return emit_procs(w, mv, count, i + 1);
};

pub let ir_mod_emit_c99 = func(h: Mut(HostIr), modv: u64, buf: MutSlice(u8)) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  let m: Mut(ModState) = mod_of_handle(h, modv);
  if is_null(m) { return fail(h, HOST_ERR_HANDLE()); }
  let modval: vf.IrModule = module_of(h, m);
  let mv: Ref(vf.IrModule) = ref_of(modval);
  let code: u64 = checks.verify_module_large(mv);
  h.last_verify = code;
  if code != 0 { return fail(h, HOST_ERR_IR()); }
  let w0: c99.C99Writer = c99.new_writer(buf);
  let w: Mut(c99.C99Writer) = mut_of(w0);
  let pn: u64 = c99.emit_preamble(w);
  let dn: u64 = emit_data(w, m, 0);
  if dn == 0 {
    return fail_msg(h, "ir_host: ir_mod_emit_c99 data", HOST_ERR_CAPACITY());
  }
  let prc: u64 = emit_procs(w, mv, m.proc_count, 0);
  if prc == 0 {
    return fail_msg(h, "ir_host: ir_mod_emit_c99 procedures",
                    HOST_ERR_CAPACITY());
  }
  if c99.writer_ok(w) == 0 {
    return fail_msg(h, "ir_host: ir_mod_emit_c99 buffer overflow",
                    HOST_ERR_CAPACITY());
  }
  return c99.writer_len(w);
};

pub let diag_emit = func(h: Mut(HostIr), span: u64, level: u64, p: Ref(u8),
                         n: u64) -> u64 {
  if is_null(h) { return 0; }
  if h.err != 0 { return 0; }
  if n >= DIAG_MESSAGE_MAX() { return fail(h, HOST_ERR_ARG()); }
  if (n != 0) and is_null(p) { return fail(h, HOST_ERR_RANGE()); }
  if h.diag_count >= h.diag_cap { return 0; }
  let stored: Mut(u8) = arena_take(h, n, 1);
  if (n != 0) and is_null(stored) { return 0; }
  if n != 0 {
    let rc: u64 = copy_bytes(stored, p, n);
  }
  let slot: Mut(Diag) = diag_slot(h.diags, h.diag_cap, h.diag_count);
  slot.span = span;
  slot.level = level;
  slot.message = ptr_cast(Ref(u8), stored);
  slot.length = n;
  h.diag_count = h.diag_count + 1;
  return 0;
};
