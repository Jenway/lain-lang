// given.lain —— Witness 实例求值、given 作用域栈与歧义校验、Witness 成员解析、模块 Witness 校验。
// 单向依赖 state/types/ast/sym/agg/ir/modules/tyreg/ctypes/ctfor/ctprim/ctfn/ctx。
let st = import("state");
let ty = import("types");
let ax = import("ast");
let s = import("sym");
let agg = import("agg");
let modules = import("modules");
let ireg = import("tyreg");
let ct = import("ctypes");
let ctf = import("ctfor");
let ctp = import("ctprim");
let ctfn = import("ctfn");
let cx = import("ctx");

let GivenEntry = struct {
  name: u64,
  tid: u64,
  wrec: u64,
  depth: u64,
  implicit: u64
};

let GivenBlk = struct {
  base: Mut(GivenEntry),
  used: u64,
  depth: u64
};

let WField = struct {
  fname: u64,
  fkind: u64,
  fa: u64,
  fb: u64
};

let given_at = func(base: Mut(GivenEntry), off: u64) -> Mut(GivenEntry) {
  return ptr_cast(Mut(GivenEntry), ptr_cast(Mut(u8), base) + off);
};

let wfield_at = func(wrec: Mut(u8), i: u64) -> Mut(WField) {
  return ptr_cast(Mut(WField), wrec + 8 + i * 32);
};

let wrec_len = func(wrec: Mut(u8)) -> Mut(u64) {
  return ptr_cast(Mut(u64), wrec);
};

// --- given 栈（存在 st_genblk +0/+8/+16，每条 40 字节） --------------------
// [name@0, tid@8, wrec@16, depth@24, implicit@32]
let g_blk = func(k: Mut(st.State)) -> Mut(GivenBlk) {
  return ptr_cast(Mut(GivenBlk), st.st_genblk(k));
};

let g_base = func(k: Mut(st.State)) -> Mut(GivenEntry) {
  let gb: Mut(GivenBlk) = g_blk(k);
  if (gb.base as u64) != 0 { return gb.base; }
  let np: Mut(GivenEntry) = ptr_cast(Mut(GivenEntry), st.st_ralloc(k, 5120));
  gb.base = np;
  return np;
};
let g_used = func(k: Mut(st.State)) -> u64 { let gb: Mut(GivenBlk) = g_blk(k); return gb.used; };
let g_set_used = func(k: Mut(st.State), v: u64) -> u64 { let gb: Mut(GivenBlk) = g_blk(k); gb.used = v; return v; };
let g_depth = func(k: Mut(st.State)) -> u64 { let gb: Mut(GivenBlk) = g_blk(k); return gb.depth; };
let g_set_depth = func(k: Mut(st.State), v: u64) -> u64 { let gb: Mut(GivenBlk) = g_blk(k); gb.depth = v; return v; };

let mark = func(k: Mut(st.State)) -> u64 {
  let d: u64 = g_depth(k);
  g_set_depth(k, d + 1);
  return g_used(k);
};

let release = func(k: Mut(st.State), m: u64) -> u64 {
  let d: u64 = g_depth(k);
  if d > 0 { g_set_depth(k, d - 1); }
  return g_set_used(k, m);
};

let push_given = func(k: Mut(st.State), name: u64, tid: u64, wrec: u64, implicit: u64) -> u64 {
  let u: u64 = g_used(k);
  if u + 40 > 5120 { ctf.fail_msg(k, "given table full", 16, ax.e_ast()); return 0; }
  let p: Mut(GivenEntry) = given_at(g_base(k), u);
  p.name = name;
  p.tid = tid;
  p.wrec = wrec;
  p.depth = g_depth(k);
  p.implicit = implicit;
  return g_set_used(k, u + 40);
};

let find_name_scan = func(base: Mut(GivenEntry), name: u64, u: u64) -> Mut(GivenEntry) {
  if u == 0 { return null_ref(Mut(GivenEntry)); }
  let back: u64 = u - 40;
  let p: Mut(GivenEntry) = given_at(base, back);
  if p.name == name { return p; }
  return find_name_scan(base, name, back);
};

let find_by_name = func(k: Mut(st.State), name: u64) -> Mut(GivenEntry) {
  if name == 0 { return null_ref(Mut(GivenEntry)); }
  return find_name_scan(g_base(k), name, g_used(k));
};

let find_imp_scan = func(k: Mut(st.State), base: Mut(GivenEntry), tid: u64, u: u64, hit_d: u64, hit_p: Mut(GivenEntry)) -> Mut(GivenEntry) {
  if u == 0 { return hit_p; }
  let back: u64 = u - 40;
  let p: Mut(GivenEntry) = given_at(base, back);
  let imp: u64 = p.implicit;
  let rt: u64 = p.tid;
  let dp: u64 = p.depth;
  if (hit_p as u64) != 0 {
    if dp < hit_d { return hit_p; }
    if imp == 1 and rt == tid {
      ctf.fail_msg(k, "ambiguous given instance", 24, ax.e_type());
      return null_ref(Mut(GivenEntry));
    }
    return find_imp_scan(k, base, tid, back, hit_d, hit_p);
  }
  if imp == 1 and rt == tid { return find_imp_scan(k, base, tid, back, dp, p); }
  return find_imp_scan(k, base, tid, back, hit_d, hit_p);
};

let find_implicit = func(k: Mut(st.State), tid: u64) -> Mut(GivenEntry) {
  let hit: Mut(GivenEntry) = find_imp_scan(k, g_base(k), tid, g_used(k), 0, null_ref(Mut(GivenEntry)));
  if st.st_ok(k) != 0 { return null_ref(Mut(GivenEntry)); }
  if is_null(hit) { ctf.fail_msg(k, "missing given instance", 22, ax.e_type()); return null_ref(Mut(GivenEntry)); }
  return hit;
};

// --- Witness 构造与求值 --------------------------------------------------
// wrec：[nfields@0, field0..]，每字段 32B：[fname@0, fkind@8, fa@16, fb@24]
let wrec_find = func(wrec: Mut(u8), fname: u64, i: u64, n: u64) -> Mut(WField) {
  if i >= n { return null_ref(Mut(WField)); }
  let f: Mut(WField) = wfield_at(wrec, i);
  if f.fname == fname { return f; }
  return wrec_find(wrec, fname, i + 1, n);
};

let wrec_lookup = func(wrec: Mut(u8), fname: u64) -> Mut(WField) {
  let nf: u64 = deref(wrec_len(wrec));
  return wrec_find(wrec, fname, 0, nf);
};

let parse_wfields = func(k: Mut(st.State), sh: u64, fg: u64, i: u64, wrec: Mut(u8), idx: u64) -> u64 {
  let n: u64 = ax.n_count(fg);
  if i >= n { deref(wrec_len(wrec)) = idx; return idx; }
  if ax.is_comma(fg, i) == 1 { return parse_wfields(k, sh, fg, i + 1, wrec, idx); }
  if ax.is_name(fg, i) == 0 { ctf.fail_msg(k, "expected field name", 19, ax.e_ast()); return idx; }
  let fname: u64 = ax.n_sym(fg, i);
  if is_null(agg.mem_find(sh, fname)) { ctf.fail_msg(k, "unknown witness field", 21, ax.e_type()); return idx; }
  if ctf.has_tok(fg, i + 1, s.p_colon()) == 0 { ctf.fail_msg(k, "expected colon", 14, ax.e_ast()); return idx; }
  let fv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let nj: u64 = eval_witness(k, fg, i + 2, fv);
  if st.st_ok(k) != 0 { return idx; }
  let slot: Mut(WField) = wfield_at(wrec, idx);
  slot.fname = fname;
  slot.fkind = ctf.v_kind(fv);
  slot.fa = ctf.v_a(fv);
  slot.fb = ctf.v_b(fv);
  return parse_wfields(k, sh, fg, nj, wrec, idx + 1);
};

let make_witness = func(k: Mut(st.State), tid: u64, fg: u64, out: Mut(ctf.CtVal)) -> u64 {
  let sh: u64 = ireg.ty_shape(k, tid);
  if sh == 0 or agg.shp_kind(sh) != agg.kind_struct() {
    ctf.fail_msg(k, "witness needs struct", 20, ax.e_type());
    return 0;
  }
  let nf: u64 = agg.shp_count(sh);
  let wsz: u64 = 8 + nf * 32 + 64;
  let wrec: Mut(u8) = st.st_ralloc(k, wsz);
  parse_wfields(k, sh, fg, 0, wrec, 0);
  if st.st_ok(k) != 0 { return 0; }
  let wu: u64 = wrec as u64;
  ctf.v_set(out, 7, tid, wu);
  return 1;
};

let eval_witness = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ctf.CtVal)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { ctf.fail_msg(k, "empty witness expr", 18, ax.e_ast()); return i; }
  // 1) Name(args...) { fields... }
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_paren()) == 1 {
      if ctf.has_delim(g, i + 2, ax.dl_brace()) == 1 {
        let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
        let j: u64 = ctfn.eval_factory_call(k, g, i, tv);
        if j != 0 {
          if st.st_ok(k) != 0 { return i + 3; }
          make_witness(k, ctp.as_type(k, tv), ax.n_at(g, i + 2), out);
          return i + 3;
        }
      }
    }
  }
  // 2) StructName { fields... }
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_brace()) == 1 {
      let se: Mut(modules.SymEntry) = modules.find_here(k, ax.n_sym(g, i));
      if (se as u64) != 0 {
        if modules.sym_kind(se) == modules.sym_kind_struct() {
          let tid: u64 = ctf.tid_of_shape(k, modules.sym_shape(se));
          make_witness(k, tid, ax.n_at(g, i + 1), out);
          return i + 2;
        }
      }
    }
  }
  // 3) 命名 given 引用、过程名引用、或常规编译期表达式
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_paren()) == 0 {
      let nm: u64 = ax.n_sym(g, i);
      let bv: Mut(ctf.CtVal) = ctf.lookup(k, nm);
      if (bv as u64) != 0 {
        ctf.v_set(out, ctf.v_kind(bv), ctf.v_a(bv), ctf.v_b(bv));
        return i + 1;
      }
      let ge: Mut(GivenEntry) = find_by_name(k, nm);
      if (ge as u64) != 0 {
        ctf.v_set(out, 7, ge.tid, ge.wrec);
        return i + 1;
      }
      let se2: Mut(modules.SymEntry) = modules.find_here(k, nm);
      if (se2 as u64) != 0 {
        let kd: u64 = modules.sym_kind(se2);
        if kd == modules.sym_kind_func() or kd == modules.sym_kind_extern() {
          let seu: u64 = se2 as u64;
          ctf.v_set(out, 8, seu, 0);
          return i + 1;
        }
      }
    }
  }
  return ctfn.ct_eval(k, g, i, 0, out);
};

// --- 编译期/运行期查询 Witness 成员 --------------------------------------
// 若 g[i] 是编译期 Witness 绑定且 g[i+1] == '.'，返回其字段记录地址，否则空引用。
let witness_field_at = func(k: Mut(st.State), g: u64, i: u64) -> Mut(WField) {
  if ax.is_name(g, i) == 0 { return null_ref(Mut(WField)); }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 0 { return null_ref(Mut(WField)); }
  if i + 2 >= ax.n_count(g) { return null_ref(Mut(WField)); }
  if ax.is_name(g, i + 2) == 0 { return null_ref(Mut(WField)); }
  let bv: Mut(ctf.CtVal) = ctf.lookup(k, ax.n_sym(g, i));
  if is_null(bv) { return null_ref(Mut(WField)); }
  if ctf.v_kind(bv) != 7 { return null_ref(Mut(WField)); }
  let wrec: Mut(u8) = ptr_cast(Mut(u8), ctf.v_b(bv));
  let fld: Mut(WField) = wrec_lookup(wrec, ax.n_sym(g, i + 2));
  if is_null(fld) { ctf.fail_msg(k, "no such witness field", 21, ax.e_type()); return null_ref(Mut(WField)); }
  return fld;
};

let parse_want_tid = func(k: Mut(st.State), g: u64, j0: u64) -> u64 {
  if ctf.has_tok(g, j0, s.p_colon()) == 0 { return 0; }
  let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let tj: u64 = ctfn.ct_eval(k, g, j0 + 1, 0, tv);
  if st.st_ok(k) != 0 { return 0; }
  return ctp.as_type(k, tv);
};

// 登记 given / 编译期 witness let 声明：decl_i 指向 given 或 let。
let reg_given = func(k: Mut(st.State), g: u64, decl_i: u64, implicit: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if decl_i + 1 >= n {
    ctf.fail_msg(k, "expected given name", 19, ax.e_ast());
    return decl_i + 1;
  }
  let is_named: u64 = ax.is_name(g, decl_i + 1);
  let has_colon: u64 = ctf.has_tok(g, decl_i + 2, s.p_colon());
  let has_eq: u64 = ctf.has_tok(g, decl_i + 2, s.p_eq());
  if is_named == 1 and has_colon == 1 {
    let nm: u64 = ax.n_sym(g, decl_i + 1);
    let want_tid: u64 = parse_want_tid(k, g, decl_i + 2);
    if st.st_ok(k) != 0 { return decl_i + 2; }
    let eqi: u64 = ctfn.skip_eq(g, decl_i + 2);
    if ctf.has_tok(g, eqi, s.p_eq()) == 0 { ctf.fail_msg(k, "expected =", 10, ax.e_ast()); return eqi; }
    let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let nj: u64 = eval_witness(k, g, eqi + 1, v);
    if st.st_ok(k) != 0 { return ax.skip_semi(g, nj); }
    if ctf.v_kind(v) != 7 { ctf.fail_msg(k, "given needs struct witness", 26, ax.e_type()); return ax.skip_semi(g, nj); }
    let got_tid: u64 = ctf.v_a(v);
    if want_tid != 0 and want_tid != got_tid {
      ctf.fail_msg(k, "given type mismatch", 19, ax.e_type());
      return ax.skip_semi(g, nj);
    }
    push_given(k, nm, got_tid, ctf.v_b(v), implicit);
    return ax.skip_semi(g, nj);
  }
  if is_named == 1 and has_eq == 1 {
    let nm: u64 = ax.n_sym(g, decl_i + 1);
    let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let nj: u64 = eval_witness(k, g, decl_i + 3, v);
    if st.st_ok(k) != 0 { return ax.skip_semi(g, nj); }
    if ctf.v_kind(v) != 7 { ctf.fail_msg(k, "given needs struct witness", 26, ax.e_type()); return ax.skip_semi(g, nj); }
    let got_tid: u64 = ctf.v_a(v);
    push_given(k, nm, got_tid, ctf.v_b(v), implicit);
    return ax.skip_semi(g, nj);
  }
  if implicit == 1 and has_colon == 0 and has_eq == 0 {
    let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let nj: u64 = eval_witness(k, g, decl_i + 1, v);
    if st.st_ok(k) != 0 { return ax.skip_semi(g, nj); }
    if ctf.v_kind(v) != 7 { ctf.fail_msg(k, "given needs struct witness", 26, ax.e_type()); return ax.skip_semi(g, nj); }
    push_given(k, 0, ctf.v_a(v), ctf.v_b(v), implicit);
    return ax.skip_semi(g, nj);
  }
  ctf.fail_msg(k, "expected given name", 19, ax.e_ast());
  return decl_i + 1;
};

// --- Phase 4：模块 Witness ------------------------------------------------
// implicit = 2 的条目记模块见证：[name@0 = 0, tid@8 = 模块号, wrec@16 = 封签视图,
// depth@24, implicit@32 = 2]。模块见证与 Step A 的结构见证永不混淆：
// find_implicit 只认 implicit == 1，模板搜索只认 implicit == 2。

let push_mod_implicit = func(k: Mut(st.State), modv: u64, seal: u64) -> u64 {
  return push_given(k, 0, modv, seal, 2);
};

let u64_at = func(arr: Mut(u64), i: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), ptr_cast(Mut(u8), arr) + i * 8);
};

// 模块成员的类型编号：类型别名取限定名，结构/枚举取形状上的类型。
let type_tid_of = func(k: Mut(st.State), m: Mut(modules.SymEntry)) -> u64 {
  let kd: u64 = modules.sym_kind(m);
  if kd == modules.sym_kind_type_alias() { return modules.sym_qual(m); }
  if kd == modules.sym_kind_struct() or kd == modules.sym_kind_enum() {
    let sh: u64 = modules.sym_shape(m);
    if sh == 0 { return 0; }
    return ctf.tid_of_shape(k, sh);
  }
  return 0;
};

// 模块导出的 pub let Self = T 的类型编号；没有则回 0。
let mod_self_tid = func(k: Mut(st.State), modv: u64) -> u64 {
  let e: Mut(modules.SymEntry) = modules.sym_find(k, modv, s.b_self_type());
  if is_null(e) { return 0; }
  if modules.sym_pub(e) == 0 { return 0; }
  return type_tid_of(k, e);
};

// --- 签名体里的条目名称解析 ------------------------------------------------
// 严格的名字点号链：Name ('.' Name)*
let sig_path_ok = func(g: u64, i: u64, te: u64) -> u64 {
  if i >= te { return 1; }
  if ax.is_name(g, i) == 0 { return 0; }
  if i + 1 == te { return 1; }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 0 { return 0; }
  return sig_path_ok(g, i + 2, te);
};

let sig_path_names = func(g: u64, i: u64, te: u64, out: Mut(u64), idx: u64) -> u64 {
  if i >= te { return idx; }
  if ax.is_name(g, i) == 1 {
    deref(u64_at(out, idx)) = ax.n_sym(g, i);
    return sig_path_names(g, i + 1, te, out, idx + 1);
  }
  return sig_path_names(g, i + 1, te, out, idx);
};

// 点号链的终止位置（不包含）：从 i 起连续吃 Name ('.' Name)*。
let path_end_at = func(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return i; }
  if ax.is_name(g, i) == 0 { return i; }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 0 { return i + 1; }
  return path_end_at(g, i + 2);
};

let sig_only = func(e: Mut(modules.SymEntry)) -> Mut(modules.SymEntry) {
  if is_null(e) { return null_ref(Mut(modules.SymEntry)); }
  if modules.sym_kind(e) != modules.sym_kind_sig() { return null_ref(Mut(modules.SymEntry)); }
  return e;
};

// 在 base_mod 里按裸名查签名符号。
let sig_local = func(k: Mut(st.State), base_mod: u64, name: u64) -> Mut(modules.SymEntry) {
  let e: Mut(modules.SymEntry) = modules.sym_find(k, base_mod, name);
  if is_null(e) == 0 { return e; }
  if base_mod == modules.cur(k) { return modules.find_here(k, name); }
  return null_ref(Mut(modules.SymEntry));
};

// 名字或点号路径在 base_mod 里解析成 sig 符号；不是 sig 回空引用。
let sig_ref_mod = func(k: Mut(st.State), base_mod: u64, g: u64, ts: u64, te: u64) -> Mut(modules.SymEntry) {
  if sig_path_ok(g, ts, te) == 0 { return null_ref(Mut(modules.SymEntry)); }
  let names: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8 * 17));
  let cnt: u64 = sig_path_names(g, ts, te, names, 0);
  if cnt == 0 { return null_ref(Mut(modules.SymEntry)); }
  if cnt == 1 { return sig_only(sig_local(k, base_mod, deref(u64_at(names, 0)))); }
  let seal: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8));
  deref(seal) = 0;
  let segs: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), names) + 8);
  let mv: u64 = modules.mod_resolve_path(k, base_mod, deref(u64_at(names, 0)), segs, cnt - 2, seal);
  if mv == 0 { return null_ref(Mut(modules.SymEntry)); }
  return sig_only(modules.sym_find(k, mv, deref(u64_at(names, cnt - 1))));
};

// 按当前词法作用域解析名称或点号路径对应的 sig。
let sig_at = func(k: Mut(st.State), g: u64, ts: u64, te: u64) -> Mut(modules.SymEntry) {
  return sig_ref_mod(k, modules.cur(k), g, ts, te);
};

// 签名体里是否声明了 Self：只认 ``[pub] let Self : ...`` 这种形状。
let sig_has_self_scan = func(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return 0; }
  if ax.is_name(g, i) == 1 {
    if ax.n_sym(g, i) == s.b_self_type() {
      if ctf.has_tok(g, i + 1, s.p_colon()) == 1 { return 1; }
    }
  }
  return sig_has_self_scan(g, i + 1);
};

let sig_has_self = func(sig_e: Mut(modules.SymEntry)) -> u64 {
  return sig_has_self_scan(modules.sym_decl(sig_e), 0);
};

// --- 签名成员核验 ---------------------------------------------------------
let sig_item_end = func(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return i; }
  if ax.is_semi(g, i) == 1 { return i; }
  return sig_item_end(g, i + 1);
};

let sig_deny = func(k: Mut(st.State), emit: u64, m: Ref(u8), n: u64) -> u64 {
  if emit != 0 { ctf.fail_msg(k, m, n, ax.e_type()); }
  return 0;
};

let fn_tids_at = func(k: Mut(st.State), ps: Mut(ty.Ty), i: u64, np: u64, sig: Mut(u64)) -> u64 {
  if i >= np { return 1; }
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let c: u64 = ty.ty_at(t, cx.ty_idx(ps, i));
  deref(u64_at(sig, i)) = ireg.tid_of(k, t);
  return fn_tids_at(k, ps, i + 1, np, sig);
};

// 模块成员是过程时的 Fn 类型编号：优先用登记好的 Fn TypeId，没有则现场拼。
let fn_tid_of_sym = func(k: Mut(st.State), m: Mut(modules.SymEntry)) -> u64 {
  let fid: u64 = modules.sym_fnid(m);
  if fid != 0 { return fid; }
  let sg: Mut(u8) = modules.sym_sig(m);
  let np: u64 = cx.sig_np(sg);
  let tids: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, np * 8 + 8));
  let tn: u64 = fn_tids_at(k, cx.sig_params(sg), 0, np, tids);
  return ct.fn_t(k, ireg.tid_of(k, cx.sig_ret(sg)), np, tids as u64);
};

// 一条签名要求的右侧：抽象类型、子签名或一般类型表达式。
let sig_check_typed = func(k: Mut(st.State), sig_e: Mut(modules.SymEntry), g: u64, mname: u64, m: Mut(modules.SymEntry), ts: u64, te: u64, emit: u64) -> u64 {
  // let Name : Type;  —— 抽象类型，后续条目里的 Self / Name 由此绑定解出。
  if te == ts + 1 and ax.is_name(g, ts) == 1 {
    if ax.n_sym(g, ts) == s.t_type() {
      let tid: u64 = type_tid_of(k, m);
      if tid == 0 { return sig_deny(k, emit, "sig mismatch: missing or private member", 39); }
      ctf.bind(k, mname, 1, tid, 0);
      return 1;
    }
  }
  // let Name : SubSig;  —— 子模块契约。
  let sub: Mut(modules.SymEntry) = sig_ref_mod(k, modules.sym_mod(sig_e), g, ts, te);
  if is_null(sub) == 0 {
    if modules.sym_kind(m) != modules.sym_kind_mod() {
      return sig_deny(k, emit, "sig mismatch: member type differs", 33);
    }
    return check_mod_matches_sig(k, modules.sym_qual(m), sub, emit);
  }
  // 一般类型表达式：Fn(...) -> ...、Self、i64 等。
  let want_t: Mut(ty.Ty) = ax.new_ty(k);
  let saved_err: u64 = st.st_ok(k);
  cx.parse_type(k, g, ts, want_t);
  if st.st_ok(k) != 0 {
    st.st_set_err(k, saved_err);
    return sig_deny(k, emit, "sig mismatch: member type differs", 33);
  }
  let kd: u64 = modules.sym_kind(m);
  let want_id: u64 = ireg.tid_of(k, want_t);
  if kd == modules.sym_kind_func() or kd == modules.sym_kind_extern() {
    let wsh: u64 = ireg.ty_shape(k, want_id);
    if wsh == 0 { return sig_deny(k, emit, "sig mismatch: member type differs", 33); }
    if agg.shp_kind(wsh) != agg.kind_fn() { return sig_deny(k, emit, "sig mismatch: member type differs", 33); }
    if want_id != fn_tid_of_sym(k, m) { return sig_deny(k, emit, "sig mismatch: member type differs", 33); }
    return 1;
  }
  if kd == modules.sym_kind_value() or kd == modules.sym_kind_data() {
    let got: u64 = ireg.tid_of(k, ptr_cast(Mut(ty.Ty), modules.sym_sig(m)));
    if want_id != got { return sig_deny(k, emit, "sig mismatch: member type differs", 33); }
    return 1;
  }
  return sig_deny(k, emit, "sig mismatch: member type differs", 33);
};

// i 指向 let 之后的名字。
let sig_check_one = func(k: Mut(st.State), impl_modv: u64, sig_e: Mut(modules.SymEntry), g: u64, i: u64, emit: u64) -> u64 {
  if i >= ax.n_count(g) { return sig_deny(k, emit, "sig mismatch: bad declaration", 29); }
  if ax.is_name(g, i) == 0 { return sig_deny(k, emit, "sig mismatch: bad declaration", 29); }
  let mname: u64 = ax.n_sym(g, i);
  if ctf.has_tok(g, i + 1, s.p_colon()) == 0 { return sig_deny(k, emit, "sig mismatch: bad declaration", 29); }
  let ts: u64 = i + 2;
  if ts >= ax.n_count(g) { return sig_deny(k, emit, "sig mismatch: bad declaration", 29); }
  let te: u64 = sig_item_end(g, ts);
  let m: Mut(modules.SymEntry) = modules.sym_find(k, impl_modv, mname);
  if is_null(m) { return sig_deny(k, emit, "sig mismatch: missing or private member", 39); }
  if modules.sym_pub(m) == 0 { return sig_deny(k, emit, "sig mismatch: missing or private member", 39); }
  if sig_check_typed(k, sig_e, g, mname, m, ts, te, emit) == 0 { return 0; }
  if te >= ax.n_count(g) { return 1; }
  return sig_check_items(k, impl_modv, sig_e, g, te + 1, emit);
};

let sig_check_items = func(k: Mut(st.State), impl_modv: u64, sig_e: Mut(modules.SymEntry), g: u64, i: u64, emit: u64) -> u64 {
  if i >= ax.n_count(g) { return 1; }
  if ax.is_semi(g, i) == 1 { return sig_check_items(k, impl_modv, sig_e, g, i + 1, emit); }
  if ax.is_name(g, i) == 1 {
    let w: u64 = ax.n_sym(g, i);
    if w == s.k_pub() { return sig_check_items(k, impl_modv, sig_e, g, i + 1, emit); }
    if w == s.k_let() { return sig_check_one(k, impl_modv, sig_e, g, i + 1, emit); }
  }
  return sig_deny(k, emit, "sig mismatch: bad declaration", 29);
};

// 模块实现是否满足签名：逐条核对公开成员与类型。emit_diag = 0 时只判定、不报错。
let check_mod_matches_sig = func(k: Mut(st.State), impl_modv: u64, sig_e: Mut(modules.SymEntry), emit_diag: u64) -> u64 {
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  st.st_set_src(k, modules.sym_src(sig_e));
  st.st_set_vmod(k, 0);
  let cm: u64 = ctf.mark(k);
  let r: u64 = sig_check_items(k, impl_modv, sig_e, modules.sym_decl(sig_e), 0, emit_diag);
  ctf.release(k, cm);
  st.st_set_src(k, saved_src);
  st.st_set_vmod(k, saved_vmod);
  return r;
};

// 模块候选是否命中：先比对 Self 类型，再逐条核验签名成员。
let mod_matches_sig = func(k: Mut(st.State), modv: u64, sig_e: Mut(modules.SymEntry), self_tid: u64, has_self: u64) -> u64 {
  if has_self != 0 {
    if mod_self_tid(k, modv) != self_tid { return 0; }
  }
  return check_mod_matches_sig(k, modv, sig_e, 0);
};

let SigPick = struct {
  has: u64,
  best: u64,
  depth: u64,
  count: u64
};

// 从记录区尾部向前扫描模块见证，取最内层深度里唯一命中的模块。
let sig_scan = func(k: Mut(st.State), base: Mut(GivenEntry), off: u64, sig_e: Mut(modules.SymEntry), self_tid: u64, has_self: u64, pick: Mut(SigPick)) -> u64 {
  if off == 0 { return 1; }
  let back: u64 = off - 40;
  let p: Mut(GivenEntry) = given_at(base, back);
  let imp: u64 = p.implicit;
  let dp: u64 = p.depth;
  let mv: u64 = p.tid;
  if imp == 2 {
    if pick.has == 1 and dp < pick.depth { return 1; }
    if pick.has == 0 { pick.depth = dp; }
    if dp == pick.depth {
      if pick.has == 0 or mv != pick.best {
        if mod_matches_sig(k, mv, sig_e, self_tid, has_self) == 1 {
          if pick.has == 0 {
            pick.has = 1;
            pick.best = mv;
            pick.count = 1;
          } else {
            pick.count = pick.count + 1;
          }
        }
      }
    }
  }
  return sig_scan(k, base, back, sig_e, self_tid, has_self, pick);
};

// 在当前 given 记录区里找唯一满足 sig_e 的模块见证；封签写成签名自身的封签视图。
let find_sig_implicit = func(k: Mut(st.State), sig_e: Mut(modules.SymEntry), self_tid: u64, has_self: u64, out_seal: Mut(u64)) -> u64 {
  let pick: Mut(SigPick) = ptr_cast(Mut(SigPick), st.st_alloc(k, 32));
  pick.has = 0;
  pick.best = 0;
  pick.depth = 0;
  pick.count = 0;
  sig_scan(k, g_base(k), g_used(k), sig_e, self_tid, has_self, pick);
  if st.st_ok(k) != 0 { return 0; }
  if pick.has == 0 {
    ctf.fail_msg(k, "missing module witness", 22, ax.e_type());
    return 0;
  }
  if pick.count > 1 {
    ctf.fail_msg(k, "ambiguous module witness", 24, ax.e_type());
    return 0;
  }
  deref(out_seal) = modules.sym_qual(sig_e);
  return pick.best;
};

// --- ?{ m: Mod } 实参是模块时求出模块见证值 ---------------------------------
// 名字、点号路径、函子调用三种形状；不是模块就回 0，交给常规 Witness 求值。
let eval_mod_arg = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ctf.CtVal)) -> u64 {
  if i >= ax.n_count(g) { return 0; }
  if ax.is_name(g, i) == 0 { return 0; }
  if ctf.has_delim(g, i + 1, ax.dl_paren()) == 1 {
    let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let j: u64 = ctfn.eval_factory_call(k, g, i, tv);
    if j == 0 { return 0; }
    if st.st_ok(k) != 0 { return j; }
    if ctf.v_kind(tv) != 9 { return 0; }
    ctf.v_set(out, 9, ctf.v_a(tv), ctf.v_b(tv));
    return j;
  }
  let nm: u64 = ax.n_sym(g, i);
  let pe: u64 = path_end_at(g, i);
  let cnt: u64 = (pe - i + 1) / 2;
  if cnt > 1 {
    let names: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8 * 17));
    let ncnt: u64 = sig_path_names(g, i, pe, names, 0);
    let seal: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8));
    deref(seal) = 0;
    let segs: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), names) + 8);
    let mv: u64 = modules.mod_resolve_path(k, modules.cur(k), deref(u64_at(names, 0)), segs, ncnt - 1, seal);
    if mv == 0 { return 0; }
    ctf.v_set(out, 9, mv, deref(seal));
    return pe;
  }
  let sb: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8));
  deref(sb) = 0;
  let um: u64 = ctf.find_used_mod(k, nm, sb);
  if um != 0 {
    ctf.v_set(out, 9, um, deref(sb));
    return i + 1;
  }
  let e: Mut(modules.SymEntry) = modules.find_here(k, nm);
  if is_null(e) == 0 {
    if modules.sym_kind(e) == modules.sym_kind_mod() {
      ctf.v_set(out, 9, modules.sym_qual(e), modules.sym_decl(e));
      return i + 1;
    }
  }
  return 0;
};
