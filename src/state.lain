// 状态：编译期的可变寄存器块，住在 guest 内存里。
// 所有字段布局集中在本文件，别的模块只经访问器读写。
// 不写标量顶层 let：顶层标量 let 在 IR 里是符号指针，不能直接当整数算。

extern lain2_mem_alloc(bytes: u64, align: u64) -> Mut(u8) = lain2_mem_alloc;

pub let LoopFrame = struct {
  label: u64,
  res: u64,
  mark: u64,
  np: u64,
  slot0: u64,
  slot1: u64,
  slot2: u64,
  slot3: u64
};

pub let State = struct {
  sp: u64,
  tmp: u64,
  label: u64,
  modv: u64,
  err: u64,
  base: Mut(u8),
  src: u64,
  vmod_seq: u64,
  term: u64,
  cap: u64,
  scratch: Mut(u8),
  frame: Mut(u8),
  depth: u64,
  retk: u64,
  retw: u64,
  looplbl: u64,
  arena: Mut(u8),
  arenasz: u64,
  arenaused: u64,
  slotj: u64,
  loopdepth: u64,
  retsg: u64,
  root: u64,
  prefix: u64,
  regbase: Mut(u8),
  regcap: u64,
  regused: u64,
  rallbase: Mut(u8),
  rallcap: u64,
  rallused: u64,
  databuf: Mut(u8),
  datacap: u64,
  dataused: u64,
  donebase: Mut(u8),
  shpbase: Mut(u8),
  shpused: u64,
  shpcap: u64,
  modbase: Mut(u8),
  modused: u64,
  modcap: u64,
  symbase: Mut(u8),
  symused: u64,
  symcap: u64,
  pndbase: Mut(u8),
  pndused: u64,
  pndcap: u64,
  strseq: u64,
  tybase: Mut(u8),
  tycap: u64,
  tyused: u64,
  rftab: u64,
  retptr: u64,
  anon: u64,
  qhead: u64,
  retsh: u64,
  ctbase: Mut(u8),
  ctcap: u64,
  ctused: u64,
  ctret: Mut(u8),
  ctdone: u64,
  typesh: u64,
  ctcache: Mut(u8),
  ctcache_n: u64,
  genblk: Mut(u8),
  in_proc: u64,
  fq_base: Mut(u8),
  fq_used: u64,
  fq_cap: u64,
  vmod: u64
};

// cap：绑定栈字节数。arena 与持久分配都跨源存活：一次编译
// 里所有源的形状、类型、符号必须同时有效。
pub let st_new = func(cap: u64) -> Mut(State) {
  let raw: Mut(u8) = lain2_mem_alloc(552, 8);
  let b: Mut(u8) = lain2_mem_alloc(cap, 8);
  let s: Mut(u8) = lain2_mem_alloc(256, 8);
  let f: Mut(u8) = lain2_mem_alloc(1024, 8);
  let a: Mut(u8) = lain2_mem_alloc(67108864, 8);
  let r: Mut(u8) = lain2_mem_alloc(8192, 8);
  let q: Mut(u8) = lain2_mem_alloc(1048576, 8);
  let d: Mut(u8) = lain2_mem_alloc(262144, 8);
  let g: Mut(u8) = lain2_mem_alloc(64, 8);
  let h: Mut(u8) = lain2_mem_alloc(16777216, 8);
  let m: Mut(u8) = lain2_mem_alloc(65536, 8);
  let t: Mut(u8) = lain2_mem_alloc(4194304, 8);
  let u: Mut(u8) = lain2_mem_alloc(8192, 8);
  let v: Mut(u8) = lain2_mem_alloc(65536, 8);
  let x: Mut(u8) = lain2_mem_alloc(32, 8);
  let gb: Mut(u8) = lain2_mem_alloc(128, 8);
  let fq: Mut(u8) = lain2_mem_alloc(32768, 8);
  let words: MutSlice(u64) = make_slice(MutSlice(u64), ptr_cast(Mut(u64), raw), 69);
  let w: u64 = loop w(j: u64 = 0) while j < 69 {
    words[j] = 0;
    j = j + 1;
  };
  let gb_words: MutSlice(u64) = make_slice(MutSlice(u64), ptr_cast(Mut(u64), gb), 16);
  let gz: u64 = loop gzw(j: u64 = 0) while j < 16 {
    gb_words[j] = 0;
    j = j + 1;
  };
  let fq_words: MutSlice(u64) = make_slice(MutSlice(u64), ptr_cast(Mut(u64), fq), 4096);
  let fz: u64 = loop fqz(j: u64 = 0) while j < 4096 {
    fq_words[j] = 0;
    j = j + 1;
  };
  let p: Mut(State) = ptr_cast(Mut(State), raw);
  p.base = b;
  p.cap = cap;
  p.scratch = s;
  p.frame = f;
  p.arena = a;
  p.arenasz = 67108864;
  p.regbase = r;
  p.regcap = 8192;
  p.rallbase = q;
  p.rallcap = 1048576;
  p.databuf = d;
  p.datacap = 262144;
  p.donebase = g;
  p.shpbase = h;
  p.shpused = 0;
  p.shpcap = 16777216;
  p.modbase = m;
  p.modused = 0;
  p.modcap = 65536;
  p.symbase = t;
  p.symused = 0;
  p.symcap = 4194304;
  p.pndbase = u;
  p.pndused = 0;
  p.pndcap = 8192;
  p.ctbase = v;
  p.ctcap = 65536;
  p.ctret = x;
  p.genblk = gb;
  p.vmod_seq = 1000;
  p.in_proc = 0;
  p.fq_base = fq;
  p.fq_used = 0;
  p.fq_cap = 32768;
  p.vmod = 0;
  return p;
};

pub let st_sp = func(p: Mut(State)) -> u64 { return p.sp; };
pub let st_set_sp = func(p: Mut(State), v: u64) -> u64 { p.sp = v; return v; };

let st_tmp = func(p: Mut(State)) -> u64 { return p.tmp; };
let st_set_tmp = func(p: Mut(State), v: u64) -> u64 { p.tmp = v; return v; };

let st_label = func(p: Mut(State)) -> u64 { return p.label; };
let st_set_label = func(p: Mut(State), v: u64) -> u64 { p.label = v; return v; };

pub let st_mod = func(p: Mut(State)) -> u64 { return p.modv; };
pub let st_set_mod = func(p: Mut(State), v: u64) -> u64 { p.modv = v; return v; };

pub let st_err = func(p: Mut(State)) -> u64 { return p.err; };
pub let st_set_err = func(p: Mut(State), v: u64) -> u64 { p.err = v; return v; };

pub let st_base = func(p: Mut(State)) -> Mut(u8) { return p.base; };

pub let st_src = func(p: Mut(State)) -> u64 { return p.src; };
pub let st_set_src = func(p: Mut(State), v: u64) -> u64 { p.src = v; return v; };

let st_term = func(p: Mut(State)) -> u64 { return p.term; };
let st_set_term = func(p: Mut(State), v: u64) -> u64 { p.term = v; return v; };

pub let st_cap = func(p: Mut(State)) -> u64 { return p.cap; };

pub let st_scratch = func(p: Mut(State)) -> Mut(u8) { return p.scratch; };

let st_frame = func(p: Mut(State)) -> Mut(u8) { return p.frame; };

let st_depth = func(p: Mut(State)) -> u64 { return p.depth; };
let st_set_depth = func(p: Mut(State), v: u64) -> u64 { p.depth = v; return v; };

pub let st_retk = func(p: Mut(State)) -> u64 { return p.retk; };
pub let st_set_retk = func(p: Mut(State), v: u64) -> u64 { p.retk = v; return v; };

pub let st_retw = func(p: Mut(State)) -> u64 { return p.retw; };
pub let st_set_retw = func(p: Mut(State), v: u64) -> u64 { p.retw = v; return v; };

let st_looplbl = func(p: Mut(State)) -> u64 { return p.looplbl; };
let st_set_looplbl = func(p: Mut(State), v: u64) -> u64 { p.looplbl = v; return v; };

let st_arena = func(p: Mut(State)) -> Mut(u8) { return p.arena; };

let st_arenasz = func(p: Mut(State)) -> u64 { return p.arenasz; };

pub let st_arenaused = func(p: Mut(State)) -> u64 { return p.arenaused; };
pub let st_set_arenaused = func(p: Mut(State), v: u64) -> u64 { p.arenaused = v; return v; };

let st_slotj = func(p: Mut(State)) -> u64 { return p.slotj; };
pub let st_set_slotj = func(p: Mut(State), v: u64) -> u64 { p.slotj = v; return v; };

pub let st_loopdepth = func(p: Mut(State)) -> u64 { return p.loopdepth; };
pub let st_set_loopdepth = func(p: Mut(State), v: u64) -> u64 { p.loopdepth = v; return v; };

pub let st_retsg = func(p: Mut(State)) -> u64 { return p.retsg; };
pub let st_set_retsg = func(p: Mut(State), v: u64) -> u64 { p.retsg = v; return v; };

// 当前源文件的根 AST 组句柄。
pub let st_root = func(p: Mut(State)) -> u64 { return p.root; };
pub let st_set_root = func(p: Mut(State), v: u64) -> u64 { p.root = v; return v; };

// 当前源文件的模块前缀（符号句柄，形如 s0__）。
let st_prefix = func(p: Mut(State)) -> u64 { return p.prefix; };
let st_set_prefix = func(p: Mut(State), v: u64) -> u64 { p.prefix = v; return v; };

// 本源里定义或导入的顶层名字（声明表）。
let st_regbase = func(p: Mut(State)) -> Mut(u8) { return p.regbase; };
let st_regcap = func(p: Mut(State)) -> u64 { return p.regcap; };
let st_regused = func(p: Mut(State)) -> u64 { return p.regused; };
let st_set_regused = func(p: Mut(State), v: u64) -> u64 { p.regused = v; return v; };

// 持久分配：不随源重置，存放类型块与描述符。
let st_rallbase = func(p: Mut(State)) -> Mut(u8) { return p.rallbase; };
let st_rallcap = func(p: Mut(State)) -> u64 { return p.rallcap; };
let st_rallused = func(p: Mut(State)) -> u64 { return p.rallused; };
let st_set_rallused = func(p: Mut(State), v: u64) -> u64 { p.rallused = v; return v; };

// 静态数据暂存：拼好字节再交给 lain2_ir_data_add。
pub let st_databuf = func(p: Mut(State)) -> Mut(u8) { return p.databuf; };
pub let st_datacap = func(p: Mut(State)) -> u64 { return p.datacap; };
pub let st_dataused = func(p: Mut(State)) -> u64 { return p.dataused; };
pub let st_set_dataused = func(p: Mut(State), v: u64) -> u64 { p.dataused = v; return v; };

// 已登记源标记：每份源一字节。
let st_donebase = func(p: Mut(State)) -> Mut(u8) { return p.donebase; };

pub let st_done = func(p: Mut(State), src: u64) -> u64 {
  let ds: Slice(u8) = make_slice(Slice(u8), p.donebase, 64);
  return b2u(ds[src]);
};

pub let st_mark_done = func(p: Mut(State), src: u64) -> u64 {
  let ds: MutSlice(u8) = make_slice(MutSlice(u8), p.donebase, 64);
  let one: u8 = 1;
  ds[src] = one;
  return 1;
};

// 形状表：聚合、数组、字符串描述的连续数组，条目 112 字节。
pub let st_shpbase = func(p: Mut(State)) -> Mut(u8) { return p.shpbase; };
pub let st_shpused = func(p: Mut(State)) -> u64 { return p.shpused; };
let st_set_shpused = func(p: Mut(State), v: u64) -> u64 { p.shpused = v; return v; };
let st_shpcap = func(p: Mut(State)) -> u64 { return p.shpcap; };

// 模块表：模块序号与别名。条目 32 字节。
pub let st_modbase = func(p: Mut(State)) -> Mut(u8) { return p.modbase; };
pub let st_modused = func(p: Mut(State)) -> u64 { return p.modused; };
let st_set_modused = func(p: Mut(State), v: u64) -> u64 { p.modused = v; return v; };
let st_modcap = func(p: Mut(State)) -> u64 { return p.modcap; };

// 模块符号表：每个模块的顶层声明。条目 88 字节。
pub let st_symbase = func(p: Mut(State)) -> Mut(u8) { return p.symbase; };
pub let st_symused = func(p: Mut(State)) -> u64 { return p.symused; };
let st_set_symused = func(p: Mut(State), v: u64) -> u64 { p.symused = v; return v; };
let st_symcap = func(p: Mut(State)) -> u64 { return p.symcap; };

// 匿名过程队列：条目 48 字节 [限定名, 源号, 根节点, 形参组, 签名, 预留模块号]。
let st_pndbase = func(p: Mut(State)) -> Mut(u8) { return p.pndbase; };
let st_pndused = func(p: Mut(State)) -> u64 { return p.pndused; };
let st_set_pndused = func(p: Mut(State), v: u64) -> u64 { p.pndused = v; return v; };
let st_pndcap = func(p: Mut(State)) -> u64 { return p.pndcap; };

// 匿名过程队列的写入与读出。
pub let st_q_add = func(p: Mut(State)) -> Mut(u8) { return st_pnd_new(p, 48); };
pub let st_q_count = func(p: Mut(State)) -> u64 { return st_pndused(p) / 48; };
pub let st_q_at = func(p: Mut(State), i: u64) -> Mut(u8) { return st_pndbase(p) + i * 48; };
pub let st_qhead = func(p: Mut(State)) -> u64 { return p.qhead; };
pub let st_set_qhead = func(p: Mut(State), v: u64) -> u64 { p.qhead = v; return v; };

// 值聚合返回的隐藏出参：当前过程的 %_ret 名字（0 表示不走 sret）。
pub let st_retptr = func(p: Mut(State)) -> u64 { return p.retptr; };
pub let st_set_retptr = func(p: Mut(State), v: u64) -> u64 { p.retptr = v; return v; };

// 返回类型的形状号：sret 的整块拷贝按它算字节数。
pub let st_retsh = func(p: Mut(State)) -> u64 { return p.retsh; };
pub let st_set_retsh = func(p: Mut(State), v: u64) -> u64 { p.retsh = v; return v; };

// 匿名过程的合成序号。
pub let st_anon = func(p: Mut(State)) -> u64 { return p.anon; };
pub let st_set_anon = func(p: Mut(State), v: u64) -> u64 { p.anon = v; return v; };

// 字符串字面量序号。
let st_strseq = func(p: Mut(State)) -> u64 { return p.strseq; };
let st_set_strseq = func(p: Mut(State), v: u64) -> u64 { p.strseq = v; return v; };

// 类型注册表：编译期类型句柄（TypeId）的登记处。条目 40 字节。
pub let st_tybase = func(p: Mut(State)) -> Mut(u8) { return p.tybase; };
pub let st_set_tybase = func(p: Mut(State), v: Mut(u8)) -> u64 { p.tybase = v; return 1; };
pub let st_tycap = func(p: Mut(State)) -> u64 { return p.tycap; };
pub let st_set_tycap = func(p: Mut(State), v: u64) -> u64 { p.tycap = v; return v; };
pub let st_tyused = func(p: Mut(State)) -> u64 { return p.tyused; };
pub let st_set_tyused = func(p: Mut(State), v: u64) -> u64 { p.tyused = v; return v; };

// 反射表是否已经铺进当前模块。
pub let st_rftab = func(p: Mut(State)) -> u64 { return p.rftab; };
pub let st_set_rftab = func(p: Mut(State), v: u64) -> u64 { p.rftab = v; return v; };

// 取旧值并把格子加一。
pub let st_next_tmp = func(p: Mut(State)) -> u64 {
  let n: u64 = p.tmp;
  p.tmp = n + 1;
  return n;
};

pub let st_next_label = func(p: Mut(State)) -> u64 {
  let n: u64 = p.label;
  p.label = n + 1;
  return n;
};

pub let st_next_slot = func(p: Mut(State)) -> u64 {
  let n: u64 = p.slotj;
  p.slotj = n + 1;
  return n;
};

pub let st_next_str = func(p: Mut(State)) -> u64 {
  let n: u64 = p.strseq;
  p.strseq = n + 1;
  return n;
};

// 字节判真：u8 参与比较前先零扩展到 u64。
let b2u = func(b: u8) -> u64 {
  return b as u64;
};

let mem_u8 = func(p: Ref(u8)) -> u8 {
  return deref(p);
};

let mem_put8 = func(p: Mut(u8), v: u64) -> u64 {
  deref(p) = v as u8;
  return v;
};

let mem_copy = func(dst: Mut(u8), src: Ref(u8), n: u64) -> u64 {
  let ds: MutSlice(u8) = make_slice(MutSlice(u8), dst, n);
  let ss: Slice(u8) = make_slice(Slice(u8), src, n);
  let i: u64 = loop c(i: u64 = 0) while i < n {
    ds[i] = ss[i];
    i = i + 1;
  };
  return i;
};

// arena：编译器给自己用的顺序切分内存，回收发生在整个源文件编译结束时。
pub let st_alloc = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.arenaused;
  let cap: u64 = p.arenasz;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.arenaused = used + n;
  return p.arena + used;
};

// 持久分配：跨源存活，装类型块与聚合描述符。
pub let st_ralloc = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.rallused;
  let cap: u64 = p.rallcap;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.rallused = used + n;
  return p.rallbase + used;
};

// 登记表顺序追加，溢出返回空指针并置错误码。
pub let st_shp_new = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.shpused;
  let cap: u64 = p.shpcap;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.shpused = used + n;
  return p.shpbase + used;
};

pub let st_mod_new = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.modused;
  let cap: u64 = p.modcap;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.modused = used + n;
  return p.modbase + used;
};

pub let st_sym_new = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.symused;
  let cap: u64 = p.symcap;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.symused = used + n;
  return p.symbase + used;
};

let st_pnd_new = func(p: Mut(State), n: u64) -> Mut(u8) {
  let used: u64 = p.pndused;
  let cap: u64 = p.pndcap;
  if used + n > cap { st_fail(p, 3); return null_ref(Mut(u8)); }
  p.pndused = used + n;
  return p.pndbase + used;
};

// --- 编译期绑定栈与求值结果 ---------------------------------------------
// 编译期绑定栈：每条 32 字节 [名字符号, 种类, 值一, 值二]。
pub let st_ctbase = func(p: Mut(State)) -> Mut(u8) { return p.ctbase; };
pub let st_ctcap = func(p: Mut(State)) -> u64 { return p.ctcap; };
pub let st_ctused = func(p: Mut(State)) -> u64 { return p.ctused; };
pub let st_set_ctused = func(p: Mut(State), v: u64) -> u64 { p.ctused = v; return v; };

// 编译期函数 return 的结果单元（24 字节 [种类, 值一, 值二]）与返回标志。
pub let st_ctret = func(p: Mut(State)) -> Mut(u8) { return p.ctret; };
pub let st_ctdone = func(p: Mut(State)) -> u64 { return p.ctdone; };
pub let st_set_ctdone = func(p: Mut(State), v: u64) -> u64 { p.ctdone = v; return v; };

// 内建 Type 类型的逻辑形状号，第一次用到时创建。
pub let st_typesh = func(p: Mut(State)) -> u64 { return p.typesh; };
pub let st_set_typesh = func(p: Mut(State), v: u64) -> u64 { p.typesh = v; return v; };

// 编译期类型工厂记忆化缓存区基址与已用条数。
pub let st_ctcache = func(p: Mut(State)) -> Mut(u8) { return p.ctcache; };
pub let st_set_ctcache = func(p: Mut(State), v: Mut(u8)) -> Mut(u8) { p.ctcache = v; return v; };
pub let st_ctcache_n = func(p: Mut(State)) -> u64 { return p.ctcache_n; };
pub let st_set_ctcache_n = func(p: Mut(State), v: u64) -> u64 { p.ctcache_n = v; return v; };

// Phase 2B 拓展块（128 字节）：见证表 / 单态化缓存 / 泛型待编队列。
pub let st_genblk = func(p: Mut(State)) -> Mut(u8) { return p.genblk; };

// 虚拟模块序号：内联 module 与函子实例化共用一条单调递增的编号流。
let st_vmod_seq = func(p: Mut(State)) -> u64 { return p.vmod_seq; };

pub let st_next_vmod = func(p: Mut(State)) -> u64 {
  let n: u64 = p.vmod_seq;
  if n < 1000 { n = 1000; }
  p.vmod_seq = n + 1;
  return n;
};

// 当前正在求值的过程编号（0 表示不在过程体内）。
pub let st_in_proc = func(p: Mut(State)) -> u64 { return p.in_proc; };
pub let st_set_in_proc = func(p: Mut(State), v: u64) -> u64 { p.in_proc = v; return v; };

// 限定名拼装区：跨模块路径（A$B$name）在此拼接，32768 字节。
pub let st_fqbase = func(p: Mut(State)) -> Mut(u8) { return p.fq_base; };
pub let st_fqused = func(p: Mut(State)) -> u64 { return p.fq_used; };
pub let st_set_fqused = func(p: Mut(State), v: u64) -> u64 { p.fq_used = v; return v; };
pub let st_fqcap = func(p: Mut(State)) -> u64 { return p.fq_cap; };

// 词法作用域编号覆盖：0 表示沿用源编号 p.src。
pub let st_vmod = func(p: Mut(State)) -> u64 { return p.vmod; };
pub let st_set_vmod = func(p: Mut(State), v: u64) -> u64 { p.vmod = v; return v; };
pub let st_scope = func(p: Mut(State)) -> u64 { if p.vmod != 0 { return p.vmod; } return p.src; };

pub let st_fail = func(p: Mut(State), code: u64) -> u64 {
  p.err = code;
  return code;
};

pub let st_ok = func(p: Mut(State)) -> u64 { return p.err; };

// Ty/Val 缓冲都是单文件内的临时量，编译新文件前清空，避免跨文件累计耗尽。
let st_reset_arena = func(p: Mut(State)) -> u64 {
  p.arenaused = 0;
  return 0;
};

// --- 循环帧 -------------------------------------------------------------
// 第 i 帧 64 字节：标签、结果槽、环境标记、参数个数、4 个参数槽。
pub let st_lf = func(p: Mut(State), i: u64) -> Mut(LoopFrame) {
  return ptr_cast(Mut(LoopFrame), p.frame + i * 64);
};

pub let st_lf_label = func(f: Mut(LoopFrame)) -> u64 { return f.label; };
pub let st_set_lf_label = func(f: Mut(LoopFrame), v: u64) -> u64 { f.label = v; return v; };

pub let st_lf_res = func(f: Mut(LoopFrame)) -> u64 { return f.res; };
pub let st_set_lf_res = func(f: Mut(LoopFrame), v: u64) -> u64 { f.res = v; return v; };

let st_lf_mark = func(f: Mut(LoopFrame)) -> u64 { return f.mark; };
pub let st_set_lf_mark = func(f: Mut(LoopFrame), v: u64) -> u64 { f.mark = v; return v; };

pub let st_lf_np = func(f: Mut(LoopFrame)) -> u64 { return f.np; };
pub let st_set_lf_np = func(f: Mut(LoopFrame), v: u64) -> u64 { f.np = v; return v; };

pub let st_lf_slot = func(f: Mut(LoopFrame), i: u64) -> u64 {
  if i == 0 { return f.slot0; }
  if i == 1 { return f.slot1; }
  if i == 2 { return f.slot2; }
  return f.slot3;
};

pub let st_set_lf_slot = func(f: Mut(LoopFrame), i: u64, v: u64) -> u64 {
  if i == 0 { f.slot0 = v; return v; }
  if i == 1 { f.slot1 = v; return v; }
  if i == 2 { f.slot2 = v; return v; }
  f.slot3 = v;
  return v;
};
