// member.lain —— 成员路径与内建调用：名字.名字、枚举变体、聚合构造与字段、
// 导入模块成员、内建实参收集。递归求值经外部链接回到 core 与 refval。
let st = import("state");
let ty = import("types");
let env = import("env");
let ir = import("ir");
let s = import("sym");
let ax = import("ast");
let cx = import("ctx");
let agg = import("agg");
let modules = import("modules");
let bi = import("builtins");
let cl = import("calls");
let rf = import("refval");
let gn = import("generics");
let ireg = import("tyreg");
let ctf = import("ctfor");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;

let val_idx = func(ab: Mut(ty.Val), idx: u64) -> Mut(ty.Val) {
  return ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + idx * 56);
};

// --- ast / ctx 层转发（正文的裸调用经这里转一手） --------------------------
let new_ty = func(k: Mut(st.State)) -> Mut(ty.Ty) { return ax.new_ty(k); };
let new_val = func(k: Mut(st.State)) -> Mut(ty.Val) { return ax.new_val(k); };
let n_count = func(g: u64) -> u64 { return ax.n_count(g); };
let n_at = func(g: u64, i: u64) -> u64 { return ax.n_at(g, i); };
let n_sym = func(g: u64, i: u64) -> u64 { return ax.n_sym(g, i); };
let is_group = func(g: u64, i: u64) -> u64 { return ax.is_group(g, i); };
let is_name = func(g: u64, i: u64) -> u64 { return ax.is_name(g, i); };
let is_comma = func(g: u64, i: u64) -> u64 { return ax.is_comma(g, i); };
let delim_of = func(g: u64, i: u64) -> u64 { return ax.delim_of(g, i); };
let dl_paren = func() -> u64 { return ax.dl_paren(); };
let dl_brace = func() -> u64 { return ax.dl_brace(); };
let e_ast = func() -> u64 { return ax.e_ast(); };
let e_unbound = func() -> u64 { return ax.e_unbound(); };
let e_type = func() -> u64 { return ax.e_type(); };
let e_unsup = func() -> u64 { return ax.e_unsup(); };
let tnone = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.tnone(k); };
let expect_sym = func(k: Mut(st.State), g: u64, i: u64, sym: u64) -> u64 { return cx.expect_sym(k, g, i, sym); };
let slot_get = func(k: Mut(st.State), j: u64, tp: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return cx.slot_get(k, j, tp, out); };
let expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return core_expr(k, g, i, minp, want, out); };
let typed_builtin = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return rf.typed_builtin(k, g, i, want, out); };
let member_on_val = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return rf.member_on_val(k, g, i, minp, want, out); };

// 路径上的每一段：后面还有 .名字 时先试子模块，否则按成员落定。
// 成员之后剩下的 .字段 与 [下标] 后缀由 core 的后缀流程接着处理。
let member_step = func(k: Mut(st.State), g: u64, pos: u64, m: u64, sn: Mut(u64), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = n_count(g);
  let name: u64 = n_sym(g, pos);
  let more: u64 = if pos + 2 < n and is_name(g, pos + 2) == 1 and n_sym(g, pos + 1) == s.p_dot() { 1 } else { 0 };
  if more == 1 {
    let nb: Mut(u64) = ax.box(k);
    let nx: u64 = modules.resolve_child_mod(k, m, deref(sn), name, modules.cur(k), nb);
    if nx != 0 {
      deref(sn) = ax.box_get(nb);
      return member_step(k, g, pos + 2, nx, sn, want, out);
    }
  }
  let e: Mut(modules.SymEntry) = modules.sym_lookup_in(k, m, deref(sn), name, modules.cur(k));
  if is_null(e) {
    let pv: Mut(modules.SymEntry) = modules.sym_find(k, m, name);
    if (pv as u64) != 0 {
      let pm: Ref(u8) = "private symbol";
      let pd: u64 = ir.diag(k, 0, 1, pm, 14);
    }
    let um: Ref(u8) = "unbound module member";
    let ud: u64 = ir.diag(k, 0, 1, um, 21);
    st.st_fail(k, e_unbound());
    return pos + 1;
  }
  return path_member(k, g, pos, e, want, out);
};

// 模块成员路径 M.x / A.B.x / A.B.fn(...) / A.B.Struct { ... } / A.B.Enum.Variant。
let module_member = func(k: Mut(st.State), g: u64, i: u64, m0: u64, s0: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let sn: Mut(u64) = ax.box(k);
  deref(sn) = s0;
  return member_step(k, g, i + 2, m0, sn, want, out);
};

// 路径末段的成员：枚举变体先分流，其余交给成员分派。
let path_member = func(k: Mut(st.State), g: u64, last: u64, e: Mut(modules.SymEntry), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let nx: u64 = last + 1;
  let n: u64 = n_count(g);
  let kd: u64 = modules.sym_kind(e);
  if kd == modules.sym_kind_enum() and nx + 1 < n and is_group(g, nx) == 0 {
    if n_sym(g, nx) == s.p_dot() and is_name(g, nx + 1) == 1 {
      let sh: u64 = modules.sym_shape(e);
      let vpos: u64 = nx + 1;
      if vpos + 1 < n and is_group(g, vpos + 1) == 1 {
        if delim_of(g, vpos + 1) == dl_brace() {
          let made: u64 = variant_new(k, sh, n_sym(g, vpos), n_at(g, vpos + 1), out);
          let gone: u64 = made;
          return vpos + 2;
        }
        if delim_of(g, vpos + 1) == dl_paren() {
          let got: u64 = variant_proj_call(k, sh, n_sym(g, vpos), n_at(g, vpos + 1), want, out);
          let gone: u64 = got;
          return vpos + 2;
        }
      }
      st.st_fail(k, e_unsup());
      return vpos + 1;
    }
  }
  return member_entry(k, g, last, e, want, out);
};

// 名字 . 名字：本地变量、枚举变体与静态数据走运行期路径，其余按模块成员路径解析。
let dotted = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let a: u64 = n_sym(g, i);
  let b: u64 = n_sym(g, i + 2);
  // 局部变量：先取值再按值定位成员，切片 len/ptr、聚合字段与链式后缀共用一条路。
  if env.env_find(k, a) != 0 {
    let bv: Mut(ty.Val) = new_val(k);
    let bj: u64 = cl.var_ref(k, g, i, tnone(k), bv);
    if st.st_ok(k) != 0 { return i + 3; }
    ty.val_at(out, bv);
    return member_on_val(k, g, i + 1, 0, want, out);
  }
  let le: Mut(modules.SymEntry) = ctf.find_sym(k, a);
  if (le as u64) != 0 {
    let lk: u64 = modules.sym_kind(le);
    if lk == modules.sym_kind_enum() {
      let sh: u64 = modules.sym_shape(le);
      if i + 3 < n_count(g) {
        if is_group(g, i + 3) == 1 and delim_of(g, i + 3) == dl_brace() {
          let made: u64 = variant_new(k, sh, b, n_at(g, i + 3), out);
          let gone: u64 = made;
          return i + 4;
        }
        if is_group(g, i + 3) == 1 and delim_of(g, i + 3) == dl_paren() {
          let got: u64 = variant_proj_call(k, sh, b, n_at(g, i + 3), want, out);
          let gone: u64 = got;
          return i + 4;
        }
      }
      st.st_fail(k, e_unsup());
      return i + 3;
    }
    if lk == modules.sym_kind_data() or lk == modules.sym_kind_value() {
      return field_ref(k, g, i, a, b, out);
    }
  }
  let sn: Mut(u64) = ax.box(k);
  let m0: u64 = ctf.find_used_mod(k, a, sn);
  if m0 != 0 { return module_member(k, g, i, m0, ax.box_get(sn), want, out); }
  return field_ref(k, g, i, a, b, out);
};

// Shape.Circle { 载荷 }
let variant_new = func(k: Mut(st.State), sh: u64, vname: u64, argp: u64, out: Mut(ty.Val)) -> u64 {
  let m: Mut(agg.Member) = agg.mem_find(sh, vname);
  if is_null(m) { st.st_fail(k, e_unsup()); return 0; }
  let objv: Mut(ty.Val) = new_val(k);
  let obj: u64 = agg.new_obj(k, sh, objv);
  let tg: u64 = agg.tag_write(k, obj, agg.mem_tag(m));
  if agg.mem_has(m) == 1 {
    let mt: Mut(ty.Ty) = new_ty(k);
    let s1: u64 = agg.mem_ty(k, m, mt);
    let pv: Mut(ty.Val) = new_val(k);
    let j: u64 = expr(k, argp, 0, 0, mt, pv);
    let cv: Mut(ty.Val) = new_val(k);
    cx.coerce(k, pv, ty.vty(pv), mt, cv);
    let sv: u64 = agg.store_at(k, obj, agg.mem_off(m), cv, mt);
  }
  ty.val_at(out, objv);
  return 0;
};

// Shape.Circle(s)：标签命中才读载荷，否则给 0。
let variant_proj_call = func(k: Mut(st.State), sh: u64, vname: u64, argp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let av: Mut(ty.Val) = new_val(k);
  let at: Mut(ty.Ty) = new_ty(k);
  let a1: u64 = ty.ty_addr(at);
  let a2: u64 = ty.ty_set_sh(at, sh);
  let j: u64 = expr(k, argp, 0, 0, at, av);
  let rt: Mut(ty.Ty) = new_ty(k);
  if ty.ty_known(want) == 1 { let cp: u64 = ty.ty_at(rt, want); } else { let i32v: u64 = ty.ty_i32(rt); }
  let r: u64 = agg.variant_proj(k, sh, ty.vn(av), vname, rt, out);
  let ignored: u64 = j;
  return 0;
};

// 已知形状号的聚合构造（供 Name { ... } 与 Name(...) { ... } 共用）。
let agg_construct_sh = func(k: Mut(st.State), sh: u64, fg: u64, out: Mut(ty.Val)) -> u64 {
  let objv: Mut(ty.Val) = new_val(k);
  let obj: u64 = agg.new_obj(k, sh, objv);
  let j: u64 = agg_fields(k, sh, fg, 0, obj);
  let ignored: u64 = j;
  ty.val_at(out, objv);
  return 1;
};

// Name { 字段: 表达式 ... }
let agg_construct = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Val)) -> u64 {
  let nm: u64 = n_sym(g, i);
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, nm);
  if is_null(e) { cl.fail_name(k, nm, e_unbound()); return i + 2; }
  if modules.sym_kind(e) == modules.sym_kind_type_alias() {
    let ash: u64 = ireg.ty_shape(k, modules.sym_qual(e));
    agg_construct_sh(k, ash, n_at(g, i + 1), out);
    return i + 2;
  }
  let sh: u64 = modules.sym_shape(e);
  if sh == 0 { st.st_fail(k, e_type()); return i + 2; }
  agg_construct_sh(k, sh, n_at(g, i + 1), out);
  return i + 2;
};

// 字段列表：名字 : 表达式，字段之间的逗号可有可无。
let agg_fields = func(k: Mut(st.State), sh: u64, fg: u64, i: u64, obj: u64) -> u64 {
  let n: u64 = n_count(fg);
  if i >= n { return i; }
  if st.st_ok(k) != 0 { return i; }
  if is_comma(fg, i) == 1 { return agg_fields(k, sh, fg, i + 1, obj); }
  let fname: u64 = n_sym(fg, i);
  let m: Mut(agg.Member) = agg.mem_find(sh, fname);
  if is_null(m) { st.st_fail(k, e_unsup()); return i + 1; }
  let a: u64 = expect_sym(k, fg, i + 1, s.p_colon());
  let mt: Mut(ty.Ty) = new_ty(k);
  let s1: u64 = agg.mem_ty(k, m, mt);
  let pv: Mut(ty.Val) = new_val(k);
  let j: u64 = expr(k, fg, a, 0, mt, pv);
  let cv: Mut(ty.Val) = new_val(k);
  cx.coerce(k, pv, ty.vty(pv), mt, cv);
  let sv: u64 = agg.store_at(k, obj, agg.mem_off(m), cv, mt);
  return agg_fields(k, sh, fg, j, obj);
};

// 变量字段：p.x，嵌套聚合给地址，标量给值。
let field_ref = func(k: Mut(st.State), g: u64, i: u64, var_sym: u64, fname: u64, out: Mut(ty.Val)) -> u64 {
  let off: u64 = env.env_find(k, var_sym);
  if off == 0 { cl.fail_name(k, var_sym, e_unbound()); return i + 3; }
  let vt: Mut(ty.Ty) = new_ty(k);
  env.env_ty(k, off, vt);
  let sh: u64 = ty.tsh(vt);
  if sh == 0 { st.st_fail(k, e_type()); return i + 3; }
  let m: Mut(agg.Member) = agg.mem_find(sh, fname);
  if is_null(m) { st.st_fail(k, e_unsup()); return i + 3; }
  let ov: Mut(ty.Val) = new_val(k);
  slot_get(k, env.env_slot(k, off), vt, ov);
  let obj: u64 = ty.vn(ov);
  let et: Mut(ty.Ty) = new_ty(k);
  let e1: u64 = agg.mem_ty(k, m, et);
  let lv: Mut(ty.Val) = new_val(k);
  let l: u64 = agg.load_at(k, obj, agg.mem_off(m), et, lv);
  ty.val_at(out, lv);
  return i + 3;
};

// 已知符号的成员引用：M.bump(...)、M.answer、M.table、M.Struct { ... }、M.gen(...)。
let member_entry = func(k: Mut(st.State), g: u64, i: u64, e: Mut(modules.SymEntry), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let kd: u64 = modules.sym_kind(e);
  let q: u64 = modules.sym_qual(e);
  let has_call: u64 = if i + 1 < n_count(g) and is_group(g, i + 1) == 1 and delim_of(g, i + 1) == dl_paren() { 1 } else { 0 };
  if kd == modules.sym_kind_mod() or kd == modules.sym_kind_sig() {
    let mm: Ref(u8) = "module is compile-time only";
    let md: u64 = ir.diag(k, 0, 1, mm, 27);
    st.st_fail(k, e_unsup());
    return i + 1;
  }
  if kd == modules.sym_kind_func() or kd == modules.sym_kind_extern() {
    if has_call == 1 {
      let j: u64 = cl.call_sig(k, q, modules.sym_sig(e), n_at(g, i + 1), want, out);
      return i + 2;
    }
    st.st_fail(k, e_ast());
    return i + 1;
  }
  if kd == modules.sym_kind_struct() {
    if i + 1 < n_count(g) and is_group(g, i + 1) == 1 and delim_of(g, i + 1) == dl_brace() {
      let made: u64 = agg_construct_sh(k, modules.sym_shape(e), n_at(g, i + 1), out);
      let gone: u64 = made;
      return i + 2;
    }
    st.st_fail(k, e_ast());
    return i + 1;
  }
  if kd == modules.sym_kind_type_alias() {
    if i + 1 < n_count(g) and is_group(g, i + 1) == 1 and delim_of(g, i + 1) == dl_brace() {
      let sh: u64 = ireg.ty_shape(k, modules.sym_qual(e));
      let made2: u64 = agg_construct_sh(k, sh, n_at(g, i + 1), out);
      let gone2: u64 = made2;
      return i + 2;
    }
    st.st_fail(k, e_ast());
    return i + 1;
  }
  if kd == modules.sym_kind_generic() {
    if has_call == 1 {
      let nb: Mut(u64) = ax.box(k);
      gn.call_generic(k, e, g, i, want, out, nb);
      return ax.box_get(nb);
    }
    st.st_fail(k, e_ast());
    return i + 1;
  }
  let vt: Mut(u8) = modules.sym_sig(e);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let ins: u64 = ir.emit_call(k, res, q, 0);
  let t2: Mut(ty.Ty) = new_ty(k);
  if (vt as u64) != 0 { let cp: u64 = ty.ty_at(t2, ptr_cast(Mut(ty.Ty), vt)); } else { let nn: u64 = ty.ty_none(t2); }
  ty.val_ref(out, res, t2);
  return i + 1;
};

// 内建调用：实参先各自求值，再由 builtins 按名字分派。
let builtin_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let name: u64 = n_sym(g, i);
  let argsg: u64 = n_at(g, i + 1);
  if name == s.b_symbol_addr() {
    let made: u64 = bi.symbol_addr(k, argsg, out, st.st_src(k));
    let gone: u64 = made;
    return i + 2;
  }
  // 需要知道名字绑定（ref_of(slot) 取槽地址，而不是槽里的值）的内建先走这里。
  let sp: u64 = typed_builtin(k, g, i, want, out);
  if sp != 0 { return sp; }
  let na: u64 = n_count(argsg);
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, na * 56 + 8));
  let j: u64 = bi_args(k, argsg, 0, 0, na, ab);
  let r: u64 = bi.apply(k, name, ptr_cast(Mut(u8), ab), na, want, out);
  let ignored: u64 = j;
  return i + 2;
};

let bi_args = func(k: Mut(st.State), g: u64, i: u64, idx: u64, na: u64, ab: Mut(ty.Val)) -> u64 {
  let n: u64 = n_count(g);
  if i >= n { return i; }
  if idx >= na { return i; }
  let nt: Mut(ty.Ty) = tnone(k);
  let v: Mut(ty.Val) = new_val(k);
  let j: u64 = expr(k, g, i, 0, nt, v);
  let cp: u64 = ty.val_at(val_idx(ab, idx), v);
  if is_comma(g, j) == 1 { return bi_args(k, g, j + 1, idx + 1, na, ab); }
  return j;
};
