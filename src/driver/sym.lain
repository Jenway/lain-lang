// 符号：关键字、标点、运算符与基础类型名的 SymId。
// hr.sym_intern 幂等：重复驻留同一个名字拿回同一个句柄，
// 所以这些访问器随用随取，不需要缓存表。
let hr = import("src::driver::host_rt");

pub let intern = func(p: Ref(u8), n: u64) -> u64 {
  return hr.sym_intern(p, n);
};

pub let k_func = func() -> u64 { return hr.sym_intern("func", 4); };

pub let k_let = func() -> u64 { return hr.sym_intern("let", 3); };

pub let k_if = func() -> u64 { return hr.sym_intern("if", 2); };

pub let k_else = func() -> u64 { return hr.sym_intern("else", 4); };

pub let k_while = func() -> u64 { return hr.sym_intern("while", 5); };

pub let k_loop = func() -> u64 { return hr.sym_intern("loop", 4); };

pub let k_break = func() -> u64 { return hr.sym_intern("break", 5); };

pub let k_continue = func() -> u64 { return hr.sym_intern("continue", 8); };

pub let k_return = func() -> u64 { return hr.sym_intern("return", 6); };

pub let k_as = func() -> u64 { return hr.sym_intern("as", 2); };

pub let k_extern = func() -> u64 { return hr.sym_intern("extern", 6); };

// 语法宏声明关键字：@macro 之后跟宏名、形参与宏体。
pub let k_macro = func() -> u64 { return hr.sym_intern("macro", 5); };

// extern 声明的属性键：abi 选择调用约定，lib 与 link 描述链接方式。
pub let k_abi = func() -> u64 { return hr.sym_intern("abi", 3); };

pub let k_lib = func() -> u64 { return hr.sym_intern("lib", 3); };

pub let k_link = func() -> u64 { return hr.sym_intern("link", 4); };

pub let k_import = func() -> u64 { return hr.sym_intern("import", 6); };

pub let k_struct = func() -> u64 { return hr.sym_intern("struct", 6); };

pub let k_enum = func() -> u64 { return hr.sym_intern("enum", 4); };

pub let k_for = func() -> u64 { return hr.sym_intern("for", 3); };

pub let k_in = func() -> u64 { return hr.sym_intern("in", 2); };

pub let k_and = func() -> u64 { return hr.sym_intern("and", 3); };

pub let k_or = func() -> u64 { return hr.sym_intern("or", 2); };

pub let k_ref = func() -> u64 { return hr.sym_intern("ref", 3); };

pub let k_mut = func() -> u64 { return hr.sym_intern("mut", 3); };

pub let k_ro = func() -> u64 { return hr.sym_intern("ro", 2); };

pub let k_slice = func() -> u64 { return hr.sym_intern("slice", 5); };

pub let k_true = func() -> u64 { return hr.sym_intern("true", 4); };

pub let k_false = func() -> u64 { return hr.sym_intern("false", 5); };

pub let k_eval = func() -> u64 { return hr.sym_intern("eval", 4); };

pub let k_inject = func() -> u64 { return hr.sym_intern("inject", 6); };

pub let k_comptime = func() -> u64 { return hr.sym_intern("comptime", 8); };

// Phase 4 模块系统关键字。
pub let k_pub = func() -> u64 { return hr.sym_intern("pub", 3); };

pub let k_module = func() -> u64 { return hr.sym_intern("module", 6); };

pub let k_sig = func() -> u64 { return hr.sym_intern("sig", 3); };

pub let k_use = func() -> u64 { return hr.sym_intern("use", 3); };

pub let k_open = func() -> u64 { return hr.sym_intern("open", 4); };

// Phase 5 的 match 决策树与代数效应关键字。
pub let k_match = func() -> u64 { return hr.sym_intern("match", 5); };

pub let k_effect = func() -> u64 { return hr.sym_intern("effect", 6); };

pub let k_op = func() -> u64 { return hr.sym_intern("op", 2); };

pub let k_perform = func() -> u64 { return hr.sym_intern("perform", 7); };

pub let k_handle = func() -> u64 { return hr.sym_intern("handle", 6); };

pub let k_with = func() -> u64 { return hr.sym_intern("with", 4); };

pub let k_resume = func() -> u64 { return hr.sym_intern("resume", 6); };

pub let p_eq = func() -> u64 { return hr.sym_intern("=", 1); };

pub let p_arrow = func() -> u64 { return hr.sym_intern("->", 2); };

pub let p_colon = func() -> u64 { return hr.sym_intern(":", 1); };

pub let p_comma = func() -> u64 { return hr.sym_intern(",", 1); };

pub let p_dot = func() -> u64 { return hr.sym_intern(".", 1); };

let p_dcolon = func() -> u64 { return hr.sym_intern("::", 2); };

pub let p_dotdot = func() -> u64 { return hr.sym_intern("..", 2); };

// 变参标记 `...`：reader 把它切成 `..` 加 `.` 两个标点，
// 这里保留完整三点的名字，供按原文匹配变参语法的调用方使用。
pub let p_ellipsis = func() -> u64 { return hr.sym_intern("...", 3); };

pub let p_at = func() -> u64 { return hr.sym_intern("@", 1); };

pub let p_qmark = func() -> u64 { return hr.sym_intern("?", 1); };

pub let p_bang = func() -> u64 { return hr.sym_intern("!", 1); };

pub let o_plus = func() -> u64 { return hr.sym_intern("+", 1); };

pub let o_minus = func() -> u64 { return hr.sym_intern("-", 1); };

pub let o_star = func() -> u64 { return hr.sym_intern("*", 1); };

pub let o_slash = func() -> u64 { return hr.sym_intern("/", 1); };

pub let o_percent = func() -> u64 { return hr.sym_intern("%", 1); };

pub let o_amp = func() -> u64 { return hr.sym_intern("&", 1); };

pub let o_pipe = func() -> u64 { return hr.sym_intern("|", 1); };

pub let o_caret = func() -> u64 { return hr.sym_intern("^", 1); };

pub let o_shl = func() -> u64 { return hr.sym_intern("<<", 2); };

pub let o_shr = func() -> u64 { return hr.sym_intern(">>", 2); };

pub let o_lt = func() -> u64 { return hr.sym_intern("<", 1); };

pub let o_le = func() -> u64 { return hr.sym_intern("<=", 2); };

pub let o_gt = func() -> u64 { return hr.sym_intern(">", 1); };

pub let o_ge = func() -> u64 { return hr.sym_intern(">=", 2); };

pub let o_eq = func() -> u64 { return hr.sym_intern("==", 2); };

pub let o_ne = func() -> u64 { return hr.sym_intern("!=", 2); };

pub let t_i8 = func() -> u64 { return hr.sym_intern("i8", 2); };

pub let t_i16 = func() -> u64 { return hr.sym_intern("i16", 3); };

pub let t_i32 = func() -> u64 { return hr.sym_intern("i32", 3); };

pub let t_i64 = func() -> u64 { return hr.sym_intern("i64", 3); };

pub let t_u8 = func() -> u64 { return hr.sym_intern("u8", 2); };

pub let t_u16 = func() -> u64 { return hr.sym_intern("u16", 3); };

pub let t_u32 = func() -> u64 { return hr.sym_intern("u32", 3); };

pub let t_u64 = func() -> u64 { return hr.sym_intern("u64", 3); };

pub let t_usize = func() -> u64 { return hr.sym_intern("usize", 5); };

// C ABI 的基础类型名：宽度与符号由绑定方保证，语义分析只按名字落到定宽类型上。
pub let t_c_int = func() -> u64 { return hr.sym_intern("c_int", 5); };

pub let t_c_uint = func() -> u64 { return hr.sym_intern("c_uint", 6); };

pub let t_c_long = func() -> u64 { return hr.sym_intern("c_long", 6); };

pub let t_c_size = func() -> u64 { return hr.sym_intern("c_size", 6); };

pub let t_c_char = func() -> u64 { return hr.sym_intern("c_char", 6); };

pub let t_f32 = func() -> u64 { return hr.sym_intern("f32", 3); };

pub let t_f64 = func() -> u64 { return hr.sym_intern("f64", 3); };

pub let t_bool = func() -> u64 { return hr.sym_intern("bool", 4); };

pub let t_addr = func() -> u64 { return hr.sym_intern("addr_of", 4); };

pub let t_void = func() -> u64 { return hr.sym_intern("void", 4); };

// 编译期类型句柄名。
pub let t_type = func() -> u64 { return hr.sym_intern("Type", 4); };

// 代数效应的编译期类型名：Effect 是效应值，EffectRow 是效果集，Never 是中止性操作的返回类型。
pub let t_effect = func() -> u64 { return hr.sym_intern("Effect", 6); };

pub let t_effect_row = func() -> u64 { return hr.sym_intern("EffectRow", 9); };

pub let t_never = func() -> u64 { return hr.sym_intern("Never", 5); };

pub let b_load = func() -> u64 { return hr.sym_intern("load", 4); };

pub let b_store = func() -> u64 { return hr.sym_intern("store", 5); };

pub let b_lea = func() -> u64 { return hr.sym_intern("lea", 3); };

pub let b_ptr_of = func() -> u64 { return hr.sym_intern("ptr_of", 6); };

pub let b_addr_of = func() -> u64 { return hr.sym_intern("addr_of", 7); };

pub let b_len = func() -> u64 { return hr.sym_intern("len", 3); };

pub let b_ref_of = func() -> u64 { return hr.sym_intern("ref_of", 6); };

let b_mut_ref_of = func() -> u64 { return hr.sym_intern("mut_ref_of", 10); };

pub let b_mut_of = func() -> u64 { return hr.sym_intern("mut_of", 6); };

pub let b_deref = func() -> u64 { return hr.sym_intern("deref", 5); };

pub let b_fn_of = func() -> u64 { return hr.sym_intern("fn_of", 5); };

pub let b_slice_of = func() -> u64 { return hr.sym_intern("slice_of", 8); };

pub let b_symbol_addr = func() -> u64 { return hr.sym_intern("symbol_addr", 11); };

pub let b_icall = func() -> u64 { return hr.sym_intern("icall", 5); };

// 匿名过程的合成名前缀。
pub let a_anon = func() -> u64 { return hr.sym_intern("anon", 4); };

// 复合类型工厂的名字。
pub let t_ref = func() -> u64 { return hr.sym_intern("Ref", 3); };

pub let t_mut = func() -> u64 { return hr.sym_intern("Mut", 3); };

// 未初始化存储：Uninit(T) 与 Ref / Mut 同为 8 字节地址，但不可读。
pub let t_uninit = func() -> u64 { return hr.sym_intern("Uninit", 6); };

pub let t_slice = func() -> u64 { return hr.sym_intern("Slice", 5); };

pub let t_mutslice = func() -> u64 { return hr.sym_intern("MutSlice", 8); };

pub let t_array = func() -> u64 { return hr.sym_intern("Array", 5); };

pub let t_fn = func() -> u64 { return hr.sym_intern("Fn", 2); };

// 模块句柄与关联模块的绑定名 Self。
pub let t_module = func() -> u64 { return hr.sym_intern("Module", 6); };

pub let b_self_type = func() -> u64 { return hr.sym_intern("Self", 4); };

// 切片头的成员名。
pub let t_len = func() -> u64 { return hr.sym_intern("len", 3); };

pub let t_ptr = func() -> u64 { return hr.sym_intern("ptr", 3); };

// FieldInfo 的成员名。
pub let t_name = func() -> u64 { return hr.sym_intern("name", 4); };

pub let t_off = func() -> u64 { return hr.sym_intern("offset", 6); };

// FieldInfo 的字段类型成员：type 与 ty 两种写法都指向同一条记录。
pub let t_fty = func() -> u64 { return hr.sym_intern("type", 4); };

pub let t_fld_ty = func() -> u64 { return hr.sym_intern("ty", 2); };

pub let b_ptr_cast = func() -> u64 { return hr.sym_intern("ptr_cast", 8); };

pub let b_make_slice = func() -> u64 { return hr.sym_intern("make_slice", 10); };

pub let b_null_ref = func() -> u64 { return hr.sym_intern("null_ref", 8); };

// 值系统第一阶段：未初始化存储的写入与交出。
pub let b_init_at = func() -> u64 { return hr.sym_intern("init_at", 7); };

pub let b_init_zero = func() -> u64 { return hr.sym_intern("init_zero", 9); };

pub let b_drop_at = func() -> u64 { return hr.sym_intern("drop_at", 7); };

pub let b_is_null = func() -> u64 { return hr.sym_intern("is_null", 7); };

pub let b_atomic_load = func() -> u64 { return hr.sym_intern("atomic_load", 11); };

pub let b_atomic_store = func() -> u64 { return hr.sym_intern("atomic_store", 12); };

pub let b_atomic_cas = func() -> u64 { return hr.sym_intern("atomic_cas", 10); };

pub let b_atomic_add = func() -> u64 { return hr.sym_intern("atomic_add", 10); };

pub let b_atomic_fence = func() -> u64 { return hr.sym_intern("atomic_fence", 12); };
