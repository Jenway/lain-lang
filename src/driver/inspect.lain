// src/driver/inspect.lain —— lainc 的源码检视输出：模块依赖图与公开接口文档。
// 两个入口都在编译完成之后运行：它们只读状态、模块表与符号表，不产生 IR。

let hr = import("src::driver::host_rt");
let st = import("src::driver::state");
let modules = import("src::sema::modules");
let agg = import("src::sema::agg");
let ax = import("src::sema::ast");
let gn = import("src::sema::generics");
let io = import("std::io");
let os = import("std::os");
let mem = import("std::mem");

// 导入的结构类型不能直接进 size_of，按宿主运行时的写法包一层本地单元结构。
let ModCell = struct { v: modules.ModEntry };
let SymCell = struct { v: modules.SymEntry };

let mod_rec = func() -> u64 { return size_of(ModCell); };
let sym_rec = func() -> u64 { return size_of(SymCell); };

let out_cap = func() -> u64 { return 16777216; };

// --- 输出缓冲 -------------------------------------------------------------
// 先写进一块宿主递增区里的缓冲，最后一次性交给标准输出或 --out 指定的文件。
let Out = struct {
  base: Mut(u8),
  cap: u64,
  len: u64,
  last: u64
};

let out_new = func() -> Out {
  let raw: Mut(u8) = hr.mem_alloc(out_cap(), 8);
  if is_null(raw) {
    let dead: u64 = mem.halt_now(out_cap());
    return Out { base: raw, cap: 0, len: 0, last: 0 };
  }
  return Out { base: raw, cap: out_cap(), len: 0, last: 0 };
};

let out_room = func(o: Mut(Out), n: u64) -> Mut(u8) {
  if o.len + n > o.cap {
    let dead: u64 = mem.halt_now(o.len + n);
    return null_ref(Mut(u8));
  }
  return o.base + o.len;
};

let out_char = func(o: Mut(Out), b: u64) -> u64 {
  let p: Mut(u8) = out_room(o, 1);
  deref(p) = b as u8;
  o.len = o.len + 1;
  o.last = b;
  return 1;
};

let out_put = func(o: Mut(Out), s: Slice(u8)) -> u64 {
  if s.len == 0 { return 0; }
  let p: Mut(u8) = out_room(o, s.len);
  let d: MutSlice(u8) = make_slice(MutSlice(u8), p, s.len);
  let i: u64 = loop c(i: u64 = 0) while i < s.len {
    d[i] = s[i];
    i = i + 1;
  };
  o.len = o.len + s.len;
  let last: u8 = s[s.len - 1];
  o.last = last as u64;
  return i;
};

let out_u64 = func(o: Mut(Out), v: u64) -> u64 {
  if v >= 10 {
    let head: u64 = out_u64(o, v / 10);
  }
  return out_char(o, 48 + (v % 10));
};

let out_sym = func(o: Mut(Out), h: u64) -> u64 {
  if h == 0 { return 0; }
  let p: Ref(u8) = modules.sym_addr(h);
  let n: u64 = modules.sym_len(h);
  return out_put(o, make_slice(Slice(u8), p, n));
};

let out_flush = func(o: Mut(Out), path: Slice(u8)) -> u64 {
  let text: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), o.base), o.len);
  if path.len == 0 {
    let wrote: u64 = io.write_str(text);
    if wrote == text.len { return 0; }
    return 1;
  }
  let rc: u64 = os.write_file(path, text);
  if rc == 0 { return 0; }
  os.eprint("[inspect] cannot write output file: ");
  os.eprint(path);
  os.eprint("\n");
  return 1;
};

// --- 模块表 ---------------------------------------------------------------
let mod_count = func(k: Mut(st.State)) -> u64 {
  return st.st_modused(k) / mod_rec();
};

let mod_at = func(k: Mut(st.State), i: u64) -> Mut(modules.ModEntry) {
  return ptr_cast(Mut(modules.ModEntry), st.st_modbase(k) + i * mod_rec());
};

// 父链编码：交回「父模块号 + 1」，0 表示没有父链。
let parent_of = func(k: Mut(st.State), child: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(modules.ModEntry) = mod_at(k, i);
  if (p.owner == child) and (p.kind == modules.mod_kind_parent()) {
    return p.src + 1;
  }
  return parent_of(k, child, i + 1, n);
};

// 虚拟模块号沿父链上溯到所在源文件；找不到时交回源数量（一个无效编号）。
let owner_source = func(k: Mut(st.State), owner: u64, depth: u64) -> u64 {
  let count: u64 = hr.source_count();
  if owner < count { return owner; }
  if depth > 16 { return count; }
  let encoded: u64 = parent_of(k, owner, 0, mod_count(k));
  if encoded == 0 { return count; }
  return owner_source(k, encoded - 1, depth + 1);
};

let edge_seen = func(k: Mut(st.State), upto: u64, owner: u64, target: u64,
                     i: u64) -> u64 {
  if i >= upto { return 0; }
  let p: Mut(modules.ModEntry) = mod_at(k, i);
  if (p.kind == modules.mod_kind_import()) and (p.src == target) {
    let got: u64 = owner_source(k, p.owner, 0);
    if got == owner { return 1; }
  }
  return edge_seen(k, upto, owner, target, i + 1);
};

let dump_nodes = func(o: Mut(Out), i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  out_put(o, "  m");
  out_u64(o, i);
  out_put(o, "[\"");
  out_put(o, hr.source_path_slice(i));
  out_put(o, "\"]\n");
  return dump_nodes(o, i + 1, n);
};

let dump_edges = func(o: Mut(Out), k: Mut(st.State), i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(modules.ModEntry) = mod_at(k, i);
  let source_count: u64 = hr.source_count();
  if (p.kind == modules.mod_kind_import()) and (p.src < source_count) {
    let owner: u64 = owner_source(k, p.owner, 0);
    if (owner < source_count) and (owner != p.src) {
      let seen: u64 = edge_seen(k, i, owner, p.src, 0);
      if seen == 0 {
        out_put(o, "  m");
        out_u64(o, owner);
        out_put(o, " --> m");
        out_u64(o, p.src);
        out_put(o, "\n");
      }
    }
  }
  return dump_edges(o, k, i + 1, n);
};

pub let dump_deps = func(k: Mut(st.State), path: Slice(u8)) -> u64 {
  let o0: Out = out_new();
  let o: Mut(Out) = mut_of(o0);
  let count: u64 = hr.source_count();
  out_put(o, "flowchart LR\n");
  let nodes: u64 = dump_nodes(o, 0, count);
  let edges: u64 = dump_edges(o, k, 0, mod_count(k));
  return out_flush(o, path);
};

// --- 接口文档 -------------------------------------------------------------
let sym_count = func(k: Mut(st.State)) -> u64 {
  return st.st_symused(k) / sym_rec();
};

let sym_at = func(k: Mut(st.State), i: u64) -> Mut(modules.SymEntry) {
  return ptr_cast(Mut(modules.SymEntry), st.st_symbase(k) + i * sym_rec());
};

let scalar_name = func(w: u64, sg: u64) -> Slice(u8) {
  if w == 1 {
    if sg == 0 { return "bool"; }
    return "i1";
  }
  if w == 8 { if sg == 1 { return "i8"; } else { return "u8"; } }
  if w == 16 { if sg == 1 { return "i16"; } else { return "u16"; } }
  if w == 32 { if sg == 1 { return "i32"; } else { return "u32"; } }
  if w == 64 { if sg == 1 { return "i64"; } else { return "u64"; } }
  return "u64";
};

// 符号的种类判定：类型声明、可导出的函数，以及不属于这两类的声明。
let is_type_sym = func(e: Mut(modules.SymEntry)) -> u64 {
  let kd: u64 = modules.sym_kind(e);
  if kd == modules.sym_kind_struct() { return 1; }
  if kd == modules.sym_kind_enum() { return 1; }
  if kd == modules.sym_kind_sig() { return 1; }
  if kd == modules.sym_kind_mod() { return 1; }
  return 0;
};

let is_fn_sym = func(e: Mut(modules.SymEntry)) -> u64 {
  let kd: u64 = modules.sym_kind(e);
  if kd == modules.sym_kind_func() { return 1; }
  if kd == modules.sym_kind_generic() { return 1; }
  return 0;
};

let print_type_line = func(o: Mut(Out), e: Mut(modules.SymEntry)) -> u64 {
  let kd: u64 = modules.sym_kind(e);
  out_put(o, "- `");
  if kd == modules.sym_kind_sig() {
    out_put(o, "sig ");
  } else if kd == modules.sym_kind_mod() {
    out_put(o, "module ");
  } else {
    let sh: u64 = modules.sym_shape(e);
    let sk: u64 = if sh == 0 { 0 } else { agg.shp_kind(sh) };
    if sk == agg.kind_cenum() {
      out_put(o, "enum(");
      out_put(o, scalar_name(agg.shp_und_w(sh), agg.shp_und_sg(sh)));
      out_put(o, ") ");
    } else if sk == agg.kind_enum() {
      out_put(o, "enum ");
    } else {
      out_put(o, "struct ");
    }
  }
  out_sym(o, modules.sym_name(e));
  out_put(o, "`\n");
  return 1;
};

// 记号间的空格：括号内侧、逗号/冒号/分号之前不留空格，其余相邻记号之间留一格。
let gap_after = func(b: u64) -> u64 {
  if b == 40 or b == 91 or b == 123 or b == 63 or b == 46 or b == 96 { return 0; }
  return 1;
};

let gap_before = func(b: u64) -> u64 {
  if b == 41 or b == 93 or b == 125 or b == 44 or b == 59 or b == 58 or b == 46 { return 0; }
  if b == 40 or b == 91 { return 0; }
  return 1;
};

// 把 AST 节点按原文写进缓冲；组按分隔符递归展开。
let print_node = func(o: Mut(Out), h: u64) -> u64 {
  if ax.is_group_node(h) == 0 {
    let n: u64 = ax.lit_len(h);
    if n == 0 { return 0; }
    let p: Ref(u8) = ax.lit_addr(h);
    let s: Slice(u8) = make_slice(Slice(u8), p, n);
    let first: u64 = s[0] as u64;
    if (o.len != 0) and (gap_after(o.last) == 1) and (gap_before(first) == 1) {
      let sp: u64 = out_char(o, 32);
    }
    return out_put(o, s);
  }
  let d: u64 = ax.delim(h);
  let openb: u64 = if d == ax.dl_paren() { 40 } else { if d == ax.dl_bracket() { 91 } else { 123 } };
  let closeb: u64 = if d == ax.dl_paren() { 41 } else { if d == ax.dl_bracket() { 93 } else { 125 } };
  if (o.len != 0) and (gap_after(o.last) == 1) and (gap_before(openb) == 1) {
    let sp: u64 = out_char(o, 32);
  }
  let op: u64 = out_char(o, openb);
  let inner: u64 = print_seq(o, h, 0, ax.n_count(h));
  return out_char(o, closeb);
};

let print_seq = func(o: Mut(Out), g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let h: u64 = ax.n_at(g, i);
  let one: u64 = print_node(o, h);
  return print_seq(o, g, i + 1, n);
};

let find_body = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return n; }
  if (ax.is_group(g, i) == 1) and (ax.delim_of(g, i) == ax.dl_brace()) {
    return i;
  }
  return find_body(g, i + 1, n);
};

// 函数声明的原文范围：从 func 词到体花括号之前。
let print_fn_sig = func(o: Mut(Out), e: Mut(modules.SymEntry)) -> u64 {
  let src: u64 = modules.sym_src(e);
  let g: u64 = hr.source_root(src);
  if g == 0 { return 0; }
  let n: u64 = ax.n_count(g);
  let decl: u64 = modules.sym_decl(e);
  if decl >= n { return 0; }
  let kd: u64 = modules.sym_kind(e);
  let body: u64 = if kd == modules.sym_kind_generic() {
    let hdr: Mut(gn.GenHdr) = ptr_cast(Mut(gn.GenHdr), modules.sym_sig(e));
    hdr.body_i
  } else {
    find_body(g, decl + 1, n)
  };
  let stop: u64 = if body > n { n } else { body };
  if stop <= decl { return 0; }
  return print_seq(o, g, decl, stop);
};

let print_fn_line = func(o: Mut(Out), e: Mut(modules.SymEntry)) -> u64 {
  out_put(o, "- `");
  out_sym(o, modules.sym_name(e));
  out_put(o, "` — `");
  let at: u64 = o.len;
  let sig: u64 = print_fn_sig(o, e);
  if o.len == at { out_put(o, "func(...)"); }
  out_put(o, "`\n");
  return 1;
};

let docs_types = func(o: Mut(Out), k: Mut(st.State), modv: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let e: Mut(modules.SymEntry) = sym_at(k, i);
  if (modules.sym_mod(e) == modv) and (modules.sym_pub(e) != 0) and (is_type_sym(e) == 1) {
    let line: u64 = print_type_line(o, e);
  }
  return docs_types(o, k, modv, i + 1, n);
};

let docs_fns = func(o: Mut(Out), k: Mut(st.State), modv: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let e: Mut(modules.SymEntry) = sym_at(k, i);
  if (modules.sym_mod(e) == modv) and (modules.sym_pub(e) != 0) and (is_fn_sym(e) == 1) {
    let line: u64 = print_fn_line(o, e);
  }
  return docs_fns(o, k, modv, i + 1, n);
};

let dump_source_docs = func(o: Mut(Out), k: Mut(st.State), src: u64) -> u64 {
  let total: u64 = sym_count(k);
  out_put(o, "## `");
  out_put(o, hr.source_path_slice(src));
  out_put(o, "`\n\n### Types\n\n");
  let t: u64 = docs_types(o, k, src, 0, total);
  out_put(o, "\n### Functions\n\n");
  let f: u64 = docs_fns(o, k, src, 0, total);
  out_put(o, "\n");
  return 1;
};

let docs_sources = func(o: Mut(Out), k: Mut(st.State), i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let one: u64 = dump_source_docs(o, k, i);
  return docs_sources(o, k, i + 1, n);
};

pub let dump_docs = func(k: Mut(st.State), path: Slice(u8)) -> u64 {
  let o0: Out = out_new();
  let o: Mut(Out) = mut_of(o0);
  let count: u64 = hr.source_count();
  let body: u64 = docs_sources(o, k, 0, count);
  return out_flush(o, path);
};
