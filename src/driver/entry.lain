let os = import("std::os");
let st = import("src::driver::state");
let ev = import("src::sema::eval");
let ex = import("src::syntax::expand");
let ir = import("src::sema::ir_emit");
let tr = import("std::trace");
let hr = import("src::driver::host_rt");
let err = import("src::driver::err");
let insp = import("src::driver::inspect");
let option = import("std::option");

let OptSlice = option.Option(Slice(u8));

let CliOpts = struct {
  help: bool,
  c99: bool,
  opt: bool,
  release_fast: bool,
  print_result: bool,
  dump_expand: bool,
  dump_deps: bool,
  dump_docs: bool,
  out_path: OptSlice.Opt,
  split_c: OptSlice.Opt,
  trace_path: OptSlice.Opt,
  entry_name: OptSlice.Opt,
  target: OptSlice.Opt,
  src_path: OptSlice.Opt,
  bad_args: bool,
};

let same_range = func(a: Slice(u8), b: Slice(u8), i: u64) -> bool {
  if i >= a.len { return true; }
  if a[i] != b[i] { return false; }
  return same_range(a, b, i + 1);
};

let same = func(a: Slice(u8), b: Slice(u8)) -> bool {
  if a.len != b.len { return false; }
  return same_range(a, b, 0);
};

let ends_c = func(s: Slice(u8)) -> bool {
  if s.len < 2 { return false; }
  if s[s.len - 2] != 46 { return false; }
  if s[s.len - 1] != 99 { return false; }
  return true;
};

let arg = func(i: u64) -> Slice(u8) {
  let n: u64 = os.argv_len(i);
  let cap: u64 = n + 1;
  let raw: u64 = os.alloc_bytes(cap);
  let buf: MutSlice(u8) = make_slice(MutSlice(u8), ptr_cast(Mut(u8), raw), cap);
  let got: u64 = os.argv_copy(i, buf);
  return make_slice(Slice(u8), ptr_cast(Ref(u8), raw), got);
};

let usage = func() -> u64 {
  let msg: Slice(u8) = "usage: lainc <source.lain> [--out <out.l1|out.c|out.md|out.mmd>] [--split-c <prefix>] [--c99] [--opt] [--release-fast] [--entry <name>] [--target <windows|linux|macos>] [--trace <trace.json>] [--print-result] [--dump-expand] [--dump-deps] [--dump-docs] [--help]\n";
  return os.eprint(msg);
};

let parse = func(o: Mut(CliOpts), i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let s: Slice(u8) = arg(i);
  if same(s, "--out") and (i + 1 < n) {
    o.out_path = OptSlice.some(arg(i + 1));
    return parse(o, i + 2, n);
  }
  if same(s, "--split-c") and (i + 1 < n) {
    o.split_c = OptSlice.some(arg(i + 1));
    return parse(o, i + 2, n);
  }
  if same(s, "--entry") and (i + 1 < n) {
    o.entry_name = OptSlice.some(arg(i + 1));
    return parse(o, i + 2, n);
  }
  if same(s, "--trace") and (i + 1 < n) {
    o.trace_path = OptSlice.some(arg(i + 1));
    return parse(o, i + 2, n);
  }
  if same(s, "--target") and (i + 1 < n) {
    o.target = OptSlice.some(arg(i + 1));
    return parse(o, i + 2, n);
  }
  if same(s, "--help") or same(s, "-h") {
    o.help = true;
    return 0;
  }
  if same(s, "--c99") {
    o.c99 = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--opt") {
    o.opt = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--release-fast") {
    o.release_fast = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--print-result") {
    o.print_result = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--dump-expand") {
    o.dump_expand = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--dump-deps") {
    o.dump_deps = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--dump-docs") {
    o.dump_docs = true;
    return parse(o, i + 1, n);
  }
  if same(s, "--out") or same(s, "--split-c") or same(s, "--entry") or same(s, "--trace") or same(s, "--target") {
    o.bad_args = true;
    return 1;
  }
  let src: OptSlice.Opt = o.src_path;
  if OptSlice.is_none(src) {
    o.src_path = OptSlice.some(s);
    return parse(o, i + 1, n);
  }
  o.bad_args = true;
  return 1;
};

let entry_name = func(o: Mut(CliOpts)) -> Slice(u8) {
  let en: OptSlice.Opt = o.entry_name;
  return match en {
    None => "s0__main",
    Some(name) => name,
  };
};

let target_apply = func(o: Mut(CliOpts)) -> u64 {
  let t: OptSlice.Opt = o.target;
  return match t {
    None => 0,
    Some(name) => {
      if same(name, "windows") {
        let s0: u64 = hr.set_target_os(hr.OS_WINDOWS());
        return 0;
      }
      if same(name, "linux") {
        let s1: u64 = hr.set_target_os(hr.OS_LINUX());
        return 0;
      }
      if same(name, "macos") {
        let s2: u64 = hr.set_target_os(hr.OS_MACOS());
        return 0;
      }
      1
    },
  };
};

let trace_finish = func(rc: u64) -> u64 {
  if tr.trace_is_enabled() == 0 { return rc; }
  let cap: u64 = 4194304;
  let p: Mut(u8) = hr.mem_alloc(cap, 8);
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), p, cap);
  let n: u64 = tr.dump_json(ms);
  hr.trace_flush(ptr_cast(Ref(u8), p), n);
  return rc;
};

let kind_of = func(code: u64) -> err.ErrKind {
  if code == 2 { return err.ErrKind.CompileUnbound { }; }
  if code == 21 { return err.ErrKind.CompileUnbound { }; }
  if code == 22 { return err.ErrKind.CompileUnbound { }; }
  if code == 3 { return err.ErrKind.CompileType { }; }
  if code == 4 { return err.ErrKind.CompileType { }; }
  return err.ErrKind.CompileSyntax { };
};

let report_code = func(src: u64, span: u64, msg: Slice(u8)) -> u64 {
  let printed: u64 = hr.report_fail_at(src, span, msg);
  return 1;
};

pub let build = func(k: Mut(st.State), i: u64, count: u64) -> u64 {
  if i >= count { return st.st_ok(k); }
  let e: u64 = ev.compile_source(k, i);
  let code: u64 = st.st_ok(k);
  if code != 0 {
    hr.print_diags();
    trace_finish(code);
    return report_code(i, hr.source_err_offset(i),
                       "source compilation failed");
  }
  let total: u64 = hr.source_count();
  return build(k, i + 1, total);
};

let run_meta = func(count: u64) -> u64 {
  hr.rt_init();
  if hr.trace_enabled() == 1 {
    tr.trace_enable(1);
  }
  let k: Mut(st.State) = st.st_new(65536);
  let rf: u64 = st.st_set_release_fast(k, hr.release_fast());
  let mname: u64 = hr.source_name(0);
  let md: u64 = ir.mod_new(k, mname);
  let t_build: u64 = tr.span_begin();
  let built: u64 = build(k, 0, count);
  let ev_build: u64 = tr.span_end("lainc_build", "lainc", t_build, count);
  if built != 0 { return trace_finish(built); }
  let t_verify: u64 = tr.span_begin();
  let v: u64 = ir.verify(k);
  let ev_verify: u64 = tr.span_end("ir_verify", "lainc", t_verify, v);
  if v != 0 {
    hr.print_diags();
    trace_finish(v);
    return report_code(0, 0, "LAINIR verification failed");
  }

  let t_emit: u64 = tr.span_begin();
  let written: u64 = ir.emit_output(k);
  let ev_emit: u64 = tr.span_end("ir_emit", "lainc", t_emit, written);
  return trace_finish(st.st_ok(k));
};

@root
let lain_meta_v2_entry = func(count: u64) -> u64 {
  return run_meta(count);
};

let run_cli = func() -> u64 {
  hr.rt_init();
  let o0: CliOpts = CliOpts {
    help: false,
    c99: false,
    opt: false,
    release_fast: false,
    print_result: false,
    dump_expand: false,
    dump_deps: false,
    dump_docs: false,
    out_path: OptSlice.none(),
    split_c: OptSlice.none(),
    trace_path: OptSlice.none(),
    entry_name: OptSlice.none(),
    target: OptSlice.none(),
    src_path: OptSlice.none(),
    bad_args: false,
  };
  let o: Mut(CliOpts) = mut_of(o0);
  let argc: u64 = os.argc();
  if argc < 2 {
    usage();
    return 2;
  }
  parse(o, 1, argc);
  if o.help {
    usage();
    return 0;
  }
  if o.bad_args {
    usage();
    return 2;
  }
  let tgt_bad: u64 = target_apply(o);
  if tgt_bad != 0 {
    usage();
    return 2;
  }
  if o.release_fast {
    let rf: u64 = hr.set_release_fast(1);
  }
  let src_opt: OptSlice.Opt = o.src_path;
  let src: Slice(u8) = match src_opt {
    None => "",
    Some(p) => p,
  };
  let trace_opt: OptSlice.Opt = o.trace_path;
  match trace_opt {
    None => 0,
    Some(p) => {
      hr.trace_set_path(p);
      tr.trace_enable(1);
      0
    },
  }
  let added: u64 = hr.source_add_file(src);
  if added == hr.NO_SOURCE() {
    hr.report_source_fail(src);
    trace_finish(1);
    return 1;
  }
  let k: Mut(st.State) = st.st_new(65536);
  let rf: u64 = st.st_set_release_fast(k, hr.release_fast());
  let mname: u64 = hr.source_name(added);
  let md: u64 = ir.mod_new(k, mname);

  if o.dump_expand {
    let root: u64 = hr.source_root(added);
    let exp: u64 = ex.expand_root(k, root);
    let code: u64 = st.st_ok(k);
    if code != 0 {
      hr.print_diags();
      trace_finish(code);
      return report_code(added, hr.source_err_offset(added),
                         "expand pass failed");
    }
    let dumped: u64 = ex.dump_ast(exp);
    return trace_finish(0);
  }
  let t_build: u64 = tr.span_begin();
  let built: u64 = build(k, 0, 1);
  let ev_build: u64 = tr.span_end("cli_build", "lainc", t_build, 1);
  if built != 0 { return built; }

  if o.dump_deps or o.dump_docs {
    let dump_path: Slice(u8) = match o.out_path {
      None => "",
      Some(p) => p,
    };
    if o.dump_deps { return trace_finish(insp.dump_deps(k, dump_path)); }
    return trace_finish(insp.dump_docs(k, dump_path));
  }
  if o.opt {
    let t_opt: u64 = tr.span_begin();
    let changed: u64 = ir.opt(k);
    let ev_opt: u64 = tr.span_end("cli_opt", "lainc", t_opt, changed);
  }
  let t_verify: u64 = tr.span_begin();
  let v: u64 = ir.verify(k);
  let ev_verify: u64 = tr.span_end("cli_verify", "lainc", t_verify, v);
  if v != 0 {
    hr.print_diags();
    trace_finish(v);
    return report_code(added, hr.source_err_offset(added),
                       "LAINIR verification failed");
  }
  let out_opt: OptSlice.Opt = o.out_path;
  let split_opt: OptSlice.Opt = o.split_c;
  match split_opt {
    None => 0,
    Some(prefix) => {
      let en: Slice(u8) = entry_name(o);
      let pr: u64 = if o.print_result { 1 } else { 0 };
      let t_sp: u64 = tr.span_begin();
      let rc: u64 = hr.emit_c99_split(st.st_mod(k), prefix, en, pr, 400);
      let ev_sp: u64 = tr.span_end("cli_emit_split_c", "lainc", t_sp, rc);
      if rc != 0 {
        return report_code(hr.NO_SOURCE(), 0,
                           "failed to write split C99 output");
      }
      0
    },
  }
  match out_opt {
    None => 0,
    Some(out_path) => {
      if o.c99 or ends_c(out_path) {
        let en: Slice(u8) = entry_name(o);
        let pr: u64 = if o.print_result { 1 } else { 0 };
        let t_c99: u64 = tr.span_begin();
        let rc: u64 = hr.emit_c99_file(st.st_mod(k), out_path, en, pr);
        let ev_c99: u64 = tr.span_end("cli_emit_c99", "lainc", t_c99, rc);
        if rc != 0 {
          return report_code(hr.NO_SOURCE(), 0,
                             "failed to write C99 output");
        }
      } else {
        let t_l1: u64 = tr.span_begin();
        let rc: u64 = hr.emit_l1_file(st.st_mod(k), out_path);
        let ev_l1: u64 = tr.span_end("cli_emit_l1", "lainc", t_l1, rc);
        if rc != 0 {
          return report_code(hr.NO_SOURCE(), 0,
                             "failed to write LAINIR text output");
        }
      }
      0
    },
  }
  return trace_finish(0);
};

@root
let main = func() -> u64 {
  return run_cli();
};
