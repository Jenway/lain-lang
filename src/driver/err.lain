let fmt = import("std::fmt");

pub let ErrKind = enum {
  HostCap
  HostHandle
  HostArg
  HostRange
  HostIr
  CompileSyntax
  CompileType
  CompileUnbound
  CompileVerify
  CompileEval
  CompileBorrow
  CompileEffect
};

pub let ErrInfo = struct {
  kind: ErrKind,
  code: u64,
  src: u64,
  span: u64,
  detail: u64,
  msg: Slice(u8),
};

let ErrEffect = func(E: Type) -> Effect {
  return effect {
    op fail(info: E) -> Never;
  };
};

pub let CompileErr = ErrEffect(ErrInfo);

pub let err_kind_name = func(k: ErrKind) -> Slice(u8) {
  let name: Slice(u8) = match k {
    HostCap => "host_cap",
    HostHandle => "host_handle",
    HostArg => "host_arg",
    HostRange => "host_range",
    HostIr => "host_ir",
    CompileSyntax => "compile_syntax",
    CompileType => "compile_type",
    CompileUnbound => "compile_unbound",
    CompileVerify => "compile_verify",
    CompileEval => "compile_eval",
    CompileBorrow => "compile_borrow",
    CompileEffect => "compile_effect",
  };
  return name;
};

pub let fail_info = func(kind: ErrKind, code: u64, src: u64, span: u64, detail: u64,
    msg: Slice(u8)) -> u64 !{ CompileErr } {
  let info: ErrInfo = ErrInfo { kind: kind, code: code, src: src, span: span,
                                detail: detail, msg: msg };
  perform CompileErr.fail(info);
  return 0;
};

let copy_at = func(dst: MutSlice(u8), src: Slice(u8), i: u64) -> () {
  if i >= src.len { return; }
  dst[i] = src[i];
  copy_at(dst, src, i + 1);
};

let put_byte = func(dst: MutSlice(u8), at: u64, b: u8) -> u64 {
  dst[at] = b;
  return at + 1;
};

let put_str = func(dst: MutSlice(u8), at: u64, s: Slice(u8)) -> u64 {
  return loop c(i: u64 = 0, o: u64 = at) while i < s.len {
    dst[o] = s[i];
    o = o + 1;
    i = i + 1;
  };
};

let put_dec = func(dst: MutSlice(u8), at: u64, v: u64) -> u64 {
  if v >= 10 {
    let head: u64 = put_dec(dst, at, v / 10);
    return put_byte(dst, head, (48 + (v % 10)) as u8);
  }
  return put_byte(dst, at, (48 + v) as u8);
};

let put_indent = func(dst: MutSlice(u8), at: u64, text: Slice(u8), start: u64,
                      used: u64) -> u64 {
  return loop c(i: u64 = 0, o: u64 = at) while i < used {
    let b: u8 = text[start + i];
    if b == 9 { dst[o] = 9; } else { dst[o] = 32; }
    o = o + 1;
    i = i + 1;
  };
};

pub let line_origin = func(text: Slice(u8), line: u64) -> u64 {
  if line <= 1 { return 0; }
  return loop c(i: u64 = 0, want: u64 = 1, start: u64 = 0) while i <= text.len {
    if i == text.len { break c(text.len); }
    let b: u8 = text[i];
    if b == 10 {
      want = want + 1;
      start = i + 1;
      if want >= line { break c(i + 1); }
    }
    i = i + 1;
  };
};

pub let line_number_at = func(text: Slice(u8), span: u64) -> u64 {
  let stop: u64 = if span > text.len { text.len } else { span };
  return loop c(i: u64 = 0, line: u64 = 1) while i < stop {
    let b: u8 = text[i];
    if b == 10 { line = line + 1; }
    i = i + 1;
  };
};

pub let line_start_at = func(text: Slice(u8), span: u64) -> u64 {
  let stop: u64 = if span > text.len { text.len } else { span };
  return loop c(i: u64 = 0, start: u64 = 0) while i < stop {
    let b: u8 = text[i];
    if b == 10 { start = i + 1; }
    i = i + 1;
  };
};

pub let line_bytes = func(text: Slice(u8), start: u64) -> u64 {
  return loop c(i: u64 = start) while i < text.len {
    let b: u8 = text[i];
    if (b == 10) or (b == 13) { break c(i - start); }
    i = i + 1;
  };
};

pub let format_line_col_err = func(out: MutSlice(u8), path: Slice(u8),
                                  text: Slice(u8), line: u64, col: u64,
                                  msg: Slice(u8)) -> u64 {
  let o0: u64 = put_str(out, 0, path);
  let located: u64 = if (line == 0) or (text.len == 0) { 0 } else { 1 };
  let head: u64 = if located == 0 {
    let sep: Slice(u8) = if path.len == 0 { "" } else { ": " };
    let a: u64 = put_str(out, o0, sep);
    put_str(out, a, "error: ")
  } else {
    let p: u64 = if path.len == 0 { o0 } else { put_str(out, o0, ":") };
    let b: u64 = put_dec(out, p, line);
    let c: u64 = put_str(out, b, ":");
    let d: u64 = put_dec(out, c, col);
    put_str(out, d, ": error: ")
  };
  let o2: u64 = put_str(out, head, msg);
  let o3: u64 = put_str(out, o2, "\n");
  if located == 0 { return o3; }
  let start: u64 = line_origin(text, line);
  let len: u64 = line_bytes(text, start);
  let o4: u64 = put_str(out, o3, "  ");
  let o5: u64 = put_str(out, o4, make_slice(Slice(u8), text.ptr + start, len));
  let o6: u64 = put_str(out, o5, "\n");
  let o7: u64 = put_str(out, o6, "  ");
  let ahead: u64 = if col == 0 { 0 } else { col - 1 };
  let used: u64 = if ahead > len { len } else { ahead };
  let o8: u64 = put_indent(out, o7, text, start, used);
  let o9: u64 = put_byte(out, o8, 94);
  return put_str(out, o9, "\n");
};

pub let format_loc_err = func(out: MutSlice(u8), path: Slice(u8), text: Slice(u8),
                              span: u64, msg: Slice(u8)) -> u64 {
  if text.len == 0 { return format_line_col_err(out, path, text, 0, 0, msg); }
  let stop: u64 = if span > text.len { text.len } else { span };
  let line: u64 = line_number_at(text, stop);
  let start: u64 = line_start_at(text, stop);
  return format_line_col_err(out, path, text, line, (stop - start) + 1, msg);
};

pub let format_err = func(info: ErrInfo, dst: MutSlice(u8)) -> u64 {

  let kind: ErrKind = info.kind;
  let code: u64 = info.code;
  let src: u64 = info.src;
  let span: u64 = info.span;
  let detail: u64 = info.detail;
  let msg: Slice(u8) = info.msg;
  let c0: fmt.Cursor = fmt.write_str(fmt.fmt_begin(), "[");
  let c1: fmt.Cursor = fmt.write_str(c0, err_kind_name(kind));
  let c2: fmt.Cursor = fmt.write_str(c1, "] code=");
  let c3: fmt.Cursor = fmt.write_u64(c2, code);
  let c4: fmt.Cursor = fmt.write_str(c3, " src=");
  let c5: fmt.Cursor = fmt.write_u64(c4, src);
  let c6: fmt.Cursor = fmt.write_str(c5, " span=");
  let c7: fmt.Cursor = fmt.write_u64(c6, span);
  let c8: fmt.Cursor = fmt.write_str(c7, " detail=");
  let c9: fmt.Cursor = fmt.write_u64(c8, detail);
  let c10: fmt.Cursor = fmt.write_str(c9, ": ");
  let c11: fmt.Cursor = fmt.write_str(c10, msg);
  let c12: fmt.Cursor = fmt.write_str(c11, "\n");
  let line: Slice(u8) = fmt.fmt_done(c12);
  copy_at(dst, line, 0);
  return line.len;
};
