let os = import("std::os");
let tr = import("std::trace");
let err = import("src::driver::err");
let symtab = import("src::host::symtab");
let ao = import("src::meta::ast_out");
let sh = import("src::host::source_host");
let irh = import("src::host::ir_host");
let vmh = import("src::host::vm_host");
let eng = import("src::vm::engine");
let emit_text = import("src::ir::emit_text");
let c99 = import("src::backend::c99");
let vf = import("src::ir::verify::model");
let opt = import("src::ir::opt");
let mem = import("std::mem");

let trap_mut = func(cause: u64) -> Mut(u8) {
  let dead: u64 = mem.trap_abort(cause);
  return null_ref(Mut(u8));
};

let die_u64 = func(msg: Slice(u8), cause: u64) -> u64 {
  os.eprint(msg);
  let dead: u64 = mem.trap_abort(cause);
  return dead;
};

let die_mut = func(msg: Slice(u8), cause: u64) -> Mut(u8) {
  os.eprint(msg);
  return trap_mut(cause);
};

let note_fail = func(msg: Slice(u8)) -> u64 {
  os.eprint(msg);
  return 1;
};

let sym_bytes = func() -> u64 { return 268435456; };
let bump_bytes = func() -> u64 { return 536870912; };

let ir_bytes = func() -> u64 { return 536870912; };
let vm_bytes = func() -> u64 { return 4194304; };

let out_bytes = func() -> u64 { return 67108864; };

let ast_node_cap = func() -> u64 { return 262144; };
let ast_kid_cap = func() -> u64 { return 1048576; };
let ast_pool_cap = func() -> u64 { return 4194304; };
let ast_mark_cap = func() -> u64 { return 4096; };

let source_cap = func() -> u64 { return 256; };
let source_kids_cap = func() -> u64 { return 1048576; };

let SymTabCell = struct { v: symtab.HostSymTab };
let AstOutCell = struct { v: ao.AstOut };
let SourcesCell = struct { v: sh.HostSources };
let MarkCell = struct { v: ao.Mark };
let ModStateCell = struct { v: irh.ModState };
let DataRecCell = struct { v: irh.DataRec };

pub let NO_SOURCE = func() -> u64 { return 4294967295; };

pub let OS_WINDOWS = func() -> u64 { return 0; };
pub let OS_LINUX = func() -> u64 { return 1; };
pub let OS_MACOS = func() -> u64 { return 2; };

let HostRt = struct {
  syms: Mut(symtab.HostSymTab),
  ast_out: Mut(ao.AstOut),
  sources: Mut(sh.HostSources),
  ir: Mut(irh.HostIr),
  vm: Mut(vmh.VmHost),
  bump_base: Mut(u8),
  bump_cap: u64,
  bump_used: u64,
  trace_path_ptr: u64,
  trace_path_len: u64,
  trace_on: u64,
  trace_flushed: u64,
  target_os: u64,
  release_fast: u64,
};

let g_rt: Array(u64, 1) = [0];

let rt_slot = func() -> MutSlice(u64) {
  return make_slice(MutSlice(u64), mut_of(g_rt), 1);
};

let copy_bytes = func(dst: Mut(u8), src: Ref(u8), n: u64) -> u64 {
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let d: Mut(u8) = dst + i;
    let s: Ref(u8) = src + i;
    deref(d) = deref(s);
    i = i + 1;
  };
  return i;
};

let bytes_eq = func(a: Ref(u8), b: Ref(u8), n: u64) -> u64 {
  return loop c(i: u64 = 0, ok: u64 = 1) while i < n {
    let x: u8 = deref(a + i);
    let y: u8 = deref(b + i);
    if x != y { ok = 0; }
    i = i + 1;
  };
};

let put_text = func(dst: Mut(u8), at: u64, s: Slice(u8)) -> u64 {
  return loop c(i: u64 = 0, o: u64 = at) while i < s.len {
    let d: Mut(u8) = dst + o;
    deref(d) = s[i];
    o = o + 1;
    i = i + 1;
  };
};

let put_dec = func(dst: Mut(u8), at: u64, v: u64) -> u64 {
  if v >= 10 {
    let head: u64 = put_dec(dst, at, v / 10);
    let d: Mut(u8) = dst + head;
    deref(d) = (48 + (v % 10)) as u8;
    return head + 1;
  }
  let one: Mut(u8) = dst + at;
  deref(one) = (48 + v) as u8;
  return at + 1;
};

let bump_take = func(h: Mut(HostRt), bytes: u64, align: u64) -> Mut(u8) {
  let a: u64 = if align == 0 { 16 } else { align };
  if (a & (a - 1)) != 0 {
    return die_mut("[host_rt] bump allocation alignment is not a power of two\n", bytes);
  }
  if a > 4096 {
    return die_mut("[host_rt] bump allocation alignment exceeds one page\n", align);
  }
  let base: u64 = h.bump_base as u64;
  let want: u64 = h.bump_used;
  let miss: u64 = want % a;
  let off: u64 = if miss == 0 { want } else { want + (a - miss) };
  if (off + bytes) > h.bump_cap {
    return die_mut("[host_rt] bump arena exhausted\n", bytes);
  }
  h.bump_used = off + bytes;
  return ptr_cast(Mut(u8), base + off);
};

let host_new = func() -> u64 {
  let raw_ptr: u64 = os.alloc_bytes(size_of(HostRt));
  if raw_ptr == 0 {
    return die_u64("[host_rt] host struct allocation failed\n", raw_ptr);
  }
  let stab: Mut(symtab.HostSymTab) =
    ptr_cast(Mut(symtab.HostSymTab), os.alloc_bytes(size_of(SymTabCell)));
  if is_null(stab) { return die_u64("[host_rt] symtab init failed\n", 0); }
  let sbase: Mut(u8) = ptr_cast(Mut(u8), os.alloc_bytes(sym_bytes()));
  if is_null(sbase) { return die_u64("[host_rt] symtab arena allocation failed\n", 0); }
  let sbuf: MutSlice(u8) = make_slice(MutSlice(u8), sbase, sym_bytes());
  deref(stab) = symtab.symtab_new(sbuf);

  let arena_bytes: u64 = ao.ast_out_bytes(ast_node_cap(), ast_kid_cap(), ast_pool_cap(),
                                          ast_mark_cap());
  let abase: Mut(u8) = ptr_cast(Mut(u8), os.alloc_bytes(arena_bytes));
  if is_null(abase) { return die_u64("[host_rt] ast arena allocation failed\n", 0); }
  let ast_out: Mut(ao.AstOut) = ptr_cast(Mut(ao.AstOut), os.alloc_bytes(size_of(AstOutCell)));
  if is_null(ast_out) { return die_u64("[host_rt] ast_out init failed\n", 0); }
  deref(ast_out) = ao.ast_out_init(abase, ast_node_cap(), ast_kid_cap(), ast_pool_cap(),
                                   ast_mark_cap());

  let sources: Mut(sh.HostSources) =
    ptr_cast(Mut(sh.HostSources), os.alloc_bytes(size_of(SourcesCell)));
  if is_null(sources) { return die_u64("[host_rt] source manager init failed\n", 0); }
  deref(sources) = sh.host_sources_new(stab, ast_out, source_cap(), source_kids_cap());

  let ir_base: Mut(u8) = ptr_cast(Mut(u8), os.alloc_bytes(ir_bytes()));
  if is_null(ir_base) { return die_u64("[host_rt] ir arena allocation failed\n", 0); }
  let ir: Mut(irh.HostIr) = irh.host_new(ir_base, ir_bytes());
  if is_null(ir) { return die_u64("[host_rt] ir host init failed\n", 0); }

  let vm_base: Mut(u8) = ptr_cast(Mut(u8), os.alloc_bytes(vm_bytes()));
  if is_null(vm_base) { return die_u64("[host_rt] vm arena allocation failed\n", 0); }
  let vm: Mut(vmh.VmHost) =
    vmh.host_new_with_config(vm_base, vm_bytes(), ir, vmh.default_large_config());
  if is_null(vm) { return die_u64("[host_rt] vm host init failed\n", 0); }

  let bump_base: Mut(u8) = ptr_cast(Mut(u8), os.alloc_bytes(bump_bytes()));
  if is_null(bump_base) { return die_u64("[host_rt] bump arena allocation failed\n", 0); }

  let h: Mut(HostRt) = ptr_cast(Mut(HostRt), raw_ptr);
  deref(h) = HostRt {
    syms: stab,
    ast_out: ast_out,
    sources: sources,
    ir: ir,
    vm: vm,
    bump_base: bump_base,
    bump_cap: bump_bytes(),
    bump_used: 0,
    trace_path_ptr: 0,
    trace_path_len: 0,
    trace_on: 0,
    trace_flushed: 0,
    target_os: OS_WINDOWS(),
    release_fast: 0,
  };
  return raw_ptr;
};

pub let rt_init = func() -> u64 {
  let s: MutSlice(u64) = rt_slot();
  if s[0] != 0 { return s[0]; }
  let raw_ptr: u64 = host_new();
  s[0] = raw_ptr;
  let h: Mut(HostRt) = ptr_cast(Mut(HostRt), raw_ptr);
  let rc: u64 = c99.set_syms(h.syms);
  if rc != 0 { return die_u64("[host_rt] c99 symbol table wiring failed\n", rc); }
  return raw_ptr;
};

let rt = func() -> Mut(HostRt) {
  let raw_ptr: u64 = rt_init();
  return ptr_cast(Mut(HostRt), raw_ptr);
};

pub let set_target_os = func(os_id: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  h.target_os = os_id;
  return os_id;
};

pub let get_target_os = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return h.target_os;
};

pub let set_release_fast = func(v: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  h.release_fast = v;
  return v;
};

pub let release_fast = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return h.release_fast;
};

pub let mem_alloc = func(bytes: u64, align: u64) -> Mut(u8) {
  return bump_take(rt(), bytes, align);
};

pub let sym_intern = func(p: Ref(u8), n: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return symtab.sym_intern(h.syms, p, n);
};

pub let sym_find = func(p: Ref(u8), n: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return symtab.sym_find(h.syms, p, n);
};

pub let sym_same = func(a: u64, b: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return symtab.sym_same(h.syms, a, b);
};

pub let sym_addr = func(s: u64) -> Ref(u8) {
  let h: Mut(HostRt) = rt();
  return symtab.sym_addr(h.syms, s);
};

pub let sym_len = func(s: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return symtab.sym_len(h.syms, s);
};

let put_norm = func(dst: Mut(u8), at: u64, src: Ref(u8), n: u64) -> u64 {
  return loop c(i: u64 = 0, o: u64 = at) while i < n {
    let b: u64 = deref(src + i) as u64;
    if b == 92 {
      let d: Mut(u8) = dst + o;
      deref(d) = 47 as u8;
      o = o + 1;
      i = i + 1;
    } else {
      let pair: u64 = if (i + 1) < n { deref(src + (i + 1)) as u64 } else { 0 };
      if (b == 58) and (pair == 58) {
        let d2: Mut(u8) = dst + o;
        deref(d2) = 47 as u8;
        o = o + 1;
        i = i + 2;
      } else {
        let d3: Mut(u8) = dst + o;
        deref(d3) = b as u8;
        o = o + 1;
        i = i + 1;
      }
    }
  };
};

let has_lain_ext = func(dst: Mut(u8), at: u64) -> u64 {
  if at < 5 { return 0; }
  let p: Mut(u8) = dst + (at - 5);
  let b0: u64 = deref(p) as u64;
  let b1: u64 = deref(p + 1) as u64;
  let b2: u64 = deref(p + 2) as u64;
  let b3: u64 = deref(p + 3) as u64;
  let b4: u64 = deref(p + 4) as u64;
  if (b0 == 46) and (b1 == 108) and (b2 == 97) and (b3 == 105) and (b4 == 110) {
    return 1;
  }
  return 0;
};

let put_ext = func(dst: Mut(u8), at: u64) -> u64 {
  if has_lain_ext(dst, at) == 1 { return at; }
  let base: Mut(u8) = dst + at;
  deref(base) = 46 as u8;
  let q1: Mut(u8) = base + 1;
  deref(q1) = 108 as u8;
  let q2: Mut(u8) = base + 2;
  deref(q2) = 97 as u8;
  let q3: Mut(u8) = base + 3;
  deref(q3) = 105 as u8;
  let q4: Mut(u8) = base + 4;
  deref(q4) = 110 as u8;
  return at + 5;
};

let build_cand = func(dst: Mut(u8), pre: Slice(u8), modv: Slice(u8)) -> u64 {
  let a: u64 = copy_bytes(dst, pre.ptr, pre.len);
  let b: u64 = put_norm(dst, a, modv.ptr, modv.len);
  return put_ext(dst, b);
};

let source_dir = func(hs: Mut(sh.HostSources), cur: u64) -> Slice(u8) {
  if cur >= hs.source_count { return ""; }
  let nm: u64 = sh.source_name(hs, cur);
  if nm == 0 { return ""; }
  let n: u64 = symtab.sym_len(hs.syms, nm);
  let p: Ref(u8) = symtab.sym_addr(hs.syms, nm);
  let cut: u64 = loop c(i: u64 = 0, last: u64 = 0) while i < n {
    let b: u64 = deref(p + i) as u64;
    if b == 47 { last = i + 1; }
    i = i + 1;
  };
  return make_slice(Slice(u8), p, cut);
};

let find_named = func(hs: Mut(sh.HostSources), p: Ref(u8), n: u64) -> u64 {
  let idx: u64 = loop f(i: u64 = 0) while i < hs.source_count {
    let nm: u64 = sh.source_name(hs, i);
    if nm != 0 {
      let sn: u64 = symtab.sym_len(hs.syms, nm);
      if sn == n {
        let sp: Ref(u8) = symtab.sym_addr(hs.syms, nm);
        if bytes_eq(sp, p, n) == 1 { break f(i); }
      }
    }
    i = i + 1;
  };
  return idx;
};

let read_keep = func(h: Mut(HostRt), p: Ref(u8), n: u64, out_len: Mut(u64)) -> Mut(u8) {
  let slots: Mut(u8) = bump_take(h, 16, 8);
  let op: Mut(u64) = ptr_cast(Mut(u64), slots);
  let ol: Mut(u64) = ptr_cast(Mut(u64), slots + 8);
  deref(op) = 0;
  deref(ol) = 0;
  let path: Slice(u8) = make_slice(Slice(u8), p, n);
  let rc: u64 = os.read_file(path, op, ol);
  if rc != 0 { return null_ref(Mut(u8)); }
  let raw: u64 = deref(op);
  let len: u64 = deref(ol);
  let keep: Mut(u8) = bump_take(h, len + 1, 8);
  if is_null(keep) { return keep; }
  let copied: u64 = copy_bytes(keep, ptr_cast(Ref(u8), raw), len);
  let z: Mut(u8) = keep + len;
  deref(z) = 0;
  os.free_bytes(raw);
  deref(out_len) = len;
  return keep;
};

let report_missing = func(dst: Mut(u8), n: u64) -> u64 {
  os.eprint("[host_rt] cannot read source file: ");
  os.eprint(make_slice(Slice(u8), ptr_cast(Ref(u8), dst), n));
  return os.eprint("\n");
};

let report_missing_module = func(modv: Slice(u8)) -> u64 {
  os.eprint("[host_rt] cannot find imported module: ");
  os.eprint(modv);
  return os.eprint("\n");
};

let load_source = func(h: Mut(HostRt), p: Mut(u8), n: u64) -> u64 {
  let len: Mut(u64) = ptr_cast(Mut(u64), bump_take(h, 8, 8));
  deref(len) = 0;
  let text: Mut(u8) = read_keep(h, ptr_cast(Ref(u8), p), n, len);
  if is_null(text) { return NO_SOURCE(); }
  let name: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), p), n);
  let body: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), text), deref(len));
  return sh.source_add(h.sources, name, body);
};

pub let source_count = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.source_count(h.sources);
};

pub let source_name = func(src: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.source_name(h.sources, src);
};

pub let source_text = func(src: u64) -> Slice(u8) {
  let h: Mut(HostRt) = rt();
  return sh.source_text_slice(h.sources, src);
};

pub let source_path_slice = func(src: u64) -> Slice(u8) {
  let h: Mut(HostRt) = rt();
  if src >= sh.source_count(h.sources) { return ""; }
  let nm: u64 = sh.source_name(h.sources, src);
  if nm == 0 { return ""; }
  return make_slice(Slice(u8), symtab.sym_addr(h.syms, nm), symtab.sym_len(h.syms, nm));
};

pub let source_err_offset = func(src: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  if src >= sh.source_count(h.sources) { return 0; }
  let line: u64 = sh.source_err_line(h.sources, src);
  let col: u64 = sh.source_err_col(h.sources, src);
  if line == 0 { return 0; }
  return sh.line_col_offset(sh.source_text_slice(h.sources, src), line, col);
};

pub let source_root = func(src: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.source_root(h.sources, src);
};

pub let set_source_root = func(src: u64, root: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.set_source_root(h.sources, src, root);
};

pub let source_add_file_quiet = func(path: Slice(u8)) -> u64 {
  let h: Mut(HostRt) = rt();
  let hs: Mut(sh.HostSources) = h.sources;
  let dst: Mut(u8) = bump_take(h, path.len + 8, 8);
  let n: u64 = put_norm(dst, 0, path.ptr, path.len);
  let hit: u64 = find_named(hs, ptr_cast(Ref(u8), dst), n);
  if hit < hs.source_count { return hit; }
  return load_source(h, dst, n);
};

pub let source_add_file = func(path: Slice(u8)) -> u64 {
  let h: Mut(HostRt) = rt();
  let hs: Mut(sh.HostSources) = h.sources;
  let dst: Mut(u8) = bump_take(h, path.len + 8, 8);
  let n: u64 = put_norm(dst, 0, path.ptr, path.len);
  let got: u64 = source_add_file_quiet(path);
  if got == NO_SOURCE() {
    if sh.last_error_kind(hs) == 0 { report_missing(dst, n); }
  }
  return got;
};

pub let source_import = func(cur_src: u64, mod_ptr: Ref(u8), mod_len: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let hs: Mut(sh.HostSources) = h.sources;
  let modv: Slice(u8) = make_slice(Slice(u8), mod_ptr, mod_len);
  let dir: Slice(u8) = source_dir(hs, cur_src);
  let dst: Mut(u8) = bump_take(h, dir.len + mod_len + 8, 8);
  let empty: Slice(u8) = "";
  let n1: u64 = build_cand(dst, empty, modv);
  let got1: u64 = source_add_file_quiet(make_slice(Slice(u8), ptr_cast(Ref(u8), dst), n1));
  if got1 != NO_SOURCE() { return got1; }
  if dir.len != 0 {
    let n2: u64 = build_cand(dst, dir, modv);
    let got2: u64 = source_add_file_quiet(make_slice(Slice(u8), ptr_cast(Ref(u8), dst), n2));
    if got2 != NO_SOURCE() { return got2; }
  }
  report_missing_module(modv);
  return NO_SOURCE();
};

pub let ast_parse_snippet = func(p: Ref(u8), n: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_parse_snippet(h.sources, make_slice(Slice(u8), p, n));
};

let CLASS_SHIFT = func() -> u64 { return 28; };
let INDEX_MASK = func() -> u64 { return 0x0FFFFFFF; };
let SYM_CLASS = func() -> u64 { return 3; };

let sym_id_of = func(v: u64) -> u64 {
  if v == 0 { return 0; }
  if (v >> CLASS_SHIFT()) == SYM_CLASS() { return v & INDEX_MASK(); }
  return v;
};

let sym_handle_of = func(v: u64) -> u64 {
  if v == 0 { return 0; }
  if (v >> CLASS_SHIFT()) == SYM_CLASS() { return v; }
  if v > INDEX_MASK() { return die_u64("[host_rt] symbol handle out of range\n", v); }
  return (SYM_CLASS() << CLASS_SHIFT()) | v;
};

pub let ast_kind = func(hv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_kind(h.sources, hv);
};

pub let ast_delim = func(hv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_delim(h.sources, hv);
};

pub let ast_sym = func(hv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sym_id_of(sh.ast_sym(h.sources, hv));
};

pub let ast_child_count = func(hv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_child_count(h.sources, hv);
};

pub let ast_child = func(hv: u64, i: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_child(h.sources, hv, i);
};

pub let ast_literal_addr = func(hv: u64) -> Ref(u8) {
  let h: Mut(HostRt) = rt();
  return sh.ast_literal_addr(h.sources, hv);
};

pub let ast_literal_len = func(hv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_literal_len(h.sources, hv);
};

pub let ast_tx_begin = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_tx_begin(h.sources);
};

let current_tx = func(h: Mut(HostRt)) -> u64 {
  let a: Mut(ao.AstOut) = h.ast_out;
  let d: u64 = ao.tx_depth(a);
  if d == 0 { return die_u64("[host_rt] ast transaction stack is empty\n", d); }
  let at: Mut(ao.Mark) = a.marks + (d - 1) * size_of(MarkCell);
  let m: ao.Mark = deref(at);
  return m.tx;
};

pub let ast_tx_commit = func(root: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_tx_commit(h.sources, current_tx(h), root);
};

pub let ast_tx_rollback = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_tx_rollback(h.sources, current_tx(h));
};

pub let ast_mk_token = func(sym: u64, origin: u64, text: Ref(u8), len: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  return sh.ast_mk_token(h.sources, sym_handle_of(sym), origin,
                         make_slice(Slice(u8), text, len));
};

