pub let ir_mod_opt = func(modv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let m: Mut(irh.ModState) = mod_of(h.ir, modv);
  let modval: vf.IrModule = module_of(m);
  let stats: opt.OptStats = opt.opt_module(mut_of(modval));
  tr.counter("opt_folded", stats.folded);
  tr.counter("opt_dce", stats.dce_removed);
  return stats.folded + stats.dce_removed;
};

