};

let die_mod = func(msg: Slice(u8), cause: u64) -> Mut(irh.ModState) {
  os.eprint(msg);
  let dead: u64 = mem.trap_abort(cause);
  return null_ref(Mut(irh.ModState));
};

let mod_of = func(ir: Mut(irh.HostIr), modv: u64) -> Mut(irh.ModState) {
  if modv == 0 { return die_mod("[host_rt] module handle is zero\n", modv); }
  if modv > ir.mod_cap {
    return die_mod("[host_rt] module handle above capacity\n", modv);
  }
  let raw: Mut(u8) = ptr_cast(Mut(u8), ir.mods);
  let m: Mut(irh.ModState) = ptr_cast(Mut(irh.ModState),
                                     raw + (modv - 1) * size_of(ModStateCell));
  if m.in_use == 0 { return die_mod("[host_rt] module handle is not in use\n", modv); }
  return m;
};

let module_of = func(m: Mut(irh.ModState)) -> vf.IrModule {
  return vf.module_new(m.name,
                       ptr_cast(Ref(vf.IrProc), m.procs), m.proc_count,
                       ptr_cast(Ref(vf.IrRegion), m.regions), m.region_count,
                       ptr_cast(Ref(vf.IrInst), m.insts), m.inst_count,
                       ptr_cast(Ref(vf.IrCase), m.cases), m.case_count,
                       m.scratch);
};

let emit_data_all = func(w: Mut(c99.C99Writer), m: Mut(irh.ModState), i: u64) -> u64 {
  if i >= m.data_count { return 1; }
  let at: Mut(irh.DataRec) = m.data + i * size_of(DataRecCell);
  let d: irh.DataRec = deref(at);
  let bytes: Slice(u8) = make_slice(Slice(u8), d.bytes, d.size);
  let rc: u64 = c99.emit_data_decl(w, d.symbol, bytes, d.is_writable);
  return emit_data_all(w, m, i + 1);
};

let emit_procs_all = func(w: Mut(c99.C99Writer), mv: Ref(vf.IrModule), count: u64,
                          i: u64) -> u64 {
  if i >= count { return 1; }
  let b: u64 = c99.emit_proc_body_c99(w, mv, i);
  return emit_procs_all(w, mv, count, i + 1);
};

let render_l1 = func(h: Mut(HostRt), m: Mut(irh.ModState), buf: Mut(u8), cap: u64) -> u64 {
  let modval: vf.IrModule = module_of(m);
  let mv: Ref(vf.IrModule) = ref_of(modval);
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), buf, cap);
  let w0: emit_text.TextWriter = emit_text.writer_new(ms);
  let w: Mut(emit_text.TextWriter) = mut_of(w0);
  let data: Ref(emit_text.IrDataView) = ptr_cast(Ref(emit_text.IrDataView), m.data);
  let nsyms: Mut(symtab.HostSymTab) = h.syms;
  let n: u64 = emit_text.emit_module_text(w, nsyms, mv, data, m.data_count);
  let ok: u64 = emit_text.writer_ok(w);
  if ok == 0 { return 0; }
  return emit_text.writer_len(w);
};

pub let ir_mod_emit_output = func(modv: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let m: Mut(irh.ModState) = mod_of(h.ir, modv);
  let cap: u64 = out_bytes();
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 {
    return die_u64("[host_rt] ir_mod_emit_output: output buffer allocation failed\n", 0);
  }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let wrote: u64 = render_l1(h, m, buf, cap);
  os.free_bytes(raw);
  return wrote;
};

pub let emit_l1_file = func(modv: u64, path: Slice(u8)) -> u64 {
  let h: Mut(HostRt) = rt();
  let m: Mut(irh.ModState) = mod_of(h.ir, modv);
  let cap: u64 = out_bytes();
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 {
    return note_fail("[host_rt] emit_l1_file: output buffer allocation failed\n");
  }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let wrote: u64 = render_l1(h, m, buf, cap);
  if wrote == 0 {
    os.free_bytes(raw);
    return note_fail("[host_rt] emit_l1_file buffer overflow\n");
  }
  let out: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), wrote);
  let rc: u64 = os.write_file(path, out);
  os.free_bytes(raw);
  if rc != 0 { return note_fail("[host_rt] emit_l1_file: write to output path failed\n"); }
  return rc;
};

pub let emit_c99_file = func(modv: u64, path: Slice(u8), entry: Slice(u8),
                             print_result: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let m: Mut(irh.ModState) = mod_of(h.ir, modv);
  let modval: vf.IrModule = module_of(m);
  let mv: Ref(vf.IrModule) = ref_of(modval);
  let cap: u64 = out_bytes();
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 {
    return note_fail("[host_rt] emit_c99_file: output buffer allocation failed\n");
  }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), buf, cap);
  let w0: c99.C99Writer = c99.new_writer(ms);
  let w: Mut(c99.C99Writer) = mut_of(w0);
  let pn: u64 = c99.emit_preamble_lib(w);
  let t_data: u64 = tr.span_begin();
  let dn: u64 = emit_data_all(w, m, 0);
  tr.span_end("c99_emit_data", "c99", t_data, dn);
  let t_decls: u64 = tr.span_begin();
  let fd: u64 = c99.emit_all_proc_decls(w, mv, 0);
  tr.span_end("c99_emit_proc_decls", "c99", t_decls, fd);
  let nl: u64 = c99.put_byte(w, 10);
  let t_procs: u64 = tr.span_begin();
  let pr: u64 = emit_procs_all(w, mv, m.proc_count, 0);
  tr.span_end("c99_emit_procs", "c99", t_procs, pr);
  let es: u64 = sym_intern(entry.ptr, entry.len);
  let t_entry: u64 = tr.span_begin();
  let en: u64 = c99.emit_entry_main(w, mv, es, print_result);
  tr.span_end("c99_emit_entry_main", "c99", t_entry, en);
  let ok: u64 = c99.writer_ok(w);
  let wrote: u64 = c99.writer_len(w);
  if ok == 0 {
    os.free_bytes(raw);
    return note_fail("[host_rt] emit_c99_file buffer overflow\n");
  }
  tr.counter("ir_procs", m.proc_count);
  tr.counter("ir_insts", m.inst_count);
  tr.counter("c99_bytes", wrote);
  let out: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), wrote);
  let rc: u64 = os.write_file(path, out);
  os.free_bytes(raw);
  if rc != 0 { return note_fail("[host_rt] emit_c99_file: write to output path failed\n"); }
  return rc;
};

let split_base = func(prefix: Slice(u8)) -> Slice(u8) {
  let cut: u64 = loop c(i: u64 = 0, last: u64 = 0) while i < prefix.len {
    let b: u64 = prefix[i] as u64;
    if b == 47 { last = i + 1; }
    i = i + 1;
  };
  return make_slice(Slice(u8), prefix.ptr + cut, prefix.len - cut);
};

let split_path = func(dst: Mut(u8), prefix: Slice(u8), suffix: Slice(u8)) -> Slice(u8) {
  let a: u64 = put_text(dst, 0, prefix);
  let b: u64 = put_text(dst, a, suffix);
  return make_slice(Slice(u8), ptr_cast(Ref(u8), dst), b);
};

let split_part_path = func(dst: Mut(u8), prefix: Slice(u8), n: u64) -> Slice(u8) {
  let a: u64 = put_text(dst, 0, prefix);
  let b: u64 = put_text(dst, a, "_p");
  let c: u64 = put_dec(dst, b, n);
  let d: u64 = put_text(dst, c, ".c");
  return make_slice(Slice(u8), ptr_cast(Ref(u8), dst), d);
};

let split_writer = func(buf: Mut(u8), cap: u64) -> c99.C99Writer {
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), buf, cap);
  return c99.new_writer(ms);
};

let split_flush = func(buf: Mut(u8), w: Mut(c99.C99Writer), path: Slice(u8),
                       msg: Slice(u8)) -> u64 {
  let ok: u64 = c99.writer_ok(w);
  if ok == 0 { return note_fail(msg); }
  let wrote: u64 = c99.writer_len(w);
  let out: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), wrote);
  let rc: u64 = os.write_file(path, out);
  if rc != 0 { return note_fail(msg); }
  return 0;
};

let split_include = func(w: Mut(c99.C99Writer), base: Slice(u8), suffix: Slice(u8)) -> u64 {
  let a: u64 = c99.put_str(w, "#include \"");
  let b: u64 = c99.put_str(w, base);
  let c: u64 = c99.put_str(w, suffix);
  return c99.put_str(w, "\"\n");
};

let split_data_rec = func(m: Mut(irh.ModState), i: u64) -> irh.DataRec {
  let at: Mut(irh.DataRec) = m.data + i * size_of(DataRecCell);
  return deref(at);
};

let split_data_externs = func(w: Mut(c99.C99Writer), m: Mut(irh.ModState), i: u64) -> u64 {
  if i >= m.data_count { return 1; }
  let d: irh.DataRec = split_data_rec(m, i);
  let bytes: Slice(u8) = make_slice(Slice(u8), d.bytes, d.size);
  let rc: u64 = c99.emit_data_decl_extern(w, d.symbol, bytes, d.is_writable);
  return split_data_externs(w, m, i + 1);
};

let split_data_defs = func(w: Mut(c99.C99Writer), m: Mut(irh.ModState), i: u64) -> u64 {
  if i >= m.data_count { return 1; }
  let d: irh.DataRec = split_data_rec(m, i);
  let bytes: Slice(u8) = make_slice(Slice(u8), d.bytes, d.size);
  let rc: u64 = c99.emit_data_decl_shared(w, d.symbol, bytes, d.is_writable);
  return split_data_defs(w, m, i + 1);
};

let manifest_add = func(mb: Mut(u8), at: u64, prefix: Slice(u8), suffix: Slice(u8)) -> u64 {
  let a: u64 = put_text(mb, at, prefix);
  let b: u64 = put_text(mb, a, suffix);
  let nl: Mut(u8) = mb + b;
  deref(nl) = 10 as u8;
  return b + 1;
};

let manifest_add_part = func(mb: Mut(u8), at: u64, prefix: Slice(u8), n: u64) -> u64 {
  let a: u64 = put_text(mb, at, prefix);
  let b: u64 = put_text(mb, a, "_p");
  let c: u64 = put_dec(mb, b, n);
  let d: u64 = put_text(mb, c, ".c");
  let nl: Mut(u8) = mb + d;
  deref(nl) = 10 as u8;
  return d + 1;
};

pub let emit_c99_split = func(modv: u64, prefix: Slice(u8), entry: Slice(u8),
                              print_result: u64, batch: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let m: Mut(irh.ModState) = mod_of(h.ir, modv);
  let modval: vf.IrModule = module_of(m);
  let mv: Ref(vf.IrModule) = ref_of(modval);
  let es: u64 = sym_intern(entry.ptr, entry.len);
  let pi: u64 = c99.find_proc(mv, es);
  if pi == vf.NO_REGION() {
    return note_fail("[host_rt] emit_c99_split: entry procedure not found\n");
  }
  let cap: u64 = out_bytes();
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 {
    return note_fail("[host_rt] emit_c99_split: output buffer allocation failed\n");
  }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let p_buf: Mut(u8) = bump_take(h, prefix.len + 32, 8);
  let base0: Slice(u8) = split_base(prefix);
  let inc_base: Slice(u8) = if base0.len == 0 { prefix } else { base0 };
  let step: u64 = if batch == 0 { 400 } else { batch };
  let mark: MutSlice(u64) = c99.compute_reachable_procs(mv, pi);
  let guard: u64 = c99.fnv1a_hash(prefix);

  let w10: c99.C99Writer = split_writer(buf, cap);
  let w1: Mut(c99.C99Writer) = mut_of(w10);
  let w1s: u64 = c99.writer_set_split(w1, 1);
  let g0: u64 = c99.put_str(w1, "#ifndef LAIN_SPLIT_C_");
  let g1: u64 = c99.put_u64_hex(w1, guard);
  let g2: u64 = c99.put_str(w1, "\n#define LAIN_SPLIT_C_");
  let g3: u64 = c99.put_u64_hex(w1, guard);
  let g4: u64 = c99.put_str(w1, "\n");
  let g5: u64 = c99.emit_split_preamble_shared(w1);
  let g6: u64 = split_data_externs(w1, m, 0);
  let g7: u64 = c99.emit_reachable_proc_decls(w1, mv, mark);
  let g8: u64 = c99.put_str(w1, "\n#endif\n");
  let shared_path: Slice(u8) = split_path(p_buf, prefix, "_shared.h");
  let rc_s: u64 = split_flush(buf, w1, shared_path,
                              "[host_rt] emit_c99_split: failed to write shared header\n");
  if rc_s != 0 {
    let rel_s: u64 = c99.release_reachable_procs(mark);
    os.free_bytes(raw);
    return rc_s;
  }

  let w20: c99.C99Writer = split_writer(buf, cap);
  let w2: Mut(c99.C99Writer) = mut_of(w20);
  let w2s: u64 = c99.writer_set_split(w2, 1);
  let d_inc: u64 = split_include(w2, inc_base, "_shared.h");
  let d_sep: u64 = c99.put_str(w2, "\n");
  let d_def: u64 = split_data_defs(w2, m, 0);
  let data_path: Slice(u8) = split_path(p_buf, prefix, "_data.c");
  let rc_d: u64 = split_flush(buf, w2, data_path,
                              "[host_rt] emit_c99_split: failed to write data file\n");
  if rc_d != 0 {
    let rel_d: u64 = c99.release_reachable_procs(mark);
    os.free_bytes(raw);
    return rc_d;
  }

  let parts_rc: u64 = loop c(lo: u64 = 0, part: u64 = 0) while 1 {
    if lo >= m.proc_count { break c(0); }
    let wp0: c99.C99Writer = split_writer(buf, cap);
    let wp: Mut(c99.C99Writer) = mut_of(wp0);
    let wps: u64 = c99.writer_set_split(wp, 1);
    let p_inc: u64 = split_include(wp, inc_base, "_shared.h");
    let p_sep: u64 = c99.put_str(wp, "\n");
    let p_body: u64 = c99.emit_reachable_proc_bodies_range(wp, mv, mark, lo, lo + step);
    let part_path: Slice(u8) = split_part_path(p_buf, prefix, part);
    let rc_p: u64 = split_flush(buf, wp, part_path,
                                "[host_rt] emit_c99_split: failed to write procedure part\n");
    if rc_p != 0 { break c(rc_p); }
    lo = lo + step;
    part = part + 1;
  };
  if parts_rc != 0 {
    let rel_p: u64 = c99.release_reachable_procs(mark);
    os.free_bytes(raw);
    return parts_rc;
  }

  let w30: c99.C99Writer = split_writer(buf, cap);
  let w3: Mut(c99.C99Writer) = mut_of(w30);
  let w3s: u64 = c99.writer_set_split(w3, 1);
  let m_inc: u64 = split_include(w3, inc_base, "_shared.h");
  let m_sep: u64 = c99.put_str(w3, "\n");
  let m_glob: u64 = c99.emit_split_main_globals(w3);
  let m_sep2: u64 = c99.put_str(w3, "\n");
  let m_main: u64 = c99.emit_entry_main(w3, mv, es, print_result);
  let main_path: Slice(u8) = split_path(p_buf, prefix, "_main.c");
  let rc_m: u64 = split_flush(buf, w3, main_path,
                              "[host_rt] emit_c99_split: failed to write entry file\n");
  if rc_m != 0 {
    let rel_m: u64 = c99.release_reachable_procs(mark);
    os.free_bytes(raw);
    return rc_m;
  }

  let part_count: u64 = (m.proc_count + step - 1) / step;
  let mf_cap: u64 = (part_count + 4) * (prefix.len + 32);
  let mf: Mut(u8) = bump_take(h, mf_cap, 8);
  let mf_a: u64 = manifest_add(mf, 0, prefix, "_data.c");
  let mf_b: u64 = manifest_add(mf, mf_a, prefix, "_main.c");
  let mf_c: u64 = loop c(i: u64 = 0, at: u64 = mf_b) while i < part_count {
    at = manifest_add_part(mf, at, prefix, i);
    i = i + 1;
  };
  let mf_path: Slice(u8) = split_path(p_buf, prefix, "_manifest.txt");
  let mf_out: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), mf), mf_c);
  let mf_rc: u64 = os.write_file(mf_path, mf_out);
  let rel_all: u64 = c99.release_reachable_procs(mark);
  os.free_bytes(raw);
  if mf_rc != 0 {
    return note_fail("[host_rt] emit_c99_split: failed to write manifest\n");
  }
  tr.counter("c99_split_parts", part_count);
  return 0;
};

let trace_kind_cat = func(kind: u64) -> Slice(u8) {
  if kind == eng.TraceKind.Enter { return "vm_enter"; }
  if kind == eng.TraceKind.Exit { return "vm_exit"; }
  if kind == eng.TraceKind.Trap { return "vm_trap"; }
  return "vm_trace";
};

let sub_name = func(h: Mut(HostRt), sym: u64) -> Slice(u8) {
  if sym == 0 { return "<vm>"; }
  let n: u64 = symtab.sym_len(h.syms, sym);
  let p: Ref(u8) = symtab.sym_addr(h.syms, sym);
  return make_slice(Slice(u8), p, n);
};

let emit_vm_trace = func(h: Mut(HostRt), i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let ev: eng.TraceEvent = vmh.last_trace_at(h.vm, i);
  let ts: u64 = tr.span_begin_tid();
  tr.span_end_tid(sub_name(h, ev.sub_sym), trace_kind_cat(ev.kind as u64), ts, ev.steps,
                  tr.Lane.Vm as u64);
  return emit_vm_trace(h, i + 1, n);
};

let trace_vm_result = func(h: Mut(HostRt), t0: u64, rc: u64) -> u64 {
  let count: u64 = vmh.last_trace_count(h.vm);
  tr.counter_tid("vm.steps", vmh.host_last_steps(h.vm), tr.Lane.Vm as u64);
  emit_vm_trace(h, 0, count);
  tr.span_end_tid("vm_apply", "vm", t0, count, tr.Lane.Vm as u64);
  return rc;
};

pub let apply_module = func(modv: u64, entry: u64, args: Ref(u8), arg_n: u64,
                            out: Mut(u8), out_cap: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  let av: Slice(u64) = make_slice(Slice(u64), ptr_cast(Ref(u64), args), arg_n);
  if tr.trace_is_enabled() == 0 {
    return vmh.apply_module(h.vm, modv, entry, av, out, out_cap);
  }
  let t0: u64 = tr.span_begin_tid();
  let rc: u64 = vmh.apply_module(h.vm, modv, entry, av, out, out_cap);
  return trace_vm_result(h, t0, rc);
};

pub let apply_module_bytes = func(modv: u64, entry: u64, out: Mut(u8),
                                  out_cap: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  if tr.trace_is_enabled() == 0 {
    return vmh.apply_module_bytes(h.vm, modv, entry, out, out_cap);
  }
  let t0: u64 = tr.span_begin_tid();
  let rc: u64 = vmh.apply_module_bytes(h.vm, modv, entry, out, out_cap);
  return trace_vm_result(h, t0, rc);
};

pub let trace_enabled = func() -> u64 {
  let h: Mut(HostRt) = rt();
  return h.trace_on;
};

pub let trace_set_path = func(path: Slice(u8)) -> u64 {
  let h: Mut(HostRt) = rt();
  if h.trace_path_len != 0 {
    os.free_bytes(h.trace_path_ptr);
    h.trace_path_ptr = 0;
    h.trace_path_len = 0;
  }
  if path.len == 0 {
    h.trace_on = 0;
    h.trace_flushed = 0;
    return 0;
  }
  let raw: u64 = os.alloc_bytes(path.len + 1);
  if raw == 0 {
    return die_u64("[host_rt] trace_set_path: trace path allocation failed\n", 0);
  }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let copied: u64 = copy_bytes(buf, path.ptr, path.len);
  let z: Mut(u8) = buf + path.len;
  deref(z) = 0;
  h.trace_path_ptr = raw;
  h.trace_path_len = path.len;
  h.trace_on = 1;
  h.trace_flushed = 0;
  return 0;
};

pub let trace_flush = func(json_ptr: Ref(u8), json_len: u64) -> u64 {
  let h: Mut(HostRt) = rt();
  if h.trace_path_len == 0 { return 0; }
  let path: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), h.trace_path_ptr),
                                   h.trace_path_len);
  let json: Slice(u8) = make_slice(Slice(u8), json_ptr, json_len);
  let rc: u64 = os.write_file(path, json);
  h.trace_flushed = h.trace_flushed + 1;
  return rc;
};

let diag_head = func(level: u64) -> Slice(u8) {
  if level == 1 { return "error: "; }
  return "warning: ";
};

pub let print_diags = func() -> u64 {
  let h: Mut(HostRt) = rt();
  let ir: Mut(irh.HostIr) = h.ir;
  let n: u64 = irh.host_diag_count(ir);
  if n == 0 { return 0; }
  let i: u64 = loop c(i: u64 = 0) while i < n {
    let level: u64 = irh.host_diag_level(ir, i);
    let span: u64 = irh.host_diag_span(ir, i);
    let msg: Slice(u8) = irh.host_diag_message(ir, i);
    let head: Slice(u8) = diag_head(level);
    let raw: u64 = os.alloc_bytes(head.len + msg.len + 32);
    if raw == 0 {
      return die_u64("[host_rt] print_diags: diagnostic line allocation failed\n", 0);
    }
    let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
    let a: u64 = put_text(buf, 0, head);
    let b: u64 = put_text(buf, a, msg);
    let c: u64 = if span == 0 { b } else { put_text(buf, b, " (span ") };
    let d: u64 = if span == 0 { c } else { put_dec(buf, c, span) };
    let e: u64 = if span == 0 { d } else { put_text(buf, d, ")") };
    let f: u64 = put_text(buf, e, "\n");
    let line: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), f);
    let wrote: u64 = os.eprint(line);
    os.free_bytes(raw);
    i = i + 1;
  };
  return n;
};

let report_at = func(path: Slice(u8), text: Slice(u8), span: u64,
                     msg: Slice(u8)) -> u64 {
  let cap: u64 = 512 + path.len + 2 * text.len + msg.len;
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 { return note_fail("[host_rt] error report allocation failed\n"); }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), buf, cap);
  let n: u64 = err.format_loc_err(ms, path, text, span, msg);
  let line: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), n);
  let rc: u64 = os.eprint(line);
  os.free_bytes(raw);
  return rc;
};

pub let report_fail_at = func(src: u64, span: u64, msg: Slice(u8)) -> u64 {
  if src >= source_count() { return report_at("", "", 0, msg); }
  return report_at(source_path_slice(src), source_text(src), span, msg);
};

pub let report_err = func(info: err.ErrInfo) -> u64 {
  let msg: Slice(u8) = info.msg;
  let src: u64 = info.src;
  let span: u64 = info.span;
  if src < source_count() {
    return report_at(source_path_slice(src), source_text(src), span, msg);
  }
  let cap: u64 = 256 + msg.len;
  let raw: u64 = os.alloc_bytes(cap);
  if raw == 0 { return note_fail("[host_rt] error report allocation failed\n"); }
  let buf: Mut(u8) = ptr_cast(Mut(u8), raw);
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), buf, cap);
  let n: u64 = err.format_err(info, ms);
  let line: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), buf), n);
  let rc: u64 = os.eprint(line);
  os.free_bytes(raw);
  return rc;
};

pub let report_source_fail = func(path: Slice(u8)) -> u64 {
  let h: Mut(HostRt) = rt();
  let hs: Mut(sh.HostSources) = h.sources;
  if sh.last_error_kind(hs) == 0 { return 0; }
  let line: u64 = sh.last_error_line(hs);
  let col: u64 = sh.last_error_col(hs);
  let len_slot: Mut(u64) = ptr_cast(Mut(u64), bump_take(h, 8, 8));
  deref(len_slot) = 0;
  let text_ptr: Mut(u8) = read_keep(h, path.ptr, path.len, len_slot);
  let text: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), text_ptr),
                                  deref(len_slot));
  let span: u64 = sh.line_col_offset(text, line, col);
  let rc: u64 = report_at(path, text, span, "source syntax error");
  return 1;
};

pub let fail_host = func(kind: err.ErrKind, code: u64, detail: u64,
    msg: Slice(u8)) -> u64 !{ err.CompileErr } {
  return err.fail_info(kind, code, 0, 0, detail, msg)!;
};
