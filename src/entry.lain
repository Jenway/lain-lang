// entry.lain —— Meta 编译器入口。所有源码编进同一个 LAINIR 模块，跨源调用才成立。
let st = import("state");
let ev = import("eval");
let ir = import("ir");
let tr = import("std::trace");

extern lain2_source_count() -> u64 = lain2_source_count;
extern lain2_source_name(src: u64) -> u64 = lain2_source_name;
// 追踪通道：宿主给缓冲区、由宿主落盘。C99 后端只导出 lain_meta_v2_entry 这一个
// 过程，所以开关与导出都从模块这边发起，宿主只提供缓冲与写入。
extern lain2_trace_on() -> u64 = lain2_trace_on;
extern lain2_trace_buf() -> Mut(u8) = lain2_trace_buf;
extern lain2_trace_cap() -> u64 = lain2_trace_cap;
extern lain2_trace_flush(len: u64) -> u64 = lain2_trace_flush;

// 逐源编译：每步重读源数量，import 新增的源会被一并编掉。
pub let build = func(k: Mut(st.State), i: u64, count: u64) -> u64 {
  if i >= count { return st.st_ok(k); }
  let e: u64 = ev.compile_source(k, i);
  if st.st_ok(k) != 0 { return st.st_ok(k); }
  let total: u64 = lain2_source_count();
  return build(k, i + 1, total);
};

// 把事件表写成 JSON 写进宿主缓冲并交给宿主落盘；没开追踪就原样返回结果码。
let trace_finish = func(rc: u64) -> u64 {
  if tr.trace_is_enabled() == 0 { return rc; }
  let cap: u64 = lain2_trace_cap();
  let p: Mut(u8) = lain2_trace_buf();
  let ms: MutSlice(u8) = make_slice(MutSlice(u8), p, cap);
  let n: u64 = tr.dump_json(ms);
  let w: u64 = lain2_trace_flush(n);
  return rc;
};

@root
let lain_meta_v2_entry = func(count: u64) -> u64 {
  if lain2_trace_on() == 1 {
    let on: u64 = tr.trace_enable(1);
  }
  let k: Mut(st.State) = st.st_new(65536);
  let mname: u64 = lain2_source_name(0);
  let md: u64 = ir.mod_new(k, mname);
  let t_build: u64 = tr.span_begin();
  let code: u64 = build(k, 0, count);
  let ev_build: u64 = tr.span_end("lainc_build", "lainc", t_build, count);
  if code != 0 {
    let msg: Ref(u8) = "compile failed";
    let d: u64 = ir.diag(k, code, 1, msg, 14);
    return trace_finish(code);
  }
  let t_verify: u64 = tr.span_begin();
  let v: u64 = ir.verify(k);
  let ev_verify: u64 = tr.span_end("ir_verify", "lainc", t_verify, v);
  if v != 0 {
    let msg2: Ref(u8) = "verify failed";
    let d2: u64 = ir.diag(k, v, 1, msg2, 13);
    return trace_finish(v);
  }
  // emit_output 返回的是写出的字节数，不是错误码。
  let t_emit: u64 = tr.span_begin();
  let written: u64 = ir.emit_output(k);
  let ev_emit: u64 = tr.span_end("ir_emit", "lainc", t_emit, written);
  return trace_finish(st.st_ok(k));
};
