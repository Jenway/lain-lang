// entry.lain —— Meta 编译器入口。所有源码编进同一个 LAINIR 模块，跨源调用才成立。
let st = import("state");
let ev = import("eval");
let ir = import("ir");

extern lain2_source_count() -> u64 = lain2_source_count;
extern lain2_source_name(src: u64) -> u64 = lain2_source_name;

// 逐源编译：每步重读源数量，import 新增的源会被一并编掉。
func build(k: Mut(st.State), i: u64, count: u64) -> u64 {
  if i >= count { return st.st_ok(k); }
  let e: u64 = ev.compile_source(k, i);
  if st.st_ok(k) != 0 { return st.st_ok(k); }
  let total: u64 = lain2_source_count();
  return build(k, i + 1, total);
}

@root
func lain_meta_v2_entry(count: u64) -> u64 {
  let k: Mut(st.State) = st.st_new(65536);
  let mname: u64 = lain2_source_name(0);
  let md: u64 = ir.mod_new(k, mname);
  let code: u64 = build(k, 0, count);
  if code != 0 {
    let msg: Ref(u8) = "compile failed";
    ir.diag(k, code, 1, msg, 14);
    return code;
  }
  let v: u64 = ir.verify(k);
  if v != 0 {
    let msg2: Ref(u8) = "verify failed";
    ir.diag(k, v, 1, msg2, 13);
    return v;
  }
  // emit_output 返回的是写出的字节数，不是错误码。
  ir.emit_output(k);
  return st.st_ok(k);
}
