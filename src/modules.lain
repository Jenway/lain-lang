// 模块：模块表（别名 → 源号）、模块符号表（每份源导出的顶层名字）、限定名拼装。
// 每个模块的过程与数据统一带前缀 "s<源号>__"，跨源同名不会撞。
let st = import("state");
let ty = import("types");
let ir = import("ir");

extern lain2_sym_addr(h: u64) -> Ref(u8) = lain2_sym_addr;
extern lain2_sym_len(h: u64) -> u64 = lain2_sym_len;
extern lain2_sym_find(p: Ref(u8), n: u64) -> u64 = lain2_sym_find;
extern lain2_sym_same(a: u64, b: u64) -> u64 = lain2_sym_same;
extern lain2_sym_intern(p: Ref(u8), n: u64) -> u64 = lain2_sym_intern;

let ModEntry = struct {
  alias: u64,
  src: u64,
  kind: u64,
  owner: u64
};

let SymEntry = struct {
  kind: u64,
  name: u64,
  modv: u64,
  qual: u64,
  sig: Mut(u8),
  shape: u64,
  flag: u64,
  decl: u64,
  src: u64,
  ro_flag: u64,
  fnid: u64
};

// --- 符号字节 -----------------------------------------------------------
let sym_addr = func(h: u64) -> Ref(u8) {
  if h == 0 { return null_ref(Ref(u8)); }
  return lain2_sym_addr(h);
};

let sym_len = func(h: u64) -> u64 {
  if h == 0 { return 0; }
  return lain2_sym_len(h);
};

// 把十进制写进 p，返回字节数。
let digits_at = func(p: Mut(u8), v: u64) -> u64 {
  let n: u64 = loop c(x: u64 = v, n: u64 = 1) while x >= 10 {
    x = x / 10;
    n = n + 1;
  };
  let buf: MutSlice(u8) = make_slice(MutSlice(u8), p, n);
  let w: u64 = loop w(y: u64 = v, i: u64 = n) while i > 0 {
    let d: u64 = y - y / 10 * 10;
    let d8: u8 = d as u8;
    let base: u8 = 48;
    let at: u64 = i - 1;
    buf[at] = base + d8;
    y = y / 10;
    i = i - 1;
  };
  return n;
};

let copy_sym = func(dst: Mut(u8), h: u64) -> u64 {
  let len: u64 = sym_len(h);
  if len == 0 { return 0; }
  let src: Ref(u8) = sym_addr(h);
  let ds: MutSlice(u8) = make_slice(MutSlice(u8), dst, len);
  let ss: Slice(u8) = make_slice(Slice(u8), src, len);
  let i: u64 = loop c(i: u64 = 0) while i < len {
    ds[i] = ss[i];
    i = i + 1;
  };
  return len;
};

// s<源号>__<名字><尾巴>。尾巴为 0 表示没有。
let qual_full = func(s: Mut(st.State), src: u64, name: u64, tail: u64) -> u64 {
  let p: Mut(u8) = st.st_scratch(s);
  let n: u64 = digits_at(p + 1, src);
  let hd: MutSlice(u8) = make_slice(MutSlice(u8), p, 3 + n);
  let one: u8 = 115;
  let us: u8 = 95;
  hd[0] = one;
  hd[1 + n] = us;
  hd[2 + n] = us;
  let nl: u64 = copy_sym(p + 3 + n, name);
  let off: u64 = 3 + n + nl;
  let tl: u64 = copy_sym(p + off, tail);
  return lain2_sym_intern(p, off + tl);
};

let qual = func(s: Mut(st.State), src: u64, name: u64) -> u64 {
  return qual_full(s, src, name, 0);
};

// s<源号>__<前缀><十进制>
let qual_num = func(s: Mut(st.State), src: u64, prefix: u64, v: u64) -> u64 {
  let p: Mut(u8) = st.st_scratch(s);
  let n: u64 = digits_at(p + 1, src);
  let hd: MutSlice(u8) = make_slice(MutSlice(u8), p, 3 + n);
  let one: u8 = 115;
  let us: u8 = 95;
  hd[0] = one;
  hd[1 + n] = us;
  hd[2 + n] = us;
  let pl: u64 = copy_sym(p + 3 + n, prefix);
  let off: u64 = 3 + n + pl;
  let dl: u64 = digits_at(p + off, v);
  return lain2_sym_intern(p, off + dl);
};

// 当前的源号就是当前的模块号。
let cur = func(s: Mut(st.State)) -> u64 { return st.st_src(s); };

let in_cur = func(s: Mut(st.State), name: u64) -> u64 { return qual(s, cur(s), name); };

// --- 模块表 -------------------------------------------------------------
// 条目 32 字节：[别名符号, 源号, 种类, 导入方源号]。
// 别名是文件局部的：两份源各自 import 同一个别名指不同目标时不能互相串。
let mod_add = func(s: Mut(st.State), alias: u64, src: u64, kind: u64) -> u64 {
  let p: Mut(ModEntry) = ptr_cast(Mut(ModEntry), st.st_mod_new(s, 32));
  p.alias = alias;
  p.src = src;
  p.kind = kind;
  p.owner = st.st_src(s);
  return 1;
};

let mod_at = func(s: Mut(st.State), i: u64) -> Mut(ModEntry) {
  return ptr_cast(Mut(ModEntry), st.st_modbase(s) + i * 32);
};

let mod_count = func(s: Mut(st.State)) -> u64 { return st.st_modused(s) / 32; };

let mod_scan = func(s: Mut(st.State), alias: u64, owner: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.alias == alias and p.owner == owner { return p.src + 1; }
  return mod_scan(s, alias, owner, i + 1, n);
};

// (导入方, 别名) → 源号 + 1；未命中回 0。
let mod_lookup = func(s: Mut(st.State), alias: u64) -> u64 {
  return mod_scan(s, alias, st.st_src(s), 0, mod_count(s));
};

let mod_name_scan = func(s: Mut(st.State), src: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.src == src { return p.alias; }
  return mod_name_scan(s, src, i + 1, n);
};

// 源号 → 该源的模块别名符号（导入时登记，供源号反查）；未登记回 0。
let mod_name_of = func(s: Mut(st.State), src: u64) -> u64 {
  return mod_name_scan(s, src, 0, mod_count(s));
};

// --- 模块符号表 ---------------------------------------------------------
// 条目 88 字节：[种类, 裸名, 模块号, 限定名, 签名, 形状号, 标记, 声明下标, 源号, 只读, Fn TypeId]。
let sym_kind_struct = func() -> u64 { return 1; };
let sym_kind_enum = func() -> u64 { return 2; };
let sym_kind_func = func() -> u64 { return 3; };
let sym_kind_extern = func() -> u64 { return 4; };
let sym_kind_data = func() -> u64 { return 5; };
let sym_kind_value = func() -> u64 { return 6; };
let sym_kind_generic = func() -> u64 { return 7; };

// 名字键：AST 给出的符号句柄按出现位置分配，同一文本在不同位置句柄不同，
// 所以查表前统一把原文重新 intern 一次，得到按内容稳定的键。
let name_key = func(s: Mut(st.State), h: u64) -> u64 {
  let n: u64 = sym_len(h);
  if n == 0 { return 0; }
  // 符号池已经映射进 guest 空间，可以直接按内容查表，不必复制文本。
  let f: u64 = lain2_sym_find(sym_addr(h), n);
  if f != 0 { return f; }
  return h;
};

let sym_add = func(s: Mut(st.State), kind: u64, mod: u64, name: u64, q: u64, sig: Mut(u8), sh: u64) -> Mut(SymEntry) {
  let p: Mut(SymEntry) = ptr_cast(Mut(SymEntry), st.st_sym_new(s, 88));
  p.kind = kind;
  p.name = name;
  p.modv = mod;
  p.qual = q;
  p.sig = sig;
  p.shape = sh;
  p.flag = 0;
  p.ro_flag = 0;
  p.fnid = 0;
  return p;
};

let sym_count = func(s: Mut(st.State)) -> u64 { return st.st_symused(s) / 88; };

let sym_at = func(s: Mut(st.State), i: u64) -> Mut(SymEntry) {
  return ptr_cast(Mut(SymEntry), st.st_symbase(s) + i * 88);
};

let sym_kind = func(p: Mut(SymEntry)) -> u64 { return p.kind; };
let sym_name = func(p: Mut(SymEntry)) -> u64 { return p.name; };
let sym_mod = func(p: Mut(SymEntry)) -> u64 { return p.modv; };
let sym_qual = func(p: Mut(SymEntry)) -> u64 { return p.qual; };
let sym_sig = func(p: Mut(SymEntry)) -> Mut(u8) { return p.sig; };
let sym_shape = func(p: Mut(SymEntry)) -> u64 { return p.shape; };
// 标记：生成器函数是否已经编译过体（0 未编译，1 已编译）。
let sym_flag = func(p: Mut(SymEntry)) -> u64 { return p.flag; };
let sym_set_flag = func(p: Mut(SymEntry), v: u64) -> u64 { p.flag = v; return v; };

// 声明所在的源号与源里的节点下标：inject 要在沙箱里跑生成器，生成器的体
// 可能还没编过，需要凭这两个值回到它的声明位置补编。
let sym_decl = func(p: Mut(SymEntry)) -> u64 { return p.decl; };
let sym_set_decl = func(p: Mut(SymEntry), v: u64) -> u64 { p.decl = v; return v; };
let sym_src = func(p: Mut(SymEntry)) -> u64 { return p.src; };
let sym_set_src = func(p: Mut(SymEntry), v: u64) -> u64 { p.src = v; return v; };

// 静态数据是否只读：ro 表与字符串不允许被赋值。
let sym_ro = func(p: Mut(SymEntry)) -> u64 { return p.ro_flag; };
let sym_set_ro = func(p: Mut(SymEntry), v: u64) -> u64 { p.ro_flag = v; return v; };
let sym_fnid = func(p: Mut(SymEntry)) -> u64 { return p.fnid; };
let sym_set_fnid = func(p: Mut(SymEntry), v: u64) -> u64 { p.fnid = v; return v; };

// AST 的符号句柄按出现位置分配，同名不同位置句柄不同，比名一律走这条。
let sym_same = func(a: u64, b: u64) -> u64 { return lain2_sym_same(a, b); };

let sym_scan = func(s: Mut(st.State), mod: u64, name: u64, i: u64, n: u64) -> Mut(SymEntry) {
  if i >= n { return null_ref(Mut(SymEntry)); }
  let p: Mut(SymEntry) = sym_at(s, i);
  if p.modv == mod and lain2_sym_same(p.name, name) == 1 { return p; }
  return sym_scan(s, mod, name, i + 1, n);
};

// 名字是不是一个已知的结构类型（聚合构造只在结构名后跟花括号时成立）。
let is_struct_name = func(s: Mut(st.State), sym: u64) -> u64 {
  let e: Mut(SymEntry) = find_here(s, sym);
  if is_null(e) { return 0; }
  if sym_kind(e) == sym_kind_struct() { return 1; }
  return 0;
};

// (模块号, 裸名) → 条目；未命中回空引用。
let sym_find = func(s: Mut(st.State), mod: u64, name: u64) -> Mut(SymEntry) {
  return sym_scan(s, mod, name, 0, sym_count(s));
};

// 当前源里查一个裸名。
let find_here = func(s: Mut(st.State), name: u64) -> Mut(SymEntry) {
  return sym_find(s, cur(s), name);
};
