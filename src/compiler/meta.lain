// Attribute expansion over immutable parsed syntax and generated syntax.
//
// Meta callables are Lain procedures evaluated through the L1 interpreter.
// This module owns expansion order, hygiene and limits; it has no host syntax
// callbacks.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");
let syntax: Module = import("packages::lain::compiler::syntax");
let generated_syntax: Module =
    import("packages::lain::compiler::generated_syntax");

@export
let meta: Module = std::module {

    @export
    let Meta = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let Syntax: Module = syntax.Syntax(Memory);
        let Generated: Module =
            generated_syntax.GeneratedSyntax(Memory);

        let MetaCallableId: type = usize;

        let MetaCallable: type = std::struct {
            id: MetaCallableId,
            name: Memory.String,
            procedure: usize,
        };

        let MetaCallableVector: type = vector.Vec(
            MetaCallable,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Registry: type = std::struct {
            callables: MetaCallableVector,
        };

        let Context: type = std::struct {
            expansion_id: usize,
            call_site_unit: Syntax.UnitId,
            call_site: Syntax.NodeId,
            hygiene: Syntax.HygieneId,
        };

        let Invocation: type = std::struct {
            attribute: Syntax.NodeId,
            arguments: Syntax.NodeId,
            target: Syntax.NodeId,
        };

        let Expansion: type = std::struct {
            syntax: Generated.SyntaxList,
            diagnostic: i32,
        };

        let new_registry = std::func() -> Registry {
            return Registry {
                callables: MetaCallableVector.new(),
            };
        };

        let register = std::func(
            registry: &mut Registry,
            name: Memory.String,
            procedure: usize,
        ) -> MetaCallableId ! {Memory.Allocation.Effect} {
            let id: MetaCallableId = registry.callables.length();
            registry.callables.push(MetaCallable {
                id: id,
                name: name,
                procedure: procedure,
            });
            return id;
        };

        let invoke = std::func(
            registry: &Registry,
            callable: MetaCallableId,
            context: Context,
            invocation: Invocation,
            builder: &mut Generated.Builder,
        ) -> Expansion ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if callable >= registry.callables.length() {
                return Expansion {
                    syntax: Generated.empty_list(builder),
                    diagnostic: 2902,
                };
            }

            let selected: &MetaCallable =
                registry.callables.get(callable);
            if selected.procedure == std::usize_max() {
                return Expansion {
                    syntax: Generated.empty_list(builder),
                    diagnostic: 2906,
                };
            }

            // The next convergence slice encodes Context/Invocation as L1
            // values and executes this ProcedureId.  Until then, fail
            // explicitly instead of storing a compile-time Module in Vec.
            return Expansion {
                syntax: Generated.empty_list(builder),
                diagnostic: 2906,
            };
        };

        let find = std::func(
            registry: &Registry,
            name: &Memory.String,
        ) -> MetaCallableId ! {Memory.Bounds.Effect} {
            let index: usize = 0;
            while index < registry.callables.length() {
                let callable: &MetaCallable =
                    registry.callables.get(index);
                if Memory.String.equal(&callable.name, name) {
                    return callable.id;
                }
                index = index + 1;
            }
            return std::usize_max();
        };

        let append_list = std::func(
            builder: &mut Generated.Builder,
            output: &mut Generated.SyntaxList,
            input: Generated.SyntaxList,
        ) -> unit ! {Memory.Bounds.Effect} {
            let current: Syntax.NodeId = input.first;
            let remaining: usize = input.length;
            while remaining != 0 {
                let next: Syntax.NodeId = Syntax.node(
                    builder.store,
                    input.unit,
                    current,
                ).next_sibling;
                Syntax.node_mut(
                    builder.store,
                    input.unit,
                    current,
                ).next_sibling = Syntax.invalid_node();
                Generated.append(
                    builder,
                    output,
                    current,
                );
                current = next;
                remaining = remaining - 1;
            }
        };

        let expand = std::func(
            store: &mut Syntax.Store,
            unit: Syntax.UnitId,
            root: Syntax.NodeId,
            registry: &Registry,
        ) -> Expansion ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let builder: Generated.Builder =
                Generated.begin(store, root);
            let output: Generated.SyntaxList =
                Generated.empty_list(&builder);

            let current: Syntax.NodeId =
                Syntax.node(store, unit, root).first_child;
            let expansion_count: usize = 0;

            while current != Syntax.invalid_node() {
                if expansion_count >= 64 {
                    return Expansion {
                        syntax: output,
                        diagnostic: 2904,
                    };
                }

                if Syntax.token_equal(
                    store,
                    unit,
                    current,
                    "@",
                    1,
                ) {
                    let name_node: Syntax.NodeId =
                        Syntax.next_significant(
                            store,
                            unit,
                            Syntax.node(
                                store,
                                unit,
                                current,
                            ).next_sibling,
                        );
                    let target: Syntax.NodeId =
                        Syntax.next_significant(
                            store,
                            unit,
                            Syntax.node(
                                store,
                                unit,
                                name_node,
                            ).next_sibling,
                        );
                    let name: Memory.String =
                        Syntax.copy_token_text(
                            store,
                            unit,
                            name_node,
                            false,
                        );
                    let callable: MetaCallableId =
                        find(registry, &name);
                    if callable == std::usize_max() {
                        return Expansion {
                            syntax: output,
                            diagnostic: 2902,
                        };
                    }
                    let one: Expansion = invoke(
                        registry,
                        callable,
                        Context {
                            expansion_id: expansion_count + 1,
                            call_site_unit: unit,
                            call_site: current,
                            hygiene: builder.hygiene,
                        },
                        Invocation {
                            attribute: name_node,
                            arguments: Syntax.invalid_node(),
                            target: target,
                        },
                        &mut builder,
                    );
                    if one.diagnostic != 0 { return one; }
                    append_list(
                        &mut builder,
                        &mut output,
                        one.syntax,
                    );
                    current = target;
                } else {
                    let cloned: Syntax.NodeId =
                        Generated.clone_from(
                            &mut builder,
                            unit,
                            current,
                            true,
                        );
                    Generated.append(
                        &mut builder,
                        &mut output,
                        cloned,
                    );
                }

                current = Syntax.node(
                    store,
                    unit,
                    current,
                ).next_sibling;
                expansion_count = expansion_count + 1;
            }

            let sealed: Syntax.UnitId =
                Generated.seal(&mut builder, output);
            return Expansion {
                syntax: Generated.SyntaxList {
                    unit: sealed,
                    first: output.first,
                    last: output.last,
                    length: output.length,
                },
                diagnostic: 0,
            };
        };

        return std::module {
            @export let MetaCallableId: type = MetaCallableId;
            @export let MetaCallable: type = MetaCallable;
            @export let Registry: type = Registry;
            @export let Context: type = Context;
            @export let Invocation: type = Invocation;
            @export let Expansion: type = Expansion;
            @export let new_registry = new_registry;
            @export let register = register;
            @export let find = find;
            @export let invoke = invoke;
            @export let expand = expand;
        };
    };
};
