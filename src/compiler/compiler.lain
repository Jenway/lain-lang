// Canonical compiler namespace.  Historical per-fixture entry points were
// removed; all requests use compiler_core.Compiler(Memory).compile.

let memory_model: Module = import("std::memory_model");
let compiler_core: Module =
    import("packages::lain::compiler::compiler_core");

@export
let compiler: Module = std::module {
    @export
    let Compiler = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        return compiler_core.Compiler(Memory);
    };
};
