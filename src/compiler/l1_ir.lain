// Dynamic, structured LAIN-IR owned entirely by Lain.
//
// This is not a CFG.  A procedure contains nested structured regions.  A
// backend may construct a CFG later, but labels and backend block topology do
// not leak into this representation.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");

@export
let l1_ir: Module = std::module {

    @export
    let Model = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let TypeId: type = usize;
        let ExprId: type = usize;
        let InstructionId: type = usize;
        let RegionId: type = usize;
        let ProcedureId: type = usize;

        let Type: type = std::struct {
            kind: i32,
            bit_width: usize,
        };

        let ExprIdVector: type = vector.Vec(
            ExprId,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Expr: type = std::struct {
            kind: i32,
            result_type: TypeId,
            left: ExprId,
            right: ExprId,
            index: usize,
            i32_value: i32,
            procedure: ProcedureId,
            arguments: ExprIdVector,
        };

        let Instruction: type = std::struct {
            kind: i32,
            name: Memory.String,
            expression: ExprId,
            destination: ExprId,
            value_type: TypeId,
            first_region: RegionId,
            second_region: RegionId,
        };

        let TypeVector: type = vector.Vec(
            Type,
            Memory.Allocation,
            Memory.Bounds,
        );
        let ExprVector: type = vector.Vec(
            Expr,
            Memory.Allocation,
            Memory.Bounds,
        );
        let InstructionVector: type = vector.Vec(
            Instruction,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Region: type = std::struct {
            instructions: InstructionVector,
        };

        let RegionVector: type = vector.Vec(
            Region,
            Memory.Allocation,
            Memory.Bounds,
        );
        let TypeIdVector: type = vector.Vec(
            TypeId,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Procedure: type = std::struct {
            name: Memory.String,
            parameter_types: TypeIdVector,
            return_type: TypeId,
            body: RegionId,
            is_external: bool,
        };

        let ProcedureVector: type = vector.Vec(
            Procedure,
            Memory.Allocation,
            Memory.Bounds,
        );

        let Unit: type = std::struct {
            types: TypeVector,
            expressions: ExprVector,
            regions: RegionVector,
            procedures: ProcedureVector,
        };

        let new = std::func() -> Unit {
            return Unit {
                types: TypeVector.new(),
                expressions: ExprVector.new(),
                regions: RegionVector.new(),
                procedures: ProcedureVector.new(),
            };
        };

        let add_type = std::func(
            unit: &mut Unit,
            value: Type,
        ) -> TypeId ! {Memory.Allocation.Effect} {
            let id: TypeId = unit.types.length();
            unit.types.push(value);
            return id;
        };

        let add_expression = std::func(
            unit: &mut Unit,
            value: Expr,
        ) -> ExprId ! {Memory.Allocation.Effect} {
            let id: ExprId = unit.expressions.length();
            unit.expressions.push(value);
            return id;
        };

        let begin_region = std::func(
            unit: &mut Unit,
        ) -> RegionId ! {Memory.Allocation.Effect} {
            let id: RegionId = unit.regions.length();
            unit.regions.push(Region {
                instructions: InstructionVector.new(),
            });
            return id;
        };

        let append_instruction = std::func(
            unit: &mut Unit,
            region: RegionId,
            value: Instruction,
        ) -> InstructionId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let target: &mut Region = unit.regions.get_mut(region);
            let id: InstructionId = target.instructions.length();
            target.instructions.push(value);
            return id;
        };

        let add_procedure = std::func(
            unit: &mut Unit,
            name: Memory.String,
            return_type: TypeId,
            body: RegionId,
            is_external: bool,
        ) -> ProcedureId ! {Memory.Allocation.Effect} {
            let id: ProcedureId = unit.procedures.length();
            unit.procedures.push(Procedure {
                name: name,
                parameter_types: TypeIdVector.new(),
                return_type: return_type,
                body: body,
                is_external: is_external,
            });
            return id;
        };

        let add_parameter = std::func(
            unit: &mut Unit,
            procedure: ProcedureId,
            parameter_type: TypeId,
        ) -> unit ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let target: &mut Procedure =
                unit.procedures.get_mut(procedure);
            target.parameter_types.push(parameter_type);
        };

        let append_call_argument = std::func(
            unit: &mut Unit,
            call: ExprId,
            argument: ExprId,
        ) -> unit ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let target: &mut Expr = unit.expressions.get_mut(call);
            target.arguments.push(argument);
        };

        return std::module {
            @export let TypeId: type = TypeId;
            @export let ExprId: type = ExprId;
            @export let ExprIdVector: type = ExprIdVector;
            @export let InstructionId: type = InstructionId;
            @export let RegionId: type = RegionId;
            @export let ProcedureId: type = ProcedureId;
            @export let Type: type = Type;
            @export let Expr: type = Expr;
            @export let Instruction: type = Instruction;
            @export let Region: type = Region;
            @export let Procedure: type = Procedure;
            @export let Unit: type = Unit;
            @export let new = new;
            @export let add_type = add_type;
            @export let add_expression = add_expression;
            @export let begin_region = begin_region;
            @export let append_instruction = append_instruction;
            @export let add_procedure = add_procedure;
            @export let add_parameter = add_parameter;
            @export let append_call_argument = append_call_argument;
        };
    };
};
