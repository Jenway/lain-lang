// Concrete main-branch compiler specialization.
//
// This is the compiler program that the cold bootstrap must eventually
// compile.  Platform I/O and effect handlers stay outside this file; callers
// provide an in-memory request and install the selected policies.

let memory_model: Module = import("std::memory_model");
let arena: Module = import("std::core::arena");
let bounds: Module = import("std::bounds");
let compiler_core: Module =
    import("packages::lain::compiler::compiler_core");

@export
let lainc: Module = std::module {
    @export
    let Memory: Module = memory_model.Model(
        arena.Policy,
        bounds.Trap,
    );

    @export
    let Compiler: Module = compiler_core.Compiler(Memory);

    // The stable in-memory compiler entry.  The native driver converts files
    // to CompileRequest and handles the effects at the process boundary.
    @export
    let compiler_compile = std::func(
        request: Compiler.CompileRequest,
    ) -> Compiler.CompileResult ! {
        Memory.Allocation.Effect,
        Memory.Bounds.Effect,
    } {
        return Compiler.compile(request);
    };
};
