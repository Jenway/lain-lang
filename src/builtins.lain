// 内建：字符串字面量、静态表、内存读写与指针内建。参数由 core 求值成 Val 数组后送进来，
// 这样这里不需要知道表达式怎么算，core 也不用知道内建怎么写。
let st = import("state");
let ty = import("types");
let ir = import("ir");
let codes = import("ir_codes");
let agg = import("agg");
let sym = import("sym");
let ax = import("ast");
let modules = import("modules");

// --- 静态数据 -----------------------------------------------------------
// 把值按 w 位、小端写进 p。
func put_le(p: addr, v: u64, w: u64) -> u64 {
  let bytes: u64 = w / 8;
  let x: u64 = v;
  let i: u64 = 0;
  let w2: u64 = loop c(i: u64 = 0, x: u64 = v) while i < bytes {
    let b: u8 = x as u8;
    store(p + i, b);
    x = x / 256;
    i = i + 1;
  };
  return 0;
}

// 字符串字面量的字节落在暂存缓冲里，交给 data_add 变成 ro 静态数据。
func string_data(s: addr, dname: u64, text: addr, len: u64) -> u64 {
  let buf: addr = st.st_databuf(s) + st.st_dataused(s);
  let i: u64 = loop c(i: u64 = 0) while i < len {
    let b: u8 = load(text + i);
    store(buf + i, b);
    i = i + 1;
  };
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + len);
  let rc: u64 = ir.data_add(s, dname, buf, len, 0);
  return agg.array_new(s, agg.kind_string(), len, 0, 8, 0, 0);
}

// 定长表：[1, 2, 3] 这种字面量组按元素宽度铺进静态数据。逗号也占孩子位置，要跳过。
func table_cnt(g: u64, i: u64, n: u64, acc: u64) -> u64 {
  if i >= n { return acc; }
  if ax.is_comma(g, i) == 1 { return table_cnt(g, i + 1, n, acc); }
  return table_cnt(g, i + 1, n, acc + 1);
}

func table_fill(s: addr, buf: addr, g: u64, i: u64, n: u64, pos: u64, ew: u64) -> u64 {
  if i >= n { return 0; }
  if ax.is_comma(g, i) == 1 { return table_fill(s, buf, g, i + 1, n, pos, ew); }
  let tok: u64 = ax.n_at(g, i);
  let v: u64 = ax.num_value(ax.lit_addr(tok), ax.lit_len(tok));
  let off: u64 = pos * ew;
  let put: u64 = put_le(buf + off, v, ew * 8);
  return table_fill(s, buf, g, i + 1, n, pos + 1, ew);
}

func table_data(s: addr, dname: u64, g: u64, elem: addr, rdonly: u64) -> u64 {
  let ew: u64 = agg.type_size(ty.tk(elem), ty.tw(elem), ty.tsh(elem));
  let n: u64 = ax.n_count(g);
  let cnt: u64 = table_cnt(g, 0, n, 0);
  let size: u64 = ew * cnt;
  let buf: addr = st.st_databuf(s) + st.st_dataused(s);
  let fill: u64 = table_fill(s, buf, g, 0, n, 0, ew);
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + size);
  let wr: u64 = if rdonly == 1 { 0 } else { 1 };
  let rc: u64 = ir.data_add(s, dname, buf, size, wr);
  return agg.array_new(s, agg.kind_array(), cnt, ty.tk(elem), ty.tw(elem), ty.tsg(elem),
                       ty.tsh(elem));
}

// 聚合的静态占位：先给一块零字节数据，字段由随后的过程写进去。
func agg_data(s: addr, dname: u64, sh: u64) -> u64 {
  let size: u64 = agg.shp_size(sh);
  let buf: addr = st.st_databuf(s) + st.st_dataused(s);
  let zero: u8 = 0;
  let i: u64 = loop c(i: u64 = 0) while i < size {
    store(buf + i, zero);
    i = i + 1;
  };
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + size);
  return ir.data_add(s, dname, buf, size, 1);
}

// --- 间接调用 -----------------------------------------------------------
// 组里顶层逗号分隔的项数；空组算零项。
func arg_count(g: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if n == 0 { return 0; }
  return comma_n(g, 0, n, 0) + 1;
}

func comma_n(g: u64, i: u64, n: u64, acc: u64) -> u64 {
  if i >= n { return acc; }
  if ax.is_comma(g, i) == 1 { return comma_n(g, i + 1, n, acc + 1); }
  return comma_n(g, i + 1, n, acc);
}

// 形参类型表压进两个 64 位字：每项 16 位，低 8 位类型码、高 8 位宽度。
func pack_params(k: addr, ps: addr, i: u64, n: u64, pk: addr) -> u64 {
  if i >= n { return i; }
  let tp: addr = ps + i * 32;
  let code: u64 = ir.kcode(tp);
  if code == 0 { st.st_fail(k, ax.e_type()); return i; }
  let w: u64 = ty.tw(tp);
  if w > 255 { st.st_fail(k, ax.e_type()); return i; }
  let item: u64 = code + w * 256;
  let wo: u64 = (i / 4) * 8;
  let sh: u64 = (i - i / 4 * 4) * 16;
  let cur: u64 = load(pk + wo);
  store(pk + wo, cur + (item << sh));
  return pack_params(k, ps, i + 1, n, pk);
}

func push_vals(k: addr, ab: addr, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  let a: u64 = ir.op_val(k, ab + i * 56);
  return push_vals(k, ab, i + 1, n);
}

// 间接调用：被调值必须是 addr，实参已在 ab 里按形参类型强制过。
func icall_emit(k: addr, sk: addr, fv: addr, ab: addr, want: addr, out: addr) -> u64 {
  let vt: addr = ty.vty(fv);
  if ty.tk(vt) != 3 {
    // 目标不是 addr：一次性调用错误，报明确消息再失败。
    let m: addr = "icall-target";
    let dg: u64 = ir.diag(k, 0, 1, m, 12);
    st.st_fail(k, ax.e_type());
    return 0;
  }
  let np: u64 = load(sk);
  let ps: addr = load(sk + 16) as addr;
  let pk: addr = st.st_alloc(k, 16);
  store(pk, 0);
  store(pk + 8, 0);
  let filled: u64 = pack_params(k, ps, 0, np, pk);
  if st.st_ok(k) != 0 { return 0; }
  let ret: addr = st.st_alloc(k, 32);
  let rt: u64 = ty.ty_at(ret, load(sk + 8) as addr);
  let res: u64 = if ty.ty_known(ret) == 1 { ir.fresh_t(k) } else { 0 };
  let ar: u64 = ir.args_reset(k);
  let f: u64 = ir.op_val(k, fv);
  let d: u64 = push_vals(k, ab, 0, np);
  let plo: u64 = load(pk);
  let phi: u64 = load(pk + 8);
  let ins: u64 = ir.emit_call_indirect(k, res, ret, plo, phi);
  if res == 0 {
    ty.val_none(out);
    return 0;
  }
  let rv: addr = st.st_alloc(k, 56);
  ty.val_ref(rv, res, ret);
  let ct: addr = st.st_alloc(k, 56);
  if ty.ty_known(want) == 0 {
    let cp: u64 = ty.val_at(ct, rv);
  } else {
    let cv: u64 = coerce_v(k, rv, want, ct);
  }
  ty.val_at(out, ct);
  return 0;
}

// --- 内建分派 -----------------------------------------------------------
func is_builtin(name: u64) -> u64 {
  if name == sym.b_load() { return 1; }
  if name == sym.b_store() { return 1; }
  if name == sym.b_lea() { return 1; }
  if name == sym.b_ptr_of() { return 1; }
  if name == sym.b_addr_of() { return 1; }
  if name == sym.b_len() { return 1; }
  if name == sym.b_ref_of() { return 1; }
  if name == sym.b_slice_of() { return 1; }
  if name == sym.b_symbol_addr() { return 1; }
  return 0;
}

// 读的内存宽度由上下文期望类型决定，没有期望时按机器字。
func load_ty(k: addr, want: addr) -> addr {
  if ty.ty_known(want) == 1 { return want; }
  return ir.tbits(k, 64);
}

func do_load(k: addr, v0: addr, want: addr, out: addr) -> u64 {
  let t: addr = load_ty(k, want);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let ins: u64 = ir.emit_mem(k, codes.INST_LOAD(), res, t, 0);
  return ty.val_ref(out, res, t);
}

// store 的宽度取右值的类型；右值是裸字面量时按 64 位。
func store_ty(k: addr, v: addr) -> addr {
  let t: addr = st.st_alloc(k, 32);
  let vt: addr = ty.vty(v);
  if ty.vlit(v) == 1 { let rc: u64 = ty.ty_bits(t, 64, 0); return t; }
  if ty.ty_known(vt) == 0 { let rc: u64 = ty.ty_bits(t, 64, 0); return t; }
  let cp: u64 = ty.ty_at(t, vt);
  return t;
}

func do_store(k: addr, v0: addr, v1: addr) -> u64 {
  let t: addr = store_ty(k, v1);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v1);
  let b: u64 = ir.op_val(k, v0);
  return ir.emit_mem(k, codes.INST_STORE(), 0, t, 0);
}

func do_lea(k: addr, v0: addr, v1: addr, out: addr) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let b: u64 = ir.op_val(k, v1);
  let c: u64 = ir.arg_int(k, 1);
  let d: u64 = ir.arg_int(k, 0);
  let ins: u64 = ir.emit(k, codes.INST_LEA(), res, ir.taddr(k));
  return ty.val_ref(out, res, ir.taddr(k));
}

func do_slice(k: addr, v0: addr, v1: addr, out: addr) -> u64 {
  let obj: addr = st.st_alloc(k, 56);
  let base: u64 = agg.new_bytes(k, 16, 8, obj);
  let at: addr = st.st_alloc(k, 32);
  let u64t: u64 = ty.ty_u64(at);
  let addr_t: addr = ir.taddr(k);
  let s1: u64 = agg.store_at(k, base, 0, v0, addr_t);
  let s2: u64 = agg.store_at(k, base, 8, v1, at);
  let av: addr = st.st_alloc(k, 32);
  let ta: u64 = ty.ty_addr(av);
  return ty.val_ref(out, base, av);
}

func apply(k: addr, name: u64, argv: addr, n: u64, want: addr, out: addr) -> u64 {
  let v0: addr = argv;
  let v1: addr = argv + 56;
  if name == sym.b_load() { return do_load(k, v0, want, out); }
  if name == sym.b_store() { return do_store(k, v0, v1); }
  if name == sym.b_lea() { return do_lea(k, v0, v1, out); }
  if name == sym.b_ptr_of() {
    let t: addr = st.st_alloc(k, 32);
    let u: u64 = ty.ty_u64(t);
    return coerce_v(k, v0, t, out);
  }
  if name == sym.b_addr_of() {
    let t: addr = ir.taddr(k);
    return coerce_v(k, v0, t, out);
  }
  if name == sym.b_ref_of() {
    let vt: addr = ty.vty(v0);
    if ty.tk(vt) == 3 { let cp: u64 = ty.val_at(out, v0); return 0; }
    let rc: u64 = st.st_fail(k, 3);
    return 0;
  }
  if name == sym.b_len() {
    let vt: addr = ty.vty(v0);
    let sh: u64 = ty.tsh(vt);
    let t: addr = st.st_alloc(k, 32);
    let u: u64 = ty.ty_u64(t);
    if sh == 0 { let rc: u64 = st.st_fail(k, 3); return 0; }
    let cnt: u64 = agg.shp_len(sh);
    return ty.val_lit(out, cnt, t);
  }
  if name == sym.b_slice_of() { return do_slice(k, v0, v1, out); }
  let rc: u64 = st.st_fail(k, 5);
  return 0;
}

// coerce 的本地副本：builtins 在 ctx 之前，不能反向依赖。
func coerce_v(k: addr, v: addr, to: addr, out: addr) -> u64 {
  let from: addr = ty.vty(v);
  let cp: u64 = ty.val_at(out, v);
  if ty.ty_known(from) == 0 { return 0; }
  if ty.vlit(v) == 1 { return ty.val_lit(out, ty.vbits(v), to); }
  if ty.ty_same(from, to) == 1 { return 0; }
  let kind: u64 = ty.cast_inst(ty.tk(from), ty.tw(from), ty.tsg(from), ty.tk(to), ty.tw(to));
  if kind == 0 { return 0; }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, ty.vn(v));
  let ins: u64 = ir.emit(k, kind, res, to);
  return ty.val_ref(out, res, to);
}

// symbol_addr("name")：把字面量文本当作数据符号名，拼上本模块前缀。
func symbol_addr(k: addr, g: u64, out: addr, src: u64) -> u64 {
  let h: u64 = if ax.n_count(g) > 0 { ax.n_at(g, 0) } else { 0 };
  if h == 0 { let rc: u64 = st.st_fail(k, 1); return 0; }
  let off: addr = ax.lit_addr(h) + 1;
  let len: u64 = ax.lit_len(h) - 2;
  if len == 0 { let rc: u64 = st.st_fail(k, 1); return 0; }
  let p: addr = st.st_scratch(k) + 64;
  let i: u64 = loop c(i: u64 = 0) while i < len {
    let b: u8 = load(off + i);
    store(p + i, b);
    i = i + 1;
  };
  let name: u64 = ir.sym_lit(p, len);
  let q: u64 = modules.qual(k, src, name);
  let t: addr = st.st_alloc(k, 32);
  let a: u64 = ty.ty_addr(t);
  return ty.val_ref(out, q, t);
}
