@foreign("bootstrap.source-count")
let bootstrap_source_count = std::func() -> usize;

@foreign("bootstrap.source-data")
let bootstrap_source_data = std::func(index: usize) -> addr;

@foreign("bootstrap.source-length")
let bootstrap_source_length = std::func(index: usize) -> usize;

@foreign("bootstrap.source-path-data")
let bootstrap_source_path_data = std::func(index: usize) -> addr;

@foreign("bootstrap.source-path-length")
let bootstrap_source_path_length = std::func(index: usize) -> usize;

@foreign("bootstrap.artifact-begin")
let bootstrap_artifact_begin = std::func() -> unit;

@foreign("bootstrap.artifact-write-byte")
let bootstrap_artifact_write_byte = std::func(byte: i32) -> unit;

@foreign("bootstrap.artifact-write-literal")
let bootstrap_artifact_write_literal = std::func(text: addr) -> unit;

@foreign("bootstrap.artifact-finish")
let bootstrap_artifact_finish = std::func() -> unit;

let byte_at = std::func(source: addr, index: usize) -> i32 {
    return std::load_i8(std::offset(source, index));
};

let is_space = std::func(byte: i32) -> bool {
    if byte == 32 { return 1; }
    if byte == 9 { return 1; }
    if byte == 10 { return 1; }
    if byte == 13 { return 1; }
    return 0;
};

let is_ident_byte = std::func(byte: i32) -> bool {
    if byte >= 48 {
        if byte <= 57 { return 1; }
    }
    if byte >= 65 {
        if byte <= 90 { return 1; }
    }
    if byte >= 97 {
        if byte <= 122 { return 1; }
    }
    if byte == 95 { return 1; }
    return 0;
};

let import_path_length = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let cursor: usize = start;
    let length: usize = 5;
    while cursor < end {
        if byte_at(source, cursor) == 58 {
            if cursor + 1 < end {
                if byte_at(source, cursor + 1) == 58 {
                    length = length + 1;
                    cursor = cursor + 2;
                } else {
                    return 0;
                }
            } else {
                return 0;
            }
        } else {
            length = length + 1;
            cursor = cursor + 1;
        }
    }
    return length;
};

let source_path_matches_import = std::func(
    source_index: usize,
    import_source: addr,
    import_start: usize,
    import_end: usize,
) -> bool {
    let path: addr = bootstrap_source_path_data(source_index);
    let path_length: usize =
        bootstrap_source_path_length(source_index);
    let wanted_length: usize = import_path_length(
        import_source,
        import_start,
        import_end,
    );
    if wanted_length == 0 { return 0; }
    if path_length < wanted_length { return 0; }
    let path_cursor: usize = path_length - wanted_length;
    let import_cursor: usize = import_start;
    while import_cursor < import_end {
        let wanted: i32 = byte_at(import_source, import_cursor);
        let actual: i32 = byte_at(path, path_cursor);
        if wanted == 58 {
            if import_cursor + 1 >= import_end { return 0; }
            if byte_at(import_source, import_cursor + 1) != 58 {
                return 0;
            }
            if actual != 47 {
                if actual != 92 { return 0; }
            }
            import_cursor = import_cursor + 2;
            path_cursor = path_cursor + 1;
        } else {
            if actual != wanted { return 0; }
            import_cursor = import_cursor + 1;
            path_cursor = path_cursor + 1;
        }
    }
    if byte_at(path, path_cursor) != 46 { return 0; }
    if byte_at(path, path_cursor + 1) != 108 { return 0; }
    if byte_at(path, path_cursor + 2) != 97 { return 0; }
    if byte_at(path, path_cursor + 3) != 105 { return 0; }
    if byte_at(path, path_cursor + 4) != 110 { return 0; }
    return 1;
};

let resolve_import = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let source_index: usize = 0;
    let count: usize = bootstrap_source_count();
    while source_index < count {
        if source_path_matches_import(
            source_index,
            source,
            start,
            end,
        ) {
            return source_index + 1;
        }
        source_index = source_index + 1;
    }
    return 0;
};

// Transitional compile-time environment. Entries are intentionally compact:
// {name-key, value-kind, value-key}.  They make compile-time bindings explicit
// instead of treating them as comments.  The self-hosted CompilerContext will
// replace this table when it becomes executable.
let register_compile_time_binding = std::func(
    cache: addr,
    source: addr,
    name_start: usize,
    name_end: usize,
    value_kind: usize,
    value_start: usize,
    value_end: usize,
) -> bool {
    let count_addr: addr = std::offset(cache, 114712);
    let entries: addr = std::offset(cache, 114720);
    let count: usize = std::load_i64(count_addr);
    if count >= 512 {
        let overflow_count_addr: addr = std::offset(cache, 163928);
        let overflow_count: usize =
            std::load_i64(overflow_count_addr);
        if overflow_count >= 2048 { return 0; }
        let overflow_entry: addr = std::offset(
            cache, 163936 + overflow_count * 24,
        );
        std::store_i64(
            overflow_entry,
            span_key(source, name_start, name_end),
        );
        std::store_i64(
            std::offset(overflow_entry, 8), value_kind,
        );
        let payload: usize = span_key(
            source, value_start, value_end,
        );
        if value_kind == 1 {
            payload = resolve_import(source, value_start, value_end);
        }
        std::store_i64(
            std::offset(overflow_entry, 16), payload,
        );
        std::store_i64(
            overflow_count_addr, overflow_count + 1,
        );
        return 1;
    }
    let entry: addr = std::offset(entries, count * 24);
    std::store_i64(
        entry,
        span_key(source, name_start, name_end),
    );
    std::store_i64(std::offset(entry, 8), value_kind);
    let payload: usize = span_key(source, value_start, value_end);
    if value_kind == 1 {
        payload = resolve_import(source, value_start, value_end);
    }
    std::store_i64(std::offset(entry, 16), payload);
    std::store_i64(count_addr, count + 1);
    return 1;
};

let lookup_compile_time_binding = std::func(
    cache: addr,
    source: addr,
    name_start: usize,
    name_end: usize,
) -> usize {
    let wanted: usize = span_key(source, name_start, name_end);
    let count: usize = std::load_i64(
        std::offset(cache, 114712),
    );
    let entries: addr = std::offset(cache, 114720);
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(entries, index * 24);
        if std::load_i64(entry) == wanted {
            return std::load_i64(std::offset(entry, 8));
        }
        index = index + 1;
    }
    let overflow_count: usize = std::load_i64(
        std::offset(cache, 163928),
    );
    let overflow_index: usize = 0;
    while overflow_index < overflow_count {
        let overflow_entry: addr = std::offset(
            cache, 163936 + overflow_index * 24,
        );
        if std::load_i64(overflow_entry) == wanted {
            return std::load_i64(
                std::offset(overflow_entry, 8),
            );
        }
        overflow_index = overflow_index + 1;
    }
    return 0;
};

let lookup_compile_time_payload = std::func(
    cache: addr,
    source: addr,
    name_start: usize,
    name_end: usize,
) -> usize {
    let wanted: usize = span_key(source, name_start, name_end);
    let overflow_count: usize = std::load_i64(
        std::offset(cache, 163928),
    );
    let overflow_index: usize = overflow_count;
    while overflow_index != 0 {
        overflow_index = overflow_index - 1;
        let entry: addr = std::offset(
            cache, 163936 + overflow_index * 24,
        );
        if std::load_i64(entry) == wanted {
            let payload: usize =
                std::load_i64(std::offset(entry, 16));
            if payload != 0 { return payload; }
        }
    }
    let count: usize = std::load_i64(
        std::offset(cache, 114712),
    );
    let index: usize = count;
    while index != 0 {
        index = index - 1;
        let entry: addr = std::offset(
            cache, 114720 + index * 24,
        );
        if std::load_i64(entry) == wanted {
            let payload: usize =
                std::load_i64(std::offset(entry, 16));
            if payload != 0 { return payload; }
        }
    }
    return 0;
};

let is_compile_time_type_in = std::func(
    cache: addr,
    source: addr,
    initial_start: usize,
    initial_end: usize,
) -> bool {
    if is_compile_time_type(source, initial_start, initial_end) {
        return 1;
    }
    let start: usize = trim_left(
        source, initial_end, initial_start,
    );
    let name_end: usize = scan_ident_end(
        source, initial_end, start,
    );
    let kind: usize = lookup_compile_time_binding(
        cache, source, start, name_end,
    );
    if kind == 8 { return 1; }
    if kind == 9 { return 1; }
    let dot: usize = find_top_level(
        source, start, initial_end, 46,
    );
    if dot < initial_end {
        let member_start: usize = skip_space(
            source, initial_end, dot + 1,
        );
        let member_end: usize = scan_ident_end(
            source, initial_end, member_start,
        );
        kind = lookup_compile_time_binding(
            cache, source, member_start, member_end,
        );
        if kind == 8 { return 1; }
        if kind == 9 { return 1; }
    }
    return 0;
};

let source_index_of = std::func(source: addr) -> usize {
    let index: usize = 0;
    let count: usize = bootstrap_source_count();
    while index < count {
        if bootstrap_source_data(index) == source {
            return index + 1;
        }
        index = index + 1;
    }
    return 0;
};

let register_constructor = std::func(
    cache: addr,
    source: addr,
    name_start: usize,
    name_end: usize,
    parameters_start: usize,
    parameters_end: usize,
    body_start: usize,
    body_end: usize,
) -> bool {
    let source_index: usize = source_index_of(source);
    if source_index == 0 { return 0; }
    let count_addr: addr = std::offset(cache, 127024);
    let count: usize = std::load_i64(count_addr);
    if count >= 512 { return 0; }
    let entry: addr =
        std::offset(cache, 127032 + count * 40);
    std::store_i64(
        entry, span_key(source, name_start, name_end),
    );
    std::store_i64(std::offset(entry, 8), source_index - 1);
    std::store_i64(std::offset(entry, 16), body_start);
    std::store_i64(std::offset(entry, 24), body_end);
    std::store_i64(std::offset(entry, 32), 0);
    let parameter_count: usize = std::load_i64(
        std::offset(cache, 147520),
    );
    if parameter_count >= 512 { return 0; }
    let parameter_entry: addr = std::offset(
        cache, 147528 + parameter_count * 24,
    );
    std::store_i64(
        parameter_entry, span_key(source, name_start, name_end),
    );
    std::store_i64(
        std::offset(parameter_entry, 8), parameters_start,
    );
    std::store_i64(
        std::offset(parameter_entry, 16), parameters_end,
    );
    std::store_i64(
        std::offset(cache, 147520), parameter_count + 1,
    );
    std::store_i64(count_addr, count + 1);
    return 1;
};

let lookup_constructor = std::func(
    cache: addr,
    source: addr,
    name_start: usize,
    name_end: usize,
    source_identity: usize,
) -> addr {
    let wanted: usize = span_key(source, name_start, name_end);
    let count: usize = std::load_i64(
        std::offset(cache, 127024),
    );
    let index: usize = 0;
    while index < count {
        let entry: addr =
            std::offset(cache, 127032 + index * 40);
        if std::load_i64(entry) == wanted {
            if source_identity == 0 {
                return entry;
            }
            if std::load_i64(std::offset(entry, 8)) + 1 ==
                source_identity {
                return entry;
            }
        }
        index = index + 1;
    }
    return 0 as addr;
};

let alias_constructor_layout = std::func(
    cache: addr,
    constructor_source: addr,
    body_start: usize,
    body_end: usize,
    binding_source: addr,
    binding_start: usize,
    binding_end: usize,
    previous_field_count: usize,
    previous_type_count: usize,
) -> bool {
    let concrete_key: usize = 0;
    let cursor: usize = body_start;
    while cursor < body_end {
        if is_ident_byte(byte_at(constructor_source, cursor)) {
            let token_end: usize = scan_ident_end(
                constructor_source, body_end, cursor,
            );
            if span_equals(
                constructor_source,
                cursor,
                token_end,
                "Concrete",
                8,
            ) {
                concrete_key = span_key(
                    constructor_source, cursor, token_end,
                );
                cursor = body_end;
            } else {
                cursor = token_end;
            }
        } else {
            cursor = cursor + 1;
        }
    }
    if concrete_key == 0 {
        let struct_cursor: usize = body_start;
        while struct_cursor < body_end {
            if is_ident_byte(
                byte_at(constructor_source, struct_cursor)
            ) {
                let struct_token_end: usize = scan_ident_end(
                    constructor_source, body_end, struct_cursor,
                );
                if span_equals(
                    constructor_source,
                    struct_cursor,
                    struct_token_end,
                    "struct",
                    6,
                ) {
                    let struct_open: usize = find_top_level(
                        constructor_source,
                        struct_token_end,
                        body_end,
                        123,
                    );
                    if struct_open < body_end {
                        let struct_close: usize = matching_close(
                            constructor_source,
                            body_end,
                            struct_open,
                            123,
                            125,
                        );
                        return register_struct_fields(
                            cache,
                            binding_source,
                            constructor_source,
                            binding_start,
                            binding_end,
                            struct_open + 1,
                            struct_close,
                        );
                    }
                }
                struct_cursor = struct_token_end;
            } else {
                struct_cursor = struct_cursor + 1;
            }
        }
        return 1;
    }
    let binding_key: usize = span_key(
        binding_source, binding_start, binding_end,
    );
    let field_count: usize = std::load_i64(cache);
    let field_index: usize = previous_field_count;
    while field_index < field_count {
        let entry: addr = std::offset(
            cache, 8 + field_index * 24,
        );
        if std::load_i64(entry) == concrete_key {
            let append_count: usize = std::load_i64(cache);
            if append_count >= 4096 { return 0; }
            let append: addr = std::offset(
                cache, 8 + append_count * 24,
            );
            std::store_i64(append, binding_key);
            std::store_i64(
                std::offset(append, 8),
                std::load_i64(std::offset(entry, 8)),
            );
            std::store_i64(
                std::offset(append, 16),
                std::load_i64(std::offset(entry, 16)),
            );
            std::store_i64(cache, append_count + 1);
        }
        field_index = field_index + 1;
    }
    let type_count: usize = std::load_i64(
        std::offset(cache, 213088),
    );
    let type_index: usize = previous_type_count;
    while type_index < type_count {
        let entry: addr = std::offset(
            cache, 213096 + type_index * 40,
        );
        if std::load_i64(entry) == concrete_key {
            let append_count: usize = std::load_i64(
                std::offset(cache, 213088),
            );
            if append_count >= 4096 { return 0; }
            let append: addr = std::offset(
                cache, 213096 + append_count * 40,
            );
            std::store_i64(append, binding_key);
            std::store_i64(
                std::offset(append, 8),
                std::load_i64(std::offset(entry, 8)),
            );
            std::store_i64(
                std::offset(append, 16),
                std::load_i64(std::offset(entry, 16)),
            );
            std::store_i64(
                std::offset(append, 24),
                std::load_i64(std::offset(entry, 24)),
            );
            std::store_i64(
                std::offset(append, 32),
                std::load_i64(std::offset(entry, 32)),
            );
            std::store_i64(
                std::offset(cache, 213088), append_count + 1,
            );
        }
        type_index = type_index + 1;
    }
    return 1;
};

let instantiate_constructor = std::func(
    cache: addr,
    binding_source: addr,
    binding_start: usize,
    binding_end: usize,
    arguments_start: usize,
    arguments_end: usize,
    constructor: addr,
) -> i32 {
    if constructor == (0 as addr) { return 5009; }
    let status: usize = std::load_i64(
        std::offset(constructor, 32),
    );
    if status == 1 { return 5010; }
    std::store_i64(std::offset(constructor, 32), 1);
    let source_index: usize = std::load_i64(
        std::offset(constructor, 8),
    );
    let source: addr = bootstrap_source_data(source_index);
    let body_start: usize = std::load_i64(
        std::offset(constructor, 16),
    );
    let body_end: usize = std::load_i64(
        std::offset(constructor, 24),
    );
    let constructor_key: usize = std::load_i64(constructor);
    let parameters_start: usize = 0;
    let parameters_end: usize = 0;
    let parameter_count: usize = std::load_i64(
        std::offset(cache, 147520),
    );
    let parameter_index: usize = 0;
    while parameter_index < parameter_count {
        let parameter_entry: addr = std::offset(
            cache, 147528 + parameter_index * 24,
        );
        if std::load_i64(parameter_entry) == constructor_key {
            parameters_start = std::load_i64(
                std::offset(parameter_entry, 8),
            );
            parameters_end = std::load_i64(
                std::offset(parameter_entry, 16),
            );
            parameter_index = parameter_count;
        } else {
            parameter_index = parameter_index + 1;
        }
    }
    let previous_substitution_count: usize = std::load_i64(
        std::offset(cache, 159816),
    );
    let parameter_cursor: usize = parameters_start;
    let argument_cursor: usize = arguments_start;
    while parameter_cursor < parameters_end {
        if argument_cursor >= arguments_end {
            std::store_i64(std::offset(constructor, 32), 0);
            return 5100 + source_index;
        }
        let parameter_comma: usize = find_top_level(
            source,
            parameter_cursor,
            parameters_end,
            44,
        );
        let parameter_name_start: usize = trim_left(
            source, parameter_comma, parameter_cursor,
        );
        let parameter_name_end: usize = scan_ident_end(
            source, parameter_comma, parameter_name_start,
        );
        let argument_comma: usize = find_top_level(
            binding_source,
            argument_cursor,
            arguments_end,
            44,
        );
        let substitution_count: usize = std::load_i64(
            std::offset(cache, 159816),
        );
        if substitution_count >= 128 {
            std::store_i64(std::offset(constructor, 32), 0);
            return 5013;
        }
        let substitution: addr = std::offset(
            cache, 159824 + substitution_count * 32,
        );
        std::store_i64(
            substitution,
            span_key(
                source,
                parameter_name_start,
                parameter_name_end,
            ),
        );
        std::store_i64(
            std::offset(substitution, 8), binding_source,
        );
        std::store_i64(
            std::offset(substitution, 16),
            trim_left(
                binding_source, argument_comma, argument_cursor,
            ),
        );
        std::store_i64(
            std::offset(substitution, 24),
            trim_right(
                binding_source, argument_cursor, argument_comma,
            ),
        );
        std::store_i64(
            std::offset(cache, 159816), substitution_count + 1,
        );
        if parameter_comma == parameters_end {
            parameter_cursor = parameters_end;
        } else {
            parameter_cursor = skip_space(
                source, parameters_end, parameter_comma + 1,
            );
        }
        if argument_comma == arguments_end {
            argument_cursor = arguments_end;
        } else {
            argument_cursor = skip_space(
                binding_source,
                arguments_end,
                argument_comma + 1,
            );
        }
    }
    let previous_namespace_start: usize = std::load_i64(
        std::offset(cache, 127008),
    );
    let previous_namespace_end: usize = std::load_i64(
        std::offset(cache, 127016),
    );
    let previous_namespace_source: usize = std::load_i64(
        std::offset(cache, 147512),
    );
    let previous_field_count: usize = std::load_i64(cache);
    let previous_type_count: usize = std::load_i64(
        std::offset(cache, 213088),
    );
    // Namespace names are hashed by spelling; emit the binding name from the
    // call site while the constructor body is analyzed.
    // The current bootstrap sources use the same source buffer for the
    // binding span passed below.
    std::store_i64(
        std::offset(cache, 127008), binding_start,
    );
    std::store_i64(
        std::offset(cache, 127016), binding_end,
    );
    std::store_i64(
        std::offset(cache, 147512), binding_source,
    );
    let result: i32 = compile_source(
        cache, source, body_start, body_end,
    );
    if result == 0 {
        if alias_constructor_layout(
            cache,
            source,
            body_start,
            body_end,
            binding_source,
            binding_start,
            binding_end,
            previous_field_count,
            previous_type_count,
        ) == 0 {
            std::store_i64(std::offset(constructor, 32), 0);
            return 5014;
        }
    }
    std::store_i64(
        std::offset(cache, 159816),
        previous_substitution_count,
    );
    std::store_i64(
        std::offset(cache, 127008), previous_namespace_start,
    );
    std::store_i64(
        std::offset(cache, 127016), previous_namespace_end,
    );
    std::store_i64(
        std::offset(cache, 147512),
        previous_namespace_source,
    );
    if result != 0 {
        std::store_i64(std::offset(constructor, 32), 0);
        return result;
    }
    // The same constructor may be instantiated under multiple binding names.
    // Active recursion is rejected above; completed calls release the
    // constructor until the specialization cache becomes the owner of reuse.
    std::store_i64(std::offset(constructor, 32), 0);
    return 0;
};

let skip_space = std::func(
    source: addr,
    length: usize,
    initial: usize,
) -> usize {
    let cursor: usize = initial;
    let running: bool = 1;
    while running {
        if cursor >= length {
            running = 0;
        } else {
            let byte: i32 = byte_at(source, cursor);
            if is_space(byte) {
                cursor = cursor + 1;
            } else {
                if byte == 47 {
                    if cursor + 1 < length {
                        if byte_at(source, cursor + 1) == 47 {
                            cursor = cursor + 2;
                            let commenting: bool = 1;
                            while commenting {
                                if cursor >= length {
                                    commenting = 0;
                                } else {
                                    if byte_at(source, cursor) == 10 {
                                        cursor = cursor + 1;
                                        commenting = 0;
                                    } else {
                                        cursor = cursor + 1;
                                    }
                                }
                            }
                        } else {
                            running = 0;
                        }
                    } else {
                        running = 0;
                    }
                } else {
                    running = 0;
                }
            }
        }
    }
    return cursor;
};

let scan_ident_end = std::func(
    source: addr,
    length: usize,
    start: usize,
) -> usize {
    let cursor: usize = start;
    while cursor < length {
        if is_ident_byte(byte_at(source, cursor)) {
            cursor = cursor + 1;
        } else {
            return cursor;
        }
    }
    return cursor;
};

let emit_span = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> unit {
    let cursor: usize = start;
    while cursor < end {
        bootstrap_artifact_write_byte(byte_at(source, cursor));
        cursor = cursor + 1;
    }
    return;
};

let emit_name = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> unit {
    let cursor: usize = start;
    let bootstrap_name: bool = 0;
    if end - start >= 10 {
        if byte_at(source, start) == 98 {
            if byte_at(source, start + 1) == 111 {
                if byte_at(source, start + 2) == 111 {
                    if byte_at(source, start + 3) == 116 {
                        if byte_at(source, start + 4) == 115 {
                            if byte_at(source, start + 5) == 116 {
                                if byte_at(source, start + 6) == 114 {
                                    if byte_at(source, start + 7) == 97 {
                                        if byte_at(source, start + 8) == 112 {
                                            if byte_at(source, start + 9) == 95 {
                                                bootstrap_name = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    while cursor < end {
        let byte: i32 = byte_at(source, cursor);
        if bootstrap_name {
            if cursor == start + 9 {
                bootstrap_artifact_write_byte(46);
            } else {
                if byte == 95 {
                    bootstrap_artifact_write_byte(45);
                } else {
                    bootstrap_artifact_write_byte(byte);
                }
            }
        } else {
            if is_space(byte) {
                // Qualified names may be line-wrapped in source. LAIN-IR
                // procedure and value names are emitted as one token.
            } else {
            if byte == 58 {
                if cursor + 1 < end {
                    if byte_at(source, cursor + 1) == 58 {
                        bootstrap_artifact_write_byte(46);
                        cursor = cursor + 1;
                    } else {
                        bootstrap_artifact_write_byte(byte);
                    }
                } else {
                    bootstrap_artifact_write_byte(byte);
                }
            } else {
                bootstrap_artifact_write_byte(byte);
            }
            }
        }
        cursor = cursor + 1;
    }
    return;
};

let emit_constructor_argument = std::func(
    cache: addr,
    source: addr,
    start: usize,
    end: usize,
    limit: usize,
) -> unit {
    let dot: usize = find_top_level(source, start, end, 46);
    let colon: usize = find_top_level(source, start, end, 58);
    let separator: usize = dot;
    if colon < separator { separator = colon; }
    let head_end: usize = separator;
    if head_end == end {
        head_end = scan_ident_end(source, end, start);
    }
    if span_equals(source, start, head_end, "Memory", 6) {
        if dot < end {
            let member_start: usize = skip_space(
                source, end, dot + 1,
            );
            let member_end: usize = scan_ident_end(
                source, end, member_start,
            );
            let member_tail: usize = find_top_level(
                source, member_end, end, 46,
            );
            if span_equals(
                source, member_start, member_end, "Allocation", 10,
            ) {
                bootstrap_artifact_write_literal("Policy");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "Bounds", 6,
            ) {
                bootstrap_artifact_write_literal("Trap");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "Bytes", 5,
            ) {
                bootstrap_artifact_write_literal("Bytes");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "String", 6,
            ) {
                bootstrap_artifact_write_literal("String");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
        }
    }
    let index: usize = limit;
    while index != 0 {
        index = index - 1;
        let substitution: addr = std::offset(
            cache, 159824 + index * 32,
        );
        if std::load_i64(substitution) ==
            span_key(source, start, head_end) {
            let argument_source: addr = (
                std::load_i64(std::offset(substitution, 8))
                as addr
            );
            let argument_start: usize = std::load_i64(
                std::offset(substitution, 16),
            );
            let argument_end: usize = std::load_i64(
                std::offset(substitution, 24),
            );
            emit_constructor_argument(
                cache,
                argument_source,
                argument_start,
                argument_end,
                index,
            );
            if separator < end {
                emit_name(source, separator, end);
            }
            return;
        }
    }
    let leaf: usize = start;
    let last_dot: usize = find_last_top_level_dot(
        source, start, end,
    );
    if last_dot < end {
        leaf = skip_space(source, end, last_dot + 1);
    } else {
        if colon < end {
            leaf = colon + 1;
            if leaf < end {
                if byte_at(source, leaf) == 58 { leaf = leaf + 1; }
            }
            leaf = skip_space(source, end, leaf);
        }
    }
    emit_name(source, leaf, end);
    return;
};

let emit_scoped_name = std::func(
    cache: addr,
    source: addr,
    start: usize,
    end: usize,
) -> unit {
    let dot: usize = find_top_level(source, start, end, 46);
    let colon: usize = find_top_level(source, start, end, 58);
    let first_separator: usize = dot;
    if colon < first_separator { first_separator = colon; }
    let head_end: usize = first_separator;
    if head_end == end {
        head_end = scan_ident_end(source, end, start);
    }
    if span_equals(source, start, head_end, "Memory", 6) {
        if dot < end {
            let member_start: usize = skip_space(
                source, end, dot + 1,
            );
            let member_end: usize = scan_ident_end(
                source, end, member_start,
            );
            let member_tail: usize = find_top_level(
                source, member_end, end, 46,
            );
            if span_equals(
                source,
                member_start,
                member_end,
                "Allocation",
                10,
            ) {
                bootstrap_artifact_write_literal("Policy");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "Bounds", 6,
            ) {
                bootstrap_artifact_write_literal("Trap");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "Bytes", 5,
            ) {
                bootstrap_artifact_write_literal("Bytes");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
            if span_equals(
                source, member_start, member_end, "String", 6,
            ) {
                bootstrap_artifact_write_literal("String");
                if member_tail < end {
                    emit_name(source, member_tail, end);
                }
                return;
            }
        }
    }
    let substitution_count: usize = std::load_i64(
        std::offset(cache, 159816),
    );
    let substitution_index: usize = substitution_count;
    while substitution_index != 0 {
        substitution_index = substitution_index - 1;
        let substitution: addr = std::offset(
            cache, 159824 + substitution_index * 32,
        );
        if std::load_i64(substitution) ==
            span_key(source, start, head_end) {
            let argument_source: addr = (
                std::load_i64(std::offset(substitution, 8))
                as addr
            );
            let argument_start: usize = std::load_i64(
                std::offset(substitution, 16),
            );
            let argument_end: usize = std::load_i64(
                std::offset(substitution, 24),
            );
            emit_constructor_argument(
                cache,
                argument_source,
                argument_start,
                argument_end,
                substitution_index,
            );
            if first_separator < end {
                emit_name(source, first_separator, end);
            }
            return;
        }
    }
    if span_equals(source, start, head_end, "Namespace", 9) {
        let namespace_start: usize = std::load_i64(
            std::offset(cache, 127008),
        );
        let namespace_end: usize = std::load_i64(
            std::offset(cache, 127016),
        );
        if namespace_end > namespace_start {
            let namespace_source: addr = (
                std::load_i64(std::offset(cache, 147512))
                as addr
            );
            emit_name(
                namespace_source,
                namespace_start,
                namespace_end,
            );
            if first_separator < end {
                emit_name(source, first_separator, end);
            }
            return;
        }
    }
    if dot == end {
    if colon == end {
        let namespace_start: usize = std::load_i64(
            std::offset(cache, 127008),
        );
        let namespace_end: usize = std::load_i64(
            std::offset(cache, 127016),
        );
        if namespace_end > namespace_start {
            let namespace_source: addr = (
                std::load_i64(std::offset(cache, 147512))
                as addr
            );
            emit_name(
                namespace_source,
                namespace_start,
                namespace_end,
            );
            bootstrap_artifact_write_byte(46);
        }
    }
    }
    emit_name(source, start, end);
    return;
};

let span_is = std::func(
    source: addr,
    start: usize,
    end: usize,
    code: i32,
) -> bool {
    let length: usize = end - start;
    if code == 1 {
        if length != 3 { return 0; }
        if byte_at(source, start) != 108 { return 0; }
        if byte_at(source, start + 1) != 101 { return 0; }
        return byte_at(source, start + 2) == 116;
    }
    if code == 2 {
        if length != 6 { return 0; }
        if byte_at(source, start) != 114 { return 0; }
        if byte_at(source, start + 1) != 101 { return 0; }
        if byte_at(source, start + 2) != 116 { return 0; }
        if byte_at(source, start + 3) != 117 { return 0; }
        if byte_at(source, start + 4) != 114 { return 0; }
        return byte_at(source, start + 5) == 110;
    }
    if code == 3 {
        if length != 2 { return 0; }
        if byte_at(source, start) != 105 { return 0; }
        return byte_at(source, start + 1) == 102;
    }
    if code == 4 {
        if length != 5 { return 0; }
        if byte_at(source, start) != 119 { return 0; }
        if byte_at(source, start + 1) != 104 { return 0; }
        if byte_at(source, start + 2) != 105 { return 0; }
        if byte_at(source, start + 3) != 108 { return 0; }
        return byte_at(source, start + 4) == 101;
    }
    if code == 5 {
        if length != 4 { return 0; }
        if byte_at(source, start) != 101 { return 0; }
        if byte_at(source, start + 1) != 108 { return 0; }
        if byte_at(source, start + 2) != 115 { return 0; }
        return byte_at(source, start + 3) == 101;
    }
    return 0;
};

let span_equals = std::func(
    source: addr,
    start: usize,
    end: usize,
    expected: addr,
    expected_length: usize,
) -> bool {
    if end - start != expected_length {
        return 0;
    }
    let index: usize = 0;
    while index < expected_length {
        if byte_at(source, start + index) != byte_at(expected, index) {
            return 0;
        }
        index = index + 1;
    }
    return 1;
};

let is_compile_time_type = std::func(
    source: addr,
    initial_start: usize,
    initial_end: usize,
) -> bool {
    let start: usize = trim_left(source, initial_end, initial_start);
    let end: usize = trim_right(source, start, initial_end);
    if span_equals(source, start, end, "type", 4) {
        return 1;
    }
    if span_equals(source, start, end, "Module", 6) {
        return 1;
    }
    if span_equals(source, start, end, "ModuleShape", 11) {
        return 1;
    }
    return 0;
};

let trim_left = std::func(
    source: addr,
    end: usize,
    start: usize,
) -> usize {
    let cursor: usize = start;
    while cursor < end {
        if is_space(byte_at(source, cursor)) {
            cursor = cursor + 1;
        } else {
            return cursor;
        }
    }
    return cursor;
};

let trim_right = std::func(
    source: addr,
    start: usize,
    initial_end: usize,
) -> usize {
    let end: usize = initial_end;
    while end > start {
        if is_space(byte_at(source, end - 1)) {
            end = end - 1;
        } else {
            return end;
        }
    }
    return end;
};

let matching_close = std::func(
    source: addr,
    length: usize,
    open: usize,
    open_byte: i32,
    close_byte: i32,
) -> usize {
    let cursor: usize = open + 1;
    let depth: i32 = 1;
    let quoted: bool = 0;
    while cursor < length {
        let byte: i32 = byte_at(source, cursor);
        if quoted {
            if byte == 92 {
                cursor = cursor + 1;
            } else {
                if byte == 34 { quoted = 0; }
            }
        } else {
            if byte == 34 {
                quoted = 1;
            } else {
                if byte == open_byte { depth = depth + 1; }
                if byte == close_byte {
                    depth = depth - 1;
                    if depth == 0 { return cursor; }
                }
            }
        }
        cursor = cursor + 1;
    }
    return length;
};

let find_top_level = std::func(
    source: addr,
    start: usize,
    end: usize,
    wanted: i32,
) -> usize {
    let cursor: usize = start;
    let paren_depth: i32 = 0;
    let brace_depth: i32 = 0;
    let bracket_depth: i32 = 0;
    let quoted: bool = 0;
    while cursor < end {
        let byte: i32 = byte_at(source, cursor);
        if quoted {
            if byte == 92 {
                cursor = cursor + 1;
            } else {
                if byte == 34 { quoted = 0; }
            }
        } else {
            if byte == 34 {
                quoted = 1;
            } else {
                if paren_depth == 0 {
                    if brace_depth == 0 {
                        if bracket_depth == 0 {
                            if byte == wanted { return cursor; }
                        }
                    }
                }
                if byte == 40 { paren_depth = paren_depth + 1; }
                if byte == 41 { paren_depth = paren_depth - 1; }
                if byte == 123 { brace_depth = brace_depth + 1; }
                if byte == 125 { brace_depth = brace_depth - 1; }
                if byte == 91 { bracket_depth = bracket_depth + 1; }
                if byte == 93 { bracket_depth = bracket_depth - 1; }
            }
        }
        cursor = cursor + 1;
    }
    return end;
};

let find_last_operator = std::func(
    source: addr,
    start: usize,
    end: usize,
    level: i32,
) -> usize {
    let cursor: usize = start;
    let found: usize = end;
    let depth: i32 = 0;
    let quoted: bool = 0;
    while cursor < end {
        let byte: i32 = byte_at(source, cursor);
        if quoted {
            if byte == 92 {
                cursor = cursor + 1;
            } else {
                if byte == 34 { quoted = 0; }
            }
        } else {
            if byte == 34 {
                quoted = 1;
            } else {
                if byte == 40 { depth = depth + 1; }
                if byte == 123 { depth = depth + 1; }
                if byte == 91 { depth = depth + 1; }
                if byte == 41 { depth = depth - 1; }
                if byte == 125 { depth = depth - 1; }
                if byte == 93 { depth = depth - 1; }
                if depth == 0 {
                    if level == 1 {
                        if byte == 124 {
                            if cursor + 1 < end {
                                if byte_at(source, cursor + 1) == 124 {
                                    found = cursor;
                                }
                            }
                        }
                    }
                    if level == 2 {
                        if byte == 38 {
                            if cursor + 1 < end {
                                if byte_at(source, cursor + 1) == 38 {
                                    found = cursor;
                                }
                            }
                        }
                    }
                    if level == 3 {
                        let second_half: bool = 0;
                        if cursor > start {
                            let previous: i32 = byte_at(
                                source,
                                cursor - 1,
                            );
                            if previous == 61 { second_half = 1; }
                            if previous == 33 { second_half = 1; }
                            if previous == 60 { second_half = 1; }
                            if previous == 62 { second_half = 1; }
                        }
                        if second_half == 0 {
                            if byte == 61 { found = cursor; }
                            if byte == 33 { found = cursor; }
                            if byte == 60 { found = cursor; }
                            if byte == 62 { found = cursor; }
                        }
                    }
                    if level == 4 {
                        if byte == 43 { found = cursor; }
                        if byte == 45 { found = cursor; }
                    }
                    if level == 5 {
                        if byte == 42 {
                            let postfix_deref: bool = 0;
                            if cursor > start {
                                if byte_at(source, cursor - 1) == 46 {
                                    postfix_deref = 1;
                                }
                            }
                            if postfix_deref == 0 { found = cursor; }
                        }
                        if byte == 47 { found = cursor; }
                        if byte == 37 { found = cursor; }
                    }
                }
            }
        }
        cursor = cursor + 1;
    }
    return found;
};

let find_top_level_as = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let cursor: usize = start;
    let depth: i32 = 0;
    let quoted: bool = 0;
    while cursor + 1 < end {
        let byte: i32 = byte_at(source, cursor);
        if quoted {
            if byte == 92 {
                cursor = cursor + 1;
            } else {
                if byte == 34 { quoted = 0; }
            }
        } else {
            if byte == 34 {
                quoted = 1;
            } else {
                if byte == 40 { depth = depth + 1; }
                if byte == 123 { depth = depth + 1; }
                if byte == 91 { depth = depth + 1; }
                if byte == 41 { depth = depth - 1; }
                if byte == 125 { depth = depth - 1; }
                if byte == 93 { depth = depth - 1; }
                if depth == 0 {
                    if byte == 97 {
                        if byte_at(source, cursor + 1) == 115 {
                            let left_ok: bool = cursor == start;
                            let right_ok: bool = cursor + 2 == end;
                            if cursor > start {
                                left_ok = is_ident_byte(
                                    byte_at(source, cursor - 1),
                                ) == 0;
                            }
                            if cursor + 2 < end {
                                right_ok = is_ident_byte(
                                    byte_at(source, cursor + 2),
                                ) == 0;
                            }
                            if left_ok {
                                if right_ok { return cursor; }
                            }
                        }
                    }
                }
            }
        }
        cursor = cursor + 1;
    }
    return end;
};

let emit_type = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> unit {
    let left: usize = trim_left(source, end, start);
    let right: usize = trim_right(source, left, end);
    let length: usize = right - left;
    if length == 5 {
        if span_equals(source, left, right, "never", 5) {
            bootstrap_artifact_write_literal("#never");
            return;
        }
        if byte_at(source, left) == 117 {
            bootstrap_artifact_write_literal("#bits<64>");
            return;
        }
    }
    if length == 4 {
        if byte_at(source, left) == 98 {
            bootstrap_artifact_write_literal("#bits<1>");
            return;
        }
        if byte_at(source, left) == 117 {
            bootstrap_artifact_write_literal("#unit");
            return;
        }
        if byte_at(source, left) == 97 {
            bootstrap_artifact_write_literal("#addr");
            return;
        }
    }
    if length == 3 {
        if byte_at(source, left) == 105 {
            bootstrap_artifact_write_literal("#bits<32>");
            return;
        }
    }
    // Nominal structs, references, Modules and compile-time objects are
    // represented by an address in the transitional compiler ABI. TypeValue
    // keeps their semantic identity; LAIN-IR only receives the physical shape.
    bootstrap_artifact_write_literal("#addr");
    return;
};

let emit_type_in = std::func(
    cache: addr,
    source: addr,
    initial_start: usize,
    initial_end: usize,
) -> unit {
    let start: usize = trim_left(
        source, initial_end, initial_start,
    );
    let end: usize = trim_right(source, start, initial_end);
    let substituted_kind: i32 = compile_time_argument_kind_in(
        cache,
        source,
        start,
        end,
        std::load_i64(std::offset(cache, 159816)),
    );
    if substituted_kind == 1 {
        bootstrap_artifact_write_literal("#bits<32>");
        return;
    }
    if substituted_kind == 2 {
        bootstrap_artifact_write_literal("#bits<1>");
        return;
    }
    if substituted_kind == 3 {
        bootstrap_artifact_write_literal("#bits<64>");
        return;
    }
    if substituted_kind == 4 {
        bootstrap_artifact_write_literal("#addr");
        return;
    }
    if start < end {
        if byte_at(source, start) == 38 {
            bootstrap_artifact_write_literal("#addr");
            return;
        }
    }
    let name_start: usize = start;
    let dot: usize = find_top_level(source, start, end, 46);
    if dot < end {
        name_start = skip_space(source, end, dot + 1);
    }
    let name_end: usize = scan_ident_end(source, end, name_start);
    let kind: usize = lookup_compile_time_binding(
        cache, source, name_start, name_end,
    );
    if kind == 31 {
        bootstrap_artifact_write_literal("#bits<32>");
        return;
    }
    if kind == 32 {
        bootstrap_artifact_write_literal("#bits<1>");
        return;
    }
    if kind == 33 {
        bootstrap_artifact_write_literal("#bits<64>");
        return;
    }
    if kind == 34 {
        bootstrap_artifact_write_literal("#addr");
        return;
    }
    emit_type(source, start, end);
    return;
};

let emit_typed_store_prefix = std::func(kind: usize) -> unit {
    bootstrap_artifact_write_literal("#store[");
    if kind == 1 {
        bootstrap_artifact_write_literal("#bits<32>");
    } else {
        if kind == 2 {
            bootstrap_artifact_write_literal("#bits<1>");
        } else {
            if kind == 3 {
                bootstrap_artifact_write_literal("#bits<64>");
            } else {
                bootstrap_artifact_write_literal("#addr");
            }
        }
    }
    bootstrap_artifact_write_literal("] ");
    return;
};

let emit_operator = std::func(
    source: addr,
    position: usize,
) -> usize {
    let byte: i32 = byte_at(source, position);
    if byte == 43 { bootstrap_artifact_write_literal("#add("); return 1; }
    if byte == 45 { bootstrap_artifact_write_literal("#sub("); return 1; }
    if byte == 42 { bootstrap_artifact_write_literal("#mul("); return 1; }
    if byte == 47 { bootstrap_artifact_write_literal("#udiv("); return 1; }
    if byte == 61 { bootstrap_artifact_write_literal("#eq("); return 2; }
    if byte == 33 { bootstrap_artifact_write_literal("#ne("); return 2; }
    if byte == 60 {
        if byte_at(source, position + 1) == 61 {
            bootstrap_artifact_write_literal("#ule(");
            return 2;
        }
        bootstrap_artifact_write_literal("#ult(");
        return 1;
    }
    if byte == 62 {
        if byte_at(source, position + 1) == 61 {
            bootstrap_artifact_write_literal("#uge(");
            return 2;
        }
        bootstrap_artifact_write_literal("#ugt(");
        return 1;
    }
    return 1;
};

let spans_equal = std::func(
    source: addr,
    left_start: usize,
    left_end: usize,
    right_start: usize,
    right_end: usize,
) -> bool {
    if left_end - left_start != right_end - right_start {
        return 0;
    }
    let index: usize = 0;
    while left_start + index < left_end {
        if byte_at(source, left_start + index) !=
            byte_at(source, right_start + index) {
            return 0;
        }
        index = index + 1;
    }
    return 1;
};

// Returns type_start * 2^32 + type_end, or zero when NAME has no preceding
// typed binding. This deliberately rescans source instead of requiring a host
// symbol table; the self-hosted compiler will later replace it with TypeStore.
let find_variable_type = std::func(
    source: addr,
    before: usize,
    name_start: usize,
    name_end: usize,
) -> usize {
    let cursor: usize = before;
    while cursor != 0 {
        cursor = cursor - 1;
        if is_ident_byte(byte_at(source, cursor)) {
            let token_start: usize = cursor;
            let scanning_start: bool = 1;
            while scanning_start {
                if token_start == 0 {
                    scanning_start = 0;
                } else {
                    if is_ident_byte(byte_at(source, token_start - 1)) {
                        token_start = token_start - 1;
                    } else {
                        scanning_start = 0;
                    }
                }
            }
            let token_end: usize = scan_ident_end(
                source, before, token_start,
            );
            if spans_equal(
                source,
                token_start,
                token_end,
                name_start,
                name_end,
            ) {
                let colon: usize = skip_space(
                    source, before, token_end,
                );
                if colon < before {
                    if byte_at(source, colon) == 58 {
                        let type_start: usize = skip_space(
                            source, before, colon + 1,
                        );
                        if type_start < before {
                            if byte_at(source, type_start) == 38 {
                                type_start = skip_space(
                                    source, before, type_start + 1,
                                );
                                let mut_end: usize = scan_ident_end(
                                    source, before, type_start,
                                );
                                if span_equals(
                                    source,
                                    type_start,
                                    mut_end,
                                    "mut",
                                    3,
                                ) {
                                    type_start = skip_space(
                                        source, before, mut_end,
                                    );
                                }
                            }
                        }
                        let type_end: usize = scan_ident_end(
                            source, before, type_start,
                        );
                        let type_path_running: bool = 1;
                        while type_path_running {
                            let dot: usize = skip_space(
                                source, before, type_end,
                            );
                            if dot < before {
                                if byte_at(source, dot) == 46 {
                                    let member_start: usize = skip_space(
                                        source, before, dot + 1,
                                    );
                                    let member_end: usize = scan_ident_end(
                                        source, before, member_start,
                                    );
                                    if member_end > member_start {
                                        type_end = member_end;
                                    } else {
                                        type_path_running = 0;
                                    }
                                } else {
                                    type_path_running = 0;
                                }
                            } else {
                                type_path_running = 0;
                            }
                        }
                        if type_end > type_start {
                            return type_start * 1000000 + type_end;
                        }
                    }
                }
            }
            cursor = token_start;
        }
    }
    return 0;
};

let scan_path_end = std::func(
    source: addr,
    end: usize,
    start: usize,
) -> usize {
    let result: usize = scan_ident_end(source, end, start);
    let running: bool = 1;
    while running {
        let dot: usize = skip_space(source, end, result);
        if dot < end {
            if byte_at(source, dot) == 46 {
                let member_start: usize = skip_space(
                    source, end, dot + 1,
                );
                let member_end: usize = scan_ident_end(
                    source, end, member_start,
                );
                if member_end > member_start {
                    result = member_end;
                } else {
                    running = 0;
                }
            } else {
                running = 0;
            }
        } else {
            running = 0;
        }
    }
    return result;
};

// Returns physical_kind * 1,000,000 + byte_offset + 1. The low value is biased by
// one so that field zero remains distinguishable from "not found".
let find_struct_field = std::func(
    source: addr,
    before: usize,
    type_start: usize,
    type_end: usize,
    field_start: usize,
    field_end: usize,
) -> usize {
    let cursor: usize = before;
    while cursor != 0 {
        cursor = cursor - 1;
        if is_ident_byte(byte_at(source, cursor)) {
        let token_start: usize = cursor;
        let scanning_start: bool = 1;
        while scanning_start {
            if token_start == 0 {
                scanning_start = 0;
            } else {
                if is_ident_byte(byte_at(source, token_start - 1)) {
                    token_start = token_start - 1;
                } else {
                    scanning_start = 0;
                }
            }
        }
        let token_end: usize = scan_ident_end(
            source, before, token_start,
        );
        if span_is(source, token_start, token_end, 1) {
            let declaration_name: usize = skip_space(
                source, before, token_end,
            );
            let declaration_name_end: usize = scan_ident_end(
                source, before, declaration_name,
            );
            if spans_equal(
                source,
                declaration_name,
                declaration_name_end,
                type_start,
                type_end,
            ) {
                let equal: usize = find_top_level(
                    source,
                    declaration_name_end,
                    before,
                    61,
                );
                let body_open: usize = find_top_level(
                    source, equal + 1, before, 123,
                );
                if body_open < before {
                    let body_close: usize = matching_close(
                        source, before, body_open, 123, 125,
                    );
                    let field: usize = skip_space(
                        source, body_close, body_open + 1,
                    );
                    let offset: usize = 0;
                    while field < body_close {
                        let comma: usize = find_top_level(
                            source, field, body_close, 44,
                        );
                        let name_end: usize = scan_ident_end(
                            source, comma, field,
                        );
                        let colon: usize = find_top_level(
                            source, name_end, comma, 58,
                        );
                        if spans_equal(
                            source,
                            field,
                            name_end,
                            field_start,
                            field_end,
                        ) {
                            let member_type: usize = skip_space(
                                source, comma, colon + 1,
                            );
                            let member_type_end: usize = scan_path_end(
                                source, comma, member_type,
                            );
                            let kind: usize = 4;
                            if span_equals(
                                source,
                                member_type,
                                member_type_end,
                                "i32",
                                3,
                            ) {
                                kind = 1;
                            }
                            if span_equals(
                                source,
                                member_type,
                                member_type_end,
                                "bool",
                                4,
                            ) {
                                kind = 2;
                            }
                            if span_equals(
                                source,
                                member_type,
                                member_type_end,
                                "usize",
                                5,
                            ) {
                                kind = 3;
                            }
                            return kind * 1000000 + offset + 1;
                        }
                        offset = offset + 8;
                        if comma == body_close {
                            field = body_close;
                        } else {
                            field = skip_space(
                                source, body_close, comma + 1,
                            );
                        }
                    }
                }
            }
            cursor = token_start;
        } else {
            cursor = token_start;
        }
        }
    }
    return 0;
};

let find_struct_field_type = std::func(
    source: addr,
    before: usize,
    type_start: usize,
    type_end: usize,
    field_start: usize,
    field_end: usize,
) -> usize {
    let cursor: usize = before;
    while cursor != 0 {
        cursor = cursor - 1;
        if is_ident_byte(byte_at(source, cursor)) {
            let token_start: usize = cursor;
            let scanning_start: bool = 1;
            while scanning_start {
                if token_start == 0 {
                    scanning_start = 0;
                } else {
                    if is_ident_byte(byte_at(source, token_start - 1)) {
                        token_start = token_start - 1;
                    } else {
                        scanning_start = 0;
                    }
                }
            }
            let token_end: usize = scan_ident_end(
                source, before, token_start,
            );
            if span_is(source, token_start, token_end, 1) {
                let declaration_name: usize = skip_space(
                    source, before, token_end,
                );
                let declaration_name_end: usize = scan_ident_end(
                    source, before, declaration_name,
                );
                if spans_equal(
                    source,
                    declaration_name,
                    declaration_name_end,
                    type_start,
                    type_end,
                ) {
                    let equal: usize = find_top_level(
                        source,
                        declaration_name_end,
                        before,
                        61,
                    );
                    let body_open: usize = find_top_level(
                        source, equal + 1, before, 123,
                    );
                    if body_open < before {
                        let body_close: usize = matching_close(
                            source, before, body_open, 123, 125,
                        );
                        let field: usize = skip_space(
                            source, body_close, body_open + 1,
                        );
                        while field < body_close {
                            let comma: usize = find_top_level(
                                source, field, body_close, 44,
                            );
                            let name_end: usize = scan_ident_end(
                                source, comma, field,
                            );
                            let colon: usize = find_top_level(
                                source, name_end, comma, 58,
                            );
                            if spans_equal(
                                source,
                                field,
                                name_end,
                                field_start,
                                field_end,
                            ) {
                                let member_type: usize = skip_space(
                                    source, comma, colon + 1,
                                );
                                let member_type_end: usize =
                                    scan_path_end(
                                        source, comma, member_type,
                                    );
                                if member_type_end > member_type {
                                    return member_type * 1000000 +
                                        member_type_end;
                                }
                                return 0;
                            }
                            if comma == body_close {
                                field = body_close;
                            } else {
                                field = skip_space(
                                    source,
                                    body_close,
                                    comma + 1,
                                );
                            }
                        }
                    }
                }
                cursor = token_start;
            } else {
                cursor = token_start;
            }
        }
    }
    return 0;
};

let span_key = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let hash: usize = 2166136261;
    let cursor: usize = start;
    while cursor < end {
        hash = hash * 16777619 + byte_at(source, cursor);
        cursor = cursor + 1;
    }
    return hash;
};

let register_struct_fields = std::func(
    cache: addr,
    type_source: addr,
    source: addr,
    type_start: usize,
    type_end: usize,
    body_start: usize,
    body_end: usize,
) -> bool {
    let type_key: usize = span_key(
        type_source, type_start, type_end,
    );
    let field: usize = skip_space(source, body_end, body_start);
    let offset: usize = 0;
    while field < body_end {
        let comma: usize = find_top_level(
            source, field, body_end, 44,
        );
        let field_end: usize = scan_ident_end(
            source, comma, field,
        );
        let colon: usize = find_top_level(
            source, field_end, comma, 58,
        );
        if colon == comma { return 0; }
        let member_type: usize = skip_space(
            source, comma, colon + 1,
        );
        let member_type_end: usize = scan_path_end(
            source, comma, member_type,
        );
        let kind: usize = 4;
        if span_equals(
            source, member_type, member_type_end, "i32", 3,
        ) { kind = 1; }
        if span_equals(
            source, member_type, member_type_end, "bool", 4,
        ) { kind = 2; }
        if span_equals(
            source, member_type, member_type_end, "usize", 5,
        ) { kind = 3; }
        let alias_kind: usize = lookup_compile_time_binding(
            cache, source, member_type, member_type_end,
        );
        if alias_kind == 31 { kind = 1; }
        if alias_kind == 32 { kind = 2; }
        if alias_kind == 33 { kind = 3; }
        if alias_kind == 34 { kind = 4; }
        let count: usize = std::load_i64(cache);
        if count >= 4096 { return 0; }
        let entry: addr = std::offset(cache, 8 + count * 24);
        std::store_i64(entry, type_key);
        std::store_i64(
            std::offset(entry, 8),
            span_key(source, field, field_end),
        );
        std::store_i64(
            std::offset(entry, 16),
            kind * 1000000 + offset + 1,
        );
        let type_entry_count: usize = std::load_i64(
            std::offset(cache, 213088),
        );
        if type_entry_count >= 4096 { return 0; }
        let type_entry: addr = std::offset(
            cache, 213096 + type_entry_count * 40,
        );
        std::store_i64(type_entry, type_key);
        std::store_i64(
            std::offset(type_entry, 8),
            span_key(source, field, field_end),
        );
        std::store_i64(std::offset(type_entry, 16), source);
        std::store_i64(
            std::offset(type_entry, 24), member_type,
        );
        std::store_i64(
            std::offset(type_entry, 32), member_type_end,
        );
        std::store_i64(
            std::offset(cache, 213088), type_entry_count + 1,
        );
        std::store_i64(cache, count + 1);
        offset = offset + 8;
        if comma == body_end {
            field = body_end;
        } else {
            field = skip_space(source, body_end, comma + 1);
        }
    }
    return 1;
};

let cached_struct_field_type_entry = std::func(
    cache: addr,
    source: addr,
    type_start: usize,
    type_end: usize,
    field_start: usize,
    field_end: usize,
) -> addr {
    let key_start: usize = type_start;
    let type_dot: usize = find_last_top_level_dot(
        source, type_start, type_end,
    );
    if type_dot < type_end {
        key_start = skip_space(source, type_end, type_dot + 1);
    }
    let type_key: usize = span_key(source, key_start, type_end);
    let field_key: usize = span_key(
        source, field_start, field_end,
    );
    let count: usize = std::load_i64(
        std::offset(cache, 213088),
    );
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(
            cache, 213096 + index * 40,
        );
        if std::load_i64(entry) == type_key {
            if std::load_i64(std::offset(entry, 8)) == field_key {
                return entry;
            }
        }
        index = index + 1;
    }
    return 0 as addr;
};

let cached_struct_field_cross = std::func(
    cache: addr,
    type_source: addr,
    type_start: usize,
    type_end: usize,
    field_source: addr,
    field_start: usize,
    field_end: usize,
) -> usize {
    let key_start: usize = type_start;
    let type_dot: usize = find_last_top_level_dot(
        type_source, type_start, type_end,
    );
    if type_dot < type_end {
        key_start = skip_space(
            type_source, type_end, type_dot + 1,
        );
    }
    let type_key: usize = span_key(
        type_source, key_start, type_end,
    );
    let field_key: usize = span_key(
        field_source, field_start, field_end,
    );
    let count: usize = std::load_i64(cache);
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(cache, 8 + index * 24);
        if std::load_i64(entry) == type_key {
            if std::load_i64(std::offset(entry, 8)) == field_key {
                return std::load_i64(std::offset(entry, 16));
            }
        }
        index = index + 1;
    }
    return 0;
};

let cached_struct_field_type_entry_cross = std::func(
    cache: addr,
    type_source: addr,
    type_start: usize,
    type_end: usize,
    field_source: addr,
    field_start: usize,
    field_end: usize,
) -> addr {
    let key_start: usize = type_start;
    let type_dot: usize = find_last_top_level_dot(
        type_source, type_start, type_end,
    );
    if type_dot < type_end {
        key_start = skip_space(
            type_source, type_end, type_dot + 1,
        );
    }
    let type_key: usize = span_key(
        type_source, key_start, type_end,
    );
    let field_key: usize = span_key(
        field_source, field_start, field_end,
    );
    let count: usize = std::load_i64(
        std::offset(cache, 213088),
    );
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(
            cache, 213096 + index * 40,
        );
        if std::load_i64(entry) == type_key {
            if std::load_i64(std::offset(entry, 8)) == field_key {
                return entry;
            }
        }
        index = index + 1;
    }
    return 0 as addr;
};

// CACHE is {count, entries[256]}; each entry is
// {type-key, field-key, encoded physical field descriptor}.
let cached_struct_field = std::func(
    cache: addr,
    source: addr,
    before: usize,
    type_start: usize,
    type_end: usize,
    field_start: usize,
    field_end: usize,
) -> usize {
    let key_start: usize = type_start;
    let type_dot: usize = find_top_level(
        source, type_start, type_end, 46,
    );
    if type_dot < type_end {
        key_start = skip_space(source, type_end, type_dot + 1);
    }
    let type_key: usize = span_key(source, key_start, type_end);
    let field_key: usize = span_key(source, field_start, field_end);
    let count: usize = std::load_i64(cache);
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(cache, 8 + index * 24);
        if std::load_i64(entry) == type_key {
            if std::load_i64(std::offset(entry, 8)) == field_key {
                return std::load_i64(std::offset(entry, 16));
            }
        }
        index = index + 1;
    }
    let descriptor: usize = find_struct_field(
        source,
        before,
        type_start,
        type_end,
        field_start,
        field_end,
    );
    // Negative lookups are cached as descriptor zero as well. Qualified
    // Module member accesses otherwise rescan the whole source on every use.
    if count < 4096 {
        let entry: addr = std::offset(cache, 8 + count * 24);
        std::store_i64(entry, type_key);
        std::store_i64(std::offset(entry, 8), field_key);
        std::store_i64(std::offset(entry, 16), descriptor);
        std::store_i64(cache, count + 1);
    }
    return descriptor;
};

let find_last_top_level_dot = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> usize {
    let dot: usize = find_top_level(source, start, end, 46);
    let last: usize = end;
    while dot < end {
        last = dot;
        dot = find_top_level(source, dot + 1, end, 46);
    }
    return last;
};

// Transitional fallback for a field access whose base is a call expression.
// Method-return type propagation belongs to the self-hosted elaborator; until
// that path runs, accept a field name only when every registered occurrence
// has the same physical descriptor.
let cached_unambiguous_field = std::func(
    cache: addr,
    source: addr,
    field_start: usize,
    field_end: usize,
) -> usize {
    let field_key: usize = span_key(source, field_start, field_end);
    let count: usize = std::load_i64(cache);
    let index: usize = 0;
    let found: usize = 0;
    while index < count {
        let entry: addr = std::offset(cache, 8 + index * 24);
        if std::load_i64(std::offset(entry, 8)) == field_key {
            let descriptor: usize =
                std::load_i64(std::offset(entry, 16));
            if descriptor != 0 {
                if found == 0 {
                    found = descriptor;
                } else {
                    if found != descriptor { return 0; }
                }
            }
        }
        index = index + 1;
    }
    return found;
};

let emit_usize = std::func(value: usize) -> unit {
    if value == 0 { bootstrap_artifact_write_literal("0"); return; }
    if value == 8 { bootstrap_artifact_write_literal("8"); return; }
    if value == 16 { bootstrap_artifact_write_literal("16"); return; }
    if value == 24 { bootstrap_artifact_write_literal("24"); return; }
    if value == 32 { bootstrap_artifact_write_literal("32"); return; }
    if value == 40 { bootstrap_artifact_write_literal("40"); return; }
    if value == 48 { bootstrap_artifact_write_literal("48"); return; }
    if value == 56 { bootstrap_artifact_write_literal("56"); return; }
    if value == 64 { bootstrap_artifact_write_literal("64"); return; }
    if value == 72 { bootstrap_artifact_write_literal("72"); return; }
    if value == 80 { bootstrap_artifact_write_literal("80"); return; }
    if value == 88 { bootstrap_artifact_write_literal("88"); return; }
    if value == 96 { bootstrap_artifact_write_literal("96"); return; }
    if value == 104 { bootstrap_artifact_write_literal("104"); return; }
    if value == 112 { bootstrap_artifact_write_literal("112"); return; }
    if value == 120 { bootstrap_artifact_write_literal("120"); return; }
    if value == 128 { bootstrap_artifact_write_literal("128"); return; }
    if value == 136 { bootstrap_artifact_write_literal("136"); return; }
    if value == 144 { bootstrap_artifact_write_literal("144"); return; }
    if value == 152 { bootstrap_artifact_write_literal("152"); return; }
    if value == 160 { bootstrap_artifact_write_literal("160"); return; }
    if value == 168 { bootstrap_artifact_write_literal("168"); return; }
    if value == 176 { bootstrap_artifact_write_literal("176"); return; }
    if value == 184 { bootstrap_artifact_write_literal("184"); return; }
    if value == 192 { bootstrap_artifact_write_literal("192"); return; }
    if value == 200 { bootstrap_artifact_write_literal("200"); return; }
    if value == 208 { bootstrap_artifact_write_literal("208"); return; }
    if value == 216 { bootstrap_artifact_write_literal("216"); return; }
    if value == 224 { bootstrap_artifact_write_literal("224"); return; }
    if value == 232 { bootstrap_artifact_write_literal("232"); return; }
    if value == 240 { bootstrap_artifact_write_literal("240"); return; }
    if value == 248 { bootstrap_artifact_write_literal("248"); return; }
    if value == 256 { bootstrap_artifact_write_literal("256"); return; }
    bootstrap_artifact_write_literal("0");
    return;
};

let emit_decimal = std::func(value: usize) -> unit {
    if value >= 10 {
        emit_decimal(value / 10);
    }
    let quotient: usize = value / 10;
    let digit: usize = value - quotient * 10;
    if digit == 0 { bootstrap_artifact_write_byte(48); return; }
    if digit == 1 { bootstrap_artifact_write_byte(49); return; }
    if digit == 2 { bootstrap_artifact_write_byte(50); return; }
    if digit == 3 { bootstrap_artifact_write_byte(51); return; }
    if digit == 4 { bootstrap_artifact_write_byte(52); return; }
    if digit == 5 { bootstrap_artifact_write_byte(53); return; }
    if digit == 6 { bootstrap_artifact_write_byte(54); return; }
    if digit == 7 { bootstrap_artifact_write_byte(55); return; }
    if digit == 8 { bootstrap_artifact_write_byte(56); return; }
    bootstrap_artifact_write_byte(57);
    return;
};

let emit_temporary_name = std::func(position: usize) -> unit {
    bootstrap_artifact_write_literal("__tmp_");
    emit_decimal(position);
    return;
};

let compile_time_argument_kind = std::func(
    source: addr,
    initial_start: usize,
    initial_end: usize,
) -> i32 {
    let start: usize = trim_left(source, initial_end, initial_start);
    let end: usize = trim_right(source, start, initial_end);
    if span_equals(source, start, end, "i32", 3) { return 1; }
    if span_equals(source, start, end, "bool", 4) { return 2; }
    if span_equals(source, start, end, "usize", 5) { return 3; }
    if span_equals(source, start, end, "addr", 4) { return 4; }
    return 0;
};

let compile_time_argument_kind_in = std::func(
    cache: addr,
    source: addr,
    initial_start: usize,
    initial_end: usize,
    limit: usize,
) -> i32 {
    let direct: i32 = compile_time_argument_kind(
        source, initial_start, initial_end,
    );
    if direct != 0 { return direct; }
    let start: usize = trim_left(
        source, initial_end, initial_start,
    );
    let end: usize = trim_right(source, start, initial_end);
    let index: usize = limit;
    while index != 0 {
        index = index - 1;
        let substitution: addr = std::offset(
            cache, 159824 + index * 32,
        );
        if std::load_i64(substitution) == span_key(source, start, end) {
            let argument_source: addr = (
                std::load_i64(std::offset(substitution, 8))
                as addr
            );
            return compile_time_argument_kind_in(
                cache,
                argument_source,
                std::load_i64(std::offset(substitution, 16)),
                std::load_i64(std::offset(substitution, 24)),
                index,
            );
        }
    }
    return 0;
};

let emit_specialization_suffix = std::func(kind: i32) -> unit {
    if kind == 1 {
        bootstrap_artifact_write_literal("__T_i32");
        return;
    }
    if kind == 2 {
        bootstrap_artifact_write_literal("__T_bool");
        return;
    }
    if kind == 3 {
        bootstrap_artifact_write_literal("__T_usize");
        return;
    }
    if kind == 4 {
        bootstrap_artifact_write_literal("__T_addr");
        return;
    }
    return;
};

let emit_expression = std::func(
