            );
        } else {
            emit_scoped_name(cache, source, start, name_end);
        }
        if specialization_kind != 0 {
            emit_specialization_suffix(specialization_kind);
        }
        bootstrap_artifact_write_literal("(");
        let argument_start: usize = open + 1;
        if specialization_kind != 0 {
            if first_comma == close {
                argument_start = close;
            } else {
                argument_start = first_comma + 1;
            }
        }
        let argument_cursor: usize = argument_start;
        let first: bool = 1;
        if method_type != 0 {
            emit_expression(
                cache, source, start, method_receiver_end,
            );
            first = 0;
        }
        while argument_cursor < close {
            let comma: usize = find_top_level(
                source,
                argument_cursor,
                close,
                44,
            );
            let argument_left: usize = trim_left(
                source,
                comma,
                argument_cursor,
            );
            let argument_right: usize = trim_right(
                source,
                argument_left,
                comma,
            );
            if argument_left == argument_right {
                argument_cursor = close;
            } else {
                if first == 0 {
                    bootstrap_artifact_write_literal(", ");
                }
                emit_expression(
                    cache,
                    source,
                    argument_left,
                    argument_right,
                );
                first = 0;
                if comma == close {
                    argument_cursor = close;
                } else {
                    argument_cursor = comma + 1;
                }
            }
        }
        bootstrap_artifact_write_literal(")");
        return;
    }

    let field_dot: usize = find_last_top_level_dot(
        source, start, end,
    );
    if field_dot < end {
        let base_end: usize = trim_right(
            source, start, field_dot,
        );
        let field_start: usize = trim_left(
            source, end, field_dot + 1,
        );
        let field_end: usize = scan_ident_end(
            source, end, field_start,
        );
        let packed_type: usize = find_variable_type(
            source, start, start, base_end,
        );
        let field_type_source: addr = source;
        if packed_type == 0 {
            let base_field_dot: usize = find_last_top_level_dot(
                source, start, base_end,
            );
            if base_field_dot < base_end {
                let root_end: usize = trim_right(
                    source, start, base_field_dot,
                );
                let root_type: usize = find_variable_type(
                    source, start, start, root_end,
                );
                if root_type != 0 {
                    let root_type_start: usize =
                        root_type / 1000000;
                    let root_type_end: usize =
                        root_type - root_type_start * 1000000;
                    let base_field_start: usize = trim_left(
                        source, base_end, base_field_dot + 1,
                    );
                    let base_field_end: usize = scan_ident_end(
                        source, base_end, base_field_start,
                    );
                    let type_entry: addr =
                        cached_struct_field_type_entry_cross(
                            cache,
                            source,
                            root_type_start,
                            root_type_end,
                            source,
                            base_field_start,
                            base_field_end,
                        );
                    if type_entry != (0 as addr) {
                        field_type_source = (
                            std::load_i64(
                                std::offset(type_entry, 16),
                            )
                            as addr
                        );
                        let nested_type_start: usize =
                            std::load_i64(
                                std::offset(type_entry, 24),
                            );
                        let nested_type_end: usize =
                            std::load_i64(
                                std::offset(type_entry, 32),
                            );
                        packed_type =
                            nested_type_start * 1000000 +
                            nested_type_end;
                    }
                }
            }
        }
        if packed_type != 0 {
            let type_start: usize = packed_type / 1000000;
            let type_end: usize =
                packed_type - type_start * 1000000;
            let field: usize = 0;
            if is_compile_time_type(source, type_start, type_end) == 0 {
                field = cached_struct_field_cross(
                    cache,
                    field_type_source,
                    type_start,
                    type_end,
                    source,
                    field_start,
                    field_end,
                );
            }
            if field != 0 {
                let kind: usize = field / 1000000;
                let encoded_offset: usize =
                    field - kind * 1000000;
                let offset: usize = encoded_offset - 1;
                if kind == 1 {
                    bootstrap_artifact_write_literal(
                        "#load[#bits<32>](",
                    );
                } else {
                    if kind == 2 {
                        bootstrap_artifact_write_literal(
                            "#load[#bits<1>](",
                        );
                    } else {
                        if kind == 3 {
                            bootstrap_artifact_write_literal(
                                "#load[#bits<64>](",
                            );
                        } else {
                            bootstrap_artifact_write_literal(
                                "#load[#addr](",
                            );
                        }
                    }
                }
                bootstrap_artifact_write_literal("#lea(base=");
                emit_expression(cache, source, start, base_end);
                bootstrap_artifact_write_literal(
                    ", idx=0, scale=0, offset=",
                );
                emit_usize(offset);
                bootstrap_artifact_write_literal("))");
                return;
            }
        }
    }

    if byte_at(source, start) == 34 {
        emit_span(source, start, end);
        return;
    }
    if span_equals(source, start, end, "true", 4) {
        bootstrap_artifact_write_literal("1");
        return;
    }
    if span_equals(source, start, end, "false", 5) {
        bootstrap_artifact_write_literal("0");
        return;
    }
    if byte_at(source, start) >= 48 {
        if byte_at(source, start) <= 57 {
            emit_span(source, start, end);
            return;
        }
    }
    bootstrap_artifact_write_byte(37);
    emit_name(source, start, end);
    return;
};

let scan_statement_end = std::func(
    source: addr,
    end: usize,
    start: usize,
) -> usize {
    let cursor: usize = start;
    let depth: i32 = 0;
    let quoted: bool = 0;
    while cursor < end {
        let byte: i32 = byte_at(source, cursor);
        if quoted {
            if byte == 92 {
                cursor = cursor + 1;
            } else {
                if byte == 34 { quoted = 0; }
            }
        } else {
            if byte == 34 {
                quoted = 1;
            } else {
                if byte == 40 { depth = depth + 1; }
                if byte == 123 { depth = depth + 1; }
                if byte == 91 { depth = depth + 1; }
                if byte == 41 { depth = depth - 1; }
                if byte == 125 { depth = depth - 1; }
                if byte == 93 { depth = depth - 1; }
                if depth == 0 {
                    if byte == 59 { return cursor; }
                }
            }
        }
        cursor = cursor + 1;
    }
    return end;
};

let is_struct_literal = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> bool {
    let open: usize = find_top_level(source, start, end, 123);
    if open == end { return 0; }
    let close: usize = matching_close(source, end, open, 123, 125);
    let tail: usize = trim_right(source, close + 1, end);
    if tail > close + 1 {
        if byte_at(source, tail - 1) == 44 {
            tail = trim_right(source, close + 1, tail - 1);
        }
    }
    return tail == close + 1;
};

let emit_struct_literal = std::func(
    cache: addr,
    source: addr,
    source_end: usize,
    start: usize,
    end: usize,
    target_start: usize,
    target_end: usize,
) -> unit {
    let open: usize = find_top_level(source, start, end, 123);
    let close: usize = matching_close(source, end, open, 123, 125);
    let type_start: usize = trim_left(source, open, start);
    let type_end: usize = trim_right(source, type_start, open);
    let cursor: usize = skip_space(source, close, open + 1);
    let field_count: usize = 0;
    while cursor < close {
        let comma: usize = find_top_level(source, cursor, close, 44);
        let field_start: usize = trim_left(source, comma, cursor);
        if field_start < comma {
            field_count = field_count + 1;
        }
        if comma == close {
            cursor = close;
        } else {
            cursor = skip_space(source, close, comma + 1);
        }
    }

    cursor = skip_space(source, close, open + 1);
    while cursor < close {
        let comma: usize = find_top_level(source, cursor, close, 44);
        let field_start: usize = trim_left(source, comma, cursor);
        if field_start < comma {
            let field_end: usize = scan_ident_end(
                source, comma, field_start,
            );
            let colon: usize = find_top_level(
                source, field_end, comma, 58,
            );
            let value_start: usize = trim_left(
                source, comma, colon + 1,
            );
            if is_struct_literal(source, value_start, comma) {
                emit_struct_literal(
                    cache,
                    source,
                    source_end,
                    value_start,
                    comma,
                    value_start,
                    value_start,
                );
            }
        }
        if comma == close {
            cursor = close;
        } else {
            cursor = skip_space(source, close, comma + 1);
        }
    }

    bootstrap_artifact_write_literal("  #let %");
    if target_start < target_end {
        emit_name(source, target_start, target_end);
    } else {
        if target_start == 0 {
            bootstrap_artifact_write_literal("__return_value");
        } else {
            emit_temporary_name(target_start);
        }
    }
    bootstrap_artifact_write_literal(": #addr = #alloca(");
    emit_usize(field_count * 8);
    bootstrap_artifact_write_literal(")\n");

    cursor = skip_space(source, close, open + 1);
    let sequential_offset: usize = 0;
    while cursor < close {
        let comma: usize = find_top_level(source, cursor, close, 44);
        let field_start: usize = trim_left(source, comma, cursor);
        if field_start < comma {
            let field_end: usize = scan_ident_end(
                source, comma, field_start,
            );
            let colon: usize = find_top_level(
                source, field_end, comma, 58,
            );
            let descriptor: usize = cached_struct_field(
                cache,
                source,
                source_end,
                type_start,
                type_end,
                field_start,
                field_end,
            );
            let field_offset: usize = sequential_offset;
            if descriptor != 0 {
                let kind: usize = descriptor / 1000000;
                let encoded_offset: usize =
                    descriptor - kind * 1000000;
                field_offset = encoded_offset - 1;
            }
            bootstrap_artifact_write_literal("  #store[");
            emit_type_in(cache, source, colon + 1, comma);
            bootstrap_artifact_write_literal("] ");
            emit_expression(cache, source, colon + 1, comma);
            bootstrap_artifact_write_literal(", #lea(base=%");
            if target_start < target_end {
                emit_name(source, target_start, target_end);
            } else {
                if target_start == 0 {
                    bootstrap_artifact_write_literal("__return_value");
                } else {
                    emit_temporary_name(target_start);
                }
            }
            bootstrap_artifact_write_literal(
                ", idx=0, scale=0, offset=",
            );
            emit_usize(field_offset);
            bootstrap_artifact_write_literal(")\n");
            sequential_offset = sequential_offset + 8;
        }
        if comma == close {
            cursor = close;
        } else {
            cursor = skip_space(source, close, comma + 1);
        }
    }
    return;
};

let prepare_expression_structs = std::func(
    cache: addr,
    source: addr,
    source_end: usize,
    initial_start: usize,
    initial_end: usize,
) -> unit {
    let start: usize = trim_left(source, initial_end, initial_start);
    let end: usize = trim_right(source, start, initial_end);
    if is_struct_literal(source, start, end) {
        emit_struct_literal(
            cache,
            source,
            source_end,
            start,
            end,
            start,
            start,
        );
        return;
    }
    let open: usize = find_top_level(source, start, end, 40);
    if open < end {
        let close: usize = matching_close(source, end, open, 40, 41);
        if close + 1 == end {
            let cursor: usize = skip_space(source, close, open + 1);
            while cursor < close {
                let comma: usize = find_top_level(
                    source, cursor, close, 44,
                );
                let argument_start: usize = trim_left(
                    source, comma, cursor,
                );
                if argument_start < comma {
                    prepare_expression_structs(
                        cache,
                        source,
                        source_end,
                        argument_start,
                        comma,
                    );
                }
                if comma == close {
                    cursor = close;
                } else {
                    cursor = skip_space(source, close, comma + 1);
                }
            }
        }
    }
    return;
};

let scan_if_chain_end = std::func(
    source: addr,
    end: usize,
    if_start: usize,
) -> usize {
    let if_end: usize = scan_ident_end(source, end, if_start);
    let body_open: usize = find_top_level(
        source, if_end, end, 123,
    );
    if body_open == end { return end; }
    let body_close: usize = matching_close(
        source, end, body_open, 123, 125,
    );
    let next: usize = skip_space(source, end, body_close + 1);
    let next_end: usize = scan_ident_end(source, end, next);
    if span_is(source, next, next_end, 5) {
        let else_start: usize = skip_space(source, end, next_end);
        let else_word_end: usize = scan_ident_end(
            source, end, else_start,
        );
        if span_is(source, else_start, else_word_end, 3) {
            return scan_if_chain_end(source, end, else_start);
        }
        if else_start < end {
            if byte_at(source, else_start) == 123 {
                return matching_close(
                    source, end, else_start, 123, 125,
                ) + 1;
            }
        }
    }
    return body_close + 1;
};

let compile_block = std::func(
    cache: addr,
    source: addr,
    length: usize,
    block_start: usize,
    block_end: usize,
) -> unit {
    let cursor: usize = skip_space(source, block_end, block_start);
    while cursor < block_end {
        let word_end: usize = scan_ident_end(source, block_end, cursor);
        if span_is(source, cursor, word_end, 2) {
            let semi: usize = scan_statement_end(source, block_end, word_end);
            let value_start: usize = trim_left(source, semi, word_end);
            if value_start < semi {
                if is_struct_literal(source, value_start, semi) {
                    emit_struct_literal(
                        cache,
                        source,
                        length,
                        value_start,
                        semi,
                        0,
                        0,
                    );
                    bootstrap_artifact_write_literal(
                        "  #return %__return_value\n",
                    );
                } else {
                    prepare_expression_structs(
                        cache,
                        source,
                        length,
                        value_start,
                        semi,
                    );
                    bootstrap_artifact_write_literal("  #return ");
                    emit_expression(cache, source, value_start, semi);
                    bootstrap_artifact_write_literal("\n");
                }
            } else {
                bootstrap_artifact_write_literal("  #return\n");
            }
            cursor = skip_space(source, block_end, semi + 1);
        } else {
            if span_is(source, cursor, word_end, 1) {
                let semi: usize = scan_statement_end(
                    source,
                    block_end,
                    word_end,
                );
                let name_start: usize = skip_space(
                    source,
                    semi,
                    word_end,
                );
                let name_end: usize = scan_ident_end(
                    source,
                    semi,
                    name_start,
                );
                let colon: usize = find_top_level(
                    source,
                    name_end,
                    semi,
                    58,
                );
                let equal: usize = find_top_level(
                    source,
                    name_end,
                    semi,
                    61,
                );
                if is_struct_literal(source, equal + 1, semi) {
                    emit_struct_literal(
                        cache,
                        source,
                        length,
                        equal + 1,
                        semi,
                        name_start,
                        name_end,
                    );
                } else {
                    prepare_expression_structs(
                        cache,
                        source,
                        length,
                        equal + 1,
                        semi,
                    );
                    bootstrap_artifact_write_literal("  #let %");
                    emit_name(source, name_start, name_end);
                    bootstrap_artifact_write_literal(": ");
                    emit_type_in(cache, source, colon + 1, equal);
                    bootstrap_artifact_write_literal(" = ");
                    emit_expression(cache, source, equal + 1, semi);
                    bootstrap_artifact_write_literal("\n");
                }
                cursor = skip_space(source, block_end, semi + 1);
            } else {
                if span_is(source, cursor, word_end, 3) {
                    let open: usize = find_top_level(
                        source,
                        word_end,
                        block_end,
                        123,
                    );
                    let close: usize = matching_close(
                        source,
                        block_end,
                        open,
                        123,
                        125,
                    );
                    bootstrap_artifact_write_literal("  #if ");
                    emit_expression(cache, source, word_end, open);
                    bootstrap_artifact_write_literal(" {\n");
                    compile_block(
                        cache, source, length, open + 1, close,
                    );
                    bootstrap_artifact_write_literal("  }");
                    let next: usize = skip_space(
                        source,
                        block_end,
                        close + 1,
                    );
                    let next_end: usize = scan_ident_end(
                        source,
                        block_end,
                        next,
                    );
                    if span_is(source, next, next_end, 5) {
                        let else_start: usize = skip_space(
                            source,
                            block_end,
                            next_end,
                        );
                        let else_word_end: usize = scan_ident_end(
                            source, block_end, else_start,
                        );
                        if span_is(
                            source, else_start, else_word_end, 3,
                        ) {
                            let else_end: usize = scan_if_chain_end(
                                source, block_end, else_start,
                            );
                            bootstrap_artifact_write_literal(
                                " #else {\n",
                            );
                            compile_block(
                                cache,
                                source,
                                length,
                                else_start,
                                else_end,
                            );
                            bootstrap_artifact_write_literal("  }\n");
                            cursor = skip_space(
                                source, block_end, else_end,
                            );
                        } else {
                            let else_close: usize = matching_close(
                                source,
                                block_end,
                                else_start,
                                123,
                                125,
                            );
                            bootstrap_artifact_write_literal(
                                " #else {\n",
                            );
                            compile_block(
                                cache,
                                source,
                                length,
                                else_start + 1,
                                else_close,
                            );
                            bootstrap_artifact_write_literal("  }\n");
                            cursor = skip_space(
                                source,
                                block_end,
                                else_close + 1,
                            );
                        }
                    } else {
                        bootstrap_artifact_write_literal("\n");
                        cursor = next;
                    }
                } else {
                    if span_is(source, cursor, word_end, 4) {
                        let open: usize = find_top_level(
                            source,
                            word_end,
                            block_end,
                            123,
                        );
                        let close: usize = matching_close(
                            source,
                            block_end,
                            open,
                            123,
                            125,
                        );
                        bootstrap_artifact_write_literal("  #loop {\n");
                        bootstrap_artifact_write_literal("  #if #eq(");
                        emit_expression(cache, source, word_end, open);
                        bootstrap_artifact_write_literal(
                            ", 0) {\n  #break\n  }\n"
                        );
                        compile_block(
                            cache, source, length, open + 1, close,
                        );
                        bootstrap_artifact_write_literal(
                            "  #continue\n  }\n"
                        );
                        cursor = skip_space(
                            source,
                            block_end,
                            close + 1,
                        );
                    } else {
                        let semi: usize = scan_statement_end(
                            source,
                            block_end,
                            cursor,
                        );
                        if span_equals(
                            source, cursor, word_end, "break", 5,
                        ) {
                            bootstrap_artifact_write_literal("  #break\n");
                        } else {
                            if span_equals(
                                source,
                                cursor,
                                word_end,
                                "continue",
                                8,
                            ) {
                                bootstrap_artifact_write_literal(
                                    "  #continue\n",
                                );
                            } else {
                                let equal: usize = find_top_level(
                                    source,
                                    cursor,
                                    semi,
                                    61,
                                );
                                if equal < semi {
                                    prepare_expression_structs(
                                        cache,
                                        source,
                                        length,
                                        equal + 1,
                                        semi,
                                    );
                                    let target_end: usize = trim_right(
                                        source, cursor, equal,
                                    );
                                    if byte_at(source, cursor) == 42 {
                                        bootstrap_artifact_write_literal(
                                            "  #store[#bits<64>] ",
                                        );
                                        emit_expression(
                                            cache,
                                            source,
                                            equal + 1,
                                            semi,
                                        );
                                        bootstrap_artifact_write_literal(
                                            ", ",
                                        );
                                        emit_expression(
                                            cache,
                                            source,
                                            cursor + 1,
                                            target_end,
                                        );
                                        bootstrap_artifact_write_literal(
                                            "\n",
                                        );
                                    } else {
                                    let field_dot: usize =
                                        find_last_top_level_dot(
                                            source, cursor, target_end,
                                        );
                                    if field_dot < target_end {
                                        let base_end: usize = trim_right(
                                            source, cursor, field_dot,
                                        );
                                        let field_start: usize = trim_left(
                                            source,
                                            target_end,
                                            field_dot + 1,
                                        );
                                        let field_end: usize =
                                            scan_ident_end(
                                                source,
                                                target_end,
                                                field_start,
                                            );
                                        let descriptor: usize = 0;
                                        let packed_type: usize =
                                            find_variable_type(
                                                source,
                                                cursor,
                                                cursor,
                                                base_end,
                                            );
                                        if packed_type != 0 {
                                            let type_start: usize =
                                                packed_type / 1000000;
                                            let type_end: usize =
                                                packed_type -
                                                type_start * 1000000;
                                            descriptor =
                                                cached_struct_field(
                                                    cache,
                                                    source,
                                                    cursor,
                                                    type_start,
                                                    type_end,
                                                    field_start,
                                                    field_end,
                                                );
                                        }
                                        if descriptor == 0 {
                                            descriptor =
                                                cached_unambiguous_field(
                                                    cache,
                                                    source,
                                                    field_start,
                                                    field_end,
                                                );
                                        }
                                        if descriptor != 0 {
                                            let kind: usize =
                                                descriptor / 1000000;
                                            let encoded_offset: usize =
                                                descriptor -
                                                kind * 1000000;
                                            bootstrap_artifact_write_literal(
                                                "  ",
                                            );
                                            emit_typed_store_prefix(kind);
                                            emit_expression(
                                                cache,
                                                source,
                                                equal + 1,
                                                semi,
                                            );
                                            bootstrap_artifact_write_literal(
                                                ", #lea(base=",
                                            );
                                            emit_expression(
                                                cache,
                                                source,
                                                cursor,
                                                base_end,
                                            );
                                            bootstrap_artifact_write_literal(
                                                ", idx=0, scale=0, offset=",
                                            );
                                            emit_usize(encoded_offset - 1);
                                            bootstrap_artifact_write_literal(
                                                ")\n",
                                            );
                                        } else {
                                            bootstrap_artifact_write_literal(
                                                "  %",
                                            );
                                            emit_name(
                                                source,
                                                cursor,
                                                target_end,
                                            );
                                            bootstrap_artifact_write_literal(
                                                " = ",
                                            );
                                            emit_expression(
                                                cache,
                                                source,
                                                equal + 1,
                                                semi,
                                            );
                                            bootstrap_artifact_write_literal(
                                                "\n",
                                            );
                                        }
                                    } else {
                                        bootstrap_artifact_write_literal(
                                            "  %",
                                        );
                                        emit_name(
                                            source,
                                            cursor,
                                            target_end,
                                        );
                                        bootstrap_artifact_write_literal(
                                            " = ",
                                        );
                                        emit_expression(
                                            cache,
                                            source,
                                            equal + 1,
                                            semi,
                                        );
                                        bootstrap_artifact_write_literal(
                                            "\n",
                                        );
                                    }
                                    }
                                } else {
                                    prepare_expression_structs(
                                        cache,
                                        source,
                                        length,
                                        cursor,
                                        semi,
                                    );
                                    bootstrap_artifact_write_literal("  ");
                                    emit_expression(
                                        cache, source, cursor, semi,
                                    );
                                    bootstrap_artifact_write_literal("\n");
                                }
                            }
                        }
                        cursor = skip_space(
                            source,
                            block_end,
                            semi + 1,
                        );
                    }
                }
            }
        }
    }
    return;
};

let emit_parameters = std::func(
    cache: addr,
    source: addr,
    start: usize,
    end: usize,
) -> unit {
    let cursor: usize = skip_space(source, end, start);
    let first: bool = 1;
    while cursor < end {
        let comma: usize = find_top_level(source, cursor, end, 44);
        let name_start: usize = trim_left(source, comma, cursor);
        let name_end: usize = scan_ident_end(source, comma, name_start);
        let colon: usize = find_top_level(
            source,
            name_end,
            comma,
            58,
        );
        if first == 0 {
            bootstrap_artifact_write_literal(", ");
        }
        emit_type_in(cache, source, colon + 1, comma);
        bootstrap_artifact_write_literal(" %");
        emit_name(source, name_start, name_end);
        first = 0;
        if comma == end {
            cursor = end;
        } else {
            cursor = skip_space(source, end, comma + 1);
        }
    }
    return;
};

let first_parameter_is_type = std::func(
    source: addr,
    start: usize,
    end: usize,
) -> bool {
    let parameter_start: usize = skip_space(source, end, start);
    if parameter_start >= end { return 0; }
    let comma: usize = find_top_level(
        source, parameter_start, end, 44,
    );
    let name_end: usize = scan_ident_end(
        source, comma, parameter_start,
    );
    let colon: usize = find_top_level(
        source, name_end, comma, 58,
    );
    if colon == comma { return 0; }
    return span_equals(
        source,
        trim_left(source, comma, colon + 1),
        trim_right(source, colon + 1, comma),
        "type",
        4,
    );
};

let emit_specialized_type = std::func(
    cache: addr,
    source: addr,
    initial_start: usize,
    initial_end: usize,
    type_parameter_start: usize,
    type_parameter_end: usize,
    specialization_kind: i32,
) -> unit {
    let start: usize = trim_left(source, initial_end, initial_start);
    let end: usize = trim_right(source, start, initial_end);
    if spans_equal(
        source,
        start,
        end,
        type_parameter_start,
        type_parameter_end,
    ) {
        if specialization_kind == 1 {
            bootstrap_artifact_write_literal("#bits<32>");
            return;
        }
        if specialization_kind == 2 {
            bootstrap_artifact_write_literal("#bits<1>");
            return;
        }
        if specialization_kind == 3 {
            bootstrap_artifact_write_literal("#bits<64>");
            return;
        }
        if specialization_kind == 4 {
            bootstrap_artifact_write_literal("#addr");
            return;
        }
    }
    emit_type_in(cache, source, start, end);
    return;
};

let emit_specialized_parameters = std::func(
    cache: addr,
    source: addr,
    start: usize,
    end: usize,
    specialization_kind: i32,
) -> unit {
    let first_parameter_start: usize = skip_space(source, end, start);
    let first_comma: usize = find_top_level(
        source, first_parameter_start, end, 44,
    );
    let type_parameter_start: usize = first_parameter_start;
    let type_parameter_end: usize = scan_ident_end(
        source, first_comma, type_parameter_start,
    );
    let cursor: usize = end;
    if first_comma < end {
        cursor = skip_space(source, end, first_comma + 1);
    }
    let first: bool = 1;
    while cursor < end {
        let comma: usize = find_top_level(source, cursor, end, 44);
        let name_start: usize = trim_left(source, comma, cursor);
        let name_end: usize = scan_ident_end(source, comma, name_start);
        let colon: usize = find_top_level(
            source,
            name_end,
            comma,
            58,
        );
        if first == 0 {
            bootstrap_artifact_write_literal(", ");
        }
        emit_specialized_type(
            cache,
            source,
            colon + 1,
            comma,
            type_parameter_start,
            type_parameter_end,
            specialization_kind,
        );
        bootstrap_artifact_write_literal(" %");
        emit_name(source, name_start, name_end);
        first = 0;
        if comma == end {
            cursor = end;
        } else {
            cursor = skip_space(source, end, comma + 1);
        }
    }
    return;
};

let span_contains_token = std::func(
    source: addr,
    start: usize,
    end: usize,
    token_start: usize,
    token_end: usize,
) -> bool {
    let cursor: usize = start;
    while cursor < end {
        if is_ident_byte(byte_at(source, cursor)) {
            let candidate_end: usize = scan_ident_end(
                source, end, cursor,
            );
            if spans_equal(
                source,
                cursor,
                candidate_end,
                token_start,
                token_end,
            ) {
                return 1;
            }
            cursor = candidate_end;
        } else {
            cursor = cursor + 1;
        }
    }
    return 0;
};

// Return the first declared effect name as start * 1000000 + end.
// Zero means that the named function exists without an effect requirement,
// or that the span does not name a function.
let find_function_effect = std::func(
    source: addr,
    source_end: usize,
    wanted_start: usize,
    wanted_end: usize,
) -> usize {
    let cursor: usize = 0;
    let matches: usize = 0;
    let found: usize = 0;
    while cursor < source_end {
        if byte_at(source, cursor) == 108 {
            let word_end: usize = scan_ident_end(
                source, source_end, cursor,
            );
            if span_is(source, cursor, word_end, 1) {
                let name_start: usize = skip_space(
                    source, source_end, word_end,
                );
                let name_end: usize = scan_ident_end(
                    source, source_end, name_start,
                );
                if spans_equal(
                    source,
                    name_start,
                    name_end,
                    wanted_start,
                    wanted_end,
                ) {
                    matches = matches + 1;
                    let equal: usize = find_top_level(
                        source, name_end, source_end, 61,
                    );
                    let rhs_start: usize = skip_space(
                        source, source_end, equal + 1,
                    );
                    let params_open: usize = find_top_level(
                        source, rhs_start, source_end, 40,
                    );
                    if params_open < source_end {
                        let params_close: usize = matching_close(
                            source,
                            source_end,
                            params_open,
                            40,
                            41,
                        );
                        let body_open: usize = find_top_level(
                            source,
                            params_close + 1,
                            source_end,
                            123,
                        );
                        let bang: usize = find_top_level(
                            source,
                            params_close + 1,
                            body_open,
                            33,
                        );
                        if bang < body_open {
                            let effect_open: usize = find_top_level(
                                source,
                                bang + 1,
                                body_open,
                                123,
                            );
                            let effect_close: usize = matching_close(
                                source,
                                source_end,
                                effect_open,
                                123,
                                125,
                            );
                            let effect_start: usize = skip_space(
                                source,
                                effect_close,
                                effect_open + 1,
                            );
                            let effect_end: usize = scan_ident_end(
                                source,
                                effect_close,
                                effect_start,
                            );
                            if effect_end > effect_start {
                                let effect_tail: usize = skip_space(
                                    source,
                                    effect_close,
                                    effect_end,
                                );
                                if effect_tail == effect_close {
                                    if span_equals(
                                        source,
                                        effect_start,
                                        effect_end,
                                        "Effect",
                                        6,
                                    ) == 0 {
                                        found =
                                            effect_start * 1000000 +
                                            effect_end;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            cursor = word_end;
        } else {
            cursor = cursor + 1;
        }
    }
    if matches == 1 {
        return found;
    }
    return 0;
};

let cached_function_effect = std::func(
    cache: addr,
    source: addr,
    source_end: usize,
    wanted_start: usize,
    wanted_end: usize,
) -> usize {
    let key: usize = span_key(source, wanted_start, wanted_end);
    let count_addr: addr = std::offset(cache, 98312);
    let entries: addr = std::offset(cache, 98320);
    let count: usize = std::load_i64(count_addr);
    let index: usize = 0;
    while index < count {
        let entry: addr = std::offset(entries, index * 16);
        if std::load_i64(entry) == key {
            return std::load_i64(std::offset(entry, 8));
        }
        index = index + 1;
    }
    let found: usize = find_function_effect(
        source,
        source_end,
        wanted_start,
        wanted_end,
    );
    if count < 1024 {
        let entry: addr = std::offset(entries, count * 16);
        std::store_i64(entry, key);
        std::store_i64(std::offset(entry, 8), found);
        std::store_i64(count_addr, count + 1);
    }
    return found;
};

let validate_effect_calls = std::func(
    cache: addr,
    source: addr,
    source_end: usize,
    body_start: usize,
    body_end: usize,
    available_start: usize,
    available_end: usize,
) -> i32 {
    if std::load_i64(std::offset(cache, 114704)) == 0 {
        return 0;
    }
    let cursor: usize = body_start;
    while cursor < body_end {
        if is_ident_byte(byte_at(source, cursor)) {
            let name_end: usize = scan_ident_end(
                source, body_end, cursor,
            );
            let next: usize = skip_space(source, body_end, name_end);
            if next < body_end {
                if byte_at(source, next) == 40 {
                    let required: usize = cached_function_effect(
                        cache,
                        source,
                        source_end,
                        cursor,
                        name_end,
                    );
                    if required != 0 {
                        let required_start: usize = required / 1000000;
                        let required_end: usize =
                            required - required_start * 1000000;
                        if span_contains_token(
                            source,
                            available_start,
                            available_end,
                            required_start,
                            required_end,
                        ) == 0 {
                            return 3103;
                        }
                    }
                }
            }
            cursor = name_end;
        } else {
            cursor = cursor + 1;
        }
    }
    return 0;
};

let source_declares_effect = std::func(
    source: addr,
    end: usize,
) -> bool {
    let cursor: usize = 0;
    while cursor < end {
        if byte_at(source, cursor) == 33 {
            let next: usize = skip_space(source, end, cursor + 1);
            if next < end {
                if byte_at(source, next) == 123 {
                    let close: usize = matching_close(
                        source, end, next, 123, 125,
                    );
                    let effect_start: usize = skip_space(
                        source, close, next + 1,
                    );
                    let effect_end: usize = scan_ident_end(
                        source, close, effect_start,
                    );
                    let tail: usize = skip_space(
                        source, close, effect_end,
                    );
                    if tail == close {
                        if span_equals(
                            source,
                            effect_start,
                            effect_end,
                            "Effect",
                            6,
                        ) == 0 {
                            return 1;
                        }
                    }
                    cursor = close;
                }
            }
        }
        cursor = cursor + 1;
    }
    return 0;
};

let compile_source = std::func(
    cache: addr,
    source: addr,
    initial_start: usize,
    end: usize,
) -> i32 {
    let cursor: usize = skip_space(source, end, initial_start);
    while cursor < end {
        if cursor >= end { return 0; }
        let foreign: bool = 0;
        let exported: bool = 0;
        if cursor < end {
            if byte_at(source, cursor) == 64 {
                let annotation_start: usize = cursor + 1;
                let annotation_end: usize = scan_ident_end(
                    source,
                    end,
                    annotation_start,
                );
                if span_equals(
                    source,
                    annotation_start,
                    annotation_end,
                    "foreign",
                    7,
                ) {
                    foreign = 1;
                }
                if span_equals(
                    source,
                    annotation_start,
                    annotation_end,
                    "export",
                    6,
                ) {
                    exported = 1;
                }
                cursor = skip_space(source, end, annotation_end);
                if cursor < end {
                    if byte_at(source, cursor) == 40 {
                        let annotation_close: usize = matching_close(
                            source, end, cursor, 40, 41,
                        );
                        cursor = skip_space(
                            source, end, annotation_close + 1,
                        );
                    }
                }
            }
        }

        let let_end: usize = scan_ident_end(source, end, cursor);
        if span_is(source, cursor, let_end, 2) {
            // A return in a compile-time constructor ends its expansion body;
            // it does not become a top-level physical procedure.
            let returned_start: usize = skip_space(
                source, end, let_end,
            );
            let returned_word_end: usize = scan_ident_end(
                source, end, returned_start,
            );
            if span_equals(
                source,
                returned_start,
                returned_word_end,
                "std",
                3,
            ) {
                let first_colon: usize = skip_space(
                    source, end, returned_word_end,
                );
                let second_colon: usize = skip_space(
                    source, end, first_colon + 1,
                );
                let returned_form_start: usize = skip_space(
                    source, end, second_colon + 1,
                );
                let returned_form_end: usize = scan_ident_end(
                    source, end, returned_form_start,
                );
                if span_equals(
                    source,
                    returned_form_start,
                    returned_form_end,
                    "module",
                    6,
                ) {
                    let returned_body_open: usize = find_top_level(
                        source, returned_form_end, end, 123,
                    );
                    if returned_body_open < end {
                        let returned_body_close: usize =
                            matching_close(
                                source,
                                end,
                                returned_body_open,
                                123,
                                125,
                            );
                        return compile_source(
                            cache,
                            source,
                            returned_body_open + 1,
                            returned_body_close,
                        );
                    }
                }
            }
            return 0;
        }
        if span_is(source, cursor, let_end, 1) == 0 {
            return 1000 + cursor;
        }
        let name_start: usize = skip_space(source, end, let_end);
        let name_end: usize = scan_ident_end(
            source,
            end,
            name_start,
        );
        let equal: usize = find_top_level(
            source,
            name_end,
            end,
            61,
        );
        if equal == end {
            return 11;
        }
        let rhs_start: usize = skip_space(source, end, equal + 1);
        let first_word_end: usize = scan_ident_end(
            source, end, rhs_start,
        );

        if span_equals(
            source,
            rhs_start,
            first_word_end,
            "import",
            6,
        ) {
            let args_open: usize = find_top_level(
                source, first_word_end, end, 40,
            );
            if args_open == end { return 5007; }
            let args_close: usize = matching_close(
                source, end, args_open, 40, 41,
            );
            let path_quote: usize = skip_space(
                source, args_close, args_open + 1,
            );
            if path_quote >= args_close { return 5007; }
            if byte_at(source, path_quote) != 34 { return 5007; }
            let path_end: usize = path_quote + 1;
            let resolved_path_end: usize = path_quote + 1;
            let import_resolved: bool = 0;
            while path_end < args_close {
                if byte_at(source, path_end) == 34 {
                    if resolve_import(
                        source,
                        path_quote + 1,
                        path_end,
                    ) == 0 {
                        return 5007;
                    }
                    import_resolved = 1;
                    resolved_path_end = path_end;
                    path_end = args_close;
                } else {
                    path_end = path_end + 1;
                }
            }
            if import_resolved == 0 { return 5007; }
            let semi: usize = scan_statement_end(
                source, end, first_word_end,
            );
            if register_compile_time_binding(
                cache,
                source,
                name_start,
                name_end,
                1,
                path_quote + 1,
                resolved_path_end,
            ) == 0 {
                return 5008;
            }
            cursor = skip_space(source, end, semi + 1);
        } else {
            let form_start: usize = rhs_start;
            let form_end: usize = first_word_end;
            if span_equals(
                source,
                rhs_start,
                first_word_end,
                "std",
                3,
            ) {
                let first_colon: usize = skip_space(
                    source, end, first_word_end,
                );
                let second_colon: usize = skip_space(
                    source, end, first_colon + 1,
                );
                form_start = skip_space(
                    source, end, second_colon + 1,
                );
                form_end = scan_ident_end(source, end, form_start);
            }

            if span_equals(
                source,
                form_start,
                form_end,
                "module",
                6,
            ) {
                let body_open: usize = find_top_level(
                    source, form_end, end, 123,
                );
                if body_open == end {
                    return 12;
                }
                let body_close: usize = matching_close(
                    source, end, body_open, 123, 125,
                );
                if register_compile_time_binding(
                    cache,
                    source,
                    name_start,
                    name_end,
                    1,
                    body_open + 1,
                    body_close,
                ) == 0 {
                    return 5008;
                }
                // Module bodies define a namespace. Analyze their bindings
                // now so unsupported members cannot hide behind the outer
                // std::module form. Compile-time constructors remain deferred
                // until specialization, but direct runtime members are
                // emitted and checked.
                let previous_namespace_start: usize = std::load_i64(
                    std::offset(cache, 127008),
                );
                let previous_namespace_end: usize = std::load_i64(
                    std::offset(cache, 127016),
                );
                let previous_namespace_source: usize = std::load_i64(
                    std::offset(cache, 147512),
                );
                let associated_namespace: bool = span_equals(
                    source,
                    name_start,
                    name_end,
                    "Namespace",
                    9,
                );
                if associated_namespace == 0 {
                    std::store_i64(
                        std::offset(cache, 127008), name_start,
                    );
                    std::store_i64(
                        std::offset(cache, 127016), name_end,
                    );
                    std::store_i64(
                        std::offset(cache, 147512), source,
                    );
                }
                let module_status: i32 = compile_source(
                    cache,
                    source,
                    body_open + 1,
                    body_close,
                );
                std::store_i64(
                    std::offset(cache, 127008),
                    previous_namespace_start,
                );
                std::store_i64(
                    std::offset(cache, 127016),
                    previous_namespace_end,
                );
                std::store_i64(
                    std::offset(cache, 147512),
                    previous_namespace_source,
                );
                if module_status != 0 {
                    return module_status;
                }
                let semi: usize = skip_space(
                    source, end, body_close + 1,
                );
                cursor = skip_space(source, end, semi + 1);
            } else {
                if span_equals(
                    source,
                    form_start,
                    form_end,
                    "func",
                    4,
                ) {
                    let params_open: usize = find_top_level(
                        source, form_end, end, 40,
                    );
                    let params_close: usize = matching_close(
                        source, end, params_open, 40, 41,
                    );
                    let arrow: usize = skip_space(
                        source, end, params_close + 1,
                    );
                    let type_start: usize = skip_space(
                        source, end, arrow + 2,
                    );
                    let body_open: usize = end;
                    let signature_end: usize = end;
                    let available_effect_start: usize = end;
                    let available_effect_end: usize = end;
                    if foreign {
                        signature_end = scan_statement_end(
                            source, end, type_start,
                        );
                    } else {
                        body_open = find_top_level(
                            source, type_start, end, 123,
                        );
                        let bang: usize = find_top_level(
                            source, type_start, body_open, 33,
                        );
                        if bang < body_open {
                            available_effect_start = body_open + 1;
                            let effect_close: usize = matching_close(
                                source, end, body_open, 123, 125,
                            );
                            available_effect_end = effect_close;
                            signature_end = bang;
                            body_open = find_top_level(
                                source, effect_close + 1, end, 123,
                            );
                        } else {
                            signature_end = body_open;
                        }
                    }
                    let type_end: usize = trim_right(
                        source, type_start, signature_end,
                    );
                    let specialized: bool = first_parameter_is_type(
                        source, params_open + 1, params_close,
                    );
                    let type_parameter_start: usize = skip_space(
                        source, params_close, params_open + 1,
                    );
                    let first_parameter_comma: usize = find_top_level(
                        source,
                        type_parameter_start,
                        params_close,
                        44,
                    );
                    let type_parameter_end: usize = scan_ident_end(
                        source,
                        first_parameter_comma,
                        type_parameter_start,
                    );

                    if is_compile_time_type_in(
                        cache, source, type_start, type_end,
                    ) {
                        if register_compile_time_binding(
                            cache,
                            source,
                            name_start,
                            name_end,
                            9,
                            type_start,
                            type_end,
                        ) == 0 {
                            return 5008;
                        }
                        if foreign {
                            let semi: usize = scan_statement_end(
                                source, end, type_end,
                            );
                            cursor = skip_space(source, end, semi + 1);
                        } else {
                            let body_close: usize = matching_close(
                                source, end, body_open, 123, 125,
                            );
                            if register_constructor(
                                cache,
                                 source,
                                 name_start,
                                 name_end,
                                 params_open + 1,
                                 params_close,
                                 body_open + 1,
                                 body_close,
                            ) == 0 {
                                return 5011;
                            }
                            // Type and Module constructors are compile-time
                            // callables. Unused constructors do not emit
                            // runtime procedures.
                            let semi: usize = skip_space(
                                source, end, body_close + 1,
                            );
                            cursor = skip_space(source, end, semi + 1);
                        }
                    } else {
                        let body_close: usize = body_open;
                        if foreign == 0 {
                            body_close = matching_close(
                                source, end, body_open, 123, 125,
                            );
                            let effect_status: i32 = validate_effect_calls(
                                cache,
                                source,
                                end,
                                body_open + 1,
                                body_close,
                                available_effect_start,
                                available_effect_end,
                            );
                            if effect_status != 0 {
                                return effect_status;
                            }
                        }
                        let specialization_kind: i32 = 0;
                        let specialization_end: i32 = 0;
                        if specialized {
                            specialization_kind = 1;
                            specialization_end = 4;
                        }
                        while specialization_kind <= specialization_end {
                            if foreign {
                                bootstrap_artifact_write_literal(
                                    "#extern #proc ",
                                );
                            } else {
                                bootstrap_artifact_write_literal("#proc ");
                            }
                            emit_scoped_name(
                                cache, source, name_start, name_end,
                            );
                            if specialized {
                                emit_specialization_suffix(
                                    specialization_kind,
                                );
                            }
                            bootstrap_artifact_write_literal("(");
                            if specialized {
                                emit_specialized_parameters(
                                    cache,
                                    source,
                                    params_open + 1,
                                    params_close,
                                    specialization_kind,
                                );
                            } else {
                                emit_parameters(
                                    cache,
                                    source,
                                    params_open + 1,
                                    params_close,
                                );
                            }
                            bootstrap_artifact_write_literal(") -> ");
                            if specialized {
                                emit_specialized_type(
                                    cache,
                                    source,
                                    type_start,
                                    type_end,
                                    type_parameter_start,
                                    type_parameter_end,
                                    specialization_kind,
                                );
                            } else {
                                emit_type_in(
                                    cache, source, type_start, type_end,
                                );
                            }

                            if foreign {
                                bootstrap_artifact_write_literal(";\n\n");
                            } else {
                                bootstrap_artifact_write_literal(" {\n");
                                compile_block(
                                    cache,
                                    source,
                                    end,
                                    body_open + 1,
                                    body_close,
                                );
                                bootstrap_artifact_write_literal("}\n\n");
                            }
                            specialization_kind = specialization_kind + 1;
                        }
                        if foreign {
                            let semi: usize = scan_statement_end(
                                source, end, type_end,
                            );
                            cursor = skip_space(source, end, semi + 1);
                        } else {
                            let semi: usize = skip_space(
                                source, end, body_close + 1,
                            );
                            cursor = skip_space(source, end, semi + 1);
                        }
                    }
                } else {
                    let intrinsic_kind: usize = 0;
                    if span_equals(
                        source, form_start, form_end,
                        "handler", 7,
                    ) {
                        intrinsic_kind = 5;
                    }
                    if span_equals(
                        source, form_start, form_end,
                        "effect_operation", 16,
                    ) {
                        intrinsic_kind = 6;
                    }
                    if span_equals(
                        source, form_start, form_end,
                        "effect", 6,
                    ) {
                        intrinsic_kind = 7;
                    }
                    if span_equals(
                        source, form_start, form_end,
                        "meta_type", 9,
                    ) {
                        intrinsic_kind = 8;
                    }
                    if span_equals(
                        source, form_start, form_end,
                        "handler_type", 12,
                    ) {
                        intrinsic_kind = 3;
                    }
                    if span_equals(
                        source, form_start, form_end,
                        "type_with_namespace", 19,
                    ) {
                        intrinsic_kind = 3;
                    }
                    if intrinsic_kind != 0 {
                        let semi: usize = scan_statement_end(
                            source, end, rhs_start,
                        );
                        if intrinsic_kind == 6 {
                            let operation_open: usize = find_top_level(
                                source, form_end, semi, 40,
                            );
                            let operation_close: usize = matching_close(
                                source,
                                semi,
                                operation_open,
                                40,
                                41,
                            );
                            let effect_comma: usize = find_top_level(
                                source,
                                operation_open + 1,
                                operation_close,
                                44,
                            );
                            let name_comma: usize = find_top_level(
                                source,
                                effect_comma + 1,
                                operation_close,
                                44,
                            );
                            let signature_start: usize = skip_space(
                                source,
                                operation_close,
                                name_comma + 1,
                            );
                            let signature_name_end: usize =
                                scan_ident_end(
                                    source,
                                    operation_close,
                                    signature_start,
                                );
                            let signature_open: usize = find_top_level(
                                source,
                                signature_name_end,
                                operation_close,
                                40,
                            );
                            let signature_close: usize = matching_close(
                                source,
                                operation_close,
                                signature_open,
                                40,
                                41,
                            );
                            let signature_arrow: usize = skip_space(
                                source,
                                operation_close,
                                signature_close + 1,
                            );
                            let signature_type_start: usize = skip_space(
                                source,
                                operation_close,
                                signature_arrow + 2,
                            );
                            let signature_type_end: usize = trim_right(
                                source,
                                signature_type_start,
                                operation_close,
                            );
                            if signature_type_end > signature_type_start {
                                if byte_at(
                                    source, signature_type_end - 1,
                                ) == 44 {
                                    signature_type_end = trim_right(
                                        source,
                                        signature_type_start,
                                        signature_type_end - 1,
                                    );
                                }
                            }
                            bootstrap_artifact_write_literal(
                                "#extern #proc ",
                            );
                            emit_scoped_name(
                                cache, source, name_start, name_end,
                            );
                            bootstrap_artifact_write_literal("(");
                            emit_parameters(
                                cache,
                                source,
                                signature_open + 1,
                                signature_close,
                            );
                            bootstrap_artifact_write_literal(") -> ");
                            emit_type_in(
                                cache,
                                source,
                                signature_type_start,
                                signature_type_end,
                            );
                            bootstrap_artifact_write_literal(";\n\n");
                        }
                        if register_compile_time_binding(
                            cache,
                            source,
                            name_start,
                            name_end,
                            intrinsic_kind,
                            rhs_start,
                            semi,
                        ) == 0 {
                            return 5008;
                        }
                        cursor = skip_space(
                            source, end, semi + 1,
                        );
                    } else {
                    let annotation: usize = find_top_level(
                        source, name_end, equal, 58,
                    );
                    if annotation < equal {
                        let expected_start: usize = skip_space(
                            source, equal, annotation + 1,
                        );
                        let expected_end: usize = scan_ident_end(
                            source, equal, expected_start,
                        );
                        let compile_time_kind: usize = 0;
                        if span_equals(
                            source,
                            expected_start,
                            expected_end,
                            "Module",
                            6,
                        ) {
                            compile_time_kind = 1;
                        }
                        if span_equals(
                            source,
                            expected_start,
                            expected_end,
                            "ModuleShape",
                            11,
                        ) {
                            compile_time_kind = 2;
                        }
                        if span_equals(
                            source,
                            expected_start,
                            expected_end,
                            "type",
                            4,
                        ) {
                            compile_time_kind = 3;
                        }
                        if compile_time_kind == 0 {
                            if lookup_compile_time_binding(
                                cache,
                                source,
                                expected_start,
                                expected_end,
                            ) != 0 {
                                compile_time_kind = 4;
                            }
                        }
                        if compile_time_kind == 0 {
                            // A qualified ModuleShape annotation can be
                            // introduced by another source unit. The
                            // constructor call itself is sufficient evidence
                            // that this binding is compile-time.
                            let candidate_semi: usize =
                                scan_statement_end(
                                    source, end, rhs_start,
                                );
                            let candidate_open: usize = find_top_level(
                                source,
                                rhs_start,
                                candidate_semi,
                                40,
                            );
                            if candidate_open < candidate_semi {
                                let candidate_end: usize = trim_right(
                                    source,
                                    rhs_start,
                                    candidate_open,
                                );
                                let candidate_start: usize = rhs_start;
                                let candidate_source_identity: usize = 0;
                                let candidate_first_dot: usize =
                                    find_top_level(
                                        source,
                                        candidate_start,
                                        candidate_end,
                                        46,
                                    );
                                if candidate_first_dot < candidate_end {
                                    candidate_source_identity =
                                        lookup_compile_time_payload(
                                            cache,
                                            source,
                                            candidate_start,
                                            candidate_first_dot,
                                        );
                                }
                                let candidate_dot: usize =
                                    find_last_top_level_dot(
                                        source,
                                        candidate_start,
                                        candidate_end,
                                    );
                                if candidate_dot < candidate_end {
                                    candidate_start = skip_space(
                                        source,
                                        candidate_end,
                                        candidate_dot + 1,
                                    );
                                }
                                let candidate_name_end: usize =
                                    scan_ident_end(
                                        source,
                                        candidate_end,
                                        candidate_start,
                                    );
                                if lookup_constructor(
                                    cache,
                                    source,
                                    candidate_start,
                                    candidate_name_end,
                                    candidate_source_identity,
                                ) != (0 as addr) {
                                    compile_time_kind = 4;
                                }
                            }
                        }
                        if compile_time_kind != 0 {
                            let semi: usize = scan_statement_end(
                                source, end, rhs_start,
                            );
                            let rhs_end: usize = trim_right(
                                source, rhs_start, semi,
                            );
                            if compile_time_kind == 3 {
                                if span_equals(
                                    source, rhs_start, rhs_end,
                                    "i32", 3,
                                ) {
                                    compile_time_kind = 31;
                                }
                                if span_equals(
                                    source, rhs_start, rhs_end,
                                    "bool", 4,
                                ) {
                                    compile_time_kind = 32;
                                }
                                if span_equals(
                                    source, rhs_start, rhs_end,
                                    "usize", 5,
                                ) {
                                    compile_time_kind = 33;
                                }
                                if span_equals(
                                    source, rhs_start, rhs_end,
                                    "addr", 4,
                                ) {
                                    compile_time_kind = 34;
                                }
                            }
                            if span_equals(
                                source,
                                form_start,
                                form_end,
                                "struct",
                                6,
                            ) {
                                let struct_open: usize = find_top_level(
                                    source, form_end, semi, 123,
                                );
                                if struct_open == semi { return 5004; }
                                let struct_close: usize = matching_close(
                                    source, semi, struct_open, 123, 125,
                                );
                                if register_struct_fields(
                                    cache,
                                    source,
                                    source,
                                    name_start,
                                    name_end,
                                    struct_open + 1,
                                    struct_close,
                                ) == 0 {
                                    return 5004;
                                }
                            }
                            if register_compile_time_binding(
                                cache,
                                source,
                                name_start,
                                name_end,
                                compile_time_kind,
                                rhs_start,
                                semi,
                            ) == 0 {
                                return 5008;
                            }
                            let constructor_open: usize = find_top_level(
                                source, rhs_start, semi, 40,
                            );
                            if constructor_open < semi {
                                let callee_end: usize = trim_right(
                                    source, rhs_start, constructor_open,
                                );
                                let callee_start: usize = rhs_start;
                                let constructor_source_identity: usize = 0;
                                let callee_first_dot: usize =
                                    find_top_level(
                                        source,
                                        callee_start,
                                        callee_end,
                                        46,
                                    );
                                if callee_first_dot < callee_end {
                                    constructor_source_identity =
                                        lookup_compile_time_payload(
                                            cache,
                                            source,
                                            callee_start,
                                            callee_first_dot,
                                        );
                                }
                                let callee_dot: usize =
                                    find_last_top_level_dot(
                                    source,
                                    callee_start,
                                    callee_end,
                                );
                                let constructor_name_start: usize =
                                    callee_start;
                                if callee_dot < callee_end {
                                    constructor_name_start = skip_space(
                                        source,
                                        callee_end,
                                        callee_dot + 1,
                                    );
                                }
                                let constructor_name_end: usize =
                                    scan_ident_end(
                                        source,
                                        callee_end,
                                        constructor_name_start,
                                    );
                                let constructor: addr =
                                    lookup_constructor(
                                        cache,
                                        source,
                                        constructor_name_start,
                                        constructor_name_end,
                                        constructor_source_identity,
                                    );
                                if constructor != (0 as addr) {
                                    let constructor_close: usize =
                                        matching_close(
                                            source,
                                            semi,
                                            constructor_open,
                                            40,
                                            41,
                                        );
                                    let instantiate_status: i32 =
                                        instantiate_constructor(
                                            cache,
                                            source,
                                            name_start,
                                            name_end,
                                            constructor_open + 1,
                                            constructor_close,
                                            constructor,
                                        );
                                    if instantiate_status != 0 {
                                        return instantiate_status;
                                    }
                                }
                            }
                            cursor = skip_space(
                                source, end, semi + 1,
                            );
                        } else {
                            let alias_semi: usize = scan_statement_end(
                                source, end, rhs_start,
                            );
                            let alias_end: usize = trim_right(
                                source, rhs_start, alias_semi,
                            );
                            let alias_open: usize = find_top_level(
                                source, rhs_start, alias_end, 40,
                            );
                            let alias_brace: usize = find_top_level(
                                source, rhs_start, alias_end, 123,
                            );
                            if exported {
                                if alias_open == alias_end {
                                    if alias_brace == alias_end {
                                        cursor = skip_space(
                                            source,
                                            end,
                                            alias_semi + 1,
                                        );
                                    } else {
                                        return 5001;
                                    }
                                } else {
                                    return 5001;
                                }
                            } else {
                                return 5001;
                            }
                        }
                    } else {
                        // Never claim that a source closure compiled when this
                        // bootstrap compiler did not understand the binding.
                        if exported {
                            let alias_semi: usize = scan_statement_end(
                                source, end, rhs_start,
                            );
                            let alias_end: usize = trim_right(
                                source, rhs_start, alias_semi,
                            );
                            if find_top_level(
                                source, rhs_start, alias_end, 40,
                            ) == alias_end {
                                if find_top_level(
                                    source, rhs_start, alias_end, 123,
                                ) == alias_end {
                                    cursor = skip_space(
                                        source, end, alias_semi + 1,
                                    );
                                } else {
                                    return 5001;
                                }
                            } else {
                                return 5001;
                            }
                        } else {
                            return 5001;
                        }
                    }
                    }
                }
            }
        }
    }
    return 0;
};

let compiler_compile = std::func() -> i32 {
    let source_count: usize = bootstrap_source_count();
    if source_count == 0 {
        return 1;
    }
    bootstrap_artifact_begin();
    bootstrap_artifact_write_literal(
        "#extern #proc bootstrap.effect-throw("
    );
    bootstrap_artifact_write_literal(
        "#addr %error) -> #unit;\n\n"
    );
    bootstrap_artifact_write_literal(
        "#extern #proc bootstrap.effect-trap() -> #unit;\n\n"
    );
    let cache: addr = std::alloca(376944);
    std::store_i64(cache, 0);
    std::store_i64(std::offset(cache, 98312), 0);
    std::store_i64(std::offset(cache, 114712), 0);
    std::store_i64(std::offset(cache, 127008), 0);
    std::store_i64(std::offset(cache, 127016), 0);
    std::store_i64(std::offset(cache, 127024), 0);
    std::store_i64(std::offset(cache, 147512), 0);
    std::store_i64(std::offset(cache, 147520), 0);
    std::store_i64(std::offset(cache, 159816), 0);
    std::store_i64(std::offset(cache, 163928), 0);
    std::store_i64(std::offset(cache, 213088), 0);
    let has_effects: bool = 0;
    let source_index: usize = 0;
    while source_index < source_count {
        let source: addr = bootstrap_source_data(source_index);
        let length: usize = bootstrap_source_length(source_index);
        if source_declares_effect(source, length) {
            has_effects = 1;
        }
        source_index = source_index + 1;
    }
    std::store_i64(std::offset(cache, 114704), has_effects);
    source_index = 0;
    while source_index < source_count {
        let source: addr = bootstrap_source_data(source_index);
        let length: usize = bootstrap_source_length(source_index);
        let status: i32 = compile_source(cache, source, 0, length);
        if status != 0 {
            return status;
        }
        source_index = source_index + 1;
    }
    bootstrap_artifact_finish();
    return 0;
};
