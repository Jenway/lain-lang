// ctx.lain —— 编译期公共层：类型与值的构造、栈槽读写、类型标注与签名查询、循环帧。
let st = import("state");
let ty = import("types");
let env = import("env");
let ir = import("ir");
let codes = import("ir_codes");
let s = import("sym");
let ax = import("ast");
let agg = import("agg");
let modules = import("modules");
let bi = import("builtins");
let ireg = import("tyreg");
let ct = import("ctypes");
let tb = import("tbuild");
let ctfn = import("ctfn");

// --- ast 层转发（本文件正文的裸调用经这里转一手，避免逐处加前缀） ----------
func new_ty(k: addr) -> addr { return ax.new_ty(k); }
func new_val(k: addr) -> addr { return ax.new_val(k); }
func n_count(g: u64) -> u64 { return ax.n_count(g); }
func n_sym(g: u64, i: u64) -> u64 { return ax.n_sym(g, i); }
func n_at(g: u64, i: u64) -> u64 { return ax.n_at(g, i); }
func node_count(h: u64) -> u64 { return ax.node_count(h); }
func node_kind(h: u64) -> u64 { return ax.node_kind(h); }
func is_group_node(h: u64) -> u64 { return ax.is_group_node(h); }
func node_sym(h: u64) -> u64 { return ax.node_sym(h); }
func dl_bracket() -> u64 { return ax.dl_bracket(); }
func dl_paren() -> u64 { return ax.dl_paren(); }
func e_ast() -> u64 { return ax.e_ast(); }
func e_type() -> u64 { return ax.e_type(); }
func is_comma(g: u64, i: u64) -> u64 { return ax.is_comma(g, i); }
func is_name(g: u64, i: u64) -> u64 { return ax.is_name(g, i); }
func is_group(g: u64, i: u64) -> u64 { return ax.is_group(g, i); }
func delim_of(g: u64, i: u64) -> u64 { return ax.delim_of(g, i); }
func no_slot() -> u64 { return ax.no_slot(); }

// --- 类型与值 -----------------------------------------------------------
func t64(k: addr) -> addr {
  let p: addr = new_ty(k);
  ty.ty_u64(p);
  return p;
}
func tbool(k: addr) -> addr {
  let p: addr = new_ty(k);
  ty.ty_bool(p);
  return p;
}
func tnone(k: addr) -> addr {
  let p: addr = new_ty(k);
  ty.ty_none(p);
  return p;
}
func ti32(k: addr) -> addr {
  let p: addr = new_ty(k);
  ty.ty_i32(p);
  return p;
}

// 把一个值推到当前指令的实参邮箱。字面量走立即数，其余走名字引用。
func push_val(k: addr, v: addr) -> u64 { return ir.op_val(k, v); }

// 字面量物化成一条指令的值名（#if 的条件这类位置必须是值名）。
func val_force(k: addr, v: addr, tp: addr) -> u64 {
  if ty.vlit(v) == 0 { return ty.vn(v); }
  ir.args_reset(k);
  ir.arg_int(k, ty.vbits(v));
  ir.arg_int(k, 0);
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, codes.INST_ADD(), res, tp);
  return res;
}

func conv_fail(k: addr) -> u64 {
  let m: addr = "type mismatch";
  let d: u64 = ir.diag(k, 0, 1, m, 13);
  return st.st_fail(k, e_type());
}

// 把 v（类型 from）转成 to，结果写 out。复合类型先走 ctypes 的转换判定：
// 只改类型、现造切片头、或明确拒绝（Ref 不能升级成 Mut）。
func coerce(k: addr, v: addr, from: addr, to: addr, out: addr) -> u64 {
  ty.val_at(out, v);
  if ty.ty_known(from) == 0 { return 0; }
  if ty.ty_known(to) == 0 { return 0; }
  if ty.vlit(v) == 1 {
    return ty.val_lit(out, ty.vbits(v), to);
  }
  if ty.ty_same(from, to) == 1 { return 0; }
  let ck: u64 = ct.conv_kind(k, from, to);
  if ck == 1 { return ty.ty_at(ty.vty(out), to); }
  if ck == 3 { return ty.ty_at(ty.vty(out), to); }
  if ck == 2 { return ct.slice_wrap(k, v, ty.tsh(from), to, out); }
  if ck == 9 { return conv_fail(k); }
  let kind: u64 = ty.cast_inst(ty.tk(from), ty.tw(from), ty.tsg(from), ty.tk(to), ty.tw(to));
  if kind == 0 { return 0; }
  ir.args_reset(k);
  ir.arg_ref(k, ty.vn(v));
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, kind, res, to);
  return ty.val_ref(out, res, to);
}

// --- 栈槽 ---------------------------------------------------------------
func slot_put(k: addr, j: u64, v: addr, tp: addr) -> u64 {
  let w: addr = t64(k);
  let c: addr = new_val(k);
  coerce(k, v, tp, w, c);
  ir.args_reset(k);
  push_val(k, c);
  ir.arg_ref(k, ir.slot_name(k, j));
  return ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
}

func slot_get(k: addr, j: u64, tp: addr, out: addr) -> u64 {
  let w: addr = t64(k);
  ir.args_reset(k);
  ir.arg_ref(k, ir.slot_name(k, j));
  let res: u64 = ir.fresh_t(k);
  ir.emit_mem(k, codes.INST_LOAD(), res, w, 0);
  let v: addr = new_val(k);
  ty.val_ref(v, res, w);
  return coerce(k, v, w, tp, out);
}

func slot_copy(k: addr, dst: u64, src: u64) -> u64 {
  let w: addr = t64(k);
  ir.args_reset(k);
  ir.arg_ref(k, ir.slot_name(k, src));
  let res: u64 = ir.fresh_t(k);
  ir.emit_mem(k, codes.INST_LOAD(), res, w, 0);
  ir.args_reset(k);
  ir.arg_ref(k, res);
  ir.arg_ref(k, ir.slot_name(k, dst));
  return ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
}

func kw_weight(h: u64) -> u64 {
  if is_group_node(h) == 1 { return 0; }
  let sym: u64 = node_sym(h);
  if sym == s.k_let() { return 1; }
  if sym == s.k_if() { return 1; }
  if sym == s.k_loop() { return 6; }
  if sym == s.k_while() { return 2; }
  if sym == s.k_for() { return 6; }
  return 0;
}

func count_list(h: u64, i: u64, n: u64, acc: u64) -> u64 {
  if i >= n { return acc; }
  let j: u64 = i + 1;
  let h2: u64 = n_at(h, i);
  return count_list(h, j, n, count_tree(h2, acc));
}

func count_tree(h: u64, acc: u64) -> u64 {
  return count_list(h, 0, node_count(h), acc + kw_weight(h));
}

func emit_slots(k: addr, j: u64, n: u64) -> u64 {
  let t: addr = new_ty(k);
  ty.ty_u8(t);
  let done: u64 = loop w(idx: u64 = j) while idx < n {
    ir.args_reset(k);
    ir.arg_int(k, 8);
    ir.emit_mem(k, codes.INST_ALLOCA(), ir.slot_name(k, idx), t, 0);
    idx = idx + 1;
  };
  return done;
}

// --- 类型标注 -----------------------------------------------------------
func expect_sym(k: addr, g: u64, i: u64, sym: u64) -> u64 {
  if i < n_count(g) {
    if n_sym(g, i) == sym { return i + 1; }
  }
  st.st_fail(k, e_ast());
  return i + 1;
}

// 名字型类型：标量走 ty_of_sym，struct / enum 名走模块符号表并带上形状号。
func named_type(k: addr, name: u64, out: addr) -> u64 {
  let e: addr = modules.find_here(k, name);
  if e as u64 == 0 { st.st_fail(k, 21); return 0; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_struct() and kd != modules.sym_kind_enum() { st.st_fail(k, 22); return 0; }
  let sh: u64 = modules.sym_shape(e);
  let a: u64 = ty.ty_addr(out);
  let b: u64 = ty.ty_set_sh(out, sh);
  return sh;
}

// 限定类型名 M.Name。
func qual_type(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let alias: u64 = n_sym(g, i);
  let name: u64 = n_sym(g, i + 2);
  let m: u64 = modules.mod_lookup(k, alias);
  if m == 0 { st.st_fail(k, e_type()); return i + 3; }
  let e: addr = modules.sym_find(k, m - 1, name);
  if e as u64 == 0 { st.st_fail(k, e_type()); return i + 3; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_struct() and kd != modules.sym_kind_enum() {
    st.st_fail(k, e_type());
    return i + 3;
  }
  let sh: u64 = modules.sym_shape(e);
  let a: u64 = ty.ty_addr(out);
  let b: u64 = ty.ty_set_sh(out, sh);
  return i + 3;
}

// --- 复合类型工厂 -------------------------------------------------------
// Ref(T) / Mut(T) / Slice(T) / MutSlice(T) / Array(T,N) / Fn((P,...)->R)。

func factory_ref(k: addr, g: u64, i: u64, out: addr, mutv: u64) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: addr = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), mutv);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
}

func factory_slice(k: addr, g: u64, i: u64, out: addr, mutv: u64) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: addr = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  let id: u64 = ct.slice_t(k, ireg.tid_of(k, e), mutv);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
}

func count_at(k: addr, g: u64, i: u64) -> u64 {
  if i >= n_count(g) { st.st_fail(k, e_type()); return 0; }
  if ax.is_digit_token(g, i) == 0 { st.st_fail(k, e_type()); return 0; }
  let h: u64 = n_at(g, i);
  return ax.num_value(ax.lit_addr(h), ax.lit_len(h));
}

func factory_array(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: addr = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  if j >= n_count(grp) { st.st_fail(k, e_type()); return i + 2; }
  if is_comma(grp, j) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let cnt: u64 = count_at(k, grp, j + 1);
  let id: u64 = ct.array_t(k, ireg.tid_of(k, e), cnt);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
}

func fill_sig(k: addr, g: u64, i: u64, idx: u64, sig: addr) -> u64 {
  if i >= n_count(g) { return idx; }
  let t: addr = new_ty(k);
  let j: u64 = parse_type(k, g, i, t);
  store(sig + idx * 8, ireg.tid_of(k, t));
  let nj: u64 = if is_comma(g, j) == 1 { j + 1 } else { j };
  return fill_sig(k, g, nj, idx + 1, sig);
}

func factory_fn(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) < 3 { st.st_fail(k, e_type()); return i + 2; }
  let pg: u64 = n_at(grp, 0);
  if is_group_node(pg) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let np: u64 = bi.arg_count(pg);
  let sig: addr = st.st_ralloc(k, np * 8 + 8);
  let got: u64 = fill_sig(k, pg, 0, 0, sig);
  let ret: addr = new_ty(k);
  let j: u64 = parse_type(k, grp, 2, ret);
  let id: u64 = ct.fn_t(k, ireg.tid_of(k, ret), np, sig as u64);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
}

func factory_type(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let nm: u64 = n_sym(g, i);
  if nm == s.t_mutslice() { return factory_slice(k, g, i, out, 1); }
  if nm == s.t_mut() { return factory_ref(k, g, i, out, 1); }
  if nm == s.t_ref() { return factory_ref(k, g, i, out, 0); }
  if nm == s.t_slice() { return factory_slice(k, g, i, out, 0); }
  if nm == s.t_array() { return factory_array(k, g, i, out); }
  if nm == s.t_fn() { return factory_fn(k, g, i, out); }
  return 0;
}

// 类型标注：标量名、struct/enum 名、限定名 M.Name、复合类型工厂、
// 旧写法 ref T / mut ref T / slice T，以及表类型 [T]。
// 复合类型一律压成物理表示：引用族与 Fn 是 addr，切片是 16 字节头，
// 数组是原地块；逻辑身份都记在形状号里。
func parse_type(k: addr, g: u64, i: u64, out: addr) -> u64 {
  if i >= n_count(g) { st.st_fail(k, e_ast()); return i + 1; }
  let h: u64 = n_at(g, i);
  if is_group_node(h) == 1 {
    if ax.delim(h) == dl_bracket() {
      let elem: addr = new_ty(k);
      let j: u64 = parse_type(k, h, 0, elem);
      let id: u64 = ct.array_t(k, ireg.tid_of(k, elem), 0);
      let a: u64 = ireg.project(k, id, out);
      return i + 1;
    }
    st.st_fail(k, e_type());
    return i + 1;
  }
  let sym: u64 = node_sym(h);
  // Type 是编译期的一等类型：物理上不可物化，只携带逻辑形状。
  if sym == s.t_type() {
    ty.ty_addr(out);
    ty.ty_set_sh(out, tb.type_shape(k));
    return i + 1;
  }
  if sym == s.k_ro() { return parse_type(k, g, i + 1, out); }
  if is_name(g, i) == 1 and i + 1 < n_count(g) and is_group(g, i + 1) == 1 {
    if delim_of(g, i + 1) == dl_paren() {
      let f: u64 = factory_type(k, g, i, out);
      if f != 0 { return f; }
      let cf: u64 = ctfn.type_from_call(k, g, i, out);
      if cf != 0 { return cf; }
    }
  }
  if sym == s.k_ref() {
    let e: addr = new_ty(k);
    let j: u64 = parse_type(k, g, i + 1, e);
    let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), 0);
    let a: u64 = ireg.project(k, id, out);
    return j;
  }
  if sym == s.k_slice() {
    let e: addr = new_ty(k);
    let j: u64 = parse_type(k, g, i + 1, e);
    let id: u64 = ct.slice_t(k, ireg.tid_of(k, e), 0);
    let a: u64 = ireg.project(k, id, out);
    return j;
  }
  if sym == s.k_mut() {
    if i + 1 < n_count(g) and n_sym(g, i + 1) == s.k_ref() {
      let e: addr = new_ty(k);
      let j: u64 = parse_type(k, g, i + 2, e);
      let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), 1);
      let a: u64 = ireg.project(k, id, out);
      return j;
    }
    st.st_fail(k, e_type());
    return i + 1;
  }
  if is_name(g, i) == 1 and i + 2 < n_count(g) and n_sym(g, i + 1) == s.p_dot() {
    return qual_type(k, g, i, out);
  }
  if ty.ty_of_sym(sym, out) == 1 { return i + 1; }
  if named_type(k, sym, out) != 0 { return i + 1; }
  st.st_fail(k, e_type());
  return i + 1;
}

// --- 函数签名 -----------------------------------------------------------
// 签名记录 24 字节：[形参个数, 返回类型, 形参类型表]。
func sig_new(k: addr, ret: addr, np: u64, params: addr) -> addr {
  // 签名挂在符号条目上，必须跨源存活：源之间会清空 arena。
  // 返回类型块与形参类型表也一起搬进持久池，否则源一清就指向复用过的字节。
  let p: addr = st.st_ralloc(k, 24);
  store(p, np);
  let r: addr = st.st_ralloc(k, 32);
  let rc: u64 = ty.ty_at(r, ret);
  store(p + 8, r as u64);
  if np == 0 {
    store(p + 16, 0);
    return p;
  }
  let ps: addr = st.st_ralloc(k, np * 32);
  store(p + 16, ps as u64);
  let i: u64 = loop c(i: u64 = 0) while i < np {
    let tc: u64 = ty.ty_at(ps + i * 32, params + i * 32);
    i = i + 1;
  };
  return p;
}

func sig_np(sg: addr) -> u64 { return load(sg); }
func sig_ret(sg: addr) -> addr { return load(sg + 8) as addr; }
func sig_params(sg: addr) -> addr { return load(sg + 16) as addr; }

// 形参组：名字、':'、类型，形参之间用逗号分隔。类型表按 32 字节一条铺。
func parse_params(k: addr, pg: u64, i: u64, idx: u64, tintbl: addr, symtbl: addr) -> u64 {
  let n: u64 = n_count(pg);
  if i >= n { return idx; }
  let sym: u64 = n_sym(pg, i);
  let a: u64 = expect_sym(k, pg, i + 1, s.p_colon());
  let t: addr = tintbl + idx * 32;
  let j: u64 = parse_type(k, pg, a, t);
  store(symtbl + idx * 8, sym);
  let nj: u64 = if is_comma(pg, j) == 1 { j + 1 } else { j };
  return parse_params(k, pg, nj, idx + 1, tintbl, symtbl);
}

// 从模块符号表取签名；形参类型拷进 paramp，返回类型拷进 retp，
// meta 里放 [命中, 形参个数, 限定名]。
func sig_lookup(k: addr, name: u64, retp: addr, paramp: addr, meta: addr) -> u64 {
  let e: addr = modules.find_here(k, name);
  if e as u64 == 0 { return 0; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_func() and kd != modules.sym_kind_extern() { return 0; }
  let sg: addr = modules.sym_sig(e);
  let np: u64 = sig_np(sg);
  let ret: addr = sig_ret(sg);
  let ps: addr = sig_params(sg);
  let i: u64 = loop c(i: u64 = 0) while i < np {
    ty.ty_at(paramp + i * 32, ps + i * 32);
    i = i + 1;
  };
  ty.ty_at(retp, ret);
  store(meta, 1);
  store(meta + 8, np);
  store(meta + 16, modules.sym_qual(e));
  return 1;
}

// 间接调用签名 [...]：形参组、箭头、返回类型。返回一条签名记录，
// 形参没有名字，类型表按 32 字节一条铺。
func icall_sig(k: addr, sg: u64) -> addr {
  let n: u64 = n_count(sg);
  if n < 3 { st.st_fail(k, e_type()); return 0 as addr; }
  let pg: u64 = n_at(sg, 0);
  if is_group_node(pg) != 1 { st.st_fail(k, e_type()); return 0 as addr; }
  if n_sym(sg, 1) != s.p_arrow() { st.st_fail(k, e_type()); return 0 as addr; }
  let np: u64 = bi.arg_count(pg);
  let tbl: addr = st.st_alloc(k, np * 32 + 32);
  let got: u64 = sig_param_list(k, pg, 0, 0, tbl);
  if got != np { st.st_fail(k, e_type()); return 0 as addr; }
  let ret: addr = new_ty(k);
  let j: u64 = parse_type(k, sg, 2, ret);
  if j < n { st.st_fail(k, e_type()); return 0 as addr; }
  return sig_new(k, ret, np, tbl);
}

func sig_param_list(k: addr, pg: u64, i: u64, idx: u64, tbl: addr) -> u64 {
  if i >= n_count(pg) { return idx; }
  let j: u64 = parse_type(k, pg, i, tbl + idx * 32);
  let nj: u64 = if is_comma(pg, j) == 1 { j + 1 } else { j };
  return sig_param_list(k, pg, nj, idx + 1, tbl);
}

// --- 循环帧 ---------------------------------------------------------------
func find_loop_at(k: addr, label: u64, d: u64) -> u64 {
  if d == 0 { return no_slot(); }
  let f: addr = st.st_lf(k, d - 1);
  if st.st_lf_label(f) == label { return d - 1; }
  return find_loop_at(k, label, d - 1);
}

func find_loop(k: addr, label: u64, has_label: u64) -> u64 {
  let d: u64 = st.st_loopdepth(k);
  if d == 0 { return no_slot(); }
  if has_label == 0 { return d - 1; }
  return find_loop_at(k, label, d);
}

// --- 结果槽（if/loop 共用） ---------------------------------------------
func alloc_res_slot(k: addr) -> u64 {
  let j: u64 = st.st_next_slot(k);
  let w: addr = t64(k);
  ir.args_reset(k);
  ir.arg_int(k, 0);
  ir.arg_ref(k, ir.slot_name(k, j));
  ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
  return j;
}

// --- 标签头 -------------------------------------------------------------
// <名字> ( … )：名字后面紧跟小括号才算标签。
func loop_head(k: addr, g: u64, j: u64, ob: addr) -> u64 {
  let n: u64 = n_count(g);
  store(ob, 0);
  if j + 1 < n and is_name(g, j) == 1 and is_group(g, j + 1) == 1 and delim_of(g, j + 1) == dl_paren() {
    store(ob, 1);
    store(ob + 8, n_sym(g, j));
    return j + 1;
  }
  return j;
}
