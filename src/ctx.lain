// ctx.lain —— 编译期公共层：类型与值的构造、栈槽读写、类型标注与签名查询、循环帧。
let st = import("state");
let ty = import("types");
let env = import("env");
let ir = import("ir");
let codes = import("ir_codes");
let s = import("sym");
let ax = import("ast");
let agg = import("agg");
let modules = import("modules");
let bi = import("builtins");
let ireg = import("tyreg");
let ct = import("ctypes");
let tb = import("tbuild");
let ctfn = import("ctfn");
let ctf = import("ctfor");

let SigRec = struct {
  np: u64,
  ret: Mut(ty.Ty),
  params: Mut(ty.Ty)
};

let SigMeta = struct {
  hit: u64,
  np: u64,
  qual: u64
};

let LoopHeadOut = struct {
  has: u64,
  label: u64
};

// --- ast 层转发（本文件正文的裸调用经这里转一手，避免逐处加前缀） ----------
let new_ty = func(k: Mut(st.State)) -> Mut(ty.Ty) { return ax.new_ty(k); };
let new_val = func(k: Mut(st.State)) -> Mut(ty.Val) { return ax.new_val(k); };
let n_count = func(g: u64) -> u64 { return ax.n_count(g); };
let n_sym = func(g: u64, i: u64) -> u64 { return ax.n_sym(g, i); };
let n_at = func(g: u64, i: u64) -> u64 { return ax.n_at(g, i); };
let node_count = func(h: u64) -> u64 { return ax.node_count(h); };
let node_kind = func(h: u64) -> u64 { return ax.node_kind(h); };
let is_group_node = func(h: u64) -> u64 { return ax.is_group_node(h); };
let node_sym = func(h: u64) -> u64 { return ax.node_sym(h); };
let dl_bracket = func() -> u64 { return ax.dl_bracket(); };
let dl_paren = func() -> u64 { return ax.dl_paren(); };
let e_ast = func() -> u64 { return ax.e_ast(); };
let e_type = func() -> u64 { return ax.e_type(); };
let is_comma = func(g: u64, i: u64) -> u64 { return ax.is_comma(g, i); };
let is_name = func(g: u64, i: u64) -> u64 { return ax.is_name(g, i); };
let is_group = func(g: u64, i: u64) -> u64 { return ax.is_group(g, i); };
let delim_of = func(g: u64, i: u64) -> u64 { return ax.delim_of(g, i); };
let no_slot = func() -> u64 { return ax.no_slot(); };

let ty_idx = func(base: Mut(ty.Ty), i: u64) -> Mut(ty.Ty) {
  return ptr_cast(Mut(ty.Ty), ptr_cast(Mut(u8), base) + i * 32);
};

let word_idx = func(base: Mut(u64), i: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), ptr_cast(Mut(u8), base) + i * 8);
};

// --- 类型与值 -----------------------------------------------------------
let t64 = func(k: Mut(st.State)) -> Mut(ty.Ty) {
  let p: Mut(ty.Ty) = new_ty(k);
  ty.ty_u64(p);
  return p;
};
let tbool = func(k: Mut(st.State)) -> Mut(ty.Ty) {
  let p: Mut(ty.Ty) = new_ty(k);
  ty.ty_bool(p);
  return p;
};
let tnone = func(k: Mut(st.State)) -> Mut(ty.Ty) {
  let p: Mut(ty.Ty) = new_ty(k);
  ty.ty_none(p);
  return p;
};
let ti32 = func(k: Mut(st.State)) -> Mut(ty.Ty) {
  let p: Mut(ty.Ty) = new_ty(k);
  ty.ty_i32(p);
  return p;
};

// 把一个值推到当前指令的实参邮箱。字面量走立即数，其余走名字引用。
let push_val = func(k: Mut(st.State), v: Mut(ty.Val)) -> u64 { return ir.op_val(k, v); };

// 字面量物化成一条指令的值名（#if 的条件这类位置必须是值名）。
let val_force = func(k: Mut(st.State), v: Mut(ty.Val), tp: Mut(ty.Ty)) -> u64 {
  if ty.vlit(v) == 0 { return ty.vn(v); }
  ir.args_reset(k);
  ir.arg_int(k, ty.vbits(v));
  ir.arg_int(k, 0);
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, codes.INST_ADD(), res, tp);
  return res;
};

let conv_fail = func(k: Mut(st.State)) -> u64 {
  let m: Ref(u8) = "type mismatch";
  let d: u64 = ir.diag(k, 0, 1, m, 13);
  return st.st_fail(k, e_type());
};

// 把 v（类型 from）转成 to，结果写 out。复合类型先走 ctypes 的转换判定：
// 只改类型、现造切片头、或明确拒绝（Ref 不能升级成 Mut）。
let coerce = func(k: Mut(st.State), v: Mut(ty.Val), from: Mut(ty.Ty), to: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  ty.val_at(out, v);
  if ty.ty_known(from) == 0 { return 0; }
  if ty.ty_known(to) == 0 { return 0; }
  if ty.vlit(v) == 1 {
    return ty.val_lit(out, ty.vbits(v), to);
  }
  if ty.ty_same(from, to) == 1 { return 0; }
  let ck: u64 = ct.conv_kind(k, from, to);
  if ck == 1 { return ty.ty_at(ty.vty(out), to); }
  if ck == 3 { return ty.ty_at(ty.vty(out), to); }
  if ck == 2 { return ct.slice_wrap(k, v, ty.tsh(from), to, out); }
  if ck == 9 { return conv_fail(k); }
  let kind: u64 = ty.cast_inst(ty.tk(from), ty.tw(from), ty.tsg(from), ty.tk(to), ty.tw(to));
  if kind == 0 { return ty.ty_at(ty.vty(out), to); }
  ir.args_reset(k);
  ir.arg_ref(k, ty.vn(v));
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, kind, res, to);
  return ty.val_ref(out, res, to);
};

// --- 栈槽 ---------------------------------------------------------------
let slot_put = func(k: Mut(st.State), j: u64, v: Mut(ty.Val), tp: Mut(ty.Ty)) -> u64 {
  let w: Mut(ty.Ty) = t64(k);
  let c: Mut(ty.Val) = new_val(k);
  coerce(k, v, tp, w, c);
  ir.args_reset(k);
  push_val(k, c);
  ir.arg_ref(k, ir.slot_name(k, j));
  return ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
};

let slot_get = func(k: Mut(st.State), j: u64, tp: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let w: Mut(ty.Ty) = t64(k);
  ir.args_reset(k);
  ir.arg_ref(k, ir.slot_name(k, j));
  let res: u64 = ir.fresh_t(k);
  ir.emit_mem(k, codes.INST_LOAD(), res, w, 0);
  let v: Mut(ty.Val) = new_val(k);
  ty.val_ref(v, res, w);
  return coerce(k, v, w, tp, out);
};

let slot_copy = func(k: Mut(st.State), dst: u64, src: u64) -> u64 {
  let w: Mut(ty.Ty) = t64(k);
  ir.args_reset(k);
  ir.arg_ref(k, ir.slot_name(k, src));
  let res: u64 = ir.fresh_t(k);
  ir.emit_mem(k, codes.INST_LOAD(), res, w, 0);
  ir.args_reset(k);
  ir.arg_ref(k, res);
  ir.arg_ref(k, ir.slot_name(k, dst));
  return ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
};

let kw_weight = func(h: u64) -> u64 {
  if is_group_node(h) == 1 { return 0; }
  let sym: u64 = node_sym(h);
  if sym == s.k_let() { return 1; }
  if sym == s.k_if() { return 1; }
  if sym == s.k_loop() { return 6; }
  if sym == s.k_while() { return 2; }
  if sym == s.k_for() { return 6; }
  return 0;
};

let count_list = func(h: u64, i: u64, n: u64, acc: u64) -> u64 {
  if i >= n { return acc; }
  let j: u64 = i + 1;
  let h2: u64 = n_at(h, i);
  return count_list(h, j, n, count_tree(h2, acc));
};

let count_tree = func(h: u64, acc: u64) -> u64 {
  return count_list(h, 0, node_count(h), acc + kw_weight(h));
};

let emit_slots = func(k: Mut(st.State), j: u64, n: u64) -> u64 {
  let t: Mut(ty.Ty) = new_ty(k);
  ty.ty_u8(t);
  let done: u64 = loop w(idx: u64 = j) while idx < n {
    ir.args_reset(k);
    ir.arg_int(k, 8);
    ir.emit_mem(k, codes.INST_ALLOCA(), ir.slot_name(k, idx), t, 0);
    idx = idx + 1;
  };
  return done;
};

// --- 类型标注 -----------------------------------------------------------
let expect_sym = func(k: Mut(st.State), g: u64, i: u64, sym: u64) -> u64 {
  if i < n_count(g) {
    if n_sym(g, i) == sym { return i + 1; }
  }
  st.st_fail(k, e_ast());
  return i + 1;
};

// 名字型类型：标量走 ty_of_sym，struct / enum 名走模块符号表并带上形状号。
let named_type = func(k: Mut(st.State), name: u64, out: Mut(ty.Ty)) -> u64 {
  let e: Mut(modules.SymEntry) = modules.find_here(k, name);
  if is_null(e) { st.st_fail(k, 21); return 0; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_struct() and kd != modules.sym_kind_enum() { st.st_fail(k, 22); return 0; }
  let sh: u64 = modules.sym_shape(e);
  let a: u64 = ty.ty_addr(out);
  let b: u64 = ty.ty_set_sh(out, sh);
  return sh;
};

// 限定类型名 M.Name。
let qual_type = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 {
  let alias: u64 = n_sym(g, i);
  let name: u64 = n_sym(g, i + 2);
  let m: u64 = modules.mod_lookup(k, alias);
  if m == 0 { st.st_fail(k, e_type()); return i + 3; }
  let e: Mut(modules.SymEntry) = modules.sym_find(k, m - 1, name);
  if is_null(e) { st.st_fail(k, e_type()); return i + 3; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_struct() and kd != modules.sym_kind_enum() {
    st.st_fail(k, e_type());
    return i + 3;
  }
  let sh: u64 = modules.sym_shape(e);
  let a: u64 = ty.ty_addr(out);
  let b: u64 = ty.ty_set_sh(out, sh);
  return i + 3;
};

// --- 复合类型工厂 -------------------------------------------------------
// Ref(T) / Mut(T) / Slice(T) / MutSlice(T) / Array(T,N) / Fn((P,...)->R)。

let factory_ref = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty), mutv: u64) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), mutv);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
};

let factory_slice = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty), mutv: u64) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  let id: u64 = ct.slice_t(k, ireg.tid_of(k, e), mutv);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
};

let count_at = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  if i >= n_count(g) { st.st_fail(k, e_type()); return 0; }
  if ax.is_digit_token(g, i) == 1 {
    let h: u64 = n_at(g, i);
    return ax.num_value(ax.lit_addr(h), ax.lit_len(h));
  }
  if is_name(g, i) == 1 {
    let bv: Mut(ctf.CtVal) = ctf.lookup(k, n_sym(g, i));
    if (bv as u64) != 0 {
      if ctf.v_kind(bv) == 0 { return ctf.v_a(bv); }
    }
  }
  st.st_fail(k, e_type());
  return 0;
};

let factory_array = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let e: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, grp, 0, e);
  if j >= n_count(grp) { st.st_fail(k, e_type()); return i + 2; }
  if is_comma(grp, j) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let cnt: u64 = count_at(k, grp, j + 1);
  let id: u64 = ct.array_t(k, ireg.tid_of(k, e), cnt);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
};

let fill_sig = func(k: Mut(st.State), g: u64, i: u64, idx: u64, sig: Mut(u64)) -> u64 {
  if i >= n_count(g) { return idx; }
  let t: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, g, i, t);
  deref(word_idx(sig, idx)) = ireg.tid_of(k, t);
  let nj: u64 = if is_comma(g, j) == 1 { j + 1 } else { j };
  return fill_sig(k, g, nj, idx + 1, sig);
};

let factory_fn = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 {
  let grp: u64 = n_at(g, i + 1);
  if n_count(grp) < 3 { st.st_fail(k, e_type()); return i + 2; }
  let pg: u64 = n_at(grp, 0);
  if is_group_node(pg) == 0 { st.st_fail(k, e_type()); return i + 2; }
  let np: u64 = bi.arg_count(pg);
  let sig: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, np * 8 + 8));
  let got: u64 = fill_sig(k, pg, 0, 0, sig);
  let ret: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, grp, 2, ret);
  let id: u64 = ct.fn_t(k, ireg.tid_of(k, ret), np, sig as u64);
  let a: u64 = ireg.project(k, id, out);
  return i + 2;
};

let factory_type = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 {
  let nm: u64 = n_sym(g, i);
  if nm == s.t_mutslice() { return factory_slice(k, g, i, out, 1); }
  if nm == s.t_mut() { return factory_ref(k, g, i, out, 1); }
  if nm == s.t_ref() { return factory_ref(k, g, i, out, 0); }
  if nm == s.t_slice() { return factory_slice(k, g, i, out, 0); }
  if nm == s.t_array() { return factory_array(k, g, i, out); }
  if nm == s.t_fn() { return factory_fn(k, g, i, out); }
  return 0;
};

// 类型标注：标量名、struct/enum 名、限定名 M.Name、复合类型工厂、
// 旧写法 ref T / mut ref T / slice T，以及表类型 [T]。
// 复合类型一律压成物理表示：引用族与 Fn 是指针，切片是 16 字节头，
// 数组是原地块；逻辑身份都记在形状号里。
let parse_type = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 {
  if i >= n_count(g) { st.st_fail(k, e_ast()); return i + 1; }
  let h: u64 = n_at(g, i);
  if is_group_node(h) == 1 {
    if ax.delim(h) == dl_bracket() {
      let elem: Mut(ty.Ty) = new_ty(k);
      let j: u64 = parse_type(k, h, 0, elem);
      let id: u64 = ct.array_t(k, ireg.tid_of(k, elem), 0);
      let a: u64 = ireg.project(k, id, out);
      return i + 1;
    }
    st.st_fail(k, e_type());
    return i + 1;
  }
  let sym: u64 = node_sym(h);
  // Type 是编译期的一等类型：物理上不可物化，只携带逻辑形状。
  if sym == s.t_type() {
    ty.ty_addr(out);
    ty.ty_set_sh(out, tb.type_shape(k));
    return i + 1;
  }
  if sym == s.k_ro() { return parse_type(k, g, i + 1, out); }
  if is_name(g, i) == 1 and i + 1 < n_count(g) and is_group(g, i + 1) == 1 {
    if delim_of(g, i + 1) == dl_paren() {
      let f: u64 = factory_type(k, g, i, out);
      if f != 0 { return f; }
      let cf: u64 = ctfn.type_from_call(k, g, i, out);
      if cf != 0 { return cf; }
    }
  }
  if sym == s.k_ref() {
    let e: Mut(ty.Ty) = new_ty(k);
    let j: u64 = parse_type(k, g, i + 1, e);
    let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), 0);
    let a: u64 = ireg.project(k, id, out);
    return j;
  }
  if sym == s.k_slice() {
    let e: Mut(ty.Ty) = new_ty(k);
    let j: u64 = parse_type(k, g, i + 1, e);
    let id: u64 = ct.slice_t(k, ireg.tid_of(k, e), 0);
    let a: u64 = ireg.project(k, id, out);
    return j;
  }
  if sym == s.k_mut() {
    if i + 1 < n_count(g) and n_sym(g, i + 1) == s.k_ref() {
      let e: Mut(ty.Ty) = new_ty(k);
      let j: u64 = parse_type(k, g, i + 2, e);
      let id: u64 = ct.ref_t(k, ireg.tid_of(k, e), 1);
      let a: u64 = ireg.project(k, id, out);
      return j;
    }
    st.st_fail(k, e_type());
    return i + 1;
  }
  if is_name(g, i) == 1 and i + 2 < n_count(g) and n_sym(g, i + 1) == s.p_dot() {
    if i + 3 < n_count(g) and is_group(g, i + 3) == 1 and ax.delim_of(g, i + 3) == dl_paren() {
      let cf2: u64 = ctfn.type_from_call(k, g, i, out);
      if cf2 != 0 { return cf2; }
    }
    return qual_type(k, g, i, out);
  }
  if ty.ty_of_sym(sym, out) == 1 { return i + 1; }
  let bv: Mut(ctf.CtVal) = ctf.lookup(k, sym);
  if (bv as u64) != 0 {
    if ctf.v_kind(bv) == 1 {
      let pr: u64 = ireg.project(k, ctf.v_a(bv), out);
      return i + 1;
    }
  }
  if named_type(k, sym, out) != 0 { return i + 1; }
  st.st_fail(k, e_type());
  return i + 1;
};

// --- 函数签名 -----------------------------------------------------------
// 签名记录 24 字节：[形参个数, 返回类型, 形参类型表]。
let sig_new = func(k: Mut(st.State), ret: Mut(ty.Ty), np: u64, params: Mut(ty.Ty)) -> Mut(u8) {
  // 签名挂在符号条目上，必须跨源存活：源之间会清空 arena。
  // 返回类型块与形参类型表也一起搬进持久池，否则源一清就指向复用过的字节。
  let p: Mut(SigRec) = ptr_cast(Mut(SigRec), st.st_ralloc(k, 24));
  p.np = np;
  let r: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, 32));
  let rc: u64 = ty.ty_at(r, ret);
  p.ret = r;
  if np == 0 {
    p.params = null_ref(Mut(ty.Ty));
    return ptr_cast(Mut(u8), p);
  }
  let ps: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, np * 32));
  p.params = ps;
  let i: u64 = loop c(i: u64 = 0) while i < np {
    let tc: u64 = ty.ty_at(ty_idx(ps, i), ty_idx(params, i));
    i = i + 1;
  };
  return ptr_cast(Mut(u8), p);
};

let sig_np = func(sg: Mut(u8)) -> u64 { let p: Mut(SigRec) = ptr_cast(Mut(SigRec), sg); return p.np; };
let sig_ret = func(sg: Mut(u8)) -> Mut(ty.Ty) { let p: Mut(SigRec) = ptr_cast(Mut(SigRec), sg); return p.ret; };
let sig_params = func(sg: Mut(u8)) -> Mut(ty.Ty) { let p: Mut(SigRec) = ptr_cast(Mut(SigRec), sg); return p.params; };

// 形参组：名字、':'、类型，形参之间用逗号分隔。类型表按 32 字节一条铺。
let parse_params = func(k: Mut(st.State), pg: u64, i: u64, idx: u64, tintbl: Mut(ty.Ty), symtbl: Mut(u64)) -> u64 {
  let n: u64 = n_count(pg);
  if i >= n { return idx; }
  let sym: u64 = n_sym(pg, i);
  let a: u64 = expect_sym(k, pg, i + 1, s.p_colon());
  let t: Mut(ty.Ty) = ty_idx(tintbl, idx);
  let j: u64 = parse_type(k, pg, a, t);
  deref(word_idx(symtbl, idx)) = sym;
  let nj: u64 = if is_comma(pg, j) == 1 { j + 1 } else { j };
  return parse_params(k, pg, nj, idx + 1, tintbl, symtbl);
};

// 从模块符号表取签名；形参类型拷进 paramp，返回类型拷进 retp，
// meta 里放 [命中, 形参个数, 限定名]。
let sig_lookup = func(k: Mut(st.State), name: u64, retp: Mut(ty.Ty), paramp: Mut(ty.Ty), meta: Mut(SigMeta)) -> u64 {
  let e: Mut(modules.SymEntry) = modules.find_here(k, name);
  if is_null(e) { return 0; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_func() and kd != modules.sym_kind_extern() { return 0; }
  let sg: Mut(u8) = modules.sym_sig(e);
  let np: u64 = sig_np(sg);
  let ret: Mut(ty.Ty) = sig_ret(sg);
  let ps: Mut(ty.Ty) = sig_params(sg);
  let i: u64 = loop c(i: u64 = 0) while i < np {
    ty.ty_at(ty_idx(paramp, i), ty_idx(ps, i));
    i = i + 1;
  };
  ty.ty_at(retp, ret);
  meta.hit = 1;
  meta.np = np;
  meta.qual = modules.sym_qual(e);
  return 1;
};

// 间接调用签名 [...]：形参组、箭头、返回类型。返回一条签名记录，
// 形参没有名字，类型表按 32 字节一条铺。
let icall_sig = func(k: Mut(st.State), sg: u64) -> Mut(u8) {
  let n: u64 = n_count(sg);
  if n < 3 { st.st_fail(k, e_type()); return null_ref(Mut(u8)); }
  let pg: u64 = n_at(sg, 0);
  if is_group_node(pg) != 1 { st.st_fail(k, e_type()); return null_ref(Mut(u8)); }
  if n_sym(sg, 1) != s.p_arrow() { st.st_fail(k, e_type()); return null_ref(Mut(u8)); }
  let np: u64 = bi.arg_count(pg);
  let tbl: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, np * 32 + 32));
  let got: u64 = sig_param_list(k, pg, 0, 0, tbl);
  if got != np { st.st_fail(k, e_type()); return null_ref(Mut(u8)); }
  let ret: Mut(ty.Ty) = new_ty(k);
  let j: u64 = parse_type(k, sg, 2, ret);
  if j < n { st.st_fail(k, e_type()); return null_ref(Mut(u8)); }
  return sig_new(k, ret, np, tbl);
};

let sig_param_list = func(k: Mut(st.State), pg: u64, i: u64, idx: u64, tbl: Mut(ty.Ty)) -> u64 {
  if i >= n_count(pg) { return idx; }
  let j: u64 = parse_type(k, pg, i, ty_idx(tbl, idx));
  let nj: u64 = if is_comma(pg, j) == 1 { j + 1 } else { j };
  return sig_param_list(k, pg, nj, idx + 1, tbl);
};

// --- 循环帧 ---------------------------------------------------------------
let find_loop_at = func(k: Mut(st.State), label: u64, d: u64) -> u64 {
  if d == 0 { return no_slot(); }
  let f: Mut(st.LoopFrame) = st.st_lf(k, d - 1);
  if st.st_lf_label(f) == label { return d - 1; }
  return find_loop_at(k, label, d - 1);
};

let find_loop = func(k: Mut(st.State), label: u64, has_label: u64) -> u64 {
  let d: u64 = st.st_loopdepth(k);
  if d == 0 { return no_slot(); }
  if has_label == 0 { return d - 1; }
  return find_loop_at(k, label, d);
};

// --- 结果槽（if/loop 共用） ---------------------------------------------
let alloc_res_slot = func(k: Mut(st.State)) -> u64 {
  let j: u64 = st.st_next_slot(k);
  let w: Mut(ty.Ty) = t64(k);
  ir.args_reset(k);
  ir.arg_int(k, 0);
  ir.arg_ref(k, ir.slot_name(k, j));
  ir.emit_mem(k, codes.INST_STORE(), 0, w, 0);
  return j;
};

// --- 标签头 -------------------------------------------------------------
// <名字> ( … )：名字后面紧跟小括号才算标签。
let loop_head = func(k: Mut(st.State), g: u64, j: u64, ob: Mut(LoopHeadOut)) -> u64 {
  let n: u64 = n_count(g);
  ob.has = 0;
  if j + 1 < n and is_name(g, j) == 1 and is_group(g, j + 1) == 1 and delim_of(g, j + 1) == dl_paren() {
    ob.has = 1;
    ob.label = n_sym(g, j);
    return j + 1;
  }
  return j;
};
