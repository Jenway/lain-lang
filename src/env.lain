// 词法作用域：一条记录 48 字节 = [名字 SymId, 槽号, k, w, sg, 形状号]。
// 槽号指向过程入口发好的 #alloca，读写走 types.lain 的标量访问器。
let st = import("state");
let ty = import("types");

func env_mark(s: addr) -> u64 { return st.st_sp(s); }

func env_release(s: addr, mark: u64) -> u64 { return st.st_set_sp(s, mark); }

func env_push(s: addr, sym: u64, slot: u64, t: addr) -> u64 {
  let off: u64 = st.st_sp(s);
  if off + 48 > st.st_cap(s) { return st.st_fail(s, 2); }
  let p: addr = st.st_base(s) + off;
  store(p, sym);
  store(p + 8, slot);
  store(p + 16, ty.tk(t));
  store(p + 24, ty.tw(t));
  store(p + 32, ty.tsg(t));
  store(p + 40, ty.tsh(t));
  st.st_set_sp(s, off + 48);
  return 0;
}

func env_scan(s: addr, sym: u64, off: u64) -> u64 {
  if off == 0 { return 0; }
  let back: u64 = off - 48;
  let p: addr = st.st_base(s) + back;
  let got: u64 = load(p);
  if got == sym { return back + 1; }
  return env_scan(s, sym, back);
}

func env_find(s: addr, sym: u64) -> u64 {
  return env_scan(s, sym, st.st_sp(s));
}

func env_has(s: addr, sym: u64) -> u64 {
  if env_find(s, sym) == 0 { return 0; }
  return 1;
}

func env_slot(s: addr, off: u64) -> u64 {
  let back: u64 = off - 1;
  let p: addr = st.st_base(s) + back;
  return load(p + 8);
}

func env_ty(s: addr, off: u64, out: addr) -> u64 {
  let back: u64 = off - 1;
  let p: addr = st.st_base(s) + back;
  let k: u64 = load(p + 16);
  let w: u64 = load(p + 24);
  let sg: u64 = load(p + 32);
  let sh: u64 = load(p + 40);
  ty.ty_save(out, k, w, sg);
  return ty.ty_set_sh(out, sh);
}
