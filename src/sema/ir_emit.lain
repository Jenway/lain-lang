let emit_symbol = func(s: Mut(st.State), kind: u64, res: u64, symbol: u64) -> u64 {
  return hr.ir_inst_symbol(st.st_mod(s), kind, res, symbol);
};

pub let proc_end = func(s: Mut(st.State)) -> u64 {
  return hr.ir_proc_end(st.st_mod(s));
};

pub let sym_lit = func(p: Ref(u8), n: u64) -> u64 {
  return hr.sym_intern(p, n);
};

pub let op_val = func(s: Mut(st.State), v: Mut(ty.Val)) -> u64 {
  if ty.vlit(v) == 1 { return arg_int(s, ty.vbits(v)); }
  let nm: u64 = ty.vn(v);
  if nm == 0 {
    let m: Ref(u8) = "empty-operand";
    let d: u64 = diag(s, v as u64, 1, m, 13);
    let d2: u64 = diag(s, ty.vbits(v), 2, m, 13);
    return st.st_fail(s, 3);
  }
  return arg_ref(s, nm);
};

pub let taddr = func(s: Mut(st.State)) -> Mut(ty.Ty) {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(s, 32));
  let rc: u64 = ty.ty_addr(t);
  return t;
};

pub let tbits = func(s: Mut(st.State), w: u64) -> Mut(ty.Ty) {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(s, 32));
  let rc: u64 = ty.ty_bits(t, w, 0);
  return t;
};

