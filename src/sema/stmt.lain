let st = import("src::driver::state");
let ty = import("src::sema::types");
let env = import("src::sema::env");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let s = import("src::driver::sym");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let agg = import("src::sema::agg");
let lv = import("src::sema::lval");
let flow = import("src::sema::flow");
let ireg = import("src::sema::tyreg");
let ct = import("src::comptime::ctypes");
let ctf = import("src::comptime::ctfor");
let tb = import("src::sema::tbuild");
let gv = import("src::sema::witness");
let modules = import("src::sema::modules");
let ctfn = import("src::comptime::ctfn");
let ctp = import("src::comptime::ctprim");
let ef = import("src::sema::effects");
let drop = import("src::sema::drop");
let hr = import("src::driver::host_rt");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;
extern stmt_p1_group(k: Mut(st.State), g: u64) -> u64 = lainc_eval_phase1_group;
extern stmt_p2_group(k: Mut(st.State), g: u64) -> u64 = lainc_eval_phase2_group;

let path_take = func(k: Mut(st.State), g: u64, i: u64, segs: Mut(u64), cnt: Mut(u64), n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_name(g, i) == 0 { return i; }
  let c: u64 = ax.box_get(cnt);
  if c >= 8 { return i; }
  let wp: Mut(u64) = cx.word_idx(segs, c);
  deref(wp) = ax.n_sym(g, i);
  ax.box_put(cnt, c + 1);
  if i + 2 < n and ax.n_sym(g, i + 1) == s.p_dot() and ax.is_name(g, i + 2) == 1 {
    return path_take(k, g, i + 2, segs, cnt, n);
  }
  return i + 1;
};

let path_resolve = func(k: Mut(st.State), segs: Mut(u64), cnt: u64, seal: Mut(u64)) -> u64 {
  if cnt == 0 { return 0; }
  let first: u64 = deref(segs);
  let m0: u64 = ctf.find_used_mod(k, first, seal);
  if m0 == 0 { return 0; }
  if cnt == 1 { return m0; }
  let rest: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), segs) + 8);
  let tail: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), rest) + 8);
  return modules.mod_resolve_path(k, m0, deref(rest), tail, cnt - 2, seal);
};

let ct_module_rhs = func(k: Mut(st.State), g: u64, e: u64, name: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if e >= n { return 0; }

  if ax.n_sym(g, e) == s.k_module() and e + 1 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Brace as u64 {
    let bodyg: u64 = ax.n_at(g, e + 1);
    let vmod: u64 = st.st_next_vmod(k);
    let reg: u64 = modules.mod_register_vmod(k, vmod, 0);
    let par: u64 = modules.mod_set_parent(k, vmod, modules.cur(k));
    let saved: u64 = st.st_vmod(k);
    st.st_set_vmod(k, vmod);
    let a: u64 = stmt_p1_group(k, bodyg);
    if st.st_ok(k) == 0 { let bd0: u64 = drop.bind_self_drop(k, vmod); }
    if st.st_ok(k) == 0 { let b: u64 = stmt_p2_group(k, bodyg); }
    st.st_set_vmod(k, saved);
    if st.st_ok(k) == 0 { let bd: u64 = drop.bind_self_drop(k, vmod); }
    if st.st_ok(k) == 0 { let bd: u64 = ctf.bind(k, name, 9, vmod, 0); }
    return ax.skip_semi(g, e + 2);
  }

  if ax.is_name(g, e) == 1 and e + 1 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Paren as u64 {
    let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let fc: u64 = ctfn.eval_factory_call(k, g, e, v);
    if fc != 0 {
      if st.st_ok(k) != 0 { return fc; }
      if ctf.v_kind(v) == 9 {
        let bd: u64 = ctf.bind(k, name, 9, ctf.v_a(v), ctf.v_b(v));
        return ax.skip_semi(g, fc);
      }
    }
  }

  if ax.is_name(g, e) == 1 {
    let segs: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
    let cnt: Mut(u64) = ax.box(k);
    let end: u64 = path_take(k, g, e, segs, cnt, n);
    if end < n and ax.is_semi(g, end) == 0 { return 0; }
    let seal: Mut(u64) = ax.box(k);
    let m: u64 = path_resolve(k, segs, ax.box_get(cnt), seal);
    if m == 0 { return 0; }
    let bd: u64 = ctf.bind(k, name, 9, m, deref(seal));
    return ax.skip_semi(g, end);
  }
  return 0;
};

let stmt_use = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let is_use: u64 = if ax.n_sym(g, i) == s.k_use() { 1 } else { 0 };
  let segs: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let cnt: Mut(u64) = ax.box(k);
  let end: u64 = path_take(k, g, i + 1, segs, cnt, n);
  let c: u64 = ax.box_get(cnt);
  if c == 0 {
    let m0: Ref(u8) = "expected module path";
    let d0: u64 = ir.diag(k, 0, 1, m0, 19);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return end;
  }
  let seal: Mut(u64) = ax.box(k);
  let target: u64 = path_resolve(k, segs, c, seal);
  if target == 0 {
    let m: Ref(u8) = "unknown module";
    let d: u64 = ir.diag(k, 0, 1, m, 14);
    st.st_fail(k, ax.FailKind.Type as u64);
    return ax.skip_semi(g, end);
  }
  if is_use == 1 {
    let pu: u64 = ctf.push_use(k, target, deref(seal));
    let pi: u64 = gv.push_mod_implicit(k, target, deref(seal));
  } else {
    let op: u64 = modules.mod_add_open(k, modules.cur(k), target, deref(seal));
  }
  return ax.skip_semi(g, end);
};

let sig_ann = func(k: Mut(st.State), g: u64, j0: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if j0 >= n { return 0; }
  if ax.n_sym(g, j0) != s.p_colon() { return 0; }
  if j0 + 1 >= n { return 0; }
  if ax.is_name(g, j0 + 1) == 0 { return 0; }
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, ax.n_sym(g, j0 + 1));
  if is_null(e) { return 0; }
  if modules.sym_kind(e) != modules.sym_kind_sig() { return 0; }
  return 1;
};

let stmt_let = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64)) -> u64 {
  let name: u64 = ax.n_sym(g, i + 1);
  let j0: u64 = i + 2;
  let t: Mut(ty.Ty) = cx.tnone(k);
  let sa: u64 = sig_ann(k, g, j0);
  let j: u64 = if j0 < ax.n_count(g) and ax.n_sym(g, j0) == s.p_colon() {
    if sa == 1 { j0 + 2 } else { cx.parse_type(k, g, j0 + 1, t) }
  } else { j0 };
  if tb.ty_is_type(t) == 1 {
    let m: Ref(u8) = "type value at runtime";
    let d: u64 = ir.diag(k, 0, 1, m, 21);
    st.st_fail(k, ax.FailKind.Type as u64);
    return j;
  }
  let e: u64 = cx.expect_sym(k, g, j, s.p_eq());
  let cp: u64 = drop.bare_local(k, g, e);
  if cp != 0 and env.env_is_noncopy(k, cp) == 1 {
    let m: Ref(u8) = "implicit copy of !Copy";
    let d: u64 = ir.diag(k, 0, 1, m, 22);
    st.st_fail(k, ax.FailKind.Type as u64);
    return ax.skip_semi(g, e);
  }
  let efj: u64 = ef.effect_rhs(k, g, e, name, 0);
  if efj != 0 { return ax.skip_semi(g, efj); }
  let mb: u64 = ct_module_rhs(k, g, e, name);
  if mb != 0 { return mb; }
  let v: Mut(ty.Val) = ax.new_val(k);

  let hint: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(t) == 1 { ty.ty_at(hint, t); } else { ty.ty_bits(hint, 64, 1); }
  let nj: u64 = core_expr(k, g, e, 0, hint, v);
  if st.st_ok(k) != 0 { return nj; }
  if ef.take_aborts(k) == 1 { return ax.skip_semi(g, nj); }
  if cx.val_is_never(k, v) == 1 {
    let dr: u64 = ef.emit_default_return(k);
    ax.box_put(term, 1);
    return ax.skip_semi(g, nj);
  }
  let vt: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(t) == 1 {
    ty.ty_at(vt, t);

    if ty.tk(t) == 3 and ty.tsh(t) == 0 and ty.tsh(ty.vty(v)) != 0 {
      let sh: u64 = ty.tsh(ty.vty(v));
      let sv: u64 = ty.ty_set_sh(vt, sh);
    }
  } else {
    let vs: u64 = ty.tsh(ty.vty(v));
    if vs != 0 {
      if agg.shp_kind(vs) == agg.kind_string() {
        let id: u64 = ireg.ty_add(k, ireg.lk_bits(), 8, 0, 0);
        let sid: u64 = ct.slice_t(k, id, 0);
        let projected: u64 = ireg.project(k, sid, vt);
      } else {
        ty.ty_at(vt, ty.vty(v));
      }
    } else {
      ty.ty_at(vt, ty.vty(v));
    }
  }
  if ty.ty_known(vt) == 0 {

    let absent: u64 = if ty.vn(v) != 0 { 0 } else { 1 };
    let m1: Ref(u8) = "void value";
    let m2: Ref(u8) = "cannot infer type";
    let mv: Ref(u8) = if absent == 1 { m1 } else { m2 };
    let ml: u64 = if absent == 1 { 10 } else { 17 };
    let md: u64 = ir.diag(k, 0, 1, mv, ml);
    st.st_fail(k, ax.FailKind.Type as u64);
    return nj;
  }

  let cv: Mut(ty.Val) = ax.new_val(k);
  let c1: u64 = cx.coerce(k, v, ty.vty(v), vt, cv);
  if st.st_ok(k) != 0 { return nj; }
  let sl: u64 = st.st_next_slot(k);
  cx.slot_put(k, sl, cv, ty.vty(cv));
  env.env_push(k, name, sl, vt);
  let csh: u64 = ty.tsh(vt);
  if csh != 0 and agg.shp_has_drop(csh) == 1 {
    let fs: u64 = drop.new_alive_flag(k);
    let noff: u64 = env.env_find(k, name);
    env.env_set_alive_slot(k, noff, fs);
  }
  return ax.skip_semi(g, nj);
};

let stmt_assign = func(k: Mut(st.State), g: u64, i: u64, eqj: u64, term: Mut(u64)) -> u64 {
  let r: Mut(lv.LvalRec) = lv.rec_new(k);
  let a: u64 = lv.parse_base(k, g, i, r);
  if st.st_ok(k) != 0 { return eqj + 1; }
  let b: u64 = lv.parse_walk(k, g, a, eqj, r);
  if st.st_ok(k) != 0 { return eqj + 1; }
  let lock: u64 = lv.rec_lock(r);
  let mr: Ref(u8) = "read-only ref";
  let ms: Ref(u8) = "read-only slice";
  let mt: Ref(u8) = "read-only table";
  if lock == 1 { return lv.lval_bad(k, mr, 13, eqj + 1); }
  if lock == 2 { return lv.lval_bad(k, ms, 15, eqj + 1); }
  if lock == 3 { return lv.lval_bad(k, mt, 15, eqj + 1); }
  let t: Mut(ty.Ty) = lv.rec_ty(r);
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, g, eqj + 1, 0, t, v);
  if st.st_ok(k) != 0 { return j; }
  if ef.take_aborts(k) == 1 { return ax.skip_semi(g, j); }
  if cx.val_is_never(k, v) == 1 {
    let dr: u64 = ef.emit_default_return(k);
    ax.box_put(term, 1);
    return ax.skip_semi(g, j);
  }
  let c: Mut(ty.Val) = ax.new_val(k);
  let c1: u64 = cx.coerce(k, v, ty.vty(v), t, c);
  if st.st_ok(k) != 0 { return j; }
  let s0: u64 = lv.store_value(k, r, c);
  if eqj == i + 1 and ax.is_name(g, i) == 1 {
    let off: u64 = env.env_find(k, ax.n_sym(g, i));
    if off != 0 and env.env_is_noncopy(k, off) == 1 { drop.mark_alive(k, off); }
  }
  return ax.skip_semi(g, j);
};

let return_local = func(k: Mut(st.State), g: u64, j0: u64) -> u64 {
  let off: u64 = drop.bare_local(k, g, j0);
  if off != 0 and env.env_is_noncopy(k, off) == 1 { return drop.mark_relocated(k, off); }
  return 0;
};

let stmt_return = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64)) -> u64 {
  ax.box_put(term, 1);
  let ins: Mut(ef.InlineState) = ef.inline_top(k);
  if is_null(ins) == 0 {
    let ct: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), ins.tp);
    let j0: u64 = i + 1;
    let has: u64 = if j0 < ax.n_count(g) and ax.is_semi(g, j0) == 0 { 1 } else { 0 };
    let jj: u64 = if has == 1 {
      let v: Mut(ty.Val) = ax.new_val(k);
      let ej: u64 = core_expr(k, g, j0, 0, ct, v);
      if st.st_ok(k) == 0 and ty.val_known(v) == 1 {
        let c: Mut(ty.Val) = ax.new_val(k);
        cx.coerce(k, v, ty.vty(v), ct, c);
        if st.st_ok(k) == 0 { cx.slot_put(k, ins.slot, c, ct); }
      }
      let rl: u64 = return_local(k, g, j0);
      ej
    } else { j0 };
    drop.drop_all(k);
    ir.args_reset(k);
    ir.emit_jump(k, codes.InstKind.Break as u64, ins.label);
    return ax.skip_semi(g, jj);
  }
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_save(rt, st.st_retk(k), st.st_retw(k), st.st_retsg(k));
  let sh: u64 = ty.ty_set_sh(rt, st.st_retsh(k));
  let rp: u64 = st.st_retptr(k);
  let j0: u64 = i + 1;
  let has: u64 = if j0 < ax.n_count(g) and ax.is_semi(g, j0) == 0 { 1 } else { 0 };

  if rp != 0 and has == 1 {
    let v: Mut(ty.Val) = ax.new_val(k);
    let j: u64 = core_expr(k, g, j0, 0, rt, v);
    if st.st_ok(k) != 0 { return j; }
    if ef.take_aborts(k) == 1 { return ax.skip_semi(g, j); }
    let rl: u64 = return_local(k, g, j0);
    let c: Mut(ty.Val) = ax.new_val(k);
    let c1: u64 = cx.coerce(k, v, ty.vty(v), rt, c);
    if st.st_ok(k) != 0 { return j; }
    let sz: u64 = agg.shp_size(ty.tsh(rt));
    let cp: u64 = agg.copy_block(k, rp, ty.vn(c), sz);
    let dr: u64 = drop.drop_all(k);
    ir.args_reset(k);
    ir.emit_jump(k, codes.InstKind.Return as u64, 0);
    return ax.skip_semi(g, j);
  }
  let j: u64 = if has == 1 {
    let v: Mut(ty.Val) = ax.new_val(k);
    let ej: u64 = core_expr(k, g, j0, 0, rt, v);
    if st.st_ok(k) != 0 { return ej; }
    if ty.ty_known(rt) == 0 { st.st_fail(k, ax.FailKind.Type as u64); return ej; }
    let rl: u64 = return_local(k, g, j0);
    let c: Mut(ty.Val) = ax.new_val(k);
    cx.coerce(k, v, ty.vty(v), rt, c);
    drop.drop_all(k);
    ir.args_reset(k);
    cx.push_val(k, c);
    ej
  } else {
    drop.drop_all(k);
    ir.args_reset(k);
    j0
  };
  if ef.take_aborts(k) == 1 { return ax.skip_semi(g, j); }
  ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  return ax.skip_semi(g, j);
};

let break_value = func(k: Mut(st.State), bg: u64, resj: u64) -> u64 {
  let v: Mut(ty.Val) = ax.new_val(k);
  let noty: Mut(ty.Ty) = cx.tnone(k);
  let j: u64 = core_expr(k, bg, 0, 0, noty, v);
  if st.st_ok(k) != 0 { return j; }
  if resj != ax.no_slot() and ty.val_known(v) == 1 { cx.slot_put(k, resj, v, ty.vty(v)); }
  return j;
};

let stmt_break = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64)) -> u64 {
  ax.box_put(term, 1);
  let ho: Mut(cx.LoopHeadOut) = ptr_cast(Mut(cx.LoopHeadOut), st.st_alloc(k, 16));
  let j: u64 = cx.loop_head(k, g, i + 1, ho);
  let fi: u64 = cx.find_loop(k, ho.label, ho.has);
  if fi == ax.no_slot() { st.st_fail(k, ax.FailKind.Frame as u64); return j; }
  let f: Mut(st.LoopFrame) = st.st_lf(k, fi);
  let resj: u64 = st.st_lf_res(f);
  let j2: u64 = if j < ax.n_count(g) and ax.is_group(g, j) == 1 { break_value(k, ax.n_at(g, j), resj) } else { j };
  let dr: u64 = drop.drop_from(k, st.st_lf_mark(f));
  ir.args_reset(k);
  ir.emit_jump(k, codes.InstKind.Break as u64, st.st_lf_label(f));
  return ax.skip_semi(g, j2);
};

let cont_args = func(k: Mut(st.State), g: u64, i: u64, idx: u64, f: Mut(st.LoopFrame)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  let v: Mut(ty.Val) = ax.new_val(k);
  let noty: Mut(ty.Ty) = cx.tnone(k);
  let j: u64 = core_expr(k, g, i, 0, noty, v);
  if st.st_ok(k) != 0 { return j; }
  if idx < st.st_lf_np(f) and ty.val_known(v) == 1 {
    cx.slot_put(k, st.st_lf_slot(f, idx), v, ty.vty(v));
  }
  if ax.is_comma(g, j) == 1 { return cont_args(k, g, j + 1, idx + 1, f); }
  return j;
};

let stmt_continue = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64)) -> u64 {
  ax.box_put(term, 1);
  let ho: Mut(cx.LoopHeadOut) = ptr_cast(Mut(cx.LoopHeadOut), st.st_alloc(k, 16));
  let j: u64 = cx.loop_head(k, g, i + 1, ho);
  let fi: u64 = cx.find_loop(k, ho.label, ho.has);
  if fi == ax.no_slot() { st.st_fail(k, ax.FailKind.Frame as u64); return j; }
  let f: Mut(st.LoopFrame) = st.st_lf(k, fi);
  let j2: u64 = if j < ax.n_count(g) and ax.is_group(g, j) == 1 { cont_args(k, ax.n_at(g, j), 0, 0, f) } else { j };
  if st.st_ok(k) != 0 { return j2; }
  let dr: u64 = drop.drop_from(k, st.st_lf_mark(f));
  ir.args_reset(k);
  ir.emit_jump(k, codes.InstKind.Continue as u64, st.st_lf_label(f));
  return ax.skip_semi(g, j2);
};

let stmt_ctfor = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64)) -> u64 {
  let d: Mut(ctf.ForDesc) = ctf.for_open(k, g, i);
  if st.st_ok(k) != 0 { return i + 1; }
  let body: u64 = ctf.for_body(d);
  let ctmark: u64 = ctf.mark(k);
  let m0: u64 = ctf.for_step(k, d);
  let m1: u64 = loop step(m: u64 = m0) while m == 1 {
    let mark: u64 = env.env_mark(k);
    let j: u64 = block_mode(k, ax.n_at(g, body), 0, term, ax.no_slot(), cx.tnone(k));
    env.env_release(k, mark);
    ctf.release(k, ctmark);
    let bad: u64 = if st.st_ok(k) != 0 { 1 } else { 0 };
    let tbad: u64 = if ax.box_get(term) == 1 { 1 } else { bad };
    m = if tbad == 1 { 0 } else { ctf.for_step(k, d) };
  };
  ctf.release(k, ctmark);
  return body + 1;
};

let is_os_query = func(name: u64) -> u64 {
  if name == s.intern("target_os", 9) { return 1; }
  if name == s.intern("is_windows", 10) { return 1; }
  if name == s.intern("is_linux", 8) { return 1; }
  if name == s.intern("is_macos", 8) { return 1; }
  return 0;
};

let os_query_value = func(name: u64) -> u64 {
  let os_id: u64 = hr.get_target_os();
  if name == s.intern("is_windows", 10) { return if os_id == hr.OS_WINDOWS() { 1 } else { 0 }; }
  if name == s.intern("is_linux", 8) { return if os_id == hr.OS_LINUX() { 1 } else { 0 }; }
  if name == s.intern("is_macos", 8) { return if os_id == hr.OS_MACOS() { 1 } else { 0 }; }
  return os_id;
};

let cond_prec = func(g: u64, i: u64) -> u64 {
  if ax.is_group(g, i) == 1 { return 0; }
  let op: u64 = ax.n_sym(g, i);
  if op == s.k_or() { return 1; }
  if op == s.k_and() { return 2; }
  let p: u64 = ctp.ct_prio(g, i);
  if p == 0 { return 0; }
  return p + 2;
};

let cond_bin = func(k: Mut(st.State), op: u64, a: u64, b: u64) -> u64 {
  if op == s.k_or() { return if (a != 0) or (b != 0) { 1 } else { 0 }; }
  if op == s.k_and() { return if (a != 0) and (b != 0) { 1 } else { 0 }; }
  return ctp.ct_bin(k, op, a, b);
};

let cond_atom = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ctf.CtVal)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { ctf.fail_msg(k, "empty comptime if condition", 27, ax.FailKind.Ast as u64); return i; }
  let h: u64 = ax.n_at(g, i);
  if ax.is_group_node(h) == 1 {
    if ax.delim(h) == ax.Delim.Paren as u64 {
      let j: u64 = cond_expr(k, h, 0, 0, out);
      if st.st_ok(k) == 0 and j != ax.n_count(h) { ctf.fail_msg(k, "bad comptime if condition", 25, ax.FailKind.Ast as u64); }
      return i + 1;
    }
    ctf.fail_msg(k, "bad comptime if condition", 25, ax.FailKind.Ast as u64);
    return i + 1;
  }
  if ax.is_digit_token(g, i) == 1 {
    ctf.v_set(out, 0, ax.num_value(ax.lit_addr(h), ax.lit_len(h)), 0);
    return i + 1;
  }
  let name: u64 = ax.node_sym(h);
  if name == s.k_true() or name == s.k_false() {
    let b: u64 = if name == s.k_true() { 1 } else { 0 };
    ctf.v_set(out, 0, b, 0);
    return i + 1;
  }
  if name == 0 { ctf.fail_msg(k, "condition is not comptime-known", 31, ax.FailKind.Type as u64); return i + 1; }
  if i + 1 < n and ax.is_group(g, i + 1) == 1 and ax.delim_of(g, i + 1) == ax.Delim.Paren as u64 {
    let ag: u64 = ax.n_at(g, i + 1);
    if is_os_query(name) == 1 {
      if ax.n_count(ag) != 0 { ctf.fail_msg(k, "os query takes no args", 22, ax.FailKind.Ast as u64); return i + 2; }
      ctf.v_set(out, 0, os_query_value(name), 0);
      return i + 2;
    }
    if name == s.intern("size_of", 7) or name == s.intern("align_of", 8) or name == s.intern("field_count", 11) {
      let rc: u64 = ctf.prim(k, name, ag, out);
      return i + 2;
    }
  }
  let bv: Mut(ctf.CtVal) = ctf.lookup(k, name);
  if is_null(bv) == 0 {
    ctf.v_set(out, ctf.v_kind(bv), ctf.v_a(bv), ctf.v_b(bv));
    return i + 1;
  }
  ctf.fail_msg(k, "condition is not comptime-known", 31, ax.FailKind.Type as u64);
  return i + 1;
};

let cond_tail = func(k: Mut(st.State), g: u64, i: u64, minp: u64, out: Mut(ctf.CtVal)) -> u64 {
  if i >= ax.n_count(g) { return i; }
  let p: u64 = cond_prec(g, i);
  if (p == 0) or (p < minp) { return i; }
  if ctf.v_kind(out) != 0 { ctf.fail_msg(k, "condition needs integers", 24, ax.FailKind.Type as u64); return i; }
  let op: u64 = ax.n_sym(g, i);
  let rhs: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let j: u64 = cond_atom(k, g, i + 1, rhs);
  if st.st_ok(k) != 0 { return j; }
  let j2: u64 = cond_tail(k, g, j, p + 1, rhs);
  if st.st_ok(k) != 0 { return j2; }
  if ctf.v_kind(rhs) != 0 { ctf.fail_msg(k, "condition needs integers", 24, ax.FailKind.Type as u64); return j2; }
  ctf.v_set(out, 0, cond_bin(k, op, ctf.v_a(out), ctf.v_a(rhs)), 0);
  return cond_tail(k, g, j2, minp, out);
};

let cond_expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, out: Mut(ctf.CtVal)) -> u64 {
  let j: u64 = cond_atom(k, g, i, out);
  if st.st_ok(k) != 0 { return j; }
  return cond_tail(k, g, j, minp, out);
};

pub let comptime_cond = func(k: Mut(st.State), g: u64, i: u64, stop: u64) -> u64 {
  let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let j: u64 = cond_expr(k, g, i, 0, v);
  if st.st_ok(k) != 0 { return 0; }
  if j != stop { ctf.fail_msg(k, "condition is not comptime-known", 31, ax.FailKind.Ast as u64); return 0; }
  if ctf.v_kind(v) != 0 { ctf.fail_msg(k, "condition needs an integer value", 32, ax.FailKind.Type as u64); return 0; }
  return if ctf.v_a(v) != 0 { 1 } else { 0 };
};

pub let CtIf = struct {
  cond_i: u64,
  stop_i: u64,
  yes: u64,
  no: u64,
  next_i: u64
};

let brace_from = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  if ax.is_group(g, i) == 1 and ax.delim_of(g, i) == ax.Delim.Brace as u64 { return i; }
  return brace_from(g, i + 1, n);
};

pub let ctif_open = func(k: Mut(st.State), g: u64, i: u64) -> Mut(CtIf) {
  let n: u64 = ax.n_count(g);
  let b: u64 = brace_from(g, i + 2, n);
  let d: Mut(CtIf) = ptr_cast(Mut(CtIf), st.st_alloc(k, 40));
  d.cond_i = i + 2;
  d.stop_i = b;
  d.yes = 0;
  d.no = 0;
  d.next_i = i + 2;
  if b == 0 {
    ctf.fail_msg(k, "expected comptime if body", 25, ax.FailKind.Ast as u64);
    return d;
  }
  d.yes = ax.n_at(g, b);
  d.next_i = b + 1;
  if b + 2 < n and ax.is_group(g, b + 1) == 0 and ax.n_sym(g, b + 1) == s.k_else() {
    if ax.is_group(g, b + 2) == 1 and ax.delim_of(g, b + 2) == ax.Delim.Brace as u64 {
      d.no = ax.n_at(g, b + 2);
      d.next_i = b + 3;
    } else {
      ctf.fail_msg(k, "expected comptime else body", 27, ax.FailKind.Ast as u64);
    }
  }
  return d;
};

pub let ctif_body = func(k: Mut(st.State), g: u64, d: Mut(CtIf)) -> u64 {
  let t: u64 = comptime_cond(k, g, d.cond_i, d.stop_i);
  if st.st_ok(k) != 0 { return 0; }
  if t == 1 { return d.yes; }
  return d.no;
};

let stmt_ctif = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 {
  let d: Mut(CtIf) = ctif_open(k, g, i);
  if st.st_ok(k) != 0 { return d.next_i; }
  let body: u64 = ctif_body(k, g, d);
  if st.st_ok(k) != 0 { return d.next_i; }
  if body != 0 {
    let mark: u64 = env.env_mark(k);
    let t: Mut(u64) = ax.box(k);
    let j: u64 = block_mode(k, body, 0, t, slot, tp);
    env.env_release(k, mark);
    if ax.box_get(t) == 1 { ax.box_put(term, 1); }
  }
  return ax.skip_semi(g, d.next_i);
};

let stmt_discard = func(k: Mut(st.State), v: Mut(ty.Val)) -> u64 {
  let sh: u64 = ty.tsh(ty.vty(v));
  if agg.shp_has_drop(sh) == 0 { return 0; }
  let m: Ref(u8) = "discarded !Copy value; bind it with let";
  let d: u64 = ir.diag(k, 0, 1, m, 39);
  st.st_fail(k, ax.FailKind.Type as u64);
  return 0;
};

pub let stmt_while = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val), term: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(g);
  let d: u64 = st.st_loopdepth(k);
  if d >= 8 { st.st_fail(k, ax.FailKind.Frame as u64); return i + 1; }
  let label: u64 = ir.fresh_l(k);
  let f: Mut(st.LoopFrame) = st.st_lf(k, d);
  st.st_set_loopdepth(k, d + 1);
  st.st_set_lf_label(f, label);
  st.st_set_lf_np(f, 0);
  let mark: u64 = env.env_mark(k);
  st.st_set_lf_mark(f, mark);
  let wt: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(want) == 1 { ty.ty_at(wt, want); }
  let resj: u64 = if ty.ty_known(wt) == 1 { cx.alloc_res_slot(k) } else { ax.no_slot() };
  st.st_set_lf_res(f, resj);
  let noty: Mut(ty.Ty) = cx.tnone(k);
  let ct: Mut(ty.Ty) = cx.tbool(k);
  let r0: u64 = ir.region_begin(k);
  let cv: Mut(ty.Val) = ax.new_val(k);
  let cj: u64 = core_expr(k, g, i + 1, 0, noty, cv);
  if st.st_ok(k) != 0 { return cj; }
  let cb: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, cv, ty.vty(cv), ct, cb);
  if st.st_ok(k) != 0 { return cj; }
  let cn: u64 = cx.val_force(k, cb, ct);
  let body_ok: u64 = if cj < n {
    if ax.is_group(g, cj) == 1 and (ax.delim_of(g, cj) == ax.Delim.Brace as u64) { 1 } else { 0 }
  } else { 0 };
  if body_ok == 0 {
    let m: Ref(u8) = "while needs a body";
    let dg: u64 = ir.diag(k, 0, 1, m, 18);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return cj;
  }
  let bg: u64 = ax.n_at(g, cj);
  let bt: Mut(u64) = ax.box(k);
  let r1: u64 = ir.region_begin(k);
  let body_next: u64 = block_mode(k, bg, 0, bt, ax.no_slot(), noty);
  if ax.box_get(bt) == 0 {
    ir.args_reset(k);
    ir.emit_jump(k, codes.InstKind.Continue as u64, label);
  }
  let r1e: u64 = ir.region_end(k);
  ir.emit_if(k, 0, cn, r1e, 0);
  ir.args_reset(k);
  ir.emit_jump(k, codes.InstKind.Break as u64, label);
  let r2: u64 = ir.region_end(k);
  ir.emit_loop(k, 0, label, r2);
  st.st_set_loopdepth(k, d);
  env.env_release(k, mark);
  if resj != ax.no_slot() { cx.slot_get(k, resj, wt, out); } else { ty.val_none(out); }
  return cj + 1;
};

let stmt_mode = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  let h: u64 = ax.n_at(g, i);
  if ax.is_group_node(h) == 1 {
    if ax.delim(h) == ax.Delim.Brace as u64 {
      let mark: u64 = env.env_mark(k);
      let t: Mut(u64) = ax.box(k);
      let j: u64 = block_mode(k, h, 0, t, slot, tp);
      env.env_release(k, mark);
      if ax.box_get(t) == 1 { ax.box_put(term, 1); }
      return i + 1;
    }
    st.st_fail(k, ax.FailKind.Ast as u64);
    ax.box_put(term, 1);
    return i + 1;
  }
  let sym: u64 = ax.node_sym(h);
  if sym == s.k_let() { return stmt_let(k, g, i, term); }
  if sym == s.intern("given", 5) {
    let m: Ref(u8) = "legacy witness syntax removed";
    let d: u64 = ir.diag(k, 0, 1, m, 29);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return i + 1;
  }
  if sym == s.k_use() or sym == s.k_open() { return stmt_use(k, g, i); }
  if sym == s.k_if() {
    let v: Mut(ty.Val) = ax.new_val(k);
    let nt: Mut(ty.Ty) = cx.tnone(k);
    let hint: Mut(ty.Ty) = if slot == ax.no_slot() { nt } else { tp };
    let j: u64 = flow.if_compile(k, g, i, hint, v, term);
    if st.st_ok(k) != 0 { return j; }
    if slot != ax.no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
    return ax.skip_semi(g, j);
  }
  if sym == s.k_while() {
    let v: Mut(ty.Val) = ax.new_val(k);
    let nt: Mut(ty.Ty) = cx.tnone(k);
    let hint: Mut(ty.Ty) = if slot == ax.no_slot() { nt } else { tp };
    let j: u64 = stmt_while(k, g, i, hint, v, term);
    if st.st_ok(k) != 0 { return j; }
    if slot != ax.no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
    return ax.skip_semi(g, j);
  }
  if sym == s.k_loop() {
    let v: Mut(ty.Val) = ax.new_val(k);
    let nt: Mut(ty.Ty) = cx.tnone(k);
    let hint: Mut(ty.Ty) = if slot == ax.no_slot() { nt } else { tp };
    let j: u64 = flow.loop_compile(k, g, i, hint, v, term);
    if st.st_ok(k) != 0 { return j; }
    if slot != ax.no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
    return ax.skip_semi(g, j);
  }
  if sym == s.k_match() {
    let v: Mut(ty.Val) = ax.new_val(k);
    let nt: Mut(ty.Ty) = cx.tnone(k);
    let hint: Mut(ty.Ty) = if slot == ax.no_slot() { nt } else { tp };
    let j: u64 = flow.match_compile(k, g, i, hint, v, term);
    if st.st_ok(k) != 0 { return j; }
    if slot != ax.no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
    return ax.skip_semi(g, j);
  }
  if sym == s.k_return() { return stmt_return(k, g, i, term); }
  if sym == s.k_break() { return stmt_break(k, g, i, term); }
  if sym == s.k_continue() { return stmt_continue(k, g, i, term); }
  if sym == s.k_func() or sym == s.k_extern() or sym == s.k_struct() {
    st.st_fail(k, ax.FailKind.Unsup as u64);
    ax.box_put(term, 1);
    return i + 1;
  }
  if sym == s.k_enum() or sym == s.k_import() {
    st.st_fail(k, ax.FailKind.Unsup as u64);
    ax.box_put(term, 1);
    return i + 1;
  }
  if sym == s.k_comptime() {
    if i + 1 < n and ax.n_sym(g, i + 1) == s.k_for() { return stmt_ctfor(k, g, i, term); }
    if i + 1 < n and ax.n_sym(g, i + 1) == s.k_if() { return stmt_ctif(k, g, i, term, slot, tp); }
    if i + 1 >= n or ax.n_sym(g, i + 1) != s.p_dot() {
      st.st_fail(k, ax.FailKind.Unsup as u64);
      ax.box_put(term, 1);
      return i + 1;
    }
  }
  let eqj: u64 = lv.find_eq(g, i, n);
  if eqj != 0 { return stmt_assign(k, g, i, eqj, term); }
  let v: Mut(ty.Val) = ax.new_val(k);
  let nt: Mut(ty.Ty) = cx.tnone(k);
  let hint: Mut(ty.Ty) = if slot == ax.no_slot() { nt } else { tp };
  let j: u64 = core_expr(k, g, i, 0, hint, v);
  if st.st_ok(k) != 0 { return j; }
  if ef.take_aborts(k) == 1 {
    ax.box_put(term, 1);
    return ax.skip_semi(g, j);
  }
  if cx.val_is_never(k, v) == 1 {
    let dr: u64 = ef.emit_default_return(k);
    ax.box_put(term, 1);
    return ax.skip_semi(g, j);
  }
  if slot != ax.no_slot() and ty.val_known(v) == 1 {
    let cv: Mut(ty.Val) = ax.new_val(k);
    let dst_t: Mut(ty.Ty) = if ty.ty_known(tp) == 1 { tp } else { ty.vty(v) };
    cx.coerce(k, v, ty.vty(v), dst_t, cv);
    cx.slot_put(k, slot, cv, dst_t);
  } else {
    let dv: u64 = stmt_discard(k, v);
  }
  return ax.skip_semi(g, j);
};

let block_walk = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  let t: Mut(u64) = ax.box(k);
  let j: u64 = stmt_mode(k, g, i, t, slot, tp);
  if st.st_ok(k) != 0 { return j; }
  if ax.box_get(t) == 1 { ax.box_put(term, 1); return j; }
  return block_walk(k, g, j, term, slot, tp);
};

pub let block_mode = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 {
  let gm: u64 = gv.mark(k);
  let ctm: u64 = ctf.mark(k);
  let em: u64 = env.env_mark(k);
  let r: u64 = block_walk(k, g, i, term, slot, tp);

  if ax.box_get(term) == 0 { let dr: u64 = drop.drop_from(k, em); }
  gv.release(k, gm);
  ctf.release(k, ctm);
  return r;
};

@root
let lainc_stmt_block = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 {
  return block_mode(k, g, i, term, slot, tp);
};
