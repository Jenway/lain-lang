let st = import("src::driver::state");
let ty = import("src::sema::types");
let env = import("src::sema::env");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let s = import("src::driver::sym");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let agg = import("src::sema::agg");
let modules = import("src::sema::modules");
let bi = import("src::sema::builtins");
let cpt = import("src::comptime::comptime");
let rf = import("src::comptime::reflect");
let ireg = import("src::sema::tyreg");
let ct = import("src::comptime::ctypes");
let lv = import("src::sema::lval");
let an = import("src::sema::anon");
let cl = import("src::sema::calls");
let flow = import("src::sema::flow");
let sm = import("src::sema::stmt");
let me = import("src::sema::member");
let rv = import("src::sema::refval");
let ctf = import("src::comptime::ctfor");
let ctfn = import("src::comptime::ctfn");
let gv = import("src::sema::witness");
let gn = import("src::sema::generics");
let ef = import("src::sema::effects");

let expr_tail = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if st.st_ok(k) != 0 { return i; }

  if ax.is_group(g, i) == 0 {
    if ax.n_sym(g, i) == s.k_as() {
      let t: Mut(ty.Ty) = ax.new_ty(k);
      let j: u64 = cx.parse_type(k, g, i + 1, t);
      let c: Mut(ty.Val) = ax.new_val(k);
      cx.cast_value(k, out, ty.vty(out), t, c);
      ty.val_at(out, c);
      return expr_tail(k, g, j, minp, want, out);
    }
  }

  if ax.is_group(g, i) == 1 {
    if ax.delim_of(g, i) == ax.Delim.Bracket as u64 { return sub_expr(k, g, i, minp, want, out); }
    if ax.delim_of(g, i) == ax.Delim.Paren as u64 {
      if rv.fn_val_p(k, out) == 1 { return rv.postfix_call(k, g, i, minp, want, out); }
    }
  }
  if ax.is_group(g, i) == 0 {
    if ax.n_sym(g, i) == s.p_dot() {
      if i + 1 < n {
        let plain: u64 = ax.is_name(g, i + 1);
        let interp: u64 = ctf.interp_at(g, i + 1);
        if plain == 1 or interp == 1 {
          return rv.member_on_val(k, g, i, minp, want, out);
        }
      }
    }
    if ax.n_sym(g, i) == s.p_bang() {
      let pr: u64 = ef.propagate(k);
      return expr_tail(k, g, i + 1, minp, want, out);
    }
  }
  let op: u64 = if ax.is_group(g, i) == 0 { ax.n_sym(g, i) } else { 0 };
  let p: u64 = ty.prec(op);
  if p == 0 { return i; }
  if p < minp { return i; }

  let rv_val: Mut(ty.Val) = ax.new_val(k);

  let is_logic: u64 = if op == s.k_and() or op == s.k_or() { 1 } else { 0 };
  let hint: Mut(ty.Ty) = if is_logic == 1 { cx.tnone(k) } else {
    if ty.tk(ty.vty(out)) == 3 { cx.t64(k) } else { ty.vty(out) }
  };
  let rj: u64 = expr(k, g, i + 1, p + 1, hint, rv_val);
  if st.st_ok(k) != 0 { return rj; }
  let lt: Mut(ty.Ty) = ty.vty(out);
  let rt: Mut(ty.Ty) = ty.vty(rv_val);
  let opt: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(lt) == 1 {
    ty.ty_at(opt, lt);
  } else {
    if ty.ty_known(rt) == 1 { ty.ty_at(opt, rt); } else {
      if ty.ty_known(want) == 1 { ty.ty_at(opt, want); } else { ty.ty_i32(opt); }
    }
  }

  if ty.tk(opt) == 3 {
    if op == s.o_plus() {
      if ty.tk(lt) == 3 and ty.tk(rt) != 3 {
        let res: u64 = lea_emit(k, out, rv_val, ty.vty(out));
        let at: Mut(ty.Ty) = ax.new_ty(k);
        ty.ty_at(at, ty.vty(out));
        ty.val_ref(out, res, at);
        return expr_tail(k, g, rj, minp, want, out);
      }
      if ty.tk(rt) == 3 and ty.tk(lt) != 3 {
        let res2: u64 = lea_emit(k, rv_val, out, ty.vty(rv_val));
        let at2: Mut(ty.Ty) = ax.new_ty(k);
        ty.ty_at(at2, ty.vty(rv_val));
        ty.val_ref(out, res2, at2);
        return expr_tail(k, g, rj, minp, want, out);
      }
    }
    let dzs: u64 = ir.diag(k, st.st_src(k), 34, "binsrc", 6);
    let dzo: u64 = ir.diag(k, op, 32, modules.sym_addr(op), modules.sym_len(op));
    st.st_fail(k, ax.FailKind.Op as u64);
    return rj;
  }
  let lv: Mut(ty.Val) = ax.new_val(k);
  let rvv: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, out, lt, opt, lv);
  cx.coerce(k, rv_val, rt, opt, rvv);
  let kind: u64 = ty.bin_inst(op, ty.tsg(opt));
  if kind == 999 { let dz9: u64 = ir.diag(k, op, 33, modules.sym_addr(op), modules.sym_len(op)); st.st_fail(k, ax.FailKind.Op as u64); return rj; }
  let rest: Mut(ty.Ty) = ax.new_ty(k);
  ty.result_ty(op, opt, rest);
  ir.args_reset(k);
  cx.push_val(k, lv);
  cx.push_val(k, rvv);
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, kind, res, opt);
  ty.val_ref(out, res, rest);
  return expr_tail(k, g, rj, minp, want, out);
};

pub let expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let j: u64 = expr_prefix(k, g, i, want, out);
  if st.st_ok(k) != 0 { return j; }
  return expr_tail(k, g, j, minp, want, out);
};

@root
let lainc_core_expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  return expr(k, g, i, minp, want, out);
};

@root
let lainc_core_tail = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  return expr_tail(k, g, i, minp, want, out);
};

let prefix_neg = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let j: u64 = i + 1;
  if j >= ax.n_count(g) { st.st_fail(k, ax.FailKind.Ast as u64); return j; }
  if ax.is_digit_token(g, j) == 0 { st.st_fail(k, ax.FailKind.Unsup as u64); return j; }
  let h: u64 = ax.n_at(g, j);
  let pa: Ref(u8) = ax.lit_addr(h);
  let pl: u64 = ax.lit_len(h);
  let v: u64 = ax.num_value(pa, pl);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(want) == 1 and ty.tw(want) > 1 { ty.ty_at(t, want); } else { ty.ty_i32(t); }
  ir.args_reset(k);
  ir.arg_int(k, 0);
  ir.arg_int(k, v);
  let res: u64 = ir.fresh_t(k);
  ir.emit(k, codes.InstKind.Sub as u64, res, t);
  ty.val_ref(out, res, t);
  return j + 1;
};

let reflect_prefix = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  if ax.is_name(g, i) == 0 { return 0; }
  let m: u64 = rf.mode_of(ax.n_sym(g, i));
  if m == 0 {
    let tv: u64 = rf.type_value(k, g, i, out);
    if tv == 1 { return i + 1; }
    return 0;
  }
  if i + 1 >= ax.n_count(g) { return 0; }
  if ax.is_group(g, i + 1) != 1 { return 0; }
  let pr: u64 = rf.prepare(k);
  if st.st_ok(k) != 0 { return i + 2; }
  let pg: u64 = ax.n_at(g, i + 1);
  let v1: Mut(ty.Val) = ax.new_val(k);
  let v2: Mut(ty.Val) = ax.new_val(k);
  let pair: u64 = if m >= 6 and m <= 9 { 1 } else { 0 };
  let j1: u64 = if m == 10 { 0 } else { expr(k, pg, 0, 0, cx.t64(k), v1) };
  if st.st_ok(k) != 0 { return i + 2; }
  let bad: u64 = rf.bad_id(k, m, v1);
  if bad == 1 { return i + 2; }
  let j2: u64 = if pair == 1 { expr(k, pg, 2, 0, cx.t64(k), v2) } else { 0 };
  if st.st_ok(k) != 0 { return i + 2; }
  let ok: u64 = rf.query(k, m, v1, v2, want, out);
  if ok == 0 { st.st_fail(k, ax.FailKind.Unsup as u64); }
  return i + 2;
};

let brace_struct_at = func(k: Mut(st.State), sym: u64) -> u64 {
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, sym);
  if is_null(e) { return 0; }
  let t: Mut(modules.SymEntry) = cx.self_entry(k, e);
  let kd: u64 = modules.sym_kind(t);
  if kd == modules.sym_kind_struct() { return 1; }
  if kd == modules.sym_kind_type_alias() {
    let sh: u64 = ireg.ty_shape(k, modules.sym_qual(t));
    if sh != 0 {
      if agg.shp_kind(sh) == agg.kind_struct() { return 1; }
    }
  }
  return 0;
};

let expr_prefix = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { st.st_fail(k, ax.FailKind.Ast as u64); return i; }
  let h: u64 = ax.n_at(g, i);
  if ax.is_group_node(h) == 1 {
    let dl: u64 = ax.delim(h);
    if dl == ax.Delim.Paren as u64 {
      let j: u64 = expr(k, h, 0, 0, want, out);
      return i + 1;
    }
    if dl == ax.Delim.Bracket as u64 { return arr_lit(k, g, i, want, out); }
    st.st_fail(k, ax.FailKind.Ast as u64);
    return i + 1;
  }
  if ax.is_digit_token(g, i) == 1 {
    let t: Mut(ty.Ty) = ax.new_ty(k);
    if ty.ty_known(want) == 1 and ty.tw(want) > 1 { ty.ty_at(t, want); } else { ty.ty_i32(t); }
    let pa: Ref(u8) = ax.lit_addr(h);
    let pl: u64 = ax.lit_len(h);
    let v: u64 = ax.num_value(pa, pl);
    ty.val_lit(out, v, t);
    return i + 1;
  }
  if ax.tok_first(g, i) == 34 { return str_lit(k, g, i, out); }
  let sym: u64 = ax.node_sym(h);
  if sym == s.k_true() or sym == s.k_false() {
    let t: Mut(ty.Ty) = cx.tbool(k);
    let b: u64 = if sym == s.k_true() { 1 } else { 0 };
    ty.val_lit(out, b, t);
    return i + 1;
  }

  if sym == s.k_func() {
    if i + 1 < n and ax.is_group(g, i + 1) == 1 {
      return an.func_expr(k, g, i, want, out);
    }
  }
  if sym == s.k_eval() {
    if i + 1 < n and ax.is_group(g, i + 1) == 1 {
      if ax.delim_of(g, i + 1) == ax.Delim.Paren as u64 { return eval_call(k, g, i, want, out); }
    }
  }
  if sym == s.t_type() {
    let m: Ref(u8) = "type is compile-time only";
    let d: u64 = ir.diag(k, 0, 1, m, 25);
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return i + 1;
  }
  if sym == s.k_perform() { return ef.perform_expr(k, g, i, want, out); }
  if sym == s.k_handle() { return ef.handle_expr(k, g, i, want, out); }
  if sym == s.k_resume() { return ef.resume_expr(k, g, i, want, out); }
  if sym == s.k_effect() {
    let m: Ref(u8) = "effect is compile-time only";
    let d: u64 = ir.diag(k, 0, 1, m, 27);
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return i + 1;
  }
  if sym == s.k_if() {
    let t: Mut(u64) = ax.box(k);
    return flow.if_compile(k, g, i, want, out, t);
  }
  if sym == s.k_while() {
    let t: Mut(u64) = ax.box(k);
    return sm.stmt_while(k, g, i, want, out, t);
  }
  if sym == s.k_loop() {
    let t: Mut(u64) = ax.box(k);
    return flow.loop_compile(k, g, i, want, out, t);
  }
  if sym == s.k_match() {
    let t: Mut(u64) = ax.box(k);
    return flow.match_compile(k, g, i, want, out, t);
  }
  if sym == s.o_minus() { return prefix_neg(k, g, i, want, out); }

  if i + 2 < n and ax.is_group(g, i + 1) == 0 and ax.is_name(g, i) == 1 {
    if ax.n_sym(g, i + 1) == s.p_dot() and ax.is_name(g, i + 2) == 1 {
      if env.env_find(k, sym) == 0 {
        let wf: Mut(gv.WField) = gv.witness_field_at(k, g, i);
        if st.st_ok(k) != 0 { return i + 3; }
        if is_null(wf) == 0 {
          let fk: u64 = wf.fkind;
          let fa: u64 = wf.fa;
          if fk == 8 and i + 3 < n and ax.is_group(g, i + 3) == 1 and ax.delim_of(g, i + 3) == ax.Delim.Paren as u64 {
            let se: Mut(modules.SymEntry) = ptr_cast(Mut(modules.SymEntry), fa);
            cl.call_sig(k, modules.sym_qual(se), modules.sym_sig(se), ax.n_at(g, i + 3), want, out);
            return i + 4;
          }
          if fk == 0 { ty.val_lit(out, fa, cx.t64(k)); return i + 3; }
        }
        let pv: Mut(ctf.CtVal) = ctf.proj_at(k, g, i);
        if is_null(pv) == 0 {
          if ctf.v_kind(pv) == 0 {
            ty.val_lit(out, ctf.v_a(pv), cx.t64(k));
            return i + 3;
          }
          if ctf.v_kind(pv) == 3 {
            emit_str_data(k, ptr_cast(Ref(u8), ctf.v_a(pv)), ctf.v_b(pv), out);
            return i + 3;
          }
          let m: Ref(u8) = "type is compile-time only";
          let d: u64 = ir.diag(k, 0, 1, m, 25);
          st.st_fail(k, ax.FailKind.Unsup as u64);
          return i + 3;
        }
      }
      let bv: u64 = ef.bare_variant(k, g, i, want, out);
      if bv != 0 { return bv; }
      return me.dotted(k, g, i, want, out);
    }
  }

  if i + 3 < n and ax.is_name(g, i) == 1 and ax.is_group(g, i + 1) == 1 {
    if ax.delim_of(g, i + 1) == ax.Delim.Paren as u64 and ax.is_group(g, i + 2) == 0 and ax.n_sym(g, i + 2) == s.p_dot() and ax.is_name(g, i + 3) == 1 {
      let mv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
      let mj: u64 = ctfn.eval_factory_call(k, g, i, mv);
      if mj != 0 {
        if st.st_ok(k) != 0 { return mj; }
        if ctf.v_kind(mv) == 9 {
          let modv: u64 = ctf.v_a(mv);
          let seal: u64 = ctf.v_b(mv);
          let me_e: Mut(modules.SymEntry) = modules.sym_lookup_in(k, modv, seal, ax.n_sym(g, i + 3), modules.cur(k));
          if is_null(me_e) {
            let um: Ref(u8) = "unbound module member";
            let ud: u64 = ir.diag(k, 0, 1, um, 21);
            st.st_fail(k, ax.FailKind.Unbound as u64);
            return i + 4;
          }
          return me.member_entry(k, g, i + 3, me_e, want, out);
        }
        if ctf.v_kind(mv) == 1 {
          let tm: Ref(u8) = "type is compile-time only";
          let td: u64 = ir.diag(k, 0, 1, tm, 25);
          st.st_fail(k, ax.FailKind.Unsup as u64);
          return i + 4;
        }
      }
    }
  }

  if i + 2 < n and ax.is_name(g, i) == 1 and ax.is_group(g, i + 1) == 1 and ax.is_group(g, i + 2) == 1 {
    if ax.delim_of(g, i + 1) == ax.Delim.Paren as u64 and ax.delim_of(g, i + 2) == ax.Delim.Brace as u64 {
      let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
      let fj: u64 = ctfn.eval_factory_call(k, g, i, tv);
      if fj != 0 {
        if st.st_ok(k) != 0 { return i + 3; }
        if ctf.v_kind(tv) != 1 {
          let nm0: Ref(u8) = "type factory expected";
          let nd0: u64 = ir.diag(k, 0, 1, nm0, 21);
          st.st_fail(k, ax.FailKind.Type as u64);
          return i + 3;
        }
        let sh: u64 = ireg.ty_shape(k, ctf.v_a(tv));
        if sh == 0 { st.st_fail(k, ax.FailKind.Type as u64); return i + 3; }
        me.agg_construct_sh(k, sh, ax.n_at(g, i + 2), out);
        return i + 3;
      }
    }
  }

  if i + 1 < n and ax.is_name(g, i) == 1 and ax.is_group(g, i + 1) == 1 {
    if ax.delim_of(g, i + 1) == ax.Delim.Brace as u64 {
      if brace_struct_at(k, sym) == 1 {
        return me.agg_construct(k, g, i, out);
      }
    }
  }

  let rq: u64 = reflect_prefix(k, g, i, want, out);
  if rq != 0 { return rq; }

  if sym == s.b_icall() and i + 2 < n {
    if ax.is_group(g, i + 1) == 1 and ax.is_group(g, i + 2) == 1 {
      return cl.icall_call(k, g, i, want, out);
    }
  }
  if i + 1 < n and ax.is_group(g, i + 1) == 1 {
    if ax.delim_of(g, i + 1) == ax.Delim.Paren as u64 {
      let ue: Mut(modules.SymEntry) = ctf.find_sym(k, sym);
      if bi.is_builtin(sym) == 1 and is_null(ue) == 1 { return me.builtin_call(k, g, i, want, out); }

      let qc: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
      let qh: u64 = ctf.query_fold(k, qc, g, i);
      if st.st_ok(k) != 0 { return i + 2; }
      if qh == 1 {
        ty.val_lit(out, ctf.v_a(qc), cx.t64(k));
        return i + 2;
      }

      let fo: u64 = env.env_find(k, sym);
      if fo != 0 {
        let ft: Mut(ty.Ty) = ax.new_ty(k);
        env.env_ty(k, fo, ft);
        let fsh: u64 = ty.tsh(ft);
        if fsh != 0 {
          if agg.shp_kind(fsh) == agg.kind_fn() {
            let fv: Mut(ty.Val) = ax.new_val(k);
            let fj: u64 = cl.var_ref(k, g, i, cx.tnone(k), fv);
            let pf: u64 = rv.postfix_call(k, g, i + 1, 0, want, fv);
            let ig: u64 = fj;
            ty.val_at(out, fv);
            return pf;
          }
        }
      }

      let ge: Mut(modules.SymEntry) = ctf.find_sym(k, sym);
      if is_null(ge) == 0 {
        if modules.sym_kind(ge) == modules.sym_kind_generic() {
          let nb: Mut(u64) = ax.box(k);
          gn.call_generic(k, ge, g, i, want, out, nb);
          let nxt: u64 = ax.box_get(nb);
          return nxt;
        }
      }
      let cj: u64 = cl.call_expr(k, g, i, want, out);
      let se2: Mut(modules.SymEntry) = ctf.find_sym(k, sym);
      let cg: u64 = ef.call_guard(k, se2, g, i + 2);
      return cj;
    }
    if ax.delim_of(g, i + 1) == ax.Delim.Bracket as u64 and sym == s.b_icall() {
      return cl.icall_call(k, g, i, want, out);
    }
  }

  if env.env_find(k, sym) == 0 {
    let cv: Mut(ctf.CtVal) = ctf.lookup(k, sym);
    if is_null(cv) == 0 {
      if ctf.v_kind(cv) == 0 {
        ty.val_lit(out, ctf.v_a(cv), cx.t64(k));
        return i + 1;
      }
      let m: Ref(u8) = "type is compile-time only";
      let d: u64 = ir.diag(k, 0, 1, m, 25);
      st.st_fail(k, ax.FailKind.Unsup as u64);
      return i + 1;
    }
  }
  return cl.var_ref(k, g, i, want, out);
};

let eval_fail = func(k: Mut(st.State), tmp: u64, saved_mod: u64, saved_sp: u64, code: u64, out: Mut(ty.Val), back: u64) -> u64 {
  cpt.release(tmp);
  st.st_set_mod(k, saved_mod);
  st.st_set_sp(k, saved_sp);
  ty.val_none(out);
  st.st_fail(k, code);
  return back;
};

let eval_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let pg: u64 = ax.n_at(g, i + 1);
  let saved_mod: u64 = st.st_mod(k);
  let saved_sp: u64 = st.st_sp(k);
  env.env_release(k, 0);
  let tmp: u64 = cpt.clone(k);
  st.st_set_mod(k, tmp);

  let pr: u64 = rf.prepare(k);
  if st.st_ok(k) != 0 {
    return eval_fail(k, tmp, saved_mod, saved_sp, st.st_err(k), out, i + 2);
  }
  let ename: u64 = cpt.entry_name();
  ir.proc_begin(k, ename);
  ir.region_begin(k);
  let nslots: u64 = 4 + cx.count_tree(pg, 0);
  cx.emit_slots(k, 0, nslots);
  let tv: Mut(ty.Val) = ax.new_val(k);
  expr(k, pg, 0, 0, cx.tnone(k), tv);
  if st.st_ok(k) != 0 {
    return eval_fail(k, tmp, saved_mod, saved_sp, st.st_err(k), out, i + 2);
  }
  if ty.val_known(tv) == 0 {
    return eval_fail(k, tmp, saved_mod, saved_sp, ax.FailKind.Type as u64, out, i + 2);
  }
  let vt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_at(vt, ty.vty(tv));
  if ty.tk(vt) == 3 or ty.ty_byte_ok(vt) == 0 {
    return eval_fail(k, tmp, saved_mod, saved_sp, ax.FailKind.Type as u64, out, i + 2);
  }
  ir.proc_result(k, vt);
  ir.args_reset(k);
  cx.push_val(k, tv);
  ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  ir.region_end(k);
  let vrc: u64 = cpt.verify(tmp);
  if vrc != 0 {
    let vm: Ref(u8) = "eval-verify";
    let vd: u64 = ir.diag(k, vrc, 1, vm, 11);
    return eval_fail(k, tmp, saved_mod, saved_sp, ax.FailKind.Unsup as u64, out, i + 2);
  }
  let ob: Mut(u8) = cpt.out_buf();
  ir.args_reset(k);
  let arc: u64 = cpt.apply_scalar(tmp, ename, ob);
  let w0: Mut(u64) = ptr_cast(Mut(u64), ob);
  let w1: Mut(u64) = ptr_cast(Mut(u64), ob + 8);
  let rc: u64 = if arc != 0 { arc } else { deref(w0) };
  if rc != 0 {
    let am: Ref(u8) = "eval-apply";
    let ad: u64 = ir.diag(k, rc, 1, am, 10);
    return eval_fail(k, tmp, saved_mod, saved_sp, ax.FailKind.Unsup as u64, out, i + 2);
  }
  let bits: u64 = deref(w1);
  cpt.release(tmp);
  st.st_set_mod(k, saved_mod);
  st.st_set_sp(k, saved_sp);
  ty.val_lit(out, bits, vt);
  cx.coerce(k, out, vt, want, out);
  return i + 2;
};

let lea_emit = func(k: Mut(st.State), base: Mut(ty.Val), idx: Mut(ty.Val), t: Mut(ty.Ty)) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, base);
  let b: u64 = ir.op_val(k, idx);
  let c: u64 = ir.arg_int(k, 1);
  let d: u64 = ir.arg_int(k, 0);
  let ins: u64 = ir.emit(k, codes.InstKind.Lea as u64, res, t);
  return res;
};

let elem_of_arr = func(k: Mut(st.State), sh: u64, et: Mut(ty.Ty)) -> u64 {
  let elem: Mut(agg.Member) = agg.mem_index(sh, 0);
  let r: u64 = agg.mem_ty(k, elem, et);
  return agg.type_size(agg.mem_k(elem), agg.mem_w(elem), agg.mem_sh(elem));
};

let elem_of_slice = func(k: Mut(st.State), sh: u64, et: Mut(ty.Ty)) -> u64 {
  let r: u64 = ct.elem_ty(k, sh, et);
  return ct.elem_size(k, sh);
};

let sub_expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let bg: u64 = ax.n_at(g, i);
  let uw: u64 = rv.unwrap_ref(k, out);
  let ignored_uw: u64 = uw;
  let bt: Mut(ty.Ty) = ty.vty(out);
  let sh: u64 = ty.tsh(bt);
  if sh == 0 { st.st_fail(k, ax.FailKind.Type as u64); return i + 1; }
  let kd: u64 = agg.shp_kind(sh);
  let sliced: u64 = if kd == agg.kind_slice() or kd == agg.kind_mutslice() { 1 } else { 0 };
  let base: Mut(ty.Val) = ax.new_val(k);
  if sliced == 1 {
    let lv_val: Mut(ty.Val) = ax.new_val(k);
    let l: u64 = agg.load_at(k, ty.vn(out), 0, ir.taddr(k), lv_val);
    ty.val_at(base, lv_val);
  } else {
    ty.val_at(base, out);
  }
  let nt: Mut(ty.Ty) = ax.new_ty(k);
  let u: u64 = ty.ty_u64(nt);
  let iv: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = expr(k, bg, 0, 0, nt, iv);
  let et: Mut(ty.Ty) = ax.new_ty(k);
  let ew: u64 = if sliced == 1 { elem_of_slice(k, sh, et) } else { elem_of_arr(k, sh, et) };
  let at: Mut(ty.Ty) = ax.new_ty(k);
  let a1: u64 = ty.ty_addr(at);
  let a2: u64 = ty.ty_set_sh(at, ty.tsh(et));
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, base);
  let b: u64 = ir.op_val(k, iv);
  let c: u64 = ir.arg_int(k, ew);
  let d: u64 = ir.arg_int(k, 0);
  let ins: u64 = ir.emit(k, codes.InstKind.Lea as u64, res, ir.taddr(k));
  let ignored: u64 = j;
  if sliced == 1 {

    let ev: Mut(ty.Val) = ax.new_val(k);
    if rv.deref_loads(ty.tsh(et)) == 1 {
      let el: u64 = agg.load_at(k, res, 0, et, ev);
    } else {
      let ev2: u64 = ty.val_ref(ev, res, et);
    }
    ty.val_at(out, ev);
  } else {
    let static_table: u64 = agg.shp_static(sh);
    if static_table == 1 {
      ty.val_ref(out, res, at);
    } else {
      let ev: Mut(ty.Val) = ax.new_val(k);
      if rv.deref_loads(ty.tsh(et)) == 1 {
        let el: u64 = agg.load_at(k, res, 0, et, ev);
      } else {
        let ev2: u64 = ty.val_ref(ev, res, et);
      }
      ty.val_at(out, ev);
    }
  }
  return expr_tail(k, g, i + 1, minp, want, out);
};

let arr_fill = func(k: Mut(st.State), g: u64, i: u64, idx: u64, base: u64, esz: u64, et: Mut(ty.Ty),
              cnt: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if idx >= cnt { return i; }
  if ax.is_comma(g, i) == 1 { return arr_fill(k, g, i + 1, idx, base, esz, et, cnt); }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = expr(k, g, i, 0, et, v);
  let c: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), et, c);
  let s_res: u64 = agg.store_at(k, base, idx * esz, c, et);
  return arr_fill(k, g, j, idx + 1, base, esz, et, cnt);
};

let rep_sep = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  if ax.is_semi(g, i) == 1 { return i + 1; }
  return rep_sep(g, i + 1, n);
};

let rep_len = func(k: Mut(st.State), g: u64, i: u64, n: u64) -> u64 {
  if i + 1 != n {
    let m: Ref(u8) = "array repeat needs a compile-time length";
    let d: u64 = ir.diag(k, 0, 1, m, 40);
    st.st_fail(k, ax.FailKind.Type as u64);
    return 0;
  }
  if ax.is_digit_token(g, i) == 1 {
    let h: u64 = ax.n_at(g, i);
    return ax.num_value(ax.lit_addr(h), ax.lit_len(h));
  }
  if ax.is_name(g, i) == 1 {
    let cv: Mut(ctf.CtVal) = ctf.lookup(k, ax.n_sym(g, i));
    if is_null(cv) == 0 and ctf.v_kind(cv) == 0 { return ctf.v_a(cv); }
  }
  let m: Ref(u8) = "array repeat needs a compile-time length";
  let d: u64 = ir.diag(k, 0, 1, m, 40);
  st.st_fail(k, ax.FailKind.Type as u64);
  return 0;
};

let rep_fill = func(k: Mut(st.State), base: u64, cnt: u64, esz: u64,
               val: Mut(ty.Val), et: Mut(ty.Ty)) -> u64 {
  let done: u64 = loop f(j: u64 = 0) while j < cnt {
    let s: u64 = agg.store_at(k, base, j * esz, val, et);
    j = j + 1;
  };
  return done;
};

let arr_rep = func(k: Mut(st.State), g: u64, i: u64, grp: u64, sep: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = ax.n_count(grp);
  let cnt: u64 = rep_len(k, grp, sep, n);
  if st.st_ok(k) != 0 { return i + 1; }
  if cnt == 0 {
    let m: Ref(u8) = "array repeat length must be positive";
    let d: u64 = ir.diag(k, 0, 1, m, 36);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  let wsh: u64 = ty.tsh(want);
  let shaped: u64 = if wsh == 0 { 0 } else {
    if agg.shp_kind(wsh) == agg.kind_array() { 1 } else { 0 }
  };
  let et: Mut(ty.Ty) = ax.new_ty(k);
  if shaped == 1 {
    if agg.shp_len(wsh) != cnt {
      let m: Ref(u8) = "array repeat length mismatch";
      let d: u64 = ir.diag(k, 0, 1, m, 28);
      st.st_fail(k, ax.FailKind.Type as u64);
      return i + 1;
    }
    let elem: Mut(agg.Member) = agg.mem_index(wsh, 0);
    let e1: u64 = agg.mem_ty(k, elem, et);
  }

  let hint: Mut(ty.Ty) = ax.new_ty(k);
  if shaped == 1 { ty.ty_at(hint, et); } else { ty.ty_bits(hint, 64, 1); }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = expr(k, grp, 0, 0, hint, v);
  if st.st_ok(k) != 0 { return i + 1; }
  if shaped == 0 {
    if ty.ty_known(ty.vty(v)) == 0 { st.st_fail(k, ax.FailKind.Type as u64); return i + 1; }
    ty.ty_at(et, ty.vty(v));
  }
  let esh: u64 = ty.tsh(et);
  if agg.shp_has_drop(esh) == 1 {
    let m: Ref(u8) = "array repeat element is not Copy";
    let d: u64 = ir.diag(k, 0, 1, m, 32);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  let c: Mut(ty.Val) = ax.new_val(k);
  let c1: u64 = cx.coerce(k, v, ty.vty(v), et, c);
  if st.st_ok(k) != 0 { return i + 1; }
  let sh: u64 = if shaped == 1 { wsh } else {
    agg.array_new(k, agg.kind_array(), cnt, ty.tk(et), ty.tw(et), ty.tsg(et), ty.tsh(et))
  };
  let size: u64 = agg.shp_size(sh);
  let objv: Mut(ty.Val) = ax.new_val(k);
  let base: u64 = agg.new_bytes(k, size, agg.shp_align(sh), objv);
  let zero: u64 = if ty.vlit(c) == 1 and ty.vbits(c) == 0 { 1 } else { 0 };
  if zero == 1 {
    let z: u64 = agg.zero_at(k, base, 0, size);
  } else {
    let esz: u64 = agg.type_size(ty.tk(et), ty.tw(et), ty.tsh(et));
    let filled: u64 = rep_fill(k, base, cnt, esz, c, et);
  }
  let at: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_addr(at);
  ty.ty_set_sh(at, sh);
  ty.val_ref(out, base, at);
  return i + 1;
};

let arr_lit = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let grp: u64 = ax.n_at(g, i);
  let sep: u64 = rep_sep(grp, 0, ax.n_count(grp));
  if sep != 0 { return arr_rep(k, g, i, grp, sep, want, out); }
  let cnt: u64 = bi.table_cnt(grp, 0, ax.n_count(grp), 0);
  let wsh: u64 = ty.tsh(want);
  let ok: u64 = if wsh == 0 { 0 } else {
    if agg.shp_kind(wsh) == agg.kind_array() {
      if agg.shp_len(wsh) == cnt { 1 } else { 0 }
    } else { 0 }
  };
  if ok == 0 {
    let m: Ref(u8) = "array-literal";
    let d: u64 = ir.diag(k, cnt, 1, m, 13);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 1;
  }
  let elem: Mut(agg.Member) = agg.mem_index(wsh, 0);
  let et: Mut(ty.Ty) = ax.new_ty(k);
  let e1: u64 = agg.mem_ty(k, elem, et);
  let esz: u64 = agg.type_size(agg.mem_k(elem), agg.mem_w(elem), agg.mem_sh(elem));
  let objv: Mut(ty.Val) = ax.new_val(k);
  let base: u64 = agg.new_bytes(k, agg.shp_size(wsh), agg.shp_align(wsh), objv);
  let filled: u64 = arr_fill(k, grp, 0, 0, base, esz, et, cnt);
  ty.val_at(out, objv);
  return i + 1;
};

let emit_str_data = func(k: Mut(st.State), text: Ref(u8), len: u64, out: Mut(ty.Val)) -> u64 {
  let src: u64 = st.st_src(k);
  let seq: u64 = st.st_next_str(k);
  let pre: u64 = strlit_prefix(k);
  let dname: u64 = modules.qual_num(k, src, pre, seq);
  let sh: u64 = bi.string_data(k, dname, text, len);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let a: u64 = ty.ty_addr(t);
  let s2: u64 = ty.ty_set_sh(t, sh);
  ty.val_ref(out, dname, t);
  return dname;
};

let str_lit = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Val)) -> u64 {
  let h: u64 = ax.n_at(g, i);
  let text: Ref(u8) = ax.lit_addr(h) + 1;
  let len: u64 = ax.lit_len(h) - 2;
  emit_str_data(k, text, len, out);
  return i + 1;
};

let strlit_prefix = func(k: Mut(st.State)) -> u64 {
  let p: Mut(u8) = st.st_scratch(k) + 64;
  let ps: MutSlice(u8) = make_slice(MutSlice(u8), p, 8);
  ps[0] = 115;
  ps[1] = 116;
  ps[2] = 114;
  ps[3] = 108;
  ps[4] = 105;
  ps[5] = 116;
  ps[6] = 95;
  return ir.sym_lit(p, 7);
};
