let st = import("src::driver::state");
let ty = import("src::sema::types");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let s = import("src::driver::sym");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let agg = import("src::sema::agg");
let modules = import("src::sema::modules");
let ireg = import("src::sema::tyreg");
let ctf = import("src::comptime::ctfor");
let ctfn = import("src::comptime::ctfn");
let tb = import("src::sema::tbuild");
let env = import("src::sema::env");
let cl = import("src::sema::calls");
let drop = import("src::sema::drop");
let hr = import("src::driver::host_rt");
let row = import("src::sema::effects::row");
let infer = import("src::sema::effects::infer");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;
extern effects_block(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 = lainc_stmt_block;

let n_count = func(g: u64) -> u64 { return ax.n_count(g); };
let n_at = func(g: u64, i: u64) -> u64 { return ax.n_at(g, i); };
let n_sym = func(g: u64, i: u64) -> u64 { return ax.n_sym(g, i); };
let is_group = func(g: u64, i: u64) -> u64 { return ax.is_group(g, i); };
let delim_of = func(g: u64, i: u64) -> u64 { return ax.delim_of(g, i); };
let is_name = func(g: u64, i: u64) -> u64 { return ax.is_name(g, i); };
let is_comma = func(g: u64, i: u64) -> u64 { return ax.is_comma(g, i); };
let is_semi = func(g: u64, i: u64) -> u64 { return ax.is_semi(g, i); };
let dl_brace = func() -> u64 { return ax.Delim.Brace as u64; };
let dl_paren = func() -> u64 { return ax.Delim.Paren as u64; };
let no_slot = func() -> u64 { return ax.no_slot(); };
let new_ty = func(k: Mut(st.State)) -> Mut(ty.Ty) { return ax.new_ty(k); };
let new_val = func(k: Mut(st.State)) -> Mut(ty.Val) { return ax.new_val(k); };
let box = func(k: Mut(st.State)) -> Mut(u64) { return ax.box(k); };
let box_get = func(p: Mut(u64)) -> u64 { return ax.box_get(p); };
let box_put = func(p: Mut(u64), v: u64) -> u64 { return ax.box_put(p, v); };
let parse_type = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 { return cx.parse_type(k, g, i, out); };
let t64 = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.t64(k); };
let tnone = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.tnone(k); };
let emit_slots = func(k: Mut(st.State), j: u64, n: u64) -> u64 { return cx.emit_slots(k, j, n); };

pub let register_effect = func(k: Mut(st.State), name: u64, bodyg: u64, param_tid: u64, is_pub: u64) -> Mut(modules.SymEntry) {
  let se: Mut(modules.SymEntry) = modules.sym_add(k, row.kind_effect(), modules.cur(k), name, param_tid, null_ref(Mut(u8)), bodyg);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  return se;
};

pub let effect_rhs = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64) -> u64 {
  let n: u64 = n_count(g);
  if e >= n { return 0; }
  if n_sym(g, e) == s.k_effect() {
    if e + 1 < n and is_group(g, e + 1) == 1 and delim_of(g, e + 1) == dl_brace() {
      let se: Mut(modules.SymEntry) = register_effect(k, name, n_at(g, e + 1), 0, is_pub);
      return e + 2;
    }
    return 0;
  }
  if is_name(g, e) == 0 { return 0; }
  if e + 1 >= n { return 0; }
  if is_group(g, e + 1) == 0 { return 0; }
  if delim_of(g, e + 1) != dl_paren() { return 0; }
  let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let j: u64 = ctfn.eval_factory_call(k, g, e, v);
  if j == 0 { return 0; }
  if st.st_ok(k) != 0 { return j; }
  if ctf.v_kind(v) != 11 { return 0; }
  let se2: Mut(modules.SymEntry) = register_effect(k, name, ctf.v_a(v), ctf.v_b(v), is_pub);
  return j;
};

pub let effect_symbol = func(k: Mut(st.State), name: u64) -> Mut(modules.SymEntry) {
  let se: Mut(modules.SymEntry) = ctf.find_sym(k, name);
  if is_null(se) { return se; }
  if modules.sym_kind(se) != row.kind_effect() { return null_ref(Mut(modules.SymEntry)); }
  return se;
};

let state_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_state", 11);
};

let ensure_state = func(k: Mut(st.State)) -> u64 {
  let nm: u64 = state_name(k);
  if ir.data_find(k, nm) != 0 { return nm; }
  let buf: Mut(u8) = st.st_databuf(k) + st.st_dataused(k);
  let zs: MutSlice(u8) = make_slice(MutSlice(u8), buf, 32);
  let z: u64 = loop w(i: u64 = 0) while i < 32 {
    zs[i] = 0;
    i = i + 1;
  };
  let used: u64 = st.st_set_dataused(k, st.st_dataused(k) + 32);
  let add: u64 = ir.data_add(k, nm, buf, 32, 1);
  return nm;
};

let state_addr = func(k: Mut(st.State)) -> u64 {
  let nm: u64 = ensure_state(k);
  let res: u64 = ir.fresh_t(k);
  let e: u64 = ir.emit_lea(k, res, nm, 0, 1, 0);
  return res;
};

let load_u64 = func(k: Mut(st.State), base: u64, off: u64) -> u64 {
  let p: u64 = agg.off_of(k, base, off);
  let t: Mut(ty.Ty) = t64(k);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, p);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, res, t, 0);
  return res;
};

let store_lit = func(k: Mut(st.State), base: u64, off: u64, bits: u64) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let v: Mut(ty.Val) = new_val(k);
  ty.val_lit(v, bits, t);
  return agg.store_at(k, base, off, v, t);
};

let store_val = func(k: Mut(st.State), base: u64, off: u64, v: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let c: Mut(ty.Val) = new_val(k);
  let rc: u64 = cx.coerce(k, v, ty.vty(v), t, c);
  return agg.store_at(k, base, off, c, t);
};

let handler_top_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_top", 9);
};

let handler_cur_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_hcur", 10);
};

let handler_frames_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_hframes", 13);
};

let hframe_bytes = func() -> u64 { return 16384; };

let trap_depth_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_trap", 10);
};

let ensure_global = func(k: Mut(st.State), nm: u64, size: u64) -> u64 {
  if ir.data_find(k, nm) != 0 { return nm; }
  let buf: Mut(u8) = st.st_databuf(k) + st.st_dataused(k);
  let zs: MutSlice(u8) = make_slice(MutSlice(u8), buf, size);
  let z: u64 = loop w(i: u64 = 0) while i < size {
    zs[i] = 0;
    i = i + 1;
  };
  let used: u64 = st.st_set_dataused(k, st.st_dataused(k) + size);
  let add: u64 = ir.data_add(k, nm, buf, size, 1);
  return nm;
};

let ensure_handler = func(k: Mut(st.State)) -> u64 {
  return ensure_global(k, handler_top_name(k), 8);
};

let ensure_hcur = func(k: Mut(st.State)) -> u64 {
  return ensure_global(k, handler_cur_name(k), 8);
};

let ensure_hframes = func(k: Mut(st.State)) -> u64 {
  return ensure_global(k, handler_frames_name(k), hframe_bytes());
};

let ensure_trap_depth = func(k: Mut(st.State)) -> u64 {
  return ensure_global(k, trap_depth_name(k), 8);
};

let pay_top_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_paytop", 12);
};

let pay_arena_name = func(k: Mut(st.State)) -> u64 {
  return ir.sym_lit("__eff_payarena", 14);
};

let pay_arena_bytes = func() -> u64 { return 65536; };

let ensure_pay_top = func(k: Mut(st.State)) -> u64 {
  return ensure_global(k, pay_top_name(k), 8);
};

let pay_arena_ptr = func(k: Mut(st.State)) -> Mut(ty.Val) {
  let nm: u64 = ensure_global(k, pay_arena_name(k), pay_arena_bytes());
  let res: u64 = ir.fresh_t(k);
  let e: u64 = ir.emit_lea(k, res, nm, 0, 1, 0);
  let v: Mut(ty.Val) = new_val(k);
  let vr: u64 = ty.val_ref(v, res, ir.taddr(k));
  return v;
};

let pay_top_load = func(k: Mut(st.State)) -> u64 {
  let g: u64 = ensure_pay_top(k);
  return load_u64(k, g, 0);
};

let pay_top_reset = func(k: Mut(st.State)) -> u64 {
  let g: u64 = ensure_pay_top(k);
  return store_lit(k, g, 0, 0);
};

let trap_depth_load = func(k: Mut(st.State)) -> u64 {
  let g: u64 = ensure_trap_depth(k);
  return load_u64(k, g, 0);
};

let trap_depth_step = func(k: Mut(st.State), kind: u64, delta: u64) -> u64 {
  let g: u64 = ensure_trap_depth(k);
  let cur: u64 = load_u64(k, g, 0);
  let t: Mut(ty.Ty) = t64(k);
  let res: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, cur);
  let b: u64 = ir.arg_int(k, delta);
  let ins: u64 = ir.emit(k, kind, res, t);
  let v: Mut(ty.Val) = new_val(k);
  ty.val_ref(v, res, t);
  let s0: u64 = store_val(k, g, 0, v);
  return res;
};

let emit_trap = func(k: Mut(st.State), payload: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let pv: Mut(ty.Val) = new_val(k);
  let pc: u64 = cx.coerce(k, payload, ty.vty(payload), t, pv);
  let zero: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let a1: u64 = ir.op_val(k, pv);
  let a2: u64 = ir.op_val(k, pv);
  let sub: u64 = ir.emit(k, codes.InstKind.Sub as u64, zero, t);
  let res: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let b1: u64 = ir.arg_int(k, 1);
  let b2: u64 = ir.arg_ref(k, zero);
  let div: u64 = ir.emit(k, codes.InstKind.UDiv as u64, res, t);
  let rv: Mut(ty.Val) = new_val(k);
  ty.val_ref(rv, res, t);
  let base: u64 = state_addr(k);
  let s1: u64 = store_val(k, base, 0, rv);
  return res;
};

let proc_addr = func(k: Mut(st.State), name: u64) -> Mut(ty.Val) {
  let at: Mut(ty.Ty) = ir.taddr(k);
  let res: u64 = ir.fresh_t(k);
  let e: u64 = ir.emit_lea(k, res, name, 0, 1, 0);
  let v: Mut(ty.Val) = new_val(k);
  let vr: u64 = ty.val_ref(v, res, at);
  return v;
};

let as_addr = func(k: Mut(st.State), v: Mut(ty.Val)) -> Mut(ty.Val) {
  let at: Mut(ty.Ty) = ir.taddr(k);
  let out: Mut(ty.Val) = new_val(k);
  let c: u64 = cx.coerce(k, v, ty.vty(v), at, out);
  return out;
};

let as_u64 = func(k: Mut(st.State), v: Mut(ty.Val)) -> Mut(ty.Val) {
  let t: Mut(ty.Ty) = t64(k);
  let out: Mut(ty.Val) = new_val(k);
  let c: u64 = cx.coerce(k, v, ty.vty(v), t, out);
  return out;
};

let u64_val = func(k: Mut(st.State), name: u64) -> Mut(ty.Val) {
  let v: Mut(ty.Val) = new_val(k);
  ty.val_ref(v, name, t64(k));
  return v;
};

let add_imm = func(k: Mut(st.State), a: u64, imm: u64) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let res: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let x: u64 = ir.arg_ref(k, a);
  let y: u64 = ir.arg_int(k, imm);
  let ins: u64 = ir.emit(k, codes.InstKind.Add as u64, res, t);
  return res;
};

let add_val = func(k: Mut(st.State), a: u64, b: u64) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let res: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let x: u64 = ir.arg_ref(k, a);
  let y: u64 = ir.arg_ref(k, b);
  let ins: u64 = ir.emit(k, codes.InstKind.Add as u64, res, t);
  return res;
};

let cond_u64 = func(k: Mut(st.State), kind: u64, a: u64, imm: u64) -> u64 {
  let t: Mut(ty.Ty) = t64(k);
  let res: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  let x: u64 = ir.arg_ref(k, a);
  let y: u64 = ir.arg_int(k, imm);
  let ins: u64 = ir.emit(k, kind, res, t);
  return res;
};

let alloc_dyn_slot = func(k: Mut(st.State)) -> u64 {
  let n: u64 = st.st_next_tmp(k);
  let j: u64 = 1000000 + n;
  let nm: u64 = ir.slot_name(k, j);
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  ir.args_reset(k);
  let a: u64 = ir.arg_int(k, 8);
  ir.emit_mem(k, codes.InstKind.Alloca as u64, nm, t8, 0);
  ir.args_reset(k);
  let z: u64 = ir.arg_int(k, 0);
  let r: u64 = ir.arg_ref(k, nm);
  ir.emit_mem(k, codes.InstKind.Store as u64, 0, ir.tbits(k, 64), 0);
  return j;
};

let payload_stable = func(k: Mut(st.State), payload: Mut(ty.Val)) -> Mut(ty.Val) {
  let pt: Mut(ty.Ty) = ty.vty(payload);
  let t: Mut(ty.Ty) = t64(k);
  let out: Mut(ty.Val) = new_val(k);
  if agg.is_value_agg(pt) == 0 {
    let rc: u64 = cx.coerce(k, payload, pt, t, out);
    return out;
  }
  let size: u64 = agg.shp_size(ty.tsh(pt));
  let aligned: u64 = ((size + 7) / 8) * 8;
  let used: u64 = pay_top_load(k);
  let next: u64 = add_imm(k, used, aligned);
  let basev: Mut(ty.Val) = pay_arena_ptr(k);
  let baseu: Mut(ty.Val) = as_u64(k, basev);
  let off: u64 = add_val(k, ty.vn(baseu), used);
  let rawv: Mut(ty.Val) = new_val(k);
  let rawl: u64 = ty.val_ref(rawv, off, t);
  let dsta: Mut(ty.Val) = new_val(k);
  let dstr: u64 = cx.coerce(k, rawv, t, ir.taddr(k), dsta);
  let dst: u64 = ty.vn(dsta);
  let over: u64 = cond_u64(k, codes.InstKind.UGt as u64, next, pay_arena_bytes());
  let okl: u64 = ir.region_begin(k);
  let cp: u64 = agg.copy_block(k, dst, ty.vn(payload), size);
  let okr: u64 = ir.region_end(k);
  let badl: u64 = ir.region_begin(k);
  let bad: u64 = ir.emit_jump(k, codes.InstKind.Unreachable as u64, 0);
  let badr: u64 = ir.region_end(k);
  let ifi: u64 = ir.emit_if(k, 0, over, badr, okr);
  let nv: Mut(ty.Val) = new_val(k);
  let nvl: u64 = ty.val_ref(nv, next, t);
  let g: u64 = ensure_pay_top(k);
  let ns: u64 = store_val(k, g, 0, nv);
  let vr: u64 = ty.val_at(out, dsta);
  return out;
};

let arm_payload_copy = func(k: Mut(st.State), sl: u64, pt: Mut(ty.Ty), cv: Mut(ty.Val)) -> u64 {
  if agg.is_value_agg(pt) == 1 {
    let size: u64 = agg.shp_size(ty.tsh(pt));
    let obj: Mut(ty.Val) = new_val(k);
    let buf: u64 = agg.new_bytes(k, size, 8, obj);
    let cp: u64 = agg.copy_block(k, ty.vn(obj), ty.vn(cv), size);
    return cx.slot_put(k, sl, obj, pt);
  }
  return cx.slot_put(k, sl, cv, pt);
};

let push_eff_frame = func(k: Mut(st.State), fnname: u64) -> u64 {
  let g: u64 = ensure_handler(k);
  let gc: u64 = ensure_hcur(k);
  let gf: u64 = ensure_hframes(k);
  let u64t: Mut(ty.Ty) = t64(k);

  let cur0: u64 = load_u64(k, gc, 0);
  let cinit: u64 = cond_u64(k, codes.InstKind.Eq as u64, cur0, 0);
  let ir0: u64 = ir.region_begin(k);
  let f0n: u64 = ir.fresh_t(k);
  let e0: u64 = ir.emit_lea(k, f0n, gf, 0, 1, 0);
  let f0a: Mut(ty.Val) = new_val(k);
  let f0r: u64 = ty.val_ref(f0a, f0n, ir.taddr(k));
  let f0v: Mut(ty.Val) = as_u64(k, f0a);
  let s0: u64 = store_val(k, gc, 0, f0v);
  let ir0e: u64 = ir.region_end(k);
  let if0: u64 = ir.emit_if(k, 0, cinit, ir0e, 0);
  let cur: u64 = load_u64(k, gc, 0);
  let cura: Mut(ty.Val) = as_addr(k, u64_val(k, cur));
  let top: u64 = load_u64(k, g, 0);
  let s1: u64 = store_val(k, ty.vn(cura), 0, proc_addr(k, fnname));
  let s2: u64 = store_val(k, ty.vn(cura), 8, u64_val(k, top));
  let s3: u64 = agg.store_at(k, g, 0, cura, ir.taddr(k));
  let nxt: u64 = add_imm(k, cur, 16);
  let s4: u64 = store_val(k, gc, 0, u64_val(k, nxt));
  let slot: u64 = alloc_dyn_slot(k);
  let s5: u64 = cx.slot_put(k, slot, cura, ir.taddr(k));
  return slot;
};

let pop_eff_frame = func(k: Mut(st.State), slot: u64) -> u64 {
  let g: u64 = ensure_handler(k);
  let gc: u64 = ensure_hcur(k);
  let at: Mut(ty.Ty) = ir.taddr(k);
  let fv: Mut(ty.Val) = new_val(k);
  let sg: u64 = cx.slot_get(k, slot, at, fv);
  let prev: u64 = load_u64(k, ty.vn(fv), 8);
  let s0: u64 = store_val(k, g, 0, u64_val(k, prev));
  let fu: Mut(ty.Val) = as_u64(k, fv);
  let s1: u64 = store_val(k, gc, 0, fu);
  return 1;
};

pub let emit_default_return = func(k: Mut(st.State)) -> u64 {
  let dr: u64 = drop.drop_all_cold(k);
  let rt: Mut(ty.Ty) = new_ty(k);
  let a: u64 = ty.ty_save(rt, st.st_retk(k), st.st_retw(k), st.st_retsg(k));
  let b: u64 = ty.ty_set_sh(rt, st.st_retsh(k));
  let sr: u64 = agg.sret_ty(rt);
  ir.args_reset(k);
  if sr == 0 and ty.ty_known(rt) == 1 {
    let c: u64 = ir.arg_int(k, 0);
  }
  return ir.emit_jump(k, codes.InstKind.Return as u64, 0);
};

pub let propagate = func(k: Mut(st.State)) -> u64 {
  let nm: u64 = ensure_state(k);
  let stv: u64 = load_u64(k, nm, 0);
  let t: Mut(ty.Ty) = t64(k);
  let cond: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, stv);
  let b: u64 = ir.arg_int(k, 0);
  let cmp: u64 = ir.emit(k, codes.InstKind.Ne as u64, cond, t);
  let r: u64 = ir.region_begin(k);
  let d: u64 = emit_default_return(k);
  let re: u64 = ir.region_end(k);
  return ir.emit_if(k, 0, cond, re, 0);
};

let eff_seq = func(k: Mut(st.State), bodyg: u64, param_tid: u64) -> u64 {
  let c: Mut(row.EffCtx) = row.ctx(k);
  let fb: Mut(u64) = box(k);
  let done: u64 = loop sc(i: u64 = 0) while i < c.sn {
    let p: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), c.seqs) + i * 24);
    let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
    let pb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 16);
    if (deref(p) == bodyg) and ((deref(pa) == param_tid) or (param_tid == 0)) {
      box_put(fb, i + 1);
      break sc(i + 1);
    }
    i = i + 1;
  };
  let hit: u64 = box_get(fb);
  if hit != 0 { return hit; }
  let idx: u64 = c.sn;
  if idx >= c.scap { return 1; }
  let q: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), c.seqs) + idx * 24);
  let qa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), q) + 8);
  let qb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), q) + 16);
  deref(q) = bodyg;
  deref(qa) = param_tid;
  deref(qb) = 0;
  c.sn = idx + 1;
  return idx + 1;
};

let runtime_tag = func(k: Mut(st.State), bodyg: u64, param_tid: u64, op_index: u64) -> u64 {
  let seq: u64 = eff_seq(k, bodyg, param_tid);
  return seq * 256 + op_index;
};

pub let resume_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let r: Mut(row.ResumeState) = row.top_resume(k);
  let n: u64 = n_count(g);
  if is_null(r) {
    let m: Ref(u8) = "resume outside handler";
    let d: u64 = ir.diag(k, n_at(g, i), 1, m, 22);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return i + 1;
  }
  if r.ret_tid == tb.never_tid(k) {
    let m2: Ref(u8) = "cannot resume abortive effect";
    let d2: u64 = ir.diag(k, n_at(g, i), 1, m2, 29);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  if r.count >= 1 {
    let m3: Ref(u8) = "one-shot continuation resumed multiple times";
    let d3: u64 = ir.diag(k, n_at(g, i), 1, m3, 44);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  if st.st_loopdepth(k) > r.base_loop {
    let m4: Ref(u8) = "one-shot continuation resumed multiple times";
    let d4: u64 = ir.diag(k, n_at(g, i), 1, m4, 44);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  r.count = r.count + 1;
  let rt: Mut(ty.Ty) = new_ty(k);
  let pj: u64 = ireg.project(k, r.ret_tid, rt);
  let j: u64 = i + 1;
  if j < n and is_group(g, j) == 1 and delim_of(g, j) == dl_paren() {
    let pg: u64 = n_at(g, j);
    if n_count(pg) == 0 {
      ty.val_none(out);
    } else {
      let v: Mut(ty.Val) = new_val(k);
      let ej: u64 = core_expr(k, pg, 0, 0, rt, v);
      if r.mode == 0 {
        ty.val_at(out, v);
      } else {
        let base: u64 = state_addr(k);
        let sv: u64 = store_val(k, base, 16, v);
        let sz: u64 = store_lit(k, base, 0, 0);
        let so: u64 = store_lit(k, base, 24, 1);
        ty.val_at(out, v);
      }
    }
    return j + 1;
  }
  ty.val_none(out);
  return j;
};

let payload_bits = func(k: Mut(st.State), argsg: u64, info: Mut(row.OpInfo)) -> Mut(ty.Val) {
  let v: Mut(ty.Val) = new_val(k);
  if info.np == 0 {
    let t: Mut(ty.Ty) = t64(k);
    ty.val_lit(v, 0, t);
    return v;
  }
  if info.np > 1 {
    let m: Ref(u8) = "effect op needs one payload";
    let d: u64 = ir.diag(k, 0, 1, m, 27);
    st.st_fail(k, ax.FailKind.Unsup as u64);
    ty.val_none(v);
    return v;
  }
  let tid: u64 = row.op_param_tid(k, info);
  let pt: Mut(ty.Ty) = new_ty(k);
  let pj: u64 = ireg.project(k, tid, pt);
  let j: u64 = core_expr(k, argsg, 0, 0, pt, v);
  return v;
};

let inline_handler = func(k: Mut(st.State), bodyg: u64, param_tid: u64) -> Mut(row.HandlerRec) {
  let c: Mut(row.EffCtx) = row.ctx(k);
  let i: u64 = c.hn;
  let found: Mut(row.HandlerRec) = null_ref(Mut(row.HandlerRec));
  let done: u64 = loop h(i: u64 = c.hn) while i > 0 {
    let hp: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), c.handlers) + (i - 1) * 8);
    let hr: Mut(row.HandlerRec) = ptr_cast(Mut(row.HandlerRec), deref(hp));
    let j: u64 = loop a(j: u64 = 0) while j < hr.n {
      let arm: Mut(row.HArm) = ptr_cast(Mut(row.HArm), ptr_cast(Mut(u8), hr.arms) + j * 88);
      if arm.kind == 1 and arm.has_resume == 1 and arm.abortive == 0 {
        if (arm.bodyg == bodyg) and ((arm.param_tid == param_tid) or (param_tid == 0) or (arm.param_tid == 0)) {
          return hr;
        }
      }
      j = j + 1;
    };
    i = i - 1;
  };
  return found;
};

let arm_inline = func(k: Mut(st.State), h: Mut(row.HandlerRec), bodyg: u64, param_tid: u64, payload: Mut(ty.Val), info: Mut(row.OpInfo), out: Mut(ty.Val)) -> u64 {
  let n: u64 = h.n;
  let a: Mut(row.HArm) = null_ref(Mut(row.HArm));
  let found: u64 = loop f(i: u64 = 0) while i < n {
    let ar: Mut(row.HArm) = ptr_cast(Mut(row.HArm), ptr_cast(Mut(u8), h.arms) + i * 88);
    if ar.kind == 1 and ar.has_resume == 1 and ar.abortive == 0 {
      if (ar.bodyg == bodyg) and ((ar.param_tid == param_tid) or (param_tid == 0) or (ar.param_tid == 0)) {
        a = ar;
        break f(1);
      }
    }
    i = i + 1;
  };
  if found == 0 { return 0; }
  let mark: u64 = env.env_mark(k);
  if a.bind != 0 {
    let sl: u64 = st.st_next_slot(k);
    let pt: Mut(ty.Ty) = new_ty(k);
    let pj: u64 = ireg.project(k, a.param_tid, pt);
    let cv: Mut(ty.Val) = new_val(k);
    let rc: u64 = cx.coerce(k, payload, ty.vty(payload), pt, cv);
    cx.slot_put(k, sl, cv, pt);
    env.env_push(k, a.bind, sl, pt);
  }
  let rt: Mut(ty.Ty) = new_ty(k);
  let rj: u64 = ireg.project(k, info.ret_tid, rt);
  let pr: u64 = row.push_resume(k, 0, info.ret_tid, st.st_loopdepth(k));
  let term: Mut(u64) = box(k);
  let slot: u64 = if ty.ty_known(rt) == 1 { alloc_dyn_slot(k) } else { no_slot() };
  if a.blk == 1 {
    let bg: u64 = n_at(h.ag, a.body);
    let bj: u64 = effects_block(k, bg, 0, term, slot, rt);
  } else {
    let v: Mut(ty.Val) = new_val(k);
    let ej: u64 = core_expr(k, h.ag, a.body, 0, rt, v);
    if st.st_ok(k) == 0 and slot != no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
  }
  let pp: u64 = row.pop_resume(k);
  if slot != no_slot() {
    cx.slot_get(k, slot, rt, out);
  } else {
    ty.val_none(out);
  }
  env.env_release(k, mark);
  if st.st_ok(k) != 0 { return 1; }
  return 1;
};

let resumable_dispatch = func(k: Mut(st.State), tag: u64, payload: Mut(ty.Val), info: Mut(row.OpInfo), out: Mut(ty.Val)) -> u64 {
  let g: u64 = ensure_handler(k);
  let u64t: Mut(ty.Ty) = t64(k);
  let at: Mut(ty.Ty) = ir.taddr(k);
  let topa: Mut(ty.Val) = new_val(k);
  let topl: u64 = agg.load_at(k, g, 0, at, topa);
  let topu: Mut(ty.Val) = new_val(k);
  let topc: u64 = cx.coerce(k, topa, at, u64t, topu);
  let cond: u64 = cond_u64(k, codes.InstKind.Ne as u64, ty.vn(topu), 0);
  let slot: u64 = alloc_dyn_slot(k);
  let tr: u64 = ir.region_begin(k);

  let sa0: u64 = state_addr(k);
  let sc0: u64 = store_lit(k, sa0, 0, 0);
  let fnv: Mut(ty.Val) = new_val(k);
  let fnl: u64 = agg.load_at(k, ty.vn(topa), 0, at, fnv);
  let pv: Mut(ty.Val) = new_val(k);
  let pc: u64 = cx.coerce(k, payload, ty.vty(payload), u64t, pv);
  let item: u64 = 1 + 64 * 256;
  let plo: u64 = item + item * 65536 + item * 16777216;
  ir.args_reset(k);
  let tgt: u64 = ir.arg_ref(k, ty.vn(fnv));
  let t1: u64 = ir.arg_int(k, tag);
  let t2: u64 = ir.op_val(k, pv);
  let t3: u64 = ir.arg_ref(k, ty.vn(topu));
  let rv: u64 = ir.fresh_t(k);
  let ic: u64 = ir.emit_call_indirect(k, rv, u64t, plo, 0);
  let rvv: Mut(ty.Val) = new_val(k);
  ty.val_ref(rvv, rv, u64t);
  let sp: u64 = cx.slot_put(k, slot, rvv, u64t);
  let tre: u64 = ir.region_end(k);
  let er: u64 = ir.region_begin(k);
  let sa: u64 = state_addr(k);
  let s0: u64 = store_lit(k, sa, 0, tag);
  let s1: u64 = store_val(k, sa, 8, payload);
  let s2: u64 = store_lit(k, sa, 24, 0);
  let z: Mut(ty.Val) = new_val(k);
  ty.val_lit(z, 0, u64t);
  cx.slot_put(k, slot, z, u64t);
  if row.in_handle(k) == 0 {
    let dr: u64 = emit_default_return(k);
  }
  let ere: u64 = ir.region_end(k);
  let ifi: u64 = ir.emit_if(k, 0, cond, tre, ere);
  let rv2: Mut(ty.Val) = new_val(k);
  cx.slot_get(k, slot, u64t, rv2);
  let rt: Mut(ty.Ty) = new_ty(k);
  let rj: u64 = ireg.project(k, info.ret_tid, rt);
  let c2: u64 = cx.coerce(k, rv2, u64t, rt, out);
  return 1;
};

pub let perform_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = n_count(g);
  let j: u64 = i + 1;
  if j >= n or is_name(g, j) == 0 {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return j;
  }
  let bodyg: u64 = 0;
  let param_tid: u64 = 0;
  let j2: u64 = 0;
  if j + 1 < n and is_group(g, j + 1) == 1 and delim_of(g, j + 1) == dl_paren() {
    let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    let fj: u64 = ctfn.eval_factory_call(k, g, j, v);
    if fj == 0 or st.st_ok(k) != 0 or ctf.v_kind(v) != 11 {
      let m: Ref(u8) = "unknown effect";
      let d: u64 = ir.diag(k, n_at(g, j), 1, m, 14);
      st.st_fail(k, ax.FailKind.Unbound as u64);
      return j + 2;
    }
    bodyg = ctf.v_a(v);
    param_tid = ctf.v_b(v);
    j2 = fj;
  } else {
    let se: Mut(modules.SymEntry) = effect_symbol(k, n_sym(g, j));
    if is_null(se) {
      let m2: Ref(u8) = "unknown effect";
      let d2: u64 = ir.diag(k, n_at(g, j), 1, m2, 14);
      st.st_fail(k, ax.FailKind.Unbound as u64);
      return j + 1;
    }
    bodyg = modules.sym_shape(se);
    param_tid = modules.sym_qual(se);
    j2 = j + 1;
  }
  if j2 + 1 >= n { st.st_fail(k, ax.FailKind.Ast as u64); return j2; }
  if is_group(g, j2) == 0 and cx.is_path_sep(n_sym(g, j2)) {
    if is_name(g, j2 + 1) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return j2 + 1; }
    if j2 + 2 >= n or is_group(g, j2 + 2) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return j2 + 2; }
    let opname: u64 = n_sym(g, j2 + 1);
    let argsg: u64 = n_at(g, j2 + 2);
    let info: Mut(row.OpInfo) = row.op_find(k, bodyg, opname);
    if info.found == 0 {
      let m3: Ref(u8) = "unknown effect op";
      let d3: u64 = ir.diag(k, n_at(g, j2 + 1), 1, m3, 17);
      st.st_fail(k, ax.FailKind.Unbound as u64);
      return j2 + 3;
    }
    let is_trap: u64 = infer.is_trap_shape(k, bodyg, param_tid);
    if is_trap == 0 {
      if infer.current_allows(k, bodyg, param_tid) == 0 {
        let added: u64 = infer.infer_add(k, bodyg, param_tid);
        if added == 0 {
          let m4: Ref(u8) = "unhandled effect";
          let d4: u64 = ir.diag(k, n_at(g, j), 1, m4, 16);
          st.st_fail(k, ax.FailKind.Type as u64);
          return j2 + 3;
        }
      }
    }
    if param_tid != 0 { info.param_tid = param_tid; }
    let payload: Mut(ty.Val) = payload_bits(k, argsg, info);
    if st.st_ok(k) != 0 { return j2 + 3; }
    let tag: u64 = runtime_tag(k, bodyg, param_tid, info.index);
    if info.abortive == 0 {
      let hr0: Mut(row.HandlerRec) = inline_handler(k, bodyg, param_tid);
      if is_null(hr0) == 0 {
        let ok: u64 = arm_inline(k, hr0, bodyg, param_tid, payload, info, out);
        if ok == 1 { return j2 + 3; }
      }

    }
    if info.abortive == 0 {

      let dd: u64 = resumable_dispatch(k, tag, payload, info, out);
      return j2 + 3;
    }
    let base: u64 = state_addr(k);
    let stable: Mut(ty.Val) = payload_stable(k, payload);
    if is_trap == 1 {

      let deep: u64 = trap_depth_load(k);
      let active: u64 = cond_u64(k, codes.InstKind.Ne as u64, deep, 0);
      let tr: u64 = ir.region_begin(k);
      let t0: u64 = store_lit(k, base, 0, tag);
      let t1: u64 = store_val(k, base, 8, stable);
      let t2: u64 = store_lit(k, base, 24, 0);
      if row.in_handle(k) == 0 {
        let t3: u64 = emit_default_return(k);
      }
      let tre: u64 = ir.region_end(k);
      let er: u64 = ir.region_begin(k);
      if st.st_release_fast(k) == 0 {
        let e1: u64 = emit_trap(k, payload);
      }
      if row.in_handle(k) == 0 {
        let e2: u64 = emit_default_return(k);
      }
      let ere: u64 = ir.region_end(k);
      let ifi: u64 = ir.emit_if(k, 0, active, tre, ere);
      ty.val_none(out);
    } else {
      let s0: u64 = store_lit(k, base, 0, tag);
      let s1: u64 = store_val(k, base, 8, stable);
      let s2: u64 = store_lit(k, base, 24, 0);
      if row.in_handle(k) == 1 {
        ty.val_none(out);
      } else {
        let dr: u64 = emit_default_return(k);
        let ma: u64 = row.mark_abort(k);
        ty.val_none(out);
      }
    }
    return j2 + 3;
  }
  st.st_fail(k, ax.FailKind.Ast as u64);
  return j2;
};

let find_with = func(g: u64, i: u64) -> u64 {
  let n: u64 = n_count(g);
  if i >= n { return n; }
  if is_group(g, i) == 0 and n_sym(g, i) == s.k_with() { return i; }
  return find_with(g, i + 1);
};

let tok_byte = func(ag: u64, i: u64, k: u64) -> u64 {
  let h: u64 = n_at(ag, i);
  let p: Ref(u8) = ax.lit_addr(h);
  let b: u8 = deref(p + k);
  return b as u64;
};

let arrow_at = func(k: Mut(st.State), ag: u64, i: u64) -> u64 {
  let n: u64 = n_count(ag);
  if i >= n { st.st_fail(k, ax.FailKind.Ast as u64); return i + 1; }
  if is_group(ag, i) == 0 {
    let h: u64 = n_at(ag, i);
    if h != 0 and ax.lit_len(h) == 2 {
      if tok_byte(ag, i, 0) == 61 and tok_byte(ag, i, 1) == 62 { return i + 1; }
    }
  }
  if i + 1 < n and is_group(ag, i + 1) == 0 {
    if n_sym(ag, i) == s.p_eq() and n_sym(ag, i + 1) == s.o_gt() { return i + 2; }
  }
  st.st_fail(k, ax.FailKind.Ast as u64);
  return i + 1;
};

let arm_end = func(ag: u64, i: u64) -> u64 {
  let n: u64 = n_count(ag);
  if i >= n { return i; }
  if is_group(ag, i) == 1 { return i + 1; }
  if is_comma(ag, i) == 1 or is_semi(ag, i) == 1 { return i; }
  return arm_end(ag, i + 1);
};

let arm_first = func(pg: u64) -> u64 {
  if n_count(pg) == 0 { return 0; }
  if is_name(pg, 0) == 0 { return 0; }
  return n_sym(pg, 0);
};

let scan_resume = func(ag: u64, i: u64, end: u64) -> u64 {
  if i >= end { return 0; }
  if is_group(ag, i) == 1 {
    let sub: u64 = n_at(ag, i);
    if scan_resume(sub, 0, n_count(sub)) == 1 { return 1; }
  } else {
    if n_sym(ag, i) == s.k_resume() { return 1; }
  }
  return scan_resume(ag, i + 1, end);
};

let resolve_op_row = func(k: Mut(st.State), r: Mut(row.EffRow), opname: u64) -> Mut(row.OpInfo) {
  if is_null(r) == 0 {
    let i: u64 = 0;
    let found: Mut(row.OpInfo) = null_ref(Mut(row.OpInfo));
    let done: u64 = loop it(i: u64 = 0) while i < r.n {
      let p: Mut(u64) = row.item_at(r, i);
      let tag: u64 = deref(p);
      let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
      let pb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 16);
      if tag == 0 {
        let info: Mut(row.OpInfo) = row.op_find(k, deref(pa), opname);
        if info.found == 1 {
          if deref(pb) != 0 { info.param_tid = deref(pb); }
          else { let ptid: u64 = row.op_param_tid(k, info); }
          found = info;
          break it(i + 1);
        }
      }
      i = i + 1;
    };
    if is_null(found) == 0 { return found; }
  }
  return null_ref(Mut(row.OpInfo));
};

let resolve_op_any = func(k: Mut(st.State), opname: u64) -> Mut(row.OpInfo) {
  let cnt: u64 = modules.sym_count(k);
  let res: Mut(row.OpInfo) = null_ref(Mut(row.OpInfo));
  let done: u64 = loop sc(i: u64 = 0) while i < cnt {
    let se: Mut(modules.SymEntry) = modules.sym_at(k, i);
    if modules.sym_kind(se) == row.kind_effect() {
      let info: Mut(row.OpInfo) = row.op_find(k, modules.sym_shape(se), opname);
      if info.found == 1 {
        if modules.sym_qual(se) != 0 { info.param_tid = modules.sym_qual(se); }
        else { let ptid: u64 = row.op_param_tid(k, info); }
        res = info;
        break sc(i + 1);
      }
    }
    i = i + 1;
  };
  return res;
};

let arm_new = func(k: Mut(st.State), ag: u64, cnt: u64) -> Mut(row.HandlerRec) {
  let h: Mut(row.HandlerRec) = ptr_cast(Mut(row.HandlerRec), st.st_alloc(k, 48));
  h.ag = ag;
  h.row = row.row_empty(k) as u64;
  h.arms = ptr_cast(Mut(row.HArm), st.st_alloc(k, (cnt + 1) * 88));
  h.n = 0;
  h.has_return = 0;
  h.has_resumable = 0;
  return h;
};

let arm_at = func(h: Mut(row.HandlerRec), i: u64) -> Mut(row.HArm) {
  return ptr_cast(Mut(row.HArm), ptr_cast(Mut(u8), h.arms) + i * 88);
};

let case_buf = func(k: Mut(st.State), n: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), st.st_alloc(k, (n + 1) * 8));
};

let case_put = func(p: Mut(u64), i: u64, region: u64) -> u64 {
  let q: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + i * 8);
  deref(q) = region;
  return 1;
};

let case_get = func(p: Mut(u64), i: u64) -> u64 {
  let q: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + i * 8);
  return deref(q);
};

let case_flush = func(k: Mut(st.State), tags: Mut(u64), regions: Mut(u64), n: u64) -> u64 {
  let i: u64 = loop f(i: u64 = 0) while i < n {
    let ca: u64 = ir.case_add(k, case_get(tags, i), case_get(regions, i));
    i = i + 1;
  };
  return n;
};

let parse_arms = func(k: Mut(st.State), ag: u64, cand: Mut(row.EffRow), cnt: u64) -> Mut(row.HandlerRec) {
  let h: Mut(row.HandlerRec) = arm_new(k, ag, cnt);
  let n: u64 = n_count(ag);
  let caught: Mut(row.EffRow) = row.row_empty(k);
  let i: u64 = 0;
  let done: u64 = loop it(i: u64 = 0) while i < n {
    let j: u64 = row.skip_seps(ag, i);
    if j >= n { break it(j); }
    if is_name(ag, j) == 0 { break it(j + 1); }
    let nm: u64 = n_sym(ag, j);
    let a: Mut(row.HArm) = arm_at(h, h.n);
    a.kind = 0;
    a.tag = 0;
    a.bodyg = 0;
    a.param_tid = 0;
    a.ret_tid = 0;
    a.bind = 0;
    a.resume_bind = 0;
    a.body = 0;
    a.blk = 0;
    a.has_resume = 0;
    a.abortive = 0;
    if nm == s.k_return() {
      if j + 1 >= n or is_group(ag, j + 1) == 0 { break it(j + 1); }
      let pg: u64 = n_at(ag, j + 1);
      a.kind = 0;
      a.bind = arm_first(pg);
      let b: u64 = arrow_at(k, ag, j + 2);
      a.body = b;
      if b < n and is_group(ag, b) == 1 and delim_of(ag, b) == dl_brace() { a.blk = 1; }
      h.has_return = 1;
      h.n = h.n + 1;
      i = arm_end(ag, b);
    } else {
      a.kind = 1;
      let info: Mut(row.OpInfo) = resolve_op_row(k, cand, nm);
      if is_null(info) { info = resolve_op_any(k, nm); }
      if is_null(info) {
        let m: Ref(u8) = "unknown effect op";
        let d: u64 = ir.diag(k, n_at(ag, j), 1, m, 17);
        st.st_fail(k, ax.FailKind.Unbound as u64);
        break it(n);
      }
      a.bodyg = 0;
      let bidx: u64 = 0;
      let bj: u64 = j + 1;
      if bj < n and is_group(ag, bj) == 1 and delim_of(ag, bj) == dl_paren() {
        a.bind = arm_first(n_at(ag, bj));
        bj = bj + 1;
      }
      if bj + 2 < n and is_group(ag, bj) == 0 and n_sym(ag, bj) == s.k_with() {
        if n_sym(ag, bj + 1) == s.k_resume() {
          if is_group(ag, bj + 2) == 1 and delim_of(ag, bj + 2) == dl_paren() {
            a.resume_bind = arm_first(n_at(ag, bj + 2));
            a.has_resume = 1;
            bj = bj + 3;
          }
        }
      }
      let b2: u64 = arrow_at(k, ag, bj);
      a.body = b2;
      if b2 < n and is_group(ag, b2) == 1 and delim_of(ag, b2) == dl_brace() { a.blk = 1; }
      a.param_tid = row.op_param_tid(k, info);
      a.ret_tid = info.ret_tid;
      a.abortive = info.abortive;
      let aend: u64 = arm_end(ag, b2);
      if a.abortive == 0 and a.has_resume == 0 {
        if scan_resume(ag, a.body, aend) == 1 { a.has_resume = 1; }
      }
      if a.abortive == 1 and a.has_resume == 1 {
        let m2: Ref(u8) = "cannot resume abortive effect";
        let d2: u64 = ir.diag(k, n_at(ag, j), 1, m2, 29);
        st.st_fail(k, ax.FailKind.Type as u64);
        break it(n);
      }

      let owner: u64 = owner_effect(k, cand, nm, info);
      let etid: u64 = owner_param(k, cand, owner);
      a.bodyg = owner;
      a.tag = runtime_tag(k, owner, etid, info.index);
      let pp: u64 = row.row_push(k, caught, 0, owner, etid);
      if a.has_resume == 1 and a.abortive == 0 { h.has_resumable = 1; }
      h.n = h.n + 1;
      i = aend;
    }
  };
  h.row = caught as u64;
  return h;
};

let owner_param = func(k: Mut(st.State), cand: Mut(row.EffRow), owner: u64) -> u64 {
  let fb: Mut(u64) = box(k);
  box_put(fb, 0);
  if is_null(cand) == 0 {
    let done: u64 = loop it(i: u64 = 0) while i < cand.n {
      let p: Mut(u64) = row.item_at(cand, i);
      let tag: u64 = deref(p);
      let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
      let pb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 16);
      if (tag == 0) and (deref(pa) == owner) {
        box_put(fb, deref(pb) + 1);
        break it(i + 1);
      }
      i = i + 1;
    };
    let hit: u64 = box_get(fb);
    if hit != 0 { return hit - 1; }
  }
  let cnt: u64 = modules.sym_count(k);
  let res: u64 = loop sc(i: u64 = 0) while i < cnt {
    let se: Mut(modules.SymEntry) = modules.sym_at(k, i);
    if (modules.sym_kind(se) == row.kind_effect()) and (modules.sym_shape(se) == owner) {
      break sc(modules.sym_qual(se) + 1);
    }
    i = i + 1;
  };
  if res == 0 { return 0; }
  return res - 1;
};

let owner_effect = func(k: Mut(st.State), cand: Mut(row.EffRow), opname: u64, info: Mut(row.OpInfo)) -> u64 {
  if is_null(cand) == 0 {
    let i: u64 = 0;
    let done: u64 = loop it(i: u64 = 0) while i < cand.n {
      let p: Mut(u64) = row.item_at(cand, i);
      let tag: u64 = deref(p);
      let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
      if tag == 0 {
        let oi: Mut(row.OpInfo) = row.op_find(k, deref(pa), opname);
        if oi.found == 1 { break it(deref(pa)); }
      }
      i = i + 1;
    };
    if done != 0 and done != cand.n { return done; }
  }
  let cnt: u64 = modules.sym_count(k);
  let res: u64 = loop sc(i: u64 = 0) while i < cnt {
    let se: Mut(modules.SymEntry) = modules.sym_at(k, i);
    if modules.sym_kind(se) == row.kind_effect() {
      let oi: Mut(row.OpInfo) = row.op_find(k, modules.sym_shape(se), opname);
      if oi.found == 1 { break sc(modules.sym_shape(se)); }
    }
    i = i + 1;
  };
  return res;
};

let push_handler = func(k: Mut(st.State), h: Mut(row.HandlerRec)) -> u64 {
  let c: Mut(row.EffCtx) = row.ctx(k);
  if c.hn >= c.hcap { return st.st_fail(k, ax.FailKind.Frame as u64); }
  let p: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), c.handlers) + c.hn * 8);
  deref(p) = h as u64;
  c.hn = c.hn + 1;
  return 1;
};

let pop_handler = func(k: Mut(st.State)) -> u64 {
  let c: Mut(row.EffCtx) = row.ctx(k);
  if c.hn == 0 { return 0; }
  c.hn = c.hn - 1;
  return 1;
};

let disp_at = func(c: Mut(row.EffCtx), i: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), ptr_cast(Mut(u8), c.disp) + i * 48);
};

let scan_names = func(k: Mut(st.State), g: u64, i: u64, end: u64, b1: u64, b2: u64) -> u64 {
  if i >= end { return 0; }
  if is_group(g, i) == 1 {
    let sub: u64 = n_at(g, i);
    if scan_names(k, sub, 0, n_count(sub), b1, b2) == 1 { return 1; }
  } else {
    if is_name(g, i) == 1 {
      let nm: u64 = n_sym(g, i);
      if nm != b1 and nm != b2 and env.env_find(k, nm) != 0 { return 1; }
    }
  }
  return scan_names(k, g, i + 1, end, b1, b2);
};

let disp_needs_env = func(k: Mut(st.State), h: Mut(row.HandlerRec)) -> u64 {
  let fb: Mut(u64) = box(k);
  box_put(fb, 0);
  let done: u64 = loop a(i: u64 = 0) while i < h.n {
    let ar: Mut(row.HArm) = arm_at(h, i);
    if ar.kind == 1 and ar.abortive == 0 {
      let aend: u64 = arm_end(h.ag, ar.body);
      if scan_names(k, h.ag, ar.body, aend, ar.bind, ar.resume_bind) == 1 {
        box_put(fb, 1);
        break a(i + 1);
      }
    }
    i = i + 1;
  };
  return box_get(fb);
};

let enqueue_disp = func(k: Mut(st.State), h: Mut(row.HandlerRec)) -> u64 {
  if h.has_resumable == 0 { return 0; }
  if disp_needs_env(k, h) == 1 { return 0; }
  let c: Mut(row.EffCtx) = row.ctx(k);
  if c.dn >= c.dcap { return st.st_fail(k, ax.FailKind.Frame as u64); }
  let seq: u64 = st.st_next_tmp(k);
  let pf: u64 = s.intern("_effh", 5);
  let nm: u64 = modules.qual_num(k, st.st_src(k), pf, seq);
  let p: Mut(u64) = disp_at(c, c.dn);
  deref(p) = nm;
  let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
  let pb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 16);
  let pc: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 24);
  let pd: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 32);
  let pe: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 40);
  deref(pa) = h.ag;
  deref(pb) = h.arms as u64;
  deref(pc) = h.n;
  deref(pd) = st.st_src(k);
  deref(pe) = st.st_vmod(k);
  c.dn = c.dn + 1;
  return nm;
};

pub let handler_pending = func(k: Mut(st.State)) -> u64 {
  let c: Mut(row.EffCtx) = row.ctx(k);
  if c.dn == 0 { return 0; }
  return 1;
};

let disp_arm_region = func(k: Mut(st.State), ag: u64, ar: Mut(row.HArm), pay: Mut(ty.Val)) -> u64 {
  let r: u64 = ir.region_begin(k);
  let mark: u64 = env.env_mark(k);
  let term: Mut(u64) = box(k);
  if ar.bind != 0 {
    let sl: u64 = st.st_next_slot(k);
    let pt: Mut(ty.Ty) = new_ty(k);
    let pj: u64 = ireg.project(k, ar.param_tid, pt);
    let cv: Mut(ty.Val) = new_val(k);
    let rc: u64 = cx.coerce(k, pay, ty.vty(pay), pt, cv);
    cx.slot_put(k, sl, cv, pt);
    env.env_push(k, ar.bind, sl, pt);
  }
  let rt: Mut(ty.Ty) = new_ty(k);
  let rj: u64 = ireg.project(k, ar.ret_tid, rt);
  let pr: u64 = row.push_resume(k, 0, ar.ret_tid, st.st_loopdepth(k));
  let slot: u64 = if ty.ty_known(rt) == 1 { alloc_dyn_slot(k) } else { no_slot() };
  if ar.blk == 1 {
    let bg: u64 = n_at(ag, ar.body);
    let bj: u64 = effects_block(k, bg, 0, term, slot, rt);
  } else {
    let v: Mut(ty.Val) = new_val(k);
    let ej: u64 = core_expr(k, ag, ar.body, 0, rt, v);
    if st.st_ok(k) == 0 and slot != no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, slot, v, ty.vty(v));
    }
  }
  let pp: u64 = row.pop_resume(k);
  env.env_release(k, mark);
  if box_get(term) == 1 or row.take_aborts(k) == 1 { return ir.region_end(k); }
  let u64t: Mut(ty.Ty) = t64(k);
  let rv: Mut(ty.Val) = new_val(k);
  if slot != no_slot() { cx.slot_get(k, slot, rt, rv); } else { ty.val_lit(rv, 0, u64t); }
  let cv2: Mut(ty.Val) = new_val(k);
  let rc2: u64 = cx.coerce(k, rv, ty.vty(rv), u64t, cv2);
  ir.args_reset(k);
  let rr: u64 = ir.region_result(k, u64t);
  let cn: u64 = cx.val_force(k, cv2, u64t);
  let an: u64 = ir.arg_ref(k, cn);
  ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  return ir.region_end(k);
};

pub let flush_one_handler = func(k: Mut(st.State)) -> u64 {
  let c: Mut(row.EffCtx) = row.ctx(k);
  if c.dn == 0 { return 0; }
  let idx: u64 = c.dn - 1;
  c.dn = idx;
  let p: Mut(u64) = disp_at(c, idx);
  let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
  let pb: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 16);
  let pc: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 24);
  let pd: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 32);
  let pe: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 40);
  let nm: u64 = deref(p);
  let ag: u64 = deref(pa);
  let arms: Mut(row.HArm) = ptr_cast(Mut(row.HArm), deref(pb));
  let cnt: u64 = deref(pc);
  let src: u64 = deref(pd);
  let modv: u64 = deref(pe);
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  let saved_ip: u64 = st.st_in_proc(k);
  let sv: u64 = st.st_set_src(k, src);
  let mv: u64 = if modv >= 1000 { modv } else { 0 };
  let sm: u64 = st.st_set_vmod(k, mv);
  st.st_set_slotj(k, 0);
  st.st_set_loopdepth(k, 0);
  env.env_release(k, 0);
  let u64t: Mut(ty.Ty) = t64(k);
  st.st_set_retk(k, ty.tk(u64t));
  st.st_set_retw(k, ty.tw(u64t));
  st.st_set_retsg(k, ty.tsg(u64t));
  st.st_set_retsh(k, 0);
  let nip: u64 = st.st_set_in_proc(k, saved_ip + 1);
  let bp: u64 = ir.proc_begin(k, nm);
  let tag: u64 = ir.fresh_t(k);
  let pay: u64 = ir.fresh_t(k);
  let frm: u64 = ir.fresh_t(k);
  ir.proc_param(k, tag, u64t);
  ir.proc_param(k, pay, u64t);
  ir.proc_param(k, frm, u64t);
  ir.proc_result(k, u64t);
  ir.region_begin(k);
  let sl: u64 = emit_slots(k, 0, 9 + cnt + cx.count_tree(ag, 0));
  let payv: Mut(ty.Val) = new_val(k);
  ty.val_ref(payv, pay, u64t);
  let tagv: Mut(ty.Val) = new_val(k);
  ty.val_ref(tagv, tag, u64t);
  let resname: u64 = ir.fresh_t(k);

  let at: Mut(ty.Ty) = ir.taddr(k);
  let framev: Mut(ty.Val) = new_val(k);
  ty.val_ref(framev, frm, u64t);
  let fra: Mut(ty.Val) = new_val(k);
  let frc: u64 = cx.coerce(k, framev, u64t, at, fra);
  let prev: Mut(ty.Val) = new_val(k);
  let prevl: u64 = agg.load_at(k, ty.vn(fra), 8, at, prev);
  let prevu: Mut(ty.Val) = new_val(k);
  let prevc: u64 = cx.coerce(k, prev, at, u64t, prevu);
  let gtop: u64 = ensure_handler(k);
  let sw0: u64 = store_val(k, gtop, 0, prevu);
  let tags: Mut(u64) = case_buf(k, cnt);
  let regions: Mut(u64) = case_buf(k, cnt);
  let i: u64 = 0;
  let added: u64 = loop dc(i: u64 = 0) while i < cnt {
    let ar: Mut(row.HArm) = ptr_cast(Mut(row.HArm), ptr_cast(Mut(u8), arms) + i * 88);
    let cr: u64 = disp_arm_region(k, ag, ar, payv);
    let ct: u64 = case_put(tags, i, ar.tag);
    let cp: u64 = case_put(regions, i, cr);
    i = i + 1;
  };
  let cf: u64 = case_flush(k, tags, regions, cnt);

  let dr: u64 = ir.region_begin(k);
  let has_prev: u64 = cond_u64(k, codes.InstKind.Ne as u64, ty.vn(prevu), 0);
  let pr: u64 = ir.region_begin(k);
  let pfn: Mut(ty.Val) = new_val(k);
  let pfl: u64 = agg.load_at(k, ty.vn(prev), 0, at, pfn);
  let item: u64 = 1 + 64 * 256;
  let plo: u64 = item + item * 65536 + item * 16777216;
  ir.args_reset(k);
  let qa: u64 = ir.arg_ref(k, ty.vn(pfn));
  let qb: u64 = ir.arg_ref(k, tag);
  let qc: u64 = ir.arg_ref(k, pay);
  let qd: u64 = ir.arg_ref(k, ty.vn(prevu));
  let qr: u64 = ir.fresh_t(k);
  let qc2: u64 = ir.emit_call_indirect(k, qr, u64t, plo, 0);
  let qrv: Mut(ty.Val) = new_val(k);
  ty.val_ref(qrv, qr, u64t);
  ir.args_reset(k);
  let r1: u64 = ir.region_result(k, u64t);
  let qn: u64 = cx.val_force(k, qrv, u64t);
  let qo: u64 = ir.arg_ref(k, qn);
  ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  let pre: u64 = ir.region_end(k);
  let nr: u64 = ir.region_begin(k);
  let base: u64 = state_addr(k);
  let stg: u64 = store_val(k, base, 0, tagv);
  ir.args_reset(k);
  let r2: u64 = ir.region_result(k, u64t);
  let z2: Mut(ty.Val) = new_val(k);
  ty.val_lit(z2, 0, u64t);
  let zn: u64 = cx.val_force(k, z2, u64t);
  let za: u64 = ir.arg_ref(k, zn);
  ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  let nre: u64 = ir.region_end(k);
  let pifv: u64 = ir.fresh_t(k);
  let pif: u64 = ir.emit_if(k, pifv, has_prev, pre, nre);

  ir.args_reset(k);
  let r0: u64 = ir.region_result(k, u64t);
  let pifv2: Mut(ty.Val) = new_val(k);
  ty.val_ref(pifv2, pifv, u64t);
  let pifn: u64 = cx.val_force(k, pifv2, u64t);
  let pifa: u64 = ir.arg_ref(k, pifn);
  ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  let dre: u64 = ir.region_end(k);
  let sw: u64 = ir.emit_switch(k, resname, tag, u64t, dre);
  let sw1: u64 = store_val(k, gtop, 0, framev);
  ir.args_reset(k);
  let sv2: Mut(ty.Val) = new_val(k);
  ty.val_ref(sv2, resname, u64t);
  ir.op_val(k, sv2);
  ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  ir.region_end(k);
  ir.proc_end(k);
  let rip: u64 = st.st_set_in_proc(k, saved_ip);
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  return 1;
};

let arm_region = func(k: Mut(st.State), h: Mut(row.HandlerRec), ar: Mut(row.HArm), resj: u64, want: Mut(ty.Ty), obj: u64) -> u64 {
  let r: u64 = ir.region_begin(k);
  let mark: u64 = env.env_mark(k);
  let term: Mut(u64) = box(k);
  if ar.bind != 0 {
    let sl: u64 = st.st_next_slot(k);
    let pt: Mut(ty.Ty) = new_ty(k);
    let pj: u64 = ireg.project(k, ar.param_tid, pt);
    let base: u64 = state_addr(k);
    let pv: u64 = load_u64(k, base, 8);
    let v: Mut(ty.Val) = new_val(k);
    ty.val_ref(v, pv, t64(k));
    let cv: Mut(ty.Val) = new_val(k);
    let rc: u64 = cx.coerce(k, v, ty.vty(v), pt, cv);
    let sc: u64 = arm_payload_copy(k, sl, pt, cv);
    env.env_push(k, ar.bind, sl, pt);
  }
  let prz: u64 = pay_top_reset(k);
  let pr: u64 = if ar.kind == 1 and ar.has_resume == 1 { row.push_resume(k, 1, ar.ret_tid, st.st_loopdepth(k)) } else { 0 };
  if ar.blk == 1 {
    let bg: u64 = n_at(h.ag, ar.body);
    let bj: u64 = effects_block(k, bg, 0, term, resj, want);
  } else {
    let v: Mut(ty.Val) = new_val(k);
    let ej: u64 = core_expr(k, h.ag, ar.body, 0, want, v);
    if st.st_ok(k) == 0 and resj != no_slot() and ty.val_known(v) == 1 {
      cx.slot_put(k, resj, v, ty.vty(v));
    }
  }
  let pp: u64 = if ar.kind == 1 and ar.has_resume == 1 { row.pop_resume(k) } else { 0 };
  env.env_release(k, mark);
  return ir.region_end(k);
};

let row_no_abortive = func(k: Mut(st.State), r: Mut(row.EffRow)) -> u64 {
  if row.row_is_empty(r) == 1 { return 0; }
  let i: u64 = 0;
  let ok: u64 = loop it(i: u64 = 0) while i < r.n {
    let p: Mut(u64) = row.item_at(r, i);
    let tag: u64 = deref(p);
    let pa: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), p) + 8);
    if tag == 1 { return 0; }
    let cnt: u64 = n_count(deref(pa));
    let j: u64 = 0;
    let ok2: u64 = loop op(j: u64 = 0) while j < cnt {
      if n_sym(deref(pa), j) == s.k_op() {
        let rt: Mut(ty.Ty) = new_ty(k);
        let b: u64 = parse_type(k, deref(pa), j + 4, rt);
        if ireg.tid_of(k, rt) == tb.never_tid(k) { return 0; }
        j = b;
      } else { j = j + 1; }
    };
    i = i + 1;
  };
  return 1;
};

let has_trap_arm = func(k: Mut(st.State), h: Mut(row.HandlerRec)) -> u64 {
  let found: u64 = loop a(i: u64 = 0) while i < h.n {
    let ar: Mut(row.HArm) = arm_at(h, i);
    if ar.kind == 1 {
      if infer.is_trap_shape(k, ar.bodyg, 0) == 1 { break a(1); }
    }
    if i + 1 >= h.n { break a(0); }
    i = i + 1;
  };
  return found;
};

let can_inline_call = func(k: Mut(st.State), se: Mut(modules.SymEntry)) -> u64 {
  if is_null(se) { return 0; }
  if modules.sym_kind(se) != modules.sym_kind_func() { return 0; }
  let src: u64 = modules.sym_src(se);
  let root: u64 = hr.source_root(src);
  let d: u64 = modules.sym_decl(se);
  let pg: u64 = if is_group(root, d + 1) == 1 { d + 1 } else { d + 2 };
  if n_count(n_at(root, pg)) != 0 { return 0; }
  let r: Mut(row.EffRow) = infer.callee_row(k, se);
  return row_no_abortive(k, r);
};

let inline_call = func(k: Mut(st.State), se: Mut(modules.SymEntry), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let src: u64 = modules.sym_src(se);
  let root: u64 = hr.source_root(src);
  let d: u64 = modules.sym_decl(se);
  let pg: u64 = if is_group(root, d + 1) == 1 { d + 1 } else { d + 2 };
  let l: Mut(row.FnLayout) = row.fn_layout(k, root, pg);
  let rt: Mut(ty.Ty) = new_ty(k);
  ty.ty_none(rt);
  if l.ret_i != 0 { let rj: u64 = parse_type(k, root, l.ret_i, rt); }
  let bodyg: u64 = n_at(root, l.body_i);
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  let sv: u64 = st.st_set_src(k, src);
  let mv: u64 = if modules.sym_home(se) >= 1000 { modules.sym_home(se) } else { 0 };
  let sm: u64 = st.st_set_vmod(k, mv);
  let label: u64 = ir.fresh_l(k);
  let slot: u64 = alloc_dyn_slot(k);
  let seq: u64 = st.st_next_tmp(k);
  let base: u64 = 200000 + seq * 1024;
  let sj: u64 = st.st_set_slotj(k, base);
  let nslots: u64 = 8 + cx.count_tree(bodyg, 0);
  let es: u64 = emit_slots(k, base, base + nslots);
  let r: u64 = ir.region_begin(k);
  let term: Mut(u64) = box(k);
  let pr: u64 = row.push_inline(k, label, slot, rt as u64);
  let bj: u64 = effects_block(k, bodyg, 0, term, no_slot(), tnone(k));
  let pp: u64 = row.pop_inline(k);
  let re: u64 = ir.region_end(k);
  let lp: u64 = ir.emit_loop(k, 0, label, re);
  if ty.ty_known(rt) == 1 { cx.slot_get(k, slot, rt, out); } else { ty.val_none(out); }
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  return 1;
};

pub let handle_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let n: u64 = n_count(g);
  let wi: u64 = find_with(g, i + 1);
  if wi >= n { st.st_fail(k, ax.FailKind.Ast as u64); return n; }
  if wi + 1 >= n or is_group(g, wi + 1) == 0 or delim_of(g, wi + 1) != dl_brace() {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return wi + 1;
  }
  let ag: u64 = n_at(g, wi + 1);

  let direct: u64 = 0;
  if wi == i + 3 and is_name(g, i + 1) == 1 and is_group(g, i + 2) == 1 and delim_of(g, i + 2) == dl_paren() {
    direct = 1;
  }
  let cand: Mut(row.EffRow) = row.row_empty(k);
  let callee: Mut(modules.SymEntry) = null_ref(Mut(modules.SymEntry));
  if direct == 1 {
    let se: Mut(modules.SymEntry) = ctf.find_sym(k, n_sym(g, i + 1));
    if is_null(se) == 0 {
      let kd: u64 = modules.sym_kind(se);
      if kd == modules.sym_kind_func() or kd == modules.sym_kind_extern() {
        callee = se;
        cand = infer.callee_row(k, se);
      } else if kd == modules.sym_kind_generic() {
        callee = se;
      }
    } else {
      direct = 0;
    }
  }
  if direct == 0 { cand = row.frames_row(k); }
  let hr0: Mut(row.HandlerRec) = parse_arms(k, ag, cand, n_count(ag));
  if st.st_ok(k) != 0 { return wi + 2; }
  let dname: u64 = if hr0.has_resumable == 1 { enqueue_disp(k, hr0) } else { 0 };
  let gen_first: u64 = 0;
  if is_null(callee) == 0 {
    if modules.sym_kind(callee) == modules.sym_kind_generic() { gen_first = 1; }
  }
  if gen_first == 0 {
    if direct == 0 and i + 1 < n and is_name(g, i + 1) == 1 {
      let ge2: Mut(modules.SymEntry) = ctf.find_sym(k, n_sym(g, i + 1));
      if is_null(ge2) == 0 {
        if modules.sym_kind(ge2) == modules.sym_kind_generic() { gen_first = 1; }
      }
    }
  }
  let exv: Mut(ty.Val) = new_val(k);
  if gen_first == 1 { let gj: u64 = core_expr(k, g, i + 1, 0, want, exv); }
  if gen_first == 1 and hr0.n == 1 and hr0.has_return == 1 and hr0.has_resumable == 0 {
    let a0: Mut(row.HArm) = arm_at(hr0, 0);
    let mark: u64 = env.env_mark(k);
    if a0.kind == 0 and a0.bind != 0 {
      let sl: u64 = st.st_next_slot(k);
      let bv: Mut(ty.Val) = new_val(k);
      if ty.val_known(exv) == 1 {
        cx.slot_put(k, sl, exv, ty.vty(exv));
        env.env_push(k, a0.bind, sl, ty.vty(exv));
      }
    }
    let term: Mut(u64) = box(k);
    if a0.blk == 1 {
      let bg: u64 = n_at(ag, a0.body);
      let bj: u64 = effects_block(k, bg, 0, term, no_slot(), want);
      ty.val_none(out);
    } else {
      let v: Mut(ty.Val) = new_val(k);
      let ej: u64 = core_expr(k, ag, a0.body, 0, want, v);
      ty.val_at(out, v);
    }
    env.env_release(k, mark);
    return wi + 2;
  }
  let caught: Mut(row.EffRow) = ptr_cast(Mut(row.EffRow), hr0.row);

  let hs: u64 = if dname != 0 { push_eff_frame(k, dname) } else { no_slot() };
  let cw: u64 = if gen_first == 1 { 0 } else { row.push_frame(k, caught) };
  let ph: u64 = if gen_first == 1 { 0 } else { push_handler(k, hr0) };
  let trap_arm: u64 = if gen_first == 1 { 0 } else { has_trap_arm(k, hr0) };
  let td0: u64 = if trap_arm == 1 { trap_depth_step(k, codes.InstKind.Add as u64, 1) } else { 0 };
  let prev: u64 = row.in_handle(k);
  let sh: u64 = row.set_in_handle(k, 1);
  let saved_ab: u64 = row.take_aborts(k);
  let nx: u64 = if gen_first == 1 {
    wi
  } else if direct == 1 {
    let ck: u64 = if is_null(callee) == 0 { modules.sym_kind(callee) } else { 0 };
    if ck == modules.sym_kind_generic() {
      let j4: u64 = core_expr(k, g, i + 1, 0, want, exv);
      wi
    } else {
      if can_inline_call(k, callee) == 1 {
        let j3: u64 = inline_call(k, callee, want, exv);
        wi
      } else {
        let j: u64 = cl.call_expr(k, g, i + 1, want, exv);
        wi
      }
    }
  } else {
    let j2: u64 = core_expr(k, g, i + 1, 0, want, exv);
    wi
  };
  if st.st_ok(k) != 0 {
    let rs: u64 = row.set_in_handle(k, prev);
    if gen_first == 0 { let pq: u64 = pop_handler(k); let pf: u64 = row.pop_frame(k); }
    return nx;
  }
  let td1: u64 = if trap_arm == 1 { trap_depth_step(k, codes.InstKind.Sub as u64, 1) } else { 0 };
  if dname != 0 { let po: u64 = pop_eff_frame(k, hs); }
  let rs2: u64 = row.set_in_handle(k, prev);
  if gen_first == 0 { let pq2: u64 = pop_handler(k); let pf2: u64 = row.pop_frame(k); };
  let rwant: Mut(ty.Ty) = new_ty(k);
  if ty.ty_known(want) == 1 { ty.ty_at(rwant, want); } else { ty.ty_at(rwant, ty.vty(exv)); }
  let has_res: u64 = ty.ty_known(rwant);
  let resj: u64 = if has_res == 1 { alloc_dyn_slot(k) } else { no_slot() };
  let base: u64 = state_addr(k);
  let sel: u64 = load_u64(k, base, 0);
  let sel_ty: Mut(ty.Ty) = t64(k);
  let resname: u64 = ir.fresh_t(k);

  let r0: u64 = ir.region_begin(k);
  let m0: u64 = env.env_mark(k);
  let term0: Mut(u64) = box(k);
  let a0: Mut(row.HArm) = null_ref(Mut(row.HArm));
  let has_ret: u64 = hr0.has_return;
  if has_ret == 1 {
    let fi: u64 = loop fr(i: u64 = 0) while i < hr0.n {
      let ar: Mut(row.HArm) = arm_at(hr0, i);
      if ar.kind == 0 { a0 = ar; break fr(i + 1); }
      i = i + 1;
    };
    if is_null(a0) == 0 {
      if a0.bind != 0 {
        let sl: u64 = st.st_next_slot(k);
        let bv: Mut(ty.Val) = new_val(k);
        if ty.val_known(exv) == 1 {
          cx.slot_put(k, sl, exv, ty.vty(exv));
          env.env_push(k, a0.bind, sl, ty.vty(exv));
        } else {
          let tv: Mut(ty.Ty) = tnone(k);
          env.env_push(k, a0.bind, sl, tv);
        }
      }
      if a0.blk == 1 {
        let bg0: u64 = n_at(ag, a0.body);
        let bj0: u64 = effects_block(k, bg0, 0, term0, resj, rwant);
      } else {
        let v0: Mut(ty.Val) = new_val(k);
        let ej0: u64 = core_expr(k, ag, a0.body, 0, rwant, v0);
        if st.st_ok(k) == 0 and resj != no_slot() and ty.val_known(v0) == 1 {
          cx.slot_put(k, resj, v0, ty.vty(v0));
        }
      }
    }
  } else {
    if resj != no_slot() and ty.val_known(exv) == 1 {
      cx.slot_put(k, resj, exv, ty.vty(exv));
    }
  }
  let prz0: u64 = pay_top_reset(k);
  env.env_release(k, m0);
  let cr0: u64 = ir.region_end(k);

  let case_n: u64 = hr0.n + 1;
  let tags: Mut(u64) = case_buf(k, case_n);
  let regions: Mut(u64) = case_buf(k, case_n);
  let rt0: u64 = case_put(tags, 0, 0);
  let rp0: u64 = case_put(regions, 0, cr0);
  let ci: u64 = 0;
  let added: u64 = loop ac(i: u64 = 0) while i < hr0.n {
    let ar: Mut(row.HArm) = arm_at(hr0, i);
    if ar.kind == 1 {
      let srst: u64 = store_lit(k, base, 0, 0);
      let cr: u64 = arm_region(k, hr0, ar, resj, rwant, 0);
      let ct: u64 = case_put(tags, ci + 1, ar.tag);
      let cp: u64 = case_put(regions, ci + 1, cr);
      ci = ci + 1;
    }
    i = i + 1;
  };
  let cf: u64 = case_flush(k, tags, regions, ci + 1);

  let dr: u64 = ir.region_begin(k);
  if prev != 1 {
    let d: u64 = emit_default_return(k);
  }
  let dre: u64 = ir.region_end(k);
  let sw: u64 = ir.emit_switch(k, 0, sel, sel_ty, dre);
  if has_res == 1 {
    cx.slot_get(k, resj, rwant, out);
  } else {
    ty.val_none(out);
  }
  return wi + 2;
};
