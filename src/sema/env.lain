// 词法作用域：一条记录 48 字节 = [名字 SymId, 槽号, k, w, sg, 形状号]。
// 槽号指向过程入口发好的 #alloca，读写走 types.lain 的标量访问器。
let st = import("src::driver::state");
let ty = import("src::sema::types");

let EnvEntry = struct {
  sym: u64,
  slot: u64,
  k: u64,
  w: u64,
  sg: u64,
  sh: u64
};

let entry_at = func(s: Mut(st.State), off: u64) -> Mut(EnvEntry) {
  return ptr_cast(Mut(EnvEntry), st.st_base(s) + off);
};

pub let env_mark = func(s: Mut(st.State)) -> u64 { return st.st_sp(s); };

pub let env_release = func(s: Mut(st.State), mark: u64) -> u64 { return st.st_set_sp(s, mark); };

pub let env_push = func(s: Mut(st.State), sym: u64, slot: u64, t: Mut(ty.Ty)) -> u64 {
  let off: u64 = st.st_sp(s);
  if off + 48 > st.st_cap(s) { return st.st_fail(s, 2); }
  let e: Mut(EnvEntry) = entry_at(s, off);
  e.sym = sym;
  e.slot = slot;
  e.k = ty.tk(t);
  e.w = ty.tw(t);
  e.sg = ty.tsg(t);
  e.sh = ty.tsh(t);
  st.st_set_sp(s, off + 48);
  return 0;
};

let env_scan = func(s: Mut(st.State), sym: u64, off: u64) -> u64 {
  if off == 0 { return 0; }
  let back: u64 = off - 48;
  let e: Mut(EnvEntry) = entry_at(s, back);
  if e.sym == sym { return back + 1; }
  return env_scan(s, sym, back);
};

pub let env_find = func(s: Mut(st.State), sym: u64) -> u64 {
  return env_scan(s, sym, st.st_sp(s));
};

let env_has = func(s: Mut(st.State), sym: u64) -> u64 {
  if env_find(s, sym) == 0 { return 0; }
  return 1;
};

pub let env_slot = func(s: Mut(st.State), off: u64) -> u64 {
  let e: Mut(EnvEntry) = entry_at(s, off - 1);
  return e.slot;
};

pub let env_ty = func(s: Mut(st.State), off: u64, out: Mut(ty.Ty)) -> u64 {
  let e: Mut(EnvEntry) = entry_at(s, off - 1);
  ty.ty_save(out, e.k, e.w, e.sg);
  return ty.ty_set_sh(out, e.sh);
};
