// effects.lain —— 单次代数效应门面：声明登记、效应行、纯度检查与 LainIR 降解。
//
// 实现在三个子模块里：行的表示、编译期上下文与声明布局住在
// src::sema::effects::row；效应行成员判定、Trap 环境效应与调用点检查住在
// src::sema::effects::infer；声明、perform、handle、resume 的降解住在
// src::sema::effects::lower。本文件把它们的公开符号按原名称重新导出，
// import("src::sema::effects") 的调用点因此照旧可用。
let st = import("src::driver::state");
let ty = import("src::sema::types");
let modules = import("src::sema::modules");
let row = import("src::sema::effects::row");
let infer = import("src::sema::effects::infer");
let lower = import("src::sema::effects::lower");

pub let kind_effect = func() -> u64 { return row.kind_effect(); };

// --- 类型 -----------------------------------------------------------------
pub let EffRow = row.EffRow;
pub let EffCtx = row.EffCtx;
pub let HArm = row.HArm;
pub let HandlerRec = row.HandlerRec;
pub let ResumeState = row.ResumeState;
pub let OpInfo = row.OpInfo;
pub let FnLayout = row.FnLayout;
pub let InlineState = row.InlineState;

// --- 表容量 ---------------------------------------------------------------
pub let SEQ_CAP = func() -> u64 { return row.SEQ_CAP(); };
pub let FRAME_CAP = func() -> u64 { return row.FRAME_CAP(); };
pub let HANDLER_CAP = func() -> u64 { return row.HANDLER_CAP(); };
pub let RESUME_CAP = func() -> u64 { return row.RESUME_CAP(); };
pub let INF_CAP = func() -> u64 { return row.INF_CAP(); };

// --- 上下文状态 -----------------------------------------------------------
pub let in_handle = func(k: Mut(st.State)) -> u64 { return row.in_handle(k); };
pub let set_in_handle = func(k: Mut(st.State), v: u64) -> u64 { return row.set_in_handle(k, v); };
pub let last_aborts = func(k: Mut(st.State)) -> u64 { return row.last_aborts(k); };
pub let clear_aborts = func(k: Mut(st.State)) -> u64 { return row.clear_aborts(k); };
pub let take_aborts = func(k: Mut(st.State)) -> u64 { return row.take_aborts(k); };
pub let mark_abort = func(k: Mut(st.State)) -> u64 { return row.mark_abort(k); };

// --- 效应行 ---------------------------------------------------------------
pub let row_empty = func(k: Mut(st.State)) -> Mut(EffRow) { return row.row_empty(k); };
pub let row_is_empty = func(r: Mut(EffRow)) -> u64 { return row.row_is_empty(r); };
pub let push_frame = func(k: Mut(st.State), r: Mut(EffRow)) -> u64 { return row.push_frame(k, r); };
pub let pop_frame = func(k: Mut(st.State)) -> u64 { return row.pop_frame(k); };

// --- 声明布局 -------------------------------------------------------------
pub let layout_from = func(k: Mut(st.State), g: u64, a0: u64) -> Mut(FnLayout) { return row.layout_from(k, g, a0); };
pub let fn_layout = func(k: Mut(st.State), g: u64, pg_i: u64) -> Mut(FnLayout) { return row.fn_layout(k, g, pg_i); };
pub let op_param_tid = func(k: Mut(st.State), info: Mut(OpInfo)) -> u64 { return row.op_param_tid(k, info); };
pub let op_find = func(k: Mut(st.State), bodyg: u64, opname: u64) -> Mut(OpInfo) { return row.op_find(k, bodyg, opname); };
pub let row_from_hdr = func(k: Mut(st.State), src: u64, modv: u64, grp: u64) -> Mut(EffRow) { return row.row_from_hdr(k, src, modv, grp); };
pub let bare_variant = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return row.bare_variant(k, g, i, want, out); };

// --- 内联调用状态 ---------------------------------------------------------
pub let push_inline = func(k: Mut(st.State), label: u64, slot: u64, tp: u64) -> u64 { return row.push_inline(k, label, slot, tp); };
pub let pop_inline = func(k: Mut(st.State)) -> u64 { return row.pop_inline(k); };
pub let inline_top = func(k: Mut(st.State)) -> Mut(InlineState) { return row.inline_top(k); };
pub let inline_active = func(k: Mut(st.State)) -> u64 { return row.inline_active(k); };

// --- 效应推断与调用点检查 -------------------------------------------------
pub let infer_begin = func(k: Mut(st.State), se: Mut(modules.SymEntry)) -> u64 { return infer.infer_begin(k, se); };
pub let infer_end = func(k: Mut(st.State), prev: u64) -> u64 { return infer.infer_end(k, prev); };
pub let callee_row = func(k: Mut(st.State), se: Mut(modules.SymEntry)) -> Mut(EffRow) { return infer.callee_row(k, se); };
pub let is_trap_effect = func(k: Mut(st.State), eff: Mut(modules.SymEntry)) -> u64 { return infer.is_trap_effect(k, eff); };
pub let call_guard = func(k: Mut(st.State), se: Mut(modules.SymEntry), g: u64, nxt: u64) -> u64 { return infer.call_guard(k, se, g, nxt); };
pub let call_guard_row = func(k: Mut(st.State), r: Mut(EffRow), g: u64, nxt: u64) -> u64 { return infer.call_guard_row(k, r, g, nxt); };

// --- 声明登记 -------------------------------------------------------------
pub let register_effect = func(k: Mut(st.State), name: u64, bodyg: u64, param_tid: u64, is_pub: u64) -> Mut(modules.SymEntry) { return lower.register_effect(k, name, bodyg, param_tid, is_pub); };
pub let effect_rhs = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64) -> u64 { return lower.effect_rhs(k, g, e, name, is_pub); };
pub let effect_symbol = func(k: Mut(st.State), name: u64) -> Mut(modules.SymEntry) { return lower.effect_symbol(k, name); };

// --- 降解 -----------------------------------------------------------------
pub let emit_default_return = func(k: Mut(st.State)) -> u64 { return lower.emit_default_return(k); };
pub let propagate = func(k: Mut(st.State)) -> u64 { return lower.propagate(k); };
pub let resume_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return lower.resume_expr(k, g, i, want, out); };
pub let perform_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return lower.perform_expr(k, g, i, want, out); };
pub let handler_pending = func(k: Mut(st.State)) -> u64 { return lower.handler_pending(k); };
pub let flush_one_handler = func(k: Mut(st.State)) -> u64 { return lower.flush_one_handler(k); };
pub let handle_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return lower.handle_expr(k, g, i, want, out); };
