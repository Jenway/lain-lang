let st = import("src::driver::state");
let ty = import("src::sema::types");
let ir = import("src::sema::ir_emit");
let hr = import("src::driver::host_rt");
let fm = import("std::fmt");

pub let ModEntry = struct {
  alias: u64,
  src: u64,
  kind: u64,
  owner: u64,
  seal: u64,
  prefix: u64
};

pub let SymEntry = struct {
  kind: u64,
  name: u64,
  modv: u64,
  qual: u64,
  sig: Mut(u8),
  shape: u64,
  flag: u64,
  decl: u64,
  src: u64,
  ro_flag: u64,
  fnid: u64,
  pub_flag: u64,
  home: u64
};

pub let sym_addr = func(h: u64) -> Ref(u8) {
  if h == 0 { return null_ref(Ref(u8)); }
  return hr.sym_addr(h);
};

pub let sym_len = func(h: u64) -> u64 {
  if h == 0 { return 0; }
  return hr.sym_len(h);
};

let sym_slice = func(h: u64) -> Slice(u8) {
  if h == 0 { return ""; }
  return make_slice(Slice(u8), sym_addr(h), sym_len(h));
};

let put_sym = func(c: fm.Cursor, h: u64) -> fm.Cursor {
  return fm.write_str(c, sym_slice(h));
};

let put_head = func(c: fm.Cursor, src: u64, pf: u64) -> fm.Cursor {
  if pf != 0 { return put_sym(c, pf); }
  let c1: fm.Cursor = fm.write_str(c, "s");
  let c2: fm.Cursor = fm.write_u64(c1, src);
  return fm.write_str(c2, "__");
};

let intern_done = func(c: fm.Cursor) -> u64 {
  let done: Slice(u8) = fm.fmt_done(c);
  return hr.sym_intern(done.ptr, done.len);
};

pub let copy_sym = func(dst: Mut(u8), h: u64) -> u64 {
  let len: u64 = sym_len(h);
  if len == 0 { return 0; }
  let src: Ref(u8) = sym_addr(h);
  let ds: MutSlice(u8) = make_slice(MutSlice(u8), dst, len);
  let ss: Slice(u8) = make_slice(Slice(u8), src, len);
  let i: u64 = loop c(i: u64 = 0) while i < len {
    ds[i] = ss[i];
    i = i + 1;
  };
  return len;
};

pub let qual_full = func(s: Mut(st.State), src: u64, name: u64, tail: u64) -> u64 {
  let pf: u64 = if src >= 1000 { mod_lookup_prefix(s, src) } else { 0 };
  let c0: fm.Cursor = put_head(fm.fmt_begin(), src, pf);
  let c1: fm.Cursor = put_sym(c0, name);
  return intern_done(put_sym(c1, tail));
};

pub let qual = func(s: Mut(st.State), src: u64, name: u64) -> u64 {
  return qual_full(s, src, name, 0);
};

pub let qual_num = func(s: Mut(st.State), src: u64, prefix: u64, v: u64) -> u64 {
  let c0: fm.Cursor = put_head(fm.fmt_begin(), src, 0);
  let c1: fm.Cursor = put_sym(c0, prefix);
  return intern_done(fm.write_u64(c1, v));
};

pub let cur = func(s: Mut(st.State)) -> u64 { return st.st_scope(s); };

let in_cur = func(s: Mut(st.State), name: u64) -> u64 { return qual(s, cur(s), name); };

pub let mod_kind_import = func() -> u64 { return 1; };
pub let mod_kind_open = func() -> u64 { return 2; };
pub let mod_kind_parent = func() -> u64 { return 4; };
pub let mod_kind_vmod = func() -> u64 { return 5; };

pub let mod_add_in = func(s: Mut(st.State), owner: u64, alias: u64, src: u64, kind: u64, seal: u64, prefix: u64) -> Mut(ModEntry) {
  let p: Mut(ModEntry) = ptr_cast(Mut(ModEntry), st.st_mod_new(s, 48));
  if is_null(p) { return null_ref(Mut(ModEntry)); }
  p.alias = alias;
  p.src = src;
  p.kind = kind;
  p.owner = owner;
  p.seal = seal;
  p.prefix = prefix;
  return p;
};

pub let mod_add = func(s: Mut(st.State), alias: u64, src: u64, kind: u64) -> u64 {
  let p: Mut(ModEntry) = mod_add_in(s, cur(s), alias, src, kind, 0, 0);
  if is_null(p) { return 0; }
  return 1;
};

pub let mod_add_open = func(s: Mut(st.State), owner: u64, target_mod: u64, seal: u64) -> u64 {
  let p: Mut(ModEntry) = mod_add_in(s, owner, 0, target_mod, mod_kind_open(), seal, 0);
  if is_null(p) { return 0; }
  return 1;
};

pub let mod_set_parent = func(s: Mut(st.State), child_mod: u64, parent_mod: u64) -> u64 {
  let p: Mut(ModEntry) = mod_add_in(s, child_mod, 0, parent_mod, mod_kind_parent(), 0, 0);
  if is_null(p) { return 0; }
  return 1;
};

pub let mod_register_vmod = func(s: Mut(st.State), vmod: u64, prefix: u64) -> u64 {
  let p: Mut(ModEntry) = mod_add_in(s, vmod, 0, vmod, mod_kind_vmod(), 0, prefix);
  if is_null(p) { return 0; }
  return vmod;
};

let mod_at = func(s: Mut(st.State), i: u64) -> Mut(ModEntry) {
  return ptr_cast(Mut(ModEntry), st.st_modbase(s) + i * 48);
};

let mod_count = func(s: Mut(st.State)) -> u64 { return st.st_modused(s) / 48; };

let mod_src = func(p: Mut(ModEntry)) -> u64 { return p.src; };
let mod_kind = func(p: Mut(ModEntry)) -> u64 { return p.kind; };
let mod_seal = func(p: Mut(ModEntry)) -> u64 { return p.seal; };
let mod_prefix = func(p: Mut(ModEntry)) -> u64 { return p.prefix; };

pub let mod_lookup = func(s: Mut(st.State), alias: u64) -> u64 {
  let m: Mut(ModEntry) = mod_lookup_lex(s, cur(s), alias, 0);
  if is_null(m) { return 0; }
  return m.src + 1;
};

let entry_scan = func(s: Mut(st.State), owner: u64, alias: u64, i: u64, n: u64) -> Mut(ModEntry) {
  if i >= n { return null_ref(Mut(ModEntry)); }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.alias == alias and p.owner == owner { return p; }
  return entry_scan(s, owner, alias, i + 1, n);
};

pub let mod_lookup_entry = func(s: Mut(st.State), owner: u64, alias: u64) -> Mut(ModEntry) {
  if alias == 0 { return null_ref(Mut(ModEntry)); }
  return entry_scan(s, owner, alias, 0, mod_count(s));
};

let mod_name_scan = func(s: Mut(st.State), src: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.alias != 0 and p.src == src { return p.alias; }
  return mod_name_scan(s, src, i + 1, n);
};

let mod_name_of = func(s: Mut(st.State), src: u64) -> u64 {
  return mod_name_scan(s, src, 0, mod_count(s));
};

let prefix_scan = func(s: Mut(st.State), vmod: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.src == vmod and p.prefix != 0 {
    if p.kind == mod_kind_vmod() or p.kind == mod_kind_import() { return p.prefix; }
  }
  return prefix_scan(s, vmod, i + 1, n);
};

let mod_lookup_prefix = func(s: Mut(st.State), vmod: u64) -> u64 {
  return prefix_scan(s, vmod, 0, mod_count(s));
};

let parent_scan = func(s: Mut(st.State), child_mod: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.owner == child_mod and p.kind == mod_kind_parent() { return p.src + 1; }
  return parent_scan(s, child_mod, i + 1, n);
};

let mod_parent = func(s: Mut(st.State), child_mod: u64) -> u64 {
  return parent_scan(s, child_mod, 0, mod_count(s));
};

let mod_lookup_lex = func(s: Mut(st.State), modv: u64, alias: u64, depth: u64) -> Mut(ModEntry) {
  if depth > 16 { return null_ref(Mut(ModEntry)); }
  if alias == 0 { return null_ref(Mut(ModEntry)); }
  let m: Mut(ModEntry) = mod_lookup_entry(s, modv, alias);
  if is_null(m) == 0 { return m; }
  let par1: u64 = mod_parent(s, modv);
  if par1 == 0 { return null_ref(Mut(ModEntry)); }
  return mod_lookup_lex(s, par1 - 1, alias, depth + 1);
};

pub let sym_kind_struct = func() -> u64 { return 1; };
pub let sym_kind_enum = func() -> u64 { return 2; };
pub let sym_kind_func = func() -> u64 { return 3; };
pub let sym_kind_extern = func() -> u64 { return 4; };
pub let sym_kind_data = func() -> u64 { return 5; };
pub let sym_kind_value = func() -> u64 { return 6; };
pub let sym_kind_generic = func() -> u64 { return 7; };
pub let sym_kind_mod = func() -> u64 { return 8; };
pub let sym_kind_sig = func() -> u64 { return 9; };
pub let sym_kind_type_alias = func() -> u64 { return 10; };

let name_key = func(s: Mut(st.State), h: u64) -> u64 {
  if h == 0 { return 0; }
  let n: u64 = sym_len(h);
  if n == 0 { return 0; }

  let f: u64 = hr.sym_find(sym_addr(h), n);
  if f != 0 { return f; }
  return h;
};

pub let sym_add = func(s: Mut(st.State), kind: u64, mod: u64, name: u64, q: u64, sig: Mut(u8), sh: u64) -> Mut(SymEntry) {
  let p: Mut(SymEntry) = ptr_cast(Mut(SymEntry), st.st_sym_new(s, 104));
  p.kind = kind;
  p.name = name;
  p.modv = mod;
  p.qual = q;
  p.sig = sig;
  p.shape = sh;
  p.flag = 0;
  p.decl = 0;
  p.src = st.st_src(s);
  p.ro_flag = 0;
  p.fnid = 0;
  p.pub_flag = 0;
  p.home = mod;
  return p;
};

pub let sym_count = func(s: Mut(st.State)) -> u64 { return st.st_symused(s) / 104; };

pub let sym_at = func(s: Mut(st.State), i: u64) -> Mut(SymEntry) {
  return ptr_cast(Mut(SymEntry), st.st_symbase(s) + i * 104);
};

pub let sym_kind = func(p: Mut(SymEntry)) -> u64 { return p.kind; };
pub let sym_name = func(p: Mut(SymEntry)) -> u64 { return p.name; };
pub let sym_mod = func(p: Mut(SymEntry)) -> u64 { return p.modv; };
pub let sym_home = func(p: Mut(SymEntry)) -> u64 { return p.home; };
pub let sym_set_home = func(p: Mut(SymEntry), v: u64) -> u64 { p.home = v; return v; };
pub let sym_qual = func(p: Mut(SymEntry)) -> u64 { return p.qual; };
pub let sym_sig = func(p: Mut(SymEntry)) -> Mut(u8) { return p.sig; };
pub let sym_shape = func(p: Mut(SymEntry)) -> u64 { return p.shape; };

pub let sym_flag = func(p: Mut(SymEntry)) -> u64 { return p.flag; };
pub let sym_set_flag = func(p: Mut(SymEntry), v: u64) -> u64 { p.flag = v; return v; };

pub let sym_decl = func(p: Mut(SymEntry)) -> u64 { return p.decl; };
pub let sym_set_decl = func(p: Mut(SymEntry), v: u64) -> u64 { p.decl = v; return v; };
pub let sym_src = func(p: Mut(SymEntry)) -> u64 { return p.src; };
pub let sym_set_src = func(p: Mut(SymEntry), v: u64) -> u64 { p.src = v; return v; };

pub let sym_ro = func(p: Mut(SymEntry)) -> u64 { return p.ro_flag; };
pub let sym_set_ro = func(p: Mut(SymEntry), v: u64) -> u64 { p.ro_flag = v; return v; };
pub let sym_fnid = func(p: Mut(SymEntry)) -> u64 { return p.fnid; };
pub let sym_set_fnid = func(p: Mut(SymEntry), v: u64) -> u64 { p.fnid = v; return v; };

pub let sym_pub = func(p: Mut(SymEntry)) -> u64 { return p.pub_flag; };
pub let sym_set_pub = func(p: Mut(SymEntry), v: u64) -> u64 { p.pub_flag = v; return v; };

let sym_same = func(a: u64, b: u64) -> u64 { return hr.sym_same(a, b); };

let sym_scan = func(s: Mut(st.State), mod: u64, name: u64, i: u64, n: u64) -> Mut(SymEntry) {
  if i >= n { return null_ref(Mut(SymEntry)); }
  let p: Mut(SymEntry) = sym_at(s, i);
  if p.modv == mod {
    if p.name != 0 {
      if name != 0 {
        if hr.sym_same(p.name, name) == 1 { return p; }
      }
    }
  }
  return sym_scan(s, mod, name, i + 1, n);
};

pub let is_struct_name = func(s: Mut(st.State), sym: u64) -> u64 {
  let e: Mut(SymEntry) = find_here(s, sym);
  if is_null(e) { return 0; }
  if sym_kind(e) == sym_kind_struct() { return 1; }
  return 0;
};

pub let sym_find = func(s: Mut(st.State), mod: u64, name: u64) -> Mut(SymEntry) {
  return sym_scan(s, mod, name, 0, sym_count(s));
};

let parent_mod_sym = func(s: Mut(st.State), modv: u64, name: u64, depth: u64) -> Mut(SymEntry) {
  if depth > 16 { return null_ref(Mut(SymEntry)); }
  let par1: u64 = mod_parent(s, modv);
  if par1 == 0 { return null_ref(Mut(SymEntry)); }
  let par: u64 = par1 - 1;
  let e: Mut(SymEntry) = sym_find(s, par, name);
  if is_null(e) == 0 {
    if e.kind == sym_kind_mod() { return e; }
  }
  return parent_mod_sym(s, par, name, depth + 1);
};

let sym_is_visible = func(s: Mut(st.State), sym: Mut(SymEntry), cur_mod: u64) -> u64 {
  if is_null(sym) { return 0; }
  if sym.modv == cur_mod { return 1; }
  if sym.pub_flag != 0 { return 1; }
  return 0;
};

pub let sym_lookup_in = func(s: Mut(st.State), target_mod: u64, seal_mod: u64, name: u64, cur_mod: u64) -> Mut(SymEntry) {
  let e: Mut(SymEntry) = sym_find(s, target_mod, name);
  if is_null(e) { return null_ref(Mut(SymEntry)); }
  if sym_is_visible(s, e, cur_mod) == 0 { return null_ref(Mut(SymEntry)); }
  if seal_mod != 0 {
    let sv: Mut(SymEntry) = sym_find(s, seal_mod, name);
    if is_null(sv) { return null_ref(Mut(SymEntry)); }
    if sv.pub_flag == 0 { return null_ref(Mut(SymEntry)); }
  }
  return e;
};

pub let resolve_child_mod = func(s: Mut(st.State), owner_mod: u64, seal_mod: u64, name: u64, cur_mod: u64, out_seal: Mut(u64)) -> u64 {
  let e: Mut(SymEntry) = sym_lookup_in(s, owner_mod, seal_mod, name, cur_mod);
  if is_null(e) == 0 {
    if e.kind == sym_kind_mod() {
      deref(out_seal) = e.decl;
      return e.qual;
    }
  }
  if owner_mod == cur_mod {
    let m: Mut(ModEntry) = mod_lookup_lex(s, owner_mod, name, 0);
    if is_null(m) == 0 {
      deref(out_seal) = m.seal;
      return m.src;
    }
    let pm: Mut(SymEntry) = parent_mod_sym(s, owner_mod, name, 0);
    if is_null(pm) == 0 {
      deref(out_seal) = pm.decl;
      return pm.qual;
    }
  }
  return 0;
};

let path_step = func(s: Mut(st.State), ss: MutSlice(u64), i: u64, n: u64, owner: u64, seal: u64, cur_mod: u64, out_seal: Mut(u64)) -> u64 {
  if i >= n { return owner; }
  let nm: u64 = ss[i];
  let nx: u64 = resolve_child_mod(s, owner, seal, nm, cur_mod, out_seal);
  if nx == 0 { return 0; }
  let ns: u64 = deref(out_seal);
  return path_step(s, ss, i + 1, n, nx, ns, cur_mod, out_seal);
};

pub let mod_resolve_path = func(s: Mut(st.State), cur_mod: u64, first_name: u64, segs: Mut(u64), nsegs: u64, out_seal: Mut(u64)) -> u64 {
  let m: u64 = resolve_child_mod(s, cur_mod, 0, first_name, cur_mod, out_seal);
  if m == 0 { return 0; }
  if nsegs == 0 { return m; }
  let ss: MutSlice(u64) = make_slice(MutSlice(u64), segs, nsegs);
  let sl: u64 = deref(out_seal);
  return path_step(s, ss, 0, nsegs, m, sl, cur_mod, out_seal);
};

let open_scan = func(s: Mut(st.State), owner: u64, name: u64, cur_mod: u64, i: u64, n: u64) -> Mut(SymEntry) {
  if i >= n { return null_ref(Mut(SymEntry)); }
  let p: Mut(ModEntry) = mod_at(s, i);
  if p.owner == owner and p.kind == mod_kind_open() {
    let e: Mut(SymEntry) = sym_lookup_in(s, p.src, p.seal, name, cur_mod);
    if is_null(e) == 0 { return e; }
  }
  return open_scan(s, owner, name, cur_mod, i + 1, n);
};

let here_at = func(s: Mut(st.State), walk_mod: u64, name: u64, cur_mod: u64, depth: u64) -> Mut(SymEntry) {
  if depth > 16 { return null_ref(Mut(SymEntry)); }
  let e: Mut(SymEntry) = sym_find(s, walk_mod, name);
  if is_null(e) == 0 { return e; }
  let o: Mut(SymEntry) = open_scan(s, walk_mod, name, cur_mod, 0, mod_count(s));
  if is_null(o) == 0 { return o; }
  let par1: u64 = mod_parent(s, walk_mod);
  if par1 == 0 { return null_ref(Mut(SymEntry)); }
  return here_at(s, par1 - 1, name, cur_mod, depth + 1);
};

pub let find_here = func(s: Mut(st.State), name: u64) -> Mut(SymEntry) {
  return here_at(s, cur(s), name, cur(s), 0);
};
