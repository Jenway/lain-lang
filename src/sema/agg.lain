let st = import("src::driver::state");
let ty = import("src::sema::types");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");

pub let Member = struct {
  name: u64,
  off: u64,
  tag: u64,
  has: u64,
  k: u64,
  w: u64,
  sg: u64,
  sh: u64
};

pub let Shape = struct {
  kind: u64,
  name: u64,
  modv: u64,
  size: u64,
  align: u64,
  count: u64,
  length: u64,
  is_static: u64,
  tid: u64,
  elem: u64,
  ret_tid: u64,
  sig: u64,
  mem: Mut(Member),
  memcap: u64,
  drop_q: u64,
  has_drop: u64
};

pub let ShapeKind = enum(u64) {
  Struct = 1,
  Enum = 2,
  Array = 3,
  String = 4,
  Ref = 6,
  Mut = 7,
  Slice = 8,
  MutSlice = 9,

  Uninit = 10,
  Fn = 11,
  Type = 12,

  CEnum = 13
};

pub let shp_ptr = func(sh: u64) -> Mut(Shape) { return ptr_cast(Mut(Shape), sh); };

pub let shp_rec = func() -> u64 { return 128; };

pub let shape_at = func(k: Mut(st.State), i: u64) -> u64 {
  let b: Mut(u8) = st.st_shpbase(k);
  return (b + i * shp_rec()) as u64;
};

let mem_init = func() -> u64 { return 8; };

let align_up = func(v: u64, a: u64) -> u64 {
  if a == 0 { return v; }
  return (v + a - 1) / a * a;
};

pub let shp_new = func(s: Mut(st.State), kind: u64, name: u64, m: u64) -> u64 {
  let p: Mut(Shape) = ptr_cast(Mut(Shape), st.st_shp_new(s, shp_rec()));
  p.kind = kind;
  p.name = name;
  p.modv = m;
  p.size = 0;
  p.align = 1;
  p.count = 0;
  p.length = 0;
  p.is_static = 0;
  p.tid = 0;
  p.elem = 0;
  p.ret_tid = 0;
  p.sig = 0;
  p.drop_q = 0;
  p.has_drop = 0;
  let ms: Mut(Member) = ptr_cast(Mut(Member), st.st_ralloc(s, mem_init() * 64));
  p.mem = ms;
  p.memcap = mem_init();
  return p as u64;
};

let shp_mem = func(sh: u64) -> Mut(Member) { let p: Mut(Shape) = shp_ptr(sh); return p.mem; };
let shp_memcap = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.memcap; };
pub let shp_kind = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.kind; };
pub let shp_name = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.name; };
let shp_mod = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.modv; };
pub let shp_set_name = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.name = v; return v; };
pub let shp_set_mod = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.modv = v; return v; };
pub let shp_size = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.size; };
pub let shp_align = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.align; };
pub let shp_count = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.count; };

pub let shp_len = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.length; };
pub let shp_static = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.is_static; };
pub let shp_set_static = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.is_static = v; return v; };
pub let shp_tid = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.tid; };
pub let shp_set_tid = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.tid = v; return v; };
pub let shp_elem = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.elem; };
pub let shp_set_elem = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.elem = v; return v; };
pub let shp_ret = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.ret_tid; };
pub let shp_set_ret = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.ret_tid = v; return v; };
pub let shp_sig = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.sig; };
pub let shp_set_sig = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.sig = v; return v; };

pub let shp_und_w = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.elem; };
pub let shp_und_sg = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.ret_tid; };
pub let shp_set_under = func(sh: u64, w: u64, sg: u64) -> u64 {
  let p: Mut(Shape) = shp_ptr(sh);
  p.elem = w;
  p.ret_tid = sg;
  return w;
};
pub let shp_drop_q = func(sh: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); return p.drop_q; };
pub let shp_set_drop_q = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.drop_q = v; return v; };
pub let shp_has_drop = func(sh: u64) -> u64 {
  if sh == 0 { return 0; }
  let p: Mut(Shape) = shp_ptr(sh);
  return p.has_drop;
};
pub let shp_set_has_drop = func(sh: u64, v: u64) -> u64 { let p: Mut(Shape) = shp_ptr(sh); p.has_drop = v; return v; };

pub let mem_at = func(sh: u64, i: u64) -> Mut(Member) {
  let base: Mut(u8) = ptr_cast(Mut(u8), shp_mem(sh));
  return ptr_cast(Mut(Member), base + i * 64);
};

let mem_copy = func(dst: Mut(Member), src: Mut(Member), n: u64, i: u64) -> u64 {
  if i >= n { return 1; }
  let d: Mut(Member) = ptr_cast(Mut(Member), ptr_cast(Mut(u8), dst) + i * 64);
  let p: Mut(Member) = ptr_cast(Mut(Member), ptr_cast(Mut(u8), src) + i * 64);
  d.name = p.name;
  d.off = p.off;
  d.tag = p.tag;
  d.has = p.has;
  d.k = p.k;
  d.w = p.w;
  d.sg = p.sg;
  d.sh = p.sh;
  return mem_copy(dst, src, n, i + 1);
};

let mem_reserve = func(s: Mut(st.State), sh: u64, need: u64) -> u64 {
  let cap: u64 = shp_memcap(sh);
  if need <= cap { return 1; }
  let ncap: u64 = cap * 2;
  let nb: Mut(Member) = ptr_cast(Mut(Member), st.st_ralloc(s, ncap * 64));
  if st.st_ok(s) != 0 { return 0; }
  let old: Mut(Member) = shp_mem(sh);
  let used: u64 = shp_count(sh);
  let cp: u64 = mem_copy(nb, old, used, 0);
  let p: Mut(Shape) = shp_ptr(sh);
  p.mem = nb;
  p.memcap = ncap;
  return 1;
};

pub let mem_name = func(m: Mut(Member)) -> u64 { return m.name; };
pub let mem_off = func(m: Mut(Member)) -> u64 { return m.off; };
pub let mem_tag = func(m: Mut(Member)) -> u64 { return m.tag; };
pub let mem_has = func(m: Mut(Member)) -> u64 { return m.has; };
pub let mem_k = func(m: Mut(Member)) -> u64 { return m.k; };
pub let mem_w = func(m: Mut(Member)) -> u64 { return m.w; };
let mem_sg = func(m: Mut(Member)) -> u64 { return m.sg; };
pub let mem_sh = func(m: Mut(Member)) -> u64 { return m.sh; };

pub let mem_ty = func(k: Mut(st.State), m: Mut(Member), out: Mut(ty.Ty)) -> u64 {
  let save: u64 = ty.ty_save(out, m.k, m.w, m.sg);
  return ty.ty_set_sh(out, m.sh);
};

pub let type_size = func(k: u64, w: u64, sub: u64) -> u64 {
  if sub != 0 { return shp_size(sub); }
  if k == 3 { return 8; }
  let n: u64 = w / 8;
  if n == 0 { return 1; }
  return n;
};

pub let type_align = func(k: u64, w: u64, sub: u64) -> u64 {
  if sub != 0 { return shp_align(sub); }
  if k == 3 { return 8; }
  let n: u64 = w / 8;
  if n == 0 { return 1; }
  return n;
};

pub let add_member = func(s: Mut(st.State), sh: u64, name: u64, off: u64, tag: u64, has: u64,
                k: u64, w: u64, sg: u64, sub: u64) -> Mut(Member) {
  let p: Mut(Shape) = shp_ptr(sh);
  let i: u64 = p.count;
  let rs: u64 = mem_reserve(s, sh, i + 1);
  if st.st_ok(s) != 0 { return null_ref(Mut(Member)); }
  let m: Mut(Member) = mem_at(sh, i);
  m.name = name;
  m.off = off;
  m.tag = tag;
  m.has = has;
  m.k = k;
  m.w = w;
  m.sg = sg;
  m.sh = sub;
  p.count = i + 1;
  return m;
};

pub let field_add = func(s: Mut(st.State), sh: u64, name: u64, k: u64, w: u64, sg: u64, sub: u64) -> Mut(Member) {
  let p: Mut(Shape) = shp_ptr(sh);
  let a: u64 = type_align(k, w, sub);
  if a > p.align { p.align = a; }
  let off: u64 = align_up(p.size, a);
  let sz: u64 = type_size(k, w, sub);
  p.size = off + sz;
  if sub != 0 and shp_has_drop(sub) == 1 { p.has_drop = 1; }
  return add_member(s, sh, name, off, 0, 1, k, w, sg, sub);
};

pub let variant_add = func(s: Mut(st.State), sh: u64, name: u64, has: u64, k: u64, w: u64, sg: u64,
                 sub: u64) -> Mut(Member) {
  let p: Mut(Shape) = shp_ptr(sh);
  let tag: u64 = p.count;
  let a: u64 = type_align(k, w, sub);
  if a > p.align { p.align = a; }
  let off: u64 = align_up(1, a);
  let sz: u64 = type_size(k, w, sub);
  let end: u64 = if has == 1 { off + sz } else { 1 };
  if end > p.size { p.size = end; }
  return add_member(s, sh, name, off, tag, has, k, w, sg, sub);
};

pub let cenum_new = func(s: Mut(st.State), name: u64, w: u64, sg: u64) -> u64 {
  let sh: u64 = shp_new(s, ShapeKind.CEnum as u64, name, st.st_src(s));
  let p: Mut(Shape) = shp_ptr(sh);
  let sz: u64 = w / 8;
  p.size = sz;
  p.align = sz;
  let u: u64 = shp_set_under(sh, w, sg);
  return sh;
};

pub let cenum_variant_add = func(s: Mut(st.State), sh: u64, name: u64, value: u64) -> Mut(Member) {
  let p: Mut(Shape) = shp_ptr(sh);
  let i: u64 = p.count;
  let rs: u64 = mem_reserve(s, sh, i + 1);
  if st.st_ok(s) != 0 { return null_ref(Mut(Member)); }
  let m: Mut(Member) = mem_at(sh, i);
  m.name = name;
  m.off = 0;
  m.tag = value;
  m.has = 0;
  m.k = 0;
  m.w = 0;
  m.sg = 0;
  m.sh = 0;
  p.count = i + 1;
  return m;
};

pub let cenum_ty = func(sh: u64, out: Mut(ty.Ty)) -> u64 {
  let w: u64 = shp_und_w(sh);
  let sg: u64 = shp_und_sg(sh);
  ty.ty_save(out, codes.TyKind.Bits as u64, w, sg);
  return ty.ty_set_sh(out, sh);
};

pub let cenum_lit = func(k: Mut(st.State), sh: u64, value: u64, out: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let a: u64 = cenum_ty(sh, t);
  return ty.val_lit(out, value, t);
};

pub let array_new = func(s: Mut(st.State), kind: u64, n: u64, k: u64, w: u64, sg: u64, sub: u64) -> u64 {
  let sh: u64 = shp_new(s, kind, 0, st.st_src(s));
  let esz: u64 = type_size(k, w, sub);
  let ea: u64 = type_align(k, w, sub);
  let p: Mut(Shape) = shp_ptr(sh);
  p.size = esz * n;
  p.align = ea;
  p.length = n;
  let m: Mut(Member) = add_member(s, sh, 0, 0, 0, 1, k, w, sg, sub);
  return sh;
};

pub let finish = func(s: Mut(st.State), sh: u64) -> u64 {
  let p: Mut(Shape) = shp_ptr(sh);
  let a0: u64 = p.align;
  let a: u64 = if a0 == 0 { 1 } else { a0 };
  p.align = a;
  p.size = align_up(p.size, a);
  return 0;
};

let mem_scan = func(sh: u64, name: u64, i: u64, n: u64) -> Mut(Member) {
  if i >= n { return null_ref(Mut(Member)); }
  let m: Mut(Member) = mem_at(sh, i);
  if m.name == name { return m; }
  return mem_scan(sh, name, i + 1, n);
};

pub let mem_find = func(sh: u64, name: u64) -> Mut(Member) {
  let n: u64 = shp_count(sh);
  return mem_scan(sh, name, 0, n);
};

pub let mem_index = func(sh: u64, i: u64) -> Mut(Member) { return mem_at(sh, i); };

pub let new_obj = func(k: Mut(st.State), sh: u64, out: Mut(ty.Val)) -> u64 {

  let raw: u64 = shp_size(sh);
  let size: u64 = if raw == 0 { 1 } else { raw };
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_int(k, size);
  let tv: Mut(ty.Ty) = ir.tbits(k, 8);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Alloca as u64, res, tv, 0);
  let at: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let ta: u64 = ty.ty_addr(at);
  let sh_set: u64 = ty.ty_set_sh(at, sh);
  let v: u64 = ty.val_ref(out, res, at);
  return res;
};

pub let new_bytes = func(k: Mut(st.State), n: u64, al: u64, out: Mut(ty.Val)) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_int(k, n);
  let tv: Mut(ty.Ty) = ir.tbits(k, 8);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Alloca as u64, res, tv, 0);
  let at: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let ta: u64 = ty.ty_addr(at);
  let v: u64 = ty.val_ref(out, res, at);
  return res;
};

pub let off_of = func(k: Mut(st.State), obj: u64, off: u64) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let ins: u64 = ir.emit_lea(k, res, obj, 0, 1, off);
  return res;
};

pub let is_value_shape = func(sh: u64) -> u64 {
  if sh == 0 { return 0; }
  let kd: u64 = shp_kind(sh);
  if kd == ShapeKind.Struct as u64 { return 1; }
  if kd == ShapeKind.Enum as u64 { return 1; }
  if kd == ShapeKind.Array as u64 { return 1; }
  if kd == ShapeKind.Slice as u64 { return 1; }
  if kd == ShapeKind.MutSlice as u64 { return 1; }
  return 0;
};

pub let is_value_agg = func(tp: Mut(ty.Ty)) -> u64 {
  if ty.tk(tp) != (codes.TyKind.Addr as u64) { return 0; }
  return is_value_shape(ty.tsh(tp));
};

pub let copy_bytes_at = func(k: Mut(st.State), dst_obj: u64, dst_off: u64, src_ptr: u64,
                size: u64) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let words: u64 = size / 8;
  let wdone: u64 = loop w(j: u64 = 0) while j < words {
    let dp: u64 = off_of(k, dst_obj, dst_off + j * 8);
    let sp: u64 = off_of(k, src_ptr, j * 8);
    let wv: u64 = ir.fresh_t(k);
    let rc0: u64 = ir.args_reset(k);
    let a0: u64 = ir.arg_ref(k, sp);
    let l0: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, wv, t64, 0);
    let rc1: u64 = ir.args_reset(k);
    let a1: u64 = ir.arg_ref(k, wv);
    let a2: u64 = ir.arg_ref(k, dp);
    let s0: u64 = ir.emit_mem(k, codes.InstKind.Store as u64, 0, t64, 0);
    j = j + 1;
  };
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let rest: u64 = size - words * 8;
  let bdone: u64 = loop b(j: u64 = 0) while j < rest {
    let dp: u64 = off_of(k, dst_obj, dst_off + words * 8 + j);
    let sp: u64 = off_of(k, src_ptr, words * 8 + j);
    let bv: u64 = ir.fresh_t(k);
    let rc2: u64 = ir.args_reset(k);
    let a3: u64 = ir.arg_ref(k, sp);
    let l1: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, bv, t8, 0);
    let rc3: u64 = ir.args_reset(k);
    let a4: u64 = ir.arg_ref(k, bv);
    let a5: u64 = ir.arg_ref(k, dp);
    let s1: u64 = ir.emit_mem(k, codes.InstKind.Store as u64, 0, t8, 0);
    j = j + 1;
  };
  return size;
};

let is_subbyte_bits = func(tp: Mut(ty.Ty)) -> u64 {
  if ty.tk(tp) != (codes.TyKind.Bits as u64) { return 0; }
  return if ty.ty_byte_ok(tp) == 0 { 1 } else { 0 };
};

let byte_t = func(k: Mut(st.State)) -> Mut(ty.Ty) {
  return ir.tbits(k, 8);
};

let widen_byte = func(k: Mut(st.State), v: Mut(ty.Val), t8: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  if ty.vlit(v) == 1 { return ty.val_lit(out, ty.vbits(v), t8); }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, ty.vn(v));
  let ins: u64 = ir.emit(k, codes.InstKind.ZExt as u64, res, t8);
  return ty.val_ref(out, res, t8);
};

let narrow_byte = func(k: Mut(st.State), raw: u64, tp: Mut(ty.Ty)) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, raw);
  let ins: u64 = ir.emit(k, codes.InstKind.Trunc as u64, res, tp);
  return res;
};

pub let store_at = func(k: Mut(st.State), obj: u64, off: u64, val: Mut(ty.Val), tp: Mut(ty.Ty)) -> u64 {
  if is_value_agg(tp) == 1 {
    let sh: u64 = ty.tsh(tp);
    return copy_bytes_at(k, obj, off, ty.vn(val), shp_size(sh));
  }
  let p: u64 = off_of(k, obj, off);
  if is_subbyte_bits(tp) == 1 {
    let t8: Mut(ty.Ty) = byte_t(k);
    let w: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
    let wv: u64 = widen_byte(k, val, t8, w);
    let rc: u64 = ir.args_reset(k);
    let a: u64 = ir.op_val(k, w);
    let b: u64 = ir.arg_ref(k, p);
    return ir.emit_mem(k, codes.InstKind.Store as u64, 0, t8, 0);
  }
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, val);
  let b: u64 = ir.arg_ref(k, p);
  return ir.emit_mem(k, codes.InstKind.Store as u64, 0, tp, 0);
};

pub let load_at = func(k: Mut(st.State), obj: u64, off: u64, tp: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let p: u64 = off_of(k, obj, off);
  if is_value_agg(tp) == 1 {
    return ty.val_ref(out, p, tp);
  }
  if is_subbyte_bits(tp) == 1 {
    let t8: Mut(ty.Ty) = byte_t(k);
    let raw: u64 = ir.fresh_t(k);
    let rc: u64 = ir.args_reset(k);
    let a: u64 = ir.arg_ref(k, p);
    let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, raw, t8, 0);
    let res: u64 = narrow_byte(k, raw, tp);
    return ty.val_ref(out, res, tp);
  }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, p);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, res, tp, 0);
  return ty.val_ref(out, res, tp);
};

pub let zero_at = func(k: Mut(st.State), obj: u64, off: u64, size: u64) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let words: u64 = size / 8;
  let wdone: u64 = loop w(j: u64 = 0) while j < words {
    let dp: u64 = off_of(k, obj, off + j * 8);
    let rc0: u64 = ir.args_reset(k);
    let a0: u64 = ir.arg_int(k, 0);
    let a1: u64 = ir.arg_ref(k, dp);
    let s0: u64 = ir.emit_mem(k, codes.InstKind.Store as u64, 0, t64, 0);
    j = j + 1;
  };
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let rest: u64 = size - words * 8;
  let bdone: u64 = loop b(j: u64 = 0) while j < rest {
    let dp: u64 = off_of(k, obj, words * 8 + j);
    let rc1: u64 = ir.args_reset(k);
    let a2: u64 = ir.arg_int(k, 0);
    let a3: u64 = ir.arg_ref(k, dp);
    let s1: u64 = ir.emit_mem(k, codes.InstKind.Store as u64, 0, t8, 0);
    j = j + 1;
  };
  return size;
};

let tag_read = func(k: Mut(st.State), obj: u64) -> u64 {
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, obj);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, res, t8, 0);
  return res;
};

pub let tag_write = func(k: Mut(st.State), obj: u64, tag: u64) -> u64 {
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_int(k, tag);
  let b: u64 = ir.arg_ref(k, obj);
  return ir.emit_mem(k, codes.InstKind.Store as u64, 0, t8, 0);
};

pub let variant_proj = func(k: Mut(st.State), sh: u64, obj: u64, name: u64, res_ty: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let m: Mut(Member) = mem_find(sh, name);
  if is_null(m) {
    let rc: u64 = st.st_fail(k, 2);
    let v: u64 = ty.val_none(out);
    return 0;
  }
  let tag: u64 = mem_tag(m);
  let mt: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let mtb: u64 = mem_ty(k, m, mt);
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let tg: u64 = tag_read(k, obj);
  let ceq: u64 = ir.fresh_t(k);
  let rc0: u64 = ir.args_reset(k);
  let a0: u64 = ir.arg_ref(k, tg);
  let a1: u64 = ir.arg_int(k, tag);
  let eqi: u64 = ir.emit(k, codes.InstKind.Eq as u64, ceq, t8);
  let h1: u64 = proj_then(k, m, obj, res_ty, mt);
  let h2: u64 = proj_zero(k, res_ty);
  let res: u64 = ir.fresh_t(k);
  let ifi: u64 = ir.emit_if(k, res, ceq, h1, h2);
  return ty.val_ref(out, res, res_ty);
};

let proj_then = func(k: Mut(st.State), m: Mut(Member), obj: u64, res_ty: Mut(ty.Ty), mt: Mut(ty.Ty)) -> u64 {
  let r: u64 = ir.region_begin(k);
  let rr: u64 = ir.region_result(k, res_ty);
  let has: u64 = mem_has(m);
  if has == 1 {
    let lv: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
    let l: u64 = load_at(k, obj, mem_off(m), mt, lv);
    let rc2: u64 = ir.args_reset(k);
    let b: u64 = ir.op_val(k, lv);
    let y: u64 = ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  } else {
    let rc: u64 = ir.args_reset(k);
    let a: u64 = ir.arg_int(k, 0);
    let y: u64 = ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  }
  return ir.region_end(k);
};

let proj_zero = func(k: Mut(st.State), res_ty: Mut(ty.Ty)) -> u64 {
  let r: u64 = ir.region_begin(k);
  let rr: u64 = ir.region_result(k, res_ty);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_int(k, 0);
  let y: u64 = ir.emit_jump(k, codes.InstKind.Yield as u64, 0);
  return ir.region_end(k);
};

let sret_shape = func(sh: u64) -> u64 { return is_value_shape(sh); };

pub let sret_ty = func(t: Mut(ty.Ty)) -> u64 { return sret_shape(ty.tsh(t)); };

let copy_words = func(k: Mut(st.State), dst: u64, src: u64, n: u64) -> u64 {
  let t8: Mut(ty.Ty) = ir.tbits(k, 64);
  let i: u64 = loop w(j: u64 = 0) while j < n {
    let v: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
    let l: u64 = load_at(k, src, j * 8, t8, v);
    let s: u64 = store_at(k, dst, j * 8, v, t8);
    j = j + 1;
  };
  return n;
};

let copy_tail = func(k: Mut(st.State), dst: u64, src: u64, at: u64, n: u64) -> u64 {
  let t8: Mut(ty.Ty) = ir.tbits(k, 8);
  let i: u64 = loop b(j: u64 = 0) while j < n {
    let v: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
    let l: u64 = load_at(k, src, at + j, t8, v);
    let s: u64 = store_at(k, dst, at + j, v, t8);
    j = j + 1;
  };
  return n;
};

pub let copy_block = func(k: Mut(st.State), dst: u64, src: u64, size: u64) -> u64 {
  let words: u64 = size / 8;
  let h: u64 = copy_words(k, dst, src, words);
  let rest: u64 = size - words * 8;
  if rest == 0 { return size; }
  return copy_tail(k, dst, src, words * 8, rest);
};

let drop_member_at = func(k: Mut(st.State), sh: u64, obj: u64, i: u64) -> u64 {
  if i == 0 { return 0; }
  let idx: u64 = i - 1;
  let m: Mut(Member) = mem_at(sh, idx);
  let hs: u64 = m.sh;
  if m.has == 1 and hs != 0 and shp_has_drop(hs) == 1 {
    let faddr: u64 = off_of(k, obj, m.off);
    let r: u64 = drop_value_at(k, hs, faddr);
  }
  return drop_member_at(k, sh, obj, idx);
};

pub let drop_value_at = func(k: Mut(st.State), sh: u64, obj: u64) -> u64 {
  if sh == 0 { return 0; }
  if shp_has_drop(sh) == 0 { return 0; }
  let q: u64 = shp_drop_q(sh);
  if q != 0 {
    ir.args_reset(k);
    let a: u64 = ir.arg_ref(k, obj);
    let c: u64 = ir.emit_call(k, 0, q, 0);
  }
  if shp_kind(sh) == ShapeKind.Struct as u64 {
    let n: u64 = shp_count(sh);
    let r: u64 = drop_member_at(k, sh, obj, n);
  }
  return 0;
};
