let st = import("src::driver::state");
let ty = import("src::sema::types");
let env = import("src::sema::env");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let s = import("src::driver::sym");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let co = import("src::sema::core");
let sm = import("src::sema::stmt");
let me = import("src::sema::member");
let agg = import("src::sema::agg");
let modules = import("src::sema::modules");
let an = import("src::sema::anon");
let ct = import("src::comptime::ctypes");
let ireg = import("src::sema::tyreg");
let tb = import("src::sema::tbuild");
let ctf = import("src::comptime::ctfor");
let gn = import("src::sema::generics");
let gv = import("src::sema::witness");
let efrow = import("src::sema::effects::row");
let efinf = import("src::sema::effects::infer");
let eflow = import("src::sema::effects::lower");
let drop = import("src::sema::drop");
let tr = import("std::trace");
let hr = import("src::driver::host_rt");

extern decl_compile_vmod_p2(k: Mut(st.State), vmod: u64, src: u64, bodyg: u64, snap_buf: Mut(u8), snap_cnt: u64) -> u64 = lainc_compile_functor_mod_p2;

let emit_ret_guard = func(k: Mut(st.State), rt: Mut(ty.Ty), term: Mut(u64)) -> u64 {
  if ax.box_get(term) == 1 { return 0; }
  if ty.ty_known(rt) == 0 {
    ir.args_reset(k);
    return ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  }
  ir.args_reset(k);
  return ir.emit_jump(k, codes.InstKind.Unreachable as u64, 0);
};

let proc_name = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let name: u64 = ax.n_sym(g, i + 1);
  if i >= 2 and ax.is_group(g, i - 2) == 0 and ax.n_sym(g, i - 2) == s.p_at() {
    return name;
  }
  return modules.qual(k, st.st_scope(k), name);
};

let begin_proc = func(k: Mut(st.State), q: u64, rt: Mut(ty.Ty)) -> u64 {
  st.st_set_slotj(k, 0);
  st.st_set_loopdepth(k, 0);
  env.env_release(k, 0);
  st.st_set_retk(k, ty.tk(rt));
  st.st_set_retw(k, ty.tw(rt));
  st.st_set_retsg(k, ty.tsg(rt));
  st.st_set_retsh(k, ty.tsh(rt));
  let ip: u64 = st.st_in_proc(k);
  let nip: u64 = st.st_set_in_proc(k, ip + 1);
  return ir.proc_begin(k, q);
};

let sret_param = func(k: Mut(st.State)) -> u64 {
  let vn: u64 = ir.fresh_t(k);
  let ap: Mut(ty.Ty) = ir.taddr(k);
  ir.proc_param(k, vn, ap);
  return st.st_set_retptr(k, vn);
};

let bind_gen_vals = func(k: Mut(st.State), nms: Mut(u64), vals: Mut(ctf.CtVal), i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  let nm: u64 = deref(cx.word_idx(nms, i));
  let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), ptr_cast(Mut(u8), vals) + i * 24);
  ctf.bind(k, nm, ctf.v_kind(v), ctf.v_a(v), ctf.v_b(v));

  if ctf.v_kind(v) == 9 { gv.push_mod_implicit(k, ctf.v_a(v), ctf.v_b(v)); }
  return bind_gen_vals(k, nms, vals, i + 1, n);
};

let flush_gen_rec = func(k: Mut(st.State), ge: Mut(gn.GenQRec)) -> u64 {
  let q: u64 = ge.mangled_q;
  let tpl_e: Mut(modules.SymEntry) = ge.tpl_e;
  let nct: u64 = ge.nct;
  let nms: Mut(u64) = ge.names_arr;
  let vals: Mut(ctf.CtVal) = ge.vals_arr;
  let dp: u64 = ge.depth;
  let hdr: Mut(gn.GenHdr) = ptr_cast(Mut(gn.GenHdr), modules.sym_sig(tpl_e));
  let src: u64 = hdr.src;
  let gm: u64 = hdr.modv;
  let root: u64 = hr.source_root(src);
  let pg: u64 = ax.n_at(root, hdr.pg_i);
  let ret_i: u64 = hdr.ret_i;
  let bodyg: u64 = ax.n_at(root, hdr.body_i);
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  let saved_dp: u64 = gn.gen_depth(k);
  let cm: u64 = ctf.mark(k);
  let gmark: u64 = gv.mark(k);
  let gvm: u64 = if gm >= 1000 { gm } else { 0 };
  st.st_set_src(k, src);
  st.st_set_vmod(k, gvm);
  gn.set_gen_depth(k, dp);
  bind_gen_vals(k, nms, vals, 0, nct);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  if ret_i != 0 { cx.parse_type(k, root, ret_i, rt); }
  let row: Mut(efrow.EffRow) = efrow.row_empty(k);
  compile_body_with(k, pg, rt, bodyg, q, row);
  gv.release(k, gmark);
  ctf.release(k, cm);
  gn.set_gen_depth(k, saved_dp);
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  return flush_queue(k);
};

let FqRec = struct {
  vmod: u64,
  src: u64,
  bodyg: u64,
  snap: Mut(u8),
  cnt: u64
};

let fq_at = func(k: Mut(st.State), i: u64) -> Mut(FqRec) {
  return ptr_cast(Mut(FqRec), st.st_fqbase(k) + i * 40);
};

let queue_pending = func(k: Mut(st.State)) -> u64 {
  if st.st_qhead(k) < st.st_q_count(k) { return 1; }
  let gb: Mut(gn.GenQBlk) = gn.qblk(k);
  if is_null(gb.qbase) == 0 and gb.qhead < gb.qn { return 1; }
  return 0;
};

let flush_fq = func(k: Mut(st.State)) -> u64 {
  let total: u64 = st.st_fqused(k) / 40;
  let done: u64 = loop w(i: u64 = 0) while i < st.st_fqused(k) / 40 {
    let r: Mut(FqRec) = fq_at(k, i);
    let vmod: u64 = r.vmod;
    if vmod != 0 {
      r.vmod = 0;
      if st.st_ok(k) == 0 {
        let a: u64 = decl_compile_vmod_p2(k, vmod, r.src, r.bodyg, r.snap, r.cnt);
      }

      let more: u64 = if queue_pending(k) == 1 or st.st_fqused(k) / 40 > total { 1 } else { 0 };
      if more == 1 { return flush_queue(k); }
    }
    i = i + 1;
  };
  st.st_set_fqused(k, 0);
  return done;
};

let drain_gate: Array(u64, 2) = [0, 0];

let gate_cells = func() -> MutSlice(u64) {
  return make_slice(MutSlice(u64), mut_of(drain_gate), 2);
};

let handled = func() -> u64 {
  let g: MutSlice(u64) = gate_cells();
  g[1] = g[1] + 1;
  return g[1];
};

let flush_queue = func(k: Mut(st.State)) -> u64 {
  let g: MutSlice(u64) = gate_cells();
  if g[0] != 0 { return drain_queue(k); }
  let before: u64 = g[1];
  g[0] = 1;
  let t0: u64 = tr.span_begin();
  let rc: u64 = drain_queue(k);
  g[0] = 0;
  let done: u64 = g[1] - before;
  if done != 0 {
    let ev: u64 = tr.span_end("flush_queue", "lainc", t0, done);
  }
  return rc;
};

let drain_queue = func(k: Mut(st.State)) -> u64 {
  let e: Mut(an.AnonEntry) = an.pending(k);
  if is_null(e) == 0 {
    let q: u64 = an.entry_name(e);
    let src: u64 = an.entry_src(e);
    let g: u64 = an.entry_group(e);
    let node: u64 = an.entry_node(e);
    let am: u64 = an.entry_modv(e);
    let saved_src: u64 = st.st_src(k);
    let saved_vmod: u64 = st.st_vmod(k);
    let avm: u64 = if am >= 1000 { am } else { 0 };
    st.st_set_src(k, src);
    st.st_set_vmod(k, avm);
    let row0: Mut(efrow.EffRow) = efrow.row_empty(k);
    let b: u64 = compile_body(k, g, node, q, row0);
    let h0: u64 = handled();
    if st.st_ok(k) != 0 {

      let m: Ref(u8) = "anonymous func cannot capture";
      let d: u64 = ir.diag(k, 0, 2, m, 29);
    }
    st.st_set_vmod(k, saved_vmod);
    st.st_set_src(k, saved_src);
    return drain_queue(k);
  }
  if eflow.handler_pending(k) == 1 {
    let hh: u64 = eflow.flush_one_handler(k);
    let h1: u64 = handled();
    return drain_queue(k);
  }
  let ge: Mut(gn.GenQRec) = gn.genq_pending(k);
  if is_null(ge) == 0 {
    let h2: u64 = handled();
    return flush_gen_rec(k, ge);
  }
  if st.st_in_proc(k) != 0 { return 0; }
  if st.st_fqused(k) != 0 { let h3: u64 = handled(); }
  return flush_fq(k);
};

let compile_body_with = func(k: Mut(st.State), pg: u64, rt: Mut(ty.Ty), bodyg: u64, q: u64, row: Mut(efrow.EffRow)) -> u64 {
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let sr: u64 = agg.sret_ty(rt);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, rt);
  let ab0: u64 = efrow.clear_aborts(k);
  let fr: u64 = efrow.push_frame(k, row);
  let rp: u64 = if sr == 1 { sret_param(k) } else { st.st_set_retptr(k, 0) };
  let pnames: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let dummy: u64 = loop w(idx: u64 = 0) while idx < np {
    let vn: u64 = ir.fresh_t(k);
    let wp: Mut(u64) = cx.word_idx(pnames, idx);
    deref(wp) = vn;
    ir.proc_param(k, vn, cx.ty_idx(paramp, idx));
    idx = idx + 1;
  };
  if sr == 0 {
    if ty.ty_known(rt) == 1 { ir.proc_result(k, rt); }
  }
  ir.region_begin(k);
  let nslots: u64 = np + 4 + cx.count_tree(bodyg, 0);
  let sd: u64 = cx.emit_slots(k, 0, nslots);
  let bnd: u64 = loop w(idx: u64 = 0) while idx < np {
    let sl: u64 = st.st_next_slot(k);
    let vt: Mut(ty.Ty) = ax.new_ty(k);
    ty.ty_at(vt, cx.ty_idx(paramp, idx));
    let pn: u64 = deref(cx.word_idx(pnames, idx));
    let ps: u64 = deref(cx.word_idx(syms, idx));
    let pv: Mut(ty.Val) = ax.new_val(k);
    ty.val_ref(pv, pn, vt);
    cx.slot_put(k, sl, pv, vt);
    env.env_push(k, ps, sl, vt);
    idx = idx + 1;
  };
  let term: Mut(u64) = ax.box(k);
  let after: u64 = sm.block_mode(k, bodyg, 0, term, ax.no_slot(), rt);

  if ax.box_get(term) == 0 { let dp: u64 = drop.drop_all(k); }
  let guard: u64 = emit_ret_guard(k, rt, term);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  let pf: u64 = efrow.pop_frame(k);
  return flush_queue(k);
};

let compile_body = func(k: Mut(st.State), g: u64, i: u64, q: u64, row: Mut(efrow.EffRow)) -> u64 {
  let pg: u64 = ax.n_at(g, i);
  let l: Mut(efrow.FnLayout) = efrow.fn_layout(k, g, i);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  if l.ret_i != 0 { cx.parse_type(k, g, l.ret_i, rt); }
  let bodyg: u64 = ax.n_at(g, l.body_i);
  compile_body_with(k, pg, rt, bodyg, q, row);
  return l.next_i;
};

let skip_body = func(g: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if ax.is_group(g, i) == 1 {
    if ax.delim_of(g, i) == ax.Delim.Brace as u64 { return i + 1; }
  }
  return skip_body(g, i + 1);
};

pub let compile_func = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let se: Mut(modules.SymEntry) = modules.find_here(k, ax.n_sym(g, i + 1));
  let flag: u64 = if is_null(se) { 0 } else { modules.sym_set_flag(se, 1) };
  if is_null(se) == 0 {
    if tb.sig_types(modules.sym_sig(se)) == 1 { return skip_body(g, i + 2); }
  }
  let row: Mut(efrow.EffRow) = efinf.callee_row(k, se);
  return compile_body(k, g, i + 2, q, row);
};

pub let compile_func_expr = func(k: Mut(st.State), g: u64, i: u64, name: u64) -> u64 {
  let se: Mut(modules.SymEntry) = modules.find_here(k, name);
  let q: u64 = if is_null(se) { modules.qual(k, st.st_scope(k), name) } else { modules.sym_qual(se) };
  if is_null(se) == 0 {
    if tb.sig_types(modules.sym_sig(se)) == 1 { return skip_body(g, i + 1); }
  }
  let row: Mut(efrow.EffRow) = efinf.callee_row(k, se);
  let b: u64 = compile_body(k, g, i + 1, q, row);
  return ax.skip_semi(g, b);
};

pub let compile_top_let = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let name: u64 = ax.n_sym(g, i + 1);
  let j0: u64 = i + 2;
  let t: Mut(ty.Ty) = cx.tnone(k);
  let j: u64 = if j0 < ax.n_count(g) and ax.n_sym(g, j0) == s.p_colon() { cx.parse_type(k, g, j0 + 1, t) } else { j0 };
  let e: u64 = cx.expect_sym(k, g, j, s.p_eq());
  let q: u64 = proc_name(k, g, i);
  st.st_set_slotj(k, 0);
  st.st_set_loopdepth(k, 0);
  env.env_release(k, 0);
  st.st_set_retk(k, 9);
  st.st_set_retsh(k, 0);
  let ip0: u64 = st.st_in_proc(k);
  let nip: u64 = st.st_set_in_proc(k, ip0 + 1);
  ir.proc_begin(k, q);
  ir.region_begin(k);
  let nslots: u64 = 4 + cx.count_tree(g, 0);
  let sd: u64 = cx.emit_slots(k, 0, nslots);
  let v: Mut(ty.Val) = ax.new_val(k);
  let nj: u64 = co.expr(k, g, e, 0, t, v);
  if st.st_ok(k) != 0 { return nj; }
  let vt: Mut(ty.Ty) = ax.new_ty(k);
  if ty.ty_known(t) == 1 {
    ty.ty_at(vt, t);
  } else {
    let vs: u64 = ty.tsh(ty.vty(v));
    if vs != 0 {
      if agg.shp_kind(vs) == agg.ShapeKind.String as u64 {
        let id: u64 = ireg.ty_add(k, ireg.lk_bits(), 8, 0, 0);
        let sid: u64 = ct.slice_t(k, id, 0);
        let projected: u64 = ireg.project(k, sid, vt);
      } else {
        ty.ty_at(vt, ty.vty(v));
      }
    } else {
      ty.ty_at(vt, ty.vty(v));
    }
  }
  if ty.ty_known(vt) == 0 { st.st_fail(k, ax.FailKind.Type as u64); return nj; }
  if ty.tk(vt) == 3 and ty.tsh(vt) == 0 and ty.tsh(ty.vty(v)) != 0 {
    let sh: u64 = ty.tsh(ty.vty(v));
    let sv: u64 = ty.ty_set_sh(vt, sh);
  }
  ir.proc_result(k, vt);
  let sl: u64 = st.st_next_slot(k);
  cx.slot_put(k, sl, v, ty.vty(v));
  env.env_push(k, name, sl, vt);
  let lv_val: Mut(ty.Val) = ax.new_val(k);
  cx.slot_get(k, sl, vt, lv_val);
  ir.args_reset(k);
  ir.op_val(k, lv_val);
  ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  let fl: u64 = flush_queue(k);
  return ax.skip_semi(g, nj);
};

pub let compile_data_ref = func(k: Mut(st.State), g: u64, i: u64, nj: u64, dname: u64, t: Mut(ty.Ty)) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, t);
  ir.proc_result(k, t);
  ir.region_begin(k);
  ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, dname);
  let ins: u64 = ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  return ax.skip_semi(g, nj);
};

pub let compile_data_agg = func(k: Mut(st.State), g: u64, i: u64, nj: u64, dname: u64, sh: u64, fg: u64) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let a1: u64 = ty.ty_addr(t);
  let a2: u64 = ty.ty_set_sh(t, sh);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, t);
  ir.proc_result(k, t);
  ir.region_begin(k);
  let nslots: u64 = 4 + cx.count_tree(fg, 0);
  let sd: u64 = cx.emit_slots(k, 0, nslots);
  let wr: u64 = me.agg_fields(k, sh, fg, 0, dname);
  ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, dname);
  let ins: u64 = ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  return ax.skip_semi(g, nj);
};
