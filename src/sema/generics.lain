// generics.lain —— Phase 2B ?{} 泛型模板登记、4 步单态化调度与待编队列。
// 单向依赖 state/types/ast/sym/agg/ir/modules/tyreg/tbuild/ctfor/ctfn/ctx/calls/given/genunify。
let st = import("src::driver::state");
let ty = import("src::sema::types");
let ax = import("src::syntax::ast");
let s = import("src::driver::sym");
let ir = import("src::ir::ir");
let modules = import("src::sema::modules");
let ireg = import("src::sema::tyreg");
let tb = import("src::sema::tbuild");
let ctf = import("src::comptime::ctfor");
let ctp = import("src::comptime::ctprim");
let ctfn = import("src::comptime::ctfn");
let cx = import("src::sema::ctx");
let cl = import("src::sema::calls");
let gv = import("src::sema::witness");
let gu = import("src::sema::genunify");
let ef = import("src::sema::effects");
let hr = import("src::driver::host_rt");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;

pub let GenHdr = struct {
  decl_i: u64,
  src: u64,
  pg_i: u64,
  qg_i: u64,
  ret_i: u64,
  body_i: u64,
  modv: u64,
  eff_i: u64
};

pub let GenQRec = struct {
  mangled_q: u64,
  tpl_e: Mut(modules.SymEntry),
  nct: u64,
  names_arr: Mut(u64),
  vals_arr: Mut(ctf.CtVal),
  depth: u64
};

pub let GenQBlk = struct {
  pad0: u64,
  pad8: u64,
  pad16: u64,
  pad24: u64,
  pad32: u64,
  qbase: Mut(GenQRec),
  qn: u64,
  qhead: u64,
  depth: u64,
  seq: u64
};

pub let qblk = func(k: Mut(st.State)) -> Mut(GenQBlk) {
  return ptr_cast(Mut(GenQBlk), st.st_genblk(k));
};

let qrec_at = func(base: Mut(GenQRec), i: u64) -> Mut(GenQRec) {
  return ptr_cast(Mut(GenQRec), ptr_cast(Mut(u8), base) + i * 48);
};

let rtval_at = func(ab: Mut(ty.Val), i: u64) -> Mut(ty.Val) {
  return ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + i * 56);
};

let paramty_at = func(ps: Mut(ty.Ty), i: u64) -> Mut(ty.Ty) {
  return ptr_cast(Mut(ty.Ty), ptr_cast(Mut(u8), ps) + i * 32);
};

// --- 模板头（64B）：[decl_i@0, src@8, pg_i@16, qg_i@24, ret_i@32, body_i@40, modv@48, eff_i@56] ---
pub let gen_hdr_modv = func(hdr: Mut(GenHdr)) -> u64 { return hdr.modv; };

pub let reg_generic = func(k: Mut(st.State), name: u64, q: u64, decl_i: u64, pg_i: u64, qg_i: u64, ret_i: u64, eff_i: u64, body_i: u64) -> Mut(modules.SymEntry) {
  let hdr: Mut(GenHdr) = ptr_cast(Mut(GenHdr), st.st_ralloc(k, 64));
  hdr.decl_i = decl_i;
  hdr.src = st.st_src(k);
  hdr.pg_i = pg_i;
  hdr.qg_i = qg_i;
  hdr.ret_i = ret_i;
  hdr.body_i = body_i;
  hdr.modv = st.st_scope(k);
  hdr.eff_i = eff_i;
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_generic(), st.st_src(k), name, q, ptr_cast(Mut(u8), hdr), 0);
  modules.sym_set_decl(se, decl_i);
  modules.sym_set_src(se, st.st_src(k));
  return se;
};

// --- 待编队列（st_genblk +40/+48/+56，每条 48B） --------------------------
// [mangled_q@0, tpl_e@8, nct@16, names_arr@24, vals_arr@32, depth@40]
pub let gen_depth = func(k: Mut(st.State)) -> u64 { let gb: Mut(GenQBlk) = qblk(k); return gb.depth; };
pub let set_gen_depth = func(k: Mut(st.State), v: u64) -> u64 { let gb: Mut(GenQBlk) = qblk(k); gb.depth = v; return v; };

let genq_base = func(k: Mut(st.State)) -> Mut(GenQRec) {
  let gb: Mut(GenQBlk) = qblk(k);
  if is_null(gb.qbase) == 0 { return gb.qbase; }
  let qsz: u64 = 48 * 128;
  let nb: Mut(GenQRec) = ptr_cast(Mut(GenQRec), st.st_ralloc(k, qsz));
  gb.qbase = nb;
  return nb;
};

let genq_push = func(k: Mut(st.State), q: u64, tpl_e: Mut(modules.SymEntry), nct: u64, ctp_tbl: Mut(gu.CtParamRec), vals: Mut(ctf.CtVal)) -> u64 {
  let gb: Mut(GenQBlk) = qblk(k);
  let base: Mut(GenQRec) = genq_base(k);
  let n: u64 = gb.qn;
  if n >= 128 { ctf.fail_msg(k, "generic queue full", 18, ax.e_ast()); return 0; }
  let nms: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, nct * 8 + 8));
  let vcp: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_ralloc(k, nct * 24 + 8));
  let i: u64 = loop cp(i: u64 = 0) while i < nct {
    let cp_rec: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    deref(gu.word_at(nms, i)) = cp_rec.name;
    let src: Mut(ctf.CtVal) = gu.val_at(vals, i);
    let dst: Mut(ctf.CtVal) = gu.val_at(vcp, i);
    dst.kind = src.kind;
    dst.a = src.a;
    dst.b = src.b;
    i = i + 1;
  };
  let rec: Mut(GenQRec) = qrec_at(base, n);
  rec.mangled_q = q;
  rec.tpl_e = tpl_e;
  rec.nct = nct;
  rec.names_arr = nms;
  rec.vals_arr = vcp;
  rec.depth = gen_depth(k) + 1;
  gb.qn = n + 1;
  return 1;
};

pub let genq_pending = func(k: Mut(st.State)) -> Mut(GenQRec) {
  let gb: Mut(GenQBlk) = qblk(k);
  if is_null(gb.qbase) { return null_ref(Mut(GenQRec)); }
  let h: u64 = gb.qhead;
  if h >= gb.qn { return null_ref(Mut(GenQRec)); }
  gb.qhead = h + 1;
  return qrec_at(gb.qbase, h);
};

// --- 辅助：压入已绑定的编译期实参 ----------------------------------------
let push_bound = func(k: Mut(st.State), ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if i >= nct { return 1; }
  if deref(gu.word_at(bound, i)) == 1 {
    let cp_rec: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    let nm: u64 = cp_rec.name;
    let v: Mut(ctf.CtVal) = gu.val_at(vals, i);
    ctf.bind(k, nm, v.kind, v.a, v.b);
  }
  return push_bound(k, ctp_tbl, nct, vals, bound, i + 1);
};

// 解析调用点显式 ?{ key: val, ... }
let parse_explicit_q = func(k: Mut(st.State), qag: u64, i: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(qag);
  if i >= n { return 1; }
  if ax.is_comma(qag, i) == 1 { return parse_explicit_q(k, qag, i + 1, ctp_tbl, nct, vals, bound); }
  if ax.is_name(qag, i) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  if ctf.has_tok(qag, i + 1, s.p_colon()) == 0 {
    ctf.fail_msg(k, "bad ?{} arg", 11, ax.e_ast());
    return 0;
  }
  let idx: u64 = gu.ct_find(ctp_tbl, nct, ax.n_sym(qag, i), 0);
  if idx == 999 { ctf.fail_msg(k, "unknown comptime arg", 20, ax.e_type()); return 0; }
  // 实参是模块（名字、点号路径或函子调用）时记模块见证值。
  let mv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let mj: u64 = gv.eval_mod_arg(k, qag, i + 2, mv);
  if st.st_ok(k) != 0 { return 0; }
  if mj != 0 {
    let mdst: Mut(ctf.CtVal) = gu.val_at(vals, idx);
    mdst.kind = 9;
    mdst.a = ctf.v_a(mv);
    mdst.b = ctf.v_b(mv);
    deref(gu.word_at(bound, idx)) = 1;
    return parse_explicit_q(k, qag, mj, ctp_tbl, nct, vals, bound);
  }
  let ev: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let nj: u64 = ctfn.ct_eval(k, qag, i + 2, 0, ev);
  if st.st_ok(k) != 0 { return 0; }
  let dst: Mut(ctf.CtVal) = gu.val_at(vals, idx);
  dst.kind = ctf.v_kind(ev);
  dst.a = ctf.v_a(ev);
  dst.b = ctf.v_b(ev);
  deref(gu.word_at(bound, idx)) = 1;
  return parse_explicit_q(k, qag, nj, ctp_tbl, nct, vals, bound);
};

// 逐个处理运行时实参：已知类型按 want 求值，含未绑定类型变量则 tnone 求值后合一。
let eval_rt_args = func(k: Mut(st.State), pg: u64, pi: u64, argsg: u64, ai: u64, idx: u64, ab: Mut(ty.Val),
                  ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let pn: u64 = ax.n_count(pg);
  let an: u64 = ax.n_count(argsg);
  if pi >= pn {
    if ai < an { ctf.fail_msg(k, "too many args", 13, ax.e_type()); }
    return idx;
  }
  if ax.is_comma(pg, pi) == 1 { return eval_rt_args(k, pg, pi + 1, argsg, ai, idx, ab, ctp_tbl, nct, vals, bound); }
  if ai >= an { ctf.fail_msg(k, "missing args", 12, ax.e_type()); return idx; }
  if ctf.has_tok(pg, pi + 1, s.p_colon()) == 0 { ctf.fail_msg(k, "expected :", 10, ax.e_ast()); return idx; }
  let te: u64 = gu.ct_skip_ty(pg, pi + 2);
  let v: Mut(ty.Val) = rtval_at(ab, idx);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  if gu.ast_has_unbound(pg, pi + 2, te, ctp_tbl, nct, bound) == 0 {
    let wt: Mut(ty.Ty) = ax.new_ty(k);
    cx.parse_type(k, pg, pi + 2, wt);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return idx; }
    let aj: u64 = core_expr(k, argsg, ai, 0, wt, v);
    if st.st_ok(k) != 0 { return idx; }
    if ty.vlit(v) == 0 {
      gu.unify_type(k, pg, pi + 2, te, ireg.tid_of(k, ty.vty(v)), ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return idx; }
    }
    let nj: u64 = if ax.is_comma(argsg, aj) == 1 { aj + 1 } else { aj };
    return eval_rt_args(k, pg, te, argsg, nj, idx + 1, ab, ctp_tbl, nct, vals, bound);
  }
  ctf.release(k, cm);
  let aj2: u64 = core_expr(k, argsg, ai, 0, cx.tnone(k), v);
  if st.st_ok(k) != 0 { return idx; }
  let atid: u64 = ireg.tid_of(k, ty.vty(v));
  gu.unify_type(k, pg, pi + 2, te, atid, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return idx; }
  let nj2: u64 = if ax.is_comma(argsg, aj2) == 1 { aj2 + 1 } else { aj2 };
  return eval_rt_args(k, pg, te, argsg, nj2, idx + 1, ab, ctp_tbl, nct, vals, bound);
};

// 编译期参数里第一个 T: Type 的下标；没有则 999。
let type_param_at = func(qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, i: u64) -> u64 {
  if i >= nct { return 999; }
  let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
  if p.ty_end == p.ty_start + 1 {
    if ax.is_name(qg, p.ty_start) == 1 {
      if ax.n_sym(qg, p.ty_start) == s.t_type() { return i; }
    }
  }
  return type_param_at(qg, ctp_tbl, nct, i + 1);
};

// 把 T 绑定成模块的 Self 类型；T 已绑定时比对一致性。
let bind_self_param = func(k: Mut(st.State), ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), t_idx: u64, i: u64, st_tid: u64) -> u64 {
  if t_idx == 999 or t_idx == i { return 1; }
  if st_tid == 0 { ctf.fail_msg(k, "module has no Self type", 23, ax.e_type()); return 0; }
  let tslot: Mut(ctf.CtVal) = gu.val_at(vals, t_idx);
  if deref(gu.word_at(bound, t_idx)) == 1 {
    if tslot.a != st_tid {
      ctf.fail_msg(k, "module Self type conflict", 25, ax.e_type());
      return 0;
    }
    return 1;
  }
  tslot.kind = 1;
  tslot.a = st_tid;
  tslot.b = 0;
  deref(gu.word_at(bound, t_idx)) = 1;
  return 1;
};

// 约束是签名时的编译期参数求解：显式模块直接校验，隐式模块从模块见证记录区里搜。
let resolve_sig_param = func(k: Mut(st.State), qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64, sig_e: Mut(modules.SymEntry)) -> u64 {
  let has_self: u64 = gv.sig_has_self(sig_e);
  let t_idx: u64 = type_param_at(qg, ctp_tbl, nct, 0);
  let seal_value: u64 = modules.sym_qual(sig_e);
  let tv: Mut(ctf.CtVal) = gu.val_at(vals, i);
  if deref(gu.word_at(bound, i)) == 1 {
    if tv.kind != 9 {
      ctf.fail_msg(k, "explicit ?{} arg needs a module", 31, ax.e_type());
      return 0;
    }
    if gv.check_mod_matches_sig(k, tv.a, sig_e, 1) == 0 { return 0; }
    tv.b = seal_value;
    if has_self != 0 {
      let st_tid: u64 = gv.mod_self_tid(k, tv.a);
      if bind_self_param(k, ctp_tbl, nct, vals, bound, t_idx, i, st_tid) == 0 { return 0; }
    }
    return 1;
  }
  let tbound: u64 = 0;
  if t_idx != 999 and t_idx != i { tbound = deref(gu.word_at(bound, t_idx)); }
  let self_tid: u64 = 0;
  let want_self: u64 = 0;
  if tbound == 1 {
    let tslot: Mut(ctf.CtVal) = gu.val_at(vals, t_idx);
    self_tid = tslot.a;
    want_self = has_self;
  }
  let seal_box: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 8));
  deref(seal_box) = 0;
  let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
  if p.def_start != 0 {
    let modv_opt: u64 = gv.find_sig_implicit_opt(k, sig_e, self_tid, want_self, seal_box);
    if st.st_ok(k) != 0 { return 0; }
    if modv_opt != 0 {
      tv.kind = 9;
      tv.a = modv_opt;
      tv.b = deref(seal_box);
      deref(gu.word_at(bound, i)) = 1;
      if has_self != 0 {
        let st_tid2: u64 = gv.mod_self_tid(k, modv_opt);
        if bind_self_param(k, ctp_tbl, nct, vals, bound, t_idx, i, st_tid2) == 0 { return 0; }
      }
      return 1;
    }
    let dj: u64 = gv.eval_mod_arg(k, qg, p.def_start, tv);
    if st.st_ok(k) != 0 { return 0; }
    if dj == 0 {
      ctfn.ct_eval(k, qg, p.def_start, 0, tv);
      if st.st_ok(k) != 0 { return 0; }
    }
    if tv.kind != 9 {
      ctf.fail_msg(k, "default ?{} witness needs a module", 34, ax.e_type());
      return 0;
    }
    if gv.check_mod_matches_sig(k, tv.a, sig_e, 1) == 0 { return 0; }
    tv.b = seal_value;
    deref(gu.word_at(bound, i)) = 1;
    if has_self != 0 {
      let st_tid3: u64 = gv.mod_self_tid(k, tv.a);
      if bind_self_param(k, ctp_tbl, nct, vals, bound, t_idx, i, st_tid3) == 0 { return 0; }
    }
    return 1;
  }
  let modv: u64 = gv.find_sig_implicit(k, sig_e, self_tid, want_self, seal_box);
  if modv == 0 { return 0; }
  tv.kind = 9;
  tv.a = modv;
  tv.b = deref(seal_box);
  deref(gu.word_at(bound, i)) = 1;
  if has_self != 0 {
    let st_tid2: u64 = gv.mod_self_tid(k, modv);
    if bind_self_param(k, ctp_tbl, nct, vals, bound, t_idx, i, st_tid2) == 0 { return 0; }
  }
  return 1;
};

// 用已解出的编译期参数，解析出隐式模块见证；签名约束按签名查找模块见证。
// 签名约束先解：T 未绑时可从胜出的模块取 Self，其余约束再解。
let resolve_sig_pass = func(k: Mut(st.State), qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if i >= nct { return 1; }
  let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  let sig_e: Mut(modules.SymEntry) = gv.sig_at(k, qg, p.ty_start, p.ty_end);
  if is_null(sig_e) {
    ctf.release(k, cm);
    return resolve_sig_pass(k, qg, ctp_tbl, nct, vals, bound, i + 1);
  }
  let ok: u64 = resolve_sig_param(k, qg, ctp_tbl, nct, vals, bound, i, sig_e);
  ctf.release(k, cm);
  if ok == 0 { return 0; }
  if st.st_ok(k) != 0 { return 0; }
  return resolve_sig_pass(k, qg, ctp_tbl, nct, vals, bound, i + 1);
};

let resolve_givens_rest = func(k: Mut(st.State), qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if i >= nct { return 1; }
  if deref(gu.word_at(bound, i)) == 0 {
    let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
    if effect_row_param(k, qg, p) == 1 {
      let rv: Mut(ctf.CtVal) = gu.val_at(vals, i);
      rv.kind = 0;
      rv.a = 0;
      rv.b = 0;
      deref(gu.word_at(bound, i)) = 1;
      return resolve_givens_rest(k, qg, ctp_tbl, nct, vals, bound, i + 1);
    }
    if p.def_start != 0 {
      let cm0: u64 = ctf.mark(k);
      push_bound(k, ctp_tbl, nct, vals, bound, 0);
      ctfn.ct_eval(k, qg, p.def_start, 0, gu.val_at(vals, i));
      ctf.release(k, cm0);
      if st.st_ok(k) != 0 { return 0; }
      deref(gu.word_at(bound, i)) = 1;
      return resolve_givens_rest(k, qg, ctp_tbl, nct, vals, bound, i + 1);
    }
    let cm: u64 = ctf.mark(k);
    push_bound(k, ctp_tbl, nct, vals, bound, 0);
    let tv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
    ctfn.ct_eval(k, qg, p.ty_start, 0, tv);
    ctf.release(k, cm);
    if st.st_ok(k) != 0 { return 0; }
    let target_tid: u64 = ctp.as_type(k, tv);
    if st.st_ok(k) != 0 { return 0; }
    if target_tid == tb.type_tid(k) {
      ctf.fail_msg(k, "cannot infer comptime param", 25, ax.e_type());
      return 0;
    }
    ctf.fail_msg(k, "missing comptime/module witness", 31, ax.e_type());
    return 0;
  }
  return resolve_givens_rest(k, qg, ctp_tbl, nct, vals, bound, i + 1);
};

let resolve_givens = func(k: Mut(st.State), qg: u64, ctp_tbl: Mut(gu.CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64), i: u64) -> u64 {
  if resolve_sig_pass(k, qg, ctp_tbl, nct, vals, bound, i) == 0 { return 0; }
  return resolve_givens_rest(k, qg, ctp_tbl, nct, vals, bound, i);
};

let coerce_args = func(k: Mut(st.State), ab: Mut(ty.Val), ps: Mut(ty.Ty), i: u64, np: u64) -> u64 {
  if i >= np { return 1; }
  let v: Mut(ty.Val) = rtval_at(ab, i);
  let pt: Mut(ty.Ty) = paramty_at(ps, i);
  let c: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), pt, c);
  if st.st_ok(k) != 0 { return 0; }
  ty.val_at(v, c);
  return coerce_args(k, ab, ps, i + 1, np);
};

let build_sig = func(k: Mut(st.State), root: u64, pg: u64, ret_i: u64) -> Mut(u8) {
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np2: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  if ret_i != 0 { cx.parse_type(k, root, ret_i, rt); }
  return cx.sig_new(k, rt, np2, paramp);
};

let alloc_mangled = func(k: Mut(st.State), e: Mut(modules.SymEntry), src: u64, nct: u64, ctp_tbl: Mut(gu.CtParamRec), vals: Mut(ctf.CtVal), sg: Mut(u8)) -> u64 {
  let dp: u64 = gen_depth(k);
  if dp + 1 >= 64 { ctf.fail_msg(k, "generic recursion limit", 23, ax.e_type()); return 0; }
  let gb: Mut(GenQBlk) = qblk(k);
  let seq: u64 = gb.seq;
  gb.seq = seq + 1;
  let qn: u64 = modules.qual_num(k, src, modules.sym_name(e), seq);
  gu.cache_put(k, e as u64, nct, qn, sg, vals);
  genq_push(k, qn, e, nct, ctp_tbl, vals);
  return qn;
};

let ret_end = func(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return i; }
  if ctf.has_delim(g, i, ax.dl_brace()) == 1 { return i; }
  if ax.is_group(g, i) == 0 and ax.n_sym(g, i) == s.p_bang() {
    if ctf.has_delim(g, i + 1, ax.dl_brace()) == 1 { return i; }
  }
  return ret_end(g, i + 1);
};

pub let effect_row_of = func(k: Mut(st.State), e: Mut(modules.SymEntry)) -> Mut(ef.EffRow) {
  let hdr: Mut(GenHdr) = ptr_cast(Mut(GenHdr), modules.sym_sig(e));
  return ef.row_from_hdr(k, hdr.src, hdr.modv, hdr.eff_i);
};

let effect_row_param = func(k: Mut(st.State), qg: u64, p: Mut(gu.CtParamRec)) -> u64 {
  if p.ty_end != p.ty_start + 1 { return 0; }
  if ax.is_name(qg, p.ty_start) == 0 { return 0; }
  if ax.n_sym(qg, p.ty_start) == s.t_effect_row() { return 1; }
  return 0;
};

// --- 对外调用入口 ---------------------------------------------------------
pub let call_generic = func(k: Mut(st.State), e: Mut(modules.SymEntry), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val), next_box: Mut(u64)) -> u64 {
  let hdr: Mut(GenHdr) = ptr_cast(Mut(GenHdr), modules.sym_sig(e));
  let src: u64 = hdr.src;
  let root: u64 = hr.source_root(src);
  let pg: u64 = ax.n_at(root, hdr.pg_i);
  let qg: u64 = ax.n_at(root, hdr.qg_i);
  let ret_i: u64 = hdr.ret_i;
  let ctp_tbl: Mut(gu.CtParamRec) = ptr_cast(Mut(gu.CtParamRec), st.st_alloc(k, 320));
  let nct: u64 = gu.parse_ctparams(k, qg, 0, ctp_tbl, 0);
  if st.st_ok(k) != 0 { return 0; }
  let vals: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 192));
  let bound: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let bslice: MutSlice(u64) = make_slice(MutSlice(u64), bound, 8);
  let zi: u64 = loop zb(z: u64 = 0) while z < 8 { bslice[z] = 0; z = z + 1; };
  let is_q: u64 = if ctf.has_tok(g, i + 2, s.p_qmark()) == 1 { ctf.has_delim(g, i + 3, ax.dl_brace()) } else { 0 };
  ax.box_put(next_box, if is_q == 1 { i + 4 } else { i + 2 });
  if is_q == 1 {
    if parse_explicit_q(k, ax.n_at(g, i + 3), 0, ctp_tbl, nct, vals, bound) == 0 { return 0; }
  }
  let absz: u64 = 16 * 56 + 8;
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, absz));
  let np: u64 = eval_rt_args(k, pg, 0, ax.n_at(g, i + 1), 0, 0, ab, ctp_tbl, nct, vals, bound);
  if st.st_ok(k) != 0 { return 0; }
  if ret_i != 0 and ty.ty_known(want) == 1 {
    let re: u64 = ret_end(root, ret_i);
    if gu.ast_has_unbound(root, ret_i, re, ctp_tbl, nct, bound) == 1 {
      gu.unify_type(k, root, ret_i, re, ireg.tid_of(k, want), ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return 0; }
    }
  }
  if resolve_givens(k, qg, ctp_tbl, nct, vals, bound, 0) == 0 { return 0; }
  let hit: Mut(gu.MonoCacheRec) = gu.cache_find(k, e as u64, nct, vals);
  let cm: u64 = ctf.mark(k);
  push_bound(k, ctp_tbl, nct, vals, bound, 0);
  let sg_raw: Mut(u8) = if is_null(hit) == 0 {
    hit.concrete_sg
  } else {
    build_sig(k, root, pg, ret_i)
  };
  ctf.release(k, cm);
  if st.st_ok(k) != 0 { return 0; }
  let sg: Mut(cx.SigRec) = ptr_cast(Mut(cx.SigRec), sg_raw);
  if coerce_args(k, ab, sg.params, 0, np) == 0 { return 0; }
  let mq: u64 = if is_null(hit) == 0 { hit.mangled_q } else { alloc_mangled(k, e, src, nct, ctp_tbl, vals, sg_raw) };
  if st.st_ok(k) != 0 { return 0; }
  return cl.emit_prepared(k, mq, sg.ret, np, ab, want, out);
};

let push_pos_ct = func(k: Mut(st.State), nms: Mut(u64), vals: Mut(ctf.CtVal), i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  let v: Mut(ctf.CtVal) = gu.val_at(vals, i);
  ctf.bind(k, deref(gu.word_at(nms, i)), v.kind, v.a, v.b);
  return push_pos_ct(k, nms, vals, i + 1, n);
};

let copy_resolved_q = func(ctp_tbl: Mut(gu.CtParamRec), vals: Mut(ctf.CtVal), out_nms: Mut(u64), out_vals: Mut(ctf.CtVal), i: u64, n: u64) -> u64 {
  if i >= n { return n; }
  let p: Mut(gu.CtParamRec) = gu.ctparam_at(ctp_tbl, i);
  let src: Mut(ctf.CtVal) = gu.val_at(vals, i);
  let dst: Mut(ctf.CtVal) = gu.val_at(out_vals, i);
  deref(gu.word_at(out_nms, i)) = p.name;
  dst.kind = src.kind;
  dst.a = src.a;
  dst.b = src.b;
  return copy_resolved_q(ctp_tbl, vals, out_nms, out_vals, i + 1, n);
};

@root let lainc_resolve_factory_q = func(k: Mut(st.State), callee_src: u64, callee_vmod: u64, qg: u64, qag: u64,
                                        npos: u64, pos_nms: Mut(u64), pos_vals: Mut(ctf.CtVal),
                                        out_nms: Mut(u64), out_vals: Mut(ctf.CtVal)) -> u64 {
  let ctp_tbl: Mut(gu.CtParamRec) = ptr_cast(Mut(gu.CtParamRec), st.st_alloc(k, 320));
  let nct: u64 = gu.parse_ctparams(k, qg, 0, ctp_tbl, 0);
  if st.st_ok(k) != 0 { return 0; }
  let vals: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 192));
  let bound: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let bslice: MutSlice(u64) = make_slice(MutSlice(u64), bound, 8);
  let zi: u64 = loop zb(z: u64 = 0) while z < 8 { bslice[z] = 0; z = z + 1; };
  if qag != 0 {
    if parse_explicit_q(k, qag, 0, ctp_tbl, nct, vals, bound) == 0 { return 0; }
  }
  let prev_src: u64 = st.st_src(k);
  let prev_vmod: u64 = st.st_vmod(k);
  let cm: u64 = ctf.mark(k);
  st.st_set_src(k, callee_src);
  st.st_set_vmod(k, callee_vmod);
  push_pos_ct(k, pos_nms, pos_vals, 0, npos);
  let ok: u64 = if st.st_ok(k) == 0 { resolve_givens(k, qg, ctp_tbl, nct, vals, bound, 0) } else { 0 };
  ctf.release(k, cm);
  st.st_set_vmod(k, prev_vmod);
  st.st_set_src(k, prev_src);
  if ok == 0 or st.st_ok(k) != 0 { return 0; }
  return copy_resolved_q(ctp_tbl, vals, out_nms, out_vals, 0, nct);
};
