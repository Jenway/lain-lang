let val_idx = func(ab: Mut(ty.Val), idx: u64) -> Mut(ty.Val) {
  return ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + idx * 56);
};

let FqRec = struct {
  vmod: u64,
  src: u64,
  bodyg: u64,
  snap: Mut(u8),
  cnt: u64
};

let storage_suffix = func(k: Mut(st.State)) -> u64 {
  let p: Mut(u8) = st.st_scratch(k) + 128;
  let ps: MutSlice(u8) = make_slice(MutSlice(u8), p, 8);
  ps[0] = 95;
  ps[1] = 115;
  ps[2] = 116;
  ps[3] = 111;
  ps[4] = 114;
  ps[5] = 97;
  ps[6] = 103;
  ps[7] = 101;
  return hr.sym_intern(p, 8);
};

let storage_name = func(k: Mut(st.State), name: u64) -> u64 {
  let suffix: u64 = storage_suffix(k);
  return modules.qual_full(k, modules.cur(k), name, suffix);
};

let find_eq = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_group(g, i) == 0 {
    if ax.n_sym(g, i) == s.p_eq() { return i; }
  }
  return find_eq(g, i + 1, n);
};

let skip_to_body = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_group(g, i) == 1 and ax.delim_of(g, i) == ax.Delim.Brace as u64 { return i + 1; }
  return skip_to_body(g, i + 1, n);
};

let p_dcolon = func() -> u64 { return s.intern("::", 2); };

let path_sep = func(g: u64, i: u64) -> u64 {
  let t: u64 = ax.n_sym(g, i);
  if t == s.p_dot() { return 1; }
  if t == p_dcolon() { return 1; }
  return 0;
};

let path_take = func(k: Mut(st.State), g: u64, i: u64, segs: Mut(u64), cnt: Mut(u64), n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_name(g, i) == 0 { return i; }
  let c: u64 = ax.box_get(cnt);
  if c >= 8 { return i; }
  let wp: Mut(u64) = cx.word_idx(segs, c);
  deref(wp) = ax.n_sym(g, i);
  ax.box_put(cnt, c + 1);
  if i + 2 < n {
    if path_sep(g, i + 1) == 1 {
      if ax.is_name(g, i + 2) == 1 { return path_take(k, g, i + 2, segs, cnt, n); }
    }
  }
  return i + 1;
};

let path_resolve = func(k: Mut(st.State), segs: Mut(u64), cnt: u64, seal: Mut(u64)) -> u64 {
  if cnt == 0 { return 0; }
  let first: u64 = deref(segs);
  let m0: u64 = ctf.find_used_mod(k, first, seal);
  if m0 == 0 { return 0; }
  if cnt == 1 { return m0; }
  let rest: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), segs) + 8);
  let tail: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), rest) + 8);
  return modules.mod_resolve_path(k, m0, deref(rest), tail, cnt - 2, seal);
};

let private_walk = func(k: Mut(st.State), segs: Mut(u64), cnt: u64, m: u64, seal: u64, i: u64) -> u64 {
  if i >= cnt { return 0; }
  let nm: u64 = deref(ptr_cast(Mut(u64), ptr_cast(Mut(u8), segs) + i * 8));
  let e: Mut(modules.SymEntry) = modules.sym_lookup_in(k, m, seal, nm, modules.cur(k));
  if is_null(e) == 0 {
    if modules.sym_kind(e) != modules.sym_kind_mod() { return 0; }
    return private_walk(k, segs, cnt, modules.sym_qual(e), modules.sym_decl(e), i + 1);
  }
  let raw: Mut(modules.SymEntry) = modules.sym_find(k, m, nm);
  if is_null(raw) != 0 { return 0; }
  let pm: Ref(u8) = "private symbol";
  let pd: u64 = ir.diag(k, 0, 1, pm, 14);
  st.st_fail(k, ax.FailKind.Unbound as u64);
  return 1;
};

let private_deny = func(k: Mut(st.State), segs: Mut(u64), cnt: u64) -> u64 {
  if cnt < 2 { return 0; }
  let sb: Mut(u64) = ax.box(k);
  let m: u64 = ctf.find_used_mod(k, deref(segs), sb);
  if m == 0 { return 0; }
  return private_walk(k, segs, cnt, m, ax.box_get(sb), 1);
};

let sig_named = func(k: Mut(st.State), g: u64, i: u64) -> Mut(modules.SymEntry) {
  let n: u64 = ax.n_count(g);
  if i >= n { return null_ref(Mut(modules.SymEntry)); }
  if ax.is_name(g, i) == 0 { return null_ref(Mut(modules.SymEntry)); }
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, ax.n_sym(g, i));
  if is_null(e) { return null_ref(Mut(modules.SymEntry)); }
  if modules.sym_kind(e) != modules.sym_kind_sig() { return null_ref(Mut(modules.SymEntry)); }
  return e;
};

let is_legacy_witness = func(sym: u64) -> u64 {
  if sym == s.intern("given", 5) { return 1; }
  return 0;
};

let deny_legacy_witness = func(k: Mut(st.State)) -> u64 {
  let m: Ref(u8) = "legacy witness syntax removed";
  let d: u64 = ir.diag(k, 0, 1, m, 29);
  return st.st_fail(k, ax.FailKind.Ast as u64);
};

let mark_pub = func(k: Mut(st.State), name: u64, is_pub: u64) -> u64 {
  let e: Mut(modules.SymEntry) = modules.find_here(k, name);
  if is_null(e) { return 0; }
  return modules.sym_set_pub(e, is_pub);
};

let import_src = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let cur: u64 = st.st_src(k);
  let h: u64 = if i + 1 < ax.n_count(g) and ax.is_group(g, i + 1) == 1 { ax.n_at(g, i + 1) } else { 0 };
  if h == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return 0; }
  let tok: u64 = if ax.n_count(h) > 0 { ax.n_at(h, 0) } else { 0 };
  if tok == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return 0; }
  let path_len: u64 = ax.lit_len(tok);
  if path_len < 2 { st.st_fail(k, ax.FailKind.Ast as u64); return 0; }
  let path_ptr: Ref(u8) = ax.lit_addr(tok) + 1;
  let src2: u64 = hr.source_import(cur, path_ptr, path_len - 2);
  if src2 >= 4000000000 {
    st.st_fail(k, ax.FailKind.Type as u64);
    return 0;
  }
  let r: u64 = compile_source(k, src2);
  st.st_set_src(k, cur);
  if st.st_ok(k) != 0 { return 0; }
  return src2;
};

let mod_target = func(k: Mut(st.State), g: u64, i: u64, oe: Mut(u64), os: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i + 2 < n {
    if ax.n_sym(g, i + 1) == s.k_import() {
      if ax.is_group(g, i + 2) == 1 {
        if ax.delim_of(g, i + 2) == ax.Delim.Paren as u64 {
          deref(oe) = i + 3;
          return import_src(k, g, i + 1);
        }
      }
    }
  }
  let segs: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let cnt: Mut(u64) = ax.box(k);
  let end: u64 = path_take(k, g, i + 1, segs, cnt, n);
  deref(oe) = end;
  let c: u64 = ax.box_get(cnt);
  if c == 0 {
    let m0: Ref(u8) = "expected module path";
    let d0: u64 = ir.diag(k, 0, 1, m0, 19);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return 0;
  }
  return path_resolve(k, segs, c, os);
};

let is_select = func(g: u64, i: u64, n: u64) -> u64 {
  if i + 1 >= n { return 0; }
  if path_sep(g, i) == 0 { return 0; }
  if ax.is_group(g, i + 1) == 0 { return 0; }
  if ax.delim_of(g, i + 1) != ax.Delim.Brace as u64 { return 0; }
  return 1;
};

let imp_alias = func(k: Mut(st.State), target: u64, seal: u64, item: u64, is_pub: u64) -> u64 {
  let e: Mut(modules.SymEntry) = modules.sym_lookup_in(k, target, seal, item, modules.cur(k));
  if is_null(e) {
    let m: Ref(u8) = "unknown imported symbol";
    let d: u64 = ir.diag(k, 0, 1, m, 23);
    st.st_fail(k, ax.FailKind.Type as u64);
    return 0;
  }
  let kd: u64 = modules.sym_kind(e);
  let q: u64 = modules.sym_qual(e);
  let sg: Mut(u8) = modules.sym_sig(e);
  let sh: u64 = modules.sym_shape(e);
  let fl: u64 = modules.sym_flag(e);
  let dc: u64 = modules.sym_decl(e);
  let sr: u64 = modules.sym_src(e);
  let ro: u64 = modules.sym_ro(e);
  let fi: u64 = modules.sym_fnid(e);
  let se: Mut(modules.SymEntry) = modules.sym_add(k, kd, modules.cur(k), item, q, sg, sh);
  let sf: u64 = modules.sym_set_flag(se, fl);
  let sd: u64 = modules.sym_set_decl(se, dc);
  let ss: u64 = modules.sym_set_src(se, sr);
  let sro: u64 = modules.sym_set_ro(se, ro);
  let sfn: u64 = modules.sym_set_fnid(se, fi);
  let shm: u64 = modules.sym_set_home(se, modules.sym_home(e));
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  if kd == modules.sym_kind_mod() {
    let mi: u64 = modules.mod_add_in(k, modules.cur(k), item, q, modules.mod_kind_import(), dc, 0);
  }
  return 1;
};

let imp_items = func(k: Mut(st.State), g: u64, target: u64, seal: u64, is_pub: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if st.st_ok(k) != 0 { return i; }
  if ax.is_comma(g, i) == 1 or ax.is_semi(g, i) == 1 { return imp_items(k, g, target, seal, is_pub, i + 1); }
  if ax.is_name(g, i) == 0 {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return i + 1;
  }
  let r: u64 = imp_alias(k, target, seal, ax.n_sym(g, i), is_pub);
  return imp_items(k, g, target, seal, is_pub, i + 1);
};

let p1_open = func(k: Mut(st.State), g: u64, i: u64, is_pub: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let is_use: u64 = if ax.n_sym(g, i) == s.k_use() { 1 } else { 0 };
  let oe: Mut(u64) = ax.box(k);
  let os: Mut(u64) = ax.box(k);
  let target: u64 = mod_target(k, g, i, oe, os);
  let end: u64 = ax.box_get(oe);
  if target == 0 {
    if st.st_ok(k) == 0 {
      let m: Ref(u8) = "unknown module";
      let d: u64 = ir.diag(k, 0, 1, m, 14);
      st.st_fail(k, ax.FailKind.Type as u64);
    }
    return ax.skip_semi(g, end);
  }
  let seal: u64 = deref(os);
  if is_select(g, end, n) == 1 {
    let items: u64 = ax.n_at(g, end + 1);
    let r: u64 = imp_items(k, items, target, seal, is_pub, 0);
    return ax.skip_semi(g, end + 2);
  }
  let opened: u64 = modules.mod_add_open(k, modules.cur(k), target, seal);
  if is_use == 1 {
    let pu: u64 = ctf.push_use(k, target, seal);
    let pi: u64 = gv.push_mod_implicit(k, target, seal);
  }
  return ax.skip_semi(g, end);
};

let fn_type_id = func(k: Mut(st.State), sg: Mut(u8)) -> u64 {
  let np: u64 = cx.sig_np(sg);
  let rt: Mut(ty.Ty) = cx.sig_ret(sg);
  let ps: Mut(ty.Ty) = cx.sig_params(sg);
  let tids: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, np * 8 + 8));
  let i: u64 = loop c(i: u64 = 0) while i < np {
    let pt: Mut(ty.Ty) = ax.new_ty(k);
    let cp: u64 = ty.ty_at(pt, cx.ty_idx(ps, i));
    let wp: Mut(u64) = cx.word_idx(tids, i);
    deref(wp) = ireg.tid_of(k, pt);
    i = i + 1;
  };
  return cty.fn_t(k, ireg.tid_of(k, rt), np, tids as u64);
};

let parse_struct_shape = func(k: Mut(st.State), name: u64, q: u64, fg: u64) -> Mut(modules.SymEntry) {
  let sh: u64 = agg.shp_new(k, agg.ShapeKind.Struct as u64, name, modules.cur(k));
  let n: u64 = ax.n_count(fg);
  let j: u64 = loop c(j: u64 = 0) while j < n {
    if ax.is_semi(fg, j) == 1 or ax.is_comma(fg, j) == 1 {
      j = j + 1;
    } else {
      let fname: u64 = ax.n_sym(fg, j);
      let a: u64 = cx.expect_sym(k, fg, j + 1, s.p_colon());
      let ft: Mut(ty.Ty) = ax.new_ty(k);
      let b: u64 = cx.parse_type(k, fg, a, ft);
      let m: Mut(agg.Member) = agg.field_add(k, sh, fname, ty.tk(ft), ty.tw(ft), ty.tsg(ft), ty.tsh(ft));
      j = b;
    }
  };
  let fin: u64 = agg.finish(k, sh);
  return modules.sym_add(k, modules.sym_kind_struct(), modules.cur(k), name, q, null_ref(Mut(u8)), sh);
};

let parse_enum_shape = func(k: Mut(st.State), name: u64, q: u64, fg: u64) -> Mut(modules.SymEntry) {
  let sh: u64 = agg.shp_new(k, agg.ShapeKind.Enum as u64, name, modules.cur(k));
  let n: u64 = ax.n_count(fg);
  let j: u64 = loop c(j: u64 = 0) while j < n {
    if ax.is_name(fg, j) == 0 {
      j = j + 1;
    } else {
      let vn: u64 = ax.n_sym(fg, j);
      if j + 1 < n and ax.is_group(fg, j + 1) == 1 {
        let pt: Mut(ty.Ty) = ax.new_ty(k);
        let b: u64 = cx.parse_type(k, ax.n_at(fg, j + 1), 0, pt);
        let m: Mut(agg.Member) = agg.variant_add(k, sh, vn, 1, ty.tk(pt), ty.tw(pt), ty.tsg(pt), ty.tsh(pt));
        j = j + 2;
      } else {
        let m0: Mut(agg.Member) = agg.variant_add(k, sh, vn, 0, 0, 0, 0, 0);
        j = j + 1;
      }
    }
  };
  let fin: u64 = agg.finish(k, sh);
  return modules.sym_add(k, modules.sym_kind_enum(), modules.cur(k), name, q, null_ref(Mut(u8)), sh);
};

let cenum_fail = func(k: Mut(st.State), m: Ref(u8), len: u64) -> u64 {
  let d: u64 = ir.diag(k, 0, 1, m, len);
  return st.st_fail(k, ax.FailKind.Type as u64);
};

let cenum_value_at = func(k: Mut(st.State), fg: u64, i: u64, out: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(fg);
  if i >= n { st.st_fail(k, ax.FailKind.Ast as u64); return i; }
  let cv: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  if ax.is_name(fg, i) == 0 and ax.n_sym(fg, i) == s.o_minus() {
    let j: u64 = ctfn.ct_eval(k, fg, i + 1, 0, cv);
    if st.st_ok(k) != 0 { return j; }
    if ctf.v_kind(cv) != 0 { return j; }
    deref(out) = 0 - ctf.v_a(cv);
    return j;
  }
  let j2: u64 = ctfn.ct_eval(k, fg, i, 0, cv);
  if st.st_ok(k) != 0 { return j2; }
  if ctf.v_kind(cv) != 0 { return j2; }
  deref(out) = ctf.v_a(cv);
  return j2;
};

let cenum_fits = func(w: u64, sg: u64, v: u64) -> u64 {
  if w >= 64 { return 1; }
  let lim: u64 = 1 << w;
  let r: u64 = v % lim;
  if sg == 0 { return if r == v { 1 } else { 0 }; }
  let half: u64 = 1 << (w - 1);
  if r <= half - 1 { return 1; }
  if r >= lim - half { return 1; }
  return 0;
};

let cenum_dup = func(sh: u64, value: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  let m: Mut(agg.Member) = agg.mem_at(sh, i);
  if agg.mem_tag(m) == value { return 1; }
  return cenum_dup(sh, value, i + 1, n);
};

let parse_cenum_shape = func(k: Mut(st.State), name: u64, q: u64, w: u64, sg: u64, fg: u64) -> Mut(modules.SymEntry) {
  let sh: u64 = agg.cenum_new(k, name, w, sg);
  let n: u64 = ax.n_count(fg);
  let nxt: Mut(u64) = ax.box(k);
  deref(nxt) = 0;
  let done: u64 = loop v(j: u64 = 0) while j < n {
    if ax.is_comma(fg, j) == 1 or ax.is_semi(fg, j) == 1 {
      j = j + 1;
    } else {
      if ax.is_name(fg, j) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); break v(j + 1); }
      let vname: u64 = ax.n_sym(fg, j);
      let j2: u64 = j + 1;
      let bv: Mut(u64) = ax.box(k);
      deref(bv) = deref(nxt);
      let j3: u64 = if j2 < n and ax.n_sym(fg, j2) == s.p_eq() { cenum_value_at(k, fg, j2 + 1, bv) } else { j2 };
      if st.st_ok(k) != 0 { break v(j3); }
      let val: u64 = ax.box_get(bv);
      let fit: u64 = cenum_fits(w, sg, val);
      if fit == 0 { let f0: u64 = cenum_fail(k, "enum value out of range", 23); break v(j3); }
      let dup: u64 = cenum_dup(sh, val, 0, agg.shp_count(sh));
      if dup == 1 { let f1: u64 = cenum_fail(k, "duplicate enum value", 20); break v(j3); }
      let m: Mut(agg.Member) = agg.cenum_variant_add(k, sh, vname, val);
      deref(nxt) = val + 1;
      j = j3;
    }
  };
  let fin: u64 = agg.finish(k, sh);
  return modules.sym_add(k, modules.sym_kind_enum(), modules.cur(k), name, q, null_ref(Mut(u8)), sh);
};

let find_brace = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_group(g, i) == 1 and ax.delim_of(g, i) == ax.Delim.Brace as u64 { return i; }
  return find_brace(g, i + 1, n);
};

let p1_generic = func(k: Mut(st.State), g: u64, decl_i: u64, pg_i: u64, qmark_i: u64, name: u64, q: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let l: Mut(efrow.FnLayout) = efrow.layout_from(k, g, qmark_i + 2);
  let eff: u64 = if l.eff_i == 0 { 0 } else { ax.n_at(g, l.eff_i) };
  gn.reg_generic(k, name, q, decl_i, pg_i, qmark_i + 1, l.ret_i, eff, l.body_i);
  return l.body_i;
};

let p1_extern = func(k: Mut(st.State), g: u64, i: u64, is_pub: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let name: u64 = ax.n_sym(g, i + 1);
  let pg: u64 = ax.n_at(g, i + 2);
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  let a0: u64 = i + 3;
  let a: u64 = if a0 < n and ax.n_sym(g, a0) == s.p_arrow() { cx.parse_type(k, g, a0 + 1, rt) } else { a0 };
  let has_eq: u64 = if a < n and ax.n_sym(g, a) == s.p_eq() { 1 } else { 0 };
  let has_link: u64 = if has_eq == 1 and a + 1 < n { 1 } else { 0 };
  let link: u64 = if has_link == 1 { ax.n_sym(g, a + 1) } else { name };
  let j: u64 = if has_link == 1 { a + 2 } else { a };
  let sg: Mut(u8) = cx.sig_new(k, rt, np, paramp);
  let e: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_extern(), modules.cur(k), name, name, sg, 0);
  let ep: u64 = modules.sym_set_pub(e, is_pub);
  let fid: u64 = fn_type_id(k, sg);
  let sf: u64 = modules.sym_set_fnid(e, fid);
  let b: u64 = ir.proc_extern(k, name, link);
  let pp: u64 = extern_params(k, syms, paramp, 0, np);
  let pr: u64 = if ty.ty_known(rt) == 1 { ir.proc_result(k, rt) } else { 0 };
  let pe: u64 = ir.proc_end(k);
  return ax.skip_semi(g, j);
};

let extern_params = func(k: Mut(st.State), syms: Mut(u64), paramp: Mut(ty.Ty), idx: u64, np: u64) -> u64 {
  if idx >= np { return idx; }
  let nm: u64 = deref(cx.word_idx(syms, idx));
  let pt: Mut(ty.Ty) = ax.new_ty(k);
  let cp: u64 = ty.ty_at(pt, cx.ty_idx(paramp, idx));
  let r: u64 = ir.proc_param(k, nm, pt);
  return extern_params(k, syms, paramp, idx + 1, np);
};

let attr_slot = func(key: u64) -> u64 {
  if key == s.k_abi() { return 0; }
  if key == s.k_lib() { return 1; }
  if key == s.k_link() { return 2; }
  return 3;
};

let attr_slots = func(k: Mut(st.State)) -> Mut(u64) {
  let p: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 24));
  deref(cx.word_idx(p, 0)) = hr.sym_intern("C", 1);
  deref(cx.word_idx(p, 1)) = 0;
  deref(cx.word_idx(p, 2)) = 0;
  return p;
};

let attr_parse = func(k: Mut(st.State), ag: u64, i: u64, slots: Mut(u64)) -> u64 {
  let n: u64 = ax.n_count(ag);
  if i >= n { return i; }
  if ax.is_comma(ag, i) == 1 { return attr_parse(k, ag, i + 1, slots); }
  let key: u64 = ax.n_sym(ag, i);
  let sl: u64 = attr_slot(key);
  let a: u64 = cx.expect_sym(k, ag, i + 1, s.p_eq());
  if (sl == 3) or (a >= n) or (ax.tok_first(ag, a) != 34) {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return n;
  }
  let tok: u64 = ax.n_at(ag, a);
  deref(cx.word_idx(slots, sl)) = hr.sym_intern(ax.lit_addr(tok) + 1, ax.lit_len(tok) - 2);
  return attr_parse(k, ag, a + 1, slots);
};

let dot_width = func(sym: u64) -> u64 {
  if sym == s.p_ellipsis() { return 3; }
  if sym == hr.sym_intern("..", 2) { return 2; }
  if sym == s.p_dot() { return 1; }
  return 0;
};

let dots_end = func(pg: u64, i: u64, n: u64, acc: u64) -> u64 {
  if acc >= 3 { return i; }
  if i >= n { return 0; }
  if ax.is_group(pg, i) == 1 { return 0; }
  let w: u64 = dot_width(ax.n_sym(pg, i));
  if w == 0 { return 0; }
  return dots_end(pg, i + 1, n, acc + w);
};

let ellipsis_end = func(pg: u64, i: u64, n: u64) -> u64 {
  if i >= n { return 0; }
  if ax.is_group(pg, i) == 1 { return 0; }
  let w: u64 = dot_width(ax.n_sym(pg, i));
  if w == 0 { return 0; }
  return dots_end(pg, i + 1, n, w);
};

let ellipsis_at = func(pg: u64, i: u64, n: u64) -> u64 {
  if i >= n { return n; }
  if ellipsis_end(pg, i, n) != 0 { return i; }
  return ellipsis_at(pg, i + 1, n);
};

let params_before = func(k: Mut(st.State), pg: u64, i: u64, stop: u64, idx: u64, tintbl: Mut(ty.Ty), symtbl: Mut(u64)) -> u64 {
  if i >= stop { return idx; }
  let sym: u64 = ax.n_sym(pg, i);
  let a: u64 = cx.expect_sym(k, pg, i + 1, s.p_colon());
  let t: Mut(ty.Ty) = cx.ty_idx(tintbl, idx);
  let j: u64 = cx.parse_type(k, pg, a, t);
  deref(cx.word_idx(symtbl, idx)) = sym;
  let nj: u64 = if ax.is_comma(pg, j) == 1 { j + 1 } else { j };
  return params_before(k, pg, nj, stop, idx + 1, tintbl, symtbl);
};

let p1_extern_attr = func(k: Mut(st.State), g: u64, ag: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let slots: Mut(u64) = attr_slots(k);
  let ap: u64 = attr_parse(k, ag, 0, slots);
  if st.st_ok(k) != 0 { return skip_stmt(g, i, n); }
  let is_pub: u64 = if ax.n_sym(g, i) == s.k_pub() { 1 } else { 0 };
  let h: u64 = if is_pub == 1 { i + 1 } else { i };
  if (h + 2 >= n) or (ax.n_sym(g, h) != s.k_let()) or (ax.is_name(g, h + 1) == 0) {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return skip_stmt(g, i, n);
  }
  let name: u64 = ax.n_sym(g, h + 1);
  let e: u64 = cx.expect_sym(k, g, h + 2, s.p_eq());
  if (st.st_ok(k) != 0) or (ax.n_sym(g, e) != s.k_func()) or (ax.is_group(g, e + 1) == 0) {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return skip_stmt(g, i, n);
  }
  let pg: u64 = ax.n_at(g, e + 1);
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let cnt: u64 = ax.n_count(pg);
  let stop: u64 = ellipsis_at(pg, 0, cnt);
  let is_var: u64 = if stop < cnt { 1 } else { 0 };
  let np: u64 = params_before(k, pg, 0, stop, 0, paramp, syms);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  let a0: u64 = e + 2;
  let a: u64 = if a0 < n and ax.n_sym(g, a0) == s.p_arrow() { cx.parse_type(k, g, a0 + 1, rt) } else { a0 };
  let q: u64 = modules.qual(k, modules.cur(k), name);
  let abi: u64 = deref(cx.word_idx(slots, 0));
  let lib: u64 = deref(cx.word_idx(slots, 1));
  let link0: u64 = deref(cx.word_idx(slots, 2));
  let link: u64 = if link0 == 0 { name } else { link0 };
  let sg: Mut(u8) = cx.sig_new(k, rt, np, paramp);
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_extern(), modules.cur(k), name, q, sg, 0);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  let sf: u64 = modules.sym_set_flag(se, is_var);
  let fid: u64 = fn_type_id(k, sg);
  let sfn: u64 = modules.sym_set_fnid(se, fid);
  let b: u64 = ir.proc_extern_abi(k, q, link, abi, lib, is_var);
  let pp: u64 = extern_params(k, syms, paramp, 0, np);
  let pr: u64 = if ty.ty_known(rt) == 1 { ir.proc_result(k, rt) } else { 0 };
  let pe: u64 = ir.proc_end(k);
  return ax.skip_semi(g, a);
};

let p1_import = func(k: Mut(st.State), g: u64, i: u64, alias: u64, is_pub: u64) -> u64 {
  let src2: u64 = import_src(k, g, i);
  if src2 == 0 { return i + 1; }
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_mod(), modules.cur(k), alias, src2, null_ref(Mut(u8)), 0);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  let m: u64 = modules.mod_add(k, alias, src2, agg.ShapeKind.Struct as u64);
  return i + 1;
};

let sig_line_end = func(fg: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_semi(fg, i) == 1 { return i + 1; }
  return sig_line_end(fg, i + 1, n);
};

let sig_add = func(k: Mut(st.State), fg: u64, smv: u64, mn: u64, kind: u64, from: u64) -> u64 {
  let se: Mut(modules.SymEntry) = modules.sym_add(k, kind, smv, mn, 0, null_ref(Mut(u8)), 0);
  let sp: u64 = modules.sym_set_pub(se, 1);
  return sig_line_end(fg, from, ax.n_count(fg));
};

let sig_member = func(k: Mut(st.State), fg: u64, smv: u64, j: u64) -> u64 {
  let n: u64 = ax.n_count(fg);
  if j >= n { return n; }
  if ax.is_semi(fg, j) == 1 { return j + 1; }
  if ax.is_group_node(ax.n_at(fg, j)) == 1 { return j + 1; }
  let p: u64 = if ax.n_sym(fg, j) == s.k_pub() { j + 1 } else { j };
  if p >= n { return p; }
  let w: u64 = ax.n_sym(fg, p);
  if w == s.k_let() {
    if p + 1 >= n { st.st_fail(k, ax.FailKind.Ast as u64); return p + 1; }
    return sig_add(k, fg, smv, ax.n_sym(fg, p + 1), modules.sym_kind_value(), p + 2);
  }
  if w == s.t_fty() {
    if p + 1 >= n { st.st_fail(k, ax.FailKind.Ast as u64); return p + 1; }
    return sig_add(k, fg, smv, ax.n_sym(fg, p + 1), modules.sym_kind_type_alias(), p + 2);
  }
  if ax.is_name(fg, p) == 1 { return sig_add(k, fg, smv, ax.n_sym(fg, p), modules.sym_kind_value(), p + 1); }
  return p + 1;
};

let p1_sig = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if e + 1 >= n or ax.is_group(g, e + 1) == 0 or ax.delim_of(g, e + 1) != ax.Delim.Brace as u64 {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return e;
  }
  let bodyg: u64 = ax.n_at(g, e + 1);
  let smv: u64 = st.st_next_vmod(k);
  let reg: u64 = modules.mod_register_vmod(k, smv, 0);
  let par: u64 = modules.mod_set_parent(k, smv, modules.cur(k));
  let cnt: u64 = ax.n_count(bodyg);
  let j: u64 = loop m(j: u64 = 0) while j < cnt {
    j = sig_member(k, bodyg, smv, j);
  };
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_sig(), modules.cur(k), name, smv, null_ref(Mut(u8)), 0);
  let sd: u64 = modules.sym_set_decl(se, bodyg);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  return ax.skip_semi(g, e + 2);
};

let bind_mod_alias = func(k: Mut(st.State), modv: u64, name: u64, is_pub: u64, sig_e: Mut(modules.SymEntry), seal0: u64, shp: u64) -> u64 {
  let seal: u64 = seal0;
  if is_null(sig_e) == 0 {
    let ok: u64 = gv.check_mod_matches_sig(k, modv, sig_e, 1);
    if st.st_ok(k) != 0 { return 0; }
    seal = modules.sym_qual(sig_e);
  }
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_mod(), modules.cur(k), name, modv, null_ref(Mut(u8)), shp);
  let sd: u64 = modules.sym_set_decl(se, seal);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  let mi: u64 = modules.mod_add_in(k, modules.cur(k), name, modv, 1, seal, 0);
  return 1;
};

let p1_mod_lit = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64, sig_e: Mut(modules.SymEntry)) -> u64 {
  let n: u64 = ax.n_count(g);
  if e + 1 >= n or ax.is_group(g, e + 1) == 0 or ax.delim_of(g, e + 1) != ax.Delim.Brace as u64 {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return e;
  }
  let bodyg: u64 = ax.n_at(g, e + 1);
  let vmod: u64 = st.st_next_vmod(k);
  let reg: u64 = modules.mod_register_vmod(k, vmod, 0);
  let outer: u64 = modules.cur(k);
  let par: u64 = modules.mod_set_parent(k, vmod, outer);
  let saved: u64 = st.st_vmod(k);
  st.st_set_vmod(k, vmod);
  let a: u64 = phase1(k, bodyg, 0, ax.n_count(bodyg));
  st.st_set_vmod(k, saved);
  if st.st_ok(k) != 0 { return ax.skip_semi(g, e + 2); }

  let bd: u64 = drop.bind_self_drop(k, vmod);
  let bm: u64 = bind_mod_alias(k, vmod, name, is_pub, sig_e, 0, bodyg);
  return ax.skip_semi(g, e + 2);
};

let p1_factory_mod = func(k: Mut(st.State), g: u64, e: u64, name: u64, q: u64, is_pub: u64, sig_e: Mut(modules.SymEntry)) -> u64 {
  if ax.is_name(g, e) == 0 { return 0; }
  let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), st.st_alloc(k, 24));
  let j: u64 = ctfn.eval_factory_call(k, g, e, v);
  if j == 0 { return 0; }
  if st.st_ok(k) != 0 { return ax.skip_semi(g, j); }
  let vk: u64 = ctf.v_kind(v);
  if vk == 1 {
    let tid: u64 = ctf.v_a(v);
    let sh: u64 = ireg.ty_shape(k, tid);

    if sh == 0 {
      let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_type_alias(), modules.cur(k), name, tid, null_ref(Mut(u8)), 0);
      let sp: u64 = modules.sym_set_pub(se, is_pub);
      return ax.skip_semi(g, j);
    }

    agg.shp_set_name(sh, name);
    agg.shp_set_mod(sh, modules.cur(k));
    let se2: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_struct(), modules.cur(k), name, q, null_ref(Mut(u8)), sh);
    let sf2: u64 = modules.sym_set_flag(se2, 1);
    let sp2: u64 = modules.sym_set_pub(se2, is_pub);
    return ax.skip_semi(g, j);
  }
  if vk != 9 { return 0; }
  let bm: u64 = bind_mod_alias(k, ctf.v_a(v), name, is_pub, sig_e, ctf.v_b(v), 0);
  return ax.skip_semi(g, j);
};

let p1_mod_alias = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64, sig_e: Mut(modules.SymEntry)) -> u64 {
  let n: u64 = ax.n_count(g);
  if ax.is_name(g, e) == 0 { return 0; }
  if e + 1 < n and ax.is_group(g, e + 1) == 1 { return 0; }
  let segs: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
  let cnt: Mut(u64) = ax.box(k);
  let end: u64 = path_take(k, g, e, segs, cnt, n);
  if end < n and ax.is_semi(g, end) == 0 { return 0; }
  let seal: Mut(u64) = ax.box(k);
  let m: u64 = path_resolve(k, segs, ax.box_get(cnt), seal);
  if m == 0 {
    let pd: u64 = private_deny(k, segs, ax.box_get(cnt));
    return 0;
  }
  let bm: u64 = bind_mod_alias(k, m, name, is_pub, sig_e, deref(seal), 0);
  return ax.skip_semi(g, end);
};

let prim_type_name = func(k: Mut(st.State), name: u64) -> u64 {
  let t: Mut(ty.Ty) = ax.new_ty(k);
  return ty.ty_of_sym(name, t);
};

let type_name_at = func(k: Mut(st.State), name: u64) -> u64 {
  if name == s.t_type() or name == s.t_module() { return 1; }
  if prim_type_name(k, name) == 1 { return 1; }
  let cv: Mut(ctf.CtVal) = ctf.lookup(k, name);
  if is_null(cv) == 0 {
    if ctf.v_kind(cv) == 1 { return 1; }
  }
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, name);
  if is_null(e) { return 0; }
  let kd: u64 = modules.sym_kind(e);
  if kd == modules.sym_kind_struct() or kd == modules.sym_kind_enum() or kd == modules.sym_kind_type_alias() { return 1; }
  return 0;
};

let type_factory_name = func(name: u64) -> u64 {
  if name == s.t_mut() or name == s.t_ref() or name == s.t_slice() { return 1; }
  if name == s.t_mutslice() or name == s.t_array() or name == s.t_fn() { return 1; }
  if name == s.t_uninit() { return 1; }
  return 0;
};

let type_path_name = func(k: Mut(st.State), segs: Mut(u64), cnt: u64) -> u64 {
  if cnt < 2 { return 0; }
  let seal: Mut(u64) = ax.box(k);
  let head: u64 = path_resolve(k, segs, cnt - 1, seal);
  if head == 0 { return 0; }
  let lastp: Mut(u64) = ptr_cast(Mut(u64), ptr_cast(Mut(u8), segs) + (cnt - 1) * 8);
  let e: Mut(modules.SymEntry) = modules.sym_lookup_in(k, head, deref(seal), deref(lastp), modules.cur(k));
  if is_null(e) {
    let raw: Mut(modules.SymEntry) = modules.sym_find(k, head, deref(lastp));
    if is_null(raw) == 0 {
      let pm: Ref(u8) = "private symbol";
      let pd: u64 = ir.diag(k, 0, 1, pm, 14);
      st.st_fail(k, ax.FailKind.Unbound as u64);
    }
    return 0;
  }
  let kd: u64 = modules.sym_kind(e);
  if kd == modules.sym_kind_struct() or kd == modules.sym_kind_enum() or kd == modules.sym_kind_type_alias() { return 1; }
  return 0;
};

let bind_type_alias = func(k: Mut(st.State), g: u64, e: u64, end: u64, name: u64, is_pub: u64) -> u64 {
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let j: u64 = cx.parse_type(k, g, e, t);
  if st.st_ok(k) != 0 { return ax.skip_semi(g, j); }
  let tid: u64 = ireg.tid_of(k, t);
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_type_alias(), modules.cur(k), name, tid, null_ref(Mut(u8)), 0);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  return ax.skip_semi(g, end);
};

let p1_type_alias = func(k: Mut(st.State), g: u64, e: u64, name: u64, is_pub: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if e >= n { return 0; }
  if ax.is_name(g, e) == 0 { return 0; }

  if e + 1 < n and ax.is_group(g, e + 1) == 1 {
    if ax.delim_of(g, e + 1) != ax.Delim.Paren as u64 { return 0; }
    if type_factory_name(ax.n_sym(g, e)) == 0 { return 0; }
    return bind_type_alias(k, g, e, e + 2, name, is_pub);
  }

  if e + 1 < n and ax.n_sym(g, e + 1) == s.p_dot() {
    let segs: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 64));
    let cnt: Mut(u64) = ax.box(k);
    let end: u64 = path_take(k, g, e, segs, cnt, n);
    if end < n and ax.is_semi(g, end) == 0 { return 0; }
    if type_path_name(k, segs, ax.box_get(cnt)) == 0 { return 0; }
    return bind_type_alias(k, g, e, end, name, is_pub);
  }
  if e + 1 < n and ax.is_semi(g, e + 1) == 0 { return 0; }
  if type_name_at(k, ax.n_sym(g, e)) == 0 { return 0; }
  return bind_type_alias(k, g, e, e + 1, name, is_pub);
};

let p1_let = func(k: Mut(st.State), g: u64, i: u64, n: u64, is_pub: u64) -> u64 {
  let name: u64 = ax.n_sym(g, i + 1);
  let j0: u64 = i + 2;
  let rdonly: u64 = if j0 < n and ax.n_sym(g, j0) == s.k_ro() { 1 } else { 0 };
  let t: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(t);
  let has_ann: u64 = if j0 < n and ax.n_sym(g, j0) == s.p_colon() { 1 } else { 0 };
  let sig_e: Mut(modules.SymEntry) = if has_ann == 1 { sig_named(k, g, j0 + 1) } else { null_ref(Mut(modules.SymEntry)) };
  let j: u64 = if has_ann == 1 and is_null(sig_e) { cx.parse_type(k, g, j0 + 1, t) } else { if has_ann == 1 { j0 + 2 } else { j0 } };
  if tb.ty_is_type(t) == 1 {
    let m: Ref(u8) = "type value at runtime";
    let d: u64 = ir.diag(k, 0, 1, m, 21);
    st.st_fail(k, ax.FailKind.Type as u64);
    return j;
  }
  let e: u64 = cx.expect_sym(k, g, j, s.p_eq());
  if e >= n { st.st_fail(k, ax.FailKind.Ast as u64); return e; }
  let efj: u64 = eflow.effect_rhs(k, g, e, name, is_pub);
  if efj != 0 { return ax.skip_semi(g, efj); }
  if ax.n_sym(g, e) == s.k_import() { return p1_import(k, g, e, name, is_pub); }
  let is_root: u64 = if i >= 2 and ax.is_group(g, i - 2) == 0 and ax.n_sym(g, i - 2) == s.p_at() { 1 } else { 0 };
  let q: u64 = if is_root == 1 { name } else { modules.qual(k, modules.cur(k), name) };

  if ax.n_sym(g, e) == s.k_func() { return p1_flet(k, g, e, name, q, is_pub); }

  if ax.n_sym(g, e) == s.k_sig() { return p1_sig(k, g, e, name, is_pub); }

  if ax.n_sym(g, e) == s.k_module() { return p1_mod_lit(k, g, e, name, is_pub, sig_e); }

  if ax.n_sym(g, e) == s.k_struct() and e + 1 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Brace as u64 {
    let se: Mut(modules.SymEntry) = parse_struct_shape(k, name, q, ax.n_at(g, e + 1));
    let sf: u64 = modules.sym_set_flag(se, 1);
    let sp: u64 = modules.sym_set_pub(se, is_pub);
    return ax.skip_semi(g, e + 2);
  }

  if ax.n_sym(g, e) == s.k_enum() and e + 2 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Paren as u64 and ax.is_group(g, e + 2) == 1 and ax.delim_of(g, e + 2) == ax.Delim.Brace as u64 {
    let pg: u64 = ax.n_at(g, e + 1);
    let bt: Mut(ty.Ty) = ax.new_ty(k);
    let bj: u64 = cx.parse_type(k, pg, 0, bt);
    if st.st_ok(k) != 0 { return ax.skip_semi(g, e + 3); }
    let bw: u64 = ty.tw(bt);
    let ok: u64 = if ty.tk(bt) == (codes.TyKind.Bits as u64) and bw >= 8 and bw <= 64 and bw / 8 * 8 == bw { 1 } else { 0 };
    if ok == 0 or bj != ax.n_count(pg) {
      let bf: u64 = cenum_fail(k, "enum base type must be an integer", 33);
      return ax.skip_semi(g, e + 3);
    }
    let se: Mut(modules.SymEntry) = parse_cenum_shape(k, name, q, bw, ty.tsg(bt), ax.n_at(g, e + 2));
    let sf: u64 = modules.sym_set_flag(se, 1);
    let sp: u64 = modules.sym_set_pub(se, is_pub);
    return ax.skip_semi(g, e + 3);
  }

  if ax.n_sym(g, e) == s.k_enum() and e + 1 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Brace as u64 {
    let se: Mut(modules.SymEntry) = parse_enum_shape(k, name, q, ax.n_at(g, e + 1));
    let sf: u64 = modules.sym_set_flag(se, 1);
    let sp: u64 = modules.sym_set_pub(se, is_pub);
    return ax.skip_semi(g, e + 2);
  }

  let fm: u64 = p1_factory_mod(k, g, e, name, q, is_pub, sig_e);
  if fm != 0 { return fm; }
  let ma: u64 = p1_mod_alias(k, g, e, name, is_pub, sig_e);
  if ma != 0 { return ma; }

  let tbind: u64 = ctfn.type_binding(k, g, e, name, q);
  if tbind != 0 {
    let se2: Mut(modules.SymEntry) = modules.find_here(k, name);
    if is_null(se2) == 0 {
      let sf: u64 = modules.sym_set_flag(se2, 1);
      let sp: u64 = modules.sym_set_pub(se2, is_pub);
    }
    return ax.skip_semi(g, tbind);
  }

  let ta: u64 = p1_type_alias(k, g, e, name, is_pub);
  if ta != 0 { return ta; }

  if ax.is_group(g, e) == 1 and ax.delim_of(g, e) == ax.Delim.Bracket as u64 {
    let sh0: u64 = ty.tsh(t);
    if sh0 == 0 { st.st_fail(k, ax.FailKind.Type as u64); return e; }
    let et: Mut(ty.Ty) = ax.new_ty(k);
    let s1: u64 = agg.mem_ty(k, agg.mem_index(sh0, 0), et);
    let dname: u64 = storage_name(k, name);
    let sh: u64 = bi.table_data(k, dname, ax.n_at(g, e), et, rdonly);
    let tv: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, 32));
    let a1: u64 = ty.ty_addr(tv);
    let a2: u64 = ty.ty_set_sh(tv, sh);
    let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_data(), modules.cur(k), name, q, ptr_cast(Mut(u8), tv), sh);
    let rr: u64 = modules.sym_set_ro(se, rdonly);
    let sp: u64 = modules.sym_set_pub(se, is_pub);
    return ax.skip_semi(g, e + 1);
  }

  if ax.tok_first(g, e) == 34 {
    let h: u64 = ax.n_at(g, e);
    let dname: u64 = storage_name(k, name);
    let sh: u64 = bi.string_data(k, dname, ax.lit_addr(h) + 1, ax.lit_len(h) - 2);
    let tv: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, 32));
    let a1: u64 = ty.ty_addr(tv);
    let a2: u64 = ty.ty_set_sh(tv, sh);
    let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_data(), modules.cur(k), name, q, ptr_cast(Mut(u8), tv), sh);
    let rr: u64 = modules.sym_set_ro(se, 1);
    let sp: u64 = modules.sym_set_pub(se, is_pub);
    return ax.skip_semi(g, e);
  }

  if ax.is_name(g, e) == 1 and e + 1 < n and ax.is_group(g, e + 1) == 1 {
    if ax.delim_of(g, e + 1) == ax.Delim.Brace as u64 {
      let te: Mut(modules.SymEntry) = modules.find_here(k, ax.n_sym(g, e));
      if is_null(te) { st.st_fail(k, ax.FailKind.Type as u64); return e; }
      let sh: u64 = modules.sym_shape(te);
      let dname: u64 = storage_name(k, name);
      let r: u64 = bi.agg_data(k, dname, sh);
      let tv: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, 32));
      let a1: u64 = ty.ty_addr(tv);
      let a2: u64 = ty.ty_set_sh(tv, sh);
      let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_data(), modules.cur(k), name, q, ptr_cast(Mut(u8), tv), sh);
      let sp: u64 = modules.sym_set_pub(se, is_pub);
      return ax.skip_semi(g, e + 1);
    }
  }

  let vt: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_ralloc(k, 32));
  let cpv: u64 = ty.ty_at(vt, t);
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_value(), modules.cur(k), name, q, ptr_cast(Mut(u8), vt), 0);
  let sp: u64 = modules.sym_set_pub(se, is_pub);
  return ax.skip_semi(g, e);
};

let p1_flet = func(k: Mut(st.State), g: u64, e: u64, name: u64, q: u64, is_pub: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  let a0: u64 = e + 2;
  if a0 + 1 < n and ax.is_group(g, a0) == 0 and ax.n_sym(g, a0) == s.p_qmark() and ax.is_group(g, a0 + 1) == 1 {
    if ax.delim_of(g, a0 + 1) == ax.Delim.Brace as u64 {
      let fl: Mut(efrow.FnLayout) = efrow.layout_from(k, g, a0 + 2);
      let is_ct_ret: u64 = if fl.ret_i != 0 and ax.is_group(g, fl.ret_i) == 0 {
        let rs: u64 = ax.n_sym(g, fl.ret_i);
        if (rs == s.t_module()) or (rs == s.t_type()) or (rs == s.t_effect()) { 1 } else { 0 }
      } else { 0 };
      if is_ct_ret == 0 {
        let body_idx: u64 = p1_generic(k, g, e, e + 1, a0, name, q);
        let gp: u64 = mark_pub(k, name, is_pub);
        return ax.skip_semi(g, body_idx + 1);
      }
      let pg0: u64 = ax.n_at(g, e + 1);
      let paramp0: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
      let syms0: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
      let np0: u64 = cx.parse_params(k, pg0, 0, 0, paramp0, syms0);
      let rt0: Mut(ty.Ty) = ax.new_ty(k);
      ty.ty_none(rt0);
      let a_rt0: u64 = cx.parse_type(k, g, fl.ret_i, rt0);
      let sg0: Mut(u8) = cx.sig_new(k, rt0, np0, paramp0);
      let eff0: u64 = if fl.eff_i == 0 { 0 } else { ax.n_at(g, fl.eff_i) };
      let se0: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_func(), modules.cur(k), name, q, sg0, eff0);
      let fp0: u64 = modules.sym_set_pub(se0, is_pub);
      let sd0: u64 = modules.sym_set_decl(se0, e);
      let ss0: u64 = modules.sym_set_src(se0, st.st_src(k));
      let fid0: u64 = fn_type_id(k, sg0);
      let sf0: u64 = modules.sym_set_fnid(se0, fid0);
      return ax.skip_semi(g, fl.next_i);
    }
  }
  let pg: u64 = ax.n_at(g, e + 1);
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np: u64 = cx.parse_params(k, pg, 0, 0, paramp, syms);
  let l: Mut(efrow.FnLayout) = efrow.fn_layout(k, g, e + 1);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_none(rt);
  let a: u64 = if l.ret_i != 0 { cx.parse_type(k, g, l.ret_i, rt) } else { l.ret_i };
  let sg: Mut(u8) = cx.sig_new(k, rt, np, paramp);
  let eff: u64 = if l.eff_i == 0 { 0 } else { ax.n_at(g, l.eff_i) };
  let se: Mut(modules.SymEntry) = modules.sym_add(k, modules.sym_kind_func(), modules.cur(k), name, q, sg, eff);
  let fp: u64 = modules.sym_set_pub(se, is_pub);
  let sd: u64 = modules.sym_set_decl(se, e);
  let ss: u64 = modules.sym_set_src(se, st.st_src(k));
  let fid: u64 = fn_type_id(k, sg);
  let sf: u64 = modules.sym_set_fnid(se, fid);
  return ax.skip_semi(g, l.next_i);
};

let phase1v = func(k: Mut(st.State), g: u64, i: u64, n: u64, force: u64) -> u64 {
  if i >= n { return i; }
  if st.st_ok(k) != 0 { return i; }
  if ax.is_group(g, i) == 1 { return phase1v(k, g, i + 1, n, force); }
  if ax.is_semi(g, i) == 1 { return phase1v(k, g, i + 1, n, force); }
  let sym: u64 = ax.n_sym(g, i);
  let pub_syn: u64 = if sym == s.k_pub() { 1 } else { 0 };

  if pub_syn == 1 {
    if i + 1 < n {
      if ax.is_group(g, i + 1) == 1 {
        if ax.delim_of(g, i + 1) == ax.Delim.Brace as u64 {
          let body: u64 = ax.n_at(g, i + 1);
          let a: u64 = phase1v(k, body, 0, ax.n_count(body), 1);
          return phase1v(k, g, ax.skip_semi(g, i + 2), n, force);
        }
      }
    }
  }
  let is_pub: u64 = if force == 1 { 1 } else { pub_syn };
  let h: u64 = if pub_syn == 1 { i + 1 } else { i };
  if h >= n { return i + 1; }
  let hs: u64 = ax.n_sym(g, h);
  if hs == s.k_struct() or hs == s.k_enum() or hs == s.k_func() {
    let m: Ref(u8) = "top-level struct/enum/func removed; use let";
    let d: u64 = ir.diag(k, 0, 1, m, 43);
    st.st_fail(k, ax.FailKind.Ast as u64);
    return i + 1;
  }
  if hs == s.k_extern() { let a: u64 = p1_extern(k, g, h, is_pub); return phase1v(k, g, a, n, force); }

  if sym == s.p_at() and ax.n_sym(g, i + 1) == s.k_extern() and ax.is_group(g, i + 2) == 1 and ax.delim_of(g, i + 2) == ax.Delim.Paren as u64 {
    let a: u64 = p1_extern_attr(k, g, ax.n_at(g, i + 2), i + 3);
    return phase1v(k, g, a, n, force);
  }
  if hs == s.k_let() { let a: u64 = p1_let(k, g, h, n, is_pub); return phase1v(k, g, a, n, force); }
  if is_legacy_witness(hs) == 1 { let a: u64 = deny_legacy_witness(k); return i + 1; }
  if hs == s.k_open() or hs == s.k_use() { let a: u64 = p1_open(k, g, h, is_pub); return phase1v(k, g, a, n, force); }

  if hs == s.k_comptime() and i + 1 < n and ax.n_sym(g, i + 1) == s.k_if() {
    let d: Mut(sm.CtIf) = sm.ctif_open(k, g, h);
    if st.st_ok(k) != 0 { return d.next_i; }
    let body: u64 = sm.ctif_body(k, g, d);
    if st.st_ok(k) != 0 { return d.next_i; }
    if body != 0 { let a: u64 = phase1v(k, body, 0, ax.n_count(body), force); }
    return phase1v(k, g, d.next_i, n, force);
  }

  if hs == s.k_inject() { let a: u64 = inject_decl(k, g, h); return phase1v(k, g, a, n, force); }
  return phase1v(k, g, i + 1, n, force);
};

let phase1 = func(k: Mut(st.State), g: u64, i: u64, n: u64) -> u64 {
  return phase1v(k, g, i, n, 0);
};

let p2_let = func(k: Mut(st.State), g: u64, i: u64, n: u64) -> u64 {
  let name: u64 = ax.n_sym(g, i + 1);
  let e: u64 = find_eq(g, i + 2, n) + 1;
  if e >= n { st.st_fail(k, ax.FailKind.Ast as u64); return e; }
  if ax.n_sym(g, e) == s.k_import() { return ax.skip_semi(g, e); }

  if ax.n_sym(g, e) == s.k_struct() or ax.n_sym(g, e) == s.k_enum() {
    if ax.n_sym(g, e) == s.k_enum() and e + 1 < n and ax.is_group(g, e + 1) == 1 and ax.delim_of(g, e + 1) == ax.Delim.Paren as u64 {
      return ax.skip_semi(g, e + 3);
    }
    return ax.skip_semi(g, e + 2);
  }
  let se: Mut(modules.SymEntry) = modules.find_here(k, name);
  if is_null(se) { st.st_fail(k, ax.FailKind.Ast as u64); return e; }
  let kd: u64 = modules.sym_kind(se);

  if kd == modules.sym_kind_sig() or kd == modules.sym_kind_type_alias() { return skip_stmt(g, i + 1, n); }
  if kd == efrow.kind_effect() { return skip_stmt(g, i + 1, n); }

  if kd == modules.sym_kind_struct() or kd == modules.sym_kind_enum() { return skip_stmt(g, i + 1, n); }

  if kd == modules.sym_kind_mod() {
    let bodyg: u64 = modules.sym_shape(se);
    if bodyg == 0 or modules.sym_flag(se) == 1 { return ax.skip_semi(g, e + 2); }
    let sf: u64 = modules.sym_set_flag(se, 1);
    let saved: u64 = st.st_vmod(k);
    st.st_set_vmod(k, modules.sym_qual(se));
    let r: u64 = phase2(k, bodyg, 0, ax.n_count(bodyg));
    st.st_set_vmod(k, saved);
    if st.st_ok(k) == 0 {
      let bd: u64 = drop.bind_self_drop(k, modules.sym_qual(se));
    }
    return ax.skip_semi(g, e + 2);
  }
  let after: u64 = if ax.is_group(g, e) == 1 { ax.skip_semi(g, e + 1) } else { ax.skip_semi(g, e) };

  if modules.sym_flag(se) == 1 { return after; }
  if kd == modules.sym_kind_generic() {
    let hdr: Mut(gn.GenHdr) = ptr_cast(Mut(gn.GenHdr), modules.sym_sig(se));
    let body_idx: u64 = hdr.body_i;
    return ax.skip_semi(g, body_idx + 1);
  }
  let marked: u64 = modules.sym_set_flag(se, 1);
  if kd == modules.sym_kind_func() {
    let prev: u64 = efinf.infer_begin(k, se);
    let cf: u64 = dl.compile_func_expr(k, g, modules.sym_decl(se), name);
    let fin: u64 = efinf.infer_end(k, prev);
    return cf;
  }
  if kd == modules.sym_kind_value() {
    return dl.compile_top_let(k, g, i);
  }
  let tv: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), modules.sym_sig(se));
  let dname: u64 = storage_name(k, name);

  if ax.is_name(g, e) == 1 and e + 1 < n and ax.is_group(g, e + 1) == 1 {
    if ax.delim_of(g, e + 1) == ax.Delim.Brace as u64 {
      let sh: u64 = ty.tsh(tv);
      return dl.compile_data_agg(k, g, i, after, dname, sh, ax.n_at(g, e + 1));
    }
  }
  return dl.compile_data_ref(k, g, i, after, dname, tv);
};

let skip_stmt = func(g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if ax.is_semi(g, i) == 1 { return i + 1; }
  return skip_stmt(g, i + 1, n);
};

let phase2 = func(k: Mut(st.State), g: u64, i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  if st.st_ok(k) != 0 { return i; }
  if ax.is_group(g, i) == 1 { return phase2(k, g, i + 1, n); }
  if ax.is_semi(g, i) == 1 { return phase2(k, g, i + 1, n); }
  let sym: u64 = ax.n_sym(g, i);
  let is_pub: u64 = if sym == s.k_pub() { 1 } else { 0 };

  if is_pub == 1 {
    if i + 1 < n {
      if ax.is_group(g, i + 1) == 1 {
        if ax.delim_of(g, i + 1) == ax.Delim.Brace as u64 {
          let body: u64 = ax.n_at(g, i + 1);
          let a: u64 = phase2(k, body, 0, ax.n_count(body));
          return phase2(k, g, ax.skip_semi(g, i + 2), n);
        }
      }
    }
  }
  let h: u64 = if is_pub == 1 { i + 1 } else { i };
  if h >= n { return i + 1; }
  let hs: u64 = ax.n_sym(g, h);

  if sym == s.p_at() and ax.n_sym(g, i + 1) == s.k_extern() and ax.is_group(g, i + 2) == 1 {
    let a: u64 = skip_stmt(g, i + 3, n);
    return phase2(k, g, a, n);
  }
  if is_legacy_witness(hs) == 1 { let a: u64 = deny_legacy_witness(k); return i + 1; }

  if hs == s.k_comptime() and i + 1 < n and ax.n_sym(g, i + 1) == s.k_if() {
    let d: Mut(sm.CtIf) = sm.ctif_open(k, g, h);
    if st.st_ok(k) != 0 { return d.next_i; }
    let body: u64 = sm.ctif_body(k, g, d);
    if st.st_ok(k) != 0 { return d.next_i; }
    if body != 0 { let a: u64 = phase2(k, body, 0, ax.n_count(body)); }
    return phase2(k, g, d.next_i, n);
  }
  if hs == s.k_let() { let a: u64 = p2_let(k, g, h, n); return phase2(k, g, a, n); }
  if hs == s.k_extern() {

    let a: u64 = skip_stmt(g, h + 1, n);
    return phase2(k, g, a, n);
  }

  if hs == s.k_open() or hs == s.k_use() { let a: u64 = skip_stmt(g, h + 1, n); return phase2(k, g, a, n); }

  if hs == s.k_inject() { let a: u64 = ax.skip_semi(g, h + 2); return phase2(k, g, a, n); }
  return phase2(k, g, i + 1, n);
};

let compile_as = func(k: Mut(st.State), src: u64, root: u64) -> u64 {

  let am: u64 = st.st_arenaused(k);
  let sp: u64 = st.st_sp(k);
  let saved_src: u64 = st.st_src(k);
  let saved_root: u64 = st.st_root(k);
  let saved_ct: u64 = st.st_ctused(k);
  let saved_vmod: u64 = st.st_vmod(k);
  st.st_set_src(k, src);
  st.st_set_root(k, root);
  st.st_set_vmod(k, 0);
  let mk: u64 = env.env_release(k, 0);

  let t_exp: u64 = tr.span_begin();
  let exp_root: u64 = ex.expand_root(k, root);
  let ev_exp: u64 = tr.span_end("expand", "lainc", t_exp, src);
  st.st_set_root(k, exp_root);
  if st.st_ok(k) != 0 { return restore_arena(k, am, sp, saved_ct, saved_src, saved_root, saved_vmod); }

  let rooted: u64 = hr.set_source_root(src, exp_root);
  if rooted == hr.NO_SOURCE() {
    st.st_fail(k, ax.FailKind.Ast as u64);
    return restore_arena(k, am, sp, saved_ct, saved_src, saved_root, saved_vmod);
  }
  let n: u64 = ax.n_count(exp_root);
  let t_p1: u64 = tr.span_begin();
  let a: u64 = phase1(k, exp_root, 0, n);
  let ev_p1: u64 = tr.span_end("phase1_elaborate", "lainc", t_p1, n);
  if st.st_ok(k) != 0 { return restore_arena(k, am, sp, saved_ct, saved_src, saved_root, saved_vmod); }
  let t_p2: u64 = tr.span_begin();
  let b: u64 = phase2(k, exp_root, 0, n);
  let ev_p2: u64 = tr.span_end("phase2_lower", "lainc", t_p2, n);

  let c_arena: u64 = tr.counter("arena_kb", st.st_arenaused(k) / 1024);
  let c_syms: u64 = tr.counter("symbols", modules.sym_count(k));
  let c_shapes: u64 = tr.counter("shapes", st.st_shpused(k) / agg.shp_rec());
  let c_types: u64 = tr.counter("types", ireg.reg_count(k));
  return restore_arena(k, am, sp, saved_ct, saved_src, saved_root, saved_vmod);
};

let restore_arena = func(k: Mut(st.State), am: u64, sp: u64, saved_ct: u64, saved_src: u64, saved_root: u64, saved_vmod: u64) -> u64 {
  let ra: u64 = st.st_set_arenaused(k, am);
  let rs: u64 = st.st_set_sp(k, sp);
  let rc: u64 = st.st_set_ctused(k, saved_ct);
  let rsrc: u64 = st.st_set_src(k, saved_src);
  let rroot: u64 = st.st_set_root(k, saved_root);
  let rvm: u64 = st.st_set_vmod(k, saved_vmod);
  return st.st_ok(k);
};

pub let compile_source = func(k: Mut(st.State), src: u64) -> u64 {
  if st.st_done(k, src) == 1 { return st.st_ok(k); }
  let m: u64 = st.st_mark_done(k, src);
  let root: u64 = hr.source_root(src);
  let t_src: u64 = tr.span_begin();
  let rc: u64 = compile_as(k, src, root);
  let ev_src: u64 = tr.span_end("compile_source", "lainc", t_src, src);
  return rc;
};

let collect_args = func(k: Mut(st.State), g: u64, i: u64, idx: u64, ab: Mut(ty.Val)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return idx; }
  if ax.is_comma(g, i) == 1 { return collect_args(k, g, i + 1, idx, ab); }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = co.expr(k, g, i, 0, cx.tnone(k), v);
  if st.st_ok(k) != 0 { return j; }
  let cp: u64 = ty.val_at(val_idx(ab, idx), v);
  return collect_args(k, g, j, idx + 1, ab);
};

let fill_lits = func(k: Mut(st.State), ab: Mut(ty.Val), idx: u64, cnt: u64) -> u64 {
  if idx >= cnt { return idx; }
  let v: Mut(ty.Val) = val_idx(ab, idx);
  if ty.vlit(v) != 1 {
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return idx;
  }
  let a: u64 = ir.arg_int(k, ty.vbits(v));
  return fill_lits(k, ab, idx + 1, cnt);
};

let scan_len = func(p: Mut(u8), i: u64, cap: u64) -> u64 {
  if i >= cap { return 0; }
  let b: u8 = deref(p + i);
  if b == 0 { return i; }
  return scan_len(p, i + 1, cap);
};

let inject_decl = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let pg: u64 = ax.n_at(g, i + 1);
  let fname: u64 = ax.n_sym(pg, 0);
  let fn: Mut(modules.SymEntry) = modules.find_here(k, fname);
  if is_null(fn) { st.st_fail(k, ax.FailKind.Unbound as u64); return i + 2; }
  if modules.sym_kind(fn) != modules.sym_kind_func() { st.st_fail(k, ax.FailKind.Type as u64); return i + 2; }
  let argsg: u64 = ax.n_at(pg, 1);
  let span: u64 = 896;
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, span));
  let cnt: u64 = collect_args(k, argsg, 0, 0, ab);
  if st.st_ok(k) != 0 { return i + 2; }
  let saved_mod: u64 = st.st_mod(k);
  let saved_sp: u64 = st.st_sp(k);
  let saved_src: u64 = st.st_src(k);
  let saved_root: u64 = st.st_root(k);

  let pre: u64 = phase2(k, saved_root, 0, i);
  if st.st_ok(k) != 0 { return i + 2; }

  let fd: u64 = modules.sym_flag(fn);
  if fd == 0 {
    let dsrc: u64 = modules.sym_src(fn);
    let dnode: u64 = modules.sym_decl(fn);
    st.st_set_src(k, dsrc);
    let droot: u64 = hr.source_root(dsrc);
    st.st_set_root(k, droot);
    let cf: u64 = 0;
    let pv: u64 = efinf.infer_begin(k, fn);
    if ax.is_group(droot, dnode + 1) == 1 {
      cf = dl.compile_func_expr(k, droot, dnode, fname);
    } else {
      cf = dl.compile_func(k, droot, dnode);
    }
    let cfin: u64 = efinf.infer_end(k, pv);
    let fs: u64 = modules.sym_set_flag(fn, 1);
    st.st_set_src(k, saved_src);
    st.st_set_root(k, saved_root);
    if st.st_ok(k) != 0 { return i + 2; }
  }
  let tmp: u64 = ct.clone(k);
  st.st_set_mod(k, tmp);

  let pr: u64 = rf.prepare(k);
  if st.st_ok(k) != 0 { return i + 2; }
  let cap: u64 = rf.buffer_bytes();
  let out: Mut(u8) = ct.buf(cap);
  let ename: u64 = ct.inject_name();
  let b1: u64 = ir.proc_begin(k, ename);
  let b0: u64 = ir.proc_result(k, ir.taddr(k));
  let b2: u64 = ir.region_begin(k);
  let b3: u64 = ir.args_reset(k);
  let b4: u64 = fill_lits(k, ab, 0, cnt);
  let cres: u64 = ir.fresh_t(k);
  let b5: u64 = ir.emit_call(k, cres, modules.sym_qual(fn), 0);

  let buf_ptr: u64 = ir.fresh_t(k);
  let b6: u64 = ir.emit_lea(k, buf_ptr, rf.buffer_name(), 0, 1, 0);
  let b7: u64 = ir.args_reset(k);
  let b8: u64 = ir.arg_ref(k, buf_ptr);
  let b9: u64 = ir.emit_jump(k, codes.InstKind.Return as u64, 0);
  let b10: u64 = ir.region_end(k);
  let vrc: u64 = ct.verify(tmp);
  let arc: u64 = if vrc != 0 { vrc } else { ct.apply_bytes(tmp, ename, out, cap) };
  let rl: u64 = ct.release(tmp);
  st.st_set_mod(k, saved_mod);
  st.st_set_sp(k, saved_sp);
  if vrc != 0 { st.st_fail(k, ax.FailKind.Unsup as u64); return i + 2; }

  let len: u64 = scan_len(out, 0, arc);
  if len == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return i + 2; }
  let src2: u64 = ct.snippet(ptr_cast(Ref(u8), out), len);
  if src2 == 0 { st.st_fail(k, ax.FailKind.Ast as u64); return i + 2; }
  if st.st_done(k, src2) == 1 { return ax.skip_semi(g, i + 2); }
  let dm: u64 = st.st_mark_done(k, src2);
  let root2: u64 = hr.source_root(src2);

  let cc: u64 = compile_as(k, saved_src, root2);
  st.st_set_src(k, saved_src);
  st.st_set_root(k, saved_root);

  let rroot: u64 = hr.set_source_root(saved_src, saved_root);
  return ax.skip_semi(g, i + 2);
};

@root
let lainc_eval_phase1_group = func(k: Mut(st.State), g: u64) -> u64 {
  return phase1(k, g, 0, ax.n_count(g));
};

@root
let lainc_eval_phase2_group = func(k: Mut(st.State), g: u64) -> u64 {
  return phase2(k, g, 0, ax.n_count(g));
};

@root
let lainc_compile_functor_mod = func(k: Mut(st.State), src: u64, bodyg: u64, parent_modv: u64, vmod: u64) -> u64 {
  let reg: u64 = modules.mod_register_vmod(k, vmod, 0);
  let par: u64 = modules.mod_set_parent(k, vmod, parent_modv);
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  st.st_set_src(k, src);
  st.st_set_vmod(k, vmod);
  let a: u64 = phase1(k, bodyg, 0, ax.n_count(bodyg));
  if st.st_ok(k) == 0 { let bd: u64 = drop.bind_self_drop(k, vmod); }
  if st.st_ok(k) == 0 and st.st_in_proc(k) == 0 {
    let b: u64 = phase2(k, bodyg, 0, ax.n_count(bodyg));
    if st.st_ok(k) == 0 { let bd2: u64 = drop.bind_self_drop(k, vmod); }
  }
  if st.st_ok(k) == 0 and st.st_in_proc(k) != 0 {
    let cntp: Mut(u64) = ax.box(k);
    let buf: Mut(u8) = ctf.snap_save(k, cntp);
    let cnt: u64 = ax.box_get(cntp);
    let used: u64 = st.st_fqused(k);
    if used + 40 > st.st_fqcap(k) {
      let m: Ref(u8) = "functor queue full";
      let d: u64 = ir.diag(k, 0, 1, m, 18);
      st.st_fail(k, ax.FailKind.Ast as u64);
    }
    if st.st_ok(k) == 0 {
      let r: Mut(FqRec) = ptr_cast(Mut(FqRec), st.st_fqbase(k) + used);
      r.vmod = vmod;
      r.src = src;
      r.bodyg = bodyg;
      r.snap = buf;
      r.cnt = cnt;
      let su: u64 = st.st_set_fqused(k, used + 40);
    }
  }
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  if st.st_ok(k) != 0 { return 0; }
  return vmod;
};

let push_snap_mods = func(k: Mut(st.State), snap_buf: Mut(u8), i: u64, cnt: u64) -> u64 {
  if i >= cnt { return 1; }
  let base: Mut(u8) = snap_buf + i * 32;
  let kind: u64 = deref(ptr_cast(Mut(u64), base + 8));
  if kind == 9 {
    let a: u64 = deref(ptr_cast(Mut(u64), base + 16));
    let b: u64 = deref(ptr_cast(Mut(u64), base + 24));
    gv.push_mod_implicit(k, a, b);
  }
  return push_snap_mods(k, snap_buf, i + 1, cnt);
};

@root
let lainc_compile_functor_mod_p2 = func(k: Mut(st.State), vmod: u64, src: u64, bodyg: u64, snap_buf: Mut(u8), snap_cnt: u64) -> u64 {
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  let cm: u64 = ctf.mark(k);
  let wm: u64 = gv.mark(k);
  let rs: u64 = ctf.snap_restore(k, snap_buf, snap_cnt);
  push_snap_mods(k, snap_buf, 0, snap_cnt);
  st.st_set_src(k, src);
  st.st_set_vmod(k, vmod);
  let b: u64 = phase2(k, bodyg, 0, ax.n_count(bodyg));
  if st.st_ok(k) == 0 { let bd: u64 = drop.bind_self_drop(k, vmod); }
  gv.release(k, wm);
  ctf.release(k, cm);
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  return b;
};
