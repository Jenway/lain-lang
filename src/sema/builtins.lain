// 内建：字符串字面量、静态表、内存读写与指针内建。参数由 core 求值成 Val 数组后送进来，
// 这样这里不需要知道表达式怎么算，core 也不用知道内建怎么写。
let st = import("src::driver::state");
let ty = import("src::sema::types");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let agg = import("src::sema::agg");
let sym = import("src::driver::sym");
let ax = import("src::sema::ast");
let modules = import("src::sema::modules");
let hr = import("src::driver::host_rt");

let SigRec = struct {
  np: u64,
  ret: Mut(ty.Ty),
  params: Mut(ty.Ty)
};

let ty_at_idx = func(ps: Mut(ty.Ty), i: u64) -> Mut(ty.Ty) {
  return ptr_cast(Mut(ty.Ty), ptr_cast(Mut(u8), ps) + i * 32);
};

// --- 静态数据 -----------------------------------------------------------
// 把值按 w 位、小端写进 p。
let put_le = func(p: Mut(u8), v: u64, w: u64) -> u64 {
  let bytes: u64 = w / 8;
  let buf: MutSlice(u8) = make_slice(MutSlice(u8), p, bytes);
  let w2: u64 = loop c(i: u64 = 0, x: u64 = v) while i < bytes {
    buf[i] = x as u8;
    x = x / 256;
    i = i + 1;
  };
  return 0;
};

// 一个转义字符的实际字节（不认识的就照原样，反斜杠后接其它字符取其本身）。
let esc_at = func(text: Ref(u8), i: u64, len: u64) -> u8 {
  let b: u8 = deref(text + i);
  if b != 92 { return b; }
  if i + 1 >= len { return b; }
  let c: u8 = deref(text + i + 1);
  if c == 110 { return 10; }
  if c == 114 { return 13; }
  if c == 116 { return 9; }
  if c == 48 { return 0; }
  return c;
};

// 转义序列吃两个字节，普通字符吃一个。
let esc_step = func(text: Ref(u8), i: u64, len: u64) -> u64 {
  let b: u8 = deref(text + i);
  if b != 92 { return 1; }
  if i + 1 >= len { return 1; }
  return 2;
};

// 把源码里的字面量字节反转义后铺进 buf，回实际长度。
let unescape_into = func(buf: Mut(u8), text: Ref(u8), len: u64) -> u64 {
  let dst: MutSlice(u8) = make_slice(MutSlice(u8), buf, len);
  let r: u64 = loop c(i: u64 = 0, o: u64 = 0) while i < len {
    let v: u8 = esc_at(text, i, len);
    let stp: u64 = esc_step(text, i, len);
    dst[o] = v;
    i = i + stp;
    o = o + 1;
  };
  return r;
};

// 字符串字面量的字节反转义后落在暂存缓冲里，交给 data_add 变成 ro 静态数据。
pub let string_data = func(s: Mut(st.State), dname: u64, text: Ref(u8), len: u64) -> u64 {
  let buf: Mut(u8) = st.st_databuf(s) + st.st_dataused(s);
  let outlen: u64 = unescape_into(buf, text, len);
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + outlen);
  let rc: u64 = ir.data_add(s, dname, buf, outlen, 0);
  return agg.array_new(s, agg.kind_string(), outlen, 0, 8, 0, 0);
};

// 定长表：[1, 2, 3] 这种字面量组按元素宽度铺进静态数据。逗号也占孩子位置，要跳过。
pub let table_cnt = func(g: u64, i: u64, n: u64, acc: u64) -> u64 {
  let cnt: u64 = loop c(k: u64 = i, a: u64 = acc) while k < n {
    if ax.is_comma(g, k) == 0 { a = a + 1; }
    k = k + 1;
  };
  return cnt;
};

let table_fill = func(s: Mut(st.State), buf: Mut(u8), g: u64, i: u64, n: u64, pos: u64, ew: u64) -> u64 {
  let filled: u64 = loop c(k: u64 = i, p: u64 = pos) while k < n {
    if ax.is_comma(g, k) == 0 {
      let tok: u64 = ax.n_at(g, k);
      let v: u64 = ax.num_value(ax.lit_addr(tok), ax.lit_len(tok));
      let off: u64 = p * ew;
      let put: u64 = put_le(buf + off, v, ew * 8);
      p = p + 1;
    }
    k = k + 1;
  };
  return filled;
};

pub let table_data = func(s: Mut(st.State), dname: u64, g: u64, elem: Mut(ty.Ty), rdonly: u64) -> u64 {
  let ew: u64 = agg.type_size(ty.tk(elem), ty.tw(elem), ty.tsh(elem));
  let n: u64 = ax.n_count(g);
  let cnt: u64 = table_cnt(g, 0, n, 0);
  let size: u64 = ew * cnt;
  let buf: Mut(u8) = st.st_databuf(s) + st.st_dataused(s);
  let fill: u64 = table_fill(s, buf, g, 0, n, 0, ew);
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + size);
  let wr: u64 = if rdonly == 1 { 0 } else { 1 };
  let rc: u64 = ir.data_add(s, dname, buf, size, wr);
  let sh: u64 = agg.array_new(s, agg.kind_array(), cnt, ty.tk(elem), ty.tw(elem), ty.tsg(elem),
                              ty.tsh(elem));
  let mark: u64 = agg.shp_set_static(sh, 1);
  return sh;
};

// 聚合的静态占位：先给一块零字节数据，字段由随后的过程写进去。
pub let agg_data = func(s: Mut(st.State), dname: u64, sh: u64) -> u64 {
  let size: u64 = agg.shp_size(sh);
  let buf: Mut(u8) = st.st_databuf(s) + st.st_dataused(s);
  let zs: MutSlice(u8) = make_slice(MutSlice(u8), buf, size);
  let zero: u8 = 0;
  let i: u64 = loop c(i: u64 = 0) while i < size {
    zs[i] = zero;
    i = i + 1;
  };
  let add: u64 = st.st_set_dataused(s, st.st_dataused(s) + size);
  return ir.data_add(s, dname, buf, size, 1);
};

// --- 间接调用 -----------------------------------------------------------
// 组里顶层逗号分隔的项数；空组算零项。
pub let arg_count = func(g: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if n == 0 { return 0; }
  return comma_n(g, 0, n, 0) + 1;
};

let comma_n = func(g: u64, i: u64, n: u64, acc: u64) -> u64 {
  if i >= n { return acc; }
  if ax.is_comma(g, i) == 1 { return comma_n(g, i + 1, n, acc + 1); }
  return comma_n(g, i + 1, n, acc);
};

// 形参类型表压进两个 64 位字：每项 16 位，低 8 位类型码、高 8 位宽度。
let pack_params_from = func(k: Mut(st.State), ps: Mut(ty.Ty), i: u64, n: u64, pk: MutSlice(u64), base: u64) -> u64 {
  if i >= n { return i; }
  let tp: Mut(ty.Ty) = ty_at_idx(ps, i);
  let code: u64 = ir.kcode(tp);
  if code == 0 { st.st_fail(k, ax.e_type()); return i; }
  let w: u64 = ty.tw(tp);
  if w > 255 { st.st_fail(k, ax.e_type()); return i; }
  let item: u64 = code + w * 256;
  let idx: u64 = base + i;
  let wi: u64 = idx / 4;
  let sh: u64 = (idx - wi * 4) * 16;
  pk[wi] = pk[wi] + (item << sh);
  return pack_params_from(k, ps, i + 1, n, pk, base);
};

let pack_params = func(k: Mut(st.State), ps: Mut(ty.Ty), i: u64, n: u64, pk: MutSlice(u64)) -> u64 {
  return pack_params_from(k, ps, i, n, pk, 0);
};

let push_vals = func(k: Mut(st.State), ab: Mut(ty.Val), i: u64, n: u64) -> u64 {
  if i >= n { return i; }
  let v: Mut(ty.Val) = ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + i * 56);
  let a: u64 = ir.op_val(k, v);
  return push_vals(k, ab, i + 1, n);
};

// 间接调用：被调值必须是指针类型，实参已在 ab 里按形参类型强制过。
pub let icall_emit = func(k: Mut(st.State), sk_raw: Ref(u8), fv: Mut(ty.Val), ab: Mut(ty.Val), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let vt: Mut(ty.Ty) = ty.vty(fv);
  if ty.tk(vt) != 3 {
    // 目标不是指针：一次性调用错误，报明确消息再失败。
    let m: Ref(u8) = "icall-target";
    let dg: u64 = ir.diag(k, 0, 1, m, 12);
    st.st_fail(k, ax.e_type());
    return 0;
  }
  let sk: Mut(SigRec) = ptr_cast(Mut(SigRec), sk_raw);
  let np: u64 = sk.np;
  let ps: Mut(ty.Ty) = sk.params;
  let ret: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let rt: u64 = ty.ty_at(ret, sk.ret);
  let pk: MutSlice(u64) = make_slice(MutSlice(u64), ptr_cast(Mut(u64), st.st_alloc(k, 16)), 2);
  pk[0] = 0;
  pk[1] = 0;
  if agg.sret_ty(ret) == 1 { return icall_sret(k, fv, ab, np, ps, ret, want, out, pk); }
  let filled: u64 = pack_params(k, ps, 0, np, pk);
  if st.st_ok(k) != 0 { return 0; }
  let res: u64 = if ty.ty_known(ret) == 1 { ir.fresh_t(k) } else { 0 };
  let ar: u64 = ir.args_reset(k);
  let f: u64 = ir.op_val(k, fv);
  let d: u64 = push_vals(k, ab, 0, np);
  let ins: u64 = ir.emit_call_indirect(k, res, ret, pk[0], pk[1]);
  if res == 0 {
    ty.val_none(out);
    return 0;
  }
  let rv: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  ty.val_ref(rv, res, ret);
  let ct: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  if ty.ty_known(want) == 0 {
    let cp: u64 = ty.val_at(ct, rv);
  } else {
    let cv: u64 = coerce_v(k, rv, want, ct);
  }
  ty.val_at(out, ct);
  return 0;
};

// 值聚合返回走隐藏出参：先 #alloca 结果块，把它当第 0 个实参传进去，
// 指令本身没有返回值，调用方拿到的就是那块地址。
let icall_sret = func(k: Mut(st.State), fv: Mut(ty.Val), ab: Mut(ty.Val), np: u64, ps: Mut(ty.Ty), ret: Mut(ty.Ty), want: Mut(ty.Ty),
                out: Mut(ty.Val), pk: MutSlice(u64)) -> u64 {
  if np + 1 > 8 { st.st_fail(k, ax.e_type()); return 0; }
  let dv: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  let ao: u64 = agg.new_obj(k, ty.tsh(ret), dv);
  pk[0] = 4;
  let filled: u64 = pack_params_from(k, ps, 0, np, pk, 1);
  if st.st_ok(k) != 0 { return 0; }
  let nt: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let n0: u64 = ty.ty_none(nt);
  let ar: u64 = ir.args_reset(k);
  let f: u64 = ir.op_val(k, fv);
  let p0: u64 = ir.op_val(k, dv);
  let d: u64 = push_vals(k, ab, 0, np);
  let ins: u64 = ir.emit_call_indirect(k, 0, nt, pk[0], pk[1]);
  let ct: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  if ty.ty_known(want) == 0 {
    let cp: u64 = ty.val_at(ct, dv);
  } else {
    let cv: u64 = coerce_v(k, dv, want, ct);
  }
  ty.val_at(out, ct);
  return 0;
};

// --- 目标系统内建 -----------------------------------------------------------
// 四个名字都是零实参调用，值在编译期就折算成常量，不产生任何指令。
let b_target_os = func() -> u64 { return sym.intern("target_os", 9); };
let b_is_windows = func() -> u64 { return sym.intern("is_windows", 10); };
let b_is_linux = func() -> u64 { return sym.intern("is_linux", 8); };
let b_is_macos = func() -> u64 { return sym.intern("is_macos", 8); };

// target_os() 的结果是 u64 编号，is_*() 的结果是 bool。
let os_id_lit = func(k: Mut(st.State), out: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let u: u64 = ty.ty_u64(t);
  return ty.val_lit(out, hr.get_target_os(), t);
};

let os_is_lit = func(k: Mut(st.State), want: u64, out: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let b: u64 = ty.ty_bool(t);
  let got: u64 = hr.get_target_os();
  let v: u64 = if got == want { 1 } else { 0 };
  return ty.val_lit(out, v, t);
};

// --- 内建分派 -----------------------------------------------------------
pub let is_builtin = func(name: u64) -> u64 {
  if name == b_target_os() { return 1; }
  if name == b_is_windows() { return 1; }
  if name == b_is_linux() { return 1; }
  if name == b_is_macos() { return 1; }
  if name == sym.b_load() { return 1; }
  if name == sym.b_store() { return 1; }
  if name == sym.b_lea() { return 1; }
  if name == sym.b_ptr_of() { return 1; }
  if name == sym.b_addr_of() { return 1; }
  if name == sym.b_len() { return 1; }
  if name == sym.b_ref_of() { return 1; }
  if name == sym.b_mut_of() { return 1; }
  if name == sym.b_deref() { return 1; }
  if name == sym.b_fn_of() { return 1; }
  if name == sym.b_slice_of() { return 1; }
  if name == sym.b_symbol_addr() { return 1; }
  if name == sym.b_ptr_cast() { return 1; }
  if name == sym.b_make_slice() { return 1; }
  if name == sym.b_null_ref() { return 1; }
  if name == sym.b_init_at() { return 1; }
  if name == sym.b_init_zero() { return 1; }
  if name == sym.b_drop_at() { return 1; }
  if name == sym.b_drop() { return 1; }
  if name == sym.b_reloc() { return 1; }
  if name == sym.b_is_null() { return 1; }
  if name == sym.b_atomic_load() { return 1; }
  if name == sym.b_atomic_store() { return 1; }
  if name == sym.b_atomic_cas() { return 1; }
  if name == sym.b_atomic_add() { return 1; }
  if name == sym.b_atomic_fence() { return 1; }
  return 0;
};

// 读的内存宽度由上下文期望类型决定，没有期望时按机器字。
let load_ty = func(k: Mut(st.State), want: Mut(ty.Ty)) -> Mut(ty.Ty) {
  if ty.ty_known(want) == 1 { return want; }
  return ir.tbits(k, 64);
};

// 位宽不足一字节的整数类型（bool 只有 1 位，排除 TY_ADDR）在内存里占 1 字节：
// 读回来先截到 tp，写出去先零扩满 1 字节。
let is_subbyte_bits = func(tp: Mut(ty.Ty)) -> u64 {
  if ty.tk(tp) != (codes.TyKind.Bits as u64) { return 0; }
  return if ty.ty_byte_ok(tp) == 0 { 1 } else { 0 };
};

let narrow_byte = func(k: Mut(st.State), raw: u64, tp: Mut(ty.Ty)) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, raw);
  let ins: u64 = ir.emit(k, codes.InstKind.Trunc as u64, res, tp);
  return res;
};

let widen_byte = func(k: Mut(st.State), v: Mut(ty.Val), t8: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  if ty.vlit(v) == 1 { return ty.val_lit(out, ty.vbits(v), t8); }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, ty.vn(v));
  let ins: u64 = ir.emit(k, codes.InstKind.ZExt as u64, res, t8);
  return ty.val_ref(out, res, t8);
};

let do_load = func(k: Mut(st.State), v0: Mut(ty.Val), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = load_ty(k, want);
  if is_subbyte_bits(t) == 1 {
    let t8: Mut(ty.Ty) = ir.tbits(k, 8);
    let raw: u64 = ir.fresh_t(k);
    let rc: u64 = ir.args_reset(k);
    let a: u64 = ir.op_val(k, v0);
    let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, raw, t8, 0);
    let res: u64 = narrow_byte(k, raw, t);
    return ty.val_ref(out, res, t);
  }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let ins: u64 = ir.emit_mem(k, codes.InstKind.Load as u64, res, t, 0);
  return ty.val_ref(out, res, t);
};

// store 的宽度取右值的类型；右值是裸字面量时按 64 位，字面量的类型已知
// 且位宽不足一字节（bool）时按它的真实类型（写内存时零扩到 1 字节）。
let store_ty = func(k: Mut(st.State), v: Mut(ty.Val)) -> Mut(ty.Ty) {
  let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let vt: Mut(ty.Ty) = ty.vty(v);
  if ty.ty_known(vt) == 1 and is_subbyte_bits(vt) == 1 { let cp0: u64 = ty.ty_at(t, vt); return t; }
  if ty.vlit(v) == 1 { let rc: u64 = ty.ty_bits(t, 64, 0); return t; }
  if ty.ty_known(vt) == 0 { let rc: u64 = ty.ty_bits(t, 64, 0); return t; }
  let cp: u64 = ty.ty_at(t, vt);
  return t;
};

let do_store = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val)) -> u64 {
  let t: Mut(ty.Ty) = store_ty(k, v1);
  if is_subbyte_bits(t) == 1 {
    let t8: Mut(ty.Ty) = ir.tbits(k, 8);
    let w: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
    let wv: u64 = widen_byte(k, v1, t8, w);
    let rc: u64 = ir.args_reset(k);
    let a: u64 = ir.op_val(k, w);
    let b: u64 = ir.op_val(k, v0);
    return ir.emit_mem(k, codes.InstKind.Store as u64, 0, t8, 0);
  }
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v1);
  let b: u64 = ir.op_val(k, v0);
  return ir.emit_mem(k, codes.InstKind.Store as u64, 0, t, 0);
};

// 原子指令的类型一律按 64 位字，内存序作整数操作数原地传入。
let do_atomic_fence = func(k: Mut(st.State), v0: Mut(ty.Val)) -> u64 {
  let nt: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let nn: u64 = ty.ty_none(nt);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  return ir.emit(k, codes.InstKind.AtomicFence as u64, 0, nt);
};

let do_atomic_load = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), out: Mut(ty.Val)) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let b: u64 = ir.op_val(k, v1);
  let ins: u64 = ir.emit(k, codes.InstKind.AtomicLoad as u64, res, t64);
  return ty.val_ref(out, res, t64);
};

let do_atomic_store = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), v2: Mut(ty.Val)) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v1);
  let b: u64 = ir.op_val(k, v0);
  let c: u64 = ir.op_val(k, v2);
  return ir.emit(k, codes.InstKind.AtomicStore as u64, 0, t64);
};

let do_atomic_cas = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), v2: Mut(ty.Val), v3: Mut(ty.Val),
                         out: Mut(ty.Val)) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let b: u64 = ir.op_val(k, v1);
  let c: u64 = ir.op_val(k, v2);
  let d: u64 = ir.op_val(k, v3);
  let ins: u64 = ir.emit(k, codes.InstKind.Cmpxchg as u64, res, t64);
  return ty.val_ref(out, res, t64);
};

let do_atomic_add = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), v2: Mut(ty.Val), out: Mut(ty.Val)) -> u64 {
  let t64: Mut(ty.Ty) = ir.tbits(k, 64);
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let b: u64 = ir.op_val(k, v1);
  let c: u64 = ir.op_val(k, v2);
  let ins: u64 = ir.emit(k, codes.InstKind.RmwAdd as u64, res, t64);
  return ty.val_ref(out, res, t64);
};

let do_lea = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), out: Mut(ty.Val)) -> u64 {
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.op_val(k, v0);
  let b: u64 = ir.op_val(k, v1);
  let c: u64 = ir.arg_int(k, 1);
  let d: u64 = ir.arg_int(k, 0);
  let ins: u64 = ir.emit(k, codes.InstKind.Lea as u64, res, ir.taddr(k));
  return ty.val_ref(out, res, ir.taddr(k));
};

let do_slice = func(k: Mut(st.State), v0: Mut(ty.Val), v1: Mut(ty.Val), out: Mut(ty.Val)) -> u64 {
  let obj: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, 56));
  let base: u64 = agg.new_bytes(k, 16, 8, obj);
  let at: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let u64t: u64 = ty.ty_u64(at);
  let ptr_t: Mut(ty.Ty) = ir.taddr(k);
  let s1: u64 = agg.store_at(k, base, 0, v0, ptr_t);
  let s2: u64 = agg.store_at(k, base, 8, v1, at);
  let av: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
  let ta: u64 = ty.ty_addr(av);
  return ty.val_ref(out, base, av);
};

pub let apply = func(k: Mut(st.State), name: u64, argv: Mut(u8), n: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let v0: Mut(ty.Val) = ptr_cast(Mut(ty.Val), argv);
  let v1: Mut(ty.Val) = ptr_cast(Mut(ty.Val), argv + 56);
  let v2: Mut(ty.Val) = ptr_cast(Mut(ty.Val), argv + 112);
  let v3: Mut(ty.Val) = ptr_cast(Mut(ty.Val), argv + 168);
  if name == b_target_os() { return os_id_lit(k, out); }
  if name == b_is_windows() { return os_is_lit(k, hr.OS_WINDOWS(), out); }
  if name == b_is_linux() { return os_is_lit(k, hr.OS_LINUX(), out); }
  if name == b_is_macos() { return os_is_lit(k, hr.OS_MACOS(), out); }
  if name == sym.b_load() { return do_load(k, v0, want, out); }
  if name == sym.b_store() { return do_store(k, v0, v1); }
  if name == sym.b_atomic_load() { return do_atomic_load(k, v0, v1, out); }
  if name == sym.b_atomic_store() { return do_atomic_store(k, v0, v1, v2); }
  if name == sym.b_atomic_cas() { return do_atomic_cas(k, v0, v1, v2, v3, out); }
  if name == sym.b_atomic_add() { return do_atomic_add(k, v0, v1, v2, out); }
  if name == sym.b_atomic_fence() { return do_atomic_fence(k, v0); }
  if name == sym.b_lea() { return do_lea(k, v0, v1, out); }
  if name == sym.b_ptr_of() {
    let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
    let u: u64 = ty.ty_u64(t);
    return coerce_v(k, v0, t, out);
  }
  if name == sym.b_addr_of() {
    let t: Mut(ty.Ty) = ir.taddr(k);
    return coerce_v(k, v0, t, out);
  }
  if name == sym.b_ref_of() {
    let vt: Mut(ty.Ty) = ty.vty(v0);
    if ty.tk(vt) == 3 { let cp: u64 = ty.val_at(out, v0); return 0; }
    let rc: u64 = st.st_fail(k, 3);
    return 0;
  }
  if name == sym.b_len() {
    let vt: Mut(ty.Ty) = ty.vty(v0);
    let sh: u64 = ty.tsh(vt);
    let t: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 32));
    let u: u64 = ty.ty_u64(t);
    if sh == 0 { let rc: u64 = st.st_fail(k, 3); return 0; }
    let cnt: u64 = agg.shp_len(sh);
    return ty.val_lit(out, cnt, t);
  }
  if name == sym.b_slice_of() { return do_slice(k, v0, v1, out); }
  let rc: u64 = st.st_fail(k, 5);
  return 0;
};

// coerce 的本地副本：builtins 在 ctx 之前，不能反向依赖。
let coerce_v = func(k: Mut(st.State), v: Mut(ty.Val), to: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let from: Mut(ty.Ty) = ty.vty(v);
  let cp: u64 = ty.val_at(out, v);
  if ty.ty_known(from) == 0 { return 0; }
  if ty.vlit(v) == 1 { return ty.val_lit(out, ty.vbits(v), to); }
  if ty.ty_same(from, to) == 1 { return 0; }
  let kind: u64 = ty.cast_inst(ty.tk(from), ty.tw(from), ty.tsg(from), ty.tk(to), ty.tw(to));
  if kind == 0 { return 0; }
  let res: u64 = ir.fresh_t(k);
  let rc: u64 = ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, ty.vn(v));
  let ins: u64 = ir.emit(k, kind, res, to);
  return ty.val_ref(out, res, to);
};

// symbol_addr("name")：把字面量文本当作数据符号名，拼上本模块前缀。
pub let symbol_addr = func(k: Mut(st.State), g: u64, out: Mut(ty.Val), src: u64) -> u64 {
  let h: u64 = if ax.n_count(g) > 0 { ax.n_at(g, 0) } else { 0 };
  if h == 0 { return 0; }
  let off: Ref(u8) = ax.lit_addr(h) + 1;
  let len: u64 = ax.lit_len(h) - 2;
  if len == 0 { return 0; }
  let p: Mut(u8) = st.st_scratch(k) + 64;
  let ds: MutSlice(u8) = make_slice(MutSlice(u8), p, len);
  let ss: Slice(u8) = make_slice(Slice(u8), off, len);
  let i: u64 = loop c(i: u64 = 0) while i < len {
    ds[i] = ss[i];
    i = i + 1;
  };
  let name: u64 = ir.sym_lit(p, len);
  let q: u64 = modules.qual(k, src, name);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let a: u64 = ty.ty_addr(t);
  return ty.val_ref(out, q, t);
};
