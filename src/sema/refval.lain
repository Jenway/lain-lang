let st = import("src::driver::state");
let ty = import("src::sema::types");
let env = import("src::sema::env");
let ir = import("src::sema::ir_emit");
let codes = import("src::ir::ir_codes");
let s = import("src::driver::sym");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let agg = import("src::sema::agg");
let modules = import("src::sema::modules");
let bi = import("src::sema::builtins");
let ireg = import("src::sema::tyreg");
let ct = import("src::comptime::ctypes");
let cl = import("src::sema::calls");
let ctf = import("src::comptime::ctfor");
let drop = import("src::sema::drop");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;
extern core_tail(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_tail;
extern ufcs_on_val_bridge(k: Mut(st.State), g: u64, i: u64, fname: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_ufcs_on_val;

pub let deref_loads = func(sh: u64) -> u64 {
  if sh == 0 { return 1; }
  let kd: u64 = agg.shp_kind(sh);
  if kd == agg.ShapeKind.Ref as u64 or kd == agg.ShapeKind.Mut as u64 or kd == agg.ShapeKind.Fn as u64 { return 1; }
  return 0;
};

let is_ref_shape = func(sh: u64) -> u64 {
  if sh == 0 { return 0; }
  let kd: u64 = agg.shp_kind(sh);
  if kd == agg.ShapeKind.Ref as u64 or kd == agg.ShapeKind.Mut as u64 { return 1; }
  return 0;
};

let is_ptr_shape = func(sh: u64) -> u64 {
  if sh == 0 { return 0; }
  let kd: u64 = agg.shp_kind(sh);
  if kd == agg.ShapeKind.Ref as u64 or kd == agg.ShapeKind.Mut as u64 or kd == agg.ShapeKind.Uninit as u64 { return 1; }
  return 0;
};

pub let fn_val_p = func(k: Mut(st.State), out: Mut(ty.Val)) -> u64 {
  let sh: u64 = ty.tsh(ty.vty(out));
  if sh == 0 { return 0; }
  if agg.shp_kind(sh) == agg.ShapeKind.Fn as u64 { return 1; }
  return 0;
};

pub let unwrap_ref = func(k: Mut(st.State), out: Mut(ty.Val)) -> u64 {
  let sh: u64 = ty.tsh(ty.vty(out));
  if sh == 0 { return 0; }
  if is_ref_shape(sh) == 0 { return 0; }
  let eid: u64 = ct.elem_tid(k, sh);
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  let pr: u64 = ireg.project(k, eid, rt);
  let got: Mut(ty.Val) = ax.new_val(k);
  if deref_loads(ty.tsh(rt)) == 1 {
    let l: u64 = agg.load_at(k, ty.vn(out), 0, rt, got);
  } else {
    let r: u64 = ty.val_ref(got, ty.vn(out), rt);
  }
  ty.val_at(out, got);
  return unwrap_ref(k, out) + 1;
};

let ref_ty = func(k: Mut(st.State), eid: u64, mutv: u64) -> Mut(ty.Ty) {
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let id: u64 = ct.ref_t(k, eid, mutv);
  let p: u64 = ireg.project(k, id, t);
  return t;
};

let as_ref = func(k: Mut(st.State), v: Mut(ty.Val), rt: Mut(ty.Ty), want: Mut(ty.Ty), out: Mut(ty.Val), back: u64) -> u64 {
  if ty.tk(ty.vty(v)) != 3 {
    let m: Ref(u8) = "ref-nonaddr";
    let d: u64 = ir.diag(k, 0, 1, m, 11);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return back;
  }
  let rv: Mut(ty.Val) = ax.new_val(k);
  let r0: u64 = ty.val_ref(rv, ty.vn(v), rt);
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, rv, rt, want, c);
  ty.val_at(out, c);
  return back;
};

let tnone = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.tnone(k); };
let t64 = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.t64(k); };
let coerce = func(k: Mut(st.State), v: Mut(ty.Val), from: Mut(ty.Ty), to: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return cx.coerce(k, v, from, to, out); };
let slot_get = func(k: Mut(st.State), j: u64, tp: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return cx.slot_get(k, j, tp, out); };

let ref_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val), mutv: u64) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  if ax.is_group(argsg, 0) == 0 and ax.is_name(argsg, 0) == 1 {
    let nm: u64 = ax.n_sym(argsg, 0);
    let off: u64 = env.env_find(k, nm);
    if off != 0 {
      if env.env_alive(k, off) == 0 {
        let m: Ref(u8) = "use after reloc";
        let d: u64 = ir.diag(k, 0, 1, m, 15);
        st.st_fail(k, ax.FailKind.Type as u64);
        ty.val_none(out);
        return i + 2;
      }
      let vt: Mut(ty.Ty) = ax.new_ty(k);
      let g0: u64 = env.env_ty(k, off, vt);
      let rt: Mut(ty.Ty) = ref_ty(k, ireg.tid_of(k, vt), mutv);
      if ty.tsh(vt) == 0 {
        let res: u64 = ir.fresh_t(k);
        let rc: u64 = ir.args_reset(k);
        let lea: u64 = ir.emit_lea(k, res, ir.slot_name(k, env.env_slot(k, off)), 0, 1, 0);
        let rv: Mut(ty.Val) = ax.new_val(k);
        let r1: u64 = ty.val_ref(rv, res, rt);
        let c: Mut(ty.Val) = ax.new_val(k);
        coerce(k, rv, rt, want, c);
        ty.val_at(out, c);
        return i + 2;
      }
      let ov: Mut(ty.Val) = ax.new_val(k);
      let got: u64 = slot_get(k, env.env_slot(k, off), vt, ov);
      return as_ref(k, ov, rt, want, out, i + 2);
    }
  }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, argsg, 0, 0, tnone(k), v);
  let rt: Mut(ty.Ty) = ref_ty(k, ireg.tid_of(k, ty.vty(v)), mutv);
  return as_ref(k, v, rt, want, out, i + 2);
};

let deref_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, argsg, 0, 0, tnone(k), v);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let sh: u64 = ty.tsh(ty.vty(v));
  if is_ref_shape(sh) == 0 {
    let m: Ref(u8) = "deref-nonref";
    let d: u64 = ir.diag(k, 0, 1, m, 12);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let eid: u64 = ct.elem_tid(k, sh);
  if eid == ireg.void_tid(k) {
    let m: Ref(u8) = "deref-void";
    let d: u64 = ir.diag(k, 0, 1, m, 10);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let et: Mut(ty.Ty) = ax.new_ty(k);
  let pr: u64 = ireg.project(k, eid, et);
  let got: Mut(ty.Val) = ax.new_val(k);
  if deref_loads(ty.tsh(et)) == 1 {
    let l: u64 = agg.load_at(k, ty.vn(v), 0, et, got);
  } else {
    let r: u64 = ty.val_ref(got, ty.vn(v), et);
  }
  ty.val_at(out, got);
  return i + 2;
};

let def_slice_ty = func(k: Mut(st.State), mutv: u64) -> Mut(ty.Ty) {
  let e: Mut(ty.Ty) = ax.new_ty(k);
  let u: u64 = ty.ty_u8(e);
  let id: u64 = ireg.tid_of(k, e);
  let sid: u64 = ct.slice_t(k, id, mutv);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let p: u64 = ireg.project(k, sid, t);
  return t;
};

let slice_target = func(k: Mut(st.State), want: Mut(ty.Ty), mutv: u64) -> Mut(ty.Ty) {
  let wsh: u64 = ty.tsh(want);
  if wsh != 0 {
    let kd: u64 = agg.shp_kind(wsh);
    if kd == agg.ShapeKind.Slice as u64 or kd == agg.ShapeKind.MutSlice as u64 { return want; }
  }
  return def_slice_ty(k, mutv);
};

let elem_slice_ty = func(k: Mut(st.State), elem: u64) -> Mut(ty.Ty) {
  let sid: u64 = ct.slice_t(k, elem, 0);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let p: u64 = ireg.project(k, sid, t);
  return t;
};

let want_is_slice = func(want: Mut(ty.Ty)) -> u64 {
  let wsh: u64 = ty.tsh(want);
  if wsh == 0 { return 0; }
  let kd: u64 = agg.shp_kind(wsh);
  if kd == agg.ShapeKind.Slice as u64 or kd == agg.ShapeKind.MutSlice as u64 { return 1; }
  return 0;
};

let make_head = func(k: Mut(st.State), pv: Mut(ty.Val), lv: Mut(ty.Val), tgt: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let obj: Mut(ty.Val) = ax.new_val(k);
  let base: u64 = agg.new_bytes(k, 16, 8, obj);
  let at: Mut(ty.Ty) = ir.taddr(k);
  let p2: Mut(ty.Val) = ax.new_val(k);
  coerce(k, pv, ty.vty(pv), at, p2);
  let s1: u64 = agg.store_at(k, base, 0, p2, at);
  let ut: Mut(ty.Ty) = ax.new_ty(k);
  let u: u64 = ty.ty_u64(ut);
  let l2: Mut(ty.Val) = ax.new_val(k);
  coerce(k, lv, ty.vty(lv), ut, l2);
  let s2: u64 = agg.store_at(k, base, 8, l2, ut);
  return ty.val_ref(out, base, tgt);
};

let slice_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  let na: u64 = bi.arg_count(argsg);
  if na == 0 { return 0; }
  let v1: Mut(ty.Val) = ax.new_val(k);
  let j1: u64 = core_expr(k, argsg, 0, 0, tnone(k), v1);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if na == 1 {
    let sh: u64 = ty.tsh(ty.vty(v1));
    if sh == 0 { st.st_fail(k, ax.FailKind.Type as u64); ty.val_none(out); return i + 2; }
    let kd: u64 = agg.shp_kind(sh);
    if (kd != agg.ShapeKind.Array as u64) and (kd != agg.ShapeKind.String as u64) {
      st.st_fail(k, ax.FailKind.Type as u64);
      ty.val_none(out);
      return i + 2;
    }
    let tgt: Mut(ty.Ty) = slice_target(k, want, 0);
    if kd == agg.ShapeKind.Array as u64 {
      if want_is_slice(want) == 0 { tgt = elem_slice_ty(k, ct.elem_tid(k, sh)); }
    }
    let c: Mut(ty.Val) = ax.new_val(k);
    coerce(k, v1, ty.vty(v1), tgt, c);
    ty.val_at(out, c);
    return i + 2;
  }
  let bc: u64 = if ax.is_comma(argsg, j1) == 1 { j1 + 1 } else { j1 };
  let v2: Mut(ty.Val) = ax.new_val(k);
  let j2: u64 = core_expr(k, argsg, bc, 0, t64(k), v2);
  let tgt: Mut(ty.Ty) = slice_target(k, want, 0);
  let c: Mut(ty.Val) = ax.new_val(k);
  let h: u64 = make_head(k, v1, v2, tgt, c);
  ty.val_at(out, c);
  return i + 2;
};

let len_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, argsg, 0, 0, tnone(k), v);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let sh: u64 = ty.tsh(ty.vty(v));
  if sh == 0 { st.st_fail(k, ax.FailKind.Type as u64); ty.val_none(out); return i + 2; }
  let kd: u64 = agg.shp_kind(sh);
  let ut: Mut(ty.Ty) = t64(k);
  let lv: Mut(ty.Val) = ax.new_val(k);
  if kd == agg.ShapeKind.Slice as u64 or kd == agg.ShapeKind.MutSlice as u64 {
    let l: u64 = agg.load_at(k, ty.vn(v), 8, ut, lv);
  } else {
    let l2: u64 = ty.val_lit(lv, agg.shp_len(sh), ut);
  }
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, lv, ut, want, c);
  ty.val_at(out, c);
  return i + 2;
};

let synth_sig = func(k: Mut(st.State), sg: Mut(u8), i: u64, np: u64, sig: Mut(u64)) -> u64 {
  if i >= np { return i; }
  let ps: Mut(ty.Ty) = cx.sig_params(sg);
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let c: u64 = ty.ty_at(t, cx.ty_idx(ps, i));
  let wp: Mut(u64) = cx.word_idx(sig, i);
  deref(wp) = ireg.tid_of(k, t);
  return synth_sig(k, sg, i + 1, np, sig);
};

let fn_of_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  if ax.is_group(argsg, 0) == 1 or ax.is_name(argsg, 0) == 0 {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let nm: u64 = ax.n_sym(argsg, 0);
  let e: Mut(modules.SymEntry) = modules.find_here(k, nm);
  if is_null(e) { ty.val_none(out); return i + 2; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_func() and kd != modules.sym_kind_extern() {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let sg: Mut(u8) = modules.sym_sig(e);
  let np: u64 = cx.sig_np(sg);
  let ret: Mut(ty.Ty) = ax.new_ty(k);
  let r1: u64 = ty.ty_at(ret, cx.sig_ret(sg));
  let sig: Mut(u64) = ptr_cast(Mut(u64), st.st_ralloc(k, np * 8 + 8));
  let filled: u64 = synth_sig(k, sg, 0, np, sig);
  let fid: u64 = ct.fn_t(k, ireg.tid_of(k, ret), np, sig as u64);
  let ft: Mut(ty.Ty) = ax.new_ty(k);
  let pr: u64 = ireg.project(k, fid, ft);
  let v: Mut(ty.Val) = ax.new_val(k);
  let v1: u64 = ty.val_ref(v, modules.sym_qual(e), ft);
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, v, ft, want, c);
  ty.val_at(out, c);
  return i + 2;
};

let ptr_cast_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) < 3 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  let j1: u64 = cx.parse_type(k, argsg, 0, rt);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if is_ptr_shape(ty.tsh(rt)) == 0 {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let bc: u64 = if ax.is_comma(argsg, j1) == 1 { j1 + 1 } else { j1 };
  let v1: Mut(ty.Val) = ax.new_val(k);
  let j2: u64 = core_expr(k, argsg, bc, 0, tnone(k), v1);
  let ignored: u64 = j2;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if ty.tk(ty.vty(v1)) == 0 and ty.tw(ty.vty(v1)) == 64 {
    let uv: u64 = cx.val_force(k, v1, t64(k));
    let ap: u64 = ir.fresh_t(k);
    ir.args_reset(k);
    ir.arg_ref(k, uv);
    ir.emit(k, codes.InstKind.Bitcast as u64, ap, ir.taddr(k));
    let av: Mut(ty.Val) = ax.new_val(k);
    ty.val_ref(av, ap, rt);
    return as_ref(k, av, rt, want, out, i + 2);
  }
  return as_ref(k, v1, rt, want, out, i + 2);
};

let null_ref_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let rt: Mut(ty.Ty) = ax.new_ty(k);
  let j1: u64 = cx.parse_type(k, argsg, 0, rt);
  let ignored: u64 = j1;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if is_ptr_shape(ty.tsh(rt)) == 0 {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let zv: Mut(ty.Val) = ax.new_val(k);
  ty.val_lit(zv, 0, t64(k));
  let uv: u64 = cx.val_force(k, zv, t64(k));
  let ap: u64 = ir.fresh_t(k);
  ir.args_reset(k);
  ir.arg_ref(k, uv);
  ir.emit(k, codes.InstKind.Bitcast as u64, ap, ir.taddr(k));
  let av: Mut(ty.Val) = ax.new_val(k);
  ty.val_ref(av, ap, rt);
  return as_ref(k, av, rt, want, out, i + 2);
};

let is_null_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) == 0 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let v1: Mut(ty.Val) = ax.new_val(k);
  let j1: u64 = core_expr(k, argsg, 0, 0, tnone(k), v1);
  let ignored: u64 = j1;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if ty.tk(ty.vty(v1)) != 3 {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let bt: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_bool(bt);
  let bv: Mut(ty.Val) = ax.new_val(k);
  if ty.vlit(v1) == 1 {
    let rz: u64 = if ty.vbits(v1) == 0 { 1 } else { 0 };
    ty.val_lit(bv, rz, bt);
  } else {
    let uv: u64 = ir.fresh_t(k);
    ir.args_reset(k);
    ir.arg_ref(k, ty.vn(v1));
    ir.emit(k, codes.InstKind.Bitcast as u64, uv, t64(k));
    let eqr: u64 = ir.fresh_t(k);
    ir.args_reset(k);
    ir.arg_ref(k, uv);
    ir.arg_int(k, 0);
    ir.emit(k, codes.InstKind.Eq as u64, eqr, t64(k));
    ty.val_ref(bv, eqr, bt);
  }
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, bv, bt, want, c);
  ty.val_at(out, c);
  return i + 2;
};

let retag_ptr = func(k: Mut(st.State), eid: u64, name: u64, kind: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let id: u64 = if kind == 2 { ct.uninit_t(k, eid) } else { ct.ref_t(k, eid, kind) };
  let t: Mut(ty.Ty) = ax.new_ty(k);
  let p: u64 = ireg.project(k, id, t);
  let rv: Mut(ty.Val) = ax.new_val(k);
  let r: u64 = ty.val_ref(rv, name, t);
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, rv, t, want, c);
  ty.val_at(out, c);
  return 0;
};

let ptr_check = func(k: Mut(st.State), v: Mut(ty.Val), want_kind: u64, msg: Ref(u8), msglen: u64) -> u64 {
  let sh: u64 = ty.tsh(ty.vty(v));
  if sh != 0 and agg.shp_kind(sh) == want_kind { return sh; }
  let d: u64 = ir.diag(k, 0, 1, msg, msglen);
  st.st_fail(k, ax.FailKind.Type as u64);
  return 0;
};

let init_at_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if bi.arg_count(argsg) != 2 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let dv: Mut(ty.Val) = ax.new_val(k);
  let j1: u64 = core_expr(k, argsg, 0, 0, tnone(k), dv);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let m: Ref(u8) = "init_at-nonuninit";
  let sh: u64 = ptr_check(k, dv, agg.ShapeKind.Uninit as u64, m, 17);
  if sh == 0 { ty.val_none(out); return i + 2; }
  let eid: u64 = ct.elem_tid(k, sh);
  let et: Mut(ty.Ty) = ax.new_ty(k);
  let pr: u64 = ireg.project(k, eid, et);
  let bc: u64 = if ax.is_comma(argsg, j1) == 1 { j1 + 1 } else { j1 };
  let ca: u64 = drop.bare_local(k, argsg, bc);
  if ca != 0 and env.env_is_noncopy(k, ca) == 1 {
    let cm: Ref(u8) = "implicit copy of !Copy";
    let cd: u64 = ir.diag(k, 0, 1, cm, 22);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let vv: Mut(ty.Val) = ax.new_val(k);
  let j2: u64 = core_expr(k, argsg, bc, 0, et, vv);
  let ignored: u64 = j2;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let cv: Mut(ty.Val) = ax.new_val(k);
  coerce(k, vv, ty.vty(vv), et, cv);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let s: u64 = agg.store_at(k, ty.vn(dv), 0, cv, et);
  let r: u64 = retag_ptr(k, eid, ty.vn(dv), 1, want, out);
  return i + 2;
};

let init_zero_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if bi.arg_count(argsg) != 1 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let dv: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, argsg, 0, 0, tnone(k), dv);
  let ignored: u64 = j;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let m: Ref(u8) = "init_zero-nonuninit";
  let sh: u64 = ptr_check(k, dv, agg.ShapeKind.Uninit as u64, m, 19);
  if sh == 0 { ty.val_none(out); return i + 2; }
  let eid: u64 = ct.elem_tid(k, sh);
  let esh: u64 = ireg.ty_shape(k, eid);
  if esh != 0 and agg.shp_has_drop(esh) == 1 {
    let zm: Ref(u8) = "init_zero on !Copy";
    let zd: u64 = ir.diag(k, 0, 1, zm, 18);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let size: u64 = ireg.size_of(k, eid);
  let z: u64 = agg.zero_at(k, ty.vn(dv), 0, size);
  let r: u64 = retag_ptr(k, eid, ty.vn(dv), 1, want, out);
  return i + 2;
};

let drop_at_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if bi.arg_count(argsg) != 1 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let pv: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, argsg, 0, 0, tnone(k), pv);
  let ignored: u64 = j;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let m: Ref(u8) = "drop_at-nonmut";
  let sh: u64 = ptr_check(k, pv, agg.ShapeKind.Mut as u64, m, 14);
  if sh == 0 { ty.val_none(out); return i + 2; }
  let eid: u64 = ct.elem_tid(k, sh);
  let esh: u64 = ireg.ty_shape(k, eid);
  if esh != 0 and agg.shp_has_drop(esh) == 1 {
    let dr: u64 = agg.drop_value_at(k, esh, ty.vn(pv));
  }
  let r: u64 = retag_ptr(k, eid, ty.vn(pv), 2, want, out);
  return i + 2;
};

let reloc_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if bi.arg_count(argsg) != 1 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  if ax.is_name(argsg, 0) == 0 { st.st_fail(k, ax.FailKind.Type as u64); ty.val_none(out); return i + 2; }
  let nm: u64 = ax.n_sym(argsg, 0);
  let off: u64 = env.env_find(k, nm);
  if off == 0 {
    let m: Ref(u8) = "reloc-nonlocal";
    let d: u64 = ir.diag(k, 0, 1, m, 14);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  if env.env_alive(k, off) == 0 {
    let m: Ref(u8) = "use after reloc";
    let d: u64 = ir.diag(k, 0, 1, m, 15);
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let vt: Mut(ty.Ty) = ax.new_ty(k);
  let g0: u64 = env.env_ty(k, off, vt);
  let v: Mut(ty.Val) = ax.new_val(k);
  let sg: u64 = slot_get(k, env.env_slot(k, off), vt, v);
  let c: Mut(ty.Val) = ax.new_val(k);
  coerce(k, v, vt, want, c);
  let rl: u64 = drop.mark_relocated(k, off);
  ty.val_at(out, c);
  return i + 2;
};

let make_slice_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i + 1);
  if ax.n_count(argsg) < 5 { st.st_fail(k, ax.FailKind.Ast as u64); ty.val_none(out); return i + 2; }
  let tgt: Mut(ty.Ty) = ax.new_ty(k);
  let j1: u64 = cx.parse_type(k, argsg, 0, tgt);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let sh: u64 = ty.tsh(tgt);
  if sh == 0 { st.st_fail(k, ax.FailKind.Type as u64); ty.val_none(out); return i + 2; }
  let kd: u64 = agg.shp_kind(sh);
  if (kd != agg.ShapeKind.Slice as u64) and (kd != agg.ShapeKind.MutSlice as u64) {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let bc1: u64 = if ax.is_comma(argsg, j1) == 1 { j1 + 1 } else { j1 };
  let v1: Mut(ty.Val) = ax.new_val(k);
  let j2: u64 = core_expr(k, argsg, bc1, 0, tnone(k), v1);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  if ty.tk(ty.vty(v1)) != 3 {
    st.st_fail(k, ax.FailKind.Type as u64);
    ty.val_none(out);
    return i + 2;
  }
  let bc2: u64 = if ax.is_comma(argsg, j2) == 1 { j2 + 1 } else { j2 };
  let v2: Mut(ty.Val) = ax.new_val(k);
  let j3: u64 = core_expr(k, argsg, bc2, 0, t64(k), v2);
  let ignored: u64 = j3;
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 2; }
  let c: Mut(ty.Val) = ax.new_val(k);
  let h: u64 = make_head(k, v1, v2, tgt, c);
  let ig2: u64 = h;
  let w: Mut(ty.Val) = ax.new_val(k);
  coerce(k, c, tgt, want, w);
  ty.val_at(out, w);
  return i + 2;
};

pub let typed_builtin = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let name: u64 = ax.n_sym(g, i);
  if name == s.b_ref_of() { return ref_call(k, g, i, want, out, 0); }
  if name == s.b_mut_of() { return ref_call(k, g, i, want, out, 1); }
  if name == s.b_deref() { return deref_call(k, g, i, want, out); }
  if name == s.b_len() { return len_call(k, g, i, want, out); }
  if name == s.b_slice_of() { return slice_call(k, g, i, want, out); }
  if name == s.b_fn_of() { return fn_of_call(k, g, i, want, out); }
  if name == s.b_ptr_cast() { return ptr_cast_call(k, g, i, want, out); }
  if name == s.b_null_ref() { return null_ref_call(k, g, i, want, out); }
  if name == s.b_is_null() { return is_null_call(k, g, i, want, out); }
  if name == s.b_make_slice() { return make_slice_call(k, g, i, want, out); }
  if name == s.b_init_at() { return init_at_call(k, g, i, want, out); }
  if name == s.b_init_zero() { return init_zero_call(k, g, i, want, out); }
  if name == s.b_drop_at() { return drop_at_call(k, g, i, want, out); }
  if name == s.b_reloc() { return reloc_call(k, g, i, want, out); }
  return 0;
};

pub let member_on_val = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {

  let interp: u64 = ctf.interp_at(g, i + 1);
  let fname: u64 = if interp == 1 { ctf.interp_name(k, ax.n_at(g, i + 1)) } else { ax.n_sym(g, i + 1) };
  if interp == 1 {
    if st.st_ok(k) != 0 { return i + 2; }
  }
  let uw: u64 = unwrap_ref(k, out);
  let ignored_uw: u64 = uw;
  let sh: u64 = ty.tsh(ty.vty(out));
  let is_call_sfx: u64 = if interp == 0 and i + 2 < ax.n_count(g) and ax.is_group(g, i + 2) == 1 and ax.delim(ax.n_at(g, i + 2)) == ax.Delim.Paren as u64 { 1 } else { 0 };
  if sh == 0 {
    if is_call_sfx == 1 {
      let uf0: u64 = ufcs_on_val_bridge(k, g, i, fname, want, out);
      if st.st_ok(k) != 0 { return i + 3; }
      if uf0 != 0 { return core_tail(k, g, i + 3, minp, want, out); }
    }
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 2;
  }
  let kd: u64 = agg.shp_kind(sh);
  if kd == agg.ShapeKind.Slice as u64 or kd == agg.ShapeKind.MutSlice as u64 {
    let ut: Mut(ty.Ty) = t64(k);
    let lvv: Mut(ty.Val) = ax.new_val(k);
    if fname == s.t_len() {
      let l: u64 = agg.load_at(k, ty.vn(out), 8, ut, lvv);
    } else {
      if fname == s.t_ptr() {
        let is_m: u64 = if kd == agg.ShapeKind.MutSlice as u64 { 1 } else { 0 };
        let pty: Mut(ty.Ty) = ref_ty(k, ct.elem_tid(k, sh), is_m);
        let l2: u64 = agg.load_at(k, ty.vn(out), 0, pty, lvv);
      } else {
        st.st_fail(k, ax.FailKind.Unsup as u64);
        return i + 2;
      }
    }
    ty.val_at(out, lvv);
    return core_tail(k, g, i + 2, minp, want, out);
  }
  let m: Mut(agg.Member) = agg.mem_find(sh, fname);
  if is_null(m) {
    if is_call_sfx == 1 {
      let uf1: u64 = ufcs_on_val_bridge(k, g, i, fname, want, out);
      if st.st_ok(k) != 0 { return i + 3; }
      if uf1 != 0 { return core_tail(k, g, i + 3, minp, want, out); }
    }
    if interp == 1 {
      let nf: Ref(u8) = "no such field";
      let d: u64 = ir.diag(k, 0, 1, nf, 13);
      st.st_fail(k, ax.FailKind.Op as u64);
      return i + 2;
    }
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return i + 2;
  }
  let et: Mut(ty.Ty) = ax.new_ty(k);
  let e1: u64 = agg.mem_ty(k, m, et);
  let got: Mut(ty.Val) = ax.new_val(k);
  let l1: u64 = agg.load_at(k, ty.vn(out), agg.mem_off(m), et, got);
  ty.val_at(out, got);
  return core_tail(k, g, i + 2, minp, want, out);
};

pub let postfix_call = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let argsg: u64 = ax.n_at(g, i);
  let sh: u64 = ty.tsh(ty.vty(out));
  let sk: Mut(u8) = ct.sig_of_fn(k, sh);
  let np: u64 = cx.sig_np(sk);
  let ps: Mut(ty.Ty) = cx.sig_params(sk);
  let na: u64 = bi.arg_count(argsg);
  if na != np {
    let m: Ref(u8) = "fn-args";
    let d: u64 = ir.diag(k, np, 1, m, 7);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, np * 56 + 8));
  let j: u64 = if np == 0 { 0 } else { cl.call_args(k, argsg, 0, 0, np, ab, ps) };
  if st.st_ok(k) != 0 { return i + 1; }
  let fv: Mut(ty.Val) = ax.new_val(k);
  ty.val_at(fv, out);
  let rvv: Mut(ty.Val) = ax.new_val(k);
  let rc: u64 = bi.icall_emit(k, sk, fv, ab, want, rvv);
  ty.val_at(out, rvv);
  return core_tail(k, g, i + 1, minp, want, out);
};
