// genunify.lain —— ?{} 编译期形参解析、实参类型模式合一与单态化缓存。
// 单向依赖 state/ast/sym/agg/modules/tyreg/ctypes/ctfor/ctprim/ctfn。
let st = import("src::driver::state");
let ax = import("src::syntax::ast");
let s = import("src::driver::sym");
let agg = import("src::sema::agg");
let ireg = import("src::sema::tyreg");
let ct = import("src::comptime::ctypes");
let ctf = import("src::comptime::ctfor");
let ctp = import("src::comptime::ctprim");
let ctfn = import("src::comptime::ctfn");

pub let CtParamRec = struct {
  name: u64,
  ty_start: u64,
  ty_end: u64
};

let WFieldRec = struct {
  fname: u64,
  fkind: u64,
  fa: u64,
  fb: u64
};

let WitnessRec = struct {
  nf: u64
};

pub let MonoCacheRec = struct {
  tpl_e: u64,
  nct: u64,
  mangled_q: u64,
  concrete_sg: Mut(u8)
};

let MonoBlk = struct {
  pad0: u64,
  pad8: u64,
  pad16: u64,
  base: Mut(u8),
  n: u64
};

pub let ctparam_at = func(tbl: Mut(CtParamRec), idx: u64) -> Mut(CtParamRec) {
  return ptr_cast(Mut(CtParamRec), ptr_cast(Mut(u8), tbl) + idx * 24);
};

pub let val_at = func(vals: Mut(ctf.CtVal), idx: u64) -> Mut(ctf.CtVal) {
  return ptr_cast(Mut(ctf.CtVal), ptr_cast(Mut(u8), vals) + idx * 24);
};

pub let word_at = func(arr: Mut(u64), idx: u64) -> Mut(u64) {
  return ptr_cast(Mut(u64), ptr_cast(Mut(u8), arr) + idx * 8);
};

// 编译期形参项 24B：[name@0, ty_start@8, ty_end@16]；最多 8 项。
pub let ct_skip_ty = func(qg: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(qg);
  if i >= n { return i; }
  if ax.is_comma(qg, i) == 1 { return i; }
  return ct_skip_ty(qg, i + 1);
};

pub let parse_ctparams = func(k: Mut(st.State), qg: u64, i: u64, out: Mut(CtParamRec), idx: u64) -> u64 {
  let n: u64 = ax.n_count(qg);
  if i >= n { return idx; }
  if ax.is_comma(qg, i) == 1 { return parse_ctparams(k, qg, i + 1, out, idx); }
  if idx >= 8 { ctf.fail_msg(k, "too many comptime params", 24, ax.e_ast()); return idx; }
  if ax.is_name(qg, i) == 0 or ctf.has_tok(qg, i + 1, s.p_colon()) == 0 {
    ctf.fail_msg(k, "bad comptime param", 18, ax.e_ast());
    return idx;
  }
  let te: u64 = ct_skip_ty(qg, i + 2);
  let p: Mut(CtParamRec) = ctparam_at(out, idx);
  p.name = ax.n_sym(qg, i);
  p.ty_start = i + 2;
  p.ty_end = te;
  return parse_ctparams(k, qg, te, out, idx + 1);
};

pub let ct_find = func(ctp_tbl: Mut(CtParamRec), nct: u64, name: u64, i: u64) -> u64 {
  if i >= nct { return 999; }
  let p: Mut(CtParamRec) = ctparam_at(ctp_tbl, i);
  if p.name == name { return i; }
  return ct_find(ctp_tbl, nct, name, i + 1);
};

// --- 类型模式合一 ---------------------------------------------------------
let bind_or_check = func(k: Mut(st.State), idx: u64, kind: u64, val: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let bp: Mut(u64) = word_at(bound, idx);
  let slot: Mut(ctf.CtVal) = val_at(vals, idx);
  if deref(bp) == 1 {
    if slot.kind != kind or slot.a != val {
      ctf.fail_msg(k, "type inference conflict", 23, ax.e_type());
      return 0;
    }
    return 1;
  }
  slot.kind = kind;
  slot.a = val;
  slot.b = 0;
  deref(bp) = 1;
  return 1;
};

pub let ast_has_unbound = func(g: u64, i: u64, end: u64, ctp_tbl: Mut(CtParamRec), nct: u64, bound: Mut(u64)) -> u64 {
  if i >= end { return 0; }
  if ax.is_group(g, i) == 1 {
    let sub: u64 = ax.n_at(g, i);
    if ast_has_unbound(sub, 0, ax.n_count(sub), ctp_tbl, nct, bound) == 1 { return 1; }
  } else {
    if ax.is_name(g, i) == 1 {
      let idx: u64 = ct_find(ctp_tbl, nct, ax.n_sym(g, i), 0);
      if idx != 999 {
        if deref(word_at(bound, idx)) == 0 { return 1; }
      }
    }
  }
  return ast_has_unbound(g, i + 1, end, ctp_tbl, nct, bound);
};

let unify_wrap = func(k: Mut(st.State), pg: u64, i: u64, end: u64, want_sk: u64, arg_tid: u64, ctp_tbl: Mut(CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  let sh: u64 = ireg.ty_shape(k, arg_tid);
  if sh == 0 { return 0; }
  if agg.shp_kind(sh) != want_sk { return 0; }
  let elem: u64 = ct.elem_tid(k, sh);
  let grp: u64 = ax.n_at(pg, i + 1);
  return unify_type(k, grp, 0, ax.n_count(grp), elem, ctp_tbl, nct, vals, bound);
};

pub let unify_type = func(k: Mut(st.State), pg: u64, i: u64, end: u64, arg_tid: u64, ctp_tbl: Mut(CtParamRec), nct: u64, vals: Mut(ctf.CtVal), bound: Mut(u64)) -> u64 {
  if i >= end { return 1; }
  if ax.is_name(pg, i) == 1 and i + 1 == end {
    let nm: u64 = ax.n_sym(pg, i);
    let idx: u64 = ct_find(ctp_tbl, nct, nm, 0);
    if idx != 999 { return bind_or_check(k, idx, 1, arg_tid, vals, bound); }
    return 1;
  }
  if ax.is_name(pg, i) == 1 and ctf.has_delim(pg, i + 1, ax.dl_paren()) == 1 {
    let nm: u64 = ax.n_sym(pg, i);
    if nm == s.t_ref() { return unify_wrap(k, pg, i, end, agg.kind_ref(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_mut() { return unify_wrap(k, pg, i, end, agg.kind_mut(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_slice() { return unify_wrap(k, pg, i, end, agg.kind_slice(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_mutslice() { return unify_wrap(k, pg, i, end, agg.kind_mutslice(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_array() {
      let sh: u64 = ireg.ty_shape(k, arg_tid);
      if sh == 0 { return 0; }
      if agg.shp_kind(sh) != agg.kind_array() { return 0; }
      let grp: u64 = ax.n_at(pg, i + 1);
      let gn: u64 = ax.n_count(grp);
      if gn < 3 { return 0; }
      let cj: u64 = ctf.has_tok(grp, gn - 2, s.p_comma());
      let cidx: u64 = if cj == 1 { gn - 1 } else { gn };
      let elem: u64 = ct.elem_tid(k, sh);
      unify_type(k, grp, 0, gn - 2, elem, ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return 0; }
      if cidx < gn and ax.is_name(grp, cidx) == 1 {
        let ni: u64 = ct_find(ctp_tbl, nct, ax.n_sym(grp, cidx), 0);
        if ni != 999 { return bind_or_check(k, ni, 0, agg.shp_len(sh), vals, bound); }
      }
      return 1;
    }
  }
  return 1;
};

// --- 单态化缓存（存在 st_genblk +24/+32，每条 288 字节） --------------------
// [tpl_e@0, nct@8, mangled_q@16, concrete_sg@24, vals(8*24B)@32]
let wrec_eq = func(w1: Mut(WitnessRec), w2: Mut(WitnessRec)) -> u64 {
  if w1 as u64 == w2 as u64 { return 1; }
  let n1: u64 = w1.nf;
  let n2: u64 = w2.nf;
  if n1 != n2 { return 0; }
  let i: u64 = loop w(i: u64 = 0) while i < n1 {
    let f1: Mut(WFieldRec) = ptr_cast(Mut(WFieldRec), ptr_cast(Mut(u8), w1) + 8 + i * 32);
    let f2: Mut(WFieldRec) = ptr_cast(Mut(WFieldRec), ptr_cast(Mut(u8), w2) + 8 + i * 32);
    if f1.fname != f2.fname { return 0; }
    if f1.fkind != f2.fkind { return 0; }
    if f1.fa != f2.fa { return 0; }
    if f1.fkind == 7 {
      if wrec_eq(ptr_cast(Mut(WitnessRec), f1.fb), ptr_cast(Mut(WitnessRec), f2.fb)) == 0 { return 0; }
    }
    i = i + 1;
  };
  return 1;
};

let val_eq = func(v1: Mut(ctf.CtVal), v2: Mut(ctf.CtVal)) -> u64 {
  if v1.kind != v2.kind { return 0; }
  if v1.a != v2.a { return 0; }
  // 模块见证额外比对封签视图，同一模块的两种收窄视图不算同一实例。
  if v1.kind == 9 and v1.b != v2.b { return 0; }
  if v1.kind == 7 {
    return wrec_eq(ptr_cast(Mut(WitnessRec), v1.b), ptr_cast(Mut(WitnessRec), v2.b));
  }
  return 1;
};

let vals_eq = func(v1: Mut(ctf.CtVal), v2: Mut(ctf.CtVal), i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  if val_eq(val_at(v1, i), val_at(v2, i)) == 0 { return 0; }
  return vals_eq(v1, v2, i + 1, n);
};

pub let cache_find = func(k: Mut(st.State), tpl_e: u64, nct: u64, vals: Mut(ctf.CtVal)) -> Mut(MonoCacheRec) {
  let gb: Mut(MonoBlk) = ptr_cast(Mut(MonoBlk), st.st_genblk(k));
  let base: Mut(u8) = gb.base;
  if is_null(base) { return null_ref(Mut(MonoCacheRec)); }
  let n: u64 = gb.n;
  let i: u64 = loop sc(i: u64 = 0) while i < n {
    let raw: Mut(u8) = base + i * 288;
    let rec: Mut(MonoCacheRec) = ptr_cast(Mut(MonoCacheRec), raw);
    if rec.tpl_e == tpl_e and rec.nct == nct {
      if vals_eq(ptr_cast(Mut(ctf.CtVal), raw + 32), vals, 0, nct) == 1 { return rec; }
    }
    i = i + 1;
  };
  return null_ref(Mut(MonoCacheRec));
};

let cache_base = func(k: Mut(st.State)) -> Mut(u8) {
  let gb: Mut(MonoBlk) = ptr_cast(Mut(MonoBlk), st.st_genblk(k));
  if is_null(gb.base) == 0 { return gb.base; }
  let csz: u64 = 288 * 128;
  let nb: Mut(u8) = st.st_ralloc(k, csz);
  gb.base = nb;
  return nb;
};

pub let cache_put = func(k: Mut(st.State), tpl_e: u64, nct: u64, q: u64, sg: Mut(u8), vals: Mut(ctf.CtVal)) -> u64 {
  let gb: Mut(MonoBlk) = ptr_cast(Mut(MonoBlk), st.st_genblk(k));
  let base: Mut(u8) = cache_base(k);
  let n: u64 = gb.n;
  if n >= 128 { ctf.fail_msg(k, "mono cache full", 15, ax.e_ast()); return 0; }
  let raw: Mut(u8) = base + n * 288;
  let rec: Mut(MonoCacheRec) = ptr_cast(Mut(MonoCacheRec), raw);
  rec.tpl_e = tpl_e;
  rec.nct = nct;
  rec.mangled_q = q;
  rec.concrete_sg = sg;
  let rvals: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), raw + 32);
  let i: u64 = loop cp(i: u64 = 0) while i < nct {
    let dst: Mut(ctf.CtVal) = val_at(rvals, i);
    let src: Mut(ctf.CtVal) = val_at(vals, i);
    dst.kind = src.kind;
    dst.a = src.a;
    dst.b = src.b;
    i = i + 1;
  };
  gb.n = n + 1;
  return 1;
};
