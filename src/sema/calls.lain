let st = import("src::driver::state");
let ty = import("src::sema::types");
let ir = import("src::sema::ir_emit");
let ax = import("src::sema::ast");
let cx = import("src::sema::ctx");
let agg = import("src::sema::agg");
let modules = import("src::sema::modules");
let bi = import("src::sema::builtins");
let env = import("src::sema::env");
let ireg = import("src::sema::tyreg");
let tb = import("src::sema::tbuild");
let ctf = import("src::comptime::ctfor");
let drop = import("src::sema::drop");

extern core_expr(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 = lainc_core_expr;

let val_idx = func(ab: Mut(ty.Val), idx: u64) -> Mut(ty.Val) {
  return ptr_cast(Mut(ty.Val), ptr_cast(Mut(u8), ab) + idx * 56);
};

pub let call_expr = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let callee: u64 = ax.n_sym(g, i);
  let argsg: u64 = ax.n_at(g, i + 1);
  let e: Mut(modules.SymEntry) = ctf.find_sym(k, callee);
  if is_null(e) { ty.val_none(out); fail_name(k, callee, ax.FailKind.Unbound as u64); return i + 2; }
  let kd: u64 = modules.sym_kind(e);
  if kd != modules.sym_kind_func() and kd != modules.sym_kind_extern() {
    ty.val_none(out);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 2;
  }
  let variadic: u64 = if kd == modules.sym_kind_extern() {
    if modules.sym_flag(e) == 1 { 1 } else { 0 }
  } else {
    0
  };
  let j: u64 = if variadic == 1 {
    call_sig_var(k, modules.sym_qual(e), modules.sym_sig(e), argsg, want, out)
  } else {
    call_sig(k, modules.sym_qual(e), modules.sym_sig(e), argsg, want, out)
  };

  let ignored: u64 = j;
  return i + 2;
};

pub let fail_name = func(k: Mut(st.State), sym: u64, code: u64) -> u64 {
  let p: Ref(u8) = modules.sym_addr(sym);
  let n: u64 = modules.sym_len(sym);
  let rc: u64 = ir.diag(k, code, 1, p, n);
  return st.st_fail(k, code);
};

pub let emit_prepared = func(k: Mut(st.State), q: u64, ret: Mut(ty.Ty), np: u64, ab: Mut(ty.Val), want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let rest: Mut(ty.Ty) = ax.new_ty(k);
  ty.ty_at(rest, ret);

  if agg.sret_ty(rest) == 1 {
    let dv: Mut(ty.Val) = ax.new_val(k);
    let ao: u64 = agg.new_obj(k, ty.tsh(rest), dv);
    ir.args_reset(k);
    let p0: u64 = cx.push_val(k, dv);
    let f0: u64 = fill_args(k, ab, 0, np);
    let e0: u64 = ir.emit_call(k, 0, q, 0);
    ty.val_at(out, dv);
    return 1;
  }
  ir.args_reset(k);
  let dummy: u64 = fill_args(k, ab, 0, np);
  let res: u64 = if ty.ty_known(rest) == 1 { ir.fresh_t(k) } else { 0 };
  ir.emit_call(k, res, q, 0);
  if res == 0 {
    ty.val_none(out);
  } else {
    ty.val_ref(out, res, rest);
  }
  return 1;
};

pub let call_sig = func(k: Mut(st.State), q: u64, sg: Mut(u8), argsg: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {

  if tb.sig_types(sg) == 1 {
    let m: Ref(u8) = "type is compile-time only";
    let d: u64 = ir.diag(k, 0, 1, m, 25);
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return 0;
  }
  let np: u64 = cx.sig_np(sg);
  let ret: Mut(ty.Ty) = cx.sig_ret(sg);
  let ps: Mut(ty.Ty) = cx.sig_params(sg);
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, np * 56 + 8));

  let zw: u64 = zero_vals(k, ab, 0, np);
  let j: u64 = call_args(k, argsg, 0, 0, np, ab, ps);

  let hole: u64 = scan_holes(k, ab, 0, np);
  if hole != np {
    let p: Ref(u8) = modules.sym_addr(q);
    let n: u64 = modules.sym_len(q);
    let d: u64 = ir.diag(k, hole, 1, p, n);
    st.st_fail(k, ax.FailKind.Type as u64);
    return j;
  }
  let ep: u64 = emit_prepared(k, q, ret, np, ab, want, out);
  return j;
};

let max_operands = func() -> u64 { return 16; };

pub let call_sig_var = func(k: Mut(st.State), q: u64, sg: Mut(u8), argsg: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  if tb.sig_types(sg) == 1 {
    let m: Ref(u8) = "type is compile-time only";
    let d: u64 = ir.diag(k, 0, 1, m, 25);
    st.st_fail(k, ax.FailKind.Unsup as u64);
    return 0;
  }
  let np: u64 = cx.sig_np(sg);
  let ret: Mut(ty.Ty) = cx.sig_ret(sg);
  let ps: Mut(ty.Ty) = cx.sig_params(sg);
  let na: u64 = positional_count(argsg, 0, 0);
  let total_args: u64 = if na > np { na } else { np };
  if total_args > max_operands() {
    let m: Ref(u8) = "too many call args";
    let d: u64 = ir.diag(k, total_args, 1, m, 18);
    ty.val_none(out);
    st.st_fail(k, ax.FailKind.Type as u64);
    return argsg;
  }
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, total_args * 56 + 8));
  let zw: u64 = zero_vals(k, ab, 0, total_args);
  let j: u64 = call_args(k, argsg, 0, 0, np, ab, ps);

  let hole: u64 = scan_holes(k, ab, 0, np);
  if hole != np {
    let p: Ref(u8) = modules.sym_addr(q);
    let n: u64 = modules.sym_len(q);
    let d: u64 = ir.diag(k, hole, 1, p, n);
    st.st_fail(k, ax.FailKind.Type as u64);
    return j;
  }
  let next: u64 = if np == 0 { 0 } else { skip_comma(argsg, j) };
  let j2: u64 = if na > np { var_args(k, argsg, next, np, total_args, ab) } else { next };
  let ep: u64 = emit_prepared(k, q, ret, total_args, ab, want, out);
  return j2;
};

let positional_count = func(g: u64, i: u64, acc: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return acc; }
  if ax.is_comma(g, i) == 1 { return positional_count(g, i + 1, acc); }
  return positional_count(g, i + 1, acc + 1);
};

let skip_comma = func(g: u64, j: u64) -> u64 {
  if ax.is_comma(g, j) == 1 { return j + 1; }
  return j;
};

let var_args = func(k: Mut(st.State), g: u64, i: u64, idx: u64, arity: u64, ab: Mut(ty.Val)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if idx >= arity { return i; }
  let pt: Mut(ty.Ty) = cx.tnone(k);
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, g, i, 0, pt, v);
  let c: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), pt, c);
  ty.val_at(val_idx(ab, idx), c);
  if ax.is_comma(g, j) == 1 { return var_args(k, g, j + 1, idx + 1, arity, ab); }
  return j;
};

let zero_vals = func(k: Mut(st.State), ab: Mut(ty.Val), idx: u64, arity: u64) -> u64 {
  if idx >= arity { return idx; }
  let v: Mut(ty.Val) = val_idx(ab, idx);
  let nn: u64 = ty.val_none(v);
  return zero_vals(k, ab, idx + 1, arity);
};

let scan_holes = func(k: Mut(st.State), ab: Mut(ty.Val), idx: u64, arity: u64) -> u64 {
  if idx >= arity { return idx; }
  let v: Mut(ty.Val) = val_idx(ab, idx);
  if ty.vlit(v) == 0 {
    if ty.vn(v) == 0 { return idx; }
  }
  return scan_holes(k, ab, idx + 1, arity);
};

let fill_args = func(k: Mut(st.State), ab: Mut(ty.Val), idx: u64, arity: u64) -> u64 {
  if idx >= arity { return idx; }
  let v: Mut(ty.Val) = val_idx(ab, idx);

  if ty.vlit(v) == 0 {
    if ty.vn(v) == 0 {
      let m: Ref(u8) = "empty-arg";
      let d: u64 = ir.diag(k, idx, 1, m, 9);
      st.st_fail(k, ax.FailKind.Type as u64);
      return idx;
    }
  }
  cx.push_val(k, v);
  return fill_args(k, ab, idx + 1, arity);
};

pub let call_args = func(k: Mut(st.State), g: u64, i: u64, idx: u64, arity: u64, ab: Mut(ty.Val), paramp: Mut(ty.Ty)) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if idx >= arity { return i; }
  let ca: u64 = drop.bare_local(k, g, i);
  if ca != 0 and env.env_is_noncopy(k, ca) == 1 {
    let m: Ref(u8) = "implicit copy of !Copy";
    let d: u64 = ir.diag(k, 0, 1, m, 22);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i;
  }
  let pt: Mut(ty.Ty) = cx.ty_idx(paramp, idx);
  let v: Mut(ty.Val) = ax.new_val(k);
  let j: u64 = core_expr(k, g, i, 0, pt, v);
  let c: Mut(ty.Val) = ax.new_val(k);
  cx.coerce(k, v, ty.vty(v), pt, c);
  ty.val_at(val_idx(ab, idx), c);
  if ax.is_comma(g, j) == 1 { return call_args(k, g, j + 1, idx + 1, arity, ab, paramp); }
  return j;
};

pub let var_ref = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let sym: u64 = ax.n_sym(g, i);
  let off: u64 = env.env_find(k, sym);
  if off != 0 {
    if env.env_alive(k, off) == 0 {
      let m: Ref(u8) = "use after reloc";
      let d: u64 = ir.diag(k, 0, 1, m, 15);
      st.st_fail(k, ax.FailKind.Type as u64);
      ty.val_none(out);
      return i + 1;
    }
    let t: Mut(ty.Ty) = ax.new_ty(k);
    env.env_ty(k, off, t);
    cx.slot_get(k, env.env_slot(k, off), t, out);
    return i + 1;
  }
  let se: Mut(modules.SymEntry) = ctf.find_sym(k, sym);
  if is_null(se) == 0 {
    let sk: u64 = modules.sym_kind(se);
    if sk == modules.sym_kind_type_alias() {
      let m: Ref(u8) = "type is compile-time only";
      let d: u64 = ir.diag(k, 0, 1, m, 25);
      st.st_fail(k, ax.FailKind.Unsup as u64);
      return i + 1;
    }
    if sk == modules.sym_kind_func() or sk == modules.sym_kind_extern() {
      let fid: u64 = modules.sym_fnid(se);
      if fid != 0 {
        let ft: Mut(ty.Ty) = ax.new_ty(k);
        let pj: u64 = ireg.project(k, fid, ft);
        let v: Mut(ty.Val) = ax.new_val(k);
        let r: u64 = ty.val_ref(v, modules.sym_qual(se), ft);
        let c: Mut(ty.Val) = ax.new_val(k);
        cx.coerce(k, v, ft, want, c);
        ty.val_at(out, c);
        return i + 1;
      }
    }
    if sk == modules.sym_kind_data() or sk == modules.sym_kind_value() {
      let vt: Mut(u8) = modules.sym_sig(se);
      let res: u64 = ir.fresh_t(k);
      let rc: u64 = ir.args_reset(k);
      let ins: u64 = ir.emit_call(k, res, modules.sym_qual(se), 0);
      let t2: Mut(ty.Ty) = ax.new_ty(k);
      if is_null(vt) == 0 { let cp: u64 = ty.ty_at(t2, ptr_cast(Mut(ty.Ty), vt)); } else { let nn: u64 = ty.ty_none(t2); }
      ty.val_ref(out, res, t2);
      return i + 1;
    }
  }
  let cv: Mut(ctf.CtVal) = ctf.lookup(k, sym);
  if is_null(cv) == 0 {
    if ctf.v_kind(cv) == 0 {
      let t: Mut(ty.Ty) = cx.t64(k);
      ty.val_lit(out, ctf.v_a(cv), t);
      return i + 1;
    }
    let m: Ref(u8) = "compile-time value used at runtime";
    let d: u64 = ir.diag(k, 0, 1, m, 34);
    ty.val_none(out);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 1;
  }
  fail_name(k, sym, ax.FailKind.Unbound as u64);
  return i + 1;
};

pub let icall_call = func(k: Mut(st.State), g: u64, i: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 {
  let sg: u64 = ax.n_at(g, i + 1);
  let argsg: u64 = ax.n_at(g, i + 2);
  let sk: Mut(u8) = cx.icall_sig(k, sg);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 3; }
  let np: u64 = cx.sig_np(sk);
  let ps: Mut(ty.Ty) = cx.sig_params(sk);
  let need: u64 = if np == 0 { 1 } else { np + 1 };
  let na: u64 = bi.arg_count(argsg);
  if na != need {
    let m: Ref(u8) = "icall-args";
    let dg: u64 = ir.diag(k, need, 1, m, 10);
    ty.val_none(out);
    st.st_fail(k, ax.FailKind.Type as u64);
    return i + 3;
  }
  let fv: Mut(ty.Val) = ax.new_val(k);
  let j0: u64 = core_expr(k, argsg, 0, 0, cx.tnone(k), fv);
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 3; }
  let ab: Mut(ty.Val) = ptr_cast(Mut(ty.Val), st.st_alloc(k, np * 56 + 8));
  let st0: u64 = if ax.is_comma(argsg, j0) == 1 { j0 + 1 } else { j0 };
  let j1: u64 = if np == 0 { st0 } else { call_args(k, argsg, st0, 0, np, ab, ps) };
  if st.st_ok(k) != 0 { ty.val_none(out); return i + 3; }
  let rc: u64 = bi.icall_emit(k, sk, fv, ab, want, out);
  return i + 3;
};
