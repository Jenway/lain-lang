// Pure-Lain evaluator for the structured L1 model.
//
// Platform procedures are ordinary external calls.  The evaluator receives an
// explicit ExternalCalls module chosen by its caller; it contains no built-in
// C, filesystem, allocator or Meta special cases.

let memory_model: Module = import("std::memory_model");
let vector: Module = import("std::core::vec");
let effects: Module = import("std::effect");
let l1_ir: Module = import("packages::lain::lainir::api::l1_ir");

@export
let lainvm: Module = std::module {

    @export
    let ExternalCallShape: ModuleShape = std::module_shape {
        let Response: type;
        let call: std::func(
            name: addr,
            arguments: addr,
            argument_count: usize,
        ) -> Response;
        let response_status = std::func(response: &Response) -> i32;
        let response_bits = std::func(response: &Response) -> u64;
    };

    @export
    let Interpreter = std::func(
        Memory: memory_model.Shape,
        ExternalCalls: ExternalCallShape,
        L1: Module,
    ) -> Module {
        let Value: type = std::struct {
            type_id: L1.TypeId,
            i32_value: i32,
            bits_value: u64,
        };

        let ValueVector: type = vector.Vec(
            Value,
            Memory.Allocation,
            Memory.Bounds,
        );

        // Flow is interpreter-private control state.  It is intentionally not
        // part of the LAINVM API: callers receive a physical Value or the
        // standard Trap effect.
        let Flow: type = std::struct {
            status: i32,
            value: Value,
            trap_kind: i32,
            trap_procedure: usize,
            trap_position: usize,
        };

        let Address: type = std::struct {
            owner: usize,
            generation: usize,
            kind: i32,
            activation: usize,
            object: usize,
            offset: usize,
            length: usize,
            active: bool,
        };
        let AddressVector: type = vector.Vec(
            Address, Memory.Allocation, Memory.Bounds,
        );

        let Activation: type = std::struct {
            id: usize,
            parent: usize,
            storage_start: usize,
            storage_length: usize,
            active: bool,
        };
        let ActivationVector: type = vector.Vec(
            Activation, Memory.Allocation, Memory.Bounds,
        );

        let Trap: type = std::struct {
            // 1 execution, 2 quota, 3 capability, 4 memory/lifetime.
            kind: i32,
            status: i32,
            procedure: usize,
            position: usize,
            active: bool,
        };

        let Capability: type = std::struct {
            owner: usize,
            active: bool,
            external: bool,
        };
        let CapabilityVector: type = vector.Vec(
            Capability,
            Memory.Allocation,
            Memory.Bounds,
        );

        let CallFrame: type = std::struct {
            procedure: usize,
            region: usize,
            position: usize,
            activation: usize,
            arguments: ValueVector,
            return_procedure: usize,
            return_region: usize,
            return_position: usize,
        };
        let CallFrameVector: type = vector.Vec(
            CallFrame,
            Memory.Allocation,
            Memory.Bounds,
        );

        let VSpace: type = std::struct {
            owner: usize,
            generation: usize,
            released: bool,
            storage: Memory.Bytes,
            addresses: AddressVector,
            activations: ActivationVector,
            allocation_bytes: usize,
            allocation_limit: usize,
        };

        let TCB: type = std::struct {
            // 0 READY, 1 RUNNING, 2 BLOCKED, 3 DEAD.
            status: i32,
            steps: usize,
            step_limit: usize,
            depth_limit: usize,
            current_activation: usize,
            next_activation: usize,
            procedure: usize,
            region: usize,
            position: usize,
            suspend_reason: i32,
            slice_limit: usize,
            slice_steps: usize,
            yielded: bool,
            resume_pending: bool,
            frames: CallFrameVector,
            trap: Trap,
        };

        let LainVm: type = std::struct {
            vspace: VSpace,
            tcb: TCB,
            cspace: CapabilityVector,
        };

        let append_address = std::func(
            state: &mut LainVm,
            address: Address,
        ) -> unit ! {Memory.Allocation.Effect} {
            state.vspace.addresses.push(address);
        };

        let address_value = std::func(
            state: &mut LainVm,
            type_id: L1.TypeId,
            address: Address,
        ) -> Flow ! {Memory.Allocation.Effect} {
            if state.vspace.addresses.length() >= 0 {
                append_address(state, address);
            }
            let value: Value = Value {
                type_id: type_id,
                i32_value: state.vspace.addresses.length() as i32,
                bits_value: state.vspace.addresses.length() as u64,
            };
            let result: Flow = success(value);
            return result;
        };

        let address_at = std::func(
            unit: &L1.Unit,
            state: &LainVm,
            value: Value,
        ) -> usize {
            // Scalar values use the same integer fields as the compact
            // address handle.  Inspect the physical type before treating
            // the payload as an address; otherwise returning literal 42
            // could be mistaken for an alloca handle and reported as an
            // activation escape.
            if value.type_id >= unit.types.length() { return std::usize_max(); }
            if unit.types.get(value.type_id).kind != 2 {
                return std::usize_max();
            }
            if value.i32_value <= 0 { return std::usize_max(); }
            let index: usize = (value.i32_value - 1) as usize;
            if index >= state.vspace.addresses.length() { return std::usize_max(); }
            let address: &Address = state.vspace.addresses.get(index);
            if state.vspace.released || address.owner != state.vspace.owner
                || address.generation != state.vspace.generation {
                return std::usize_max();
            }
            if address.kind == 1 && !address.active {
                return std::usize_max();
            }
            if address.kind == 1 {
                if address.activation >= state.vspace.activations.length() {
                    return std::usize_max();
                }
                if !state.vspace.activations.get(address.activation).active {
                    return std::usize_max();
                }
            }
            return index;
        };

        let consume_step = std::func(state: &mut LainVm) -> bool {
            if state.tcb.status != 1 { return false; }
            if state.tcb.step_limit != 0 && state.tcb.steps >= state.tcb.step_limit {
                return false;
            }
            if state.tcb.slice_limit != 0
                && state.tcb.slice_steps >= state.tcb.slice_limit {
                state.tcb.yielded = true;
                return false;
            }
            state.tcb.steps = state.tcb.steps + 1;
            if state.tcb.slice_limit != 0 {
                state.tcb.slice_steps = state.tcb.slice_steps + 1;
            }
            return true;
        };

        let consume_expression_step = std::func(state: &mut LainVm) -> bool {
            if state.tcb.status != 1 { return false; }
            if state.tcb.step_limit != 0 && state.tcb.steps >= state.tcb.step_limit {
                return false;
            }
            state.tcb.steps = state.tcb.steps + 1;
            return true;
        };

        let fail = std::func(code: i32) -> Flow {
            return Flow {
                status: code,
                value: Value { type_id: 0, i32_value: 0, bits_value: 0 },
                trap_kind: 0,
                trap_procedure: 0,
                trap_position: 0,
            };
        };

        let success = std::func(value: Value) -> Flow {
            return Flow {
                status: 0, value: value,
                trap_kind: 0, trap_procedure: 0, trap_position: 0,
            };
        };

        let power_of_two = std::func(width: usize) -> u64 {
            let value: u64 = 1;
            let index: usize = 0;
            while index < width {
                value = value * 2;
                index = index + 1;
            }
            return value;
        };

        let bit_mask = std::func(width: usize) -> u64 {
            if width >= 64 { return std::usize_max() as u64; }
            return power_of_two(width) - 1;
        };

        let signed_bits = std::func(bits: u64, width: usize) -> i64 {
            if width >= 64 { return bits as i64; }
            let mask: u64 = bit_mask(width);
            let sign: u64 = power_of_two(width - 1);
            let normalized: u64 = bits & mask;
            if (normalized & sign) != 0 {
                return (normalized as i64)
                    - (power_of_two(width) as i64);
            }
            return normalized as i64;
        };

        let scalar = std::func(type_id: L1.TypeId, bits: u64) -> Value {
            return Value {
                type_id: type_id,
                i32_value: bits as i32,
                bits_value: bits,
            };
        };

        // Internal structured-control results.  They never cross the public
        // execute boundary.
        let fallthrough = std::func() -> Flow { return fail(7997); };
        let break_flow = std::func() -> Flow { return fail(7998); };
        let continue_flow = std::func() -> Flow { return fail(7999); };
        let yield_flow = std::func() -> Flow { return fail(7996); };

        let trap_kind = std::func(code: i32) -> i32 {
            if code == 7108 || code == 7109 || code == 7115 {
                return 2;
            }
            if code == 7102 { return 3; }
            if code == 7116 || code == 7117 || code == 7119
                || code == 7120 {
                return 4;
            }
            return 1;
        };

        let release_vspace = std::func(
            state: &mut LainVm,
        ) -> unit ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            // Logical release closes every handle before reclaiming the
            // provider-owned backing arena. This function is used only for a
            // top-level interpreter invocation that created its own VSpace.
            let address_index: usize = 0;
            while address_index < state.vspace.addresses.length() {
                let address: &mut Address =
                    state.vspace.addresses.get_mut(address_index);
                address.active = false;
                address_index = address_index + 1;
            }
            let activation_index: usize = 0;
            while activation_index < state.vspace.activations.length() {
                let frame: &mut Activation =
                    state.vspace.activations.get_mut(activation_index);
                frame.active = false;
                activation_index = activation_index + 1;
            }
            state.vspace.released = true;
            state.vspace.generation = state.vspace.generation + 1;
            state.vspace.storage.release();
            state.vspace.storage = Memory.Bytes.new();
            state.vspace.addresses.release();
            state.vspace.activations.release();
            state.vspace.allocation_bytes = 0;
        };

        let start_tcb = std::func(state: &mut LainVm) -> bool {
            if state.tcb.status != 0 { return false; }
            state.tcb.status = 1;
            return true;
        };

        let suspend_tcb_reason = std::func(
            state: &mut LainVm,
            reason: i32,
        ) -> bool {
            if state.tcb.status != 1 { return false; }
            state.tcb.suspend_reason = reason;
            state.tcb.status = 2;
            return true;
        };

        let suspend_tcb = std::func(state: &mut LainVm) -> bool {
            return suspend_tcb_reason(state, 0);
        };

        let resume_tcb = std::func(state: &mut LainVm) -> bool {
            if state.tcb.status != 2 { return false; }
            state.tcb.suspend_reason = 0;
            state.tcb.status = 1;
            return true;
        };

        // External calls cross the VM gate only through an active capability
        // object owned by the current VM context.
        let external_capability_allowed = std::func(
            state: &LainVm,
        ) -> bool {
            if state.tcb.status != 1 { return false; }
            let index: usize = 0;
            while index < state.cspace.length() {
                let capability: &Capability = state.cspace.get(index);
                if capability.active
                    && capability.owner != 0
                    && capability.external {
                    return true;
                }
                index = index + 1;
            }
            return false;
        };

        let capability_transfer = std::func(
            state: &mut LainVm,
            index: usize,
            owner: usize,
            target: usize,
        ) -> bool ! {
            Memory.Bounds.Effect,
        } {
            if index >= state.cspace.length() || target == owner {
                return false;
            }
            let capability: &mut Capability = state.cspace.get_mut(index);
            if !capability.active || capability.owner != owner {
                return false;
            }
            capability.owner = target;
            return true;
        };

        let capability_revoke = std::func(
            state: &mut LainVm,
            index: usize,
            owner: usize,
        ) -> bool ! {
            Memory.Bounds.Effect,
        } {
            if index >= state.cspace.length() { return false; }
            let capability: &mut Capability = state.cspace.get_mut(index);
            if !capability.active || capability.owner != owner {
                return false;
            }
            capability.active = false;
            return true;
        };

        let finish_vm = std::func(
            state: &mut LainVm,
            procedure_id: L1.ProcedureId,
            result: Flow,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if result.status != 0 {
                state.tcb.trap = Trap {
                    kind: trap_kind(result.status),
                    status: result.status,
                    procedure: procedure_id,
                    position: state.tcb.position,
                    active: true,
                };
            }
            release_vspace(state);
            state.tcb.status = 3;
            if result.status != 0 {
                return Flow {
                    status: result.status,
                    value: result.value,
                    trap_kind: state.tcb.trap.kind,
                    trap_procedure: state.tcb.trap.procedure,
                    trap_position: state.tcb.trap.position,
                };
            }
            return result;
        };

        let evaluate_expression = std::func(
            unit: &L1.Unit,
            expression_id: L1.ExprId,
            arguments: &ValueVector,
            depth: usize,
            state: &mut LainVm,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if !consume_expression_step(state) {
                if state.tcb.yielded { return yield_flow(); }
                return fail(7109);
            }
            if state.tcb.depth_limit != 0 && depth >= state.tcb.depth_limit {
                return fail(7108);
            }

            // Keep malformed units in the language-level error channel.  A
            // Meta caller may construct a unit incrementally, so an invalid
            // expression handle must not turn into a host bounds trap.
            if expression_id >= unit.expressions.length() {
                return fail(7104);
            }

            let expression: &L1.Expr =
                unit.expressions.get(expression_id);

            if expression.kind == 1 {
                return success(scalar(
                    expression.result_type, expression.wide_value,
                ));
            }

            if expression.kind == 2 {
                if expression.index >= arguments.length() {
                    return fail(7105);
                }
                return success(*arguments.get(expression.index));
            }

            // Procedure addresses are callable capabilities, distinct from
            // activation and readonly-data addresses.  They can be consumed
            // by #call_indirect, but cannot be loaded from or stored to.
            if expression.kind == 40 {
                if expression.procedure >= unit.procedures.length() {
                    return fail(7101);
                }
                return address_value(state, expression.result_type, Address {
                    owner: state.vspace.owner,
                    generation: state.vspace.generation,
                    kind: 3, activation: 0, object: expression.procedure,
                    offset: 0, length: 0, active: true,
                });
            }

            if expression.kind == 41 {
                if expression.index >= unit.data.length() { return fail(7113); }
                let item: &L1.Data = unit.data.get(expression.index);
                return address_value(state, expression.result_type, Address {
                    owner: state.vspace.owner,
                    generation: state.vspace.generation,
                    kind: 2, activation: 0, object: expression.index,
                    offset: 0, length: item.size, active: true,
                });
            }

            if expression.kind == 42 {
                if expression.size == 0 { return fail(7114); }
                if state.vspace.allocation_limit != 0
                    && state.vspace.allocation_bytes + expression.size
                        > state.vspace.allocation_limit { return fail(7115); }
                let start: usize = state.vspace.storage.length();
                let byte_index: usize = 0;
                while byte_index < expression.size {
                    state.vspace.storage.push(0);
                    byte_index = byte_index + 1;
                }
                state.vspace.allocation_bytes =
                    state.vspace.allocation_bytes + expression.size;
                return address_value(state, expression.result_type, Address {
                    owner: state.vspace.owner,
                    generation: state.vspace.generation,
                    kind: 1, activation: state.tcb.current_activation,
                    object: 0, offset: start, length: expression.size,
                    active: true,
                });
            }

            if expression.kind == 43 {
                let base_result: Flow = evaluate_expression(
                    unit, expression.left, arguments, depth + 1, state,
                );
                if base_result.status != 0 { return base_result; }
                let index_result: Flow = evaluate_expression(
                    unit, expression.right, arguments, depth + 1, state,
                );
                if index_result.status != 0 { return index_result; }
                let address_index: usize = address_at(unit, state, base_result.value);
                if address_index == std::usize_max() { return fail(7116); }
                let base: &Address = state.vspace.addresses.get(address_index);
                let displacement: i64 =
                    (index_result.value.i32_value as i64)
                    * (expression.scale as i64) + expression.offset;
                if displacement < 0 { return fail(7117); }
                let next_offset: usize = base.offset + displacement as usize;
                if next_offset < base.offset || next_offset > base.offset + base.length {
                    return fail(7117);
                }
                return address_value(state, expression.result_type, Address {
                    owner: base.owner,
                    generation: base.generation,
                    kind: base.kind, activation: base.activation,
                    object: base.object, offset: next_offset,
                    length: base.length - displacement as usize,
                    active: base.active,
                });
            }

            if expression.kind == 44 {
                let address_result: Flow = evaluate_expression(
                    unit, expression.left, arguments, depth + 1, state,
                );
                if address_result.status != 0 { return address_result; }
                let address_index: usize = address_at(unit, state, address_result.value);
                if address_index == std::usize_max() { return fail(7116); }
                let address: &Address = state.vspace.addresses.get(address_index);
                let value_type: &L1.Type = unit.types.get(expression.result_type);
                if value_type.kind != 1 || value_type.bit_width == 0
                    || value_type.bit_width > 64
                    || value_type.bit_width % 8 != 0 { return fail(7118); }
                let count: usize = value_type.bit_width / 8;
                if count > address.length { return fail(7117); }
                let bits: u64 = 0;
                let byte_index: usize = 0;
                while byte_index < count {
                    let byte: i32 = 0;
                    if address.kind == 1 {
                        byte = *state.vspace.storage.get(address.offset + byte_index);
                    } else if address.kind == 2 {
                        let data: &L1.Data = unit.data.get(address.object);
                        let data_offset: usize = address.offset + byte_index;
                        if data_offset < data.initializer.length() {
                            byte = *data.initializer.get(data_offset);
                        }
                    } else { return fail(7116); }
                    bits = bits
                        + (byte as u64) * power_of_two(byte_index * 8);
                    byte_index = byte_index + 1;
                }
                return success(scalar(expression.result_type, bits));
            }

            if expression.kind >= 3 {
                if expression.kind <= 17 {
                    let left: Flow = evaluate_expression(
                        unit,
                        expression.left,
                        arguments,
                        depth + 1,
                        state,
                    );
                    if left.status != 0 { return left; }

                    let right: Flow = evaluate_expression(
                        unit,
                        expression.right,
                        arguments,
                        depth + 1,
                        state,
                    );
                    if right.status != 0 { return right; }

                    let operand_type: &L1.Type =
                        unit.types.get(left.value.type_id);
                    let width: usize = operand_type.bit_width;
                    let value: u64 = 0;
                    if expression.kind == 3 {
                        value = (left.value.bits_value
                            + right.value.bits_value) & bit_mask(width);
                    } else if expression.kind == 4 {
                        value = (left.value.bits_value
                            - right.value.bits_value) & bit_mask(width);
                    } else if expression.kind == 5 {
                        value = (left.value.bits_value
                            * right.value.bits_value) & bit_mask(width);
                    } else if expression.kind == 12 {
                        if right.value.bits_value == 0 { return fail(7110); }
                        value = ((signed_bits(left.value.bits_value, width)
                            / signed_bits(right.value.bits_value, width)) as u64)
                            & bit_mask(width);
                    } else if expression.kind == 13 {
                        if right.value.bits_value == 0 { return fail(7110); }
                        value = (left.value.bits_value & bit_mask(width))
                            / (right.value.bits_value & bit_mask(width));
                    } else if expression.kind == 6 {
                        value = left.value.bits_value == right.value.bits_value;
                    } else if expression.kind == 7 {
                        value = left.value.bits_value != right.value.bits_value;
                    } else if expression.kind == 8 {
                        value = signed_bits(left.value.bits_value, width)
                            < signed_bits(right.value.bits_value, width);
                    } else if expression.kind == 9 {
                        value = signed_bits(left.value.bits_value, width)
                            <= signed_bits(right.value.bits_value, width);
                    } else if expression.kind == 10 {
                        value = signed_bits(left.value.bits_value, width)
                            > signed_bits(right.value.bits_value, width);
                    } else if expression.kind == 11 {
                        value = signed_bits(left.value.bits_value, width)
                            >= signed_bits(right.value.bits_value, width);
                    } else if expression.kind == 14 {
                        value = left.value.bits_value < right.value.bits_value;
                    } else if expression.kind == 15 {
                        value = left.value.bits_value <= right.value.bits_value;
                    } else if expression.kind == 16 {
                        value = left.value.bits_value > right.value.bits_value;
                    } else if expression.kind == 17 {
                        value = left.value.bits_value >= right.value.bits_value;
                    }
                    return success(scalar(expression.result_type, value));
                }
            }

            if expression.kind >= 30 && expression.kind <= 33 {
                let input: Flow = evaluate_expression(
                    unit, expression.left, arguments, depth + 1, state,
                );
                if input.status != 0 { return input; }
                let source_type: &L1.Type = unit.types.get(input.value.type_id);
                let result_type: &L1.Type = unit.types.get(expression.result_type);
                let bits: u64 = input.value.bits_value;
                if expression.kind == 30 {
                    bits = bits & bit_mask(source_type.bit_width);
                } else if expression.kind == 31 {
                    bits = signed_bits(bits, source_type.bit_width) as u64;
                } else if expression.kind == 32 {
                    bits = bits & bit_mask(result_type.bit_width);
                }
                return success(scalar(expression.result_type, bits));
            }

            // Procedure lookup and nested calls are deliberately expressed in
            // Lain data.  External calls go through the supplied module and
            // never through hidden host dispatch.
            if expression.kind == 20 {
                if expression.procedure >= unit.procedures.length() {
                    return fail(7101);
                }

                let call_arguments: ValueVector =
                    ValueVector.new();
                let argument_index: usize = 0;
                while argument_index
                    < expression.arguments.length() {
                    let argument: Flow = evaluate_expression(
                        unit,
                        *expression.arguments.get(argument_index),
                        arguments,
                        depth + 1,
                        state,
                    );
                    if argument.status != 0 { return argument; }
                    call_arguments.push(argument.value);
                    argument_index = argument_index + 1;
                }
                return execute_procedure(
                    unit,
                    expression.procedure,
                    &call_arguments,
                    depth + 1,
                    state,
                );
            }

            if expression.kind == 21 {
                let target: Flow = evaluate_expression(
                    unit, expression.left, arguments, depth + 1, state,
                );
                if target.status != 0 { return target; }
                    let address_index: usize = address_at(unit, state, target.value);
                if address_index == std::usize_max() { return fail(7116); }
                let address: &Address = state.vspace.addresses.get(address_index);
                if address.kind != 3 { return fail(7121); }

                let call_arguments: ValueVector = ValueVector.new();
                let argument_index: usize = 0;
                while argument_index < expression.arguments.length() {
                    let argument: Flow = evaluate_expression(
                        unit,
                        *expression.arguments.get(argument_index),
                        arguments,
                        depth + 1,
                        state,
                    );
                    if argument.status != 0 { return argument; }
                    call_arguments.push(argument.value);
                    argument_index = argument_index + 1;
                }
                return execute_procedure(
                    unit, address.object, &call_arguments, depth + 1, state,
                );
            }

            return fail(7104);
        };

        let execute_region = std::func(
            unit: &L1.Unit,
            region_id: L1.RegionId,
            arguments: &ValueVector,
            depth: usize,
            state: &mut LainVm,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if region_id >= unit.regions.length() {
                return fail(7103);
            }
            let region: &L1.Region = unit.regions.get(region_id);
            let offset: usize = 0;
            if state.tcb.resume_pending && state.tcb.region == region_id {
                offset = state.tcb.position;
                state.tcb.resume_pending = false;
            }
            state.tcb.region = region_id;

            while offset < region.instructions.length() {
                state.tcb.position = offset;
                if state.tcb.frames.length() > 0 {
                    let top_frame: usize = state.tcb.frames.length() - 1;
                    state.tcb.frames.get_mut(top_frame).region = region_id;
                    state.tcb.frames.get_mut(top_frame).position = offset;
                }
                if !consume_step(state) {
                    if state.tcb.yielded { return yield_flow(); }
                    return fail(7109);
                }
                let instruction: &L1.Instruction =
                    region.instructions.get(offset);

                if instruction.kind == 1 {
                    return evaluate_expression(
                        unit,
                        instruction.expression,
                        arguments,
                        depth,
                        state,
                    );
                }

                if instruction.kind == 2 {
                    let condition: Flow = evaluate_expression(
                        unit,
                        instruction.expression,
                        arguments,
                        depth,
                        state,
                    );
                    if condition.status != 0 {
                        return condition;
                    }
                    if condition.value.i32_value != 0 {
                        let branch: Flow = execute_region(
                            unit,
                            instruction.first_region,
                            arguments,
                            depth + 1,
                            state,
                        );
                        if branch.status != 7997 { return branch; }
                    } else {
                        let branch: Flow = execute_region(
                            unit,
                            instruction.second_region,
                            arguments,
                            depth + 1,
                            state,
                        );
                        if branch.status != 7997 { return branch; }
                    }
                }

                if instruction.kind == 3 {
                    let loop_status: i32 = 7997;
                    while 1 == 1 {
                        let body: Flow = execute_region(
                            unit, instruction.first_region, arguments,
                            depth + 1, state,
                        );
                        if body.status == 7999 { continue; }
                        if body.status == 7998 || body.status == 7997 { break; }
                        loop_status = body.status;
                        break;
                    }
                    if loop_status != 7997 {
                        return fail(loop_status);
                    }
                }

                if instruction.kind == 4 { return break_flow(); }
                if instruction.kind == 5 { return continue_flow(); }
                if instruction.kind == 6 {
                    let stored: Flow = evaluate_expression(
                        unit, instruction.expression, arguments, depth, state,
                    );
                    if stored.status != 0 { return stored; }
                    let destination: Flow = evaluate_expression(
                        unit, instruction.destination, arguments, depth, state,
                    );
                    if destination.status != 0 { return destination; }
                    let address_index: usize = address_at(unit, state, destination.value);
                    if address_index == std::usize_max() { return fail(7116); }
                    let address: &Address = state.vspace.addresses.get(address_index);
                    if address.kind == 2 { return fail(7119); }
                    if address.kind != 1 { return fail(7116); }
                    let value_type: &L1.Type = unit.types.get(instruction.value_type);
                    if value_type.kind != 1 || value_type.bit_width == 0
                        || value_type.bit_width > 64
                        || value_type.bit_width % 8 != 0 { return fail(7118); }
                    let count: usize = value_type.bit_width / 8;
                    if count > address.length { return fail(7117); }
                    let byte_index: usize = 0;
                    while byte_index < count {
                        *state.vspace.storage.get_mut(address.offset + byte_index) =
                            ((stored.value.bits_value
                                / power_of_two(byte_index * 8)) & 255) as i32;
                        byte_index = byte_index + 1;
                    }
                }

                offset = offset + 1;
            }

            return fallthrough();
        };

        // Every public execution entry point starts the same root TCB.  Keeping
        // construction here prevents execute() and execute_limited() from
        // drifting into separate evaluator paths as VM state grows.
        let new_vm = std::func(
            step_limit: usize,
            depth_limit: usize,
            allocation_limit: usize,
            external_calls_allowed: bool,
        ) -> LainVm ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let capability_active: bool = external_calls_allowed;
            let cspace: CapabilityVector = CapabilityVector.new();
            cspace.push(Capability {
                owner: 1,
                active: capability_active,
                external: capability_active,
            });
            cspace.push(Capability {
                owner: 1,
                active: true,
                external: false,
            });
            return LainVm {
                vspace: VSpace {
                    owner: 1,
                    generation: 1,
                    released: false,
                    storage: Memory.Bytes.new(),
                    addresses: AddressVector.new(),
                    activations: ActivationVector.new(),
                    allocation_bytes: 0,
                    allocation_limit: allocation_limit,
                },
                tcb: TCB {
                    // 0 READY, 1 RUNNING, 2 BLOCKED, 3 DEAD.
                    status: 0,
                    steps: 0,
                    step_limit: step_limit,
                    depth_limit: depth_limit,
                    current_activation: 0,
                    next_activation: 1,
                    procedure: 0,
                    region: 0,
                    position: 0,
                    suspend_reason: 0,
                    slice_limit: 0,
                    slice_steps: 0,
                    yielded: false,
                    resume_pending: false,
                    frames: CallFrameVector.new(),
                    trap: Trap {
                        kind: 0, status: 0, procedure: 0,
                        position: 0, active: false,
                    },
                },
                cspace: cspace,
            };
        };

        let value_type = std::func(value: &Value) -> L1.TypeId {
            return value.type_id;
        };

        let value_i32 = std::func(value: &Value) -> i32 {
            return value.i32_value;
        };

        let value_bits = std::func(value: &Value) -> u64 {
            return value.bits_value;
        };

        let new_arguments = std::func() -> ValueVector {
            return ValueVector.new();
        };

        let run_root = std::func(
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let state: LainVm = new_vm(0, 128, 0, false);
            if !start_tcb(&mut state) {
                return finish_vm(
                    &mut state, procedure_id, fail(7103),
                );
            }
            let result: Flow = execute_procedure(
                unit,
                procedure_id,
                arguments,
                0,
                &mut state,
            );
            return finish_vm(&mut state, procedure_id, result);
        };

        let run_root_limited = std::func(
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
            step_limit: usize,
            depth_limit: usize,
            allocation_limit: usize,
            external_calls_allowed: bool,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            let state: LainVm = new_vm(
                step_limit, depth_limit, allocation_limit,
                external_calls_allowed,
            );
            if !start_tcb(&mut state) {
                return finish_vm(
                    &mut state, procedure_id, fail(7103),
                );
            }
            let result: Flow = execute_procedure(
                unit, procedure_id, arguments, 0, &mut state
            );
            return finish_vm(&mut state, procedure_id, result);
        };

        // Run a prepared child procedure in a fresh TCB while retaining the
        // caller's VSpace and capability space.  LAINIR lowering materializes
        // a source #eval's implicit captures as `arguments` before reaching
        // this boundary.  The child has no borrowed caller frame: only the
        // physical values in that vector cross into it.
        let run_child = std::func(
            state: &mut LainVm,
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if state.tcb.status != 1 { return fail(7103); }

            let parent_tcb: TCB = state.tcb;
            state.tcb = TCB {
                status: 0,
                steps: parent_tcb.steps,
                step_limit: parent_tcb.step_limit,
                depth_limit: parent_tcb.depth_limit,
                current_activation: 0,
                next_activation: parent_tcb.next_activation,
                procedure: procedure_id,
                region: 0,
                position: 0,
                suspend_reason: 0,
                slice_limit: 0,
                slice_steps: 0,
                yielded: false,
                resume_pending: false,
                frames: CallFrameVector.new(),
                trap: Trap {
                    kind: 0, status: 0, procedure: 0,
                    position: 0, active: false,
                },
            };
            let flow: Flow = fail(7103);
            if start_tcb(state) {
                flow = execute_procedure(
                    unit,
                    procedure_id,
                    arguments,
                    parent_tcb.frames.length(),
                    state,
                );
            }
            if flow.status != 0 {
                state.tcb.trap = Trap {
                    kind: trap_kind(flow.status),
                    status: flow.status,
                    procedure: procedure_id,
                    position: state.tcb.position,
                    active: true,
                };
                flow = Flow {
                    status: flow.status,
                    value: flow.value,
                    trap_kind: state.tcb.trap.kind,
                    trap_procedure: state.tcb.trap.procedure,
                    trap_position: state.tcb.trap.position,
                };
            }
            state.tcb.status = 3;
            let child_tcb: TCB = state.tcb;
            parent_tcb.steps = child_tcb.steps;
            parent_tcb.next_activation = child_tcb.next_activation;
            if flow.status != 0 { parent_tcb.trap = child_tcb.trap; }
            state.tcb = parent_tcb;
            return flow;
        };

        let run_slice = std::func(
            state: &mut LainVm,
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
            fuel: usize,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if fuel == 0 { return fail(7109); }
            if state.tcb.status == 0 && !start_tcb(state) {
                return fail(7103);
            }
            if state.tcb.status != 1 { return fail(7103); }
            state.tcb.slice_limit = fuel;
            state.tcb.slice_steps = 0;
            state.tcb.yielded = false;
            let result: Flow = fail(7103);
            if state.tcb.resume_pending && state.tcb.frames.length() > 0 {
                let top_frame: usize = state.tcb.frames.length() - 1;
                let resume_region: L1.RegionId =
                    state.tcb.frames.get(top_frame).region;
                let resume_arguments: ValueVector = ValueVector.new();
                let resume_source: &ValueVector =
                    &state.tcb.frames.get(top_frame).arguments;
                let resume_argument_index: usize = 0;
                while resume_argument_index < resume_source.length() {
                    resume_arguments.push(
                        *resume_source.get(resume_argument_index),
                    );
                    resume_argument_index = resume_argument_index + 1;
                }
                result = execute_region(
                    unit,
                    resume_region,
                    &resume_arguments,
                    state.tcb.frames.length(),
                    state,
                );
            } else {
                result = execute_procedure(
                    unit, procedure_id, arguments, 0, state,
                );
            }
            state.tcb.slice_limit = 0;
            if result.status == 7996 {
                state.tcb.resume_pending = true;
                return result;
            }
            return finish_vm(state, procedure_id, result);
        };

        let execute_procedure = std::func(
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
            depth: usize,
            state: &mut LainVm,
        ) -> Flow ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            if state.tcb.depth_limit != 0 && depth >= state.tcb.depth_limit {
                return fail(7108);
            }
            if procedure_id >= unit.procedures.length() {
                return fail(7101);
            }
            state.tcb.procedure = procedure_id;
            let procedure: &L1.Procedure =
                unit.procedures.get(procedure_id);
            if procedure.is_external {
                // An external procedure can only cross the evaluator boundary
                // after the individual VM invocation explicitly grants the
                // external-call capability.  The dispatcher itself remains a
                // LAINIR-provider dependency, never a hidden host facility.
                if !external_capability_allowed(state) {
                    return fail(7102);
                }
                if procedure.parameter_types.length() != arguments.length() {
                    return fail(7105);
                }
                let name: addr = Memory.Allocation.address(
                    procedure.name.bytes.storage,
                );
                let raw_arguments: addr = Memory.Allocation.address(
                    arguments.storage,
                );
                let external_response: ExternalCalls.Response =
                    ExternalCalls.call(
                        name, raw_arguments, arguments.length(),
                    );
                let external_status: i32 =
                    ExternalCalls.response_status(&external_response);
                if external_status != 0 { return fail(external_status); }
                return success(scalar(
                    procedure.return_type,
                    ExternalCalls.response_bits(&external_response),
                ));
            }
            if procedure.parameter_types.length() != arguments.length() {
                return fail(7105);
            }
            let previous_procedure: usize = state.tcb.procedure;
            let previous_region: usize = state.tcb.region;
            let previous_position: usize = state.tcb.position;
            let previous_activation: usize = state.tcb.current_activation;
            let activation: usize = state.tcb.next_activation;
            state.tcb.next_activation = state.tcb.next_activation + 1;
            state.tcb.current_activation = activation;
            state.tcb.procedure = procedure_id;
            state.tcb.region = procedure.body;
            state.tcb.position = 0;
            let frame_arguments: ValueVector = ValueVector.new();
            let frame_argument_index: usize = 0;
            while frame_argument_index < arguments.length() {
                frame_arguments.push(*arguments.get(frame_argument_index));
                frame_argument_index = frame_argument_index + 1;
            }
            state.tcb.frames.push(CallFrame {
                procedure: procedure_id,
                region: procedure.body,
                position: 0,
                activation: activation,
                arguments: frame_arguments,
                return_procedure: previous_procedure,
                return_region: previous_region,
                return_position: previous_position,
            });
            state.vspace.activations.push(Activation {
                id: activation,
                parent: previous_activation,
                storage_start: state.vspace.storage.length(),
                storage_length: 0,
                active: true,
            });
            let result: Flow = execute_region(
                unit,
                procedure.body,
                arguments,
                depth + 1,
                state,
            );
            if result.status == 7996 {
                return result;
            }
            let activation_escape: bool = false;
            if result.status == 0 {
                let returned_address: usize = address_at(unit, state, result.value);
                if returned_address != std::usize_max()
                    && state.vspace.addresses.get(returned_address).kind == 1
                    && state.vspace.addresses.get(returned_address).activation
                        == activation {
                    activation_escape = true;
                }
            }
            // Activation-owned address handles become invalid as soon as the
            // procedure returns.  Keep the handles in the table for stable
            // scalar representation, but mark every derived handle dead so
            // later #lea/#load/#store paths reject use-after-return.
            let address_index: usize = 0;
            while address_index < state.vspace.addresses.length() {
                let address: &mut Address = state.vspace.addresses.get_mut(address_index);
                if address.kind == 1 && address.activation == activation {
                    address.active = false;
                }
                address_index = address_index + 1;
            }
            let activation_index: usize = 0;
            let activation_storage_length: usize =
                state.vspace.storage.length();
            while activation_index < state.vspace.activations.length() {
                let frame: &mut Activation =
                    state.vspace.activations.get_mut(activation_index);
                if frame.id == activation {
                    frame.storage_length =
                        activation_storage_length - frame.storage_start;
                    frame.active = false;
                }
                activation_index = activation_index + 1;
            }
            state.tcb.current_activation = previous_activation;
            if state.tcb.frames.length() > 0 {
                state.tcb.frames.length = state.tcb.frames.length() - 1;
            }
            if previous_activation != 0 {
                state.tcb.procedure = previous_procedure;
                state.tcb.region = previous_region;
                state.tcb.position = previous_position;
            }
            if activation_escape { return fail(7120); }
            if result.status == 7997
                || result.status == 7998
                || result.status == 7999 {
                return fail(7103);
            }
            return result;
        };

        // The VM boundary deliberately exposes no status-and-value wrapper.
        // A verified computation either returns its physical value or raises
        // the standard Trap effect.  Flow stays private to this module.
        let execute = std::func(
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
        ) -> Value ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
            effects.Trap,
        } {
            let flow: Flow = run_root(unit, procedure_id, arguments);
            if flow.status != 0 { effects.trap(); }
            return flow.value;
        };

        let execute_limited = std::func(
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
            step_limit: usize,
            depth_limit: usize,
            allocation_limit: usize,
            external_calls_allowed: bool,
        ) -> Value ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
            effects.Trap,
        } {
            let flow: Flow = run_root_limited(
                unit, procedure_id, arguments, step_limit, depth_limit,
                allocation_limit, external_calls_allowed,
            );
            if flow.status != 0 { effects.trap(); }
            return flow.value;
        };

        let execute_child = std::func(
            state: &mut LainVm,
            unit: &L1.Unit,
            procedure_id: L1.ProcedureId,
            arguments: &ValueVector,
        ) -> Value ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
            effects.Trap,
        } {
            let flow: Flow = run_child(
                state, unit, procedure_id, arguments,
            );
            if flow.status != 0 { effects.trap(); }
            return flow.value;
        };

        // #eval is an effect request, not a compiler-owned evaluator object.
        // The handler is installed by the VM execution boundary, where the
        // active TCB and VSpace are available.  Meta can therefore request a
        // child computation without receiving either implementation object.
        let Eval: effects.Effect = std::effect("LAINVM.Eval", L1);
        let eval = std::effect_operation(
            Eval,
            "eval",
            std::func(
                unit: &L1.Unit,
                procedure_id: L1.ProcedureId,
                arguments: &ValueVector,
            ) -> Value,
        );
        let eval_handler = std::func(
            state: &mut LainVm,
        ) -> effects.Handler(
            Eval,
            {
                Memory.Allocation.Effect,
                Memory.Bounds.Effect,
                effects.Trap,
            },
        ) {
            return std::handler(Eval) ! {
                Memory.Allocation.Effect,
                Memory.Bounds.Effect,
                effects.Trap,
            } {
                eval(unit, procedure_id, arguments) {
                    resume execute_child(
                        state, unit, procedure_id, arguments,
                    );
                }
            };
        };

        return std::module {
            @export let L1: Module = L1;
            @export let Value: type = Value;
            @export let ValueVector: type = ValueVector;
            @export let new_arguments = new_arguments;
            @export let make_bits = scalar;
            @export let value_type = value_type;
            @export let value_i32 = value_i32;
            @export let value_bits = value_bits;
            @export let Capability: type = Capability;
            @export let CapabilityVector: type = CapabilityVector;
            @export let CallFrame: type = CallFrame;
            @export let CallFrameVector: type = CallFrameVector;
            @export let LainVm: type = LainVm;
            @export let capability_transfer = capability_transfer;
            @export let capability_revoke = capability_revoke;
            @export let new_vm = new_vm;
            @export let start_tcb = start_tcb;
            @export let suspend_tcb = suspend_tcb;
            @export let suspend_tcb_reason = suspend_tcb_reason;
            @export let resume_tcb = resume_tcb;
            @export let execute = execute;
            @export let execute_limited = execute_limited;
            @export let execute_child = execute_child;
            @export let Eval: effects.Effect = Eval;
            @export let eval = eval;
            @export let eval_handler = eval_handler;
        };
    };
};
