// Stable compiler-facing LAINVM execution contract.
//
// The compiler can construct and inspect physical values, create an argument
// frame, and request Eval.  It cannot observe VM state, TCBs, VSpace, Trap
// records, capability tables, or interpreter control flow.

let effects: Module = import("std::effect");

@export
let lainvm_api_contract: Module = std::module {
    @export
    let ExecutionShape: ModuleShape = std::module_shape {
        let Artifact: std::type;
        let Procedure: std::type;
        let Value: std::type;
        let ValueVector: std::type;
        let Allocation: effects.Effect;
        let Eval: effects.Effect;

        let new_arguments = std::func() -> ValueVector;
        let append_argument = std::func(
            arguments: &mut ValueVector,
            value: Value,
        ) -> unit ! {Allocation};
        let make_bits = std::func(
            value_type: usize,
            bits: u64,
        ) -> Value;
        let value_type = std::func(value: &Value) -> usize;
        let value_i32 = std::func(value: &Value) -> i32;
        let value_bits = std::func(value: &Value) -> u64;
        let eval = std::func(
            unit: &Artifact,
            procedure: Procedure,
            arguments: &ValueVector,
        ) -> Value ! {Eval};
    };
};
