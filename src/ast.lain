// ast.lain —— AST 节点访问与字面量读取。句柄约定见 seed/kernel/src/meta/host_v2.c。
// 组的分隔符就是 ASCII 码；根组是 0。
extern lain2_ast_kind(h: u64) -> u64 = lain2_ast_kind;
extern lain2_ast_delim(h: u64) -> u64 = lain2_ast_delim;
extern lain2_ast_sym(h: u64) -> u64 = lain2_ast_sym;
extern lain2_ast_child_count(h: u64) -> u64 = lain2_ast_child_count;
extern lain2_ast_child(h: u64, i: u64) -> u64 = lain2_ast_child;
extern lain2_ast_literal_addr(h: u64) -> addr = lain2_ast_literal_addr;
extern lain2_ast_literal_len(h: u64) -> u64 = lain2_ast_literal_len;

let st = import("state");

// --- 常量 ---------------------------------------------------------------
func dl_paren() -> u64 { return 40; }
func dl_bracket() -> u64 { return 91; }
func dl_brace() -> u64 { return 123; }

// 「这个位置没有槽」。
func no_slot() -> u64 { return 999999; }

// 裸原语的转出：别的单元要用 AST 原语时走这里，不要在各自文件里重复声明
// 同一条 extern（同一份台账只能有一处）。
func delim(h: u64) -> u64 {
  if h == 0 { return 0; }
  return lain2_ast_delim(h);
}
func lit_addr(h: u64) -> addr { return lain2_ast_literal_addr(h); }
func lit_len(h: u64) -> u64 { return lain2_ast_literal_len(h); }

func e_ast() -> u64 { return 1; }
func e_unbound() -> u64 { return 2; }
func e_type() -> u64 { return 3; }
func e_op() -> u64 { return 4; }
func e_unsup() -> u64 { return 5; }
func e_frame() -> u64 { return 6; }

// --- 小块内存 -----------------------------------------------------------
func new_ty(k: addr) -> addr { return st.st_alloc(k, 32); }
func new_val(k: addr) -> addr { return st.st_alloc(k, 56); }

// 8 字节临时格：end / term 这类输出位置。
func box(k: addr) -> addr { return st.st_alloc(k, 8); }
func box_put(p: addr, v: u64) -> u64 { store(p, v); return v; }
func box_get(p: addr) -> u64 { return load(p); }

// --- AST 访问（调用前必须自己保证下标没有越界） -------------------------
func n_count(g: u64) -> u64 { return lain2_ast_child_count(g); }
func n_at(g: u64, i: u64) -> u64 {
  if i >= n_count(g) { return 0; }
  return lain2_ast_child(g, i);
}
func n_sym(g: u64, i: u64) -> u64 {
  if i >= n_count(g) { return 0; }
  let h: u64 = n_at(g, i);
  if h == 0 { return 0; }
  return lain2_ast_sym(h);
}
func node_count(h: u64) -> u64 {
  if h == 0 { return 0; }
  return lain2_ast_child_count(h);
}
// 节点种类：1 = 词，2 = 组。空组的孩子数是 0，只能靠种类认出来。
func node_kind(h: u64) -> u64 {
  if h == 0 { return 0; }
  return lain2_ast_kind(h);
}
func is_group_node(h: u64) -> u64 {
  if node_kind(h) == 2 { return 1; }
  return 0;
}
func node_sym(h: u64) -> u64 {
  if h == 0 { return 0; }
  return lain2_ast_sym(h);
}
func is_group(g: u64, i: u64) -> u64 {
  if i >= n_count(g) { return 0; }
  return is_group_node(n_at(g, i));
}
func delim_of(g: u64, i: u64) -> u64 {
  if i >= n_count(g) { return 0; }
  return lain2_ast_delim(n_at(g, i));
}
func byte_at(p: addr, k: u64) -> u64 {
  let b: u8 = load(p + k);
  return b as u64;
}
func tok_first(g: u64, i: u64) -> u64 {
  let h: u64 = n_at(g, i);
  let len: u64 = lain2_ast_literal_len(h);
  if len == 0 { return 0; }
  let p: addr = lain2_ast_literal_addr(h);
  return byte_at(p, 0);
}
func is_digit_token(g: u64, i: u64) -> u64 {
  let b: u64 = tok_first(g, i);
  if b >= 48 and b <= 57 { return 1; }
  return 0;
}
// 分号、逗号是单字节词，直接看字节，省一张符号表。
func tok_is(g: u64, i: u64, code: u64) -> u64 {
  if i >= n_count(g) { return 0; }
  if is_group(g, i) == 1 { return 0; }
  let h: u64 = n_at(g, i);
  if lain2_ast_literal_len(h) != 1 { return 0; }
  let b: u64 = byte_at(lain2_ast_literal_addr(h), 0);
  if b == code { return 1; }
  return 0;
}
func is_semi(g: u64, i: u64) -> u64 { return tok_is(g, i, 59); }
func is_comma(g: u64, i: u64) -> u64 { return tok_is(g, i, 44); }
// 名字记号：首字节是字母或下划线。
func is_name(g: u64, i: u64) -> u64 {
  let b: u64 = tok_first(g, i);
  if b == 95 { return 1; }
  if b >= 65 and b <= 90 { return 1; }
  if b >= 97 and b <= 122 { return 1; }
  return 0;
}
func skip_semi(g: u64, j: u64) -> u64 {
  if is_semi(g, j) == 1 { return j + 1; }
  return j;
}

// 十进制 / 0x 十六进制字面量。
func num_value(p: addr, n: u64) -> u64 {
  let b0: u64 = byte_at(p, 0);
  if n > 2 and b0 == 48 {
    let b1: u64 = byte_at(p, 1);
    if b1 == 120 or b1 == 88 {
      return loop h(i: u64 = 2, v: u64 = 0) while i < n {
        let c: u64 = byte_at(p, i);
        let d: u64 = if c <= 57 { c - 48 } else { if c <= 70 { c - 55 } else { c - 87 } };
        v = v * 16 + d;
        i = i + 1;
      };
    }
  }
  return loop d(i: u64 = 0, v: u64 = 0) while i < n {
    let c: u64 = byte_at(p, i);
    v = v * 10 + (c - 48);
    i = i + 1;
  };
}
