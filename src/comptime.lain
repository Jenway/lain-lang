// comptime.lain —— 编译期求值的外壳：临时模块的克隆、入口收尾、隔离执行与释放。
// 递归的表达式求值留在 core.lain：core 单向 import 本文件，这里不能反过来 import core。
let st = import("state");

extern lain2_sym_intern(p: Ref(u8), n: u64) -> u64 = lain2_sym_intern;
extern lain2_ir_mod_verify(mod: u64) -> u64 = lain2_ir_mod_verify;
extern lain2_ir_mod_clone_completed(mod: u64) -> u64 = lain2_ir_mod_clone_completed;
extern lain2_ir_mod_free(mod: u64) -> u64 = lain2_ir_mod_free;
extern lain2_apply_module(mod: u64, entry: u64, args: Ref(u8), arg_n: u64, out: Mut(u8), out_cap: u64) -> u64 = lain2_apply_module;
extern lain2_apply_module_bytes(mod: u64, entry: u64, out: Mut(u8), out_cap: u64) -> u64 = lain2_apply_module_bytes;
extern lain2_ast_parse_snippet(p: Ref(u8), n: u64) -> u64 = lain2_ast_parse_snippet;
extern lain2_mem_alloc(bytes: u64, align: u64) -> Mut(u8) = lain2_mem_alloc;

// 求值入口名：临时模块只装这一个过程，固定名字不会撞车。
let entry_name = func() -> u64 { return lain2_sym_intern("__meta_eval", 11); };

let clone = func(k: Mut(st.State)) -> u64 { return lain2_ir_mod_clone_completed(st.st_mod(k)); };

let verify = func(m: u64) -> u64 { return lain2_ir_mod_verify(m); };

let release = func(m: u64) -> u64 { return lain2_ir_mod_free(m); };

// 结果缓冲区：apply 要 16 字节可写区（[状态, 结果]），从工作区线性切一块。
let out_buf = func() -> Mut(u8) { return lain2_mem_alloc(16, 8); };

// 零参调用。out 是一条 16 字节记录：[状态, 结果]。状态 0 表示求值成功；
// 非 0 是隔离执行里的错误码，调用方必须把它翻成编译错误。
let apply_scalar = func(m: u64, entry: u64, out: Mut(u8)) -> u64 {
  let none: Ref(u8) = null_ref(Ref(u8));
  let cap: u64 = 16;
  return lain2_apply_module(m, entry, none, 0, out, cap);
};

// 注入入口名：生成器跑在沙箱里，入口只负责把生成为的文本交回宿主。
let inject_name = func() -> u64 { return lain2_sym_intern("__meta_inject", 13); };

// 工作区里切一块可写区，供字节流或结果输出使用。
let buf = func(bytes: u64) -> Mut(u8) { return lain2_mem_alloc(bytes, 8); };

// 把沙箱入口返回的指针指向的字节流整块抄回来。
let apply_bytes = func(m: u64, entry: u64, out: Mut(u8), cap: u64) -> u64 {
  return lain2_apply_module_bytes(m, entry, out, cap);
};

// 把一段文本登记成新的源码单元，返回它的编号（0 表示失败，诊断已写进宿主）。
let snippet = func(p: Ref(u8), n: u64) -> u64 { return lain2_ast_parse_snippet(p, n); };
