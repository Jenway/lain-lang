// decl.lain —— 过程与顶层 let 的编译：签名解析、栈槽铺底、过程体交给 core。
let st = import("state");
let ty = import("types");
let env = import("env");
let ir = import("ir");
let codes = import("ir_codes");
let s = import("sym");
let ax = import("ast");
let cx = import("ctx");
let co = import("core");
let sm = import("stmt");
let me = import("member");
let agg = import("agg");
let modules = import("modules");
let an = import("anon");
let ct = import("ctypes");
let ireg = import("tyreg");
let tb = import("tbuild");
let ctf = import("ctfor");
let gn = import("generics");
let gv = import("given");
let ef = import("effects");

extern lain2_source_root(src: u64) -> u64 = lain2_source_root;
extern decl_compile_vmod_p2(k: Mut(st.State), vmod: u64, src: u64, bodyg: u64, snap_buf: Mut(u8), snap_cnt: u64) -> u64 = lainc_compile_functor_mod_p2;

// --- ast / ctx 层转发（本文件正文的裸调用经这里转一手，避免逐处加前缀） ----------
let new_ty = func(k: Mut(st.State)) -> Mut(ty.Ty) { return ax.new_ty(k); };
let new_val = func(k: Mut(st.State)) -> Mut(ty.Val) { return ax.new_val(k); };
let box = func(k: Mut(st.State)) -> Mut(u64) { return ax.box(k); };
let box_get = func(p: Mut(u64)) -> u64 { return ax.box_get(p); };
let n_count = func(g: u64) -> u64 { return ax.n_count(g); };
let n_sym = func(g: u64, i: u64) -> u64 { return ax.n_sym(g, i); };
let n_at = func(g: u64, i: u64) -> u64 { return ax.n_at(g, i); };
let no_slot = func() -> u64 { return ax.no_slot(); };
let skip_semi = func(g: u64, j: u64) -> u64 { return ax.skip_semi(g, j); };
let e_type = func() -> u64 { return ax.e_type(); };
let e_ast = func() -> u64 { return ax.e_ast(); };
let tnone = func(k: Mut(st.State)) -> Mut(ty.Ty) { return cx.tnone(k); };
let expect_sym = func(k: Mut(st.State), g: u64, i: u64, sym: u64) -> u64 { return cx.expect_sym(k, g, i, sym); };
let parse_type = func(k: Mut(st.State), g: u64, i: u64, out: Mut(ty.Ty)) -> u64 { return cx.parse_type(k, g, i, out); };
let parse_params = func(k: Mut(st.State), pg: u64, i: u64, idx: u64, tintbl: Mut(ty.Ty), symtbl: Mut(u64)) -> u64 { return cx.parse_params(k, pg, i, idx, tintbl, symtbl); };
let count_tree = func(h: u64, acc: u64) -> u64 { return cx.count_tree(h, acc); };
let emit_slots = func(k: Mut(st.State), j: u64, n: u64) -> u64 { return cx.emit_slots(k, j, n); };
let slot_put = func(k: Mut(st.State), j: u64, v: Mut(ty.Val), tp: Mut(ty.Ty)) -> u64 { return cx.slot_put(k, j, v, tp); };
let slot_get = func(k: Mut(st.State), j: u64, tp: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return cx.slot_get(k, j, tp, out); };
let push_val = func(k: Mut(st.State), v: Mut(ty.Val)) -> u64 { return cx.push_val(k, v); };
let block_mode = func(k: Mut(st.State), g: u64, i: u64, term: Mut(u64), slot: u64, tp: Mut(ty.Ty)) -> u64 { return sm.block_mode(k, g, i, term, slot, tp); };
let expr = func(k: Mut(st.State), g: u64, i: u64, minp: u64, want: Mut(ty.Ty), out: Mut(ty.Val)) -> u64 { return co.expr(k, g, i, minp, want, out); };

// --- 过程 ---------------------------------------------------------------
let emit_ret_guard = func(k: Mut(st.State), rt: Mut(ty.Ty), term: Mut(u64)) -> u64 {
  if box_get(term) == 1 { return 0; }
  if ty.ty_known(rt) == 0 {
    ir.args_reset(k);
    return ir.emit_jump(k, codes.INST_RETURN(), 0);
  }
  ir.args_reset(k);
  return ir.emit_jump(k, codes.INST_UNREACHABLE(), 0);
};

// 过程与顶层值都按「模块前缀 + 名字」定名，跨源同名不撞。
let proc_name = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let name: u64 = n_sym(g, i + 1);
  if i >= 2 and ax.is_group(g, i - 2) == 0 and n_sym(g, i - 2) == s.p_at() {
    return name;
  }
  return modules.qual(k, st.st_scope(k), name);
};

let begin_proc = func(k: Mut(st.State), q: u64, rt: Mut(ty.Ty)) -> u64 {
  st.st_set_slotj(k, 0);
  st.st_set_loopdepth(k, 0);
  env.env_release(k, 0);
  st.st_set_retk(k, ty.tk(rt));
  st.st_set_retw(k, ty.tw(rt));
  st.st_set_retsg(k, ty.tsg(rt));
  st.st_set_retsh(k, ty.tsh(rt));
  let ip: u64 = st.st_in_proc(k);
  let nip: u64 = st.st_set_in_proc(k, ip + 1);
  return ir.proc_begin(k, q);
};

// 值聚合返回的隐藏首参：%_ret: 指针。后面 return 的整块拷贝就写它。
let sret_param = func(k: Mut(st.State)) -> u64 {
  let vn: u64 = ir.fresh_t(k);
  let ap: Mut(ty.Ty) = ir.taddr(k);
  ir.proc_param(k, vn, ap);
  return st.st_set_retptr(k, vn);
};

let bind_gen_vals = func(k: Mut(st.State), nms: Mut(u64), vals: Mut(ctf.CtVal), i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  let nm: u64 = deref(cx.word_idx(nms, i));
  let v: Mut(ctf.CtVal) = ptr_cast(Mut(ctf.CtVal), ptr_cast(Mut(u8), vals) + i * 24);
  ctf.bind(k, nm, ctf.v_kind(v), ctf.v_a(v), ctf.v_b(v));
  // 模块见证参数同步进记录区，嵌套泛型调用才能自动找到它。
  if ctf.v_kind(v) == 9 { gv.push_mod_implicit(k, ctf.v_a(v), ctf.v_b(v)); }
  return bind_gen_vals(k, nms, vals, i + 1, n);
};

// 处理已经弹出的泛型队列条目；调用方负责弹出，避免重复弹出丢条目。
let flush_gen_rec = func(k: Mut(st.State), ge: Mut(gn.GenQRec)) -> u64 {
  let q: u64 = ge.mangled_q;
  let tpl_e: Mut(modules.SymEntry) = ge.tpl_e;
  let nct: u64 = ge.nct;
  let nms: Mut(u64) = ge.names_arr;
  let vals: Mut(ctf.CtVal) = ge.vals_arr;
  let dp: u64 = ge.depth;
  let hdr: Mut(gn.GenHdr) = ptr_cast(Mut(gn.GenHdr), modules.sym_sig(tpl_e));
  let src: u64 = hdr.src;
  let gm: u64 = hdr.modv;
  let root: u64 = lain2_source_root(src);
  let pg: u64 = ax.n_at(root, hdr.pg_i);
  let ret_i: u64 = hdr.ret_i;
  let bodyg: u64 = ax.n_at(root, hdr.body_i);
  let saved_src: u64 = st.st_src(k);
  let saved_vmod: u64 = st.st_vmod(k);
  let saved_dp: u64 = gn.gen_depth(k);
  let cm: u64 = ctf.mark(k);
  let gmark: u64 = gv.mark(k);
  let gvm: u64 = if gm >= 1000 { gm } else { 0 };
  st.st_set_src(k, src);
  st.st_set_vmod(k, gvm);
  gn.set_gen_depth(k, dp);
  bind_gen_vals(k, nms, vals, 0, nct);
  let rt: Mut(ty.Ty) = new_ty(k);
  ty.ty_none(rt);
  if ret_i != 0 { parse_type(k, root, ret_i, rt); }
  let row: Mut(ef.EffRow) = ef.row_empty(k);
  compile_body_with(k, pg, rt, bodyg, q, row);
  gv.release(k, gmark);
  ctf.release(k, cm);
  gn.set_gen_depth(k, saved_dp);
  st.st_set_vmod(k, saved_vmod);
  st.st_set_src(k, saved_src);
  return flush_queue(k);
};

// 函子 phase2 队列，条目 40 字节：[虚拟模块号, 源号, 体组, 绑定快照, 快照条数]。
let FqRec = struct {
  vmod: u64,
  src: u64,
  bodyg: u64,
  snap: Mut(u8),
  cnt: u64
};

let fq_at = func(k: Mut(st.State), i: u64) -> Mut(FqRec) {
  return ptr_cast(Mut(FqRec), st.st_fqbase(k) + i * 40);
};

// 队列里还有待编条目（只看不弹；弹出会丢掉条目）。
let queue_pending = func(k: Mut(st.State)) -> u64 {
  if st.st_qhead(k) < st.st_q_count(k) { return 1; }
  let gb: Mut(gn.GenQBlk) = gn.qblk(k);
  if is_null(gb.qbase) == 0 and gb.qhead < gb.qn { return 1; }
  return 0;
};

// 过程体内实例化的函子等到所有过程收尾后补编 phase2；内层重入时已处理的条目
// 用 vmod = 0 标记，不会被重编。
let flush_fq = func(k: Mut(st.State)) -> u64 {
  let total: u64 = st.st_fqused(k) / 40;
  let done: u64 = loop w(i: u64 = 0) while i < st.st_fqused(k) / 40 {
    let r: Mut(FqRec) = fq_at(k, i);
    let vmod: u64 = r.vmod;
    if vmod != 0 {
      r.vmod = 0;
      if st.st_ok(k) == 0 {
        let a: u64 = decl_compile_vmod_p2(k, vmod, r.src, r.bodyg, r.snap, r.cnt);
      }
      // phase2 可能再排进匿名过程、泛型单态或新的函子实例，先把它们排空。
      let more: u64 = if queue_pending(k) == 1 or st.st_fqused(k) / 40 > total { 1 } else { 0 };
      if more == 1 { return flush_queue(k); }
    }
    i = i + 1;
  };
  st.st_set_fqused(k, 0);
  return done;
};

// 匿名过程、泛型单态化与函子 phase2 按批排空：每轮处理一条，再回到队头。
let flush_queue = func(k: Mut(st.State)) -> u64 {
  let e: Mut(an.AnonEntry) = an.pending(k);
  if is_null(e) == 0 {
    let q: u64 = an.entry_name(e);
    let src: u64 = an.entry_src(e);
    let g: u64 = an.entry_group(e);
    let node: u64 = an.entry_node(e);
    let am: u64 = an.entry_modv(e);
    let saved_src: u64 = st.st_src(k);
    let saved_vmod: u64 = st.st_vmod(k);
    let avm: u64 = if am >= 1000 { am } else { 0 };
    st.st_set_src(k, src);
    st.st_set_vmod(k, avm);
    let row0: Mut(ef.EffRow) = ef.row_empty(k);
    let b: u64 = compile_body(k, g, node, q, row0);
    if st.st_ok(k) != 0 {
      // 匿名过程在独立作用域里编译，外层局部量本来就看不到；给出可读的原因。
      let m: Ref(u8) = "anonymous func cannot capture";
      let d: u64 = ir.diag(k, 0, 2, m, 29);
    }
    st.st_set_vmod(k, saved_vmod);
    st.st_set_src(k, saved_src);
    return flush_queue(k);
  }
  if ef.handler_pending(k) == 1 {
    let hh: u64 = ef.flush_one_handler(k);
    return flush_queue(k);
  }
  let ge: Mut(gn.GenQRec) = gn.genq_pending(k);
  if is_null(ge) == 0 { return flush_gen_rec(k, ge); }
  if st.st_in_proc(k) != 0 { return 0; }
  return flush_fq(k);
};

let compile_body_with = func(k: Mut(st.State), pg: u64, rt: Mut(ty.Ty), bodyg: u64, q: u64, row: Mut(ef.EffRow)) -> u64 {
  let paramp: Mut(ty.Ty) = ptr_cast(Mut(ty.Ty), st.st_alloc(k, 512));
  let syms: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let np: u64 = parse_params(k, pg, 0, 0, paramp, syms);
  let sr: u64 = agg.sret_ty(rt);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, rt);
  let ab0: u64 = ef.clear_aborts(k);
  let fr: u64 = ef.push_frame(k, row);
  let rp: u64 = if sr == 1 { sret_param(k) } else { st.st_set_retptr(k, 0) };
  let pnames: Mut(u64) = ptr_cast(Mut(u64), st.st_alloc(k, 128));
  let dummy: u64 = loop w(idx: u64 = 0) while idx < np {
    let vn: u64 = ir.fresh_t(k);
    let wp: Mut(u64) = cx.word_idx(pnames, idx);
    deref(wp) = vn;
    ir.proc_param(k, vn, cx.ty_idx(paramp, idx));
    idx = idx + 1;
  };
  if sr == 0 {
    if ty.ty_known(rt) == 1 { ir.proc_result(k, rt); }
  }
  ir.region_begin(k);
  let nslots: u64 = 16 + 32 + count_tree(bodyg, 0);
  let sd: u64 = emit_slots(k, 0, nslots);
  let bnd: u64 = loop w(idx: u64 = 0) while idx < np {
    let sl: u64 = st.st_next_slot(k);
    let vt: Mut(ty.Ty) = new_ty(k);
    ty.ty_at(vt, cx.ty_idx(paramp, idx));
    let pn: u64 = deref(cx.word_idx(pnames, idx));
    let ps: u64 = deref(cx.word_idx(syms, idx));
    let pv: Mut(ty.Val) = new_val(k);
    ty.val_ref(pv, pn, vt);
    slot_put(k, sl, pv, vt);
    env.env_push(k, ps, sl, vt);
    idx = idx + 1;
  };
  let term: Mut(u64) = box(k);
  let after: u64 = block_mode(k, bodyg, 0, term, no_slot(), rt);
  let guard: u64 = emit_ret_guard(k, rt, term);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  let pf: u64 = ef.pop_frame(k);
  return flush_queue(k);
};

// 过程体：i 指向形参组，返回体之后的位置。
let compile_body = func(k: Mut(st.State), g: u64, i: u64, q: u64, row: Mut(ef.EffRow)) -> u64 {
  let pg: u64 = n_at(g, i);
  let l: Mut(ef.FnLayout) = ef.fn_layout(k, g, i);
  let rt: Mut(ty.Ty) = new_ty(k);
  ty.ty_none(rt);
  if l.ret_i != 0 { parse_type(k, g, l.ret_i, rt); }
  let bodyg: u64 = n_at(g, l.body_i);
  compile_body_with(k, pg, rt, bodyg, q, row);
  return l.next_i;
};

// 跳到过程的体之后（花括号组结束），用于只由编译期求值器解释的过程。
let skip_body = func(g: u64, i: u64) -> u64 {
  let n: u64 = n_count(g);
  if i >= n { return i; }
  if ax.is_group(g, i) == 1 {
    if ax.delim_of(g, i) == ax.dl_brace() { return i + 1; }
  }
  return skip_body(g, i + 1);
};

pub let compile_func = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let se: Mut(modules.SymEntry) = modules.find_here(k, n_sym(g, i + 1));
  let flag: u64 = if is_null(se) { 0 } else { modules.sym_set_flag(se, 1) };
  if (se as u64) != 0 {
    if tb.sig_types(modules.sym_sig(se)) == 1 { return skip_body(g, i + 2); }
  }
  let row: Mut(ef.EffRow) = ef.callee_row(k, se);
  return compile_body(k, g, i + 2, q, row);
};

// let 名 = func (形参) ... { 体 }：名字来自 let，func 词在 i。
pub let compile_func_expr = func(k: Mut(st.State), g: u64, i: u64, name: u64) -> u64 {
  let se: Mut(modules.SymEntry) = modules.find_here(k, name);
  let q: u64 = if is_null(se) { modules.qual(k, st.st_scope(k), name) } else { modules.sym_qual(se) };
  if (se as u64) != 0 {
    if tb.sig_types(modules.sym_sig(se)) == 1 { return skip_body(g, i + 1); }
  }
  let row: Mut(ef.EffRow) = ef.callee_row(k, se);
  let b: u64 = compile_body(k, g, i + 1, q, row);
  return skip_semi(g, b);
};

// 顶层的普通值：零参过程，把值算出来直接返回。
pub let compile_top_let = func(k: Mut(st.State), g: u64, i: u64) -> u64 {
  let name: u64 = n_sym(g, i + 1);
  let j0: u64 = i + 2;
  let t: Mut(ty.Ty) = tnone(k);
  let j: u64 = if j0 < n_count(g) and n_sym(g, j0) == s.p_colon() { parse_type(k, g, j0 + 1, t) } else { j0 };
  let e: u64 = expect_sym(k, g, j, s.p_eq());
  let q: u64 = proc_name(k, g, i);
  st.st_set_slotj(k, 0);
  st.st_set_loopdepth(k, 0);
  env.env_release(k, 0);
  st.st_set_retk(k, 9);
  st.st_set_retsh(k, 0);
  let ip0: u64 = st.st_in_proc(k);
  let nip: u64 = st.st_set_in_proc(k, ip0 + 1);
  ir.proc_begin(k, q);
  ir.region_begin(k);
  let nslots: u64 = 16 + 32 + count_tree(g, 0);
  let sd: u64 = emit_slots(k, 0, nslots);
  let v: Mut(ty.Val) = new_val(k);
  let nj: u64 = expr(k, g, e, 0, t, v);
  if st.st_ok(k) != 0 { return nj; }
  let vt: Mut(ty.Ty) = new_ty(k);
  if ty.ty_known(t) == 1 {
    ty.ty_at(vt, t);
  } else {
    let vs: u64 = ty.tsh(ty.vty(v));
    if vs != 0 {
      if agg.shp_kind(vs) == agg.kind_string() {
        let id: u64 = ireg.ty_add(k, ireg.lk_bits(), 8, 0, 0);
        let sid: u64 = ct.slice_t(k, id, 0);
        let projected: u64 = ireg.project(k, sid, vt);
      } else {
        ty.ty_at(vt, ty.vty(v));
      }
    } else {
      ty.ty_at(vt, ty.vty(v));
    }
  }
  if ty.ty_known(vt) == 0 { st.st_fail(k, e_type()); return nj; }
  if ty.tk(vt) == 3 and ty.tsh(vt) == 0 and ty.tsh(ty.vty(v)) != 0 {
    let sh: u64 = ty.tsh(ty.vty(v));
    let sv: u64 = ty.ty_set_sh(vt, sh);
  }
  ir.proc_result(k, vt);
  let sl: u64 = st.st_next_slot(k);
  slot_put(k, sl, v, ty.vty(v));
  env.env_push(k, name, sl, vt);
  let lv_val: Mut(ty.Val) = new_val(k);
  slot_get(k, sl, vt, lv_val);
  ir.args_reset(k);
  push_val(k, lv_val);
  ir.emit_jump(k, codes.INST_RETURN(), 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  let fl: u64 = flush_queue(k);
  return skip_semi(g, nj);
};

// 静态数据的读数过程：表与字符串直接返回数据符号的地址。
pub let compile_data_ref = func(k: Mut(st.State), g: u64, i: u64, nj: u64, dname: u64, t: Mut(ty.Ty)) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, t);
  ir.proc_result(k, t);
  ir.region_begin(k);
  ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, dname);
  let ins: u64 = ir.emit_jump(k, codes.INST_RETURN(), 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  return skip_semi(g, nj);
};

// 顶层聚合构造：数据块先登记成零字节，再由这个过程把字段写进去。
pub let compile_data_agg = func(k: Mut(st.State), g: u64, i: u64, nj: u64, dname: u64, sh: u64, fg: u64) -> u64 {
  let q: u64 = proc_name(k, g, i);
  let t: Mut(ty.Ty) = new_ty(k);
  let a1: u64 = ty.ty_addr(t);
  let a2: u64 = ty.ty_set_sh(t, sh);
  let ip0: u64 = st.st_in_proc(k);
  let bp: u64 = begin_proc(k, q, t);
  ir.proc_result(k, t);
  ir.region_begin(k);
  let nslots: u64 = 16 + 32 + count_tree(fg, 0);
  let sd: u64 = emit_slots(k, 0, nslots);
  let wr: u64 = me.agg_fields(k, sh, fg, 0, dname);
  ir.args_reset(k);
  let a: u64 = ir.arg_ref(k, dname);
  let ins: u64 = ir.emit_jump(k, codes.INST_RETURN(), 0);
  ir.region_end(k);
  ir.proc_end(k);
  let ipr: u64 = st.st_set_in_proc(k, ip0);
  return skip_semi(g, nj);
};
