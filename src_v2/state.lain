// 状态：编译期的可变寄存器块，住在 guest 内存里。
// 所有偏移只在本文件出现，别的模块只经访问器读写。
// 这里不写任何标量顶层 let：lain0 把顶层标量 let 当成符号地址，参与运算会报
// 「addr 上没有这个算子」。

extern lain2_mem_alloc(bytes: u64, align: u64) -> addr = lain2_mem_alloc;

// cap：绑定栈字节数。整块布局：状态 192 + 绑定栈 cap + 临时名缓冲 64 +
// 循环帧 1024 + 类型/值暂存 arena 65536。
func st_new(cap: u64) -> addr {
  let p: addr = lain2_mem_alloc(192, 8);
  let b: addr = lain2_mem_alloc(cap, 8);
  let s: addr = lain2_mem_alloc(64, 8);
  let f: addr = lain2_mem_alloc(1024, 8);
  let a: addr = lain2_mem_alloc(262144, 8);
  let z: u64 = 0;
  let w: u64 = loop w(j: u64 = 0) while j < 192 {
    store(p + j, z);
    j = j + 8;
  };
  store(p + 40, b as u64);
  store(p + 72, cap);
  store(p + 80, s as u64);
  store(p + 88, f as u64);
  store(p + 128, a as u64);
  store(p + 136, 262144);
  return p;
}

func st_sp(p: addr) -> u64 { return load(p + 0); }
func st_set_sp(p: addr, v: u64) -> u64 { store(p + 0, v); return v; }

func st_tmp(p: addr) -> u64 { return load(p + 8); }
func st_set_tmp(p: addr, v: u64) -> u64 { store(p + 8, v); return v; }

func st_label(p: addr) -> u64 { return load(p + 16); }
func st_set_label(p: addr, v: u64) -> u64 { store(p + 16, v); return v; }

func st_mod(p: addr) -> u64 { return load(p + 24); }
func st_set_mod(p: addr, v: u64) -> u64 { store(p + 24, v); return v; }

func st_err(p: addr) -> u64 { return load(p + 32); }
func st_set_err(p: addr, v: u64) -> u64 { store(p + 32, v); return v; }

func st_base(p: addr) -> addr { return load(p + 40) as addr; }

func st_src(p: addr) -> u64 { return load(p + 48); }
func st_set_src(p: addr, v: u64) -> u64 { store(p + 48, v); return v; }

func st_term(p: addr) -> u64 { return load(p + 64); }
func st_set_term(p: addr, v: u64) -> u64 { store(p + 64, v); return v; }

func st_cap(p: addr) -> u64 { return load(p + 72); }

func st_scratch(p: addr) -> addr { return load(p + 80) as addr; }

func st_frame(p: addr) -> addr { return load(p + 88) as addr; }

func st_depth(p: addr) -> u64 { return load(p + 96); }
func st_set_depth(p: addr, v: u64) -> u64 { store(p + 96, v); return v; }

func st_retk(p: addr) -> u64 { return load(p + 104); }
func st_set_retk(p: addr, v: u64) -> u64 { store(p + 104, v); return v; }

func st_retw(p: addr) -> u64 { return load(p + 112); }
func st_set_retw(p: addr, v: u64) -> u64 { store(p + 112, v); return v; }

func st_looplbl(p: addr) -> u64 { return load(p + 120); }
func st_set_looplbl(p: addr, v: u64) -> u64 { store(p + 120, v); return v; }

func st_arena(p: addr) -> addr { return load(p + 128) as addr; }

func st_arenasz(p: addr) -> u64 { return load(p + 136); }

func st_arenaused(p: addr) -> u64 { return load(p + 144); }

func st_slotj(p: addr) -> u64 { return load(p + 152); }
func st_set_slotj(p: addr, v: u64) -> u64 { store(p + 152, v); return v; }

func st_loopdepth(p: addr) -> u64 { return load(p + 160); }
func st_set_loopdepth(p: addr, v: u64) -> u64 { store(p + 160, v); return v; }

func st_retsg(p: addr) -> u64 { return load(p + 168); }
func st_set_retsg(p: addr, v: u64) -> u64 { store(p + 168, v); return v; }

// 当前源文件的根 AST 组句柄。
func st_root(p: addr) -> u64 { return load(p + 176); }
func st_set_root(p: addr, v: u64) -> u64 { store(p + 176, v); return v; }

// 取旧值并把格子加一。
func st_next_tmp(p: addr) -> u64 {
  let n: u64 = load(p + 8);
  store(p + 8, n + 1);
  return n;
}

func st_next_label(p: addr) -> u64 {
  let n: u64 = load(p + 16);
  store(p + 16, n + 1);
  return n;
}

func st_next_slot(p: addr) -> u64 {
  let n: u64 = load(p + 152);
  store(p + 152, n + 1);
  return n;
}

// arena：编译器给自己用的顺序切分内存，回收发生在整个源文件编译结束时
// （本进程一次只编一份源）。
func st_alloc(p: addr, n: u64) -> addr {
  let used: u64 = load(p + 144);
  let cap: u64 = load(p + 136);
  if used + n > cap { return st_fail(p, 3) as addr; }
  store(p + 144, used + n);
  let base: addr = load(p + 128) as addr;
  return base + used;
}

func st_fail(p: addr, code: u64) -> u64 {
  store(p + 32, code);
  return code;
}

func st_ok(p: addr) -> u64 { return load(p + 32); }

// Ty/Val 缓冲都是单文件内的临时量，编译新文件前清空，避免跨文件累计耗尽。
func st_reset_arena(p: addr) -> u64 {
  store(p + 144, 0);
  return 0;
}

// --- 循环帧 -------------------------------------------------------------
// 第 i 帧 64 字节：标签 0、结果槽 8、环境标记 16、参数个数 24、参数槽 32/40/48/56。
func st_lf(p: addr, i: u64) -> addr {
  return st_frame(p) + i * 64;
}

func st_lf_label(f: addr) -> u64 { return load(f + 0); }
func st_set_lf_label(f: addr, v: u64) -> u64 { store(f + 0, v); return v; }

func st_lf_res(f: addr) -> u64 { return load(f + 8); }
func st_set_lf_res(f: addr, v: u64) -> u64 { store(f + 8, v); return v; }

func st_lf_mark(f: addr) -> u64 { return load(f + 16); }
func st_set_lf_mark(f: addr, v: u64) -> u64 { store(f + 16, v); return v; }

func st_lf_np(f: addr) -> u64 { return load(f + 24); }
func st_set_lf_np(f: addr, v: u64) -> u64 { store(f + 24, v); return v; }

func st_lf_slot(f: addr, i: u64) -> u64 {
  return load(f + 32 + i * 8);
}

func st_set_lf_slot(f: addr, i: u64, v: u64) -> u64 {
  store(f + 32 + i * 8, v);
  return v;
}
