*.lain linguist-language=Clojure
# The self-hosting compiler source must stay LF: the frozen bootstrap
# frontend scans by \n and a CRLF working-tree copy corrupts gen2 output.
src/lainc/lainc.lain text eol=lf
# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff
