import std::dynarray;

struct RawToken {
    kind: i32,
    start: usize,
    len: usize,
    int_val: u64,
}

struct Lexer {
    src_ptr: *const u8,
    src_len: usize,
    pos: usize,
}

struct LexResult {
    tok: RawToken,
    next: Lexer,
}

pub fn make_lexer(src: *const u8, len: usize) -> Lexer {
    Lexer { src_ptr: src, src_len: len, pos: 0 }
}
