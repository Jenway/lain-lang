{
  "name": "tree-sitter-lain",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Lain programming language",
  "main": "bindings/node",
  "keywords": [
    "tree-sitter",
    "lain"
  ],
  "tree-sitter": [
    {
      "scope": "source.lain",
      "file-types": [
        "lain"
      ],
      "highlights": "queries/highlights.scm",
      "brackets": "queries/brackets.scm"
    }
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.27.0"
  }
}
