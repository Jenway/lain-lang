// 字符串字面量的内联形态：能当表达式值返回、进 if 分支、作实参。
func greet() -> addr {
  return "hi";
}
func pick(b: bool) -> addr {
  if b {
    return "yes";
  } else {
    return "no";
  }
}
func echo(s: addr) -> addr {
  return s;
}
func start() -> addr {
  return echo("inline");
}

// 内联字符串的首字节 'h'。
func first_byte() -> u8 {
  let s: addr = "hi";
  let b: u8 = load(s);
  return b;
}
