// 引用 / 切片类型：ref / mut ref / slice。
struct Slot { v: u64 }

func deref(p: ref u64) -> u64 {
  return load(p);
}
func set(p: mut ref u64, v: u64) -> u64 {
  store(p, v);
  return v;
}
func make_slice(b: addr, n: u64) -> slice u8 {
  return slice_of(b, n);
}
// 引用指向栈上的聚合局部（`ref u64` 在 IR 里就是 #addr）。
func via_ref() -> u64 {
  let slot: Slot = Slot { v: 42 };
  let r: ref u64 = ref_of(slot);
  return load(r);
}

// 引用当地址用：写入后再读回。
func local_set() -> u64 {
  let slot: Slot = Slot { v: 0 };
  let p: addr = ref_of(slot);
  store(p, 5);
  return load(p);
}
