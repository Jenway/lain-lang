// genunify.lain —— ?{} 编译期形参解析、实参类型模式合一与单态化缓存。
// 单向依赖 state/ast/sym/agg/modules/tyreg/ctypes/ctfor/ctprim/ctfn/given。
let st = import("state");
let ax = import("ast");
let s = import("sym");
let agg = import("agg");
let ireg = import("tyreg");
let ct = import("ctypes");
let ctf = import("ctfor");
let ctp = import("ctprim");
let ctfn = import("ctfn");

// 编译期形参项 24B：[name@0, ty_start@8, ty_end@16]；最多 8 项。
func ct_skip_ty(qg: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(qg);
  if i >= n { return i; }
  if ax.is_comma(qg, i) == 1 { return i; }
  return ct_skip_ty(qg, i + 1);
}

func parse_ctparams(k: addr, qg: u64, i: u64, out: addr, idx: u64) -> u64 {
  let n: u64 = ax.n_count(qg);
  if i >= n { return idx; }
  if ax.is_comma(qg, i) == 1 { return parse_ctparams(k, qg, i + 1, out, idx); }
  if idx >= 8 { ctf.fail_msg(k, "too many comptime params", 24, ax.e_ast()); return idx; }
  if ax.is_name(qg, i) == 0 or ctf.has_tok(qg, i + 1, s.p_colon()) == 0 {
    ctf.fail_msg(k, "bad comptime param", 18, ax.e_ast());
    return idx;
  }
  let te: u64 = ct_skip_ty(qg, i + 2);
  let p: addr = out + idx * 24;
  store(p, ax.n_sym(qg, i));
  store(p + 8, i + 2);
  store(p + 16, te);
  return parse_ctparams(k, qg, te, out, idx + 1);
}

func ct_find(ctp_tbl: addr, nct: u64, name: u64, i: u64) -> u64 {
  if i >= nct { return 999; }
  if load(ctp_tbl + i * 24) == name { return i; }
  return ct_find(ctp_tbl, nct, name, i + 1);
}

// --- 类型模式合一 ---------------------------------------------------------
func bind_or_check(k: addr, idx: u64, kind: u64, val: u64, vals: addr, bound: addr) -> u64 {
  let b0: u64 = load(bound + idx * 8);
  if b0 == 1 {
    let slot: addr = vals + idx * 24;
    let sk: u64 = load(slot);
    let sv: u64 = load(slot + 8);
    if sk != kind or sv != val {
      ctf.fail_msg(k, "type inference conflict", 23, ax.e_type());
      return 0;
    }
    return 1;
  }
  let slot: addr = vals + idx * 24;
  store(slot, kind); store(slot + 8, val); store(slot + 16, 0);
  store(bound + idx * 8, 1);
  return 1;
}

func ast_has_unbound(g: u64, i: u64, end: u64, ctp_tbl: addr, nct: u64, bound: addr) -> u64 {
  if i >= end { return 0; }
  if ax.is_group(g, i) == 1 {
    let sub: u64 = ax.n_at(g, i);
    if ast_has_unbound(sub, 0, ax.n_count(sub), ctp_tbl, nct, bound) == 1 { return 1; }
  } else {
    if ax.is_name(g, i) == 1 {
      let idx: u64 = ct_find(ctp_tbl, nct, ax.n_sym(g, i), 0);
      if idx != 999 {
        let bd: u64 = load(bound + idx * 8);
        if bd == 0 { return 1; }
      }
    }
  }
  return ast_has_unbound(g, i + 1, end, ctp_tbl, nct, bound);
}

func unify_wrap(k: addr, pg: u64, i: u64, end: u64, want_sk: u64, arg_tid: u64, ctp_tbl: addr, nct: u64, vals: addr, bound: addr) -> u64 {
  let sh: u64 = ireg.ty_shape(k, arg_tid);
  if sh == 0 or agg.shp_kind(sh) != want_sk { return 0; }
  let elem: u64 = ct.elem_tid(k, sh);
  let grp: u64 = ax.n_at(pg, i + 1);
  return unify_type(k, grp, 0, ax.n_count(grp), elem, ctp_tbl, nct, vals, bound);
}

func unify_type(k: addr, pg: u64, i: u64, end: u64, arg_tid: u64, ctp_tbl: addr, nct: u64, vals: addr, bound: addr) -> u64 {
  if i >= end { return 1; }
  if ax.is_name(pg, i) == 1 and i + 1 == end {
    let nm: u64 = ax.n_sym(pg, i);
    let idx: u64 = ct_find(ctp_tbl, nct, nm, 0);
    if idx != 999 { return bind_or_check(k, idx, 1, arg_tid, vals, bound); }
    return 1;
  }
  if ax.is_name(pg, i) == 1 and ctf.has_delim(pg, i + 1, ax.dl_paren()) == 1 {
    let nm: u64 = ax.n_sym(pg, i);
    if nm == s.t_ref() { return unify_wrap(k, pg, i, end, agg.kind_ref(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_mut() { return unify_wrap(k, pg, i, end, agg.kind_mut(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_slice() { return unify_wrap(k, pg, i, end, agg.kind_slice(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_mutslice() { return unify_wrap(k, pg, i, end, agg.kind_mutslice(), arg_tid, ctp_tbl, nct, vals, bound); }
    if nm == s.t_array() {
      let sh: u64 = ireg.ty_shape(k, arg_tid);
      if sh == 0 or agg.shp_kind(sh) != agg.kind_array() { return 0; }
      let grp: u64 = ax.n_at(pg, i + 1);
      let gn: u64 = ax.n_count(grp);
      if gn < 3 { return 0; }
      let cj: u64 = ctf.has_tok(grp, gn - 2, s.p_comma());
      let cidx: u64 = if cj == 1 { gn - 1 } else { gn };
      let elem: u64 = ct.elem_tid(k, sh);
      unify_type(k, grp, 0, gn - 2, elem, ctp_tbl, nct, vals, bound);
      if st.st_ok(k) != 0 { return 0; }
      if cidx < gn and ax.is_name(grp, cidx) == 1 {
        let ni: u64 = ct_find(ctp_tbl, nct, ax.n_sym(grp, cidx), 0);
        if ni != 999 { return bind_or_check(k, ni, 0, agg.shp_len(sh), vals, bound); }
      }
      return 1;
    }
  }
  return 1;
}

// --- 单态化缓存（存在 st_genblk +24/+32，每条 288 字节） --------------------
// [tpl_e@0, nct@8, mangled_q@16, concrete_sg@24, vals(8*24B)@32]
func wrec_eq(w1: addr, w2: addr) -> u64 {
  if w1 as u64 == w2 as u64 { return 1; }
  let n1: u64 = load(w1); let n2: u64 = load(w2);
  if n1 != n2 { return 0; }
  let i: u64 = loop w(i: u64 = 0) while i < n1 {
    let f1: addr = w1 + 8 + i * 32;
    let f2: addr = w2 + 8 + i * 32;
    let n1: u64 = load(f1); let n2: u64 = load(f2);
    let k1: u64 = load(f1 + 8); let k2: u64 = load(f2 + 8);
    let a1: u64 = load(f1 + 16); let a2: u64 = load(f2 + 16);
    if n1 != n2 or k1 != k2 or a1 != a2 { return 0; }
    if k1 == 7 {
      let p1: u64 = load(f1 + 24); let p2: u64 = load(f2 + 24);
      if wrec_eq(p1 as addr, p2 as addr) == 0 { return 0; }
    }
    i = i + 1;
  };
  return 1;
}

func val_eq(v1: addr, v2: addr) -> u64 {
  let k1: u64 = load(v1); let k2: u64 = load(v2);
  let a1: u64 = load(v1 + 8); let a2: u64 = load(v2 + 8);
  if k1 != k2 or a1 != a2 { return 0; }
  if k1 == 7 {
    let p1: u64 = load(v1 + 16); let p2: u64 = load(v2 + 16);
    return wrec_eq(p1 as addr, p2 as addr);
  }
  return 1;
}

func vals_eq(v1: addr, v2: addr, i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  if val_eq(v1 + i * 24, v2 + i * 24) == 0 { return 0; }
  return vals_eq(v1, v2, i + 1, n);
}

func cache_find(k: addr, tpl_e: u64, nct: u64, vals: addr) -> addr {
  let gb: addr = st.st_genblk(k);
  let bu: u64 = load(gb + 24);
  if bu == 0 { return 0 as addr; }
  let base: addr = bu as addr;
  let n: u64 = load(gb + 32);
  let i: u64 = loop sc(i: u64 = 0) while i < n {
    let rec: addr = base + i * 288;
    let rt: u64 = load(rec); let rn: u64 = load(rec + 8);
    if rt == tpl_e and rn == nct {
      if vals_eq(rec + 32, vals, 0, nct) == 1 { return rec; }
    }
    i = i + 1;
  };
  return 0 as addr;
}

func cache_base(k: addr) -> addr {
  let gb: addr = st.st_genblk(k);
  let b0u: u64 = load(gb + 24);
  if b0u != 0 { return b0u as addr; }
  let csz: u64 = 288 * 128;
  let nb: addr = st.st_ralloc(k, csz);
  store(gb + 24, nb as u64);
  return nb;
}

func cache_put(k: addr, tpl_e: u64, nct: u64, q: u64, sg: addr, vals: addr) -> u64 {
  let gb: addr = st.st_genblk(k);
  let base: addr = cache_base(k);
  let n: u64 = load(gb + 32);
  if n >= 128 { ctf.fail_msg(k, "mono cache full", 15, ax.e_ast()); return 0; }
  let rec: addr = base + n * 288;
  store(rec, tpl_e); store(rec + 8, nct);
  store(rec + 16, q); store(rec + 24, sg as u64);
  let i: u64 = loop cp(i: u64 = 0) while i < nct {
    let dst: addr = rec + 32 + i * 24;
    let src: addr = vals + i * 24;
    let s0: u64 = load(src); let s1: u64 = load(src + 8); let s2: u64 = load(src + 16);
    store(dst, s0); store(dst + 8, s1); store(dst + 16, s2);
    i = i + 1;
  };
  store(gb + 32, n + 1);
  return 1;
}
