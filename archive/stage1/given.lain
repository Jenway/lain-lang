// given.lain —— Witness 实例求值、given 作用域栈与歧义校验、Witness 成员解析。
// 单向依赖 state/types/ast/sym/agg/ir/modules/tyreg/ctfor/ctprim/ctfn。
let st = import("state");
let ty = import("types");
let ax = import("ast");
let s = import("sym");
let agg = import("agg");
let modules = import("modules");
let ireg = import("tyreg");
let ctf = import("ctfor");
let ctp = import("ctprim");
let ctfn = import("ctfn");

// --- given 栈（存在 st_genblk +0/+8/+16，每条 40 字节） --------------------
// [name@0, tid@8, wrec@16, depth@24, implicit@32]
func g_base(k: addr) -> addr {
  let gb: addr = st.st_genblk(k);
  let p: addr = load(gb) as addr;
  if p as u64 != 0 { return p; }
  let np: addr = st.st_ralloc(k, 5120);
  store(gb, np as u64);
  return np;
}
func g_used(k: addr) -> u64 { return load(st.st_genblk(k) + 8); }
func g_set_used(k: addr, v: u64) -> u64 { store(st.st_genblk(k) + 8, v); return v; }
func g_depth(k: addr) -> u64 { return load(st.st_genblk(k) + 16); }
func g_set_depth(k: addr, v: u64) -> u64 { store(st.st_genblk(k) + 16, v); return v; }

func mark(k: addr) -> u64 {
  let d: u64 = g_depth(k);
  g_set_depth(k, d + 1);
  return g_used(k);
}

func release(k: addr, m: u64) -> u64 {
  let d: u64 = g_depth(k);
  if d > 0 { g_set_depth(k, d - 1); }
  return g_set_used(k, m);
}

func push_given(k: addr, name: u64, tid: u64, wrec: u64, implicit: u64) -> u64 {
  let u: u64 = g_used(k);
  if u + 40 > 5120 { ctf.fail_msg(k, "given table full", 16, ax.e_ast()); return 0; }
  let p: addr = g_base(k) + u;
  store(p, name);
  store(p + 8, tid);
  store(p + 16, wrec);
  store(p + 24, g_depth(k));
  store(p + 32, implicit);
  return g_set_used(k, u + 40);
}

func find_name_scan(base: addr, name: u64, u: u64) -> addr {
  if u == 0 { return 0 as addr; }
  let back: u64 = u - 40;
  let p: addr = base + back;
  if load(p) == name { return p; }
  return find_name_scan(base, name, back);
}

func find_by_name(k: addr, name: u64) -> addr {
  return find_name_scan(g_base(k), name, g_used(k));
}

func find_imp_scan(k: addr, base: addr, tid: u64, u: u64, hit_d: u64, hit_p: addr) -> addr {
  if u == 0 { return hit_p; }
  let back: u64 = u - 40;
  let p: addr = base + back;
  let imp: u64 = load(p + 32);
  let rt: u64 = load(p + 8);
  let dp: u64 = load(p + 24);
  if hit_p as u64 != 0 {
    if dp < hit_d { return hit_p; }
    if imp == 1 and rt == tid {
      ctf.fail_msg(k, "ambiguous given instance", 24, ax.e_type());
      return 0 as addr;
    }
    return find_imp_scan(k, base, tid, back, hit_d, hit_p);
  }
  if imp == 1 and rt == tid { return find_imp_scan(k, base, tid, back, dp, p); }
  return find_imp_scan(k, base, tid, back, hit_d, hit_p);
}

func find_implicit(k: addr, tid: u64) -> addr {
  let hit: addr = find_imp_scan(k, g_base(k), tid, g_used(k), 0, 0 as addr);
  if st.st_ok(k) != 0 { return 0 as addr; }
  if hit as u64 == 0 { ctf.fail_msg(k, "missing given instance", 22, ax.e_type()); return 0 as addr; }
  return hit;
}

// --- Witness 构造与求值 --------------------------------------------------
// wrec：[nfields@0, field0..]，每字段 32B：[fname@0, fkind@8, fa@16, fb@24]
func wrec_find(wrec: addr, fname: u64, i: u64, n: u64) -> addr {
  if i >= n { return 0 as addr; }
  let f: addr = wrec + 8 + i * 32;
  if load(f) == fname { return f; }
  return wrec_find(wrec, fname, i + 1, n);
}

func wrec_lookup(wrec: addr, fname: u64) -> addr {
  let nf: u64 = load(wrec);
  return wrec_find(wrec, fname, 0, nf);
}

func parse_wfields(k: addr, sh: u64, fg: u64, i: u64, wrec: addr, idx: u64) -> u64 {
  let n: u64 = ax.n_count(fg);
  if i >= n { store(wrec, idx); return idx; }
  if ax.is_comma(fg, i) == 1 { return parse_wfields(k, sh, fg, i + 1, wrec, idx); }
  if ax.is_name(fg, i) == 0 { ctf.fail_msg(k, "expected field name", 19, ax.e_ast()); return idx; }
  let fname: u64 = ax.n_sym(fg, i);
  if agg.mem_find(sh, fname) as u64 == 0 { ctf.fail_msg(k, "unknown witness field", 21, ax.e_type()); return idx; }
  if ctf.has_tok(fg, i + 1, s.p_colon()) == 0 { ctf.fail_msg(k, "expected colon", 14, ax.e_ast()); return idx; }
  let fv: addr = st.st_alloc(k, 24);
  let nj: u64 = eval_witness(k, fg, i + 2, fv);
  if st.st_ok(k) != 0 { return idx; }
  let slot: addr = wrec + 8 + idx * 32;
  store(slot, fname);
  store(slot + 8, ctf.v_kind(fv));
  store(slot + 16, ctf.v_a(fv));
  store(slot + 24, ctf.v_b(fv));
  return parse_wfields(k, sh, fg, nj, wrec, idx + 1);
}

func make_witness(k: addr, tid: u64, fg: u64, out: addr) -> u64 {
  let sh: u64 = ireg.ty_shape(k, tid);
  if sh == 0 or agg.shp_kind(sh) != agg.kind_struct() {
    ctf.fail_msg(k, "witness needs struct", 20, ax.e_type());
    return 0;
  }
  let nf: u64 = agg.shp_count(sh);
  let wsz: u64 = 8 + nf * 32 + 64;
  let wrec: addr = st.st_ralloc(k, wsz);
  parse_wfields(k, sh, fg, 0, wrec, 0);
  if st.st_ok(k) != 0 { return 0; }
  let wu: u64 = wrec as u64;
  ctf.v_set(out, 7, tid, wu);
  return 1;
}

func eval_witness(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { ctf.fail_msg(k, "empty witness expr", 18, ax.e_ast()); return i; }
  // 1) Name(args...) { fields... }
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_paren()) == 1 {
      if ctf.has_delim(g, i + 2, ax.dl_brace()) == 1 {
        let tv: addr = st.st_alloc(k, 24);
        let j: u64 = ctfn.eval_factory_call(k, g, i, tv);
        if j != 0 {
          if st.st_ok(k) != 0 { return i + 3; }
          make_witness(k, ctp.as_type(k, tv), ax.n_at(g, i + 2), out);
          return i + 3;
        }
      }
    }
  }
  // 2) StructName { fields... }
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_brace()) == 1 {
      let se: addr = modules.find_here(k, ax.n_sym(g, i));
      if se as u64 != 0 {
        if modules.sym_kind(se) == modules.sym_kind_struct() {
          let tid: u64 = ctf.tid_of_shape(k, modules.sym_shape(se));
          make_witness(k, tid, ax.n_at(g, i + 1), out);
          return i + 2;
        }
      }
    }
  }
  // 3) 命名 given 引用、过程名引用、或常规编译期表达式
  if ax.is_name(g, i) == 1 {
    if ctf.has_delim(g, i + 1, ax.dl_paren()) == 0 {
      let nm: u64 = ax.n_sym(g, i);
      let bv: addr = ctf.lookup(k, nm);
      if bv as u64 != 0 {
        ctf.v_set(out, ctf.v_kind(bv), ctf.v_a(bv), ctf.v_b(bv));
        return i + 1;
      }
      let ge: addr = find_by_name(k, nm);
      if ge as u64 != 0 {
        let gt: u64 = load(ge + 8); let gw: u64 = load(ge + 16);
        ctf.v_set(out, 7, gt, gw);
        return i + 1;
      }
      let se2: addr = modules.find_here(k, nm);
      if se2 as u64 != 0 {
        let kd: u64 = modules.sym_kind(se2);
        if kd == modules.sym_kind_func() or kd == modules.sym_kind_extern() {
          let seu: u64 = se2 as u64;
          ctf.v_set(out, 8, seu, 0);
          return i + 1;
        }
      }
    }
  }
  return ctfn.ct_eval(k, g, i, 0, out);
}

// --- 编译期/运行期查询 Witness 成员 --------------------------------------
// 若 g[i] 是编译期 Witness 绑定且 g[i+1] == '.'，返回其字段记录地址，否则 0。
func witness_field_at(k: addr, g: u64, i: u64) -> addr {
  if ax.is_name(g, i) == 0 { return 0 as addr; }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 0 { return 0 as addr; }
  if i + 2 >= ax.n_count(g) { return 0 as addr; }
  if ax.is_name(g, i + 2) == 0 { return 0 as addr; }
  let bv: addr = ctf.lookup(k, ax.n_sym(g, i));
  if bv as u64 == 0 { return 0 as addr; }
  if ctf.v_kind(bv) != 7 { return 0 as addr; }
  let wrec: addr = ctf.v_b(bv) as addr;
  let fld: addr = wrec_lookup(wrec, ax.n_sym(g, i + 2));
  if fld as u64 == 0 { ctf.fail_msg(k, "no such witness field", 21, ax.e_type()); return 0 as addr; }
  return fld;
}

func parse_want_tid(k: addr, g: u64, j0: u64) -> u64 {
  if ctf.has_tok(g, j0, s.p_colon()) == 0 { return 0; }
  let tv: addr = st.st_alloc(k, 24);
  let tj: u64 = ctfn.ct_eval(k, g, j0 + 1, 0, tv);
  if st.st_ok(k) != 0 { return 0; }
  return ctp.as_type(k, tv);
}

// 登记 given / 编译期 witness let 声明：decl_i 指向 given 或 let。
func reg_given(k: addr, g: u64, decl_i: u64, implicit: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if decl_i + 1 >= n {
    ctf.fail_msg(k, "expected given name", 19, ax.e_ast());
    return decl_i + 1;
  }
  if ax.is_name(g, decl_i + 1) == 0 {
    ctf.fail_msg(k, "expected given name", 19, ax.e_ast());
    return decl_i + 1;
  }
  let nm: u64 = ax.n_sym(g, decl_i + 1);
  let j0: u64 = decl_i + 2;
  let want_tid: u64 = parse_want_tid(k, g, j0);
  if st.st_ok(k) != 0 { return j0; }
  let eqi: u64 = ctfn.skip_eq(g, j0);
  if ctf.has_tok(g, eqi, s.p_eq()) == 0 { ctf.fail_msg(k, "expected =", 10, ax.e_ast()); return eqi; }
  let v: addr = st.st_alloc(k, 24);
  let nj: u64 = eval_witness(k, g, eqi + 1, v);
  if st.st_ok(k) != 0 { return ax.skip_semi(g, nj); }
  if ctf.v_kind(v) != 7 { ctf.fail_msg(k, "given needs struct witness", 26, ax.e_type()); return ax.skip_semi(g, nj); }
  let got_tid: u64 = ctf.v_a(v);
  if want_tid != 0 and want_tid != got_tid {
    ctf.fail_msg(k, "given type mismatch", 19, ax.e_type());
    return ax.skip_semi(g, nj);
  }
  push_given(k, nm, got_tid, ctf.v_b(v), implicit);
  return ax.skip_semi(g, nj);
}
