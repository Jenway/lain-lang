// 符号：关键字、标点、运算符与基础类型名的 SymId。
// lain2_sym_intern 幂等：重复驻留同一个名字拿回同一个句柄，
// 所以这些访问器随用随取，不需要缓存表。
extern lain2_sym_intern(p: addr, n: u64) -> u64 = lain2_sym_intern;

func intern(p: addr, n: u64) -> u64 {
  return lain2_sym_intern(p, n);
}

func k_func() -> u64 { return lain2_sym_intern("func", 4); }

func k_let() -> u64 { return lain2_sym_intern("let", 3); }

func k_if() -> u64 { return lain2_sym_intern("if", 2); }

