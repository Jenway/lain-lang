// Canonical compiler namespace.  Historical per-fixture entry points were
// removed; all requests use a capability-specialized compiler core.

let memory_model: Module = import("std::memory_model");
let compiler_core: Module =
    import("packages::lain::compiler::compiler_core");
let lainir_api: Module =
    import("packages::lain::lainir::api_contract");
let lainvm_api: Module =
    import("packages::lain::lainvm::api_contract");

@export
let compiler: Module = std::module {
    @export
    let Compiler = std::func(
        Memory: memory_model.Shape,
        Ir: lainir_api.CapabilitiesShape,
        Vm: lainvm_api.ExecutionShape,
    ) -> Module {
        return compiler_core.Compiler(Memory, Ir, Vm);
    };
};
