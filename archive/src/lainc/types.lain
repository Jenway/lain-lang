// Compile-time type and module values owned by the Lain compiler.
//
// A source module imports this file as one namespace:
//
//   let types: Module = import("packages::lain::compiler::types");
//   let value: types.TypeValue = ...;
//
// TypeId is the identity used by elaboration and specialization.  Runtime
// representation is a separate property and only that representation reaches
// LAIN-IR.

let memory_model: Module = import("std::memory_model");
let meta_std: Module = import("std::meta");

@export
let types: Module = std::module {

    @export
    let TypeId: std::type = usize;

    @export
    let ModuleId: std::type = usize;

    @export
    let NamespaceId: std::type = usize;

    @export
    let TypeKind: std::type = i32;

    @export let Builtins: std::type = meta_std.Builtins;


    @export let TypeValue: std::type = meta_std.TypeValue;


    // A ModuleValue is a compile-time value.  Keep the Meta ABI concrete
    // at this boundary so field projections (module_value.id/namespace) stay
    // visible to the current lowering pass.  The shape mirrors std/meta's
    // canonical value and is converted by the registry APIs below.
    @export
    let ModuleValue: std::type = std::struct {
        id: ModuleId,
        namespace: NamespaceId,
        module_payload: ModuleId,
    };


    // The compiler's unified compile-time value.  Type values and module
    // values keep their registry-backed shapes; every other Meta value
    // (policy scalars, effect arguments) is one tagged payload.
    @export
    let MetaValue: std::type = std::struct {
        kind: usize,
        type_id: TypeId,
        payload: usize,
        valid: bool,
    };

    // Keep the Meta-facing phase scalar concrete.  Re-exporting a factory
    // member type through this compatibility namespace loses its physical
    // width during the current source lowering pass; the std/meta model still
    // owns the phase definition and registry data.
    @export let CallablePhase: std::type = i32;


    @export
    let Registry = std::func(
        Memory: memory_model.Shape,
    ) -> Module {
        let MetaStd: Module = meta_std.Meta(Memory);
        let RegistryState: std::type = MetaStd.TypeRegistry;
        let TypeArgumentVector: std::type = MetaStd.TypeArgumentVector;
        let new = std::func() -> RegistryState
            ! {Memory.Allocation.Effect} {
            return MetaStd.new_type_registry();
        };
        let intern = std::func(
            state: &mut RegistryState,
            kind: TypeKind,
            owner: ModuleId,
            namespace: NamespaceId,
            arguments: &TypeArgumentVector,
        ) -> TypeId ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            return MetaStd.intern_type(
                state,
                kind,
                owner,
                namespace,
                arguments,
            );
        };
        let get = std::func(
            state: &RegistryState,
            id: TypeId,
        ) -> &TypeValue ! {Memory.Bounds.Effect} {
            return MetaStd.get_type(state, id);
        };
        let intern_module = std::func(
            state: &mut RegistryState,
            id: ModuleId,
            namespace: NamespaceId,
        ) -> usize ! {
            Memory.Allocation.Effect,
            Memory.Bounds.Effect,
        } {
            return MetaStd.intern_module(state, id, namespace);
        };
        return std::module {
            @export let State: std::type = RegistryState;
            @export let TypeArgumentVector: std::type = TypeArgumentVector;
            @export let new = new;
            @export let intern = intern;
            @export let get = get;
            @export let intern_module = intern_module;
            @export
            let invalid_namespace = std::func() -> NamespaceId {
                return 0;
            };
        };
    };


    @export
    let kind_builtin = std::func() -> TypeKind { return 1; };

    @export
    let kind_comptime = std::func() -> TypeKind { return 2; };

    @export
    let kind_nominal = std::func() -> TypeKind { return 3; };

    @export
    let kind_specialized = std::func() -> TypeKind { return 4; };


    @export
    let same_meta_value = std::func(
        left: &MetaValue,
        right: &MetaValue,
    ) -> bool {
        if !left.valid || !right.valid { return false; }
        if left.type_id != right.type_id { return false; }
        if left.kind != right.kind { return false; }
        return left.payload == right.payload;
    };


    @export
    let callable_phase_meta = std::func() -> CallablePhase {
        return 1;
    };

    @export
    let callable_phase_comptime = std::func() -> CallablePhase {
        return 2;
    };

    @export
    let callable_phase_runtime = std::func() -> CallablePhase {
        return 3;
    };
};
