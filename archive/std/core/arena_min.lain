let effects: Module = import("std::effect");
let allocation: Module = import("std::allocation");
@export
let arena_min: Module = std::module {
  @export let Policy: allocation.Policy = std::module {
    @export let Block: std::type = addr;
    @export let Effect: effects.Effect = allocation.Alloc(Policy);
    @export let empty = std::func() -> Block { return 0 as addr; };
    @export let is_empty = std::func(block: Block) -> bool { return block == (0 as addr); };
    @export let address = std::func(block: Block) -> addr { return block; };
    @export let allocate = std::effect_operation(Effect, "allocate", std::func(size: usize, alignment: usize) -> Block);
    @export let resize = std::effect_operation(Effect, "resize", std::func(block: Block, size: usize, alignment: usize) -> Block);
    @export let release = std::effect_operation(Effect, "release", std::func(block: Block) -> unit);
    @export let capacity_overflow = std::effect_operation(Effect, "capacity_overflow", std::func() -> never);
  };
};
