// std/effect.lain
//
// Generic Meta facilities for declaring, applying and handling effects.
// Concrete effects belong to domain modules such as std::allocation,
// std::bounds and std::platform.

@export
let effect: Module = std::module {
    @export
    let EffectKind: std::type = i32;

    @export
    let Pure: EffectKind = 0;

    @export
    let Allocation: EffectKind = 1;

    @export
    let Bounds: EffectKind = 2;

    @export
    let Host: EffectKind = 3;

    @export
    let effect_allowed = std::func(
        required: EffectKind,
        provided: EffectKind,
    ) -> bool {
        if required == 0 { return true; }
        return required == provided;
    };

    @export
    let capability_id = std::func(kind: EffectKind) -> usize {
        if kind == 1 { return 10; }
        if kind == 2 { return 20; }
        if kind == 3 { return 30; }
        return 0;
    };

    @export
    let propagated_effect = std::func(
        local: EffectKind,
        child: EffectKind,
    ) -> EffectKind {
        if local != 0 { return local; }
        return child;
    };

    @export
    let Effect: std::type = std::meta_type("Effect");

    @export
    let EffectSet: std::type = std::meta_type("EffectSet");

    @export
    let Handler = std::func(
        Handled: Effect,
        Remaining: EffectSet,
    ) -> std::type {
        return std::handler_type(Handled, Remaining);
    };

    @export
    let Throws = std::func(
        Error: std::type,
    ) -> Effect {
        return std::effect("Throws", Error);
    };

    @export
    let Trap: Effect = std::effect("Trap");

    @export
    let RawMemory: Effect = std::effect("RawMemory");
};
