// Semantic conversion policy for Meta type values.
//
// `std::type` is reserved for the Meta type of all type values.  This module
// contains only the conversion rule still consumed by std::meta.

@export
let type_policy: Module = std::module {
    @export
    let strict_conversion = std::func(
        from_kind: i32,
        to_kind: i32,
        explicit: bool,
    ) -> bool {
        if from_kind == to_kind { return true; }
        if from_kind == 3 && to_kind == 1 && explicit { return true; }
        return false;
    };
};
