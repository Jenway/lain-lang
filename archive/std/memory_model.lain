// Bundle allocation, bounds and their derived collection types into one
// compile-time Module value.

let allocation: Module = import("std::allocation");
let bounds: Module = import("std::bounds");
let vector: Module = import("std::core::vec");
let string: Module = import("std::core::string");

@export
let memory_model: Module = std::module {
    @export
    let Shape: ModuleShape = std::module_shape {
        let Allocation: allocation.Policy;
        let Bounds: bounds.Policy;
        let Bytes: std::type;
        let String: std::type;
    };

    @export
    let Model = std::func(
        Allocation: allocation.Policy,
        Bounds: bounds.Policy,
    ) -> Module {
        let Bytes: std::type = vector.Vec(
            i32,
            Allocation,
            Bounds,
        );
        let String: std::type = string.String(
            Allocation,
            Bounds,
        );

        return std::module {
            @export
            let Allocation: allocation.Policy = Allocation;

            @export
            let Bounds: bounds.Policy = Bounds;

            @export
            let Bytes: std::type = Bytes;

            @export
            let String: std::type = String;

        };
    };
};
