// std/backend.lain
//
// Backend input contract.  These records are Meta-owned facts; a backend may
// reject an unknown target/ABI before it asks the host to emit or link files.

@export
let backend: Module = std::module {
    @export let TargetKind: std::type = i32;
    @export let Native: TargetKind = 1;
    @export let LainIR: TargetKind = 2;
    @export let CBridge: TargetKind = 3;

    @export let CallingConvention: std::type = i32;
    @export let C: CallingConvention = 1;
    @export let Lain: CallingConvention = 2;

    @export let Endian: std::type = i32;
    @export let Little: Endian = 1;
    @export let Big: Endian = 2;

    @export
    let DataLayout: std::type = std::struct {
        pointer_width: usize,
        pointer_alignment: usize,
        endian: Endian,
    };

    @export
    let Target: std::type = std::struct {
        identity: usize,
        kind: TargetKind,
        data: DataLayout,
        calling_convention: CallingConvention,
    };

    @export
    let Extern: std::type = std::struct {
        identity: usize,
        capability: usize,
        resolved: bool,
    };

    @export
    let Function: std::type = std::struct {
        identity: usize,
        parameter_count: usize,
        return_width: usize,
        body_id: usize,
    };

    @export
    let Module: std::type = std::struct {
        identity: usize,
        function_count: usize,
        extern_count: usize,
        target_identity: usize,
    };

    // 0 means valid; non-zero values are stable diagnostic categories.
    @export
    let validate_target = std::func(
        kind: TargetKind,
        pointer_width: usize,
        pointer_alignment: usize,
        convention: CallingConvention,
    ) -> i32 {
        if kind != Native && kind != LainIR && kind != CBridge { return 4101; }
        if pointer_width != 32 && pointer_width != 64 { return 4102; }
        if pointer_alignment == 0 || pointer_alignment > pointer_width { return 4103; }
        if convention != C && convention != Lain { return 4104; }
        return 0;
    };

    @export
    let validate_extern = std::func(
        resolved: bool,
        capability: usize,
    ) -> i32 {
        if resolved == false { return 4201; }
        if capability == 0 { return 4202; }
        return 0;
    };

    @export
    let diagnostic_severity = std::func(code: i32) -> i32 {
        if code >= 4000 && code < 4200 { return 2; }
        if code >= 4200 && code < 4300 { return 3; }
        return 1;
    };

    @export
    let capability_required = std::func(kind: TargetKind) -> usize {
        if kind == Native { return 30; }
        if kind == CBridge { return 20; }
        return 0;
    };
};
