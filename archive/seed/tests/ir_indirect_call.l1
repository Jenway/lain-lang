#proc add(%a: #bits<64>, %b: #bits<64>) -> #bits<64> {
  %r = #add[#bits<64>](%a, %b)
  #return %r
}

#proc one(%a: #bits<64>) -> #bits<64> {
  %r = #add[#bits<64>](%a, 1)
  #return %r
}

#proc zero() -> #bits<64> {
  #return 42
}

#proc run_zero() -> #bits<64> {
  %p = #bitcast[#addr](@zero)
  %r = #call[() -> #bits<64>](%p)
  #return %r
}

#proc run_add() -> #bits<64> {
  %p = #bitcast[#addr](@add)
  %r = #call[(#bits<64>, #bits<64>) -> #bits<64>](%p, 5, 7)
  #return %r
}

#proc run_tail(%a: #bits<64>) -> #bits<64> {
  %p = #bitcast[#addr](@one)
  %r = #call[tail] [(#bits<64>) -> #bits<64>](%p, %a)
  #return %r
}
