// test.lain —— 根目录库级测试入口（类比 `go test ./...`）。
// 聚合标准库与编译器核心套件，通过 `std::test` 输出统一 PASS/FAIL 汇总。
let io = import("std::io");
let os = import("std::os");
let t = import("std::test");
let col = import("std::collections");
let bld = import("std::build");
let fmt = import("std::fmt");
let opt = import("std::option");
let mem = import("std::mem");
let sync = import("std::sync");
let thread = import("std::thread");
let pool = import("std::pool");
let sched = import("std::sched");
let meta = import("std::meta");
let ir_test = import("tests::ir_verify_test");

use bld;
open mem;
use mem.SystemAlloc;

let Vec64 = col.ArenaVec(u64, 16);
let Map64 = col.HashMapU64(u64, 32);
let OptI64 = opt.Option(i64);

// --- 语言核心覆盖：match 穷尽性、定长数组与切片、字符串转义、UFCS ---
let LangOpt = enum {
  Some(i64)
  None
};

let unwrap_plus_one = func(o: LangOpt) -> i64 {
  let value: i64 = match o {
    Some(x) => x + 1,
    None => 0,
  };
  return value;
};

let sum_u64_slice = func(s: Slice(u64)) -> u64 {
  let n: u64 = s.len;
  let acc: u64 = loop su(i: u64 = 0, acc: u64 = 0) while i < n {
    acc = acc + s[i];
    i = i + 1;
  };
  return acc;
};

let sum_u8_slice = func(s: Slice(u8)) -> u64 {
  let n: u64 = s.len;
  let acc: u64 = loop sb(i: u64 = 0, acc: u64 = 0) while i < n {
    let c: u8 = s[i];
    acc = acc + (c as u64);
    i = i + 1;
  };
  return acc;
};

let array_head_tail = func(a: Array(u64, 4)) -> u64 {
  let s: Slice(u64) = slice_of(a);
  return s[0] + s[3];
};

let LangI64 = module {
  pub let Self = i64;

  pub let twice = func(self: i64) -> i64 { return self * 2; };

  pub let peek = func(self: Ref(i64)) -> i64 { return deref(self); };

  pub let bump = func(self: Mut(i64)) -> i64 {
    let cur: i64 = deref(self);
    deref(self) = cur + 1;
    return deref(self);
  };
};

let LangVec2 = struct { x: i64, y: i64 };

let LangVec2Ops = module {
  pub let Self = LangVec2;

  pub let len2 = func(v: Self) -> i64 {
    return (v.x * v.x) + (v.y * v.y);
  };

  pub let get_x = func(v: Ref(Self)) -> i64 {
    return deref(v).x;
  };

  pub let add_x = func(v: Mut(Self), delta: i64) -> i64 {
    deref(v).x = deref(v).x + delta;
    return deref(v).x;
  };
};

use LangI64;
use LangVec2Ops;

// --- 语言核心覆盖：中止性效应与词法尾恢复效应 ---
let LangDbError = enum {
  Timeout
  Corrupted
};

let LangError = func(E: Type) -> Effect {
  return effect { op raise(err: E) -> Never; };
};

let LangCancel = effect {
  op cancel() -> Never;
};

let lang_load = func(id: i64) -> i64 !{ LangError(LangDbError) } {
  return id * 2;
};

let lang_fetch = func(id: i64, mode: i64) -> i64 !{ LangError(LangDbError), LangCancel } {
  if mode == 1 {
    perform LangError(LangDbError).raise(LangDbError.Corrupted);
  }
  if mode == 2 {
    perform LangCancel.cancel();
  }
  return lang_load(id)!;
};

let lang_classify = func(id: i64, mode: i64) -> i64 {
  return handle lang_fetch(id, mode) with {
    return(v) => v,
    raise(e) => 80,
    cancel() => 20,
  };
};

let LangYield = func(T: Type) -> Effect {
  return effect { op emit(val: T) -> i64; };
};

let lang_produce = func() -> i64 !{ LangYield(i64) } {
  let a: i64 = perform LangYield(i64).emit(10);
  let b: i64 = perform LangYield(i64).emit(20);
  return a + b;
};

let lang_yield_run = func() -> i64 {
  return handle lang_produce() with {
    return(v) => v,
    emit(v) => resume(v * 2),
  };
};

let run_collections_suite = func() -> i64 {
  let st: t.Suite = t.suite("std::collections");
  let v: Vec64.Vec = Vec64.new();
  Vec64.push(mut_of(v), 10);
  Vec64.push(mut_of(v), 20);
  Vec64.push(mut_of(v), 30);
  t.eq_u64(mut_of(st), "vec count", Vec64.count(ref_of(v)), 3);
  t.eq_u64(mut_of(st), "vec get[1]", Vec64.get(ref_of(v), 1), 20);
  Vec64.set(mut_of(v), 1, 99);
  t.eq_u64(mut_of(st), "vec set[1]", Vec64.get(ref_of(v), 1), 99);
  Vec64.clear(mut_of(v));
  t.eq_u64(mut_of(st), "vec clear", Vec64.count(ref_of(v)), 0);

  let m: Map64.Map = Map64.new();
  Map64.put(mut_of(m), 101, 42);
  Map64.put(mut_of(m), 202, 84);
  t.eq_u64(mut_of(st), "map count", Map64.count(ref_of(m)), 2);
  t.eq_u64(mut_of(st), "map has 101", Map64.has(ref_of(m), 101), 1);
  t.eq_u64(mut_of(st), "map has 999", Map64.has(ref_of(m), 999), 0);
  let out_arr: Array(u64, 1) = [0];
  let ok: u64 = Map64.get(ref_of(m), 202, ptr_cast(Mut(u64), mut_of(out_arr)));
  t.eq_u64(mut_of(st), "map get ok", ok, 1);
  t.eq_u64(mut_of(st), "map get val", out_arr[0], 84);
  return t.finish(mut_of(st));
};

let run_build_suite = func() -> i64 {
  let st: t.Suite = t.suite("std::build");
  let os_l: bld.Os = bld.Os.Linux { };
  let arch_x: bld.Arch = bld.Arch.X86_64 { };
  let opt_r: bld.OptMode = bld.OptMode.ReleaseFast { };
  let env: bld.TargetEnv = bld.TargetEnv {
    os: ref_of(os_l),
    arch: ref_of(arch_x),
    opt: ref_of(opt_r),
  };
  let g: bld.Graph = bld.new_graph(env);
  let lib_id: u64 = g.add_static_lib("core", "src/core.lain", "body1", "iface1");
  let app_id: u64 = g.add_executable("app", "src/entry.lain", "body2", "iface2");
  let linked: u64 = g.link(app_id, lib_id);
  // 每个单元自身一步、每条链接边一步：2 个单元 + 1 条边 = 3
  t.eq_u64(mut_of(st), "graph step_count", g.step_count(), 3);
  t.eq_u64(mut_of(st), "graph edge_count", g.edge_count(), 1);
  t.eq_u64(mut_of(st), "graph link", linked, 1);
  let h1: u64 = bld.fnv1a_bytes("iface_v1");
  let h2: u64 = bld.fnv1a_bytes("iface_v1");
  let h3: u64 = bld.fnv1a_bytes("iface_v2");
  t.eq_u64(mut_of(st), "iface unchanged", bld.interface_unchanged(h1, h2), 1);
  t.eq_u64(mut_of(st), "iface changed", bld.interface_unchanged(h1, h3), 0);
  return t.finish(mut_of(st));
};

let run_os_fmt_suite = func() -> i64 {
  let st: t.Suite = t.suite("std::os_and_fmt");
  let c0: fmt.Cursor = fmt.fmt_begin();
  let c1: fmt.Cursor = fmt.write_str(c0, "lain-");
  let c2: fmt.Cursor = fmt.write_u64(c1, 7);
  let txt: Slice(u8) = fmt.fmt_done(c2);
  t.eq_bytes(mut_of(st), "fmt_done", txt, "lain-7");

  let tmp: Slice(u8) = "build/std_os_probe.tmp";
  let wrc: u64 = os.write_file(tmp, txt);
  t.eq_u64(mut_of(st), "write_file", wrc, 0);
  t.eq_bool(mut_of(st), "file_exists true", os.file_exists(tmp), true);

  let rptr_arr: Array(u64, 1) = [0];
  let rlen_arr: Array(u64, 1) = [0];
  let rrc: u64 = os.read_file(tmp, ptr_cast(Mut(u64), mut_of(rptr_arr)), ptr_cast(Mut(u64), mut_of(rlen_arr)));
  t.eq_u64(mut_of(st), "read_file", rrc, 0);
  let rptr: u64 = rptr_arr[0];
  let rlen: u64 = rlen_arr[0];
  let got: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), rptr), rlen);
  t.eq_bytes(mut_of(st), "read_file bytes", got, "lain-7");
  if rptr != 0 { os.free_bytes(rptr); }

  let drc: u64 = os.remove_file(tmp);
  t.eq_u64(mut_of(st), "remove_file", drc, 0);
  t.eq_bool(mut_of(st), "file_exists false", os.file_exists(tmp), false);
  return t.finish(mut_of(st));
};

let run_option_mem_suite = func() -> i64 {
  let st: t.Suite = t.suite("std::option_and_mem");

  // --- std::option ---
  let some7: OptI64.Opt = OptI64.some(7);
  let no_val: OptI64.Opt = OptI64.none();
  t.eq_bool(mut_of(st), "option some is_some", OptI64.is_some(some7), true);
  t.eq_bool(mut_of(st), "option some is_none", OptI64.is_none(some7), false);
  t.eq_bool(mut_of(st), "option none is_some", OptI64.is_some(no_val), false);
  t.eq_bool(mut_of(st), "option none is_none", OptI64.is_none(no_val), true);
  t.eq_i64(mut_of(st), "option unwrap_or some", OptI64.unwrap_or(some7, -1), 7);
  t.eq_i64(mut_of(st), "option unwrap_or none", OptI64.unwrap_or(no_val, -1), -1);

  // --- std::mem.BumpArena ---
  let arena: mem.BumpArena.Arena = mem.BumpArena.new();
  t.eq_u64(mut_of(st), "arena capacity", mem.BumpArena.capacity(ref_of(arena)), 8192);
  t.eq_u64(mut_of(st), "arena remaining empty", mem.BumpArena.remaining(ref_of(arena)), 8192);
  let a0: u64 = mem.BumpArena.alloc(mut_of(arena), 64);
  t.check(mut_of(st), "arena alloc nonzero", a0 != 0);
  t.eq_u64(mut_of(st), "arena remaining after 64", mem.BumpArena.remaining(ref_of(arena)), 8128);
  let a1: u64 = mem.BumpArena.alloc(mut_of(arena), 8);
  t.check(mut_of(st), "arena alloc second", a1 == a0 + 64);
  t.eq_u64(mut_of(st), "arena remaining after 72", mem.BumpArena.remaining(ref_of(arena)), 8120);
  t.eq_u64(mut_of(st), "arena free inside", mem.BumpArena.free(mut_of(arena), a0), 1);
  t.eq_u64(mut_of(st), "arena free outside", mem.BumpArena.free(mut_of(arena), a0 + 8192), 0);
  let fb: u64 = 4096;
  let oom_addr: u64 = mem.bump_alloc_or(mut_of(arena), 9000, fb);
  t.eq_u64(mut_of(st), "arena oom fallback", oom_addr, 4096);
  t.eq_u64(mut_of(st), "arena reset", mem.BumpArena.reset(mut_of(arena)), 1);
  t.eq_u64(mut_of(st), "arena remaining reset", mem.BumpArena.remaining(ref_of(arena)), 8192);

  // --- std::mem.BudgetTracker ---
  let tr: mem.BudgetTracker.Tracker = mem.BudgetTracker.new(64);
  let p0: u64 = mem.BudgetTracker.alloc(mut_of(tr), 16);
  t.check(mut_of(st), "budget alloc1 nonzero", p0 != 0);
  t.eq_u64(mut_of(st), "budget live 24", mem.BudgetTracker.live(ref_of(tr)), 24);
  let p1: u64 = mem.BudgetTracker.alloc(mut_of(tr), 16);
  t.check(mut_of(st), "budget alloc2 nonzero", p1 != 0);
  t.eq_u64(mut_of(st), "budget live 48", mem.BudgetTracker.live(ref_of(tr)), 48);
  t.eq_u64(mut_of(st), "budget peak 48", mem.BudgetTracker.peak(ref_of(tr)), 48);
  let pd: u64 = mem.BudgetTracker.alloc(mut_of(tr), 40);
  t.eq_u64(mut_of(st), "budget deny over limit", pd, 0);
  t.eq_u64(mut_of(st), "budget denied 1", mem.BudgetTracker.denied(ref_of(tr)), 1);
  let fbk: u64 = 777;
  let budget_oom: u64 = mem.budget_alloc_or(mut_of(tr), 40, fbk);
  t.eq_u64(mut_of(st), "budget oom fallback", budget_oom, 777);
  t.eq_u64(mut_of(st), "budget denied 2", mem.BudgetTracker.denied(ref_of(tr)), 2);
  t.eq_bool(mut_of(st), "budget has_leaks before free", mem.BudgetTracker.has_leaks(ref_of(tr)), true);
  t.eq_u64(mut_of(st), "budget free p0", mem.BudgetTracker.free(mut_of(tr), p0), 0);
  t.eq_u64(mut_of(st), "budget live 24 after free", mem.BudgetTracker.live(ref_of(tr)), 24);
  t.eq_u64(mut_of(st), "budget free p1", mem.BudgetTracker.free(mut_of(tr), p1), 0);
  t.eq_u64(mut_of(st), "budget live 0", mem.BudgetTracker.live(ref_of(tr)), 0);
  t.eq_bool(mut_of(st), "budget has_leaks after free", mem.BudgetTracker.has_leaks(ref_of(tr)), false);

  // --- std::mem.SystemAlloc ---
  let sa: mem.SystemHandle = mem.SystemAlloc.new();
  let sp: u64 = mem.SystemAlloc.alloc(mut_of(sa), 128);
  t.check(mut_of(st), "system alloc nonzero", sp != 0);
  t.eq_u64(mut_of(st), "system free", mem.SystemAlloc.free(mut_of(sa), sp), 0);
  let sp2: u64 = mem.alloc_with(mut_of(sa), 32);
  t.check(mut_of(st), "system alloc_with nonzero", sp2 != 0);
  t.eq_u64(mut_of(st), "system free alloc_with", mem.SystemAlloc.free(mut_of(sa), sp2), 0);
  return t.finish(mut_of(st));
};

let MetaBoolRec = struct {
  ok: bool,
  tag: u8,
  active: bool,
};

let SliceBox = struct {
  tag: u64,
  text: Slice(u8),
};

let MetaFieldPrinter = func(T: Type) -> Module {
  return module {
    pub let Self = T;
    pub let join_names = func(v: T) -> Slice(u8) {
      let c: fmt.Cursor = fmt.fmt_begin();
      let first: u64 = 1;
      comptime for f in fields_of(T) {
        if first == 0 { c = fmt.write_str(c, ","); }
        c = fmt.write_str(c, f.name);
        first = 0;
      }
      return fmt.fmt_done(c);
    };
  };
};

let MetaBoolPrinter = MetaFieldPrinter(MetaBoolRec);

// 泛型函数里的 comptime for：单态化后的 T 必须能在编译期绑定里查到。
let count_fields = func(v: Ref(T)) ?{ T: Type } -> u64 {
  let n: u64 = 0;
  comptime for f in fields_of(T) {
    n = n + 1;
  }
  return n;
};

let run_meta_and_bool_suite = func() -> i64 {
  let st: t.Suite = t.suite("meta::bool_and_fields");
  let r: MetaBoolRec = MetaBoolRec { ok: true, tag: 42, active: false };
  t.eq_bool(mut_of(st), "struct bool ok", r.ok, true);
  t.eq_u64(mut_of(st), "struct u8 tag", r.tag as u64, 42);
  t.eq_bool(mut_of(st), "struct bool active", r.active, false);
  let mp: Mut(MetaBoolRec) = mut_of(r);
  mp.ok = false;
  mp.active = true;
  t.eq_bool(mut_of(st), "mut bool ok", r.ok, false);
  t.eq_bool(mut_of(st), "mut bool active", r.active, true);
  t.eq_u64(mut_of(st), "u8 tag intact", r.tag as u64, 42);
  let b: bool = true;
  let bp: Ref(bool) = ref_of(b);
  t.eq_bool(mut_of(st), "ref bool deref", deref(bp), true);
  let names: Slice(u8) = MetaBoolPrinter.join_names(r);
  t.eq_bytes(mut_of(st), "fields_of(T).name Slice(u8)", names, "ok,tag,active");
  t.eq_u64(mut_of(st), "generic comptime for fields_of(T)", count_fields(ref_of(r)), 3);
  let sarr: Array(Slice(u8), 2) = ["alpha", "omega"];
  t.eq_bytes(mut_of(st), "Array(Slice(u8), 2)[0]", sarr[0], "alpha");
  t.eq_bytes(mut_of(st), "Array(Slice(u8), 2)[1]", sarr[1], "omega");
  let sb_raw: u64 = os.alloc_bytes(size_of(SliceBox));
  let sbp: Mut(SliceBox) = ptr_cast(Mut(SliceBox), sb_raw);
  sbp.tag = 9;
  sbp.text = "lain";
  t.eq_u64(mut_of(st), "mut SliceBox tag", sbp.tag, 9);
  t.eq_bytes(mut_of(st), "mut SliceBox text", sbp.text, "lain");
  os.free_bytes(sb_raw);
  return t.finish(mut_of(st));
};

let thread_worker = func(arg: Mut(u8)) -> c_uint {
  let ap: Mut(sync.AtomicU64) = ptr_cast(Mut(sync.AtomicU64), arg);
  let i: u64 = 0;
  loop lp(k: u64 = 0) while k < 1000 {
    sync.atomic_u64_add(ap, 1, sync.RELAXED());
    k = k + 1;
  };
  return 0;
};

let pool_task_inc = func(arg: Mut(u8)) -> u64 {
  let ap: Mut(sync.AtomicU64) = ptr_cast(Mut(sync.AtomicU64), arg);
  sync.atomic_u64_add(ap, 1, sync.RELAXED());
  return 0;
};

let sched_task_inc = func(ctx: Mut(u8)) -> u64 {
  let ap: Mut(sync.AtomicU64) = ptr_cast(Mut(sync.AtomicU64), ctx);
  sync.atomic_u64_add(ap, 1, sync.RELAXED());
  return 0;
};

let run_sync_thread_meta_suite = func() -> i64 {
  let st: t.Suite = t.suite("std::sync_thread_meta");
  let a: sync.AtomicU64 = sync.atomic_u64_new(10);
  t.eq_u64(mut_of(st), "atomic load init", sync.atomic_u64_load(mut_of(a), sync.ACQUIRE()), 10);
  t.eq_u64(mut_of(st), "atomic add old", sync.atomic_u64_add(mut_of(a), 5, sync.SEQ_CST()), 10);
  t.eq_u64(mut_of(st), "atomic load after add", sync.atomic_u64_load(mut_of(a), sync.ACQUIRE()), 15);
  t.eq_u64(mut_of(st), "atomic cas old", sync.atomic_u64_cas(mut_of(a), 15, 42, sync.ACQ_REL()), 15);
  t.eq_u64(mut_of(st), "atomic load after cas", sync.atomic_u64_load(mut_of(a), sync.SEQ_CST()), 42);
  let lk: sync.SpinLock = sync.spin_new();
  sync.spin_lock(mut_of(lk));
  sync.spin_unlock(mut_of(lk));
  t.check(mut_of(st), "spinlock lock/unlock", true);

  let shared: sync.AtomicU64 = sync.atomic_u64_new(0);
  let t1: thread.Thread = thread.spawn(fn_of(thread_worker), ptr_cast(Mut(u8), mut_of(shared)));
  let t2: thread.Thread = thread.spawn(fn_of(thread_worker), ptr_cast(Mut(u8), mut_of(shared)));
  t.eq_u64(mut_of(st), "thread1 join", thread.join(t1), 0);
  t.eq_u64(mut_of(st), "thread2 join", thread.join(t2), 0);
  t.eq_u64(mut_of(st), "concurrent atomic_add 2000", sync.atomic_u64_load(mut_of(shared), sync.SEQ_CST()), 2000);

  let pshared: sync.AtomicU64 = sync.atomic_u64_new(0);
  let tp: Mut(pool.ThreadPool) = pool.pool_new(4, 128);
  let p_ok: u64 = 1;
  loop sub(pi: u64 = 0) while pi < 100 {
    if pool.pool_submit(tp, fn_of(pool_task_inc), ptr_cast(Mut(u8), mut_of(pshared))) == false {
      p_ok = 0;
    }
    pi = pi + 1;
  };
  pool.pool_wait_all(tp);
  t.eq_u64(mut_of(st), "pool 100 submits accepted", p_ok, 1);
  t.eq_u64(mut_of(st), "pool 100 tasks executed", sync.atomic_u64_load(mut_of(pshared), sync.SEQ_CST()), 100);
  t.eq_u64(mut_of(st), "pool shutdown", pool.pool_shutdown(tp), 0);

  let is_cnt: sync.AtomicU64 = sync.atomic_u64_new(0);
  let isched: sched.InlineSched = sched.InlineScheduler.new();
  sched.dispatch(mut_of(isched), fn_of(sched_task_inc), ptr_cast(Mut(u8), mut_of(is_cnt))) ?{ sc: sched.InlineScheduler };
  sched.dispatch(mut_of(isched), fn_of(sched_task_inc), ptr_cast(Mut(u8), mut_of(is_cnt))) ?{ sc: sched.InlineScheduler };
  t.eq_u64(mut_of(st), "inline sched wait_idle", sched.wait_idle(mut_of(isched)) ?{ sc: sched.InlineScheduler }, 2);
  t.eq_u64(mut_of(st), "inline sched counter", sync.atomic_u64_load(mut_of(is_cnt), sync.SEQ_CST()), 2);

  let ps_cnt: sync.AtomicU64 = sync.atomic_u64_new(0);
  let tp2: Mut(pool.ThreadPool) = pool.pool_new(2, 32);
  let psched: sched.PoolSched = sched.PoolScheduler.new(tp2);
  loop ps_lp(psi: u64 = 0) while psi < 8 {
    sched.dispatch(mut_of(psched), fn_of(sched_task_inc), ptr_cast(Mut(u8), mut_of(ps_cnt))) ?{ sc: sched.PoolScheduler };
    psi = psi + 1;
  };
  sched.wait_idle(mut_of(psched)) ?{ sc: sched.PoolScheduler };
  t.eq_u64(mut_of(st), "pool sched counter", sync.atomic_u64_load(mut_of(ps_cnt), sync.SEQ_CST()), 8);
  pool.pool_shutdown(tp2);

  let @concat_ident(macro_, val): u64 = 77;
  t.eq_u64(mut_of(st), "macro @concat_ident", macro_val, 77);
  t.eq_bytes(mut_of(st), "macro @stringify", @stringify(alpha + beta), "alpha + beta");

  let mbytes: u64 = meta.ast_out_bytes(16, 32, 256, 8);
  let mbuf: u64 = os.alloc_bytes(mbytes);
  let ao: meta.AstOut = meta.ast_out_init(ptr_cast(Mut(u8), mbuf), 16, 32, 256, 8);
  let tx0: u64 = meta.ast_out_begin(mut_of(ao));
  let tmp_tok: u64 = meta.ast_out_mk_token(mut_of(ao), 1, 0, 0, "discard");
  meta.ast_out_rollback(mut_of(ao), tx0);
  t.eq_u64(mut_of(st), "ast_out rollback count 0", meta.ast_out_node_count(mut_of(ao)), 0);
  let tx1: u64 = meta.ast_out_begin(mut_of(ao));
  let tok_id: u64 = meta.ast_out_mk_token(mut_of(ao), 2, 0, 0, "hello");
  meta.ast_out_commit(mut_of(ao), tx1, tok_id);
  let av: meta.AstView = meta.ast_view_of(mut_of(ao));
  t.eq_bytes(mut_of(st), "ast_view text", meta.view_text(av, tok_id), "hello");
  os.free_bytes(mbuf);
  return t.finish(mut_of(st));
};

let run_lang_core_suite = func() -> i64 {
  let st: t.Suite = t.suite("lang::core");

  // match 穷尽性：两个分支都被走到，Some 的载荷被绑定并参与运算。
  let some_val: LangOpt = LangOpt.Some { 41 };
  let none_val: LangOpt = LangOpt.None {};
  t.eq_i64(mut_of(st), "match Some payload", unwrap_plus_one(some_val), 42);
  t.eq_i64(mut_of(st), "match None branch", unwrap_plus_one(none_val), 0);

  // 定长数组与切片：数组形参、Slice 视图、MutSlice 子切片。
  let arr: Array(u64, 4) = [10, 20, 30, 40];
  let s: Slice(u64) = slice_of(arr);
  t.eq_u64(mut_of(st), "Array(u64, 4) slice len", s.len, 4);
  t.eq_u64(mut_of(st), "Slice element sum", sum_u64_slice(s), 100);
  t.eq_u64(mut_of(st), "Array param head+tail", array_head_tail(arr), 50);
  let p: Mut(u64) = mut_of(arr);
  let ms: MutSlice(u64) = slice_of(p, 2);
  t.eq_u64(mut_of(st), "MutSlice sub-slice len", ms.len, 2);
  let sub: Slice(u64) = ms;
  t.eq_u64(mut_of(st), "MutSlice narrowing sum", sum_u64_slice(sub), 30);

  // 字符串转义：\n \t \\ \" 各自落成单个字节。
  let esc: Slice(u8) = "a\nb\"c\\";
  t.eq_u64(mut_of(st), "escape len", esc.len, 6);
  t.eq_u64(mut_of(st), "escape byte sum", sum_u8_slice(esc), 430);
  t.eq_bytes(mut_of(st), "escape bytes", esc, "a\nb\"c\\");
  let tabbed: Slice(u8) = "x\ty";
  t.eq_u64(mut_of(st), "tab len", tabbed.len, 3);
  t.eq_u64(mut_of(st), "tab byte sum", sum_u8_slice(tabbed), 250);

  // UFCS 标量分派：值 / Ref / Mut 三种首参。
  let n: i64 = 5;
  t.eq_i64(mut_of(st), "ufcs scalar value recv", n.twice(), 10);
  t.eq_i64(mut_of(st), "ufcs scalar ref recv", n.peek(), 5);
  let nr: Ref(i64) = ref_of(n);
  t.eq_i64(mut_of(st), "ufcs scalar ref-of recv", nr.peek(), 5);
  t.eq_i64(mut_of(st), "ufcs scalar mut recv", n.bump(), 6);
  t.eq_i64(mut_of(st), "ufcs scalar mut persisted", n, 6);

  // UFCS 结构体分派：同样三种首参。
  let v: LangVec2 = LangVec2 { x: 3, y: 4 };
  t.eq_i64(mut_of(st), "ufcs struct value recv", v.len2(), 25);
  t.eq_i64(mut_of(st), "ufcs struct ref recv", v.get_x(), 3);
  t.eq_i64(mut_of(st), "ufcs struct mut recv", v.add_x(5), 8);
  t.eq_i64(mut_of(st), "ufcs struct mut persisted", v.x, 8);
  return t.finish(mut_of(st));
};

let run_effects_suite = func() -> i64 {
  let st: t.Suite = t.suite("lang::effects");

  // 中止性效应（-> Never）：值 / 错误 / 停止三条通道。
  t.eq_i64(mut_of(st), "abortive value channel", lang_classify(21, 0), 42);
  t.eq_i64(mut_of(st), "abortive error channel", lang_classify(21, 1), 80);
  t.eq_i64(mut_of(st), "abortive stop channel", lang_classify(21, 2), 20);
  // 再走一次值通道，确认效应没有残留。
  t.eq_i64(mut_of(st), "abortive value channel repeated", lang_classify(21, 0), 42);

  // 词法尾恢复：两次 emit 各自 resume，续体把加工后的值送回发起点。
  t.eq_i64(mut_of(st), "resumable emit resume", lang_yield_run(), 60);
  return t.finish(mut_of(st));
};

let main = func() -> i64 {
  io.println("=== Lain Library Test Runner (test.lain) ===");
  let f0: i64 = ir_test.run_suite();
  let f1: i64 = run_collections_suite();
  let f2: i64 = run_build_suite();
  let f3: i64 = run_os_fmt_suite();
  let f4: i64 = run_option_mem_suite();
  let f5: i64 = run_meta_and_bool_suite();
  let f6: i64 = run_sync_thread_meta_suite();
  let f7: i64 = run_lang_core_suite();
  let f8: i64 = run_effects_suite();
  let total_fail: i64 = f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8;
  if total_fail == 0 {
    io.println("ALL SUITES PASSED");
  } else {
    io.print("TOTAL FAILURES: ");
    io.print_i64(total_fail);
    io.newline();
  }
  return total_fail;
};
