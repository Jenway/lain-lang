// ctfn.lain —— Phase 2A-2 编译期类型工厂求值器（解释签名含 Type 的函数体）。
// 复用 ctfor 的值单元/绑定栈与 ctprim 的类型原语，单文件控制在 300 行内。
extern lain2_source_root(idx: u64) -> u64 = lain2_source_root;
let st = import("state");
let ax = import("ast");
let s = import("sym");
let modules = import("modules");
let ireg = import("tyreg");
let agg = import("agg");
let ct = import("ctypes");
let tb = import("tbuild");
let ctf = import("ctfor");
let ctp = import("ctprim");

func collect(k: addr, ag: u64, i: u64, idx: u64, need: u64, ab: addr) -> u64 {
  let n: u64 = ax.n_count(ag);
  if idx >= need {
    if i < n { ctf.fail_msg(k, "too many args", 13, ax.e_ast()); return 0; }
    return 1;
  }
  if i >= n { ctf.fail_msg(k, "missing args", 12, ax.e_ast()); return 0; }
  let j: u64 = ct_eval(k, ag, i, 0, ab + idx * 24);
  if st.st_ok(k) != 0 { return 0; }
  let nj: u64 = if ax.is_comma(ag, j) == 1 { j + 1 } else { j };
  return collect(k, ag, nj, idx + 1, need, ab);
}

func fill_fn_params(k: addr, pg: u64, i: u64, idx: u64, np: u64, tbl: addr) -> u64 {
  if idx >= np { return idx; }
  let t: addr = st.st_alloc(k, 24);
  let j: u64 = ct_eval(k, pg, i, 0, t);
  if st.st_ok(k) != 0 { return idx; }
  store(tbl + idx * 8, ctp.as_type(k, t));
  let nj: u64 = if ax.is_comma(pg, j) == 1 { j + 1 } else { j };
  return fill_fn_params(k, pg, nj, idx + 1, np, tbl);
}

func fn_factory(k: addr, ag: u64) -> u64 {
  if ax.n_count(ag) < 3 { ctf.fail_msg(k, "bad Fn type", 11, ax.e_ast()); return 0; }
  let pg: u64 = ax.n_at(ag, 0);
  let np: u64 = ctp.arg_count_at(pg, 0, 0);
  let tbl: addr = st.st_ralloc(k, np * 8 + 8);
  fill_fn_params(k, pg, 0, 0, np, tbl);
  if st.st_ok(k) != 0 { return 0; }
  let rt: addr = st.st_alloc(k, 24);
  ct_eval(k, ag, 2, 0, rt);
  if st.st_ok(k) != 0 { return 0; }
  return ct.fn_t(k, ctp.as_type(k, rt), np, tbl as u64);
}

func ct_call(k: addr, name: u64, ag: u64, out: addr) -> u64 {
  if name == s.t_fn() {
    let id: u64 = fn_factory(k, ag);
    if st.st_ok(k) != 0 { return 2; }
    ctf.v_set(out, 1, id, 0);
    return 1;
  }
  let ar1: u64 = ctp.prim_arity(name);
  if ar1 != 0 {
    let nargs: u64 = ar1 - 1;
    let ab: addr = st.st_alloc(k, 72);
    if collect(k, ag, 0, 0, nargs, ab) == 0 { return 2; }
    return ctp.apply_prim(k, name, ag, ab, nargs, out);
  }
  let e: addr = modules.find_here(k, name);
  if e as u64 == 0 {
    let qr: u64 = ctf.prim(k, name, ag, out);
    if qr != 0 { return qr; }
    ctf.fail_msg(k, "unknown comptime fn", 19, ax.e_unbound());
    return 2;
  }
  if modules.sym_kind(e) != modules.sym_kind_func() { ctf.fail_msg(k, "not callable", 12, ax.e_type()); return 2; }
  call_user(k, e, ag, out);
  return 1;
}

func ct_prefix(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { ctf.fail_msg(k, "empty comptime expr", 19, ax.e_ast()); return i; }
  let h: u64 = ax.n_at(g, i);
  if ax.is_group_node(h) == 1 {
    if ax.delim(h) == ax.dl_paren() {
      let j: u64 = ct_eval(k, h, 0, 0, out);
      if st.st_ok(k) == 0 and j != ax.n_count(h) { ctf.fail_msg(k, "bad comptime expr", 17, ax.e_ast()); }
      return i + 1;
    }
    ctf.fail_msg(k, "bad comptime expr", 17, ax.e_ast());
    return i + 1;
  }
  if ax.is_digit_token(g, i) == 1 {
    ctf.v_set(out, 0, ax.num_value(ax.lit_addr(h), ax.lit_len(h)), 0);
    return i + 1;
  }
  if ax.tok_first(g, i) == 34 {
    let pa: addr = ax.lit_addr(h);
    let pu: u64 = (pa as u64) + 1;
    ctf.v_set(out, 3, pu, ax.lit_len(h) - 2);
    return i + 1;
  }
  let name: u64 = ax.node_sym(h);
  if name == s.k_true() or name == s.k_false() {
    let bv0: u64 = if name == s.k_true() { 1 } else { 0 };
    ctf.v_set(out, 0, bv0, 0);
    return i + 1;
  }
  if name == 0 { ctf.fail_msg(k, "bad comptime expr", 17, ax.e_op()); return i + 1; }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 1 and i + 2 < n and ax.is_name(g, i + 2) == 1 {
    let m: u64 = modules.mod_lookup(k, name);
    if m != 0 {
      let mem: addr = modules.sym_find(k, m - 1, ax.n_sym(g, i + 2));
      if mem as u64 != 0 {
        let mk: u64 = modules.sym_kind(mem);
        if mk == modules.sym_kind_func() and ctf.has_delim(g, i + 3, ax.dl_paren()) == 1 {
          call_user(k, mem, ax.n_at(g, i + 3), out);
          return i + 4;
        }
        if mk == modules.sym_kind_struct() or mk == modules.sym_kind_enum() {
          ctf.v_set(out, 1, ctf.tid_of_shape(k, modules.sym_shape(mem)), 0);
          return i + 3;
        }
      }
    }
  }
  if ctf.has_delim(g, i + 1, ax.dl_paren()) == 1 {
    ct_call(k, name, ax.n_at(g, i + 1), out);
    return i + 2;
  }
  let bv: addr = ctf.lookup(k, name);
  if bv as u64 != 0 {
    if ctf.has_tok(g, i + 1, s.p_dot()) == 1 {
      if i + 2 < n and ax.is_name(g, i + 2) == 1 {
        let pv: addr = ctf.proj(k, bv, ax.n_sym(g, i + 2));
        if pv as u64 != 0 { ctf.v_set(out, ctf.v_kind(pv), ctf.v_a(pv), ctf.v_b(pv)); return i + 3; }
        ctf.fail_msg(k, "bad FieldInfo member", 20, ax.e_op());
        return i + 3;
      }
    }
    ctf.v_set(out, ctf.v_kind(bv), ctf.v_a(bv), ctf.v_b(bv));
    return i + 1;
  }
  let tid: u64 = if name == s.t_type() { tb.type_tid(k) } else { ctf.tid_of_name(k, name) };
  if tid != 0 { ctf.v_set(out, 1, tid, 0); return i + 1; }
  ctf.fail_msg(k, "unknown comptime name", 21, ax.e_unbound());
  return i + 1;
}

func ct_tail(k: addr, g: u64, i: u64, minp: u64, out: addr) -> u64 {
  if i >= ax.n_count(g) { return i; }
  let p: u64 = ctp.ct_prio(g, i);
  if p == 0 or p < minp { return i; }
  if ctf.v_kind(out) != 0 { ctf.fail_msg(k, "comptime op needs int", 21, ax.e_type()); return i; }
  let op: u64 = ax.n_sym(g, i);
  let rhs: addr = st.st_alloc(k, 24);
  let j: u64 = ct_prefix(k, g, i + 1, rhs);
  if st.st_ok(k) != 0 { return j; }
  let j2: u64 = ct_tail(k, g, j, p + 1, rhs);
  if st.st_ok(k) != 0 { return j2; }
  if ctf.v_kind(rhs) != 0 { ctf.fail_msg(k, "comptime op needs int", 21, ax.e_type()); return j2; }
  let r: u64 = ctp.ct_bin(k, op, ctf.v_a(out), ctf.v_a(rhs));
  ctf.v_set(out, 0, r, 0);
  return ct_tail(k, g, j2, minp, out);
}

func ct_eval(k: addr, g: u64, i: u64, minp: u64, out: addr) -> u64 {
  let j: u64 = ct_prefix(k, g, i, out);
  if st.st_ok(k) != 0 { return j; }
  return ct_tail(k, g, j, minp, out);
}

// --- 过程体解释 -----------------------------------------------------------
func skip_param_ty(pg: u64, i: u64) -> u64 {
  if i >= ax.n_count(pg) { return i; }
  if ax.is_comma(pg, i) == 1 { return i + 1; }
  return skip_param_ty(pg, i + 1);
}

func eval_params(k: addr, pg: u64, i: u64, ag: u64, ai: u64, ab: addr, nms: addr, idx: u64) -> u64 {
  let pn: u64 = ax.n_count(pg);
  let an: u64 = ax.n_count(ag);
  if i >= pn {
    if ai < an { ctf.fail_msg(k, "too many args", 13, ax.e_ast()); }
    return idx;
  }
  if ax.is_comma(pg, i) == 1 { return eval_params(k, pg, i + 1, ag, ai, ab, nms, idx); }
  if ai >= an { ctf.fail_msg(k, "missing args", 12, ax.e_ast()); return idx; }
  if idx >= 8 { ctf.fail_msg(k, "too many params", 15, ax.e_ast()); return idx; }
  store(nms + idx * 8, ax.node_sym(ax.n_at(pg, i)));
  let aj: u64 = ct_eval(k, ag, ai, 0, ab + idx * 24);
  if st.st_ok(k) != 0 { return idx; }
  let i2: u64 = if ctf.has_tok(pg, i + 1, s.p_colon()) == 1 { skip_param_ty(pg, i + 2) } else { i + 1 };
  let a2: u64 = if ax.is_comma(ag, aj) == 1 { aj + 1 } else { aj };
  return eval_params(k, pg, i2, ag, a2, ab, nms, idx + 1);
}

func bind_arr(k: addr, nms: addr, ab: addr, i: u64, n: u64) -> u64 {
  if i >= n { return 1; }
  let v: addr = ab + i * 24;
  let nm: u64 = load(nms + i * 8);
  ctf.bind(k, nm, ctf.v_kind(v), ctf.v_a(v), ctf.v_b(v));
  if st.st_ok(k) != 0 { return 0; }
  return bind_arr(k, nms, ab, i + 1, n);
}

func find_body(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return 0; }
  if ctf.has_delim(g, i, ax.dl_brace()) == 1 { return i; }
  return find_body(g, i + 1);
}

func call_user(k: addr, e: addr, ag: u64, out: addr) -> u64 {
  let d: u64 = modules.sym_decl(e);
  let root: u64 = lain2_source_root(modules.sym_src(e));
  let pi: u64 = if ax.n_sym(root, d) == s.k_func() { d + 2 } else { d + 1 };
  let body: u64 = find_body(root, pi + 1);
  if body == 0 { ctf.fail_msg(k, "no body", 7, ax.e_ast()); return 0; }
  let ab: addr = st.st_alloc(k, 192);
  let nms: addr = st.st_alloc(k, 64);
  let nargs: u64 = eval_params(k, ax.n_at(root, pi), 0, ag, 0, ab, nms, 0);
  if st.st_ok(k) != 0 { return 0; }
  let hit: addr = tb.cache_find(k, e, nargs, ab);
  if hit as u64 != 0 {
    let rk: u64 = load(hit + 16); let ra: u64 = load(hit + 24); let rb: u64 = load(hit + 32);
    ctf.v_set(out, rk, ra, rb);
    return 1;
  }
  let prev: u64 = st.st_ctdone(k);
  let prev_src: u64 = st.st_src(k);
  let mark: u64 = ctf.mark(k);
  st.st_set_ctdone(k, 0);
  st.st_set_src(k, modules.sym_src(e));
  bind_arr(k, nms, ab, 0, nargs);
  if st.st_ok(k) == 0 { run(k, ax.n_at(root, body)); }
  ctf.release(k, mark);
  st.st_set_src(k, prev_src);
  st.st_set_ctdone(k, prev);
  if st.st_ok(k) != 0 { return 0; }
  let ret: addr = st.st_ctret(k);
  let rk: u64 = ctf.v_kind(ret); let ra: u64 = ctf.v_a(ret); let rb: u64 = ctf.v_b(ret);
  tb.cache_put(k, e, nargs, ab, rk, ra, rb);
  ctf.v_set(out, rk, ra, rb);
  return 1;
}

func skip_eq(g: u64, i: u64) -> u64 {
  if i >= ax.n_count(g) { return i; }
  if ctf.has_tok(g, i, s.p_eq()) == 1 { return i; }
  return skip_eq(g, i + 1);
}

func run(k: addr, g: u64) -> u64 { return run_at(k, g, 0); }

func run_at(k: addr, g: u64, i: u64) -> u64 {
  let n: u64 = ax.n_count(g);
  if i >= n { return i; }
  if st.st_ok(k) != 0 or st.st_ctdone(k) == 1 { return n; }
  if ax.is_semi(g, i) == 1 { return run_at(k, g, i + 1); }
  if ax.is_group(g, i) == 1 {
    let mark: u64 = ctf.mark(k);
    run(k, ax.n_at(g, i));
    ctf.release(k, mark);
    return run_at(k, g, i + 1);
  }
  let name: u64 = ax.node_sym(ax.n_at(g, i));
  if name == s.k_let() {
    let nm: u64 = ax.node_sym(ax.n_at(g, i + 1));
    let j1: u64 = if ctf.has_tok(g, i + 2, s.p_colon()) == 1 { skip_eq(g, i + 3) } else { i + 2 };
    let e: u64 = if ctf.has_tok(g, j1, s.p_eq()) == 1 { j1 + 1 } else { j1 };
    let v: addr = st.st_alloc(k, 24);
    let j: u64 = ct_eval(k, g, e, 0, v);
    if st.st_ok(k) != 0 { return j; }
    ctf.bind(k, nm, ctf.v_kind(v), ctf.v_a(v), ctf.v_b(v));
    return run_at(k, g, ax.skip_semi(g, j));
  }
  if name == s.k_if() {
    let c: addr = st.st_alloc(k, 24);
    let j: u64 = ct_eval(k, g, i + 1, 0, c);
    if st.st_ok(k) != 0 { return j; }
    let he: u64 = ctf.has_tok(g, j + 1, s.k_else());
    let mark: u64 = ctf.mark(k);
    if ctf.v_a(c) != 0 { run(k, ax.n_at(g, j)); } else { if he == 1 { run(k, ax.n_at(g, j + 2)); } }
    ctf.release(k, mark);
    return run_at(k, g, j + 1 + he * 2);
  }
  if name == s.k_return() {
    let j: u64 = if i + 1 < n { ct_eval(k, g, i + 1, 0, st.st_ctret(k)) } else { i + 1 };
    st.st_set_ctdone(k, 1);
    return j;
  }
  if name == s.k_comptime() {
    if ctf.has_tok(g, i + 1, s.k_for()) == 0 { ctf.fail_msg(k, "expected for", 12, ax.e_ast()); return i + 1; }
    let d: addr = ctf.for_open(k, g, i);
    if st.st_ok(k) != 0 { return i + 4; }
    let body: u64 = ctf.for_body(d);
    let ctmark: u64 = ctf.mark(k);
    let m0: u64 = ctf.for_step(k, d);
    let m1: u64 = loop step(m: u64 = m0) while m == 1 {
      let m2: u64 = ctf.mark(k);
      run(k, ax.n_at(g, body));
      ctf.release(k, m2);
      let stop: u64 = if st.st_ok(k) != 0 or st.st_ctdone(k) == 1 { 1 } else { 0 };
      m = if stop == 1 { 0 } else { ctf.for_step(k, d) };
    };
    ctf.release(k, ctmark);
    return run_at(k, g, body + 1);
  }
  if ax.is_name(g, i) == 1 and ctf.has_tok(g, i + 1, s.p_eq()) == 1 {
    let v: addr = st.st_alloc(k, 24);
    let j: u64 = ct_eval(k, g, i + 2, 0, v);
    if st.st_ok(k) != 0 { return j; }
    ctf.set_binding(k, name, v);
    return run_at(k, g, ax.skip_semi(g, j));
  }
  let v2: addr = st.st_alloc(k, 24);
  let j2: u64 = ct_eval(k, g, i, 0, v2);
  return run_at(k, g, ax.skip_semi(g, j2));
}

// --- 对外入口：顶层 let 绑定与类型位置调用 -------------------------------
func eval_factory_call(k: addr, g: u64, i: u64, out: addr) -> u64 {
  if ax.is_name(g, i) == 0 { return 0; }
  if ctf.has_delim(g, i + 1, ax.dl_paren()) == 1 {
    let fn: addr = modules.find_here(k, ax.n_sym(g, i));
    if fn as u64 == 0 { return 0; }
    if modules.sym_kind(fn) != modules.sym_kind_func() { return 0; }
    if tb.sig_types(modules.sym_sig(fn)) == 0 { return 0; }
    call_user(k, fn, ax.n_at(g, i + 1), out);
    return i + 2;
  }
  if ctf.has_tok(g, i + 1, s.p_dot()) == 1 and i + 3 < ax.n_count(g) and ax.is_name(g, i + 2) == 1 {
    if ctf.has_delim(g, i + 3, ax.dl_paren()) == 1 {
      let m: u64 = modules.mod_lookup(k, ax.n_sym(g, i));
      if m == 0 { return 0; }
      let fn2: addr = modules.sym_find(k, m - 1, ax.n_sym(g, i + 2));
      if fn2 as u64 == 0 { return 0; }
      if modules.sym_kind(fn2) != modules.sym_kind_func() { return 0; }
      if tb.sig_types(modules.sym_sig(fn2)) == 0 { return 0; }
      call_user(k, fn2, ax.n_at(g, i + 3), out);
      return i + 4;
    }
  }
  return 0;
}

func type_binding(k: addr, g: u64, e: u64, name: u64, q: u64) -> u64 {
  let v: addr = st.st_alloc(k, 24);
  let j: u64 = eval_factory_call(k, g, e, v);
  if j == 0 or st.st_ok(k) != 0 { return j; }
  let tid: u64 = ctp.as_type(k, v);
  if st.st_ok(k) != 0 { return j; }
  let sh: u64 = ireg.ty_shape(k, tid);
  if sh == 0 { ctf.fail_msg(k, "not a record type", 17, ax.e_type()); return j; }
  agg.shp_set_name(sh, name);
  agg.shp_set_mod(sh, st.st_src(k));
  modules.sym_add(k, modules.sym_kind_struct(), st.st_src(k), name, q, 0 as addr, sh);
  return j;
}

func type_from_call(k: addr, g: u64, i: u64, out: addr) -> u64 {
  let v: addr = st.st_alloc(k, 24);
  let j: u64 = eval_factory_call(k, g, i, v);
  if j == 0 or st.st_ok(k) != 0 { return j; }
  let tid: u64 = ctp.as_type(k, v);
  if st.st_ok(k) != 0 { return j; }
  ireg.project(k, tid, out);
  return j;
}
