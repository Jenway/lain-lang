#proc emit_c_i64(i64 %value) -> #unit {
  #if #eq(%value, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #let %negative: i1 = #lt(%value, 0)
  #let %current: i64 = %value
  #let %buffer: addr = #call bootstrap.allocate-pages(32)
  #let %count: i64 = 0
  #loop digits {
    #if #eq(%current, 0) { #break digits }
    #let %quotient: i64 = #div(%current, 10)
    #let %remainder: i64 = #sub(%current, #mul(%quotient, 10))
    #if %negative { %remainder = #sub(0, %remainder) }
    #store #add(48, %remainder), #lea(
      base=%buffer, idx=%count, scale=1, offset=0
    )
    %count = #add(%count, 1)
    %current: i64 = %quotient
    #continue digits
  }
  #if %negative { #call bootstrap.artifact-write-byte(45) }
  #loop output {
    #if #eq(%count, 0) { #break output }
    %count = #sub(%count, 1)
    #call bootstrap.artifact-write-byte(#load[i8](#lea(
      base=%buffer, idx=%count, scale=1, offset=0
    )))
    #continue output
  }
  #call bootstrap.release-pages(%buffer)
  #return
}

