// Dumb syntax parser for LAIN-IR tooling.
//
// The parser intentionally does not type-check or lower anything.  It turns
// the lossless token stream from source.l1 into a small linked AST carrying
// source ranges and child/sibling links.  That makes the same representation
// usable by formatter, diagnostics, and LSP code without compiler magic.

#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#extern #proc tool_source_new(addr %data, i64 %length) -> addr;
#extern #proc tool_source_nil(addr %source) -> addr;
#extern #proc tool_is_nil(addr %source, addr %value) -> i1;
#extern #proc tool_source_data(addr %source) -> addr;
#extern #proc tool_source_length(addr %source) -> i64;
#extern #proc tool_source_offset(addr %source) -> i64;
#extern #proc tool_lex_all(addr %source) -> addr;
#extern #proc tool_diag_new(
  addr %source, i32 %severity, i32 %code, i64 %start, i64 %length,
  addr %message, i64 %message_length
) -> addr;
#extern #proc tool_source_diagnostic_count(addr %source) -> i64;

#extern #proc tool_token_kind(addr %token) -> i32;
#extern #proc tool_token_start(addr %token) -> i64;
#extern #proc tool_token_length(addr %token) -> i64;
#extern #proc tool_token_next(addr %token) -> addr;

// AST kinds: 1 module, 2 proc, 3 block, 4 let, 5 record, 6 return,
// 7 field, 8 statement, 9 token-group.  The parser leaves expression and
// type syntax in token-group/statement ranges until a later AST pass.
// AST layout: kind i32 @0, flags i32 @4, start i64 @8, length i64 @16,
// first-child addr @24, last-child addr @32, next-sibling addr @40,
// source addr @48.  The source link lets list operations test the one-byte
// sentinel without ever reading a wider value from it.

#proc parser_byte_at(addr %data, i64 %index) -> i8 {
  #return #load[i8](#lea(base=%data, idx=%index, scale=1, offset=0))
}

#proc parser_ast_new(
  addr %source, i32 %kind, i64 %start, i64 %length
) -> addr {
  #let %node: addr = #call bootstrap.allocate-pages(56)
  #store %kind, #lea(base=%node, idx=0, scale=0, offset=0)
  #store[i32] 0, #lea(base=%node, idx=0, scale=0, offset=4)
  #store %start, #lea(base=%node, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%node, idx=0, scale=0, offset=16)
  #store #call tool_source_nil(%source), #lea(base=%node, idx=0, scale=0, offset=24)
  #store #call tool_source_nil(%source), #lea(base=%node, idx=0, scale=0, offset=32)
  #store #call tool_source_nil(%source), #lea(base=%node, idx=0, scale=0, offset=40)
  #store %source, #lea(base=%node, idx=0, scale=0, offset=48)
  #return %node
}

#proc parser_ast_kind(addr %node) -> i32 {
  #return #load[i32](#lea(base=%node, idx=0, scale=0, offset=0))
}

#proc parser_ast_start(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=8))
}

#proc parser_ast_length(addr %node) -> i64 {
  #return #load[i64](#lea(base=%node, idx=0, scale=0, offset=16))
}

#proc parser_ast_first_child(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=24))
}

#proc parser_ast_next(addr %node) -> addr {
  #return #load[addr](#lea(base=%node, idx=0, scale=0, offset=40))
}

// Return the structural boundary at a source byte.  The result is 1 for the
// opening byte of a block node, 2 for the byte immediately after its closing
// brace, and 0 otherwise.  Keeping this query in the AST module gives tools a
// single source of truth for structural braces instead of re-parsing those
// bytes independently.
#proc parser_ast_boundary(addr %node, i64 %index) -> i32 {
  #let %source: addr = #load[addr](#lea(base=%node, idx=0, scale=0, offset=48))
  #let %start: i64 = #call parser_ast_start(%node)
  #let %end: i64 = #add(%start, #call parser_ast_length(%node))
  // Child ranges are nested, so reject unrelated siblings before recursing.
  // This keeps a boundary lookup proportional to AST depth rather than the
  // number of nodes in the module.
  #if #lt(%index, %start) { #return 0 }
  #if #ge(%index, %end) { #return 0 }
  #if #eq(#call parser_ast_kind(%node), 3) {
    #if #eq(%start, %index) { #return 1 }
    #if #eq(%end, #add(%index, 1)) { #return 2 }
  }

  #let %child: addr = #call parser_ast_first_child(%node)
  #loop boundary_children {
    #if #call tool_is_nil(%source, %child) { #break boundary_children }
    #let %boundary: i32 = #call parser_ast_boundary(%child, %index)
    #if #ne(%boundary, 0) { #return %boundary }
    %child: addr = #call parser_ast_next(%child)
    #continue boundary_children
  }
  #return 0
}

#proc parser_ast_set_end(addr %node, i64 %end) -> #unit {
  #let %start: i64 = #call parser_ast_start(%node)
  #if #ge(%end, %start) {
    #store #sub(%end, %start), #lea(base=%node, idx=0, scale=0, offset=16)
  }
  #return
}

#proc parser_ast_append(addr %parent, addr %child) -> #unit {
  #let %source: addr = #load[addr](#lea(base=%parent, idx=0, scale=0, offset=48))
  #let %first: addr = #call parser_ast_first_child(%parent)
  #let %last: addr = #load[addr](#lea(base=%parent, idx=0, scale=0, offset=32))
  // The caller always supplies a real child; use the source-owned sentinel
  // check so nullable links never require an address comparison.
  #if #call tool_is_nil(%source, %first) {
    #store %child, #lea(base=%parent, idx=0, scale=0, offset=24)
  } else {
    #store %child, #lea(base=%last, idx=0, scale=0, offset=40)
  }
  #store %child, #lea(base=%parent, idx=0, scale=0, offset=32)
  #return
}

// Cursor layout: source @0, current token @8, last consumed end @16,
// failed flag @24, sentinel @32.
#proc parser_new(addr %source, addr %tokens) -> addr {
  #let %cursor: addr = #call bootstrap.allocate-pages(40)
  #store %source, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #store %tokens, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=16)
  #store[i32] 0, #lea(base=%cursor, idx=0, scale=0, offset=24)
  #store #call tool_source_nil(%source), #lea(base=%cursor, idx=0, scale=0, offset=32)
  #return %cursor
}

#proc parser_source(addr %cursor) -> addr {
  #return #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=0))
}

#proc parser_current(addr %cursor) -> addr {
  #return #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=8))
}

#proc parser_is_eof(addr %cursor) -> i1 {
  #let %source: addr = #call parser_source(%cursor)
  #let %token: addr = #call parser_current(%cursor)
  #if #call tool_is_nil(%source, %token) { #return 1 }
  #if #eq(#call tool_token_kind(%token), 0) { #return 1 }
  #return 0
}

#proc parser_advance(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %token: addr = #call parser_current(%cursor)
  #if #call tool_is_nil(%source, %token) { #return %token }
  #store #call tool_token_next(%token), #lea(base=%cursor, idx=0, scale=0, offset=8)
  #store #add(
    #call tool_token_start(%token), #call tool_token_length(%token)
  ), #lea(base=%cursor, idx=0, scale=0, offset=16)
  #return %token
}

#proc parser_mark_failed(addr %cursor) -> #unit {
  #store[i32] 1, #lea(base=%cursor, idx=0, scale=0, offset=24)
  #return
}

#proc parser_failed(addr %cursor) -> i1 {
  #return #ne(#load[i32](#lea(base=%cursor, idx=0, scale=0, offset=24)), 0)
}

#proc parser_token_text_is(
  addr %cursor, addr %token, addr %text, i64 %text_length
) -> i1 {
  #let %source: addr = #call parser_source(%cursor)
  #if #call tool_is_nil(%source, %token) { #return 0 }
  #if #ne(#call tool_token_length(%token), %text_length) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #let %start: i64 = #call tool_token_start(%token)
  #let %offset: i64 = 0
  #loop text_compare {
    #if #ge(%offset, %text_length) { #break text_compare }
    #if #ne(
      #call parser_byte_at(%data, #add(%start, %offset)),
      #call parser_byte_at(%text, %offset)
    ) { #return 0 }
    %offset: i64 = #add(%offset, 1)
    #continue text_compare
  }
  #return 1
}

#proc parser_is_proc(addr %cursor, addr %token) -> i1 {
  #if #call parser_token_text_is(%cursor, %token, "proc", 4) { #return 1 }
  #if #call parser_token_text_is(%cursor, %token, "#proc", 5) { #return 1 }
  #return 0
}

#proc parser_is_let(addr %cursor, addr %token) -> i1 {
  #if #call parser_token_text_is(%cursor, %token, "let", 3) { #return 1 }
  #if #call parser_token_text_is(%cursor, %token, "#let", 4) { #return 1 }
  #return 0
}

#proc parser_is_return(addr %cursor, addr %token) -> i1 {
  #if #call parser_token_text_is(%cursor, %token, "return", 6) { #return 1 }
  #if #call parser_token_text_is(%cursor, %token, "#return", 7) { #return 1 }
  #return 0
}

#proc parser_is_record(addr %cursor, addr %token) -> i1 {
  #if #call parser_token_text_is(%cursor, %token, "record", 6) { #return 1 }
  #if #call parser_token_text_is(%cursor, %token, "#record", 7) { #return 1 }
  #return 0
}

#proc parser_is_punct(addr %cursor, addr %token, i8 %byte) -> i1 {
  #let %source: addr = #call parser_source(%cursor)
  #if #call tool_is_nil(%source, %token) { #return 0 }
  #if #ne(#call tool_token_length(%token), 1) { #return 0 }
  #if #ne(#call tool_token_kind(%token), 5) { #return 0 }
  #let %data: addr = #call tool_source_data(%source)
  #return #eq(
    #call parser_byte_at(%data, #call tool_token_start(%token)), %byte
  )
}

#proc parser_error(addr %cursor, addr %message, i64 %message_length) -> #unit {
  #let %source: addr = #call parser_source(%cursor)
  #let %token: addr = #call parser_current(%cursor)
  #if #call parser_is_eof(%cursor) {
    #call tool_diag_new(
      %source, 1, 20, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16)),
      0, %message, %message_length
    )
  } else {
    #call tool_diag_new(
      %source, 1, 20, #call tool_token_start(%token),
      #call tool_token_length(%token), %message, %message_length
    )
  }
  #call parser_mark_failed(%cursor)
  #return
}

// Forward references are supported by the LAIN-IR parser.  These routines
// are mutually recursive: blocks contain statements, and record/let values
// may contain blocks.
#proc parser_parse_block(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %open: addr = #call parser_current(%cursor)
  #let %start: i64 = #call tool_token_start(%open)
  #let %node: addr = #call parser_ast_new(%source, 3, %start, 1)
  #call parser_advance(%cursor)
  #loop block_items {
    #if #call parser_is_eof(%cursor) { #break block_items }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_punct(%cursor, %current, 125) {
      #let %close: addr = #call parser_advance(%cursor)
      #call parser_ast_set_end(
        %node, #add(#call tool_token_start(%close), #call tool_token_length(%close))
      )
      #return %node
    }
    #let %child: addr = #call parser_parse_statement(%cursor)
    #call parser_ast_append(%node, %child)
    #continue block_items
  }
  #call parser_error(%cursor, "unterminated block", 18)
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_record(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %record_token: addr = #call parser_advance(%cursor)
  #let %node: addr = #call parser_ast_new(
    %source, 5, #call tool_token_start(%record_token),
    #call tool_token_length(%record_token)
  )
  #loop record_header {
    #if #call parser_is_eof(%cursor) { #break record_header }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_punct(%cursor, %current, 123) {
      #let %body: addr = #call parser_parse_block(%cursor)
      #call parser_ast_append(%node, %body)
      #call parser_ast_set_end(
        %node, #add(#call parser_ast_start(%body), #call parser_ast_length(%body))
      )
      #return %node
    }
    #call parser_advance(%cursor)
    #continue record_header
  }
  #call parser_error(%cursor, "record requires a block", 23)
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_generic(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %first: addr = #call parser_current(%cursor)
  #let %node: addr = #call parser_ast_new(
    %source, 8, #call tool_token_start(%first), #call tool_token_length(%first)
  )
  #loop generic {
    #if #call parser_is_eof(%cursor) { #break generic }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_punct(%cursor, %current, 59) {
      #let %semi: addr = #call parser_advance(%cursor)
      #call parser_ast_set_end(
        %node, #add(#call tool_token_start(%semi), #call tool_token_length(%semi))
      )
      #return %node
    }
    #if #call parser_is_punct(%cursor, %current, 125) { #break generic }
    #if #call parser_is_punct(%cursor, %current, 123) {
      #let %body: addr = #call parser_parse_block(%cursor)
      #call parser_ast_append(%node, %body)
      #call parser_ast_set_end(
        %node, #add(#call parser_ast_start(%body), #call parser_ast_length(%body))
      )
      #return %node
    }
    #call parser_advance(%cursor)
    #continue generic
  }
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_let(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %let_token: addr = #call parser_advance(%cursor)
  #let %node: addr = #call parser_ast_new(
    %source, 4, #call tool_token_start(%let_token),
    #call tool_token_length(%let_token)
  )
  #loop let_value {
    #if #call parser_is_eof(%cursor) { #break let_value }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_record(%cursor, %current) {
      #let %record: addr = #call parser_parse_record(%cursor)
      #call parser_ast_append(%node, %record)
      #continue let_value
    }
    // A record-valued top-level let is commonly written without a second
    // semicolon.  Stop before the next declaration instead of swallowing it.
    #if #call parser_is_proc(%cursor, %current) { #break let_value }
    #if #call parser_is_let(%cursor, %current) { #break let_value }
    #if #call parser_is_return(%cursor, %current) { #break let_value }
    #if #call parser_is_punct(%cursor, %current, 59) {
      #let %semi: addr = #call parser_advance(%cursor)
      #call parser_ast_set_end(
        %node, #add(#call tool_token_start(%semi), #call tool_token_length(%semi))
      )
      #return %node
    }
    #if #call parser_is_punct(%cursor, %current, 125) { #break let_value }
    #call parser_advance(%cursor)
    #continue let_value
  }
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_return(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %return_token: addr = #call parser_advance(%cursor)
  #let %node: addr = #call parser_ast_new(
    %source, 6, #call tool_token_start(%return_token),
    #call tool_token_length(%return_token)
  )
  #loop return_value {
    #if #call parser_is_eof(%cursor) { #break return_value }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_punct(%cursor, %current, 59) {
      #let %semi: addr = #call parser_advance(%cursor)
      #call parser_ast_set_end(
        %node, #add(#call tool_token_start(%semi), #call tool_token_length(%semi))
      )
      #return %node
    }
    #if #call parser_is_punct(%cursor, %current, 125) { #break return_value }
    #call parser_advance(%cursor)
    #continue return_value
  }
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_statement(addr %cursor) -> addr {
  #let %current: addr = #call parser_current(%cursor)
  #if #call parser_is_let(%cursor, %current) {
    #return #call parser_parse_let(%cursor)
  }
  #if #call parser_is_return(%cursor, %current) {
    #return #call parser_parse_return(%cursor)
  }
  #if #call parser_is_record(%cursor, %current) {
    #return #call parser_parse_record(%cursor)
  }
  #if #call parser_is_proc(%cursor, %current) {
    #return #call parser_parse_proc(%cursor)
  }
  #if #call parser_is_punct(%cursor, %current, 123) {
    #return #call parser_parse_block(%cursor)
  }
  #return #call parser_parse_generic(%cursor)
}

#proc parser_parse_proc(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %proc_token: addr = #call parser_advance(%cursor)
  #let %node: addr = #call parser_ast_new(
    %source, 2, #call tool_token_start(%proc_token),
    #call tool_token_length(%proc_token)
  )
  #loop proc_header {
    #if #call parser_is_eof(%cursor) { #break proc_header }
    #let %current: addr = #call parser_current(%cursor)
    #if #call parser_is_punct(%cursor, %current, 123) {
      #let %body: addr = #call parser_parse_block(%cursor)
      #call parser_ast_append(%node, %body)
      #call parser_ast_set_end(
        %node, #add(#call parser_ast_start(%body), #call parser_ast_length(%body))
      )
      #return %node
    }
    #call parser_advance(%cursor)
    #continue proc_header
  }
  #call parser_error(%cursor, "proc requires a block", 21)
  #call parser_ast_set_end(
    %node, #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
  )
  #return %node
}

#proc parser_parse_item(addr %cursor) -> addr {
  #let %current: addr = #call parser_current(%cursor)
  // Recover from an unmatched closing brace at module scope.  Consuming the
  // token is important: every error-recovery branch must make progress.
  #if #call parser_is_punct(%cursor, %current, 125) {
    #let %source: addr = #call parser_source(%cursor)
    #let %bad: addr = #call parser_advance(%cursor)
    #let %node: addr = #call parser_ast_new(
      %source, 9, #call tool_token_start(%bad), #call tool_token_length(%bad)
    )
    #call parser_error(%cursor, "unmatched closing brace", 23)
    #return %node
  }
  #if #call parser_is_proc(%cursor, %current) {
    #return #call parser_parse_proc(%cursor)
  }
  #if #call parser_is_let(%cursor, %current) {
    #return #call parser_parse_let(%cursor)
  }
  #if #call parser_is_return(%cursor, %current) {
    #return #call parser_parse_return(%cursor)
  }
  #if #call parser_is_record(%cursor, %current) {
    #return #call parser_parse_record(%cursor)
  }
  #return #call parser_parse_generic(%cursor)
}

#proc parser_parse_module(addr %cursor) -> addr {
  #let %source: addr = #call parser_source(%cursor)
  #let %module: addr = #call parser_ast_new(%source, 1, 0, #call tool_source_length(%source))
  #loop module_items {
    #if #call parser_is_eof(%cursor) { #break module_items }
    #let %item: addr = #call parser_parse_item(%cursor)
    #call parser_ast_append(%module, %item)
    #continue module_items
  }
  #return %module
}

#proc parser_emit_decimal(i64 %value) -> #unit {
  #let %buffer: addr = #alloca(32)
  #let %position: i64 = 31
  #let %remaining: i64 = %value
  #if #eq(%remaining, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #loop digits {
    #if #eq(%remaining, 0) { #break digits }
    #let %digit: i64 = #udiv(%remaining, 10)
    #let %remainder: i64 = #sub(%remaining, #mul(%digit, 10))
    %position: i64 = #sub(%position, 1)
    #store[i8] #add(%remainder, 48), #lea(base=%buffer, idx=%position, scale=1, offset=0)
    %remaining: i64 = %digit
    #continue digits
  }
  #let %length: i64 = #sub(31, %position)
  #let %index: i64 = 0
  #loop output_digits {
    #if #ge(%index, %length) { #break output_digits }
    #call bootstrap.artifact-write-byte(#load[i8](#lea(
      base=%buffer, idx=#add(%position, %index), scale=1, offset=0
    )))
    %index: i64 = #add(%index, 1)
    #continue output_digits
  }
  #return
}

#proc parser_emit_list(addr %source, addr %node) -> #unit {
  #let %first: i1 = 1
  #let %current: addr = %node
  #loop nodes {
    #if #call tool_is_nil(%source, %current) { #break nodes }
    #if #eq(%first, 0) { #call bootstrap.artifact-write-literal(",") }
    #call parser_emit_node(%source, %current)
    %first: i1 = 0
    %current: addr = #call parser_ast_next(%current)
    #continue nodes
  }
  #return
}

#proc parser_emit_node(addr %source, addr %node) -> #unit {
  #call bootstrap.artifact-write-literal("{\"kind\":")
  #call parser_emit_decimal(#zext[#bits<64>](#call parser_ast_kind(%node)))
  #call bootstrap.artifact-write-literal(",\"start\":")
  #call parser_emit_decimal(#call parser_ast_start(%node))
  #call bootstrap.artifact-write-literal(",\"length\":")
  #call parser_emit_decimal(#call parser_ast_length(%node))
  #call bootstrap.artifact-write-literal(",\"children\":[")
  #call parser_emit_list(%source, #call parser_ast_first_child(%node))
  #call bootstrap.artifact-write-literal("]}")
  #return
}

// Build and serialize a lossless dumb AST for source[0].
#proc tool_parse_demo() -> i32 {
  #if #eq(#call bootstrap.source-count(), 0) { #return 1 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %source: addr = #call tool_source_new(%data, %length)
  #let %tokens: addr = #call tool_lex_all(%source)
  #let %cursor: addr = #call parser_new(%source, %tokens)
  #let %module: addr = #call parser_parse_module(%cursor)

  #call bootstrap.artifact-begin()
  #call bootstrap.artifact-write-literal("[")
  #call parser_emit_node(%source, %module)
  #call bootstrap.artifact-write-literal("]\n")
  #call bootstrap.artifact-finish()
  #if #call parser_failed(%cursor) { #return 2 }
  #return 0
}
