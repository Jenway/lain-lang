// LAIN-IR -> C compiler. Seed owns parsing, verification, IR storage and
// #eval execution; this source only traverses seed handles and emits C.

#extern #proc bootstrap.source-count() -> #bits<64>;
#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.eval_source(#addr %data, #bits<64> %length) -> #bits<32>;
#extern #proc bootstrap.validate-source(#addr %data, #bits<64> %length) -> #bits<32>;
#extern #proc bootstrap.ir-module-id(#addr %data, #bits<64> %length) -> #bits<64>;
#extern #proc bootstrap.ir-module-id-release(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-module-first(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-find(#bits<64> %module, #addr %name) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-next(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-name(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-procedure-name-length(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-link-name(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-procedure-return-width(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-return-kind(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-parameter-count(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-external(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-data(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-data-size(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-data-alignment(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-data-byte(#bits<64> %id, #bits<64> %index) -> #bits<8>;
#extern #proc bootstrap.ir-procedure-parameter-name(#bits<64> %id, #bits<64> %index) -> #addr;
#extern #proc bootstrap.ir-procedure-parameter-width(#bits<64> %id, #bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-parameter-kind(#bits<64> %id, #bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.ir-procedure-first-block(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-block-first-instruction(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-block-next(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-next(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-kind(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-value(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-destination(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-name(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-instruction-label(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-instruction-type-width(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-type-kind(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-condition(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-then-block(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-else-block(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-instruction-loop-block(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-kind(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-const(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-left(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-right(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-operand(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-block(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-type-width(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-type-kind(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-scale(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-offset(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-byte-size(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-string(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-expression-arg-index(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-callee-name(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-expression-name(#bits<64> %id) -> #addr;
#extern #proc bootstrap.ir-expression-argument-count(#bits<64> %id) -> #bits<64>;
#extern #proc bootstrap.ir-expression-argument-at(#bits<64> %id, #bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.allocate-pages(#bits<64> %size) -> #addr;
#extern #proc bootstrap.release-pages(#addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(#bits<8> %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(#addr %text) -> #unit;
#extern #proc bootstrap.artifact-write-identifier(#addr %name) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc bootstrap.write-diagnostic(#addr %text, #bits<64> %length) -> #unit;

#proc byte_at(#addr %data, #bits<64> %index) -> #bits<8> {
  #return #load[#bits<8>](#lea(base=%data, idx=%index, scale=1, offset=0))
}

#proc emit_error(#addr %message, #bits<64> %length, #bits<32> %status) -> #bits<32> {
  #call bootstrap.write-diagnostic(%message, %length)
  #return %status
}
#proc seed_procedure_is_main(#bits<64> %procedure_id) -> #bits<1> {
  #if #ne(#call bootstrap.ir-procedure-data(%procedure_id), 0) { #return 0 }
  #let %name: #addr = #call bootstrap.ir-procedure-name(%procedure_id)
  #if #eq(#call byte_at(%name, 0), 0) { #return 0 }
  #if #ne(#call byte_at(%name, 0), 109) { #return 0 }
  #if #ne(#call byte_at(%name, 1), 97) { #return 0 }
  #if #ne(#call byte_at(%name, 2), 105) { #return 0 }
  #if #ne(#call byte_at(%name, 3), 110) { #return 0 }
  #if #ne(#call byte_at(%name, 4), 0) { #return 0 }
  #return 1
}

#proc seed_module_has_main(#bits<64> %module_id) -> #bits<1> {
  #let %procedure_id: #bits<64> = #call bootstrap.ir-module-first(%module_id)
  #loop procedures {
    #if #eq(%procedure_id, 0) { #break procedures }
    #if #call seed_procedure_is_main(%procedure_id) {
      #if #ne(#call bootstrap.ir-procedure-return-width(%procedure_id), 32) {
        #return 0
      }
      #if #ne(#call bootstrap.ir-procedure-parameter-count(%procedure_id), 0) {
        #return 0
      }
      #if #ne(#call bootstrap.ir-procedure-external(%procedure_id), 0) {
        #return 0
      }
      #return 1
    }
    %procedure_id: #bits<64> = #call bootstrap.ir-procedure-next(%procedure_id)
    #continue procedures
  }
  #return 0
}

#proc seed_emit_identifier(#addr %name) -> #unit {
  #call bootstrap.artifact-write-identifier(%name)
  #return
}

#proc seed_find_procedure(#bits<64> %module_id, #addr %name) -> #bits<64> {
  #return #call bootstrap.ir-procedure-find(%module_id, %name)
}
#proc seed_emit_c_type(#bits<64> %kind, #bits<64> %width) -> #bits<1> {
  #if #eq(%kind, 0) {
    #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("uint8_t") #return 1 }
    #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("int8_t") #return 1 }
    #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("int16_t") #return 1 }
    #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("int32_t") #return 1 }
    #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("int64_t") #return 1 }
    #return 0
  }
  #if #eq(%kind, 1) {
    #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("float") #return 1 }
    #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("double") #return 1 }
    #return 0
  }
  #if #eq(%kind, 3) {
    #call bootstrap.artifact-write-literal("uint8_t *")
    #return 1
  }
  #if #eq(%kind, 4) { #call bootstrap.artifact-write-literal("void") #return 1 }
  #if #eq(%kind, 5) { #call bootstrap.artifact-write-literal("void") #return 1 }
  #return 0
}

#proc seed_emit_indent(#bits<64> %depth) -> #unit {
  #let %count: #bits<64> = 0
  #loop spaces {
    #if #sge(%count, %depth) { #break spaces }
    #call bootstrap.artifact-write-literal("  ")
    %count: #bits<64> = #add(%count, 1)
    #continue spaces
  }
  #return
}

#proc seed_emit_string_literal(#addr %text) -> #bits<1> {
  #call bootstrap.artifact-write-byte(34)
  #let %index: #bits<64> = 0
  #loop bytes {
    #if #sge(%index, 4096) { #return 0 }
    #let %byte: #bits<8> = #call byte_at(%text, %index)
    #if #eq(%byte, 0) { #break bytes }
    #if #eq(%byte, 34) {
      #call bootstrap.artifact-write-literal("\\\"")
    } else {
      #if #eq(%byte, 92) {
        #call bootstrap.artifact-write-literal("\\\\")
      } else {
        #if #eq(%byte, 10) {
          #call bootstrap.artifact-write-literal("\\n")
        } else {
          #if #eq(%byte, 13) {
            #call bootstrap.artifact-write-literal("\\r")
          } else {
            #if #eq(%byte, 9) {
              #call bootstrap.artifact-write-literal("\\t")
            } else {
              #call bootstrap.artifact-write-byte(%byte)
            }
          }
        }
      }
    }
    %index: #bits<64> = #add(%index, 1)
    #continue bytes
  }
  #call bootstrap.artifact-write-byte(34)
  #return 1
}

#proc seed_emit_load_helper(#bits<64> %kind, #bits<64> %width) -> #bits<1> {
  #if #eq(%kind, 0) {
    #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("lainir_load_i1") #return 1 }
    #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("lainir_load_i8") #return 1 }
    #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("lainir_load_i16") #return 1 }
    #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("lainir_load_i32") #return 1 }
    #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("lainir_load_i64") #return 1 }
  }
  #if #eq(%kind, 1) {
    #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("lainir_load_f32") #return 1 }
    #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("lainir_load_f64") #return 1 }
  }
  #if #eq(%kind, 3) { #call bootstrap.artifact-write-literal("lainir_load_addr") #return 1 }
  #return 0
}

#proc seed_emit_full_expression(
  #bits<64> %module_id,
  #bits<64> %procedure_id,
  #bits<64> %expression_id,
  #bits<64> %expected_width
) -> #bits<1> {
  #let %kind: #bits<64> = #call bootstrap.ir-expression-kind(%expression_id)
  #if #eq(%kind, 1) {
    #call emit_c_i64(#call bootstrap.ir-expression-const(%expression_id))
    #return 1
  }
  #if #eq(%kind, 0) {
    #call seed_emit_identifier(#call bootstrap.ir-expression-name(%expression_id))
    #return 1
  }
  #if #eq(%kind, 2) {
    #let %index: #bits<64> = #call bootstrap.ir-expression-arg-index(%expression_id)
    #call seed_emit_identifier(
      #call bootstrap.ir-procedure-parameter-name(%procedure_id, %index)
    )
    #return 1
  }
  #if #eq(%kind, 23) {
    #return #call seed_emit_string_literal(
      #call bootstrap.ir-expression-string(%expression_id)
    )
  }
  #if #eq(%kind, 24) {
    #call bootstrap.artifact-write-literal("((uint8_t *)(uintptr_t)")
    #call seed_emit_identifier(#call bootstrap.ir-expression-name(%expression_id))
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #eq(%kind, 25) {
    #call bootstrap.artifact-write-literal("((uint8_t[" )
    #call emit_c_i64(#call bootstrap.ir-expression-byte-size(%expression_id))
    #call bootstrap.artifact-write-literal("]){0})")
    #return 1
  }
  #if #eq(%kind, 26) {
    #call bootstrap.artifact-write-literal("((void)0)")
    #return 1
  }
  #if #eq(%kind, 4) {
    #call bootstrap.artifact-write-literal("((uint8_t *)((uintptr_t)")
    #if #ne(#call bootstrap.ir-expression-left(%expression_id), 0) {
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-left(%expression_id), 64
      ), 0) { #return 0 }
    }
    #call bootstrap.artifact-write-literal(" + ((uintptr_t)")
    #if #ne(#call bootstrap.ir-expression-right(%expression_id), 0) {
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-right(%expression_id), 64
      ), 0) { #return 0 }
    } else {
      #call bootstrap.artifact-write-literal("0")
    }
    #call bootstrap.artifact-write-literal(" * ")
    #call emit_c_i64(#call bootstrap.ir-expression-scale(%expression_id))
    #call bootstrap.artifact-write-literal(" + ")
    #call emit_c_i64(#call bootstrap.ir-expression-offset(%expression_id))
    #call bootstrap.artifact-write-literal(")))")
    #return 1
  }
  #if #eq(%kind, 3) {
    #let %type_kind: #bits<64> = #call bootstrap.ir-expression-type-kind(%expression_id)
    #let %type_width: #bits<64> = #call bootstrap.ir-expression-type-width(%expression_id)
    #if #eq(#call seed_emit_load_helper(%type_kind, %type_width), 0) { #return 0 }
    #call bootstrap.artifact-write-literal("((const void *)")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), 64
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #eq(%kind, 21) {
    #let %callee: #bits<64> = #call seed_find_procedure(
      %module_id, #call bootstrap.ir-expression-callee-name(%expression_id)
    )
    #if #eq(%callee, 0) { #return 0 }
    #call seed_emit_identifier(#call bootstrap.ir-expression-callee-name(%expression_id))
    #call bootstrap.artifact-write-literal("(")
    #let %index: #bits<64> = 0
    #let %count: #bits<64> = #call bootstrap.ir-expression-argument-count(%expression_id)
    #loop arguments {
      #if #sge(%index, %count) { #break arguments }
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-argument-at(%expression_id, %index),
        #call bootstrap.ir-procedure-parameter-width(%callee, %index)
      ), 0) { #return 0 }
      %index: #bits<64> = #add(%index, 1)
      #if #slt(%index, %count) {
        #call bootstrap.artifact-write-literal(", ")
      }
      #continue arguments
    }
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #eq(%kind, 40) {
    #call bootstrap.artifact-write-literal("((uint8_t *)(uintptr_t)&")
    #call seed_emit_identifier(#call bootstrap.ir-expression-callee-name(%expression_id))
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #sge(%kind, 37) {
    #if #sle(%kind, 39) {
      #call bootstrap.artifact-write-literal("((")
      #if #eq(#call seed_emit_c_type(
        #call bootstrap.ir-expression-type-kind(%expression_id),
        #call bootstrap.ir-expression-type-width(%expression_id)
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(")")
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-operand(%expression_id),
        %expected_width
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(")")
      #return 1
    }
  }
  #if #eq(%kind, 41) {
    #call bootstrap.artifact-write-literal("((")
    #if #eq(#call seed_emit_c_type(
      #call bootstrap.ir-expression-type-kind(%expression_id),
      #call bootstrap.ir-expression-type-width(%expression_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(")")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id),
      %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #sge(%kind, 5) {
    #if #sle(%kind, 9) {
      #call bootstrap.artifact-write-literal("(")
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-left(%expression_id), %expected_width
      ), 0) { #return 0 }
      #if #eq(%kind, 5) { #call bootstrap.artifact-write-literal(" + ") }
      #if #eq(%kind, 6) { #call bootstrap.artifact-write-literal(" - ") }
      #if #eq(%kind, 7) { #call bootstrap.artifact-write-literal(" * ") }
      #if #eq(%kind, 8) { #call bootstrap.artifact-write-literal(" == ") }
      #if #eq(%kind, 9) { #call bootstrap.artifact-write-literal(" != ") }
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-right(%expression_id), %expected_width
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(")")
      #return 1
    }
  }
  #if #sge(%kind, 27) {
    #if #sle(%kind, 36) {
      #call bootstrap.artifact-write-literal("(")
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-left(%expression_id), %expected_width
      ), 0) { #return 0 }
      #if #eq(%kind, 27) { #call bootstrap.artifact-write-literal(" / ") }
      #if #eq(%kind, 28) { #call bootstrap.artifact-write-literal(" / ") }
      #if #eq(%kind, 29) { #call bootstrap.artifact-write-literal(" < ") }
      #if #eq(%kind, 30) { #call bootstrap.artifact-write-literal(" <= ") }
      #if #eq(%kind, 31) { #call bootstrap.artifact-write-literal(" > ") }
      #if #eq(%kind, 32) { #call bootstrap.artifact-write-literal(" >= ") }
      #if #eq(%kind, 33) { #call bootstrap.artifact-write-literal(" < ") }
      #if #eq(%kind, 34) { #call bootstrap.artifact-write-literal(" <= ") }
      #if #eq(%kind, 35) { #call bootstrap.artifact-write-literal(" > ") }
      #if #eq(%kind, 36) { #call bootstrap.artifact-write-literal(" >= ") }
      #if #eq(#call seed_emit_full_expression(
        %module_id, %procedure_id,
        #call bootstrap.ir-expression-right(%expression_id), %expected_width
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(")")
      #return 1
    }
  }
  #if #sge(%kind, 15) {
    #if #sle(%kind, 20) {
      #call bootstrap.artifact-write-literal("(")
      #if #eq(#call seed_emit_full_expression(%module_id, %procedure_id, #call bootstrap.ir-expression-left(%expression_id), %expected_width), 0) { #return 0 }
      #if #eq(%kind, 15) { #call bootstrap.artifact-write-literal(" + ") }
      #if #eq(%kind, 16) { #call bootstrap.artifact-write-literal(" - ") }
      #if #eq(%kind, 17) { #call bootstrap.artifact-write-literal(" * ") }
      #if #eq(%kind, 18) { #call bootstrap.artifact-write-literal(" / ") }
      #if #eq(%kind, 19) { #call bootstrap.artifact-write-literal(" == ") }
      #if #eq(%kind, 20) { #call bootstrap.artifact-write-literal(" < ") }
      #if #eq(#call seed_emit_full_expression(%module_id, %procedure_id, #call bootstrap.ir-expression-right(%expression_id), %expected_width), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(")")
      #return 1
    }
  }
  #if #eq(%kind, 10) {
    #call bootstrap.artifact-write-literal("__builtin_popcountll((unsigned long long)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal("))")
    #return 1
  }
  #if #eq(%kind, 11) {
    #call bootstrap.artifact-write-literal("__builtin_clzll((unsigned long long)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal("))")
    #return 1
  }
  #if #eq(%kind, 12) {
    #call bootstrap.artifact-write-literal("((((uint64_t)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(") << 1) | ((uint64_t)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(") >> 63))")
    #return 1
  }
  #if #eq(%kind, 13) {
    #call bootstrap.artifact-write-literal("((uint8_t *)(uintptr_t)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #if #eq(%kind, 14) {
    #call bootstrap.artifact-write-literal("((uint64_t)(uintptr_t)(")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-expression-operand(%expression_id), %expected_width
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(")")
    #return 1
  }
  #return 0
}

// `#unit` and `#never` are physical types with no C representation: a binding
// of such a type names no value the emitter can give a C object.  The binding
// is still a real instruction, so its initializer keeps being emitted for its
// effects while nothing is declared for the name.
#proc seed_type_has_value(#bits<64> %type_kind) -> #bits<1> {
  #if #eq(%type_kind, 4) { #return 0 }
  #if #eq(%type_kind, 5) { #return 0 }
  #return 1
}

#proc seed_emit_effect_only_binding(
  #bits<64> %module_id,
  #bits<64> %procedure_id,
  #bits<64> %instruction_id,
  #bits<64> %depth
) -> #bits<1> {
  #let %value_id: #bits<64> = #call bootstrap.ir-instruction-value(%instruction_id)
  // A folded `#eval` has no physical result left, so there is nothing to emit.
  #if #eq(%value_id, 0) { #return 1 }
  #call seed_emit_indent(%depth)
  #if #eq(#call seed_emit_full_expression(
    %module_id, %procedure_id, %value_id, 0
  ), 0) { #return 0 }
  #call bootstrap.artifact-write-literal(";\n")
  #return 1
}

#proc seed_emit_full_instruction(
  #bits<64> %module_id,
  #bits<64> %procedure_id,
  #bits<64> %instruction_id,
  #bits<64> %depth
) -> #bits<1> {
  #let %kind: #bits<64> = #call bootstrap.ir-instruction-kind(%instruction_id)
  #if #eq(%kind, 0) {
    #if #eq(#call seed_type_has_value(
      #call bootstrap.ir-instruction-type-kind(%instruction_id)
    ), 0) {
      #return #call seed_emit_effect_only_binding(
        %module_id, %procedure_id, %instruction_id, %depth
      )
    }
    #call seed_emit_indent(%depth)
    #if #eq(#call seed_emit_c_type(
      #call bootstrap.ir-instruction-type-kind(%instruction_id),
      #call bootstrap.ir-instruction-type-width(%instruction_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(" ")
    #call seed_emit_identifier(#call bootstrap.ir-instruction-name(%instruction_id))
    #call bootstrap.artifact-write-literal(" = ")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-value(%instruction_id),
      #call bootstrap.ir-instruction-type-width(%instruction_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(";\n")
    #return 1
  }
  #if #eq(%kind, 1) {
    #if #eq(#call seed_type_has_value(
      #call bootstrap.ir-instruction-type-kind(%instruction_id)
    ), 0) {
      #return #call seed_emit_effect_only_binding(
        %module_id, %procedure_id, %instruction_id, %depth
      )
    }
    #call seed_emit_indent(%depth)
    #call seed_emit_identifier(#call bootstrap.ir-instruction-name(%instruction_id))
    #call bootstrap.artifact-write-literal(" = ")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-value(%instruction_id),
      #call bootstrap.ir-instruction-type-width(%instruction_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(";\n")
    #return 1
  }
  #if #eq(%kind, 2) {
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("{ ")
    #if #eq(#call seed_emit_c_type(
      #call bootstrap.ir-instruction-type-kind(%instruction_id),
      #call bootstrap.ir-instruction-type-width(%instruction_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(" _lainir_store = ")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-value(%instruction_id),
      #call bootstrap.ir-instruction-type-width(%instruction_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal("; memcpy((void *)")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-destination(%instruction_id), 64
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(", &_lainir_store, sizeof(_lainir_store)); }\n")
    #return 1
  }
  #if #eq(%kind, 3) {
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("if (")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-condition(%instruction_id), 1
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(") {\n")
    #if #eq(#call seed_emit_full_block(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-then-block(%instruction_id), #add(%depth, 1)
    ), 0) { #return 0 }
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("}")
    #let %else_id: #bits<64> = #call bootstrap.ir-instruction-else-block(%instruction_id)
    #if #ne(%else_id, 0) {
      #call bootstrap.artifact-write-literal(" else {\n")
      #if #eq(#call seed_emit_full_block(
        %module_id, %procedure_id, %else_id, #add(%depth, 1)
      ), 0) { #return 0 }
      #call seed_emit_indent(%depth)
      #call bootstrap.artifact-write-literal("}")
    }
    #call bootstrap.artifact-write-literal("\n")
    #return 1
  }
  #if #eq(%kind, 4) {
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("while (1) {\n")
    #if #eq(#call seed_emit_full_block(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-loop-block(%instruction_id), #add(%depth, 1)
    ), 0) { #return 0 }
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("}\n")
    #return 1
  }
  #if #eq(%kind, 5) {
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("break;\n")
    #return 1
  }
  #if #eq(%kind, 6) {
    #call seed_emit_indent(%depth)
    #call bootstrap.artifact-write-literal("continue;\n")
    #return 1
  }
  #if #eq(%kind, 7) {
    #if #eq(#call seed_type_has_value(
      #call bootstrap.ir-procedure-return-kind(%procedure_id)
    ), 0) {
      // The returned value has no C representation: evaluate it for its
      // effects and return without handing a value back.
      #let %return_value: #bits<64> = #call bootstrap.ir-instruction-value(%instruction_id)
      #if #ne(%return_value, 0) {
        #call seed_emit_indent(%depth)
        #if #eq(#call seed_emit_full_expression(
          %module_id, %procedure_id, %return_value, 0
        ), 0) { #return 0 }
        #call bootstrap.artifact-write-literal(";\n")
      }
      #call seed_emit_indent(%depth)
      #call bootstrap.artifact-write-literal("return;\n")
      #return 1
    }
    #call seed_emit_indent(%depth)
    #let %value_id: #bits<64> = #call bootstrap.ir-instruction-value(%instruction_id)
    #if #eq(%value_id, 0) {
      #call bootstrap.artifact-write-literal("return;\n")
      #return 1
    }
    #call bootstrap.artifact-write-literal("return ")
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id, %value_id,
      #call bootstrap.ir-procedure-return-width(%procedure_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(";\n")
    #return 1
  }
  #if #eq(%kind, 8) {
    #call seed_emit_indent(%depth)
    #if #eq(#call seed_emit_full_expression(
      %module_id, %procedure_id,
      #call bootstrap.ir-instruction-value(%instruction_id), 0
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(";\n")
    #return 1
  }
  #return 0
}

#proc seed_emit_full_block(
  #bits<64> %module_id,
  #bits<64> %procedure_id,
  #bits<64> %block_id,
  #bits<64> %depth
) -> #bits<1> {
  #let %instruction_id: #bits<64> = #call bootstrap.ir-block-first-instruction(%block_id)
  #loop instructions {
    #if #eq(%instruction_id, 0) { #return 1 }
    #if #eq(#call seed_emit_full_instruction(
      %module_id, %procedure_id, %instruction_id, %depth
    ), 0) { #return 0 }
    %instruction_id: #bits<64> = #call bootstrap.ir-instruction-next(%instruction_id)
    #continue instructions
  }
  #return 1
}

#proc seed_emit_full_parameters(#bits<64> %procedure_id) -> #bits<1> {
  #let %count: #bits<64> = #call bootstrap.ir-procedure-parameter-count(%procedure_id)
  #if #eq(%count, 0) {
    #call bootstrap.artifact-write-literal("void")
    #return 1
  }
  #let %index: #bits<64> = 0
  #loop parameters {
    #if #sge(%index, %count) { #break parameters }
    #let %kind: #bits<64> = #call bootstrap.ir-procedure-parameter-kind(%procedure_id, %index)
    #let %width: #bits<64> = #call bootstrap.ir-procedure-parameter-width(%procedure_id, %index)
    #if #eq(#call seed_emit_c_type(%kind, %width), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(" ")
    #call seed_emit_identifier(
      #call bootstrap.ir-procedure-parameter-name(%procedure_id, %index)
    )
    %index: #bits<64> = #add(%index, 1)
    #if #slt(%index, %count) { #call bootstrap.artifact-write-literal(", ") }
    #continue parameters
  }
  #return 1
}

#proc seed_emit_data_object(#bits<64> %data_id) -> #bits<1> {
  #call bootstrap.artifact-write-literal("_Alignas(")
  #call emit_c_i64(#call bootstrap.ir-data-alignment(%data_id))
  #call bootstrap.artifact-write-literal(") static const uint8_t ")
  #call seed_emit_identifier(#call bootstrap.ir-procedure-name(%data_id))
  #call bootstrap.artifact-write-literal("[")
  #let %size: #bits<64> = #call bootstrap.ir-data-size(%data_id)
  #call emit_c_i64(%size)
  #call bootstrap.artifact-write-literal("] = {")
  #let %index: #bits<64> = 0
  #loop data_bytes {
    #if #sge(%index, %size) { #break data_bytes }
    #if #ne(%index, 0) { #call bootstrap.artifact-write-literal(", ") }
    #call emit_c_i64(#zext[#bits<64>](#call bootstrap.ir-data-byte(%data_id, %index)))
    %index: #bits<64> = #add(%index, 1)
    #continue data_bytes
  }
  #call bootstrap.artifact-write-literal("};\n")
  #return 1
}

#proc seed_emit_full_module(#bits<64> %module_id, #bits<1> %require_main) -> #bits<1> {
  #if %require_main {
    #if #eq(#call seed_module_has_main(%module_id), 0) { #return 0 }
  }
  // The seed parser and verifier have already checked the complete module.
  // Walk it once for emission; capability failures still abort the artifact.
  #let %procedure_id: #bits<64> = #call bootstrap.ir-module-first(%module_id)
  #if #eq(%procedure_id, 0) { #return 0 }
  #call bootstrap.artifact-begin()
  #call bootstrap.artifact-write-literal(
    "#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <stdlib.h>\n\n"
  )
  #call bootstrap.artifact-write-literal(
    "static uint8_t lainir_load_i1(const void *p) { uint8_t v; memcpy(&v, p, sizeof(v)); return v & 1u; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static int8_t lainir_load_i8(const void *p) { int8_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static int16_t lainir_load_i16(const void *p) { int16_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static int32_t lainir_load_i32(const void *p) { int32_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static int64_t lainir_load_i64(const void *p) { int64_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static uint8_t *lainir_load_addr(const void *p) { uint8_t *v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static float lainir_load_f32(const void *p) { float v; memcpy(&v, p, sizeof(v)); return v; }\n"
  )
  #call bootstrap.artifact-write-literal(
    "static double lainir_load_f64(const void *p) { double v; memcpy(&v, p, sizeof(v)); return v; }\n\n"
  )
  %procedure_id: #bits<64> = #call bootstrap.ir-module-first(%module_id)
  #loop data_objects {
    #if #eq(%procedure_id, 0) { #break data_objects }
    #if #ne(#call bootstrap.ir-procedure-data(%procedure_id), 0) {
      #if #eq(#call seed_emit_data_object(%procedure_id), 0) { #return 0 }
    }
    %procedure_id: #bits<64> = #call bootstrap.ir-procedure-next(%procedure_id)
    #continue data_objects
  }
  #call bootstrap.artifact-write-literal("\n")
  %procedure_id: #bits<64> = #call bootstrap.ir-module-first(%module_id)
  #loop prototypes {
    #if #eq(%procedure_id, 0) { #break prototypes }
    #if #eq(#call bootstrap.ir-procedure-data(%procedure_id), 0) {
    #if #eq(#call seed_emit_c_type(
      #call bootstrap.ir-procedure-return-kind(%procedure_id),
      #call bootstrap.ir-procedure-return-width(%procedure_id)
    ), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(" ")
    #call seed_emit_identifier(#call bootstrap.ir-procedure-name(%procedure_id))
    #call bootstrap.artifact-write-literal("(")
    #if #eq(#call seed_emit_full_parameters(%procedure_id), 0) { #return 0 }
    #call bootstrap.artifact-write-literal(");\n")
    }
    %procedure_id: #bits<64> = #call bootstrap.ir-procedure-next(%procedure_id)
    #continue prototypes
  }
  #call bootstrap.artifact-write-literal("\n")
  %procedure_id: #bits<64> = #call bootstrap.ir-module-first(%module_id)
  #loop definitions {
    #if #eq(%procedure_id, 0) { #break definitions }
    #if #eq(#call bootstrap.ir-procedure-data(%procedure_id), 0) {
    #if #eq(#call bootstrap.ir-procedure-external(%procedure_id), 0) {
      #if #eq(#call seed_emit_c_type(
        #call bootstrap.ir-procedure-return-kind(%procedure_id),
        #call bootstrap.ir-procedure-return-width(%procedure_id)
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(" ")
      #call seed_emit_identifier(#call bootstrap.ir-procedure-name(%procedure_id))
      #call bootstrap.artifact-write-literal("(")
      #if #eq(#call seed_emit_full_parameters(%procedure_id), 0) { #return 0 }
      #call bootstrap.artifact-write-literal(") {\n")
      #if #eq(#call seed_emit_full_block(
        %module_id, %procedure_id,
        #call bootstrap.ir-procedure-first-block(%procedure_id), 1
      ), 0) { #return 0 }
      #call bootstrap.artifact-write-literal("}\n\n")
    }
    }
    %procedure_id: #bits<64> = #call bootstrap.ir-procedure-next(%procedure_id)
    #continue definitions
  }
  #call bootstrap.artifact-finish()
  #return 1
}
#proc emit_c_i64(#bits<64> %value) -> #unit {
  #if #eq(%value, 0) {
    #call bootstrap.artifact-write-byte(48)
    #return
  }
  #let %negative: #bits<1> = #slt(%value, 0)
  #let %current: #bits<64> = %value
  #let %buffer: #addr = #call bootstrap.allocate-pages(32)
  #let %count: #bits<64> = 0
  #loop digits {
    #if #eq(%current, 0) { #break digits }
    #let %quotient: #bits<64> = #udiv(%current, 10)
    #let %remainder: #bits<64> = #sub(%current, #mul(%quotient, 10))
    #if %negative { %remainder = #sub(0, %remainder) }
    #store #add(48, %remainder), #lea(
      base=%buffer, idx=%count, scale=1, offset=0
    )
    %count = #add(%count, 1)
    %current: #bits<64> = %quotient
    #continue digits
  }
  #if %negative { #call bootstrap.artifact-write-byte(45) }
  #loop output {
    #if #eq(%count, 0) { #break output }
    %count = #sub(%count, 1)
    #call bootstrap.artifact-write-byte(#load[#bits<8>](#lea(
      base=%buffer, idx=%count, scale=1, offset=0
    )))
    #continue output
  }
  #call bootstrap.release-pages(%buffer)
  #return
}

#proc lainir_compile() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return #call emit_error(
      "lainir-c stage 0 expects exactly one source",
      43,
      2
    )
  }

  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #if #eq(#call bootstrap.validate-source(%data, %length), 0) {
    #return #call emit_error("seed parser/verifier rejected source", 38, 2)
  }
  #let %seed_module_id: #bits<64> = #call bootstrap.ir-module-id(%data, %length)
  #if #eq(%seed_module_id, 0) {
    #return #call emit_error("seed module handle unavailable", 31, 2)
  }
  #if #eq(#call seed_module_has_main(%seed_module_id), 0) {
    #call bootstrap.ir-module-id-release(%seed_module_id)
    #return #call emit_error("seed module has no valid main", 29, 2)
  }
  #if #eq(#call bootstrap.eval_source(%data, %length), 0) {
    #call bootstrap.ir-module-id-release(%seed_module_id)
    #return #call emit_error(
      "cannot evaluate #eval at compile time",
      39,
      2
    )
  }
  #if #call seed_emit_full_module(%seed_module_id, 1) {
    #call bootstrap.ir-module-id-release(%seed_module_id)
    #return 0
  }
  #call bootstrap.ir-module-id-release(%seed_module_id)
  #return #call emit_error("seed-backed emitter does not support this IR", 44, 3)
}

// Library/module mode is used by the bootstrap fixed point. Unlike the native
// program mode it does not require a C-shaped `main`.

#proc lainir_compile_module() -> #bits<32> {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return #call emit_error(
      "lainir-c module mode expects exactly one source",
      45,
      2
    )
  }
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #if #eq(#call bootstrap.validate-source(%data, %length), 0) {
    #return #call emit_error("seed parser/verifier rejected source", 38, 2)
  }
  #let %seed_module_id: #bits<64> = #call bootstrap.ir-module-id(%data, %length)
  #if #eq(%seed_module_id, 0) {
    #return #call emit_error("seed module handle unavailable", 31, 2)
  }
  #if #eq(#call bootstrap.eval_source(%data, %length), 0) {
    #return #call emit_error(
      "cannot evaluate #eval at compile time",
      39,
      2
    )
  }
  #if #call seed_emit_full_module(%seed_module_id, 0) {
    #call bootstrap.ir-module-id-release(%seed_module_id)
    #return 0
  }
  #call bootstrap.ir-module-id-release(%seed_module_id)
  #return #call emit_error("seed-backed emitter does not support this IR", 44, 3)
}
