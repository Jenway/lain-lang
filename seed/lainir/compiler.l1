#proc module_uses_division(addr %module) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) { #break functions }
    #if #call body_uses_division(#call ir_function_body(%function)) { #return 1 }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 0
}

#proc emit_c_load_name(i32 %width) -> #unit {
  #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("lainir_load_i1") #return }
  #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("lainir_load_i8") #return }
  #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("lainir_load_i16") #return }
  #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("lainir_load_i32") #return }
  #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("lainir_load_i64") #return }
  #if #eq(%width, 128) { #call bootstrap.artifact-write-literal("lainir_load_addr") #return }
  #if #eq(%width, 288) { #call bootstrap.artifact-write-literal("lainir_load_f32") #return }
  #if #eq(%width, 320) { #call bootstrap.artifact-write-literal("lainir_load_f64") #return }
  #call bootstrap.artifact-write-literal("lainir_load_invalid")
  #return
}

#proc emit_c_indirect_parameter_types(addr %expression) -> #unit {
  #let %parameter: addr = #call ir_indirect_first_parameter(%expression)
  #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
  #if #eq(%remaining, 0) {
    #call bootstrap.artifact-write-literal("void")
    #return
  }
  #loop parameters {
    #if #eq(%remaining, 0) { #break parameters }
    #call emit_c_bits_type(#call ir_parameter_width(%parameter))
    %remaining: i64 = #sub(%remaining, 1)
    #if #ne(%remaining, 0) {
      #call bootstrap.artifact-write-literal(", ")
    }
    %parameter: addr = #call ir_parameter_next(%parameter)
    #continue parameters
  }
  #return
}

#proc emit_c_unsigned_type(i32 %width) -> #unit {
  #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("uint8_t") #return }
  #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("uint8_t") #return }
  #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("uint16_t") #return }
  #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("uint32_t") #return }
  #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("uint64_t") #return }
  #call bootstrap.artifact-write-literal("uint32_t")
  #return
}

#proc emit_c_div_name(i32 %width) -> #unit {
  #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("lainir_div_i1") #return }
  #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("lainir_div_i8") #return }
  #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("lainir_div_i16") #return }
  #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("lainir_div_i32") #return }
  #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("lainir_div_i64") #return }
  #call bootstrap.artifact-write-literal("lainir_div_invalid")
  #return
}

#proc emit_c_signed_div_name(i32 %width) -> #unit {
  #if #eq(%width, 1) { #call bootstrap.artifact-write-literal("lainir_sdiv_i1") #return }
  #if #eq(%width, 8) { #call bootstrap.artifact-write-literal("lainir_sdiv_i8") #return }
  #if #eq(%width, 16) { #call bootstrap.artifact-write-literal("lainir_sdiv_i16") #return }
  #if #eq(%width, 32) { #call bootstrap.artifact-write-literal("lainir_sdiv_i32") #return }
  #if #eq(%width, 64) { #call bootstrap.artifact-write-literal("lainir_sdiv_i64") #return }
  #call bootstrap.artifact-write-literal("lainir_sdiv_invalid")
  #return
}

#proc emit_c_wrapping_binary(
  addr %data,
  addr %expression,
  i32 %kind
) -> #unit {
  #let %width: i32 = #call ir_body_let_width(%expression)
  #if #eq(%kind, 6) {
    #call emit_c_div_name(%width)
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(", ")
    #call emit_c_expression(%data, #call ir_expr_right(%expression))
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 31) {
    #call emit_c_signed_div_name(%width)
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(", ")
    #call emit_c_expression(%data, #call ir_expr_right(%expression))
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 32) {
    #call emit_c_div_name(%width)
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(", ")
    #call emit_c_expression(%data, #call ir_expr_right(%expression))
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #call bootstrap.artifact-write-literal("((")
  #call emit_c_bits_type(%width)
  #call bootstrap.artifact-write-literal(")(")
  #call emit_c_unsigned_type(%width)
  #call bootstrap.artifact-write-literal(")((((")
  #call emit_c_unsigned_type(%width)
  #call bootstrap.artifact-write-literal(")(")
  #call emit_c_expression(%data, #call ir_expr_left(%expression))
  #call bootstrap.artifact-write-literal("))")
  #call emit_c_binary_operator(%kind)
  #call bootstrap.artifact-write-literal("((")
  #call emit_c_unsigned_type(%width)
  #call bootstrap.artifact-write-literal(")(")
  #call emit_c_expression(%data, #call ir_expr_right(%expression))
  #call bootstrap.artifact-write-literal("))))")
  #if #eq(%width, 1) {
    #call bootstrap.artifact-write-literal(" & 1u")
  }
  #call bootstrap.artifact-write-literal(")")
  #return
}

#proc emit_c_expression(addr %data, addr %expression) -> #unit {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  // #eval is consumed during compilation.  The compile-time pass replaces
  // supported blocks with kind=73 scalar constants before C emission; this
  // branch remains a defensive fallback for an unmaterialized block.
  #if #eq(%kind, 46) {
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #return
  }
  #if #eq(%kind, 73) {
    #let %value: i64 = #load[i64](#lea(
      base=%expression, idx=0, scale=0, offset=24
    ))
    #if #lt(%value, 0) {
      #call bootstrap.artifact-write-byte(45)
      %value: i64 = #sub(0, %value)
    }
    #if #eq(%value, 0) {
      #call bootstrap.artifact-write-byte(48)
      #return
    }
    #let %buffer: addr = #call bootstrap.allocate-pages(32)
    #let %count: i64 = 0
    #loop digits {
      #if #eq(%value, 0) { #break digits }
      #let %quotient: i64 = #div(%value, 10)
      #store #add(48, #sub(%value, #mul(%quotient, 10))), #lea(
        base=%buffer, idx=%count, scale=1, offset=0
      )
      %count: i64 = #add(%count, 1)
      %value: i64 = %quotient
      #continue digits
    }
    #loop output {
      #if #eq(%count, 0) { #break output }
      %count: i64 = #sub(%count, 1)
      #call bootstrap.artifact-write-byte(#load[i8](#lea(
        base=%buffer, idx=%count, scale=1, offset=0
      )))
      #continue output
    }
    #call bootstrap.release-pages(%buffer)
    #return
  }
  #if #eq(%kind, 1) {
    #let %start: i64 = #call ir_expr_start(%expression)
    #call emit_source_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%expression))
    )
    #return
  }
  #if #ge(%kind, 41) {
    #if #le(%kind, 43) {
      #let %target_width: i32 = #call ir_body_let_width(%expression)
      #let %source_width: i32 = #load[i32](#lea(
        base=%expression, idx=0, scale=0, offset=40
      ))
      #call bootstrap.artifact-write-literal("((")
      #call emit_c_bits_type(%target_width)
      #call bootstrap.artifact-write-literal(")")
      #if #eq(%kind, 41) {
        #call bootstrap.artifact-write-literal("((")
        #call emit_c_unsigned_type(%source_width)
        #call bootstrap.artifact-write-literal(")")
      }
      #if #eq(%kind, 42) {
        #call bootstrap.artifact-write-literal("((")
        #call emit_c_bits_type(%source_width)
        #call bootstrap.artifact-write-literal(")")
      }
      #if #eq(%kind, 43) {
        #call bootstrap.artifact-write-literal("((")
        #call emit_c_unsigned_type(%target_width)
        #call bootstrap.artifact-write-literal(")")
      }
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal("))")
      #return
    }
  }
  #if #eq(%kind, 72) {
    #let %source_width: i32 = #load[i32](#lea(
      base=%expression, idx=0, scale=0, offset=40
    ))
    #let %target_width: i32 = #call ir_body_let_width(%expression)
    #if #eq(%source_width, %target_width) {
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #return
    }
    #if #eq(%source_width, 288) {
      #call bootstrap.artifact-write-literal(
        "((union { uint32_t i; float f; }){ .f = (float)("
      )
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal(" ) }).i")
      #return
    }
    #if #eq(%source_width, 320) {
      #call bootstrap.artifact-write-literal(
        "((union { uint64_t i; double f; }){ .f = (double)("
      )
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal(" ) }).i")
      #return
    }
    #if #eq(%target_width, 288) {
      #call bootstrap.artifact-write-literal(
        "((union { uint32_t i; float f; }){ .i = (uint32_t)("
      )
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal(" ) }).f")
      #return
    }
    #if #eq(%target_width, 320) {
      #call bootstrap.artifact-write-literal(
        "((union { uint64_t i; double f; }){ .i = (uint64_t)("
      )
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal(" ) }).f")
      #return
    }
    #call bootstrap.artifact-write-literal("0")
    #return
  }
  #if #call ir_expr_is_binary(%expression) {
    #if #le(%kind, 6) {
      #call emit_c_wrapping_binary(%data, %expression, %kind)
      #return
    }
    #if #eq(%kind, 31) {
      #call emit_c_wrapping_binary(%data, %expression, %kind)
      #return
    }
    #if #eq(%kind, 32) {
      #call emit_c_wrapping_binary(%data, %expression, %kind)
      #return
    }
    #if #ge(%kind, 66) {
      #if #le(%kind, 71) {
        #call bootstrap.artifact-write-literal("(")
        #call emit_c_expression(%data, #call ir_expr_left(%expression))
        #call emit_c_binary_operator(%kind)
        #call emit_c_expression(%data, #call ir_expr_right(%expression))
        #call bootstrap.artifact-write-literal(")")
        #return
      }
    }
    #if #ge(%kind, 37) {
      #call bootstrap.artifact-write-literal("((")
      #call emit_c_unsigned_type(#call ir_body_let_width(%expression))
      #call bootstrap.artifact-write-literal(")(")
      #call emit_c_expression(%data, #call ir_expr_left(%expression))
      #call bootstrap.artifact-write-literal(")")
      #call emit_c_binary_operator(%kind)
      #call bootstrap.artifact-write-literal("(")
      #call emit_c_unsigned_type(#call ir_body_let_width(%expression))
      #call bootstrap.artifact-write-literal(")(")
      #call emit_c_expression(%data, #call ir_expr_right(%expression))
      #call bootstrap.artifact-write-literal("))")
      #return
    }
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call emit_c_binary_operator(%kind)
    #call emit_c_expression(%data, #call ir_expr_right(%expression))
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 3) {
    #let %start: i64 = #call ir_expr_start(%expression)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%expression))
    )
    #call bootstrap.artifact-write-literal("(")
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #call emit_c_expression(%data, %argument)
      %remaining: i64 = #sub(%remaining, 1)
      #if #ne(%remaining, 0) {
        #call bootstrap.artifact-write-literal(", ")
      }
      %argument: addr = #call ir_expr_next(%argument)
      #continue arguments
    }
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 13) {
    #let %start: i64 = #call ir_expr_start(%expression)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%expression))
    )
    #return
  }
  #if #eq(%kind, 29) {
    #call bootstrap.artifact-write-literal("\"")
    #let %start: i64 = #call ir_expr_start(%expression)
    #call emit_source_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%expression))
    )
    #call bootstrap.artifact-write-literal("\"")
    #return
  }
  #if #eq(%kind, 21) {
    #call bootstrap.artifact-write-literal("((uint8_t[")
    #let %start: i64 = #call ir_expr_start(%expression)
    #if #eq(#call ir_expr_length(%expression), 0) {
      #if #eq(%start, 1) { #call bootstrap.artifact-write-literal("1") }
      #if #eq(%start, 2) { #call bootstrap.artifact-write-literal("2") }
      #if #eq(%start, 4) { #call bootstrap.artifact-write-literal("4") }
      #if #eq(%start, 8) { #call bootstrap.artifact-write-literal("8") }
    } else {
      #call emit_source_range(
        %data,
        %start,
        #add(%start, #call ir_expr_length(%expression))
      )
    }
    #call bootstrap.artifact-write-literal("]){0})")
    #return
  }
  #if #eq(%kind, 22) {
    #call emit_c_load_name(#call ir_body_let_width(%expression))
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 30) {
    #call emit_c_load_name(#call ir_body_let_width(%expression))
    #call bootstrap.artifact-write-literal("((uint8_t *)((uintptr_t)")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(" + ")
    #let %offset_start: i64 = #call ir_expr_start(%expression)
    #call emit_source_range(
      %data,
      %offset_start,
      #add(%offset_start, #call ir_expr_length(%expression))
    )
    #call bootstrap.artifact-write-literal("))")
    #return
  }
  #if #eq(%kind, 23) {
    #call bootstrap.artifact-write-literal("((uint8_t *)((uintptr_t)")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(" + ((uintptr_t)")
    #call emit_c_expression(%data, #call ir_expr_right(%expression))
    #call bootstrap.artifact-write-literal(" * ")
    #let %scale_start: i64 = #call ir_expr_start(%expression)
    #call emit_source_range(
      %data,
      %scale_start,
      #add(%scale_start, #call ir_expr_length(%expression))
    )
    #call bootstrap.artifact-write-literal(") + ")
    #let %offset_start: i64 = #call ir_expr_lea_offset_start(%expression)
    #call emit_source_range(
      %data,
      %offset_start,
      #add(%offset_start, #call ir_expr_lea_offset_length(%expression))
    )
    #call bootstrap.artifact-write-literal("))")
    #return
  }
  #if #eq(%kind, 25) {
    #call bootstrap.artifact-write-literal("((uint8_t *)(uintptr_t)&")
    #let %start: i64 = #call ir_expr_start(%expression)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%expression))
    )
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #if #eq(%kind, 26) {
    #call bootstrap.artifact-write-literal("((")
    #call emit_c_bits_type(#call ir_body_let_width(%expression))
    #call bootstrap.artifact-write-literal(" (*)(")
    #call emit_c_indirect_parameter_types(%expression)
    #call bootstrap.artifact-write-literal("))(uintptr_t)")
    #call emit_c_expression(%data, #call ir_expr_left(%expression))
    #call bootstrap.artifact-write-literal(")(")
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_arguments {
      #if #eq(%remaining, 0) { #break indirect_arguments }
      #call emit_c_expression(%data, %argument)
      %remaining: i64 = #sub(%remaining, 1)
      #if #ne(%remaining, 0) {
        #call bootstrap.artifact-write-literal(", ")
      }
      %argument: addr = #call ir_expr_next(%argument)
      #continue indirect_arguments
    }
    #call bootstrap.artifact-write-literal(")")
    #return
  }
  #call bootstrap.artifact-write-literal("0")
  #return
}

#proc emit_c_binary_operator(i32 %kind) -> #unit {
  #if #eq(%kind, 2) { #call bootstrap.artifact-write-literal(" + ") #return }
  #if #eq(%kind, 4) { #call bootstrap.artifact-write-literal(" - ") #return }
  #if #eq(%kind, 5) { #call bootstrap.artifact-write-literal(" * ") #return }
  #if #eq(%kind, 6) { #call bootstrap.artifact-write-literal(" / ") #return }
  #if #eq(%kind, 7) { #call bootstrap.artifact-write-literal(" == ") #return }
  #if #eq(%kind, 8) { #call bootstrap.artifact-write-literal(" != ") #return }
  #if #eq(%kind, 9) { #call bootstrap.artifact-write-literal(" < ") #return }
  #if #eq(%kind, 10) { #call bootstrap.artifact-write-literal(" <= ") #return }
  #if #eq(%kind, 11) { #call bootstrap.artifact-write-literal(" > ") #return }
  #if #eq(%kind, 12) { #call bootstrap.artifact-write-literal(" >= ") #return }
  #if #eq(%kind, 33) { #call bootstrap.artifact-write-literal(" < ") #return }
  #if #eq(%kind, 34) { #call bootstrap.artifact-write-literal(" <= ") #return }
  #if #eq(%kind, 35) { #call bootstrap.artifact-write-literal(" > ") #return }
  #if #eq(%kind, 36) { #call bootstrap.artifact-write-literal(" >= ") #return }
  #if #eq(%kind, 37) { #call bootstrap.artifact-write-literal(" < ") #return }
  #if #eq(%kind, 38) { #call bootstrap.artifact-write-literal(" <= ") #return }
  #if #eq(%kind, 39) { #call bootstrap.artifact-write-literal(" > ") #return }
  #if #eq(%kind, 40) { #call bootstrap.artifact-write-literal(" >= ") #return }
  #if #eq(%kind, 66) { #call bootstrap.artifact-write-literal(" + ") #return }
  #if #eq(%kind, 67) { #call bootstrap.artifact-write-literal(" - ") #return }
  #if #eq(%kind, 68) { #call bootstrap.artifact-write-literal(" * ") #return }
  #if #eq(%kind, 69) { #call bootstrap.artifact-write-literal(" / ") #return }
  #if #eq(%kind, 70) { #call bootstrap.artifact-write-literal(" == ") #return }
  #if #eq(%kind, 71) { #call bootstrap.artifact-write-literal(" < ") #return }
  #call bootstrap.artifact-write-literal(" /* invalid-op */ ")
  #return
}

#proc emit_c_function_name(addr %data, addr %function) -> #unit {
  #let %name_start: i64 = #call ir_function_name_start(%function)
  #let %name_end: i64 = #add(
    %name_start,
    #call ir_function_name_length(%function)
  )
  #call emit_c_identifier_range(%data, %name_start, %name_end)
  #return
}

#proc emit_c_bits_type(i32 %width) -> #unit {
  #if #eq(%width, 129) {
    #call bootstrap.artifact-write-literal("void")
    #return
  }
  #if #eq(%width, 128) {
    #call bootstrap.artifact-write-literal("uint8_t *")
    #return
  }
  #if #eq(%width, 130) {
    #call bootstrap.artifact-write-literal("void")
    #return
  }
  #if #eq(%width, 288) {
    #call bootstrap.artifact-write-literal("float")
    #return
  }
  #if #eq(%width, 320) {
    #call bootstrap.artifact-write-literal("double")
    #return
  }
  #if #eq(%width, 1) {
    #call bootstrap.artifact-write-literal("uint8_t")
    #return
  }
  #if #eq(%width, 8) {
    #call bootstrap.artifact-write-literal("int8_t")
    #return
  }
  #if #eq(%width, 16) {
    #call bootstrap.artifact-write-literal("int16_t")
    #return
  }
  #if #eq(%width, 32) {
    #call bootstrap.artifact-write-literal("int32_t")
    #return
  }
  #if #eq(%width, 64) {
    #call bootstrap.artifact-write-literal("int64_t")
    #return
  }
  #call bootstrap.artifact-write-literal("/* invalid-type */ int")
  #return
}

#proc emit_c_parameters(addr %data, addr %function) -> #unit {
  #let %parameter: addr = #call ir_function_first_parameter(%function)
  #let %remaining: i64 = #call ir_function_parameter_count(%function)
  #if #eq(%remaining, 0) {
    #call bootstrap.artifact-write-literal("void")
    #return
  }
  #loop parameters {
    #if #eq(%remaining, 0) { #break parameters }
    #call emit_c_bits_type(#call ir_parameter_width(%parameter))
    #call bootstrap.artifact-write-literal(" ")
    #let %start: i64 = #call ir_parameter_name_start(%parameter)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_parameter_name_length(%parameter))
    )
    %remaining: i64 = #sub(%remaining, 1)
    #if #ne(%remaining, 0) {
      #call bootstrap.artifact-write-literal(", ")
    }
    %parameter: addr = #call ir_parameter_next(%parameter)
    #continue parameters
  }
  #return
}

#proc emit_c_function_body(addr %data, addr %body) -> #unit {
  #if #eq(#call ir_expr_kind(%body), 16) {
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 15) {
    #call bootstrap.artifact-write-literal("  if (")
    #call emit_c_expression(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal(") {\n")
    #call emit_c_function_body(%data, #call ir_expr_right(%body))
    #call bootstrap.artifact-write-literal("  }")
    #if #ne(#call ir_expr_kind(#call ir_body_if_else(%body)), 16) {
      #call bootstrap.artifact-write-literal(" else {\n")
      #call emit_c_function_body(%data, #call ir_body_if_else(%body))
      #call bootstrap.artifact-write-literal("  }")
    }
    #call bootstrap.artifact-write-literal("\n")
    #call emit_c_function_body(
      %data,
      #call ir_body_if_continuation(%body)
    )
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 17) {
    #call bootstrap.artifact-write-literal("  while (1) {\n")
    #call emit_c_function_body(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal("  break;\n")
    #if #ne(#call ir_expr_length(%body), 0) {
      #call bootstrap.artifact-write-literal("  lainir_continue_")
      #let %label_start: i64 = #call ir_expr_start(%body)
      #call emit_c_identifier_range(
        %data,
        %label_start,
        #add(%label_start, #call ir_expr_length(%body))
      )
      #call bootstrap.artifact-write-literal(":;\n")
    }
    #call bootstrap.artifact-write-literal("  }\n")
    #if #ne(#call ir_expr_length(%body), 0) {
      #call bootstrap.artifact-write-literal("  lainir_break_")
      #let %label_start: i64 = #call ir_expr_start(%body)
      #call emit_c_identifier_range(
        %data,
        %label_start,
        #add(%label_start, #call ir_expr_length(%body))
      )
      #call bootstrap.artifact-write-literal(":;\n")
    }
    #call emit_c_function_body(%data, #call ir_expr_right(%body))
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 18) {
    #if #eq(#call ir_expr_length(%body), 0) {
      #call bootstrap.artifact-write-literal("  break;\n")
    } else {
      #call bootstrap.artifact-write-literal("  goto lainir_break_")
      #let %label_start: i64 = #call ir_expr_start(%body)
      #call emit_c_identifier_range(
        %data,
        %label_start,
        #add(%label_start, #call ir_expr_length(%body))
      )
      #call bootstrap.artifact-write-literal(";\n")
    }
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 19) {
    #if #eq(#call ir_expr_length(%body), 0) {
      #call bootstrap.artifact-write-literal("  continue;\n")
    } else {
      #call bootstrap.artifact-write-literal("  goto lainir_continue_")
      #let %label_start: i64 = #call ir_expr_start(%body)
      #call emit_c_identifier_range(
        %data,
        %label_start,
        #add(%label_start, #call ir_expr_length(%body))
      )
      #call bootstrap.artifact-write-literal(";\n")
    }
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 20) {
    #call bootstrap.artifact-write-literal("  ")
    #let %start: i64 = #call ir_expr_start(%body)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%body))
    )
    #call bootstrap.artifact-write-literal(" = ")
    #call emit_c_expression(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal(";\n")
    #call emit_c_function_body(%data, #call ir_expr_right(%body))
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 27) {
    #call bootstrap.artifact-write-literal("  ")
    #call emit_c_expression(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal(";\n")
    #call emit_c_function_body(%data, #call ir_expr_right(%body))
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 28) {
    #call bootstrap.artifact-write-literal("  return;\n")
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 24) {
    #call bootstrap.artifact-write-literal("  { ")
    #call emit_c_bits_type(#call ir_body_let_width(%body))
    #call bootstrap.artifact-write-literal(" lainir_store_tmp = ")
    #call emit_c_expression(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal("; memcpy(")
    #call emit_c_expression(%data, #call ir_expr_right(%body))
    #call bootstrap.artifact-write-literal(", &lainir_store_tmp, sizeof(lainir_store_tmp)); }\n")
    #call emit_c_function_body(%data, #call ir_body_store_rest(%body))
    #return
  }
  #if #eq(#call ir_expr_kind(%body), 14) {
    #call bootstrap.artifact-write-literal("  ")
    #call emit_c_bits_type(#call ir_body_let_width(%body))
    #call bootstrap.artifact-write-literal(" ")
    #let %start: i64 = #call ir_expr_start(%body)
    #call emit_c_identifier_range(
      %data,
      %start,
      #add(%start, #call ir_expr_length(%body))
    )
    #call bootstrap.artifact-write-literal(" = ")
    #call emit_c_expression(%data, #call ir_expr_left(%body))
    #call bootstrap.artifact-write-literal(";\n")
    #call emit_c_function_body(%data, #call ir_expr_right(%body))
    #return
  }
  #call bootstrap.artifact-write-literal("  return ")
  #call emit_c_expression(%data, %body)
  #call bootstrap.artifact-write-literal(";\n")
  #return
}

#proc emit_c_module(addr %data, addr %module) -> #unit {
  #call bootstrap.artifact-begin()
  #call bootstrap.artifact-write-literal("#include <stdint.h>\n\n")
  #if #call module_uses_memory(%module) {
    #call bootstrap.artifact-write-literal(
      "#include <string.h>\n\n"
    )
    #call bootstrap.artifact-write-literal(
      "static uint8_t lainir_load_i1(const void *p) { uint8_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int8_t lainir_load_i8(const void *p) { int8_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int16_t lainir_load_i16(const void *p) { int16_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int32_t lainir_load_i32(const void *p) { int32_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int64_t lainir_load_i64(const void *p) { int64_t v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static uint8_t *lainir_load_addr(const void *p) { uint8_t *v; memcpy(&v, p, sizeof(v)); return v; }\n\n"
    )
    #call bootstrap.artifact-write-literal(
      "static float lainir_load_f32(const void *p) { float v; memcpy(&v, p, sizeof(v)); return v; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static double lainir_load_f64(const void *p) { double v; memcpy(&v, p, sizeof(v)); return v; }\n\n"
    )
  }
  #if #call module_uses_division(%module) {
    #call bootstrap.artifact-write-literal("#include <stdlib.h>\n\n")
    #call bootstrap.artifact-write-literal(
      "static uint8_t lainir_div_i1(uint8_t a, uint8_t b) { uint8_t ub = (uint8_t)(b & 1u); if (!ub) abort(); return (uint8_t)((a / ub) & 1u); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int8_t lainir_div_i8(int8_t a, int8_t b) { uint8_t ua = (uint8_t)a, ub = (uint8_t)b; if (!ub) abort(); return (int8_t)(uint8_t)(ua / ub); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int16_t lainir_div_i16(int16_t a, int16_t b) { uint16_t ua = (uint16_t)a, ub = (uint16_t)b; if (!ub) abort(); return (int16_t)(uint16_t)(ua / ub); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int32_t lainir_div_i32(int32_t a, int32_t b) { uint32_t ua = (uint32_t)a, ub = (uint32_t)b; if (!ub) abort(); return (int32_t)(uint32_t)(ua / ub); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int64_t lainir_div_i64(int64_t a, int64_t b) { uint64_t ua = (uint64_t)a, ub = (uint64_t)b; if (!ub) abort(); return (int64_t)(uint64_t)(ua / ub); }\n\n"
    )
    #call bootstrap.artifact-write-literal(
      "static uint8_t lainir_sdiv_i1(uint8_t a, uint8_t b) { int8_t sa = (a & 1u) ? -1 : 0, sb = (b & 1u) ? -1 : 0; if (!sb) abort(); return (uint8_t)(sa / sb) & 1u; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int8_t lainir_sdiv_i8(int8_t a, int8_t b) { if (!b) abort(); if (a == INT8_MIN && b == -1) return INT8_MIN; return (int8_t)(a / b); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int16_t lainir_sdiv_i16(int16_t a, int16_t b) { if (!b) abort(); if (a == INT16_MIN && b == -1) return INT16_MIN; return (int16_t)(a / b); }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int32_t lainir_sdiv_i32(int32_t a, int32_t b) { if (!b) abort(); if (a == INT32_MIN && b == -1) return INT32_MIN; return a / b; }\n"
    )
    #call bootstrap.artifact-write-literal(
      "static int64_t lainir_sdiv_i64(int64_t a, int64_t b) { if (!b) abort(); if (a == INT64_MIN && b == -1) return INT64_MIN; return a / b; }\n\n"
    )
  }

  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop prototypes {
    #if #eq(%remaining, 0) { #break prototypes }
    #call emit_c_bits_type(#call ir_function_return_width(%function))
    #call bootstrap.artifact-write-literal(" ")
    #call emit_c_function_name(%data, %function)
    #call bootstrap.artifact-write-literal("(")
    #call emit_c_parameters(%data, %function)
    #call bootstrap.artifact-write-literal(");\n")
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue prototypes
  }

  #call bootstrap.artifact-write-literal("\n")
  %function: addr = #call ir_module_first(%module)
  %remaining: i64 = #call ir_module_count(%module)
  #loop definitions {
    #if #eq(%remaining, 0) { #break definitions }
    #if #eq(#call ir_function_is_external(%function), 0) {
      #call emit_c_bits_type(#call ir_function_return_width(%function))
      #call bootstrap.artifact-write-literal(" ")
      #call emit_c_function_name(%data, %function)
      #call bootstrap.artifact-write-literal("(")
      #call emit_c_parameters(%data, %function)
      #call bootstrap.artifact-write-literal(") {\n")
      #call emit_c_function_body(%data, #call ir_function_body(%function))
      #call bootstrap.artifact-write-literal("}\n\n")
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue definitions
  }
  #call bootstrap.artifact-finish()
  #return
}

// Executable lexer contract used by the stage-0 differential harness.  It
// exercises every punctuation class plus identifier, number, string, hash
// name, comments, and EOF without delegating tokenization to the host.
#proc lainir_lexer_contract() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return 2
  }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)

  #if #ne(#call lexer_next(%cursor), 1) { #return #call lexer_contract_fail(%cursor, 20) }
  #if #eq(#call token_equals(%cursor, "alpha", 5), 0) { #return #call lexer_contract_fail(%cursor, 36) }
  #if #ne(#call lexer_next(%cursor), 2) { #return #call lexer_contract_fail(%cursor, 21) }
  #if #ne(#call lexer_next(%cursor), 3) { #return #call lexer_contract_fail(%cursor, 22) }
  #if #ne(#call lexer_next(%cursor), 4) { #return #call lexer_contract_fail(%cursor, 23) }
  #if #ne(#call lexer_next(%cursor), 5) { #return #call lexer_contract_fail(%cursor, 24) }
  #if #ne(#call lexer_next(%cursor), 6) { #return #call lexer_contract_fail(%cursor, 25) }
  #if #ne(#call lexer_next(%cursor), 7) { #return #call lexer_contract_fail(%cursor, 26) }
  #if #ne(#call lexer_next(%cursor), 8) { #return #call lexer_contract_fail(%cursor, 27) }
  #if #ne(#call lexer_next(%cursor), 9) { #return #call lexer_contract_fail(%cursor, 28) }
  #if #ne(#call lexer_next(%cursor), 10) { #return #call lexer_contract_fail(%cursor, 29) }
  #if #ne(#call lexer_next(%cursor), 11) { #return #call lexer_contract_fail(%cursor, 30) }
  #if #ne(#call lexer_next(%cursor), 12) { #return #call lexer_contract_fail(%cursor, 31) }
  #if #ne(#call lexer_next(%cursor), 13) { #return #call lexer_contract_fail(%cursor, 32) }
  #if #ne(#call lexer_next(%cursor), 14) { #return #call lexer_contract_fail(%cursor, 33) }
  #if #ne(#call lexer_next(%cursor), 15) { #return #call lexer_contract_fail(%cursor, 34) }
  #if #ne(#call lexer_next(%cursor), 48) { #return #call lexer_contract_fail(%cursor, 83) }
  #if #ne(#call lexer_next(%cursor), 49) { #return #call lexer_contract_fail(%cursor, 84) }
  #if #ne(#call lexer_next(%cursor), 19) { #return #call lexer_contract_fail(%cursor, 35) }
  #if #eq(#call token_equals(%cursor, "proc", 4), 0) { #return #call lexer_contract_fail(%cursor, 37) }
  #if #ne(#call lexer_next(%cursor), 1) { #return #call lexer_contract_fail(%cursor, 38) }
  #if #eq(#call token_equals(%cursor, "_x", 2), 0) { #return #call lexer_contract_fail(%cursor, 39) }
  #if #ne(#call lexer_next(%cursor), 1) { #return #call lexer_contract_fail(%cursor, 40) }
  #if #eq(#call token_equals(%cursor, ".dot", 4), 0) { #return #call lexer_contract_fail(%cursor, 41) }
  #if #ne(#call lexer_next(%cursor), 1) { #return #call lexer_contract_fail(%cursor, 42) }
  #if #eq(#call token_equals(%cursor, "bang!", 5), 0) { #return #call lexer_contract_fail(%cursor, 43) }
  #if #ne(#call lexer_next(%cursor), 1) { #return #call lexer_contract_fail(%cursor, 44) }
  #if #eq(#call token_equals(%cursor, "hy-phen", 7), 0) { #return #call lexer_contract_fail(%cursor, 45) }
  #if #ne(#call lexer_next(%cursor), 0) { #return #call lexer_contract_fail(%cursor, 46) }

  #call bootstrap.release-pages(%cursor)
  #return 0
}

#proc lainir_lexer_reject_contract() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return 2
  }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)
  #if #ne(#call lexer_next(%cursor), 255) {
    #return #call lexer_contract_fail(%cursor, 47)
  }
  #call bootstrap.release-pages(%cursor)
  #return 0
}

#proc lexer_expect(addr %cursor, i32 %kind) -> i1 {
  #return #eq(#call lexer_next(%cursor), %kind)
}

#proc lainir_keyword_contract() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return 2
  }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)

  #if #eq(#call lexer_expect(%cursor, 17), 0) { #return #call lexer_contract_fail(%cursor, 50) }
  #if #eq(#call lexer_expect(%cursor, 18), 0) { #return #call lexer_contract_fail(%cursor, 51) }
  #if #eq(#call lexer_expect(%cursor, 19), 0) { #return #call lexer_contract_fail(%cursor, 52) }
  #if #eq(#call lexer_expect(%cursor, 20), 0) { #return #call lexer_contract_fail(%cursor, 53) }
  #if #eq(#call lexer_expect(%cursor, 21), 0) { #return #call lexer_contract_fail(%cursor, 54) }
  #if #eq(#call lexer_expect(%cursor, 22), 0) { #return #call lexer_contract_fail(%cursor, 55) }
  #if #eq(#call lexer_expect(%cursor, 23), 0) { #return #call lexer_contract_fail(%cursor, 56) }
  #if #eq(#call lexer_expect(%cursor, 24), 0) { #return #call lexer_contract_fail(%cursor, 57) }
  #if #eq(#call lexer_expect(%cursor, 25), 0) { #return #call lexer_contract_fail(%cursor, 58) }
  #if #eq(#call lexer_expect(%cursor, 26), 0) { #return #call lexer_contract_fail(%cursor, 59) }
  #if #eq(#call lexer_expect(%cursor, 27), 0) { #return #call lexer_contract_fail(%cursor, 60) }
  #if #eq(#call lexer_expect(%cursor, 28), 0) { #return #call lexer_contract_fail(%cursor, 61) }
  #if #eq(#call lexer_expect(%cursor, 29), 0) { #return #call lexer_contract_fail(%cursor, 62) }
  #if #eq(#call lexer_expect(%cursor, 30), 0) { #return #call lexer_contract_fail(%cursor, 63) }
  #if #eq(#call lexer_expect(%cursor, 31), 0) { #return #call lexer_contract_fail(%cursor, 64) }
  #if #eq(#call lexer_expect(%cursor, 32), 0) { #return #call lexer_contract_fail(%cursor, 65) }
  #if #eq(#call lexer_expect(%cursor, 33), 0) { #return #call lexer_contract_fail(%cursor, 66) }
  #if #eq(#call lexer_expect(%cursor, 34), 0) { #return #call lexer_contract_fail(%cursor, 67) }
  #if #eq(#call lexer_expect(%cursor, 35), 0) { #return #call lexer_contract_fail(%cursor, 68) }
  #if #eq(#call lexer_expect(%cursor, 36), 0) { #return #call lexer_contract_fail(%cursor, 69) }
  #if #eq(#call lexer_expect(%cursor, 37), 0) { #return #call lexer_contract_fail(%cursor, 70) }
  #if #eq(#call lexer_expect(%cursor, 38), 0) { #return #call lexer_contract_fail(%cursor, 71) }
  #if #eq(#call lexer_expect(%cursor, 39), 0) { #return #call lexer_contract_fail(%cursor, 72) }
  #if #eq(#call lexer_expect(%cursor, 40), 0) { #return #call lexer_contract_fail(%cursor, 73) }
  #if #eq(#call lexer_expect(%cursor, 41), 0) { #return #call lexer_contract_fail(%cursor, 74) }
  #if #eq(#call lexer_expect(%cursor, 42), 0) { #return #call lexer_contract_fail(%cursor, 75) }
  #if #eq(#call lexer_expect(%cursor, 43), 0) { #return #call lexer_contract_fail(%cursor, 76) }
  #if #eq(#call lexer_expect(%cursor, 44), 0) { #return #call lexer_contract_fail(%cursor, 77) }
  #if #eq(#call lexer_expect(%cursor, 45), 0) { #return #call lexer_contract_fail(%cursor, 78) }
  #if #eq(#call lexer_expect(%cursor, 46), 0) { #return #call lexer_contract_fail(%cursor, 79) }
  #if #eq(#call lexer_expect(%cursor, 47), 0) { #return #call lexer_contract_fail(%cursor, 82) }
  #if #eq(#call lexer_expect(%cursor, 50), 0) { #return #call lexer_contract_fail(%cursor, 83) }
  #if #eq(#call lexer_expect(%cursor, 51), 0) { #return #call lexer_contract_fail(%cursor, 84) }
  #if #eq(#call lexer_expect(%cursor, 52), 0) { #return #call lexer_contract_fail(%cursor, 85) }
  #if #eq(#call lexer_expect(%cursor, 53), 0) { #return #call lexer_contract_fail(%cursor, 86) }
  #if #eq(#call lexer_expect(%cursor, 54), 0) { #return #call lexer_contract_fail(%cursor, 87) }
  #if #eq(#call lexer_expect(%cursor, 55), 0) { #return #call lexer_contract_fail(%cursor, 88) }
  #if #eq(#call lexer_expect(%cursor, 56), 0) { #return #call lexer_contract_fail(%cursor, 89) }
  #if #eq(#call lexer_expect(%cursor, 57), 0) { #return #call lexer_contract_fail(%cursor, 90) }
  #if #eq(#call lexer_expect(%cursor, 58), 0) { #return #call lexer_contract_fail(%cursor, 91) }
  #if #eq(#call lexer_expect(%cursor, 59), 0) { #return #call lexer_contract_fail(%cursor, 92) }
  #if #eq(#call lexer_expect(%cursor, 60), 0) { #return #call lexer_contract_fail(%cursor, 93) }
  #if #eq(#call lexer_expect(%cursor, 61), 0) { #return #call lexer_contract_fail(%cursor, 94) }
  #if #eq(#call lexer_expect(%cursor, 62), 0) { #return #call lexer_contract_fail(%cursor, 95) }
  #if #eq(#call lexer_expect(%cursor, 63), 0) { #return #call lexer_contract_fail(%cursor, 96) }
  #if #eq(#call lexer_expect(%cursor, 64), 0) { #return #call lexer_contract_fail(%cursor, 97) }
  #if #eq(#call lexer_expect(%cursor, 65), 0) { #return #call lexer_contract_fail(%cursor, 98) }
  #if #eq(#call lexer_expect(%cursor, 16), 0) { #return #call lexer_contract_fail(%cursor, 80) }
  #if #eq(#call lexer_expect(%cursor, 0), 0) { #return #call lexer_contract_fail(%cursor, 81) }

  #call bootstrap.release-pages(%cursor)
  #return 0
}

#proc lainir_compile() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return #call emit_error(
      "lainir-c stage 0 expects exactly one source",
      43,
      2
    )
  }

  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)
  #let %module: addr = #call parse_module(%cursor)

  #if #call parser_failed(%cursor) {
    #call ir_module_free(%module)
    #return #call reject_cursor(%cursor)
  }
  #if #eq(#call ir_module_has_main(%data, %length, %module), 0) {
    #call ir_module_free(%module)
    #return #call reject_cursor(%cursor)
  }
  #if #eq(#call verify_module_names(%data, %length, %module), 0) {
    #call ir_module_free(%module)
    #return #call reject_cursor(%cursor)
  }
  #if #eq(#call fold_compiletime_module(%data, %length, %module), 0) {
    #call ir_module_free(%module)
    #return #call emit_error(
      "cannot evaluate #eval at compile time",
      39,
      2
    )
  }

  #call emit_c_module(%data, %module)
  #call ir_module_free(%module)
  #call bootstrap.release-pages(%cursor)
  #return 0
}

// Library/module mode is used by the bootstrap fixed point. Unlike the native
// program mode it does not require a C-shaped `main`.
#proc lainir_compile_module() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) {
    #return #call emit_error(
      "lainir-c module mode expects exactly one source",
      45,
      2
    )
  }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)
  #let %module: addr = #call parse_module(%cursor)
  #if #call parser_failed(%cursor) {
    #call ir_module_free(%module)
    #return #call reject_cursor(%cursor)
  }
  #if #eq(#call verify_module_names(%data, %length, %module), 0) {
    #call ir_module_free(%module)
    #return #call reject_cursor(%cursor)
  }
  #if #eq(#call fold_compiletime_module(%data, %length, %module), 0) {
    #call ir_module_free(%module)
    #return #call emit_error(
      "cannot evaluate #eval at compile time",
      39,
      2
    )
  }
  #call emit_c_module(%data, %module)
  #call ir_module_free(%module)
  #call bootstrap.release-pages(%cursor)
  #return 0
}

// Development entry point: writes the source slice immediately after the
// parser cursor. It deliberately performs no verification or C emission.
#proc lainir_parse_debug() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)
  #let %module: addr = #call parse_module(%cursor)
  #let %start: i64 = #call cursor_offset(%cursor)
  #let %end: i64 = #add(%start, 96)
  #if #gt(%end, %length) { %end: i64 = %length }
  #call bootstrap.artifact-begin()
  #call emit_source_range(%data, %start, %end)
  #call bootstrap.artifact-finish()
  #let %status: i32 = 0
  #if #call parser_failed(%cursor) { %status: i32 = 1 }
  #call ir_module_free(%module)
  #call bootstrap.release-pages(%cursor)
  #return %status
}

#proc lainir_verify_debug() -> i32 {
  #if #ne(#call bootstrap.source-count(), 1) { #return 2 }
  #let %data: addr = #call bootstrap.source-data(0)
  #let %length: i64 = #call bootstrap.source-length(0)
  #let %cursor: addr = #call cursor_new(%data, %length)
  #let %module: addr = #call parse_module(%cursor)
  #call bootstrap.artifact-begin()
  #if #call parser_failed(%cursor) {
    #call bootstrap.artifact-write-literal("parse")
  } else {
      #let %function: addr = #call ir_module_first(%module)
      #let %remaining: i64 = #call ir_module_count(%module)
      #loop debug_functions {
        #if #eq(%remaining, 0) {
          #call bootstrap.artifact-write-literal("ok")
          #break debug_functions
        }
        #let %failed_stage: i32 = 0
        #if #eq(#call ir_function_is_external(%function), 0) {
          #if #eq(
            #call verify_body_types(
              %data, %length, %module, %function,
              #call ir_function_body(%function)
            ),
            0
          ) {
            %failed_stage: i32 = 1
          } else {
            #if #eq(
              #call body_guarantees_return(#call ir_function_body(%function)),
              0
            ) { %failed_stage: i32 = 2 }
          }
        }
        #if #eq(%failed_stage, 0) {
          #if #eq(
            #call verify_expression_names(
              %data, %length, %module, %function,
              #call ir_function_body(%function)
            ),
            0
          ) { %failed_stage: i32 = 3 }
        }
        #if #ne(%failed_stage, 0) {
          #if #eq(%failed_stage, 1) {
            #call bootstrap.artifact-write-literal("types:")
          }
          #if #eq(%failed_stage, 2) {
            #call bootstrap.artifact-write-literal("return:")
          }
          #if #eq(%failed_stage, 3) {
            #call bootstrap.artifact-write-literal("names:")
          }
          #let %name_start: i64 = #call ir_function_name_start(%function)
          #call emit_source_range(
            %data,
            %name_start,
            #add(%name_start, #call ir_function_name_length(%function))
          )
          #break debug_functions
        }
        %function: addr = #call ir_function_next(%function)
        %remaining: i64 = #sub(%remaining, 1)
        #continue debug_functions
      }
  }
  #call bootstrap.artifact-finish()
  #call ir_module_free(%module)
  #call bootstrap.release-pages(%cursor)
  #return 0
}
