  }
  #if #eq(%kind, 22) {
    #return #call expression_uses_division(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 30) {
    #return #call expression_uses_division(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 23) {
    #if #call expression_uses_division(#call ir_expr_left(%expression)) {
      #return 1
    }
