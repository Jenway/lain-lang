  i64 %length
) -> i1 {
  #let %depth: i64 = #call parser_loop_depth(%cursor)
  #if #eq(%depth, 0) { #return 0 }
  #if #eq(%length, 0) { #return 1 }
  #let %label: addr = #load[addr](
    #lea(base=%cursor, idx=0, scale=0, offset=88)
  )
  #let %remaining: i64 = %depth
  #loop labels {
    #if #eq(%remaining, 0) { #break labels }
    #if #call source_ranges_equal(
      #call cursor_data(%cursor),
      #call cursor_length(%cursor),
      %start,
      %length,
      #call ir_parameter_name_start(%label),
      #call ir_parameter_name_length(%label)
    ) { #return 1 }
    %label: addr = #call ir_parameter_next(%label)
    %remaining: i64 = #sub(%remaining, 1)
    #continue labels
  }
  #return 0
}

#proc parser_enter_loop(
  addr %cursor,
  i64 %label_start,
  i64 %label_length
) -> #unit {
  #if #ne(%label_length, 0) {
    #if #call parser_loop_target_valid(
      %cursor, %label_start, %label_length
    ) {
      #call parser_mark_failed(%cursor)
    }
  }
  #let %depth: i64 = #call parser_loop_depth(%cursor)
  #let %label: addr = #call ir_parameter_new(
    %label_start, %label_length, 0
  )
  #if #ne(%depth, 0) {
    #call ir_parameter_set_next(
      %label,
      #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=88))
    )
  }
  #store %label, #lea(base=%cursor, idx=0, scale=0, offset=88)
  #store #add(%depth, 1), #lea(base=%cursor, idx=0, scale=0, offset=80)
  #return
}

#proc parser_leave_loop(addr %cursor) -> #unit {
  #let %depth: i64 = #call parser_loop_depth(%cursor)
  #let %label: addr = #load[addr](
    #lea(base=%cursor, idx=0, scale=0, offset=88)
  )
  #if #gt(%depth, 1) {
    #store #call ir_parameter_next(%label),
      #lea(base=%cursor, idx=0, scale=0, offset=88)
  } else {
    #store 0, #lea(base=%cursor, idx=0, scale=0, offset=88)
  }
  #call bootstrap.release-pages(%label)
  #store #sub(%depth, 1), #lea(base=%cursor, idx=0, scale=0, offset=80)
  #return
}

#proc ir_function_new(
  i64 %name_start,
  i64 %name_length,
  i32 %return_width,
  addr %body,
  addr %first_parameter,
  i64 %parameter_count,
  i1 %is_external
) -> addr {
  #let %function: addr = #call bootstrap.allocate-pages(64)
  #store %name_start, #lea(base=%function, idx=0, scale=0, offset=0)
  #store %name_length, #lea(base=%function, idx=0, scale=0, offset=8)
  #store %return_width, #lea(base=%function, idx=0, scale=0, offset=16)
  #store %body, #lea(base=%function, idx=0, scale=0, offset=24)
  #store %function, #lea(base=%function, idx=0, scale=0, offset=32)
  #store %first_parameter, #lea(base=%function, idx=0, scale=0, offset=40)
  #store %parameter_count, #lea(base=%function, idx=0, scale=0, offset=48)
  #store %is_external, #lea(base=%function, idx=0, scale=0, offset=56)
  #return %function
}

#proc ir_module_new() -> addr {
  #let %module: addr = #call bootstrap.allocate-pages(24)
  #store 0, #lea(base=%module, idx=0, scale=0, offset=16)
  #return %module
}

#proc ir_module_first(addr %module) -> addr {
  #return #load[addr](#lea(base=%module, idx=0, scale=0, offset=0))
}

#proc ir_module_count(addr %module) -> i64 {
  #return #load[i64](#lea(base=%module, idx=0, scale=0, offset=16))
}

#proc ir_module_append(addr %module, addr %function) -> #unit {
  #let %count: i64 = #call ir_module_count(%module)
  #if #eq(%count, 0) {
    #store %function, #lea(base=%module, idx=0, scale=0, offset=0)
  } else {
    #let %tail: addr = #load[addr](#lea(base=%module, idx=0, scale=0, offset=8))
    #store %function, #lea(base=%tail, idx=0, scale=0, offset=32)
  }
  #store %function, #lea(base=%module, idx=0, scale=0, offset=8)
  #store #add(%count, 1), #lea(base=%module, idx=0, scale=0, offset=16)
  #return
}

#proc ir_function_name_start(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=0))
}

#proc ir_function_name_length(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=8))
}

#proc ir_function_return_width(addr %function) -> i32 {
  #return #load[i32](#lea(base=%function, idx=0, scale=0, offset=16))
}

#proc ir_function_body(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=24))
}

#proc ir_function_next(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=32))
}

#proc ir_function_first_parameter(addr %function) -> addr {
  #return #load[addr](#lea(base=%function, idx=0, scale=0, offset=40))
}

#proc ir_function_parameter_count(addr %function) -> i64 {
  #return #load[i64](#lea(base=%function, idx=0, scale=0, offset=48))
}

#proc ir_function_is_external(addr %function) -> i1 {
  #return #load[i1](#lea(base=%function, idx=0, scale=0, offset=56))
}

#proc ir_expr_kind(addr %expression) -> i32 {
  #return #load[i32](#lea(base=%expression, idx=0, scale=0, offset=0))
}

#proc ir_expr_start(addr %expression) -> i64 {
  #return #load[i64](#lea(base=%expression, idx=0, scale=0, offset=8))
}

#proc ir_expr_length(addr %expression) -> i64 {
  #return #load[i64](#lea(base=%expression, idx=0, scale=0, offset=16))
}

#proc ir_expr_left(addr %expression) -> addr {
  #return #load[addr](#lea(base=%expression, idx=0, scale=0, offset=24))
}

#proc ir_expr_right(addr %expression) -> addr {
  #return #load[addr](#lea(base=%expression, idx=0, scale=0, offset=32))
}

#proc ir_expr_is_binary(addr %expression) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 2) {
    #return 1
  }
  #if #ge(%kind, 4) {
    #if #le(%kind, 12) {
      #return 1
    }
  }
  #if #ge(%kind, 31) {
    #if #le(%kind, 40) { #return 1 }
  }
  #if #ge(%kind, 66) {
    #if #le(%kind, 71) { #return 1 }
  }
  #return 0
}

#proc ir_expr_is_comparison(addr %expression) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #ge(%kind, 7) {
    #if #le(%kind, 12) { #return 1 }
  }
  #if #ge(%kind, 33) {
    #if #le(%kind, 40) { #return 1 }
  }
  #if #ge(%kind, 70) {
    #if #le(%kind, 71) { #return 1 }
  }
  #return 0
}

#proc ir_expr_free(addr %expression) -> #unit {
  #if #call ir_expr_is_binary(%expression) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 3) {
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #let %next: addr = #call ir_expr_next(%argument)
      #call ir_expr_free(%argument)
      %argument: addr = %next
      %remaining: i64 = #sub(%remaining, 1)
      #continue arguments
    }
  }
  #if #eq(#call ir_expr_kind(%expression), 14) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 15) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
    #call ir_expr_free(#call ir_body_if_else(%expression))
    #call ir_expr_free(#call ir_body_if_continuation(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 17) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 20) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 22) {
    #call ir_expr_free(#call ir_expr_left(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 23) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 26) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %parameter: addr = #call ir_indirect_first_parameter(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_operands {
      #if #eq(%remaining, 0) { #break indirect_operands }
      #let %argument_next: addr = #call ir_expr_next(%argument)
      #let %parameter_next: addr = #call ir_parameter_next(%parameter)
      #call ir_expr_free(%argument)
      #call bootstrap.release-pages(%parameter)
      %argument: addr = %argument_next
      %parameter: addr = %parameter_next
      %remaining: i64 = #sub(%remaining, 1)
      #continue indirect_operands
    }
  }
  #if #eq(#call ir_expr_kind(%expression), 30) {
    #call ir_expr_free(#call ir_expr_left(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 46) {
    #call ir_expr_free(#call ir_expr_left(%expression))
  }
  #if #ge(#call ir_expr_kind(%expression), 41) {
    #if #le(#call ir_expr_kind(%expression), 43) {
      #call ir_expr_free(#call ir_expr_left(%expression))
    }
  }
  #if #eq(#call ir_expr_kind(%expression), 72) {
    #call ir_expr_free(#call ir_expr_left(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 24) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
    #call ir_expr_free(#call ir_body_store_rest(%expression))
  }
  #if #eq(#call ir_expr_kind(%expression), 27) {
    #call ir_expr_free(#call ir_expr_left(%expression))
    #call ir_expr_free(#call ir_expr_right(%expression))
  }
  #call bootstrap.release-pages(%expression)
  #return
}

#proc ir_module_free(addr %module) -> #unit {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) {
      #break functions
    }
    #let %next: addr = #call ir_function_next(%function)
    #let %parameter: addr = #call ir_function_first_parameter(%function)
    #let %parameter_remaining: i64 = #call ir_function_parameter_count(%function)
    #loop parameters {
      #if #eq(%parameter_remaining, 0) { #break parameters }
      #let %parameter_next: addr = #call ir_parameter_next(%parameter)
      #call bootstrap.release-pages(%parameter)
      %parameter: addr = %parameter_next
      %parameter_remaining: i64 = #sub(%parameter_remaining, 1)
      #continue parameters
    }
    #call ir_expr_free(#call ir_function_body(%function))
    #call bootstrap.release-pages(%function)
    %function: addr = %next
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #call bootstrap.release-pages(%module)
  #return
}

#proc parser_mark_failed(addr %cursor) -> #unit {
  #store 1, #lea(base=%cursor, idx=0, scale=0, offset=48)
  #return
}

#proc parser_failed(addr %cursor) -> i1 {
  #return #ne(
    #load[i32](#lea(base=%cursor, idx=0, scale=0, offset=48)),
    0
  )
}

#proc parser_expect(addr %cursor, i32 %kind) -> i1 {
  #if #ne(#call lexer_next(%cursor), %kind) {
    #call parser_mark_failed(%cursor)
    #return 0
  }
  #return 1
}

#proc parser_next_byte_is(addr %cursor, i8 %byte) -> i1 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %length: i64 = #call cursor_length(%cursor)
  #let %position: i64 = #call skip_trivia(
    %data,
    %length,
    #call cursor_offset(%cursor)
  )
  #if #ge(%position, %length) {
    #return 0
  }
  #return #eq(#call byte_at(%data, %position), %byte)
}

#proc parser_next_is_identifier(addr %cursor) -> i1 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %position: i64 = #call skip_trivia(
    %data,
    #call cursor_length(%cursor),
    #call cursor_offset(%cursor)
  )
  #if #ge(%position, #call cursor_length(%cursor)) { #return 0 }
  #return #call is_ident_start(#call byte_at(%data, %position))
}

#proc parser_next_is_number(addr %cursor) -> i1 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %position: i64 = #call skip_trivia(
    %data,
    #call cursor_length(%cursor),
    #call cursor_offset(%cursor)
  )
  #if #ge(%position, #call cursor_length(%cursor)) { #return 0 }
  #return #call is_digit(#call byte_at(%data, %position))
}

#proc parser_next_text_is(
  addr %cursor,
  addr %text,
  i64 %text_length
) -> i1 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %length: i64 = #call cursor_length(%cursor)
  #let %position: i64 = #call skip_trivia(
    %data,
    %length,
    #call cursor_offset(%cursor)
  )
  #return #call matches_text(
    %data,
    %length,
    %position,
    %text,
    %text_length
  )
}

#proc parse_current_decimal_i32(addr %cursor) -> i32 {
  #let %value: i32 = 0
  #let %offset: i64 = 0
  #loop digits {
    #if #ge(%offset, #call token_length(%cursor)) { #break digits }
    %value: i32 = #add(
      #mul(%value, 10),
      #sub(
        #call byte_at(
          #call cursor_data(%cursor),
          #add(#call token_start(%cursor), %offset)
        ),
        48
      )
    )
    %offset: i64 = #add(%offset, 1)
    #continue digits
  }
  #return %value
}

#proc physical_bits_width_or_fail(addr %cursor, i32 %width) -> i32 {
  #if #eq(%width, 1) { #return %width }
  #if #eq(%width, 8) { #return %width }
  #if #eq(%width, 16) { #return %width }
  #if #eq(%width, 32) { #return %width }
  #if #eq(%width, 64) { #return %width }
  #call parser_mark_failed(%cursor)
  #return 0
}

#proc parse_type_width(addr %cursor) -> i32 {
  #let %kind: i32 = #call lexer_next(%cursor)
  #if #eq(%kind, 17) { #return 129 }
  #if #eq(%kind, 18) { #return 130 }
  #if #eq(%kind, 51) { #return 128 }
  #if #eq(%kind, 50) {
    #call parser_expect(%cursor, 48)
    #call parser_expect(%cursor, 2)
    #let %canonical_width: i32 = #call parse_current_decimal_i32(%cursor)
    #call parser_expect(%cursor, 49)
    #return #call physical_bits_width_or_fail(%cursor, %canonical_width)
  }
  #if #eq(%kind, 52) {
    #call parser_expect(%cursor, 48)
    #call parser_expect(%cursor, 2)
    #let %float_width: i32 = #call parse_current_decimal_i32(%cursor)
    #call parser_expect(%cursor, 49)
    #if #eq(%float_width, 32) { #return 288 }
    #if #eq(%float_width, 64) { #return 320 }
    #call parser_mark_failed(%cursor)
    #return 0
  }
  #if #ne(%kind, 1) {
    #call parser_mark_failed(%cursor)
    #return 0
  }
  #let %data: addr = #call cursor_data(%cursor)
  #let %start: i64 = #call token_start(%cursor)
  #let %length: i64 = #call token_length(%cursor)
  #if #call token_equals(%cursor, "addr", 4) {
    #return 128
  }
  #if #lt(%length, 2) {
    #call parser_mark_failed(%cursor)
    #return 0
  }
  #if #ne(#call byte_at(%data, %start), 105) {
    #call parser_mark_failed(%cursor)
    #return 0
  }

  #let %offset: i64 = 1
  #let %width: i32 = 0
  #loop digits {
    #if #ge(%offset, %length) {
      #break digits
    }
    #let %byte: i8 = #call byte_at(%data, #add(%start, %offset))
    #if #eq(#call is_digit(%byte), 0) {
      #call parser_mark_failed(%cursor)
      #return 0
    }
    %width: i32 = #add(#mul(%width, 10), #sub(%byte, 48))
    %offset: i64 = #add(%offset, 1)
    #continue digits
  }

  #return #call physical_bits_width_or_fail(%cursor, %width)
}

#proc binary_ir_kind(i32 %token_kind) -> i32 {
  #if #eq(%token_kind, 35) { #return 2 }
  #if #eq(%token_kind, 36) { #return 4 }
  #if #eq(%token_kind, 37) { #return 5 }
  #if #eq(%token_kind, 38) { #return 6 }
  #if #eq(%token_kind, 39) { #return 7 }
  #if #eq(%token_kind, 40) { #return 8 }
  #if #eq(%token_kind, 41) { #return 9 }
  #if #eq(%token_kind, 42) { #return 10 }
  #if #eq(%token_kind, 43) { #return 11 }
  #if #eq(%token_kind, 44) { #return 12 }
  #if #eq(%token_kind, 53) { #return 31 }
  #if #eq(%token_kind, 54) { #return 32 }
  #if #eq(%token_kind, 55) { #return 33 }
  #if #eq(%token_kind, 56) { #return 34 }
  #if #eq(%token_kind, 57) { #return 35 }
  #if #eq(%token_kind, 58) { #return 36 }
  #if #eq(%token_kind, 59) { #return 37 }
  #if #eq(%token_kind, 60) { #return 38 }
  #if #eq(%token_kind, 61) { #return 39 }
  #if #eq(%token_kind, 62) { #return 40 }
  #if #eq(%token_kind, 66) { #return 66 }
  #if #eq(%token_kind, 67) { #return 67 }
  #if #eq(%token_kind, 68) { #return 68 }
  #if #eq(%token_kind, 69) { #return 69 }
  #if #eq(%token_kind, 70) { #return 70 }
  #if #eq(%token_kind, 71) { #return 71 }
  #return 0
}

#proc primitive_ir_kind(addr %cursor) -> i32 {
  #if #call token_equals(%cursor, "integer.add", 11) { #return 2 }
  #if #call token_equals(%cursor, "integer.sub", 11) { #return 4 }
  #if #call token_equals(%cursor, "integer.mul", 11) { #return 5 }
  #if #call token_equals(%cursor, "integer.div", 11) { #return 6 }
  #if #call token_equals(%cursor, "integer.eq", 10) { #return 7 }
  #if #call token_equals(%cursor, "integer.ne", 10) { #return 8 }
  #if #call token_equals(%cursor, "integer.lt", 10) { #return 9 }
  #if #call token_equals(%cursor, "integer.le", 10) { #return 10 }
  #if #call token_equals(%cursor, "integer.gt", 10) { #return 11 }
  #if #call token_equals(%cursor, "integer.ge", 10) { #return 12 }
  #return 0
}

#proc parse_direct_call(addr %cursor) -> addr {
  #if #eq(#call parser_expect(%cursor, 1), 0) {
    #return #call ir_expr_const_new(0, 0)
  }
  #let %name_start: i64 = #call token_start(%cursor)
  #let %name_length: i64 = #call token_length(%cursor)
  #call parser_expect(%cursor, 5)
  #if #call parser_next_byte_is(%cursor, 41) {
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_call_empty(%name_start, %name_length)
  }

  #let %first_argument: addr = #call parse_expression(%cursor)
  #let %last_argument: addr = %first_argument
  #let %argument_count: i64 = 1
  #let %separator: i32 = #call lexer_next(%cursor)
  #loop arguments {
    #if #eq(%separator, 6) { #break arguments }
    #if #ne(%separator, 11) {
      #call parser_mark_failed(%cursor)
      #break arguments
    }
    #let %argument: addr = #call parse_expression(%cursor)
    #call ir_expr_set_next(%last_argument, %argument)
    %last_argument: addr = %argument
    %argument_count: i64 = #add(%argument_count, 1)
    %separator: i32 = #call lexer_next(%cursor)
    #continue arguments
  }
  #return #call ir_expr_call_new(
    %name_start,
    %name_length,
    %first_argument,
    %argument_count
  )
}

#proc parse_expression(addr %cursor) -> addr {
  #let %kind: i32 = #call lexer_next(%cursor)

  #if #eq(%kind, 2) {
    #return #call ir_expr_const_new(
      #call token_start(%cursor),
      #call token_length(%cursor)
    )
  }
  #if #eq(%kind, 3) {
    #return #call ir_expr_string_new(
      #call token_start(%cursor),
      #call token_length(%cursor)
    )
  }

  #if #ge(%kind, 63) {
    #if #le(%kind, 65) {
      #call parser_expect(%cursor, 9)
      #let %target_width: i32 = #call parse_type_width(%cursor)
      #call parser_expect(%cursor, 10)
      #call parser_expect(%cursor, 5)
      #let %operand: addr = #call parse_expression(%cursor)
      #call parser_expect(%cursor, 6)
      #return #call ir_expr_conversion_new(
        #sub(%kind, 22), %target_width, %operand
      )
    }
  }
  #if #eq(%kind, 72) {
    #call parser_expect(%cursor, 9)
    #let %target_width: i32 = #call parse_type_width(%cursor)
    #call parser_expect(%cursor, 10)
    #call parser_expect(%cursor, 5)
    #let %operand: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_conversion_new(72, %target_width, %operand)
  }

  #let %binary_kind: i32 = #call binary_ir_kind(%kind)
  #if #ne(%binary_kind, 0) {
    #call parser_expect(%cursor, 5)
    #let %left: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 11)
    #let %right: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_binary_new(%binary_kind, %left, %right)
  }

  #if #eq(%kind, 23) {
    #return #call parse_direct_call(%cursor)
  }
  #if #eq(%kind, 46) {
    #call parser_expect(%cursor, 7)
    #let %body: addr = #call parse_function_body(%cursor)
    #call parser_expect(%cursor, 8)
    #return #call ir_expr_eval_new(%body)
  }
  #if #ge(%kind, 66) {
    #if #le(%kind, 71) {
      #call parser_expect(%cursor, 5)
      #let %left: addr = #call parse_expression(%cursor)
      #call parser_expect(%cursor, 11)
      #let %right: addr = #call parse_expression(%cursor)
      #call parser_expect(%cursor, 6)
      #return #call ir_expr_binary_new(%kind, %left, %right)
    }
  }
  #if #eq(%kind, 30) {
    #call parser_expect(%cursor, 1)
    #let %primitive_kind: i32 = #call primitive_ir_kind(%cursor)
    #if #eq(%primitive_kind, 0) { #call parser_mark_failed(%cursor) }
    #call parser_expect(%cursor, 5)
    #let %left: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 11)
    #let %right: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_binary_new(%primitive_kind, %left, %right)
  }

  #if #eq(%kind, 4) {
    #if #eq(#call parser_expect(%cursor, 1), 0) {
      #return #call ir_expr_const_new(0, 0)
    }
    #let %start: i64 = #call token_start(%cursor)
    #let %length: i64 = #call token_length(%cursor)
    #let %width: i32 = #call parser_scope_width(%cursor, %start, %length)
    #if #eq(%width, 255) {
      #call parser_mark_failed(%cursor)
    }
    #return #call ir_expr_var_new(%start, %length, %width)
  }

  #if #eq(%kind, 31) {
    #call parser_expect(%cursor, 5)
    #if #call parser_next_is_number(%cursor) {
      #call parser_expect(%cursor, 2)
      #let %size_start: i64 = #call token_start(%cursor)
      #let %size_length: i64 = #call token_length(%cursor)
      #call parser_expect(%cursor, 6)
      #return #call ir_expr_alloca_new(%size_start, %size_length)
    }
    #let %element_width: i32 = #call parse_type_width(%cursor)
    #call parser_expect(%cursor, 6)
    #if #eq(%element_width, 129) {
      #call parser_mark_failed(%cursor)
      #return #call ir_expr_alloca_new(0, 0)
    }
    #if #eq(%element_width, 128) {
      #return #call ir_expr_alloca_typed_new(8)
    }
    #if #eq(%element_width, 288) {
      #return #call ir_expr_alloca_typed_new(4)
    }
    #if #eq(%element_width, 320) {
      #return #call ir_expr_alloca_typed_new(8)
    }
    #if #eq(%element_width, 1) {
      #return #call ir_expr_alloca_typed_new(1)
    }
    #return #call ir_expr_alloca_typed_new(#div(
      #add(%element_width, 7), 8
    ))
  }

  #if #eq(%kind, 34) {
    #call parser_expect(%cursor, 9)
    #let %type_code: i32 = #call parse_type_width(%cursor)
    #call parser_expect(%cursor, 10)
    #call parser_expect(%cursor, 5)
    #let %address: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_load_new(%type_code, %address)
  }

  #if #eq(%kind, 33) {
    #call parser_expect(%cursor, 5)
    #call parser_expect(%cursor, 1)
    #if #eq(#call token_equals(%cursor, "base", 4), 0) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 13)
    #let %base: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 11)
    #call parser_expect(%cursor, 1)
    #if #eq(#call token_equals(%cursor, "idx", 3), 0) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 13)
    #let %index: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 11)
    #call parser_expect(%cursor, 1)
    #if #eq(#call token_equals(%cursor, "scale", 5), 0) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 13)
    #call parser_expect(%cursor, 2)
    #let %scale_start: i64 = #call token_start(%cursor)
    #let %scale_length: i64 = #call token_length(%cursor)
    #call parser_expect(%cursor, 11)
    #call parser_expect(%cursor, 1)
    #if #eq(#call token_equals(%cursor, "offset", 6), 0) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 13)
    #call parser_expect(%cursor, 2)
    #let %offset_start: i64 = #call token_start(%cursor)
    #let %offset_length: i64 = #call token_length(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_lea_new(
      %base,
      %index,
      %scale_start,
      %scale_length,
      %offset_start,
      %offset_length
    )
  }
  #if #eq(%kind, 32) {
    #call parser_expect(%cursor, 9)
    #call parser_expect(%cursor, 2)
    #let %offset_start: i64 = #call token_start(%cursor)
    #let %offset_length: i64 = #call token_length(%cursor)
    #call parser_expect(%cursor, 10)
    #call parser_expect(%cursor, 5)
    #let %base: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 6)
    #let %width: i32 = 32
    #if #call parser_next_byte_is(%cursor, 58) {
      #call parser_expect(%cursor, 12)
      %width: i32 = #call parse_type_width(%cursor)
    }
    #return #call ir_expr_field_new(
      %offset_start, %offset_length, %base, %width
    )
  }

  #if #eq(%kind, 47) {
    #call parser_expect(%cursor, 5)
    #call parser_expect(%cursor, 1)
    #let %name_start: i64 = #call token_start(%cursor)
    #let %name_length: i64 = #call token_length(%cursor)
    #call parser_expect(%cursor, 6)
    #return #call ir_expr_proc_addr_new(%name_start, %name_length)
  }

  #if #eq(%kind, 45) {
    #call parser_expect(%cursor, 9)
    #call parser_expect(%cursor, 5)
    #let %first_parameter: addr = #call bootstrap.allocate-pages(1)
    #let %last_parameter: addr = %first_parameter
    #let %parameter_count: i64 = 0
    #if #eq(#call parser_next_byte_is(%cursor, 41), 0) {
      #loop signature_parameters {
        #let %parameter_width: i32 = #call parse_type_width(%cursor)
        #let %parameter: addr = #call ir_parameter_new(0, 0, %parameter_width)
        #if #eq(%parameter_count, 0) {
          #call bootstrap.release-pages(%first_parameter)
          %first_parameter: addr = %parameter
        } else {
          #call ir_parameter_set_next(%last_parameter, %parameter)
        }
        %last_parameter: addr = %parameter
        %parameter_count: i64 = #add(%parameter_count, 1)
        #let %separator: i32 = #call lexer_next(%cursor)
        #if #eq(%separator, 6) { #break signature_parameters }
        #if #ne(%separator, 11) {
          #call parser_mark_failed(%cursor)
          #break signature_parameters
        }
        #continue signature_parameters
      }
    } else {
      #call parser_expect(%cursor, 6)
    }
    #call parser_expect(%cursor, 14)
    #let %return_width: i32 = #call parse_type_width(%cursor)
    #call parser_expect(%cursor, 10)
    #call parser_expect(%cursor, 5)
    #let %target: addr = #call parse_expression(%cursor)
    #if #eq(%parameter_count, 0) {
      #call bootstrap.release-pages(%first_parameter)
      %first_parameter: addr = %target
    }
    #let %first_argument: addr = %target
    #let %last_argument: addr = %target
    #let %argument_count: i64 = 0
    #let %separator: i32 = #call lexer_next(%cursor)
    #loop indirect_arguments {
      #if #eq(%separator, 6) { #break indirect_arguments }
      #if #ne(%separator, 11) {
        #call parser_mark_failed(%cursor)
        #break indirect_arguments
      }
      #let %argument: addr = #call parse_expression(%cursor)
      #if #eq(%argument_count, 0) {
        %first_argument: addr = %argument
      } else {
        #call ir_expr_set_next(%last_argument, %argument)
      }
      %last_argument: addr = %argument
      %argument_count: i64 = #add(%argument_count, 1)
      %separator: i32 = #call lexer_next(%cursor)
      #continue indirect_arguments
    }
    #if #ne(%argument_count, %parameter_count) {
      #call parser_mark_failed(%cursor)
    }
    #return #call ir_expr_call_indirect_new(
      %target,
      %first_argument,
      %argument_count,
      %first_parameter,
      %return_width
    )
  }

  #call parser_mark_failed(%cursor)
  #return #call ir_expr_const_new(0, 0)
}

#proc parsed_expression_width(addr %expression) -> i32 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 1) { #return 0 }
  #if #eq(%kind, 73) { #return 0 }
  #if #eq(%kind, 46) {
    #return #call parsed_expression_width(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 13) { #return #call ir_body_let_width(%expression) }
  #if #eq(%kind, 21) { #return 128 }
  #if #eq(%kind, 22) { #return #call ir_body_let_width(%expression) }
  #if #eq(%kind, 23) { #return 128 }
  #if #eq(%kind, 25) { #return 128 }
  #if #eq(%kind, 26) { #return #call ir_body_let_width(%expression) }
  #if #ge(%kind, 41) {
    #if #le(%kind, 43) { #return #call ir_body_let_width(%expression) }
  }
  #if #eq(%kind, 72) { #return #call ir_body_let_width(%expression) }
  #if #call ir_expr_is_binary(%expression) {
    #let %left: i32 = #call parsed_expression_width(
      #call ir_expr_left(%expression)
    )
    #let %right: i32 = #call parsed_expression_width(
      #call ir_expr_right(%expression)
    )
    #if #call ir_expr_is_comparison(%expression) {
      #return 1
    }
    #if #eq(%left, 0) { #return %right }
    #if #eq(%right, 0) { #return %left }
    #if #eq(%left, %right) { #return %left }
  }
  #return 255
}

#proc parse_function_body(addr %cursor) -> addr {
  #if #call parser_next_byte_is(%cursor, 125) {
    #return #call ir_body_end_new()
  }
  #let %kind: i32 = #call lexer_next(%cursor)
  #if #eq(%kind, 21) {
    #if #call parser_next_byte_is(%cursor, 125) {
      #return #call ir_body_unit_return_new()
    }
    #return #call parse_expression(%cursor)
  }
  #if #eq(%kind, 23) {
    #let %call: addr = #call parse_direct_call(%cursor)
    #let %rest: addr = #call parse_function_body(%cursor)
    #return #call ir_body_effect_call_new(%call, %rest)
  }
  #if #eq(%kind, 29) {
    #call parser_expect(%cursor, 4)
    #if #eq(#call parser_expect(%cursor, 1), 0) {
      #return #call ir_expr_const_new(0, 0)
    }
    #let %name_start: i64 = #call token_start(%cursor)
    #let %name_length: i64 = #call token_length(%cursor)
    #call parser_expect(%cursor, 12)
    #let %width: i32 = #call parse_type_width(%cursor)
    #call parser_expect(%cursor, 13)
    #let %value: addr = #call parse_expression(%cursor)
    #if #eq(
      #call parser_scope_add(%cursor, %name_start, %name_length, %width),
      0
    ) {
      #call parser_mark_failed(%cursor)
    }
    #let %rest: addr = #call parse_function_body(%cursor)
    #return #call ir_body_let_new(
      %name_start,
      %name_length,
      %width,
      %value,
      %rest
    )
  }
  #if #eq(%kind, 24) {
    #let %condition: addr = #call parse_expression(%cursor)
    #call parser_expect(%cursor, 7)
    #let %scope_checkpoint: i64 = #call parser_scope_count(%cursor)
    #let %then_body: addr = #call parse_function_body(%cursor)
    #call parser_expect(%cursor, 8)
    #call parser_scope_pop_to(%cursor, %scope_checkpoint)

    #let %else_body: addr = #call ir_body_end_new()
    #if #call parser_next_text_is(%cursor, "else", 4) {
      #call parser_expect(%cursor, 25)
      #call parser_expect(%cursor, 7)
      %else_body: addr = #call parse_function_body(%cursor)
      #call parser_expect(%cursor, 8)
      #call parser_scope_pop_to(%cursor, %scope_checkpoint)
    }

    #let %continuation: addr = #call parse_function_body(%cursor)
    #return #call ir_body_if_new(
      %condition,
      %then_body,
      %else_body,
      %continuation
    )
  }
  #if #eq(%kind, 26) {
    #let %label_start: i64 = 0
    #let %label_length: i64 = 0
    #if #eq(#call parser_next_byte_is(%cursor, 123), 0) {
      #call parser_expect(%cursor, 1)
      %label_start: i64 = #call token_start(%cursor)
      %label_length: i64 = #call token_length(%cursor)
    }
    #call parser_expect(%cursor, 7)
    #let %scope_checkpoint: i64 = #call parser_scope_count(%cursor)
    #call parser_enter_loop(%cursor, %label_start, %label_length)
    #let %loop_body: addr = #call parse_function_body(%cursor)
    #call parser_leave_loop(%cursor)
    #call parser_expect(%cursor, 8)
    #call parser_scope_pop_to(%cursor, %scope_checkpoint)
    #let %continuation: addr = #call parse_function_body(%cursor)
    #return #call ir_body_loop_new(
      %label_start, %label_length, %loop_body, %continuation
    )
  }
  #if #eq(%kind, 27) {
    #let %label_start: i64 = 0
    #let %label_length: i64 = 0
    #if #call parser_next_is_identifier(%cursor) {
      #call parser_expect(%cursor, 1)
      %label_start: i64 = #call token_start(%cursor)
      %label_length: i64 = #call token_length(%cursor)
    }
    #if #eq(
      #call parser_loop_target_valid(
        %cursor, %label_start, %label_length
      ),
      0
    ) {
      #call parser_mark_failed(%cursor)
    }
    #return #call ir_body_jump_new(18, %label_start, %label_length)
  }
  #if #eq(%kind, 28) {
    #let %label_start: i64 = 0
    #let %label_length: i64 = 0
    #if #call parser_next_is_identifier(%cursor) {
      #call parser_expect(%cursor, 1)
      %label_start: i64 = #call token_start(%cursor)
      %label_length: i64 = #call token_length(%cursor)
    }
    #if #eq(
      #call parser_loop_target_valid(
        %cursor, %label_start, %label_length
      ),
      0
    ) {
      #call parser_mark_failed(%cursor)
    }
    #return #call ir_body_jump_new(19, %label_start, %label_length)
  }
  #if #eq(%kind, 4) {
    #if #eq(#call parser_expect(%cursor, 1), 0) {
      #return #call ir_expr_const_new(0, 0)
    }
    #let %name_start: i64 = #call token_start(%cursor)
    #let %name_length: i64 = #call token_length(%cursor)
    #let %bound_width: i32 = #call parser_scope_width(
      %cursor,
      %name_start,
      %name_length
    )
    #if #eq(%bound_width, 255) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 12)
    #let %declared_width: i32 = #call parse_type_width(%cursor)
    #if #ne(%declared_width, %bound_width) {
      #call parser_mark_failed(%cursor)
    }
    #call parser_expect(%cursor, 13)
    #let %value: addr = #call parse_expression(%cursor)
    #let %rest: addr = #call parse_function_body(%cursor)
    #return #call ir_body_set_new(
      %name_start,
      %name_length,
      %declared_width,
      %value,
      %rest
    )
  }
  #if #eq(%kind, 22) {
    #let %type_code: i32 = 0
    #if #call parser_next_byte_is(%cursor, 91) {
      #call parser_expect(%cursor, 9)
      %type_code: i32 = #call parse_type_width(%cursor)
      #call parser_expect(%cursor, 10)
    }
    #let %value: addr = #call parse_expression(%cursor)
    #if #eq(%type_code, 0) {
      %type_code: i32 = #call parsed_expression_width(%value)
      #if #eq(%type_code, 255) { %type_code: i32 = 0 }
    }
    #call parser_expect(%cursor, 11)
    #let %destination: addr = #call parse_expression(%cursor)
    #let %rest: addr = #call parse_function_body(%cursor)
    #return #call ir_body_store_new(
      %type_code,
      %value,
      %destination,
      %rest
    )
  }
  #call parser_mark_failed(%cursor)
  #return #call ir_expr_const_new(0, 0)
}

#proc parse_function(addr %cursor, i1 %is_external) -> addr {
  #if #eq(#call parser_expect(%cursor, 1), 0) {
    #let %failed_body: addr = #call ir_expr_const_new(0, 0)
    #return #call ir_function_new(
      0, 0, 32, %failed_body, %failed_body, 0, %is_external
    )
  }
  #let %name_start: i64 = #call token_start(%cursor)
  #let %name_length: i64 = #call token_length(%cursor)

  #call parser_expect(%cursor, 5)
  #let %first_parameter: addr = #call bootstrap.allocate-pages(1)
  #let %last_parameter: addr = %first_parameter
  #let %parameter_count: i64 = 0

  #if #call parser_next_byte_is(%cursor, 41) {
    #call parser_expect(%cursor, 6)
  } else {
    #let %separator: i32 = 11
    #loop parameters {
      #if #ne(%separator, 11) {
        #break parameters
      }
      #let %parameter_width: i32 = #call parse_type_width(%cursor)
      #if #eq(%parameter_width, 0) { #break parameters }
      #call parser_expect(%cursor, 4)
      #if #eq(#call parser_expect(%cursor, 1), 0) {
        #break parameters
      }
      #let %parameter: addr = #call ir_parameter_new(
        #call token_start(%cursor),
        #call token_length(%cursor),
        %parameter_width
      )
      #if #eq(%parameter_count, 0) {
        #call bootstrap.release-pages(%first_parameter)
        %first_parameter: addr = %parameter
      } else {
        #call ir_parameter_set_next(%last_parameter, %parameter)
      }
      %last_parameter: addr = %parameter
      %parameter_count: i64 = #add(%parameter_count, 1)
      %separator: i32 = #call lexer_next(%cursor)
      #if #ne(%separator, 11) {
        #if #ne(%separator, 6) {
          #call parser_mark_failed(%cursor)
        }
        #break parameters
      }
      #continue parameters
    }
  }
  #call parser_expect(%cursor, 14)
  #let %return_width: i32 = #call parse_type_width(%cursor)
  #if #eq(%return_width, 0) {
    #let %failed_body: addr = #call ir_expr_const_new(0, 0)
    #if #eq(%parameter_count, 0) {
      #call bootstrap.release-pages(%first_parameter)
      %first_parameter: addr = %failed_body
    }
    #return #call ir_function_new(
      %name_start,
      %name_length,
      32,
      %failed_body,
      %first_parameter,
      %parameter_count,
      %is_external
    )
  }
  #if %is_external {
    #call parser_expect(%cursor, 15)
    #let %external_body: addr = #call ir_body_end_new()
    #if #eq(%parameter_count, 0) {
      #call bootstrap.release-pages(%first_parameter)
      %first_parameter: addr = %external_body
    }
    #return #call ir_function_new(
      %name_start,
      %name_length,
      %return_width,
      %external_body,
      %first_parameter,
      %parameter_count,
      1
    )
  }
  #call parser_expect(%cursor, 7)

  #let %scope_parameter: addr = %first_parameter
  #let %scope_remaining: i64 = %parameter_count
  #loop parameter_scope {
    #if #eq(%scope_remaining, 0) { #break parameter_scope }
    #if #eq(
      #call parser_scope_add(
        %cursor,
        #call ir_parameter_name_start(%scope_parameter),
        #call ir_parameter_name_length(%scope_parameter),
        #call ir_parameter_width(%scope_parameter)
      ),
      0
    ) {
      #call parser_mark_failed(%cursor)
    }
    %scope_parameter: addr = #call ir_parameter_next(%scope_parameter)
    %scope_remaining: i64 = #sub(%scope_remaining, 1)
    #continue parameter_scope
  }

  #let %body: addr = #call parse_function_body(%cursor)
  #call parser_expect(%cursor, 8)
  #call parser_scope_clear(%cursor)

  #if #eq(%parameter_count, 0) {
    #call bootstrap.release-pages(%first_parameter)
    %first_parameter: addr = %body
  }
  #return #call ir_function_new(
    %name_start,
    %name_length,
    %return_width,
    %body,
    %first_parameter,
    %parameter_count,
    0
  )
}

#proc parse_module(addr %cursor) -> addr {
  #let %module: addr = #call ir_module_new()
  #let %kind: i32 = #call lexer_next(%cursor)

  #loop functions {
    #if #eq(%kind, 0) {
      #break functions
    }
    #let %is_external: i1 = 0
    #if #eq(%kind, 20) {
      %is_external: i1 = 1
      %kind: i32 = #call lexer_next(%cursor)
    }
    #if #ne(%kind, 19) {
      #call parser_mark_failed(%cursor)
      #break functions
    }

    #let %function: addr = #call parse_function(%cursor, %is_external)
    #call ir_module_append(%module, %function)
    #if #call parser_failed(%cursor) {
      #break functions
    }
    %kind: i32 = #call lexer_next(%cursor)
    #continue functions
  }

  #if #eq(#call ir_module_count(%module), 0) {
    #call parser_mark_failed(%cursor)
  }
  #return %module
}

#proc ir_module_has_main(addr %data, i64 %length, addr %module) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) {
      #break functions
    }
    #if #eq(#call ir_function_name_length(%function), 4) {
      #if #call matches_text(
        %data,
        %length,
        #call ir_function_name_start(%function),
        "main",
        4
      ) {
        #if #ne(#call ir_function_return_width(%function), 32) {
          #return 0
        }
        #if #ne(#call ir_function_parameter_count(%function), 0) {
          #return 0
        }
        #if #call ir_function_is_external(%function) { #return 0 }
        #return 1
      }
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 0
}

#proc source_ranges_equal(
  addr %data,
  i64 %source_length,
  i64 %left_start,
  i64 %left_length,
  i64 %right_start,
  i64 %right_length
) -> i1 {
  #if #ne(%left_length, %right_length) {
    #return 0
  }
  #let %offset: i64 = 0
  #loop bytes {
    #if #ge(%offset, %left_length) {
      #break bytes
    }
    #if #ne(
      #call byte_at(%data, #add(%left_start, %offset)),
      #call byte_at(%data, #add(%right_start, %offset))
    ) {
      #return 0
    }
    %offset: i64 = #add(%offset, 1)
    #continue bytes
  }
  #return 1
}

// Compile-time evaluator used by #eval.  It intentionally accepts only
// side-effect-free integer expressions and local procedures whose arguments
// are themselves constant; anything else is a compile-time error rather than
// a runtime fallback.
#proc bool_to_i64(i1 %value) -> i64 {
  #if %value { #return 1 }
  #return 0
}

// Compile-time calls must not rewrite the function definition in place:
// multiple #eval calls may invoke the same helper with different arguments.
// These two small cloners copy the compiler-owned 56-byte nodes and recurse
// through only the pointer fields whose layout is meaningful for each kind.
#proc clone_const_expr(addr %expression) -> addr {
  #let %copy: addr = #call bootstrap.allocate-pages(56)
  #store #load[i64](#lea(base=%expression, idx=0, scale=0, offset=0)),
    #lea(base=%copy, idx=0, scale=0, offset=0)
  #store #load[i64](#lea(base=%expression, idx=0, scale=0, offset=8)),
    #lea(base=%copy, idx=0, scale=0, offset=8)
  #store #load[i64](#lea(base=%expression, idx=0, scale=0, offset=16)),
    #lea(base=%copy, idx=0, scale=0, offset=16)
  #store 0, #lea(base=%copy, idx=0, scale=0, offset=40)
  #store #load[i64](#lea(base=%expression, idx=0, scale=0, offset=48)),
    #lea(base=%copy, idx=0, scale=0, offset=48)
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #call ir_expr_is_binary(%expression) {
    #store #call clone_const_expr(#call ir_expr_left(%expression)),
      #lea(base=%copy, idx=0, scale=0, offset=24)
    #store #call clone_const_expr(#call ir_expr_right(%expression)),
      #lea(base=%copy, idx=0, scale=0, offset=32)
    #return %copy
  }
  #if #eq(%kind, 72) {
    #store #call clone_const_expr(#call ir_expr_left(%expression)),
      #lea(base=%copy, idx=0, scale=0, offset=24)
    #return %copy
  }
  #if #eq(%kind, 46) {
    #store #call clone_const_body(#call ir_expr_left(%expression)),
      #lea(base=%copy, idx=0, scale=0, offset=24)
    #return %copy
  }
  #if #eq(%kind, 3) {
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #let %first: addr = %argument
    #let %last: addr = %argument
    #let %index: i64 = 0
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #let %next: addr = #call ir_expr_next(%argument)
      #let %item: addr = #call clone_const_expr(%argument)
      #if #eq(%index, 0) {
        %first: addr = %item
      } else {
        #call ir_expr_set_next(%last, %item)
      }
      %last: addr = %item
      %argument: addr = %next
      %remaining: i64 = #sub(%remaining, 1)
      %index: i64 = #add(%index, 1)
      #continue arguments
    }
    #store %first, #lea(base=%copy, idx=0, scale=0, offset=24)
  }
  #return %copy
}

#proc clone_const_body(addr %body) -> addr {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 14) {
    #let %copy: addr = #call ir_body_let_new(
      #call ir_expr_start(%body), #call ir_expr_length(%body),
      #call ir_body_let_width(%body),
      #call clone_const_expr(#call ir_expr_left(%body)),
      #call clone_const_body(#call ir_expr_right(%body))
    )
    #return %copy
  }
  #if #eq(%kind, 15) {
    #return #call ir_body_if_new(
      #call clone_const_expr(#call ir_expr_left(%body)),
      #call clone_const_body(#call ir_expr_right(%body)),
      #call clone_const_body(#call ir_body_if_else(%body)),
      #call clone_const_body(#call ir_body_if_continuation(%body))
    )
  }
  #if #eq(%kind, 17) {
    #return #call ir_body_loop_new(
      #call ir_expr_start(%body), #call ir_expr_length(%body),
      #call clone_const_body(#call ir_expr_left(%body)),
      #call clone_const_body(#call ir_expr_right(%body))
    )
  }
  #if #eq(%kind, 20) {
    #return #call ir_body_set_new(
      #call ir_expr_start(%body), #call ir_expr_length(%body),
      #call ir_body_let_width(%body),
      #call clone_const_expr(#call ir_expr_left(%body)),
      #call clone_const_body(#call ir_expr_right(%body))
    )
  }
  #if #eq(%kind, 24) {
    #return #call ir_body_store_new(
      #load[i32](#lea(base=%body, idx=0, scale=0, offset=48)),
      #call clone_const_expr(#call ir_expr_left(%body)),
      #call clone_const_expr(#call ir_expr_right(%body)),
      #call clone_const_body(#call ir_body_store_rest(%body))
    )
  }
  #if #eq(%kind, 27) {
    #return #call ir_body_effect_call_new(
      #call clone_const_expr(#call ir_expr_left(%body)),
      #call clone_const_body(#call ir_expr_right(%body))
    )
  }
  #if #eq(%kind, 16) { #return #call ir_body_end_new() }
  #if #eq(%kind, 28) { #return #call ir_body_unit_return_new() }
  #if #eq(%kind, 18) {
    #return #call ir_body_jump_new(
      18, #call ir_expr_start(%body), #call ir_expr_length(%body)
    )
  }
  #if #eq(%kind, 19) {
    #return #call ir_body_jump_new(
      19, #call ir_expr_start(%body), #call ir_expr_length(%body)
    )
  }
  #return #call clone_const_expr(%body)
}

#proc eval_const_call(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %call,
  addr %function,
  addr %ok
) -> i64 {
  #let %remaining: i64 = #call ir_expr_argument_count(%call)
  #if #ne(%remaining, #call ir_function_parameter_count(%function)) {
    #store 0, %ok
    #return 0
  }
  #let %argument: addr = #call ir_expr_left(%call)
  #let %parameter: addr = #call ir_function_first_parameter(%function)
  #let %body: addr = #call ir_function_body(%function)
  #if #ne(%remaining, 0) {
    %body: addr = #call clone_const_body(%body)
  }
  #loop arguments {
    #if #eq(%remaining, 0) { #break arguments }
    #let %value: i64 = #call eval_const_expr(
      %data, %source_length, %module, %argument, %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    %body: addr = #call substitute_const_body(
      %data, %source_length, %body,
      #call ir_parameter_name_start(%parameter),
      #call ir_parameter_name_length(%parameter),
      %value
    )
    %argument: addr = #call ir_expr_next(%argument)
    %parameter: addr = #call ir_parameter_next(%parameter)
    %remaining: i64 = #sub(%remaining, 1)
    #continue arguments
  }
  #return #call eval_const_body(
    %data, %source_length, %module, %body, %ok
  )
}

#proc eval_const_expr(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %expression,
  addr %ok
) -> i64 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 1) {
    #let %start: i64 = #call ir_expr_start(%expression)
    #let %length: i64 = #call ir_expr_length(%expression)
    #let %offset: i64 = 0
    #let %value: i64 = 0
    #if #eq(%length, 0) { #store 0, %ok #return 0 }
    #loop digits {
      #if #ge(%offset, %length) { #break digits }
      #let %byte: i8 = #call byte_at(%data, #add(%start, %offset))
      #if #lt(%byte, 48) {
        #store 0, %ok
        #return 0
      }
      #if #gt(%byte, 57) {
        #store 0, %ok
        #return 0
      }
      %value: i64 = #add(
        #mul(%value, 10),
        #sub(%byte, 48)
      )
      %offset: i64 = #add(%offset, 1)
      #continue digits
    }
    #return %value
  }
  #if #eq(%kind, 73) {
    #return #load[i64](#lea(
      base=%expression, idx=0, scale=0, offset=24
    ))
  }
  #if #eq(%kind, 46) {
    #return #call eval_const_body(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
  }
  #if #eq(%kind, 3) {
    #let %function: addr = #call ir_module_first(%module)
    #let %remaining: i64 = #call ir_module_count(%module)
    #loop functions {
      #if #eq(%remaining, 0) { #break functions }
      #if #call source_ranges_equal(
        %data, %source_length,
        #call ir_expr_start(%expression),
        #call ir_expr_length(%expression),
        #call ir_function_name_start(%function),
        #call ir_function_name_length(%function)
      ) {
        #if #call ir_function_is_external(%function) {
          #store 0, %ok
          #return 0
        }
        #return #call eval_const_call(
          %data, %source_length, %module,
          %expression, %function, %ok
        )
      }
      %function: addr = #call ir_function_next(%function)
      %remaining: i64 = #sub(%remaining, 1)
      #continue functions
    }
    #store 0, %ok
    #return 0
  }
  #if #call ir_expr_is_binary(%expression) {
    #let %left: i64 = #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    #let %right: i64 = #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_right(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    #if #eq(%kind, 2) { #return #add(%left, %right) }
    #if #eq(%kind, 4) { #return #sub(%left, %right) }
    #if #eq(%kind, 5) { #return #mul(%left, %right) }
    #if #eq(%kind, 6) {
      #if #eq(%right, 0) { #store 0, %ok #return 0 }
      #return #div(%left, %right)
    }
    #if #eq(%kind, 7) { #return #call bool_to_i64(#eq(%left, %right)) }
    #if #eq(%kind, 8) { #return #call bool_to_i64(#ne(%left, %right)) }
    #if #eq(%kind, 9) { #return #call bool_to_i64(#lt(%left, %right)) }
    #if #eq(%kind, 10) { #return #call bool_to_i64(#le(%left, %right)) }
    #if #eq(%kind, 11) { #return #call bool_to_i64(#gt(%left, %right)) }
    #if #eq(%kind, 12) { #return #call bool_to_i64(#ge(%left, %right)) }
    #if #eq(%kind, 31) {
      #if #eq(%right, 0) { #store 0, %ok #return 0 }
      #return #sdiv(%left, %right)
    }
    #if #eq(%kind, 32) {
      #if #eq(%right, 0) { #store 0, %ok #return 0 }
      #return #udiv(%left, %right)
    }
    #if #eq(%kind, 33) { #return #call bool_to_i64(#slt(%left, %right)) }
    #if #eq(%kind, 34) { #return #call bool_to_i64(#sle(%left, %right)) }
    #if #eq(%kind, 35) { #return #call bool_to_i64(#sgt(%left, %right)) }
    #if #eq(%kind, 36) { #return #call bool_to_i64(#sge(%left, %right)) }
    #if #eq(%kind, 37) { #return #call bool_to_i64(#ult(%left, %right)) }
    #if #eq(%kind, 38) { #return #call bool_to_i64(#ule(%left, %right)) }
    #if #eq(%kind, 39) { #return #call bool_to_i64(#ugt(%left, %right)) }
    #if #eq(%kind, 40) { #return #call bool_to_i64(#uge(%left, %right)) }
    #if #eq(%kind, 66) { #return #add(%left, %right) }
    #if #eq(%kind, 67) { #return #sub(%left, %right) }
    #if #eq(%kind, 68) { #return #mul(%left, %right) }
    #if #eq(%kind, 69) {
      #if #eq(%right, 0) { #store 0, %ok #return 0 }
      #return #div(%left, %right)
    }
    #if #eq(%kind, 70) { #return #call bool_to_i64(#eq(%left, %right)) }
    #if #eq(%kind, 71) { #return #call bool_to_i64(#lt(%left, %right)) }
  }
  #if #eq(%kind, 72) {
    #return #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
  }
  #store 0, %ok
  #return 0
}

#proc eval_const_body(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %body,
  addr %ok
) -> i64 {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 16) { #store 0, %ok #return 0 }
  #if #eq(%kind, 14) {
    #let %value: i64 = #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    #let %rest: addr = #call substitute_const_body(
      %data, %source_length,
      #call ir_expr_right(%body),
      #call ir_expr_start(%body),
      #call ir_expr_length(%body),
      %value
    )
    #return #call eval_const_body(
      %data, %source_length, %module,
      %rest, %ok
    )
  }
  #if #eq(%kind, 16) { #return 0 }
  #if #eq(%kind, 18) { #return 0 }
  #if #eq(%kind, 19) { #return 0 }
  #if #eq(%kind, 15) {
    #let %condition: i64 = #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    #if #ne(%condition, 0) {
      #return #call eval_const_body(
        %data, %source_length, %module,
        #call ir_expr_right(%body), %ok
      )
    }
    #return #call eval_const_body(
      %data, %source_length, %module,
      #call ir_body_if_else(%body), %ok
    )
  }
  #if #eq(%kind, 20) {
    #let %ignored: i64 = #call eval_const_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return 0 }
    #return #call eval_const_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
  }
  #return #call eval_const_expr(
    %data, %source_length, %module, %body, %ok
  )
}

#proc ir_expr_const_value_new(i64 %value) -> addr {
  #let %expression: addr = #call bootstrap.allocate-pages(56)
  #store 73, #lea(base=%expression, idx=0, scale=0, offset=0)
  #store %value, #lea(base=%expression, idx=0, scale=0, offset=24)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=32)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=40)
  #return %expression
}

#proc substitute_const_expr(
  addr %data,
  i64 %source_length,
  addr %expression,
  i64 %name_start,
  i64 %name_length,
  i64 %value
) -> addr {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 13) {
    #if #call source_ranges_equal(
      %data, %source_length,
      #call ir_expr_start(%expression),
      #call ir_expr_length(%expression),
      %name_start, %name_length
    ) {
      #return #call ir_expr_const_value_new(%value)
    }
    #return %expression
  }
  #if #call ir_expr_is_binary(%expression) {
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_left(%expression),
      %name_start, %name_length, %value
    ), #lea(base=%expression, idx=0, scale=0, offset=24)
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_right(%expression),
      %name_start, %name_length, %value
    ), #lea(base=%expression, idx=0, scale=0, offset=32)
    #return %expression
  }
  #if #eq(%kind, 72) {
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_left(%expression),
      %name_start, %name_length, %value
    ), #lea(base=%expression, idx=0, scale=0, offset=24)
    #return %expression
  }
  #return %expression
}

#proc substitute_const_body(
  addr %data,
  i64 %source_length,
  addr %body,
  i64 %name_start,
  i64 %name_length,
  i64 %value
) -> addr {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 14) {
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_left(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=24)
    #store #call substitute_const_body(
      %data, %source_length,
      #call ir_expr_right(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #if #eq(%kind, 15) {
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_left(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=24)
    #store #call substitute_const_body(
      %data, %source_length,
      #call ir_expr_right(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=32)
    #store #call substitute_const_body(
      %data, %source_length,
      #call ir_body_if_else(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=40)
    #store #call substitute_const_body(
      %data, %source_length,
      #call ir_body_if_continuation(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=48)
    #return %body
  }
  #if #eq(%kind, 20) {
    #store #call substitute_const_expr(
      %data, %source_length,
      #call ir_expr_left(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=24)
    #store #call substitute_const_body(
      %data, %source_length,
      #call ir_expr_right(%body),
      %name_start, %name_length, %value
    ), #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #return #call substitute_const_expr(
    %data, %source_length, %body,
    %name_start, %name_length, %value
  )
}

#proc fold_compiletime_expr(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %expression,
  addr %ok
) -> addr {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 46) {
    #let %value: i64 = #call eval_const_body(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %expression }
    #return #call ir_expr_const_value_new(%value)
  }
  #if #eq(%kind, 3) {
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #let %previous: addr = #call ir_expr_left(%expression)
    #let %first: i1 = 1
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #let %next: addr = #call ir_expr_next(%argument)
      #let %folded: addr = #call fold_compiletime_expr(
        %data, %source_length, %module, %argument, %ok
      )
      #if #eq(#load[i1](%ok), 0) { #return %expression }
      #if %first {
        #store %folded, #lea(base=%expression, idx=0, scale=0, offset=24)
        %first: i1 = 0
      } else {
        #call ir_expr_set_next(%previous, %folded)
      }
      %previous: addr = %folded
      %argument: addr = %next
      %remaining: i64 = #sub(%remaining, 1)
      #continue arguments
    }
    #return %expression
  }
  #if #call ir_expr_is_binary(%expression) {
    #let %left: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %expression }
    #let %right: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_right(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %expression }
    #store %left, #lea(base=%expression, idx=0, scale=0, offset=24)
    #store %right, #lea(base=%expression, idx=0, scale=0, offset=32)
  }
  #if #eq(%kind, 72) {
    #let %operand: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%expression), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %expression }
    #store %operand, #lea(base=%expression, idx=0, scale=0, offset=24)
  }
  #return %expression
}

#proc fold_compiletime_body(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %body,
  addr %ok
) -> addr {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 14) {
    #let %value: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %value, #lea(base=%body, idx=0, scale=0, offset=24)
    #store #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    ), #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #if #eq(%kind, 15) {
    #let %condition: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %condition, #lea(base=%body, idx=0, scale=0, offset=24)
    #let %then_body: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %then_body, #lea(base=%body, idx=0, scale=0, offset=32)
    #let %else_body: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_body_if_else(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %else_body, #lea(base=%body, idx=0, scale=0, offset=40)
    #let %continuation: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_body_if_continuation(%body), %ok
    )
    #store %continuation, #lea(base=%body, idx=0, scale=0, offset=48)
    #return %body
  }
  #if #eq(%kind, 17) {
    #let %loop_body: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %loop_body, #lea(base=%body, idx=0, scale=0, offset=24)
    #let %continuation: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
    #store %continuation, #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #if #eq(%kind, 20) {
    #let %value: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %value, #lea(base=%body, idx=0, scale=0, offset=24)
    #let %rest: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
    #store %rest, #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #if #eq(%kind, 24) {
    #let %value: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #let %destination: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %value, #lea(base=%body, idx=0, scale=0, offset=24)
    #store %destination, #lea(base=%body, idx=0, scale=0, offset=32)
    #let %rest: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_body_store_rest(%body), %ok
    )
    #store %rest, #lea(base=%body, idx=0, scale=0, offset=40)
    #return %body
  }
  #if #eq(%kind, 27) {
    #let %call: addr = #call fold_compiletime_expr(
      %data, %source_length, %module,
      #call ir_expr_left(%body), %ok
    )
    #if #eq(#load[i1](%ok), 0) { #return %body }
    #store %call, #lea(base=%body, idx=0, scale=0, offset=24)
    #let %rest: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_expr_right(%body), %ok
    )
    #store %rest, #lea(base=%body, idx=0, scale=0, offset=32)
    #return %body
  }
  #if #eq(%kind, 16) { #return %body }
  #if #eq(%kind, 18) { #return %body }
  #if #eq(%kind, 19) { #return %body }
  #if #eq(%kind, 28) { #return %body }
  #let %value: addr = #call fold_compiletime_expr(
    %data, %source_length, %module, %body, %ok
  )
  #return %value
}

#proc fold_compiletime_module(
  addr %data,
  i64 %source_length,
  addr %module
) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) { #break functions }
    #let %ok: addr = #call bootstrap.allocate-pages(1)
    #store 1, %ok
    #let %body: addr = #call fold_compiletime_body(
      %data, %source_length, %module,
      #call ir_function_body(%function), %ok
    )
    #store %body, #lea(base=%function, idx=0, scale=0, offset=24)
    #if #eq(#load[i1](%ok), 0) {
      #call bootstrap.release-pages(%ok)
      #return 0
    }
    #call bootstrap.release-pages(%ok)
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 1
}

#proc ir_module_name_count(
  addr %data,
  i64 %source_length,
  addr %module,
  i64 %name_start,
  i64 %name_length
) -> i64 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #let %matches: i64 = 0
  #loop functions {
    #if #eq(%remaining, 0) {
      #break functions
    }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      %name_start,
      %name_length,
      #call ir_function_name_start(%function),
      #call ir_function_name_length(%function)
    ) {
      %matches: i64 = #add(%matches, 1)
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return %matches
}

#proc ir_function_parameter_name_count(
  addr %data,
  i64 %source_length,
  addr %function,
  i64 %name_start,
  i64 %name_length
) -> i64 {
  #let %parameter: addr = #call ir_function_first_parameter(%function)
  #let %remaining: i64 = #call ir_function_parameter_count(%function)
  #let %matches: i64 = 0
  #loop parameters {
    #if #eq(%remaining, 0) { #break parameters }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      %name_start,
      %name_length,
      #call ir_parameter_name_start(%parameter),
      #call ir_parameter_name_length(%parameter)
    ) {
      %matches: i64 = #add(%matches, 1)
    }
    %parameter: addr = #call ir_parameter_next(%parameter)
    %remaining: i64 = #sub(%remaining, 1)
    #continue parameters
  }
  #return %matches
}

#proc ir_call_arity_matches(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %call_expression
) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) { #break functions }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      #call ir_expr_start(%call_expression),
      #call ir_expr_length(%call_expression),
      #call ir_function_name_start(%function),
      #call ir_function_name_length(%function)
    ) {
      #return #eq(
        #call ir_expr_argument_count(%call_expression),
        #call ir_function_parameter_count(%function)
      )
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 0
}

#proc ir_parameter_width_for_name(
  addr %data,
  i64 %source_length,
  addr %function,
  i64 %name_start,
  i64 %name_length
) -> i32 {
  #let %parameter: addr = #call ir_function_first_parameter(%function)
  #let %remaining: i64 = #call ir_function_parameter_count(%function)
  #loop parameters {
    #if #eq(%remaining, 0) { #break parameters }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      %name_start,
      %name_length,
      #call ir_parameter_name_start(%parameter),
      #call ir_parameter_name_length(%parameter)
    ) {
      #return #call ir_parameter_width(%parameter)
    }
    %parameter: addr = #call ir_parameter_next(%parameter)
    %remaining: i64 = #sub(%remaining, 1)
    #continue parameters
  }
  #return 255
}

#proc ir_call_return_width(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %call_expression
) -> i32 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) { #break functions }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      #call ir_expr_start(%call_expression),
      #call ir_expr_length(%call_expression),
      #call ir_function_name_start(%function),
      #call ir_function_name_length(%function)
    ) {
      #return #call ir_function_return_width(%function)
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 255
}

#proc expression_width(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %function,
  addr %expression
) -> i32 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 1) { #return 0 }
  #if #eq(%kind, 73) { #return 0 }
  #if #eq(%kind, 46) {
    #return #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
  }
  #if #eq(%kind, 3) {
    #return #call ir_call_return_width(
      %data,
      %source_length,
      %module,
      %expression
    )
  }
  #if #eq(%kind, 13) {
    #return #call ir_body_let_width(%expression)
  }
  #if #eq(%kind, 30) {
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      128
    ) { #return 255 }
    #return #call ir_body_let_width(%expression)
  }
  #if #eq(%kind, 25) { #return 128 }
  #if #eq(%kind, 29) { #return 128 }
  #if #eq(%kind, 26) {
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      128
    ) { #return 255 }
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %parameter: addr = #call ir_indirect_first_parameter(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_arguments {
      #if #eq(%remaining, 0) { #break indirect_arguments }
      #let %actual_width: i32 = #call expression_width(
        %data, %source_length, %module, %function, %argument
      )
      #if #eq(%actual_width, 255) { #return 255 }
      #if #ne(%actual_width, 0) {
        #if #ne(%actual_width, #call ir_parameter_width(%parameter)) {
          #return 255
        }
      }
      %argument: addr = #call ir_expr_next(%argument)
      %parameter: addr = #call ir_parameter_next(%parameter)
      %remaining: i64 = #sub(%remaining, 1)
      #continue indirect_arguments
    }
    #return #call ir_body_let_width(%expression)
  }
  #if #eq(%kind, 23) {
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      128
    ) { #return 255 }
    #let %index_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
    #if #eq(%index_width, 128) { #return 255 }
    #if #eq(%index_width, 255) { #return 255 }
    #return 128
  }
  #if #eq(%kind, 16) { #return 0 }
  #if #eq(%kind, 18) { #return 0 }
  #if #eq(%kind, 19) { #return 0 }
  #if #eq(%kind, 15) {
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      1
    ) { #return 255 }
    #let %then_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
    #let %else_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_body_if_else(%expression)
    )
    #let %continuation_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_body_if_continuation(%expression)
    )
    #if #eq(%then_width, 255) { #return 255 }
    #if #eq(%else_width, 255) { #return 255 }
    #if #ne(%then_width, 0) {
      #if #ne(%else_width, 0) {
        #if #ne(%then_width, %else_width) { #return 255 }
      }
    }
    #if #ne(%continuation_width, 0) {
      #return %continuation_width
    }
    #if #ne(%then_width, 0) { #return %then_width }
    #return %else_width
  }
  #if #eq(%kind, 14) {
    #let %value_width: i32 = #call expression_width(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_left(%expression)
    )
    #if #eq(%value_width, 255) { #return 255 }
    #if #ne(%value_width, 0) {
      #if #ne(%value_width, #call ir_body_let_width(%expression)) {
        #return 255
      }
    }
    #return #call expression_width(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 21) { #return 128 }
  #if #eq(%kind, 22) {
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      128
    ) { #return 255 }
    #return #call ir_body_let_width(%expression)
  }
  #if #ge(%kind, 41) {
    #if #le(%kind, 43) {
      #let %source_width: i32 = #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      )
      #let %target_width: i32 = #call ir_body_let_width(%expression)
      #if #eq(%source_width, 0) { #return 255 }
      #if #eq(%source_width, 128) { #return 255 }
      #if #eq(%source_width, 255) { #return 255 }
      #if #eq(%kind, 43) {
        #if #ge(%target_width, %source_width) { #return 255 }
      } else {
        #if #le(%target_width, %source_width) { #return 255 }
      }
      #store %source_width, #lea(
        base=%expression, idx=0, scale=0, offset=40
      )
      #return %target_width
    }
  }
  #if #eq(%kind, 72) {
    #let %source_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
    #let %target_width: i32 = #call ir_body_let_width(%expression)
    #if #eq(%source_width, 288) {
      #if #eq(%target_width, 32) {
        #store %source_width, #lea(base=%expression, idx=0, scale=0, offset=40)
        #return %target_width
      }
      #return 255
    }
    #if #eq(%source_width, 320) {
      #if #eq(%target_width, 64) {
        #store %source_width, #lea(base=%expression, idx=0, scale=0, offset=40)
        #return %target_width
      }
      #return 255
    }
    #if #eq(%target_width, 288) {
      #if #eq(%source_width, 32) {
        #store %source_width, #lea(base=%expression, idx=0, scale=0, offset=40)
        #return %target_width
      }
      #return 255
    }
    #if #eq(%target_width, 320) {
      #if #eq(%source_width, 64) {
        #store %source_width, #lea(base=%expression, idx=0, scale=0, offset=40)
        #return %target_width
      }
      #return 255
    }
    #if #eq(%source_width, %target_width) {
      #if #eq(%source_width, 1) { #return %target_width }
      #if #eq(%source_width, 8) { #return %target_width }
      #if #eq(%source_width, 16) { #return %target_width }
      #if #eq(%source_width, 32) { #return %target_width }
      #if #eq(%source_width, 64) { #return %target_width }
    }
    #return 255
  }
  #if #call ir_expr_is_binary(%expression) {
    #let %left_width: i32 = #call expression_width(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_left(%expression)
    )
    #let %right_width: i32 = #call expression_width(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_right(%expression)
    )
    #if #eq(%left_width, 255) { #return 255 }
    #if #eq(%right_width, 255) { #return 255 }
    #if #ge(%kind, 66) {
      #if #le(%kind, 71) {
        #if #ne(%left_width, %right_width) { #return 255 }
        #if #eq(%left_width, 288) {
          #if #ge(%kind, 70) { #return 1 }
          #return 288
        }
        #if #eq(%left_width, 320) {
          #if #ge(%kind, 70) { #return 1 }
          #return 320
        }
        #return 255
      }
    }
    #if #ge(%left_width, 256) { #return 255 }
    #if #ge(%right_width, 256) { #return 255 }
    #if #call ir_expr_is_comparison(%expression) {
      #if #le(%kind, 12) {
        #if #eq(%left_width, 128) {
          #if #gt(%kind, 8) { #return 255 }
        }
        #if #eq(%right_width, 128) {
          #if #gt(%kind, 8) { #return 255 }
        }
        #if #ne(#eq(%left_width, 128), #eq(%right_width, 128)) {
          #return 255
        }
        #call ir_expr_set_width(%expression, 1)
        #return 1
      }
      #if #eq(%left_width, 128) { #return 255 }
      #if #eq(%right_width, 128) { #return 255 }
      #if #ne(%left_width, 0) {
        #if #ne(%right_width, 0) {
          #if #ne(%left_width, %right_width) { #return 255 }
        }
      }
      #let %operand_width: i32 = %left_width
      #if #eq(%operand_width, 0) { %operand_width: i32 = %right_width }
      #if #eq(%operand_width, 0) { %operand_width: i32 = 32 }
      #call ir_expr_set_width(%expression, %operand_width)
      #return 1
    }
    #if #eq(%left_width, 128) { #return 255 }
    #if #eq(%right_width, 128) { #return 255 }
    #if #ge(%kind, 31) {
      #if #ne(%left_width, 0) {
        #if #ne(%right_width, 0) {
          #if #ne(%left_width, %right_width) { #return 255 }
        }
      }
    }
    #let %result_width: i32 = %left_width
    #if #eq(%result_width, 0) { %result_width: i32 = %right_width }
    #if #eq(%result_width, 0) { %result_width: i32 = 32 }
    #call ir_expr_set_width(%expression, %result_width)
    #return %result_width
  }
  #return 255
}

#proc verify_call_argument_types(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %caller,
  addr %call_expression
) -> i1 {
  #let %callee: addr = #call ir_module_first(%module)
  #let %function_remaining: i64 = #call ir_module_count(%module)
  #loop find_callee {
    #if #eq(%function_remaining, 0) { #return 0 }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      #call ir_expr_start(%call_expression),
      #call ir_expr_length(%call_expression),
      #call ir_function_name_start(%callee),
      #call ir_function_name_length(%callee)
    ) {
      #break find_callee
    }
    %callee: addr = #call ir_function_next(%callee)
    %function_remaining: i64 = #sub(%function_remaining, 1)
    #continue find_callee
  }

  #let %parameter: addr = #call ir_function_first_parameter(%callee)
  #let %argument: addr = #call ir_expr_left(%call_expression)
  #let %remaining: i64 = #call ir_expr_argument_count(%call_expression)
  #loop arguments {
    #if #eq(%remaining, 0) { #break arguments }
    #let %actual_width: i32 = #call expression_width(
      %data,
      %source_length,
      %module,
      %caller,
      %argument
    )
    #if #eq(%actual_width, 255) { #return 0 }
    #if #ne(%actual_width, 0) {
      #if #ne(%actual_width, #call ir_parameter_width(%parameter)) {
        #return 0
      }
    }
    %parameter: addr = #call ir_parameter_next(%parameter)
    %argument: addr = #call ir_expr_next(%argument)
    %remaining: i64 = #sub(%remaining, 1)
    #continue arguments
  }
  #return 1
}

#proc verify_proc_addr_signature(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %proc_address,
  addr %indirect_call
) -> i1 {
  #let %callee: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop find_callee {
    #if #eq(%remaining, 0) { #return 0 }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      #call ir_expr_start(%proc_address),
      #call ir_expr_length(%proc_address),
      #call ir_function_name_start(%callee),
      #call ir_function_name_length(%callee)
    ) {
      #break find_callee
    }
    %callee: addr = #call ir_function_next(%callee)
    %remaining: i64 = #sub(%remaining, 1)
    #continue find_callee
  }
  #if #ne(
    #call ir_function_return_width(%callee),
    #call ir_body_let_width(%indirect_call)
  ) { #return 0 }
  #if #ne(
    #call ir_function_parameter_count(%callee),
    #call ir_indirect_argument_count(%indirect_call)
  ) { #return 0 }
  #let %actual: addr = #call ir_function_first_parameter(%callee)
  #let %declared: addr = #call ir_indirect_first_parameter(%indirect_call)
  %remaining: i64 = #call ir_indirect_argument_count(%indirect_call)
  #loop parameters {
    #if #eq(%remaining, 0) { #break parameters }
    #if #ne(
      #call ir_parameter_width(%actual),
      #call ir_parameter_width(%declared)
    ) { #return 0 }
    %actual: addr = #call ir_parameter_next(%actual)
    %declared: addr = #call ir_parameter_next(%declared)
    %remaining: i64 = #sub(%remaining, 1)
    #continue parameters
  }
  #return 1
}

#proc verify_expression_names(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %function,
  addr %expression
) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 1) {
    #return 1
  }
  #if #eq(%kind, 46) {
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
  }
  #if #eq(%kind, 29) { #return 1 }
  #if #eq(%kind, 30) {
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
  }
  #if #eq(%kind, 25) {
    #return #eq(
      #call ir_module_name_count(
        %data,
        %source_length,
        %module,
        #call ir_expr_start(%expression),
        #call ir_expr_length(%expression)
      ),
      1
    )
  }
  #if #eq(%kind, 26) {
    #let %target: addr = #call ir_expr_left(%expression)
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function, %target
      ),
      0
    ) { #return 0 }
    #if #eq(#call ir_expr_kind(%target), 25) {
      #if #eq(
        #call verify_proc_addr_signature(
          %data, %source_length, %module, %target, %expression
        ),
        0
      ) { #return 0 }
    }
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_arguments {
      #if #eq(%remaining, 0) { #break indirect_arguments }
      #if #eq(
        #call verify_expression_names(
          %data, %source_length, %module, %function, %argument
        ),
        0
      ) { #return 0 }
      %argument: addr = #call ir_expr_next(%argument)
      %remaining: i64 = #sub(%remaining, 1)
      #continue indirect_arguments
    }
    #return #ne(
      #call expression_width(
        %data, %source_length, %module, %function, %expression
      ),
      255
    )
  }
  #if #call ir_expr_is_binary(%expression) {
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) {
      #return 0
    }
    #return #call verify_expression_names(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 23) {
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 3) {
    #if #ne(
      #call ir_module_name_count(
        %data,
        %source_length,
        %module,
        #call ir_expr_start(%expression),
        #call ir_expr_length(%expression)
      ),
      1
    ) {
      #return 0
    }
    #if #eq(
      #call ir_call_arity_matches(
        %data,
        %source_length,
        %module,
        %expression
      ),
      0
    ) {
      #return 0
    }
    #if #eq(
      #call verify_call_argument_types(
        %data,
        %source_length,
        %module,
        %function,
        %expression
      ),
      0
    ) {
      #return 0
    }
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #if #eq(
        #call verify_expression_names(
          %data,
          %source_length,
          %module,
          %function,
          %argument
        ),
        0
      ) {
        #return 0
      }
      %argument: addr = #call ir_expr_next(%argument)
      %remaining: i64 = #sub(%remaining, 1)
      #continue arguments
    }
    #return 1
  }
  #if #eq(%kind, 13) {
    #return #ne(#call ir_body_let_width(%expression), 255)
  }
  #if #eq(%kind, 14) {
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) {
      #return 0
    }
    #return #call verify_expression_names(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 15) {
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_expr_right(%expression)
      ),
      0
    ) { #return 0 }
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_body_if_else(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_body_if_continuation(%expression)
    )
  }
  #if #eq(%kind, 16) { #return 1 }
  #if #eq(%kind, 17) {
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 18) { #return 1 }
  #if #eq(%kind, 19) { #return 1 }
  #if #eq(%kind, 20) {
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 21) { #return 1 }
  #if #eq(%kind, 22) {
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
  }
  #if #eq(%kind, 24) {
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_right(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_body_store_rest(%expression)
    )
  }
  #if #eq(%kind, 27) {
    #if #eq(
      #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      ),
      0
    ) { #return 0 }
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%expression)
    )
  }
  #if #eq(%kind, 28) { #return 1 }
  #if #ge(%kind, 41) {
    #if #le(%kind, 43) {
      #return #call verify_expression_names(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%expression)
      )
    }
  }
  #if #eq(%kind, 72) {
    #return #call verify_expression_names(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%expression)
    )
  }
  #return 0
}

#proc verify_body_types(
  addr %data,
  i64 %source_length,
  addr %module,
  addr %function,
  addr %body
) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 16) { #return 1 }
  #if #eq(%kind, 14) {
    #let %value_width: i32 = #call expression_width(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_left(%body)
    )
    #if #eq(%value_width, 255) { #return 0 }
    #if #ne(%value_width, 0) {
      #if #ne(%value_width, #call ir_body_let_width(%body)) { #return 0 }
    }
    #return #call verify_body_types(
      %data,
      %source_length,
      %module,
      %function,
      #call ir_expr_right(%body)
    )
  }
  #if #eq(%kind, 15) {
    #if #ne(
      #call expression_width(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_expr_left(%body)
      ),
      1
    ) { #return 0 }
    #if #eq(
      #call verify_body_types(
        %data, %source_length, %module, %function,
        #call ir_expr_right(%body)
      ),
      0
    ) { #return 0 }
    #if #eq(
      #call verify_body_types(
        %data, %source_length, %module, %function,
        #call ir_body_if_else(%body)
      ),
      0
    ) { #return 0 }
    #return #call verify_body_types(
      %data, %source_length, %module, %function,
      #call ir_body_if_continuation(%body)
    )
  }
  #if #eq(%kind, 17) {
    #if #eq(
      #call verify_body_types(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%body)
      ),
      0
    ) { #return 0 }
    #return #call verify_body_types(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%body)
    )
  }
  #if #eq(%kind, 18) { #return 1 }
  #if #eq(%kind, 19) { #return 1 }
  #if #eq(%kind, 20) {
    #let %value_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%body)
    )
    #if #eq(%value_width, 255) { #return 0 }
    #if #ne(%value_width, 0) {
      #if #ne(%value_width, #call ir_body_let_width(%body)) { #return 0 }
    }
    #return #call verify_body_types(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%body)
    )
  }
  #if #eq(%kind, 24) {
    #let %value_width: i32 = #call expression_width(
      %data, %source_length, %module, %function,
      #call ir_expr_left(%body)
    )
    #if #eq(%value_width, 255) { #return 0 }
    #if #eq(%value_width, 0) { %value_width: i32 = 32 }
    #let %store_width: i32 = #call ir_body_let_width(%body)
    #if #eq(%store_width, 0) {
      #call ir_body_store_set_width(%body, %value_width)
    } else {
      #if #ne(%value_width, %store_width) { #return 0 }
    }
    #if #ne(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_right(%body)
      ),
      128
    ) { #return 0 }
    #return #call verify_body_types(
      %data, %source_length, %module, %function,
      #call ir_body_store_rest(%body)
    )
  }
  #if #eq(%kind, 27) {
    #if #eq(
      #call expression_width(
        %data, %source_length, %module, %function,
        #call ir_expr_left(%body)
      ),
      255
    ) { #return 0 }
    #return #call verify_body_types(
      %data, %source_length, %module, %function,
      #call ir_expr_right(%body)
    )
  }
  #if #eq(%kind, 28) {
    #return #eq(#call ir_function_return_width(%function), 129)
  }

  #let %return_width: i32 = #call expression_width(
    %data, %source_length, %module, %function, %body
  )
  #if #eq(%return_width, 255) { #return 0 }
  #if #eq(%return_width, 0) {
    #return #ne(#call ir_function_return_width(%function), 129)
  }
  #return #eq(%return_width, #call ir_function_return_width(%function))
}

#proc body_guarantees_return(addr %body) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 16) { #return 0 }
  #if #eq(%kind, 14) {
    #return #call body_guarantees_return(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 15) {
    #if #call body_guarantees_return(
      #call ir_body_if_continuation(%body)
    ) {
      #return 1
    }
    #if #eq(#call body_guarantees_return(#call ir_expr_right(%body)), 0) {
      #return 0
    }
    #return #call body_guarantees_return(#call ir_body_if_else(%body))
  }
  #if #eq(%kind, 17) {
    #if #call body_guarantees_return(#call ir_expr_left(%body)) {
      #return 1
    }
    #return #call body_guarantees_return(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 18) { #return 0 }
  #if #eq(%kind, 19) { #return 0 }
  #if #eq(%kind, 20) {
    #return #call body_guarantees_return(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 24) {
    #return #call body_guarantees_return(#call ir_body_store_rest(%body))
  }
  #if #eq(%kind, 27) {
    #return #call body_guarantees_return(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 28) { #return 1 }
  #return 1
}

#proc verify_module_names(
  addr %data,
  i64 %source_length,
  addr %module
) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) {
      #break functions
    }
    #if #ne(
      #call ir_module_name_count(
        %data,
        %source_length,
        %module,
        #call ir_function_name_start(%function),
        #call ir_function_name_length(%function)
      ),
      1
    ) {
      #return 0
    }
    #if #eq(#call ir_function_is_external(%function), 0) {
      #if #eq(
        #call verify_body_types(
          %data,
          %source_length,
          %module,
          %function,
          #call ir_function_body(%function)
        ),
        0
      ) { #return 0 }
      #if #eq(
        #call body_guarantees_return(#call ir_function_body(%function)),
        0
      ) { #return 0 }
    }
    #let %parameter: addr = #call ir_function_first_parameter(%function)
    #let %parameter_remaining: i64 = #call ir_function_parameter_count(%function)
    #loop parameters {
      #if #eq(%parameter_remaining, 0) { #break parameters }
      #if #ne(
        #call ir_function_parameter_name_count(
          %data,
          %source_length,
          %function,
          #call ir_parameter_name_start(%parameter),
          #call ir_parameter_name_length(%parameter)
        ),
        1
      ) {
        #return 0
      }
      %parameter: addr = #call ir_parameter_next(%parameter)
      %parameter_remaining: i64 = #sub(%parameter_remaining, 1)
      #continue parameters
    }
    #if #eq(
      #call verify_expression_names(
        %data,
        %source_length,
        %module,
        %function,
        #call ir_function_body(%function)
      ),
      0
    ) {
      #return 0
    }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 1
}

#proc emit_source_range(
  addr %data,
  i64 %start,
  i64 %end
) -> #unit {
  #let %index: i64 = %start
  #loop bytes {
    #if #ge(%index, %end) {
      #break bytes
    }
    #call bootstrap.artifact-write-byte(#call byte_at(%data, %index))
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc emit_c_identifier_range(
  addr %data,
  i64 %start,
  i64 %end
) -> #unit {
  #let %index: i64 = %start
  #loop bytes {
    #if #ge(%index, %end) { #break bytes }
    #let %byte: i8 = #call byte_at(%data, %index)
    #if #eq(%byte, 46) {
      #call bootstrap.artifact-write-literal("_dot_")
    } else {
      #if #eq(%byte, 45) {
        #call bootstrap.artifact-write-literal("_dash_")
      } else {
        #if #eq(%byte, 33) {
          #call bootstrap.artifact-write-literal("_bang_")
        } else {
          #call bootstrap.artifact-write-byte(%byte)
        }
      }
    }
    %index: i64 = #add(%index, 1)
    #continue bytes
  }
  #return
}

#proc expression_uses_memory(addr %expression) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 46) {
    #return #call expression_uses_memory(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 72) {
    #return #call expression_uses_memory(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 21) { #return 1 }
  #if #eq(%kind, 22) { #return 1 }
  #if #eq(%kind, 23) { #return 1 }
  #if #eq(%kind, 30) { #return 1 }
  #if #call ir_expr_is_binary(%expression) {
    #if #call expression_uses_memory(#call ir_expr_left(%expression)) {
      #return 1
    }
    #return #call expression_uses_memory(#call ir_expr_right(%expression))
  }
  #if #ge(%kind, 41) {
    #if #le(%kind, 43) {
      #return #call expression_uses_memory(#call ir_expr_left(%expression))
    }
  }
  #if #eq(%kind, 3) {
    #let %argument: addr = #call ir_expr_left(%expression)
    #let %remaining: i64 = #call ir_expr_argument_count(%expression)
    #loop arguments {
      #if #eq(%remaining, 0) { #break arguments }
      #if #call expression_uses_memory(%argument) { #return 1 }
      %argument: addr = #call ir_expr_next(%argument)
      %remaining: i64 = #sub(%remaining, 1)
      #continue arguments
    }
  }
  #if #eq(%kind, 26) {
    #if #call expression_uses_memory(#call ir_expr_left(%expression)) {
      #return 1
    }
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_arguments {
      #if #eq(%remaining, 0) { #break indirect_arguments }
      #if #call expression_uses_memory(%argument) { #return 1 }
      %argument: addr = #call ir_expr_next(%argument)
      %remaining: i64 = #sub(%remaining, 1)
      #continue indirect_arguments
    }
  }
  #return 0
}

#proc body_uses_memory(addr %body) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 16) { #return 0 }
  #if #eq(%kind, 24) { #return 1 }
  #if #eq(%kind, 14) {
    #if #call expression_uses_memory(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_memory(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 15) {
    #if #call expression_uses_memory(#call ir_expr_left(%body)) { #return 1 }
    #if #call body_uses_memory(#call ir_expr_right(%body)) { #return 1 }
    #if #call body_uses_memory(#call ir_body_if_else(%body)) { #return 1 }
    #return #call body_uses_memory(#call ir_body_if_continuation(%body))
  }
  #if #eq(%kind, 17) {
    #if #call body_uses_memory(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_memory(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 20) {
    #if #call expression_uses_memory(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_memory(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 27) {
    #if #call expression_uses_memory(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_memory(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 28) { #return 0 }
  #if #eq(%kind, 18) { #return 0 }
  #if #eq(%kind, 19) { #return 0 }
  #return #call expression_uses_memory(%body)
}

#proc module_uses_memory(addr %module) -> i1 {
  #let %function: addr = #call ir_module_first(%module)
  #let %remaining: i64 = #call ir_module_count(%module)
  #loop functions {
    #if #eq(%remaining, 0) { #break functions }
    #if #call body_uses_memory(#call ir_function_body(%function)) { #return 1 }
    %function: addr = #call ir_function_next(%function)
    %remaining: i64 = #sub(%remaining, 1)
    #continue functions
  }
  #return 0
}

#proc expression_uses_division(addr %expression) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%expression)
  #if #eq(%kind, 46) {
    #return #call expression_uses_division(#call ir_expr_left(%expression))
  }
  #if #eq(%kind, 72) {
