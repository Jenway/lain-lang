  #if #eq(%kind, 15) {
    #if #call expression_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #if #call body_uses_division(#call ir_expr_right(%body)) { #return 1 }
    #if #call body_uses_division(#call ir_body_if_else(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_body_if_continuation(%body))
  }
  #if #eq(%kind, 17) {
    #if #call body_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 20) {
    #if #call expression_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 24) {
    #if #call expression_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #if #call expression_uses_division(#call ir_expr_right(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_body_store_rest(%body))
  }
  #if #eq(%kind, 27) {
    #if #call expression_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_expr_right(%body))
  }
  #if #eq(%kind, 18) { #return 0 }
  #if #eq(%kind, 19) { #return 0 }
  #if #eq(%kind, 28) { #return 0 }
