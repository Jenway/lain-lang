  #return 255
}

#proc parser_scope_clear(addr %cursor) -> #unit {
  #let %entry: addr = #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=56))
  #let %remaining: i64 = #call parser_scope_count(%cursor)
  #loop bindings {
    #if #eq(%remaining, 0) { #break bindings }
    #let %next: addr = #call ir_parameter_next(%entry)
    #call bootstrap.release-pages(%entry)
    %entry: addr = %next
    %remaining: i64 = #sub(%remaining, 1)
    #continue bindings
  }
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=72)
  #return
}

#proc parser_scope_pop_to(addr %cursor, i64 %target_count) -> #unit {
  #let %current_count: i64 = #call parser_scope_count(%cursor)
  #if #ge(%target_count, %current_count) {
    #return
  }
  #if #eq(%target_count, 0) {
    #call parser_scope_clear(%cursor)
    #return
