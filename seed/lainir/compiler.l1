// Stage-0 LAIN-IR -> C compiler.
//
// This first vertical slice recognizes:
//   #proc main() -> i32 { #return <decimal integer> }
//
// All recognition and emission logic lives here in LAIN-IR.  The bootstrap
// host supplies byte-oriented input and output capabilities only.

#extern #proc bootstrap.source-count() -> i64;
#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc bootstrap.allocate-pages(i64 %size) -> addr;
#extern #proc bootstrap.release-pages(addr %memory) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(i8 %byte) -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc bootstrap.write-diagnostic(addr %text, i64 %length) -> #unit;

#proc byte_at(addr %data, i64 %index) -> i8 {
  #return #load[i8](#lea(base=%data, idx=%index, scale=1, offset=0))
}

#proc is_digit(i8 %byte) -> i1 {
  #if #lt(%byte, 48) {
    #return 0
  }
  #if #gt(%byte, 57) {
    #return 0
  }
  #return 1
}

#proc is_space(i8 %byte) -> i1 {
  #if #eq(%byte, 32) {
    #return 1
  }
  #if #eq(%byte, 9) {
    #return 1
  }
  #if #eq(%byte, 10) {
    #return 1
  }
  #if #eq(%byte, 13) {
    #return 1
  }
  #return 0
}

#proc matches_text(
  addr %data,
  i64 %length,
  i64 %index,
  addr %text,
  i64 %text_length
) -> i1 {
  #if #gt(#add(%index, %text_length), %length) {
    #return 0
  }

  #let %offset: i64 = 0
  #loop compare {
    #if #ge(%offset, %text_length) {
      #break compare
    }
    #if #ne(
      #call byte_at(%data, #add(%index, %offset)),
      #call byte_at(%text, %offset)
    ) {
      #return 0
    }
    %offset: i64 = #add(%offset, 1)
    #continue compare
  }
  #return 1
}

#proc skip_trivia(addr %data, i64 %length, i64 %start) -> i64 {
  #let %index: i64 = %start

  #loop trivia {
    #if #ge(%index, %length) {
      #return %index
    }

    #let %byte: i8 = #call byte_at(%data, %index)
    #if #call is_space(%byte) {
      %index: i64 = #add(%index, 1)
      #continue trivia
    }

    #if #eq(%byte, 47) {
      #if #lt(#add(%index, 1), %length) {
        #if #eq(#call byte_at(%data, #add(%index, 1)), 47) {
          %index: i64 = #add(%index, 2)
          #loop comment {
            #if #ge(%index, %length) {
              #break comment
            }
            #if #eq(#call byte_at(%data, %index), 10) {
              %index: i64 = #add(%index, 1)
              #break comment
            }
            %index: i64 = #add(%index, 1)
            #continue comment
          }
          #continue trivia
        }
      }
    }

    #return %index
  }

  #return %index
}

// Cursor layout (all offsets are bytes):
//   0  data          addr
//   8  source length i64
//   16 next offset   i64
//   24 token start   i64
//   32 token length  i64
//   40 token kind    i32
//   48 parser error  i32
//   56 scope first   addr
//   64 scope last    addr
//   72 scope count   i64
//   80 loop depth    i64
//   88 loop labels   addr

#proc cursor_new(addr %data, i64 %length) -> addr {
  #let %cursor: addr = #call bootstrap.allocate-pages(96)
  #store %data, #lea(base=%cursor, idx=0, scale=0, offset=0)
  #store %length, #lea(base=%cursor, idx=0, scale=0, offset=8)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=16)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=24)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=32)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=48)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=72)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=80)
  #store 0, #lea(base=%cursor, idx=0, scale=0, offset=88)
  #return %cursor
}

#proc cursor_data(addr %cursor) -> addr {
  #return #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=0))
}

#proc cursor_length(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=8))
}

#proc cursor_offset(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=16))
}

#proc token_start(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=24))
}

#proc token_length(addr %cursor) -> i64 {
  #return #load[i64](#lea(base=%cursor, idx=0, scale=0, offset=32))
}

#proc lexer_commit(
  addr %cursor,
  i32 %kind,
  i64 %start,
  i64 %length,
  i64 %next
) -> i32 {
  #store %next, #lea(base=%cursor, idx=0, scale=0, offset=16)
  #store %start, #lea(base=%cursor, idx=0, scale=0, offset=24)
  #store %length, #lea(base=%cursor, idx=0, scale=0, offset=32)
  #store %kind, #lea(base=%cursor, idx=0, scale=0, offset=40)
  #return %kind
}

#proc lexer_set_kind(addr %cursor, i32 %kind) -> i32 {
  #store %kind, #lea(base=%cursor, idx=0, scale=0, offset=40)
  #return %kind
}

#proc is_alpha(i8 %byte) -> i1 {
  #if #ge(%byte, 65) {
    #if #le(%byte, 90) {
      #return 1
    }
  }
  #if #ge(%byte, 97) {
    #if #le(%byte, 122) {
      #return 1
    }
  }
  #return 0
}

#proc is_ident_start(i8 %byte) -> i1 {
  #if #call is_alpha(%byte) {
    #return 1
  }
  #if #eq(%byte, 95) {
    #return 1
  }
  #if #eq(%byte, 46) {
    #return 1
  }
  #return 0
}

#proc is_ident_char(i8 %byte) -> i1 {
  #if #call is_ident_start(%byte) {
    #return 1
  }
  #if #call is_digit(%byte) {
    #return 1
  }
  #if #eq(%byte, 45) {
    #return 1
  }
  #if #eq(%byte, 33) {
    #return 1
  }
  #return 0
}

#proc lexer_next(addr %cursor) -> i32 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %length: i64 = #call cursor_length(%cursor)
  #let %position: i64 = #call skip_trivia(
    %data,
    %length,
    #call cursor_offset(%cursor)
  )

  #if #ge(%position, %length) {
    #return #call lexer_commit(%cursor, 0, %position, 0, %position)
  }

  #let %byte: i8 = #call byte_at(%data, %position)

  #if #call is_digit(%byte) {
    #let %end: i64 = #add(%position, 1)
    #loop number {
      #if #ge(%end, %length) {
        #break number
      }
      #if #eq(#call is_digit(#call byte_at(%data, %end)), 0) {
        #break number
      }
      %end: i64 = #add(%end, 1)
      #continue number
    }
    #return #call lexer_commit(
      %cursor,
      2,
      %position,
      #sub(%end, %position),
      %end
    )
  }

  #if #call is_ident_start(%byte) {
    #let %end: i64 = #add(%position, 1)
    #loop identifier {
      #if #ge(%end, %length) {
        #break identifier
      }
      #if #eq(#call is_ident_char(#call byte_at(%data, %end)), 0) {
        #break identifier
      }
      %end: i64 = #add(%end, 1)
      #continue identifier
    }
    #let %identifier_kind: i32 = #call lexer_commit(
      %cursor,
      1,
      %position,
      #sub(%end, %position),
      %end
    )
    #if #call token_equals(%cursor, "else", 4) {
      #return #call lexer_set_kind(%cursor, 25)
    }
    #return %identifier_kind
  }

  #if #eq(%byte, 35) {
    #let %start: i64 = #add(%position, 1)
    #if #ge(%start, %length) {
      #return #call lexer_commit(%cursor, 255, %position, 1, %start)
    }
    #if #eq(#call is_ident_start(#call byte_at(%data, %start)), 0) {
      #return #call lexer_commit(%cursor, 255, %position, 1, %start)
    }
    #let %end: i64 = #add(%start, 1)
    #loop hash_identifier {
      #if #ge(%end, %length) {
        #break hash_identifier
      }
      #if #eq(#call is_ident_char(#call byte_at(%data, %end)), 0) {
        #break hash_identifier
      }
      %end: i64 = #add(%end, 1)
      #continue hash_identifier
    }
    #let %generic_kind: i32 = #call lexer_commit(
      %cursor,
      16,
      %start,
      #sub(%end, %start),
      %end
    )
    #return #call classify_hash_keyword(%cursor)
  }

  #if #eq(%byte, 34) {
    #let %start: i64 = #add(%position, 1)
    #let %end: i64 = %start
    #loop string {
      #if #ge(%end, %length) {
        #return #call lexer_commit(
          %cursor,
          255,
          %position,
          #sub(%end, %position),
          %end
        )
      }
      #let %current: i8 = #call byte_at(%data, %end)
      #if #eq(%current, 34) {
        #return #call lexer_commit(
          %cursor,
          3,
          %start,
          #sub(%end, %start),
          #add(%end, 1)
        )
      }
      #if #eq(%current, 92) {
        %end: i64 = #add(%end, 1)
        #if #ge(%end, %length) {
          #return #call lexer_commit(
            %cursor,
            255,
            %position,
            #sub(%end, %position),
            %end
          )
        }
      }
      %end: i64 = #add(%end, 1)
      #continue string
    }
  }

  #if #eq(%byte, 45) {
    #if #lt(#add(%position, 1), %length) {
      #if #eq(#call byte_at(%data, #add(%position, 1)), 62) {
        #return #call lexer_commit(%cursor, 14, %position, 2, #add(%position, 2))
      }
    }
    #return #call lexer_commit(%cursor, 255, %position, 1, #add(%position, 1))
  }

  #if #eq(%byte, 37) {
    #return #call lexer_commit(%cursor, 4, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 40) {
    #return #call lexer_commit(%cursor, 5, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 41) {
    #return #call lexer_commit(%cursor, 6, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 123) {
    #return #call lexer_commit(%cursor, 7, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 125) {
    #return #call lexer_commit(%cursor, 8, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 91) {
    #return #call lexer_commit(%cursor, 9, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 93) {
    #return #call lexer_commit(%cursor, 10, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 44) {
    #return #call lexer_commit(%cursor, 11, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 58) {
    #return #call lexer_commit(%cursor, 12, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 61) {
    #return #call lexer_commit(%cursor, 13, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 59) {
    #return #call lexer_commit(%cursor, 15, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 60) {
    #return #call lexer_commit(%cursor, 48, %position, 1, #add(%position, 1))
  }
  #if #eq(%byte, 62) {
    #return #call lexer_commit(%cursor, 49, %position, 1, #add(%position, 1))
  }

  #return #call lexer_commit(
    %cursor,
    255,
    %position,
    1,
    #add(%position, 1)
  )
}

#proc token_equals(addr %cursor, addr %text, i64 %length) -> i1 {
  #if #ne(#call token_length(%cursor), %length) {
    #return 0
  }
  #return #call matches_text(
    #call cursor_data(%cursor),
    #call cursor_length(%cursor),
    #call token_start(%cursor),
    %text,
    %length
  )
}

#proc classify_hash_keyword(addr %cursor) -> i32 {
  #if #call token_equals(%cursor, "unit", 4) {
    #return #call lexer_set_kind(%cursor, 17)
  }
  #if #call token_equals(%cursor, "never", 5) {
    #return #call lexer_set_kind(%cursor, 18)
  }
  #if #call token_equals(%cursor, "proc", 4) {
    #return #call lexer_set_kind(%cursor, 19)
  }
  #if #call token_equals(%cursor, "extern", 6) {
    #return #call lexer_set_kind(%cursor, 20)
  }
  #if #call token_equals(%cursor, "return", 6) {
    #return #call lexer_set_kind(%cursor, 21)
  }
  #if #call token_equals(%cursor, "store", 5) {
    #return #call lexer_set_kind(%cursor, 22)
  }
  #if #call token_equals(%cursor, "call", 4) {
    #return #call lexer_set_kind(%cursor, 23)
  }
  #if #call token_equals(%cursor, "if", 2) {
    #return #call lexer_set_kind(%cursor, 24)
  }
  #if #call token_equals(%cursor, "else", 4) {
    #return #call lexer_set_kind(%cursor, 25)
  }
  #if #call token_equals(%cursor, "loop", 4) {
    #return #call lexer_set_kind(%cursor, 26)
  }
  #if #call token_equals(%cursor, "break", 5) {
    #return #call lexer_set_kind(%cursor, 27)
  }
  #if #call token_equals(%cursor, "continue", 8) {
    #return #call lexer_set_kind(%cursor, 28)
  }
  #if #call token_equals(%cursor, "let", 3) {
    #return #call lexer_set_kind(%cursor, 29)
  }
  #if #call token_equals(%cursor, "primitive", 9) {
    #return #call lexer_set_kind(%cursor, 30)
  }
  #if #call token_equals(%cursor, "alloca", 6) {
    #return #call lexer_set_kind(%cursor, 31)
  }
  #if #call token_equals(%cursor, "field", 5) {
    #return #call lexer_set_kind(%cursor, 32)
  }
  #if #call token_equals(%cursor, "lea", 3) {
    #return #call lexer_set_kind(%cursor, 33)
  }
  #if #call token_equals(%cursor, "load", 4) {
    #return #call lexer_set_kind(%cursor, 34)
  }
  #if #call token_equals(%cursor, "add", 3) {
    #return #call lexer_set_kind(%cursor, 35)
  }
  #if #call token_equals(%cursor, "sub", 3) {
    #return #call lexer_set_kind(%cursor, 36)
  }
  #if #call token_equals(%cursor, "mul", 3) {
    #return #call lexer_set_kind(%cursor, 37)
  }
  #if #call token_equals(%cursor, "div", 3) {
    #return #call lexer_set_kind(%cursor, 38)
  }
  #if #call token_equals(%cursor, "eq", 2) {
    #return #call lexer_set_kind(%cursor, 39)
  }
  #if #call token_equals(%cursor, "ne", 2) {
    #return #call lexer_set_kind(%cursor, 40)
  }
  #if #call token_equals(%cursor, "lt", 2) {
    #return #call lexer_set_kind(%cursor, 41)
  }
  #if #call token_equals(%cursor, "le", 2) {
    #return #call lexer_set_kind(%cursor, 42)
  }
  #if #call token_equals(%cursor, "gt", 2) {
    #return #call lexer_set_kind(%cursor, 43)
  }
  #if #call token_equals(%cursor, "ge", 2) {
    #return #call lexer_set_kind(%cursor, 44)
  }
  #if #call token_equals(%cursor, "call_indirect", 13) {
    #return #call lexer_set_kind(%cursor, 45)
  }
  #if #call token_equals(%cursor, "eval", 4) {
    #return #call lexer_set_kind(%cursor, 46)
  }
  #if #call token_equals(%cursor, "proc_addr", 9) {
    #return #call lexer_set_kind(%cursor, 47)
  }
  #if #call token_equals(%cursor, "bits", 4) {
    #return #call lexer_set_kind(%cursor, 50)
  }
  #if #call token_equals(%cursor, "addr", 4) {
    #return #call lexer_set_kind(%cursor, 51)
  }
  #if #call token_equals(%cursor, "float", 5) {
    #return #call lexer_set_kind(%cursor, 52)
  }
  #if #call token_equals(%cursor, "sdiv", 4) {
    #return #call lexer_set_kind(%cursor, 53)
  }
  #if #call token_equals(%cursor, "udiv", 4) {
    #return #call lexer_set_kind(%cursor, 54)
  }
  #if #call token_equals(%cursor, "slt", 3) {
    #return #call lexer_set_kind(%cursor, 55)
  }
  #if #call token_equals(%cursor, "sle", 3) {
    #return #call lexer_set_kind(%cursor, 56)
  }
  #if #call token_equals(%cursor, "sgt", 3) {
    #return #call lexer_set_kind(%cursor, 57)
  }
  #if #call token_equals(%cursor, "sge", 3) {
    #return #call lexer_set_kind(%cursor, 58)
  }
  #if #call token_equals(%cursor, "ult", 3) {
    #return #call lexer_set_kind(%cursor, 59)
  }
  #if #call token_equals(%cursor, "ule", 3) {
    #return #call lexer_set_kind(%cursor, 60)
  }
  #if #call token_equals(%cursor, "ugt", 3) {
    #return #call lexer_set_kind(%cursor, 61)
  }
  #if #call token_equals(%cursor, "uge", 3) {
    #return #call lexer_set_kind(%cursor, 62)
  }
  #if #call token_equals(%cursor, "zext", 4) {
    #return #call lexer_set_kind(%cursor, 63)
  }
  #if #call token_equals(%cursor, "sext", 4) {
    #return #call lexer_set_kind(%cursor, 64)
  }
  #if #call token_equals(%cursor, "trunc", 5) {
    #return #call lexer_set_kind(%cursor, 65)
  }
  #if #call token_equals(%cursor, "fadd", 4) {
    #return #call lexer_set_kind(%cursor, 66)
  }
  #if #call token_equals(%cursor, "fsub", 4) {
    #return #call lexer_set_kind(%cursor, 67)
  }
  #if #call token_equals(%cursor, "fmul", 4) {
    #return #call lexer_set_kind(%cursor, 68)
  }
  #if #call token_equals(%cursor, "fdiv", 4) {
    #return #call lexer_set_kind(%cursor, 69)
  }
  #if #call token_equals(%cursor, "feq", 3) {
    #return #call lexer_set_kind(%cursor, 70)
  }
  #if #call token_equals(%cursor, "flt", 3) {
    #return #call lexer_set_kind(%cursor, 71)
  }
  #if #call token_equals(%cursor, "bitcast", 7) {
    #return #call lexer_set_kind(%cursor, 72)
  }
  #return 16
}

#proc emit_error(addr %message, i64 %length, i32 %status) -> i32 {
  #call bootstrap.write-diagnostic(%message, %length)
  #return %status
}

#proc syntax_error() -> i32 {
  #return #call emit_error(
    "lainir-c: invalid module",
    24,
    3
  )
}

#proc reject_cursor(addr %cursor) -> i32 {
  #call bootstrap.release-pages(%cursor)
  #return #call syntax_error()
}

#proc lexer_contract_fail(addr %cursor, i32 %status) -> i32 {
  #call bootstrap.release-pages(%cursor)
  #return %status
}

// Compiler-owned IR.
//
// Module:   +0 first function addr, +8 last function addr, +16 count i64
// Function: +0 name start i64, +8 name length i64, +16 return width i32,
//           +24 body expression addr, +32 next function addr,
//           +40 first parameter addr, +48 parameter count i64
// Parameter:+0 name start i64, +8 name length i64, +16 width i32,
//           +24 next parameter addr
// Expr:     +0 kind i32 (1 const, 2 add, 3 call, 4 sub, 5 mul, 6 div,
//                       7 eq, 8 ne, 9 lt, 10 le, 11 gt, 12 ge, 13 var),
//           +8 source start i64, +16 source length i64,
//           +24 left/first-argument addr, +32 right addr,
//           +40 next argument addr, +48 argument count i64
//           kind 46 is #eval; its left field is the returned block expression.

#proc ir_expr_new(
  i32 %kind,
  i64 %start,
  i64 %length,
  addr %left,
  addr %right
) -> addr {
  #let %expression: addr = #call bootstrap.allocate-pages(56)
  #store %kind, #lea(base=%expression, idx=0, scale=0, offset=0)
  #store %start, #lea(base=%expression, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%expression, idx=0, scale=0, offset=16)
  #store %left, #lea(base=%expression, idx=0, scale=0, offset=24)
  #store %right, #lea(base=%expression, idx=0, scale=0, offset=32)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%expression, idx=0, scale=0, offset=48)
  #return %expression
}

#proc ir_expr_const_new(i64 %start, i64 %length) -> addr {
  #let %expression: addr = #call bootstrap.allocate-pages(56)
  #store 1, #lea(base=%expression, idx=0, scale=0, offset=0)
  #store %start, #lea(base=%expression, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%expression, idx=0, scale=0, offset=16)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=24)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=32)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=40)
  #store 0, #lea(base=%expression, idx=0, scale=0, offset=48)
  #return %expression
}

#proc ir_expr_binary_new(i32 %kind, addr %left, addr %right) -> addr {
  #return #call ir_expr_new(%kind, 0, 0, %left, %right)
}

#proc ir_expr_call_new(
  i64 %start,
  i64 %length,
  addr %first_argument,
  i64 %argument_count
) -> addr {
  #let %expression: addr = #call bootstrap.allocate-pages(56)
  #store 3, #lea(base=%expression, idx=0, scale=0, offset=0)
  #store %start, #lea(base=%expression, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%expression, idx=0, scale=0, offset=16)
  #store %first_argument, #lea(base=%expression, idx=0, scale=0, offset=24)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=32)
  #store %expression, #lea(base=%expression, idx=0, scale=0, offset=40)
  #store %argument_count, #lea(base=%expression, idx=0, scale=0, offset=48)
  #return %expression
}

#proc ir_expr_call_empty(i64 %start, i64 %length) -> addr {
  #let %expression: addr = #call bootstrap.allocate-pages(56)
  #store 3, #lea(base=%expression, idx=0, scale=0, offset=0)
  #store %start, #lea(base=%expression, idx=0, scale=0, offset=8)
  #store %length, #lea(base=%expression, idx=0, scale=0, offset=16)
