  }
  #if #eq(%kind, 26) {
    #if #call expression_uses_division(#call ir_expr_left(%expression)) {
      #return 1
    }
    #let %argument: addr = #call ir_expr_right(%expression)
    #let %remaining: i64 = #call ir_indirect_argument_count(%expression)
    #loop indirect_arguments {
      #if #eq(%remaining, 0) { #break indirect_arguments }
      #if #call expression_uses_division(%argument) { #return 1 }
      %argument: addr = #call ir_expr_next(%argument)
      %remaining: i64 = #sub(%remaining, 1)
      #continue indirect_arguments
    }
  }
  #return 0
}

#proc body_uses_division(addr %body) -> i1 {
  #let %kind: i32 = #call ir_expr_kind(%body)
  #if #eq(%kind, 16) { #return 0 }
  #if #eq(%kind, 14) {
    #if #call expression_uses_division(#call ir_expr_left(%body)) { #return 1 }
    #return #call body_uses_division(#call ir_expr_right(%body))
