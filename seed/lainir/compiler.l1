#proc parser_scope_add(
  addr %cursor,
  i64 %start,
  i64 %length,
  i32 %width
) -> i1 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %source_length: i64 = #call cursor_length(%cursor)
  #let %entry: addr = #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=56))
  #let %remaining: i64 = #call parser_scope_count(%cursor)
  #loop existing {
    #if #eq(%remaining, 0) { #break existing }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      %start,
      %length,
      #call ir_parameter_name_start(%entry),
      #call ir_parameter_name_length(%entry)
    ) {
      #return 0
    }
    %entry: addr = #call ir_parameter_next(%entry)
    %remaining: i64 = #sub(%remaining, 1)
    #continue existing
  }

  #let %binding: addr = #call ir_parameter_new(%start, %length, %width)
  #let %count: i64 = #call parser_scope_count(%cursor)
  #if #eq(%count, 0) {
    #store %binding, #lea(base=%cursor, idx=0, scale=0, offset=56)
  } else {
    #let %tail: addr = #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=64))
    #call ir_parameter_set_next(%tail, %binding)
  }
  #store %binding, #lea(base=%cursor, idx=0, scale=0, offset=64)
  #store #add(%count, 1), #lea(base=%cursor, idx=0, scale=0, offset=72)
  #return 1
}

#proc parser_scope_width(
  addr %cursor,
  i64 %start,
  i64 %length
) -> i32 {
  #let %data: addr = #call cursor_data(%cursor)
  #let %source_length: i64 = #call cursor_length(%cursor)
  #let %entry: addr = #load[addr](#lea(base=%cursor, idx=0, scale=0, offset=56))
  #let %remaining: i64 = #call parser_scope_count(%cursor)
  #loop bindings {
    #if #eq(%remaining, 0) { #break bindings }
    #if #call source_ranges_equal(
      %data,
      %source_length,
      %start,
      %length,
      #call ir_parameter_name_start(%entry),
      #call ir_parameter_name_length(%entry)
