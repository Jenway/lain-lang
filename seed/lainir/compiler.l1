  #let %last_keep: addr = #load[addr](
    #lea(base=%cursor, idx=0, scale=0, offset=56)
  )
  #let %index: i64 = 1
  #loop find_boundary {
    #if #ge(%index, %target_count) { #break find_boundary }
    %last_keep: addr = #call ir_parameter_next(%last_keep)
    %index: i64 = #add(%index, 1)
    #continue find_boundary
  }

  #let %entry: addr = #call ir_parameter_next(%last_keep)
  #let %remove_count: i64 = #sub(%current_count, %target_count)
  #loop remove {
    #if #eq(%remove_count, 0) { #break remove }
    #let %next: addr = #call ir_parameter_next(%entry)
    #call bootstrap.release-pages(%entry)
    %entry: addr = %next
    %remove_count: i64 = #sub(%remove_count, 1)
    #continue remove
  }
  #call ir_parameter_set_next(%last_keep, %last_keep)
  #store %last_keep, #lea(base=%cursor, idx=0, scale=0, offset=64)
  #store %target_count, #lea(base=%cursor, idx=0, scale=0, offset=72)
  #return
}

