#proc sum(%n: #bits<32>) -> #bits<32> {
  %total = #loop L1(%i: #bits<32> = 0, %acc: #bits<32> = 0) -> (#bits<32>) {
    %c2 = #slt[#bits<32>](%i, %n)
    #if %c2 {
      %r3 = #add[#bits<32>](%acc, %i)
      %r4 = #add[#bits<32>](%i, 1)
      #continue L1(%r4, %r3)
    }
    #break L1(%acc)
  }
  #return %total
}

#proc main() -> #bits<32> {
  %_tmp0 = #call sum(5)
  #return %_tmp0
}
