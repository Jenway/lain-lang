#proc Shape__Empty_tag() -> #bits<64> {
  #return 0
}

#proc Shape__Circle_tag() -> #bits<64> {
  #return 1
}

#proc Shape__Circle_off() -> #bits<64> {
  #return 8
}

#proc Shape__Square_tag() -> #bits<64> {
  #return 2
}

#proc Shape__Square_off() -> #bits<64> {
  #return 8
}

#proc Shape__size() -> #bits<64> {
  #return 16
}
