// LAINIR 测试程序：文本形式。
//
// 这份文件是 run_programs 的输入：解析 -> 验证 -> 装载 -> 在 VM 里跑。
// 它是**手写**的，所以允许任意排版；canonical 形式由打印器给出。
//
// 里面有三个反面对照（bad_load / write_ro / bad_call）：它们是合法程序，
// 但运行时会碰到域外行为，应当被 VM 确定性拒绝。

data bytes ro { 7 8 9 }

// 模块级**可写**数据：状态跨调用保留（.data 段）。
data counter rw { 0 0 0 0 0 0 0 0 }

#proc answer() -> #bits<64> {
  %r = #add[#bits<64>](40, 2)
  #return %r
}

#proc max(%a: #bits<64>, %b: #bits<64>) -> #bits<64> {
  %c = #sgt[#bits<64>](%a, %b)
  %r = #if %c -> (#bits<64>) {
    #yield %a
  } else {
    #yield %b
  }
  #return %r
}

#proc fact(%n: #bits<64>) -> #bits<64> {
  %c = #sle[#bits<64>](%n, 1)
  %r = #if %c -> (#bits<64>) {
    #yield 1
  } else {
    %m = #sub[#bits<64>](%n, 1)
    %f = #call fact(%m)
    %p = #mul[#bits<64>](%n, %f)
    #yield %p
  }
  #return %r
}

#proc sum_bytes(%p: #addr, %n: #bits<64>) -> #bits<64> {
  %sum = #loop bytes(%i: #bits<64> = 0, %s: #bits<64> = 0) -> (#bits<64>) {
    %c = #uge[#bits<64>](%i, %n)
    #if %c {
      #break bytes(%s)
    }
    %a = #lea(%p, %i, 1, 0)
    %b = #load[#bits<8>](%a)
    %w = #zext[#bits<64>](%b)
    %s2 = #add[#bits<64>](%s, %w)
    %i2 = #add[#bits<64>](%i, 1)
    #continue bytes(%i2, %s2)
  }
  #return %sum
}

#proc first_byte() -> #bits<64> {
  %p = #data_addr bytes
  %b = #load[#bits<8>](%p)
  %w = #zext[#bits<64>](%b)
  #return %w
}

// 访问一块从来没登记过的地址：VM 应当拒绝。
#proc bad_load() -> #bits<64> {
  %p = #int2ptr[#addr](4096)
  %b = #load[#bits<8>](%p)
  %w = #zext[#bits<64>](%b)
  #return %w
}

#proc alloca_store() -> #bits<64> {
  %slot = #alloca[#bits<64>](1)
  #store[#bits<64>](5, %slot)
  %v = #load[#bits<64>](%slot)
  #return %v
}

// 往只读段写：VM 应当拒绝。
#proc write_ro() -> #bits<64> {
  %p = #data_addr bytes
  #store[#bits<8>](1, %p)
  #return 0
}

// 32 位有符号比较：0xFFFFFFFF 是 -1，应当小于 1。
#proc slt32() -> #bits<64> {
  %c = #slt[#bits<32>](0xFFFFFFFF, 1)
  %w = #zext[#bits<64>](%c)
  #return %w
}

#proc inc(%x: #bits<64>) -> #bits<64> {
  %r = #add[#bits<64>](%x, 1)
  #return %r
}

#proc apply(%f: #addr, %x: #bits<64>) -> #bits<64> {
  %r = #call_indirect[#bits<64>](%f, %x)
  #return %r
}

#proc via_ptr() -> #bits<64> {
  %f = #proc_addr inc
  %v = #call apply(%f, 41)
  #return %v
}

// 拿数据地址去间接调用：区段没有 CALL 权限，VM 应当拒绝。
#proc bad_call() -> #bits<64> {
  %p = #data_addr bytes
  %r = #call_indirect[#bits<64>](%p)
  #return %r
}

// --- 下面几条是**形状覆盖**：它们曾经是「能跑但零覆盖」的路径。---

// 通过内存改状态：状态跨调用保留。
#proc bump() -> #bits<64> {
  %p = #data_addr counter
  %v = #load[#bits<64>](%p)
  %n = #add[#bits<64>](%v, 1)
  #store[#bits<64>](%n, %p)
  #return %n
}

#proc bump_three() -> #bits<64> {
  %a = #call bump()
  %b = #call bump()
  %c = #call bump()
  %s = #add[#bits<64>](#add[#bits<64>](%a, %b), %c)
  #return %s
}

// 无结果过程 + 无结果调用 + 无操作数 #return。
#proc nop(%x: #bits<64>) {
  #return
}

#proc void_driver() -> #bits<64> {
  #call nop(7)
  #call nop(8)
  #return 42
}

// 多结果区域：一个区域交出两个值，绑成两个名字。
// 新 IR 没有复合类型，所以多结果就是多个结果。
#proc pick(%c: #bits<1>) -> #bits<64> {
  %a, %b = #if %c -> (#bits<64>, #bits<64>) {
    #yield 1, 2
  } else {
    #yield 30, 4
  }
  %s = #add[#bits<64>](%a, %b)
  #return %s
}

#proc pick_true() -> #bits<64> {
  %r = #call pick(1)
  #return %r
}

#proc pick_false() -> #bits<64> {
  %r = #call pick(0)
  #return %r
}

// 嵌套表达式：输入糖会自动摊平成 _tmp<N>。canonical 形式里没有嵌套。
#proc nested(%a: #bits<64>, %b: #bits<64>) -> #bits<64> {
  %v = #add[#bits<64>](#mul[#bits<64>](%a, 10), #sub[#bits<64>](%b, 48))
  #return %v
}

// 循环携带状态：新 IR 里游标是循环参数，不是被赋值的绑定。
#proc count_up(%n: #bits<64>) -> #bits<64> {
  %total = #loop steps(%i: #bits<64> = 0, %acc: #bits<64> = 0) -> (#bits<64>) {
    %c = #uge[#bits<64>](%i, %n)
    #if %c {
      #break steps(%acc)
    }
    %next = #add[#bits<64>](%i, 1)
    %sum = #add[#bits<64>](%acc, %i)
    #continue steps(%next, %sum)
  }
  #return %total
}
