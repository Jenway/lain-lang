// Meta v0 —— 语言定义层，手写 LAINIR。
//
// 它是「编译器的哪一部分必须能用 Lain 重写」这条边界的第一个落点：
// 它读源码字节，按语言规则决定含义，产出 canonical LAINIR 文本，
// 交给驱动去 parse + verify + 执行。它不认识任何物理算子，
// 底座也不认识任何 Lain 概念。
//
// v0 的语言只有一条规则：
//     let NAME = INTEGER;
// 产出：
//     #proc NAME() -> #bits<64> {
//       #return INTEGER
//     }
//
// 三个入口对应三个标准阶段。v0 里 expand 是恒等（还没有宏），
// elaborate 与 lower 合成一条直线——等形状长出来再拆。

#proc lain_std_abi_version() -> #bits<64> {
  #return 1
}

#proc lain_std_initialize(%host: #addr) -> #bits<32> {
  #return 0
}

// 产出：把 source 那份源码 lowering 成 LAINIR 文本，写进宿主的输出缓冲。
// 返回 0 = 成功。
#proc lain_std_lower(%host: #addr, %source: #bits<64>) -> #bits<32> {
  %reset = #call lain_meta_emit_reset(%host)
  %len = #call lain_meta_source_length(%host, %source)
  %base = #call lain_meta_source_data(%host, %source)
  %status = #call meta_lower_source(%host, %base, %len)
  #return %status
}

#proc meta_lower_source(%host: #addr, %base: #addr, %len: #bits<64>) -> #bits<32> {
  %at = #call bs_skip_space(%base, 0, %len)
  %is_let = #call bs_match_let(%base, %at, %len)
  %status = #if %is_let -> (#bits<32>) {
    %s = #call meta_lower_let(%host, %base, %len, %at)
    #yield %s
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

#proc meta_lower_let(%host: #addr, %base: #addr, %len: #bits<64>, %let_at: #bits<64>) -> #bits<32> {
  %after = #add[#bits<64>](%let_at, 3)
  %name_lo = #call bs_skip_space(%base, %after, %len)
  %name_hi = #call bs_skip_ident(%base, %name_lo, %len)
  %has_name = #ult[#bits<64>](%name_lo, %name_hi)
  %status = #if %has_name -> (#bits<32>) {
    %s = #call meta_lower_binding(%host, %base, %len, %name_lo, %name_hi)
    #yield %s
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

// NAME [: TYPE] = INT
#proc meta_lower_binding(%host: #addr, %base: #addr, %len: #bits<64>,
                         %name_lo: #bits<64>, %name_hi: #bits<64>) -> #bits<32> {
  %at = #call bs_skip_space(%base, %name_hi, %len)
  %is_colon = #call bs_is_byte(%base, %at, 58)
  %status = #if %is_colon -> (#bits<32>) {
    %after = #add[#bits<64>](%at, 1)
    %t_lo = #call bs_skip_space(%base, %after, %len)
    %t_hi = #call bs_skip_ident(%base, %t_lo, %len)
    %s = #call meta_lower_typed(%host, %base, %len, %name_lo, %name_hi, %t_lo,
                                %t_hi)
    #yield %s
  } else {
    %s = #call meta_lower_typed(%host, %base, %len, %name_lo, %name_hi, 0, 0)
    #yield %s
  }
  #return %status
}

// 查类型表拿到 repr，再 `= INT`，最后把整条绑定写出去。
#proc meta_lower_typed(%host: #addr, %base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %t_lo: #bits<64>, %t_hi: #bits<64>) -> #bits<32> {
  %has_type = #ult[#bits<64>](%t_lo, %t_hi)
  %tbl = #data_addr meta_types

  // 查类型条目；没有标注时给 0（下面不会用它）
  %entry = #if %has_type -> (#bits<64>) {
    %tname = #lea(%base, %t_lo, 1, 0)
    %tlen = #sub[#bits<64>](%t_hi, %t_lo)
    %e = #call meta_type_find(%tbl, %tname, %tlen)
    #yield %e
  } else {
    #yield 0
  }
  %miss = #eq[#bits<64>](%entry, 0xFFFFFFFFFFFFFFFF)
  %unknown = #and[#bits<1>](%has_type, %miss)
  #if %unknown {
    %f0 = #call lain_meta_fail(%host, 5)
    #return 5
  }

  // kind 在低 8 位、width 在 8..15 位
  %info = #if %has_type -> (#bits<64>) {
    %p = #call meta_type_info(%tbl, %entry)
    #yield %p
  } else {
    // 没有标注：v0 的形式，默认 #bits<64>
    %d = #shl[#bits<64>](64, 8)
    #yield %d
  }
  %kind = #and[#bits<64>](%info, 255)
  %width = #and[#bits<64>](#lshr[#bits<64>](%info, 8), 255)

  // 从类型名之后接着解析；没有标注就从名字之后
  %resume = #if %has_type -> (#bits<64>) {
    #yield %t_hi
  } else {
    #yield %name_hi
  }
  %eq_at = #call bs_skip_space(%base, %resume, %len)
  %is_eq = #call bs_is_byte(%base, %eq_at, 61)
  %status = #if %is_eq -> (#bits<32>) {
    %after_eq = #add[#bits<64>](%eq_at, 1)
    %lhs_lo = #call bs_skip_space(%base, %after_eq, %len)
    %lhs_hi = #call bs_skip_ident(%base, %lhs_lo, %len)
    %has_lhs = #ult[#bits<64>](%lhs_lo, %lhs_hi)
    %inner = #if %has_lhs -> (#bits<32>) {
      %s = #call meta_emit_value(%host, %base, %len, %name_lo, %name_hi, %kind,
                                 %width, %tbl, %entry, %lhs_lo, %lhs_hi)
      #yield %s
    } else {
      %f = #call lain_meta_fail(%host, 3)
      #yield 3
    }
    #yield %inner
  } else {
    %f = #call lain_meta_fail(%host, 4)
    #yield 4
  }
  #return %status
}

// 右值：一个整数，或者 `整数 OP 整数`。
// 后者拿符号去**类型的 op 表**里查该发哪条物理算子——Meta 不知道
// "div" 对有符号和无符号是不同的。
#proc meta_emit_value(%host: #addr, %base: #addr, %len: #bits<64>,
                      %name_lo: #bits<64>, %name_hi: #bits<64>,
                      %kind: #bits<64>, %width: #bits<64>, %tbl: #addr,
                      %entry: #bits<64>, %lhs_lo: #bits<64>,
                      %lhs_hi: #bits<64>) -> #bits<32> {
  %op_at = #call bs_skip_space(%base, %lhs_hi, %len)
  %op_byte = #call bs_byte_at(%base, %op_at, %len)
  %is_op = #call bs_is_operator(%op_byte)
  %status = #if %is_op -> (#bits<32>) {
    %sym_at = #add[#bits<64>](%op_at, 1)
    %rhs_lo = #call bs_skip_space(%base, %sym_at, %len)
    %rhs_hi = #call bs_skip_ident(%base, %rhs_lo, %len)
    %has_rhs = #ult[#bits<64>](%rhs_lo, %rhs_hi)
    %inner = #if %has_rhs -> (#bits<32>) {
      %sym = #lea(%base, %op_at, 1, 0)
      %op_entry = #call meta_op_find(%tbl, %entry, %sym, 1)
      %op_miss = #eq[#bits<64>](%op_entry, 0xFFFFFFFFFFFFFFFF)
      %r = #if %op_miss -> (#bits<32>) {
        %f = #call lain_meta_fail(%host, 6)
        #yield 6
      } else {
        %s = #call meta_emit_binary(%host, %base, %len, %name_lo, %name_hi,
                                    %kind, %width, %tbl, %op_entry, %lhs_lo,
                                    %rhs_lo)
        #yield %s
      }
      #yield %r
    } else {
      %f = #call lain_meta_fail(%host, 3)
      #yield 3
    }
    #yield %inner
  } else {
    %s = #call meta_emit_let(%host, %base, %len, %name_lo, %name_hi, %kind,
                             %width, %lhs_lo)
    #yield %s
  }
  #return %status
}

// 把这条绑定写成 LAINIR。
#proc meta_emit_let(%host: #addr, %base: #addr, %len: #bits<64>,
                    %name_lo: #bits<64>, %name_hi: #bits<64>,
                    %kind: #bits<64>, %width: #bits<64>,
                    %num_lo: #bits<64>) -> #bits<32> {
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lain_meta_emit_write(%host, %name_at, %name_len)
  %p2a = #data_addr meta_p2a
  %w3 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w4 = #call meta_emit_repr(%host, %kind, %width)
  %p2b = #data_addr meta_p2b
  %w5 = #call lain_meta_emit_write(%host, %p2b, 13)
  %value = #call bs_read_uint(%base, %num_lo, %len)
  %w6 = #call meta_emit_uint(%host, %value)
  %p3 = #data_addr meta_p3
  %w7 = #call lain_meta_emit_write(%host, %p3, 3)
  #return 0
}

// 带算子的一条：`%r = #<物理算子>[<repr>](lhs, rhs)`。
// 物理算子名是从类型的 op 表里读出来的，不是这里选的。
#proc meta_emit_binary(%host: #addr, %base: #addr, %len: #bits<64>,
                       %name_lo: #bits<64>, %name_hi: #bits<64>,
                       %kind: #bits<64>, %width: #bits<64>, %tbl: #addr,
                       %op_entry: #bits<64>, %lhs_lo: #bits<64>,
                       %rhs_lo: #bits<64>) -> #bits<32> {
  %p1 = #data_addr meta_p1
  %w1 = #call lain_meta_emit_write(%host, %p1, 6)
  %name_at = #lea(%base, %name_lo, 1, 0)
  %name_len = #sub[#bits<64>](%name_hi, %name_lo)
  %w2 = #call lain_meta_emit_write(%host, %name_at, %name_len)
  %p2a = #data_addr meta_p2a
  %w3 = #call lain_meta_emit_write(%host, %p2a, 6)
  %w4 = #call meta_emit_repr(%host, %kind, %width)
  %o1 = #data_addr meta_o1
  %w5 = #call lain_meta_emit_write(%host, %o1, 11)
  %phys = #call meta_op_phys_at(%tbl, %op_entry)
  %phys_len = #call meta_op_phys_len(%tbl, %op_entry)
  %w6 = #call lain_meta_emit_write(%host, %phys, %phys_len)
  %o2 = #data_addr meta_o2
  %w7 = #call lain_meta_emit_write(%host, %o2, 1)
  %w8 = #call meta_emit_repr(%host, %kind, %width)
  %o3 = #data_addr meta_o3
  %w9 = #call lain_meta_emit_write(%host, %o3, 2)
  %lhs = #call bs_read_uint(%base, %lhs_lo, %len)
  %w10 = #call meta_emit_uint(%host, %lhs)
  %o4 = #data_addr meta_o4
  %w11 = #call lain_meta_emit_write(%host, %o4, 2)
  %rhs = #call bs_read_uint(%base, %rhs_lo, %len)
  %w12 = #call meta_emit_uint(%host, %rhs)
  %o5 = #data_addr meta_o5
  %w13 = #call lain_meta_emit_write(%host, %o5, 15)
  %o6 = #data_addr meta_o6
  %w14 = #call lain_meta_emit_write(%host, %o6, 2)
  #return 0
}
