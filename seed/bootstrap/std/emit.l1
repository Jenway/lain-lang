// 初代标准库 v0 —— 宿主 ABI 与产物输出。
//
// 这里声明 Meta 用到的**全部**宿主能力。它们是 link_name，同时是链接符号名，
// 所以必须是合法 C 标识符（SYMBOL 策略下后端按这个名字发外部符号引用）。
//
// 每个能力的第一个参数都是 host 地址：驱动把它作为 #addr 传进 Meta，
// Meta 原样传回来。宿主 ABI 不带 user_data，所以指针是**显式输入**，
// 而不是让产物去某个全局里捞。

#proc lain_meta_source_count(%host: #addr) -> #bits<64> #extern "lain_meta_source_count"
#proc lain_meta_source_data(%host: #addr, %index: #bits<64>) -> #addr #extern "lain_meta_source_data"
#proc lain_meta_source_length(%host: #addr, %index: #bits<64>) -> #bits<64> #extern "lain_meta_source_length"
#proc lain_meta_source_path_data(%host: #addr, %index: #bits<64>) -> #addr #extern "lain_meta_source_path_data"
#proc lain_meta_emit_reset(%host: #addr) -> #bits<32> #extern "lain_meta_emit_reset"
#proc lain_meta_emit_write(%host: #addr, %data: #addr, %length: #bits<64>) -> #bits<32> #extern "lain_meta_emit_write"
#proc lain_meta_emit_data(%host: #addr) -> #addr #extern "lain_meta_emit_data"
#proc lain_meta_emit_length(%host: #addr) -> #bits<64> #extern "lain_meta_emit_length"
#proc lain_meta_fail(%host: #addr, %code: #bits<32>) -> #bits<32> #extern "lain_meta_fail"

// 输出模板。产物长这样：
//   #proc <NAME>() -> <REPR> {
//     #return <VALUE>
//   }
// 三段固定文本 + 从源码原样搬过来的名字 + 类型实参 + 十进制数字。
data meta_p1 ro { 35 112 114 111 99 32 }
data meta_p2a ro { 40 41 32 45 62 32 }
data meta_p2b ro { 32 123 10 32 32 35 114 101 116 117 114 110 32 }
data meta_p3 ro { 10 125 10 }

// 带算子的形式：
//   #proc <NAME>() -> <REPR> {
//     %r = #<PHYS>[<REPR>](<LHS>, <RHS>)
//     #return %r
//   }
data meta_o1 ro { 32 123 10 32 32 37 114 32 61 32 35 }
data meta_o2 ro { 91 }
data meta_o3 ro { 93 40 }
data meta_o4 ro { 44 32 }
data meta_o5 ro { 41 10 32 32 35 114 101 116 117 114 110 32 37 114 10 }
data meta_o6 ro { 125 10 }

// 积类型：声明 `struct Rec { f: T ... }` 时，Meta 给每个字段发一个
// 「它的字节偏移」的过程，再发一个「总大小」的过程。
// 名字拼成 <Rec>__<field>_offset 和 <Rec>__size。
data meta_kw_struct ro { 115 116 114 117 99 116 }
data meta_dsep ro { 95 95 }
data meta_foff ro { 95 111 102 102 115 101 116 }
data meta_rsize ro { 95 95 115 105 122 101 }

// 一个字节的暂存：能力只接受 (地址, 长度)，所以单字节要有个落脚点。
data meta_scratch rw { 0 }

// 类型实参的词素。kind 决定用哪一组。
data meta_t_bits ro { 35 98 105 116 115 60 }
data meta_t_f ro { 35 102 60 }
data meta_t_vec ro { 35 118 101 99 60 }
data meta_t_addr ro { 35 97 100 100 114 }
data meta_t_gt ro { 62 }

// 把 repr 写成 LAINIR 的类型实参：0 -> #bits<N>，1 -> #f<N>，
// 2 -> #vec<N>，3 -> #addr（#addr 没有宽度可言）。
#proc meta_emit_repr(%host: #addr, %kind: #bits<64>,
                     %width: #bits<64>) -> #bits<32> {
  #if #eq[#bits<64>](%kind, 3) {
    %p = #data_addr meta_t_addr
    %w = #call lain_meta_emit_write(%host, %p, 5)
    #return %w
  }
  #if #eq[#bits<64>](%kind, 1) {
    %p = #data_addr meta_t_f
    %a = #call lain_meta_emit_write(%host, %p, 3)
    %b = #call meta_emit_uint(%host, %width)
    %g = #data_addr meta_t_gt
    %c = #call lain_meta_emit_write(%host, %g, 1)
    #return %c
  }
  #if #eq[#bits<64>](%kind, 2) {
    %p = #data_addr meta_t_vec
    %a = #call lain_meta_emit_write(%host, %p, 5)
    %b = #call meta_emit_uint(%host, %width)
    %g = #data_addr meta_t_gt
    %c = #call lain_meta_emit_write(%host, %g, 1)
    #return %c
  }
  %bits = #data_addr meta_t_bits
  %w1 = #call lain_meta_emit_write(%host, %bits, 6)
  %w2 = #call meta_emit_uint(%host, %width)
  %gt = #data_addr meta_t_gt
  %w3 = #call lain_meta_emit_write(%host, %gt, 1)
  #return %w3
}

// 写一个字节出去。
#proc meta_emit_byte(%host: #addr, %b: #bits<8>) -> #bits<32> {
  %p = #data_addr meta_scratch
  #store[#bits<8>](%b, %p)
  %r = #call lain_meta_emit_write(%host, %p, 1)
  #return %r
}

// 写一个十进制无符号整数。高位先出，所以先递归再落位。
#proc meta_emit_uint(%host: #addr, %v: #bits<64>) -> #bits<32> {
  %big = #uge[#bits<64>](%v, 10)
  %status = #if %big -> (#bits<32>) {
    %q = #udiv[#bits<64>](%v, 10)
    %skip = #call meta_emit_uint(%host, %q)
    %rem = #urem[#bits<64>](%v, 10)
    %ch = #add[#bits<64>](%rem, 48)
    %b = #trunc[#bits<8>](%ch)
    %w = #call meta_emit_byte(%host, %b)
    #yield %w
  } else {
    %ch = #add[#bits<64>](%v, 48)
    %b = #trunc[#bits<8>](%ch)
    %w = #call meta_emit_byte(%host, %b)
    #yield %w
  }
  #return %status
}
