// demo: compile-time config + struct + method + if/else
// Top-level constants evaluated via unified let path
let WIDTH = 640;
let HEIGHT = 480;
let DEFAULT_FRAME_ID = 1;

// A simple struct with field access
struct Frame {
    id: i32,
    width: i32,
    height: i32,
}

fn make_default_frame() -> Frame {
    let f: Frame = Frame {
        id: DEFAULT_FRAME_ID,
        width: WIDTH,
        height: HEIGHT,
    };
    f
}

fn frame_area(f: Frame) -> i32 {
    f.width * f.height
}

fn main() -> i32 {
    let frame = make_default_frame();
    let area = frame_area(frame);
    
    if area > 0 {
        area
    } else {
        0
    }
}
