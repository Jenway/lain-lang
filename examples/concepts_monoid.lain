// Concept-based polymorphism: Monoid(T) + generic array fold + witness override + generic SoA setter
let io = import("std::io");

let Vec2 = struct { x: i64, y: i64 };
let Vec3 = struct { x: i64, y: i64, z: i64 };

// 1. Define Monoid(T) as a first-class Type factory (struct of function pointers)
let Monoid = func(T: Type) -> Type { return struct { zero: Fn(() -> T), combine: Fn((T, T) -> T) }; };

let i64_zero = func() -> i64 { return 0; };
let i64_add = func(a: i64, b: i64) -> i64 { return a + b; };
let i64_one = func() -> i64 { return 1; };
let i64_mul = func(a: i64, b: i64) -> i64 { return a * b; };

let vec2_zero = func() -> Vec2 { return Vec2 { x: 0, y: 0 }; };
let vec2_add = func(a: Vec2, b: Vec2) -> Vec2 { return Vec2 { x: a.x + b.x, y: a.y + b.y }; };

given Monoid(i64) { zero: i64_zero, combine: i64_add };
given Monoid(Vec2) { zero: vec2_zero, combine: vec2_add };

// 2. Generic fixed-array fold: deduces T, N and resolves Monoid(T) witness automatically
let fold_arr = func(arr: Ref(Array(T, N))) ?{ T: Type, N: u64, m: Monoid(T) } -> T {
  let acc: T = m.zero();
  comptime for i in 0..N {
    acc = m.combine(acc, deref(arr)[i]);
  }
  return acc;
};

// Generic 3-way combine (also tests sret struct return through witness)
let combine3 = func(a: T, b: T, c: T) ?{ T: Type, m: Monoid(T) } -> T {
  return m.combine(m.combine(a, b), c);
};

// 3. Generic SoA type constructor and generic field setter
let make_soa = func(T: Type, N: u64) -> Type {
  let b = record_begin();
  comptime for f in fields_of(T) {
    record_add(b, f.name, Array(f.type, N));
  }
  return record_end(b);
};

let Vec2SoA = make_soa(Vec2, 3);
let Vec3SoA = make_soa(Vec3, 3);

let soa_set = func(s: Mut(SoA), idx: u64, v: T) ?{ SoA: Type, T: Type } {
  comptime for f in fields_of(T) {
    deref(s).[:f.name][idx] = v.[:f.name];
  }
};

let main = func() -> i64 {
  let nums: Array(i64, 4) = [2, 3, 4, 5];
  let sum_n: i64 = fold_arr(ref_of(nums)); // 2+3+4+5 = 14

  // Override witness explicitly with multiplicative monoid
  let prod_i64 = Monoid(i64) { zero: i64_one, combine: i64_mul };
  let prod_n: i64 = fold_arr(ref_of(nums)) ?{ m: prod_i64 }; // 2*3*4*5 = 120

  let vsum: Vec2 = combine3(Vec2 { x: 10, y: 1 }, Vec2 { x: 20, y: 2 }, Vec2 { x: 0, y: 0 }); // { 30, 3 }

  let s2: Vec2SoA = Vec2SoA { x: [0, 0, 0], y: [0, 0, 0] };
  let s3: Vec3SoA = Vec3SoA { x: [0, 0, 0], y: [0, 0, 0], z: [0, 0, 0] };
  soa_set(mut_of(s2), 1, vsum);
  soa_set(mut_of(s3), 2, Vec3 { x: 7, y: 8, z: 9 });

  // 14 + 120 + (30 + 3) + (7 + 8 + 9) = 191
  let total: i64 = sum_n + prod_n + s2.x[1] + s2.y[1] + s3.x[2] + s3.y[2] + s3.z[2];
  io.print("sum_n=");
  io.println_i64(sum_n);
  io.print("prod_n=");
  io.println_i64(prod_n);
  io.print("vsum=");
  io.println_i64(s2.x[1] + s2.y[1]);
  io.print("s3=");
  io.println_i64(s3.x[2] + s3.y[2] + s3.z[2]);
  io.print("total=");
  io.println_i64(total);
  return total;
};
