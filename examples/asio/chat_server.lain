// examples/asio/chat_server.lain
// Simple multi-client chat server — self-contained, no std imports.
//
// Single-threaded accept + poll loop. Up to 32 concurrent clients.
// Each received message is broadcast to all OTHER connected clients.
//
// NOTE: The current parser cannot handle array literal init ([0; N])
// anywhere (struct fields, local variables). We work around this by
// using heap allocation + memset for all array data.

// ═══════════════════════════════════════════════════════════════
// pthread FFI
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "pthread_mutex_init")
fn pthread_mutex_init(mutex: *mut u8, attr: *mut u8) -> i32;
@foreign(c, link_name = "pthread_mutex_lock")
fn pthread_mutex_lock(mutex: *mut u8) -> i32;
@foreign(c, link_name = "pthread_mutex_unlock")
fn pthread_mutex_unlock(mutex: *mut u8) -> i32;

// ═══════════════════════════════════════════════════════════════
// Intrinsics
// ═══════════════════════════════════════════════════════════════

@compiler_intrinsic(size_of)
fn size_of<T>() -> usize;
@compiler_intrinsic(ptr_cast)
fn ptr_cast<T, U>(ptr: *mut T) -> *mut U;
@compiler_intrinsic(usize_to_i32)
fn usize_to_i32(v: usize) -> i32;
@compiler_intrinsic(i32_to_usize)
fn i32_to_usize(v: i32) -> usize;
@compiler_intrinsic(slice_len)
fn slice_len<T>(s: &[T]) -> usize;

// ═══════════════════════════════════════════════════════════════
// TCP — raw C wrappers
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "lain_tcp_socket")
fn tcp_socket(af: i32, kind: i32, protocol: i32) -> usize;
@foreign(c, link_name = "lain_tcp_bind")
fn tcp_bind(socket: usize, addr: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_listen")
fn tcp_listen(socket: usize, backlog: i32) -> i32;
@foreign(c, link_name = "lain_tcp_accept")
fn tcp_accept(socket: usize) -> usize;
@foreign(c, link_name = "lain_tcp_recv")
fn tcp_recv(socket: usize, buf: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_send")
fn tcp_send(socket: usize, buf: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_close")
fn tcp_close(socket: usize) -> ();
@foreign(c, link_name = "lain_tcp_htons")
fn tcp_htons(host_short: u16) -> u16;

// ═══════════════════════════════════════════════════════════════
// C stdlib
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "malloc")
fn malloc(size: usize) -> *mut u8;
@foreign(c, link_name = "memset")
fn memset(ptr: *mut u8, val: i32, len: usize) -> *mut u8;
@foreign(c, link_name = "free")
fn free(ptr: *mut u8) -> ();
@foreign(c, link_name = "puts")
fn puts(s: *const u8) -> i32;
@foreign(c, link_name = "printf")
fn printf(fmt: *const u8, v: i32) -> i32;

// ═══════════════════════════════════════════════════════════════
// Mutex — heap-allocated pthread_mutex_t, stored by *mut u8
// ═══════════════════════════════════════════════════════════════

struct Mutex {
    raw: *mut u8,   // → 40 bytes of heap memory
}

fn mutex_new() -> Mutex {
    let raw = malloc(40);
    memset(raw, 0, 40);
    pthread_mutex_init(raw, null<*mut u8>);
    Mutex { raw: raw }
}

fn mutex_lock(m: &Mutex) -> () {
    pthread_mutex_lock(m.raw);
}

fn mutex_unlock(m: &Mutex) -> () {
    pthread_mutex_unlock(m.raw);
}

// ═══════════════════════════════════════════════════════════════
// ChatRoom — shared fd table
// ═══════════════════════════════════════════════════════════════

struct ChatRoom {
    fds: *mut usize,   // → heap [usize; 32]
    count: usize,
    lock: Mutex,
}

fn chat_room_new() -> ChatRoom {
    let raw = malloc(256);  // 32 * 8 = 256 bytes
    memset(raw, 0, 256);
    ChatRoom {
        fds: ptr_cast::<u8, usize>(raw),
        count: 0,
        lock: mutex_new(),
    }
}

fn chat_room_add(room: &ChatRoom, fd: usize) -> bool {
    mutex_lock(&room.lock);
    let ok = if room.count < 32 {
        room.fds[room.count] = fd;
        room.count = room.count + 1;
        true
    } else {
        false
    };
    mutex_unlock(&room.lock);
    ok
}

fn chat_room_remove(room: &ChatRoom, fd: usize) -> () {
    mutex_lock(&room.lock);
    let mut i: usize = 0;
    while i < room.count {
        if room.fds[i] == fd {
            let mut j: usize = i;
            while j + 1 < room.count {
                room.fds[j] = room.fds[j + 1];
                j = j + 1;
            };
            room.count = room.count - 1;
            i = room.count;
        } else {};
        i = i + 1;
    };
    mutex_unlock(&room.lock);
}

fn chat_room_broadcast(room: &ChatRoom, sender: usize, msg: *mut u8, len: i32) -> () {
    mutex_lock(&room.lock);
    let mut i: usize = 0;
    while i < room.count {
        let fd = room.fds[i];
        if fd != sender {
            tcp_send(fd, msg, len);
        } else {};
        i = i + 1;
    };
    mutex_unlock(&room.lock);
}

// ═══════════════════════════════════════════════════════════════
// SockAddrIn builder (heap to avoid array-literal init bug)
// ═══════════════════════════════════════════════════════════════

/// Build a sockaddr_in for 0.0.0.0:port. Returns a *mut u8
/// pointing to a 16-byte heap block.
fn build_addr(port: u16) -> *mut u8 {
    let raw = malloc(16);
    memset(raw, 0, 16);
    // family = AF_INET (2) at offset 0 (u16, little-endian)
    raw[0] = 2;
    raw[1] = 0;
    // port at offset 2 (u16, big-endian via htons)
    let p = tcp_htons(port);
    let hi: u8 = i32_to_usize(p / 256);
    let lo: u8 = i32_to_usize(p % 256);
    raw[2] = lo;
    raw[3] = hi;
    // addr at offset 4 (u32, INADDR_ANY = 0)
    // zero at offset 8 (8 bytes, already zero from memset)
    raw
}

// ═══════════════════════════════════════════════════════════════
// main
// ═══════════════════════════════════════════════════════════════

fn main() -> i32 {
    puts("=== Lain Chat Server ===\n");

    // Bind
    let server = tcp_socket(2, 1, 6);
    let addr = build_addr(8080);
    tcp_bind(server, addr, 16);
    tcp_listen(server, 16);
    puts("Listening on :8080 ...\n");

    let room = chat_room_new();
    let buf = malloc(4096);   // recv buffer

    let running: bool = true;
    while running {
        // Accept
        let client = tcp_accept(server);
        if client != 0 {
            let ok = chat_room_add(&room, client);
            if ok {
                printf("+ client (fd=%d)\n", usize_to_i32(client));
            } else {
                puts("x room full\n");
                tcp_close(client);
            };
        } else {};

        // Poll all clients
        mutex_lock(&room.lock);
        let mut i: usize = 0;
        while i < room.count {
            let fd = room.fds[i];
            memset(buf, 0, 4096);
            let n = tcp_recv(fd, buf, 4096);
            if n > 0 {
                mutex_unlock(&room.lock);
                chat_room_broadcast(&room, fd, buf, n);
                mutex_lock(&room.lock);
                i = 0;  // restart scan
            } else {
                if n == 0 {
                    printf("- client left (fd=%d)\n", usize_to_i32(fd));
                    tcp_close(fd);
                    let mut j: usize = i;
                    while j + 1 < room.count {
                        room.fds[j] = room.fds[j + 1];
                        j = j + 1;
                    };
                    room.count = room.count - 1;
                } else {};
                i = i + 1;
            };
        };
        mutex_unlock(&room.lock);
    };

    tcp_close(server);
    0
}
