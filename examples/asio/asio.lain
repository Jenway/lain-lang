// examples/asio/asio.lain
// Asio-like async I/O library for Lain — self-contained, no std imports.
//
// Provides: Mutex, Sender/Receiver (channel via DynArray), and
// thin async wrappers over TCP primitives.

// ═══════════════════════════════════════════════════════════════
// pthread FFI
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "pthread_mutex_init")
fn pthread_mutex_init(mutex: *mut u8, attr: *mut u8) -> i32;

@foreign(c, link_name = "pthread_mutex_lock")
fn pthread_mutex_lock(mutex: *mut u8) -> i32;

@foreign(c, link_name = "pthread_mutex_unlock")
fn pthread_mutex_unlock(mutex: *mut u8) -> i32;

// ═══════════════════════════════════════════════════════════════
// size_of — minimal compiler intrinsic
// ═══════════════════════════════════════════════════════════════

@compiler_intrinsic(size_of)
pub fn size_of<T>() -> usize;

// ═══════════════════════════════════════════════════════════════
// ptr_cast — reinterpret pointer type
// ═══════════════════════════════════════════════════════════════

@compiler_intrinsic(ptr_cast)
pub fn ptr_cast<T, U>(ptr: *mut T) -> *mut U;

// ═══════════════════════════════════════════════════════════════
// Mutex — thread-safe wrapper using pthread_mutex
// ═══════════════════════════════════════════════════════════════
//
// pthread_mutex_t on Linux x86_64 is 40 bytes.
// Zero-initialization (Lain default) equals PTHREAD_MUTEX_INITIALIZER.

pub struct Mutex {
    mtx: [u8; 40],
}

pub impl Mutex {
    pub fn new() -> Mutex {
        let m = Mutex { mtx: [0; 40] };
        pthread_mutex_init(ptr_cast::<Mutex, u8>(&m), null<*mut u8>);
        m
    }

    pub fn lock(self: &Mutex) -> () {
        pthread_mutex_lock(ptr_cast::<Mutex, u8>(self));
    }

    pub fn unlock(self: &Mutex) -> () {
        pthread_mutex_unlock(ptr_cast::<Mutex, u8>(self));
    }
}

// ═══════════════════════════════════════════════════════════════
// SpinLock — lightweight atomic spinlock via pthread (fallback)
// ═══════════════════════════════════════════════════════════════
//
// For when you don't want the overhead of a full mutex.

pub struct SpinLock {
    mtx: [u8; 40],
}

pub impl SpinLock {
    pub fn new() -> SpinLock {
        let s = SpinLock { mtx: [0; 40] };
        pthread_mutex_init(ptr_cast::<SpinLock, u8>(&s), null<*mut u8>);
        s
    }

    pub fn lock(self: &SpinLock) -> () {
        pthread_mutex_lock(ptr_cast::<SpinLock, u8>(self));
    }

    pub fn unlock(self: &SpinLock) -> () {
        pthread_mutex_unlock(ptr_cast::<SpinLock, u8>(self));
    }
}

// ═══════════════════════════════════════════════════════════════
// DynArray — minimal growable array (subset of std::dynarray)
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "malloc")
fn malloc(size: usize) -> *mut u8;

@foreign(c, link_name = "realloc")
fn realloc(ptr: *mut u8, size: usize) -> *mut u8;

@foreign(c, link_name = "free")
fn free(ptr: *mut u8) -> ();

pub struct DynArray<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

pub impl<T> DynArray<T> {
    pub fn new() -> DynArray<T> {
        DynArray { ptr: null<*mut T>, len: 0, cap: 0 }
    }

    pub fn push(self: &mut DynArray<T>, val: T) -> () ! {RawPtrWrite} {
        if self.len == self.cap {
            let four: usize = 4;
            let new_cap = if self.cap == 0 { four } else { self.cap * 2 };
            let bytes = new_cap * size_of::<T>();
            let raw = if self.cap == 0 {
                malloc(bytes)
            } else {
                realloc(ptr_cast::<T, u8>(self.ptr), bytes)
            };
            self.ptr = ptr_cast::<u8, T>(raw);
            self.cap = new_cap;
        };
        self.ptr[self.len] = val;
        self.len = self.len + 1;
    }

    pub fn pop(self: &mut DynArray<T>) -> T ! {RawPtrRead} {
        self.len = self.len - 1;
        self.ptr[self.len]
    }

    pub fn get(self: &DynArray<T>, i: usize) -> *mut T {
        if i >= self.len {
            null<*mut T>
        } else {
            &mut self.ptr[i]
        }
    }

    pub fn len(self: &DynArray<T>) -> usize {
        self.len
    }

    pub fn shrink_to_fit(self: &mut DynArray<T>) -> () {
        if self.cap > self.len {
            let bytes = self.len * size_of::<T>();
            let raw = realloc(ptr_cast::<T, u8>(self.ptr), bytes);
            self.ptr = ptr_cast::<u8, T>(raw);
            self.cap = self.len;
        };
    }
}

// ═══════════════════════════════════════════════════════════════
// Channel — MPSC queue backed by Mutex<DynArray<T>>
// ═══════════════════════════════════════════════════════════════

pub struct Sender<T> {
    queue: *mut Mutex,
    array: *mut DynArray<T>,
}

pub struct Receiver<T> {
    queue: *mut Mutex,
    array: *mut DynArray<T>,
}

pub fn channel<T>() -> (Sender<T>, Receiver<T>) {
    // Allocate shared state on the heap so Sender and Receiver
    // can both hold pointers to it.
    let q = malloc(size_of::<Mutex>()) as *mut Mutex;
    let arr = malloc(size_of::<DynArray<T>>()) as *mut DynArray<T>;

    // Zero-init then initialize
    q[0] = Mutex::new();
    arr[0] = DynArray::new::<T>();

    let tx = Sender::<T> { queue: q, array: arr };
    let rx = Receiver::<T> { queue: q, array: arr };
    (tx, rx)
}

pub impl<T> Sender<T> {
    pub fn send(self: &Sender<T>, val: T) -> () ! {RawPtrWrite} {
        let mtx = self.queue;
        mtx[0].lock();
        self.array[0].push(val);
        mtx[0].unlock();
    }
}

pub impl<T> Receiver<T> {
    pub fn try_recv(self: &Receiver<T>) -> T ! {RawPtrRead, RawPtrWrite} {
        let mtx = self.queue;
        mtx[0].lock();
        let arr = self.array;
        let result = if arr[0].len() > 0 {
            arr[0].pop()
        } else {
            // Return a dummy; caller checks len first
            arr[0].ptr[0]
        };
        mtx[0].unlock();
        result
    }

    pub fn len(self: &Receiver<T>) -> usize {
        let mtx = self.queue;
        mtx[0].lock();
        let n = self.array[0].len();
        mtx[0].unlock();
        n
    }
}

// ═══════════════════════════════════════════════════════════════
// TCP primitives (thin wrappers; re-export for convenience)
// ═══════════════════════════════════════════════════════════════
//
// These mirror std::net::tcp but are declared here so asio
// has no external dependencies.

@foreign(c, link_name = "lain_tcp_socket")
fn tcp_socket(af: i32, kind: i32, protocol: i32) -> usize;
@foreign(c, link_name = "lain_tcp_bind")
fn tcp_bind(socket: usize, addr: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_listen")
fn tcp_listen(socket: usize, backlog: i32) -> i32;
@foreign(c, link_name = "lain_tcp_accept")
fn tcp_accept(socket: usize) -> usize;
@foreign(c, link_name = "lain_tcp_recv")
fn tcp_recv(socket: usize, buf: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_send")
fn tcp_send(socket: usize, buf: *mut u8, len: i32) -> i32;
@foreign(c, link_name = "lain_tcp_close")
fn tcp_close(socket: usize) -> ();
@foreign(c, link_name = "lain_tcp_htons")
fn tcp_htons(host_short: u16) -> u16;

// ── SockAddrIn ──

#[repr(C)]
pub struct SockAddrIn {
    family: u16,
    port: u16,
    addr: u32,
    zero: [u8; 8],
}

// ── TcpListener ──

pub struct TcpListener {
    fd: usize,
}

pub struct TcpStream {
    fd: usize,
}

pub impl TcpListener {
    pub fn bind(port: u16) -> TcpListener {
        let server = tcp_socket(2, 1, 6);          // AF_INET, SOCK_STREAM, IPPROTO_TCP
        let addr = SockAddrIn {
            family: 2,                              // AF_INET
            port: tcp_htons(port),
            addr: 0,                                // INADDR_ANY
            zero: [0; 8],
        };
        tcp_bind(server, ptr_cast::<SockAddrIn, u8>(&addr), 16);
        tcp_listen(server, 16);
        TcpListener { fd: server }
    }

    pub fn accept(self: &TcpListener) -> TcpStream {
        let fd = tcp_accept(self.fd);
        TcpStream { fd: fd }
    }

    pub fn close(self: TcpListener) -> () {
        tcp_close(self.fd);
    }
}

pub impl TcpStream {
    pub fn recv(self: &TcpStream, buf: *mut u8, len: i32) -> i32 {
        tcp_recv(self.fd, buf, len)
    }

    pub fn send(self: &TcpStream, buf: *mut u8, len: i32) -> i32 {
        tcp_send(self.fd, buf, len)
    }

    pub fn close(self: TcpStream) -> () {
        tcp_close(self.fd);
    }

    pub fn fd(self: &TcpStream) -> usize {
        self.fd
    }
}

// ═══════════════════════════════════════════════════════════════
// I/O helpers
// ═══════════════════════════════════════════════════════════════

@foreign(c, link_name = "puts")
fn puts(s: *const u8) -> i32;

@foreign(c, link_name = "printf")
fn printf(fmt: *const u8, v: i32) -> i32;

pub fn println(msg: &[u8]) -> () {
    puts(ptr_cast::<u8, u8>(&msg[0]));
    0;
}

pub fn print_i32(msg: &[u8], v: i32) -> () {
    printf(ptr_cast::<u8, u8>(&msg[0]), v);
    0;
}

// ═══════════════════════════════════════════════════════════════
// usize ↔ i32 helpers
// ═══════════════════════════════════════════════════════════════

@compiler_intrinsic(usize_to_i32)
pub fn usize_to_i32(value: usize) -> i32;

@compiler_intrinsic(i32_to_usize)
pub fn i32_to_usize(value: i32) -> usize;
