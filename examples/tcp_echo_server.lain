import std::effects::executor;
import std::net::tcp;

fn handle_conn(stream: TcpStream) -> () ! {IO, Suspend, Throws<NetError>} {
    defer stream.close();

    let mut buffer: [u8; 4096] = [0; 4096];
    let mut running = true;
    let zero: usize = 0;

    while running {
        let received = stream.read(&mut buffer)?;
        if received > zero {
            stream.write(buffer[..received])?;
            0;
        } else {
            running = false;
        };
    };
}

fn handle_conn_task(fd: usize) -> () ! {IO, Suspend} {
    let stream = TcpStream::from_raw_fd(fd);
    handle {
        handle_conn(stream);
    } with Throws::to_log_and_abort()
}

fn accept_loop(listener: &TcpListener) -> () ! {IO, Suspend, Spawn, Throws<NetError>} {
    loop {
        let client = listener.accept()?;
        perform Spawn::spawn_with(handle_conn_task, client.raw_fd());
    }
}

fn serve() -> () ! {IO, Suspend, Spawn, Throws<NetError>} {
    let listener = TcpListener::bind(8080)?;
    accept_loop(&listener);
}

fn main() -> () ! {IO} {
    let executor = thread_executor();
    handle
        handle {
            serve();
        } with Throws::to_log_and_abort()
    with executor
}
