import std::c;
import std::net::tcp;

fn echo_client(client: usize) -> i32 ! {IO} {
    let mut buffer: [u8; 1024] = [0; 1024];
    let mut running = true;
    let mut result = 0;

    while running {
        let received = tcp_recv(client, &mut buffer[0], 1024);
        if received > 0 {
            tcp_send(client, &buffer[0], received);
            0;
        } else {
            running = false;
        };
    };

    result
}

fn main() -> i32 ! {IO} {
    let server = tcp_listen_any(7000);
    if server == 0 {
        print_line("tcp echo server failed to listen on port 7000");
        1
    } else {
        print_line("tcp echo server listening on port 7000");
        loop {
            let client = tcp_accept(server);
            if client == 0 {
                0;
            } else {
                echo_client(client);
                tcp_close(client);
            };
        };
        tcp_close(server);
        tcp_shutdown();
        0
    }
}
