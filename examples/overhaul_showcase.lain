let io = import("std::io");
let col = import("std::collections");
let bld = import("std::build");

let Jobs = col.Vec(u64);
let Cache = col.HashMapU64(u64);

use Jobs;
use Cache;
use bld;

let score_step = func(x: u64) -> u64 {
  return (x * 7) + 3;
};

let mix_budget = func(n: u64) -> u64 {
  let total: u64 = loop c(i: u64 = 1, acc: u64 = 0) while i <= n {
    acc = acc + score_step(i);
    i = i + 1;
  };
  return total;
};

let BuildState = enum {
  CacheHit
  Rebuilt
  Failed
};

let BuildFault = effect {
  op abort_step(code: u64) -> Never;
};

let run_unit = func(prev_iface: u64, next_iface: u64, fail_flag: u64) -> u64 !{ BuildFault } {
  if fail_flag != 0 {
    perform BuildFault.abort_step(42);
  }
  if bld.interface_unchanged(prev_iface, next_iface) == 1 {
    return 1;
  }
  return 2;
};

let classify_code = func(prev_iface: u64, next_iface: u64, fail_flag: u64) -> u64 {
  return handle run_unit(prev_iface, next_iface, fail_flag) with {
    return(v) => v,
    abort_step(c) => 3,
  };
};

let state_label = func(code: u64) -> Slice(u8) {
  let st: BuildState = if code == 1 {
    BuildState.CacheHit { }
  } else {
    if code == 2 { BuildState.Rebuilt { } } else { BuildState.Failed { } }
  };
  return match st {
    CacheHit => "HIT (skip downstream)",
    Rebuilt  => "REBUILD (iface changed)",
    Failed   => "RECOVERED (via effect)",
  };
};

let print_unit = func(label: Slice(u8), st_text: Slice(u8)) -> u64 {
  return io.println(f"  unit[{label}] : {st_text}");
};

let print_kv = func(label: Slice(u8), val: u64) -> u64 {
  return io.println(f"{label}{val}");
};

let print_banner = func(budget: u64, steps: u64, edges: u64, hit_val: u64) -> u64 {
  io.println("=== Lain Overhaul Showcase ===");
  let s1: u64 = print_kv("[comptime] Lain-VM eval budget   = ", budget);
  let s2: u64 = print_kv("[std::build] graph nodes         = ", steps);
  let s3: u64 = print_kv("[std::build] graph edges         = ", edges);
  let s4: u64 = print_kv("[collections] HashMap hit value  = ", hit_val);
  return s1 + s2 + s3 + s4;
};

let main = func() -> i64 {
  let budget: u64 = mix_budget(5);

  let os_w: bld.Os = bld.Os.Windows { };
  let arch_x: bld.Arch = bld.Arch.X86_64 { };
  let opt_r: bld.OptMode = bld.OptMode.ReleaseFast { };
  let env: bld.TargetEnv = bld.TargetEnv {
    os: ref_of(os_w),
    arch: ref_of(arch_x),
    opt: ref_of(opt_r),
  };
  let s_iface1: Slice(u8) = "pub let rt_init = func() -> u64;";
  let s_iface2: Slice(u8) = "pub let rt_init = func() -> u64;";
  let s_iface3: Slice(u8) = "pub let rt_init = func(cap: u64) -> u64;";
  let s_src1: Slice(u8) = "host_rt_body_v1";
  let s_src2: Slice(u8) = "entry_body_v1";
  let s_nlib: Slice(u8) = "core_rt";
  let s_rlib: Slice(u8) = "src/host_rt.lain";
  let s_napp: Slice(u8) = "lainc";
  let s_rapp: Slice(u8) = "src/entry.lain";

  let iface_v1: u64 = bld.fnv1a_bytes(s_iface1);
  let iface_v2: u64 = bld.fnv1a_bytes(s_iface2);
  let iface_v3: u64 = bld.fnv1a_bytes(s_iface3);
  let src_lib: u64 = bld.fnv1a_bytes(s_src1);
  let src_app: u64 = bld.fnv1a_bytes(s_src2);

  let k_lib: u64 = bld.hash_pair(s_src1, s_iface1);

  let g: bld.Graph = bld.new_graph(env);
  let lib_id: u64 = g.add_static_lib(s_nlib, s_rlib, s_src1, s_iface1);
  let app_id: u64 = g.add_executable(s_napp, s_rapp, s_src2, s_iface3);
  let linked: u64 = g.link(app_id, lib_id);

  let q: Jobs.Self = Jobs.new();
  let cache: Cache.Self = Cache.new();
  let p1: bool = q.push(lib_id);
  let p2: bool = q.push(app_id);
  let c1: bool = cache.put(k_lib, budget);

  let got: u64 = 0;
  let found: bool = cache.get(k_lib, mut_of(got));
  let found_n: u64 = if found { 1 } else { 0 };

  let steps: u64 = g.step_count();
  let edges: u64 = g.edge_count();
  let b_res: u64 = print_banner(budget, steps, edges, got);

  let c_hit: u64 = classify_code(iface_v1, iface_v2, 0);
  let c_reb: u64 = classify_code(iface_v1, iface_v3, 0);
  let c_err: u64 = classify_code(iface_v1, iface_v1, 1);

  let l1: Slice(u8) = state_label(c_hit);
  let l2: Slice(u8) = state_label(c_reb);
  let l3: Slice(u8) = state_label(c_err);
  let u1: u64 = print_unit("core_rt  ", l1);
  let u2: u64 = print_unit("lainc    ", l2);
  let u3: u64 = print_unit("fault_sim", l3);

  return ((got + steps + edges + found_n + linked) as i64);
};
