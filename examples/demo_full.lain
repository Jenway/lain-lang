// demo: top-level constants + struct + if/else + effect
let SCREEN_W = 800;
let SCREEN_H = 600;

struct Frame { id: i32, w: i32, h: i32 }

fn make_frame(id: i32) -> Frame {
    Frame { id: id, w: SCREEN_W, h: SCREEN_H }
}

fn area(f: Frame) -> i32 {
    f.w * f.h
}

fn is_large(f: Frame) -> bool {
    area(f) > 100000
}

fn main() -> i32 {
    let f = make_frame(1);
    if is_large(f) {
        area(f)
    } else {
        0
    }
}
