import std::effects::throws;
import std::result;

fn parse(flag: bool, error: CStr) -> i32 ! {Throws<CStr>} {
    if flag {
        40
    } else {
        Throws::throw(error)
    }
}

fn lift(result: Result<i32, CStr>) -> i32 ! {Throws<CStr>} {
    result?
}

fn parse_result(flag: bool) -> Result<i32, CStr> {
    handle {
        parse(flag, "parse error") + 2
    } with Throws::to_result()
}

fn main() -> i32 {
    let ok = match parse_result(true) {
        Result::Ok(value) => value,
        Result::Err(error) => 0,
    };

    let err = match parse_result(false) {
        Result::Ok(value) => 0,
        Result::Err(error) => 1,
    };

    let lifted: Result<i32, CStr> = handle {
        lift(Result::Ok(41)) + 1
    } with Throws::to_result();

    match lifted {
        Result::Ok(value) => if ok == 42 { if err == 1 { value } else { 0 } } else { 0 },
        Result::Err(error) => 0,
    }
}
