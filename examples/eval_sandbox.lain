let io = import("std::io");

let fib = func(n: i64) -> i64 {
  return if n < 2 { n } else { fib(n - 1) + fib(n - 2) };
};

let sum_squares = func(limit: i64) -> i64 {
  let s: i64 = loop sum(i: i64 = 1, acc: i64 = 0) while i <= limit {
    acc = acc + (i * i);
    i = i + 1;
  };
  return s;
};

let main = func() -> i64 {

  let f10: i64 = eval(fib(10));
  let sq5: i64 = eval(sum_squares(5));

  io.print("fib(10)=");
  io.println_i64(f10);
  io.print("sum_squares(5)=");
  io.println_i64(sq5);
  io.print("total=");
  io.println_i64(f10 + sq5);

  return f10 + sq5;
};
