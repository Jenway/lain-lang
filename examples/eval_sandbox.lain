// Compile-time sandboxed evaluation (`eval`) with zero runtime overhead
func fib(n: i64) -> i64 {
  return if n < 2 { n } else { fib(n - 1) + fib(n - 2) };
}

func sum_squares(limit: i64) -> i64 {
  let s: i64 = loop sum(i: i64 = 1, acc: i64 = 0) while i <= limit {
    acc = acc + (i * i);
    i = i + 1;
  };
  return s;
}

func main() -> i64 {
  // Both expressions execute inside the isolated LAINIR sandbox at compile time
  // and fold into immediate integer constants in the generated IR.
  let f10: i64 = eval(fib(10));       // 55
  let sq5: i64 = eval(sum_squares(5)); // 1 + 4 + 9 + 16 + 25 = 55
  return f10 + sq5;                    // 110
}
