struct Counter {
    value: i32,
}

@interface(Counter)
@interface_impl(counter)
struct CounterOps {
    add: fn(Counter, i32) -> i32,
    value: fn(Counter) -> i32,
}

fn counter_add(counter: Counter, amount: i32) -> i32 {
    counter.value + amount
}

fn counter_value(counter: Counter) -> i32 {
    counter.value
}

fn add_through_vtable(counter: Counter::Dyn, amount: i32) -> i32 {
    Counter::add(counter, amount)
}

fn main() -> i32 {
    let counter = Counter { value: 20 };
    let dynamic = Counter::make_dyn(counter, Counter::make_vtable());
    add_through_vtable(dynamic, 2) + Counter::value(dynamic)
}
