struct Counter {
    value: i32,
}

@interface(Counter)
@interface_impl(counter)
struct CounterOps {
    add: fn(Counter, i32) -> i32,
    get: fn(Counter) -> i32,
}

fn counter_add(counter: Counter, amount: i32) -> i32 {
    counter.value + amount
}

fn counter_get(counter: Counter) -> i32 {
    counter.value
}

fn call_add(counter: CounterInterface, amount: i32) -> i32 {
    CounterInterface_add(counter, amount)
}

fn main() -> i32 {
    let counter = Counter { value: 20 };
    let interface = make_CounterInterface(counter, make_CounterOps());
    call_add(interface, 2) + CounterInterface_get(interface)
}
