struct Point {
  x: i32
  y: i32
}

struct Line {
  a: Point
  b: Point
}

enum Shape {
  Circle(i32)
  Empty
}

// 聚合形参：地址由调用方给，投影读其中的载荷。
func area(s: Shape) -> i32 {
  return Shape.Circle(s);
}

func first(p: Point) -> i32 {
  return p.x;
}

// 返回聚合：地址原样交回调用方。
func idp(p: Point) -> Point {
  return p;
}

// 栈上构造两个 Point，整体复制一份再读字段：3 + 4 = 7。
func copy() -> i32 {
  let p: Point = Point { x: 3 y: 4 };
  let q: Point = p;
  return q.x + q.y;
}

// 构造 -> 返回聚合 -> 形参读字段：5。
func chain() -> i32 {
  let p: Point = Point { x: 5 y: 6 };
  let q: Point = idp(p);
  return first(q);
}

// 枚举构造 + 两次投影：9 + 9 = 18。
func project(k: i32) -> i32 {
  let s: Shape = Shape.Circle { k };
  return Shape.Circle(s) + area(s);
}

// Line 的字段本身是聚合：先取出 a 再读 x。
func span(l: Line) -> i32 {
  let p: Point = l.a;
  return p.x;
}
