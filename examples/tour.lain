struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn new(x: i32, y: i32) -> Point {
        Point { x: x, y: y }
    }

    fn sum(self: &Point) -> i32 {
        self.x + self.y
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

enum Score {
    Exact(i32),
    Miss(i32),
}

fn identity<T>(value: T) -> T {
    value
}

fn second(xs: &[i32]) -> i32 {
    xs[1]
}

fn loop_bonus(limit: i32) -> i32 {
    let mut i = 0;
    let mut sum = 0;

    while i < limit {
        i = i + 1;

        if i == 2 {
            continue;
        } else {
            sum = sum + i;
        };

        if i == 4 {
            break;
        } else {
            0;
        };
    };

    sum
}

fn score(value: i32) -> Score {
    if value == 42 {
        Score::Exact(value)
    } else {
        Score::Miss(0)
    }
}

fn main() -> i32 {
    let point = Point::new(20, 7);
    let pair: Pair<i32, CStr> = Pair {
        first: identity<i32>(4),
        second: "kept generic",
    };
    let numbers = [1, 3, 5];

    let total = point.sum() + pair.first + second(&numbers) + loop_bonus(4);

    match score(total) {
        Score::Exact(value) => value,
        Score::Miss(value) => value,
    }
}
