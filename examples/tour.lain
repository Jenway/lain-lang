struct Point { x: i32, y: i32 }

fn second(xs: &[i32]) -> i32 {
    xs[1]
}

fn first_byte(bytes: &[u8]) -> u8 {
    bytes[0]
}

fn half(x: f64) -> f64 {
    x / 2.0
}

fn small_less(a: u8, b: u8) -> bool {
    a < b
}

fn observe(x: &i32) -> i32 {
    1
}

fn loop_score() -> i32 {
    let mut i = 0;
    let mut sum = 0;

    while i < 6 {
        i = i + 1;

        if i == 4 {
            continue;
        } else {
            sum = sum + i;
        };

        if i == 5 {
            break;
        } else {
            0;
        };
    };

    sum
}

fn main() -> i32 {
    let mut point = Point { x: 5, y: 6 };
    point.x = point.x + 1;
    let numbers = [1, 7, 3];

    let from_struct = point.x + point.y;
    let from_slice = second(&numbers);
    let from_ref = observe(&from_slice);
    let from_loop = loop_score();
    let from_float = if half(84.0) == 42.0 { 4 } else { 0 };
    let from_ordering = if small_less(2, 4) { 5 } else { 0 };
    let from_string = if first_byte("*") == 42 { 2 } else { 0 };

    from_struct + from_slice + from_ref + from_loop + from_float + from_ordering + from_string
}
