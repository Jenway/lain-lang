struct Slot { v: u64 }

func peek(p: addr) -> u8 {
  let b: u8 = load(p);
  return b;
}

func poke(p: addr, v: u8) -> i32 {
  store(p, v);
  return 0;
}

func at(p: addr, i: u64) -> u8 {
  let b: u8 = load(p + i);
  return b;
}

func step(p: addr, i: u64) -> addr {
  let q: addr = lea(p, i);
  return q;
}

// 栈上缓冲：写字节再读字节。
func local_peek() -> u8 {
  let slot: Slot = Slot { v: 0 };
  let p: addr = ref_of(slot);
  store(p, 65);
  return peek(p);
}
