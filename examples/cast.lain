struct Slot { v: u64 }

func pack(p: addr) -> u64 {
  return p as u64;
}

func unpack(w: u64) -> addr {
  return w as addr;
}

func element(p: addr, i: u64) -> u64 {
  let q: addr = p + i * 8;
  let w: u64 = load(q);
  return w;
}

func byte_at(p: addr, i: u64) -> u8 {
  let b: u8 = load(p + i * 1);
  return b;
}

func round(p: addr) -> addr {
  return (p as u64) as addr;
}

func scaled(p: addr, i: u64) -> u64 {
  let q: addr = p + i * 8;
  store(q, 7);
  let r: addr = p + i * 8;
  return load(r);
}

// 栈上 8 字节缓冲（聚合局部在 IR 里就是 #alloca）：写机器字再整字读回。
func local_store() -> u64 {
  let slot: Slot = Slot { v: 0 };
  let q: addr = ref_of(slot);
  store(q, 7);
  return load(q);
}

// 只读低字节。
func local_byte() -> u8 {
  let slot: Slot = Slot { v: 0 };
  let q: addr = ref_of(slot);
  store(q, 42);
  let b: u8 = load(q);
  return b;
}

// 地址 -> 整数 -> 地址 的往返。
func local_round() -> u64 {
  let slot: Slot = Slot { v: 11 };
  let q: addr = ref_of(slot);
  let w: u64 = q as u64;
  let back: addr = w as addr;
  return load(back);
}
