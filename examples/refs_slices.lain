// First-class references, slices, tagged enums, and function pointers
enum Boxed {
  Int(i64)
  Empty
}

func map_slice(xs: Slice(i64), f: Fn((i64) -> i64)) -> i64 {
  let s: i64 = loop walk(i: u64 = 0, acc: i64 = 0) while i < len(xs) {
    acc = acc + f(xs[i]);
    i = i + 1;
  };
  return s;
}

func double_val(x: i64) -> i64 { return x * 2; }

func bump(p: Mut(i64), delta: i64) {
  deref(p) = deref(p) + delta;
}

func main() -> i64 {
  let arr: Array(i64, 4) = [1, 2, 3, 4];
  let doubled_sum: i64 = map_slice(slice_of(arr), double_val); // 20

  let v: i64 = 5;
  bump(mut_of(v), 7); // 12
  let b: Boxed = Boxed.Int { v * 3 };
  let unboxed: i64 = Boxed.Int(b); // 36

  return doubled_sum + unboxed; // 20 + 36 = 56
}
