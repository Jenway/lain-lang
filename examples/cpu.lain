fn popcount(x: u64) -> u64 { x.popcount() }
fn leading(x: u64) -> u64 { x.leading_zeros() }
fn swap(x: u32) -> u32 { x.bswap() }
fn rotate(x: u64, n: u64) -> u64 { x.rotate_left(n) }
fn extract(x: u64, mask: u64) -> u64 { x.extract_bits(mask) }
fn fma_ok(a: f32, b: f32, c: f32) -> f32 { @fma(a * b + c) }
fn likely(cond: bool) -> bool { @likely(cond) }
fn forever(n: i64, acc: i64) -> i64 {
    if n <= 1 { acc } else { @tail_call forever(n - 1, acc * n) }
}
fn main(x: u64, n: u64) -> u64 { popcount(x) + rotate(x, n) }
