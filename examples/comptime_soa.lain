// Compile-time type factories & layout introspection
let io = import("std::io");
let option = import("std::option");

let Vec3 = struct { x: i64, y: i64, z: i64 };

// 1. Structure-of-Arrays factory: SoA(T, N)
let make_soa = func(T: Type, N: u64) -> Type {
  let b = record_begin();
  comptime for f in fields_of(T) {
    record_add(b, f.name, Array(f.type, N));
  }
  return record_end(b);
};

// 2. Compile-time struct extension: prepends `tag: u64` to any struct T
let with_tag = func(T: Type) -> Type {
  let b = record_begin();
  record_add(b, "tag", u64);
  comptime for f in fields_of(T) {
    record_add(b, f.name, f.type);
  }
  return record_end(b);
};

// 3. Generic Option functor from std::option
let Vec3Opt = option.Option(Vec3);

let Vec3SoA = make_soa(Vec3, 4);
let TaggedVec3 = with_tag(Vec3);

let stamp_vec3 = func(dst: Mut(TaggedVec3), tag: u64, src: Vec3) {
  deref(dst).tag = tag;
  comptime for f in fields_of(Vec3) {
    deref(dst).[:f.name] = src.[:f.name];
  }
};

let main = func() -> i64 {
  let soa: Vec3SoA = Vec3SoA { x: [0, 0, 0, 0], y: [0, 0, 0, 0], z: [0, 0, 0, 0] };
  let v: Vec3 = Vec3 { x: 3, y: 4, z: 5 };
  comptime for f in fields_of(Vec3) {
    soa.[:f.name][2] = v.[:f.name];
  }
  let dot: i64 = (soa.x[2] * soa.x[2]) + (soa.y[2] * soa.y[2]) + (soa.z[2] * soa.z[2]); // 50

  let tv: TaggedVec3 = TaggedVec3 { tag: 0, x: 0, y: 0, z: 0 };
  stamp_vec3(mut_of(tv), 99, v); // 99 + 3 + 4 + 5 = 111

  // 单例缓存：同一份 Vec3 调用 Option 得到同一个模块与同一个 Opt 类型。
  let opt: Vec3Opt.Opt = Vec3Opt.some(v);
  let none: Vec3Opt.Opt = Vec3Opt.none();
  let opt_val: i64 = match opt {
    Some(x) => x.x + x.z,
    None => 0,
  }; // 8
  let none_sum: i64 = match none {
    Some(x) => x.x,
    None => 0,
  }; // 0
  let has_some: bool = Vec3Opt.is_some(opt);

  // 布局内省：SoA 4 元素与带 tag 扩展后的结构体大小
  let soa_size: u64 = size_of(Vec3SoA);
  let tagged_size: u64 = size_of(TaggedVec3);

  let tagged_sum: i64 = (tv.tag as i64) + tv.x + tv.y + tv.z;
  let some_flag: u64 = if has_some { 1 } else { 0 };
  let total: i64 = dot + tagged_sum + opt_val + none_sum
    + (soa_size as i64) + (tagged_size as i64);
  io.println(f"dot={dot}");
  io.println(f"tagged={tagged_sum}");
  io.println(f"opt={opt_val}");
  io.println(f"none={none_sum}");
  io.println(f"is_some={some_flag}");
  io.println(f"size_of(Vec3SoA)={soa_size}");
  io.println(f"size_of(TaggedVec3)={tagged_size}");
  io.println(f"total={total}");
  return total;
};
