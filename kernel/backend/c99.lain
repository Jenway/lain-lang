use import("std::option")::{ Option };
use import("kernel::ir::model")::{ Ty, Op, Inst, DataSeg, Proc, IrModule, MemAxiom };
let io = import("std::io");
let str = import("std::str");

let emit_u64 = func(v: u64) ?{ out: io::Sink } {
  if v == 0 {
    out::write("0");
    return;
  }
  let buf: Array(u8, 32) = [0; 32];
  let n: u64 = 0;
  let cur: u64 = v;
  while cur > 0 {
    buf[n] = (48 + (cur % 10)) as u8;
    n = n + 1;
    cur = cur / 10;
  };
  let rev: Array(u8, 32) = [0; 32];
  let i: u64 = 0;
  while i < n {
    rev[i] = buf[n - 1 - i];
    i = i + 1;
  };
  out::write(make_slice(Slice(u8), ptr_cast(Ref(u8), ptr_of(rev)), n));
};

let emit_val = func(id: u64) ?{ out: io::Sink } {
  out::write("v");
  emit_u64(id) ?{ out: out };
};

let emit_c_ty = func(t: Ty) ?{ out: io::Sink } {
  match t {
    Void => out::write("void"),
    Bits(_) => out::write("uint64_t"),
    Float(n) => if n == 32 { out::write("float"); } else { out::write("double"); },
    Vec(_) => out::write("uint64_t"),
    Addr => out::write("uint64_t"),
  };
};

let emit_preamble = func() ?{ out: io::Sink } {
  out::write("#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdio.h>\n\n");
  out::write("static int g_lain_argc = 0;\nstatic char **g_lain_argv = NULL;\n\n");
  out::write("static inline uint64_t lain_os_argc(void) { return (uint64_t)(g_lain_argc > 0 ? g_lain_argc : 0); }\n");
  out::write("static inline uint64_t lain_os_argv_len(uint64_t idx) { if (!g_lain_argv || idx >= (uint64_t)(g_lain_argc > 0 ? g_lain_argc : 0)) return 0; return (uint64_t)strlen(g_lain_argv[idx]); }\n");
  out::write("static inline uint64_t lain_os_argv_copy(uint64_t idx, uint64_t buf, uint64_t cap) { size_t n; if (!g_lain_argv || idx >= (uint64_t)(g_lain_argc > 0 ? g_lain_argc : 0)) return 0; n = strlen(g_lain_argv[idx]); if (n > (size_t)cap) n = (size_t)cap; if (n > 0 && buf) memcpy((void*)(uintptr_t)buf, g_lain_argv[idx], n); return (uint64_t)n; }\n");
  out::write("static inline uint64_t lain_os_eprint(uint64_t ptr, uint64_t len) { if (len > 0 && ptr) fwrite((const void*)(uintptr_t)ptr, 1, (size_t)len, stderr); return len; }\n");
  out::write("static inline uint64_t lain_ext_calloc(uint64_t n, uint64_t sz) { return (uint64_t)(uintptr_t)calloc((size_t)n, (size_t)sz); }\n");
  out::write("static inline uint64_t lain_ext_malloc(uint64_t n) { return (uint64_t)(uintptr_t)malloc((size_t)n); }\n");
  out::write("static inline void lain_ext_free(uint64_t p) { free((void*)(uintptr_t)p); }\n");
  out::write("static inline uint64_t lain_ext_memcpy(uint64_t d, uint64_t s, uint64_t n) { return (uint64_t)(uintptr_t)memcpy((void*)(uintptr_t)d, (const void*)(uintptr_t)s, (size_t)n); }\n");
  out::write("static inline uint64_t lain_ext_fopen(uint64_t p, uint64_t m) { return (uint64_t)(uintptr_t)fopen((const char*)(uintptr_t)p, (const char*)(uintptr_t)m); }\n");
  out::write("static inline uint64_t lain_ext_fclose(uint64_t f) { return (uint64_t)(int64_t)fclose((FILE*)(uintptr_t)f); }\n");
  out::write("static inline uint64_t lain_ext_fseek(uint64_t f, uint64_t o, uint64_t w) { return (uint64_t)(int64_t)fseek((FILE*)(uintptr_t)f, (long)(int64_t)o, (int)(int64_t)w); }\n");
  out::write("static inline uint64_t lain_ext_ftell(uint64_t f) { return (uint64_t)(int64_t)ftell((FILE*)(uintptr_t)f); }\n");
  out::write("static inline uint64_t lain_ext_fread(uint64_t b, uint64_t s, uint64_t n, uint64_t f) { return (uint64_t)fread((void*)(uintptr_t)b, (size_t)s, (size_t)n, (FILE*)(uintptr_t)f); }\n");
  out::write("static inline uint64_t lain_ext_fwrite(uint64_t b, uint64_t s, uint64_t n, uint64_t f) { return (uint64_t)fwrite((const void*)(uintptr_t)b, (size_t)s, (size_t)n, (FILE*)(uintptr_t)f); }\n");
  out::write("static inline uint64_t lain_ext_remove(uint64_t p) { return (uint64_t)(int64_t)remove((const char*)(uintptr_t)p); }\n");
  out::write("static inline uint64_t lain_ext_system(uint64_t c) { return (uint64_t)(int64_t)system((const char*)(uintptr_t)c); }\n");
  out::write("static inline uint64_t lain_ext_putchar(uint64_t c) { return (uint64_t)(int64_t)putchar((int)(int64_t)c); }\n\n");
  out::write("typedef struct { uint8_t *buf; size_t used; size_t cap; } LainArenaChunk;\n");
  out::write("typedef struct { LainArenaChunk *chunks; size_t count; size_t cap; size_t cur; } LainArena;\n");
  out::write("typedef struct { size_t chunk_idx; size_t used; } LainArenaMark;\n");
  out::write("static LainArena g_lain_arena = { NULL, 0, 0, 0 };\n");
  out::write("static LainArenaMark lain_arena_mark(void) { LainArenaMark m; m.chunk_idx = g_lain_arena.cur; m.used = (g_lain_arena.cur < g_lain_arena.count) ? g_lain_arena.chunks[g_lain_arena.cur].used : 0; return m; }\n");
  out::write("static void lain_arena_reset(LainArenaMark m) { size_t i = m.chunk_idx + 1; while (i < g_lain_arena.count) { g_lain_arena.chunks[i].used = 0; i++; } if (m.chunk_idx < g_lain_arena.count) { g_lain_arena.chunks[m.chunk_idx].used = m.used; g_lain_arena.cur = m.chunk_idx; } else { g_lain_arena.cur = 0; } }\n");
  out::write("static uint64_t lain_arena_alloc(size_t n) { size_t align_n = (n == 0 ? 1 : n); align_n = (align_n + 15u) & ~(size_t)15u; while (g_lain_arena.cur < g_lain_arena.count) { LainArenaChunk *c = &g_lain_arena.chunks[g_lain_arena.cur]; if (c->used + align_n <= c->cap) { uint8_t *p = c->buf + c->used; memset(p, 0, align_n); c->used += align_n; return (uint64_t)(uintptr_t)p; } g_lain_arena.cur++; } size_t new_cap = 65536u; if (align_n > new_cap) new_cap = align_n; if (g_lain_arena.count == g_lain_arena.cap) { size_t ncap = g_lain_arena.cap ? g_lain_arena.cap * 2u : 8u; LainArenaChunk *nc = (LainArenaChunk *)realloc(g_lain_arena.chunks, ncap * sizeof(LainArenaChunk)); if (!nc) abort(); g_lain_arena.chunks = nc; g_lain_arena.cap = ncap; } uint8_t *buf = (uint8_t *)calloc(1, new_cap); if (!buf) abort(); size_t idx = g_lain_arena.count++; g_lain_arena.chunks[idx].buf = buf; g_lain_arena.chunks[idx].used = align_n; g_lain_arena.chunks[idx].cap = new_cap; g_lain_arena.cur = idx; return (uint64_t)(uintptr_t)buf; }\n\n");
  out::write("static inline uint64_t lain_udiv(uint64_t a, uint64_t b) { if (!b) abort(); return a / b; }\n");
  out::write("static inline uint64_t lain_urem(uint64_t a, uint64_t b) { if (!b) abort(); return a % b; }\n");
  out::write("static inline uint64_t lain_sdiv(uint64_t a, uint64_t b) { if (!b) abort(); if (((int64_t)a == INT64_MIN) && ((int64_t)b == -1)) abort(); return (uint64_t)((int64_t)a / (int64_t)b); }\n");
  out::write("static inline uint64_t lain_srem(uint64_t a, uint64_t b) { if (!b) abort(); if (((int64_t)a == INT64_MIN) && ((int64_t)b == -1)) abort(); return (uint64_t)((int64_t)a % (int64_t)b); }\n");
  out::write("static inline uint64_t lain_shl(uint64_t a, uint64_t b, uint64_t w) { if (b >= w) abort(); return a << b; }\n");
  out::write("static inline uint64_t lain_lshr(uint64_t a, uint64_t b, uint64_t w) { if (b >= w) abort(); return a >> b; }\n");
  out::write("static inline uint64_t lain_ashr(uint64_t a, uint64_t b, uint64_t w) { if (b >= w) abort(); return (uint64_t)((int64_t)a >> b); }\n");
  out::write("static inline uint64_t lain_load(uint64_t addr, size_t n) { uint64_t v = 0; memcpy(&v, (const void*)(uintptr_t)addr, n); return v; }\n");
  out::write("static inline void lain_store(uint64_t addr, uint64_t v, size_t n) { memcpy((void*)(uintptr_t)addr, &v, n); }\n\n");
};

let emit_data = func(m: Ref(IrModule)) ?{ out: io::Sink } {
  let i: u64 = 0;
  let n: u64 = m.datas.len();
  while i < n {
    let seg: Ref(DataSeg) = m.datas.get_ref(i);
    if seg.mutable {
      out::write("static uint8_t d_");
    } else {
      out::write("static const uint8_t d_");
    }
    emit_u64(i) ?{ out: out };
    out::write("[] = { ");
    let j: u64 = 0;
    let blen: u64 = seg.bytes.len();
    if blen == 0 {
      out::write("0");
    } else {
      while j < blen {
        if j > 0 { out::write(", "); }
        emit_u64(seg.bytes.get(j) as u64) ?{ out: out };
        j = j + 1;
      };
    }
    out::write(" };\n");
    i = i + 1;
  };
  if n > 0 { out::write("\n"); }
};

let is_c_wrapped_extern = func(name: Slice(u8)) -> bool {
  return str::eq(name, "calloc") or str::eq(name, "malloc") or str::eq(name, "free") or
         str::eq(name, "memcpy") or str::eq(name, "fopen") or str::eq(name, "fclose") or
         str::eq(name, "fseek") or str::eq(name, "ftell") or str::eq(name, "fread") or
         str::eq(name, "fwrite") or str::eq(name, "remove") or str::eq(name, "system") or
         str::eq(name, "putchar");
};

let is_preamble_extern = func(name: Slice(u8)) -> bool {
  return is_c_wrapped_extern(name) or str::eq(name, "lain_os_argc") or
         str::eq(name, "lain_os_argv_len") or str::eq(name, "lain_os_argv_copy") or
         str::eq(name, "lain_os_eprint");
};

let emit_proc_sig = func(p: Ref(Proc), id: u64) ?{ out: io::Sink } {
  if p.is_extern {
    out::write("extern ");
    emit_c_ty(p.ret_ty) ?{ out: out };
    out::write(" ");
    out::write(p.link_name);
  } else {
    out::write("static ");
    emit_c_ty(p.ret_ty) ?{ out: out };
    out::write(" p_");
    emit_u64(id) ?{ out: out };
  }
  out::write("(");
  let np: u64 = p.params.len();
  if np == 0 {
    out::write("void");
  } else {
    let i: u64 = 0;
    while i < np {
      if i > 0 { out::write(", "); }
      emit_c_ty(p.params.get(i)) ?{ out: out };
      out::write(" a");
      emit_u64(i) ?{ out: out };
      i = i + 1;
    };
  }
  out::write(")");
};

let emit_bin_sym = func(op: Op) ?{ out: io::Sink } {
  if op == Op::Add { out::write(" + "); }
  else if op == Op::Sub { out::write(" - "); }
  else if op == Op::Mul { out::write(" * "); }
  else if op == Op::And { out::write(" & "); }
  else if op == Op::Or { out::write(" | "); }
  else if op == Op::Xor { out::write(" ^ "); }
  else if op == Op::Eq { out::write(" == "); }
  else if op == Op::Ne { out::write(" != "); }
  else if op == Op::Ult { out::write(" < "); }
  else if op == Op::Ule { out::write(" <= "); }
  else if op == Op::Ugt { out::write(" > "); }
  else { out::write(" >= "); }
};

let emit_signed_cmp_sym = func(op: Op) ?{ out: io::Sink } {
  if op == Op::Slt { out::write(" < "); }
  else if op == Op::Sle { out::write(" <= "); }
  else if op == Op::Sgt { out::write(" > "); }
  else { out::write(" >= "); }
};

let find_value_block = func(p: Ref(Proc), pc: u64) -> Option(u64) {
  let i: u64 = pc;
  let depth: u64 = 0;
  while i > 0 {
    i = i - 1;
    let ins: Ref(Inst) = p.insts.get_ref(i);
    if (ins.op == Op::EndIf) or (ins.op == Op::EndLoop) or (ins.op == Op::EndSwitch) {
      depth = depth + 1;
    } else if (ins.op == Op::If) or (ins.op == Op::Loop) or (ins.op == Op::Switch) {
      if depth > 0 {
        depth = depth - 1;
      } else if (ins.op == Op::If) or (ins.op == Op::Switch) {
        return Option(u64)::some(i);
      } else {
        return Option(u64)::none();
      };
    };
  };
  return Option(u64)::none();
};

let find_loop_pc = func(p: Ref(Proc), pc: u64, label: u64) -> Option(u64) {
  let i: u64 = pc;
  while i > 0 {
    i = i - 1;
    let ins: Ref(Inst) = p.insts.get_ref(i);
    if (ins.op == Op::Loop) and (ins.a == label) {
      return Option(u64)::some(i);
    };
  };
  return Option(u64)::none();
};

let emit_inst = func(m: Ref(IrModule), p: Ref(Proc), pc: u64) ?{ out: io::Sink } {
  let ins: Ref(Inst) = p.insts.get_ref(pc);
  let op: Op = ins.op;
  let k: u64 = op as u64;
  out::write("  ");
  if op == Op::Const {
    if ins.dst != 0 {
      emit_val(ins.dst) ?{ out: out };
      out::write(" = ");
      emit_u64(ins.imm) ?{ out: out };
      out::write("ULL;\n");
    }
  } else if op == Op::Param {
    out::write("abort();\n");
  } else if op == Op::SymAddr {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = (uint64_t)(uintptr_t)");
    if ins.aux == 0 {
      out::write("d_");
      emit_u64(ins.a) ?{ out: out };
    } else {
      out::write("p_");
      emit_u64(ins.a) ?{ out: out };
    }
    out::write(";\n");
  } else if (op == Op::Udiv) or (op == Op::Urem) {
    emit_val(ins.dst) ?{ out: out };
    if op == Op::Udiv { out::write(" = lain_udiv("); } else { out::write(" = lain_urem("); }
    emit_val(ins.a) ?{ out: out };
    out::write(", ");
    emit_val(ins.b) ?{ out: out };
    out::write(");\n");
  } else if (op == Op::Sdiv) or (op == Op::Srem) {
    emit_val(ins.dst) ?{ out: out };
    if op == Op::Sdiv { out::write(" = lain_sdiv("); } else { out::write(" = lain_srem("); }
    emit_val(ins.a) ?{ out: out };
    out::write(", ");
    emit_val(ins.b) ?{ out: out };
    out::write(");\n");
  } else if (op == Op::Shl) or (op == Op::Lshr) or (op == Op::Ashr) {
    emit_val(ins.dst) ?{ out: out };
    if op == Op::Shl { out::write(" = lain_shl("); }
    else if op == Op::Lshr { out::write(" = lain_lshr("); }
    else { out::write(" = lain_ashr("); }
    emit_val(ins.a) ?{ out: out };
    out::write(", ");
    emit_val(ins.b) ?{ out: out };
    out::write(", 64);\n");
  } else if ((k >= (Op::Add as u64)) and (k <= (Op::Xor as u64))) or ((k >= (Op::Eq as u64)) and (k <= (Op::Uge as u64))) {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = (uint64_t)(");
    emit_val(ins.a) ?{ out: out };
    emit_bin_sym(op) ?{ out: out };
    emit_val(ins.b) ?{ out: out };
    out::write(");\n");
  } else if (k >= (Op::Slt as u64)) and (k <= (Op::Sge as u64)) {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = (uint64_t)((int64_t)");
    emit_val(ins.a) ?{ out: out };
    emit_signed_cmp_sym(op) ?{ out: out };
    out::write("(int64_t)");
    emit_val(ins.b) ?{ out: out };
    out::write(");\n");
  } else if (op == Op::Bitcast) or (op == Op::Zext) or (op == Op::Sext) or (op == Op::Trunc) {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = ");
    emit_val(ins.a) ?{ out: out };
    out::write(";\n");
  } else if op == Op::Alloca {
    let bytes: u64 = ins.imm * ins.ty.bytes();
    emit_val(ins.dst) ?{ out: out };
    out::write(" = lain_arena_alloc(");
    emit_u64(if bytes == 0 { 1 } else { bytes }) ?{ out: out };
    out::write(");\n");
  } else if op == Op::Lea {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = ");
    emit_val(ins.a) ?{ out: out };
    out::write(" + ");
    if ins.b == 0 {
      out::write("0ULL");
    } else {
      emit_val(ins.b) ?{ out: out };
    }
    out::write(" * ");
    emit_u64(ins.c) ?{ out: out };
    out::write("ULL + ");
    emit_u64(ins.imm) ?{ out: out };
    out::write("ULL;\n");
  } else if op == Op::Load {
    emit_val(ins.dst) ?{ out: out };
    out::write(" = lain_load(");
    emit_val(ins.a) ?{ out: out };
    out::write(", ");
    emit_u64(ins.ty.bytes()) ?{ out: out };
    out::write(");\n");
  } else if op == Op::Store {
    out::write("lain_store(");
    emit_val(ins.b) ?{ out: out };
    out::write(", ");
    emit_val(ins.a) ?{ out: out };
    out::write(", ");
    emit_u64(ins.ty.bytes()) ?{ out: out };
    out::write(");\n");
  } else if op == Op::Call {
    let callee: Ref(Proc) = m.procs.get_ref(ins.a);
    if ins.dst != 0 {
      emit_val(ins.dst) ?{ out: out };
      out::write(" = ");
    }
    if callee.is_extern {
      if is_c_wrapped_extern(callee.link_name) {
        out::write("lain_ext_");
      }
      out::write(callee.link_name);
    } else {
      out::write("p_");
      emit_u64(ins.a) ?{ out: out };
    }
    out::write("(");
    let ai: u64 = 0;
    while ai < ins.c {
      if ai > 0 { out::write(", "); }
      emit_val(p.call_args.get(ins.b + ai)) ?{ out: out };
      ai = ai + 1;
    };
    out::write(");\n");
  } else if op == Op::CallIndirect {
    if ins.dst != 0 {
      emit_val(ins.dst) ?{ out: out };
      out::write(" = ");
    }
    out::write("((");
    emit_c_ty(ins.ty) ?{ out: out };
    out::write("(*)(");
    if ins.c == 0 {
      out::write("void");
    } else {
      let ti: u64 = 0;
      while ti < ins.c {
        if ti > 0 { out::write(", "); }
        out::write("uint64_t");
        ti = ti + 1;
      };
    }
    out::write("))(uintptr_t)");
    emit_val(ins.a) ?{ out: out };
    out::write(")(");
    let ii: u64 = 0;
    while ii < ins.c {
      if ii > 0 { out::write(", "); }
      emit_val(p.call_args.get(ins.b + ii)) ?{ out: out };
      ii = ii + 1;
    };
    out::write(");\n");
  } else if op == Op::If {
    out::write("if (");
    emit_val(ins.a) ?{ out: out };
    out::write(") {\n");
  } else if op == Op::Else {
    out::write("} else {\n");
  } else if op == Op::EndIf {
    out::write("}\n");
  } else if op == Op::Loop {
    out::write("L_loop_");
    emit_u64(ins.a) ?{ out: out };
    out::write(": while (1) {\n");
  } else if op == Op::EndLoop {
    let lp: Ref(Inst) = p.insts.get_ref(ins.a);
    out::write("break; } L_end_");
    emit_u64(lp.a) ?{ out: out };
    out::write(":;\n");
  } else if op == Op::Break {
    match find_loop_pc(p, pc, ins.a) {
      Some(loop_pc) => {
        let lp: Ref(Inst) = p.insts.get_ref(loop_pc);
        if (lp.dst != 0) and (ins.b != 0) {
          emit_val(lp.dst) ?{ out: out };
          out::write(" = ");
          emit_val(ins.b) ?{ out: out };
          out::write(";\n  ");
        };
        out::write("goto L_end_");
        emit_u64(ins.a) ?{ out: out };
        out::write(";\n");
      },
      None => { out::write("abort();\n"); },
    }
  } else if op == Op::Continue {
    match find_loop_pc(p, pc, ins.a) {
      Some(_) => {
        out::write("goto L_loop_");
        emit_u64(ins.a) ?{ out: out };
        out::write(";\n");
      },
      None => { out::write("abort();\n"); },
    }
  } else if op == Op::Switch {
    out::write("switch (");
    emit_val(ins.a) ?{ out: out };
    if (ins.b > 0) and (ins.b < 64) {
      out::write(" & ");
      emit_u64(((1 as u64) << ins.b) - 1) ?{ out: out };
      out::write("ULL");
    };
    out::write(") { if (0) {\n");
  } else if op == Op::Case {
    out::write("} break; case ");
    emit_u64(ins.imm) ?{ out: out };
    out::write("ULL: {\n");
  } else if op == Op::Default {
    out::write("} break; default: {\n");
  } else if op == Op::EndSwitch {
    out::write("} break; }\n");
  } else if op == Op::Yield {
    match find_value_block(p, pc) {
      Some(h) => {
        let hi: Ref(Inst) = p.insts.get_ref(h);
        if (hi.dst != 0) and (ins.a != 0) {
          emit_val(hi.dst) ?{ out: out };
          out::write(" = ");
          emit_val(ins.a) ?{ out: out };
          out::write(";\n");
        };
      },
      None => { out::write("abort();\n"); },
    }
  } else if op == Op::Return {
    if ins.a != 0 {
      out::write("{ ");
      emit_c_ty(p.ret_ty) ?{ out: out };
      out::write(" __rv = ");
      emit_val(ins.a) ?{ out: out };
      out::write("; lain_arena_reset(__am); return __rv; }\n");
    } else {
      out::write("lain_arena_reset(__am); ");
      let is_void_ret: bool = match p.ret_ty {
        Void => true,
        _ => false,
      };
      if is_void_ret {
        out::write("return;\n");
      } else {
        out::write("return 0;\n");
      }
    }
  } else if op == Op::Assume {
    out::write("if (!");
    emit_val(ins.a) ?{ out: out };
    out::write(") { abort(); }\n");
  } else if op == Op::Unreachable {
    out::write("abort();\n");
  }
};

let emit_proc = func(m: Ref(IrModule), id: u64) ?{ out: io::Sink } {
  let p: Ref(Proc) = m.procs.get_ref(id);
  if p.is_extern {
    return;
  }
  emit_proc_sig(p, id) ?{ out: out };
  out::write(" {\n  LainArenaMark __am = lain_arena_mark();\n");
  let vi: u64 = 1;
  while vi <= p.val_count {
    out::write("  uint64_t ");
    emit_val(vi) ?{ out: out };
    out::write(" = 0;\n");
    vi = vi + 1;
  };
  let pi: u64 = 0;
  while pi < p.params.len() {
    out::write("  ");
    emit_val(pi + 1) ?{ out: out };
    out::write(" = a");
    emit_u64(pi) ?{ out: out };
    out::write(";\n");
    pi = pi + 1;
  };
  let pc: u64 = 0;
  let n: u64 = p.insts.len();
  while pc < n {
    emit_inst(m, p, pc) ?{ out: out };
    pc = pc + 1;
  };
  out::write("}\n\n");
};

pub let emit_module = func(m: Ref(IrModule), entry: Slice(u8)) ?{ out: io::Sink } -> bool {
  emit_preamble() ?{ out: out };
  emit_data(m) ?{ out: out };
  let i: u64 = 0;
  let n: u64 = m.procs.len();
  while i < n {
    let sp: Ref(Proc) = m.procs.get_ref(i);
    if (sp.is_extern == false) or (is_preamble_extern(sp.link_name) == false) {
      emit_proc_sig(sp, i) ?{ out: out };
      out::write(";\n");
    }
    i = i + 1;
  };
  out::write("\n");
  let j: u64 = 0;
  while j < n {
    emit_proc(m, j) ?{ out: out };
    j = j + 1;
  };
  if entry.len > 0 {
    let ei: u64 = 0;
    while ei < n {
      let ep: Ref(Proc) = m.procs.get_ref(ei);
      if str::eq(ep.name, entry) {
        out::write("int main(int argc, char **argv) { g_lain_argc = argc; g_lain_argv = argv; return (int)p_");
        emit_u64(ei) ?{ out: out };
        out::write("(); }\n");
        return true;
      }
      ei = ei + 1;
    };
    return false;
  }
  return true;
};
