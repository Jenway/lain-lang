let diag = import("std::diag");
use import("std::collections")::{ Vec };
use import("std::err")::{ Fail };
use import("std::mem")::{ OomErr, is_pow2 };
use import("kernel::ir::model")::{ Ty, Op, Inst, Proc, IrModule };

let is_valid_ty = func(t: Ty) -> bool {
  return match t {
    Void => true,
    Bits(n) => (n == 1) or (n == 8) or (n == 16) or (n == 32) or (n == 64),
    Float(n) => (n == 32) or (n == 64),
    Vec(n) => (n == 128) or (n == 256) or (n == 512),
    Addr => true,
  };
};

let is_bits_ty = func(t: Ty) -> bool {
  return match t {
    Bits(_) => true,
    _ => false,
  };
};

let is_bit1_ty = func(t: Ty) -> bool {
  return match t {
    Bits(n) => n == 1,
    _ => false,
  };
};

let is_addr_ty = func(t: Ty) -> bool {
  return match t {
    Addr => true,
    _ => false,
  };
};

let is_term = func(op: Op) -> bool {
  let k: u64 = op as u64;
  return (k >= (Op::Yield as u64)) and (k <= (Op::Unreachable as u64));
};

let is_block_boundary = func(op: Op) -> bool {
  return (op == Op::Else)
    or (op == Op::EndIf)
    or (op == Op::EndLoop)
    or (op == Op::Case)
    or (op == Op::Default)
    or (op == Op::EndSwitch);
};

pub {
  let VerifyError = enum {
    BadType
    TypeMismatch
    BadAlign(u64)
    BadControlFlow
    TailNotBeforeReturn
    DeadCodeAfterTerm
    BadCallTarget(u64)
    BadCallArity(u64)
    UndefinedValue(u64)
    DuplicateCase(u64)
  };

  let VerifyFault = struct {
    err: VerifyError,
    proc_id: u64,
    pc: u64
  };

  let VerifyErr = Fail(VerifyFault);
};

let verify_err_kind = func(err: VerifyError) -> Slice(u8) {
  return match err {
    BadType => "BadType",
    TypeMismatch => "TypeMismatch",
    BadAlign(_) => "BadAlign",
    BadControlFlow => "BadControlFlow",
    TailNotBeforeReturn => "TailNotBeforeReturn",
    DeadCodeAfterTerm => "DeadCodeAfterTerm",
    BadCallTarget(_) => "BadCallTarget",
    BadCallArity(_) => "BadCallArity",
    UndefinedValue(_) => "UndefinedValue",
    DuplicateCase(_) => "DuplicateCase"
  };
};

let verify_fail = func(err: VerifyError, proc_id: u64, pc: u64) !{ VerifyErr } -> Never {
  diag::emit_ir("verify", verify_err_kind(err), proc_id, pc);
  perform VerifyErr::fail(VerifyFault { err: err, proc_id: proc_id, pc: pc });
};

let require_defined = func(val_tys: Ref(Vec(Ty)), val_id: u64, proc_id: u64, pc: u64) !{ VerifyErr } -> Ty {
  if (val_id == 0) or (val_id >= val_tys.len()) {
    verify_fail(VerifyError::UndefinedValue { val_id }, proc_id, pc);
  }
  let t: Ty = val_tys.get(val_id);
  if (t == Ty::Void) {
    verify_fail(VerifyError::UndefinedValue { val_id }, proc_id, pc);
  }
  return t;
};

let record_type = func(val_tys: Mut(Vec(Ty)), val_id: u64, val_count: u64, t: Ty) {
  if (val_id > 0) and (val_id <= val_count) {
    val_tys.set(val_id, t);
  }
};

pub {
  let verify_proc = func(m: Ref(IrModule), proc_id: u64) !{ VerifyErr, OomErr } {
    let p: Ref(Proc) = m.procs.get_ref(proc_id);
    if is_valid_ty(p.ret_ty) == false {
      verify_fail(VerifyError::BadType, proc_id, 0);
    }
    if p.is_extern {
      return;
    }
    let val_tys: Vec(Ty) = Vec(Ty)::new();
    let vi: u64 = 0;
    while vi <= p.val_count {
      val_tys.push(Ty::Void);
      vi = vi + 1;
    };
    let pi: u64 = 0;
    while pi < p.params.len() {
      let pt: Ty = p.params.get(pi);
      if is_valid_ty(pt) == false {
        verify_fail(VerifyError::BadType, proc_id, 0);
      }
      if (pi + 1) <= p.val_count {
        val_tys.set(pi + 1, pt);
      }
      pi = pi + 1;
    };

    let depth: u64 = 0;
    let dead: bool = false;
    let case_marks: Vec(u64) = Vec(u64)::new();
    let case_seen: Vec(u64) = Vec(u64)::new();
    let pc: u64 = 0;
    let n: u64 = p.insts.len();
    while pc < n {
      let ins: Ref(Inst) = p.insts.get_ref(pc);
      if is_block_boundary(ins.op) {
        dead = false;
      } else {
        if dead {
          verify_fail(VerifyError::DeadCodeAfterTerm, proc_id, pc);
        }
      }
      if is_valid_ty(ins.ty) == false {
        verify_fail(VerifyError::BadType, proc_id, pc);
      }
      if (ins.op == Op::Load) or (ins.op == Op::Store) {
        if is_pow2(ins.imm) == false {
          verify_fail(VerifyError::BadAlign { ins.imm }, proc_id, pc);
        }
      }
      if ins.op == Op::Call {
        if ins.a >= m.procs.len() {
          verify_fail(VerifyError::BadCallTarget { ins.a }, proc_id, pc);
        }
        let callee: Ref(Proc) = m.procs.get_ref(ins.a);
        if ins.c != callee.params.len() {
          verify_fail(VerifyError::BadCallArity { ins.c }, proc_id, pc);
        }
        if (ins.b + ins.c) > p.call_args.len() {
          verify_fail(VerifyError::BadCallArity { ins.c }, proc_id, pc);
        }
        let ai: u64 = 0;
        while ai < ins.c {
          let av: u64 = p.call_args.get(ins.b + ai);
          let at: Ty = require_defined(ref_of(val_tys), av, proc_id, pc);
          let pt: Ty = callee.params.get(ai);
          if at != pt {
            verify_fail(VerifyError::TypeMismatch, proc_id, pc);
          }
          ai = ai + 1;
        };
        if ins.aux == 1 {
          if (pc + 1) >= n {
            verify_fail(VerifyError::TailNotBeforeReturn, proc_id, pc);
          }
          let nxt: Ref(Inst) = p.insts.get_ref(pc + 1);
          if nxt.op != Op::Return {
            verify_fail(VerifyError::TailNotBeforeReturn, proc_id, pc);
          }
        }
      }
      let k: u64 = ins.op as u64;
      if (k >= (Op::Add as u64)) and (k <= (Op::Ashr as u64)) {
        if is_bits_ty(ins.ty) == false {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if ta != ins.ty {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        let tb: Ty = require_defined(ref_of(val_tys), ins.b, proc_id, pc);
        if tb != ins.ty {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, ins.ty);
      } else if (k >= (Op::Eq as u64)) and (k <= (Op::Sge as u64)) {
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if ta != ins.ty {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        let tb: Ty = require_defined(ref_of(val_tys), ins.b, proc_id, pc);
        if tb != ins.ty {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, Ty::Bits { 1 });
      } else if ins.op == Op::Load {
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if is_addr_ty(ta) == false {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, ins.ty);
      } else if ins.op == Op::Store {
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if ta != ins.ty {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        let tb: Ty = require_defined(ref_of(val_tys), ins.b, proc_id, pc);
        if is_addr_ty(tb) == false {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
      } else if ins.op == Op::Alloca {
        if ins.imm == 0 {
          verify_fail(VerifyError::BadType, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, Ty::Addr);
      } else if ins.op == Op::Lea {
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if is_addr_ty(ta) == false {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, Ty::Addr);
      } else if (ins.op == Op::If) or (ins.op == Op::Assume) {
        let ta: Ty = require_defined(ref_of(val_tys), ins.a, proc_id, pc);
        if is_bit1_ty(ta) == false {
          verify_fail(VerifyError::TypeMismatch, proc_id, pc);
        }
        record_type(mut_of(val_tys), ins.dst, p.val_count, ins.ty);
      } else {
        record_type(mut_of(val_tys), ins.dst, p.val_count, ins.ty);
      }
      if ins.op == Op::Switch {
        case_marks.push(case_seen.len());
      }
      if ins.op == Op::Case {
        let start: u64 = 0;
        if case_marks.len() > 0 {
          start = case_marks.get(case_marks.len() - 1);
        }
        let ci: u64 = start;
        while ci < case_seen.len() {
          if case_seen.get(ci) == ins.imm {
            verify_fail(VerifyError::DuplicateCase { ins.imm }, proc_id, pc);
          }
          ci = ci + 1;
        };
        case_seen.push(ins.imm);
      }
      if ins.op == Op::EndSwitch {
        match case_marks.pop() {
          Some(m) => {
            while case_seen.len() > m {
              case_seen.pop();
            };
          },
          None => {},
        };
      }
      if (ins.op == Op::If) or (ins.op == Op::Loop) or (ins.op == Op::Switch) {
        depth = depth + 1;
      }
      if (ins.op == Op::EndIf) or (ins.op == Op::EndLoop) or (ins.op == Op::EndSwitch) {
        if depth == 0 {
          verify_fail(VerifyError::BadControlFlow, proc_id, pc);
        }
        depth = depth - 1;
      }
      if is_term(ins.op) {
        dead = true;
      }
      pc = pc + 1;
    };
    if depth != 0 {
      verify_fail(VerifyError::BadControlFlow, proc_id, n);
    }
  };

  let verify_module = func(m: Ref(IrModule)) !{ VerifyErr, OomErr } {
    let i: u64 = 0;
    let n: u64 = m.procs.len();
    while i < n {
      verify_proc(m, i);
      i = i + 1;
    };
  };
};
