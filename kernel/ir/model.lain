use import("std::collections")::{ Vec };

pub {
  let Ty = module {
    pub {
      let Self = enum {
        Void
        Bits(u8)
        Float(u8)
        Vec(u16)
        Addr
      };

      let bytes = func(t: Self) -> u64 {
        return match t {
          Void => 0,
          Bits(n) => if n <= 8 { 1 } else { (n as u64) / 8 },
          Float(n) => (n as u64) / 8,
          Vec(n) => (n as u64) / 8,
          Addr => 8,
        };
      };
    };
  };

  let Op = enum(u64) {
    Const = 0,
    SymAddr = 1,
    Param = 2,
    Add = 10,
    Sub = 11,
    Mul = 12,
    Udiv = 13,
    Sdiv = 14,
    Urem = 15,
    Srem = 16,
    And = 17,
    Or = 18,
    Xor = 19,
    Shl = 20,
    Lshr = 21,
    Ashr = 22,
    Eq = 30,
    Ne = 31,
    Ult = 32,
    Ule = 33,
    Ugt = 34,
    Uge = 35,
    Slt = 36,
    Sle = 37,
    Sgt = 38,
    Sge = 39,
    Bitcast = 40,
    Zext = 41,
    Sext = 42,
    Trunc = 43,
    Alloca = 50,
    Lea = 51,
    Load = 52,
    Store = 53,
    Call = 60,
    CallIndirect = 61,
    If = 70,
    Else = 71,
    EndIf = 72,
    Loop = 73,
    EndLoop = 74,
    Switch = 75,
    Case = 76,
    Default = 77,
    EndSwitch = 78,
    Yield = 80,
    Break = 81,
    Continue = 82,
    Return = 83,
    Unreachable = 84,
    Assume = 85
  };

  let DerefBound = struct {
    val_id: u64,
    bytes: u64
  };

  let MemAxiom = enum {
    NoAlias(u64)
    ReadOnly(u64)
    Dereferenceable(DerefBound)
  };

  let Inst = struct {
    op: Op,
    ty: Ty,
    dst: u64,
    a: u64,
    b: u64,
    c: u64,
    imm: u64,
    aux: u64
  };

  let DataSeg = struct {
    name: Slice(u8),
    mutable: bool,
    align: u64,
    bytes: Vec(u8)
  };

  let Proc = struct {
    name: Slice(u8),
    link_name: Slice(u8),
    is_extern: bool,
    is_pure: bool,
    ret_ty: Ty,
    params: Vec(Ty),
    insts: Vec(Inst),
    call_args: Vec(u64),
    axioms: Vec(MemAxiom),
    val_count: u64
  };

  let IrModule = module {
    pub {
      let Self = struct {
        datas: Vec(DataSeg),
        procs: Vec(Proc)
      };

      let new = func() -> Self {
        return Self {
          datas: Vec(DataSeg)::new(),
          procs: Vec(Proc)::new()
        };
      };
    };
  };
};
