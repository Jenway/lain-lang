use import("std::err")::{ Fail };
use import("kernel::vm::addr")::{ VmAddr, SegId };

pub {
  let Trap = module {
    pub {
      let Reason = enum {
        Unreachable
        MemoryOob(VmAddr)
        Alignment(VmAddr)
        PermViolation(VmAddr)
        CapacityExceeded(u64)
        BorrowActive(SegId)
        StackOverflow(u64)
        CallDepth(u64)
        DivideByZero
        SignedDivOverflow
        ShiftOutOfRange(u64)
        CapDenied
        BadOpcode(u64)
      };

      let Self = struct {
        reason: Reason,
        proc_id: u64,
        pc: u64
      };
    };
  };

  let VmTrap = Fail(Trap);
};
