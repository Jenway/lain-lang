let diag = import("std::diag");
use import("std::err")::{ Fail };
use import("kernel::vm::addr")::{ VmAddr, SegId };

pub {
  let Trap = module {
    pub {
      let Reason = enum {
        Unreachable
        MemoryOob(VmAddr)
        Alignment(VmAddr)
        PermViolation(VmAddr)
        CapacityExceeded(u64)
        BorrowActive(SegId)
        StackOverflow(u64)
        CallDepth(u64)
        DivideByZero
        SignedDivOverflow
        ShiftOutOfRange(u64)
        CapDenied
        BadOpcode(u64)
      };

      let Self = struct {
        reason: Reason,
        proc_id: u64,
        pc: u64
      };
    };
  };

  let VmTrap = Fail(Trap);
};

let trap_kind = func(r: Trap::Reason) -> Slice(u8) {
  return match r {
    Unreachable => "Unreachable",
    MemoryOob(_) => "MemoryOob",
    Alignment(_) => "Alignment",
    PermViolation(_) => "PermViolation",
    CapacityExceeded(_) => "CapacityExceeded",
    BorrowActive(_) => "BorrowActive",
    StackOverflow(_) => "StackOverflow",
    CallDepth(_) => "CallDepth",
    DivideByZero => "DivideByZero",
    SignedDivOverflow => "SignedDivOverflow",
    ShiftOutOfRange(_) => "ShiftOutOfRange",
    CapDenied => "CapDenied",
    BadOpcode(_) => "BadOpcode"
  };
};

pub let raise_trap = func(reason: Trap::Reason, proc_id: u64, pc: u64) !{ VmTrap } -> Never {
  diag::emit_ir("vm", trap_kind(reason), proc_id, pc);
  perform VmTrap::fail(Trap { reason: reason, proc_id: proc_id, pc: pc });
};
