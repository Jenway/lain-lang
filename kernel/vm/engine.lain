use import("std::collections")::{ Vec };
use import("std::option")::{ Option };
use import("std::mem")::{ OomErr };
use import("kernel::ir::model")::{ Ty, Op, Inst, Proc };
use import("kernel::vm::addr")::{ VmAddr, EpId };
use import("kernel::vm::trap")::{ Trap, VmTrap };
use import("kernel::vm::vspace")::{ VSpace, Segment };
use import("kernel::vm::cspace")::{ CSpace, CapEntry };
use import("kernel::vm::image")::{ Image };
use import("kernel::vm::tcb")::{ Tcb, Frame, VmStatus };

pub {
  let SliceOutcome = enum {
    Done(u64)
    FuelSlice
    Blocked(EpId)
    Trapped(Trap)
  };
};

let width_of = func(t: Ty) -> u64 {
  return match t {
    Bits(n) => n as u64,
    Addr => 64,
    _ => 64,
  };
};

let mask_bits = func(v: u64, bits: u64) -> u64 {
  if bits >= 64 { return v; }
  return v & (((1 as u64) << bits) - 1);
};

let sext_bits = func(v: u64, bits: u64) -> i64 {
  if bits >= 64 { return v as i64; }
  let shift: u64 = 64 - bits;
  return ((v << shift) as i64) >> shift;
};

let slot_get = func(tcb: Ref(Tcb), base: u64, val_id: u64) -> u64 {
  if val_id == 0 { return 0; }
  return tcb.slots.get(base + val_id);
};

let slot_set = func(tcb: Mut(Tcb), base: u64, val_id: u64, v: u64) {
  if val_id == 0 { return; }
  tcb.slots.set(base + val_id, v);
};

let eval_arith = func(op: Op, bits: u64, lhs: u64, rhs: u64, proc_id: u64, pc: u64) !{ VmTrap } -> u64 {
  let a: u64 = mask_bits(lhs, bits);
  let b: u64 = mask_bits(rhs, bits);
  if op == Op::Add { return mask_bits(a + b, bits); }
  if op == Op::Sub { return mask_bits(a - b, bits); }
  if op == Op::Mul { return mask_bits(a * b, bits); }
  if op == Op::And { return mask_bits(a & b, bits); }
  if op == Op::Or { return mask_bits(a | b, bits); }
  if op == Op::Xor { return mask_bits(a ^ b, bits); }
  if (op == Op::Udiv) or (op == Op::Urem) {
    if b == 0 {
      perform VmTrap::fail(Trap { reason: Trap::Reason::DivideByZero, proc_id: proc_id, pc: pc });
    }
    if op == Op::Udiv { return mask_bits(a / b, bits); }
    return mask_bits(a % b, bits);
  }
  if (op == Op::Sdiv) or (op == Op::Srem) {
    let sa: i64 = sext_bits(a, bits);
    let sb: i64 = sext_bits(b, bits);
    if sb == 0 {
      perform VmTrap::fail(Trap { reason: Trap::Reason::DivideByZero, proc_id: proc_id, pc: pc });
    }
    let min_val: i64 = sext_bits((1 as u64) << (bits - 1), bits);
    if (sa == min_val) and (sb == -1) {
      perform VmTrap::fail(Trap { reason: Trap::Reason::SignedDivOverflow, proc_id: proc_id, pc: pc });
    }
    if op == Op::Sdiv { return mask_bits((sa / sb) as u64, bits); }
    return mask_bits((sa % sb) as u64, bits);
  }
  if (op == Op::Shl) or (op == Op::Lshr) or (op == Op::Ashr) {
    if b >= bits {
      perform VmTrap::fail(Trap { reason: Trap::Reason::ShiftOutOfRange { b }, proc_id: proc_id, pc: pc });
    }
    if op == Op::Shl { return mask_bits(a << b, bits); }
    if op == Op::Lshr { return mask_bits(a >> b, bits); }
    return mask_bits((sext_bits(a, bits) >> b) as u64, bits);
  }
  perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { op as u64 }, proc_id: proc_id, pc: pc });
};

let eval_cmp = func(op: Op, bits: u64, lhs: u64, rhs: u64) -> u64 {
  let a: u64 = mask_bits(lhs, bits);
  let b: u64 = mask_bits(rhs, bits);
  let sa: i64 = sext_bits(a, bits);
  let sb: i64 = sext_bits(b, bits);
  let hit: bool = if op == Op::Eq { a == b }
    else if op == Op::Ne { a != b }
    else if op == Op::Ult { a < b }
    else if op == Op::Ule { a <= b }
    else if op == Op::Ugt { a > b }
    else if op == Op::Uge { a >= b }
    else if op == Op::Slt { sa < sb }
    else if op == Op::Sle { sa <= sb }
    else if op == Op::Sgt { sa > sb }
    else { sa >= sb };
  return if hit { 1 } else { 0 };
};

let step_loop = func(
  img: Ref(Image),
  vs: Mut(VSpace),
  cs: Ref(CSpace),
  tcb: Mut(Tcb),
  fuel_budget: u64
) !{ VmTrap, OomErr } -> SliceOutcome {
  let left: u64 = fuel_budget;
  while tcb.frames.len() > 0 {
    if left == 0 {
      return SliceOutcome::FuelSlice;
    }
    left = left - 1;
    tcb.fuel_used = tcb.fuel_used + 1;

    let fr: Mut(Frame) = tcb.top_frame();
    let pid: u64 = fr.proc_id;
    let pc: u64 = fr.pc;
    let base: u64 = fr.slot_base;
    let p: Ref(Proc) = img.ir.procs.get_ref(pid);
    if pc >= p.insts.len() {
      let popped: Option(Frame) = tcb.pop_frame();
      match popped {
        Some(f) => { vs.set_accessible(tcb.stack_seg, f.stack_mark); },
        None => {},
      };
      if tcb.frames.len() == 0 {
        return SliceOutcome::Done { 0 };
      }
    } else {

    let ins: Ref(Inst) = p.insts.get_ref(pc);
    let op: Op = ins.op;
    let k: u64 = op as u64;
    let bits: u64 = width_of(ins.ty);

    if op == Op::Const {
      slot_set(tcb, base, ins.dst, mask_bits(ins.imm, bits));
      fr.pc = pc + 1;
    } else if op == Op::SymAddr {
      let addr: u64 = if ins.aux == 0 {
        let dv: VmAddr = img.data_vaddr(ins.a);
        dv.raw
      } else {
        ins.a + 1
      };
      slot_set(tcb, base, ins.dst, addr);
      fr.pc = pc + 1;
    } else if (k >= (Op::Add as u64)) and (k <= (Op::Ashr as u64)) {
      let lv: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let rv: u64 = slot_get(ref_of(deref(tcb)), base, ins.b);
      let res: u64 = eval_arith(op, bits, lv, rv, pid, pc);
      slot_set(tcb, base, ins.dst, res);
      fr.pc = pc + 1;
    } else if (k >= (Op::Eq as u64)) and (k <= (Op::Sge as u64)) {
      let lv: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let rv: u64 = slot_get(ref_of(deref(tcb)), base, ins.b);
      slot_set(tcb, base, ins.dst, eval_cmp(op, bits, lv, rv));
      fr.pc = pc + 1;
    } else if (op == Op::Bitcast) or (op == Op::Zext) or (op == Op::Trunc) {
      let v: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      slot_set(tcb, base, ins.dst, mask_bits(v, bits));
      fr.pc = pc + 1;
    } else if op == Op::Sext {
      let v: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      slot_set(tcb, base, ins.dst, mask_bits(sext_bits(v, bits) as u64, bits));
      fr.pc = pc + 1;
    } else if op == Op::Alloca {
      let bytes: u64 = ins.imm * ins.ty.bytes();
      let ptr: VmAddr = vs.grow_accessible(tcb.stack_seg, bytes);
      slot_set(tcb, base, ins.dst, ptr.raw);
      fr.pc = pc + 1;
    } else if op == Op::Lea {
      let baddr: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let idx: u64 = slot_get(ref_of(deref(tcb)), base, ins.b);
      slot_set(tcb, base, ins.dst, baddr + idx * ins.c + ins.imm);
      fr.pc = pc + 1;
    } else if op == Op::Load {
      let addr: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let v: u64 = vs.load(VmAddr { raw: addr }, ins.ty.bytes(), ins.imm);
      slot_set(tcb, base, ins.dst, mask_bits(v, bits));
      fr.pc = pc + 1;
    } else if op == Op::Store {
      let val: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let addr: u64 = slot_get(ref_of(deref(tcb)), base, ins.b);
      vs.store(VmAddr { raw: addr }, val, ins.ty.bytes(), ins.imm);
      fr.pc = pc + 1;
    } else if op == Op::Call {
      let callee: Ref(Proc) = img.ir.procs.get_ref(ins.a);
      let call_vals: Vec(u64) = Vec(u64)::new();
      let ai: u64 = 0;
      while ai < ins.c {
        let arg_vid: u64 = p.call_args.get(ins.b + ai);
        call_vals.push(slot_get(ref_of(deref(tcb)), base, arg_vid));
        ai = ai + 1;
      };
      if callee.is_extern {
        let idx: u64 = match cs.lookup(callee.link_name) {
          Some(ci) => ci,
          None => perform VmTrap::fail(Trap { reason: Trap::Reason::CapDenied, proc_id: pid, pc: pc }),
        };
        let entry: Ref(CapEntry) = cs.entries.get_ref(idx);
        if entry.param_count != call_vals.len() {
          perform VmTrap::fail(Trap { reason: Trap::Reason::CapDenied, proc_id: pid, pc: pc });
        }
        let h: Fn((u64, Mut(VSpace), Slice(u64)) -> u64) = entry.handler;
        let res: u64 = h(entry.ctx, vs, call_vals.as_slice());
        if entry.has_ret and (ins.dst != 0) {
          slot_set(tcb, base, ins.dst, res);
        }
        fr.pc = pc + 1;
      } else {
        fr.pc = pc + 1;
        let seg: Ref(Segment) = vs.segs.get_ref(tcb.stack_seg.id);
        tcb.push_frame(ins.a, 0, callee.val_count + 1, seg.accessible, ins.dst, ins.dst != 0);
        let new_fr: Mut(Frame) = tcb.top_frame();
        let pi: u64 = 0;
        while pi < call_vals.len() {
          slot_set(tcb, new_fr.slot_base, pi + 1, call_vals.get(pi));
          pi = pi + 1;
        };
      }
    } else if op == Op::CallIndirect {
      let fp: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      if (fp == 0) or ((fp - 1) >= img.ir.procs.len()) {
        perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { fp }, proc_id: pid, pc: pc });
      }
      let callee_id: u64 = fp - 1;
      let callee: Ref(Proc) = img.ir.procs.get_ref(callee_id);
      let call_vals: Vec(u64) = Vec(u64)::new();
      let ai: u64 = 0;
      while ai < ins.c {
        let arg_vid: u64 = p.call_args.get(ins.b + ai);
        call_vals.push(slot_get(ref_of(deref(tcb)), base, arg_vid));
        ai = ai + 1;
      };
      if callee.is_extern {
        let idx: u64 = match cs.lookup(callee.link_name) {
          Some(ci) => ci,
          None => perform VmTrap::fail(Trap { reason: Trap::Reason::CapDenied, proc_id: pid, pc: pc }),
        };
        let entry: Ref(CapEntry) = cs.entries.get_ref(idx);
        if entry.param_count != call_vals.len() {
          perform VmTrap::fail(Trap { reason: Trap::Reason::CapDenied, proc_id: pid, pc: pc });
        }
        let h: Fn((u64, Mut(VSpace), Slice(u64)) -> u64) = entry.handler;
        let res: u64 = h(entry.ctx, vs, call_vals.as_slice());
        if entry.has_ret and (ins.dst != 0) {
          slot_set(tcb, base, ins.dst, res);
        }
        fr.pc = pc + 1;
      } else {
        fr.pc = pc + 1;
        let seg: Ref(Segment) = vs.segs.get_ref(tcb.stack_seg.id);
        tcb.push_frame(callee_id, 0, callee.val_count + 1, seg.accessible, ins.dst, ins.dst != 0);
        let new_fr: Mut(Frame) = tcb.top_frame();
        let pi: u64 = 0;
        while pi < call_vals.len() {
          slot_set(tcb, new_fr.slot_base, pi + 1, call_vals.get(pi));
          pi = pi + 1;
        };
      }
    } else if op == Op::If {
      let cond: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      fr.pc = if cond == 0 { ins.b } else { pc + 1 };
    } else if op == Op::Else {
      fr.pc = ins.c + 1;
    } else if (op == Op::EndIf) or (op == Op::Loop) or (op == Op::EndLoop) or (op == Op::EndSwitch) {
      fr.pc = pc + 1;
    } else if op == Op::Switch {
      let sel: u64 = mask_bits(slot_get(ref_of(deref(tcb)), base, ins.a), ins.b);
      let limit: u64 = ins.c;
      let depth: u64 = 0;
      let case_target: u64 = 0;
      let def_target: u64 = 0;
      let sc: u64 = pc + 1;
      while sc < limit {
        let s_ins: Ref(Inst) = p.insts.get_ref(sc);
        let s_op: Op = s_ins.op;
        if s_op == Op::Switch {
          depth = depth + 1;
        } else if s_op == Op::EndSwitch {
          if depth == 0 {
            sc = limit;
          } else {
            depth = depth - 1;
          }
        } else if depth == 0 {
          if s_op == Op::Case {
            if (s_ins.imm == sel) and (case_target == 0) {
              case_target = sc + 1;
            }
          } else if s_op == Op::Default {
            if def_target == 0 {
              def_target = sc + 1;
            }
          }
        }
        sc = sc + 1;
      };
      fr.pc = if case_target != 0 { case_target } else if def_target != 0 { def_target } else { limit + 1 };
    } else if (op == Op::Case) or (op == Op::Default) {
      let depth: u64 = 0;
      let end_target: u64 = 0;
      let sc: u64 = pc + 1;
      let n: u64 = p.insts.len();
      while sc < n {
        let s_ins: Ref(Inst) = p.insts.get_ref(sc);
        let s_op: Op = s_ins.op;
        if s_op == Op::Switch {
          depth = depth + 1;
        } else if s_op == Op::EndSwitch {
          if depth == 0 {
            end_target = sc + 1;
            sc = n;
          } else {
            depth = depth - 1;
          }
        }
        sc = sc + 1;
      };
      if end_target == 0 {
        perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { k }, proc_id: pid, pc: pc });
      }
      fr.pc = end_target;
    } else if op == Op::Yield {
      let val: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let depth: u64 = 0;
      let hdr_pc: u64 = 0;
      let found: bool = false;
      let i: u64 = pc;
      while (i > 0) and (found == false) {
        i = i - 1;
        let b_ins: Ref(Inst) = p.insts.get_ref(i);
        let b_op: Op = b_ins.op;
        if (b_op == Op::EndIf) or (b_op == Op::EndLoop) or (b_op == Op::EndSwitch) {
          depth = depth + 1;
        } else if (b_op == Op::If) or (b_op == Op::Loop) or (b_op == Op::Switch) {
          if depth == 0 {
            if b_op == Op::Loop {
              perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { k }, proc_id: pid, pc: pc });
            }
            hdr_pc = i;
            found = true;
          } else {
            depth = depth - 1;
          }
        }
      };
      if found {
        let hdr: Ref(Inst) = p.insts.get_ref(hdr_pc);
        if hdr.dst != 0 {
          slot_set(tcb, base, hdr.dst, val);
        }
        fr.pc = hdr.c + 1;
      } else {
        perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { k }, proc_id: pid, pc: pc });
      }
    } else if op == Op::Break {
      let val: u64 = slot_get(ref_of(deref(tcb)), base, ins.b);
      let lbl: u64 = ins.a;
      let loop_pc: u64 = 0;
      let found: bool = false;
      let i: u64 = pc;
      while (i > 0) and (found == false) {
        i = i - 1;
        let b_ins: Ref(Inst) = p.insts.get_ref(i);
        let b_op: Op = b_ins.op;
        if b_op == Op::Loop {
          if b_ins.a == lbl {
            loop_pc = i;
            found = true;
          }
        }
      };
      if found {
        let lp: Ref(Inst) = p.insts.get_ref(loop_pc);
        if lp.dst != 0 {
          slot_set(tcb, base, lp.dst, val);
        }
        fr.pc = lp.b + 1;
      } else {
        perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { lbl }, proc_id: pid, pc: pc });
      }
    } else if op == Op::Continue {
      let lbl: u64 = ins.a;
      let loop_pc: u64 = 0;
      let found: bool = false;
      let i: u64 = pc;
      while (i > 0) and (found == false) {
        i = i - 1;
        let b_ins: Ref(Inst) = p.insts.get_ref(i);
        let b_op: Op = b_ins.op;
        if b_op == Op::Loop {
          if b_ins.a == lbl {
            loop_pc = i;
            found = true;
          }
        }
      };
      if found {
        fr.pc = loop_pc + 1;
      } else {
        perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { lbl }, proc_id: pid, pc: pc });
      }
    } else if op == Op::Return {
      let rv: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      let popped: Option(Frame) = tcb.pop_frame();
      match popped {
        Some(f) => {
          vs.set_accessible(tcb.stack_seg, f.stack_mark);
          if tcb.frames.len() == 0 {
            return SliceOutcome::Done { rv };
          }
          if f.has_ret_dst {
            let caller: Mut(Frame) = tcb.top_frame();
            slot_set(tcb, caller.slot_base, f.ret_dst, rv);
          }
        },
        None => { return SliceOutcome::Done { rv }; },
      };
    } else if op == Op::Assume {
      let cond: u64 = slot_get(ref_of(deref(tcb)), base, ins.a);
      if cond == 0 {
        perform VmTrap::fail(Trap { reason: Trap::Reason::Unreachable, proc_id: pid, pc: pc });
      }
      fr.pc = pc + 1;
    } else if op == Op::Unreachable {
      perform VmTrap::fail(Trap { reason: Trap::Reason::Unreachable, proc_id: pid, pc: pc });
    } else {
      perform VmTrap::fail(Trap { reason: Trap::Reason::BadOpcode { k }, proc_id: pid, pc: pc });
    }
    }
  };
  return SliceOutcome::Done { 0 };
};

pub {
  let Engine = module {
    pub {
      let run_slice = func(
        img: Ref(Image),
        vs: Mut(VSpace),
        cs: Ref(CSpace),
        tcb: Mut(Tcb),
        fuel_budget: u64
      ) !{ OomErr } -> SliceOutcome {
        return handle step_loop(img, vs, cs, tcb, fuel_budget) with {
          return(out) => out,
          fail(tr) => {
            tcb.status = VmStatus::Trapped;
            SliceOutcome::Trapped { tr }
          },
        };
      };
    };
  };
};
