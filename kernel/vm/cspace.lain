use import("std::collections")::{ Vec };
use import("std::option")::{ Option };
use import("std::mem")::{ OomErr };
use import("kernel::vm::vspace")::{ VSpace };
let str = import("std::str");

pub {
  let CapEntry = struct {
    name: Slice(u8),
    param_count: u64,
    has_ret: bool,
    handler: Fn((u64, Mut(VSpace), Slice(u64)) -> u64),
    ctx: u64
  };

  let CSpace = module {
    pub {
      let Self = struct {
        entries: Vec(CapEntry),
        frozen: bool
      };

      let new = func() -> Self {
        return Self {
          entries: Vec(CapEntry)::new(),
          frozen: false
        };
      };

      let register = func(cs: Mut(Self), entry: CapEntry) !{ OomErr } -> bool {
        if cs.frozen {
          return false;
        }
        cs.entries.push(entry);
        return true;
      };

      let freeze = func(cs: Mut(Self)) {
        cs.frozen = true;
      };

      let is_frozen = func(cs: Ref(Self)) -> bool {
        return cs.frozen;
      };

      let lookup = func(cs: Ref(Self), name: Slice(u8)) -> Option(u64) {
        let i: u64 = 0;
        let n: u64 = cs.entries.len();
        while i < n {
          let e: Ref(CapEntry) = cs.entries.get_ref(i);
          if str::eq(e.name, name) {
            return Option(u64)::some(i);
          }
          i = i + 1;
        };
        return Option(u64)::none();
      };
    };
  };
};
