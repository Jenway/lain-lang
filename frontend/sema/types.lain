  HirStructLit, HirCast, HirExprKind, HirExpr, HirLet, HirAssign, HirWhile,
  HirStmt, HirFn, VariantInfo, EnumInfo, HirEnumLit, HirMatchArm, HirMatch,
  HirPtrOffset, HirMemWrite, HirDropAt, HirFieldPtr, HirPerform, HirHandleArm, HirHandle
};
