use import("frontend::sema::effects")::{ EffRow };
use import("frontend::sema::comptime")::{ eval_hir_u64, eval_hir_bool };

let ArgVec = Vec(HirExprId);
let StmtVec = Vec(HirStmtId);
let TypeIdVec = Vec(TypeId);

pub {
  let FlatDecl = struct {
    id: u32,
    is_pub: bool
  };

  let ConstDecl = struct {
    decl_id: u32,
    is_pub: bool,
    evaluated: bool,
    ty: TypeId,
    val: u64
  };

  let GenericFnDef = struct {
    decl_id: u32,
    is_pub: bool
  };

  let GenericFnInst = struct {
    gidx: u32,
    args_start: u32,
    args_len: u32,
    fn_id: HirFnId
  };

  let GenericTyInst = struct {
    gidx: u32,
    args_start: u32,
    args_len: u32,
    ty_id: TypeId
  };

  let ModuleDefInfo = struct {
    name: Slice(u8),
    self_tid: Option(TypeId)
  };

  let GenericModInst = struct {
    gidx: u32,
    args_start: u32,
    args_len: u32,
    mod_idx: u32
  };

  let SigDefInfo = struct {
    name: Slice(u8),
    items: IdRange
  };

  let ModFnEntry = struct {
    fid: HirFnId,
    decl_id: u32,
    mod_idx: u32
  };

  let EffectDefInfo = struct {
    name: Slice(u8),
    ops: IdRange
  };

  let Ctx = struct {
    hir: HirModule,
    globals: Scope,
    locals: Scope,
    type_params: Scope,
    struct_tys: Vec(TypeId),
    enum_tys: Vec(TypeId),
    decls: Vec(FlatDecl),
    fn_decls: Vec(FlatDecl),
    fn_checked: Vec(bool),
    generic_fns: Vec(GenericFnDef),
    generic_fn_insts: Vec(GenericFnInst),
    generic_ty_insts: Vec(GenericTyInst),
    generic_mod_insts: Vec(GenericModInst),
    generic_type_args: Vec(TypeId),
    modules: Vec(ModuleDefInfo),
    mod_syms: Vec(SymEntry),
    sigs: Vec(SigDefInfo),
    effects: Vec(EffectDefInfo),
    cur_eff_names: Vec(Slice(u8)),
    handled_effs: Vec(Slice(u8)),
    fn_eff_ranges: Vec(HirRange),
    fn_eff_names: Vec(Slice(u8)),
    mod_fns: Vec(ModFnEntry),
    mod_decl_buf: Vec(FlatDecl),
    consts: Vec(ConstDecl),
    arg_buf: ArgVec,
    stmt_buf: StmtVec,
    arm_buf: Vec(HirMatchArm),
    harm_buf: Vec(HirHandleArm),
    tid_buf: TypeIdVec,
    expr_buf: Vec(ExprId),
    void_tid: TypeId,
    bool_tid: TypeId,
    i64_tid: TypeId,
    u8_tid: TypeId,
    u64_tid: TypeId,
    type_tid: TypeId,
    mod_tid: TypeId,
    sig_tid: TypeId,
    eff_tid: TypeId,
    type_info_sidx: u32,
    type_info_tid: TypeId,
    cur_ret: TypeId,
    cur_mod: Option(u32)
  };
};

let blank = func() -> Slice(u8) {
  return make_slice(Slice(u8), null_ref(Ref(u8)), 0);
};

let mod_define = func(c: Mut(Ctx), midx: u32, name: Slice(u8), kind: SymKind) ?{ al: Allocator = SystemAlloc } !{ OomErr } {
  deref(c).mod_syms.push(SymEntry { name: name, kind: kind, depth: midx, pad: 0 });
};

let mod_lookup = func(c: Mut(Ctx), midx: u32, name: Slice(u8)) -> Option(SymEntry) {
  let n: u64 = deref(c).mod_syms.len();
  let i: u64 = n;
  while i > 0 {
    let e: SymEntry = deref(c).mod_syms.get(i - 1);
    if (e.depth == midx) and eq(e.name, name) {
      return Option(SymEntry)::some(e);
    }
    i = i - 1;
  };
  return Option(SymEntry)::none();
};

let eff_expr_name = func(ast: Ref(AstModule()), text: Slice(u8), eid: ExprId) -> Slice(u8) {
  let ex: Expr = ast.exprs.get(eid.idx as u64);
  return match ex {
    Ident(nsp) => Span::slice(nsp, text),
    Path(p) => {
      if p.len == 0 {
        blank()
      } else {
        Span::slice(ast.path_segs.get((p.start as u64) + (p.len as u64) - 1), text)
      }
    },
    _ => blank(),
  };
};

let record_fn_effects = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), eff_r: IdRange) !{ OomErr } {
  let start: u32 = deref(c).fn_eff_names.len() as u32;
  let i: u64 = 0;
  while i < (eff_r.len as u64) {
    let eid: ExprId = ast.expr_lists.get((eff_r.start as u64) + i);
    let ename: Slice(u8) = eff_expr_name(ast, text, eid);
    if ename.len > 0 {
      deref(c).fn_eff_names.push(ename);
    }
    i = i + 1;
  };
  let used: u32 = (deref(c).fn_eff_names.len() as u32) - start;
  deref(c).fn_eff_ranges.push(HirRange { start: start, len: used });
};

let push_cur_effs = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), eff_r: IdRange) !{ OomErr } -> u64 {
  let base: u64 = deref(c).cur_eff_names.len();
  let i: u64 = 0;
  while i < (eff_r.len as u64) {
    let eid: ExprId = ast.expr_lists.get((eff_r.start as u64) + i);
    let ename: Slice(u8) = eff_expr_name(ast, text, eid);
    if ename.len > 0 {
      deref(c).cur_eff_names.push(ename);
    }
    i = i + 1;
  };
  return base;
};

let eff_allowed = func(c: Mut(Ctx), ename: Slice(u8)) -> bool {
  let hn: u64 = deref(c).handled_effs.len();
  let hi: u64 = 0;
  while hi < hn {
    if eq(deref(c).handled_effs.get(hi), ename) {
      return true;
    }
    hi = hi + 1;
  };
  let cn: u64 = deref(c).cur_eff_names.len();
  let ci: u64 = 0;
  while ci < cn {
    if eq(deref(c).cur_eff_names.get(ci), ename) {
      return true;
    }
    ci = ci + 1;
  };
  return false;
};

let type_tag = func(t: HirType) -> u32 {
  return match t {
    Void => 0,
    Bool => 1,
    Int(_) => 2,
    Float(_) => 3,
    Ref(_) => 4,
    Mut(_) => 5,
    Struct(_) => 6,
    Enum(_) => 7,
    Fn(_) => 8,
    HirNever => 9,
    TypeMeta => 10,
  };
};

let type_bits = func(t: HirType) -> u32 {
  return match t {
    Int(ii) => ii.bits as u32,
    Float(w) => w as u32,
    _ => 0,
  };
};

let type_signed = func(t: HirType) -> bool {
  return match t {
    Int(ii) => ii.signed,
    _ => false,
  };
};

let type_inner = func(t: HirType) -> TypeId {
  return match t {
    Ref(inner) => inner,
    Mut(inner) => inner,
    _ => TypeId { idx: 0 },
  };
};

let type_index = func(t: HirType) -> u32 {
  return match t {
    Struct(idx) => idx,
    Enum(idx) => idx,
    Fn(idx) => idx,
    _ => 0,
  };
};

let same_hir_type = func(a: HirType, b: HirType) -> bool {
  let tag: u32 = type_tag(a);
  if tag != type_tag(b) {
    return false;
  }
  if tag == 2 {
    return (type_bits(a) == type_bits(b)) and (type_signed(a) == type_signed(b));
  }
  if tag == 3 {
    return type_bits(a) == type_bits(b);
  }
  if (tag == 4) or (tag == 5) {
    return type_inner(a).idx == type_inner(b).idx;
  }
  if (tag == 6) or (tag == 7) or (tag == 8) {
    return type_index(a) == type_index(b);
  }
  return true;
};

let is_comparison = func(op: BinOp) -> bool {
  return match op {
    Eq => true,
    Ne => true,
    Lt => true,
    Le => true,
    Gt => true,
    Ge => true,
    And => true,
    Or => true,
    _ => false,
  };
};

let new_ctx = func() -> Ctx {
  return Ctx {
    hir: HirModule::new(),
    globals: Scope::new(),
    locals: Scope::new(),
    type_params: Scope::new(),
    struct_tys: Vec(TypeId)::new(),
    enum_tys: Vec(TypeId)::new(),
    decls: Vec(FlatDecl)::new(),
    fn_decls: Vec(FlatDecl)::new(),
    fn_checked: Vec(bool)::new(),
    generic_fns: Vec(GenericFnDef)::new(),
    generic_fn_insts: Vec(GenericFnInst)::new(),
    generic_ty_insts: Vec(GenericTyInst)::new(),
    generic_mod_insts: Vec(GenericModInst)::new(),
    generic_type_args: Vec(TypeId)::new(),
    modules: Vec(ModuleDefInfo)::new(),
    mod_syms: Vec(SymEntry)::new(),
    sigs: Vec(SigDefInfo)::new(),
    effects: Vec(EffectDefInfo)::new(),
    cur_eff_names: Vec(Slice(u8))::new(),
    handled_effs: Vec(Slice(u8))::new(),
    fn_eff_ranges: Vec(HirRange)::new(),
    fn_eff_names: Vec(Slice(u8))::new(),
    mod_fns: Vec(ModFnEntry)::new(),
    mod_decl_buf: Vec(FlatDecl)::new(),
    consts: Vec(ConstDecl)::new(),
    arg_buf: ArgVec::new(),
    stmt_buf: StmtVec::new(),
    arm_buf: Vec(HirMatchArm)::new(),
    harm_buf: Vec(HirHandleArm)::new(),
    tid_buf: TypeIdVec::new(),
    expr_buf: Vec(ExprId)::new(),
    void_tid: TypeId { idx: 0 },
    bool_tid: TypeId { idx: 0 },
    i64_tid: TypeId { idx: 0 },
    u8_tid: TypeId { idx: 0 },
    u64_tid: TypeId { idx: 0 },
    type_tid: TypeId { idx: 0 },
    mod_tid: TypeId { idx: 0 },
    sig_tid: TypeId { idx: 0 },
    eff_tid: TypeId { idx: 0 },
    type_info_sidx: 0,
    type_info_tid: TypeId { idx: 0 },
    cur_ret: TypeId { idx: 0 },
    cur_mod: Option(u32)::none()
  };
};

let fail_at = func(err: SemaErr) !{ SemaFail } -> HirExprId {
  perform SemaFail::fail(err);
  return HirExprId { idx: 0 };
};

let fail_type = func(err: SemaErr) !{ SemaFail } -> TypeId {
  perform SemaFail::fail(err);
  return TypeId { idx: 0 };
};

let fail_u64 = func(err: SemaErr) !{ SemaFail } -> u64 {
  perform SemaFail::fail(err);
  return 0;
};

let fail_variant = func(err: SemaErr) !{ SemaFail } -> u32 {
  perform SemaFail::fail(err);
  return 0;
};

let span_at = func(ast: Ref(AstModule()), r: IdRange) ?{ al: Allocator = SystemAlloc } -> Span {
  return ast.path_segs.get((r.start as u64) + (r.len as u64) - 1);
};

let add_named = func(c: Mut(Ctx), name: Slice(u8), t: HirType, sp: Span) !{ OomErr, SemaFail } -> TypeId {
  let tid: TypeId = HirModule::add_type(mut_of(deref(c).hir), t);
  let kind: SymKind = SymKind::BuiltinTy { tid };
  Scope::define(mut_of(deref(c).globals), name, kind, sp);
  return tid;
};

let seed_builtins = func(c: Mut(Ctx), sp: Span) !{ OomErr, SemaFail } {
  c.void_tid = add_named(c, "()", HirType::Void, sp);
  c.bool_tid = add_named(c, "bool", HirType::Bool, sp);
  c.u8_tid = add_named(c, "u8", HirType::Int { IntInfo { bits: 8, signed: false } }, sp);
  add_named(c, "u16", HirType::Int { IntInfo { bits: 16, signed: false } }, sp);
  add_named(c, "u32", HirType::Int { IntInfo { bits: 32, signed: false } }, sp);
  c.u64_tid = add_named(c, "u64", HirType::Int { IntInfo { bits: 64, signed: false } }, sp);
  add_named(c, "i8", HirType::Int { IntInfo { bits: 8, signed: true } }, sp);
  add_named(c, "i16", HirType::Int { IntInfo { bits: 16, signed: true } }, sp);
  add_named(c, "i32", HirType::Int { IntInfo { bits: 32, signed: true } }, sp);
  c.i64_tid = add_named(c, "i64", HirType::Int { IntInfo { bits: 64, signed: true } }, sp);
  add_named(c, "f32", HirType::Float { 32 }, sp);
  add_named(c, "f64", HirType::Float { 64 }, sp);
  add_named(c, "Never", HirType::HirNever, sp);
  c.type_tid = add_named(c, "Type", HirType::TypeMeta, sp);
  c.mod_tid = add_named(c, "Module", HirType::TypeMeta, sp);
  c.sig_tid = add_named(c, "Sig", HirType::TypeMeta, sp);
  c.eff_tid = add_named(c, "Effect", HirType::TypeMeta, sp);
  let ti_fstart: u32 = c.hir.fields.len() as u32;
  HirModule::add_field(mut_of(deref(c).hir), FieldInfo { name: "size", ty: c.u64_tid, offset: 0 });
  HirModule::add_field(mut_of(deref(c).hir), FieldInfo { name: "align", ty: c.u64_tid, offset: 8 });
  HirModule::add_field(mut_of(deref(c).hir), FieldInfo { name: "has_drop", ty: c.bool_tid, offset: 16 });
  HirModule::add_field(mut_of(deref(c).hir), FieldInfo { name: "kind_tag", ty: c.u64_tid, offset: 24 });
  let ti_sidx: u32 = HirModule::add_struct(mut_of(deref(c).hir), StructInfo {
    name: "TypeInfo",
    fields: HirRange { start: ti_fstart, len: 4 },
    size: 32,
    align: 8
  });
  let ti_tid: TypeId = HirModule::add_type(mut_of(deref(c).hir), HirType::Struct { ti_sidx });
  deref(c).struct_tys.push(ti_tid);
  Scope::define(mut_of(deref(c).globals), "TypeInfo", SymKind::StructDef { ti_sidx }, sp);
  c.type_info_sidx = ti_sidx;
  c.type_info_tid = ti_tid;
};

let flatten_decls = func(ast: Ref(AstModule()), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let top: IdRange = ast.top_decls;
  let i: u64 = 0;
  while i < (top.len as u64) {
    let did: DeclId = ast.decl_lists.get((top.start as u64) + i);
    c.decls.push(FlatDecl { id: did.idx, is_pub: false });
    i = i + 1;
  };
  let cursor: u64 = 0;
  while cursor < c.decls.len() {
    let fd: FlatDecl = c.decls.get(cursor);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      PubBlock(r) => {
        let j: u64 = 0;
        while j < (r.len as u64) {
          let cid: DeclId = ast.decl_lists.get((r.start as u64) + j);
          c.decls.push(FlatDecl { id: cid.idx, is_pub: true });
          j = j + 1;
        };
      },
      _ => {},
    };
    cursor = cursor + 1;
  };
};

let intern = func(c: Mut(Ctx), t: HirType) !{ OomErr } -> TypeId {
  let n: u64 = c.hir.types.len();
  let i: u64 = 0;
  let hit: bool = false;
  let at: u32 = 0;
  while (i < n) and (hit == false) {
    let cur: HirType = c.hir.types.get(i);
    if same_hir_type(cur, t) {
      hit = true;
      at = i as u32;
    }
    i = i + 1;
  };
  if hit {
    return TypeId { idx: at };
  }
  return HirModule::add_type(mut_of(deref(c).hir), t);
};

let struct_tid = func(c: Mut(Ctx), idx: u32) -> TypeId {
  return c.struct_tys.get(idx as u64);
};

let struct_size = func(c: Mut(Ctx), idx: u32) -> u32 {
  let st: StructInfo = HirModule::struct_at(ref_of(deref(c).hir), idx);
  return st.size;
};

let struct_align = func(c: Mut(Ctx), idx: u32) -> u32 {
  let st: StructInfo = HirModule::struct_at(ref_of(deref(c).hir), idx);
  return st.align;
};

let enum_tid = func(c: Mut(Ctx), idx: u32) -> TypeId {
  return c.enum_tys.get(idx as u64);
};

let enum_size = func(c: Mut(Ctx), idx: u32) -> u32 {
  let en: EnumInfo = HirModule::enum_at(ref_of(deref(c).hir), idx);
  return en.size;
};

let enum_align = func(c: Mut(Ctx), idx: u32) -> u32 {
  let en: EnumInfo = HirModule::enum_at(ref_of(deref(c).hir), idx);
  return en.align;
};

let type_size = func(c: Mut(Ctx), t: TypeId) -> u32 {
  let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), t);
  return match ht {
    Void => 0,
    Bool => 1,
    Int(ii) => (ii.bits as u32) / 8,
    Float(w) => (w as u32) / 8,
    Ref(_) => 8,
    Mut(_) => 8,
    Struct(idx) => struct_size(c, idx),
    Enum(idx) => enum_size(c, idx),
    Fn(_) => 8,
    HirNever => 0,
    TypeMeta => 0,
  };
};

let type_align = func(c: Mut(Ctx), t: TypeId) -> u32 {
  let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), t);
  return match ht {
    Void => 1,
    Bool => 1,
    Int(ii) => (ii.bits as u32) / 8,
    Float(w) => (w as u32) / 8,
    Ref(_) => 8,
    Mut(_) => 8,
    Struct(idx) => struct_align(c, idx),
    Enum(idx) => enum_align(c, idx),
    Fn(_) => 8,
    HirNever => 1,
    TypeMeta => 1,
  };
};

let strip_refs = func(c: Mut(Ctx), t: TypeId) -> TypeId {
  let cur: TypeId = t;
  let done: bool = false;
  while done == false {
    let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), cur);
    match ht {
      Ref(inner) => {
        cur = inner;
      },
      Mut(inner) => {
        cur = inner;
      },
      _ => {
        done = true;
      },
    };
  };
  return cur;
};

let struct_index = func(c: Mut(Ctx), t: TypeId) -> Option(u32) {
  let core: TypeId = strip_refs(c, t);
  let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), core);
  return match ht {
    Struct(idx) => Option(u32)::some(idx),
    _ => Option(u32)::none(),
  };
};

let fn_index = func(c: Mut(Ctx), t: TypeId) -> Option(u32) {
  let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), t);
  return match ht {
    Fn(idx) => Option(u32)::some(idx),
    _ => Option(u32)::none(),
  };
};

let same_type = func(c: Mut(Ctx), a: TypeId, b: TypeId) -> bool {
  if a.idx == b.idx {
    return true;
  }
  let ta: HirType = HirModule::type_at(ref_of(deref(c).hir), a);
  let tb: HirType = HirModule::type_at(ref_of(deref(c).hir), b);
  return same_hir_type(ta, tb);
};

let expr_ty = func(c: Mut(Ctx), id: HirExprId) -> TypeId {
  let e: HirExpr = HirModule::expr_at(ref_of(deref(c).hir), id);
  return e.ty;
};

let mk = func(c: Mut(Ctx), kind: HirExprKind, ty: TypeId, sp: Span) !{ OomErr } -> HirExprId {
  let e: HirExpr = HirExpr { kind: kind, ty: ty, span: sp };
  return HirModule::add_expr(mut_of(deref(c).hir), e);
};

let void_expr = func(c: Mut(Ctx), sp: Span) !{ OomErr } -> HirExprId {
  let blk: HirBlock = HirBlock { stmts: HirRange { start: 0, len: 0 }, tail: Option(HirExprId)::none() };
  return mk(c, HirExprKind::Block { blk }, c.void_tid, sp);
};

let module_self_tid = func(c: Mut(Ctx), midx: u32, sp: Span) !{ OomErr, SemaFail } -> TypeId {
  let mi: Ref(ModuleDefInfo) = deref(c).modules.get_ref(midx as u64);
  let has_self: bool = false;
  let stid: TypeId = TypeId { idx: 0 };
  match mi.self_tid {
    Some(t) => { stid = t; has_self = true; },
    None => {},
  };
  if has_self {
    return stid;
  }
  return fail_type(SemaErr::TypeMismatch(sp));
};

let named_tid = func(c: Mut(Ctx), e: SymEntry, sp: Span) !{ OomErr, SemaFail } -> TypeId {
  let tid: TypeId = match e.kind {
    BuiltinTy(t) => t,
    StructDef(idx) => struct_tid(c, idx),
    EnumDef(idx) => enum_tid(c, idx),
    ModuleDef(midx) => module_self_tid(c, midx, sp),
    _ => fail_type(SemaErr::TypeMismatch(sp)),
  };
  return tid;
};

let lookup_type_sym = func(c: Mut(Ctx), name: Slice(u8)) -> Option(SymEntry) {
  let tfound: Option(SymEntry) = Scope::lookup(ref_of(deref(c).type_params), name);
  match tfound {
    Some(te) => { return Option(SymEntry)::some(te); },
    None => {},
  };
  let has_mod: bool = false;
  let cur_m: u32 = 0;
  match deref(c).cur_mod {
    Some(mi) => { cur_m = mi; has_mod = true; },
    None => {},
  };
  if has_mod {
    let mfound: Option(SymEntry) = mod_lookup(c, cur_m, name);
    match mfound {
      Some(me) => { return Option(SymEntry)::some(me); },
      None => {},
    };
  }
  return Scope::lookup(ref_of(deref(c).globals), name);
};

let lookup_value_sym = func(c: Mut(Ctx), name: Slice(u8)) -> Option(SymEntry) {
  let lfound: Option(SymEntry) = Scope::lookup(ref_of(deref(c).locals), name);
  match lfound {
    Some(le) => { return Option(SymEntry)::some(le); },
    None => {},
  };
  return lookup_type_sym(c, name);
};

let resolve_path_sym = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), r: IdRange) -> Option(SymEntry) {
  if r.len == 0 {
    return Option(SymEntry)::none();
  }
  let seg0: Slice(u8) = Span::slice(ast.path_segs.get(r.start as u64), text);
  let cur: Option(SymEntry) = if r.len == 1 {
    lookup_value_sym(c, seg0)
  } else {
    lookup_type_sym(c, seg0)
  };
  let i: u64 = 1;
  while i < (r.len as u64) {
    let seg: Slice(u8) = Span::slice(ast.path_segs.get((r.start as u64) + i), text);
    let next: Option(SymEntry) = Option(SymEntry)::none();
    match cur {
      Some(ent) => {
        match ent.kind {
          ModuleDef(mi) => {
            next = mod_lookup(c, mi, seg);
          },
          _ => {},
        };
      },
      None => {},
    };
    cur = next;
    i = i + 1;
  };
  return cur;
};

let resolve_effect_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), e: ExprId) -> Option(u32) {
  let ex: Expr = ast.exprs.get(e.idx as u64);
  let ent_opt: Option(SymEntry) = match ex {
    Ident(nsp) => lookup_type_sym(c, Span::slice(nsp, text)),
    Path(r) => resolve_path_sym(ast, text, c, r),
    _ => Option(SymEntry)::none(),
  };
  let out: Option(u32) = Option(u32)::none();
  match ent_opt {
    Some(ent) => {
      match ent.kind {
        EffectDef(eidx) => { out = Option(u32)::some(eidx); },
        _ => {},
      };
    },
    None => {},
  };
  return out;
};

let find_effect_op = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), eidx: u32, op_name: Slice(u8)) -> Option(u32) {
  let ed: EffectDefInfo = deref(c).effects.get(eidx as u64);
  let i: u64 = 0;
  while i < (ed.ops.len as u64) {
    let op: EffectOp = ast.effect_ops.get((ed.ops.start as u64) + i);
    if eq(Span::slice(op.name, text), op_name) {
      return Option(u32)::some(i as u32);
    }
    i = i + 1;
  };
  return Option(u32)::none();
};

let type_from_name = func(c: Mut(Ctx), name: Slice(u8), sp: Span) !{ OomErr, SemaFail } -> TypeId {
  let found: Option(SymEntry) = lookup_type_sym(c, name);
  let tid: TypeId = match found {
    Some(e) => named_tid(c, e, sp),
    None => fail_type(SemaErr::UnknownIdent(sp)),
  };
  return tid;
};

let path_tid = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), r: IdRange, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> TypeId
{
  if r.len == 0 {
    return fail_type(SemaErr::Unsupported(sp));
  }
  if r.len >= 2 {
    let seg0: Span = ast.path_segs.get(r.start as u64);
    let head_name: Slice(u8) = Span::slice(seg0, text);
    let found0: Option(SymEntry) = lookup_type_sym(c, head_name);
    let is_mod: bool = false;
    let midx: u32 = 0;
    match found0 {
      Some(e0) => {
        match e0.kind {
          ModuleDef(mi) => { midx = mi; is_mod = true; },
          _ => {},
        };
      },
      None => {},
    };
    if is_mod {
      let cur_m: u32 = midx;
      let si: u64 = 1;
      while si + 1 < (r.len as u64) {
        let sseg: Span = ast.path_segs.get((r.start as u64) + si);
        let sname: Slice(u8) = Span::slice(sseg, text);
        let sub_opt: Option(SymEntry) = mod_lookup(c, cur_m, sname);
        let sub_ok: bool = false;
        match sub_opt {
          Some(se) => {
            match se.kind {
              ModuleDef(next_m) => { cur_m = next_m; sub_ok = true; },
              _ => {},
            };
          },
          None => {},
        };
        if sub_ok == false {
          return fail_type(SemaErr::UnknownIdent(sseg));
        }
        si = si + 1;
      };
      let last_seg: Span = ast.path_segs.get((r.start as u64) + (r.len as u64) - 1);
      let last_name: Slice(u8) = Span::slice(last_seg, text);
      let mem_opt: Option(SymEntry) = mod_lookup(c, cur_m, last_name);
      let has_mem: bool = false;
      let mem_e: SymEntry = SymEntry { name: blank(), kind: SymKind::ConstVal { 0 }, depth: 0, pad: 0 };
      match mem_opt {
        Some(me) => { mem_e = me; has_mem = true; },
        None => {},
      };
      if has_mem {
        return named_tid(c, mem_e, sp);
      }
      return fail_type(SemaErr::UnknownIdent(last_seg));
    }
  }
  return type_from_name(c, Span::slice(span_at(ast, r), text), sp);
};

let unit_type = func(c: Mut(Ctx), se: StructExpr, sp: Span) !{ OomErr, SemaFail } -> TypeId {
  let tid: TypeId = if se.fields.len == 0 {
    c.void_tid
  } else {
    fail_type(SemaErr::Unsupported(sp))
  };
  return tid;
};

let wrap_tag = func(name: Slice(u8)) -> u8 {
  if eq(name, "Ref") {
    return 1;
  }
  if eq(name, "Mut") {
    return 2;
  }
  return 0;
};

let wrap_type = func(tag: u8, inner: TypeId) -> HirType {
  if tag == 1 {
    return HirType::Ref { inner };
  }
  return HirType::Mut { inner };
};

let ident_name = func(ex: Expr, text: Slice(u8)) -> Slice(u8) {
  return match ex {
    Ident(nsp) => Span::slice(nsp, text),
    _ => blank(),
  };
};

let is_type_param_expr = func(ast: Ref(AstModule()), text: Slice(u8), e: ExprId) ?{ al: Allocator = SystemAlloc } -> bool {
  let ex: Expr = ast.exprs.get(e.idx as u64);
  return match ex {
    Ident(sp) => {
      let w: Slice(u8) = Span::slice(sp, text);
      eq(w, "Type") or eq(w, "Module") or eq(w, "Sig") or eq(w, "Effect")
    },
    _ => false,
  };
};

let find_generic_ty_inst = func(c: Mut(Ctx), gidx: u32, tids: Ref(TypeIdVec::Self)) -> Option(TypeId) {
  let n: u64 = deref(c).generic_ty_insts.len();
  let i: u64 = 0;
  while i < n {
    let inst: GenericTyInst = deref(c).generic_ty_insts.get(i);
    if (inst.gidx == gidx) and ((inst.args_len as u64) == TypeIdVec::len(tids)) {
      let ok: bool = true;
      let j: u64 = 0;
      while (j < TypeIdVec::len(tids)) and ok {
        let a: TypeId = deref(c).generic_type_args.get((inst.args_start as u64) + j);
        let b: TypeId = TypeIdVec::get(tids, j);
        if a.idx != b.idx {
          ok = false;
        }
        j = j + 1;
      };
      if ok {
        return Option(TypeId)::some(inst.ty_id);
      }
    }
    i = i + 1;
  };
  return Option(TypeId)::none();
};

let record_type_args = func(c: Mut(Ctx), tids: Ref(TypeIdVec::Self)) !{ OomErr } -> u32 {
  let start: u32 = deref(c).generic_type_args.len() as u32;
  let i: u64 = 0;
  while i < TypeIdVec::len(tids) {
    deref(c).generic_type_args.push(TypeIdVec::get(tids, i));
    i = i + 1;
  };
  return start;
};

let extract_returned_expr = func(ast: Ref(AstModule()), body: ExprId, ok: Mut(bool)) -> ExprId {
  let ex: Expr = ast.exprs.get(body.idx as u64);
  let out: ExprId = body;
  let found: bool = false;
  let is_blk: bool = false;
  let blk: BlockExpr = BlockExpr { stmts: IdRange { start: 0, len: 0 }, tail: Option(ExprId)::none() };
  match ex {
    Block(b) => {
      blk = b;
      is_blk = true;
    },
    _ => {
      found = true;
    },
  };
  if is_blk {
    match blk.tail {
      Some(t) => {
        out = t;
        found = true;
      },
      None => {},
    };
    if (found == false) and (blk.stmts.len > 0) {
      let last_sid: StmtId = ast.stmt_lists.get((blk.stmts.start as u64) + (blk.stmts.len as u64) - 1);
      let st: Stmt = ast.stmts.get(last_sid.idx as u64);
      let ret_opt: Option(ExprId) = Option(ExprId)::none();
      match st {
        Return(r) => { ret_opt = r; },
        _ => {},
      };
      match ret_opt {
        Some(rv) => {
          out = rv;
          found = true;
        },
        None => {},
      };
    }
  }
  deref(ok) = found;
  return out;
};

let resolve_type = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), e: ExprId, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> TypeId
{
  let wrappers: Vec(u8) = Vec(u8)::new();
  let cur: ExprId = e;
  let tid: TypeId = TypeId { idx: 0 };
  let done: bool = false;
  let steps: u32 = 0;
  while (done == false) and (steps < 64) {
    steps = steps + 1;
    let ex: Expr = ast.exprs.get(cur.idx as u64);
    match ex {
      Ident(nsp) => {
        tid = type_from_name(c, Span::slice(nsp, text), sp);
        done = true;
      },
      Path(r) => {
        tid = path_tid(ast, text, c, r, sp);
        done = true;
      },
      Struct(se) => {
        tid = unit_type(c, se, sp);
        done = true;
      },
      Field(f) => {
        let mopt: Option(u32) = resolve_module_expr(ast, text, c, f.base, sp);
        let has_m: bool = false;
        let midx: u32 = 0;
        match mopt {
          Some(mi) => { midx = mi; has_m = true; },
          None => {},
        };
        if has_m {
          let fname: Slice(u8) = Span::slice(f.field, text);
          let mem_opt: Option(SymEntry) = mod_lookup(c, midx, fname);
          let has_mem: bool = false;
          let mem_e: SymEntry = SymEntry { name: blank(), kind: SymKind::ConstVal { 0 }, depth: 0, pad: 0 };
          match mem_opt {
            Some(me) => { mem_e = me; has_mem = true; },
            None => {},
          };
          if has_mem {
            tid = named_tid(c, mem_e, sp);
          } else {
            tid = fail_type(SemaErr::UnknownIdent(f.field));
          }
        } else {
          tid = fail_type(SemaErr::Unsupported(sp));
        }
        done = true;
      },
      Call(call) => {
        let callee: Expr = ast.exprs.get(call.callee.idx as u64);
        let cname: Slice(u8) = ident_name(callee, text);
        let tag: u8 = wrap_tag(cname);
        if (tag != 0) and (call.args.len == 1) {
          wrappers.push(tag);
          cur = ast.expr_lists.get(call.args.start as u64);
        } else {
          let gfound: Option(SymEntry) = Scope::lookup(ref_of(deref(c).globals), cname);
          let has_g: bool = false;
          let gidx_val: u32 = 0;
          match gfound {
            Some(ge) => {
              match ge.kind {
                GenericFn(gi) => {
                  has_g = true;
                  gidx_val = gi;
                },
                _ => {},
              };
            },
            None => {},
          };
          if has_g {
            if is_module_ret_fn(ast, text, c, gidx_val) {
              let midx: u32 = instantiate_generic_module(ast, text, c, gidx_val, call, sp);
              tid = module_self_tid(c, midx, sp);
            } else {
              tid = instantiate_generic_type(ast, text, c, gidx_val, call, sp);
            }
            done = true;
          } else {
            tid = fail_type(SemaErr::Unsupported(sp));
            done = true;
          }
        }
      },
      _ => {
        tid = fail_type(SemaErr::Unsupported(sp));
        done = true;
      },
    };
  };
  if (done == false) or (steps >= 64) {
    tid = fail_type(SemaErr::Unsupported(sp));
  } else {
    while wrappers.len() > 0 {
      let n: u64 = wrappers.len();
      let tag: u8 = wrappers.get(n - 1);
      wrappers.truncate(n - 1);
      tid = intern(c, wrap_type(tag, tid));
    };
  }
  return tid;
};

let layout_struct = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), idx: u32, se: StructExpr)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let start: u32 = c.hir.fields.len() as u32;
  let off: u32 = 0;
  let max_align: u32 = 1;
  let i: u64 = 0;
  while i < (se.fields.len as u64) {
    let fdef: FieldDef = ast.fields.get((se.fields.start as u64) + i);
    let tid: TypeId = resolve_type(ast, text, c, fdef.ty, fdef.span);
    let fa: u32 = type_align(c, tid);
    let fsz: u32 = type_size(c, tid);
    if fa > max_align {
      max_align = fa;
    }
    off = align_up(off as u64, fa as u64) as u32;
    let fname: Slice(u8) = Span::slice(fdef.name, text);
    HirModule::add_field(mut_of(deref(c).hir), FieldInfo { name: fname, ty: tid, offset: off });
    off = off + fsz;
    i = i + 1;
  };
  let total: u32 = align_up(off as u64, max_align as u64) as u32;
  let used: u32 = (c.hir.fields.len() as u32) - start;
  HirModule::set_struct_layout(mut_of(deref(c).hir), idx, HirRange { start: start, len: used }, total, max_align);
};

let declare_structs = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let idx: u32 = c.hir.structs.len() as u32;
  let i: u64 = 0;
  while i < c.decls.len() {
    let fd: FlatDecl = c.decls.get(i);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          Struct(_) => {
            let name: Slice(u8) = Span::slice(ld.name, text);
            let sp: Span = ast.decl_spans.get(fd.id as u64);
            let st: StructInfo = StructInfo { name: name, fields: HirRange { start: 0, len: 0 }, size: 0, align: 1 };
            let idx: u32 = HirModule::add_struct(mut_of(deref(c).hir), st);
            let tid: TypeId = HirModule::add_type(mut_of(deref(c).hir), HirType::Struct { idx });
            c.struct_tys.push(tid);
            let kind: SymKind = SymKind::StructDef { idx };
            Scope::define(mut_of(deref(c).globals), name, kind, sp);
          },
          _ => {},
        };
      },
      _ => {},
    };
    i = i + 1;
  };
  let k: u64 = 0;
  while k < c.decls.len() {
    let fd2: FlatDecl = c.decls.get(k);
    let d2: Decl = ast.decls.get(fd2.id as u64);
    match d2 {
      Let(ld2) => {
        let init2: Expr = ast.exprs.get(ld2.init.idx as u64);
        match init2 {
          Struct(se) => {
            layout_struct(ast, text, c, idx, se);
            idx = idx + 1;
          },
          _ => {},
        };
      },
      _ => {},
    };
    k = k + 1;
  };
};

let variant_tag = func(ast: Ref(AstModule()), text: Slice(u8), vd: VariantDef, i: u64) !{ SemaFail } -> u64 {
  let tag: u64 = i;
  match vd.discrim {
    Some(de) => {
      let dx: Expr = ast.exprs.get(de.idx as u64);
      match dx {
        Lit(lk) => {
          let is_int: bool = match lk {
            Int => true,
            _ => false,
          };
          let dsp: Span = ast.expr_spans.get(de.idx as u64);
          let parsed: Option(i64) = if is_int { parse_i64(Span::slice(dsp, text)) } else { Option(i64)::none() };
          match parsed {
            Some(v) => {
              tag = v as u64;
            },
            None => {
              tag = fail_u64(SemaErr::TypeMismatch(vd.span));
            },
          };
        },
        _ => {
          tag = fail_u64(SemaErr::Unsupported(vd.span));
        },
      };
    },
    None => {},
  };
  return tag;
};

let layout_enum = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), idx: u32, ee: EnumExpr)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let start: u32 = c.hir.variants.len() as u32;
  let max_p_size: u32 = 0;
  let max_p_align: u32 = 1;
  let tagged: bool = false;
  let i: u64 = 0;
  while i < (ee.variants.len as u64) {
    let vd: VariantDef = ast.variants.get((ee.variants.start as u64) + i);
    let vname: Slice(u8) = Span::slice(vd.name, text);
    let tag_val: u64 = variant_tag(ast, text, vd, i);
    let pty: TypeId = c.void_tid;
    let has_payload: bool = false;
    match vd.payload {
      Some(pe) => {
        pty = resolve_type(ast, text, c, pe, vd.span);
        has_payload = true;
        let psz: u32 = type_size(c, pty);
        let pal: u32 = type_align(c, pty);
        if psz > max_p_size {
          max_p_size = psz;
        }
        if pal > max_p_align {
          max_p_align = pal;
        }
        tagged = true;
      },
      None => {},
    };
    let vi: VariantInfo = VariantInfo { name: vname, payload_ty: pty, has_payload: has_payload, tag_val: tag_val };
    HirModule::add_variant(mut_of(deref(c).hir), vi);
    i = i + 1;
  };
  let used: u32 = (c.hir.variants.len() as u32) - start;
  let tag_size: u32 = 8;
  let payload_off: u32 = 0;
  let size: u32 = 8;
  let align: u32 = 8;
  if tagged {
    payload_off = 8;
    align = max_p_align;
    if align < 8 {
      align = 8;
    }
    size = align_up(8 + max_p_size, align) as u32;
  }
  HirModule::set_enum_layout(mut_of(deref(c).hir), idx, HirRange { start: start, len: used }, tag_size, payload_off, size, align, tagged);
};

let instantiate_generic_type = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), gidx: u32, call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> TypeId
{
  let gf: GenericFnDef = deref(c).generic_fns.get(gidx as u64);
  let gd: Decl = ast.decls.get(gf.decl_id as u64);
  let has_ld: bool = false;
  let gld: LetDecl = LetDecl { is_pub: false, name: sp, ty: Option(ExprId)::none(), init: ExprId { idx: 0 } };
  match gd {
    Let(x) => { gld = x; has_ld = true; },
    _ => {},
  };
  if has_ld == false {
    return fail_type(SemaErr::Unsupported(sp));
  }
  let gex: Expr = ast.exprs.get(gld.init.idx as u64);
  let has_fe: bool = false;
  let gfe: FuncExpr = FuncExpr {
    params: IdRange { start: 0, len: 0 },
    witnesses: IdRange { start: 0, len: 0 },
    ret_ty: Option(ExprId)::none(),
    effects: IdRange { start: 0, len: 0 },
    body: ExprId { idx: 0 }
  };
  match gex {
    Func(x) => { gfe = x; has_fe = true; },
    _ => {},
  };
  if has_fe == false {
    return fail_type(SemaErr::Unsupported(sp));
  }
  if call.args.len != gfe.params.len {
    return fail_type(SemaErr::ArityMismatch(sp));
  }
  let tbase: u64 = deref(c).tid_buf.len();
  let bad_args: bool = false;
  let pi: u64 = 0;
  while (pi < (gfe.params.len as u64)) and (bad_args == false) {
    let p: Param = ast.params.get((gfe.params.start as u64) + pi);
    if is_type_param_expr(ast, text, p.ty) == false {
      bad_args = true;
    } else {
      let aex: ExprId = ast.expr_lists.get((call.args.start as u64) + pi);
      let atid: TypeId = resolve_type(ast, text, c, aex, sp);
      deref(c).tid_buf.push(atid);
    }
    pi = pi + 1;
  };
  let tcount: u64 = deref(c).tid_buf.len() - tbase;
  if bad_args {
    deref(c).tid_buf.truncate(tbase);
    return fail_type(SemaErr::Unsupported(sp));
  }
  let has_cached: bool = false;
  let cached_tid: TypeId = TypeId { idx: 0 };
  let c_i: u64 = 0;
  while c_i < deref(c).generic_ty_insts.len() {
    let inst: GenericTyInst = deref(c).generic_ty_insts.get(c_i);
    if (inst.gidx == gidx) and ((inst.args_len as u64) == tcount) {
      let ok: bool = true;
      let c_j: u64 = 0;
      while (c_j < tcount) and ok {
        let a: TypeId = deref(c).generic_type_args.get((inst.args_start as u64) + c_j);
        let b: TypeId = deref(c).tid_buf.get(tbase + c_j);
        if a.idx != b.idx {
          ok = false;
        }
        c_j = c_j + 1;
      };
      if ok {
        has_cached = true;
        cached_tid = inst.ty_id;
      }
    }
    c_i = c_i + 1;
  };
  if has_cached {
    deref(c).tid_buf.truncate(tbase);
    return cached_tid;
  }
  Scope::push_scope(mut_of(deref(c).type_params));
  let bi: u64 = 0;
  while bi < tcount {
    let p: Param = ast.params.get((gfe.params.start as u64) + bi);
    let pname: Slice(u8) = Span::slice(p.name, text);
    let btid: TypeId = deref(c).tid_buf.get(tbase + bi);
    let bkind: SymKind = SymKind::BuiltinTy { btid };
    Scope::define(mut_of(deref(c).type_params), pname, bkind, p.span);
    bi = bi + 1;
  };
  let ret_ok: bool = false;
  let rex: ExprId = extract_returned_expr(ast, gfe.body, mut_of(ret_ok));
  let res_tid: TypeId = TypeId { idx: 0 };
  if ret_ok == false {
    Scope::pop_scope(mut_of(deref(c).type_params));
    deref(c).tid_buf.truncate(tbase);
    return fail_type(SemaErr::Unsupported(sp));
  }
  let rnode: Expr = ast.exprs.get(rex.idx as u64);
  match rnode {
    Struct(se) => {
      let sname: Slice(u8) = Span::slice(gld.name, text);
      let sidx: u32 = HirModule::add_struct(mut_of(deref(c).hir), StructInfo {
        name: sname,
        fields: HirRange { start: 0, len: 0 },
        size: 0,
        align: 1
      });
      res_tid = HirModule::add_type(mut_of(deref(c).hir), HirType::Struct { sidx });
      deref(c).struct_tys.push(res_tid);
      let astart: u32 = deref(c).generic_type_args.len() as u32;
      let r_i: u64 = 0;
      while r_i < tcount {
        deref(c).generic_type_args.push(deref(c).tid_buf.get(tbase + r_i));
        r_i = r_i + 1;
      };
      deref(c).generic_ty_insts.push(GenericTyInst {
        gidx: gidx,
        args_start: astart,
        args_len: tcount as u32,
        ty_id: res_tid
      });
      layout_struct(ast, text, c, sidx, se);
    },
    Enum(ee) => {
      let ename: Slice(u8) = Span::slice(gld.name, text);
      let eidx: u32 = HirModule::add_enum(mut_of(deref(c).hir), EnumInfo {
        name: ename,
        variants: HirRange { start: 0, len: 0 },
        tag_size: 8,
        payload_off: 0,
        size: 8,
        align: 8,
        is_tagged_union: false
      });
      res_tid = HirModule::add_type(mut_of(deref(c).hir), HirType::Enum { eidx });
      deref(c).enum_tys.push(res_tid);
      let astart: u32 = deref(c).generic_type_args.len() as u32;
      let r_i: u64 = 0;
      while r_i < tcount {
        deref(c).generic_type_args.push(deref(c).tid_buf.get(tbase + r_i));
        r_i = r_i + 1;
      };
      deref(c).generic_ty_insts.push(GenericTyInst {
        gidx: gidx,
        args_start: astart,
        args_len: tcount as u32,
        ty_id: res_tid
      });
      layout_enum(ast, text, c, eidx, ee);
    },
    _ => {
      res_tid = resolve_type(ast, text, c, rex, sp);
    },
  };
  Scope::pop_scope(mut_of(deref(c).type_params));
  deref(c).tid_buf.truncate(tbase);
  return res_tid;
};

let declare_enums = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let idx: u32 = c.hir.enums.len() as u32;
  let i: u64 = 0;
  while i < c.decls.len() {
    let fd: FlatDecl = c.decls.get(i);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          Enum(_) => {
            let name: Slice(u8) = Span::slice(ld.name, text);
            let sp: Span = ast.decl_spans.get(fd.id as u64);
            let en: EnumInfo = EnumInfo {
              name: name,
              variants: HirRange { start: 0, len: 0 },
              tag_size: 8,
              payload_off: 0,
              size: 8,
              align: 8,
              is_tagged_union: false
            };
            let idx: u32 = HirModule::add_enum(mut_of(deref(c).hir), en);
            let tid: TypeId = HirModule::add_type(mut_of(deref(c).hir), HirType::Enum { idx });
            deref(c).enum_tys.push(tid);
            let kind: SymKind = SymKind::EnumDef { idx };
            Scope::define(mut_of(deref(c).globals), name, kind, sp);
          },
          _ => {},
        };
      },
      _ => {},
    };
    i = i + 1;
  };
  let k: u64 = 0;
  while k < c.decls.len() {
    let fd2: FlatDecl = c.decls.get(k);
    let d2: Decl = ast.decls.get(fd2.id as u64);
    match d2 {
      Let(ld2) => {
        let init2: Expr = ast.exprs.get(ld2.init.idx as u64);
        match init2 {
          Enum(ee) => {
            layout_enum(ast, text, c, idx, ee);
            idx = idx + 1;
          },
          _ => {},
        };
      },
      _ => {},
    };
    k = k + 1;
  };
};

let has_type_param = func(ast: Ref(AstModule()), text: Slice(u8), fe: FuncExpr) ?{ al: Allocator = SystemAlloc } -> bool {
  let pi: u64 = 0;
  while pi < (fe.params.len as u64) {
    let p: Param = ast.params.get((fe.params.start as u64) + pi);
    if is_type_param_expr(ast, text, p.ty) {
      return true;
    }
    pi = pi + 1;
  };
  return false;
};

let declare_fn = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), fd: FlatDecl, ld: LetDecl, fe: FuncExpr)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> bool
{
  let name: Slice(u8) = Span::slice(ld.name, text);
  let sp: Span = ast.decl_spans.get(fd.id as u64);
  if has_type_param(ast, text, fe) {
    let gidx: u32 = deref(c).generic_fns.len() as u32;
    deref(c).generic_fns.push(GenericFnDef { decl_id: fd.id, is_pub: fd.is_pub or ld.is_pub });
    Scope::define(mut_of(deref(c).globals), name, SymKind::GenericFn { gidx }, sp);
    return true;
  }
  let ret: TypeId = c.void_tid;
  match fe.ret_ty {
    Some(re) => {
      ret = resolve_type(ast, text, c, re, sp);
    },
    None => {},
  };
  let fn_idx: u32 = c.hir.fns.len() as u32;
  HirModule::add_type(mut_of(deref(c).hir), HirType::Fn { fn_idx });
  let pstart: u32 = c.hir.params.len() as u32;
  let pi: u64 = 0;
  while pi < (fe.params.len as u64) {
    let p: Param = ast.params.get((fe.params.start as u64) + pi);
    let ptid: TypeId = resolve_type(ast, text, c, p.ty, p.span);
    let pname: Slice(u8) = Span::slice(p.name, text);
    let item: HirParam = HirParam { name: pname, ty: ptid, local: HirLocalId { idx: 0 } };
    HirModule::add_param(mut_of(deref(c).hir), item);
    pi = pi + 1;
  };
  let used: u32 = (c.hir.params.len() as u32) - pstart;
  let f: HirFn = HirFn {
    name: name,
    is_pub: fd.is_pub or ld.is_pub,
    params: HirRange { start: pstart, len: used },
    locals: HirRange { start: 0, len: 0 },
    ret_ty: ret,
    body: HirExprId { idx: 0 },
    span: sp
  };
    let fid: HirFnId = HirModule::add_fn(mut_of(deref(c).hir), f);
  let kind: SymKind = SymKind::Func { fid };
  Scope::define(mut_of(deref(c).globals), name, kind, sp);
  record_fn_effects(ast, text, c, fe.effects);
  return false;
};

let declare_fns = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let i: u64 = 0;
  while i < c.decls.len() {
    let fd: FlatDecl = c.decls.get(i);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          Func(fe) => {
            let is_gen: bool = declare_fn(ast, text, c, fd, ld, fe);
            if is_gen == false {
              deref(c).fn_decls.push(fd);
              deref(c).fn_checked.push(false);
            }
          },
          Struct(_) => {},
          Enum(_) => {},
          ModuleLit(_) => {},
          SigLit(_) => {},
          EffectLit(_) => {},
          _ => {
            let cname: Slice(u8) = Span::slice(ld.name, text);
            let existing: Option(SymEntry) = Scope::lookup(ref_of(deref(c).globals), cname);
            let is_mod_alias: bool = false;
            match existing {
              Some(ee) => {
                match ee.kind {
                  ModuleDef(_) => { is_mod_alias = true; },
                  _ => {},
                };
              },
              None => {},
            };
            if is_mod_alias == false {
              let sp: Span = ast.decl_spans.get(fd.id as u64);
              let cidx: u32 = deref(c).consts.len() as u32;
              let cd: ConstDecl = ConstDecl { decl_id: fd.id, is_pub: fd.is_pub or ld.is_pub, evaluated: false, ty: TypeId { idx: 0 }, val: 0 };
              deref(c).consts.push(cd);
              let kind: SymKind = SymKind::ConstVal { cidx };
              Scope::define(mut_of(deref(c).globals), cname, kind, sp);
            }
          },
        };
      },
      _ => {},
    };
    i = i + 1;
  };
};

let flatten_mod_decls = func(ast: Ref(AstModule()), c: Mut(Ctx), r: IdRange) !{ OomErr } -> u64 {
  let base: u64 = deref(c).mod_decl_buf.len();
  let i: u64 = 0;
  while i < (r.len as u64) {
    let did: DeclId = ast.decl_lists.get((r.start as u64) + i);
    deref(c).mod_decl_buf.push(FlatDecl { id: did.idx, is_pub: false });
    i = i + 1;
  };
  let cur: u64 = base;
  while cur < deref(c).mod_decl_buf.len() {
    let fd: FlatDecl = deref(c).mod_decl_buf.get(cur);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      PubBlock(pr) => {
        let j: u64 = 0;
        while j < (pr.len as u64) {
          let cid: DeclId = ast.decl_lists.get((pr.start as u64) + j);
          deref(c).mod_decl_buf.push(FlatDecl { id: cid.idx, is_pub: true });
          j = j + 1;
        };
      },
      _ => {},
    };
    cur = cur + 1;
  };
  return base;
};

let declare_mod_fn = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), midx: u32, fd: FlatDecl, ld: LetDecl, fe: FuncExpr)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirFnId)
{
  let name: Slice(u8) = Span::slice(ld.name, text);
  let sp: Span = ast.decl_spans.get(fd.id as u64);
  if has_type_param(ast, text, fe) {
    let gidx: u32 = deref(c).generic_fns.len() as u32;
    deref(c).generic_fns.push(GenericFnDef { decl_id: fd.id, is_pub: fd.is_pub or ld.is_pub });
    mod_define(c, midx, name, SymKind::GenericFn { gidx });
    return Option(HirFnId)::none();
  }
  let ret: TypeId = c.void_tid;
  match fe.ret_ty {
    Some(re) => { ret = resolve_type(ast, text, c, re, sp); },
    None => {},
  };
  let fn_idx: u32 = c.hir.fns.len() as u32;
  HirModule::add_type(mut_of(deref(c).hir), HirType::Fn { fn_idx });
  let pstart: u32 = c.hir.params.len() as u32;
  let pi: u64 = 0;
  while pi < (fe.params.len as u64) {
    let p: Param = ast.params.get((fe.params.start as u64) + pi);
    let ptid: TypeId = resolve_type(ast, text, c, p.ty, p.span);
    let pname: Slice(u8) = Span::slice(p.name, text);
    HirModule::add_param(mut_of(deref(c).hir), HirParam { name: pname, ty: ptid, local: HirLocalId { idx: 0 } });
    pi = pi + 1;
  };
  let used: u32 = (c.hir.params.len() as u32) - pstart;
  let f: HirFn = HirFn {
    name: name,
    is_pub: false,
    params: HirRange { start: pstart, len: used },
    locals: HirRange { start: 0, len: 0 },
    ret_ty: ret,
    body: HirExprId { idx: 0 },
    span: sp
  };
  let fid: HirFnId = HirModule::add_fn(mut_of(deref(c).hir), f);
  deref(c).fn_decls.push(fd);
  deref(c).fn_checked.push(false);
  record_fn_effects(ast, text, c, fe.effects);
  mod_define(c, midx, name, SymKind::Func { fid });
  return Option(HirFnId)::some(fid);
};

let populate_module = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), midx: u32, r: IdRange, check_now: bool)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let saved_mod: Option(u32) = deref(c).cur_mod;
  deref(c).cur_mod = Option(u32)::some(midx);
  let base: u64 = flatten_mod_decls(ast, c, r);
  let end: u64 = deref(c).mod_decl_buf.len();

  let i: u64 = base;
  while i < end {
    let fd: FlatDecl = deref(c).mod_decl_buf.get(i);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let mname: Slice(u8) = Span::slice(ld.name, text);
        let msp: Span = ast.decl_spans.get(fd.id as u64);
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          Struct(_) => {
            let sidx: u32 = HirModule::add_struct(mut_of(deref(c).hir), StructInfo {
              name: mname,
              fields: HirRange { start: 0, len: 0 },
              size: 0,
              align: 1
            });
            let stid: TypeId = HirModule::add_type(mut_of(deref(c).hir), HirType::Struct { sidx });
            deref(c).struct_tys.push(stid);
            mod_define(c, midx, mname, SymKind::StructDef { sidx });
            if eq(mname, "Self") {
              let mslot: Mut(ModuleDefInfo) = deref(c).modules.get_mut(midx as u64);
              deref(mslot).self_tid = Option(TypeId)::some(stid);
            }
          },
          Enum(_) => {
            let eidx: u32 = HirModule::add_enum(mut_of(deref(c).hir), EnumInfo {
              name: mname,
              variants: HirRange { start: 0, len: 0 },
              tag_size: 8,
              payload_off: 0,
              size: 8,
              align: 8,
              is_tagged_union: false
            });
            let etid: TypeId = HirModule::add_type(mut_of(deref(c).hir), HirType::Enum { eidx });
            deref(c).enum_tys.push(etid);
            mod_define(c, midx, mname, SymKind::EnumDef { eidx });
            if eq(mname, "Self") {
              let mslot2: Mut(ModuleDefInfo) = deref(c).modules.get_mut(midx as u64);
              deref(mslot2).self_tid = Option(TypeId)::some(etid);
            }
          },
          EffectLit(er) => {
            let eidx: u32 = deref(c).effects.len() as u32;
            deref(c).effects.push(EffectDefInfo { name: mname, ops: er });
            mod_define(c, midx, mname, SymKind::EffectDef { eidx });
          },
          _ => {},
        };
      },
      _ => {},
    };
    i = i + 1;
  };

  let j: u64 = base;
  while j < end {
    let fd2: FlatDecl = deref(c).mod_decl_buf.get(j);
    let d2: Decl = ast.decls.get(fd2.id as u64);
    match d2 {
      Let(ld2) => {
        let mname2: Slice(u8) = Span::slice(ld2.name, text);
        let msp2: Span = ast.decl_spans.get(fd2.id as u64);
        let init2: Expr = ast.exprs.get(ld2.init.idx as u64);
        match init2 {
          Struct(se) => {
            let found_s: Option(SymEntry) = mod_lookup(c, midx, mname2);
            match found_s {
              Some(se_ent) => {
                match se_ent.kind {
                  StructDef(sidx) => { layout_struct(ast, text, c, sidx, se); },
                  _ => {},
                };
              },
              None => {},
            };
          },
          Enum(ee) => {
            let found_e: Option(SymEntry) = mod_lookup(c, midx, mname2);
            match found_e {
              Some(ee_ent) => {
                match ee_ent.kind {
                  EnumDef(eidx) => { layout_enum(ast, text, c, eidx, ee); },
                  _ => {},
                };
              },
              None => {},
            };
          },
          Ident(_) => {
            if eq(mname2, "Self") {
              let atid: TypeId = resolve_type(ast, text, c, ld2.init, msp2);
              mod_define(c, midx, "Self", SymKind::BuiltinTy { atid });
              let mslot3: Mut(ModuleDefInfo) = deref(c).modules.get_mut(midx as u64);
              deref(mslot3).self_tid = Option(TypeId)::some(atid);
            }
          },
          Path(_) => {
            if eq(mname2, "Self") {
              let atid2: TypeId = resolve_type(ast, text, c, ld2.init, msp2);
              mod_define(c, midx, "Self", SymKind::BuiltinTy { atid2 });
              let mslot4: Mut(ModuleDefInfo) = deref(c).modules.get_mut(midx as u64);
              deref(mslot4).self_tid = Option(TypeId)::some(atid2);
            }
          },
          Call(_) => {
            if eq(mname2, "Self") {
              let atid3: TypeId = resolve_type(ast, text, c, ld2.init, msp2);
              mod_define(c, midx, "Self", SymKind::BuiltinTy { atid3 });
              let mslot5: Mut(ModuleDefInfo) = deref(c).modules.get_mut(midx as u64);
              deref(mslot5).self_tid = Option(TypeId)::some(atid3);
            }
          },
          _ => {},
        };
      },
      _ => {},
    };
    j = j + 1;
  };

  let k: u64 = base;
  while k < end {
    let fd3: FlatDecl = deref(c).mod_decl_buf.get(k);
    let d3: Decl = ast.decls.get(fd3.id as u64);
    match d3 {
      Let(ld3) => {
        let init3: Expr = ast.exprs.get(ld3.init.idx as u64);
        match init3 {
          Func(fe) => {
            let fid_opt: Option(HirFnId) = declare_mod_fn(ast, text, c, midx, fd3, ld3, fe);
            match fid_opt {
              Some(fid) => {
                deref(c).mod_fns.push(ModFnEntry { fid: fid, decl_id: fd3.id, mod_idx: midx });
                if check_now {
                  let fslot: Mut(bool) = deref(c).fn_checked.get_mut(fid.idx as u64);
                  deref(fslot) = true;
                  let saved_locals: Scope = Scope::swap(mut_of(deref(c).locals), Scope::new());
                  let saved_ret: TypeId = c.cur_ret;
                  let hf: HirFn = HirModule::fn_at(ref_of(deref(c).hir), fid);
                  c.cur_ret = hf.ret_ty;
                  let lstart: u32 = c.hir.locals.len() as u32;
                  let li: u32 = 0;
                  while li < hf.params.len {
                    let pidx: u32 = hf.params.start + li;
                    let hp: HirParam = HirModule::param_at(ref_of(deref(c).hir), pidx);
                    let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: hp.name, ty: hp.ty });
                    HirModule::set_param_local(mut_of(deref(c).hir), pidx, lid);
                    Scope::define(mut_of(deref(c).locals), hp.name, SymKind::Local { lid }, hf.span);
                    li = li + 1;
                  };
                  let body: HirExprId = check_expr_as(ast, text, c, fe.body, Option(TypeId)::none());
                  let lused: u32 = (c.hir.locals.len() as u32) - lstart;
                  HirModule::set_fn_body(mut_of(deref(c).hir), fid, body, HirRange { start: lstart, len: lused });
                  c.cur_ret = saved_ret;
                  let _spent: Scope = Scope::swap(mut_of(deref(c).locals), reloc(saved_locals));
                }
              },
              None => {},
            };
          },
          _ => {},
        };
      },
      _ => {},
    };
    k = k + 1;
  };

  deref(c).mod_decl_buf.truncate(base);
  deref(c).cur_mod = saved_mod;
};

let declare_modules_and_sigs = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let i: u64 = 0;
  while i < c.decls.len() {
    let fd: FlatDecl = c.decls.get(i);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let name: Slice(u8) = Span::slice(ld.name, text);
        let sp: Span = ast.decl_spans.get(fd.id as u64);
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          SigLit(sr) => {
            let sidx: u32 = deref(c).sigs.len() as u32;
            deref(c).sigs.push(SigDefInfo { name: name, items: sr });
            Scope::define(mut_of(deref(c).globals), name, SymKind::SigDef { sidx }, sp);
          },
          EffectLit(er) => {
            let eidx: u32 = deref(c).effects.len() as u32;
            deref(c).effects.push(EffectDefInfo { name: name, ops: er });
            Scope::define(mut_of(deref(c).globals), name, SymKind::EffectDef { eidx }, sp);
          },
          ModuleLit(mr) => {
            let midx: u32 = deref(c).modules.len() as u32;
            deref(c).modules.push(ModuleDefInfo {
              name: name,
              self_tid: Option(TypeId)::none()
            });
            Scope::define(mut_of(deref(c).globals), name, SymKind::ModuleDef { midx }, sp);
            populate_module(ast, text, c, midx, mr, false);
          },
          _ => {},
        };
      },
      _ => {},
    };
    i = i + 1;
  };
};

let is_module_ret_fn = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), gidx: u32) ?{ al: Allocator = SystemAlloc } -> bool {
  let gf: GenericFnDef = deref(c).generic_fns.get(gidx as u64);
  let gd: Decl = ast.decls.get(gf.decl_id as u64);
  let has_ld: bool = false;
  let gld: LetDecl = LetDecl { is_pub: false, name: Span::empty(ast.src, 0), ty: Option(ExprId)::none(), init: ExprId { idx: 0 } };
  match gd { Let(x) => { gld = x; has_ld = true; }, _ => {}, };
  if has_ld == false { return false; }
  let gex: Expr = ast.exprs.get(gld.init.idx as u64);
  let has_fe: bool = false;
  let gfe: FuncExpr = FuncExpr {
    params: IdRange { start: 0, len: 0 },
    witnesses: IdRange { start: 0, len: 0 },
    ret_ty: Option(ExprId)::none(),
    effects: IdRange { start: 0, len: 0 },
    body: ExprId { idx: 0 }
  };
  match gex { Func(x) => { gfe = x; has_fe = true; }, _ => {}, };
  if has_fe == false { return false; }
  let is_mod: bool = false;
  match gfe.ret_ty {
    Some(re) => {
      let rex: Expr = ast.exprs.get(re.idx as u64);
      match rex {
        Ident(rsp) => {
          if eq(Span::slice(rsp, text), "Module") {
            is_mod = true;
          }
        },
        _ => {},
      };
    },
    None => {},
  };
  return is_mod;
};

let instantiate_generic_module = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), gidx: u32, call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> u32
{
  let gf: GenericFnDef = deref(c).generic_fns.get(gidx as u64);
  let gd: Decl = ast.decls.get(gf.decl_id as u64);
  let gld: LetDecl = LetDecl { is_pub: false, name: sp, ty: Option(ExprId)::none(), init: ExprId { idx: 0 } };
  match gd { Let(x) => { gld = x; }, _ => {}, };
  let gex: Expr = ast.exprs.get(gld.init.idx as u64);
  let gfe: FuncExpr = FuncExpr {
    params: IdRange { start: 0, len: 0 },
    witnesses: IdRange { start: 0, len: 0 },
    ret_ty: Option(ExprId)::none(),
    effects: IdRange { start: 0, len: 0 },
    body: ExprId { idx: 0 }
  };
  match gex { Func(x) => { gfe = x; }, _ => {}, };
  if call.args.len != gfe.params.len {
    perform SemaFail::fail(SemaErr::ArityMismatch(sp));
    return 0;
  }
  let tbase: u64 = deref(c).tid_buf.len();
  let pi: u64 = 0;
  while pi < (gfe.params.len as u64) {
    let aex: ExprId = ast.expr_lists.get((call.args.start as u64) + pi);
    let atid: TypeId = resolve_type(ast, text, c, aex, sp);
    deref(c).tid_buf.push(atid);
    pi = pi + 1;
  };
  let tcount: u64 = deref(c).tid_buf.len() - tbase;
  let has_cached: bool = false;
  let cached_m: u32 = 0;
  let ci: u64 = 0;
  while ci < deref(c).generic_mod_insts.len() {
    let inst: GenericModInst = deref(c).generic_mod_insts.get(ci);
    if (inst.gidx == gidx) and ((inst.args_len as u64) == tcount) {
      let ok: bool = true;
      let cj: u64 = 0;
      while (cj < tcount) and ok {
        let a: TypeId = deref(c).generic_type_args.get((inst.args_start as u64) + cj);
        let b: TypeId = deref(c).tid_buf.get(tbase + cj);
        if a.idx != b.idx { ok = false; }
        cj = cj + 1;
      };
      if ok {
        has_cached = true;
        cached_m = inst.mod_idx;
      }
    }
    ci = ci + 1;
  };
  if has_cached {
    deref(c).tid_buf.truncate(tbase);
    return cached_m;
  }
  Scope::push_scope(mut_of(deref(c).type_params));
  let bi: u64 = 0;
  while bi < tcount {
    let p: Param = ast.params.get((gfe.params.start as u64) + bi);
    let pname: Slice(u8) = Span::slice(p.name, text);
    let btid: TypeId = deref(c).tid_buf.get(tbase + bi);
    let bkind: SymKind = SymKind::BuiltinTy { btid };
    Scope::define(mut_of(deref(c).type_params), pname, bkind, p.span);
    bi = bi + 1;
  };
  let ret_ok: bool = false;
  let rex: ExprId = extract_returned_expr(ast, gfe.body, mut_of(ret_ok));
  let midx: u32 = deref(c).modules.len() as u32;
  if ret_ok {
    let rnode: Expr = ast.exprs.get(rex.idx as u64);
    match rnode {
      ModuleLit(mr) => {
        deref(c).modules.push(ModuleDefInfo {
          name: Span::slice(gld.name, text),
          self_tid: Option(TypeId)::none()
        });
        let astart: u32 = deref(c).generic_type_args.len() as u32;
        let ri: u64 = 0;
        while ri < tcount {
          deref(c).generic_type_args.push(deref(c).tid_buf.get(tbase + ri));
          ri = ri + 1;
        };
        deref(c).generic_mod_insts.push(GenericModInst {
          gidx: gidx,
          args_start: astart,
          args_len: tcount as u32,
          mod_idx: midx
        });
        populate_module(ast, text, c, midx, mr, true);
      },
      _ => {
        perform SemaFail::fail(SemaErr::Unsupported(sp));
      },
    };
  } else {
    perform SemaFail::fail(SemaErr::Unsupported { sp });
  }
  Scope::pop_scope(mut_of(deref(c).type_params));
  deref(c).tid_buf.truncate(tbase);
  return midx;
};

let resolve_module_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), e: ExprId, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(u32)
{
  let ex: Expr = ast.exprs.get(e.idx as u64);
  let out: Option(u32) = Option(u32)::none();
  match ex {
    Ident(nsp) => {
      let name: Slice(u8) = Span::slice(nsp, text);
      if sym_bound(ref_of(deref(c).locals), name) == false {
        let found: Option(SymEntry) = lookup_type_sym(c, name);
        match found {
          Some(ent) => {
            match ent.kind {
              ModuleDef(mi) => { out = Option(u32)::some(mi); },
              _ => {},
            };
          },
          None => {},
        };
      }
    },
    Call(call) => {
      let ce: Expr = ast.exprs.get(call.callee.idx as u64);
      let cname: Slice(u8) = ident_name(ce, text);
      let found: Option(SymEntry) = Scope::lookup(ref_of(deref(c).globals), cname);
      let gidx: u32 = 0;
      let has_g: bool = false;
      match found {
        Some(ent) => {
          match ent.kind {
            GenericFn(gi) => { gidx = gi; has_g = true; },
            _ => {},
          };
        },
        None => {},
      };
      if has_g and is_module_ret_fn(ast, text, c, gidx) {
        let mi: u32 = instantiate_generic_module(ast, text, c, gidx, call, sp);
        out = Option(u32)::some(mi);
      }
    },
    _ => {},
  };
  return out;
};

let collect_effects = func(ast: Ref(AstModule()), text: Slice(u8), r: IdRange, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let row: EffRow = EffRow::new();
  let rm: Mut(EffRow) = mut_of(row);
  let i: u64 = 0;
  while i < (r.len as u64) {
    let eid: ExprId = ast.expr_lists.get((r.start as u64) + i);
    let ex: Expr = ast.exprs.get(eid.idx as u64);
    let name: Slice(u8) = match ex {
      Ident(nsp) => Span::slice(nsp, text),
      Path(p) => {
        if p.len == 0 {
          blank()
        } else {
          Span::slice(span_at(ast, p), text)
        }
      },
      _ => blank(),
    };
    if name.len == 0 {
      perform SemaFail::fail(SemaErr::Unsupported { sp });
      return;
    }
    if EffRow::add(rm, name) == false {
      perform SemaFail::fail(SemaErr::DuplicateSym { sp });
      return;
    }
    i = i + 1;
  };
};

let is_pure_const_hir = func(hir: Ref(HirModule), eid: HirExprId) -> bool {
  let e: HirExpr = HirModule::expr_at(hir, eid);
  let out: bool = false;
  match e.kind {
    IntConst(_) => {
      out = true;
    },
    BoolConst(_) => {
      out = true;
    },
    Unary(u) => {
      out = is_pure_const_hir(hir, u.operand);
    },
    Binary(b) => {
      out = is_pure_const_hir(hir, b.lhs) and is_pure_const_hir(hir, b.rhs);
    },
    Cast(cs) => {
      out = is_pure_const_hir(hir, cs.expr);
    },
    Call(call) => {
      let callee: HirExpr = HirModule::expr_at(hir, call.callee);
      let ok: bool = match callee.kind {
        Fn(_) => true,
        _ => false,
      };
      let i: u64 = 0;
      while (i < (call.args.len as u64)) and ok {
        let aid: HirExprId = hir.expr_lists.get((call.args.start as u64) + i);
        ok = is_pure_const_hir(hir, aid);
        i = i + 1;
      };
      out = ok;
    },
    _ => {},
  };
  return out;
};

let const_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), cidx: u32, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> HirExprId
{
  ensure_const(ast, text, c, cidx);
  let cd: ConstDecl = deref(c).consts.get(cidx as u64);
  let k: HirExprKind = if same_type(c, cd.ty, c.bool_tid) {
    HirExprKind::BoolConst { cd.val != 0 }
  } else {
    HirExprKind::IntConst { cd.val as i64 }
  };
  return mk(c, k, cd.ty, sp);
};

let sym_bound = func(s: Ref(Scope), name: Slice(u8)) -> bool {
  let found: Option(SymEntry) = Scope::lookup(s, name);
  return match found {
    Some(_) => true,
    None => false,
  };
};

let call_arg = func(ast: Ref(AstModule()), call: CallExpr, i: u64) -> ExprId {
  return ast.expr_lists.get((call.args.start as u64) + i);
};

let enum_of_path = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), r: IdRange) -> Option(u32) {
  let out: Option(u32) = Option(u32)::none();
  if r.len >= 2 {
    let seg0: Slice(u8) = Span::slice(ast.path_segs.get(r.start as u64), text);
    let cur: Option(SymEntry) = lookup_type_sym(c, seg0);
    let i: u64 = 1;
    let limit: u64 = (r.len as u64) - 1;
    while i < limit {
      let seg: Slice(u8) = Span::slice(ast.path_segs.get((r.start as u64) + i), text);
      let next: Option(SymEntry) = Option(SymEntry)::none();
      match cur {
        Some(ent) => {
          match ent.kind {
            ModuleDef(mi) => {
              next = mod_lookup(c, mi, seg);
            },
            _ => {},
          };
        },
        None => {},
      };
      cur = next;
      i = i + 1;
    };
    match cur {
      Some(e) => {
        match e.kind {
          EnumDef(idx) => {
            out = Option(u32)::some(idx);
          },
          _ => {},
        };
      },
      None => {},
    };
  }
  return out;
};

let path_tail_name = func(ast: Ref(AstModule()), text: Slice(u8), r: IdRange) -> Slice(u8) {
  return Span::slice(ast.path_segs.get((r.start as u64) + (r.len as u64) - 1), text);
};

let enum_lit_expr = func(c: Mut(Ctx), eidx: u32, abs_v: u32, payload: Option(HirExprId), sp: Span) !{ OomErr } -> HirExprId {
  let lit: HirEnumLit = HirEnumLit { enum_idx: eidx, variant_idx: abs_v, payload: payload };
  let tid: TypeId = enum_tid(c, eidx);
  return mk(c, HirExprKind::EnumLit { lit }, tid, sp);
};

let find_variant_or_fail = func(c: Mut(Ctx), eidx: u32, name: Slice(u8), sp: Span) !{ SemaFail } -> u32 {
  let vf: Option(u32) = HirModule::find_variant(ref_of(deref(c).hir), eidx, name);
  return match vf {
    Some(v) => v,
    None => fail_variant(SemaErr::UnknownIdent(sp)),
  };
};

let enum_path_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), r: IdRange, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  let eo: Option(u32) = enum_of_path(ast, text, c, r);
  match eo {
    Some(eidx) => {
      let vname: Slice(u8) = path_tail_name(ast, text, r);
      let av: u32 = find_variant_or_fail(c, eidx, vname, sp);
      let vi: VariantInfo = HirModule::variant_at(ref_of(deref(c).hir), av);
      if vi.has_payload {
        out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
      } else {
        let empty: Option(HirExprId) = Option(HirExprId)::none();
        out = Option(HirExprId)::some(enum_lit_expr(c, eidx, av, empty, sp));
      }
    },
    None => {},
  };
  return out;
};

let enum_call_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  let cal: Expr = ast.exprs.get(call.callee.idx as u64);
  match cal {
    Path(r) => {
      let eo: Option(u32) = enum_of_path(ast, text, c, r);
      match eo {
        Some(eidx) => {
          let vname: Slice(u8) = path_tail_name(ast, text, r);
          let av: u32 = find_variant_or_fail(c, eidx, vname, sp);
          let vi: VariantInfo = HirModule::variant_at(ref_of(deref(c).hir), av);
          if (call.args.len as u64) != 1 {
            out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
          } else if vi.has_payload == false {
            out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
          } else {
            let arg: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::some(vi.payload_ty));
            let payload: Option(HirExprId) = Option(HirExprId)::some(arg);
            out = Option(HirExprId)::some(enum_lit_expr(c, eidx, av, payload, sp));
          }
        },
        None => {},
      };
    },
    _ => {},
  };
  return out;
};

let enum_struct_lit_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), sl: StructLitExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  let tx: Expr = ast.exprs.get(sl.ty.idx as u64);
  match tx {
    Path(r) => {
      let eo: Option(u32) = enum_of_path(ast, text, c, r);
      match eo {
        Some(eidx) => {
          let vname: Slice(u8) = path_tail_name(ast, text, r);
          let av: u32 = find_variant_or_fail(c, eidx, vname, sp);
          let vi: VariantInfo = HirModule::variant_at(ref_of(deref(c).hir), av);
          if (vi.has_payload == false) and (sl.inits.len == 0) {
            let empty: Option(HirExprId) = Option(HirExprId)::none();
            out = Option(HirExprId)::some(enum_lit_expr(c, eidx, av, empty, sp));
          } else {
            out = Option(HirExprId)::some(fail_at(SemaErr::Unsupported(sp)));
          }
        },
        None => {},
      };
    },
    _ => {},
  };
  return out;
};

let addr_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span, is_mut: bool)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 1 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let inner: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let it: TypeId = expr_ty(c, inner);
    let rt: TypeId = if is_mut { intern(c, HirType::Mut { it }) } else { intern(c, HirType::Ref { it }) };
    out = Option(HirExprId)::some(mk(c, HirExprKind::AddrOf { inner }, rt, sp));
  }
  return out;
};

let deref_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 1 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let inner: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let it: TypeId = expr_ty(c, inner);
    let ht: HirType = HirModule::type_at(ref_of(deref(c).hir), it);
    let inner_ty: TypeId = c.void_tid;
    let good: bool = true;
    match ht {
      Ref(t) => {
        inner_ty = t;
      },
      Mut(t) => {
        inner_ty = t;
      },
      _ => {
        good = false;
      },
    };
    if good == false {
      out = Option(HirExprId)::some(fail_at(SemaErr::TypeMismatch(sp)));
    } else {
      out = Option(HirExprId)::some(mk(c, HirExprKind::Deref { inner }, inner_ty, sp));
    }
  }
  return out;
};

let ptr_offset_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 2 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let base: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let bt: TypeId = expr_ty(c, base);
    let bh: HirType = HirModule::type_at(ref_of(deref(c).hir), bt);
    let elem: TypeId = c.void_tid;
    let good: bool = true;
    match bh {
      Ref(t) => {
        elem = t;
      },
      Mut(t) => {
        elem = t;
      },
      _ => {
        good = false;
      },
    };
    if good == false {
      out = Option(HirExprId)::some(fail_at(SemaErr::TypeMismatch(sp)));
    } else {
      let idx: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 1), Option(TypeId)::none());
      let it: TypeId = expr_ty(c, idx);
      let ih: HirType = HirModule::type_at(ref_of(deref(c).hir), it);
      let is_int: bool = match ih {
        Int(_) => true,
        _ => false,
      };
      if is_int == false {
        out = Option(HirExprId)::some(fail_at(SemaErr::TypeMismatch(sp)));
      } else {
        let po: HirPtrOffset = HirPtrOffset { base: base, index: idx, elem_size: type_size(c, elem) };
        out = Option(HirExprId)::some(mk(c, HirExprKind::PtrOffset { po }, bt, sp));
      }
    }
  }
  return out;
};

let ptr_cast_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 2 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let dst: TypeId = resolve_type(ast, text, c, call_arg(ast, call, 0), sp);
    let val: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 1), Option(TypeId)::none());
    let cs: HirCast = HirCast { expr: val, to: dst };
    out = Option(HirExprId)::some(mk(c, HirExprKind::Cast { cs }, dst, sp));
  }
  return out;
};

let init_at_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 2 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let dst: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let val: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 1), Option(TypeId)::none());
    let mw: HirMemWrite = HirMemWrite { dst: dst, val: val };
    out = Option(HirExprId)::some(mk(c, HirExprKind::InitAt { mw }, c.void_tid, sp));
  }
  return out;
};

let drop_at_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 1 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let dst: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let dr: HirDropAt = HirDropAt { dst: dst };
    out = Option(HirExprId)::some(mk(c, HirExprKind::DropAt { dr }, c.void_tid, sp));
  }
  return out;
};

let type_info_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 1 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let tid: TypeId = resolve_type(ast, text, c, call_arg(ast, call, 0), sp);
    let sz: i64 = type_size(c, tid) as i64;
    let al: i64 = type_align(c, tid) as i64;
    let kt: i64 = type_tag(HirModule::type_at(ref_of(deref(c).hir), tid)) as i64;
    let e_sz: HirExprId = mk(c, HirExprKind::IntConst { sz }, c.u64_tid, sp);
    let e_al: HirExprId = mk(c, HirExprKind::IntConst { al }, c.u64_tid, sp);
    let e_hd: HirExprId = mk(c, HirExprKind::BoolConst { false }, c.bool_tid, sp);
    let e_kt: HirExprId = mk(c, HirExprKind::IntConst { kt }, c.u64_tid, sp);
    let si: StructInfo = HirModule::struct_at(ref_of(deref(c).hir), c.type_info_sidx);
    let fbase: u32 = si.fields.start;
    let istart: u32 = c.hir.inits.len() as u32;
    HirModule::add_init(mut_of(deref(c).hir), HirFieldInit { index: fbase + 0, val: e_sz });
    HirModule::add_init(mut_of(deref(c).hir), HirFieldInit { index: fbase + 1, val: e_al });
    HirModule::add_init(mut_of(deref(c).hir), HirFieldInit { index: fbase + 2, val: e_hd });
    HirModule::add_init(mut_of(deref(c).hir), HirFieldInit { index: fbase + 3, val: e_kt });
    let sl: HirStructLit = HirStructLit { struct_idx: c.type_info_sidx, inits: HirRange { start: istart, len: 4 } };
    out = Option(HirExprId)::some(mk(c, HirExprKind::StructLit { sl }, c.type_info_tid, sp));
  }
  return out;
};

let field_ptr_intrinsic = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  if (call.args.len as u64) != 2 {
    out = Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  } else {
    let base: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 0), Option(TypeId)::none());
    let bt: TypeId = expr_ty(c, base);
    let bh: HirType = HirModule::type_at(ref_of(deref(c).hir), bt);
    let is_mut: bool = false;
    let inner: TypeId = TypeId { idx: 0 };
    let is_ptr: bool = false;
    match bh {
      Ref(t) => { inner = t; is_ptr = true; },
      Mut(t) => { inner = t; is_mut = true; is_ptr = true; },
      _ => {},
    };
    if is_ptr == false {
      return Option(HirExprId)::some(fail_at(SemaErr::TypeMismatch(sp)));
    }
    let si_opt: Option(u32) = struct_index(c, inner);
    let has_sidx: bool = false;
    let sidx: u32 = 0;
    match si_opt {
      Some(v) => {
        sidx = v;
        has_sidx = true;
      },
      None => {},
    };
    if has_sidx == false {
      return Option(HirExprId)::some(fail_at(SemaErr::TypeMismatch(sp)));
    }
    let idx_h: HirExprId = check_expr_as(ast, text, c, call_arg(ast, call, 1), Option(TypeId)::some(c.u64_tid));
    let idx_e: HirExpr = HirModule::expr_at(ref_of(deref(c).hir), idx_h);
    let fidx_u64: u64 = match idx_e.kind {
      IntConst(v) => v as u64,
      _ => eval_hir_u64(ref_of(deref(c).hir), idx_h, c.u64_tid, sp),
    };
    let sinfo: StructInfo = HirModule::struct_at(ref_of(deref(c).hir), sidx);
    if fidx_u64 >= (sinfo.fields.len as u64) {
      return Option(HirExprId)::some(fail_at(SemaErr::UnknownField(sp)));
    }
    let fi: FieldInfo = HirModule::field_at(ref_of(deref(c).hir), sinfo.fields.start + (fidx_u64 as u32));
    let res_ty: TypeId = TypeId { idx: 0 };
    if is_mut {
      res_ty = intern(c, HirType::Mut { fi.ty });
    } else {
      res_ty = intern(c, HirType::Ref { fi.ty });
    }
    let fp: HirFieldPtr = HirFieldPtr { base: base, offset: fi.offset };
    out = Option(HirExprId)::some(mk(c, HirExprKind::FieldPtr { fp }, res_ty, sp));
  }
  return out;
};

let intrinsic_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let out: Option(HirExprId) = Option(HirExprId)::none();
  let cal: Expr = ast.exprs.get(call.callee.idx as u64);
  let nsp: Option(Span) = match cal {
    Ident(n) => Option(Span)::some(n),
    _ => Option(Span)::none(),
  };
  match nsp {
    Some(ns) => {
      let name: Slice(u8) = Span::slice(ns, text);
      let bound: bool = sym_bound(ref_of(deref(c).locals), name) or sym_bound(ref_of(deref(c).globals), name);
      if bound == false {
        if eq(name, "ref_of") {
          out = addr_intrinsic(ast, text, c, call, sp, false);
        } else if eq(name, "mut_of") {
          out = addr_intrinsic(ast, text, c, call, sp, true);
        } else if eq(name, "deref") {
          out = deref_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "ptr_offset") or eq(name, "@ptr_offset") {
          out = ptr_offset_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "ptr_cast") or eq(name, "@ptr_cast") {
          out = ptr_cast_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "init_at") {
          out = init_at_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "drop_at") {
          out = drop_at_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "@type_info") {
          out = type_info_intrinsic(ast, text, c, call, sp);
        } else if eq(name, "@field_ptr") {
          out = field_ptr_intrinsic(ast, text, c, call, sp);
        }
      }
    },
    None => {},
  };
  return out;
};

let check_match = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), mx: MatchExpr, want: Option(TypeId), sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> HirExprId
{
  let scrut: HirExprId = check_expr_as(ast, text, c, mx.scrutinee, Option(TypeId)::none());
  let sty: TypeId = expr_ty(c, scrut);
  let sth: HirType = HirModule::type_at(ref_of(deref(c).hir), sty);
  let eidx: u32 = 0;
  let is_enum: bool = true;
  match sth {
    Enum(i) => {
      eidx = i;
    },
    _ => {
      is_enum = false;
    },
  };
  if is_enum == false {
    return fail_at(SemaErr::TypeMismatch(sp));
  }
  let sbase: u64 = deref(c).arm_buf.len();
  let res_ty: TypeId = c.void_tid;
  let have_res: bool = false;
  match want {
    Some(w) => {
      res_ty = w;
      have_res = true;
    },
    None => {},
  };
  let i: u64 = 0;
  while i < (mx.arms.len as u64) {
    let arm: MatchArm = ast.match_arms.get((mx.arms.start as u64) + i);
    let pat: Pattern = ast.pats.get(arm.pat.idx as u64);
    let tagv: u64 = 0;
    let wild: bool = false;
    let binder: Option(HirLocalId) = Option(HirLocalId)::none();
    let pushed: bool = false;
    match pat {
      Wildcard => {
        wild = true;
      },
      Ident(nsp) => {
        let vname: Slice(u8) = Span::slice(nsp, text);
        let av: u32 = find_variant_or_fail(c, eidx, vname, nsp);
        let vi: VariantInfo = HirModule::variant_at(ref_of(deref(c).hir), av);
        if vi.has_payload {
          return fail_at(SemaErr::TypeMismatch(nsp));
        }
        tagv = vi.tag_val;
      },
      Variant(vp) => {
        let vspan: Span = span_at(ast, vp.path);
        let vname: Slice(u8) = Span::slice(vspan, text);
        let av: u32 = find_variant_or_fail(c, eidx, vname, vspan);
        let vi: VariantInfo = HirModule::variant_at(ref_of(deref(c).hir), av);
        tagv = vi.tag_val;
        match vp.arg {
          Some(apid) => {
            let bp: Pattern = ast.pats.get(apid.idx as u64);
            let bnm: Span = Span::empty(ast.src, 0);
            let is_bind: bool = true;
            match bp {
              Ident(nb) => {
                bnm = nb;
              },
              _ => {
                is_bind = false;
              },
            };
            if is_bind == false {
              return fail_at(SemaErr::Unsupported(vspan));
            }
            let name: Slice(u8) = Span::slice(bnm, text);
            Scope::push_scope(mut_of(deref(c).locals));
            pushed = true;
            let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: name, ty: vi.payload_ty });
            let kind: SymKind = SymKind::Local { lid };
            Scope::define(mut_of(deref(c).locals), name, kind, bnm);
            binder = Option(HirLocalId)::some(lid);
          },
          None => {},
        };
      },
      Lit(_) => {
        return fail_at(SemaErr::Unsupported(arm.span));
      },
    };
    let bwant: Option(TypeId) = if have_res { Option(TypeId)::some(res_ty) } else { Option(TypeId)::none() };
    let body: HirExprId = check_expr_as(ast, text, c, arm.body, bwant);
    if pushed {
      Scope::pop_scope(mut_of(deref(c).locals));
    }
    if have_res == false {
      res_ty = expr_ty(c, body);
      have_res = true;
    }
    let harm: HirMatchArm = HirMatchArm { tag_val: tagv, is_wildcard: wild, bind_local: binder, body: body };
    deref(c).arm_buf.push(harm);
    i = i + 1;
  };
  let astart: u32 = c.hir.match_arms.len() as u32;
  let aend: u64 = deref(c).arm_buf.len();
  let aj: u64 = sbase;
  while aj < aend {
    HirModule::add_match_arm(mut_of(deref(c).hir), deref(c).arm_buf.get(aj));
    aj = aj + 1;
  };
  deref(c).arm_buf.truncate(sbase);
  let used: u32 = (aend - sbase) as u32;
  let mh: HirMatch = HirMatch { scrutinee: scrut, enum_idx: eidx, arms: HirRange { start: astart, len: used } };
  return mk(c, HirExprKind::Match { mh }, res_ty, sp);
};

let find_generic_fn_inst = func(c: Mut(Ctx), gidx: u32, tids: Ref(TypeIdVec::Self)) -> Option(HirFnId) {
  let n: u64 = deref(c).generic_fn_insts.len();
  let i: u64 = 0;
  while i < n {
    let inst: GenericFnInst = deref(c).generic_fn_insts.get(i);
    if (inst.gidx == gidx) and ((inst.args_len as u64) == TypeIdVec::len(tids)) {
      let ok: bool = true;
      let j: u64 = 0;
      while (j < TypeIdVec::len(tids)) and ok {
        let a: TypeId = deref(c).generic_type_args.get((inst.args_start as u64) + j);
        let b: TypeId = TypeIdVec::get(tids, j);
        if a.idx != b.idx {
          ok = false;
        }
        j = j + 1;
      };
      if ok {
        return Option(HirFnId)::some(inst.fn_id);
      }
    }
    i = i + 1;
  };
  return Option(HirFnId)::none();
};

let build_generic_fn = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), gidx: u32, tbase: u64, tcount: u64)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> HirFnId
{
  let gf: GenericFnDef = deref(c).generic_fns.get(gidx as u64);
  let gsp: Span = ast.decl_spans.get(gf.decl_id as u64);
  let gd: Decl = ast.decls.get(gf.decl_id as u64);
  let gld: LetDecl = LetDecl { is_pub: false, name: gsp, ty: Option(ExprId)::none(), init: ExprId { idx: 0 } };
  match gd {
    Let(x) => { gld = x; },
    _ => {},
  };
  let gex: Expr = ast.exprs.get(gld.init.idx as u64);
  let gfe: FuncExpr = FuncExpr {
    params: IdRange { start: 0, len: 0 },
    witnesses: IdRange { start: 0, len: 0 },
    ret_ty: Option(ExprId)::none(),
    effects: IdRange { start: 0, len: 0 },
    body: ExprId { idx: 0 }
  };
  match gex {
    Func(x) => { gfe = x; },
    _ => {},
  };
  Scope::push_scope(mut_of(deref(c).type_params));
  let ti: u64 = 0;
  let pbi: u64 = 0;
  while pbi < (gfe.params.len as u64) {
    let p: Param = ast.params.get((gfe.params.start as u64) + pbi);
    if is_type_param_expr(ast, text, p.ty) {
      let pname: Slice(u8) = Span::slice(p.name, text);
      let btid: TypeId = deref(c).tid_buf.get(tbase + ti);
      let bkind: SymKind = SymKind::BuiltinTy { btid };
      Scope::define(mut_of(deref(c).type_params), pname, bkind, p.span);
      ti = ti + 1;
    }
    pbi = pbi + 1;
  };
  let wi: u64 = 0;
  while wi < (gfe.witnesses.len as u64) {
    let wp: WitnessParam = ast.witnesses.get((gfe.witnesses.start as u64) + wi);
    match wp.default_expr {
      Some(dm) => {
        let mo: Option(u32) = resolve_module_expr(ast, text, c, dm, wp.span);
        match mo {
          Some(mi) => {
            let wname: Slice(u8) = Span::slice(wp.name, text);
            let mkind: SymKind = SymKind::ModuleDef { mi };
            Scope::define(mut_of(deref(c).type_params), wname, mkind, wp.span);
          },
          None => {},
        };
      },
      None => {},
    };
    wi = wi + 1;
  };
  let ret: TypeId = c.void_tid;
  match gfe.ret_ty {
    Some(re) => { ret = resolve_type(ast, text, c, re, gsp); },
    None => {},
  };
  let fn_idx: u32 = c.hir.fns.len() as u32;
  HirModule::add_type(mut_of(deref(c).hir), HirType::Fn { fn_idx });
  let pstart: u32 = c.hir.params.len() as u32;
  let rpi: u64 = 0;
  while rpi < (gfe.params.len as u64) {
    let p: Param = ast.params.get((gfe.params.start as u64) + rpi);
    if is_type_param_expr(ast, text, p.ty) == false {
      let ptid: TypeId = resolve_type(ast, text, c, p.ty, p.span);
      let pname: Slice(u8) = Span::slice(p.name, text);
      HirModule::add_param(mut_of(deref(c).hir), HirParam { name: pname, ty: ptid, local: HirLocalId { idx: 0 } });
    }
    rpi = rpi + 1;
  };
  let pused: u32 = (c.hir.params.len() as u32) - pstart;
  let hf: HirFn = HirFn {
    name: Span::slice(gld.name, text),
    is_pub: false,
    params: HirRange { start: pstart, len: pused },
    locals: HirRange { start: 0, len: 0 },
    ret_ty: ret,
    body: HirExprId { idx: 0 },
    span: gsp
  };
  let fid: HirFnId = HirModule::add_fn(mut_of(deref(c).hir), hf);
  deref(c).fn_decls.push(FlatDecl { id: gf.decl_id, is_pub: false });
  deref(c).fn_checked.push(true);
  record_fn_effects(ast, text, c, gfe.effects);
  let astart: u32 = deref(c).generic_type_args.len() as u32;
  let r_i: u64 = 0;
  while r_i < tcount {
    deref(c).generic_type_args.push(deref(c).tid_buf.get(tbase + r_i));
    r_i = r_i + 1;
  };
  deref(c).generic_fn_insts.push(GenericFnInst {
    gidx: gidx,
    args_start: astart,
    args_len: tcount as u32,
    fn_id: fid
  });
  let saved_locals: Scope = Scope::swap(mut_of(deref(c).locals), Scope::new());
  let saved_ret: TypeId = c.cur_ret;
  c.cur_ret = ret;
  let lstart: u32 = c.hir.locals.len() as u32;
  let li: u32 = 0;
  while li < pused {
    let pidx: u32 = pstart + li;
    let hp: HirParam = HirModule::param_at(ref_of(deref(c).hir), pidx);
    let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: hp.name, ty: hp.ty });
    HirModule::set_param_local(mut_of(deref(c).hir), pidx, lid);
    Scope::define(mut_of(deref(c).locals), hp.name, SymKind::Local { lid }, gsp);
    li = li + 1;
  };
  let ebase: u64 = push_cur_effs(ast, text, c, gfe.effects);
  let body: HirExprId = check_expr_as(ast, text, c, gfe.body, Option(TypeId)::none());
  deref(c).cur_eff_names.truncate(ebase);
  let lused: u32 = (c.hir.locals.len() as u32) - lstart;
  HirModule::set_fn_body(mut_of(deref(c).hir), fid, body, HirRange { start: lstart, len: lused });
  c.cur_ret = saved_ret;
  let _spent: Scope = Scope::swap(mut_of(deref(c).locals), reloc(saved_locals));
  Scope::pop_scope(mut_of(deref(c).type_params));
  return fid;
};

let generic_call_expr = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), call: CallExpr, sp: Span)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> Option(HirExprId)
{
  let cal: Expr = ast.exprs.get(call.callee.idx as u64);
  let gfound: Option(SymEntry) = Option(SymEntry)::none();
  match cal {
    Ident(n) => {
      let name: Slice(u8) = Span::slice(n, text);
      if sym_bound(ref_of(deref(c).locals), name) == false {
        gfound = lookup_type_sym(c, name);
      }
    },
    Path(r) => {
      gfound = resolve_path_sym(ast, text, c, r);
    },
    Field(f) => {
      let mo: Option(u32) = resolve_module_expr(ast, text, c, f.base, sp);
      match mo {
        Some(mi) => {
          let fname: Slice(u8) = Span::slice(f.field, text);
          gfound = mod_lookup(c, mi, fname);
        },
        None => {},
      };
    },
    _ => {},
  };
  let has_g: bool = false;
  let gidx: u32 = 0;
  match gfound {
    Some(ge) => {
      match ge.kind {
        GenericFn(gi) => {
          has_g = true;
          gidx = gi;
        },
        _ => {},
      };
    },
    None => {},
  };
  if has_g == false {
    return Option(HirExprId)::none();
  }
  let gf: GenericFnDef = deref(c).generic_fns.get(gidx as u64);
  let gd: Decl = ast.decls.get(gf.decl_id as u64);
  let has_ld: bool = false;
  let gld: LetDecl = LetDecl { is_pub: false, name: sp, ty: Option(ExprId)::none(), init: ExprId { idx: 0 } };
  match gd {
    Let(x) => { gld = x; has_ld = true; },
    _ => {},
  };
  if has_ld == false {
    return Option(HirExprId)::some(fail_at(SemaErr::Unsupported(sp)));
  }
  let gex: Expr = ast.exprs.get(gld.init.idx as u64);
  let has_fe: bool = false;
  let gfe: FuncExpr = FuncExpr {
    params: IdRange { start: 0, len: 0 },
    witnesses: IdRange { start: 0, len: 0 },
    ret_ty: Option(ExprId)::none(),
    effects: IdRange { start: 0, len: 0 },
    body: ExprId { idx: 0 }
  };
  match gex {
    Func(x) => { gfe = x; has_fe = true; },
    _ => {},
  };
  if has_fe == false {
    return Option(HirExprId)::some(fail_at(SemaErr::Unsupported(sp)));
  }
  let gsp: Span = ast.decl_spans.get(gf.decl_id as u64);
  if (call.args.len as u64) != (gfe.params.len as u64) {
    return Option(HirExprId)::some(fail_at(SemaErr::ArityMismatch(sp)));
  }
  let tbase: u64 = deref(c).tid_buf.len();
  let ebase: u64 = deref(c).expr_buf.len();
  let pi: u64 = 0;
  while pi < (gfe.params.len as u64) {
    let p: Param = ast.params.get((gfe.params.start as u64) + pi);
    let aex: ExprId = ast.expr_lists.get((call.args.start as u64) + pi);
    if is_type_param_expr(ast, text, p.ty) {
      let atid: TypeId = resolve_type(ast, text, c, aex, sp);
      deref(c).tid_buf.push(atid);
    } else {
      deref(c).expr_buf.push(aex);
    }
    pi = pi + 1;
  };
  let tcount: u64 = deref(c).tid_buf.len() - tbase;
  let rcount: u64 = deref(c).expr_buf.len() - ebase;
  let fid: HirFnId = HirFnId { idx: 0 };
  let need_build: bool = true;
  let c_i: u64 = 0;
  while c_i < deref(c).generic_fn_insts.len() {
    let inst: GenericFnInst = deref(c).generic_fn_insts.get(c_i);
    if (inst.gidx == gidx) and ((inst.args_len as u64) == tcount) {
      let ok: bool = true;
      let c_j: u64 = 0;
      while (c_j < tcount) and ok {
        let a: TypeId = deref(c).generic_type_args.get((inst.args_start as u64) + c_j);
        let b: TypeId = deref(c).tid_buf.get(tbase + c_j);
        if a.idx != b.idx {
          ok = false;
        }
        c_j = c_j + 1;
      };
      if ok {
        fid = inst.fn_id;
        need_build = false;
      }
    }
    c_i = c_i + 1;
  };
  if need_build {
    fid = build_generic_fn(ast, text, c, gidx, tbase, tcount);
  }
  deref(c).tid_buf.truncate(tbase);
  let f: HirFn = HirModule::fn_at(ref_of(deref(c).hir), fid);
  let abase: u64 = deref(c).arg_buf.len();
  let ai: u64 = 0;
  while ai < rcount {
    let p: HirParam = HirModule::param_at(ref_of(deref(c).hir), f.params.start + (ai as u32));
    let rarg: ExprId = deref(c).expr_buf.get(ebase + ai);
    let pty: TypeId = p.ty;
    let want_pty: Option(TypeId) = Option(TypeId)::some(pty);
    let ah: HirExprId = check_expr_as(ast, text, c, rarg, want_pty);
    deref(c).arg_buf.push(ah);
    ai = ai + 1;
  };
  deref(c).expr_buf.truncate(ebase);
  let hstart: u32 = c.hir.expr_lists.len() as u32;
  let aj: u64 = abase;
  while aj < deref(c).arg_buf.len() {
    HirModule::add_expr_id(mut_of(deref(c).hir), deref(c).arg_buf.get(aj));
    aj = aj + 1;
  };
  deref(c).arg_buf.truncate(abase);
  let fidx_u32: u32 = fid.idx;
  let fn_ty: TypeId = intern(c, HirType::Fn { fidx_u32 });
  let cal_ex: HirExprId = mk(c, HirExprKind::Fn { fid }, fn_ty, sp);
  let hc: HirCall = HirCall { callee: cal_ex, args: HirRange { start: hstart, len: rcount as u32 } };
  let res_expr: HirExprId = mk(c, HirExprKind::Call { hc }, f.ret_ty, sp);
  return Option(HirExprId)::some(res_expr);
};

let check_expr_as = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), e: ExprId, want: Option(TypeId))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> HirExprId
{
  let ex: Expr = ast.exprs.get(e.idx as u64);
  let sp: Span = ast.expr_spans.get(e.idx as u64);
  let hid: HirExprId = HirExprId { idx: 0 };
  match ex {
    Lit(lk) => {
      let tid: TypeId = match want {
        Some(w) => w,
        None => c.i64_tid,
      };
      match lk {
        Int => {
          let parsed: Option(i64) = parse_i64(Span::slice(sp, text));
          match parsed {
            Some(v) => {
              hid = mk(c, HirExprKind::IntConst { v }, tid, sp);
            },
            None => {
              hid = fail_at(SemaErr::TypeMismatch(sp));
            },
          };
        },
        Bool(b) => {
          hid = mk(c, HirExprKind::BoolConst { b }, c.bool_tid, sp);
        },
        Str => {
          let raw: Slice(u8) = Span::slice(sp, text);
          let n: u64 = raw.len;
          let buf: Vec(u8) = Vec(u8)::new();
          let quoted: bool = (n >= 2) and (raw[0] == 34) and (raw[n - 1] == 34);
          let lo: u64 = if quoted { 1 } else { 0 };
          let hi: u64 = if quoted { n - 1 } else { n };
          let i: u64 = lo;
          let bad: bool = false;
          while i < hi {
            let ch: u8 = raw[i];
            let escape: bool = (ch == 92) and ((i + 1) < hi);
            if escape {
              let esc: u8 = raw[i + 1];
              let dec: u8 = 0;
              let known: bool = true;
              if esc == 110 {
                dec = 10;
              } else if esc == 114 {
                dec = 13;
              } else if esc == 116 {
                dec = 9;
              } else if esc == 48 {
                dec = 0;
              } else if esc == 92 {
                dec = 92;
              } else if esc == 34 {
                dec = 34;
              } else {
                known = false;
              };
              if known {
                buf.push(dec);
              } else {
                bad = true;
              }
              i = i + 2;
            } else {
              buf.push(ch);
              i = i + 1;
            }
          };
          if bad {
            hid = fail_at(SemaErr::Unsupported(sp));
          } else {
            buf.push(0);
            let bytes: Slice(u8) = buf.as_slice();
            let sidx: u32 = HirModule::add_str_lit(mut_of(deref(c).hir), bytes);
            let rtid: TypeId = intern(c, HirType::Ref { c.u8_tid });
            hid = mk(c, HirExprKind::StrLit { sidx }, rtid, sp);
          }
        },
        _ => {
          hid = fail_at(SemaErr::Unsupported(sp));
        },
      };
    },
    Ident(nsp) => {
      let name: Slice(u8) = Span::slice(nsp, text);
      let found: Option(SymEntry) = lookup_value_sym(c, name);
      match found {
        Some(ent) => {
          match ent.kind {
            Local(lid) => {
              let lt: HirLocal = HirModule::local_at(ref_of(deref(c).hir), lid);
              hid = mk(c, HirExprKind::Local { lid }, lt.ty, sp);
            },
            Func(fid) => {
              let ftid: TypeId = intern(c, HirType::Fn { fid.idx });
              hid = mk(c, HirExprKind::Fn { fid }, ftid, sp);
            },
            ConstVal(cidx) => {
              hid = const_expr(ast, text, c, cidx, sp);
            },
            _ => {
              hid = fail_at(SemaErr::TypeMismatch(sp));
            },
          };
        },
        None => {
          hid = fail_at(SemaErr::UnknownIdent(sp));
        },
      };
    },
    Path(r) => {
      let pv: Option(HirExprId) = enum_path_expr(ast, text, c, r, sp);
      let is_enum: bool = match pv {
        Some(_) => true,
        None => false,
      };
      if is_enum {
        hid = match pv {
          Some(h) => h,
          None => fail_at(SemaErr::Unsupported(sp)),
        };
      } else if r.len == 0 {
        hid = fail_at(SemaErr::Unsupported(sp));
      } else {
        let found: Option(SymEntry) = resolve_path_sym(ast, text, c, r);
        match found {
          Some(ent) => {
            match ent.kind {
              Local(lid) => {
                let lt: HirLocal = HirModule::local_at(ref_of(deref(c).hir), lid);
                hid = mk(c, HirExprKind::Local { lid }, lt.ty, sp);
              },
              Func(fid) => {
                let ftid: TypeId = intern(c, HirType::Fn { fid.idx });
                hid = mk(c, HirExprKind::Fn { fid }, ftid, sp);
              },
              ConstVal(cidx) => {
                hid = const_expr(ast, text, c, cidx, sp);
              },
              _ => {
                hid = fail_at(SemaErr::TypeMismatch(sp));
              },
            };
          },
          None => {
            hid = fail_at(SemaErr::UnknownIdent(sp));
          },
        };
      }
    },
    Unary(u) => {
      let inner: HirExprId = check_expr_as(ast, text, c, u.operand, Option(TypeId)::none());
      let it: TypeId = expr_ty(c, inner);
      let k: HirExprKind = HirExprKind::Unary { HirUnary { op: u.op, operand: inner } };
      match u.op {
        Not => {
          if same_type(c, it, c.bool_tid) {
            hid = mk(c, k, c.bool_tid, sp);
          } else {
            hid = fail_at(SemaErr::TypeMismatch(sp));
          }
        },
        _ => {
          hid = mk(c, k, it, sp);
        },
      };
    },
    Binary(b) => {
      let lhs_exp: Option(TypeId) = want;
      let is_cmp: bool = is_comparison(b.op);
      if is_cmp {
        lhs_exp = Option(TypeId)::none();
      }
      let lhs_is_int: bool = match ast.exprs.get(b.lhs.idx as u64) {
        Lit(lk) => match lk { Int => true, _ => false },
        _ => false,
      };
      let lhs_has_exp: bool = match lhs_exp {
        Some(_) => true,
        None => false,
      };
      let lhs: HirExprId = HirExprId { idx: 0 };
      let rhs: HirExprId = HirExprId { idx: 0 };
      let lt: TypeId = TypeId { idx: 0 };
      let rt: TypeId = TypeId { idx: 0 };
      if lhs_is_int and (lhs_has_exp == false) {
        rhs = check_expr_as(ast, text, c, b.rhs, Option(TypeId)::none());
        rt = expr_ty(c, rhs);
        lhs = check_expr_as(ast, text, c, b.lhs, Option(TypeId)::some(rt));
        lt = expr_ty(c, lhs);
      } else {
        lhs = check_expr_as(ast, text, c, b.lhs, lhs_exp);
        lt = expr_ty(c, lhs);
        rhs = check_expr_as(ast, text, c, b.rhs, Option(TypeId)::some(lt));
        rt = expr_ty(c, rhs);
      }
      let k: HirExprKind = HirExprKind::Binary { HirBinary { op: b.op, lhs: lhs, rhs: rhs } };
      if is_cmp {
        hid = mk(c, k, c.bool_tid, sp);
      } else if same_type(c, lt, rt) {
        hid = mk(c, k, lt, sp);
      } else {
        hid = fail_at(SemaErr::TypeMismatch(sp));
      }
    },
    Field(f) => {
      let mo: Option(u32) = resolve_module_expr(ast, text, c, f.base, sp);
      let fname: Slice(u8) = Span::slice(f.field, text);
      let has_m: bool = false;
      let midx: u32 = 0;
      match mo {
        Some(mi) => { midx = mi; has_m = true; },
        None => {},
      };
      if has_m {
        let mfound: Option(SymEntry) = mod_lookup(c, midx, fname);
        match mfound {
          Some(ent) => {
            match ent.kind {
              Func(fid) => {
                let ftid: TypeId = intern(c, HirType::Fn { fid.idx });
                hid = mk(c, HirExprKind::Fn { fid }, ftid, sp);
              },
              ConstVal(cidx) => {
                hid = const_expr(ast, text, c, cidx, sp);
              },
              _ => {
                hid = fail_at(SemaErr::TypeMismatch(sp));
              },
            };
          },
          None => {
            hid = fail_at(SemaErr::UnknownIdent(sp));
          },
        };
      } else {
        let base: HirExprId = check_expr_as(ast, text, c, f.base, Option(TypeId)::none());
        let bt: TypeId = expr_ty(c, base);
        let si: Option(u32) = struct_index(c, bt);
        let idx: u32 = match si {
          Some(v) => v,
          None => {
            return fail_at(SemaErr::TypeMismatch(sp));
          },
        };
        let found: Option(u32) = HirModule::find_field(ref_of(deref(c).hir), idx, fname);
        let abs: u32 = match found {
          Some(v) => v,
          None => {
            return fail_at(SemaErr::UnknownField(sp));
          },
        };
        let info: FieldInfo = HirModule::field_at(ref_of(deref(c).hir), abs);
        let k: HirExprKind = HirExprKind::Field { HirField { base: base, struct_idx: idx, field: abs } };
        hid = mk(c, k, info.ty, sp);
      }
    },
    Call(call) => {
      let enum_pre: Option(HirExprId) = enum_call_expr(ast, text, c, call, sp);
      let pre1: Option(HirExprId) = match enum_pre {
        Some(h) => Option(HirExprId)::some(h),
        None => intrinsic_expr(ast, text, c, call, sp),
      };
      let pre: Option(HirExprId) = match pre1 {
        Some(h) => Option(HirExprId)::some(h),
        None => generic_call_expr(ast, text, c, call, sp),
      };
      let handled: bool = match pre {
        Some(_) => true,
        None => false,
      };
      if handled {
        hid = match pre {
          Some(h) => h,
          None => fail_at(SemaErr::Unsupported(sp)),
        };
      } else {
        let cal: HirExprId = check_expr_as(ast, text, c, call.callee, Option(TypeId)::none());
        let ct: TypeId = expr_ty(c, cal);
        let fi: Option(u32) = fn_index(c, ct);
        let fidx: u32 = match fi {
          Some(v) => v,
          None => {
            return fail_at(SemaErr::Unsupported(sp));
          },
        };
        if deref(c).fn_checked.get(fidx as u64) == false {
          ensure_fn_checked(ast, text, c, fidx);
        }
        let eff_rng: HirRange = deref(c).fn_eff_ranges.get(fidx as u64);
        let ei: u64 = 0;
        while ei < (eff_rng.len as u64) {
          let ename: Slice(u8) = deref(c).fn_eff_names.get((eff_rng.start as u64) + ei);
          if eff_allowed(c, ename) == false {
            return fail_at(SemaErr::UnhandledEffect(sp));
          }
          ei = ei + 1;
        };
        let fnid: HirFnId = HirFnId { idx: fidx };
        let f: HirFn = HirModule::fn_at(ref_of(deref(c).hir), fnid);
        if (call.args.len as u64) != (f.params.len as u64) {
          return fail_at(SemaErr::ArityMismatch(sp));
        }
        let abase: u64 = deref(c).arg_buf.len();
        let ai: u64 = 0;
        while ai < (call.args.len as u64) {
          let aid: ExprId = ast.expr_lists.get((call.args.start as u64) + ai);
          let p: HirParam = HirModule::param_at(ref_of(deref(c).hir), f.params.start + (ai as u32));
          let ah: HirExprId = check_expr_as(ast, text, c, aid, Option(TypeId)::some(p.ty));
          deref(c).arg_buf.push(ah);
          ai = ai + 1;
        };
        let astart: u32 = c.hir.expr_lists.len() as u32;
        let aend: u64 = deref(c).arg_buf.len();
        let aj: u64 = abase;
        while aj < aend {
          HirModule::add_expr_id(mut_of(deref(c).hir), deref(c).arg_buf.get(aj));
          aj = aj + 1;
        };
        deref(c).arg_buf.truncate(abase);
        let used: u32 = (aend - abase) as u32;
        let k: HirExprKind = HirExprKind::Call { HirCall { callee: cal, args: HirRange { start: astart, len: used } } };
        hid = mk(c, k, f.ret_ty, sp);
      }
    },
    Cast(cs) => {
      let inner: HirExprId = check_expr_as(ast, text, c, cs.expr, Option(TypeId)::none());
      let target: TypeId = resolve_type(ast, text, c, cs.ty, sp);
      let k: HirExprKind = HirExprKind::Cast { HirCast { expr: inner, to: target } };
      hid = mk(c, k, target, sp);
    },
    Reloc(inner) => {
      let h: HirExprId = check_expr_as(ast, text, c, inner, Option(TypeId)::none());
      let it: TypeId = expr_ty(c, h);
      hid = mk(c, HirExprKind::Reloc { h }, it, sp);
    },
    Perform(pe) => {
      let eo: Option(u32) = resolve_effect_expr(ast, text, c, pe.eff);
      let has_e: bool = false;
      let eidx: u32 = 0;
      match eo {
        Some(v) => { eidx = v; has_e = true; },
        None => {},
      };
      if has_e == false {
        return fail_at(SemaErr::UnknownIdent(sp));
      }
      let ed: EffectDefInfo = deref(c).effects.get(eidx as u64);
      if eff_allowed(c, ed.name) == false {
        return fail_at(SemaErr::UnhandledEffect(sp));
      }
      let op_name: Slice(u8) = Span::slice(pe.op_name, text);
      let op_opt: Option(u32) = find_effect_op(ast, text, c, eidx, op_name);
      let has_op: bool = false;
      let op_idx: u32 = 0;
      match op_opt {
        Some(v) => { op_idx = v; has_op = true; },
        None => {},
      };
      if has_op == false {
        return fail_at(SemaErr::UnknownIdent(pe.op_name));
      }
      let eop: EffectOp = ast.effect_ops.get((ed.ops.start as u64) + (op_idx as u64));
      if (pe.args.len as u64) != (eop.params.len as u64) {
        return fail_at(SemaErr::ArityMismatch(sp));
      }
      let abase: u64 = deref(c).arg_buf.len();
      let ai: u64 = 0;
      while ai < (pe.args.len as u64) {
        let aid: ExprId = ast.expr_lists.get((pe.args.start as u64) + ai);
        let op_p: Param = ast.params.get((eop.params.start as u64) + ai);
        let ptid: TypeId = resolve_type(ast, text, c, op_p.ty, op_p.span);
        let ah: HirExprId = check_expr_as(ast, text, c, aid, Option(TypeId)::some(ptid));
        deref(c).arg_buf.push(ah);
        ai = ai + 1;
      };
      let astart: u32 = c.hir.expr_lists.len() as u32;
      let aend: u64 = deref(c).arg_buf.len();
      let aj: u64 = abase;
      while aj < aend {
        HirModule::add_expr_id(mut_of(deref(c).hir), deref(c).arg_buf.get(aj));
        aj = aj + 1;
      };
      deref(c).arg_buf.truncate(abase);
      let used: u32 = (aend - abase) as u32;
      let rtid: TypeId = c.void_tid;
      match eop.ret_ty {
        Some(re) => { rtid = resolve_type(ast, text, c, re, eop.span); },
        None => {},
      };
      let hp: HirPerform = HirPerform { eff_idx: eidx, op_idx: op_idx, args: HirRange { start: astart, len: used } };
      hid = mk(c, HirExprKind::Perform { hp }, rtid, sp);
    },
    Handle(he) => {
      let has_e: bool = false;
      let eidx: u32 = 0;
      let ai0: u64 = 0;
      while (ai0 < (he.arms.len as u64)) and (has_e == false) {
        let ha0: HandleArm = ast.handle_arms.get((he.arms.start as u64) + ai0);
        match ha0.eff {
          Some(ee) => {
            let ro: Option(u32) = resolve_effect_expr(ast, text, c, ee);
            match ro {
              Some(v) => { eidx = v; has_e = true; },
              None => {},
            };
          },
          None => {},
        };
        ai0 = ai0 + 1;
      };
      if (has_e == false) and (deref(c).effects.len() > 0) {
        eidx = 0;
        has_e = true;
      }
      if has_e == false {
        return fail_at(SemaErr::UnknownIdent(sp));
      }
      let ed: EffectDefInfo = deref(c).effects.get(eidx as u64);
      let hbase: u64 = deref(c).handled_effs.len();
      deref(c).handled_effs.push(ed.name);
      let body_hid: HirExprId = check_expr_as(ast, text, c, he.body, Option(TypeId)::none());
      let bty: TypeId = expr_ty(c, body_hid);
      deref(c).handled_effs.truncate(hbase);
      let harm_base: u64 = deref(c).harm_buf.len();
      let res_ty: TypeId = bty;
      let has_res_ty: bool = false;
      let ai: u64 = 0;
      while ai < (he.arms.len as u64) {
        let ha: HandleArm = ast.handle_arms.get((he.arms.start as u64) + ai);
        let oname: Slice(u8) = Span::slice(ha.op_name, text);
        let is_ret: bool = eq(oname, "return");
        let op_idx: u32 = 0;
        let bind_ty: TypeId = bty;
        if is_ret == false {
          let op_opt: Option(u32) = find_effect_op(ast, text, c, eidx, oname);
          let op_ok: bool = false;
          match op_opt {
            Some(v) => { op_idx = v; op_ok = true; },
            None => {},
          };
          if op_ok == false {
            return fail_at(SemaErr::UnknownIdent(ha.op_name));
          }
          let eop: EffectOp = ast.effect_ops.get((ed.ops.start as u64) + (op_idx as u64));
          if eop.params.len > 0 {
            let op_p: Param = ast.params.get(eop.params.start as u64);
            bind_ty = resolve_type(ast, text, c, op_p.ty, op_p.span);
          } else {
            bind_ty = c.void_tid;
          }
        }
        Scope::push_scope(mut_of(deref(c).locals));
        let blocal: Option(HirLocalId) = Option(HirLocalId)::none();
        match ha.bind_name {
          Some(bsp) => {
            let bname: Slice(u8) = Span::slice(bsp, text);
            let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: bname, ty: bind_ty });
            let lkind: SymKind = SymKind::Local { lid };
            Scope::define(mut_of(deref(c).locals), bname, lkind, bsp);
            blocal = Option(HirLocalId)::some(lid);
          },
          None => {},
        };
        let arm_want: Option(TypeId) = want;
        if has_res_ty {
          arm_want = Option(TypeId)::some(res_ty);
        }
        let arm_hid: HirExprId = check_expr_as(ast, text, c, ha.body, arm_want);
        if has_res_ty == false {
          res_ty = expr_ty(c, arm_hid);
          has_res_ty = true;
        }
        Scope::pop_scope(mut_of(deref(c).locals));
        deref(c).harm_buf.push(HirHandleArm {
          is_return: is_ret,
          op_idx: op_idx,
          bind_local: blocal,
          body: arm_hid,
          span: ha.span
        });
        ai = ai + 1;
      };
      let hstart: u32 = c.hir.handle_arms.len() as u32;
      let hend: u64 = deref(c).harm_buf.len();
      let hj: u64 = harm_base;
      while hj < hend {
        let _arm_id: u32 = HirModule::add_handle_arm(mut_of(deref(c).hir), deref(c).harm_buf.get(hj));
        hj = hj + 1;
      };
      deref(c).harm_buf.truncate(harm_base);
      let hused: u32 = (hend - harm_base) as u32;
      let hh: HirHandle = HirHandle { eff_idx: eidx, body: body_hid, arms: HirRange { start: hstart, len: hused } };
      hid = mk(c, HirExprKind::Handle { hh }, res_ty, sp);
    },
    If(ifx) => {
      let cond: HirExprId = check_expr_as(ast, text, c, ifx.cond, Option(TypeId)::some(c.bool_tid));
      let pure: bool = is_pure_const_hir(ref_of(deref(c).hir), cond);
      if pure {
        let cv: bool = eval_hir_bool(ref_of(deref(c).hir), cond, c.bool_tid, sp)!;
        if cv {
          hid = check_expr_as(ast, text, c, ifx.then_block, want);
        } else {
          match ifx.else_expr {
            Some(ee) => {
              hid = check_expr_as(ast, text, c, ee, want);
            },
            None => {
              hid = void_expr(c, sp);
            },
          };
        }
      } else {
        let then_id: HirExprId = check_expr_as(ast, text, c, ifx.then_block, Option(TypeId)::none());
        let tt: TypeId = expr_ty(c, then_id);
        let alt: Option(HirExprId) = Option(HirExprId)::none();
        let rty: TypeId = c.void_tid;
        match ifx.else_expr {
          Some(ee) => {
            let eh: HirExprId = check_expr_as(ast, text, c, ee, Option(TypeId)::some(tt));
            let et: TypeId = expr_ty(c, eh);
            if same_type(c, tt, et) == false {
              return fail_at(SemaErr::TypeMismatch(sp));
            }
            alt = Option(HirExprId)::some(eh);
            rty = tt;
          },
          None => {
            if same_type(c, tt, c.void_tid) == false {
              return fail_at(SemaErr::TypeMismatch(sp));
            }
          },
        };
        let k: HirExprKind = HirExprKind::If { HirIf { cond: cond, then_block: then_id, else_expr: alt } };
        hid = mk(c, k, rty, sp);
      }
    },
    Block(bl) => {
      Scope::push_scope(mut_of(deref(c).locals));
      let sbase: u64 = deref(c).stmt_buf.len();
      let si: u64 = 0;
      while si < (bl.stmts.len as u64) {
        let sid: StmtId = ast.stmt_lists.get((bl.stmts.start as u64) + si);
        let st: Stmt = ast.stmts.get(sid.idx as u64);
        let ssp: Span = ast.stmt_spans.get(sid.idx as u64);
        let hs: HirStmtId = HirStmtId { idx: 0 };
        match st {
          Let(ls) => {
            let swant: Option(TypeId) = Option(TypeId)::none();
            match ls.ty {
              Some(te) => {
                swant = Option(TypeId)::some(resolve_type(ast, text, c, te, ssp));
              },
              None => {},
            };
            let init: HirExprId = check_expr_as(ast, text, c, ls.init, swant);
            let ity: TypeId = expr_ty(c, init);
            let lname: Slice(u8) = Span::slice(ls.name, text);
            let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: lname, ty: ity });
            let kind: SymKind = SymKind::Local { lid };
            Scope::define(mut_of(deref(c).locals), lname, kind, ssp);
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Let { HirLet { local: lid, init: init } });
          },
          Assign(asg) => {
            let target: HirExprId = check_expr_as(ast, text, c, asg.target, Option(TypeId)::none());
            let tt: TypeId = expr_ty(c, target);
            let val: HirExprId = check_expr_as(ast, text, c, asg.val, Option(TypeId)::some(tt));
            let vt: TypeId = expr_ty(c, val);
            if same_type(c, tt, vt) == false {
              return fail_at(SemaErr::TypeMismatch(ssp));
            }
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Assign { HirAssign { target: target, val: val } });
          },
          Expr(ee) => {
            let eh: HirExprId = check_expr_as(ast, text, c, ee, Option(TypeId)::none());
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Expr { eh });
          },
          Return(oe) => {
            let ores: Option(HirExprId) = Option(HirExprId)::none();
            match oe {
              Some(ee) => {
                let eh: HirExprId = check_expr_as(ast, text, c, ee, Option(TypeId)::some(c.cur_ret));
                ores = Option(HirExprId)::some(eh);
              },
              None => {},
            };
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Return { ores });
          },
          While(w) => {
            let cond: HirExprId = check_expr_as(ast, text, c, w.cond, Option(TypeId)::some(c.bool_tid));
            let body: HirExprId = check_expr_as(ast, text, c, w.body, Option(TypeId)::none());
            let item: HirWhile = HirWhile { cond: cond, body: body };
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::While { item });
          },
          Break => {
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Break);
          },
          Continue => {
            hs = HirModule::add_stmt(mut_of(deref(c).hir), HirStmt::Continue);
          },
        };
        deref(c).stmt_buf.push(hs);
        si = si + 1;
      };
      let tail: Option(HirExprId) = Option(HirExprId)::none();
      let rty: TypeId = c.void_tid;
      match bl.tail {
        Some(te) => {
          let th: HirExprId = check_expr_as(ast, text, c, te, want);
          tail = Option(HirExprId)::some(th);
          rty = expr_ty(c, th);
        },
        None => {},
      };
      Scope::pop_scope(mut_of(deref(c).locals));
      let sstart: u32 = c.hir.stmt_lists.len() as u32;
      let send: u64 = deref(c).stmt_buf.len();
      let sj: u64 = sbase;
      while sj < send {
        HirModule::add_stmt_id(mut_of(deref(c).hir), deref(c).stmt_buf.get(sj));
        sj = sj + 1;
      };
      deref(c).stmt_buf.truncate(sbase);
      let used: u32 = (send - sbase) as u32;
      let k: HirExprKind = HirExprKind::Block { HirBlock { stmts: HirRange { start: sstart, len: used }, tail: tail } };
      hid = mk(c, k, rty, sp);
    },
    StructLit(sl) => {
      let epv: Option(HirExprId) = enum_struct_lit_expr(ast, text, c, sl, sp);
      let is_enum: bool = match epv {
        Some(_) => true,
        None => false,
      };
      if is_enum {
        hid = match epv {
          Some(h) => h,
          None => fail_at(SemaErr::Unsupported(sp)),
        };
      } else {
        let tid: TypeId = resolve_type(ast, text, c, sl.ty, sp);
        let si: Option(u32) = struct_index(c, tid);
        let idx: u32 = match si {
          Some(v) => v,
          None => {
            return fail_at(SemaErr::TypeMismatch(sp));
          },
        };
        let istart: u32 = c.hir.inits.len() as u32;
        let ii: u64 = 0;
        while ii < (sl.inits.len as u64) {
          let fi: FieldInit = ast.inits.get((sl.inits.start as u64) + ii);
          let fname: Slice(u8) = Span::slice(fi.name, text);
          let found: Option(u32) = HirModule::find_field(ref_of(deref(c).hir), idx, fname);
          let abs: u32 = match found {
            Some(v) => v,
            None => {
              return fail_at(SemaErr::UnknownField(fi.span));
            },
          };
          let info: FieldInfo = HirModule::field_at(ref_of(deref(c).hir), abs);
          let vh: HirExprId = check_expr_as(ast, text, c, fi.val, Option(TypeId)::some(info.ty));
          HirModule::add_init(mut_of(deref(c).hir), HirFieldInit { index: abs, val: vh });
          ii = ii + 1;
        };
        let used: u32 = (c.hir.inits.len() as u32) - istart;
        let k: HirExprKind = HirExprKind::StructLit { HirStructLit { struct_idx: idx, inits: HirRange { start: istart, len: used } } };
        hid = mk(c, k, tid, sp);
      }
    },
    Match(mx) => {
      hid = check_match(ast, text, c, mx, want, sp);
    },
    _ => {
      hid = fail_at(SemaErr::Unsupported(sp));
    },
  };
  return hid;
};

let check_fn = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), fd: FlatDecl, ld: LetDecl, fe: FuncExpr, fidx: u32)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let slot: Mut(bool) = deref(c).fn_checked.get_mut(fidx as u64);
  deref(slot) = true;
  let saved: Scope = Scope::swap(mut_of(deref(c).locals), Scope::new());
  let saved_ret: TypeId = c.cur_ret;
  let sp: Span = ast.decl_spans.get(fd.id as u64);
  let fid: HirFnId = HirFnId { idx: fidx };
  let f: HirFn = HirModule::fn_at(ref_of(deref(c).hir), fid);
  Scope::push_scope(mut_of(deref(c).locals));
  let lstart: u32 = c.hir.locals.len() as u32;
  let pcount: u64 = f.params.len as u64;
  let pi: u64 = 0;
  while pi < pcount {
    let pidx: u32 = f.params.start + (pi as u32);
    let p: HirParam = HirModule::param_at(ref_of(deref(c).hir), pidx);
    let lid: HirLocalId = HirModule::add_local(mut_of(deref(c).hir), HirLocal { name: p.name, ty: p.ty });
    HirModule::set_param_local(mut_of(deref(c).hir), pidx, lid);
    let kind: SymKind = SymKind::Local { lid };
    Scope::define(mut_of(deref(c).locals), p.name, kind, sp);
    pi = pi + 1;
  };
  c.cur_ret = f.ret_ty;
  collect_effects(ast, text, fe.effects, sp);
  let ebase: u64 = push_cur_effs(ast, text, c, fe.effects);
  let has_wit: bool = (fe.witnesses.len as u64) > 0;
  if has_wit {
    Scope::push_scope(mut_of(deref(c).type_params));
    let wi: u64 = 0;
    while wi < (fe.witnesses.len as u64) {
      let wp: WitnessParam = ast.witnesses.get((fe.witnesses.start as u64) + wi);
      match wp.default_expr {
        Some(dm) => {
          let mo: Option(u32) = resolve_module_expr(ast, text, c, dm, wp.span);
          match mo {
            Some(mi) => {
              let wname: Slice(u8) = Span::slice(wp.name, text);
              let mkind: SymKind = SymKind::ModuleDef { mi };
              Scope::define(mut_of(deref(c).type_params), wname, mkind, wp.span);
            },
            None => {},
          };
        },
        None => {},
      };
      wi = wi + 1;
    };
  }
  let body: HirExprId = check_expr_as(ast, text, c, fe.body, Option(TypeId)::none());
  deref(c).cur_eff_names.truncate(ebase);
  if has_wit {
    Scope::pop_scope(mut_of(deref(c).type_params));
  }
  let used: u32 = (c.hir.locals.len() as u32) - lstart;
  HirModule::set_fn_body(mut_of(deref(c).hir), fid, body, HirRange { start: lstart, len: used });
  let _spent: Scope = Scope::swap(mut_of(deref(c).locals), reloc(saved));
  c.cur_ret = saved_ret;
};

let ensure_fn_checked = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), fidx: u32)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let done: bool = deref(c).fn_checked.get(fidx as u64);
  if done == false {
    let saved_mod: Option(u32) = deref(c).cur_mod;
    let m_i: u64 = 0;
    while m_i < deref(c).mod_fns.len() {
      let mf: ModFnEntry = deref(c).mod_fns.get(m_i);
      if mf.fid.idx == fidx {
        deref(c).cur_mod = Option(u32)::some(mf.mod_idx);
      }
      m_i = m_i + 1;
    };
    let fd: FlatDecl = deref(c).fn_decls.get(fidx as u64);
    let d: Decl = ast.decls.get(fd.id as u64);
    match d {
      Let(ld) => {
        let init: Expr = ast.exprs.get(ld.init.idx as u64);
        match init {
          Func(fe) => {
            check_fn(ast, text, c, fd, ld, fe, fidx);
          },
          _ => {},
        };
      },
      _ => {},
    };
    deref(c).cur_mod = saved_mod;
  }
};

let check_bodies = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let mi: u64 = 0;
  while mi < deref(c).mod_fns.len() {
    let mf: ModFnEntry = deref(c).mod_fns.get(mi);
    if deref(c).fn_checked.get(mf.fid.idx as u64) == false {
      let saved_mod: Option(u32) = deref(c).cur_mod;
      deref(c).cur_mod = Option(u32)::some(mf.mod_idx);
      let d: Decl = ast.decls.get(mf.decl_id as u64);
      match d {
        Let(ld) => {
          let init: Expr = ast.exprs.get(ld.init.idx as u64);
          match init {
            Func(fe) => {
              check_fn(ast, text, c, FlatDecl { id: mf.decl_id, is_pub: ld.is_pub }, ld, fe, mf.fid.idx);
            },
            _ => {},
          };
        },
        _ => {},
      };
      deref(c).cur_mod = saved_mod;
    }
    mi = mi + 1;
  };
  let i: u64 = 0;
  while i < deref(c).fn_decls.len() {
    let done: bool = deref(c).fn_checked.get(i);
    if done == false {
      let fd: FlatDecl = deref(c).fn_decls.get(i);
      let d: Decl = ast.decls.get(fd.id as u64);
      match d {
        Let(ld) => {
          let init: Expr = ast.exprs.get(ld.init.idx as u64);
          match init {
            Func(fe) => {
              check_fn(ast, text, c, fd, ld, fe, i as u32);
            },
            _ => {},
          };
        },
        _ => {},
      };
    }
    i = i + 1;
  };
};

let ensure_const = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx), cidx: u32)
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let cd0: ConstDecl = deref(c).consts.get(cidx as u64);
  let done: bool = cd0.evaluated;
  if done == false {
    let saved: Scope = Scope::swap(mut_of(deref(c).locals), Scope::new());
    let cd: ConstDecl = deref(c).consts.get(cidx as u64);
    let slot: Mut(ConstDecl) = deref(c).consts.get_mut(cidx as u64);
    slot.evaluated = true;
    let sp: Span = ast.decl_spans.get(cd.decl_id as u64);
    let d: Decl = ast.decls.get(cd.decl_id as u64);
    match d {
      Let(ld) => {
        let want: Option(TypeId) = Option(TypeId)::none();
        match ld.ty {
          Some(te) => {
            want = Option(TypeId)::some(resolve_type(ast, text, c, te, sp));
          },
          None => {},
        };
        let init: HirExprId = check_expr_as(ast, text, c, ld.init, want);
        let ity: TypeId = expr_ty(c, init);
        let v: u64 = eval_hir_u64(ref_of(deref(c).hir), init, ity, sp)!;
        let out: Mut(ConstDecl) = deref(c).consts.get_mut(cidx as u64);
        out.ty = ity;
        out.val = v;
        out.evaluated = true;
      },
      _ => {
        perform SemaFail::fail(SemaErr::Unsupported(sp));
      },
    };
    let _spent: Scope = Scope::swap(mut_of(deref(c).locals), reloc(saved));
  }
};

let eval_all_consts = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let i: u64 = 0;
  while i < deref(c).consts.len() {
    ensure_const(ast, text, c, i as u32);
    i = i + 1;
  };
};

let apply_uses_and_aliases = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  let ui: u64 = 0;
  while ui < c.decls.len() {
    let ufd: FlatDecl = c.decls.get(ui);
    let ud: Decl = ast.decls.get(ufd.id as u64);
    match ud {
      Use(u) => {
        let tsp: Span = ast.expr_spans.get(u.target.idx as u64);
        let mod_opt: Option(u32) = resolve_module_expr(ast, text, c, u.target, tsp);
        let has_mid: bool = false;
        let midx: u32 = 0;
        match mod_opt {
          Some(mi) => {
            has_mid = true;
            midx = mi;
          },
          None => {},
        };
        if has_mid == false {
          perform SemaFail::fail(SemaErr::UnknownIdent(tsp));
        } else {
          let nj: u64 = 0;
          while nj < (u.names.len as u64) {
            let nsp: Span = ast.path_segs.get((u.names.start as u64) + nj);
            let mem_name: Slice(u8) = Span::slice(nsp, text);
            let mem_found: Option(SymEntry) = mod_lookup(c, midx, mem_name);
            let mem_ok: bool = false;
            match mem_found {
              Some(me) => {
                let ek: SymKind = me.kind;
                Scope::define(mut_of(deref(c).globals), mem_name, ek, nsp);
                mem_ok = true;
              },
              None => {},
            };
            if mem_ok == false {
              perform SemaFail::fail(SemaErr::UnknownIdent(nsp));
            }
            nj = nj + 1;
          };
        }
      },
      Let(ld) => {
        let tex: Expr = ast.exprs.get(ld.init.idx as u64);
        let is_id: bool = false;
        match tex {
          Ident(_s) => { is_id = true; },
          _ => {},
        };
        if is_id {
          let asp: Span = ast.decl_spans.get(ufd.id as u64);
          let mod_opt: Option(u32) = resolve_module_expr(ast, text, c, ld.init, asp);
          match mod_opt {
            Some(mi) => {
              let aname: Slice(u8) = Span::slice(ld.name, text);
              Scope::define(mut_of(deref(c).globals), aname, SymKind::ModuleDef(mi), asp);
            },
            None => {},
          };
        }
      },
      _ => {},
    };
    ui = ui + 1;
  };
};

let run = func(ast: Ref(AstModule()), text: Slice(u8), c: Mut(Ctx))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail }
{
  seed_builtins(c, Span::empty(ast.src, 0));
  flatten_decls(ast, c);
  declare_modules_and_sigs(ast, text, c)!;
  apply_uses_and_aliases(ast, text, c)!;
  declare_structs(ast, text, c)!;
  declare_enums(ast, text, c)!;
  declare_fns(ast, text, c)!;
  check_bodies(ast, text, c)!;
  eval_all_consts(ast, text, c)!;
};

pub let check_module = func(ast: Ref(AstModule()), text: Slice(u8))
  ?{ al: Allocator = SystemAlloc } !{ OomErr, SemaFail } -> HirModule
{
  let c0: Ctx = new_ctx();
  let c: Mut(Ctx) = mut_of(c0);
  run(ast, text, c)!;
  let res: HirModule = HirModule::take(mut_of(deref(c).hir));
  return reloc(res);
};
