use import("std::mem")::{ OomErr };
use import("frontend::syntax::span")::{ Span };
use import("frontend::sema::hir")::{ HirModule, HirExprId, TypeId, SemaErr, SemaFail };
use import("frontend::lower::emit")::{ lower_eval_expr, LowerFail };
use import("kernel::ir::model")::{ IrModule };
use import("kernel::ir::verify")::{ verify_module, VerifyErr };
use import("kernel::ir::opt")::{ optimize_module };
use import("kernel::vm::trap")::{ VmTrap };
use import("kernel::vm::engine")::{ SliceOutcome };
use import("kernel::vm::sched")::{ Limits, Sched };

let run_sched_eval = func(ir: Ref(IrModule), entry_name: Slice(u8), out: Mut(u64), ok: Mut(bool))
  !{ OomErr, VmTrap } -> u64
{
  let limits: Limits = Limits {
    fuel_slice: 100000,
    max_call_depth: 32,
    stack_cap: 16384,
    heap_cap: 65536
  };
  let empty_args: Slice(u64) = make_slice(Slice(u64), null_ref(Ref(u64)), 0);
  let res: SliceOutcome = Sched::apply(ir, entry_name, empty_args, limits);
  let _u: u64 = match res {
    Done(val) => {
      deref(out) = val;
      deref(ok) = true;
      0
    },
    _ => 0,
  };
  return 0;
};

let run_verify_eval = func(ir: Mut(IrModule), entry_name: Slice(u8), out: Mut(u64), ok: Mut(bool), oom_n: Mut(u64), oom_hit: Mut(bool))
  !{ OomErr, VerifyErr } -> u64
{
  verify_module(ir);
  optimize_module(ir);
  return handle run_sched_eval(ir, entry_name, out, ok) with {
    return(v) => v,
    oom(n) => {
      deref(oom_n) = n;
      deref(oom_hit) = true;
      1
    },
    fail(_) => 2,
  };
};

let run_lower_eval = func(hir: Ref(HirModule), expr_id: HirExprId, ret_ty: TypeId, entry_name: Slice(u8), out: Mut(u64), ok: Mut(bool), oom_n: Mut(u64), oom_hit: Mut(bool))
  !{ OomErr, LowerFail } -> u64
{
  let ir: IrModule = lower_eval_expr(hir, expr_id, ret_ty, entry_name);
  return handle run_verify_eval(mut_of(ir), entry_name, out, ok, oom_n, oom_hit) with {
    return(v) => v,
    oom(n) => {
      deref(oom_n) = n;
      deref(oom_hit) = true;
      1
    },
    fail(_) => 2,
  };
};

pub let eval_hir_u64 = func(hir: Ref(HirModule), expr_id: HirExprId, ret_ty: TypeId, span: Span)
  !{ OomErr, SemaFail } -> u64
{
  let oom_n_val: u64 = 0;
  let oom_hit_val: bool = false;
  let out_val: u64 = 0;
  let ok_val: bool = false;
  let oom_n: Mut(u64) = mut_of(oom_n_val);
  let oom_hit: Mut(bool) = mut_of(oom_hit_val);
  let out: Mut(u64) = mut_of(out_val);
  let ok: Mut(bool) = mut_of(ok_val);
  let _rc: u64 = handle run_lower_eval(hir, expr_id, ret_ty, "__ct_eval", out, ok, oom_n, oom_hit) with {
    return(v) => v,
    oom(n) => {
      deref(oom_n) = n;
      deref(oom_hit) = true;
      1
    },
    fail(_) => 2,
  };
  if deref(oom_hit) {
    perform OomErr::oom(deref(oom_n));
  }
  if deref(ok) == false {
    perform SemaFail::fail(SemaErr::ComptimeTrap { span });
  }
  return deref(out);
};

pub let eval_hir_bool = func(hir: Ref(HirModule), expr_id: HirExprId, bool_ty: TypeId, span: Span)
  !{ OomErr, SemaFail } -> bool
{
  return eval_hir_u64(hir, expr_id, bool_ty, span)! != 0;
};
