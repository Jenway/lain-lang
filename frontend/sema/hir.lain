use import("std::collections")::{ Vec };
use import("std::mem")::{ OomErr };
use import("std::option")::{ Option };
use import("std::err")::{ Fail };
use import("std::str")::{ eq };
use import("frontend::syntax::span")::{ Span };
use import("frontend::ast::model")::{ UnOp, BinOp };

pub {
  let TypeId = struct {
    idx: u32
  };

  let SymId = struct {
    idx: u32
  };

  let HirFnId = struct {
    idx: u32
  };

  let HirLocalId = struct {
    idx: u32
  };

  let HirExprId = struct {
    idx: u32
  };

  let HirStmtId = struct {
    idx: u32
  };

  let HirRange = struct {
    start: u32,
    len: u32
  };

  let SemaErr = enum {
    UnknownIdent(Span)
    TypeMismatch(Span)
    ArityMismatch(Span)
    UnknownField(Span)
    UnhandledEffect(Span)
    DuplicateSym(Span)
    Unsupported(Span)
    ComptimeTrap(Span)
  };

  let SemaFail = Fail(SemaErr);

  let IntInfo = struct {
    bits: u8,
    signed: bool
  };

  let ArrayInfo = struct {
    elem: TypeId,
    len: u64,
    size: u32,
    align: u32
  };

  let HirType = enum {
    Void
    Bool
    Int(IntInfo)
    Float(u8)
    Ref(TypeId)
    Mut(TypeId)
    Struct(u32)
    Enum(u32)
    Fn(u32)
    FnPtr(u32)
    Array(ArrayInfo)
    HirNever
    TypeMeta
  };

  let FieldInfo = struct {
    name: Slice(u8),
    ty: TypeId,
    offset: u32
  };

  let StructInfo = struct {
    name: Slice(u8),
    fields: HirRange,
    size: u32,
    align: u32
  };

  let VariantInfo = struct {
    name: Slice(u8),
    payload_ty: TypeId,
    has_payload: bool,
    tag_val: u64
  };

  let EnumInfo = struct {
    name: Slice(u8),
    variants: HirRange,
    tag_size: u32,
    payload_off: u32,
    size: u32,
    align: u32,
    is_tagged_union: bool
  };

  let HirEnumLit = struct {
    enum_idx: u32,
    variant_idx: u32,
    payload: Option(HirExprId)
  };

  let HirMatchArm = struct {
    tag_val: u64,
    is_wildcard: bool,
    bind_local: Option(HirLocalId),
    body: HirExprId
  };

  let HirMatch = struct {
    scrutinee: HirExprId,
    enum_idx: u32,
    arms: HirRange
  };

  let HirPtrOffset = struct {
    base: HirExprId,
    index: HirExprId,
    elem_size: u32
  };

  let HirMemWrite = struct {
    dst: HirExprId,
    val: HirExprId
  };

  let HirDropAt = struct {
    dst: HirExprId
  };

  let HirParam = struct {
    name: Slice(u8),
    ty: TypeId,
    local: HirLocalId
  };

  let HirLocal = struct {
    name: Slice(u8),
    ty: TypeId
  };

  let HirUnary = struct {
    op: UnOp,
    operand: HirExprId
  };

  let HirBinary = struct {
    op: BinOp,
    lhs: HirExprId,
    rhs: HirExprId
  };

  let HirCall = struct {
    callee: HirExprId,
    args: HirRange
  };

  let HirIf = struct {
    cond: HirExprId,
    then_block: HirExprId,
    else_expr: Option(HirExprId)
  };

  let HirBlock = struct {
    stmts: HirRange,
    tail: Option(HirExprId)
  };

  let HirField = struct {
    base: HirExprId,
    struct_idx: u32,
    field: u32
  };

  let HirFieldPtr = struct {
    base: HirExprId,
    offset: u32
  };

  let HirFieldInit = struct {
    index: u32,
    val: HirExprId
  };

  let HirStructLit = struct {
    struct_idx: u32,
    inits: HirRange
  };

  let HirCast = struct {
    expr: HirExprId,
    to: TypeId
  };

  let HirPerform = struct {
    eff_idx: u32,
    op_idx: u32,
    args: HirRange
  };

  let HirHandleArm = struct {
    is_return: bool,
    op_idx: u32,
    bind_local: Option(HirLocalId),
    body: HirExprId,
    span: Span
  };

  let HirHandle = struct {
    eff_idx: u32,
    body: HirExprId,
    arms: HirRange
  };

  let HirArrayRepeat = struct {
    elem: HirExprId,
    count: u64,
    elem_size: u32
  };

  let HirExprKind = enum {
    IntConst(i64)
    BoolConst(bool)
    Local(HirLocalId)
    Fn(HirFnId)
    Unary(HirUnary)
    Binary(HirBinary)
    Call(HirCall)
    If(HirIf)
    Block(HirBlock)
    Field(HirField)
    StructLit(HirStructLit)
    Cast(HirCast)
    AddrOf(HirExprId)
    Deref(HirExprId)
    PtrOffset(HirPtrOffset)
    InitAt(HirMemWrite)
    DropAt(HirDropAt)
    EnumLit(HirEnumLit)
    Match(HirMatch)
    StrLit(u32)
    FieldPtr(HirFieldPtr)
    Reloc(HirExprId)
    Perform(HirPerform)
    Handle(HirHandle)
    ArrayRepeat(HirArrayRepeat)
  };

  let HirExpr = struct {
    kind: HirExprKind,
    ty: TypeId,
    span: Span
  };

  let HirLet = struct {
    local: HirLocalId,
    init: HirExprId
  };

  let HirAssign = struct {
    target: HirExprId,
    val: HirExprId
  };

  let HirWhile = struct {
    cond: HirExprId,
    body: HirExprId
  };

  let HirStmt = enum {
    Let(HirLet)
    Assign(HirAssign)
    Expr(HirExprId)
    Return(Option(HirExprId))
    While(HirWhile)
    Break
    Continue
  };

  let HirFn = struct {
    name: Slice(u8),
    is_pub: bool,
    is_extern: bool,
    link_name: Slice(u8),
    params: HirRange,
    locals: HirRange,
    ret_ty: TypeId,
    body: HirExprId,
    span: Span
  };
};

pub let HirModule = module {
  let TypeVec = Vec(HirType);
  let StructVec = Vec(StructInfo);
  let FieldVec = Vec(FieldInfo);
  let FnVec = Vec(HirFn);
  let ParamVec = Vec(HirParam);
  let LocalVec = Vec(HirLocal);
  let ExprVec = Vec(HirExpr);
  let StmtVec = Vec(HirStmt);
  let ExprIdVec = Vec(HirExprId);
  let StmtIdVec = Vec(HirStmtId);
  let InitVec = Vec(HirFieldInit);
  let VariantVec = Vec(VariantInfo);
  let EnumVec = Vec(EnumInfo);
  let MatchArmVec = Vec(HirMatchArm);
  let HandleArmVec = Vec(HirHandleArm);
  let StrLitVec = Vec(HirRange);
  let ByteVec = Vec(u8);

  pub {
    let Self = struct {
      types: TypeVec,
      structs: StructVec,
      fields: FieldVec,
      fns: FnVec,
      params: ParamVec,
      locals: LocalVec,
      exprs: ExprVec,
      stmts: StmtVec,
      expr_lists: ExprIdVec,
      stmt_lists: StmtIdVec,
      inits: InitVec,
      enums: EnumVec,
      variants: VariantVec,
      match_arms: MatchArmVec,
      handle_arms: HandleArmVec,
      str_lits: StrLitVec,
      str_bytes: ByteVec
    };

    let new = func() -> Self {
      return Self {
        types: TypeVec::new(),
        structs: StructVec::new(),
        fields: FieldVec::new(),
        fns: FnVec::new(),
        params: ParamVec::new(),
        locals: LocalVec::new(),
        exprs: ExprVec::new(),
        stmts: StmtVec::new(),
        expr_lists: ExprIdVec::new(),
        stmt_lists: StmtIdVec::new(),
        inits: InitVec::new(),
        enums: EnumVec::new(),
        variants: VariantVec::new(),
        match_arms: MatchArmVec::new(),
        handle_arms: HandleArmVec::new(),
        str_lits: StrLitVec::new(),
        str_bytes: ByteVec::new()
      };
    };

    let type_count = func(h: Ref(Self)) -> u32 {
      return h.types.len() as u32;
    };

    let struct_count = func(h: Ref(Self)) -> u32 {
      return h.structs.len() as u32;
    };

    let fn_count = func(h: Ref(Self)) -> u32 {
      return h.fns.len() as u32;
    };

    let local_count = func(h: Ref(Self)) -> u32 {
      return h.locals.len() as u32;
    };

    let expr_count = func(h: Ref(Self)) -> u32 {
      return h.exprs.len() as u32;
    };

    let stmt_count = func(h: Ref(Self)) -> u32 {
      return h.stmts.len() as u32;
    };

    let add_type = func(h: Mut(Self), t: HirType) !{ OomErr } -> TypeId {
      let id: TypeId = TypeId { idx: h.types.len() as u32 };
      h.types.push(t);
      return id;
    };

    let add_struct = func(h: Mut(Self), s: StructInfo) !{ OomErr } -> u32 {
      let idx: u32 = h.structs.len() as u32;
      h.structs.push(s);
      return idx;
    };

    let add_field = func(h: Mut(Self), f: FieldInfo) !{ OomErr } -> u32 {
      let idx: u32 = h.fields.len() as u32;
      h.fields.push(f);
      return idx;
    };

    let add_fn = func(h: Mut(Self), f: HirFn) !{ OomErr } -> HirFnId {
      let id: HirFnId = HirFnId { idx: h.fns.len() as u32 };
      h.fns.push(f);
      return id;
    };

    let add_param = func(h: Mut(Self), p: HirParam) !{ OomErr } -> u32 {
      let idx: u32 = h.params.len() as u32;
      h.params.push(p);
      return idx;
    };

    let add_local = func(h: Mut(Self), l: HirLocal) !{ OomErr } -> HirLocalId {
      let id: HirLocalId = HirLocalId { idx: h.locals.len() as u32 };
      h.locals.push(l);
      return id;
    };

    let add_expr = func(h: Mut(Self), e: HirExpr) !{ OomErr } -> HirExprId {
      let id: HirExprId = HirExprId { idx: h.exprs.len() as u32 };
      h.exprs.push(e);
      return id;
    };

    let add_stmt = func(h: Mut(Self), s: HirStmt) !{ OomErr } -> HirStmtId {
      let id: HirStmtId = HirStmtId { idx: h.stmts.len() as u32 };
      h.stmts.push(s);
      return id;
    };

    let add_expr_id = func(h: Mut(Self), e: HirExprId) !{ OomErr } {
      h.expr_lists.push(e);
    };

    let add_stmt_id = func(h: Mut(Self), s: HirStmtId) !{ OomErr } {
      h.stmt_lists.push(s);
    };

    let add_init = func(h: Mut(Self), i: HirFieldInit) !{ OomErr } -> u32 {
      let idx: u32 = h.inits.len() as u32;
      h.inits.push(i);
      return idx;
    };

    let range_from = func(start: u32, end: u32) -> HirRange {
      if end <= start {
        return HirRange { start: start, len: 0 };
      }
      return HirRange { start: start, len: end - start };
    };

    let set_struct_layout = func(h: Mut(Self), idx: u32, fields: HirRange, size: u32, align: u32) {
      let slot: Mut(StructInfo) = h.structs.get_mut(idx as u64);
      slot.fields = fields;
      slot.size = size;
      slot.align = align;
    };

    let set_fn_body = func(h: Mut(Self), id: HirFnId, body: HirExprId, locals: HirRange) {
      let slot: Mut(HirFn) = h.fns.get_mut(id.idx as u64);
      slot.body = body;
      slot.locals = locals;
    };

    let set_param_local = func(h: Mut(Self), param_idx: u32, local: HirLocalId) {
      let slot: Mut(HirParam) = h.params.get_mut(param_idx as u64);
      slot.local = local;
    };

    let set_expr_ty = func(h: Mut(Self), id: HirExprId, ty: TypeId) {
      let slot: Mut(HirExpr) = h.exprs.get_mut(id.idx as u64);
      slot.ty = ty;
    };

    let type_at = func(h: Ref(Self), id: TypeId) -> HirType {
      return h.types.get(id.idx as u64);
    };

    let struct_at = func(h: Ref(Self), idx: u32) -> StructInfo {
      return h.structs.get(idx as u64);
    };

    let field_at = func(h: Ref(Self), idx: u32) -> FieldInfo {
      return h.fields.get(idx as u64);
    };

    let fn_at = func(h: Ref(Self), id: HirFnId) -> HirFn {
      return h.fns.get(id.idx as u64);
    };

    let param_at = func(h: Ref(Self), idx: u32) -> HirParam {
      return h.params.get(idx as u64);
    };

    let local_at = func(h: Ref(Self), id: HirLocalId) -> HirLocal {
      return h.locals.get(id.idx as u64);
    };

    let expr_at = func(h: Ref(Self), id: HirExprId) -> HirExpr {
      return h.exprs.get(id.idx as u64);
    };

    let stmt_at = func(h: Ref(Self), id: HirStmtId) -> HirStmt {
      return h.stmts.get(id.idx as u64);
    };

    let init_at = func(h: Ref(Self), idx: u32) -> HirFieldInit {
      return h.inits.get(idx as u64);
    };

    let expr_in = func(h: Ref(Self), r: HirRange, i: u32) -> HirExprId {
      return h.expr_lists.get((r.start + i) as u64);
    };

    let stmt_in = func(h: Ref(Self), r: HirRange, i: u32) -> HirStmtId {
      return h.stmt_lists.get((r.start + i) as u64);
    };

    let find_fn = func(h: Ref(Self), name: Slice(u8)) -> Option(HirFnId) {
      let n: u64 = h.fns.len();
      let i: u64 = 0;
      while i < n {
        let f: HirFn = h.fns.get(i);
        if eq(f.name, name) {
          return Option(HirFnId)::some(HirFnId { idx: i as u32 });
        }
        i = i + 1;
      };
      return Option(HirFnId)::none();
    };

    let find_field = func(h: Ref(Self), struct_idx: u32, name: Slice(u8)) -> Option(u32) {
      let st: StructInfo = h.structs.get(struct_idx as u64);
      let n: u64 = st.fields.len as u64;
      let i: u64 = 0;
      while i < n {
        let f: FieldInfo = h.fields.get(st.fields.start as u64 + i);
        if eq(f.name, name) {
          return Option(u32)::some((st.fields.start as u64 + i) as u32);
        }
        i = i + 1;
      };
      return Option(u32)::none();
    };

    let add_enum = func(h: Mut(Self), e: EnumInfo) !{ OomErr } -> u32 {
      let idx: u32 = h.enums.len() as u32;
      h.enums.push(e);
      return idx;
    };

    let add_variant = func(h: Mut(Self), v: VariantInfo) !{ OomErr } -> u32 {
      let idx: u32 = h.variants.len() as u32;
      h.variants.push(v);
      return idx;
    };

    let set_enum_layout = func(h: Mut(Self), idx: u32, variants: HirRange, tag_size: u32, payload_off: u32, size: u32, align: u32, is_tagged_union: bool) {
      let slot: Mut(EnumInfo) = h.enums.get_mut(idx as u64);
      slot.variants = variants;
      slot.tag_size = tag_size;
      slot.payload_off = payload_off;
      slot.size = size;
      slot.align = align;
      slot.is_tagged_union = is_tagged_union;
    };

    let enum_at = func(h: Ref(Self), idx: u32) -> EnumInfo {
      return h.enums.get(idx as u64);
    };

    let variant_at = func(h: Ref(Self), idx: u32) -> VariantInfo {
      return h.variants.get(idx as u64);
    };

    let find_variant = func(h: Ref(Self), enum_idx: u32, name: Slice(u8)) -> Option(u32) {
      let en: EnumInfo = h.enums.get(enum_idx as u64);
      let n: u64 = en.variants.len as u64;
      let i: u64 = 0;
      while i < n {
        let v: VariantInfo = h.variants.get(en.variants.start as u64 + i);
        if eq(v.name, name) {
          return Option(u32)::some((en.variants.start as u64 + i) as u32);
        }
        i = i + 1;
      };
      return Option(u32)::none();
    };

    let add_match_arm = func(h: Mut(Self), arm: HirMatchArm) !{ OomErr } -> u32 {
      let idx: u32 = h.match_arms.len() as u32;
      h.match_arms.push(arm);
      return idx;
    };

    let match_arm_in = func(h: Ref(Self), r: HirRange, i: u32) -> HirMatchArm {
      return h.match_arms.get((r.start + i) as u64);
    };

    let add_str_lit = func(h: Mut(Self), bytes: Slice(u8)) !{ OomErr } -> u32 {
      let start: u32 = h.str_bytes.len() as u32;
      let n: u64 = bytes.len;
      let i: u64 = 0;
      while i < n {
        h.str_bytes.push(bytes[i]);
        i = i + 1;
      };
      let idx: u32 = h.str_lits.len() as u32;
      h.str_lits.push(HirRange { start: start, len: n as u32 });
      return idx;
    };

    let str_lit_count = func(h: Ref(Self)) -> u32 {
      return h.str_lits.len() as u32;
    };

    let str_lit_at = func(h: Ref(Self), idx: u32) -> HirRange {
      return h.str_lits.get(idx as u64);
    };

    let str_byte_at = func(h: Ref(Self), idx: u32) -> u8 {
      return h.str_bytes.get(idx as u64);
    };

    let add_handle_arm = func(h: Mut(Self), arm: HirHandleArm) !{ OomErr } -> u32 {
      let id: u32 = h.handle_arms.len() as u32;
      h.handle_arms.push(arm);
      return id;
    };

    let handle_arm_at = func(h: Ref(Self), idx: u32) -> HirHandleArm {
      return h.handle_arms.get(idx as u64);
    };

    let take = func(h: Mut(Self)) -> Self {
      let out0: Self = Self {
        types: deref(h).types.take(),
        structs: deref(h).structs.take(),
        fields: deref(h).fields.take(),
        fns: deref(h).fns.take(),
        params: deref(h).params.take(),
        locals: deref(h).locals.take(),
        exprs: deref(h).exprs.take(),
        stmts: deref(h).stmts.take(),
        expr_lists: deref(h).expr_lists.take(),
        stmt_lists: deref(h).stmt_lists.take(),
        inits: deref(h).inits.take(),
        enums: deref(h).enums.take(),
        variants: deref(h).variants.take(),
        match_arms: deref(h).match_arms.take(),
        handle_arms: deref(h).handle_arms.take(),
        str_lits: deref(h).str_lits.take(),
        str_bytes: deref(h).str_bytes.take()
      };
      return reloc(out0);
    };
  };
};
