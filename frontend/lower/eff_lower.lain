pub {
  let EffPlan = struct {
    is_abortive: bool,
    status_slot: u32
  };
};

pub let EffLower = module {
  pub {
    let Self = struct {
      plan: EffPlan
    };

    let new = func() -> Self {
      return Self { plan: EffPlan { is_abortive: false, status_slot: 0 } };
    };

    let mark_abortive = func(e: Mut(Self), slot: u32) {
      e.plan = EffPlan { is_abortive: true, status_slot: slot };
    };

    let needs_status = func(e: Ref(Self)) -> bool {
      return e.plan.is_abortive;
    };
  };
};
