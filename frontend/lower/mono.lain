use import("std::collections")::{ Vec };
use import("std::mem")::{ OomErr };
use import("std::option")::{ Option };
use import("frontend::sema::hir")::{ HirFnId };
use import("kernel::ir::builder")::{ ProcId };

pub {
  let MonoEntry = struct {
    fn_id: HirFnId,
    proc_id: ProcId
  };
};

pub let MonoTable = module {
  let EntryVec = Vec(MonoEntry);

  pub {
    let Self = struct {
      entries: EntryVec
    };

    let new = func() -> Self {
      return Self { entries: EntryVec::new() };
    };

    let register = func(t: Mut(Self), fn_id: HirFnId, proc_id: ProcId) !{ OomErr } {
      let n: u64 = t.entries.len();
      let i: u64 = 0;
      while i < n {
        let e: MonoEntry = t.entries.get(i);
        if e.fn_id.idx == fn_id.idx {
          let slot: Mut(MonoEntry) = t.entries.get_mut(i);
          slot.proc_id = proc_id;
          return;
        }
        i = i + 1;
      };
      t.entries.push(MonoEntry { fn_id: fn_id, proc_id: proc_id });
    };

    let lookup = func(t: Ref(Self), fn_id: HirFnId) -> Option(ProcId) {
      let n: u64 = t.entries.len();
      let i: u64 = 0;
      while i < n {
        let e: MonoEntry = t.entries.get(i);
        if e.fn_id.idx == fn_id.idx {
          return Option(ProcId)::some(e.proc_id);
        }
        i = i + 1;
      };
      return Option(ProcId)::none();
    };

    let count = func(t: Ref(Self)) -> u64 {
      let n: u64 = t.entries.len();
      return n;
    };
  };
};
