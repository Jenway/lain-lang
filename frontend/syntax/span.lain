pub {
  let SourceId = struct {
    idx: u32
  };

  let Span = module {
    pub {
      let Self = struct {
        src: SourceId,
        start: u32,
        end: u32
      };

      let make = func(src: SourceId, start: u32, end: u32) -> Self {
        return Self { src: src, start: start, end: end };
      };

      let empty = func(src: SourceId, at: u32) -> Self {
        return Self { src: src, start: at, end: at };
      };

      let len = func(s: Self) -> u32 {
        if s.end <= s.start {
          return 0;
        }
        return s.end - s.start;
      };

      let is_empty = func(s: Self) -> bool {
        return s.end <= s.start;
      };

      let merge = func(a: Self, b: Self) -> Self {
        let lo: u32 = if a.start < b.start { a.start } else { b.start };
        let hi: u32 = if a.end > b.end { a.end } else { b.end };
        return Self { src: a.src, start: lo, end: hi };
      };

      let touches = func(a: Self, b: Self) -> bool {
        return (a.src.idx == b.src.idx) and (a.end == b.start);
      };
    };
  };
};
