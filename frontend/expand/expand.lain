use import("std::collections")::{ Vec };
use import("std::mem")::{ Allocator, SystemAlloc, OomErr };
use import("std::option")::{ Option };
use import("frontend::syntax::span")::{ Span };
use import("frontend::syntax::raw_ast")::{ SyntaxFail, NodeId, Delim, GroupRange, RawNode, RawAst };
use import("frontend::expand::env")::{ SyntaxEnv, MacroRule };
use import("frontend::expand::sugar")::{ desugar, ExpandErr, ExpandFail };

let ScanFrame = struct {
  grp: GroupRange,
  depth: u64
};

let macro_rule = func(env: Ref(SyntaxEnv), ast: Ref(RawAst()), text: Slice(u8), id: NodeId)
  ?{ al: Allocator = SystemAlloc }
  -> Option(u64)
{
  let node: RawNode = ast.node(id);
  let is_ident: bool = match node {
    Ident => true,
    _ => false
  };
  if is_ident == false {
    return Option(u64)::none();
  }
  let name: Slice(u8) = ast.text_of(text, id);
  if SyntaxEnv::is_core_form(name) {
    return Option(u64)::none();
  }
  return SyntaxEnv::lookup(env, name);
};

let check_macros = func(ast: Ref(RawAst()), text: Slice(u8), env: Ref(SyntaxEnv), root: NodeId)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail } -> u64
{
  let root_node: RawNode = ast.node(root);
  let has_root: bool = match root_node {
    Group(_) => true,
    _ => false
  };
  if has_root == false {
    return 0;
  }
  let root_grp: GroupRange = match root_node {
    Group(g) => g,
    _ => GroupRange { delim: Delim::Root, start: 0, len: 0 }
  };
  let stack: Vec(ScanFrame) = Vec(ScanFrame)::new();
  stack.push(ScanFrame { grp: root_grp, depth: 0 });
  let deepest: u64 = 0;

  while stack.len() > 0 {
    let top_idx: u64 = stack.len() - 1;
    let frame: ScanFrame = stack.get(top_idx);
    stack.truncate(top_idx);
    let grp: GroupRange = frame.grp;
    let depth: u64 = frame.depth;
    let n: u64 = grp.len as u64;
    let i: u64 = 0;
    while i < n {
      let id: NodeId = ast.child_at(grp, i as u32);
      let found: Option(u64) = macro_rule(env, ast, text, id);
      let is_macro: bool = match found {
        Some(_) => true,
        _ => false
      };
      if is_macro {
        let sp_m: Span = ast.span(id);
        let d: u64 = depth + 1;
        if d > 64 {
          perform ExpandFail::fail(ExpandErr::DepthLimit { sp_m });
        }
        let idx: u64 = match found {
          Some(k) => k,
          _ => 0
        };
        let rule: MacroRule = SyntaxEnv::rule_at(env, idx);
        if rule.proc_name.len == 0 {
          perform ExpandFail::fail(ExpandErr::MacroFailed { sp_m });
        }
        if d > deepest {
          deepest = d;
        }
        let j: u64 = i + 1;
        let pushed_body: bool = false;
        if j < n {
          let bid: NodeId = ast.child_at(grp, j as u32);
          let bnode: RawNode = ast.node(bid);
          let sp_b: Span = ast.span(bid);
          if Span::touches(sp_m, sp_b) {
            let _pb: u64 = match bnode {
              Group(bg) => {
                stack.push(ScanFrame { grp: bg, depth: d });
                pushed_body = true;
                1
              },
              _ => 0
            };
          }
        }
        if pushed_body {
          i = i + 2;
        } else {
          i = i + 1;
        }
      } else {
        let cnode: RawNode = ast.node(id);
        let _pc: u64 = match cnode {
          Group(cg) => { stack.push(ScanFrame { grp: cg, depth: depth }); 1 },
          _ => 0
        };
        i = i + 1;
      }
    };
  };
  return deepest;
};

pub let expand = func(raw: Ref(RawAst()), text: Slice(u8), env: Ref(SyntaxEnv), alloc: al::Self)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, SyntaxFail, ExpandFail } -> RawAst()
{
  let sugared: RawAst() = desugar(raw, text, alloc);
  let root: NodeId = sugared.root;
  let _depth: u64 = check_macros(ref_of(sugared), text, env, root);
  return reloc(sugared);
};
