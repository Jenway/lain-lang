use import("std::err")::{ Fail };
use import("std::io")::{ SliceCursor };
use import("std::mem")::{ Allocator, SystemAlloc, OomErr };
use import("std::str")::{ sub };
use import("frontend::syntax::span")::{ SourceId, Span };
use import("frontend::syntax::raw_ast")::{ NodeId, Delim, GroupRange, RawNode, RawAst };
use import("frontend::syntax::ast_out")::{ AstOut };
use import("frontend::syntax::reader")::{ read };

pub {
  let ExpandErr = enum {
    DepthLimit(Span)
    MacroFailed(Span)
    BadSugar(Span)
  };

  let ExpandFail = Fail(ExpandErr);
};

let shift_span = func(sp: Span, delta: u32) -> Span {
  return Span::make(sp.src, sp.start + delta, sp.end + delta);
};

let has_slot = func(text: Slice(u8), sp: Span) -> bool {
  let lo: u64 = (sp.start as u64) + 1;
  let hi: u64 = if sp.end > sp.start { (sp.end as u64) - 1 } else { lo };
  let i: u64 = lo;
  let found: bool = false;
  while (i < hi) and (found == false) {
    let c: u8 = text[i];
    if c == 92 {
      i = i + 2;
    } else if c == 123 {
      found = true;
    } else {
      i = i + 1;
    }
  };
  return found;
};

let slot_close = func(text: Slice(u8), from: u64, limit: u64, sp: Span) !{ ExpandFail } -> u64 {
  let i: u64 = from;
  let depth: u64 = 1;
  while i < limit {
    let c: u8 = text[i];
    if c == 92 {
      i = i + 2;
    } else if c == 123 {
      depth = depth + 1;
      i = i + 1;
    } else if c == 125 {
      depth = depth - 1;
      if depth == 0 {
        return i;
      }
      i = i + 1;
    } else {
      i = i + 1;
    }
  };
  perform ExpandFail::fail(ExpandErr::BadSugar(sp));
  return limit;
};

let read_slot = func(src: SourceId, text: Slice(u8), lo: u64, hi: u64, alloc: al::Self)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail } -> RawAst()
{
  let slot_text: Slice(u8) = sub(text, lo, hi);
  let cur: SliceCursor::Self = SliceCursor::new(slot_text);
  let slot_ast: RawAst() = handle read(src, mut_of(cur), alloc) with {
    return(v) => v,
    fail(err) => {
      match err {
        UnterminatedStr(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnterminatedChar(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnterminatedComment(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnmatchedClose(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnclosedGroup(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); }
      }
    }
  };
  return slot_ast;
};

let emit_slot = func(text: Slice(u8), out: Mut(AstOut() ?{ al: al }), alloc: al::Self, src: SourceId, lo: u64, hi: u64)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail, AstOutFail } -> NodeId
{
  let slot_sp: Span = Span::make(src, lo as u32, hi as u32);
  let slot_ast: RawAst() = read_slot(src, text, lo, hi, alloc);
  let root: NodeId = slot_ast.root;
  let node: RawNode = slot_ast.node(root);
  let is_group: bool = match node {
    Group(_) => true,
    _ => false
  };
  if is_group == false {
    perform ExpandFail::fail(ExpandErr::BadSugar(slot_sp));
  }
  let grp: GroupRange = match node {
    Group(g) => g,
    _ => GroupRange { delim: Delim::Root, start: 0, len: 0 }
  };
  out.begin_group(Delim::Paren, lo as u32);
  let n: u64 = grp.len as u64;
  let i: u64 = 0;
  while i < n {
    let cid: NodeId = slot_ast.child_at(grp, i as u32);
    let _c = copy_node(slot_ast, text, lo as u32, out, alloc, cid);
    i = i + 1;
  };
  return out.end_group(Delim::Paren, hi as u32);
};

let emit_fstring = func(text: Slice(u8), out: Mut(AstOut() ?{ al: al }), alloc: al::Self, f_sp: Span, lit_sp: Span)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail, AstOutFail } -> NodeId
{
  let src: SourceId = lit_sp.src;
  let lo: u64 = (lit_sp.start as u64) + 1;
  let hi: u64 = (lit_sp.end as u64) - 1;
  let piece: u64 = lo;
  let open: u64 = 0;
  let result: NodeId = NodeId { idx: 0 };
  let i: u64 = lo;
  while i < hi {
    let c: u8 = text[i];
    if c == 92 {
      i = i + 2;
    } else if c == 123 {
      let close: u64 = slot_close(text, i + 1, hi, lit_sp);
      let _callee = out.emit(RawNode::Ident, f_sp);
      out.begin_group(Delim::Paren, f_sp.start);
      open = open + 1;
      let _head = out.emit(RawNode::StrLit, Span::make(src, piece as u32, i as u32));
      let _sep0 = out.emit(RawNode::Punct(44), f_sp);
      let _slot = emit_slot(text, out, alloc, src, i + 1, close);
      let _sep1 = out.emit(RawNode::Punct(44), f_sp);
      i = close + 1;
      piece = i;
    } else {
      i = i + 1;
    }
  };
  let _tail = out.emit(RawNode::StrLit, Span::make(src, piece as u32, hi as u32));
  while open > 0 {
    result = out.end_group(Delim::Paren, lit_sp.end);
    open = open - 1;
  };
  return result;
};

let copy_children = func(src: Ref(RawAst() ?{ al: al }), text: Slice(u8), delta: u32, out: Mut(AstOut() ?{ al: al }), alloc: al::Self, grp: GroupRange)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail, AstOutFail } -> u64
{
  let n: u64 = grp.len as u64;
  let i: u64 = 0;
  while i < n {
    let id: NodeId = src.child_at(grp, i as u32);
    let used: bool = false;
    if (i + 1 < n) and (delta == 0) {
      let nid: NodeId = src.child_at(grp, (i + 1) as u32);
      let head: RawNode = src.node(id);
      let tail: RawNode = src.node(nid);
      let is_ident: bool = match head {
        Ident => true,
        _ => false
      };
      let is_lit: bool = match tail {
        StrLit => true,
        _ => false
      };
      let sp_f: Span = src.span(id);
      let sp_s: Span = src.span(nid);
      if is_ident and (is_lit and (src.text_eq(text, id, "f") and Span::touches(sp_f, sp_s))) {
        if has_slot(text, sp_s) {
          let _call = emit_fstring(text, out, alloc, sp_f, sp_s);
        } else {
          let _lit = out.emit(RawNode::StrLit, sp_s);
        }
        used = true;
        i = i + 2;
      }
    }
    if used == false {
      let _node = copy_node(src, text, delta, out, alloc, id);
      i = i + 1;
    }
  };
  return n;
};

let copy_node = func(src: Ref(RawAst() ?{ al: al }), text: Slice(u8), delta: u32, out: Mut(AstOut() ?{ al: al }), alloc: al::Self, id: NodeId)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail, AstOutFail } -> NodeId
{
  let node: RawNode = src.node(id);
  let sp: Span = src.span(id);
  return match node {
    Group(grp) => { copy_group(src, text, delta, out, alloc, grp, shift_span(sp, delta)) },
    _ => { out.emit(node, shift_span(sp, delta)) }
  };
};

let copy_group = func(src: Ref(RawAst() ?{ al: al }), text: Slice(u8), delta: u32, out: Mut(AstOut() ?{ al: al }), alloc: al::Self, grp: GroupRange, sp: Span)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail, AstOutFail } -> NodeId
{
  out.begin_group(grp.delim, sp.start);
  let _n: u64 = copy_children(src, text, delta, out, alloc, grp);
  return out.end_group(grp.delim, sp.end);
};

pub let desugar = func(raw: Ref(RawAst() ?{ al: al }), text: Slice(u8), alloc: al::Self)
  ?{ al: Allocator = SystemAlloc }
  !{ OomErr, ExpandFail } -> RawAst() ?{ al: al }
{
  let root_sp: Span = raw.span(raw.root);
  let root_node: RawNode = raw.node(raw.root);
  let is_group: bool = match root_node {
    Group(_) => true,
    _ => false
  };
  if is_group == false {
    perform ExpandFail::fail(ExpandErr::BadSugar(root_sp));
  }
  let root_grp: GroupRange = match root_node {
    Group(g) => g,
    _ => GroupRange { delim: Delim::Root, start: 0, len: 0 }
  };
  let Out = AstOut() ?{ al: al };
  let out: Out = Out::with_alloc(root_sp.src, alloc);
  let _n: u64 = handle copy_children(raw, text, 0, mut_of(out), alloc, root_grp) with {
    return(v) => v,
    fail(err) => {
      match err {
        UnmatchedClose(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnclosedGroup(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        EmptyFinish => { perform ExpandFail::fail(ExpandErr::BadSugar(root_sp)); }
      }
    }
  };
  let ast: RawAst() ?{ al: al } = handle out.finish(root_sp.end) with {
    return(v) => v,
    fail(err) => {
      match err {
        UnmatchedClose(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        UnclosedGroup(sp) => { perform ExpandFail::fail(ExpandErr::BadSugar(sp)); },
        EmptyFinish => { perform ExpandFail::fail(ExpandErr::BadSugar(root_sp)); }
      }
    }
  };
  return ast;
};
