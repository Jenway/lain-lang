use import("std::collections")::{ Vec };
use import("std::mem")::{ Allocator, SystemAlloc, OomErr };
use import("std::option")::{ Option };
use import("std::str")::{ eq };

pub {
  let MacroRule = struct {
    name: Slice(u8),
    proc_name: Slice(u8)
  };
};

pub let SyntaxEnv = func() ?{ al: Allocator = SystemAlloc } -> Module {
  return module {
    let RuleVec = Vec(MacroRule);
    let FormTable = Array(Slice(u8), 20);

    pub {
      let Self = struct {
        rules: RuleVec
      };

      let new = func() !{ OomErr } -> Self {
        let rules: RuleVec = RuleVec::new();
        return Self { rules: rules };
      };

      let with_alloc = func(a: al::Self) !{ OomErr } -> Self {
        let rules: RuleVec = RuleVec::with_alloc(a);
        return Self { rules: rules };
      };

      let register = func(env: Mut(Self), name: Slice(u8), proc_name: Slice(u8)) !{ OomErr } -> u64 {
        let rule: MacroRule = MacroRule { name: name, proc_name: proc_name };
        let idx: u64 = deref(env).rules.len();
        deref(env).rules.push(rule);
        return idx;
      };

      let rule_count = func(env: Ref(Self)) -> u64 {
        return deref(env).rules.len();
      };

      let rule_at = func(env: Ref(Self), idx: u64) -> MacroRule {
        return deref(env).rules.get(idx);
      };

      let lookup = func(env: Ref(Self), name: Slice(u8)) -> Option(u64) {
        let i: u64 = 0;
        let n: u64 = deref(env).rules.len();
        while i < n {
          let rule: MacroRule = deref(env).rules.get(i);
          if eq(rule.name, name) {
            return Option(u64)::some(i);
          }
          i = i + 1;
        };
        return Option(u64)::none();
      };

      let is_core_form = func(name: Slice(u8)) -> bool {
        let forms: FormTable = FormTable [
          "let",
          "pub",
          "use",
          "func",
          "struct",
          "enum",
          "module",
          "sig",
          "effect",
          "if",
          "else",
          "while",
          "match",
          "return",
          "break",
          "continue",
          "perform",
          "handle",
          "comptime",
          "reloc"
        ];
        let i: u64 = 0;
        let found: bool = false;
        while (i < 20) and (found == false) {
          if eq(name, forms[i]) {
            found = true;
          }
          i = i + 1;
        };
        return found;
      };
    };
  };
};
