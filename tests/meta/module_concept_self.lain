// Phase 4 正例：自定义结构体的 Eq 见证、同一类型的两份策略模块、
// use 自动命中 / 显式 ?{ e: ... } 覆写 / 块内 use 切换最近的见证。
let Eq = sig {
  pub let Self: Type;
  pub let eq: Fn((Self, Self) -> bool);
};

let Vec2 = struct { x: i64, y: i64 };

let EqVec2: Eq = module {
  pub let Self = Vec2;
  pub let eq = func(a: Vec2, b: Vec2) -> bool {
    return (a.x == b.x) and (a.y == b.y);
  };
};

let EqI64: Eq = module {
  pub let Self = i64;
  pub let eq = func(a: i64, b: i64) -> bool { return a == b; };
};

// 同一类型的第二份策略：按十进制个位比较。
let EqMod10: Eq = module {
  pub let Self = i64;
  pub let eq = func(a: i64, b: i64) -> bool { return (a % 10) == (b % 10); };
};

use EqVec2;
use EqI64;

// 逐对比较：给自定义结构体用。
let both_equal = func(a: T, b: T) ?{ T: Type, e: Eq } -> bool {
  return e.eq(a, b);
};

// 逐元素比较：给标量切片用。
let all_equal = func(arr: Slice(T), target: T) ?{ T: Type, e: Eq } -> bool {
  let n: u64 = arr.len;
  let ok: i64 = loop c(i: u64 = 0, ok: i64 = 1) while i < n {
    if e.eq(arr[i], target) == false { ok = 0; }
    i = i + 1;
  };
  return ok == 1;
};

let main = func() -> i64 {
  let v1: Vec2 = Vec2 { x: 3, y: 4 };
  let v2: Vec2 = Vec2 { x: 3, y: 4 };
  let v3: Vec2 = Vec2 { x: 3, y: 9 };
  let same_vec: bool = both_equal(v1, v2); // 自动命中 EqVec2 -> true
  let diff_vec: bool = both_equal(v1, v3); // 自动命中 EqVec2 -> false

  let nums: Array(i64, 3) = [12, 152, 2];
  let same_i64: bool = all_equal(slice_of(nums), 2 as i64); // 自动命中 EqI64 -> false

  // 块内 use：只在花括号内把 i64 的见证切到 EqMod10。
  let mod_hit: i64 = 0;
  {
    use EqMod10;
    let same_mod: bool = all_equal(slice_of(nums), 2 as i64); // 12, 152, 2 的个位都是 2
    mod_hit = if same_mod { 10 } else { 0 };
  }

  // 显式覆写：不依赖当前作用域激活了哪个模块。
  let same_explicit: bool = all_equal(slice_of(nums), 2 as i64) ?{ e: EqMod10 };
  let explicit: i64 = if same_explicit { 100 } else { 0 };

  let r: i64 = 0;
  if same_vec { r = r + 1000; }
  if diff_vec { r = r + 500; }
  if same_i64 { r = r + 50; }
  r = r + mod_hit + explicit;
  return r;
};
