// 带签名过程引用 Fn(...) 与 VTable 上的动态分发。
//
// Fn((P...) -> R) 的值就是一个带签名的过程地址；结构体字段里存 Fn 之后可以
// 直接写 s.vtable.scale(s.data, k)，不必再手写 icall。data 字段用 Ref(void)
// 擦除具体类型，被调方拿回 Ref(void) 后靠 as Ref(Circle) 恢复再解引用。
// Fn 也能做形参（按签名收过程地址）、能在标注位置直接写过程名。
let Circle = struct { r: i64 };
let VT = struct { area: Fn((Ref(Circle)) -> i64) scale: Fn((Ref(void), i64) -> i64) };
let Shape = struct { data: Ref(void) vtable: VT };

let inc = func(x: i64) -> i64 { return x + 1; };

let twice = func(g: Fn((i64) -> i64), x: i64) -> i64 { return g(g(x)); };

let circle_area = func(p: Ref(Circle)) -> i64 {
  return deref(p).r;
};

let circle_scale = func(p: Ref(void), k: i64) -> i64 {
  let q: Ref(Circle) = p as Ref(Circle);
  return deref(q).r * k;
};

let area_of = func(s: Shape) -> i64 {
  return s.vtable.area(s.data as Ref(Circle));
};

let scaled = func(s: Shape, k: i64) -> i64 {
  return s.vtable.scale(s.data, k);
};

let main = func() -> i64 {
  let c: Circle = Circle { r: 7 };
  let t: VT = VT { area: fn_of(circle_area) scale: fn_of(circle_scale) };
  let s: Shape = Shape { data: ref_of(c) vtable: t };
  let f: Fn((i64) -> i64) = inc;
  return area_of(s) + scaled(s, 5) + f(1) + twice(inc, 10);
};
