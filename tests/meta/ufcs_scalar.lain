let I64Mod = module {
  pub let Self = i64;

  pub let twice = func(self: i64) -> i64 { return self * 2; };

  pub let peek = func(self: Ref(i64)) -> i64 { return deref(self); };

  pub let bump = func(self: Mut(i64)) -> i64 {
    let cur: i64 = deref(self);
    deref(self) = cur + 1;
    return deref(self);
  };
};

use I64Mod;

let main = func() -> i64 {
  let n: i64 = 5;
  let a: i64 = n.twice();
  let b: i64 = n.peek();
  let c: i64 = n.bump();
  let r: Ref(i64) = ref_of(n);
  let d: i64 = r.peek();
  let e: i64 = r.twice();
  return a + b + c + d + e + n;
};
