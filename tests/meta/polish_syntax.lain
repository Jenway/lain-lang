let Pair = struct { x: i64, y: i64, };
let Ops = struct { run: Fn((i64) -> i64), next: Fn((i64) -> i64) };

let triple = func(x: i64) -> i64 { return x * 3; };
let inc = func(x: i64) -> i64 { return x + 1; };
let apply = func(f: Fn((i64) -> i64), x: i64) -> i64 { return f(x); };
let set_y = func(p: Mut(Pair), v: i64) { deref(p).y = v; };

let main = func() -> u64 {
  let text = "hi\n";
  let p: Pair = Pair { x: 2, y: 3, };
  set_y(mut_of(p), 9);
  let values: Array(i64, 3) = [4, 5, 6];
  let ops: Ops = Ops { run: triple, next: inc };
  let called: i64 = ops.run(values[0]) + apply(ops.next, values[1]);
  let sum: i64 = 0;
  loop c(k: u64 = 0) while k < 3 {
    sum = sum + values[k];
    k = k + 1;
  };
  let result: i64 = called + p.y + sum + len(text) + (text[1] as i64);
  return result as u64;
};
