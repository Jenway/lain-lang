// Phase 4 正例：Concept（Ord 签名）、module 见证自动匹配、显式 ?{ ord: ... } 覆写、
// 块内 use 的最近作用域优先、嵌套泛型调用与单态化缓存（产物零 icall 虚表）。
let Ord = sig {
  pub let Self: Type;
  pub let less: Fn((Self, Self) -> bool);
};

let i64_less = func(a: i64, b: i64) -> bool { return a < b; };
let i64_gt = func(a: i64, b: i64) -> bool { return a > b; };
let u64_less = func(a: u64, b: u64) -> bool { return a < b; };

let OrdI64: Ord = module {
  pub let Self = i64;
  pub let less = func(a: i64, b: i64) -> bool { return i64_less(a, b); };
};

let OrdU64: Ord = module {
  pub let Self = u64;
  pub let less = func(a: u64, b: u64) -> bool { return u64_less(a, b); };
};

let OrdI64Rev: Ord = module {
  pub let Self = i64;
  pub let less = func(a: i64, b: i64) -> bool { return i64_gt(a, b); };
};

use OrdI64;
use OrdU64;

let max = func(a: T, b: T) ?{ T: Type, ord: Ord } -> T {
  if ord.less(a, b) { return b; }
  return a;
};

let clamp = func(x: T, lo: T, hi: T) ?{ T: Type, ord: Ord } -> T {
  let m: T = max(x, lo);
  if ord.less(hi, m) { return hi; }
  return m;
};

let local_min = func(a: i64, b: i64) -> i64 {
  use OrdI64Rev;
  return max(a, b);
};

let main = func() -> i64 {
  let a: i64 = 10;
  let b: i64 = 20;
  let m1: i64 = max(a, b);
  let m2: i64 = max(a + 5, b - 15);
  let mn: i64 = max(a, b) ?{ ord: OrdI64Rev };
  let lm: i64 = local_min(33, 17);
  let cl: i64 = clamp(100 as i64, 0, 50);
  let mu: u64 = max(7 as u64, 12 as u64);
  // 20 + 15 + 10 + 17 + 50 + 12 = 124
  return m1 + m2 + mn + lm + cl + (mu as i64);
};
