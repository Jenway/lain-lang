// 负例：泛型类型推导冲突（a: i64, b: u8 无法同时满足 T）。
let Ord = sig {
  pub let Self: Type;
  pub let less: Fn((Self, Self) -> bool);
};

let i64_less = func(a: i64, b: i64) -> bool { return a < b; };

let OrdI64: Ord = module {
  pub let Self = i64;
  pub let less = func(a: i64, b: i64) -> bool { return i64_less(a, b); };
};

use OrdI64;

let max = func(a: T, b: T) ?{ T: Type, ord: Ord } -> T {
  if ord.less(a, b) { return b; }
  return a;
};

let main = func() -> i64 {
  let a: i64 = 10;
  let b: u8 = 20;
  return max(a, b);
};
