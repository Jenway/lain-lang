// 负例：泛型类型推导冲突（a: i64, b: u8 无法同时满足 T）。
func Ord(T: Type) -> Type {
  let b = record_begin();
  record_add(b, "less", Fn((T, T) -> bool));
  return record_end(b);
}
func i64_less(a: i64, b: i64) -> bool { return a < b; }
given ord_i64: Ord(i64) = Ord(i64) { less: i64_less };

func max(a: T, b: T) ?{ T: Type, ord: Ord(T) } -> T {
  if ord.less(a, b) { return b; }
  return a;
}

func main() -> i64 {
  let a: i64 = 10;
  let b: u8 = 20;
  return max(a, b);
}
