let Yield = func(T: Type) -> Effect {
  return effect { op emit(val: T) -> i64; };
};

let produce = func() -> i64 !{ Yield(i64) } {
  let a: i64 = perform Yield(i64).emit(10);
  let b: i64 = perform Yield(i64).emit(20);
  return a + b;
};

let main = func() -> i64 {

  return handle produce() with {
    return(v) => v,
    emit(v) => resume(v * 2),
  };
};
