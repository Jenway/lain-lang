let b = import("std::bench");

let work = func() -> u64 {
  return 21;
};

let main = func() -> i64 {
  let s0: u64 = b.steps();
  let n0: u64 = b.nanos();
  let out: u64 = b.measure("work", work);
  let n1: u64 = b.nanos();
  if n1 < n0 { return -1; }
  if b.steps() < s0 { return -2; }
  return out as i64;
};
