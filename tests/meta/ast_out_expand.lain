let Vec2 = struct { x: i64, y: i64 };

let AddSig = sig {
  pub let Self: Type;
  pub let sum: Fn((Self) -> i64);
};

let Vec2Add: AddSig = module {
  pub let Self = Vec2;
  pub let sum = func(v: Vec2) -> i64 { return v.x + v.y; };
};

let main = func() -> i64 {

  let acc: i64 = 0;
  comptime for k in 0..3 {
    acc = acc + k;
  }

  let v: Vec2 = Vec2 { x: 5, y: 9 };
  {
    use Vec2Add;
    acc = acc + sum(v);
  }

  let tail: Array(i64, 2) = [10, 15];

  return acc + tail[0] + tail[1];
};
