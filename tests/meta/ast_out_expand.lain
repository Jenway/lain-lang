// Phase 5.1：Expand -> Elaborate -> Lower 管线端到端回归。
// 展开阶段把 comptime for 逐轮写入当前过程；细化阶段解析模块见证与结构体；
// 降解阶段把字段访问、数组下标与剩余控制流拍平成 LAINIR。
let Vec2 = struct { x: i64, y: i64 };

let AddSig = sig {
  pub let Self: Type;
  pub let sum: Fn((Self) -> i64);
};

let Vec2Add: AddSig = module {
  pub let Self = Vec2;
  pub let sum = func(v: Vec2) -> i64 { return v.x + v.y; };
};

let main = func() -> i64 {
  // 3 = 0 + 1 + 2，展开后产物里没有对应 #loop。
  let acc: i64 = 0;
  comptime for k in 0..3 {
    acc = acc + k;
  }

  let v: Vec2 = Vec2 { x: 5, y: 9 };
  {
    use Vec2Add;
    acc = acc + sum(v);
  }

  let tail: Array(i64, 2) = [10, 15];
  // 42 = 3 + sum(Vec2{5, 9}) 的 14 + 数组 10 + 15。
  return acc + tail[0] + tail[1];
};
