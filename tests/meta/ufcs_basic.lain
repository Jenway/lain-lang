// Phase 5.2：UFCS 方法调用糖。值接收者按 Self 直传，Ref(Self) / Mut(Self)
// 由可寻址局部量自动补 ref_of / mut_of。
let Vec2 = struct { x: i64, y: i64 };

let Vec2Ops = module {
  pub let Self = Vec2;

  // 值接收者：v.len2() -> Vec2Ops.len2(v)。
  pub let len2 = func(v: Self) -> i64 {
    return (v.x * v.x) + (v.y * v.y);
  };

  // 只读接收者：v.get_x() -> Vec2Ops.get_x(ref_of(v))。
  pub let get_x = func(v: Ref(Self)) -> i64 {
    return deref(v).x;
  };

  // 可变接收者：v.add_x(5) -> Vec2Ops.add_x(mut_of(v), 5)。
  pub let add_x = func(v: Mut(Self), delta: i64) -> i64 {
    deref(v).x = deref(v).x + delta;
    return deref(v).x;
  };
};

use Vec2Ops;

let main = func() -> i64 {
  let v: Vec2 = Vec2 { x: 3, y: 4 };
  // 25 = 3*3 + 4*4
  let n: i64 = v.len2();
  // 8 = 3 + 5，同时把 v.x 改成 8。
  let m: i64 = v.add_x(5);
  // 8 = 自动 ref_of(v) 后读到的 x。
  let r: i64 = v.get_x();
  // 41 = 25 + 8 + 8
  return n + m + r;
};
