let Ord = sig {
  pub let Self: Type;
  pub let less: Fn((Self, Self) -> bool);
};

let i64_less = func(a: i64, b: i64) -> bool { return a < b; };
let i64_gt = func(a: i64, b: i64) -> bool { return a > b; };

let OrdI64A: Ord = module {
  pub let Self = i64;
  pub let less = func(a: i64, b: i64) -> bool { return i64_less(a, b); };
};

let OrdI64B: Ord = module {
  pub let Self = i64;
  pub let less = func(a: i64, b: i64) -> bool { return i64_gt(a, b); };
};

use OrdI64A;
use OrdI64B;

let max = func(a: T, b: T) ?{ T: Type, ord: Ord } -> T {
  if ord.less(a, b) { return b; }
  return a;
};

let main = func() -> i64 {
  let a: i64 = 10;
  let b: i64 = 20;
  return max(a, b);
};
