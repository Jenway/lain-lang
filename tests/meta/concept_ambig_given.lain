// 负例：同层声明两个同一类型的 given，必须报歧义。
let Ord = func(T: Type) -> Type {
  let b = record_begin();
  record_add(b, "less", Fn((T, T) -> bool));
  return record_end(b);
};
let i64_less = func(a: i64, b: i64) -> bool { return a < b; };
let i64_gt = func(a: i64, b: i64) -> bool { return a > b; };

given ord_a: Ord(i64) = Ord(i64) { less: i64_less };
given ord_b: Ord(i64) = Ord(i64) { less: i64_gt };

let max = func(a: T, b: T) ?{ T: Type, ord: Ord(T) } -> T {
  if ord.less(a, b) { return b; }
  return a;
};

let main = func() -> i64 {
  let a: i64 = 10;
  let b: i64 = 20;
  return max(a, b);
};
