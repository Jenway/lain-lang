// 负例：同层声明两个同一类型的 given，必须报歧义。
func Ord(T: Type) -> Type {
  let b = record_begin();
  record_add(b, "less", Fn((T, T) -> bool));
  return record_end(b);
}
func i64_less(a: i64, b: i64) -> bool { return a < b; }
func i64_gt(a: i64, b: i64) -> bool { return a > b; }

given ord_a: Ord(i64) = Ord(i64) { less: i64_less };
given ord_b: Ord(i64) = Ord(i64) { less: i64_gt };

func max(a: T, b: T) ?{ T: Type, ord: Ord(T) } -> T {
  if ord.less(a, b) { return b; }
  return a;
}

func main() -> i64 {
  let a: i64 = 10;
  let b: i64 = 20;
  return max(a, b);
}
