let Vec3 = struct { x: i64 y: i64 z: i64 };
let Big10 = struct { a: i64 b: i64 c: i64 d: i64 e: i64 g: i64 h: i64 k: i64 m: i64 q: i64 };

let copy_vec3 = func(d: Mut(Vec3), s: Ref(Vec3)) -> u64 {
  comptime for f in fields_of(Vec3) {
    deref(d).[:f.name] = deref(s).[:f.name];
  }
  return 1;
};

let Wrap = struct { xs: Array(i64, 3) };

let set_first = func(d: Mut(Wrap), v: i64) -> u64 {
  comptime for f in fields_of(Wrap) {
    deref(d).[:f.name][0] = v;
  }
  return deref(d).xs[0] as u64;
};

let tail2 = func(v: Big10) -> u64 {
  return v.m * 10 + v.q;
};

let main = func() -> i64 {
  let s: u64 = 0;
  comptime for k in 0..4 {
    s = s + k * 10;
  }

  let big: Big10 = Big10 { a: 1 b: 2 c: 3 d: 4 e: 5 g: 6 h: 7 k: 8 m: 9 q: 10 };
  let t: u64 = 0;
  comptime for f in fields_of(Big10) {
    t = t + big.[:f.name] as u64;
  }

  let src: Vec3 = Vec3 { x: 5 y: 7 z: 11 };
  let dst: Vec3 = Vec3 { x: 0 y: 0 z: 0 };
  let c: u64 = copy_vec3(mut_of(dst), ref_of(src)) + (dst.x * 100 + dst.y * 10 + dst.z) as u64;

  let vsz: u64 = 0;
  let voff: u64 = 0;
  comptime for f in fields_of(Vec3) {
    vsz = vsz + size_of(f.type) as u64;
    voff = voff + f.offset as u64;
  }

  let w: Wrap = Wrap { xs: [1, 2, 3] };
  let wv: u64 = set_first(mut_of(w), 777);

  let sz: u64 = size_of(Big10);
  let al: u64 = align_of(Big10);
  let fc: u64 = field_count(Big10);
  let split: u64 = big.m + big.q;
  let sum: u64 = sz * 1000 + al * 100 + fc * 10 + split;
  let sx: u64 = src.[:"x"] as u64;

  let k: u64 = 3;
  let f: u64 = 4;
  let no_leak: u64 = k * 10 + f;
  return (sum + s + t + c + tail2(big) + vsz * 1000 + voff + wv + sx + no_leak) as i64;
};
