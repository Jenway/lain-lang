// Phase 5.2B 正例：同名字段优先于模块方法。
let Holder = struct { get: Fn((i64) -> i64), v: i64 };

let HolderMod = module {
  pub let Self = Holder;
  pub let get = func(self: Ref(Holder), k: i64) -> i64 { return self.v * 100 + k; };
};

use HolderMod;

let inc = func(x: i64) -> i64 { return x + 1; };

let main = func() -> i64 {
  let h: Holder = Holder { get: inc, v: 7 };
  return h.get(4);
};
