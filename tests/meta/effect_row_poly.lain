// Phase 5.3：效应行多态。apply_fn 对回调的未捕获效应集 E 完全透明，
// 同一个高阶过程既接受纯回调，也接受带 Cancel 的回调。
let Cancel = effect {
  op cancel() -> Never;
};

let apply_fn = func(x: i64, f: Fn((i64) -> i64 !{ E }))
  ?{ E: EffectRow }
  !{ E }
  -> i64
{
  return f(x)!;
};

let pure_cb = func(x: i64) -> i64 {
  return x * 2 + 1;
};

let guarded = func(x: i64) -> i64 !{ Cancel } {
  if x > 100 {
    perform Cancel.cancel();
  }
  return x * 2;
};

let main = func() -> i64 {
  // 纯回调实例化 E 为空集：7*2+1 = 15。
  let pure_part: i64 = apply_fn(7, pure_cb);
  // 效应回调实例化 E 为 Cancel：20*2 = 40。
  let effect_part: i64 = handle apply_fn(20, guarded) with {
    return(v) => v,
    cancel() => 40,
  };
  return pure_part + effect_part;
};
