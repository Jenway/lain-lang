let PairMod = func(T: Type) -> Module {
  return module {
    pub let Self = struct { a: T, b: T };

    pub let make = func(a: T, b: T) -> Self {
      return Self { a: a, b: b };
    };

    pub let first = func(self: Ref(Self)) -> T { return self.a; };

    pub let second = func(self: Self) -> T { return self.b; };
  };
};

let IntPair = PairMod(i64);

use IntPair;

let main = func() -> i64 {
  let p: IntPair.Self = IntPair.make(3, 4);
  return p.first() * 10 + p.second();
};
