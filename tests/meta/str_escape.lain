// 字符串转义与字符串切片化。
//
// 字面量在落静态数据之前先反转义：\n \r \t \\ \" \0 变成单个真实字节，
// 形状长度按反转义后的字节数记。作为 Slice(u8) 使用时现造 16 字节头。

let sum_bytes = func(s: Slice(u8)) -> u64 {
  let n: u64 = s.len;
  let acc: u64 = loop b(i: u64 = 0, acc: u64 = 0) while i < n {
    let c: u8 = s[i];
    acc = acc + (c as u64);
    i = i + 1;
  };
  return acc;
};

let main = func() -> u64 {
  let s: Slice(u8) = "a\nb\"c\\";
  let n: u64 = s.len;
  return n * 1000 + sum_bytes(s);
};
