let sum_bytes = func(s: Slice(u8)) -> u64 {
  let n: u64 = s.len;
  let acc: u64 = loop b(i: u64 = 0, acc: u64 = 0) while i < n {
    let c: u8 = s[i];
    acc = acc + (c as u64);
    i = i + 1;
  };
  return acc;
};

let main = func() -> u64 {
  let s: Slice(u8) = "a\nb\"c\\";
  let n: u64 = s.len;
  return n * 1000 + sum_bytes(s);
};
