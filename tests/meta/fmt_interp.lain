let io = import("std::io");
let fmt = import("std::fmt");

let main = func() -> i64 {
  let x: i64 = 20;

  io.println(f"val={x}, sum={x + 1}");

  let c0: fmt.Cursor = fmt.fmt_begin();
  let c1: fmt.Cursor = fmt.write_str(c0, "val=");
  let c2: fmt.Cursor = fmt.write_i64(c1, x);
  let c3: fmt.Cursor = fmt.write_str(c2, ", sum=");
  let c4: fmt.Cursor = fmt.write_i64(c3, x + 1);
  let n: u64 = fmt.emit_line(c4);
  return 42;
};
