// Phase 2A-2 正例：Type 一等值 + TypeBuilder + 类型工厂 + comptime for + [:expr]。
// 全文件 0 字符串拼接、0 inject，结构化构造列式 SoA 并在 VM 真实执行。
let Vec3 = struct { x: i64, y: i64, z: i64 };

let make_soa = func(T: Type, N: u64) -> Type {
  let b = record_begin();
  comptime for f in fields_of(T) {
    record_add(b, f.name, Array(f.type, N));
  }
  return record_end(b);
};

let Vec3SoA = make_soa(Vec3, 4);

let soa_set = func(s: Mut(Vec3SoA), idx: u64, v: Vec3) {
  comptime for f in fields_of(Vec3) {
    deref(s).[:f.name][idx] = v.[:f.name];
  }
};

let soa_get_sum = func(s: Ref(Vec3SoA), idx: u64) -> i64 {
  let total: i64 = 0;
  comptime for f in fields_of(Vec3) {
    total = total + deref(s).[:f.name][idx];
  }
  return total;
};

// 也验证类型位置直接调用类型工厂：make_soa(Vec3, 4) 与 Vec3SoA 同构可读。
let inline_soa_x = func(s: Ref(make_soa(Vec3, 4)), idx: u64) -> i64 {
  return deref(s).x[idx];
};

let main = func() -> i64 {
  let s: Vec3SoA = Vec3SoA {
    x: [0, 0, 0, 0],
    y: [0, 0, 0, 0],
    z: [0, 0, 0, 0],
  };
  soa_set(mut_of(s), 0, Vec3 { x: 1, y: 2, z: 3 });
  soa_set(mut_of(s), 1, Vec3 { x: 10, y: 20, z: 30 });
  soa_set(mut_of(s), 2, Vec3 { x: 100, y: 200, z: 300 });
  soa_set(mut_of(s), 3, Vec3 { x: 7, y: 8, z: 9 });

  let s0: i64 = soa_get_sum(ref_of(s), 0);
  let s1: i64 = soa_get_sum(ref_of(s), 1);
  let s2: i64 = soa_get_sum(ref_of(s), 2);
  let s3: i64 = soa_get_sum(ref_of(s), 3);

  let inline_s: make_soa(Vec3, 4) = s;
  let ix: i64 = inline_soa_x(ref_of(inline_s), 2);

  // 6 + 60 + 600 + 24 + 100 = 790
  // size_of(Vec3SoA) = 96, field_count(Vec3SoA) = 3 => 790 + 96 * 10 + 3 = 1753
  return s0 + s1 + s2 + s3 + ix + (size_of(Vec3SoA) as i64) * 10 + (field_count(Vec3SoA) as i64);
};
