let Vec2 = struct { x: i64, y: i64 };

let Vec2Sum = module {
  pub let Self = Vec2;
  pub let total = func(self: Vec2) -> i64 { return self.x + self.y; };
};

let Vec2Diff = module {
  pub let Self = Vec2;
  pub let total = func(self: Vec2) -> i64 { return self.x - self.y; };
};

let Vec2Prod = module {
  pub let Self = Vec2;
  pub let prod = func(self: Ref(Vec2)) -> i64 { return self.x * self.y; };
};

use Vec2Sum;
open Vec2Prod;

let main = func() -> i64 {
  let p: Vec2 = Vec2 { x: 9, y: 4 };
  let a: i64 = p.total();
  let b: i64 = 0;
  {
    use Vec2Diff;
    b = p.total();
  }
  let c: i64 = p.total();
  let d: i64 = p.prod();
  return a * 1000 + b * 100 + c * 10 + d;
};
