let a_body: Array(u64, 5) = [0, 1, 2, 3, 4];
let b_body: Array(u64, 4) = [0, 1, 3, 4];
let loop_body: Array(u64, 1) = [2];
let empty_insts: Array(u64, 1) = [0];

let missing_body: Array(u64, 4) = [0, 1, 2, 3];

