let build_duplicate = func() -> vf.IrModule {
  let b0: vf.IrBuilder = vf.builder_new(arena_ptr());
  let b: Mut(vf.IrBuilder) = mut_of(b0);
  let pa: Ref(vf.IrParam) = vf.add_param(b, 211, vf.type_bits(64));
  let pv: Ref(vf.IrParam) = vf.add_param(b, 212, vf.type_bits(64));
  let rt: Ref(vf.IrType) = vf.add_type(b, vf.type_bits(64));
  let i0: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Add as u64);
  let s0: u64 = vf.inst_set_type(i0, codes.TyKind.Bits as u64, 64);
  let s1: u64 = vf.inst_add_operand(i0, vf.op_value(211));
  let s2: u64 = vf.inst_add_operand(i0, vf.op_value(212));
  let s3: u64 = vf.inst_add_result(i0, 301);
  let i1: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Add as u64);
  let s4: u64 = vf.inst_set_type(i1, codes.TyKind.Bits as u64, 64);
  let s5: u64 = vf.inst_add_operand(i1, vf.op_value(211));
  let s6: u64 = vf.inst_add_operand(i1, vf.op_value(212));
  let s7: u64 = vf.inst_add_result(i1, 301);
  let i2: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Return as u64);
  let s8: u64 = vf.inst_add_operand(i2, vf.op_value(301));
  let dip: Ref(u64) = ptr_cast(Ref(u64), ref_of(dup_body));
  let rg: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                           rt, 1, dip, 3);
  let pr: Mut(vf.IrProc) = vf.add_proc(b, 201, pa, 2, rt, 1);
  let s9: u64 = vf.proc_set_body(pr, 0);
  return vf.builder_module(b, 113);
};

let starts_with = func(buf: Slice(u8), at: u64, pat: Slice(u8), i: u64) -> u64 {
  if i >= pat.len { return 1; }
  if at + i >= buf.len { return 0; }
  if buf[at + i] != pat[i] { return 0; }
  return starts_with(buf, at, pat, i + 1);
};

let contains = func(buf: Slice(u8), pat: Slice(u8)) -> u64 {
  let limit: u64 = if (pat.len < buf.len) or (pat.len == buf.len) {
    buf.len - pat.len + 1
  } else {
    0
  };
  let found: u64 = loop c(i: u64 = 0, hit: u64 = 0) while (i < limit) and (hit == 0) {
    if starts_with(buf, i, pat, 0) == 1 {
      hit = 1;
    }
    i = i + 1;
  };
  return found;
};

let main = func() -> i64 {
  let ma: vf.IrModule = build_valid_a();
  let ea: u64 = checks.verify_module(ref_of(ma));
  if ea != 0 { return 10; }

  let out_bytes: Mut(u8) = out_ptr();
  let out_buf: MutSlice(u8) = make_slice(MutSlice(u8), out_bytes, 16384);
  let w0: cw.C99Writer = cw.new_writer(out_buf);
  let w: Mut(cw.C99Writer) = mut_of(w0);
  let n0: u64 = cm.emit_preamble(w);
  if n0 == 0 { return 11; }
  let n1: u64 = cm.emit_proc_c99(w, ref_of(ma), 0);
  if n1 == 0 { return 12; }

  let mb: vf.IrModule = build_valid_b();
  let eb: u64 = checks.verify_module(ref_of(mb));
  if eb != 0 { return 13; }
  let n2: u64 = cm.emit_proc_c99(w, ref_of(mb), 0);
  if n2 == 0 { return 14; }
  if cw.writer_ok(w) == 0 { return 15; }
  let total: u64 = cw.writer_len(w);
  if total == 0 { return 16; }

  let text: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), out_bytes), total);
  let has_switch: u64 = contains(text, "switch");
  if has_switch == 0 { return 17; }
  let has_load: u64 = contains(text, "lain_load_bits");
  if has_load == 0 { return 18; }
  let has_return: u64 = contains(text, "return");
  if has_return == 0 { return 19; }

  let m1: vf.IrModule = build_missing_term();
  let e1: u64 = checks.verify_module(ref_of(m1));
  if e1 != vf.ERR_NO_TERM() { return 21; }
  let m2: vf.IrModule = build_undefined();
  let e2: u64 = checks.verify_module(ref_of(m2));
  if e2 != vf.ERR_UNDEF_VAL() { return 22; }
  let m3: vf.IrModule = build_mismatch();
  let e3: u64 = checks.verify_module(ref_of(m3));
  if e3 != vf.ERR_TYPE_MISMATCH() { return 23; }
  let m4: vf.IrModule = build_duplicate();
  let e4: u64 = checks.verify_module(ref_of(m4));
  if e4 != vf.ERR_DUP_DEF() { return 24; }

  return 61;
};
