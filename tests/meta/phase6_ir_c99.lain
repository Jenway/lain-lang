let arena_ptr = func() -> Mut(u8) {
  return ptr_cast(Mut(u8), mut_of(arena_blocks));
};

let out_ptr = func() -> Mut(u8) {
  return ptr_cast(Mut(u8), mut_of(c99_blocks));
};

let build_valid_a = func() -> vf.IrModule {
  let b0: vf.IrBuilder = vf.builder_new(arena_ptr());
  let b: Mut(vf.IrBuilder) = mut_of(b0);
  let pa: Ref(vf.IrParam) = vf.add_param(b, 211, vf.type_bits(64));
  let pv: Ref(vf.IrParam) = vf.add_param(b, 212, vf.type_bits(64));
  let rt: Ref(vf.IrType) = vf.add_type(b, vf.type_bits(64));
  let i0: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Add as u64);
  let s0: u64 = vf.inst_set_type(i0, codes.TyKind.Bits as u64, 64);
  let s1: u64 = vf.inst_add_operand(i0, vf.op_value(211));
  let s2: u64 = vf.inst_add_operand(i0, vf.op_value(212));
  let s3: u64 = vf.inst_add_result(i0, 301);
  let i1: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Alloca as u64);
  let s4: u64 = vf.inst_set_type(i1, codes.TyKind.Bits as u64, 64);
  let s5: u64 = vf.inst_add_operand(i1, vf.op_int(1));
  let s6: u64 = vf.inst_add_result(i1, 302);
  let i2: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Store as u64);
  let s7: u64 = vf.inst_set_type(i2, codes.TyKind.Bits as u64, 64);
  let s8: u64 = vf.inst_add_operand(i2, vf.op_value(301));
  let s9: u64 = vf.inst_add_operand(i2, vf.op_value(302));
  let i3: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Load as u64);
  let s10: u64 = vf.inst_set_type(i3, codes.TyKind.Bits as u64, 64);
  let s11: u64 = vf.inst_add_operand(i3, vf.op_value(302));
  let s12: u64 = vf.inst_add_result(i3, 303);
  let i4: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Return as u64);
  let s13: u64 = vf.inst_add_operand(i4, vf.op_value(303));
  let aip: Ref(u64) = ptr_cast(Ref(u64), ref_of(a_body));
  let rg: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                           rt, 1, aip, 5);
  let pr: Mut(vf.IrProc) = vf.add_proc(b, 201, pa, 2, rt, 1);
  let s14: u64 = vf.proc_set_body(pr, 0);
  return vf.builder_module(b, 100);
};

let build_valid_b = func() -> vf.IrModule {
  let b0: vf.IrBuilder = vf.builder_new(arena_ptr());
  let b: Mut(vf.IrBuilder) = mut_of(b0);
  let pc: Ref(vf.IrParam) = vf.add_param(b, 221, vf.type_bool());
  let pk: Ref(vf.IrParam) = vf.add_param(b, 222, vf.type_bits(64));
  let i0: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.If as u64);
  let s0: u64 = vf.inst_add_operand(i0, vf.op_value(221));
  let s1: u64 = vf.inst_set_body(i0, 1);
  let i1: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Loop as u64);
  let s2: u64 = vf.inst_set_label(i1, 900);
  let s3: u64 = vf.inst_set_body(i1, 2);
  let i2: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Break as u64);
  let s4: u64 = vf.inst_set_label(i2, 900);
  let i3: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Switch as u64);
  let s5: u64 = vf.inst_set_type(i3, codes.TyKind.Bits as u64, 64);
  let s6: u64 = vf.inst_add_operand(i3, vf.op_value(222));
  let s7: u64 = vf.inst_set_cases(i3, 0, 1);
  let s8: u64 = vf.inst_set_default(i3, 3);
  let i4: Mut(vf.IrInst) = vf.add_inst(b, codes.InstKind.Return as u64);
  let bip: Ref(u64) = ptr_cast(Ref(u64), ref_of(b_body));
  let lip: Ref(u64) = ptr_cast(Ref(u64), ref_of(loop_body));
  let eip: Ref(u64) = ptr_cast(Ref(u64), ref_of(empty_insts));
  let rg0: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                            null_ref(Ref(vf.IrType)), 0,
                                            bip, 4);
  let rg1: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                            null_ref(Ref(vf.IrType)), 0,
                                            eip, 0);
  let rg2: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                            null_ref(Ref(vf.IrType)), 0,
                                            lip, 1);
  let rg3: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                            null_ref(Ref(vf.IrType)), 0,
                                            eip, 0);
  let rg4: Mut(vf.IrRegion) = vf.add_region(b, null_ref(Ref(vf.IrParam)), 0,
                                            null_ref(Ref(vf.IrType)), 0,
                                            eip, 0);
  let cs: Ref(vf.IrCase) = vf.add_case(b, 0, 4);
  let pr: Mut(vf.IrProc) = vf.add_proc(b, 202, pc, 2,
                                       null_ref(Ref(vf.IrType)), 0);
  let s9: u64 = vf.proc_set_body(pr, 0);
  return vf.builder_module(b, 101);
};

