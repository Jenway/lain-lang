// eval_comptime.lain —— 编译期求值：递归、循环、聚合，以及与运行期参数混算。
struct Pair { a: i32 b: i32 }

func fib(n: u64) -> u64 {
  let r: u64 = if n < 2 { n } else { fib(n - 1) + fib(n - 2) };
  return r;
}

func sum_to(n: u64) -> u64 {
  let s: u64 = loop add(i: u64 = 1, acc: u64 = 0) while i <= n { acc = acc + i; i = i + 1; };
  return s;
}

func pair_a(p: Pair) -> i32 { return p.a; }

let folded: u64 = eval(fib(10));

func folded_plus(x: u64) -> u64 { return eval(fib(10)) + x; }

func main() -> u64 {
  let agg: i32 = eval(pair_a(Pair { a: 7 b: 1 }));
  let s: u64 = eval(sum_to(100));
  return folded + s + agg as u64;
}
