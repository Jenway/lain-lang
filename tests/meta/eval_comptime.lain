let Pair = struct { a: i32 b: i32 };

let fib = func(n: u64) -> u64 {
  let r: u64 = if n < 2 { n } else { fib(n - 1) + fib(n - 2) };
  return r;
};

let sum_to = func(n: u64) -> u64 {
  let s: u64 = loop add(i: u64 = 1, acc: u64 = 0) while i <= n { acc = acc + i; i = i + 1; };
  return s;
};

let pair_a = func(p: Pair) -> i32 { return p.a; };

let folded: u64 = eval(fib(10));

let folded_plus = func(x: u64) -> u64 { return eval(fib(10)) + x; };

let main = func() -> u64 {
  let agg: i32 = eval(pair_a(Pair { a: 7 b: 1 }));
  let s: u64 = eval(sum_to(100));
  return folded + s + agg as u64;
};
