let os = import("std::os");

let main = func() -> u64 {
  if os.argc() < 1 { return 80; }

  let mem: u64 = os.alloc_bytes(64);
  if mem == 0 { return 81; }
  if os.free_bytes(mem) != 0 { return 82; }

  let path: Slice(u8) = "build/tmp_os_primitives.txt";
  let text: Slice(u8) = "hello_lain_os";
  if os.write_file(path, text) != 0 { return 83; }

  let out_ptr: u64 = 0;
  let out_len: u64 = 0;
  if os.read_file(path, mut_of(out_ptr), mut_of(out_len)) != 0 { return 84; }
  if out_len != 13 { return 85; }

  let data: Slice(u8) = make_slice(Slice(u8), ptr_cast(Ref(u8), out_ptr), out_len);
  if data[0] != 104 { return 86; }
  if data[12] != 115 { return 87; }
  if os.free_bytes(out_ptr) != 0 { return 89; }
  return 88;
};
