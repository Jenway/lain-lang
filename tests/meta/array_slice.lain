// 定长数组与切片：数组字面量、数组字段/形参、Slice 与 MutSlice 视图。
//
// Array(T, N) 在栈上开 N*sizeof(T) 的块；slice_of(数组) 把它包成 { ptr, len } 的
// 16 字节头，slice_of(Ref(T), n) 也造同一形状的头；MutSlice 只允许单向转 Slice。
// 切片的 len 与下标都按元素宽度缩放，元素读出来是元素的真实位宽。

struct Row { xs: Array(u64, 4) tag: u64 }

func sum_slice(s: Slice(u64)) -> u64 {
  let n: u64 = s.len;
  let acc: u64 = loop l(i: u64 = 0, acc: u64 = 0) while i < n {
    acc = acc + s[i];
    i = i + 1;
  };
  return acc;
}

// 数组作为形参：按块地址传递，取出来仍是带形状的数组。
func head_tail(a: Array(u64, 4)) -> u64 {
  let s: Slice(u64) = slice_of(a);
  return s[0] + s[3];
}

// 数组作为结构体字段，字段读出来是块地址，再转切片。
func row_mid(r: Row) -> u64 {
  let a: Array(u64, 4) = r.xs;
  let s: Slice(u64) = slice_of(a);
  return s[1] + s[2] + r.tag;
}

func main() -> u64 {
  let arr: Array(u64, 4) = [10, 20, 30, 40];
  let s: Slice(u64) = slice_of(arr);
  let n: u64 = s.len;
  let p: Mut(u64) = mut_of(arr);
  let ms: MutSlice(u64) = slice_of(p, 2);
  let m: Slice(u64) = ms;
  let r: Row = Row { xs: [1, 2, 3, 4] tag: 5 };
  let tail: u64 = if n == 4 { head_tail(arr) } else { 0 };
  return n * 1000 + sum_slice(s) + tail + row_mid(r) + m.len;
}
