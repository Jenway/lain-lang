// std::test 自检：全部断言通过，返回失败计数 0。
let t = import("std::test");

func main() -> i64 {
  let s: t.Suite = t.suite("self");
  t.check(mut_of(s), "truth", true);
  t.eq_i64(mut_of(s), "i64", 42, 42);
  t.eq_u64(mut_of(s), "u64", 7 as u64, 7 as u64);
  t.eq_bool(mut_of(s), "bool", true, true);
  t.eq_bytes(mut_of(s), "bytes", "same", "same");
  let failed: i64 = t.finish(mut_of(s));
  return failed;
}
