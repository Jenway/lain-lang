let Vec3 = struct { x: i64 y: i64 z: i64 };
let Frame = struct { pos: Vec3 tag: i64 };

let frame_score = func(r: Ref(Frame)) -> i64 {
  let inner: Vec3 = deref(r).pos;
  return inner.x * 100 + deref(r).tag;
};

let main = func() -> i64 {
  let x: u8 = 200;
  let r1: Ref(u8) = ref_of(x);
  let a: u64 = deref(r1) as u64;
  let y: u8 = 3;
  let m: Mut(u8) = mut_of(y);
  let b: u64 = deref(m) as u64;
  let f: Frame = Frame { pos: Vec3 { x: 7 y: 2 z: 1 } tag: 4 };
  let rf: Ref(Frame) = ref_of(f);
  let c: i64 = deref(rf).pos.x;
  let d: i64 = frame_score(rf);
  let g: i64 = 11;
  let mg: Mut(i64) = mut_of(g);
  let rg: Ref(i64) = mg;
  let e: i64 = deref(rg);
  return (a + b) as i64 + c + d + e;
};
