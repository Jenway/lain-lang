// Phase 5.2：match 决策树与穷尽性核验。带载荷分支绑定 Some(x) 的载荷，
// match 作为表达式统一汇聚到 i64 结果槽。
let Opt = enum {
  Some(i64)
  None
};

let unwrap_plus_one = func(o: Opt) -> i64 {
  let value: i64 = match o {
    Some(x) => x + 1,
    None => 0,
  };
  return value;
};

let main = func() -> i64 {
  let a: Opt = Opt.Some { 41 };
  let b: Opt = Opt.None {};
  // 42 = Some(41) 的 41 + 1；空分支给 0。
  let x: i64 = unwrap_plus_one(a);
  let y: i64 = unwrap_plus_one(b);
  return x + y;
};
