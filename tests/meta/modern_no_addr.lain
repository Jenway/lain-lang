let Item = struct {
  id: u64,
  val: i64,
};

let Table = func(Elem: Type) -> Type {
  let b = record_begin();
  record_add(b, "data", MutSlice(Elem));
  record_add(b, "len", u64);
  return record_end(b);
};

let ItemTable = Table(Item);

let State = struct {
  buf: Mut(u8),
  cur: Mut(Item),
  items: Mut(ItemTable),
};

let cast_mut = func(raw: Mut(u8)) ?{ T: Type } -> Mut(T) {
  return ptr_cast(Mut(T), raw);
};

let push_item = func(tbl: Mut(ItemTable), it: Item) -> u64 {
  let idx: u64 = tbl.len;
  tbl.data[idx] = it;
  tbl.len = idx + 1;
  return idx;
};

let read_item_val = func(it: Ref(Item)) -> i64 {
  return it.val;
};

let main = func() -> i64 {
  let raw_arr: Array(u64, 4) = [0, 0, 0, 0];
  let byte_p: Mut(u8) = ptr_cast(Mut(u8), mut_of(raw_arr));

  let item_ptr: Mut(Item) = cast_mut(byte_p);
  item_ptr.id = 10;
  item_ptr.val = 32;

  let nil_item: Mut(Item) = null_ref(Mut(Item));
  let nil_flag: i64 = if is_null(nil_item) { 100 } else { 0 };
  let nonnil_flag: i64 = if is_null(item_ptr) { 0 } else { 1 };

  let item_backing: Array(u64, 4) = [0, 0, 0, 0];
  let first_mut: Mut(Item) = ptr_cast(Mut(Item), mut_of(item_backing));
  let ms: MutSlice(Item) = make_slice(MutSlice(Item), first_mut, 2);
  let ptr_round: Mut(Item) = ms.ptr;
  ptr_round.id = 7;

  let tbl_val: ItemTable = ItemTable { data: ms, len: 0 };
  let st_val: State = State {
    buf: byte_p,
    cur: item_ptr,
    items: mut_of(tbl_val),
  };
  let st: Mut(State) = mut_of(st_val);
  let i0: u64 = push_item(st.items, Item { id: 1, val: 50 });
  let i1: u64 = push_item(st.items, Item { id: 2, val: 60 });

  return read_item_val(st.cur) + st.items.data[0].val + st.items.data[1].val + (item_ptr.id as i64) + nil_flag + nonnil_flag + (i1 as i64) + (ptr_round.id as i64);
};
