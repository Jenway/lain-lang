// Phase 5.2B 反例：只读引用接收者不能绑定 Mut(Self) 首参。
let Vec2 = struct { x: i64, y: i64 };

let Vec2Mod = module {
  pub let Self = Vec2;
  pub let shift = func(self: Mut(Vec2), d: i64) -> i64 {
    self.x = self.x + d;
    return self.x;
  };
};

use Vec2Mod;

let main = func() -> i64 {
  let p: Vec2 = Vec2 { x: 3, y: 4 };
  let r: Ref(Vec2) = ref_of(p);
  return r.shift(1);
};
