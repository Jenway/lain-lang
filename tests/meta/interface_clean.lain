// 干净版接口分发：Ref(T) 直接解引用、Ref(void) 承载不透明数据、Fn 类型直接从
// 成员调用、分发器用 let ... = func 写法声明。
struct Circle { r: i64 }
struct Rect { w: i64 h: i64 }
struct VT { area: Fn((Ref(void)) -> i64) scale: Fn((Ref(void), i64) -> i64) }
struct Shape { data: Ref(void) vtable: VT }

func circle_area(self: Ref(Circle)) -> i64 { return deref(self).r * deref(self).r; }
func circle_scale(self: Ref(Circle), k: i64) -> i64 { return deref(self).r * k; }
func rect_area(self: Ref(Rect)) -> i64 { return deref(self).w * deref(self).h; }
func rect_scale(self: Ref(Rect), k: i64) -> i64 {
  return deref(self).w * deref(self).h * k;
}

let area_of = func (s: Shape) -> i64 { return s.vtable.area(s.data); };
let scale_of = func (s: Shape, k: i64) -> i64 { return s.vtable.scale(s.data, k); };

func main() -> u64 {
  let c: Circle = Circle { r: 3 };
  let rt: Rect = Rect { w: 4 h: 5 };
  let vtc: VT = VT { area: symbol_addr("circle_area") scale: symbol_addr("circle_scale") };
  let vtr: VT = VT { area: symbol_addr("rect_area") scale: symbol_addr("rect_scale") };
  let rc: Ref(Circle) = mut_of(c);
  let rr: Ref(Rect) = mut_of(rt);
  let sc: Shape = Shape { data: rc as Ref(void) vtable: vtc };
  let sr: Shape = Shape { data: rr as Ref(void) vtable: vtr };
  let a: i64 = area_of(sc) + scale_of(sr, 2);
  return a as u64;
}
