let SubSig = sig {
  pub let Self: Type;
  pub let add: Fn((Self, Self) -> Self);
  pub let total: Fn((Self) -> i64);
};

let Outer = module {
  let secret: i64 = 5;

  pub let Inner = module {

    let hidden = func() -> i64 { return 11; };

    pub let Vec = struct { x: i64, y: i64 };

    pub let Self = Vec;

    pub let make = func(x: i64, y: i64) -> Vec {
      return Vec { x: x, y: y };
    };

    pub let add = func(a: Vec, b: Vec) -> Vec {
      let h: i64 = hidden();
      return Vec { x: a.x + b.x + h, y: a.y + b.y + h + secret };
    };

    pub let total = func(v: Vec) -> i64 { return v.x + v.y; };
  };

  pub let InnerSealed: SubSig = Inner;

  open Inner;

  pub let OuterTotal = func() -> i64 {
    return total(make(1, 2));
  };
};

let main = func() -> i64 {
  let a: Outer.Inner.Vec = Outer.Inner.make(3, 4);
  let b: Outer.Inner.Vec = Outer.Inner.Vec { x: 6, y: 7 };

  let c: Outer.Inner.Vec = Outer.Inner.add(a, b);

  let d: Outer.Inner.Vec = Outer.InnerSealed.add(c, c);

  let e: i64 = Outer.OuterTotal();

  let f: i64 = 0;
  {
    use Outer.Inner;
    let p: Vec = make(2, 3);
    f = total(p) + p.x;
  }
  let p: Outer.Inner.Vec = Outer.Inner.make(1, 1);

  let g: i64 = Outer.Inner.total(c);
  return c.x + c.y + d.x + d.y + e + f + g + p.x;
};
