let Vec2 = struct { x: i64, y: i64 };

let Vec2Left = module {
  pub let Self = Vec2;
  pub let foo = func(v: Vec2) -> i64 {
    return v.x;
  };
};

let Vec2Right = module {
  pub let Self = Vec2;
  pub let foo = func(v: Vec2) -> i64 {
    return v.y;
  };
};

use Vec2Left;
use Vec2Right;

let main = func() -> i64 {
  let v: Vec2 = Vec2 { x: 1, y: 2 };
  return v.foo();
};
