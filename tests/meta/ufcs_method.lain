let Vec2 = struct { x: i64, y: i64 };

let Vec2Mod = module {
  pub let Self = Vec2;

  pub let scale = func(self: Vec2, k: i64) -> Vec2 {
    return Vec2 { x: self.x * k, y: self.y * k };
  };

  pub let sum = func(self: Ref(Vec2)) -> i64 {
    return self.x + self.y;
  };

  pub let shift = func(self: Mut(Vec2), d: i64) -> i64 {
    self.x = self.x + d;
    return self.x;
  };
};

use Vec2Mod;

let bump = func(m: Mut(Vec2)) -> i64 {
  return m.shift(5);
};

let main = func() -> i64 {
  let p: Vec2 = Vec2 { x: 3, y: 4 };
  let scaled: Vec2 = p.scale(10);
  let s: i64 = p.sum();
  let moved: i64 = p.shift(5);
  let r: Ref(Vec2) = ref_of(p);
  let rs: i64 = r.sum();
  let scaled2: Vec2 = r.scale(2);
  let b: i64 = bump(mut_of(p));
  return scaled.x + scaled.y + s + moved + rs + scaled2.x + scaled2.y + b + p.x;
};
