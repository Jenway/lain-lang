// lain_io_write 必须拒绝落在任何可读区域之外的地址，而不是读取宿主内存。
let io = import("std::io");

func main() -> i64 {
  let bytes: Array(u8, 4) = [65, 66, 67, 68];
  let base: Slice(u8) = slice_of(bytes);
  let far: Ref(u8) = ptr_cast(Ref(u8), (base.ptr as u64) + 1073741824);
  let bad: Slice(u8) = make_slice(Slice(u8), far, 4);
  io.write_str(bad);
  return 0;
}
