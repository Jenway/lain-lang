let col = import("std::collections");

let IntVec = col.Vec(i64);
let SymMap = col.HashMapU64(i64);

use IntVec;
use SymMap;

let bit = func(b: bool) -> i64 {
  return if b { 1 } else { 0 };
};

let main = func() -> i64 {

  let v: IntVec.Self = IntVec.new();
  let p0: bool = v.push(10);
  let p1: bool = v.push(20);
  let p2: bool = v.push(30);
  let n_before: u64 = IntVec.len(ref_of(v));
  let s0: bool = v.set(0, 40);
  let e0: i64 = v.get(0);
  let e1: i64 = v.get(1);
  let e2: i64 = v.get(2);
  let vec_sum: i64 = e0 + e1 + e2;

  let grow_ok: u64 = loop f(i: u64 = 0, ok: u64 = 1) while i < 97 {
    let pushed: bool = v.push(1);
    if pushed == false { ok = 0; }
    i = i + 1;
  };
  let n_full: u64 = IntVec.len(ref_of(v));

  v.clear();
  let n_after: u64 = IntVec.len(ref_of(v));
  let empty_pop: IntVec.Opt = IntVec.pop(mut_of(v));
  let empty_none: bool = match empty_pop {
    Some(_) => false,
    None => true,
  };

  let w: IntVec.Self = IntVec.new();
  let wp: bool = w.push(7);
  let wn: u64 = IntVec.len(ref_of(w));
  let wg: i64 = w.get(0);
  let wpop: IntVec.Opt = IntVec.pop(mut_of(w));
  let wpop_val: i64 = match wpop {
    Some(x) => x,
    None => -1,
  };
  let wn2: u64 = IntVec.len(ref_of(w));

  let m: SymMap.Self = SymMap.new();
  let q0: bool = m.put(1, 4);
  let q1: bool = m.put(33, 9);
  let q2: bool = m.put(9, 1);
  let n_map: u64 = SymMap.len(ref_of(m));

  let q3: bool = m.put(1, 5);
  let n_map2: u64 = SymMap.len(ref_of(m));

  let out1: i64 = 0;
  let f1: bool = m.get(1, mut_of(out1));
  let out33: i64 = 0;
  let f33: bool = m.get(33, mut_of(out33));
  let out9: i64 = 0;
  let f9: bool = m.get(9, mut_of(out9));
  let hit: bool = m.has(33);
  let miss: bool = m.has(2);
  let out_missing: i64 = 0;
  let f_missing: bool = m.get(2, mut_of(out_missing));

  let m2: SymMap.Self = SymMap.new();
  let r0: bool = m2.put(1, 100);
  let out_m2: i64 = 0;
  let f_m2: bool = m2.get(1, mut_of(out_m2));
  let m2_n: u64 = SymMap.len(ref_of(m2));

  let push_bias: i64 = bit(p0) + bit(p1) + bit(p2) - 3;
  let count_bias: i64 = (n_before as i64) - 3;
  let set_bias: i64 = bit(s0) - 1;
  let grow_bias: i64 = (grow_ok as i64) - 1 + (n_full as i64) - 100;
  let clear_bias: i64 = n_after as i64;
  let pop_bias: i64 = if empty_none { 0 } else { 1 };
  let vec2_bias: i64 = bit(wp) - 1 + (wn as i64) - 1 + wg - 7 + wpop_val - 7 + (wn2 as i64);
  let put_bias: i64 = bit(q0) + bit(q1) + bit(q2) + (if q3 { 0 } else { 1 }) - 4;
  let map_len_bias: i64 = (n_map as i64) - 3 + (n_map2 as i64) - 3;
  let get_flags: i64 = bit(f1) + bit(f33) + bit(f9) - 3;
  let collision_bias: i64 = out33 - 9;
  let key_bias: i64 = out9 - 1;
  let hit_bias: i64 = bit(hit) - 1;
  let miss_bias: i64 = bit(miss);
  let missing_get_bias: i64 = (if f_missing { 1 } else { 0 }) + out_missing;
  let map2_bias: i64 = bit(r0) - 1 + bit(f_m2) - 1 + (m2_n as i64) - 1 + out_m2 - 100;

  return vec_sum + out1 + push_bias + count_bias + set_bias + grow_bias + clear_bias
    + pop_bias + vec2_bias + put_bias + map_len_bias + get_flags + collision_bias
    + key_bias + hit_bias + miss_bias + missing_get_bias + map2_bias;
};
