let Cancel = effect {
  op cancel() -> Never;
};

let stop = func(id: i64) -> i64 !{ Cancel } {
  if id > 0 {
    perform Cancel.cancel();
  }
  return id;
};

let run = func(id: i64) -> i64 !{ Cancel } {
  return stop(id) + 1;
};

let main = func() -> i64 {
  return handle run(1) with {
    return(v) => v,
    cancel() => 0,
  };
};
