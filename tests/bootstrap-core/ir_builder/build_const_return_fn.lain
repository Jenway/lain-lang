// Bootstrap Core: Lain IR builder wrapper can build a const-return function.
// CHECK: #proc build_answer(i32 %arg0, i32 %arg1) -> i32
// CHECK: #call ir_return_const_i32
// CHECK: #field[0]
// CHECK: #field[12]
// CHECK: #return #add

struct IrType {
    tag: i32,
    width: i32,
}

struct IrValue {
    tag: i32,
    type_tag: i32,
    payload: i32,
}

struct IrFunction {
    name: i32,
    param_count: i32,
    ret_tag: i32,
    body_score: i32,
}

fn ir_type_i32() -> IrType {
    IrType { tag: 1, width: 32 }
}

fn ir_const_i32(value: i32) -> IrValue {
    let ty: IrType = ir_type_i32();
    IrValue { tag: 1, type_tag: ty.tag, payload: value }
}

fn ir_return_const_i32(name: i32, value: i32) -> IrFunction {
    let value_expr: IrValue = ir_const_i32(value);
    IrFunction {
        name: name,
        param_count: 0,
        ret_tag: value_expr.type_tag,
        body_score: value_expr.payload,
    }
}

fn build_answer(name: i32, value: i32) -> i32 {
    let function: IrFunction = ir_return_const_i32(name, value);
    function.name + function.body_score
}

fn main(name: i32, value: i32) -> i32 {
    build_answer(name, value)
}
