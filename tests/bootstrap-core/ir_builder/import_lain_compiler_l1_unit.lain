// Bootstrap Core: Lain-owned structured L1Unit builds return and add procedures.
// CHECK: #proc main
// CHECK: #call l1_unit_l1_unit_return_42_score
// CHECK: #call l1_unit_l1_unit_add_40_2_score
// CHECK: #call l1_unit_l1_unit_return_42_instruction_count
// CHECK: #call l1_unit_l1_unit_add_40_2_instruction_count
// CHECK: #return

import packages::lain::compiler::l1_unit;

fn main(name: i32) -> i32 {
    return l1_unit_return_42_score(name) + l1_unit_add_40_2_score(name) + l1_unit_return_42_instruction_count(name) + l1_unit_add_40_2_instruction_count(name);
}
