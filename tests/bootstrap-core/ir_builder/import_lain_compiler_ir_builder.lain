// Bootstrap Core: a Lain package can host compiler IR builder helpers.
// CHECK: #proc main
// CHECK: #call ir_builder_ir_build_const_score
// CHECK: #call ir_builder_ir_build_call_score
// CHECK: #return #add

import packages::lain::compiler::ir_builder;

fn main(name: i32, callee: i32, left: i32, right: i32) -> i32 {
    ir_build_const_score(name, left) + ir_build_call_score(name, callee, left, right)
}
