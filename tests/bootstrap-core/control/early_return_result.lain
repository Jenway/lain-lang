// Bootstrap Core: early return Result.Err can express recoverable compiler errors.
// CHECK: #proc parse_piece(i32 %arg0) -> addr
// CHECK: #if #eq
// CHECK: #return #call ParseResult_Err()
// CHECK: #return #call ParseResult_Ok()

enum ParseResult {
    Ok,
    Err,
}

fn parse_piece(token_tag: i32) -> ParseResult {
    if token_tag == 0 {
        return ParseResult::Err();
    }

    ParseResult::Ok()
}

fn main(tag: i32) -> ParseResult {
    parse_piece(tag)
}
