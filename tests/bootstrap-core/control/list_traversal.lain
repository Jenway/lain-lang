// Bootstrap Core: list/tree traversal can express parser and lowering walks.
// CHECK: #proc count_tag(addr %arg0, i32 %arg1) -> i32
// CHECK: #alloca(4)
// CHECK: #if #eq
// CHECK: #store 1
// CHECK: #load
// CHECK: #call count_tag
// CHECK: #return #add

let AstNode: type = std::struct {
    tag: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

let count_tag = std::func(node: AstNode, wanted: i32) -> i32 {
    let self_count: i32 = if node.tag == wanted {
        1
    } else {
        0
    };

    let child_count: i32 = if node.has_child == 0 {
        0
    } else {
        count_tag(node.first_child, wanted)
    };

    let next_count: i32 = if node.has_next == 0 {
        0
    } else {
        count_tag(node.next, wanted)
    };

    self_count + child_count + next_count
}

let main = std::func(root_tag: i32, child_tag: i32, wanted: i32) -> i32 {
    let child: AstNode = AstNode {
        tag: child_tag,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let root: AstNode = AstNode {
        tag: root_tag,
        has_child: 1,
        first_child: child,
        has_next: 0,
        next: 0,
    };
    count_tag(root, wanted)
}
