// Bootstrap Core: nested match can express parser dispatch.
// CHECK: #proc classify_pair(addr %arg0, addr %arg1) -> i32
// CHECK: #if #eq
// CHECK: #return 11
// CHECK: #return 12
// CHECK: #return 20

enum NodeKind {
    Atom,
    Group,
}

fn classify_pair(first: NodeKind, second: NodeKind) -> i32 {
    match first {
        Atom => {
            match second {
                Atom => { 11 },
                Group => { 12 },
            }
        },
        Group => { 20 },
    }
}

fn main() -> i32 {
    let first: NodeKind = NodeKind::Atom();
    let second: NodeKind = NodeKind::Group();
    classify_pair(first, second)
}
