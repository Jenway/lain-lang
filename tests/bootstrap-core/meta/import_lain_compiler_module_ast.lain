// Bootstrap Core: lain.compiler can extract module exports from LAIN-AST topology.
// CHECK: #proc main
// CHECK: #call module_ast_module_ast_pub_fn_name
// CHECK: #call module_ast_module_ast_root_pub_fn_count
// CHECK: #return #add

import packages::lain::compiler::module_ast;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn main(pub_symbol: i32, fn_symbol: i32, name_symbol: i32, ret_symbol: i32) -> i32 {
    let ret: AstSexpr = AstSexpr {
        tag: 1,
        symbol: ret_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let params: AstSexpr = AstSexpr {
        tag: 2,
        symbol: 0,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let name: AstSexpr = AstSexpr {
        tag: 1,
        symbol: name_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 1,
        next: params,
    };
    let call: AstSexpr = AstSexpr {
        tag: 6,
        symbol: 0,
        has_child: 1,
        first_child: name,
        has_next: 1,
        next: ret,
    };
    let signature: AstSexpr = AstSexpr {
        tag: 4,
        symbol: 0,
        has_child: 1,
        first_child: call,
        has_next: 0,
        next: 0,
    };
    let fn_atom: AstSexpr = AstSexpr {
        tag: 1,
        symbol: fn_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let pub_atom: AstSexpr = AstSexpr {
        tag: 1,
        symbol: pub_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 1,
        next: fn_atom,
    };
    let prefix: AstSexpr = AstSexpr {
        tag: 3,
        symbol: 0,
        has_child: 1,
        first_child: pub_atom,
        has_next: 1,
        next: signature,
    };
    let header: AstSexpr = AstSexpr {
        tag: 3,
        symbol: 0,
        has_child: 1,
        first_child: prefix,
        has_next: 0,
        next: 0,
    };
    let form: AstSexpr = AstSexpr {
        tag: 3,
        symbol: 0,
        has_child: 1,
        first_child: header,
        has_next: 0,
        next: 0,
    };
    let root: AstSexpr = AstSexpr {
        tag: 2,
        symbol: 0,
        has_child: 1,
        first_child: form,
        has_next: 0,
        next: 0,
    };
    return module_ast_pub_fn_name(form, pub_symbol, fn_symbol)
        + module_ast_root_pub_fn_count(root, pub_symbol, fn_symbol);
}
