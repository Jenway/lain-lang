// Bootstrap Core: a Lain package can host compiler AST, type, and diagnostic helpers.
// CHECK: #proc main
// CHECK: #call ast_ast_node_score
// CHECK: #call type_shape_type_application_score
// CHECK: #call diagnostic_diagnostic_score
// CHECK: #return #add

import packages::lain::compiler::ast;
import packages::lain::compiler::type_shape;
import packages::lain::compiler::diagnostic;

fn main(tag: i32, name: i32, arg: i32) -> i32 {
    ast_node_score(tag, name, 0, 0) + type_application_score(name, arg) + diagnostic_score(1, name, 2, 3)
}
