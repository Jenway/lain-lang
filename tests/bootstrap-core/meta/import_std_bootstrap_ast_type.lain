// Bootstrap Core: a Lain file can import std/bootstrap AST and type helpers.
// CHECK: #proc main
// CHECK: #call ast_tree_ast_node_score
// CHECK: #call type_shape_type_application_score
// CHECK: #return #add

import std::bootstrap::ast_tree;
import std::bootstrap::type_shape;

fn main(tag: i32, name: i32, arg: i32) -> i32 {
    ast_node_score(tag, name, 0, 0) + type_application_score(name, arg)
}
