// Bootstrap Core: a Lain-written lainc entry can compose module and IR helpers.
// CHECK: #proc main
// CHECK: #call lainc_lainc_compile_module_score
// CHECK: #return

import packages::lain::compiler::lainc;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn main(package_symbol: i32, path_symbol: i32, pub_symbol: i32, fn_symbol: i32, name_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let params: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let name: AstSexpr = AstSexpr { tag: 1, symbol: name_symbol, has_child: 0, first_child: 0, has_next: 1, next: params };
    let call: AstSexpr = AstSexpr { tag: 6, symbol: 0, has_child: 1, first_child: name, has_next: 0, next: 0 };
    let sig: AstSexpr = AstSexpr { tag: 4, symbol: 0, has_child: 1, first_child: call, has_next: 0, next: 0 };
    let fn_atom: AstSexpr = AstSexpr { tag: 1, symbol: fn_symbol, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let pub_atom: AstSexpr = AstSexpr { tag: 1, symbol: pub_symbol, has_child: 0, first_child: 0, has_next: 1, next: fn_atom };
    let prefix: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: pub_atom, has_next: 1, next: sig };
    let header: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: prefix, has_next: 0, next: 0 };
    let form: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: header, has_next: 0, next: 0 };
    let root: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 1, first_child: form, has_next: 0, next: 0 };
    return lainc_compile_module_score(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol);
}
