// Bootstrap Core: compiler diagnostics can be represented as data.
// CHECK: #alloca(16)
// CHECK: #field[0]
// CHECK: #field[12]
// CHECK: #return #add

struct Diagnostic {
    code: i32,
    message: i32,
    start: i32,
    end: i32,
}

fn diagnostic_span(diag: Diagnostic) -> i32 {
    diag.start + diag.end
}

fn diagnostic_score(code: i32, message: i32, start: i32, end: i32) -> i32 {
    let diag: Diagnostic = Diagnostic {
        code: code,
        message: message,
        start: start,
        end: end,
    };
    diag.code + diag.message + diagnostic_span(diag)
}

fn main(code: i32, message: i32) -> i32 {
    diagnostic_score(code, message, 10, 14)
}
