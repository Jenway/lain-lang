// Bootstrap Core: lain.compiler can consume tree-shaped LAIN-AST S-expression data.
// CHECK: #proc main
// CHECK: #call ast_sexpr_ast_sexpr_parse_fn_signature_name
// CHECK: #call ast_sexpr_ast_sexpr_parse_fn_signature_param_count
// CHECK: #call ast_sexpr_ast_sexpr_parse_fn_signature_ret
// CHECK: #return #add

import packages::lain::compiler::ast_sexpr;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn main(main_symbol: i32, i32_symbol: i32, comma_symbol: i32) -> i32 {
    let ret: AstSexpr = AstSexpr {
        tag: 1,
        symbol: i32_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let second_param: AstSexpr = AstSexpr {
        tag: 4,
        symbol: 0,
        has_child: 0,
        first_child: 0,
        has_next: 0,
        next: 0,
    };
    let comma: AstSexpr = AstSexpr {
        tag: 1,
        symbol: comma_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 1,
        next: second_param,
    };
    let first_param: AstSexpr = AstSexpr {
        tag: 4,
        symbol: 0,
        has_child: 0,
        first_child: 0,
        has_next: 1,
        next: comma,
    };
    let params: AstSexpr = AstSexpr {
        tag: 2,
        symbol: 0,
        has_child: 1,
        first_child: first_param,
        has_next: 0,
        next: 0,
    };
    let name: AstSexpr = AstSexpr {
        tag: 1,
        symbol: main_symbol,
        has_child: 0,
        first_child: 0,
        has_next: 1,
        next: params,
    };
    let call: AstSexpr = AstSexpr {
        tag: 6,
        symbol: 0,
        has_child: 1,
        first_child: name,
        has_next: 1,
        next: ret,
    };
    let signature: AstSexpr = AstSexpr {
        tag: 4,
        symbol: 0,
        has_child: 1,
        first_child: call,
        has_next: 0,
        next: 0,
    };
    ast_sexpr_parse_fn_signature_name(signature, comma_symbol)
        + ast_sexpr_parse_fn_signature_param_count(signature, comma_symbol)
        + ast_sexpr_parse_fn_signature_ret(signature, comma_symbol)
}
