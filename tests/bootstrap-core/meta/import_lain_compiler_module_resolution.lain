// Bootstrap Core: lain.compiler owns dependency-gated export resolution diagnostics.
// CHECK: #proc main
// CHECK: #call module_resolution_module_resolution_two_exports_score
// CHECK: #call module_resolution_module_resolution_missing_dependency_score
// CHECK: #call module_resolution_module_resolution_duplicate_export_code
// CHECK: #return #add

import packages::lain::compiler::module_resolution;

fn main(package_symbol: i32, path_symbol: i32, first_name: i32, first_link: i32, second_name: i32, second_link: i32, wanted_name: i32) -> i32 {
    return module_resolution_two_exports_score(package_symbol, path_symbol, first_name, first_link, second_name, second_link, wanted_name)
        + module_resolution_missing_dependency_score(package_symbol, path_symbol, wanted_name)
        + module_resolution_duplicate_export_code(package_symbol, path_symbol, first_name);
}
