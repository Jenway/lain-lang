// Bootstrap Core: lain.compiler can model meta-owned module summaries.
// CHECK: #proc main
// CHECK: #call module_module_make_id_score
// CHECK: #call module_module_export_fn_score
// CHECK: #call module_module_summary_single_export_score
// CHECK: #call module_query_module_query_lookup_two_exports_link
// CHECK: #call module_query_module_query_export_exists
// CHECK: #call module_dependency_module_dependency_pair_score
// CHECK: #call module_dependency_module_dependency_pair_contains
// CHECK: #call module_diagnostic_module_diag_missing_export_score
// CHECK: #call module_diagnostic_module_diag_missing_dependency_score
// CHECK: #call module_diagnostic_module_diag_duplicate_export_score
// CHECK: #return #add

import packages::lain::compiler::module;
import packages::lain::compiler::module_query;
import packages::lain::compiler::module_dependency;
import packages::lain::compiler::module_diagnostic;

fn main(package_symbol: i32, path_symbol: i32, name: i32, type_symbol: i32, link_symbol: i32) -> i32 {
    module_make_id_score(package_symbol, path_symbol)
        + module_export_fn_score(name, type_symbol, link_symbol)
        + module_summary_single_export_score(package_symbol, path_symbol, name, type_symbol, link_symbol)
        + module_query_lookup_two_exports_link(name, link_symbol, path_symbol, package_symbol, path_symbol)
        + module_query_export_exists(name, path_symbol, name)
        + module_dependency_pair_score(package_symbol, path_symbol, name)
        + module_dependency_pair_contains(package_symbol, path_symbol, name, name)
        + module_diag_missing_export_score(package_symbol, path_symbol, name)
        + module_diag_missing_dependency_score(package_symbol, path_symbol)
        + module_diag_duplicate_export_score(package_symbol, path_symbol, name)
}
