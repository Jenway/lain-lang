// Bootstrap Core: a Lain helper can parse a canonical function binding shape.
// CHECK: #proc parse_binding_shape(addr %arg0, addr %arg1, addr %arg2) -> i32
// CHECK: #call count_params
// CHECK: #alloca(16)
// CHECK: #return #add

let AstTree: type = std::struct {
    tag: i32,
    symbol: i32,
    has_next: i32,
    next: addr,
}

let BindingShape: type = std::struct {
    name: i32,
    param_count: i32,
    ret: i32,
    error_count: i32,
}

let count_params = std::func(node: AstTree) -> i32 {
    if node.has_next == 0 {
        1
    } else {
        1 + count_params(node.next)
    }
}

let ret_score = std::func(ret_node: AstTree) -> i32 {
    if ret_node.tag == 1 {
        ret_node.symbol
    } else {
        0
    }
}

let parse_binding_shape = std::func(name_node: AstTree, first_param: AstTree, ret_node: AstTree) -> i32 {
    let shape: BindingShape = BindingShape {
        name: name_node.symbol,
        param_count: count_params(first_param),
        ret: ret_score(ret_node),
        error_count: 0,
    };
    shape.name + shape.param_count + shape.ret + shape.error_count
}

let main = std::func(binding_name: i32, param_a: i32, param_b: i32, ret_name: i32) -> i32 {
    let second: AstTree = AstTree { tag: 1, symbol: param_b, has_next: 0, next: 0 };
    let first: AstTree = AstTree { tag: 1, symbol: param_a, has_next: 1, next: second };
    let name_node: AstTree = AstTree { tag: 1, symbol: binding_name, has_next: 0, next: 0 };
    let ret_node: AstTree = AstTree { tag: 1, symbol: ret_name, has_next: 0, next: 0 };
    parse_binding_shape(name_node, first, ret_node)
}
