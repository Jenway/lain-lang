// Bootstrap Core: a Lain helper can parse Name(T)-shaped AstTree data.
// CHECK: #alloca(12)
// CHECK: #field[0]
// CHECK: #field[4]
// CHECK: #return #add

struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

struct TypeShape {
    name: i32,
    arg: i32,
    arg_count: i32,
}

fn type_application_score(name_node: AstTree, arg_node: AstTree) -> i32 {
    let shape: TypeShape = TypeShape {
        name: name_node.symbol,
        arg: arg_node.symbol,
        arg_count: 1,
    };
    shape.name + shape.arg + shape.arg_count
}

fn main(name: i32, arg: i32) -> i32 {
    let name_node: AstTree = AstTree { tag: 1, symbol: name, left: 0, right: 0 };
    let arg_node: AstTree = AstTree { tag: 1, symbol: arg, left: 0, right: 0 };
    type_application_score(name_node, arg_node)
}
