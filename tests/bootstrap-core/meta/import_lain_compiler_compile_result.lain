// Bootstrap Core: lainc constructs a real CompileResult and exposes projections.
// CHECK: #proc main
// CHECK: #call lainc_lainc_compile_module_result_score
// CHECK: #call lainc_lainc_compile_module_ok
// CHECK: #call lainc_lainc_compile_module_diagnostic_code
// CHECK: #return

import packages::lain::compiler::lainc;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn main(package_symbol: i32, path_symbol: i32, pub_symbol: i32, fn_symbol: i32, type_symbol: i32, main_symbol: i32) -> i32 {
    let root: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let invalid: AstSexpr = AstSexpr { tag: 1, symbol: 0, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    return lainc_compile_module_result_score(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol)
        + lainc_compile_module_ok(package_symbol, path_symbol, root, pub_symbol, fn_symbol, type_symbol, main_symbol)
        + lainc_compile_module_diagnostic_code(package_symbol, path_symbol, invalid, pub_symbol, fn_symbol, type_symbol, main_symbol);
}
