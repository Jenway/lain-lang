// Bootstrap Core: a Lain helper can split comma-separated AstTree groups.
// CHECK: #proc split_group(addr %arg0) -> i32
// CHECK: #call count_items
// CHECK: #call count_commas
// CHECK: #return #add

let AstTree: type = std::struct {
    tag: i32,
    symbol: i32,
    has_next: i32,
    next: addr,
}

let SplitStats: type = std::struct {
    item_count: i32,
    comma_count: i32,
    error_count: i32,
}

let is_comma = std::func(node: AstTree) -> i32 {
    if node.tag == 44 {
        1
    } else {
        0
    }
}

let item_score = std::func(node: AstTree) -> i32 {
    if is_comma(node) == 1 {
        0
    } else {
        1
    }
}

let comma_score = std::func(node: AstTree) -> i32 {
    if is_comma(node) == 1 {
        1
    } else {
        0
    }
}

let count_items = std::func(node: AstTree) -> i32 {
    if node.has_next == 0 {
        item_score(node)
    } else {
        item_score(node) + count_items(node.next)
    }
}

let count_commas = std::func(node: AstTree) -> i32 {
    if node.has_next == 0 {
        comma_score(node)
    } else {
        comma_score(node) + count_commas(node.next)
    }
}

let malformed_count = std::func(stats: SplitStats) -> i32 {
    if stats.item_count == stats.comma_count {
        1
    } else {
        0
    }
}

let split_group = std::func(first: AstTree) -> i32 {
    let stats: SplitStats = SplitStats {
        item_count: count_items(first),
        comma_count: count_commas(first),
        error_count: 0,
    };
    stats.item_count + stats.comma_count + malformed_count(stats)
}

let main = std::func(left_symbol: i32, right_symbol: i32) -> i32 {
    let right: AstTree = AstTree { tag: 1, symbol: right_symbol, has_next: 0, next: 0 };
    let comma: AstTree = AstTree { tag: 44, symbol: 44, has_next: 1, next: right };
    let left: AstTree = AstTree { tag: 1, symbol: left_symbol, has_next: 1, next: comma };
    split_group(left)
}
