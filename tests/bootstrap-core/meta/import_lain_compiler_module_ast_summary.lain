// Bootstrap Core: lain.compiler can build a module summary score from LAIN-AST exports.
// CHECK: #proc main
// CHECK: #call module_ast_summary_module_ast_summary_pub_fn_count
// CHECK: #call module_ast_score_module_ast_score_summary
// CHECK: #return #add

import packages::lain::compiler::module_ast_summary;
import packages::lain::compiler::module_ast_score;

struct AstSexpr {
    tag: i32,
    symbol: i32,
    has_child: i32,
    first_child: addr,
    has_next: i32,
    next: addr,
}

fn main(package_symbol: i32, path_symbol: i32, pub_symbol: i32, fn_symbol: i32, first_name: i32, second_name: i32, type_symbol: i32) -> i32 {
    let params2: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let name2: AstSexpr = AstSexpr { tag: 1, symbol: second_name, has_child: 0, first_child: 0, has_next: 1, next: params2 };
    let call2: AstSexpr = AstSexpr { tag: 6, symbol: 0, has_child: 1, first_child: name2, has_next: 0, next: 0 };
    let sig2: AstSexpr = AstSexpr { tag: 4, symbol: 0, has_child: 1, first_child: call2, has_next: 0, next: 0 };
    let fn2: AstSexpr = AstSexpr { tag: 1, symbol: fn_symbol, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let pub2: AstSexpr = AstSexpr { tag: 1, symbol: pub_symbol, has_child: 0, first_child: 0, has_next: 1, next: fn2 };
    let prefix2: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: pub2, has_next: 1, next: sig2 };
    let header2: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: prefix2, has_next: 0, next: 0 };
    let form2: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: header2, has_next: 0, next: 0 };

    let params1: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let name1: AstSexpr = AstSexpr { tag: 1, symbol: first_name, has_child: 0, first_child: 0, has_next: 1, next: params1 };
    let call1: AstSexpr = AstSexpr { tag: 6, symbol: 0, has_child: 1, first_child: name1, has_next: 0, next: 0 };
    let sig1: AstSexpr = AstSexpr { tag: 4, symbol: 0, has_child: 1, first_child: call1, has_next: 0, next: 0 };
    let fn1: AstSexpr = AstSexpr { tag: 1, symbol: fn_symbol, has_child: 0, first_child: 0, has_next: 0, next: 0 };
    let pub1: AstSexpr = AstSexpr { tag: 1, symbol: pub_symbol, has_child: 0, first_child: 0, has_next: 1, next: fn1 };
    let prefix1: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: pub1, has_next: 1, next: sig1 };
    let header1: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: prefix1, has_next: 0, next: 0 };
    let form1: AstSexpr = AstSexpr { tag: 3, symbol: 0, has_child: 1, first_child: header1, has_next: 1, next: form2 };
    let root: AstSexpr = AstSexpr { tag: 2, symbol: 0, has_child: 1, first_child: form1, has_next: 0, next: 0 };

    return module_ast_summary_pub_fn_count(root, pub_symbol, fn_symbol)
        + module_ast_score_summary(package_symbol + path_symbol, root, pub_symbol, fn_symbol, type_symbol);
}
