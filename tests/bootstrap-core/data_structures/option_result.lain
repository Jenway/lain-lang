// Bootstrap Core: tagged Option/Result-shaped data can be represented.
// CHECK: #alloca(8)
// CHECK: #field[0]
// CHECK: #field[4]
// CHECK: #return #add

let OptionI32: type = std::struct {
    tag: i32,
    value: i32,
}

let ResultI32: type = std::struct {
    tag: i32,
    value: i32,
}

let option_score = std::func(value: OptionI32) -> i32 {
    value.tag + value.value
}

let result_score = std::func(value: ResultI32) -> i32 {
    value.tag + value.value
}

let main = std::func(input: i32) -> i32 {
    let some: OptionI32 = OptionI32 { tag: 1, value: input };
    let ok: ResultI32 = ResultI32 { tag: 1, value: option_score(some) };
    result_score(ok)
}
