// Bootstrap Core: tagged Option/Result-shaped data can be represented.
// CHECK: #alloca(8)
// CHECK: #field[0]
// CHECK: #field[4]
// CHECK: #return #add

struct OptionI32 {
    tag: i32,
    value: i32,
}

struct ResultI32 {
    tag: i32,
    value: i32,
}

fn option_score(value: OptionI32) -> i32 {
    value.tag + value.value
}

fn result_score(value: ResultI32) -> i32 {
    value.tag + value.value
}

fn main(input: i32) -> i32 {
    let some: OptionI32 = OptionI32 { tag: 1, value: input };
    let ok: ResultI32 = ResultI32 { tag: 1, value: option_score(some) };
    result_score(ok)
}
