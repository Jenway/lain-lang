// Bootstrap Core: list-shaped compiler collections can be traversed.
// CHECK: #proc sum_list(addr %arg0) -> i32
// CHECK: #if #eq
// CHECK: #call sum_list
// CHECK: #return #call sum_list

let Node: type = std::struct {
    value: i32,
    has_next: i32,
    next: addr,
}

let sum_list = std::func(node: Node) -> i32 {
    if node.has_next == 0 {
        node.value
    } else {
        node.value + sum_list(node.next)
    }
}

let main = std::func(a: i32, b: i32, c: i32) -> i32 {
    let last: Node = Node { value: c, has_next: 0, next: 0 };
    let middle: Node = Node { value: b, has_next: 1, next: last };
    let first: Node = Node { value: a, has_next: 1, next: middle };
    sum_list(first)
}
