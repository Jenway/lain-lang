// Bootstrap Core: enum-like tagged union plus match can drive dispatch.
// CHECK: #proc classify(addr %arg0) -> i32
// CHECK: #if #eq
// CHECK: #return 10
// CHECK: #return 20

enum ParseStep {
    Atom,
    Group,
}

fn classify(step: ParseStep) -> i32 {
    match step {
        Atom => { 10 },
        Group => { 20 },
    }
}

fn main() -> i32 {
    let step: ParseStep = ParseStep::Group();
    classify(step)
}
