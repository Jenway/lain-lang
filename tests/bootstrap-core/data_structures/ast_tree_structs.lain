// Bootstrap Core: AstTree-shaped data can be represented in Lain.
// CHECK: #alloca(16)
// CHECK: #field[0]
// CHECK: #field[4]
// CHECK: #return #add

struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

fn main(symbol: i32) -> i32 {
    let node: AstTree = AstTree { tag: 1, symbol: symbol, left: 0, right: 0 };
    node.tag + node.symbol
}
