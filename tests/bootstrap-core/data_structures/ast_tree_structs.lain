// Bootstrap Core: AstTree-shaped data can be represented in Lain.
// CHECK: #alloca(16)
// CHECK: #field[0]
// CHECK: #field[4]
// CHECK: #return #add

let AstTree: type = std::struct {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

let main = std::func(symbol: i32) -> i32 {
    let node: AstTree = AstTree { tag: 1, symbol: symbol, left: 0, right: 0 };
    node.tag + node.symbol
}
