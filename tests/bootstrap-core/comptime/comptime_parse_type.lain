// Bootstrap Core: comptime can run a type parser helper through LAIN-IR.
// CHECK: #eval parse_type_score(1, 32)
// CHECK-NOT: #call parse_type_score

struct TypeShape {
    name: i32,
    arg: i32,
    arg_count: i32,
}

comptime fn parse_type_score(name: i32, arg: i32) -> i32 {
    let shape: TypeShape = TypeShape {
        name: name,
        arg: arg,
        arg_count: 1,
    };
    shape.name + shape.arg + shape.arg_count
}

fn main() -> i32 {
    parse_type_score(1, 32)
}
