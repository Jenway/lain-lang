// Bootstrap Core: comptime can build a small AstTree value through LAIN-IR.
// CHECK: #eval make_ast_score(10, 20)
// CHECK-NOT: #call make_ast_score

struct AstTree {
    tag: i32,
    symbol: i32,
    left: i32,
    right: i32,
}

comptime fn make_ast_score(tag: i32, symbol: i32) -> i32 {
    let node: AstTree = AstTree {
        tag: tag,
        symbol: symbol,
        left: 0,
        right: 0,
    };
    node.tag + node.symbol
}

fn main() -> i32 {
    make_ast_score(10, 20)
}
