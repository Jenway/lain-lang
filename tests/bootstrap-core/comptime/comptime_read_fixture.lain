// Bootstrap Core: comptime can read an explicit fixture through host capability.
// CHECK: #eval probe_fixture()
// CHECK-NOT: #call probe_fixture

import std::build;

comptime fn probe_fixture() -> i32 {
    let _ptr = std::build::host_read_file("tests/bootstrap-core/comptime/README.md");
    42
}

fn main() -> i32 {
    probe_fixture()
}
