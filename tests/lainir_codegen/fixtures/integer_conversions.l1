#proc main() -> #bits<32> {
  #let %byte: #bits<8> = 255
  #let %zero_wide: #bits<64> = #zext[#bits<64>](%byte)
  #let %sign_wide: #bits<64> = #sext[#bits<64>](%byte)
  #let %narrow_zero: #bits<8> = #trunc[#bits<8>](%zero_wide)
  #let %narrow_sign: #bits<8> = #trunc[#bits<8>](%sign_wide)
  #if #eq(%narrow_zero, %narrow_sign) {
    #if #eq(%narrow_zero, %byte) {
      #return 42
    }
  }
  #return 0
}
