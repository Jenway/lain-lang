#proc main() -> #bits<32> {
  #let %negative: #bits<8> = 255
  #let %positive: #bits<8> = 1
  #let %minimum: #bits<8> = 128
  #let %wide: #bits<32> = 84
  #if #slt(%negative, 0) {
    #if #sle(%negative, %negative) {
      #if #sgt(%positive, %negative) {
        #if #sge(%positive, %positive) {
          #if #ult(%positive, %negative) {
            #if #ule(%positive, %positive) {
              #if #ugt(%negative, %positive) {
                #if #uge(%negative, %negative) {
                  #let %one: #bits<8> = #sdiv(%negative, %negative)
                  #let %wrapped: #bits<8> = #sdiv(%minimum, %negative)
                  #if #eq(%one, 1) {
                    #if #eq(%wrapped, %minimum) {
                      #return #udiv(%wide, 2)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  #return 0
}
