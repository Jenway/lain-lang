(group root
  (juxt
    (juxt
      (atom "fn")
      (infix "->"
        (postfix "("
          (atom "identity")
          (group paren
            (juxt
              (atom "comptime")
              (infix ":"
                (atom "T")
                (atom "type")
              )
            )
            (atom ",")
            (infix ":"
              (atom "x")
              (atom "T")
            )
          )
        )
        (atom "T")
      )
    )
    (group brace
      (atom "x")
    )
  )
)
