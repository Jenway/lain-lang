(group root
  (juxt
    (atom "#")
    (group bracket
      (postfix "("
        (atom "foreign")
        (group paren
          (infix "="
            (atom "link_name")
            (atom "\"puts\"")
          )
        )
      )
    )
  )
  (juxt
    (atom "fn")
    (postfix "("
      (atom "puts")
      (group paren
        (infix ":"
          (atom "s")
          (atom "CStr")
        )
      )
    )
  )
)
