(group root
  (juxt
    (juxt
      (atom "fn")
      (infix "->"
        (postfix "("
          (atom "parse_piece")
          (group paren
            (infix ":"
              (atom "token_tag")
              (atom "i32")
            )
          )
        )
        (atom "ParseResult")
      )
    )
    (group brace
      (juxt
        (juxt
          (atom "if")
          (infix "=="
            (atom "token_tag")
            (atom "0")
          )
        )
        (group brace
          (juxt
            (atom "return")
            (infix "::"
              (atom "ParseResult")
              (postfix "("
                (atom "Err")
                (group paren
                )
              )
            )
          )
          (atom ";")
        )
      )
      (infix "::"
        (atom "ParseResult")
        (postfix "("
          (atom "Ok")
          (group paren
          )
        )
      )
    )
  )
)
