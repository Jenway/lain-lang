import packages::lain::compiler::mini_meta;

@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    let target: addr = "let answer = fn() -> i32 { let a = 10; let b = a + 20; b + 5 + 7 }";
    let l1: addr = mini_meta_compile(target, 66);
    let expected: addr = "#proc answer() -> i32 { #let %a: i32 = 10 #let %b: i32 = #add(%a, 20) #return #add(#add(%b, 5), 7) }";
    if mini_meta_text_equal(l1, expected) != 1 { return 1; }
    return execute_l1_text(l1, "answer");
}
