// The target text is data: only packages::lain::compiler::mini_meta assigns
// language meaning to its token topology.
import packages::lain::compiler::mini_meta;

@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    let target: addr = "let main = fn() -> i32 { let x = 40; x + 2 }";
    let l1: addr = mini_meta_compile(target, 44);
    let expected: addr = "#proc main() -> i32 { #let %x: i32 = 40 #return #add(%x, 2) }";
    if mini_meta_text_equal(l1, expected) != 1 { return 1; }
    return execute_l1_text(l1, "main");
}
