import packages::lain::compiler::mini_meta;

@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;

@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;

@foreign(c, link_name = "core.execute-lainir-text-i32!")
fn execute_l1_text_i32(text: addr, entry: addr, arg: i32) -> addr;

fn main() -> i32 {
    let source: addr = read_file_string("packages/lain/compiler/mini_diagnostic.lain");
    let result: i32 = mini_meta_begin(source, string_length(source));
    if mini_meta_result_ok(result) != 1 { return mini_meta_result_diagnostic_code(result); }
    if mini_meta_result_procedure_count(result) != 1 { return 3101; }
    let message: addr = execute_l1_text_i32(
        mini_meta_result_l1_unit(result), "mini_diagnostic_message", 2301);
    if mini_meta_text_equal(message, "unknown procedure") != 1 { return 3102; }
    return 42;
}
