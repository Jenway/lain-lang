import packages::lain::compiler::mini_meta;

@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;

@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;

@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    let source: addr = read_file_string("packages/lain/compiler/mini_type.lain");
    let result: i32 = mini_meta_begin(source, string_length(source));
    if mini_meta_result_ok(result) != 1 { return mini_meta_result_diagnostic_code(result); }
    if mini_meta_result_procedure_count(result) != 4 { return 3001; }
    if mini_meta_result_has_procedure(result, "mini_type_i32") != 1 { return 3002; }
    if mini_meta_result_has_procedure(result, "mini_type_same") != 1 { return 3003; }
    let value: i32 = execute_l1_text(mini_meta_result_l1_unit(result), "mini_type_i32");
    if value != 1 { return 3004; }
    return 42;
}
