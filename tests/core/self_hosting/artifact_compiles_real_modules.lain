@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;

@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;

@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact_i32(artifact: addr, entry: addr, source: addr, length: i32) -> i32;

@foreign(c, link_name = "core.execute-lainir-unit!")
fn execute_l1_unit(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "core.destroy-lainir-unit!")
fn destroy_l1_unit(unit: i32) -> i32;

fn main() -> i32 {
    let artifact: addr = read_file_string("build/core-self-hosting/meta_compiler.l1");

    let target_source: addr = "let add = fn(a: i32, b: i32) -> i32 { a + b }
let main = fn() -> i32 { let x = add(40, 2); if x == 42 { x } else { 0 } }";
    let target_unit: i32 = execute_compiler_artifact_i32(
        artifact, "mini_meta_compile", target_source, string_length(target_source));
    if target_unit == 0 { return 3201; }
    if execute_l1_unit(target_unit, "main") != 42 { return 3202; }
    if destroy_l1_unit(target_unit) != 1 { return 3203; }

    // M7: the artifact accepts the Lain-owned interpreter source itself,
    // including its physical foreign contracts and recursive evaluator.
    let interpreter_source: addr = read_file_string(
        "packages/lain/compiler/l1_interpreter.lain");
    let interpreter_code: i32 = execute_compiler_artifact_i32(
        artifact, "mini_meta_validate", interpreter_source,
        string_length(interpreter_source));
    if interpreter_code != 0 { return interpreter_code; }
    return 42;
}
