@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.write-file-string!")
fn write_file_string(path: addr, text: addr) -> i32;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact_text(
    artifact: addr, entry: addr, source: addr, length: i32) -> addr;

fn emit(artifact_path: addr, output_path: addr) -> i32 {
    let artifact: addr = read_file_string(artifact_path);
    let source: addr = read_file_string(
        "build/core-self-hosting/compiler_source.lain");
    let generated: addr = execute_compiler_artifact_text(
        artifact, "compiler_compile_text",
        source, string_length(source));
    return write_file_string(output_path, generated);
}

fn stage2() -> i32 {
    return emit(
        "build/core-self-hosting/meta_compiler.l1",
        "build/core-self-hosting/stage2_compiler.l1");
}

fn stage3() -> i32 {
    return emit(
        "build/core-self-hosting/stage2_compiler.l1",
        "build/core-self-hosting/stage3_compiler.l1");
}
