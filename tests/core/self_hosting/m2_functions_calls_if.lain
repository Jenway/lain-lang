import packages::lain::compiler::mini_meta;

@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    let target: addr = "let add = fn(a: i32, b: i32) -> i32 { a + b }
let main = fn() -> i32 { let x = add(40, 2); if x == 42 { x } else { 0 } }";
    let result: i32 = mini_meta_begin(target, 120);
    if mini_meta_result_ok(result) != 1 { return mini_meta_result_diagnostic_code(result); }
    if mini_meta_result_procedure_count(result) != 2 { return 3001; }
    if mini_meta_result_dependency_count(result) != 0 { return 3004; }
    if mini_meta_result_has_procedure(result, "add") != 1 { return 3002; }
    if mini_meta_result_has_procedure(result, "main") != 1 { return 3003; }
    let l1: addr = mini_meta_result_l1_unit(result);
    return execute_l1_text(l1, "main");
}
