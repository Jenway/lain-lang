@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn artifact_i32(
    artifact: addr, entry: addr, source: addr, length: i32) -> i32;

fn validate(artifact: addr, source: addr) -> i32 {
    return artifact_i32(
        artifact, "mini_meta_workspace_validate",
        source, string_length(source));
}

fn compile_is_empty(artifact: addr, source: addr) -> i32 {
    let generated: i32 = artifact_i32(
        artifact, "mini_meta_workspace_compile",
        source, string_length(source));
    if generated == 0 { return 1; }
    return 0;
}

fn main() -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");

    let missing: addr = "let app: Module = module {
        let absent: Module = require(absent);
        @export
        let main = fn() -> i32 { 42 };
    };";
    if validate(artifact, missing) != 4101 { return 3701; }
    if compile_is_empty(artifact, missing) != 1 { return 3702; }

    let private_access: addr = "let math: Module = module {
        let hidden = fn() -> i32 { 42 };
    };
    let app: Module = module {
        let math: Module = require(math);
        @export
        let main = fn() -> i32 { math.hidden() };
    };";
    if validate(artifact, private_access) != 4202 { return 3703; }
    if compile_is_empty(artifact, private_access) != 1 { return 3704; }

    let duplicate: addr = "let same: Module = module {
        @export
        let a = fn() -> i32 { 1 };
    };
    let same: Module = module {
        @export
        let b = fn() -> i32 { 2 };
    };";
    if validate(artifact, duplicate) != 4002 { return 3705; }

    let cycle: addr = "let a: Module = module {
        let b: Module = require(b);
        @export
        let fa = fn() -> i32 { 1 };
    };
    let b: Module = module {
        let a: Module = require(a);
        @export
        let fb = fn() -> i32 { 2 };
    };";
    if validate(artifact, cycle) != 4103 { return 3706; }
    return 42;
}
