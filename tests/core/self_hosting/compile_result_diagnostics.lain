@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.string-equal!")
fn string_equal(left: addr, right: addr) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn artifact_i32(
    artifact: addr, entry: addr, source: addr, length: i32) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn artifact_addr(
    artifact: addr, entry: addr, source: addr, length: i32) -> addr;

fn main() -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let invalid: addr = "pub fn main() -> i32 { return missing(1); }";
    let length: i32 = string_length(invalid);
    let code: i32 = artifact_i32(
        artifact, "mini_meta_validate", invalid, length);
    if code != 2301 { return 3501; }
    let procedure: addr = artifact_addr(
        artifact, "mini_meta_diagnostic_procedure", invalid, length);
    if string_equal(procedure, "main") != 1 { return 3502; }
    let generated: i32 = artifact_i32(
        artifact, "mini_meta_compile", invalid, length);
    if generated != 0 { return 3503; }
    if artifact_i32(
        artifact, "mini_meta_procedure_count", invalid, length) != 1 {
        return 3504;
    }

    // M9: the real compiler entry owns a structured result.  Failure is
    // atomic (no unit), carries one stable diagnostic, and preserves the
    // source extent used to create the syntax handle.
    if artifact_i32(
        artifact, "mini_meta_compile_result_ok", invalid, length) != 0 {
        return 3505;
    }
    if artifact_i32(
        artifact, "mini_meta_compile_result_diagnostic_count",
        invalid, length) != 1 { return 3506; }
    if artifact_i32(
        artifact, "mini_meta_compile_result_diagnostic_code",
        invalid, length) != 2301 { return 3507; }
    let message: addr = artifact_addr(
        artifact, "mini_meta_compile_result_diagnostic_message",
        invalid, length);
    if string_equal(message, "unknown procedure") != 1 { return 3508; }
    if artifact_i32(
        artifact, "mini_meta_compile_result_diagnostic_start",
        invalid, length) != 0 { return 3509; }
    if artifact_i32(
        artifact, "mini_meta_compile_result_diagnostic_end",
        invalid, length) != length { return 3510; }

    let valid: addr = "pub fn main() -> i32 { return 42; }";
    let valid_length: i32 = string_length(valid);
    if artifact_i32(
        artifact, "mini_meta_compile_result_ok",
        valid, valid_length) != 1 { return 3511; }
    if artifact_i32(
        artifact, "mini_meta_compile_result_module_count",
        valid, valid_length) != 1 { return 3512; }
    return 42;
}
