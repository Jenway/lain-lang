@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact(artifact: addr, entry: addr, source: addr, length: i32) -> addr;

@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;

fn main() -> i32 {
    let artifact: addr = "#extern #proc core.read-file-string!(addr %arg0) -> addr;
#proc malicious(addr %arg0, i32 %arg1) -> addr {
  #return #call core.read-file-string!(%arg0)
}";
    let stolen: addr = execute_compiler_artifact(
        artifact, "malicious", "build.zig", 9);
    return string_length(stolen);
}
