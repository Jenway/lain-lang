@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.string-append!")
fn string_append(left: addr, right: addr) -> addr;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn artifact_i32(
    artifact: addr, entry: addr, source: addr, length: i32) -> i32;
@foreign(c, link_name = "core.execute-lainir-unit!")
fn execute_l1_unit(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "core.destroy-lainir-unit!")
fn destroy_l1_unit(unit: i32) -> i32;
@foreign(c, link_name = "l1.result-status!")
fn result_status(result: i32) -> i32;
@foreign(c, link_name = "l1.result-value!")
fn result_value(result: i32) -> i32;
@foreign(c, link_name = "l1.result-destroy!")
fn result_destroy(result: i32) -> i32;

fn check_generation(path: addr, base: i32) -> i32 {
    let artifact: addr = read_file_string(path);

    let simple: addr = "pub fn helper(a: i32) -> i32 { return a + 1; }
pub fn main() -> i32 { return helper(41); }";
    let unit: i32 = artifact_i32(
        artifact, "mini_meta_compile", simple, string_length(simple));
    if unit == 0 { return base + 1; }
    if execute_l1_unit(unit, "main") != 42 { return base + 2; }
    if destroy_l1_unit(unit) != 1 { return base + 3; }

    let invalid: addr = "pub fn main() -> i32 { return missing(1); }";
    if artifact_i32(
        artifact, "mini_meta_validate", invalid,
        string_length(invalid)) != 2301 { return base + 4; }

    let math: addr = read_file_string(
        "tests/core/self_hosting/fixtures/math_module.lain");
    let app: addr = read_file_string(
        "tests/core/self_hosting/fixtures/app_module.lain");
    let workspace: addr = string_append(math, app);
    let workspace_unit: i32 = artifact_i32(
        artifact, "mini_meta_workspace_compile",
        workspace, string_length(workspace));
    if workspace_unit == 0 { return base + 5; }
    if execute_l1_unit(workspace_unit, "app__main") != 42 {
        return base + 6;
    }
    if destroy_l1_unit(workspace_unit) != 1 { return base + 7; }

    let comptime_source: addr =
        "let main = fn() -> i32 { 50 + 5 }";
    let comptime: i32 = artifact_i32(
        artifact, "mini_meta_comptime_main", comptime_source,
        string_length(comptime_source));
    if comptime == 0 { return base + 8; }
    if result_status(comptime) != 0 { return base + 9; }
    if result_value(comptime) != 55 { return base + 10; }
    if result_destroy(comptime) != 1 { return base + 11; }
    return 0;
}

fn main() -> i32 {
    let stage1: i32 = check_generation(
        "build/core-self-hosting/meta_compiler.l1", 13100);
    if stage1 != 0 { return stage1; }
    let stage2: i32 = check_generation(
        "build/core-self-hosting/stage2_compiler.l1", 13200);
    if stage2 != 0 { return stage2; }
    let stage3: i32 = check_generation(
        "build/core-self-hosting/stage3_compiler.l1", 13300);
    if stage3 != 0 { return stage3; }
    return 42;
}
