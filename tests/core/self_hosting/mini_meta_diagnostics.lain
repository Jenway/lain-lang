import packages::lain::compiler::mini_meta;

fn main() -> i32 {
    let unknown_name: addr = "let main = fn() -> i32 { let x = 40; y + 2 }";
    if mini_meta_validate(unknown_name, 44) != 2003 { return 1; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2003), "unknown name or invalid i32 literal") != 1 { return 11; }

    let duplicate_name: addr = "let main = fn() -> i32 { let x = 40; let x = 1; x + 1 }";
    if mini_meta_validate(duplicate_name, 55) != 2102 { return 2; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2102), "duplicate local binding") != 1 { return 12; }

    let unsupported_operator: addr = "let main = fn() -> i32 { let x = 40; x * 2 }";
    if mini_meta_validate(unsupported_operator, 44) != 2002 { return 3; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2002), "unsupported i32 operator") != 1 { return 13; }

    let missing_result: addr = "let main = fn() -> i32 { let x = 40; }";
    if mini_meta_validate(missing_result, 38) != 2103 { return 4; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2103), "procedure body has no result expression") != 1 { return 14; }

    return 42;
}
