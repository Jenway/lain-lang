let add = std::func(left: i32, right: i32) -> i32 {
    return left + right;
};

let main = std::func() -> i32 {
    let index: i32 = 0;
    let total: i32 = 0;
    while index < 2 {
        total = add(total, 21);
        index = index + 1;
    }
    if total == 42 {
        return total;
    } else {
        return 0;
    }
};
