import packages::lain::compiler::mini_meta;

fn main() -> i32 {
    let unknown_call: addr = "let main = fn() -> i32 { missing(1) }";
    if mini_meta_validate(unknown_call, 37) != 2301 { return 1; }

    let bad_arity: addr = "let add = fn(a: i32) -> i32 { a }
let main = fn() -> i32 { add(1, 2) }";
    if mini_meta_validate(bad_arity, 70) != 2303 { return 2; }

    let duplicate_param: addr = "let main = fn(a: i32, a: i32) -> i32 { a }";
    if mini_meta_validate(duplicate_param, 42) != 2110 { return 3; }

    let bad_condition: addr = "let main = fn() -> i32 { if 1 { 42 } else { 0 } }";
    if mini_meta_validate(bad_condition, 49) != 2401 { return 4; }

    let bad_branch: addr = "let main = fn() -> i32 { if 1 == 1 { 2 == 2 } else { 0 } }";
    if mini_meta_validate(bad_branch, 58) != 2402 { return 5; }

    let duplicate_function: addr = "let same = fn() -> i32 { 1 }
let same = fn() -> i32 { 2 }";
    if mini_meta_validate(duplicate_function, 57) != 2111 { return 6; }

    if mini_meta_text_equal(mini_meta_diagnostic_message(2301), "unknown procedure") != 1 { return 11; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2303), "procedure argument count mismatch") != 1 { return 12; }
    if mini_meta_text_equal(mini_meta_diagnostic_message(2401), "if condition must be bool") != 1 { return 13; }
    return 42;
}
