@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.string-append!")
fn string_append(left: addr, right: addr) -> addr;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact(
    artifact: addr, entry: addr, source: addr, length: i32) -> addr;
@foreign(c, link_name = "core.execute-compiler-artifact-named!")
fn execute_compiler_artifact_named(
    artifact: addr, source: addr, length: i32, name: addr) -> addr;
@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let syntax: addr = read_file_string(
        "packages/lain/compiler/mini_syntax.lain");
    let middle: addr = read_file_string(
        "packages/lain/compiler/mini_middle.lain");
    let types: addr = read_file_string(
        "packages/lain/compiler/mini_type.lain");
    let module_source: addr = read_file_string(
        "packages/lain/compiler/mini_module.lain");
    let elaborate: addr = read_file_string(
        "packages/lain/compiler/mini_elaborate.lain");
    let text_builder: addr = read_file_string(
        "packages/lain/compiler/l1_text_builder.lain");
    let lower: addr = read_file_string(
        "packages/lain/compiler/mini_lower.lain");
    let diagnostic: addr = read_file_string(
        "packages/lain/compiler/mini_diagnostic.lain");
    let compile_result: addr = read_file_string(
        "packages/lain/compiler/mini_compile_result.lain");
    let meta: addr = read_file_string(
        "packages/lain/compiler/mini_meta.lain");
    let source0: addr = string_append(syntax, middle);
    let source1: addr = string_append(source0, types);
    let source2: addr = string_append(source1, module_source);
    let source3: addr = string_append(source2, elaborate);
    let source4: addr = string_append(source3, text_builder);
    let source5: addr = string_append(source4, lower);
    let source6: addr = string_append(source5, diagnostic);
    let source7: addr = string_append(source6, compile_result);
    let source: addr = string_append(source7, meta);
    let l1: addr = execute_compiler_artifact_named(
        artifact, source, string_length(source), "mini_meta_schema_version");
    if execute_l1_text(l1, "mini_meta_schema_version") != 4 { return 3411; }
    return 42;
}
