// The imported Lain module owns L1Unit and the text emitter.  Interpreter
// mode must elaborate its implementation body into this same in-memory L1
// module; no BootstrapL1Unit mirror belongs in this entry source.
import packages::lain::compiler::l1_unit;

@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn main() -> i32 {
    execute_l1_text(l1_unit_return_42_text(), "main")
}
