// Lain-side contract for the topology-only ast.* capability boundary.
// It assigns no language meaning to `+`; it only verifies the reader's tree
// shape and source evidence for a later Lain elaborator.
@foreign(c, link_name = "ast.parse!")
let ast_parse = std::func(source: addr, length: i32) -> i32;

@foreign(c, link_name = "ast.node-count")
let ast_node_count = std::func() -> i32;

@foreign(c, link_name = "ast.node-kind")
let ast_node_kind = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-text")
let ast_node_text = std::func(node: i32) -> addr;

@foreign(c, link_name = "ast.node-line")
let ast_node_line = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-col")
let ast_node_col = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-left")
let ast_node_left = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-right")
let ast_node_right = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-op")
let ast_node_op = std::func(node: i32) -> i32;

@foreign(c, link_name = "ast.node-next")
let ast_node_next = std::func(node: i32) -> i32;

@foreign(c, link_name = "core.string-equal!")
let string_equal = std::func(left: addr, right: addr) -> i32;

let main = std::func() -> i32 {
    let root: i32 = ast_parse("40 + 2", 6);
    let expr: i32 = ast_node_left(root);
    let left: i32 = ast_node_left(expr);
    let right: i32 = ast_node_right(expr);
    let op: i32 = ast_node_op(expr);

    if ast_node_count() != 5 { return 1; }
    if ast_node_kind(root) != 4 { return 2; }
    if ast_node_kind(expr) != 1 { return 3; }
    if ast_node_kind(left) != 0 { return 4; }
    if ast_node_kind(right) != 0 { return 5; }
    if ast_node_kind(op) != 0 { return 6; }
    if string_equal(ast_node_text(left), "40") != 1 { return 7; }
    if string_equal(ast_node_text(right), "2") != 1 { return 8; }
    if string_equal(ast_node_text(op), "+") != 1 { return 9; }
    if ast_node_line(left) != 1 { return 10; }
    if ast_node_col(left) != 1 { return 11; }
    if ast_node_col(op) != 4 { return 12; }
    if ast_node_col(right) != 6 { return 13; }
    if ast_node_next(left) != 0 { return 14; }
    if ast_node_next(right) != 0 { return 15; }
    if ast_node_next(op) != 0 { return 16; }
    return 42;
}
