// Generated syntax is constructed in an open unit, then sealed into the same
// opaque stable-handle domain used by parsed syntax.
@foreign(c, link_name = "ast.store-new!")
let store_new = std::func() -> i32;
@foreign(c, link_name = "ast.store-destroy!")
let store_destroy = std::func(store: i32) -> i32;
@foreign(c, link_name = "ast.unit-parse!")
let unit_parse = std::func(store: i32, source: addr, length: i32) -> i32;
@foreign(c, link_name = "ast.unit-root")
let unit_root = std::func(store: i32, unit: i32) -> i32;
@foreign(c, link_name = "ast.unit-new-generated!")
let unit_new_generated = std::func(store: i32) -> i32;
@foreign(c, link_name = "ast.unit-atom!")
let unit_atom = std::func(
    store: i32, unit: i32, text: addr) -> i32;
@foreign(c, link_name = "ast.unit-node!")
let unit_node = std::func(
    store: i32, unit: i32, kind: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-left!")
let unit_set_left = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-right!")
let unit_set_right = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-op!")
let unit_set_op = std::func(
    store: i32, unit: i32, node: i32, value: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-origin!")
let unit_set_origin = std::func(
    store: i32, unit: i32, node: i32, source: i32) -> i32;
@foreign(c, link_name = "ast.unit-set-hygiene!")
let unit_set_hygiene = std::func(
    store: i32, unit: i32, node: i32, context: i32) -> i32;
@foreign(c, link_name = "ast.unit-append!")
let unit_append = std::func(
    store: i32, unit: i32, node: i32, next: i32) -> i32;
@foreign(c, link_name = "ast.unit-clone!")
let unit_clone = std::func(store: i32, unit: i32, source: i32) -> i32;
@foreign(c, link_name = "ast.unit-seal!")
let unit_seal = std::func(store: i32, unit: i32, root: i32) -> i32;
@foreign(c, link_name = "ast.node-kind")
let node_kind = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-left")
let node_left = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-right")
let node_right = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-op")
let node_op = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-text")
let node_text = std::func(node: i32) -> addr;
@foreign(c, link_name = "ast.node-origin")
let node_origin = std::func(node: i32) -> i32;
@foreign(c, link_name = "ast.node-hygiene")
let node_hygiene = std::func(node: i32) -> i32;
@foreign(c, link_name = "core.string-equal!")
let string_equal = std::func(left: addr, right: addr) -> i32;

let main = std::func() -> i32 {
    let store: i32 = store_new();
    if store == 0 { return 1; }
    let parsed: i32 = unit_parse(store, "captured", 8);
    if parsed == 0 { return 2; }
    let source: i32 = node_left(unit_root(store, parsed));

    let generated: i32 = unit_new_generated(store);
    if generated == 0 { return 3; }
    let captured: i32 = unit_clone(store, generated, source);
    let plus: i32 = unit_atom(store, generated, "+");
    let value: i32 = unit_atom(store, generated, "1");
    if unit_set_origin(store, generated, value, source) != 1 { return 5; }
    if unit_set_hygiene(store, generated, value, 77) != 1 { return 5; }
    let expression: i32 = unit_node(store, generated, 1);
    if unit_set_left(store, generated, expression, captured) != 1 { return 5; }
    if unit_set_right(store, generated, expression, value) != 1 { return 5; }
    if unit_set_op(store, generated, expression, plus) != 1 { return 5; }
    let root: i32 = unit_node(store, generated, 4);
    if unit_set_left(store, generated, root, expression) != 1 { return 6; }
    if captured == 0 { return 4; }
    if expression == 0 { return 5; }
    if root == 0 { return 6; }

    let stable: i32 = unit_seal(store, generated, root);
    if stable == 0 { return 7; }
    let stable_expression: i32 = node_left(stable);
    if node_kind(stable_expression) != 1 { return 8; }
    if string_equal(node_text(node_left(stable_expression)), "captured") != 1 {
        return 9;
    }
    if string_equal(node_text(node_op(stable_expression)), "+") != 1 {
        return 10;
    }
    if string_equal(node_text(node_right(stable_expression)), "1") != 1 {
        return 11;
    }
    if node_origin(node_left(stable_expression)) != source { return 12; }
    if node_hygiene(node_left(stable_expression)) != 0 { return 13; }
    if node_origin(node_right(stable_expression)) != source { return 14; }
    if node_hygiene(node_right(stable_expression)) != 77 { return 15; }

    // Sealed stores are immutable.
    if unit_atom(store, generated, "late") != 0 { return 16; }
    if unit_append(store, generated, expression, value) != 0 { return 17; }
    if store_destroy(store) != 1 { return 18; }
    if node_kind(stable) != -1 { return 19; }
    if node_origin(stable) != 0 { return 20; }
    return 42;
}
