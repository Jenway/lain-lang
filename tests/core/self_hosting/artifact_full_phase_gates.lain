@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact(
    artifact: addr, entry: addr, source: addr, length: i32) -> i32;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn execute_compiler_artifact_text(
    artifact: addr, entry: addr, source: addr, length: i32) -> addr;
@foreign(c, link_name = "core.execute-compiler-artifact-named!")
fn execute_compiler_artifact_named(
    artifact: addr, source: addr, length: i32, name: addr) -> i32;
@foreign(c, link_name = "core.execute-lainir-unit!")
fn execute_l1_unit(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "core.destroy-lainir-unit!")
fn destroy_l1_unit(unit: i32) -> i32;

fn run_gate(entry: addr) -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let source: addr = read_file_string(
        "build/core-self-hosting/compiler_source.lain");
    return execute_compiler_artifact(
        artifact, entry, source, string_length(source));
}

fn run_text_gate(entry: addr) -> addr {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let source: addr = read_file_string(
        "build/core-self-hosting/compiler_source.lain");
    return execute_compiler_artifact_text(
        artifact, entry, source, string_length(source));
}

fn parse() -> i32 { return run_gate("mini_meta_m13_parse_gate"); }
fn middle() -> i32 { return run_gate("mini_meta_m13_middle_gate"); }
fn elaborate() -> i32 {
    return run_gate("mini_meta_m13_elaborate_gate");
}
fn diagnostic() -> addr {
    return run_text_gate("mini_meta_m13_elaborate_failure_name");
}
fn diagnostic_line() -> i32 {
    return run_gate("mini_meta_m13_elaborate_failure_line");
}
fn diagnostic_statement_line() -> i32 {
    return run_gate("mini_meta_m13_elaborate_failure_statement_line");
}
fn diagnostic_statement_code() -> i32 {
    return run_gate("mini_meta_m13_elaborate_failure_statement_code");
}
fn lower() -> i32 { return run_gate("mini_meta_m13_lower_gate"); }
fn lower_failure_line() -> i32 {
    return run_gate("mini_meta_m13_lower_failure_line");
}
fn lower_failure_code() -> i32 {
    return run_gate("mini_meta_m13_lower_failure_code");
}
fn lower_failure_message() -> addr {
    return run_text_gate("mini_meta_m13_lower_failure_message");
}
fn named_schema() -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let source: addr = read_file_string(
        "build/core-self-hosting/compiler_source.lain");
    let unit: i32 = execute_compiler_artifact_named(
        artifact, source, string_length(source), "mini_meta_schema_version");
    if unit == 0 { return 1; }
    let result: i32 = execute_l1_unit(unit, "mini_meta_schema_version");
    if destroy_l1_unit(unit) != 1 { return 2; }
    return result;
}
