// This is the early direct-emitter bootstrap slice.  The imported L1Unit path
// and the Lain-owned mini-meta path are covered by separate fixtures.
struct BootstrapL1Unit {
    kind: i32,
    left: i32,
    right: i32,
}

@foreign(c, link_name = "core.string-append!")
fn string_append(left: addr, right: addr) -> addr;

@foreign(c, link_name = "core.i32-to-string!")
fn i32_to_string(value: i32) -> addr;

@foreign(c, link_name = "core.string-to-i32!")
fn string_to_i32(text: addr) -> i32;

// These are topology-only reader capabilities. The Lain component decides
// which shapes it accepts and gives the resulting value language meaning.
@foreign(c, link_name = "ast.parse!")
fn ast_parse(source: addr, length: i32) -> i32;

@foreign(c, link_name = "ast.node-kind")
fn ast_node_kind(node: i32) -> i32;

@foreign(c, link_name = "ast.node-left")
fn ast_node_left(node: i32) -> i32;

@foreign(c, link_name = "ast.node-right")
fn ast_node_right(node: i32) -> i32;

@foreign(c, link_name = "ast.node-text")
fn ast_node_text(node: i32) -> addr;

// The host owns only parse/verify/execute; it does not expose a C IR builder.
@foreign(c, link_name = "core.execute-lainir-text!")
fn execute_l1_text(text: addr, entry: addr) -> i32;

fn emit_add_text(unit: BootstrapL1Unit) -> addr {
    let prefix: addr = "#proc main() -> i32 { #return #add(";
    let comma: addr = ", ";
    let suffix: addr = ") }";
    string_append(string_append(string_append(string_append(prefix, i32_to_string(unit.left)), comma), i32_to_string(unit.right)), suffix)
}

fn parse_add_expr(source: addr, length: i32) -> i32 {
    let root: i32 = ast_parse(source, length);
    let expr: i32 = ast_node_left(root);
    if ast_node_kind(expr) != 1 { return 0; }
    return expr;
}

fn lower_add_left(expr: i32) -> i32 {
    let left: i32 = ast_node_left(expr);
    if ast_node_kind(left) != 0 { return 0; }
    return string_to_i32(ast_node_text(left));
}

fn lower_add_right(expr: i32) -> i32 {
    let right: i32 = ast_node_right(expr);
    if ast_node_kind(right) != 0 { return 0; }
    return string_to_i32(ast_node_text(right));
}

fn main() -> i32 {
    let target: addr = "40 + 2";
    let expr: i32 = parse_add_expr(target, 6);
    // The current interpreter's #alloca is frame-local.  Keep this L1Unit in
    // main rather than returning its address from a helper.
    let unit: BootstrapL1Unit = BootstrapL1Unit {
        kind: 2,
        left: lower_add_left(expr),
        right: lower_add_right(expr),
    };
    execute_l1_text(emit_add_text(unit), "main")
}
