@foreign(c, link_name = "core.read-file-string!")
fn read_file_string(path: addr) -> addr;
@foreign(c, link_name = "core.string-length!")
fn string_length(text: addr) -> i32;
@foreign(c, link_name = "core.string-append!")
fn string_append(left: addr, right: addr) -> addr;
@foreign(c, link_name = "core.execute-compiler-artifact!")
fn artifact_i32(
    artifact: addr, entry: addr, source: addr, length: i32) -> i32;
@foreign(c, link_name = "core.execute-lainir-unit!")
fn execute_l1_unit(unit: i32, entry: addr) -> i32;
@foreign(c, link_name = "core.destroy-lainir-unit!")
fn destroy_l1_unit(unit: i32) -> i32;
@foreign(c, link_name = "core.lainir-unit-debug-text!")
fn debug_l1_unit(unit: i32) -> addr;

fn main() -> i32 {
    let artifact: addr = read_file_string(
        "build/core-self-hosting/meta_compiler.l1");
    let math: addr = read_file_string(
        "tests/core/self_hosting/fixtures/math_module.lain");
    let app: addr = read_file_string(
        "tests/core/self_hosting/fixtures/app_module.lain");
    let workspace: addr = string_append(math, app);
    let length: i32 = string_length(workspace);
    let code: i32 = artifact_i32(
        artifact, "mini_meta_workspace_validate", workspace, length);
    if code != 0 { return code; }
    if artifact_i32(
        artifact, "mini_meta_workspace_module_count", workspace, length) != 2 {
        return 3601;
    }
    if artifact_i32(
        artifact, "mini_meta_workspace_dependency_count", workspace, length) != 1 {
        return 3602;
    }
    let unit: i32 = artifact_i32(
        artifact, "mini_meta_workspace_compile", workspace, length);
    if unit == 0 { return 3603; }
    if string_length(debug_l1_unit(unit)) == 0 { return 3604; }
    if execute_l1_unit(unit, "app__main") != 42 { return 3605; }
    if destroy_l1_unit(unit) != 1 { return 3606; }
    return 42;
}
