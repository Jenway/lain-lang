let Option = std::enum(T: type) {
    None,
    Some(T),
};

let unwrap_or = std::func(
    option: Option(i32),
    fallback: i32
) -> i32 {
    return match option {
        Option(i32).Some(value) => value + fallback,
        Option(i32).None => fallback,
    };
};

let main = std::func() -> i32 {
    let value: Option(i32) = Option(i32).Some(42);
    return unwrap_or(value, 0);
};
