let Option = std::enum(T: type) {
    None,
    Some(T),
};

let unwrap_or = std::func(
    option: Option(i32),
    fallback: i32
) -> i32 {
    let result: i32 = match option {
        Option(i32).Some(value) => value + 1,
        _ => fallback,
    };
    return result;
};

let main = std::func() -> i32 {
    let some: Option(i32) = Option(i32).Some(39);
    let none: Option(i32) = Option(i32).None;
    return unwrap_or(some, 0) + unwrap_or(none, 2);
};
