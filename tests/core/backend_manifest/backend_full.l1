#extern #proc user_hook(#bits<64> %value) -> #bits<64>;
#proc helper(#bits<64> %value) -> #bits<64> {
  #return #add(%value, 1)
}
#proc main() -> #bits<32> {
  #let %small: #bits<32> = 7
  #let %value: #bits<64> = #call helper(41)
  #if #eq(%value, 42) {
    #return #call user_hook(42)
  }
  #return 0
}
