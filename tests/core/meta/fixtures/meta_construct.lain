let replace_attribute = std::meta(
    std::func(context: MetaContext, invocation: MetaInvocation) -> SyntaxList {
        return syntax_list_two(
            syntax_infix(
                " ",
                syntax_atom("let"),
                syntax_infix(
                    "=",
                    syntax_infix(
                        ":",
                        syntax_atom("GeneratedN"),
                        syntax_postfix(
                            syntax_atom("Comptime"),
                            syntax_group("(", syntax_atom("i32"))
                        )
                    ),
                    syntax_atom("73")
                )
            ),
            syntax_clone(invocation.target_syntax)
        );
    }
);

@replace_attribute
let ignored = std::func() -> i32 {
    return 1;
};
