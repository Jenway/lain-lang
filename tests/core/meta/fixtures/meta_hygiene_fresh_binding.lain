let fresh_binding_attribute = std::meta(
    std::func(context: MetaContext, invocation: MetaInvocation) -> SyntaxList {
        return syntax_list_one(
            syntax_infix(
                " ",
                syntax_infix(
                    " ",
                    syntax_atom("let"),
                    syntax_infix(
                        "->",
                        syntax_infix(
                            "=",
                            syntax_atom("main"),
                            syntax_infix(
                                "::",
                                syntax_atom("std"),
                                syntax_postfix(
                                    syntax_atom("func"),
                                    syntax_group(
                                        "(",
                                        syntax_infix(
                                            ":",
                                            syntax_atom("x"),
                                            syntax_atom("i32")
                                        )
                                    )
                                )
                            )
                        ),
                        syntax_atom("i32")
                    )
                ),
                syntax_group(
                    "{",
                    syntax_infix(
                        " ",
                        syntax_atom("return"),
                        syntax_atom("x")
                    )
                )
            )
        );
    }
);

@fresh_binding_attribute
let ignored: Comptime(i32) = 1;
