let second_attribute = std::meta(
    std::func(context: MetaContext, invocation: MetaInvocation) -> SyntaxList {
        return syntax_list_one(syntax_clone(invocation.target_syntax));
    }
);

let first_attribute = std::meta(
    std::func(context: MetaContext, invocation: MetaInvocation) -> SyntaxList {
        return syntax_list_two(
            syntax_infix(
                " ",
                syntax_atom("@"),
                syntax_atom("second_attribute")
            ),
            syntax_clone(invocation.target_syntax)
        );
    }
);

@first_attribute
let main = std::func() -> i32 {
    return 42;
};
