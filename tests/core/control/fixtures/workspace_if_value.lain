let app: Module = std::module {
    @export
    let main = std::func() -> i32 {
        let selected: i32 = if 1 == 1 {
            40
        } else {
            0
        };
        let value: i32 = selected;
        loop {
            value = value + 1;
            if value == 42 {
                break;
            }
            continue;
        }
        return value;
    };
};
