// tests/fixtures/check-pass/interface_impl.lain
// 验证: interface 生成 VTable struct, impl 生成 VTable 工厂函数

// 方法实现 (独立 fn, 命名约定 TargetName_MethodName)
fn Dog_speak(self: addr) -> i32 {
    42
}

// Interface 声明 → 生成 Animal_VTable { speak: addr }
interface Animal {
    fn speak(self: addr) -> i32;
}

// Impl Animal for Dog → 生成 Animal_VTable_for_Dog() 工厂函数
impl Animal for Dog {
    fn speak(self: addr) -> i32 { 42 }
}

fn main() -> i32 {
    let vtable: addr = Animal_VTable_for_Dog();
    0
}
