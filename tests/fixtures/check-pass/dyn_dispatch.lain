// tests/fixtures/check-pass/dyn_dispatch.lain
// 验证: 动态分发 — Dyn 胖指针 → vtable 查找 → indirect call

// Interface 声明 → 生成 Animal_VTable struct + Animal_Dyn 胖指针 struct
interface Animal {
    fn speak(self: addr) -> i32;
}

// 具体方法实现 (命名约定 TargetName_MethodName)
fn Dog_speak(data: addr) -> i32 {
    42
}

// Impl Animal for Dog → 生成 Animal_VTable_for_Dog() 工厂函数
impl Animal for Dog {
    fn speak(self: addr) -> i32 { 42 }
}

// 【核心测试】接收 Dyn 胖指针参数并动态分发调用方法
fn test_dispatch(animal: Animal_Dyn) -> i32 {
    animal.speak()
}

fn main() -> i32 {
    0
}
