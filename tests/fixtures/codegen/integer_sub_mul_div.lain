// CHECK: #primitive integer.sub(%arg0, %arg1)
// CHECK: #primitive integer.mul(%arg0, %arg1)
// CHECK: #primitive integer.div(%arg0, %arg1)

fn sub(left: i32, right: i32) -> i32 {
    left - right
}

fn mul(left: i32, right: i32) -> i32 {
    left * right
}

fn div(left: i32, right: i32) -> i32 {
    left / right
}
