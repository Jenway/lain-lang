// Phase 4: Spawn effect handle — handler takes task_fn arg.
// Spawn layout: {flag: u8, task_fn: addr}, flag-index=0, arg-indices=(1)
// CHECK: sub @on_spawn
// CHECK: sub @do_spawn
// CHECK: sub @main
// CHECK: cond_br
// CHECK: call @on_spawn(field[

fn on_spawn(task: addr) -> i32 {
    return 0;
}

fn do_spawn() -> i32 ! {Spawn} {
    perform Spawn::spawn(ptr::null())
}

fn main() -> i32 {
    handle Spawn with on_spawn {
        do_spawn()
    }
}
