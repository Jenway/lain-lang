// CHECK: sub @div(i32 %arg0, i32 %arg1) -> addr
// CHECK: if primitive integer.eq
// CHECK: store 1,
// CHECK: store 0,
// CHECK: store 1,
// CHECK: } else {
// CHECK: }
// FIXME: else branch lowers empty — division result is dropped

fn div(a: i32, b: i32) -> i32 ! {Throws<i32>} {
    if b == 0 {
        perform Throws::throw(1)
    } else {
        a / b
    };
}

// CHECK: sub @default(i32 %arg0) -> i32
// CHECK: return 0

fn default(e: i32) -> i32 { 0 }

// CHECK: sub @main() -> i32
// CHECK: call @div
// CHECK: cond_br primitive integer.eq(field[0]
// CHECK: block_1:
// CHECK: return field[4]
// CHECK: block_2:
// CHECK: return call @default(field[8]

fn main() -> i32 {
    handle Throws<i32> with default {
        div(10, 2)
    }
}
