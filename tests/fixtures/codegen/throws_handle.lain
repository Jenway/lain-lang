// CHECK: define <{ i8, [3 x i8], i32, i32 }> @div
// CHECK: icmp eq
// CHECK: sdiv
// CHECK: ret <{ i8, [3 x i8], i32, i32 }>

fn div(a: i32, b: i32) -> i32 ! {Throws<i32>} {
    if b == 0 {
        perform Throws::throw(1)
    } else {
        a / b
    }
}

// CHECK: define i32 @default
fn default(e: i32) -> i32 { 0 }

// CHECK: define i32 @main
// CHECK: call <{ i8, [3 x i8], i32, i32 }> @div
// CHECK: icmp eq i8
// CHECK: extractvalue {{.*}} 2
// CHECK: extractvalue {{.*}} 3
// CHECK: call i32 @default
// CHECK: ret i32

fn main() -> i32 {
    handle Throws<i32> with default {
        div(10, 2)
    }
}
