// test: aggregate init + write to malloc'd memory
@foreign(c, link_name = "malloc")
fn malloc(size: usize) -> opaque;

struct Node {
    value: i32,
    next: opaque,
}

pub fn make_node(v: i32, next: opaque) -> opaque {
    let raw = malloc(8);
    let new_node: Node = Node { value: v, next: next };
    raw
}
