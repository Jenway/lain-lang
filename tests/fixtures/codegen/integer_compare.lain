// CHECK: #primitive integer.eq(%arg0, %arg1)
// CHECK: #primitive integer.ne(%arg0, %arg1)
// CHECK: #primitive integer.lt(%arg0, %arg1)
// CHECK: #primitive integer.le(%arg0, %arg1)
// CHECK: #primitive integer.gt(%arg0, %arg1)
// CHECK: #primitive integer.ge(%arg0, %arg1)

fn eq(left: i32, right: i32) -> bool {
    left == right
}

fn not_eq(left: i32, right: i32) -> bool {
    left != right
}

fn less(left: i32, right: i32) -> bool {
    left < right
}

fn less_eq(left: i32, right: i32) -> bool {
    left <= right
}

fn greater(left: i32, right: i32) -> bool {
    left > right
}

fn greater_eq(left: i32, right: i32) -> bool {
    left >= right
}
