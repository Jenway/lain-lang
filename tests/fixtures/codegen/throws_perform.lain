// CHECK: sub @div(i32 %arg0, i32 %arg1) -> {product}
// CHECK: if primitive integer.eq
// CHECK: alloca(9)
// CHECK: store 1,
// CHECK: store 0,
// CHECK: store 1,
// CHECK: } else {
// CHECK: store 0,
// CHECK: store primitive integer.div
// CHECK: store 0,
