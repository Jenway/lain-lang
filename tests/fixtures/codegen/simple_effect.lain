// CHECK: @__lain_handler_stack = global ptr null

// handler function
// CHECK: define i32 @handler
// CHECK: ret i32 99

// do_it: loads handler stack, walks linked list, calls handler
// CHECK: define i32 @do_it
// CHECK: load ptr, ptr @__lain_handler_stack
// CHECK: load <{ ptr, i64, ptr, ptr }>
// CHECK: extractvalue <{ ptr, i64, ptr, ptr }>
// CHECK: call i32

// main: pushes handler entry, calls body, pops entry
// CHECK: define i32 @main
// CHECK: insertvalue <{ ptr, i64, ptr, ptr }>
// CHECK: store <{ ptr, i64, ptr, ptr }>
// CHECK: call i32 @do_it()

effect EmptySig {}

fn handler(ptr: &u8) -> i32 {
    return 99;
}

fn do_it() -> i32 ! {EmptySig} {
    perform EmptySig::signal()
}

fn main() -> i32 {
    handle EmptySig with handler {
        do_it()
    }
}
