// Phase 4: non-Throws effect handle lowering — layout-driven.
// EmptySig has default layout {flag: u8, value: i32}.
// do_it() returns i32 normally; flag=0 path extracts value.
// CHECK: sub @handler
// CHECK: sub @do_it
// CHECK: sub @main
// CHECK: call @do_it()
// CHECK: cond_br
// CHECK: call @handler()

effect EmptySig {}

fn handler() -> i32 {
    return 99;
}

fn do_it() -> i32 ! {EmptySig} {
    42
}

fn main() -> i32 {
    handle EmptySig with handler {
        do_it()
    }
}
