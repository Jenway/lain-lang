// TODO: custom effects (non-Throws) not yet supported
// CHECK: sub @handler
// CHECK: sub @main

effect EmptySig {}

fn handler(ptr: &u8) -> i32 {
    return 99;
}

fn do_it() -> i32 ! {EmptySig} {
    perform EmptySig::signal()
}

fn main() -> i32 {
    handle EmptySig with handler {
        do_it()
    }
}
