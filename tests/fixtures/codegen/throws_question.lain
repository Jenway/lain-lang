// CHECK: sub @inner() -> {product}
// CHECK: alloca(9)
// CHECK: store 0,
// CHECK: store 42,
// CHECK: store 0,
// CHECK: return %__agg

fn inner() -> i32 ! {Throws<i32>} {
    42
}

// CHECK: sub @outer() -> {product}
// CHECK: call @inner()
// CHECK: cond_br primitive integer.eq(field[0](call @inner()), 0), block_1, block_2
// CHECK: block_1:
// CHECK: primitive integer.add(field[1](call @inner()), 1)
// CHECK: return %__agg
// CHECK: block_2:
// CHECK: return call @inner()

fn outer() -> i32 ! {Throws<i32>} {
    let x = inner()?;
    x + 1
}
