// CHECK: sub @inner() -> addr
// CHECK: return 42

fn inner() -> i32 ! {Throws<i32>} {
    42
}

// CHECK: sub @outer() -> addr
// CHECK: call @inner()
// CHECK: cond_br primitive integer.eq(field[0](call @inner()), 0)
// CHECK: primitive integer.add(field[4](call @inner()), 1)
// CHECK: return call @inner()

fn outer() -> i32 ! {Throws<i32>} {
    let x = inner()?;
    x + 1
}
