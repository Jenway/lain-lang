// CHECK: define <{ i8, [3 x i8], i32, i32 }> @inner
// CHECK: ret <{ i8, [3 x i8], i32, i32 }> <{ i8 0, [3 x i8] undef, i32 42, i32 0 }>

fn inner() -> i32 ! {Throws<i32>} {
    42
}

// CHECK: define <{ i8, [3 x i8], i32, i32 }> @outer
// CHECK: call <{ i8, [3 x i8], i32, i32 }> @inner
// CHECK: icmp eq i8
// CHECK: extractvalue {{.*}} 2
// CHECK: extractvalue {{.*}} 3
// CHECK: i32 1

fn outer() -> i32 ! {Throws<i32>} {
    let x = inner()?;
    x + 1
}
