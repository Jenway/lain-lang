// CHECK: #proc inner() -> addr
// CHECK: #return 42
// CHECK: #proc outer() -> addr
// CHECK: #call inner()
// CHECK: #if #primitive integer.eq(#field[0](#call inner()), 0) {
// CHECK: %_t0 = #field[4](#call inner())
// CHECK: #return #primitive integer.add(%_t0, 1)
// CHECK: } else {
// CHECK: #return #call inner()

fn inner() -> i32 ! {Throws<i32>} {
    42
}

fn outer() -> i32 ! {Throws<i32>} {
    let x = inner()?;
    x + 1
}
