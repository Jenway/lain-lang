// CHECK: sub @inner() -> addr
// CHECK: return 42
// CHECK: sub @outer() -> addr
// CHECK: call @inner()
// CHECK: cond_br primitive integer.eq(field[0](call @inner()), 0), block_2, block_3
// CHECK: block_2:
// CHECK: %_t0 = field[4](call @inner())
// CHECK: return primitive integer.add(%_t0, 1)
// CHECK: block_3:
// CHECK: return call @inner()

fn inner() -> i32 ! {Throws<i32>} {
    42
}

fn outer() -> i32 ! {Throws<i32>} {
    let x = inner()?;
    x + 1
}
