// CHECK: %_t0 = primitive integer.add(%arg0, %arg1)
// CHECK: return primitive integer.mul(%_t0, %arg1)
// CHECK: %_t1 = primitive integer.sub(0, %arg0)
// CHECK: return primitive integer.gt(%_t1, %arg1)

fn local_math(left: i32, right: i32) -> i32 {
    let sum: i32 = left + right;
    sum * right
}

fn local_compare(left: i32, right: i32) -> bool {
    let negated: i32 = -left;
    negated > right
}
