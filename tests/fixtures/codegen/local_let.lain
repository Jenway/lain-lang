// CHECK: primitive integer.mul(primitive integer.add(%arg0, %arg1), %arg1)
// CHECK: primitive integer.gt(primitive integer.sub(0, %arg0), %arg1)

fn local_math(left: i32, right: i32) -> i32 {
    let sum: i32 = left + right;
    sum * right
}

fn local_compare(left: i32, right: i32) -> bool {
    let negated: i32 = -left;
    negated > right
}
