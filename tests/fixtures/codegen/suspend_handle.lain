// Phase 4: Suspend effect handle — handler takes the waker arg.
// Suspend layout: {flag: u8, waker: addr}, flag-index=0, arg-indices=(1)
// On flag==0: no value fields → return void
// On flag!=0: extract waker at field[8] → call handler(waker)
// CHECK: #proc on_suspend
// CHECK: #proc do_suspend
// CHECK: #proc main
// CHECK: #cond_br
// CHECK: #call on_suspend(#field[

fn on_suspend(waker: addr) -> i32 {
    return 99;
}

fn do_suspend() -> i32 ! {Suspend} {
    perform Suspend::suspend(ptr::null())
}

fn main() -> i32 {
    handle Suspend with on_suspend {
        do_suspend()
    }
}
