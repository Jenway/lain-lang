let main = std::func() -> i32 {
    let valid: i32 = backend.validate_target(
        backend.LainIR, 64, 8, backend.Lain
    );
    let bad_target: i32 = backend.validate_target(
        99, 64, 8, backend.Lain
    );
    let unresolved: i32 = backend.validate_extern(false, 7);
    let native_cap: usize = backend.capability_required(backend.Native);
    if valid != 0 { return 0; }
    if bad_target != 4101 { return 0; }
    if unresolved != 4201 { return 0; }
    if native_cap != 30 { return 0; }
    return 42;
};
