let make = std::func(m: i32) -> Module {
    let is_op = std::func(byte: i32) -> bool {
        return byte == 43 || byte == 45 || byte == 42 || byte == 47 || byte == 96;
    };
    let scan = std::func() -> i32 {
        let cursor: usize = 0;
        let length: usize = 10;
        while cursor < length {
            let current: i32 = 43;
            if is_op(current) {
                break;
            }
            cursor = cursor + 1;
        }
        return 42;
    };
    let process = std::func() -> i32 {
        return scan();
    };
    return std::module {
        process: process,
    };
};
