let Span: type = std::struct {
    start: i32,
    end: i32,
};

let Token: type = std::struct {
    kind: i32,
    span: Span,
};

let consume = std::func(value: Token) -> i32 {
    return value.kind + value.span.start;
};

let main = std::func() -> i32 {
    return consume(Token {
        kind: 1,
        span: Span { start: 40, end: 1 },
    });
};
