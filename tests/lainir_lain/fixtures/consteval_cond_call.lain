let identity = std::consteval(x: usize) -> usize {
    return x;
};
let classify = std::consteval(n: usize) -> usize {
    if identity(n) == 0 {
        return 1;
    } else {
        return 2;
    }
};
let a = classify(5);
let b = classify(0);
let answer = a * 10 + b;
let main = std::func() -> i32 {
    return answer;
};
