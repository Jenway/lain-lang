let bounds: Module = import("std::bounds");

let main = std::func() -> i32 {
    if bounds.checked_result(2, 3) != 0 { return 1; }
    if bounds.checked_result(3, 3) != 1 { return 2; }
    if bounds.verified_result(2, 3, true) == false { return 3; }
    if bounds.verified_result(3, 3, true) { return 4; }
    if bounds.verified_result(2, 3, false) { return 5; }
    if bounds.unchecked_trust() == false { return 6; }
    return 42;
};
