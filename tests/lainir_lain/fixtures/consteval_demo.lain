// 真实可运行的编译期求值例子
// 编译期常量：嵌套算术 + 局部绑定 + 跨函数调用 + 条件分支

let is_whitespace = std::consteval(byte: i32) -> i32 {
    if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
        return 1;
    }
    return 0;
};

let token_kind = std::consteval(byte: i32) -> i32 {
    let ws: i32 = is_whitespace(byte);
    if ws == 1 {
        return 0;
    }
    if byte >= 48 && byte <= 57 {
        return 1;
    }
    if byte >= 65 && byte <= 122 {
        return 2;
    }
    return 3;
};

// 顶层常量：多个 consteval 调用的结果组合成复合表达式
let K_WS = token_kind(32);
let K_NUM = token_kind(53);
let K_ID = token_kind(97);
let K_OP = token_kind(43);

let answer = K_WS * 1000 + K_NUM * 100 + K_ID * 10 + K_OP;
let main = std::func() -> i32 {
    return answer;
};
