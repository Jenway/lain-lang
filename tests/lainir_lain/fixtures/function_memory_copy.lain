let Region: type = std::struct {
    data: addr,
    length: usize,
};

let copy_raw = std::func(
    destination: Region,
    source: Region,
    length: usize,
) -> unit {
    let index: usize = 0;
    while index < length {
        std::store_bits(
            8,
            destination.data + index,
            std::load_bits(8, source.data + index),
        );
        index = index + 1;
    }
};
