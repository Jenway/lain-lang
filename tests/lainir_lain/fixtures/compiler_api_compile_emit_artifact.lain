let memory_model: Module = import("std::memory_model");
let source: Module = import("std::core::source");
let slice: Module = import("std::core::slice");
let memory_core: Module = import("std::core::memory");
let arena: Module = import("std::core::arena_min");
let bounds: Module = import("std::bounds");
let entry: Module = import("packages::lain::compiler::lainc");

@foreign(c, link_name = "bootstrap.artifact-begin")
let artifact_begin = std::func() -> unit;
@foreign(c, link_name = "bootstrap.artifact-write-byte")
let artifact_write_byte = std::func(byte: i32) -> unit;
@foreign(c, link_name = "bootstrap.artifact-finish")
let artifact_finish = std::func() -> unit;

let memory: Module = memory_model.Model(
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);
let SourceBuffer: type = source.source.SourceBuffer(memory);
let SourceSlice: type = slice.slice.Slice(
    SourceBuffer,
    memory.Bounds,
);
let api: Module = entry.lainc.API(memory);

let main = std::func() -> i32 {
    let buffer: SourceBuffer = SourceBuffer {
        path: memory.String.new(),
        contents: memory_core.memory.byte_span(
            "let main = std::func() -> i32 { return 42; };",
            45,
        ),
    };
    let sources: SourceSlice = SourceSlice {
        data: &buffer,
        length: 1,
    };
    let request: api.CompileRequest = api.CompileRequest {
        sources: sources,
        root_module: memory.String.new(),
        options: api.CompileOptions {
            emit_text_l1: true,
            verify_l1: true,
        },
    };
    let result: api.CompileResult = api.compile(request);
    if result.status != 0 {
        return 1;
    }
    if result.artifact.length() == 0 {
        return 2;
    }

    // The public artifact is a vector of byte values.  Re-materialize that
    // value through the bootstrap output capability so the next seed process
    // can parse and verify exactly what the API returned.
    artifact_begin();
    let index: usize = 0;
    while index < result.artifact.length() {
        artifact_write_byte(*result.artifact.get(index));
        index = index + 1;
    }
    artifact_finish();
    return 0;
};
