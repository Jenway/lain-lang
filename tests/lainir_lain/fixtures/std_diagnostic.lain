let diagnostic: Module = import("std::diagnostic");

let main = std::func() -> i32 {
    if diagnostic.severity_error() != 1 { return 1; }
    if diagnostic.severity_warning() != 2 { return 2; }
    if diagnostic.severity_note() != 3 { return 3; }
    if diagnostic.severity_help() != 4 { return 4; }
    if diagnostic.span_width(10, 14) != 4 { return 5; }
    if diagnostic.span_width(14, 10) != 0 { return 6; }
    if diagnostic.classify(1001) != 1 { return 7; }
    if diagnostic.classify(2100) != 2 { return 8; }
    if diagnostic.classify(3100) != 3 { return 9; }
    if diagnostic.classify(4100) != 4 { return 10; }
    if diagnostic.aggregate_total(1, 1) != 2 { return 11; }
    return 42;
};
