let make = std::func(m: i32) -> Module {
    let grade = std::func(byte: i32) -> i32 {
        if byte == 40 {
            return 1;
        } else if byte == 91 {
            return 2;
        } else if byte == 123 {
            return 3;
        } else {
            let cursor: usize = 0;
            cursor = cursor + 1;
            return cursor;
        }
    };
    let process = std::func() -> i32 {
        return grade(40) + 41;
    };
    return std::module {
        process: process,
    };
};
