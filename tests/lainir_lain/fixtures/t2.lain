let make = std::func(m: i32) -> Module {
    let Span: type = std::struct { start: usize, end: usize };
    let is_space = std::func(byte: i32) -> bool {
        return byte == 32 || byte == 9 || byte == 10 || byte == 13;
    };
    let classify = std::func(byte: i32) -> i32 {
        if is_space(byte) {
            return 1;
        } else {
            return 2;
        }
    };
    let span_len = std::func(sp: Span) -> usize {
        let len: usize = sp.end;
        return len;
    };
    let process = std::func() -> i32 {
        let x: i32 = classify(37);
        return x + 40;
    };
    return std::module {
        process: process,
    };
};
