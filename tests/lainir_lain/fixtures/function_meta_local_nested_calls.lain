let Span = std::func(T: type, Bounds: Module) -> type {
    let Concrete: type = std::struct {
        data: addr,
        length: usize,
    };
    let Namespace: Module = std::module {
        let get = std::func(values: &Concrete, index: usize) -> &T {
            Bounds.check(index, values.length);
            if std::size_of(T) == 0 {
                return std::dangling_ref(T);
            } else {
                return std::ref_at(T, values.data + index * std::size_of(T));
            }
        };
    };
    return std::type_with_namespace(Concrete, Namespace);
};
