let allocation: Module = import("std::allocation");
let bounds: Module = import("std::bounds");
let vector: Module = import("std::core::vec");
let string: Module = import("std::core::string");
let arena: Module = import("std::core::arena_min");

let memory: Module = std::memory_model.Model(
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);

let Text: type = string.string.String(
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);

let make = std::func() -> Text {
    return Text.new();
};

let main = std::func() -> i32 {
    return 1;
};
