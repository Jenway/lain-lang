@compiler_intrinsic(size_of)
@export
let size_of = std::func<T>() -> usize;

@compiler_intrinsic(opaque_cast)
@export
let opaque_cast = std::func(ptr: opaque) -> opaque;

@compiler_intrinsic(usize_to_opaque)
@export
let usize_to_opaque = std::func(value: usize) -> opaque;

@compiler_intrinsic(cstr_from_opaque)
@export
let cstr_from_opaque = std::func(ptr: opaque) -> CStr;

@compiler_intrinsic(usize_to_i32)
@export
let usize_to_i32 = std::func(value: usize) -> i32;

@compiler_intrinsic(i32_to_usize)
@export
let i32_to_usize = std::func(value: i32) -> usize;
