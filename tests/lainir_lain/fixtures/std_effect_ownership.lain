let effect: Module = import("std::effect");
let ownership: Module = import("std::ownership");

let main = std::func() -> i32 {
    if effect.effect_allowed(0, 1) == false { return 1; }
    if effect.effect_allowed(2, 2) == false { return 2; }
    if effect.effect_allowed(1, 2) { return 3; }
    if effect.capability_id(1) != 10 { return 4; }
    if effect.capability_id(2) != 20 { return 5; }
    if effect.capability_id(3) != 30 { return 6; }
    if effect.propagated_effect(0, 2) != 2 { return 7; }
    if effect.propagated_effect(3, 2) != 3 { return 8; }
    if ownership.borrow_allowed(0) == false { return 9; }
    if ownership.move_allowed(1) { return 10; }
    if ownership.alias_allowed(2) { return 11; }
    if ownership.transition(0, 1) != 1 { return 12; }
    if ownership.transition(1, 2) != 4 { return 13; }
    if ownership.transition(3, 2) != 2 { return 14; }
    return 42;
};
