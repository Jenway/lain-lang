let make = std::func(m: i32) -> Module {
    let memory: Module = import("std::core::memory");
    let is_space = std::func(byte: i32) -> bool {
        return byte == 32 || byte == 9 || byte == 10 || byte == 13;
    };
    let is_ident_continue = std::func(byte: i32) -> bool {
        return byte >= 65;
    };
    let is_delimiter = std::func(byte: i32) -> bool {
        return byte == 40;
    };
    let is_punctuation = std::func(byte: i32) -> bool {
        return byte == 44;
    };
    let push = std::func(output: &mut i32, kind: i32, start: usize, end: usize) -> unit {
        return;
    };
    let scan = std::func(source: addr) -> i32 {
        let cursor: usize = 0;
        let length: usize = 10;
        let output: i32 = 0;
        if cursor == 1 {
            cursor = cursor + 2;
        } else if cursor == 2 {
            cursor = cursor + 3;
        } else {
            cursor = cursor + 1;
            while cursor < length {
                let current: i32 = memory.byte_at(source, cursor);
                if is_space(current) || is_ident_continue(current) || is_delimiter(current) || is_punctuation(current) || current == 34 {
                    break;
                }
                cursor = cursor + 1;
            }
            push(&mut output, 6, 0, cursor);
        }
        return 42;
    };
    let process = std::func() -> i32 {
        return scan(0);
    };
    return std::module {
        process: process,
    };
};
