let Span = std::func(T: type, Bounds: Module) -> type {
    let Concrete: type = std::struct {
        data: addr,
        length: usize,
    };
    let Namespace: Module = std::module {
        let empty = std::func() -> Concrete {
            return Concrete { data: 0 as addr, length: 0 };
        };
    };
    return std::type_with_namespace(Concrete, Namespace);
};
