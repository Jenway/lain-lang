let meta_package: Module = import("std::meta");
let meta: Module = meta_package.meta;

let main = std::func() -> i32 {
    let value: meta.ComptimeValue = meta.comptime_i32(1, 42);
    if value.valid == false { return 1; }
    if value.kind != 1 { return 2; }
    if value.i32_payload != 42 { return 3; }
    return 0;
};
