let left: Module = std::module {
    let add = std::func(left: i32, right: i32) -> i32 {
        return left + right;
    };
};

let right: Module = std::module {
    let add = std::func(left: i32, right: i32) -> i32 {
        return left - right;
    };
};

let main = std::func() -> i32 {
    return left.add(40, 2);
};
