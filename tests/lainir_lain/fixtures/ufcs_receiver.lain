let Point: type = std::struct {
    x: i32,
};

let Namespace: Module = std::module {
    let get = std::func(value: &Point) -> i32 {
        return value.x;
    };
};

let PointWithNamespace: type = std::type_with_namespace(Point, Namespace);

let read = std::func(value: &PointWithNamespace) -> i32 {
    return value.get();
};

let main = std::func() -> i32 {
    return 42;
};
