let make = std::func(m: i32) -> Module {
    let Point: type = std::struct { x: usize, y: usize };
    let mk = std::func() -> usize {
        let p: Point = 0;
        return p;
    };
    let process = std::func() -> i32 {
        return mk();
    };
    return std::module {
        process: process,
    };
};
