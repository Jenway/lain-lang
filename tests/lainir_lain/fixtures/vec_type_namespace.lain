let vector: Module = import("std::core::vec");
let bounds: Module = import("std::bounds");
let arena: Module = import("std::core::arena_min");
let V: type = vector.vec.Vec(
    i32,
    arena.arena_min.Policy,
    bounds.bounds.Unchecked,
);
let make = std::func() -> V {
    return V.new();
};
let main = std::func() -> i32 {
    return 1;
};
