let classify = std::consteval(byte: i32) -> i32 {
    if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
        return 1;
    } else if byte == 40 || byte == 91 || byte == 123 {
        return 2;
    } else if byte >= 48 && byte <= 57 {
        return 3;
    } else {
        return 4;
    }
};
let a = classify(32);
let b = classify(91);
let c = classify(53);
let d = classify(120);
let answer = a * 1000 + b * 100 + c * 10 + d;
let main = std::func() -> i32 {
    return answer;
};
