let type: Module = import("std::type");

let main = std::func() -> i32 {
    if type.strict_conversion(1, 1, false) == false { return 1; }
    if type.strict_conversion(3, 1, true) == false { return 2; }
    if type.strict_conversion(1, 2, true) { return 3; }
    if type.permissive_conversion(6, 1, true) == false { return 4; }
    if type.permissive_conversion(5, 1, true) { return 5; }
    if type.representation_compatible(1, 32, 1, 32) == false { return 6; }
    if type.representation_compatible(1, 32, 1, 64) { return 7; }
    if type.overload_rank(1, 1) != 0 { return 8; }
    if type.overload_rank(3, 1) != 1 { return 9; }
    if type.overload_ambiguous(1, 1) == false { return 10; }
    if type.overload_ambiguous(0, 1) { return 11; }
    return 42;
};
