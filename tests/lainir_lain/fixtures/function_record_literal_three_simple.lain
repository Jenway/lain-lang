let ByteSpan: type = std::struct {
    data: addr,
    length: usize,
};

let byte_span = std::func(data: addr, length: usize) -> ByteSpan {
    return ByteSpan { data: data, length: length };
};

let empty_byte_span = std::func() -> ByteSpan {
    return ByteSpan { data: 0 as addr, length: 0 };
};

let byte_at = std::func(span: ByteSpan, index: usize) -> i32 {
    return 1;
};
