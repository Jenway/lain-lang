let generic: Module = import("std::generic");

let main = std::func() -> i32 {
    if generic.valid_parameter_kind(1) == false { return 1; }
    if generic.valid_parameter_kind(4) == false { return 2; }
    if generic.valid_parameter_kind(5) { return 3; }
    if generic.default_type_argument(0) != 1 { return 4; }
    if generic.default_type_argument(2) != 2 { return 5; }
    if generic.shadowing_allowed(0, false) == false { return 6; }
    if generic.shadowing_allowed(1, false) { return 7; }
    if generic.shadowing_allowed(1, true) == false { return 8; }
    let i32_key: usize = generic.specialization_token(11, 1, 0, 1);
    let i64_key: usize = generic.specialization_token(11, 2, 0, 1);
    let unchecked_key: usize = generic.specialization_token(11, 1, 0, 3);
    if i32_key == i64_key { return 9; }
    if i32_key == unchecked_key { return 10; }
    if generic.same_specialization(i32_key, i32_key) == false { return 11; }
    if generic.same_specialization(i32_key, i64_key) { return 12; }
    let full_key: usize = generic.specialization_key_token(11, 1, 0, 1, 77, 2, 3);
    let same_full_key: usize = generic.specialization_key_token(11, 1, 0, 1, 77, 2, 3);
    let changed_target: usize = generic.specialization_key_token(11, 1, 0, 1, 77, 9, 3);
    if generic.same_specialization(full_key, same_full_key) == false { return 13; }
    if generic.same_specialization(full_key, changed_target) { return 14; }
    if generic.key_component_changed(2, 3) == false { return 15; }
    if generic.key_component_changed(2, 2) { return 16; }
    if generic.recursion_allowed(4, 4) == false { return 17; }
    if generic.recursion_allowed(3, 4) { return 18; }
    if generic.recursion_allowed(4, 0) { return 19; }
    return 42;
};
