# Generated build output
build/
target/

# Legacy paths: no script writes here any more, but they stay ignored so
# residue from older checkouts never shows up again in a fresh diff.
# New builds keep every generated artifact under build/ (scripts/README.md).
zig-out/
zig-cache/
.zig-cache/
seed/.zig-cache-*/
seed/zig-out-*/

# Native binaries and debug symbols
*.exe
*.pdb
*.o

# Generated interface files
*.lci

# Compiler build artifacts
output*.c
tmp_*.c
*.bak

# Scratch sources
.tmp_*.lain

# Python
__pycache__/

# Tool state
.spec-workflow/

# Generated artifacts are written under build/ only.
