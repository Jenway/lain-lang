let io = import("std::io");
let fs = import("std::fs");
let os = import("std::os");
let cli = import("std::cli");
let str = import("std::str");
use import("std::mem")::{ OomErr };
use import("std::collections")::{ Vec };
use import("driver::pipeline")::{ RunResult, run_vm, emit_c99_stdout };

let check_case = func(label: Slice(u8), src: Slice(u8), expected: u64) -> u64 {
  let r: RunResult = run_vm(src, "main");
  if r.ok and (r.value == expected) {
    io::print("[PASS] ");
    io::print(label);
    io::print(" => ");
    io::println_u64(r.value);
    return 0;
  }
  io::print("[FAIL] ");
  io::print(label);
  io::print(" ok=");
  io::print_u64(if r.ok { 1 } else { 0 });
  io::print(" stage=");
  io::print_u64(r.stage);
  io::print(" got=");
  io::print_u64(r.value);
  io::print(" expected=");
  io::println_u64(expected);
  return 1;
};

let check_fail_stage = func(label: Slice(u8), src: Slice(u8), exp_stage: u64) -> u64 {
  let r: RunResult = run_vm(src, "main");
  if (r.ok == false) and (r.stage == exp_stage) {
    io::print("[PASS] ");
    io::print(label);
    io::print(" => rejected at stage ");
    io::println_u64(r.stage);
    return 0;
  }
  io::print("[FAIL] ");
  io::print(label);
  io::print(" ok=");
  io::print_u64(if r.ok { 1 } else { 0 });
  io::print(" stage=");
  io::println_u64(r.stage);
  return 1;
};

let run_self_tests = func() -> i64 {
  io::println("=== Lain v2 Driver (frontend + kernel) ===");
  let fails: u64 = 0;

  let src_arith: Slice(u8) = "pub let main = func() -> u64 { return 2 + 3 * 4 + (10 - 4) / 2; };";
  fails = fails + check_case("arith_prec", src_arith, 17);

  let src_loop: Slice(u8) = "pub let main = func() -> u64 { let s: u64 = 0; let i: u64 = 1; while i <= 10 { s = s + i; i = i + 1; }; return s; };";
  fails = fails + check_case("while_sum_1_to_10", src_loop, 55);

  let src_call: Slice(u8) = "let add = func(a: u64, b: u64) -> u64 { return a + b; }; pub let main = func() -> u64 { return add(20, 22); };";
  fails = fails + check_case("fn_call", src_call, 42);

  let src_short: Slice(u8) = "pub let main = func() -> u64 { let x: u64 = 0; if (x != 0) and ((10 / x) == 1) { return 99; } return 7; };";
  fails = fails + check_case("short_circuit_and", src_short, 7);

  let src_comptime: Slice(u8) = "pub let main = func() -> u64 { if 1 + 1 == 2 { return 123; } else { return 456; } };";
  fails = fails + check_case("const_if_fold", src_comptime, 123);

  let src_const_fn: Slice(u8) = "let add = func(a: u64, b: u64) -> u64 { return a + b; }; let Answer: u64 = add(20, 22); pub let main = func() -> u64 { return Answer; };";
  fails = fails + check_case("amphibious_const_fn", src_const_fn, 42);

  let src_struct: Slice(u8) = "let Pt = struct { x: u64, y: u64 }; pub let main = func() -> u64 { let p: Pt = Pt { x: 11, y: 31 }; return p.x + p.y; };";
  fails = fails + check_case("struct_fields", src_struct, 42);

  let src_enum: Slice(u8) = "let Val = enum { Empty Num(u64) }; pub let main = func() -> u64 { let v: Val = Val::Num(40); return match v { Num(x) => x + 2, Empty => 0 }; };";
  fails = fails + check_case("enum_match", src_enum, 42);

  let src_ptr: Slice(u8) = "let SliceU8 = struct { ptr: Ref(u8), len: u64 }; pub let main = func() -> u64 { let x: u64 = 10; let p: Mut(u64) = mut_of(x); deref(p) = 20; let s: SliceU8 = SliceU8 { ptr: \"hello\", len: 5 }; let c: u8 = deref(ptr_offset(s.ptr, 2)); return (c as u64) + x - 20; };";
  fails = fails + check_case("ptr_and_lib_slice", src_ptr, 108);

  let src_gen_fn: Slice(u8) = "let size_of = func(T: Type) -> u64 { return @type_info(T).size; }; let id = func(T: Type, x: T) -> T { return x; }; pub let main = func() -> u64 { return id(u64, size_of(u64)) + 34; };";
  fails = fails + check_case("generic_fn", src_gen_fn, 42);

  let src_gen_st: Slice(u8) = "let Slice = func(T: Type) -> Type { return struct { ptr: Ref(T), len: u64 }; }; pub let main = func() -> u64 { let s: Slice(u8) = Slice(u8) { ptr: \"hello\", len: 5 }; return s.len + 37; };";
  fails = fails + check_case("generic_struct", src_gen_st, 42);

  let src_gen: Slice(u8) = "let Slice = func(T: Type) -> Type { return struct { ptr: Ref(T), len: u64 }; }; let size_of = func(T: Type) -> u64 { return @type_info(T).size; }; let id = func(T: Type, x: T) -> T { return x; }; pub let main = func() -> u64 { let s: Slice(u8) = Slice(u8) { ptr: \"hello\", len: 5 }; return id(u64, size_of(Slice(u8))) + s.len + 21; };";
  fails = fails + check_case("generic_slice_and_fn", src_gen, 42);

  let src_fp: Slice(u8) = "let Pt = struct { x: u64, y: u64 }; pub let main = func() -> u64 { let p: Pt = Pt { x: 10, y: 20 }; let py: Mut(u64) = @field_ptr(mut_of(p), 1); deref(py) = 32; return p.x + p.y; };";
  fails = fails + check_case("reflect_field_ptr", src_fp, 42);

  let src_mfn: Slice(u8) = "let M = module { pub { let f = func() -> u64 { return 42; }; } }; pub let main = func() -> u64 { return M::f(); };";
  fails = fails + check_case("module_fn_only", src_mfn, 42);

  let src_mod: Slice(u8) = "let Counter = module { pub { let Self = struct { n: u64 }; let make = func(v: u64) -> Self { return Self { n: v }; }; let inc = func(c: Self, d: u64) -> u64 { return c.n + d; }; } }; pub let main = func() -> u64 { let x: Counter::Self = Counter::make(30); return Counter::inc(x, 12); };";
  fails = fails + check_case("module_self_fn", src_mod, 42);

  let src_gen_mod: Slice(u8) = "let Option = func(T: Type) -> Module { return module { pub { let Self = enum { None Some(T) }; let some = func(v: T) -> Self { return Self::Some(v); }; let none = func() -> Self { return Self::None; }; let unwrap_or = func(o: Self, d: T) -> T { return match o { Some(x) => x, None => d }; }; } }; }; pub let main = func() -> u64 { let a: Option(u64)::Self = Option(u64)::some(42); let b: Option(u64)::Self = Option(u64)::none(); return Option(u64)::unwrap_or(a, 0) + Option(u64)::unwrap_or(b, 0); };";
  fails = fails + check_case("generic_module_option", src_gen_mod, 42);

  let src_sig_wit: Slice(u8) = "let Ops = sig { let add_one: func(x: u64) -> u64; }; let MyOps = module { pub { let add_one = func(x: u64) -> u64 { return x + 1; }; } }; let apply = func(x: u64) ?{ ops: Ops = MyOps } -> u64 { return ops.add_one(x); }; pub let main = func() -> u64 { return apply(41); };";
  fails = fails + check_case("sig_witness_default", src_sig_wit, 42);

  let src_eff_decl: Slice(u8) = "let Fail = effect { op fail(code: u64) -> u64; }; pub let main = func() -> u64 { return 42; };";
  fails = fails + check_case("effect_decl_only", src_eff_decl, 42);

  let src_eff_fail: Slice(u8) = "let Fail = effect { op fail(code: u64) -> u64; }; let might_fail = func(ok: bool) !{ Fail } -> u64 { if ok { return 10; } perform Fail::fail(42); return 0; }; pub let main = func() -> u64 { return handle might_fail(false) with { return(v) => v, fail(c) => c }; };";
  fails = fails + check_case("effect_perform_handle", src_eff_fail, 42);

  let src_eff_ok: Slice(u8) = "let Fail = effect { op fail(code: u64) -> u64; }; let might_fail = func(ok: bool) !{ Fail } -> u64 { if ok { return 10; } perform Fail::fail(99); return 0; }; pub let main = func() -> u64 { return handle might_fail(true) with { return(v) => v + 32, fail(c) => c }; };";
  fails = fails + check_case("effect_handle_ok", src_eff_ok, 42);

  let mod_ok: bool = fs::write_bytes("build/v2_test_mod.lain", "pub let add_ten = func(x: u64) -> u64 { return x + 10; };");
  if mod_ok == false {
    io::println("[FAIL] write build/v2_test_mod.lain");
    fails = fails + 1;
  }
  let src_use_import: Slice(u8) = "use import(\"build::v2_test_mod\")::{ add_ten }; let m = import(\"build::v2_test_mod\"); pub let main = func() -> u64 { return add_ten(20) + m::add_ten(2); };";
  fails = fails + check_case("multi_file_use_import", src_use_import, 42);

  let src_eff_unhandled: Slice(u8) = "let Fail = effect { op fail(code: u64) -> u64; }; let might_fail = func() !{ Fail } -> u64 { perform Fail::fail(1); return 0; }; pub let main = func() -> u64 { return might_fail( ); };";
  fails = fails + check_fail_stage("effect_unhandled_sema_fail", src_eff_unhandled, 4);

  let src_mac_basic: Slice(u8) = "let add1 = macro(x: Syntax) -> Syntax { return quote { ($x) + 1 }; }; pub let main = func() -> u64 { return add1(41); };";
  fails = fails + check_case("macro_quote_basic", src_mac_basic, 42);

  let src_mac_unless: Slice(u8) = "let unless = macro(cond: Syntax, body: Syntax) -> Syntax { return quote { if ($cond) == false $body }; }; pub let main = func() -> u64 { let x: u64 = 0; unless(x == 1) { return 42; } return 0; };";
  fails = fails + check_case("macro_block_unless", src_mac_unless, 42);

  let src_mac_nested: Slice(u8) = "let dbl_add = macro(a: Syntax, b: Syntax) -> Syntax { let s = quote { ($a) + ($b) }; return quote { ($s) * 2 }; }; pub let main = func() -> u64 { return dbl_add(10, 11); };";
  fails = fails + check_case("macro_nested_quote", src_mac_nested, 42);

  let src_mac_str: Slice(u8) = "let id_str = macro(s: Syntax) -> Syntax { return quote { $s }; }; pub let main = func() -> u64 { let p: Ref(u8) = id_str\"hi\"; return (deref(p) as u64) - 62; };";
  fails = fails + check_case("macro_str_lit", src_mac_str, 42);

  let src_mac_len: Slice(u8) = "let pick = macro(x: Syntax) -> Syntax { if x.len > 0 { return quote { ($x) + 2 }; } return quote { 0 }; }; pub let main = func() -> u64 { return pick(40); };";
  fails = fails + check_case("macro_ct_len", src_mac_len, 42);

  io::println("=== C99 Backend Output (fn_call) ===");
  let emitted: bool = emit_c99_stdout(src_call, "main");
  if emitted == false {
    io::println("[FAIL] c99 emit failed");
    fails = fails + 1;
  }

  if fails == 0 {
    io::println("=== ALL V2 DRIVER CHECKS PASSED ===");
    return 0;
  }
  return 1;
};

let print_usage = func() {
  io::println("usage: lainc_v2 [--test] | <source.lain> [--entry <name>] [--c99 | --run] [--help]");
};

let read_source_file = func(path: Slice(u8), out: Mut(Vec(u8))) !{ OomErr } -> bool {
  let path_z: Vec(u8) = Vec(u8)::new();
  let pi: u64 = 0;
  while pi < path.len {
    path_z.push(path[pi]);
    pi = pi + 1;
  };
  path_z.push(0);
  let ps: Slice(u8) = path_z.as_slice();
  let path_sl: Slice(u8) = make_slice(Slice(u8), ps.ptr, path_z.len() - 1);
  let fh: Mut(u8) = os::open_file(path_sl, "rb");
  let ok: bool = false;
  if is_null(fh) == false {
    ok = true;
    let chunk: MutSlice(u8) = os::alloc_slice(4096);
    let reading: bool = true;
    while reading {
      let got: u64 = os::c_fread(chunk.ptr, 1, chunk.len, fh) as u64;
      if got == 0 {
        reading = false;
      } else {
        let ci: u64 = 0;
        while ci < got {
          out.push(chunk[ci]);
          ci = ci + 1;
        };
      }
    };
    os::c_fclose(fh);
    os::free_slice(chunk);
  }
  return ok;
};

let stage_name = func(stage: u64) -> Slice(u8) {
  if stage == 1 { return "read/load"; }
  if stage == 2 { return "expand"; }
  if stage == 3 { return "parse"; }
  if stage == 4 { return "sema"; }
  if stage == 5 { return "lower"; }
  if stage == 6 { return "verify"; }
  if stage == 7 { return "vm"; }
  if stage == 8 { return "vm_trap"; }
  return "unknown";
};

let run_file_inner = func(src_path: Slice(u8), entry_name: Slice(u8), want_run: bool) !{ OomErr } -> i64 {
  let src_buf: Vec(u8) = Vec(u8)::new();
  let rc: i64 = 1;
  if read_source_file(src_path, mut_of(src_buf)) == false {
    io::print("error: cannot read source file: ");
    io::println(src_path);
  } else {
    let src_bytes: Slice(u8) = src_buf.as_slice();
    if want_run {
      let r: RunResult = run_vm(src_bytes, entry_name);
      if r.ok {
        io::println_u64(r.value);
        rc = 0;
      } else {
        io::print("error: stage=");
        io::print(stage_name(r.stage));
        io::print(" (");
        io::print_u64(r.stage);
        io::print(") code=");
        io::println_u64(r.value);
      }
    } else {
      let ok: bool = emit_c99_stdout(src_bytes, entry_name);
      if ok {
        rc = 0;
      } else {
        io::println("error: c99 compilation failed");
      }
    }
  }
  return rc;
};

let main = func() -> i64 {
  let argc: u64 = cli::count();
  if argc <= 1 {
    return run_self_tests();
  }
  let want_test: bool = false;
  let want_run: bool = false;
  let want_help: bool = false;
  let has_src: bool = false;
  let src_path: Slice(u8) = "";
  let entry_name: Slice(u8) = "main";
  let i: u64 = 1;
  while i < argc {
    let a: cli::OptSlice.Opt = cli::arg(i);
    let s: Slice(u8) = cli::OptSlice.unwrap_or(a, "");
    if str::eq(s, "--help") or str::eq(s, "-h") {
      want_help = true;
      i = i + 1;
    } else if str::eq(s, "--test") {
      want_test = true;
      i = i + 1;
    } else if str::eq(s, "--run") {
      want_run = true;
      i = i + 1;
    } else if str::eq(s, "--c99") {
      want_run = false;
      i = i + 1;
    } else if str::eq(s, "--entry") and ((i + 1) < argc) {
      let ea: cli::OptSlice.Opt = cli::arg(i + 1);
      entry_name = cli::OptSlice.unwrap_or(ea, "main");
      i = i + 2;
    } else if str::eq(s, "--entry") {
      print_usage();
      return 1;
    } else if has_src == false {
      src_path = s;
      has_src = true;
      i = i + 1;
    } else {
      print_usage();
      return 1;
    }
  };
  if want_help {
    print_usage();
    return 0;
  }
  if want_test {
    return run_self_tests();
  }
  if has_src == false {
    print_usage();
    return 1;
  }
  return handle run_file_inner(src_path, entry_name, want_run) with {
    return(v) => v,
    oom(_) => 1
  };
};
