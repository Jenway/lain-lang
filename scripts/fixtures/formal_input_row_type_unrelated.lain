// Only a *type expression* constrains an entry.  This row's peer entry is
// typed (`bias: i32`), but that type mentions no entry name, and `T` appears in
// the row as nothing but its own entry, so `T` stays unconstrained and the
// declaration is reported instead of being guessed.  A derivation that counted
// a peer entry's own name, or the entry itself, would wrongly accept this row.
let pick = std::func() ?{bias: i32, T} -> i32 {
    return 41;
};

let outer: Module = std::module {
    let T: std::type = i32;
    let bias: i32 = 1;
    @export let got = pick();
};

let main = std::func() -> i32 {
    return outer.got;
};
