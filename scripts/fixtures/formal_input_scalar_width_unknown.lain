// The caller's declaration carries no annotation, so its value has no
// determined width.  An unknown width must not be reported: the call keeps the
// kind-level behaviour and still resolves the input the body returns.
let bias = std::func() ?{local: i64} -> i64 {
    return local;
};

let outer: Module = std::module {
    let local = 41;
    @export let answer: i64 = bias();
};

let main = std::func() -> i64 {
    return outer.answer;
};