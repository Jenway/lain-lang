#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc meta_parse_result_new(#addr %data, #bits<64> %length) -> #addr;
#extern #proc meta_parse_result_source(#addr %result) -> #addr;
#extern #proc meta_parse_result_tokens(#addr %result) -> #addr;
#extern #proc meta_parse_result_root(#addr %result) -> #addr;
#extern #proc meta_parse_result_status(#addr %result) -> #bits<32>;
#extern #proc meta_parse_result_release(#addr %result) -> #unit;
#extern #proc meta_token_count(#addr %token) -> #bits<64>;
#extern #proc meta_token_matches(#addr %source, #addr %token, #addr %text, #bits<64> %length) -> #bits<1>;
#extern #proc meta_source_length(#addr %source) -> #bits<64>;
#extern #proc meta_ast_first(#addr %node) -> #addr;
#extern #proc meta_ast_start(#addr %node) -> #bits<64>;
#extern #proc meta_ast_length(#addr %node) -> #bits<64>;
#extern #proc meta_ast_origin_source(#addr %node) -> #addr;
#extern #proc meta_ast_origin_start(#addr %node) -> #bits<64>;
#extern #proc meta_ast_origin_length(#addr %node) -> #bits<64>;
#extern #proc meta_ast_origin_present(#addr %node) -> #bits<1>;
#extern #proc meta_ast_syntax_context(#addr %node) -> #bits<64>;
#extern #proc meta_ast_set_syntax_context(#addr %node, #bits<64> %context) -> #unit;
#extern #proc meta_syntax_context_new() -> #addr;
#extern #proc meta_syntax_context_fresh(#addr %context) -> #bits<64>;
#extern #proc meta_syntax_context_source(#addr %context) -> #addr;
#extern #proc meta_ast_fresh_atom(#addr %context, #addr %text, #bits<64> %length, #bits<32> %token_kind) -> #addr;
#extern #proc meta_ast_write(#addr %source, #addr %node) -> #unit;
#extern #proc meta_syntax_context_release(#addr %context) -> #unit;
#extern #proc meta_ast_copy(#addr %node) -> #addr;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-literal(#addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#proc main() -> #bits<32> {
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %result: #addr = #call meta_parse_result_new(%data, %length)
  #let %status: #bits<32> = #call meta_parse_result_status(%result)
  #call meta_parse_result_release(%result)
  #let %valid_data: #addr = #call bootstrap.source-data(1)
  #let %valid_length: #bits<64> = #call bootstrap.source-length(1)
  #let %valid_result: #addr = #call meta_parse_result_new(%valid_data, %valid_length)
  #let %valid_source: #addr = #call meta_parse_result_source(%valid_result)
  #let %valid_tokens: #addr = #call meta_parse_result_tokens(%valid_result)
  #let %valid_root: #addr = #call meta_parse_result_root(%valid_result)
  #let %token_ok: #bits<1> = #call meta_token_matches(
    %valid_source, %valid_tokens, "let", 3
  )
  #let %token_count: #bits<64> = #call meta_token_count(%valid_tokens)
  #let %first_node: #addr = #call meta_ast_first(%valid_root)
  #let %origin_source: #addr = #call meta_ast_origin_source(%first_node)
  #let %origin_ok: #bits<1> = #call meta_ast_origin_present(%first_node)
  #if #eq(%origin_ok, 1) {
    #if #eq(
      #call meta_ast_origin_start(%first_node),
      #call meta_ast_start(%first_node)
    ) {
      #if #eq(
        #call meta_ast_origin_length(%first_node),
        #call meta_ast_length(%first_node)
      ) {
        #if #eq(#call meta_source_length(%origin_source), %valid_length) {
          %origin_ok: #bits<1> = 1
        } else {
          %origin_ok: #bits<1> = 0
        }
      } else {
        %origin_ok: #bits<1> = 0
      }
    } else {
      %origin_ok: #bits<1> = 0
    }
  }
  #let %context: #addr = #call meta_syntax_context_new()
  #let %context_first: #bits<64> = #call meta_syntax_context_fresh(%context)
  #let %context_second: #bits<64> = #call meta_syntax_context_fresh(%context)
  #call meta_ast_set_syntax_context(%first_node, %context_first)
  #let %copied_node: #addr = #call meta_ast_copy(%first_node)
  #let %context_ok: #bits<1> = 0
  #if #eq(%context_first, 1) {
    #if #eq(%context_second, 2) {
      #if #eq(#call meta_ast_syntax_context(%copied_node), 1) {
        %context_ok: #bits<1> = 1
      }
    }
  }
  #let %fresh_atom: #addr = #call meta_ast_fresh_atom(
    %context, "tmp", 3, 1
  )
  #let %fresh_context_source: #addr = #call meta_syntax_context_source(%context)
  #let %fresh_ok: #bits<1> = 0
  #if #eq(#call meta_ast_syntax_context(%fresh_atom), 3) {
    #if #eq(#call meta_ast_length(%fresh_atom), 3) {
      %fresh_ok: #bits<1> = 1
    }
  }
  #call meta_parse_result_release(%valid_result)
  #call bootstrap.artifact-begin()
  #if #eq(%status, 1) {
    #if #eq(%token_ok, 1) {
      #if #sgt(%token_count, 0) {
        #if #eq(%origin_ok, 1) {
        #if #eq(%context_ok, 1) {
            #if #eq(%fresh_ok, 1) {
              #call bootstrap.artifact-write-literal("status=1 token=1 origin=1 context=1 fresh=")
              #call meta_ast_write(%fresh_context_source, %fresh_atom)
              #call bootstrap.artifact-write-literal(" ctx=3\n")
            } else {
              #call bootstrap.artifact-write-literal("status=1 token=1 origin=1 context=1 fresh=bad\n")
            }
          } else {
            #call bootstrap.artifact-write-literal("status=1 token=1 origin=1 context=0\n")
          }
        } else {
          #call bootstrap.artifact-write-literal("status=1 token=1 origin=0\n")
        }
      } else {
        #call bootstrap.artifact-write-literal("status=1 token=1 count=0\n")
      }
    } else {
      #call bootstrap.artifact-write-literal("status=1 token=0\n")
    }
  } else {
    #call bootstrap.artifact-write-literal("status=unexpected\n")
  }
  #call bootstrap.artifact-finish()
  #call meta_syntax_context_release(%context)
  #return 0
}
