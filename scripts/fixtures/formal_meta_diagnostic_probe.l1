#extern #proc bootstrap.source-data(i64 %index) -> addr;
#extern #proc bootstrap.source-length(i64 %index) -> i64;
#extern #proc meta_parse_result_new(addr %data, i64 %length) -> addr;
#extern #proc meta_parse_result_status(addr %result) -> i32;
#extern #proc meta_parse_result_release(addr %result) -> #unit;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;

#proc main() -> #bits<32> {
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %result: #addr = #call meta_parse_result_new(%data, %length)
  #let %status: #bits<32> = #call meta_parse_result_status(%result)
  #call meta_parse_result_release(%result)
  #call bootstrap.artifact-begin()
  #if #eq(%status, 1) {
    #call bootstrap.artifact-write-literal("status=1\n")
  } else {
    #call bootstrap.artifact-write-literal("status=unexpected\n")
  }
  #call bootstrap.artifact-finish()
  #return 0
}
