// Backend load/store widths.
//
// `#load[#bits<32>]` emitted `L1_load64`, and `#bits<16>` load and store both
// emitted the 64-bit forms.  A 16-bit store writing 8 bytes corrupts the
// neighbouring object and a 16-bit load over-reads it, so these are
// memory-safety bugs, not merely wrong results.
//
// `L1_load32` was defined but never selected; `L1_load16` and `L1_store16`
// did not exist.
#proc probe8(#addr %p) -> #bits<8> {
  #let %a: #bits<8> = #load[#bits<8>](%p)
  #store[#bits<8>] %a, %p
  #return %a
}

#proc probe16(#addr %p) -> #bits<16> {
  #let %b: #bits<16> = #load[#bits<16>](%p)
  #store[#bits<16>] %b, %p
  #return %b
}

#proc probe32(#addr %p) -> #bits<32> {
  #let %c: #bits<32> = #load[#bits<32>](%p)
  #store[#bits<32>] %c, %p
  #return %c
}

#proc probe64(#addr %p) -> #bits<64> {
  #let %d: #bits<64> = #load[#bits<64>](%p)
  #store[#bits<64>] %d, %p
  #return %d
}

#proc main() -> #bits<32> {
  #return 0
}
