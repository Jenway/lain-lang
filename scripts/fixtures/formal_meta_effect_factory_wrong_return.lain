let effects: Module = import("std::effect");

let allocation: Module = std::module {
    @export
    let Alloc = std::func(Policy: Module) -> Module {
        return std::effect("Alloc", Policy);
    };
};

let Policy: Module = std::module {
    @export let Effect: effects.Effect = allocation.Alloc(Policy);
    @export let ping = std::effect_operation(
        Effect,
        "ping",
        std::func() -> unit,
    );
};

@export
let main = std::func() -> i32 {
    return 42;
};
