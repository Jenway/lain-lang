// `while` with a `&&` condition silently drops every conjunct after the first.
// Measured: this emits `#if #sge(%i, %a) { #break }` and nothing about `b`, so
// the loop runs until only the first comparison fails.  The equivalent manual
// unrolling and an `if` with the same condition both keep both conjuncts, so
// the defect is specific to a `&&` condition in a `while`.
let w = std::func(a: i32, b: i32) -> i32 {
    let i: i32 = 0;
    while i < a && i < b {
        i = i + 1;
    }
    return i;
};

let main = std::func() -> i32 {
    return 0;
};
