// A bare entry can also be given its kind by the body: the explicit annotation
// of a `let` declaration (`let probe: T = 0;`) is a type position, so `T` is a
// type value here even though no signature position mentions it.  The body
// reads `T` through that annotation and returns a module, so the resolved
// input is what makes the declaration well formed.
let pick = std::func() ?{T} -> Module {
    let probe: T = 0;
    return std::module {
        @export let value: i32 = 41;
    };
};

let outer: Module = std::module {
    let T: std::type = i32;
    @export let built = pick();
};

let main = std::func() -> i32 {
    return outer.built.value;
};
