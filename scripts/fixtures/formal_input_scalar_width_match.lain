// The declared scalar width is part of the requirement: the caller's `i64`
// declaration satisfies the `i64` input, and the value the body returns is the
// resolved one, so a width check that rejected the matching pair could not
// print 41 through a callee declared where `local` does not exist.
let bias = std::func() ?{local: i64} -> i64 {
    return local;
};

let outer: Module = std::module {
    let local: i64 = 41;
    @export let answer: i64 = bias();
};

let main = std::func() -> i64 {
    return outer.answer;
};