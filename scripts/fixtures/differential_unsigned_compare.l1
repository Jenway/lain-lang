// Differential fixture: unsigned comparison semantics.
//
// Two defects met here.  The Lain backend had no case at all for
// `#ult`/`#ule`/`#ugt`/`#uge`, so they fell through to the unsupported marker,
// which is a C comment -- `ult(2, 1)` became the comma expression `(2, 1)`,
// valid C evaluating to 1.  And the seed emitter maps the unsigned kinds 33-36
// to the same C operators as the signed kinds 29-32, so `#ult` and `#slt`
// compile to the same comparison.
//
// Positive small operands cannot tell those apart, which is why the earlier
// version of this fixture passed on both backends.  The discriminating case is
// a byte operand whose high bit is set: as a `#bits<8>` value it is 255, so
// unsigned 255 < 3 is false, while as a signed int8_t it is -1 and -1 < 3 is
// true.  The two families must therefore disagree.
#proc main() -> #bits<32> {
  // A byte with its high bit set.  Emitted as int8_t by both backends, so its
  // C value is -1 while its LAINIR value is 255.
  #let %high: #bits<8> = 255

  // Unsigned: 255 < 3 is false.  Signed: -1 < 3 is true.  Worth 1 each, so a
  // backend that conflates them contributes 10 where it should contribute 1.
  #let %unsigned_less: #bits<32> = #zext[#bits<32>](#ult(%high, 3))
  #let %signed_less: #bits<32> = #zext[#bits<32>](#slt(%high, 3))
  #let %pair: #bits<32> = #add(%unsigned_less, #mul(%signed_less, 10))

  // The remaining unsigned families on the same operand, each worth its own
  // amount: 255 > 3 is true, 255 <= 3 is false, 255 >= 3 is true.
  #let %rest: #bits<32> = #add(
    #mul(100, #zext[#bits<32>](#ugt(%high, 3))),
    #add(
      #mul(1000, #zext[#bits<32>](#ule(%high, 3))),
      #mul(10000, #zext[#bits<32>](#uge(%high, 3)))
    )
  )

  // Expected: 1 (255 < 3 false, -1 < 3 true gives 10 -> pair is 11) ...
  // concisely: pair = 0 + 1*10 = 10, rest = 1*100 + 0*1000 + 1*10000 = 10100,
  // total 10110.  A backend treating `#ult` as signed gives pair = 11.
  #return #add(%pair, %rest)
}
