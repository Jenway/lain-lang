#extern #proc bootstrap.source-data(#bits<64> %index) -> #addr;
#extern #proc bootstrap.source-length(#bits<64> %index) -> #bits<64>;
#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-literal(#addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc meta_parse_result_new(#addr %data, #bits<64> %length) -> #addr;
#extern #proc meta_parse_result_source(#addr %result) -> #addr;
#extern #proc meta_parse_result_root(#addr %result) -> #addr;
#extern #proc meta_parse_result_release(#addr %result) -> #unit;
#extern #proc meta_expand_root(#addr %source, #addr %root) -> #bits<32>;
#extern #proc meta_ast_is_nil(#addr %node) -> #bits<1>;
#extern #proc meta_ast_kind(#addr %node) -> #bits<32>;
#extern #proc meta_ast_first(#addr %node) -> #addr;
#extern #proc meta_ast_next(#addr %node) -> #addr;
#extern #proc meta_ast_start(#addr %node) -> #bits<64>;
#extern #proc meta_ast_length(#addr %node) -> #bits<64>;
#extern #proc meta_ast_syntax_context(#addr %node) -> #bits<64>;
#extern #proc meta_source_data(#addr %source) -> #addr;
#extern #proc meta_source_byte_at(#addr %data, #bits<64> %index) -> #bits<8>;

#proc count_t(#addr %source, #addr %node, #bits<64> %wanted_context) -> #bits<64> {
  #let %data: #addr = #call meta_source_data(%source)
  #let %count: #bits<64> = 0
  #let %current: #addr = %node
  #loop siblings {
    #if #call meta_ast_is_nil(%current) { #break siblings }
    #if #eq(#call meta_ast_kind(%current), 1) {
      #if #eq(#call meta_ast_length(%current), 1) {
        #if #eq(#call meta_source_byte_at(
          %data, #call meta_ast_start(%current)
        ), 116) {
          #if #eq(
            #call meta_ast_syntax_context(%current), %wanted_context
          ) {
            %count: #bits<64> = #add(%count, 1)
          }
        }
      }
    }
    #let %child: #addr = #call meta_ast_first(%current)
    #if #eq(#call meta_ast_is_nil(%child), 0) {
      %count: #bits<64> = #add(
        %count, #call count_t(%source, %child, %wanted_context)
      )
    }
    %current: #addr = #call meta_ast_next(%current)
    #continue siblings
  }
  #return %count
}

#extern #proc meta_ast_set_syntax_context(#addr %node, #bits<64> %context) -> #unit;
#extern #proc meta_ast_origin_source(#addr %node) -> #addr;
#extern #proc meta_ast_origin_start(#addr %node) -> #bits<64>;
#extern #proc meta_ast_origin_length(#addr %node) -> #bits<64>;

#proc is_caller_number(#addr %source, #addr %node) -> #bits<1> {
  #if #ne(#call meta_ast_kind(%node), 1) { #return 0 }
  #if #ne(#call meta_ast_length(%node), 2) { #return 0 }
  #let %data: #addr = #call meta_source_data(%source)
  #let %start: #bits<64> = #call meta_ast_start(%node)
  #if #ne(#call meta_source_byte_at(%data, #add(%start, 1)), 48) { #return 0 }
  #let %first: #bits<8> = #call meta_source_byte_at(%data, %start)
  #if #eq(%first, 49) { #return 1 }
  #if #eq(%first, 50) { #return 1 }
  #return 0
}

#proc mark_caller_arguments(#addr %source, #addr %node) -> #unit {
  #let %cursor: #addr = %node
  #loop siblings {
    #if #call meta_ast_is_nil(%cursor) { #return }
    #if #call is_caller_number(%source, %cursor) { #call meta_ast_set_syntax_context(%cursor, 123) }
    #call mark_caller_arguments(%source, #call meta_ast_first(%cursor))
    %cursor: #addr = #call meta_ast_next(%cursor)
    #continue siblings
  }
}

#proc count_preserved_arguments(#addr %source, #addr %node) -> #bits<64> {
  #let %cursor: #addr = %node
  #let %count: #bits<64> = 0
  #loop siblings {
    #if #call meta_ast_is_nil(%cursor) { #return %count }
    #if #call is_caller_number(%source, %cursor) {
      #if #eq(#call meta_ast_syntax_context(%cursor), 123) {
        #if #eq(#call meta_ast_origin_source(%cursor), %source) {
          #if #eq(#call meta_ast_origin_start(%cursor), #call meta_ast_start(%cursor)) {
            #if #eq(#call meta_ast_origin_length(%cursor), #call meta_ast_length(%cursor)) {
              %count: #bits<64> = #add(%count, 1)
            }
          }
        }
      }
    }
    %count: #bits<64> = #add(%count, #call count_preserved_arguments(%source, #call meta_ast_first(%cursor)))
    %cursor: #addr = #call meta_ast_next(%cursor)
    #continue siblings
  }
}

#proc main() -> #bits<32> {
  #let %data: #addr = #call bootstrap.source-data(0)
  #let %length: #bits<64> = #call bootstrap.source-length(0)
  #let %result: #addr = #call meta_parse_result_new(%data, %length)
  #let %source: #addr = #call meta_parse_result_source(%result)
  #let %root: #addr = #call meta_parse_result_root(%result)
  #call mark_caller_arguments(%source, #call meta_ast_first(%root))
  #let %status: #bits<32> = #call meta_expand_root(%source, %root)
  #if #ne(#call count_preserved_arguments(%source, #call meta_ast_first(%root)), 2) { #return 9 }
  #let %source_root: #addr = #call meta_ast_first(%root)
  #let %source_context: #bits<64> = #call count_t(
    %source, %source_root, 0
  )
  #let %first_expansion: #bits<64> = #call count_t(
    %source, %source_root, 1
  )
  #let %second_expansion: #bits<64> = #call count_t(
    %source, %source_root, 2
  )
  #call bootstrap.artifact-begin()
  #if #eq(%status, 1) {
    #if #eq(%source_context, 1) {
      #if #eq(%first_expansion, 3) {
        #if #eq(%second_expansion, 3) {
          #call bootstrap.artifact-write-literal("hygiene=1\n")
        } else {
          #call bootstrap.artifact-write-literal("hygiene=0\n")
        }
      } else {
        #call bootstrap.artifact-write-literal("hygiene=0\n")
      }
    } else {
      #call bootstrap.artifact-write-literal("hygiene=0\n")
    }
  } else {
    #call bootstrap.artifact-write-literal("hygiene=0\n")
  }
  #call bootstrap.artifact-finish()
  #call meta_parse_result_release(%result)
  #return 0
}
