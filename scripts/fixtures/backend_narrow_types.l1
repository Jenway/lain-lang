#proc byte_out(#bits<8> %a) -> #bits<8> {
  #return %a
}

#proc short_out(#bits<16> %b) -> #bits<16> {
  #return %b
}

#proc float_out(#float<32> %c) -> #float<32> {
  #return %c
}

#proc double_out(#float<64> %d) -> #float<64> {
  #return %d
}

#proc local_byte() -> #bits<8> {
  #let %v: #bits<8> = 7
  #return %v
}

#proc die() -> #never {
  #loop spin {
    #continue spin
  }
}

#proc main() -> #bits<32> {
  #return 0
}
