let f = std::func(value: i64) ?{T: i64} -> i64 !{IO} {
    return value;
};

// A multi-token entry type exercises the type-expression boundary the entry
// rule is stated in terms of.
let rows = std::func() ?{items: Vec(i64), limit: i32} -> i32 {
    return 0;
};

// `std::func<T>` carries compile-time type parameters before the parameter
// group, and a body-less declaration is a legal external signature.
let size_of = std::func<T>() -> usize;

let main = std::func() -> i64 {
    return f(42);
};
