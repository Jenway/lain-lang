let allocation: Module = std::module {
    @export
    let Alloc = std::func(Policy: Module) -> Module {
        return std::effect("Alloc", Policy);
    };
};

let Policy: Module = std::module {
    @export let Effect: Module = allocation.Alloc(Policy);
};

@export
let main = std::func() -> i32 {
    return 42;
};
