let max = std::func(a: i32, b: i32)
    ?{ord: Module, bias: i32}
    -> Module {
    return std::module {
        @export let value: i32 = ord.value;
    };
};

let outer: Module = std::module {
    let ord: Module = std::module {
        @export let value: i32 = 41;
    };
    let bias: i32 = 1;
    @export let built = max(0, 0);
};

let main = std::func() -> i32 {
    return outer.built.value;
};
