// The helper must execute during calculate(), and main consumes its result.
let helper = std::func(value: i32) -> i32 {
    return value + 1;
};

let calculate = std::func() -> i32 {
    let value: i32 = helper(41);
    return value;
};

let answer: i32 = calculate();

let main = std::func() -> i32 {
    return answer;
};
