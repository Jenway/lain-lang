let memory_model: Module = import("std::memory_model");
let arena_min: Module = import("std::core::arena_min");
let bounds: Module = import("std::bounds");
let provider: Module = import("packages::lain::lainir::api::default_provider");

let Memory: Module = memory_model.Model(
    arena_min.Policy,
    bounds.Unchecked,
);
let L1: Module = provider.lainir_default_provider.Provider(Memory);

@export
let probe = std::func() -> i32 {
    return L1.schema_version();
};
