// Physical parameter and result widths must survive signed division calls.
#proc divide8(#bits<8> %a, #bits<8> %b) -> #bits<8> {
  #return #sdiv(%a, %b)
}

#proc divide16(#bits<16> %a, #bits<16> %b) -> #bits<16> {
  #return #sdiv(%a, %b)
}

#proc divide32(#bits<32> %a, #bits<32> %b) -> #bits<32> {
  #return #sdiv(%a, %b)
}

#proc divide64(#bits<64> %a, #bits<64> %b) -> #bits<64> {
  #return #sdiv(%a, %b)
}

#proc main() -> #bits<32> {
  #let %zero8: #bits<8> = 0
  #let %negative8: #bits<8> = #sub(%zero8, 7)
  #let %negative_two8: #bits<8> = #sub(%zero8, 2)
  #let %expected8: #bits<8> = #sub(%zero8, 3)
  #let %q8: #bits<8> = #call divide8(%negative8, 2)
  #if #ne(%q8, %expected8) { #return 8 }
  #let %positive8: #bits<8> = #call divide8(%negative8, %negative_two8)
  #if #ne(%positive8, 3) { #return 108 }
  #let %zero16: #bits<16> = 0
  #let %negative16: #bits<16> = #sub(%zero16, 7)
  #let %negative_two16: #bits<16> = #sub(%zero16, 2)
  #let %expected16: #bits<16> = #sub(%zero16, 3)
  #let %q16: #bits<16> = #call divide16(%negative16, 2)
  #if #ne(%q16, %expected16) { #return 16 }
  #let %positive16: #bits<16> = #call divide16(%negative16, %negative_two16)
  #if #ne(%positive16, 3) { #return 116 }
  #let %zero32: #bits<32> = 0
  #let %negative32: #bits<32> = #sub(%zero32, 7)
  #let %negative_two32: #bits<32> = #sub(%zero32, 2)
  #let %expected32: #bits<32> = #sub(%zero32, 3)
  #let %q32: #bits<32> = #call divide32(%negative32, 2)
  #if #ne(%q32, %expected32) { #return 32 }
  #let %positive32: #bits<32> = #call divide32(%negative32, %negative_two32)
  #if #ne(%positive32, 3) { #return 132 }
  #let %zero64: #bits<64> = 0
  #let %negative64: #bits<64> = #sub(%zero64, 7)
  #let %negative_two64: #bits<64> = #sub(%zero64, 2)
  #let %expected64: #bits<64> = #sub(%zero64, 3)
  #let %q64: #bits<64> = #call divide64(%negative64, 2)
  #if #ne(%q64, %expected64) { #return 64 }
  #let %positive64: #bits<64> = #call divide64(%negative64, %negative_two64)
  #if #ne(%positive64, 3) { #return 164 }
  #return 42
}
