#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-literal(addr %text) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc meta_type_conversion_allowed(i32 %from_kind, i32 %to_kind, i1 %explicit) -> i1;
#extern #proc meta_generic_parameter_valid(i32 %kind) -> i1;
#extern #proc meta_generic_specialization_token(
  i64 %source_id, i64 %type_argument, i64 %value_argument,
  i64 %policy, i64 %environment, i64 %target, i64 %backend
) -> i64;
#extern #proc meta_effect_allowed(i32 %required, i32 %provided) -> i1;
#extern #proc meta_bounds_check(i64 %index, i64 %length) -> i32;

#proc main() -> #bits<32> {
  #let %ok: #bits<1> = 1
  #if #eq(
    #call meta_type_conversion_allowed(1, 1, 0), 1
  ) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(
    #call meta_type_conversion_allowed(3, 1, 1), 1
  ) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_generic_parameter_valid(1), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_generic_parameter_valid(5), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #let %token_a: #bits<64> = #call meta_generic_specialization_token(
    7, 11, 13, 17, 19, 23, 29
  )
  #let %token_b: #bits<64> = #call meta_generic_specialization_token(
    7, 11, 13, 17, 19, 23, 29
  )
  #if #eq(%token_a, %token_b) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_effect_allowed(0, 1), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_effect_allowed(1, 2), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_bounds_check(2, 3), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_bounds_check(3, 3), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #call bootstrap.artifact-begin()
  #if #eq(%ok, 1) {
    #call bootstrap.artifact-write-literal("policy=1\n")
  } else {
    #call bootstrap.artifact-write-literal("policy=0\n")
  }
  #call bootstrap.artifact-finish()
  #return 0
}
