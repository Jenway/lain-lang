#extern #proc bootstrap.artifact-begin() -> #unit;
#extern #proc bootstrap.artifact-write-byte(#bits<8> %byte) -> #unit;
#extern #proc bootstrap.artifact-finish() -> #unit;
#extern #proc meta_type_conversion_allowed(#bits<32> %from_kind, #bits<32> %to_kind, #bits<1> %explicit) -> #bits<1>;
#extern #proc meta_generic_parameter_valid(#bits<32> %kind) -> #bits<1>;
#extern #proc meta_generic_specialization_token(
  #bits<64> %source_id, #bits<64> %type_argument, #bits<64> %value_argument,
  #bits<64> %policy, #bits<64> %environment, #bits<64> %target, #bits<64> %backend
) -> #bits<64>;
#extern #proc meta_effect_allowed(#bits<32> %required, #bits<32> %provided) -> #bits<1>;
#extern #proc meta_bounds_check(#bits<64> %index, #bits<64> %length) -> #bits<32>;

#proc main() -> #bits<32> {
  #let %ok: #bits<1> = 1
  #if #eq(
    #call meta_type_conversion_allowed(1, 1, 0), 1
  ) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(
    #call meta_type_conversion_allowed(3, 1, 1), 1
  ) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_generic_parameter_valid(1), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_generic_parameter_valid(5), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #let %token_a: #bits<64> = #call meta_generic_specialization_token(
    7, 11, 13, 17, 19, 23, 29
  )
  #let %token_b: #bits<64> = #call meta_generic_specialization_token(
    7, 11, 13, 17, 19, 23, 29
  )
  #if #eq(%token_a, %token_b) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_effect_allowed(0, 1), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_effect_allowed(1, 2), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_bounds_check(2, 3), 0) {
  } else {
    %ok: #bits<1> = 0
  }
  #if #eq(#call meta_bounds_check(3, 3), 1) {
  } else {
    %ok: #bits<1> = 0
  }
  #call bootstrap.artifact-begin()
  #if #eq(%ok, 1) {
    #call bootstrap.artifact-write-byte(112)
    #call bootstrap.artifact-write-byte(111)
    #call bootstrap.artifact-write-byte(108)
    #call bootstrap.artifact-write-byte(105)
    #call bootstrap.artifact-write-byte(99)
    #call bootstrap.artifact-write-byte(121)
    #call bootstrap.artifact-write-byte(61)
    #call bootstrap.artifact-write-byte(49)
    #call bootstrap.artifact-write-byte(10)
  } else {
    #call bootstrap.artifact-write-byte(112)
    #call bootstrap.artifact-write-byte(111)
    #call bootstrap.artifact-write-byte(108)
    #call bootstrap.artifact-write-byte(105)
    #call bootstrap.artifact-write-byte(99)
    #call bootstrap.artifact-write-byte(121)
    #call bootstrap.artifact-write-byte(61)
    #call bootstrap.artifact-write-byte(48)
    #call bootstrap.artifact-write-byte(10)
  }
  #call bootstrap.artifact-finish()
  #return 0
}
