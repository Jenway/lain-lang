// Differential fixture: integer conversions.
//
// The Lain backend matches `#trunc`, `#sext` and `#zext`, advances past the
// type annotation, and emits nothing -- all three conversions are silently
// dropped.  The seed emits a real cast, so the two backends disagree.
//
// Truncation is the unambiguous case, because it changes the value rather than
// only its interpretation: 300 narrowed to eight bits is 44, and a backend that
// drops the conversion returns 300.
//
// Only `#trunc` is exercised here.  `#zext` and `#sext` are reserved for a
// separate fixture because they interact with a deeper question this one cannot
// settle: both backends represent `#bits<8>` as int8_t and `#bits<32>` as
// int32_t, so a byte value above 127 has no faithful C representation to
// extend from.  Mixing that into this fixture would make a failure ambiguous
// between the dropped conversion and the signed representation.
#proc main() -> #bits<32> {
  // 300 = 0x12C, narrowed to eight bits = 0x2C = 44.  Dropped: 300.
  #let %byte: #bits<32> = #zext[#bits<32>](#trunc[#bits<8>](300))

  // 70000 = 0x11170, narrowed to sixteen bits = 0x1170 = 4464.  Dropped: 70000.
  #let %half: #bits<32> = #zext[#bits<32>](#trunc[#bits<16>](70000))

  // 44 + 4464 = 4508.
  #return #add(%byte, %half)
}
