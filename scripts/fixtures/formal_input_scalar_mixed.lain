let pick = std::func() ?{ord: Module, bias: i32} -> i32 {
    return bias;
};

let outer: Module = std::module {
    let ord: Module = std::module {
        @export let value: i32 = 1;
    };
    let bias: i32 = 41;
    @export let answer = pick();
};

let main = std::func() -> i32 {
    return outer.answer;
};
