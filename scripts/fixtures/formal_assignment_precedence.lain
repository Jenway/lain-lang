// Mixing precedence levels in an assignment silently drops the
// lower-precedence term unless it is parenthesised.
//
// Measured: `v * 10 + d` emits `#mul(%v, 10)` and loses `+ d`; `d + v * 10`
// emits `#add(%d, %v)` and loses `* 10`.  Parenthesised forms and single
// operators are correct, and the same expressions are correct in a `return`.
let mixed = std::func(v: i32, d: i32) -> i32 {
    let x: i32 = 0;
    x = v * 10 + d;
    return x;
};

let parenthesised = std::func(v: i32, d: i32) -> i32 {
    let x: i32 = 0;
    x = (v * 10) + d;
    return x;
};

let main = std::func() -> i32 {
    return 0;
};
