// Signed division must preserve the physical 32-bit operand width across calls.
// The operands -7/2, 7/2 and -7/-2 give -3, 3 and 3, for a final result of 3.
// Both parameter emission and signed reinterpretation are required: widening
// an unsigned 32-bit negative value before division loses its signed meaning.

#proc sdiv_hlp(#bits<32> %a, #bits<32> %b) -> #bits<32> {
  #return #sdiv(%a, %b)
}

#proc main() -> #bits<32> {
  #let %zero: #bits<32> = #sub(7, 7)
  #let %neg7: #bits<32> = #sub(%zero, 7)
  #let %two: #bits<32> = #add(2, %zero)
  #let %neg2: #bits<32> = #sub(%zero, 2)
  #let %q1: #bits<32> = #call sdiv_hlp(%neg7, %two)
  #let %q2: #bits<32> = #call sdiv_hlp(7, %two)
  #let %q3: #bits<32> = #call sdiv_hlp(%neg7, %neg2)
  #return #add(%q1, #add(%q2, %q3))
}
