// A bare entry can be given its kind by another entry of the same row: the
// peer's declared type (`Vec(T)`) puts `T` in a type position, so the row
// itself constrains it.  The row is spelled the way the roadmap spells its
// strategy row (`?{ord: Ord(T), T}`): the typed peer first, the bare entry it
// constrains last.  `T` names nowhere else -- not in the parameter list, not
// in the return annotation, not in the body -- so only the peer entry can
// derive it.  `Ord` does not exist in the library, so the fixture uses `Vec`
// (std/core/vec.lain), a type constructor the repository really has.
let pick = std::func() ?{inner: Vec(T), T} -> i32 {
    return 41;
};

let outer: Module = std::module {
    let T: std::type = i32;
    let inner: Module = std::module {
        @export let value: i32 = 1;
    };
    @export let got = pick();
};

let main = std::func() -> i32 {
    return outer.got;
};
